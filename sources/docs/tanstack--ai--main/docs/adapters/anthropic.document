NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The Anthropic adapter provides access to Claude models, including Claude Fable 5, Claude Sonnet 5, Claude Opus 4.8, and more."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-anthropic\"]],\"vue\":[[\"@tanstack/ai-anthropic\"]],\"solid\":[[\"@tanstack/ai-anthropic\"]],\"svelte\":[[\"@tanstack/ai-anthropic\"]],\"preact\":[[\"@tanstack/ai-anthropic\"]],\"angular\":[[\"@tanstack/ai-anthropic\"]],\"vanilla\":[[\"@tanstack/ai-anthropic\"]],\"octane\":[[\"@tanstack/ai-anthropic\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"basic-usage-custom-api-key","children":[{"type":"text","value":"Basic Usage - Custom API Key"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { createAnthropicChat } from \"@tanstack/ai-anthropic\";\n\nconst adapter = createAnthropicChat(\"claude-sonnet-4-6\", process.env.ANTHROPIC_API_KEY!, {\n  // ... your config options\n});\n\nconst stream = chat({\n  adapter,\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"configuration","children":[{"type":"text","value":"Configuration"}]},{"type":"code","value":"import { createAnthropicChat, type AnthropicTextConfig } from \"@tanstack/ai-anthropic\";\n\nconst config: Omit<AnthropicTextConfig, \"apiKey\"> = {\n  baseURL: \"https://api.anthropic.com\", // Optional, for custom endpoints\n};\n\nconst adapter = createAnthropicChat(\"claude-sonnet-4-6\", process.env.ANTHROPIC_API_KEY!, config);","lang":"typescript"},{"type":"heading","depth":2,"id":"claude-on-vertex","children":[{"type":"text","value":"Claude on Vertex"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"@tanstack/ai-anthropic/vertex"},{"type":"text","value":" when Claude must run on Vertex AI. That\nis the path for regional endpoints and Google Cloud credentials."}]},{"type":"paragraph","children":[{"type":"text","value":"Install the Vertex SDK next to the Anthropic adapter:"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"vue\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"solid\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"svelte\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"preact\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"angular\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"vanilla\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"octane\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]]},\"mode\":\"install\"}"}},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicVertexText } from \"@tanstack/ai-anthropic/vertex\";\n\nconst stream = chat({\n  adapter: anthropicVertexText(\"claude-sonnet-5\", {\n    project: \"my-project\",\n    location: \"europe-west1\",\n  }),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"anthropicVertexText"},{"type":"text","value":" accepts only the Claude models in the Vertex catalog.\nIt does not accept Anthropic-only ids such as "},{"type":"inlineCode","value":"claude-opus-5-fast"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"project"},{"type":"text","value":" and "},{"type":"inlineCode","value":"location"},{"type":"text","value":" use the same names as "},{"type":"inlineCode","value":"@tanstack/ai-vertex"},{"type":"text","value":", so one\nauth object works for Gemini and Claude."}]},{"type":"paragraph","children":[{"type":"text","value":"If you omit "},{"type":"inlineCode","value":"project"},{"type":"text","value":", Application Default Credentials can still fill it.\n"},{"type":"inlineCode","value":"location"},{"type":"text","value":" is required. You can pass it on the factory or set\n"},{"type":"inlineCode","value":"GOOGLE_CLOUD_LOCATION"},{"type":"text","value":", "},{"type":"inlineCode","value":"GOOGLE_VERTEX_LOCATION"},{"type":"text","value":", or "},{"type":"inlineCode","value":"CLOUD_ML_REGION"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Gemini on Vertex lives in "},{"type":"link","href":"./vertex","children":[{"type":"inlineCode","value":"@tanstack/ai-vertex"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"custom-anthropic-client","children":[{"type":"text","value":"Custom Anthropic client"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"createAnthropicChatWithClient"},{"type":"text","value":" when you already have an\nAnthropic-compatible client. The adapter only needs "},{"type":"inlineCode","value":"beta.messages.create"},{"type":"text","value":".\nMessage mapping, streaming, tools, media, usage, and structured output stay\non the same TanStack path."}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"vue\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"solid\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"svelte\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"preact\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"angular\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"vanilla\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]],\"octane\":[[\"@tanstack/ai-anthropic\",\"@anthropic-ai/vertex-sdk\"]]},\"mode\":\"install\"}"}},{"type":"code","value":"import { AnthropicVertex } from \"@anthropic-ai/vertex-sdk\";\nimport { createAnthropicChatWithClient } from \"@tanstack/ai-anthropic\";\n\nconst client = new AnthropicVertex({\n  projectId: \"my-project\",\n  region: \"europe-west1\",\n});\n\nconst adapter = createAnthropicChatWithClient(\"claude-sonnet-5\", client);","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"The injected client must implement the Anthropic Beta Messages protocol.\nEndpoint-specific model and feature support stays the caller's job."}]},{"type":"heading","depth":2,"id":"example-chat-completion","children":[{"type":"text","value":"Example: Chat Completion"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: anthropicText(\"claude-sonnet-4-6\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"example-with-tools","children":[{"type":"text","value":"Example: With Tools"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { z } from \"zod\";\n\nconst searchDatabaseDef = toolDefinition({\n  name: \"search_database\",\n  description: \"Search the database\",\n  inputSchema: z.object({\n    query: z.string(),\n  }),\n});\n\nconst searchDatabase = searchDatabaseDef.server(async ({ query }) => {\n  // Search database\n  return { results: [] };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: anthropicText(\"claude-sonnet-4-6\"),\n    messages,\n    tools: [searchDatabase],\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"model-options","children":[{"type":"text","value":"Model Options"}]},{"type":"paragraph","children":[{"type":"text","value":"Anthropic supports various provider-specific options. Sampling parameters live here too — "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":", "},{"type":"inlineCode","value":"top_p"},{"type":"text","value":", and "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":" — rather than as root-level props on "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    max_tokens: 4096,\n    temperature: 0.7,\n    top_p: 0.9,\n    top_k: 40,\n    stop_sequences: [\"END\"],\n  },\n});","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"If you previously passed "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":" / "},{"type":"inlineCode","value":"topP"},{"type":"text","value":" / "},{"type":"inlineCode","value":"maxTokens"},{"type":"text","value":" at the root of "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":", see "},{"type":"link","href":"../migration/sampling-options-to-model-options","children":[{"type":"text","value":"Moving Sampling Options into modelOptions"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":4,"id":"max-tokens-default","children":[{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":" default"}]},{"type":"paragraph","children":[{"type":"text","value":"Anthropic's Messages API "},{"type":"emphasis","children":[{"type":"text","value":"requires"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":" on every request, so the adapter always sends a value. When you don't set "},{"type":"inlineCode","value":"modelOptions.max_tokens"},{"type":"text","value":", it defaults to the selected model's full output ceiling ("},{"type":"inlineCode","value":"max_output_tokens"},{"type":"text","value":" from the model metadata — e.g. 64K for Sonnet, 128K for Opus), falling back to a safe constant for unrecognized models. "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":" is a ceiling, not a reservation — billing is on tokens actually generated — so this default costs nothing extra and avoids the silent mid-response truncation ("},{"type":"inlineCode","value":"stop_reason: \"max_tokens\""},{"type":"text","value":") that a low default would cause. Set "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":" explicitly only when you want to "},{"type":"emphasis","children":[{"type":"text","value":"cap"}]},{"type":"text","value":" output below the model ceiling. If a response is truncated while using the default cap, the adapter logs a warning (visible with "},{"type":"link","href":"../advanced/debug-logging","children":[{"type":"text","value":"debug logging"}]},{"type":"text","value":" enabled)."}]},{"type":"paragraph","children":[{"type":"text","value":"A streamed response that stops at "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":" ends in a "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":" with "},{"type":"inlineCode","value":"code: 'max_tokens'"},{"type":"text","value":". Anthropic bills the tokens of that call, so this "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":" carries the "},{"type":"inlineCode","value":"usage"},{"type":"text","value":" of the call. The "},{"type":"inlineCode","value":"onUsage"},{"type":"text","value":" middleware hook fires only for "},{"type":"inlineCode","value":"RUN_FINISHED"},{"type":"text","value":". To count these tokens too, read "},{"type":"inlineCode","value":"usage"},{"type":"text","value":" from the "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":" chunk, in the stream or in an "},{"type":"inlineCode","value":"onChunk"},{"type":"text","value":" middleware."}]},{"type":"paragraph","children":[{"type":"text","value":"One exception: structured output ("},{"type":"inlineCode","value":"chat({ outputSchema })"},{"type":"text","value":") on models that use the non-streaming finalization path clamps this default to ~21K tokens. The Anthropic SDK rejects a non-streaming request whose "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":" could exceed its 10-minute timeout, so the full ceiling can't be used there. Streaming chat is unaffected. To raise the structured-output ceiling toward a model's true max, stream the response."}]},{"type":"heading","depth":3,"id":"thinking-extended-thinking","children":[{"type":"text","value":"Thinking (Extended Thinking)"}]},{"type":"paragraph","children":[{"type":"text","value":"Enable extended thinking with a token budget. This allows Claude to show its reasoning process, which is streamed as "},{"type":"inlineCode","value":"thinking"},{"type":"text","value":" chunks:"}]},{"type":"code","value":"modelOptions: {\n  thinking: {\n    type: \"enabled\",\n    budget_tokens: 2048, // Maximum tokens for thinking\n  },\n}","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"budget_tokens"},{"type":"text","value":" must be less than "},{"type":"inlineCode","value":"modelOptions.max_tokens"},{"type":"text","value":" — set "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":" high enough to leave room for the visible response alongside the thinking budget, or the request is rejected."}]},{"type":"heading","depth":3,"id":"adaptive-thinking-claude-4-6-sonnet-5-fable-5","children":[{"type":"text","value":"Adaptive Thinking (Claude 4.6+, Sonnet 5, Fable 5)"}]},{"type":"paragraph","children":[{"type":"text","value":"Newer Claude models use adaptive thinking — the model decides when and how\nmuch to think, and depth is tuned with "},{"type":"inlineCode","value":"output_config.effort"},{"type":"text","value":" instead of a\ntoken budget:"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-5\"),\n  messages: [{ role: \"user\", content: \"Plan a database migration.\" }],\n  modelOptions: {\n    thinking: { type: \"adaptive\", display: \"summarized\" },\n    output_config: { effort: \"xhigh\" },\n    max_tokens: 64_000,\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Per-model rules (enforced by the adapter's types):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"claude-sonnet-5"},{"type":"text","value":", "},{"type":"inlineCode","value":"claude-opus-4-8"},{"type":"text","value":", "},{"type":"inlineCode","value":"claude-opus-4-7"}]},{"type":"text","value":" — adaptive\nthinking with an explicit "},{"type":"inlineCode","value":"{ type: \"disabled\" }"},{"type":"text","value":" opt-out. The manual\n"},{"type":"inlineCode","value":"{ type: \"enabled\", budget_tokens }"},{"type":"text","value":" shape is rejected with a 400, and\nthe sampling parameters ("},{"type":"inlineCode","value":"temperature"},{"type":"text","value":", "},{"type":"inlineCode","value":"top_p"},{"type":"text","value":", "},{"type":"inlineCode","value":"top_k"},{"type":"text","value":") are not\naccepted (on Sonnet 5 the API rejects non-default values; on Opus\n4.7/4.8 the parameters are removed entirely)."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"claude-fable-5"}]},{"type":"text","value":" — thinking is always on. The only accepted explicit\nconfig is "},{"type":"inlineCode","value":"{ type: \"adaptive\" }"},{"type":"text","value":" (both "},{"type":"inlineCode","value":"disabled"},{"type":"text","value":" and "},{"type":"inlineCode","value":"budget_tokens"},{"type":"text","value":"\nreturn a 400), and sampling parameters are rejected."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"claude-sonnet-5-5"}]},{"type":"text","value":" — the types accept only "},{"type":"inlineCode","value":"{ type: \"adaptive\" }"},{"type":"text","value":".\nBoth "},{"type":"inlineCode","value":"disabled"},{"type":"text","value":" and "},{"type":"inlineCode","value":"budget_tokens"},{"type":"text","value":" return a 400, and so do non-default\nsampling values. To turn off up-front thinking, the API takes\n"},{"type":"inlineCode","value":"{ type: \"between_tools\" }"},{"type":"text","value":", which the adapter does not type yet."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"claude-haiku-5-5"}]},{"type":"text","value":" — adaptive thinking is the default, and the\ntypes accept "},{"type":"inlineCode","value":"{ type: \"adaptive\" }"},{"type":"text","value":" or "},{"type":"inlineCode","value":"{ type: \"disabled\" }"},{"type":"text","value":". The API\naccepts "},{"type":"inlineCode","value":"disabled"},{"type":"text","value":" at "},{"type":"inlineCode","value":"high"},{"type":"text","value":" effort or below and returns a 400 at "},{"type":"inlineCode","value":"xhigh"},{"type":"text","value":"\nand "},{"type":"inlineCode","value":"max"},{"type":"text","value":"; the types cannot express that, so pair it with "},{"type":"inlineCode","value":"low"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"medium"},{"type":"text","value":", or "},{"type":"inlineCode","value":"high"},{"type":"text","value":". "},{"type":"inlineCode","value":"{ type: \"enabled\", budget_tokens }"},{"type":"text","value":" and non-default\nsampling values return a 400. "},{"type":"inlineCode","value":"effort"},{"type":"text","value":" defaults to "},{"type":"inlineCode","value":"medium"},{"type":"text","value":" on this\nmodel, and it takes a forced "},{"type":"inlineCode","value":"tool_choice"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"claude-opus-4-6"},{"type":"text","value":" / "},{"type":"inlineCode","value":"claude-sonnet-4-6"}]},{"type":"text","value":" — accept\n"},{"type":"inlineCode","value":"{ type: \"adaptive\" }"},{"type":"text","value":" alongside the deprecated\n"},{"type":"inlineCode","value":"{ type: \"enabled\", budget_tokens }"},{"type":"text","value":" shape, and still accept sampling\nparameters."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"display"}]},{"type":"text","value":" defaults to "},{"type":"inlineCode","value":"\"omitted\""},{"type":"text","value":" on Opus 4.7+ and the 5-generation\nmodels — set "},{"type":"inlineCode","value":"\"summarized\""},{"type":"text","value":" to stream the reasoning text."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"effort"}]},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"\"low\" | \"medium\" | \"high\" | \"xhigh\" | \"max\""},{"type":"text","value":";\n"},{"type":"inlineCode","value":"\"xhigh\""},{"type":"text","value":" is available on Claude Opus 4.7+, Claude Sonnet 5, Claude\nSonnet 5.5, Claude Haiku 5.5, Claude Fable 5, and Claude Fable 5.1.\nOlder models take "},{"type":"inlineCode","value":"\"low\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"medium\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"high\""},{"type":"text","value":", and, except Claude Opus\n4.5, "},{"type":"inlineCode","value":"\"max\""},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"output_config"}]},{"type":"text","value":" is accepted on Claude Opus 4.7, Opus 4.8, Sonnet 5,\nFable 5, Opus 5, Fable 5.1, Opus 5.5, Sonnet 5.5, and Haiku 5.5. When you\nalso pass an "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":", the adapter adds "},{"type":"inlineCode","value":"output_config.format"},{"type":"text","value":" and\nkeeps the "},{"type":"inlineCode","value":"effort"},{"type":"text","value":" you set."}]}]}]},{"type":"heading","depth":3,"id":"prompt-caching","children":[{"type":"text","value":"Prompt Caching"}]},{"type":"paragraph","children":[{"type":"text","value":"Cache prompts for better performance and reduced costs:"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [\n    {\n      role: \"user\",\n      content: [\n        {\n          type: \"text\",\n          content: \"What is the capital of France?\",\n          metadata: {\n            cache_control: {\n              type: \"ephemeral\",\n            },\n          },\n        },\n      ],\n    },\n  ],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"summarization","children":[{"type":"text","value":"Summarization"}]},{"type":"paragraph","children":[{"type":"text","value":"Anthropic supports text summarization:"}]},{"type":"code","value":"import { summarize } from \"@tanstack/ai\";\nimport { anthropicSummarize } from \"@tanstack/ai-anthropic\";\n\nconst result = await summarize({\n  adapter: anthropicSummarize(\"claude-sonnet-4-6\"),\n  text: \"Your long text to summarize...\",\n  maxLength: 100,\n  style: \"concise\", // \"concise\" | \"bullet-points\" | \"paragraph\"\n});\n\nconsole.log(result.summary);","lang":"typescript"},{"type":"heading","depth":2,"id":"environment-variables","children":[{"type":"text","value":"Environment Variables"}]},{"type":"paragraph","children":[{"type":"text","value":"Set your API key in environment variables:"}]},{"type":"code","value":"ANTHROPIC_API_KEY=sk-ant-...","lang":"bash"},{"type":"heading","depth":2,"id":"api-reference","children":[{"type":"text","value":"API Reference"}]},{"type":"paragraph","children":[{"type":"text","value":"Every factory pair follows the same shape: the short factory ("},{"type":"inlineCode","value":"anthropicText"},{"type":"text","value":", "},{"type":"inlineCode","value":"anthropicSummarize"},{"type":"text","value":") reads "},{"type":"inlineCode","value":"ANTHROPIC_API_KEY"},{"type":"text","value":" from the environment, while "},{"type":"inlineCode","value":"createAnthropicChat"},{"type":"text","value":" / "},{"type":"inlineCode","value":"createAnthropicSummarize"},{"type":"text","value":" take an explicit API key. Both take "},{"type":"inlineCode","value":"model"},{"type":"text","value":" as the first argument. For Claude on Vertex, use "},{"type":"inlineCode","value":"anthropicVertexText"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-anthropic/vertex"},{"type":"text","value":". For any other custom transport, "},{"type":"inlineCode","value":"createAnthropicChatWithClient"},{"type":"text","value":" accepts an Anthropic-compatible Messages client."}]},{"type":"heading","depth":3,"id":"anthropictext-model-config-createanthropicchat-model-apikey-config","children":[{"type":"inlineCode","value":"anthropicText(model, config?)"},{"type":"text","value":" / "},{"type":"inlineCode","value":"createAnthropicChat(model, apiKey, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates an Anthropic chat adapter."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Parameters:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"model"},{"type":"text","value":" - Claude model id (e.g. "},{"type":"inlineCode","value":"\"claude-sonnet-5\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"claude-fable-5\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"claude-opus-4-8\""},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"config?.baseURL"},{"type":"text","value":" - Custom base URL (optional)"}]}]}]},{"type":"heading","depth":3,"id":"anthropicvertextext-model-config","children":[{"type":"inlineCode","value":"anthropicVertexText(model, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates an Anthropic chat adapter on Vertex. Import it from\n"},{"type":"inlineCode","value":"@tanstack/ai-anthropic/vertex"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Parameters:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"model"},{"type":"text","value":" - Claude model id"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"config.project"},{"type":"text","value":" - GCP project id (optional if ADC can resolve it)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"config.location"},{"type":"text","value":" - Vertex region (or set "},{"type":"inlineCode","value":"GOOGLE_CLOUD_LOCATION"},{"type":"text","value":")"}]}]}]},{"type":"heading","depth":3,"id":"createanthropicchatwithclient-model-client","children":[{"type":"inlineCode","value":"createAnthropicChatWithClient(model, client)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates an Anthropic chat adapter using an injected client."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Parameters:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"model"},{"type":"text","value":" - Claude model id"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"client"},{"type":"text","value":" - Client exposing "},{"type":"inlineCode","value":"beta.messages.create"}]}]}]},{"type":"heading","depth":3,"id":"anthropicsummarize-model-config-createanthropicsummarize-model-apikey-config","children":[{"type":"inlineCode","value":"anthropicSummarize(model, config?)"},{"type":"text","value":" / "},{"type":"inlineCode","value":"createAnthropicSummarize(model, apiKey, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates an Anthropic summarization adapter."}]},{"type":"heading","depth":2,"id":"limitations","children":[{"type":"text","value":"Limitations"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Image Generation"}]},{"type":"text","value":": Anthropic does not support image generation. Use OpenAI or Gemini for image generation."}]}]}]},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Getting Started"}]},{"type":"text","value":" - Learn the basics"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools Guide"}]},{"type":"text","value":" - Learn about tools"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./openai","children":[{"type":"text","value":"Other Adapters"}]},{"type":"text","value":" - Explore other providers"}]}]}]},{"type":"heading","depth":2,"id":"provider-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"paragraph","children":[{"type":"text","value":"Anthropic exposes several native tools beyond user-defined function calls.\nImport them from "},{"type":"inlineCode","value":"@tanstack/ai-anthropic/tools"},{"type":"text","value":" and pass them into\n"},{"type":"inlineCode","value":"chat({ tools: [...] })"},{"type":"text","value":"."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"For the full concept, a comparison matrix, and type-gating details, see\n"},{"type":"link","href":"../tools/provider-tools.md","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":3,"id":"websearchtool","children":[{"type":"inlineCode","value":"webSearchTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Enables Claude to run Anthropic's native web search with inline citations.\nScope the search with "},{"type":"inlineCode","value":"allowed_domains"},{"type":"text","value":" or "},{"type":"inlineCode","value":"blocked_domains"},{"type":"text","value":" (mutually\nexclusive); set "},{"type":"inlineCode","value":"max_uses"},{"type":"text","value":" to cap per-turn cost."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { webSearchTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-opus-4-7\"),\n  messages: [{ role: \"user\", content: \"What's new in AI this week?\" }],\n  tools: [\n    webSearchTool({\n      name: \"web_search\",\n      type: \"web_search_20250305\",\n      max_uses: 2,\n    }),\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" every registered Claude model. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"webfetchtool","children":[{"type":"inlineCode","value":"webFetchTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Lets Claude fetch the contents of a URL directly, useful when you want the\nmodel to read a specific page rather than run a search. Takes no required\narguments — pass an optional config object to override defaults."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { webFetchTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Summarise https://example.com\" }],\n  tools: [webFetchTool()],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Claude Sonnet 4.x and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"codeexecutiontool","children":[{"type":"inlineCode","value":"codeExecutionTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Gives Claude a sandboxed code-execution environment so it can run Python\nsnippets, analyse data, and return results inline. Choose the version string\nthat matches your desired API revision."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { codeExecutionTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Plot a histogram of [1,2,2,3,3,3]\" }],\n  tools: [\n    codeExecutionTool({ name: \"code_execution\", type: \"code_execution_20250825\" }),\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Claude Sonnet 4.x and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"attaching-hosted-skills","children":[{"type":"text","value":"Attaching hosted skills"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass a "},{"type":"inlineCode","value":"skills"},{"type":"text","value":" array as the second argument to load provider-managed skill\nbundles into the sandbox. The adapter auto-lifts them into the API's\n"},{"type":"inlineCode","value":"container.skills"},{"type":"text","value":" param and adds the required beta headers for you."}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { codeExecutionTool } from \"@tanstack/ai-anthropic/tools\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: anthropicText(\"claude-sonnet-4-5\"),\n    messages,\n    tools: [\n      codeExecutionTool(\n        { type: \"code_execution_20250825\", name: \"code_execution\" },\n        {\n          skills: [{ type: \"anthropic\", skill_id: \"pptx\", version: \"latest\" }],\n        },\n      ),\n    ],\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"For the full reference — skill shape, constraints, scope, and the OpenAI\nequivalent — see "},{"type":"link","href":"../tools/provider-skills.md","children":[{"type":"text","value":"Provider Skills"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"computerusetool","children":[{"type":"inlineCode","value":"computerUseTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Allows Claude to observe a virtual desktop (screenshots) and interact with it\nvia keyboard and mouse events. Provide the screen resolution so Claude can\ncalculate accurate coordinates."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { computerUseTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Open the browser and go to example.com\" }],\n  tools: [\n    computerUseTool({\n      type: \"computer_20250124\",\n      name: \"computer\",\n      display_width_px: 1024,\n      display_height_px: 768,\n    }),\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Claude Sonnet 3.5 and above, with two exceptions. "},{"type":"inlineCode","value":"claude-opus-5-fast"},{"type":"text","value":" takes no provider tools. Claude Opus 5.5, Claude Sonnet 5.5, and Claude Haiku 5.5 accept only the "},{"type":"inlineCode","value":"computer_toolset_20260801"},{"type":"text","value":" toolset, which the adapter does not offer yet. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"bashtool","children":[{"type":"inlineCode","value":"bashTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Provides Claude with a persistent bash shell session, letting it run arbitrary\ncommands, install packages, or manipulate files on the host. Choose the type\nstring that matches your API revision."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { bashTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"List all TypeScript files in src/\" }],\n  tools: [bashTool({ name: \"bash\", type: \"bash_20250124\" })],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Claude Sonnet 3.5 and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"texteditortool","children":[{"type":"inlineCode","value":"textEditorTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Gives Claude a structured text-editor interface for viewing and modifying files\nusing "},{"type":"inlineCode","value":"str_replace"},{"type":"text","value":", "},{"type":"inlineCode","value":"create"},{"type":"text","value":", "},{"type":"inlineCode","value":"view"},{"type":"text","value":", and "},{"type":"inlineCode","value":"undo_edit"},{"type":"text","value":" commands. Choose the\ntype string for the API revision you target."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { textEditorTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Fix the bug in src/index.ts\" }],\n  tools: [\n    textEditorTool({ type: \"text_editor_20250124\", name: \"str_replace_editor\" }),\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Claude Sonnet 3.5 and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"memorytool","children":[{"type":"inlineCode","value":"memoryTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Enables Claude to store and retrieve information across conversation turns\nusing Anthropic's managed memory service. Call with no arguments to use\ndefault configuration."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { memoryTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Remember that I prefer metric units\" }],\n  tools: [memoryTool()],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Claude Sonnet 4.x and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"customtool","children":[{"type":"inlineCode","value":"customTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a tool with an inline JSON Schema input definition instead of going\nthrough "},{"type":"inlineCode","value":"toolDefinition()"},{"type":"text","value":". Useful when you need fine-grained control over the\nschema shape or want to add "},{"type":"inlineCode","value":"cache_control"},{"type":"text","value":". Unlike branded provider tools,\n"},{"type":"inlineCode","value":"customTool"},{"type":"text","value":" returns a plain "},{"type":"inlineCode","value":"Tool"},{"type":"text","value":" and is accepted by any chat model."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { customTool } from \"@tanstack/ai-anthropic/tools\";\nimport { z } from \"zod\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Look up user 42\" }],\n  tools: [\n    customTool(\n      \"lookup_user\",\n      \"Look up a user by ID and return their profile\",\n      z.object({ userId: z.number() }),\n    ),\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" all current Claude models. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"basic-usage-custom-api-key","text":"Basic Usage - Custom API Key","level":2},{"id":"configuration","text":"Configuration","level":2},{"id":"claude-on-vertex","text":"Claude on Vertex","level":2},{"id":"custom-anthropic-client","text":"Custom Anthropic client","level":2},{"id":"example-chat-completion","text":"Example: Chat Completion","level":2},{"id":"example-with-tools","text":"Example: With Tools","level":2},{"id":"model-options","text":"Model Options","level":2},{"id":"max-tokens-default","text":"max_tokens default","level":4},{"id":"thinking-extended-thinking","text":"Thinking (Extended Thinking)","level":3},{"id":"adaptive-thinking-claude-4-6-sonnet-5-fable-5","text":"Adaptive Thinking (Claude 4.6+, Sonnet 5, Fable 5)","level":3},{"id":"prompt-caching","text":"Prompt Caching","level":3},{"id":"summarization","text":"Summarization","level":2},{"id":"environment-variables","text":"Environment Variables","level":2},{"id":"api-reference","text":"API Reference","level":2},{"id":"anthropictext-model-config-createanthropicchat-model-apikey-config","text":"anthropicText(model, config?) / createAnthropicChat(model, apiKey, config?)","level":3},{"id":"anthropicvertextext-model-config","text":"anthropicVertexText(model, config?)","level":3},{"id":"createanthropicchatwithclient-model-client","text":"createAnthropicChatWithClient(model, client)","level":3},{"id":"anthropicsummarize-model-config-createanthropicsummarize-model-apikey-config","text":"anthropicSummarize(model, config?) / createAnthropicSummarize(model, apiKey, config?)","level":3},{"id":"limitations","text":"Limitations","level":2},{"id":"next-steps","text":"Next Steps","level":2},{"id":"provider-tools","text":"Provider Tools","level":2},{"id":"websearchtool","text":"webSearchTool","level":3},{"id":"webfetchtool","text":"webFetchTool","level":3},{"id":"codeexecutiontool","text":"codeExecutionTool","level":3},{"id":"attaching-hosted-skills","text":"Attaching hosted skills","level":4},{"id":"computerusetool","text":"computerUseTool","level":3},{"id":"bashtool","text":"bashTool","level":3},{"id":"texteditortool","text":"textEditorTool","level":3},{"id":"memorytool","text":"memoryTool","level":3},{"id":"customtool","text":"customTool","level":3}]},"frameworks":["react","vue","solid","svelte","preact","angular","vanilla","octane"],"downloadMarkdown":"\nThe Anthropic adapter provides access to Claude models, including Claude Fable 5, Claude Sonnet 5, Claude Opus 4.8, and more.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-anthropic\nvue: @tanstack/ai-anthropic\nsolid: @tanstack/ai-anthropic\nsvelte: @tanstack/ai-anthropic\npreact: @tanstack/ai-anthropic\nangular: @tanstack/ai-anthropic\nvanilla: @tanstack/ai-anthropic\noctane: @tanstack/ai-anthropic\n\n<!-- ::end:tabs -->\n\n## Basic Usage\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Basic Usage - Custom API Key\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { createAnthropicChat } from \"@tanstack/ai-anthropic\";\n\nconst adapter = createAnthropicChat(\"claude-sonnet-4-6\", process.env.ANTHROPIC_API_KEY!, {\n  // ... your config options\n});\n\nconst stream = chat({\n  adapter,\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Configuration\n\n```typescript\nimport { createAnthropicChat, type AnthropicTextConfig } from \"@tanstack/ai-anthropic\";\n\nconst config: Omit<AnthropicTextConfig, \"apiKey\"> = {\n  baseURL: \"https://api.anthropic.com\", // Optional, for custom endpoints\n};\n\nconst adapter = createAnthropicChat(\"claude-sonnet-4-6\", process.env.ANTHROPIC_API_KEY!, config);\n```\n\n## Claude on Vertex\n\nUse `@tanstack/ai-anthropic/vertex` when Claude must run on Vertex AI. That\nis the path for regional endpoints and Google Cloud credentials.\n\nInstall the Vertex SDK next to the Anthropic adapter:\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nvue: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nsolid: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nsvelte: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\npreact: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nangular: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nvanilla: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\noctane: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\n\n<!-- ::end:tabs -->\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicVertexText } from \"@tanstack/ai-anthropic/vertex\";\n\nconst stream = chat({\n  adapter: anthropicVertexText(\"claude-sonnet-5\", {\n    project: \"my-project\",\n    location: \"europe-west1\",\n  }),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n`anthropicVertexText` accepts only the Claude models in the Vertex catalog.\nIt does not accept Anthropic-only ids such as `claude-opus-5-fast`.\n\n`project` and `location` use the same names as `@tanstack/ai-vertex`, so one\nauth object works for Gemini and Claude.\n\nIf you omit `project`, Application Default Credentials can still fill it.\n`location` is required. You can pass it on the factory or set\n`GOOGLE_CLOUD_LOCATION`, `GOOGLE_VERTEX_LOCATION`, or `CLOUD_ML_REGION`.\n\nGemini on Vertex lives in [`@tanstack/ai-vertex`](./vertex).\n\n## Custom Anthropic client\n\nUse `createAnthropicChatWithClient` when you already have an\nAnthropic-compatible client. The adapter only needs `beta.messages.create`.\nMessage mapping, streaming, tools, media, usage, and structured output stay\non the same TanStack path.\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nvue: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nsolid: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nsvelte: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\npreact: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nangular: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nvanilla: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\noctane: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\n\n<!-- ::end:tabs -->\n\n```typescript\nimport { AnthropicVertex } from \"@anthropic-ai/vertex-sdk\";\nimport { createAnthropicChatWithClient } from \"@tanstack/ai-anthropic\";\n\nconst client = new AnthropicVertex({\n  projectId: \"my-project\",\n  region: \"europe-west1\",\n});\n\nconst adapter = createAnthropicChatWithClient(\"claude-sonnet-5\", client);\n```\n\nThe injected client must implement the Anthropic Beta Messages protocol.\nEndpoint-specific model and feature support stays the caller's job.\n\n## Example: Chat Completion\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: anthropicText(\"claude-sonnet-4-6\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Example: With Tools\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { z } from \"zod\";\n\nconst searchDatabaseDef = toolDefinition({\n  name: \"search_database\",\n  description: \"Search the database\",\n  inputSchema: z.object({\n    query: z.string(),\n  }),\n});\n\nconst searchDatabase = searchDatabaseDef.server(async ({ query }) => {\n  // Search database\n  return { results: [] };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: anthropicText(\"claude-sonnet-4-6\"),\n    messages,\n    tools: [searchDatabase],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Model Options\n\nAnthropic supports various provider-specific options. Sampling parameters live here too — `temperature`, `top_p`, and `max_tokens` — rather than as root-level props on `chat()`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    max_tokens: 4096,\n    temperature: 0.7,\n    top_p: 0.9,\n    top_k: 40,\n    stop_sequences: [\"END\"],\n  },\n});\n```\n\n> If you previously passed `temperature` / `topP` / `maxTokens` at the root of `chat()`, see [Moving Sampling Options into modelOptions](../migration/sampling-options-to-model-options).\n\n#### `max_tokens` default\n\nAnthropic's Messages API _requires_ `max_tokens` on every request, so the adapter always sends a value. When you don't set `modelOptions.max_tokens`, it defaults to the selected model's full output ceiling (`max_output_tokens` from the model metadata — e.g. 64K for Sonnet, 128K for Opus), falling back to a safe constant for unrecognized models. `max_tokens` is a ceiling, not a reservation — billing is on tokens actually generated — so this default costs nothing extra and avoids the silent mid-response truncation (`stop_reason: \"max_tokens\"`) that a low default would cause. Set `max_tokens` explicitly only when you want to _cap_ output below the model ceiling. If a response is truncated while using the default cap, the adapter logs a warning (visible with [debug logging](../advanced/debug-logging) enabled).\n\nA streamed response that stops at `max_tokens` ends in a `RUN_ERROR` with `code: 'max_tokens'`. Anthropic bills the tokens of that call, so this `RUN_ERROR` carries the `usage` of the call. The `onUsage` middleware hook fires only for `RUN_FINISHED`. To count these tokens too, read `usage` from the `RUN_ERROR` chunk, in the stream or in an `onChunk` middleware.\n\nOne exception: structured output (`chat({ outputSchema })`) on models that use the non-streaming finalization path clamps this default to ~21K tokens. The Anthropic SDK rejects a non-streaming request whose `max_tokens` could exceed its 10-minute timeout, so the full ceiling can't be used there. Streaming chat is unaffected. To raise the structured-output ceiling toward a model's true max, stream the response.\n\n### Thinking (Extended Thinking)\n\nEnable extended thinking with a token budget. This allows Claude to show its reasoning process, which is streamed as `thinking` chunks:\n\n```typescript ignore\nmodelOptions: {\n  thinking: {\n    type: \"enabled\",\n    budget_tokens: 2048, // Maximum tokens for thinking\n  },\n}\n```\n\n**Note:** `budget_tokens` must be less than `modelOptions.max_tokens` — set `max_tokens` high enough to leave room for the visible response alongside the thinking budget, or the request is rejected.\n\n### Adaptive Thinking (Claude 4.6+, Sonnet 5, Fable 5)\n\nNewer Claude models use adaptive thinking — the model decides when and how\nmuch to think, and depth is tuned with `output_config.effort` instead of a\ntoken budget:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-5\"),\n  messages: [{ role: \"user\", content: \"Plan a database migration.\" }],\n  modelOptions: {\n    thinking: { type: \"adaptive\", display: \"summarized\" },\n    output_config: { effort: \"xhigh\" },\n    max_tokens: 64_000,\n  },\n});\n```\n\nPer-model rules (enforced by the adapter's types):\n\n- **`claude-sonnet-5`, `claude-opus-4-8`, `claude-opus-4-7`** — adaptive\n  thinking with an explicit `{ type: \"disabled\" }` opt-out. The manual\n  `{ type: \"enabled\", budget_tokens }` shape is rejected with a 400, and\n  the sampling parameters (`temperature`, `top_p`, `top_k`) are not\n  accepted (on Sonnet 5 the API rejects non-default values; on Opus\n  4.7/4.8 the parameters are removed entirely).\n- **`claude-fable-5`** — thinking is always on. The only accepted explicit\n  config is `{ type: \"adaptive\" }` (both `disabled` and `budget_tokens`\n  return a 400), and sampling parameters are rejected.\n- **`claude-sonnet-5-5`** — the types accept only `{ type: \"adaptive\" }`.\n  Both `disabled` and `budget_tokens` return a 400, and so do non-default\n  sampling values. To turn off up-front thinking, the API takes\n  `{ type: \"between_tools\" }`, which the adapter does not type yet.\n- **`claude-haiku-5-5`** — adaptive thinking is the default, and the\n  types accept `{ type: \"adaptive\" }` or `{ type: \"disabled\" }`. The API\n  accepts `disabled` at `high` effort or below and returns a 400 at `xhigh`\n  and `max`; the types cannot express that, so pair it with `low`,\n  `medium`, or `high`. `{ type: \"enabled\", budget_tokens }` and non-default\n  sampling values return a 400. `effort` defaults to `medium` on this\n  model, and it takes a forced `tool_choice`.\n- **`claude-opus-4-6` / `claude-sonnet-4-6`** — accept\n  `{ type: \"adaptive\" }` alongside the deprecated\n  `{ type: \"enabled\", budget_tokens }` shape, and still accept sampling\n  parameters.\n- **`display`** defaults to `\"omitted\"` on Opus 4.7+ and the 5-generation\n  models — set `\"summarized\"` to stream the reasoning text.\n- **`effort`** accepts `\"low\" | \"medium\" | \"high\" | \"xhigh\" | \"max\"`;\n  `\"xhigh\"` is available on Claude Opus 4.7+, Claude Sonnet 5, Claude\n  Sonnet 5.5, Claude Haiku 5.5, Claude Fable 5, and Claude Fable 5.1.\n  Older models take `\"low\"`, `\"medium\"`, `\"high\"`, and, except Claude Opus\n  4.5, `\"max\"`.\n- **`output_config`** is accepted on Claude Opus 4.7, Opus 4.8, Sonnet 5,\n  Fable 5, Opus 5, Fable 5.1, Opus 5.5, Sonnet 5.5, and Haiku 5.5. When you\n  also pass an `outputSchema`, the adapter adds `output_config.format` and\n  keeps the `effort` you set.\n\n### Prompt Caching\n\nCache prompts for better performance and reduced costs:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [\n    {\n      role: \"user\",\n      content: [\n        {\n          type: \"text\",\n          content: \"What is the capital of France?\",\n          metadata: {\n            cache_control: {\n              type: \"ephemeral\",\n            },\n          },\n        },\n      ],\n    },\n  ],\n});\n```\n\n## Summarization\n\nAnthropic supports text summarization:\n\n```typescript\nimport { summarize } from \"@tanstack/ai\";\nimport { anthropicSummarize } from \"@tanstack/ai-anthropic\";\n\nconst result = await summarize({\n  adapter: anthropicSummarize(\"claude-sonnet-4-6\"),\n  text: \"Your long text to summarize...\",\n  maxLength: 100,\n  style: \"concise\", // \"concise\" | \"bullet-points\" | \"paragraph\"\n});\n\nconsole.log(result.summary);\n```\n\n## Environment Variables\n\nSet your API key in environment variables:\n\n```bash\nANTHROPIC_API_KEY=sk-ant-...\n```\n\n## API Reference\n\nEvery factory pair follows the same shape: the short factory (`anthropicText`, `anthropicSummarize`) reads `ANTHROPIC_API_KEY` from the environment, while `createAnthropicChat` / `createAnthropicSummarize` take an explicit API key. Both take `model` as the first argument. For Claude on Vertex, use `anthropicVertexText` from `@tanstack/ai-anthropic/vertex`. For any other custom transport, `createAnthropicChatWithClient` accepts an Anthropic-compatible Messages client.\n\n### `anthropicText(model, config?)` / `createAnthropicChat(model, apiKey, config?)`\n\nCreates an Anthropic chat adapter.\n\n**Parameters:**\n\n- `model` - Claude model id (e.g. `\"claude-sonnet-5\"`, `\"claude-fable-5\"`, `\"claude-opus-4-8\"`)\n- `config?.baseURL` - Custom base URL (optional)\n\n### `anthropicVertexText(model, config?)`\n\nCreates an Anthropic chat adapter on Vertex. Import it from\n`@tanstack/ai-anthropic/vertex`.\n\n**Parameters:**\n\n- `model` - Claude model id\n- `config.project` - GCP project id (optional if ADC can resolve it)\n- `config.location` - Vertex region (or set `GOOGLE_CLOUD_LOCATION`)\n\n### `createAnthropicChatWithClient(model, client)`\n\nCreates an Anthropic chat adapter using an injected client.\n\n**Parameters:**\n\n- `model` - Claude model id\n- `client` - Client exposing `beta.messages.create`\n\n### `anthropicSummarize(model, config?)` / `createAnthropicSummarize(model, apiKey, config?)`\n\nCreates an Anthropic summarization adapter.\n\n## Limitations\n\n- **Image Generation**: Anthropic does not support image generation. Use OpenAI or Gemini for image generation.\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Other Adapters](./openai) - Explore other providers\n\n## Provider Tools\n\nAnthropic exposes several native tools beyond user-defined function calls.\nImport them from `@tanstack/ai-anthropic/tools` and pass them into\n`chat({ tools: [...] })`.\n\n> For the full concept, a comparison matrix, and type-gating details, see\n> [Provider Tools](../tools/provider-tools.md).\n\n### `webSearchTool`\n\nEnables Claude to run Anthropic's native web search with inline citations.\nScope the search with `allowed_domains` or `blocked_domains` (mutually\nexclusive); set `max_uses` to cap per-turn cost.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { webSearchTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-opus-4-7\"),\n  messages: [{ role: \"user\", content: \"What's new in AI this week?\" }],\n  tools: [\n    webSearchTool({\n      name: \"web_search\",\n      type: \"web_search_20250305\",\n      max_uses: 2,\n    }),\n  ],\n});\n```\n\n**Supported models:** every registered Claude model. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `webFetchTool`\n\nLets Claude fetch the contents of a URL directly, useful when you want the\nmodel to read a specific page rather than run a search. Takes no required\narguments — pass an optional config object to override defaults.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { webFetchTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Summarise https://example.com\" }],\n  tools: [webFetchTool()],\n});\n```\n\n**Supported models:** Claude Sonnet 4.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `codeExecutionTool`\n\nGives Claude a sandboxed code-execution environment so it can run Python\nsnippets, analyse data, and return results inline. Choose the version string\nthat matches your desired API revision.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { codeExecutionTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Plot a histogram of [1,2,2,3,3,3]\" }],\n  tools: [\n    codeExecutionTool({ name: \"code_execution\", type: \"code_execution_20250825\" }),\n  ],\n});\n```\n\n**Supported models:** Claude Sonnet 4.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n#### Attaching hosted skills\n\nPass a `skills` array as the second argument to load provider-managed skill\nbundles into the sandbox. The adapter auto-lifts them into the API's\n`container.skills` param and adds the required beta headers for you.\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { codeExecutionTool } from \"@tanstack/ai-anthropic/tools\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: anthropicText(\"claude-sonnet-4-5\"),\n    messages,\n    tools: [\n      codeExecutionTool(\n        { type: \"code_execution_20250825\", name: \"code_execution\" },\n        {\n          skills: [{ type: \"anthropic\", skill_id: \"pptx\", version: \"latest\" }],\n        },\n      ),\n    ],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nFor the full reference — skill shape, constraints, scope, and the OpenAI\nequivalent — see [Provider Skills](../tools/provider-skills.md).\n\n### `computerUseTool`\n\nAllows Claude to observe a virtual desktop (screenshots) and interact with it\nvia keyboard and mouse events. Provide the screen resolution so Claude can\ncalculate accurate coordinates.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { computerUseTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Open the browser and go to example.com\" }],\n  tools: [\n    computerUseTool({\n      type: \"computer_20250124\",\n      name: \"computer\",\n      display_width_px: 1024,\n      display_height_px: 768,\n    }),\n  ],\n});\n```\n\n**Supported models:** Claude Sonnet 3.5 and above, with two exceptions. `claude-opus-5-fast` takes no provider tools. Claude Opus 5.5, Claude Sonnet 5.5, and Claude Haiku 5.5 accept only the `computer_toolset_20260801` toolset, which the adapter does not offer yet. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `bashTool`\n\nProvides Claude with a persistent bash shell session, letting it run arbitrary\ncommands, install packages, or manipulate files on the host. Choose the type\nstring that matches your API revision.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { bashTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"List all TypeScript files in src/\" }],\n  tools: [bashTool({ name: \"bash\", type: \"bash_20250124\" })],\n});\n```\n\n**Supported models:** Claude Sonnet 3.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `textEditorTool`\n\nGives Claude a structured text-editor interface for viewing and modifying files\nusing `str_replace`, `create`, `view`, and `undo_edit` commands. Choose the\ntype string for the API revision you target.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { textEditorTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Fix the bug in src/index.ts\" }],\n  tools: [\n    textEditorTool({ type: \"text_editor_20250124\", name: \"str_replace_editor\" }),\n  ],\n});\n```\n\n**Supported models:** Claude Sonnet 3.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `memoryTool`\n\nEnables Claude to store and retrieve information across conversation turns\nusing Anthropic's managed memory service. Call with no arguments to use\ndefault configuration.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { memoryTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Remember that I prefer metric units\" }],\n  tools: [memoryTool()],\n});\n```\n\n**Supported models:** Claude Sonnet 4.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `customTool`\n\nCreates a tool with an inline JSON Schema input definition instead of going\nthrough `toolDefinition()`. Useful when you need fine-grained control over the\nschema shape or want to add `cache_control`. Unlike branded provider tools,\n`customTool` returns a plain `Tool` and is accepted by any chat model.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { customTool } from \"@tanstack/ai-anthropic/tools\";\nimport { z } from \"zod\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Look up user 42\" }],\n  tools: [\n    customTool(\n      \"lookup_user\",\n      \"Look up a user by ID and return their profile\",\n      z.object({ userId: z.number() }),\n    ),\n  ],\n});\n```\n\n**Supported models:** all current Claude models. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n","originalRawMarkdown":"---\ntitle: Anthropic\nid: anthropic-adapter\norder: 2\ndescription: \"Use Anthropic Claude models with TanStack AI — Claude Fable 5, Claude Sonnet 5, Claude Opus, and more via the @tanstack/ai-anthropic adapter.\"\nkeywords:\n  - tanstack ai\n  - anthropic\n  - claude\n  - claude fable 5\n  - claude sonnet 5\n  - claude opus\n  - adapter\n  - llm\n---\n\nThe Anthropic adapter provides access to Claude models, including Claude Fable 5, Claude Sonnet 5, Claude Opus 4.8, and more.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-anthropic\nvue: @tanstack/ai-anthropic\nsolid: @tanstack/ai-anthropic\nsvelte: @tanstack/ai-anthropic\npreact: @tanstack/ai-anthropic\nangular: @tanstack/ai-anthropic\nvanilla: @tanstack/ai-anthropic\noctane: @tanstack/ai-anthropic\n\n<!-- ::end:tabs -->\n\n## Basic Usage\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Basic Usage - Custom API Key\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { createAnthropicChat } from \"@tanstack/ai-anthropic\";\n\nconst adapter = createAnthropicChat(\"claude-sonnet-4-6\", process.env.ANTHROPIC_API_KEY!, {\n  // ... your config options\n});\n\nconst stream = chat({\n  adapter,\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Configuration\n\n```typescript\nimport { createAnthropicChat, type AnthropicTextConfig } from \"@tanstack/ai-anthropic\";\n\nconst config: Omit<AnthropicTextConfig, \"apiKey\"> = {\n  baseURL: \"https://api.anthropic.com\", // Optional, for custom endpoints\n};\n\nconst adapter = createAnthropicChat(\"claude-sonnet-4-6\", process.env.ANTHROPIC_API_KEY!, config);\n```\n\n## Claude on Vertex\n\nUse `@tanstack/ai-anthropic/vertex` when Claude must run on Vertex AI. That\nis the path for regional endpoints and Google Cloud credentials.\n\nInstall the Vertex SDK next to the Anthropic adapter:\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nvue: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nsolid: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nsvelte: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\npreact: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nangular: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nvanilla: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\noctane: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\n\n<!-- ::end:tabs -->\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicVertexText } from \"@tanstack/ai-anthropic/vertex\";\n\nconst stream = chat({\n  adapter: anthropicVertexText(\"claude-sonnet-5\", {\n    project: \"my-project\",\n    location: \"europe-west1\",\n  }),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n`anthropicVertexText` accepts only the Claude models in the Vertex catalog.\nIt does not accept Anthropic-only ids such as `claude-opus-5-fast`.\n\n`project` and `location` use the same names as `@tanstack/ai-vertex`, so one\nauth object works for Gemini and Claude.\n\nIf you omit `project`, Application Default Credentials can still fill it.\n`location` is required. You can pass it on the factory or set\n`GOOGLE_CLOUD_LOCATION`, `GOOGLE_VERTEX_LOCATION`, or `CLOUD_ML_REGION`.\n\nGemini on Vertex lives in [`@tanstack/ai-vertex`](./vertex).\n\n## Custom Anthropic client\n\nUse `createAnthropicChatWithClient` when you already have an\nAnthropic-compatible client. The adapter only needs `beta.messages.create`.\nMessage mapping, streaming, tools, media, usage, and structured output stay\non the same TanStack path.\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nvue: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nsolid: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nsvelte: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\npreact: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nangular: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\nvanilla: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\noctane: @tanstack/ai-anthropic @anthropic-ai/vertex-sdk\n\n<!-- ::end:tabs -->\n\n```typescript\nimport { AnthropicVertex } from \"@anthropic-ai/vertex-sdk\";\nimport { createAnthropicChatWithClient } from \"@tanstack/ai-anthropic\";\n\nconst client = new AnthropicVertex({\n  projectId: \"my-project\",\n  region: \"europe-west1\",\n});\n\nconst adapter = createAnthropicChatWithClient(\"claude-sonnet-5\", client);\n```\n\nThe injected client must implement the Anthropic Beta Messages protocol.\nEndpoint-specific model and feature support stays the caller's job.\n\n## Example: Chat Completion\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: anthropicText(\"claude-sonnet-4-6\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Example: With Tools\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { z } from \"zod\";\n\nconst searchDatabaseDef = toolDefinition({\n  name: \"search_database\",\n  description: \"Search the database\",\n  inputSchema: z.object({\n    query: z.string(),\n  }),\n});\n\nconst searchDatabase = searchDatabaseDef.server(async ({ query }) => {\n  // Search database\n  return { results: [] };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: anthropicText(\"claude-sonnet-4-6\"),\n    messages,\n    tools: [searchDatabase],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Model Options\n\nAnthropic supports various provider-specific options. Sampling parameters live here too — `temperature`, `top_p`, and `max_tokens` — rather than as root-level props on `chat()`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    max_tokens: 4096,\n    temperature: 0.7,\n    top_p: 0.9,\n    top_k: 40,\n    stop_sequences: [\"END\"],\n  },\n});\n```\n\n> If you previously passed `temperature` / `topP` / `maxTokens` at the root of `chat()`, see [Moving Sampling Options into modelOptions](../migration/sampling-options-to-model-options).\n\n#### `max_tokens` default\n\nAnthropic's Messages API _requires_ `max_tokens` on every request, so the adapter always sends a value. When you don't set `modelOptions.max_tokens`, it defaults to the selected model's full output ceiling (`max_output_tokens` from the model metadata — e.g. 64K for Sonnet, 128K for Opus), falling back to a safe constant for unrecognized models. `max_tokens` is a ceiling, not a reservation — billing is on tokens actually generated — so this default costs nothing extra and avoids the silent mid-response truncation (`stop_reason: \"max_tokens\"`) that a low default would cause. Set `max_tokens` explicitly only when you want to _cap_ output below the model ceiling. If a response is truncated while using the default cap, the adapter logs a warning (visible with [debug logging](../advanced/debug-logging) enabled).\n\nA streamed response that stops at `max_tokens` ends in a `RUN_ERROR` with `code: 'max_tokens'`. Anthropic bills the tokens of that call, so this `RUN_ERROR` carries the `usage` of the call. The `onUsage` middleware hook fires only for `RUN_FINISHED`. To count these tokens too, read `usage` from the `RUN_ERROR` chunk, in the stream or in an `onChunk` middleware.\n\nOne exception: structured output (`chat({ outputSchema })`) on models that use the non-streaming finalization path clamps this default to ~21K tokens. The Anthropic SDK rejects a non-streaming request whose `max_tokens` could exceed its 10-minute timeout, so the full ceiling can't be used there. Streaming chat is unaffected. To raise the structured-output ceiling toward a model's true max, stream the response.\n\n### Thinking (Extended Thinking)\n\nEnable extended thinking with a token budget. This allows Claude to show its reasoning process, which is streamed as `thinking` chunks:\n\n```typescript ignore\nmodelOptions: {\n  thinking: {\n    type: \"enabled\",\n    budget_tokens: 2048, // Maximum tokens for thinking\n  },\n}\n```\n\n**Note:** `budget_tokens` must be less than `modelOptions.max_tokens` — set `max_tokens` high enough to leave room for the visible response alongside the thinking budget, or the request is rejected.\n\n### Adaptive Thinking (Claude 4.6+, Sonnet 5, Fable 5)\n\nNewer Claude models use adaptive thinking — the model decides when and how\nmuch to think, and depth is tuned with `output_config.effort` instead of a\ntoken budget:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-5\"),\n  messages: [{ role: \"user\", content: \"Plan a database migration.\" }],\n  modelOptions: {\n    thinking: { type: \"adaptive\", display: \"summarized\" },\n    output_config: { effort: \"xhigh\" },\n    max_tokens: 64_000,\n  },\n});\n```\n\nPer-model rules (enforced by the adapter's types):\n\n- **`claude-sonnet-5`, `claude-opus-4-8`, `claude-opus-4-7`** — adaptive\n  thinking with an explicit `{ type: \"disabled\" }` opt-out. The manual\n  `{ type: \"enabled\", budget_tokens }` shape is rejected with a 400, and\n  the sampling parameters (`temperature`, `top_p`, `top_k`) are not\n  accepted (on Sonnet 5 the API rejects non-default values; on Opus\n  4.7/4.8 the parameters are removed entirely).\n- **`claude-fable-5`** — thinking is always on. The only accepted explicit\n  config is `{ type: \"adaptive\" }` (both `disabled` and `budget_tokens`\n  return a 400), and sampling parameters are rejected.\n- **`claude-sonnet-5-5`** — the types accept only `{ type: \"adaptive\" }`.\n  Both `disabled` and `budget_tokens` return a 400, and so do non-default\n  sampling values. To turn off up-front thinking, the API takes\n  `{ type: \"between_tools\" }`, which the adapter does not type yet.\n- **`claude-haiku-5-5`** — adaptive thinking is the default, and the\n  types accept `{ type: \"adaptive\" }` or `{ type: \"disabled\" }`. The API\n  accepts `disabled` at `high` effort or below and returns a 400 at `xhigh`\n  and `max`; the types cannot express that, so pair it with `low`,\n  `medium`, or `high`. `{ type: \"enabled\", budget_tokens }` and non-default\n  sampling values return a 400. `effort` defaults to `medium` on this\n  model, and it takes a forced `tool_choice`.\n- **`claude-opus-4-6` / `claude-sonnet-4-6`** — accept\n  `{ type: \"adaptive\" }` alongside the deprecated\n  `{ type: \"enabled\", budget_tokens }` shape, and still accept sampling\n  parameters.\n- **`display`** defaults to `\"omitted\"` on Opus 4.7+ and the 5-generation\n  models — set `\"summarized\"` to stream the reasoning text.\n- **`effort`** accepts `\"low\" | \"medium\" | \"high\" | \"xhigh\" | \"max\"`;\n  `\"xhigh\"` is available on Claude Opus 4.7+, Claude Sonnet 5, Claude\n  Sonnet 5.5, Claude Haiku 5.5, Claude Fable 5, and Claude Fable 5.1.\n  Older models take `\"low\"`, `\"medium\"`, `\"high\"`, and, except Claude Opus\n  4.5, `\"max\"`.\n- **`output_config`** is accepted on Claude Opus 4.7, Opus 4.8, Sonnet 5,\n  Fable 5, Opus 5, Fable 5.1, Opus 5.5, Sonnet 5.5, and Haiku 5.5. When you\n  also pass an `outputSchema`, the adapter adds `output_config.format` and\n  keeps the `effort` you set.\n\n### Prompt Caching\n\nCache prompts for better performance and reduced costs:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [\n    {\n      role: \"user\",\n      content: [\n        {\n          type: \"text\",\n          content: \"What is the capital of France?\",\n          metadata: {\n            cache_control: {\n              type: \"ephemeral\",\n            },\n          },\n        },\n      ],\n    },\n  ],\n});\n```\n\n## Summarization\n\nAnthropic supports text summarization:\n\n```typescript\nimport { summarize } from \"@tanstack/ai\";\nimport { anthropicSummarize } from \"@tanstack/ai-anthropic\";\n\nconst result = await summarize({\n  adapter: anthropicSummarize(\"claude-sonnet-4-6\"),\n  text: \"Your long text to summarize...\",\n  maxLength: 100,\n  style: \"concise\", // \"concise\" | \"bullet-points\" | \"paragraph\"\n});\n\nconsole.log(result.summary);\n```\n\n## Environment Variables\n\nSet your API key in environment variables:\n\n```bash\nANTHROPIC_API_KEY=sk-ant-...\n```\n\n## API Reference\n\nEvery factory pair follows the same shape: the short factory (`anthropicText`, `anthropicSummarize`) reads `ANTHROPIC_API_KEY` from the environment, while `createAnthropicChat` / `createAnthropicSummarize` take an explicit API key. Both take `model` as the first argument. For Claude on Vertex, use `anthropicVertexText` from `@tanstack/ai-anthropic/vertex`. For any other custom transport, `createAnthropicChatWithClient` accepts an Anthropic-compatible Messages client.\n\n### `anthropicText(model, config?)` / `createAnthropicChat(model, apiKey, config?)`\n\nCreates an Anthropic chat adapter.\n\n**Parameters:**\n\n- `model` - Claude model id (e.g. `\"claude-sonnet-5\"`, `\"claude-fable-5\"`, `\"claude-opus-4-8\"`)\n- `config?.baseURL` - Custom base URL (optional)\n\n### `anthropicVertexText(model, config?)`\n\nCreates an Anthropic chat adapter on Vertex. Import it from\n`@tanstack/ai-anthropic/vertex`.\n\n**Parameters:**\n\n- `model` - Claude model id\n- `config.project` - GCP project id (optional if ADC can resolve it)\n- `config.location` - Vertex region (or set `GOOGLE_CLOUD_LOCATION`)\n\n### `createAnthropicChatWithClient(model, client)`\n\nCreates an Anthropic chat adapter using an injected client.\n\n**Parameters:**\n\n- `model` - Claude model id\n- `client` - Client exposing `beta.messages.create`\n\n### `anthropicSummarize(model, config?)` / `createAnthropicSummarize(model, apiKey, config?)`\n\nCreates an Anthropic summarization adapter.\n\n## Limitations\n\n- **Image Generation**: Anthropic does not support image generation. Use OpenAI or Gemini for image generation.\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Other Adapters](./openai) - Explore other providers\n\n## Provider Tools\n\nAnthropic exposes several native tools beyond user-defined function calls.\nImport them from `@tanstack/ai-anthropic/tools` and pass them into\n`chat({ tools: [...] })`.\n\n> For the full concept, a comparison matrix, and type-gating details, see\n> [Provider Tools](../tools/provider-tools.md).\n\n### `webSearchTool`\n\nEnables Claude to run Anthropic's native web search with inline citations.\nScope the search with `allowed_domains` or `blocked_domains` (mutually\nexclusive); set `max_uses` to cap per-turn cost.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { webSearchTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-opus-4-7\"),\n  messages: [{ role: \"user\", content: \"What's new in AI this week?\" }],\n  tools: [\n    webSearchTool({\n      name: \"web_search\",\n      type: \"web_search_20250305\",\n      max_uses: 2,\n    }),\n  ],\n});\n```\n\n**Supported models:** every registered Claude model. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `webFetchTool`\n\nLets Claude fetch the contents of a URL directly, useful when you want the\nmodel to read a specific page rather than run a search. Takes no required\narguments — pass an optional config object to override defaults.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { webFetchTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Summarise https://example.com\" }],\n  tools: [webFetchTool()],\n});\n```\n\n**Supported models:** Claude Sonnet 4.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `codeExecutionTool`\n\nGives Claude a sandboxed code-execution environment so it can run Python\nsnippets, analyse data, and return results inline. Choose the version string\nthat matches your desired API revision.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { codeExecutionTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Plot a histogram of [1,2,2,3,3,3]\" }],\n  tools: [\n    codeExecutionTool({ name: \"code_execution\", type: \"code_execution_20250825\" }),\n  ],\n});\n```\n\n**Supported models:** Claude Sonnet 4.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n#### Attaching hosted skills\n\nPass a `skills` array as the second argument to load provider-managed skill\nbundles into the sandbox. The adapter auto-lifts them into the API's\n`container.skills` param and adds the required beta headers for you.\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { codeExecutionTool } from \"@tanstack/ai-anthropic/tools\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: anthropicText(\"claude-sonnet-4-5\"),\n    messages,\n    tools: [\n      codeExecutionTool(\n        { type: \"code_execution_20250825\", name: \"code_execution\" },\n        {\n          skills: [{ type: \"anthropic\", skill_id: \"pptx\", version: \"latest\" }],\n        },\n      ),\n    ],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nFor the full reference — skill shape, constraints, scope, and the OpenAI\nequivalent — see [Provider Skills](../tools/provider-skills.md).\n\n### `computerUseTool`\n\nAllows Claude to observe a virtual desktop (screenshots) and interact with it\nvia keyboard and mouse events. Provide the screen resolution so Claude can\ncalculate accurate coordinates.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { computerUseTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Open the browser and go to example.com\" }],\n  tools: [\n    computerUseTool({\n      type: \"computer_20250124\",\n      name: \"computer\",\n      display_width_px: 1024,\n      display_height_px: 768,\n    }),\n  ],\n});\n```\n\n**Supported models:** Claude Sonnet 3.5 and above, with two exceptions. `claude-opus-5-fast` takes no provider tools. Claude Opus 5.5, Claude Sonnet 5.5, and Claude Haiku 5.5 accept only the `computer_toolset_20260801` toolset, which the adapter does not offer yet. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `bashTool`\n\nProvides Claude with a persistent bash shell session, letting it run arbitrary\ncommands, install packages, or manipulate files on the host. Choose the type\nstring that matches your API revision.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { bashTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"List all TypeScript files in src/\" }],\n  tools: [bashTool({ name: \"bash\", type: \"bash_20250124\" })],\n});\n```\n\n**Supported models:** Claude Sonnet 3.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `textEditorTool`\n\nGives Claude a structured text-editor interface for viewing and modifying files\nusing `str_replace`, `create`, `view`, and `undo_edit` commands. Choose the\ntype string for the API revision you target.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { textEditorTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Fix the bug in src/index.ts\" }],\n  tools: [\n    textEditorTool({ type: \"text_editor_20250124\", name: \"str_replace_editor\" }),\n  ],\n});\n```\n\n**Supported models:** Claude Sonnet 3.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `memoryTool`\n\nEnables Claude to store and retrieve information across conversation turns\nusing Anthropic's managed memory service. Call with no arguments to use\ndefault configuration.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { memoryTool } from \"@tanstack/ai-anthropic/tools\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Remember that I prefer metric units\" }],\n  tools: [memoryTool()],\n});\n```\n\n**Supported models:** Claude Sonnet 4.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `customTool`\n\nCreates a tool with an inline JSON Schema input definition instead of going\nthrough `toolDefinition()`. Useful when you need fine-grained control over the\nschema shape or want to add `cache_control`. Unlike branded provider tools,\n`customTool` returns a plain `Tool` and is accepted by any chat model.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { anthropicText } from \"@tanstack/ai-anthropic\";\nimport { customTool } from \"@tanstack/ai-anthropic/tools\";\nimport { z } from \"zod\";\n\nconst stream = chat({\n  adapter: anthropicText(\"claude-sonnet-4-6\"),\n  messages: [{ role: \"user\", content: \"Look up user 42\" }],\n  tools: [\n    customTool(\n      \"lookup_user\",\n      \"Look up a user by ID and return their profile\",\n      z.object({ userId: z.number() }),\n    ),\n  ],\n});\n```\n\n**Supported models:** all current Claude models. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n"}
