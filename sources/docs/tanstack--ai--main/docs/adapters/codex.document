NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The Codex adapter runs "},{"type":"link","href":"https://developers.openai.com/codex","children":[{"type":"text","value":"OpenAI Codex"}]},{"type":"text","value":" (via the "},{"type":"inlineCode","value":"@openai/codex-sdk"},{"type":"text","value":") as a chat backend. Unlike HTTP provider adapters, this is a "},{"type":"strong","children":[{"type":"text","value":"harness adapter"}]},{"type":"text","value":": Codex runs its own agent loop and executes its own tools — shell commands, file changes, web search — locally on your server, inside its sandbox. Each "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" call runs one full harness turn; the harness's tool activity streams back as already-resolved tool-call events your UI can render."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server-only."}]},{"type":"text","value":" The harness spawns the Codex runtime (bundled with the SDK) as a subprocess, so this adapter only works in a Node.js server environment — never in the browser. The sandbox mode is the safety boundary; configure it deliberately."}]}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-codex\"]],\"vue\":[[\"@tanstack/ai-codex\"]],\"solid\":[[\"@tanstack/ai-codex\"]],\"svelte\":[[\"@tanstack/ai-codex\"]],\"preact\":[[\"@tanstack/ai-codex\"]],\"angular\":[[\"@tanstack/ai-codex\"]],\"vanilla\":[[\"@tanstack/ai-codex\"]],\"octane\":[[\"@tanstack/ai-codex\"]]},\"mode\":\"install\"}"}},{"type":"paragraph","children":[{"type":"text","value":"A runnable demo lives at "},{"type":"link","href":"https://github.com/TanStack/ai/tree/main/examples/sandbox-cloudflare","children":[{"type":"inlineCode","value":"examples/sandbox-cloudflare"}]},{"type":"text","value":" — pick Claude Code, Codex, or Grok Build in the UI, with session resume, the harness tool timeline, and tool bridging, wired into a TanStack Start app on Workers. For the same wiring on plain Node with durable, refresh-surviving runs (Claude Code on Docker), see "},{"type":"link","href":"https://github.com/TanStack/ai/tree/main/examples/sandbox-web","children":[{"type":"inlineCode","value":"examples/sandbox-web"}]},{"type":"text","value":" — swapping in this adapter is a one-line change ("},{"type":"inlineCode","value":"src/sandbox-agent.ts"},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"authentication","children":[{"type":"text","value":"Authentication"}]},{"type":"paragraph","children":[{"type":"text","value":"Your laptop can already have "},{"type":"inlineCode","value":"codex login"},{"type":"text","value":". A CI runner only has\n"},{"type":"inlineCode","value":"CODEX_API_KEY"},{"type":"text","value":". The default "},{"type":"inlineCode","value":"authMode"},{"type":"text","value":" is "},{"type":"inlineCode","value":"'api-key'"},{"type":"text","value":". Set "},{"type":"inlineCode","value":"'host'"},{"type":"text","value":" when\nyou want "},{"type":"inlineCode","value":"codex login"},{"type":"text","value":". See "},{"type":"link","href":"../sandbox/auth","children":[{"type":"text","value":"Harness Auth"}]},{"type":"text","value":"."}]},{"type":"code","value":"import { codexText } from \"@tanstack/ai-codex\"\n\ncodexText(\"gpt-5.5\")\ncodexText(\"gpt-5.5\", { authMode: \"host\" })","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"'api-key'"},{"type":"text","value":" (default): expect "},{"type":"inlineCode","value":"CODEX_API_KEY"},{"type":"text","value":" (or pass "},{"type":"inlineCode","value":"apiKey"},{"type":"text","value":")."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"'host'"},{"type":"text","value":": use "},{"type":"inlineCode","value":"codex login"},{"type":"text","value":". Do not inject "},{"type":"inlineCode","value":"CODEX_API_KEY"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { codexText } from \"@tanstack/ai-codex\";\n\nconst stream = chat({\n  adapter: codexText(\"gpt-5.1-codex\", {\n    cwd: \"/path/to/project\",\n    sandboxMode: \"workspace-write\",\n  }),\n  messages: [{ role: \"user\", content: \"Fix the failing test in utils.test.ts\" }],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"configuration","children":[{"type":"text","value":"Configuration"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"cwd"}]},{"type":"tableCell","children":[{"type":"text","value":"Working directory for the harness session. Defaults to "},{"type":"inlineCode","value":"process.cwd()"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"sandboxMode"}]},{"type":"tableCell","children":[{"type":"text","value":"Codex sandbox: "},{"type":"inlineCode","value":"'read-only'"},{"type":"text","value":", "},{"type":"inlineCode","value":"'workspace-write'"},{"type":"text","value":", or "},{"type":"inlineCode","value":"'danger-full-access'"},{"type":"text","value":". Default is "},{"type":"inlineCode","value":"'workspace-write'"},{"type":"text","value":" on local-process and Docker. Default is "},{"type":"inlineCode","value":"'danger-full-access'"},{"type":"text","value":" on Daytona and Cloudflare, because those providers cannot create a nested bubblewrap namespace. Isolation is then the outer VM plus "},{"type":"inlineCode","value":"defineSandboxPolicy"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"approvalPolicy"}]},{"type":"tableCell","children":[{"type":"text","value":"Codex approval policy. Defaults to "},{"type":"inlineCode","value":"'never'"},{"type":"text","value":" — headless runs have no approval UI, so anything else can stall a turn."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"modelReasoningEffort"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'minimal'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'low'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'medium'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'high'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'xhigh'"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"skipGitRepoCheck"}]},{"type":"tableCell","children":[{"type":"text","value":"Skip the harness's git-repo safety check. Defaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" (server adapters routinely point at scratch directories)."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"networkAccessEnabled"}]},{"type":"tableCell","children":[{"type":"text","value":"Allow network access inside the "},{"type":"inlineCode","value":"workspace-write"},{"type":"text","value":" sandbox."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"webSearchMode"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'disabled'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'cached'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'live'"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"additionalDirectories"}]},{"type":"tableCell","children":[{"type":"text","value":"Extra writable directories beyond "},{"type":"inlineCode","value":"cwd"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"authMode"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'api-key'"},{"type":"text","value":" (default) expects "},{"type":"inlineCode","value":"CODEX_API_KEY"},{"type":"text","value":". "},{"type":"inlineCode","value":"'host'"},{"type":"text","value":" uses "},{"type":"inlineCode","value":"codex login"},{"type":"text","value":". See "},{"type":"link","href":"../sandbox/auth","children":[{"type":"text","value":"Harness Auth"}]},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"apiKey"}]},{"type":"tableCell","children":[{"type":"text","value":"OpenAI API key for the harness subprocess."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"baseUrl"}]},{"type":"tableCell","children":[{"type":"text","value":"Override the Codex backend base URL."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"codexPathOverride"}]},{"type":"tableCell","children":[{"type":"text","value":"Use a specific codex executable instead of the SDK's bundled binary."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"env"}]},{"type":"tableCell","children":[{"type":"text","value":"Environment variables for the subprocess. When set, "},{"type":"inlineCode","value":"process.env"},{"type":"text","value":" is "},{"type":"strong","children":[{"type":"text","value":"not"}]},{"type":"text","value":" inherited (Codex SDK semantics)."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"config"}]},{"type":"tableCell","children":[{"type":"text","value":"Extra "},{"type":"inlineCode","value":"--config key=value"},{"type":"text","value":" overrides passed to the Codex CLI (e.g. additional "},{"type":"inlineCode","value":"mcp_servers"},{"type":"text","value":" entries)."}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Per-call overrides go through "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":": "},{"type":"inlineCode","value":"sessionId"},{"type":"text","value":", "},{"type":"inlineCode","value":"sandboxMode"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"approvalPolicy"},{"type":"text","value":", "},{"type":"inlineCode","value":"modelReasoningEffort"},{"type":"text","value":", "},{"type":"inlineCode","value":"workingDirectory"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"skipGitRepoCheck"},{"type":"text","value":", and "},{"type":"inlineCode","value":"authMode"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"stateful-sessions","children":[{"type":"text","value":"Stateful Sessions"}]},{"type":"paragraph","children":[{"type":"text","value":"Codex threads are stateful — the harness keeps the full working context (files read, commands run, conclusions reached) between turns. The adapter surfaces the thread id of every fresh run as a custom stream event named "},{"type":"inlineCode","value":"codex.session-id"},{"type":"text","value":"; thread it back via "},{"type":"inlineCode","value":"modelOptions.sessionId"},{"type":"text","value":" to resume. When resuming, only the latest user message is sent — the harness already holds the prior context."}]},{"type":"paragraph","children":[{"type":"text","value":"Server endpoint:"}]},{"type":"code","value":"import {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { codexText } from \"@tanstack/ai-codex\";\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request);\n\n  // Extra fields the client puts in the connection `body` arrive here.\n  const sessionId =\n    typeof params.forwardedProps.sessionId === \"string\"\n      ? params.forwardedProps.sessionId\n      : undefined;\n\n  const stream = chat({\n    adapter: codexText(\"gpt-5.1-codex\", {\n      cwd: \"/path/to/project\",\n      sandboxMode: \"workspace-write\",\n    }),\n    messages: params.messages,\n    modelOptions: { sessionId },\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Client (React) — capture the session id from the custom event and send it back on subsequent requests:"}]},{"type":"code","value":"import { useState } from \"react\";\nimport { useChat } from \"@tanstack/ai-react\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\nfunction CodingAssistant() {\n  const [sessionId, setSessionId] = useState<string | undefined>(undefined);\n\n  const { messages, sendMessage } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\", () => ({\n      body: { sessionId },\n    })),\n    onCustomEvent: (name, value) => {\n      if (\n        name === \"codex.session-id\" &&\n        typeof value === \"object\" &&\n        value !== null &&\n        \"sessionId\" in value &&\n        typeof value.sessionId === \"string\"\n      ) {\n        setSessionId(value.sessionId);\n      }\n    },\n  });\n\n  // ... render messages; harness tool activity (command_execution,\n  // file_change, ...) arrives as regular tool-call parts with results.\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Sessions are stored on the machine that ran them ("},{"type":"inlineCode","value":"~/.codex/sessions/"},{"type":"text","value":"), so resuming only works on the same server instance."}]},{"type":"heading","depth":2,"id":"tools","children":[{"type":"text","value":"Tools"}]},{"type":"paragraph","children":[{"type":"text","value":"Two kinds of tools flow through this adapter:"}]},{"type":"list","ordered":true,"start":1,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Built-in harness tools"}]},{"type":"text","value":" are executed by Codex itself and stream back as tool-call events with results already attached: "},{"type":"inlineCode","value":"command_execution"},{"type":"text","value":" (shell), "},{"type":"inlineCode","value":"file_change"},{"type":"text","value":" (patches), "},{"type":"inlineCode","value":"web_search"},{"type":"text","value":", and "},{"type":"inlineCode","value":"todo_list"},{"type":"text","value":" (the agent's running plan). Your code never executes them."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Your TanStack tools"}]},{"type":"text","value":" are bridged "},{"type":"emphasis","children":[{"type":"text","value":"into"}]},{"type":"text","value":" the harness: the adapter starts a short-lived Streamable-HTTP MCP server on "},{"type":"inlineCode","value":"127.0.0.1"},{"type":"text","value":" for the duration of the turn and points Codex at it. Define tools as usual with "},{"type":"inlineCode","value":"toolDefinition().server()"},{"type":"text","value":"; tool-call events come back under the names you registered."}]}]}]},{"type":"code","value":"import { z } from \"zod\";\nimport { chat, toolDefinition } from \"@tanstack/ai\";\nimport { codexText } from \"@tanstack/ai-codex\";\n\nconst lookupTicket = toolDefinition({\n  name: \"lookup_ticket\",\n  description: \"Look up an issue ticket by id\",\n  inputSchema: z.object({ ticketId: z.string() }),\n}).server(async ({ ticketId }) => {\n  return { ticketId, status: \"open\", title: \"Crash on startup\" };\n});\n\nconst stream = chat({\n  adapter: codexText(\"gpt-5.1-codex\"),\n  messages: [{ role: \"user\", content: \"What's the status of ticket T-123?\" }],\n  tools: [lookupTicket],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Client-side and approval-gated tools are not supported."}]},{"type":"text","value":" The harness executes tools inside a live subprocess, which cannot pause across HTTP requests to wait for a browser round-trip or a human approval. Passing a tool without a server "},{"type":"inlineCode","value":"execute()"},{"type":"text","value":" implementation — or one marked "},{"type":"inlineCode","value":"needsApproval"},{"type":"text","value":" — fails fast with a descriptive error. Run those tools outside the harness with a regular provider adapter."}]},{"type":"heading","depth":2,"id":"structured-output","children":[{"type":"text","value":"Structured Output"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":" on "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":". Codex runs one harness turn and constrains the last message with "},{"type":"inlineCode","value":"--output-schema"},{"type":"text","value":". Tool activity and assistant text stream as Codex writes them. The last message is also parsed as the schema object and arrives as "},{"type":"inlineCode","value":"structured-output.complete"},{"type":"text","value":"."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\"\nimport { codexText } from \"@tanstack/ai-codex\"\nimport { defineSandbox, withSandbox } from \"@tanstack/ai-sandbox\"\nimport { dockerSandbox } from \"@tanstack/ai-sandbox-docker\"\nimport { z } from \"zod\"\n\nconst Report = z.object({\n  summary: z.string(),\n  filesChanged: z.array(z.string()),\n})\n\nconst sandbox = defineSandbox({\n  id: \"repo-report\",\n  provider: dockerSandbox({ image: \"node:22\" }),\n})\n\nconst report = await chat({\n  adapter: codexText(\"gpt-5.3-codex\"),\n  messages: [{ role: \"user\", content: \"Review this repo.\" }],\n  outputSchema: Report,\n  middleware: [withSandbox(sandbox)],\n})\n\nreport.summary","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"On the client, pass the same schema to "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" and read "},{"type":"inlineCode","value":"final"},{"type":"text","value":". "},{"type":"inlineCode","value":"partial"},{"type":"text","value":" stays empty until the end."}]},{"type":"code","value":"import { fetchServerSentEvents, useChat } from \"@tanstack/ai-react\"\nimport { z } from \"zod\"\n\nconst Report = z.object({\n  summary: z.string(),\n  filesChanged: z.array(z.string()),\n})\n\nfunction ReportView() {\n  const { final, isLoading } = useChat({\n    connection: fetchServerSentEvents(\"/api/repo-report\"),\n    outputSchema: Report,\n  })\n\n  if (isLoading) return <p>The agent is inspecting the repo.</p>\n  if (!final) return null\n  return <p>{final.summary}</p>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If you only need to extract JSON from a prompt and do not need a sandbox, use "},{"type":"inlineCode","value":"@tanstack/ai-openai"},{"type":"text","value":". That path is faster."}]},{"type":"paragraph","children":[{"type":"text","value":"Full walkthrough, including the client: "},{"type":"link","href":"../structured-outputs/harnesses","children":[{"type":"text","value":"Harness Agents"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"limitations","children":[{"type":"text","value":"Limitations"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"No token-level text streaming."}]},{"type":"text","value":" The Codex SDK reports assistant text and reasoning only as completed items, so text arrives message-at-a-time. Tool activity (commands starting/finishing) still streams live, which keeps the UI feeling alive during long turns."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server-only (Node)."}]},{"type":"text","value":" The harness spawns a subprocess."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"The harness owns the agent loop."}]},{"type":"text","value":" TanStack's agent-loop strategies and per-iteration middleware don't apply inside a harness turn."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"No sampling controls."}]},{"type":"text","value":" "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":"-style options don't exist here."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Sessions are machine-local."}]},{"type":"text","value":" Resume requires hitting the same server instance."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Cold starts."}]},{"type":"text","value":" Each call spawns a harness turn; expect higher first-token latency than HTTP adapters."}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"authentication","text":"Authentication","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"configuration","text":"Configuration","level":2},{"id":"stateful-sessions","text":"Stateful Sessions","level":2},{"id":"tools","text":"Tools","level":2},{"id":"structured-output","text":"Structured Output","level":2},{"id":"limitations","text":"Limitations","level":2}]},"frameworks":["react","vue","solid","svelte","preact","angular","vanilla","octane"],"downloadMarkdown":"\nThe Codex adapter runs [OpenAI Codex](https://developers.openai.com/codex) (via the `@openai/codex-sdk`) as a chat backend. Unlike HTTP provider adapters, this is a **harness adapter**: Codex runs its own agent loop and executes its own tools — shell commands, file changes, web search — locally on your server, inside its sandbox. Each `chat()` call runs one full harness turn; the harness's tool activity streams back as already-resolved tool-call events your UI can render.\n\n> **Server-only.** The harness spawns the Codex runtime (bundled with the SDK) as a subprocess, so this adapter only works in a Node.js server environment — never in the browser. The sandbox mode is the safety boundary; configure it deliberately.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-codex\nvue: @tanstack/ai-codex\nsolid: @tanstack/ai-codex\nsvelte: @tanstack/ai-codex\npreact: @tanstack/ai-codex\nangular: @tanstack/ai-codex\nvanilla: @tanstack/ai-codex\noctane: @tanstack/ai-codex\n\n<!-- ::end:tabs -->\n\nA runnable demo lives at [`examples/sandbox-cloudflare`](https://github.com/TanStack/ai/tree/main/examples/sandbox-cloudflare) — pick Claude Code, Codex, or Grok Build in the UI, with session resume, the harness tool timeline, and tool bridging, wired into a TanStack Start app on Workers. For the same wiring on plain Node with durable, refresh-surviving runs (Claude Code on Docker), see [`examples/sandbox-web`](https://github.com/TanStack/ai/tree/main/examples/sandbox-web) — swapping in this adapter is a one-line change (`src/sandbox-agent.ts`).\n\n## Authentication\n\nYour laptop can already have `codex login`. A CI runner only has\n`CODEX_API_KEY`. The default `authMode` is `'api-key'`. Set `'host'` when\nyou want `codex login`. See [Harness Auth](../sandbox/auth).\n\n```ts\nimport { codexText } from \"@tanstack/ai-codex\"\n\ncodexText(\"gpt-5.5\")\ncodexText(\"gpt-5.5\", { authMode: \"host\" })\n```\n\n- `'api-key'` (default): expect `CODEX_API_KEY` (or pass `apiKey`).\n- `'host'`: use `codex login`. Do not inject `CODEX_API_KEY`.\n\n## Basic Usage\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { codexText } from \"@tanstack/ai-codex\";\n\nconst stream = chat({\n  adapter: codexText(\"gpt-5.1-codex\", {\n    cwd: \"/path/to/project\",\n    sandboxMode: \"workspace-write\",\n  }),\n  messages: [{ role: \"user\", content: \"Fix the failing test in utils.test.ts\" }],\n});\n```\n\n## Configuration\n\n| Option                 | Description                                                                                                                                  |\n| ---------------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `cwd`                  | Working directory for the harness session. Defaults to `process.cwd()`.                                                                       |\n| `sandboxMode`          | Codex sandbox: `'read-only'`, `'workspace-write'`, or `'danger-full-access'`. Default is `'workspace-write'` on local-process and Docker. Default is `'danger-full-access'` on Daytona and Cloudflare, because those providers cannot create a nested bubblewrap namespace. Isolation is then the outer VM plus `defineSandboxPolicy`. |\n| `approvalPolicy`       | Codex approval policy. Defaults to `'never'` — headless runs have no approval UI, so anything else can stall a turn.                           |\n| `modelReasoningEffort` | `'minimal'` \\| `'low'` \\| `'medium'` \\| `'high'` \\| `'xhigh'`.                                                                                 |\n| `skipGitRepoCheck`     | Skip the harness's git-repo safety check. Defaults to `true` (server adapters routinely point at scratch directories).                         |\n| `networkAccessEnabled` | Allow network access inside the `workspace-write` sandbox.                                                                                     |\n| `webSearchMode`        | `'disabled'` \\| `'cached'` \\| `'live'`.                                                                                                        |\n| `additionalDirectories`| Extra writable directories beyond `cwd`.                                                                                                       |\n| `authMode`             | `'api-key'` (default) expects `CODEX_API_KEY`. `'host'` uses `codex login`. See [Harness Auth](../sandbox/auth).                                |\n| `apiKey`               | OpenAI API key for the harness subprocess.                                                                                                     |\n| `baseUrl`              | Override the Codex backend base URL.                                                                                                           |\n| `codexPathOverride`    | Use a specific codex executable instead of the SDK's bundled binary.                                                                           |\n| `env`                  | Environment variables for the subprocess. When set, `process.env` is **not** inherited (Codex SDK semantics).                                  |\n| `config`               | Extra `--config key=value` overrides passed to the Codex CLI (e.g. additional `mcp_servers` entries).                                          |\n\nPer-call overrides go through `modelOptions`: `sessionId`, `sandboxMode`,\n`approvalPolicy`, `modelReasoningEffort`, `workingDirectory`,\n`skipGitRepoCheck`, and `authMode`.\n\n## Stateful Sessions\n\nCodex threads are stateful — the harness keeps the full working context (files read, commands run, conclusions reached) between turns. The adapter surfaces the thread id of every fresh run as a custom stream event named `codex.session-id`; thread it back via `modelOptions.sessionId` to resume. When resuming, only the latest user message is sent — the harness already holds the prior context.\n\nServer endpoint:\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { codexText } from \"@tanstack/ai-codex\";\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request);\n\n  // Extra fields the client puts in the connection `body` arrive here.\n  const sessionId =\n    typeof params.forwardedProps.sessionId === \"string\"\n      ? params.forwardedProps.sessionId\n      : undefined;\n\n  const stream = chat({\n    adapter: codexText(\"gpt-5.1-codex\", {\n      cwd: \"/path/to/project\",\n      sandboxMode: \"workspace-write\",\n    }),\n    messages: params.messages,\n    modelOptions: { sessionId },\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nClient (React) — capture the session id from the custom event and send it back on subsequent requests:\n\n```typescript\nimport { useState } from \"react\";\nimport { useChat } from \"@tanstack/ai-react\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\nfunction CodingAssistant() {\n  const [sessionId, setSessionId] = useState<string | undefined>(undefined);\n\n  const { messages, sendMessage } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\", () => ({\n      body: { sessionId },\n    })),\n    onCustomEvent: (name, value) => {\n      if (\n        name === \"codex.session-id\" &&\n        typeof value === \"object\" &&\n        value !== null &&\n        \"sessionId\" in value &&\n        typeof value.sessionId === \"string\"\n      ) {\n        setSessionId(value.sessionId);\n      }\n    },\n  });\n\n  // ... render messages; harness tool activity (command_execution,\n  // file_change, ...) arrives as regular tool-call parts with results.\n}\n```\n\nSessions are stored on the machine that ran them (`~/.codex/sessions/`), so resuming only works on the same server instance.\n\n## Tools\n\nTwo kinds of tools flow through this adapter:\n\n1. **Built-in harness tools** are executed by Codex itself and stream back as tool-call events with results already attached: `command_execution` (shell), `file_change` (patches), `web_search`, and `todo_list` (the agent's running plan). Your code never executes them.\n\n2. **Your TanStack tools** are bridged *into* the harness: the adapter starts a short-lived Streamable-HTTP MCP server on `127.0.0.1` for the duration of the turn and points Codex at it. Define tools as usual with `toolDefinition().server()`; tool-call events come back under the names you registered.\n\n```typescript\nimport { z } from \"zod\";\nimport { chat, toolDefinition } from \"@tanstack/ai\";\nimport { codexText } from \"@tanstack/ai-codex\";\n\nconst lookupTicket = toolDefinition({\n  name: \"lookup_ticket\",\n  description: \"Look up an issue ticket by id\",\n  inputSchema: z.object({ ticketId: z.string() }),\n}).server(async ({ ticketId }) => {\n  return { ticketId, status: \"open\", title: \"Crash on startup\" };\n});\n\nconst stream = chat({\n  adapter: codexText(\"gpt-5.1-codex\"),\n  messages: [{ role: \"user\", content: \"What's the status of ticket T-123?\" }],\n  tools: [lookupTicket],\n});\n```\n\n**Client-side and approval-gated tools are not supported.** The harness executes tools inside a live subprocess, which cannot pause across HTTP requests to wait for a browser round-trip or a human approval. Passing a tool without a server `execute()` implementation — or one marked `needsApproval` — fails fast with a descriptive error. Run those tools outside the harness with a regular provider adapter.\n\n## Structured Output\n\nPass `outputSchema` on `chat()`. Codex runs one harness turn and constrains the last message with `--output-schema`. Tool activity and assistant text stream as Codex writes them. The last message is also parsed as the schema object and arrives as `structured-output.complete`.\n\n```ts\nimport { chat } from \"@tanstack/ai\"\nimport { codexText } from \"@tanstack/ai-codex\"\nimport { defineSandbox, withSandbox } from \"@tanstack/ai-sandbox\"\nimport { dockerSandbox } from \"@tanstack/ai-sandbox-docker\"\nimport { z } from \"zod\"\n\nconst Report = z.object({\n  summary: z.string(),\n  filesChanged: z.array(z.string()),\n})\n\nconst sandbox = defineSandbox({\n  id: \"repo-report\",\n  provider: dockerSandbox({ image: \"node:22\" }),\n})\n\nconst report = await chat({\n  adapter: codexText(\"gpt-5.3-codex\"),\n  messages: [{ role: \"user\", content: \"Review this repo.\" }],\n  outputSchema: Report,\n  middleware: [withSandbox(sandbox)],\n})\n\nreport.summary\n```\n\nOn the client, pass the same schema to `useChat` and read `final`. `partial` stays empty until the end.\n\n```tsx\nimport { fetchServerSentEvents, useChat } from \"@tanstack/ai-react\"\nimport { z } from \"zod\"\n\nconst Report = z.object({\n  summary: z.string(),\n  filesChanged: z.array(z.string()),\n})\n\nfunction ReportView() {\n  const { final, isLoading } = useChat({\n    connection: fetchServerSentEvents(\"/api/repo-report\"),\n    outputSchema: Report,\n  })\n\n  if (isLoading) return <p>The agent is inspecting the repo.</p>\n  if (!final) return null\n  return <p>{final.summary}</p>\n}\n```\n\nIf you only need to extract JSON from a prompt and do not need a sandbox, use `@tanstack/ai-openai`. That path is faster.\n\nFull walkthrough, including the client: [Harness Agents](../structured-outputs/harnesses).\n\n## Limitations\n\n- **No token-level text streaming.** The Codex SDK reports assistant text and reasoning only as completed items, so text arrives message-at-a-time. Tool activity (commands starting/finishing) still streams live, which keeps the UI feeling alive during long turns.\n- **Server-only (Node).** The harness spawns a subprocess.\n- **The harness owns the agent loop.** TanStack's agent-loop strategies and per-iteration middleware don't apply inside a harness turn.\n- **No sampling controls.** `temperature`-style options don't exist here.\n- **Sessions are machine-local.** Resume requires hitting the same server instance.\n- **Cold starts.** Each call spawns a harness turn; expect higher first-token latency than HTTP adapters.\n","originalRawMarkdown":"---\ntitle: Codex\nid: codex-adapter\norder: 12\ndescription: \"Use OpenAI Codex as a chat backend in TanStack AI — agent harness with local tool execution, stateful coding sessions, and tool bridging via @tanstack/ai-codex.\"\nkeywords:\n  - tanstack ai\n  - codex\n  - codex sdk\n  - openai\n  - harness\n  - agent\n  - coding agent\n  - adapter\n---\n\nThe Codex adapter runs [OpenAI Codex](https://developers.openai.com/codex) (via the `@openai/codex-sdk`) as a chat backend. Unlike HTTP provider adapters, this is a **harness adapter**: Codex runs its own agent loop and executes its own tools — shell commands, file changes, web search — locally on your server, inside its sandbox. Each `chat()` call runs one full harness turn; the harness's tool activity streams back as already-resolved tool-call events your UI can render.\n\n> **Server-only.** The harness spawns the Codex runtime (bundled with the SDK) as a subprocess, so this adapter only works in a Node.js server environment — never in the browser. The sandbox mode is the safety boundary; configure it deliberately.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-codex\nvue: @tanstack/ai-codex\nsolid: @tanstack/ai-codex\nsvelte: @tanstack/ai-codex\npreact: @tanstack/ai-codex\nangular: @tanstack/ai-codex\nvanilla: @tanstack/ai-codex\noctane: @tanstack/ai-codex\n\n<!-- ::end:tabs -->\n\nA runnable demo lives at [`examples/sandbox-cloudflare`](https://github.com/TanStack/ai/tree/main/examples/sandbox-cloudflare) — pick Claude Code, Codex, or Grok Build in the UI, with session resume, the harness tool timeline, and tool bridging, wired into a TanStack Start app on Workers. For the same wiring on plain Node with durable, refresh-surviving runs (Claude Code on Docker), see [`examples/sandbox-web`](https://github.com/TanStack/ai/tree/main/examples/sandbox-web) — swapping in this adapter is a one-line change (`src/sandbox-agent.ts`).\n\n## Authentication\n\nYour laptop can already have `codex login`. A CI runner only has\n`CODEX_API_KEY`. The default `authMode` is `'api-key'`. Set `'host'` when\nyou want `codex login`. See [Harness Auth](../sandbox/auth).\n\n```ts\nimport { codexText } from \"@tanstack/ai-codex\"\n\ncodexText(\"gpt-5.5\")\ncodexText(\"gpt-5.5\", { authMode: \"host\" })\n```\n\n- `'api-key'` (default): expect `CODEX_API_KEY` (or pass `apiKey`).\n- `'host'`: use `codex login`. Do not inject `CODEX_API_KEY`.\n\n## Basic Usage\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { codexText } from \"@tanstack/ai-codex\";\n\nconst stream = chat({\n  adapter: codexText(\"gpt-5.1-codex\", {\n    cwd: \"/path/to/project\",\n    sandboxMode: \"workspace-write\",\n  }),\n  messages: [{ role: \"user\", content: \"Fix the failing test in utils.test.ts\" }],\n});\n```\n\n## Configuration\n\n| Option                 | Description                                                                                                                                  |\n| ---------------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `cwd`                  | Working directory for the harness session. Defaults to `process.cwd()`.                                                                       |\n| `sandboxMode`          | Codex sandbox: `'read-only'`, `'workspace-write'`, or `'danger-full-access'`. Default is `'workspace-write'` on local-process and Docker. Default is `'danger-full-access'` on Daytona and Cloudflare, because those providers cannot create a nested bubblewrap namespace. Isolation is then the outer VM plus `defineSandboxPolicy`. |\n| `approvalPolicy`       | Codex approval policy. Defaults to `'never'` — headless runs have no approval UI, so anything else can stall a turn.                           |\n| `modelReasoningEffort` | `'minimal'` \\| `'low'` \\| `'medium'` \\| `'high'` \\| `'xhigh'`.                                                                                 |\n| `skipGitRepoCheck`     | Skip the harness's git-repo safety check. Defaults to `true` (server adapters routinely point at scratch directories).                         |\n| `networkAccessEnabled` | Allow network access inside the `workspace-write` sandbox.                                                                                     |\n| `webSearchMode`        | `'disabled'` \\| `'cached'` \\| `'live'`.                                                                                                        |\n| `additionalDirectories`| Extra writable directories beyond `cwd`.                                                                                                       |\n| `authMode`             | `'api-key'` (default) expects `CODEX_API_KEY`. `'host'` uses `codex login`. See [Harness Auth](../sandbox/auth).                                |\n| `apiKey`               | OpenAI API key for the harness subprocess.                                                                                                     |\n| `baseUrl`              | Override the Codex backend base URL.                                                                                                           |\n| `codexPathOverride`    | Use a specific codex executable instead of the SDK's bundled binary.                                                                           |\n| `env`                  | Environment variables for the subprocess. When set, `process.env` is **not** inherited (Codex SDK semantics).                                  |\n| `config`               | Extra `--config key=value` overrides passed to the Codex CLI (e.g. additional `mcp_servers` entries).                                          |\n\nPer-call overrides go through `modelOptions`: `sessionId`, `sandboxMode`,\n`approvalPolicy`, `modelReasoningEffort`, `workingDirectory`,\n`skipGitRepoCheck`, and `authMode`.\n\n## Stateful Sessions\n\nCodex threads are stateful — the harness keeps the full working context (files read, commands run, conclusions reached) between turns. The adapter surfaces the thread id of every fresh run as a custom stream event named `codex.session-id`; thread it back via `modelOptions.sessionId` to resume. When resuming, only the latest user message is sent — the harness already holds the prior context.\n\nServer endpoint:\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { codexText } from \"@tanstack/ai-codex\";\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request);\n\n  // Extra fields the client puts in the connection `body` arrive here.\n  const sessionId =\n    typeof params.forwardedProps.sessionId === \"string\"\n      ? params.forwardedProps.sessionId\n      : undefined;\n\n  const stream = chat({\n    adapter: codexText(\"gpt-5.1-codex\", {\n      cwd: \"/path/to/project\",\n      sandboxMode: \"workspace-write\",\n    }),\n    messages: params.messages,\n    modelOptions: { sessionId },\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nClient (React) — capture the session id from the custom event and send it back on subsequent requests:\n\n```typescript\nimport { useState } from \"react\";\nimport { useChat } from \"@tanstack/ai-react\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\nfunction CodingAssistant() {\n  const [sessionId, setSessionId] = useState<string | undefined>(undefined);\n\n  const { messages, sendMessage } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\", () => ({\n      body: { sessionId },\n    })),\n    onCustomEvent: (name, value) => {\n      if (\n        name === \"codex.session-id\" &&\n        typeof value === \"object\" &&\n        value !== null &&\n        \"sessionId\" in value &&\n        typeof value.sessionId === \"string\"\n      ) {\n        setSessionId(value.sessionId);\n      }\n    },\n  });\n\n  // ... render messages; harness tool activity (command_execution,\n  // file_change, ...) arrives as regular tool-call parts with results.\n}\n```\n\nSessions are stored on the machine that ran them (`~/.codex/sessions/`), so resuming only works on the same server instance.\n\n## Tools\n\nTwo kinds of tools flow through this adapter:\n\n1. **Built-in harness tools** are executed by Codex itself and stream back as tool-call events with results already attached: `command_execution` (shell), `file_change` (patches), `web_search`, and `todo_list` (the agent's running plan). Your code never executes them.\n\n2. **Your TanStack tools** are bridged *into* the harness: the adapter starts a short-lived Streamable-HTTP MCP server on `127.0.0.1` for the duration of the turn and points Codex at it. Define tools as usual with `toolDefinition().server()`; tool-call events come back under the names you registered.\n\n```typescript\nimport { z } from \"zod\";\nimport { chat, toolDefinition } from \"@tanstack/ai\";\nimport { codexText } from \"@tanstack/ai-codex\";\n\nconst lookupTicket = toolDefinition({\n  name: \"lookup_ticket\",\n  description: \"Look up an issue ticket by id\",\n  inputSchema: z.object({ ticketId: z.string() }),\n}).server(async ({ ticketId }) => {\n  return { ticketId, status: \"open\", title: \"Crash on startup\" };\n});\n\nconst stream = chat({\n  adapter: codexText(\"gpt-5.1-codex\"),\n  messages: [{ role: \"user\", content: \"What's the status of ticket T-123?\" }],\n  tools: [lookupTicket],\n});\n```\n\n**Client-side and approval-gated tools are not supported.** The harness executes tools inside a live subprocess, which cannot pause across HTTP requests to wait for a browser round-trip or a human approval. Passing a tool without a server `execute()` implementation — or one marked `needsApproval` — fails fast with a descriptive error. Run those tools outside the harness with a regular provider adapter.\n\n## Structured Output\n\nPass `outputSchema` on `chat()`. Codex runs one harness turn and constrains the last message with `--output-schema`. Tool activity and assistant text stream as Codex writes them. The last message is also parsed as the schema object and arrives as `structured-output.complete`.\n\n```ts\nimport { chat } from \"@tanstack/ai\"\nimport { codexText } from \"@tanstack/ai-codex\"\nimport { defineSandbox, withSandbox } from \"@tanstack/ai-sandbox\"\nimport { dockerSandbox } from \"@tanstack/ai-sandbox-docker\"\nimport { z } from \"zod\"\n\nconst Report = z.object({\n  summary: z.string(),\n  filesChanged: z.array(z.string()),\n})\n\nconst sandbox = defineSandbox({\n  id: \"repo-report\",\n  provider: dockerSandbox({ image: \"node:22\" }),\n})\n\nconst report = await chat({\n  adapter: codexText(\"gpt-5.3-codex\"),\n  messages: [{ role: \"user\", content: \"Review this repo.\" }],\n  outputSchema: Report,\n  middleware: [withSandbox(sandbox)],\n})\n\nreport.summary\n```\n\nOn the client, pass the same schema to `useChat` and read `final`. `partial` stays empty until the end.\n\n```tsx\nimport { fetchServerSentEvents, useChat } from \"@tanstack/ai-react\"\nimport { z } from \"zod\"\n\nconst Report = z.object({\n  summary: z.string(),\n  filesChanged: z.array(z.string()),\n})\n\nfunction ReportView() {\n  const { final, isLoading } = useChat({\n    connection: fetchServerSentEvents(\"/api/repo-report\"),\n    outputSchema: Report,\n  })\n\n  if (isLoading) return <p>The agent is inspecting the repo.</p>\n  if (!final) return null\n  return <p>{final.summary}</p>\n}\n```\n\nIf you only need to extract JSON from a prompt and do not need a sandbox, use `@tanstack/ai-openai`. That path is faster.\n\nFull walkthrough, including the client: [Harness Agents](../structured-outputs/harnesses).\n\n## Limitations\n\n- **No token-level text streaming.** The Codex SDK reports assistant text and reasoning only as completed items, so text arrives message-at-a-time. Tool activity (commands starting/finishing) still streams live, which keeps the UI feeling alive during long turns.\n- **Server-only (Node).** The harness spawns a subprocess.\n- **The harness owns the agent loop.** TanStack's agent-loop strategies and per-iteration middleware don't apply inside a harness turn.\n- **No sampling controls.** `temperature`-style options don't exist here.\n- **Sessions are machine-local.** Resume requires hitting the same server instance.\n- **Cold starts.** Each call spawns a harness turn; expect higher first-token latency than HTTP adapters.\n"}
