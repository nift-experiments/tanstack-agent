  - adapter
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The fal.ai adapter provides access to 600+ models on the fal.ai platform for image, video, live, audio, speech, and transcription. Unlike text-focused adapters, the fal adapter is "},{"type":"strong","children":[{"type":"text","value":"media-focused"}]},{"type":"text","value":". It supports "},{"type":"inlineCode","value":"generateImage()"},{"type":"text","value":", "},{"type":"inlineCode","value":"generateVideo()"},{"type":"text","value":", "},{"type":"inlineCode","value":"generateLiveVideo()"},{"type":"text","value":", "},{"type":"inlineCode","value":"generateAudio()"},{"type":"text","value":", "},{"type":"inlineCode","value":"generateSpeech()"},{"type":"text","value":", and "},{"type":"inlineCode","value":"generateTranscription()"},{"type":"text","value":". It does not support "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" or tools."}]},{"type":"paragraph","children":[{"type":"text","value":"For a full working example, see the "},{"type":"link","href":"https://github.com/TanStack/ai/tree/main/examples/ts-react-media","children":[{"type":"text","value":"fal.ai example app"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-fal\"]],\"vue\":[[\"@tanstack/ai-fal\"]],\"solid\":[[\"@tanstack/ai-fal\"]],\"svelte\":[[\"@tanstack/ai-fal\"]],\"preact\":[[\"@tanstack/ai-fal\"]],\"angular\":[[\"@tanstack/ai-fal\"]],\"vanilla\":[[\"@tanstack/ai-fal\"]],\"octane\":[[\"@tanstack/ai-fal\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"type-safety-with-string-literals","children":[{"type":"text","value":"Type Safety with String Literals"}]},{"type":"paragraph","children":[{"type":"text","value":"The fal adapter provides full type safety when you pass the model ID as a "},{"type":"strong","children":[{"type":"text","value":"string literal"}]},{"type":"text","value":". This gives you autocomplete for "},{"type":"inlineCode","value":"size"},{"type":"text","value":" and "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" specific to that model. Always use string literals — not variables — when creating adapters:"}]},{"type":"code","value":"import { falImage } from \"@tanstack/ai-fal\";\n\n// Good — full type safety and autocomplete\nconst adapter = falImage(\"fal-ai/z-image/turbo\");","lang":"typescript"},{"type":"code","value":"import { falImage } from \"@tanstack/ai-fal\";\n\n// Bad — no type inference for model-specific options\nconst modelId = \"fal-ai/z-image/turbo\";\nconst adapter = falImage(modelId);","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"You can also pass any string for new models that fal.ai hasn't provided types for yet — you just won't get type safety on those endpoints."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { falImage } from \"@tanstack/ai-fal\";\n\nconst result = await generateImage({\n  adapter: falImage(\"fal-ai/flux/dev\"),\n  prompt: \"A futuristic cityscape at sunset\",\n  numberOfImages: 1,\n});\n\nconsole.log(result.images);","lang":"typescript"},{"type":"heading","depth":2,"id":"basic-usage-custom-api-key","children":[{"type":"text","value":"Basic Usage - Custom API Key"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { falImage } from \"@tanstack/ai-fal\";\n\nconst adapter = falImage(\"fal-ai/flux/dev\", {\n  apiKey: process.env.FAL_KEY!,\n});\n\nconst result = await generateImage({\n  adapter,\n  prompt: \"A futuristic cityscape at sunset\",\n  numberOfImages: 1,\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"configuration","children":[{"type":"text","value":"Configuration"}]},{"type":"code","value":"import { falImage, type FalClientConfig } from \"@tanstack/ai-fal\";\n\n// Direct API key\nconst adapter = falImage(\"fal-ai/flux/dev\", {\n  apiKey: \"your-api-key\",\n});\n\n// Using a proxy URL (for client-side usage)\nconst proxiedAdapter = falImage(\"fal-ai/flux/dev\", {\n  apiKey: \"your-api-key\",\n  proxyUrl: \"https://your-server.com/api/fal/proxy\",\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"example-image-generation","children":[{"type":"text","value":"Example: Image Generation"}]},{"type":"paragraph","children":[{"type":"text","value":"From the "},{"type":"link","href":"https://github.com/TanStack/ai/tree/main/examples/ts-react-media","children":[{"type":"text","value":"fal.ai example app"}]},{"type":"text","value":":"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { falImage } from \"@tanstack/ai-fal\";\n\n// Use string literals for the model to get full type safety\nconst result = await generateImage({\n  adapter: falImage(\"fal-ai/nano-banana-pro\"),\n  prompt: \"A futuristic cityscape at sunset\",\n  numberOfImages: 1,\n  size: \"16:9_4K\",\n  modelOptions: {\n    output_format: \"jpeg\",\n  },\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"example-image-with-model-options","children":[{"type":"text","value":"Example: Image with Model Options"}]},{"type":"paragraph","children":[{"type":"text","value":"Each fal.ai model has its own type-safe options. The adapter uses fal.ai's types to provide autocomplete and type checking for model-specific parameters. There are 1000s of combinations. If you provide the proper model endpoint id as as string literal, you will then only be able to provide "},{"type":"inlineCode","value":"size"},{"type":"text","value":" and "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" that the model supports."}]},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"IMPORTANT"}]},{"type":"text","value":": It is possible to pass strings and new endpoint ids that Fal has not provided types for. You just won't get type safety on those endpoints. You'll find this happens for very new models."}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { falImage } from \"@tanstack/ai-fal\";\n\n// Model-specific options are type-safe\nconst result = await generateImage({\n  adapter: falImage(\"fal-ai/z-image/turbo\"),\n  prompt: \"A serene mountain landscape\",\n  numberOfImages: 1,\n  size: \"landscape_16_9\",\n  modelOptions: {\n    acceleration: \"high\",\n    enable_prompt_expansion: true,\n  },\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"image-size-options","children":[{"type":"text","value":"Image Size Options"}]},{"type":"paragraph","children":[{"type":"text","value":"The fal adapter supports a flexible "},{"type":"inlineCode","value":"size"},{"type":"text","value":" parameter that maps either to "},{"type":"inlineCode","value":"image_size"},{"type":"text","value":" or to "},{"type":"inlineCode","value":"aspect_ratio"},{"type":"text","value":" and "},{"type":"inlineCode","value":"resolution"},{"type":"text","value":" parameters:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[]},{"type":"tableCell","children":[{"type":"inlineCode","value":"size"}]},{"type":"tableCell","children":[{"type":"text","value":"Maps To"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"named"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"landscape_16_9\""}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"image_size: \"landscape_16_9\""}]}],[{"type":"tableCell","children":[{"type":"text","value":"width x height (OpenAI)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"1536x1024\""}]},{"type":"tableCell","children":[]}],[{"type":"tableCell","children":[{"type":"text","value":"aspect ratio & resolution"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"16:9_4K\""}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"aspect_ratio: \"16:9\""},{"type":"text","value":", "},{"type":"inlineCode","value":"resolution: \"4K\""}]}],[{"type":"tableCell","children":[{"type":"text","value":"aspect ratio only"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"16:9\""}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"aspect_ratio: \"16:9\""}]}]]},{"type":"code","value":"// Aspect ratio only\nsize: \"16:9\"\n\n// Aspect ratio with resolution\nsize: \"16:9_4K\"\n\n// Named size (model-specific)\nsize: \"landscape_16_9\"","lang":"typescript","meta":"ignore"},{"type":"heading","depth":2,"id":"video-generation-experimental","children":[{"type":"text","value":"Video Generation (Experimental)"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Video generation is an experimental feature and may change in future releases."}]}]},{"type":"paragraph","children":[{"type":"text","value":"Video generation uses a queue-based workflow: submit a job, poll for status, then retrieve the video URL when complete."}]},{"type":"code","value":"import { generateVideo, getVideoJobStatus } from \"@tanstack/ai\";\nimport { falVideo } from \"@tanstack/ai-fal\";","lang":"typescript"},{"type":"heading","depth":2,"id":"example-text-to-video","children":[{"type":"text","value":"Example: Text-to-Video"}]},{"type":"paragraph","children":[{"type":"text","value":"From the "},{"type":"link","href":"https://github.com/TanStack/ai/tree/main/examples/ts-react-media","children":[{"type":"text","value":"fal.ai example app"}]},{"type":"text","value":":"}]},{"type":"code","value":"import { generateVideo, getVideoJobStatus } from \"@tanstack/ai\";\nimport { falVideo } from \"@tanstack/ai-fal\";\n\n// 1. Submit the video generation job\nconst adapter = falVideo(\"fal-ai/kling-video/v2.6/pro/text-to-video\");\n\nconst job = await generateVideo({\n  adapter,\n  prompt: \"A timelapse of a flower blooming\",\n  size: \"16:9\",\n  duration: \"5\",\n});\n\n// 2. Poll for status\nconst status = await getVideoJobStatus({\n  adapter,\n  jobId: job.jobId,\n});\n\nconsole.log(status.status); // \"pending\" | \"processing\" | \"completed\"","lang":"typescript"},{"type":"heading","depth":2,"id":"example-image-to-video","children":[{"type":"text","value":"Example: Image-to-Video"}]},{"type":"code","value":"import { generateVideo } from \"@tanstack/ai\";\nimport { falVideo } from \"@tanstack/ai-fal\";\n\nconst job = await generateVideo({\n  adapter: falVideo(\"fal-ai/kling-video/v2.6/pro/image-to-video\"),\n  prompt: \"Animate this scene with gentle wind\",\n  duration: \"5\",\n  modelOptions: {\n    start_image_url: \"https://example.com/image.jpg\",\n    generate_audio: true,\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"duration"},{"type":"text","value":" is typed per model from "},{"type":"inlineCode","value":"@fal-ai/client"},{"type":"text","value":"'s "},{"type":"inlineCode","value":"EndpointTypeMap"},{"type":"text","value":". Popular models also implement "},{"type":"inlineCode","value":"availableDurations()"},{"type":"text","value":" / "},{"type":"inlineCode","value":"snapDuration()"},{"type":"text","value":" for UI sliders:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Model"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"duration"},{"type":"text","value":" type"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"availableDurations()"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"fal-ai/kling-video/v1.6/{standard,pro}/text-to-video"},{"type":"text","value":", "},{"type":"inlineCode","value":"fal-ai/kling-video/v2.6/pro/{text,image}-to-video"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'5' | '10'"}]},{"type":"tableCell","children":[{"type":"text","value":"discrete"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fal-ai/kling-video/v3/pro/{text,image}-to-video"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'3'"},{"type":"text","value":" … "},{"type":"inlineCode","value":"'15'"}]},{"type":"tableCell","children":[{"type":"text","value":"discrete"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fal-ai/pika/v2.2/text-to-video"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'5' | '10'"}]},{"type":"tableCell","children":[{"type":"text","value":"discrete"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fal-ai/ltx-2.3/{text,image}-to-video"},{"type":"text","value":" (+ "},{"type":"inlineCode","value":"/fast"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'6' | '8' | '10'"}]},{"type":"tableCell","children":[{"type":"text","value":"discrete"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fal-ai/luma-dream-machine/ray-2"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'5s' | '9s'"}]},{"type":"tableCell","children":[{"type":"text","value":"discrete"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fal-ai/veo3.1"},{"type":"text","value":", "},{"type":"inlineCode","value":"fal-ai/veo3.1/fast"},{"type":"text","value":" (+ "},{"type":"inlineCode","value":"/image-to-video"},{"type":"text","value":"), "},{"type":"inlineCode","value":"fal-ai/veo3"},{"type":"text","value":" (+ "},{"type":"inlineCode","value":"/image-to-video"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'4s' | '6s' | '8s'"}]},{"type":"tableCell","children":[{"type":"text","value":"discrete"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fal-ai/wan-25-preview/text-to-video"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'2'"},{"type":"text","value":" … "},{"type":"inlineCode","value":"'15'"}]},{"type":"tableCell","children":[{"type":"text","value":"discrete"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fal-ai/minimax/video-01"}]},{"type":"tableCell","children":[{"type":"text","value":"not accepted"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"{ kind: 'none' }"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fal-ai/hunyuan-video-v1.5/text-to-video"}]},{"type":"tableCell","children":[{"type":"text","value":"not accepted ("},{"type":"inlineCode","value":"num_frames"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"{ kind: 'none' }"}]}]]},{"type":"code","value":"import { generateVideo } from \"@tanstack/ai\";\nimport { falVideo } from \"@tanstack/ai-fal\";\n\nconst adapter = falVideo(\"fal-ai/veo3.1\");\nadapter.availableDurations(); // { kind: 'discrete', values: ['4s', '6s', '8s'] }\nadapter.snapDuration(7); // '6s'\n\nawait generateVideo({\n  adapter,\n  prompt: \"A timelapse of a city skyline at dusk\",\n  duration: adapter.snapDuration(7),\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Uncurated models still type "},{"type":"inlineCode","value":"duration"},{"type":"text","value":" from the SDK when the endpoint declares the field, but "},{"type":"inlineCode","value":"availableDurations()"},{"type":"text","value":" returns "},{"type":"inlineCode","value":"{ kind: 'none' }"},{"type":"text","value":" until they are added to the runtime map."}]},{"type":"heading","depth":2,"id":"text-to-speech","children":[{"type":"text","value":"Text-to-Speech"}]},{"type":"paragraph","children":[{"type":"text","value":"Text-to-speech uses "},{"type":"inlineCode","value":"falSpeech()"},{"type":"text","value":" with the "},{"type":"inlineCode","value":"generateSpeech()"},{"type":"text","value":" activity. The adapter fetches the generated audio from fal's CDN and returns it as base64-encoded data to match the "},{"type":"inlineCode","value":"TTSResult"},{"type":"text","value":" contract."}]},{"type":"code","value":"import { generateSpeech } from \"@tanstack/ai\";\nimport { falSpeech } from \"@tanstack/ai-fal\";\n\nconst result = await generateSpeech({\n  adapter: falSpeech(\"fal-ai/kokoro/american-english\"),\n  text: \"Hello from fal!\",\n  voice: \"af_heart\",\n  speed: 1.0,\n});\n\n// result.audio is a base64-encoded string\nconsole.log(result.format); // e.g. \"wav\"\nconsole.log(result.contentType); // e.g. \"audio/wav\"","lang":"typescript"},{"type":"heading","depth":3,"id":"google-gemini-3-1-flash-tts","children":[{"type":"text","value":"Google Gemini 3.1 Flash TTS"}]},{"type":"paragraph","children":[{"type":"text","value":"Google's newest TTS model ("},{"type":"inlineCode","value":"fal-ai/gemini-3.1-flash-tts"},{"type":"text","value":") supports 80+ languages and introduces "},{"type":"strong","children":[{"type":"text","value":"granular audio tags"}]},{"type":"text","value":" for expressive control — you can embed speaker tags and style cues directly in the text."}]},{"type":"code","value":"import { generateSpeech } from \"@tanstack/ai\";\nimport { falSpeech } from \"@tanstack/ai-fal\";\n\nconst result = await generateSpeech({\n  adapter: falSpeech(\"fal-ai/gemini-3.1-flash-tts\"),\n  text: \"[warm, enthusiastic] Welcome to TanStack AI! [pause] Let's build something great.\",\n  voice: \"Kore\",\n});","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" This model is newer than "},{"type":"inlineCode","value":"@fal-ai/client@1.9.1"},{"type":"text","value":"'s type map, so "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" won't autocomplete. The call still works — the fal adapter accepts any model ID as a string. Type-safe autocomplete will land when fal's SDK types catch up."}]}]},{"type":"heading","depth":3,"id":"elevenlabs-v3","children":[{"type":"text","value":"ElevenLabs v3"}]},{"type":"code","value":"import { generateSpeech } from \"@tanstack/ai\";\nimport { falSpeech } from \"@tanstack/ai-fal\";\n\nconst result = await generateSpeech({\n  adapter: falSpeech(\"fal-ai/elevenlabs/tts/eleven-v3\"),\n  text: \"Welcome to TanStack AI.\",\n  modelOptions: {\n    voice: \"Rachel\",\n    stability: 0.5,\n  },\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"transcription","children":[{"type":"text","value":"Transcription"}]},{"type":"paragraph","children":[{"type":"text","value":"Speech-to-text uses "},{"type":"inlineCode","value":"falTranscription()"},{"type":"text","value":" with the "},{"type":"inlineCode","value":"generateTranscription()"},{"type":"text","value":" activity. The "},{"type":"inlineCode","value":"audio"},{"type":"text","value":" input accepts a URL string, "},{"type":"inlineCode","value":"Blob"},{"type":"text","value":", "},{"type":"inlineCode","value":"File"},{"type":"text","value":", or "},{"type":"inlineCode","value":"ArrayBuffer"},{"type":"text","value":" — "},{"type":"inlineCode","value":"ArrayBuffer"},{"type":"text","value":" is automatically wrapped in a "},{"type":"inlineCode","value":"Blob"},{"type":"text","value":" for upload."}]},{"type":"code","value":"import { generateTranscription } from \"@tanstack/ai\";\nimport { falTranscription } from \"@tanstack/ai-fal\";\n\nconst result = await generateTranscription({\n  adapter: falTranscription(\"fal-ai/whisper\"),\n  audio: \"https://example.com/recording.mp3\",\n  language: \"en\",\n});\n\nconsole.log(result.text);\nconsole.log(result.language);\n\n// When the model returns word/segment timestamps, they're mapped to result.segments\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.start}s → ${segment.end}s] ${segment.text}`);\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"audio-generation-music-sound-effects","children":[{"type":"text","value":"Audio Generation (Music & Sound Effects)"}]},{"type":"paragraph","children":[{"type":"text","value":"Music and sound-effect generation uses "},{"type":"inlineCode","value":"falAudio()"},{"type":"text","value":" with the "},{"type":"inlineCode","value":"generateAudio()"},{"type":"text","value":" activity. Unlike TTS, the result is returned as a URL in "},{"type":"inlineCode","value":"result.audio.url"},{"type":"text","value":" (you can fetch it yourself if you need raw bytes)."}]},{"type":"code","value":"import { generateAudio } from \"@tanstack/ai\";\nimport { falAudio } from \"@tanstack/ai-fal\";\n\n// Music generation with MiniMax Music 2.6 (latest)\nconst music = await generateAudio({\n  adapter: falAudio(\"fal-ai/minimax-music/v2.6\"),\n  prompt: \"City Pop, 80s retro, groovy synth bass, warm female vocal, 104 BPM, nostalgic urban night\",\n});\n\nconsole.log(music.audio.url);","lang":"typescript"},{"type":"code","value":"import { generateAudio } from \"@tanstack/ai\";\nimport { falAudio } from \"@tanstack/ai-fal\";\n\n// DiffRhythm with explicit lyrics\nconst lyrical = await generateAudio({\n  adapter: falAudio(\"fal-ai/diffrhythm\"),\n  prompt: \"An upbeat electronic track with synths\",\n  modelOptions: {\n    lyrics: \"[verse]\\nHello world\\n[chorus]\\nLa la la\",\n  },\n});","lang":"typescript"},{"type":"code","value":"import { generateAudio } from \"@tanstack/ai\";\nimport { falAudio } from \"@tanstack/ai-fal\";\n\n// Sound effects\nconst sfx = await generateAudio({\n  adapter: falAudio(\"fal-ai/elevenlabs/sound-effects/v2\"),\n  prompt: \"Thunderclap with rain\",\n  duration: 5,\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"popular-models","children":[{"type":"text","value":"Popular Models"}]},{"type":"heading","depth":3,"id":"image-models","children":[{"type":"text","value