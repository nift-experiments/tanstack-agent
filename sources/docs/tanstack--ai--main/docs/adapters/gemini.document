NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The Google Gemini adapter provides access to Google's Gemini models, including text generation, image generation with both Imagen and Gemini native image models (NanoBanana), and experimental text-to-speech."}]},{"type":"paragraph","children":[{"type":"text","value":"For a full working example with image generation, see the "},{"type":"link","href":"https://github.com/TanStack/ai/tree/main/examples/ts-react-media","children":[{"type":"text","value":"media generation example app"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-gemini\"]],\"vue\":[[\"@tanstack/ai-gemini\"]],\"solid\":[[\"@tanstack/ai-gemini\"]],\"svelte\":[[\"@tanstack/ai-gemini\"]],\"preact\":[[\"@tanstack/ai-gemini\"]],\"angular\":[[\"@tanstack/ai-gemini\"]],\"vanilla\":[[\"@tanstack/ai-gemini\"]],\"octane\":[[\"@tanstack/ai-gemini\"]]},\"mode\":\"install\"}"}},{"type":"paragraph","children":[{"type":"text","value":"Need Gemini on Vertex AI (regional endpoints and Google Cloud credentials)? Use the "},{"type":"link","href":"./vertex","children":[{"type":"text","value":"Vertex adapter"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"gemini-3.8-flash"},{"type":"text","value":" for chat with multimodal input, thinking, and built-in tools. It also supports structured output and caching."}]},{"type":"paragraph","children":[{"type":"text","value":"For Gemini 3.8 Flash, set "},{"type":"inlineCode","value":"modelOptions.thinkingConfig.thinkingLevel"},{"type":"text","value":" to "},{"type":"inlineCode","value":"LOW"},{"type":"text","value":", "},{"type":"inlineCode","value":"MEDIUM"},{"type":"text","value":", or "},{"type":"inlineCode","value":"HIGH"},{"type":"text","value":". The Interactions adapter uses "},{"type":"inlineCode","value":"modelOptions.generation_config.thinking_level"},{"type":"text","value":" with "},{"type":"inlineCode","value":"low"},{"type":"text","value":", "},{"type":"inlineCode","value":"medium"},{"type":"text","value":", or "},{"type":"inlineCode","value":"high"},{"type":"text","value":". Gemini 3.8 Flash does not accept the "},{"type":"inlineCode","value":"minimal"},{"type":"text","value":" thinking level."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.8-flash\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"basic-usage-custom-api-key","children":[{"type":"text","value":"Basic Usage - Custom API Key"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { createGeminiChat } from \"@tanstack/ai-gemini\";\n\nconst adapter = createGeminiChat(\"gemini-3.1-pro-preview\", process.env.GEMINI_API_KEY!, {\n  // ... your config options\n});\n\nconst stream = chat({\n  adapter,\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"configuration","children":[{"type":"text","value":"Configuration"}]},{"type":"code","value":"import { createGeminiChat, type GeminiTextConfig } from \"@tanstack/ai-gemini\";\n\nconst config: Omit<GeminiTextConfig, \"apiKey\"> = {\n  baseURL: \"https://generativelanguage.googleapis.com/v1beta\", // Optional\n  defaultHeaders: { \"X-Custom-Header\": \"value\" }, // Optional\n};\n\nconst adapter = createGeminiChat(\"gemini-3.1-pro-preview\", process.env.GEMINI_API_KEY!, config);","lang":"typescript"},{"type":"heading","depth":2,"id":"behind-a-proxy","children":[{"type":"text","value":"Behind a proxy"}]},{"type":"paragraph","children":[{"type":"text","value":"Route every request through a gateway, such as Cloudflare AI Gateway or a corporate proxy, with "},{"type":"inlineCode","value":"baseURL"},{"type":"text","value":" and "},{"type":"inlineCode","value":"defaultHeaders"},{"type":"text","value":". These two option names are the same on every TanStack AI adapter, so one gateway config works for all of them."}]},{"type":"code","value":"import { createGeminiChat } from \"@tanstack/ai-gemini\";\n\nconst adapter = createGeminiChat(\"gemini-3.8-flash\", process.env.GEMINI_API_KEY!, {\n  baseURL: \"https://gateway.example.com/google-ai-studio\",\n  defaultHeaders: { \"cf-aig-authorization\": `Bearer ${process.env.GATEWAY_TOKEN}` },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"baseURL"},{"type":"text","value":" sets "},{"type":"inlineCode","value":"httpOptions.baseUrl"},{"type":"text","value":" and "},{"type":"inlineCode","value":"defaultHeaders"},{"type":"text","value":" sets "},{"type":"inlineCode","value":"httpOptions.headers"},{"type":"text","value":". If you set both forms, "},{"type":"inlineCode","value":"baseURL"},{"type":"text","value":" and "},{"type":"inlineCode","value":"defaultHeaders"},{"type":"text","value":" win."}]},{"type":"heading","depth":2,"id":"example-chat-completion","children":[{"type":"text","value":"Example: Chat Completion"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: geminiText(\"gemini-3.1-pro-preview\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"example-with-tools","children":[{"type":"text","value":"Example: With Tools"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { z } from \"zod\";\n\nconst getCalendarEventsDef = toolDefinition({\n  name: \"get_calendar_events\",\n  description: \"Get calendar events for a date\",\n  inputSchema: z.object({\n    date: z.string(),\n  }),\n});\n\nconst getCalendarEvents = getCalendarEventsDef.server(async ({ date }) => {\n  // Fetch calendar events\n  return { events: [] };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: geminiText(\"gemini-3.1-pro-preview\"),\n    messages,\n    tools: [getCalendarEvents],\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"video-understanding","children":[{"type":"text","value":"Video Understanding"}]},{"type":"paragraph","children":[{"type":"text","value":"Ask questions about a video: \"what happens at 0:30?\", \"summarize the demo\", \"list every product shown\". Upload the file once, then chat about it."}]},{"type":"paragraph","children":[{"type":"text","value":"Video is too large to inline as base64, so upload it to the Gemini Files API first. "},{"type":"inlineCode","value":"uploadGeminiFile()"},{"type":"text","value":" uploads the file and waits until it is ready to use. "},{"type":"inlineCode","value":"geminiVideoPart()"},{"type":"text","value":" turns that upload into a message content part."}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { geminiText, uploadGeminiFile, geminiVideoPart } from \"@tanstack/ai-gemini\";\n\nexport async function POST(request: Request) {\n  const file = await uploadGeminiFile(\"./demo.mp4\", { mimeType: \"video/mp4\" });\n\n  const stream = chat({\n    adapter: geminiText(\"gemini-3.8-flash\"),\n    messages: [\n      {\n        role: \"user\",\n        content: [\n          { type: \"text\", content: \"Summarize this video and cite timestamps.\" },\n          geminiVideoPart(file),\n        ],\n      },\n    ],\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"By default Gemini samples the video at 1 frame per second. Tune that single-pass sampling through the part metadata:"}]},{"type":"code","value":"// Watch a 30s-90s clip at half a frame per second.\ngeminiVideoPart(file, { fps: 0.5, startOffset: \"30s\", endOffset: \"90s\" });","lang":"typescript","meta":"ignore"},{"type":"heading","depth":3,"id":"agentic-understanding","children":[{"type":"text","value":"Agentic understanding"}]},{"type":"paragraph","children":[{"type":"text","value":"Single-pass sampling can miss detail in long or fast-moving videos. Set "},{"type":"inlineCode","value":"processing: \"agentic\""},{"type":"text","value":" to let the model drive: it navigates the timeline and pulls frames, transcripts, and audio on demand. Supported models:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"gemini-3.8-flash"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"gemini-3.7-flash"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"gemini-3.6-flash"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"gemini-3.5-flash-lite"}]}]}]},{"type":"code","value":"geminiVideoPart(file, { processing: \"agentic\" });","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"text","value":"With "},{"type":"inlineCode","value":"agentic"},{"type":"text","value":", the adapter routes the request through Gemini's Interactions API, and you express the sampling rate in your prompt (\"watch it at 2 fps\") instead of through "},{"type":"inlineCode","value":"fps"},{"type":"text","value":". It is deeper but slower, since it re-analyzes the video on each turn."}]},{"type":"heading","depth":2,"id":"stateful-conversations-interactions-api-experimental","children":[{"type":"text","value":"Stateful Conversations — Interactions API (Experimental)"}]},{"type":"paragraph","children":[{"type":"text","value":"Gemini's "},{"type":"link","href":"https://ai.google.dev/gemini-api/docs/interactions","children":[{"type":"text","value":"Interactions API"}]},{"type":"text","value":" (currently in Beta) offers server-side conversation state — the Gemini equivalent of OpenAI's Responses API. Instead of replaying the full message history on every turn, you pass a "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":" and the server retains the transcript. This also improves cache hit rates for repeated prefixes."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"geminiTextInteractions"},{"type":"text","value":" adapter routes through "},{"type":"inlineCode","value":"client.interactions.create"},{"type":"text","value":" and surfaces the server-assigned interaction id via an AG-UI "},{"type":"inlineCode","value":"CUSTOM"},{"type":"text","value":" event ("},{"type":"inlineCode","value":"name: 'gemini.interactionId'"},{"type":"text","value":") emitted just before "},{"type":"inlineCode","value":"RUN_FINISHED"},{"type":"text","value":", so you can chain turns."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"⚠️ Experimental."}]},{"type":"text","value":" Google marks the Interactions API as Beta and explicitly flags possible breaking changes until it reaches general availability. The adapter is exported from the "},{"type":"inlineCode","value":"@tanstack/ai-gemini/experimental"},{"type":"text","value":" subpath so the experimental status is load-bearing in your editor and bundle. Text output, function tools, and the built-in tools "},{"type":"inlineCode","value":"google_search"},{"type":"text","value":", "},{"type":"inlineCode","value":"code_execution"},{"type":"text","value":", "},{"type":"inlineCode","value":"url_context"},{"type":"text","value":", "},{"type":"inlineCode","value":"file_search"},{"type":"text","value":", and "},{"type":"inlineCode","value":"computer_use"},{"type":"text","value":" are supported. "},{"type":"inlineCode","value":"google_search_retrieval"},{"type":"text","value":", "},{"type":"inlineCode","value":"google_maps"},{"type":"text","value":", and "},{"type":"inlineCode","value":"mcp_server"},{"type":"text","value":" still throw on this adapter — use "},{"type":"inlineCode","value":"geminiText()"},{"type":"text","value":" for those or wait for follow-up work."}]}]},{"type":"heading","depth":3,"id":"basic-usage-2","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiTextInteractions } from \"@tanstack/ai-gemini/experimental\";\n\n// Turn 1: introduce yourself, capture the interaction id.\nlet interactionId: string | undefined;\n\nfor await (const chunk of chat({\n  adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n  messages: [{ role: \"user\", content: \"Hi, my name is Amir.\" }],\n})) {\n  if (\n    chunk.type === \"CUSTOM\" &&\n    chunk.name === \"gemini.interactionId\" &&\n    chunk.value &&\n    typeof chunk.value === \"object\" &&\n    \"interactionId\" in chunk.value\n  ) {\n    interactionId = String(chunk.value.interactionId);\n  }\n}\n\n// Turn 2: only send the new turn's content — the server has the history.\nfor await (const chunk of chat({\n  adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n  messages: [{ role: \"user\", content: \"What is my name?\" }],\n  modelOptions: {\n    previous_interaction_id: interactionId,\n  },\n})) {\n  // ...stream \"Your name is Amir.\" back to the client.\n}","lang":"typescript","meta":"ignore"},{"type":"heading","depth":3,"id":"wiring-with-usechat-react","children":[{"type":"text","value":"Wiring with "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" (React)"}]},{"type":"paragraph","children":[{"type":"text","value":"The Interactions API is stateful and "},{"type":"strong","children":[{"type":"text","value":"does not accept multi-turn history without a "},{"type":"inlineCode","value":"previous_interaction_id"}]},{"type":"text","value":" — if a chat client sends "},{"type":"inlineCode","value":"[user, assistant, user]"},{"type":"text","value":" to a fresh interaction the adapter throws "},{"type":"inlineCode","value":"cannot send prior conversation history on a fresh interaction"},{"type":"text","value":". To make "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" work, persist the server-assigned id and send it back on the next turn:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server route"}]},{"type":"text","value":" (e.g. TanStack Start handler):"}]},{"type":"code","value":"import {\n  chat,\n  chatParamsFromRequestBody,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { geminiTextInteractions } from \"@tanstack/ai-gemini/experimental\";\n\nexport async function POST({ request }: { request: Request }) {\n  const params = await chatParamsFromRequestBody(await request.json());\n\n  // The client sends body.previousInteractionId; AG-UI maps `body` into\n  // `forwardedProps` on the wire.\n  const previousInteractionId =\n    typeof params.forwardedProps.previousInteractionId === \"string\"\n      ? params.forwardedProps.previousInteractionId\n      : undefined;\n\n  const stream = chat({\n    adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n    messages: params.messages,\n    modelOptions: {\n      previous_interaction_id: previousInteractionId,\n      store: true, // required for chaining on the next turn\n    },\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"React client"}]},{"type":"text","value":":"}]},{"type":"code","value":"import { useEffect, useMemo, useState } from \"react\";\nimport { fetchServerSentEvents, useChat } from \"@tanstack/ai-react\";\n\nfunction GeminiChat() {\n  const [interactionId, setInteractionId] = useState<string | undefined>();\n\n  const body = useMemo(\n    () => (interactionId ? { previousInteractionId: interactionId } : {}),\n    [interactionId],\n  );\n\n  const { messages, setMessages, sendMessage } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    body,\n    onCustomEvent: (eventType, data) => {\n      if (\n        eventType === \"gemini.interactionId\" &&\n        typeof data === \"object\" &&\n        data !== null &&\n        \"interactionId\" in data\n      ) {\n        setInteractionId(String(data.interactionId));\n      }\n    },\n  });\n\n  // Switching provider/model resets the server-side chain — drop the id\n  // AND the local message history together, otherwise the next turn\n  // ships multi-turn messages with no previous_interaction_id and the\n  // adapter errors out.\n  const [provider, setProvider] = useState(\"gemini-interactions\");\n  useEffect(() => {\n    setInteractionId(undefined);\n    setMessages([]);\n  }, [provider]);\n\n  // ...render messages, call sendMessage(input)\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The full working example is in "},{"type":"link","href":"https://github.com/TanStack/ai/tree/main/examples/ts-react-chat","children":[{"type":"inlineCode","value":"examples/ts-react-chat"}]},{"type":"text","value":" — see "},{"type":"inlineCode","value":"src/routes/index.tsx"},{"type":"text","value":" for the client and "},{"type":"inlineCode","value":"src/routes/api.tanchat.ts"},{"type":"text","value":" for the route."}]},{"type":"heading","depth":3,"id":"how-it-differs-from-geminitext","children":[{"type":"text","value":"How it differs from "},{"type":"inlineCode","value":"geminiText"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Concern"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"geminiText"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"geminiTextInteractions"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Underlying endpoint"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"models:generateContent"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"interactions:create"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Conversation state"}]},{"type":"tableCell","children":[{"type":"text","value":"Stateless — send full history each turn"}]},{"type":"tableCell","children":[{"type":"text","value":"Stateful — server retains transcript via "},{"type":"inlineCode","value":"previous_interaction_id"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Provider options shape"}]},{"type":"tableCell","children":[{"type":"text","value":"camelCase ("},{"type":"inlineCode","value":"stopSequences"},{"type":"text","value":", "},{"type":"inlineCode","value":"responseModalities"},{"type":"text","value":", "},{"type":"inlineCode","value":"safetySettings"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"text","value":"snake_case ("},{"type":"inlineCode","value":"generation_config"},{"type":"text","value":", "},{"type":"inlineCode","value":"response_modalities"},{"type":"text","value":", "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":")"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Built-in tools"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"google_search"},{"type":"text","value":", "},{"type":"inlineCode","value":"code_execution"},{"type":"text","value":", "},{"type":"inlineCode","value":"url_context"},{"type":"text","value":", "},{"type":"inlineCode","value":"file_search"},{"type":"text","value":", "},{"type":"inlineCode","value":"google_maps"},{"type":"text","value":", "},{"type":"inlineCode","value":"google_search_retrieval"},{"type":"text","value":", "},{"type":"inlineCode","value":"computer_use"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"google_search"},{"type":"text","value":", "},{"type":"inlineCode","value":"code_execution"},{"type":"text","value":", "},{"type":"inlineCode","value":"url_context"},{"type":"text","value":", "},{"type":"inlineCode","value":"file_search"},{"type":"text","value":", "},{"type":"inlineCode","value":"computer_use"},{"type":"text","value":" (only the first four stream "},{"type":"inlineCode","value":"CUSTOM"},{"type":"text","value":" event activity; "},{"type":"inlineCode","value":"computer_use"},{"type":"text","value":" is accepted in the request but does not currently emit per-delta events)"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Stability"}]},{"type":"tableCell","children":[{"type":"text","value":"GA"}]},{"type":"tableCell","children":[{"type":"text","value":"Experimental (Google Beta)"}]}]]},{"type":"heading","depth":3,"id":"provider-options","children":[{"type":"text","value":"Provider Options"}]},{"type":"paragraph","children":[{"type":"text","value":"The adapter exposes Interactions-specific options on "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiTextInteractions } from \"@tanstack/ai-gemini/experimental\";\n\nconst stream = chat({\n  adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    // Stateful chaining — passed only on turn 2+.\n    previous_interaction_id: \"int_abc123\",\n\n    // Persist the interaction server-side (default true). Must be true for\n    // previous_interaction_id to work on the *next* turn.\n    store: true,\n\n    // Per-request system instruction (interaction-scoped — re-specify each turn).\n    system_instruction: \"You are a helpful assistant.\",\n\n    // snake_case generation config distinct from geminiText's camelCase one.\n    generation_config: {\n      thinking_level: \"low\",\n      thinking_summaries: \"auto\",\n      stop_sequences: [\"<done>\"],\n    },\n\n    response_modalities: [\"text\"],\n  },\n});","lang":"typescript"},{"type":"heading","depth":3,"id":"reading-the-interaction-id","children":[{"type":"text","value":"Reading the interaction id"}]},{"type":"paragraph","children":[{"type":"text","value":"The server's interaction id arrives as an AG-UI "},{"type":"inlineCode","value":"CUSTOM"},{"type":"text","value":" event emitted just before "},{"type":"inlineCode","value":"RUN_FINISHED"},{"type":"text","value":":"}]},{"type":"code","value":"for await (const chunk of stream) {\n  if (\n    chunk.type === \"CUSTOM\" &&\n    chunk.name === \"gemini.interactionId\" &&\n    typeof chunk.value === \"object\" &&\n    chunk.value !== null &&\n    \"interactionId\" in chunk.value\n  ) {\n    const id = String(chunk.value.interactionId);\n    // Persist `id` wherever you store per-user conversation pointers —\n    // pass it back on the next turn as `previous_interaction_id`.\n  }\n}","lang":"typescript","meta":"ignore"},{"type":"heading","depth":3,"id":"caveats","children":[{"type":"text","value":"Caveats"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Multi-turn history requires "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":"."}]},{"type":"text","value":" The Interactions API has no stateless replay path — sending more than one message in "},{"type":"inlineCode","value":"messages"},{"type":"text","value":" without a "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":" throws. Chat UIs that maintain local history must capture the server-assigned id and chain (see "},{"type":"link","href":"#wiring-with-usechat-react","children":[{"type":"text","value":"Wiring with "},{"type":"inlineCode","value":"useChat"}]},{"type":"text","value":"). On provider/model switch, also clear the local message buffer."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Tools, "},{"type":"inlineCode","value":"system_instruction"},{"type":"text","value":", and "},{"type":"inlineCode","value":"generation_config"},{"type":"text","value":" are interaction-scoped."}]},{"type":"text","value":" Per Google's docs these are NOT inherited from a prior interaction via "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":" — pass them again on every turn you need them."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"store: false"},{"type":"text","value":" is incompatible with "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":" (no state to recall) and with "},{"type":"inlineCode","value":"background: true"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Retention (as of the time of writing): "},{"type":"strong","children":[{"type":"text","value":"55 days on the Paid Tier, 1 day on the Free Tier."}]},{"type":"text","value":" See "},{"type":"link","href":"https://ai.google.dev/gemini-api/docs/interactions","children":[{"type":"text","value":"Google's Interactions API docs"}]},{"type":"text","value":" for current retention policy."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Built-in tools in scope ("},{"type":"inlineCode","value":"google_search"},{"type":"text","value":", "},{"type":"inlineCode","value":"code_execution"},{"type":"text","value":", "},{"type":"inlineCode","value":"url_context"},{"type":"text","value":", "},{"type":"inlineCode","value":"file_search"},{"type":"text","value":", "},{"type":"inlineCode","value":"computer_use"},{"type":"text","value":") are wired through as request tools. Per-delta activity for the four search/exec tools streams back as AG-UI "},{"type":"inlineCode","value":"CUSTOM"},{"type":"text","value":" events — "},{"type":"inlineCode","value":"gemini.googleSearchCall"},{"type":"text","value":" / "},{"type":"inlineCode","value":"gemini.googleSearchResult"},{"type":"text","value":" (and the matching "},{"type":"inlineCode","value":"codeExecutionCall"},{"type":"text","value":"/"},{"type":"inlineCode","value":"Result"},{"type":"text","value":", "},{"type":"inlineCode","value":"urlContextCall"},{"type":"text","value":"/"},{"type":"inlineCode","value":"Result"},{"type":"text","value":", "},{"type":"inlineCode","value":"fileSearchCall"},{"type":"text","value":"/"},{"type":"inlineCode","value":"Result"},{"type":"text","value":") — carrying the raw Interactions delta. "},{"type":"inlineCode","value":"computer_use"},{"type":"text","value":" is accepted in the request but the Interactions API does not currently emit per-delta "},{"type":"inlineCode","value":"CUSTOM"},{"type":"text","value":" events for it. Function-tool "},{"type":"inlineCode","value":"TOOL_CALL_*"},{"type":"text","value":" events are unchanged, and "},{"type":"inlineCode","value":"finishReason"},{"type":"text","value":" stays "},{"type":"inlineCode","value":"stop"},{"type":"text","value":" when only built-in tools ran."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"google_search_retrieval"},{"type":"text","value":", "},{"type":"inlineCode","value":"google_maps"},{"type":"text","value":", and "},{"type":"inlineCode","value":"mcp_server"},{"type":"text","value":" still throw a targeted error on this adapter. Use "},{"type":"inlineCode","value":"geminiText()"},{"type":"text","value":" for the first two, or wait for a dedicated follow-up for "},{"type":"inlineCode","value":"mcp_server"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Image and audio output via Interactions aren't routed through this adapter yet — it's text-only. Use "},{"type":"inlineCode","value":"geminiImage"},{"type":"text","value":" / "},{"type":"inlineCode","value":"geminiSpeech"},{"type":"text","value":" for non-text generation for now."}]}]}]},{"type":"heading","depth":2,"id":"model-options","children":[{"type":"text","value":"Model Options"}]},{"type":"paragraph","children":[{"type":"text","value":"Gemini supports various model-specific options. Sampling parameters live here too — "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":", "},{"type":"inlineCode","value":"topP"},{"type":"text","value":", and "},{"type":"inlineCode","value":"maxOutputTokens"},{"type":"text","value":" — rather than as root-level props on "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    maxOutputTokens: 2048,\n    temperature: 0.7,\n    topP: 0.9,\n    topK: 40,\n    stopSequences: [\"END\"],\n  },\n});","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"If you previously passed "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":" / "},{"type":"inlineCode","value":"topP"},{"type":"text","value":" / "},{"type":"inlineCode","value":"maxTokens"},{"type":"text","value":" at the root of "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":", see "},{"type":"link","href":"../migration/sampling-options-to-model-options","children":[{"type":"text","value":"Moving Sampling Options into modelOptions"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":3,"id":"thinking","children":[{"type":"text","value":"Thinking"}]},{"type":"paragraph","children":[{"type":"text","value":"Enable thinking for models that support it:"}]},{"type":"code","value":"modelOptions: {\n  thinking: {\n    includeThoughts: true,\n  },\n}","lang":"typescript","meta":"ignore"},{"type":"heading","depth":3,"id":"structured-output","children":[{"type":"text","value":"Structured Output"}]},{"type":"paragraph","children":[{"type":"text","value":"Configure structured output format:"}]},{"type":"code","value":"modelOptions: {\n  responseMimeType: \"application/json\",\n}","lang":"typescript","meta":"ignore"},{"type":"heading","depth":2,"id":"summarization","children":[{"type":"text","value":"Summarization"}]},{"type":"paragraph","children":[{"type":"text","value":"Summarize long text content:"}]},{"type":"code","value":"import { summarize } from \"@tanstack/ai\";\nimport { geminiSummarize } from \"@tanstack/ai-gemini\";\n\nconst result = await summarize({\n  adapter: geminiSummarize(\"gemini-3.1-pro-preview\"),\n  text: \"Your long text to summarize...\",\n  maxLength: 100,\n  style: \"concise\", // \"concise\" | \"bullet-points\" | \"paragraph\"\n});\n\nconsole.log(result.summary);","lang":"typescript"},{"type":"heading","depth":2,"id":"embeddings","children":[{"type":"text","value":"Embeddings"}]},{"type":"paragraph","children":[{"type":"text","value":"Generate embedding vectors with gemini-embedding-001:"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { geminiEmbedding } from \"@tanstack/ai-gemini\";\n\nconst result = await embed({\n  adapter: geminiEmbedding(\"gemini-embedding-001\"),\n  input: \"a red guitar\",\n  dimensions: 1536,\n  modelOptions: {\n    taskType: \"RETRIEVAL_DOCUMENT\",\n  },\n});\n\nconsole.log(result.embeddings[0]?.vector);","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"The Gemini API's embedding endpoint does not report token usage, so\n"},{"type":"inlineCode","value":"result.usage"},{"type":"text","value":" is absent. The Vertex-only multimodal embedding model\n("},{"type":"inlineCode","value":"multimodalembedding@001"},{"type":"text","value":") is not supported by this adapter."}]}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../embeddings.md","children":[{"type":"text","value":"Embeddings guide"}]},{"type":"text","value":" for the full API."}]},{"type":"heading","depth":2,"id":"image-generation","children":[{"type":"text","value":"Image Generation"}]},{"type":"paragraph","children":[{"type":"text","value":"The Gemini adapter has two image model groups:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Gemini native image models"}]},{"type":"text","value":" (NanoBanana). A model such as "},{"type":"inlineCode","value":"gemini-3.1-flash-image"},{"type":"text","value":" uses the Interactions API. You set an aspect ratio. Some models also take a resolution tier ("},{"type":"inlineCode","value":"512"},{"type":"text","value":", "},{"type":"inlineCode","value":"1K"},{"type":"text","value":", "},{"type":"inlineCode","value":"2K"},{"type":"text","value":", or "},{"type":"inlineCode","value":"4K"},{"type":"text","value":"). TypeScript checks the set for the model."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Imagen models"}]},{"type":"text","value":". A model such as "},{"type":"inlineCode","value":"imagen-4.0-generate-001"},{"type":"text","value":" uses "},{"type":"inlineCode","value":"generateImages"},{"type":"text","value":". You set the size as WIDTHxHEIGHT."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"When the model is in "},{"type":"inlineCode","value":"GEMINI_NATIVE_IMAGE_MODELS"},{"type":"text","value":", the adapter uses the Interactions API. An Imagen model uses "},{"type":"inlineCode","value":"generateImages"},{"type":"text","value":". An unknown id uses "},{"type":"inlineCode","value":"generateImages"},{"type":"text","value":". Import the list or "},{"type":"inlineCode","value":"isGeminiNativeImageModel"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-gemini"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"example-gemini-native-image-generation-nanobanana","children":[{"type":"text","value":"Example: Gemini Native Image Generation (NanoBanana)"}]},{"type":"paragraph","children":[{"type":"text","value":"From the "},{"type":"link","href":"https://github.com/TanStack/ai/tree/main/examples/ts-react-media","children":[{"type":"text","value":"media generation example app"}]},{"type":"text","value":":"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"gemini-3.1-flash-image\"),\n  prompt: \"A futuristic cityscape at sunset\",\n  numberOfImages: 1,\n  size: \"16:9_4K\",\n});\n\nconsole.log(result.images);","lang":"typescript"},{"type":"heading","depth":3,"id":"edit-a-gemini-native-image","children":[{"type":"text","value":"Edit a Gemini native image"}]},{"type":"paragraph","children":[{"type":"text","value":"You have an image from a Gemini native model. You want to change that image without a second upload of that image."}]},{"type":"paragraph","children":[{"type":"text","value":"Pass the last "},{"type":"inlineCode","value":"id"},{"type":"text","value":" back. Write only the change in "},{"type":"inlineCode","value":"prompt"},{"type":"text","value":":"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst adapter = geminiImage(\"gemini-3.1-flash-image\");\n\nconst first = await generateImage({\n  adapter,\n  prompt: \"A red bicycle on a quiet street\",\n});\n\nconst edited = await generateImage({\n  adapter,\n  prompt: \"Make the bicycle blue\",\n  modelOptions: { previous_interaction_id: first.id },\n});","lang":"typescript"},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Generate the first image."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Call "},{"type":"inlineCode","value":"generateImage"},{"type":"text","value":" again with "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":" set to "},{"type":"inlineCode","value":"first.id"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Read "},{"type":"inlineCode","value":"edited.images"},{"type":"text","value":" for the new picture."}]}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"edited.id"},{"type":"text","value":" is the id for the next edit."}]},{"type":"paragraph","children":[{"type":"text","value":"Keep the interaction so the next edit can run:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Leave "},{"type":"inlineCode","value":"store"},{"type":"text","value":" unset."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you set "},{"type":"inlineCode","value":"store"},{"type":"text","value":" to "},{"type":"inlineCode","value":"false"},{"type":"text","value":", a later call cannot use that id."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The API default for "},{"type":"inlineCode","value":"store"},{"type":"text","value":" is "},{"type":"inlineCode","value":"true"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"A free tier keeps a stored interaction for 1 day. A paid tier keeps it for 55 days."}]},{"type":"paragraph","children":[{"type":"text","value":"If the model is Imagen, do not pass "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":". The call throws."}]},{"type":"paragraph","children":[{"type":"text","value":"If this edit needs a new reference image, add that image part on this call. Do not send the image from "},{"type":"inlineCode","value":"first"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The Interactions API is in Beta."}]},{"type":"paragraph","children":[{"type":"text","value":"The same steps are in "},{"type":"link","href":"../media/image-generation#edit-a-gemini-native-image","children":[{"type":"text","value":"Image Generation"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"example-imagen","children":[{"type":"text","value":"Example: Imagen"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"A futuristic cityscape at sunset\",\n  numberOfImages: 1,\n});\n\nconsole.log(result.images);","lang":"typescript"},{"type":"heading","depth":3,"id":"image-size-options","children":[{"type":"text","value":"Image Size Options"}]},{"type":"heading","depth":4,"id":"gemini-native-models-nanobanana","children":[{"type":"text","value":"Gemini Native Models (NanoBanana)"}]},{"type":"paragraph","children":[{"type":"text","value":"Gemini native image models use a template literal size format combining aspect ratio and resolution tier:"}]},{"type":"code","value":"// Format: \"aspectRatio_resolution\"\nsize: \"16:9_4K\"\nsize: \"1:1_2K\"\nsize: \"9:16_1K\"","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"text","value":"The accepted set differs per model, and each model's "},{"type":"inlineCode","value":"size"},{"type":"text","value":" is narrowed to its own set at compile time:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Model"}]},{"type":"tableCell","children":[{"type":"text","value":"Aspect ratios"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolutions"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-3.1-flash-image"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"1:1"},{"type":"text","value":", "},{"type":"inlineCode","value":"2:3"},{"type":"text","value":", "},{"type":"inlineCode","value":"3:2"},{"type":"text","value":", "},{"type":"inlineCode","value":"3:4"},{"type":"text","value":", "},{"type":"inlineCode","value":"4:3"},{"type":"text","value":", "},{"type":"inlineCode","value":"4:5"},{"type":"text","value":", "},{"type":"inlineCode","value":"5:4"},{"type":"text","value":", "},{"type":"inlineCode","value":"9:16"},{"type":"text","value":", "},{"type":"inlineCode","value":"16:9"},{"type":"text","value":", "},{"type":"inlineCode","value":"21:9"},{"type":"text","value":", "},{"type":"inlineCode","value":"1:4"},{"type":"text","value":", "},{"type":"inlineCode","value":"4:1"},{"type":"text","value":", "},{"type":"inlineCode","value":"1:8"},{"type":"text","value":", "},{"type":"inlineCode","value":"8:1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"512"},{"type":"text","value":", "},{"type":"inlineCode","value":"1K"},{"type":"text","value":", "},{"type":"inlineCode","value":"2K"},{"type":"text","value":", "},{"type":"inlineCode","value":"4K"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-3.1-flash-lite-image"}]},{"type":"tableCell","children":[{"type":"text","value":"same 14 as above (see note)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"1K"},{"type":"text","value":" only"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-nano-banana-2.1"}]},{"type":"tableCell","children":[{"type":"text","value":"same 14 as above"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"1K"},{"type":"text","value":", "},{"type":"inlineCode","value":"2K"},{"type":"text","value":", "},{"type":"inlineCode","value":"4K"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-3-pro-image"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"1:1"},{"type":"text","value":", "},{"type":"inlineCode","value":"2:3"},{"type":"text","value":", "},{"type":"inlineCode","value":"3:2"},{"type":"text","value":", "},{"type":"inlineCode","value":"3:4"},{"type":"text","value":", "},{"type":"inlineCode","value":"4:3"},{"type":"text","value":", "},{"type":"inlineCode","value":"4:5"},{"type":"text","value":", "},{"type":"inlineCode","value":"5:4"},{"type":"text","value":", "},{"type":"inlineCode","value":"9:16"},{"type":"text","value":", "},{"type":"inlineCode","value":"16:9"},{"type":"text","value":", "},{"type":"inlineCode","value":"21:9"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"1K"},{"type":"text","value":", "},{"type":"inlineCode","value":"2K"},{"type":"text","value":", "},{"type":"inlineCode","value":"4K"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-2.5-flash-image"}]},{"type":"tableCell","children":[{"type":"text","value":"same 10 as above"}]},{"type":"tableCell","children":[{"type":"text","value":"none — pass the bare ratio, e.g. "},{"type":"inlineCode","value":"size: \"16:9\""}]}]]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"K"},{"type":"text","value":" is case-sensitive ("},{"type":"inlineCode","value":"1k"},{"type":"text","value":" is rejected by the API), the smallest tier's token is "},{"type":"inlineCode","value":"512"},{"type":"text","value":" (not "},{"type":"inlineCode","value":"512px"},{"type":"text","value":" or "},{"type":"inlineCode","value":"0.5K"},{"type":"text","value":"), and "},{"type":"inlineCode","value":"9:21"},{"type":"text","value":" is Vertex/Cloud-only so it is not accepted here. Google documents no "},{"type":"inlineCode","value":"image_size"},{"type":"text","value":" for "},{"type":"inlineCode","value":"gemini-2.5-flash-image"},{"type":"text","value":", so that model takes a bare aspect ratio and the adapter sends no "},{"type":"inlineCode","value":"imageSize"},{"type":"text","value":"."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note on "},{"type":"inlineCode","value":"gemini-3.1-flash-lite-image"},{"type":"text","value":"."}]},{"type":"text","value":" The four extreme banner ratios ("},{"type":"inlineCode","value":"1:4"},{"type":"text","value":", "},{"type":"inlineCode","value":"4:1"},{"type":"text","value":", "},{"type":"inlineCode","value":"1:8"},{"type":"text","value":", "},{"type":"inlineCode","value":"8:1"},{"type":"text","value":") are partially inferred for this model. Unlike the other three, Flash Lite has no per-model ratio table in Google's Gemini API guide; the 14-value set comes from the Cloud model page's explicit enumeration plus the guide's bare \"a discrete set of 14 aspect ratios\" assertion. The only Gemini-API enumeration for it is a 10-item bullet headed \"New aspect ratios\", which we read as a what's-new list rather than an exhaustive one. If the API rejects those four in practice, prefer the 10 standard ratios on this model."}]}]},{"type":"heading","depth":4,"id":"imagen-models","children":[{"type":"text","value":"Imagen Models"}]},{"type":"paragraph","children":[{"type":"text","value":"Imagen models use WIDTHxHEIGHT format, which maps to aspect ratios internally:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Size"}]},{"type":"tableCell","children":[{"type":"text","value":"Aspect Ratio"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"1024x1024"}]},{"type":"tableCell","children":[{"type":"text","value":"1:1"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"1920x1080"}]},{"type":"tableCell","children":[{"type":"text","value":"16:9"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"1080x1920"}]},{"type":"tableCell","children":[{"type":"text","value":"9:16"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Alternatively, you can specify the aspect ratio directly in Model Options:"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"A landscape photo\",\n  modelOptions: {\n    aspectRatio: \"16:9\",\n  },\n});","lang":"typescript"},{"type":"heading","depth":3,"id":"image-model-options","children":[{"type":"text","value":"Image Model Options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" is typed per model family, because the two families hit different APIs."}]},{"type":"paragraph","children":[{"type":"text","value":"Imagen models ("},{"type":"inlineCode","value":"generateImages"},{"type":"text","value":") take "},{"type":"inlineCode","value":"GenerateImagesConfig"},{"type":"text","value":" fields:"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"...\",\n  modelOptions: {\n    aspectRatio: \"16:9\", // \"1:1\" | \"3:4\" | \"4:3\" | \"9:16\" | \"16:9\"\n    personGeneration: \"DONT_ALLOW\", // Control person generation\n    safetyFilterLevel: \"BLOCK_SOME\", // Safety filtering\n  },\n});","lang":"typescript","meta":"ignore"},{"type":"heading","depth":4,"id":"gemini-native-models","children":[{"type":"text","value":"Gemini native models"}]},{"type":"paragraph","children":[{"type":"text","value":"Set native image options on "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":":"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { geminiImage, ThinkingLevel } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"gemini-3.1-flash-image\"),\n  prompt: \"A beautiful garden\",\n  size: \"16:9_4K\",\n  modelOptions: {\n    thinkingConfig: { thinkingLevel: ThinkingLevel.LOW },\n    // imageConfig replaces one field from size. The 16:9 ratio from size stays.\n    // imageConfig accepts only aspectRatio and imageSize.\n    imageConfig: { imageSize: \"2K\" },\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"thinkingConfig.thinkingLevel"},{"type":"text","value":" to one of these values:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ThinkingLevel.MINIMAL"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ThinkingLevel.LOW"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ThinkingLevel.MEDIUM"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ThinkingLevel.HIGH"}]}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"thinkingConfig.thinkingBudget"},{"type":"text","value":" throws."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"systemInstruction"},{"type":"text","value":" contains an image, a file, or a tool call, the call throws."}]},{"type":"paragraph","children":[{"type":"text","value":"Pass the last result "},{"type":"inlineCode","value":"id"},{"type":"text","value":" as "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":". Read "},{"type":"link","href":"#edit-a-gemini-native-image","children":[{"type":"text","value":"Edit a Gemini native image"}]},{"type":"text","value":" for the edit steps."}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../media/image-generation","children":[{"type":"text","value":"Image Generation"}]},{"type":"text","value":" for the full native option list."}]},{"type":"heading","depth":2,"id":"text-to-speech-experimental","children":[{"type":"text","value":"Text-to-Speech (Experimental)"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Gemini TTS is experimental and may require the Live API for full functionality."}]}]},{"type":"paragraph","children":[{"type":"text","value":"Generate speech from text:"}]},{"type":"code","value":"import { generateSpeech } from \"@tanstack/ai\";\nimport { geminiSpeech } from \"@tanstack/ai-gemini\";\n\nconst result = await generateSpeech({\n  adapter: geminiSpeech(\"gemini-3.1-flash-tts-preview\"),\n  text: \"Hello from Gemini TTS!\",\n});\n\nconsole.log(result.audio); // Base64 encoded audio","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Gemini names speakers in the prompt and maps each name to a voice. Pass "},{"type":"inlineCode","value":"turns"},{"type":"text","value":"\nand the adapter does both for you, using the voice name as the speaker label:"}]},{"type":"code","value":"import { generateSpeech } from \"@tanstack/ai\";\nimport { geminiSpeech } from \"@tanstack/ai-gemini\";\n\nconst result = await generateSpeech({\n  adapter: geminiSpeech(\"gemini-3.1-flash-tts-preview\"),\n  turns: [\n    { text: \"Hey, how is it going?\", voice: \"Puck\" },\n    { text: \"Not bad, you?\", voice: \"Kore\" },\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Gemini accepts "},{"type":"strong","children":[{"type":"text","value":"two distinct voices"}]},{"type":"text","value":" per request, and a third is rejected\nbefore the call is made. Each voice must be one of the prebuilt Gemini voices.\nGemini reports no timings, so "},{"type":"inlineCode","value":"timestamps: true"},{"type":"text","value":" is rejected on this adapter."}]},{"type":"heading","depth":2,"id":"environment-variables","children":[{"type":"text","value":"Environment Variables"}]},{"type":"paragraph","children":[{"type":"text","value":"Set your API key in environment variables:"}]},{"type":"code","value":"GEMINI_API_KEY=your-api-key-here\n# or\nGOOGLE_API_KEY=your-api-key-here","lang":"bash"},{"type":"heading","depth":2,"id":"getting-an-api-key","children":[{"type":"text","value":"Getting an API Key"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Go to "},{"type":"link","href":"https://aistudio.google.com/apikey","children":[{"type":"text","value":"Google AI Studio"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Create a new API key"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add it to your environment variables"}]}]}]},{"type":"heading","depth":2,"id":"popular-image-models","children":[{"type":"text","value":"Popular Image Models"}]},{"type":"heading","depth":3,"id":"gemini-native-image-models-nanobanana","children":[{"type":"text","value":"Gemini Native Image Models (NanoBanana)"}]},{"type":"paragraph","children":[{"type":"text","value":"These models use the Interactions API. Each model has its own resolution tiers."}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Model"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-3.1-flash-image"}]},{"type":"tableCell","children":[{"type":"text","value":"Nano Banana 2 — latest and fastest Gemini native image generation (512/1K/2K/4K)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-3.1-flash-lite-image"}]},{"type":"tableCell","children":[{"type":"text","value":"Nano Banana 2 Lite — ultra-low-latency, low-cost image generation (1K only)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-nano-banana-2.1"}]},{"type":"tableCell","children":[{"type":"text","value":"Nano Banana 2.1 (1K/2K/4K, no 512 tier)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-3-pro-image"}]},{"type":"tableCell","children":[{"type":"text","value":"Nano Banana Pro — higher quality Gemini native image generation (1K/2K/4K)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gemini-2.5-flash-image"}]},{"type":"tableCell","children":[{"type":"text","value":"Nano Banana — legacy; shuts down 2026-10-02. Takes a bare aspect ratio"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"gemini-3.1-flash-image-preview"},{"type":"text","value":" and "},{"type":"inlineCode","value":"gemini-3-pro-image-preview"},{"type":"text","value":" ids were shut down on 2026-06-25. They remain in the type union as deprecated aliases so existing code compiles, but calls to them fail — use the GA ids above."}]},{"type":"heading","depth":3,"id":"imagen-models-2","children":[{"type":"text","value":"Imagen Models"}]},{"type":"paragraph","children":[{"type":"text","value":"These models use the dedicated "},{"type":"inlineCode","value":"generateImages"},{"type":"text","value":" API."}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Model"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"imagen-4.0-ultra-generate-001"}]},{"type":"tableCell","children":[{"type":"text","value":"Best quality Imagen image generation"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"imagen-4.0-generate-001"}]},{"type":"tableCell","children":[{"type":"text","value":"High quality Imagen image generation"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"imagen-4.0-fast-generate-001"}]},{"type":"tableCell","children":[{"type":"text","value":"Fast Imagen image generation"}]}]]},{"type":"heading","depth":2,"id":"api-reference","children":[{"type":"text","value":"API Reference"}]},{"type":"paragraph","children":[{"type":"text","value":"Every factory pair follows the same shape: the short factory ("},{"type":"inlineCode","value":"geminiText"},{"type":"text","value":", "},{"type":"inlineCode","value":"geminiImage"},{"type":"text","value":", …) reads "},{"type":"inlineCode","value":"GEMINI_API_KEY"},{"type":"text","value":" (or "},{"type":"inlineCode","value":"GOOGLE_API_KEY"},{"type":"text","value":") from the environment, while the "},{"type":"inlineCode","value":"create*"},{"type":"text","value":" variant takes an explicit API key. Both take "},{"type":"inlineCode","value":"model"},{"type":"text","value":" as the first argument."}]},{"type":"heading","depth":3,"id":"geminitext-model-config-creategeminichat-model-apikey-config","children":[{"type":"inlineCode","value":"geminiText(model, config?)"},{"type":"text","value":" / "},{"type":"inlineCode","value":"createGeminiChat(model, apiKey, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Gemini text/chat adapter."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Parameters:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"model"},{"type":"text","value":" - Gemini chat model id (e.g. "},{"type":"inlineCode","value":"\"gemini-3.1-pro-preview\""},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"config?.baseURL"},{"type":"text","value":" - Custom base URL (optional)"}]}]}]},{"type":"heading","depth":3,"id":"geminitextinteractions-model-config-creategeminitextinteractions-model-apikey-config-experimental","children":[{"type":"inlineCode","value":"geminiTextInteractions(model, config?)"},{"type":"text","value":" / "},{"type":"inlineCode","value":"createGeminiTextInteractions(model, apiKey, config?)"},{"type":"text","value":" (experimental)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Gemini Interactions API text adapter. Backs the stateful conversation pattern via "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":". Exported from "},{"type":"inlineCode","value":"@tanstack/ai-gemini/experimental"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Parameters:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"model"},{"type":"text","value":" - Gemini chat model id (e.g. "},{"type":"inlineCode","value":"\"gemini-3.5-flash\""},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"config?.baseURL"},{"type":"text","value":" - Custom base URL (optional)"}]}]}]},{"type":"heading","depth":3,"id":"geminisummarize-model-config-creategeminisummarize-model-apikey-config","children":[{"type":"inlineCode","value":"geminiSummarize(model, config?)"},{"type":"text","value":" / "},{"type":"inlineCode","value":"createGeminiSummarize(model, apiKey, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Gemini summarization adapter."}]},{"type":"heading","depth":3,"id":"geminiimage-model-config-creategeminiimage-model-apikey-config","children":[{"type":"inlineCode","value":"geminiImage(model, config?)"},{"type":"text","value":" / "},{"type":"inlineCode","value":"createGeminiImage(model, apiKey, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Gemini image adapter. When the model is in "},{"type":"inlineCode","value":"GEMINI_NATIVE_IMAGE_MODELS"},{"type":"text","value":", the call uses the Interactions API. "},{"type":"inlineCode","value":"result.id"},{"type":"text","value":" is the interaction id. An Imagen model uses "},{"type":"inlineCode","value":"generateImages"},{"type":"text","value":". An unknown id uses "},{"type":"inlineCode","value":"generateImages"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"geminispeech-model-config-creategeminispeech-model-apikey-config","children":[{"type":"inlineCode","value":"geminiSpeech(model, config?)"},{"type":"text","value":" / "},{"type":"inlineCode","value":"createGeminiSpeech(model, apiKey, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Gemini text-to-speech adapter. "},{"type":"emphasis","children":[{"type":"text","value":"Experimental."}]}]},{"type":"heading","depth":3,"id":"geminiaudio-model-config-creategeminiaudio-model-apikey-config","children":[{"type":"inlineCode","value":"geminiAudio(model, config?)"},{"type":"text","value":" / "},{"type":"inlineCode","value":"createGeminiAudio(model, apiKey, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Gemini Lyria music generation adapter. "},{"type":"emphasis","children":[{"type":"text","value":"Experimental."}]}]},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../media/image-generation","children":[{"type":"text","value":"Image Generation Guide"}]},{"type":"text","value":" - Learn more about image generation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://github.com/TanStack/ai/tree/main/examples/ts-react-media","children":[{"type":"text","value":"Media Generation Example"}]},{"type":"text","value":" - Full working example with Gemini and fal.ai"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Getting Started"}]},{"type":"text","value":" - Learn the basics"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools Guide"}]},{"type":"text","value":" - Learn about tools"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./openai","children":[{"type":"text","value":"Other Adapters"}]},{"type":"text","value":" - Explore other providers"}]}]}]},{"type":"heading","depth":2,"id":"provider-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"paragraph","children":[{"type":"text","value":"Google Gemini exposes several native tools beyond user-defined function calls.\nImport them from "},{"type":"inlineCode","value":"@tanstack/ai-gemini/tools"},{"type":"text","value":" and pass them into\n"},{"type":"inlineCode","value":"chat({ tools: [...] })"},{"type":"text","value":"."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"For the full concept, a comparison matrix, and type-gating details, see\n"},{"type":"link","href":"../tools/provider-tools.md","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":3,"id":"codeexecutiontool","children":[{"type":"inlineCode","value":"codeExecutionTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Enables Gemini to execute Python code in a sandboxed environment and return\nresults inline. Takes no arguments — include it in the "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" array to\nactivate code execution."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { codeExecutionTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Calculate the first 10 Fibonacci numbers\" }],\n  tools: [codeExecutionTool()],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Gemini 1.5 Pro, Gemini 2.x, Gemini 2.5 and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"filesearchtool","children":[{"type":"inlineCode","value":"fileSearchTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Searches files that have been uploaded to the Gemini File API. Pass a\n"},{"type":"inlineCode","value":"FileSearch"},{"type":"text","value":" config object with the corpus and file IDs to scope the search."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { fileSearchTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Find the quarterly revenue figures\" }],\n  tools: [\n    fileSearchTool({\n      fileSearchStoreNames: [\"fileSearchStores/my-file-search-store-123\"],\n    }),\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Gemini 2.x and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"googlesearchtool","children":[{"type":"inlineCode","value":"googleSearchTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Enables Gemini to query Google Search and incorporate grounded search results\ninto its response. Pass an optional "},{"type":"inlineCode","value":"GoogleSearch"},{"type":"text","value":" config or call with no\narguments to use defaults."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { googleSearchTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"What's the weather in Tokyo right now?\" }],\n  tools: [googleSearchTool()],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Gemini 1.5 Pro, Gemini 2.x, Gemini 2.5. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"When Google Search returns grounding data, the assistant tool-call part\nincludes "},{"type":"inlineCode","value":"metadata.providerExecuted: true"},{"type":"text","value":" and the normalized\n"},{"type":"inlineCode","value":"metadata.sources"},{"type":"text","value":" array. Gemini's raw "},{"type":"inlineCode","value":"groundingMetadata"},{"type":"text","value":" stays under\n"},{"type":"inlineCode","value":"metadata.gemini"},{"type":"text","value":". The agent loop does not execute this call in your\napplication."}]},{"type":"heading","depth":3,"id":"googlesearchretrievaltool","children":[{"type":"inlineCode","value":"googleSearchRetrievalTool"}]},{"type":"paragraph","children":[{"type":"text","value":"A retrieval-augmented variant of Google Search that returns ranked passages\nfrom the web with configurable dynamic retrieval mode. Pass an optional\n"},{"type":"inlineCode","value":"GoogleSearchRetrieval"},{"type":"text","value":" config."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { googleSearchRetrievalTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Explain the latest JavaScript proposals\" }],\n  tools: [\n    googleSearchRetrievalTool({\n      dynamicRetrievalConfig: { mode: \"MODE_DYNAMIC\", dynamicThreshold: 0.7 },\n    }),\n  ],\n});","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Gemini 1.5 Pro and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"googlemapstool","children":[{"type":"inlineCode","value":"googleMapsTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Connects Gemini to the Google Maps API for location-aware queries such as\ndirections, place search, and geocoding. Pass an optional "},{"type":"inlineCode","value":"GoogleMaps"},{"type":"text","value":" config\nor call with no arguments."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { googleMapsTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-2.5-pro\"),\n  messages: [{ role: \"user\", content: \"Find coffee shops near Union Square, SF\" }],\n  tools: [googleMapsTool()],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Gemini 2.5 and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"urlcontexttool","children":[{"type":"inlineCode","value":"urlContextTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Fetches and includes the content of URLs mentioned in the conversation so\nGemini can reason over live web pages. Takes no arguments."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { urlContextTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Summarise https://example.com/article\" }],\n  tools: [urlContextTool()],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Gemini 2.x and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"computerusetool","children":[{"type":"inlineCode","value":"computerUseTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Allows Gemini to observe a virtual desktop via screenshots and interact with\nit using predefined computer-use functions. Provide the "},{"type":"inlineCode","value":"environment"},{"type":"text","value":" and\noptionally restrict callable functions via "},{"type":"inlineCode","value":"excludedPredefinedFunctions"},{"type":"text","value":"."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { computerUseTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Navigate to example.com in the browser\" }],\n  tools: [\n    computerUseTool({\n      environment: \"browser\",\n    }),\n  ],\n});","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" Gemini 2.5 and above. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"basic-usage-custom-api-key","text":"Basic Usage - Custom API Key","level":2},{"id":"configuration","text":"Configuration","level":2},{"id":"behind-a-proxy","text":"Behind a proxy","level":2},{"id":"example-chat-completion","text":"Example: Chat Completion","level":2},{"id":"example-with-tools","text":"Example: With Tools","level":2},{"id":"video-understanding","text":"Video Understanding","level":2},{"id":"agentic-understanding","text":"Agentic understanding","level":3},{"id":"stateful-conversations-interactions-api-experimental","text":"Stateful Conversations — Interactions API (Experimental)","level":2},{"id":"basic-usage-2","text":"Basic Usage","level":3},{"id":"wiring-with-usechat-react","text":"Wiring with useChat (React)","level":3},{"id":"how-it-differs-from-geminitext","text":"How it differs from geminiText","level":3},{"id":"provider-options","text":"Provider Options","level":3},{"id":"reading-the-interaction-id","text":"Reading the interaction id","level":3},{"id":"caveats","text":"Caveats","level":3},{"id":"model-options","text":"Model Options","level":2},{"id":"thinking","text":"Thinking","level":3},{"id":"structured-output","text":"Structured Output","level":3},{"id":"summarization","text":"Summarization","level":2},{"id":"embeddings","text":"Embeddings","level":2},{"id":"image-generation","text":"Image Generation","level":2},{"id":"example-gemini-native-image-generation-nanobanana","text":"Example: Gemini Native Image Generation (NanoBanana)","level":3},{"id":"edit-a-gemini-native-image","text":"Edit a Gemini native image","level":3},{"id":"example-imagen","text":"Example: Imagen","level":3},{"id":"image-size-options","text":"Image Size Options","level":3},{"id":"gemini-native-models-nanobanana","text":"Gemini Native Models (NanoBanana)","level":4},{"id":"imagen-models","text":"Imagen Models","level":4},{"id":"image-model-options","text":"Image Model Options","level":3},{"id":"gemini-native-models","text":"Gemini native models","level":4},{"id":"text-to-speech-experimental","text":"Text-to-Speech (Experimental)","level":2},{"id":"environment-variables","text":"Environment Variables","level":2},{"id":"getting-an-api-key","text":"Getting an API Key","level":2},{"id":"popular-image-models","text":"Popular Image Models","level":2},{"id":"gemini-native-image-models-nanobanana","text":"Gemini Native Image Models (NanoBanana)","level":3},{"id":"imagen-models-2","text":"Imagen Models","level":3},{"id":"api-reference","text":"API Reference","level":2},{"id":"geminitext-model-config-creategeminichat-model-apikey-config","text":"geminiText(model, config?) / createGeminiChat(model, apiKey, config?)","level":3},{"id":"geminitextinteractions-model-config-creategeminitextinteractions-model-apikey-config-experimental","text":"geminiTextInteractions(model, config?) / createGeminiTextInteractions(model, apiKey, config?) (experimental)","level":3},{"id":"geminisummarize-model-config-creategeminisummarize-model-apikey-config","text":"geminiSummarize(model, config?) / createGeminiSummarize(model, apiKey, config?)","level":3},{"id":"geminiimage-model-config-creategeminiimage-model-apikey-config","text":"geminiImage(model, config?) / createGeminiImage(model, apiKey, config?)","level":3},{"id":"geminispeech-model-config-creategeminispeech-model-apikey-config","text":"geminiSpeech(model, config?) / createGeminiSpeech(model, apiKey, config?)","level":3},{"id":"geminiaudio-model-config-creategeminiaudio-model-apikey-config","text":"geminiAudio(model, config?) / createGeminiAudio(model, apiKey, config?)","level":3},{"id":"next-steps","text":"Next Steps","level":2},{"id":"provider-tools","text":"Provider Tools","level":2},{"id":"codeexecutiontool","text":"codeExecutionTool","level":3},{"id":"filesearchtool","text":"fileSearchTool","level":3},{"id":"googlesearchtool","text":"googleSearchTool","level":3},{"id":"googlesearchretrievaltool","text":"googleSearchRetrievalTool","level":3},{"id":"googlemapstool","text":"googleMapsTool","level":3},{"id":"urlcontexttool","text":"urlContextTool","level":3},{"id":"computerusetool","text":"computerUseTool","level":3}]},"frameworks":["react","vue","solid","svelte","preact","angular","vanilla","octane"],"downloadMarkdown":"\nThe Google Gemini adapter provides access to Google's Gemini models, including text generation, image generation with both Imagen and Gemini native image models (NanoBanana), and experimental text-to-speech.\n\nFor a full working example with image generation, see the [media generation example app](https://github.com/TanStack/ai/tree/main/examples/ts-react-media).\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-gemini\nvue: @tanstack/ai-gemini\nsolid: @tanstack/ai-gemini\nsvelte: @tanstack/ai-gemini\npreact: @tanstack/ai-gemini\nangular: @tanstack/ai-gemini\nvanilla: @tanstack/ai-gemini\noctane: @tanstack/ai-gemini\n\n<!-- ::end:tabs -->\n\nNeed Gemini on Vertex AI (regional endpoints and Google Cloud credentials)? Use the [Vertex adapter](./vertex).\n\n## Basic Usage\n\nUse `gemini-3.8-flash` for chat with multimodal input, thinking, and built-in tools. It also supports structured output and caching.\n\nFor Gemini 3.8 Flash, set `modelOptions.thinkingConfig.thinkingLevel` to `LOW`, `MEDIUM`, or `HIGH`. The Interactions adapter uses `modelOptions.generation_config.thinking_level` with `low`, `medium`, or `high`. Gemini 3.8 Flash does not accept the `minimal` thinking level.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.8-flash\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Basic Usage - Custom API Key\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { createGeminiChat } from \"@tanstack/ai-gemini\";\n\nconst adapter = createGeminiChat(\"gemini-3.1-pro-preview\", process.env.GEMINI_API_KEY!, {\n  // ... your config options\n});\n\nconst stream = chat({\n  adapter,\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Configuration\n\n```typescript\nimport { createGeminiChat, type GeminiTextConfig } from \"@tanstack/ai-gemini\";\n\nconst config: Omit<GeminiTextConfig, \"apiKey\"> = {\n  baseURL: \"https://generativelanguage.googleapis.com/v1beta\", // Optional\n  defaultHeaders: { \"X-Custom-Header\": \"value\" }, // Optional\n};\n\nconst adapter = createGeminiChat(\"gemini-3.1-pro-preview\", process.env.GEMINI_API_KEY!, config);\n```\n  \n\n## Behind a proxy\n\nRoute every request through a gateway, such as Cloudflare AI Gateway or a corporate proxy, with `baseURL` and `defaultHeaders`. These two option names are the same on every TanStack AI adapter, so one gateway config works for all of them.\n\n```typescript\nimport { createGeminiChat } from \"@tanstack/ai-gemini\";\n\nconst adapter = createGeminiChat(\"gemini-3.8-flash\", process.env.GEMINI_API_KEY!, {\n  baseURL: \"https://gateway.example.com/google-ai-studio\",\n  defaultHeaders: { \"cf-aig-authorization\": `Bearer ${process.env.GATEWAY_TOKEN}` },\n});\n```\n\n`baseURL` sets `httpOptions.baseUrl` and `defaultHeaders` sets `httpOptions.headers`. If you set both forms, `baseURL` and `defaultHeaders` win.\n\n## Example: Chat Completion\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: geminiText(\"gemini-3.1-pro-preview\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Example: With Tools\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { z } from \"zod\";\n\nconst getCalendarEventsDef = toolDefinition({\n  name: \"get_calendar_events\",\n  description: \"Get calendar events for a date\",\n  inputSchema: z.object({\n    date: z.string(),\n  }),\n});\n\nconst getCalendarEvents = getCalendarEventsDef.server(async ({ date }) => {\n  // Fetch calendar events\n  return { events: [] };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: geminiText(\"gemini-3.1-pro-preview\"),\n    messages,\n    tools: [getCalendarEvents],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Video Understanding\n\nAsk questions about a video: \"what happens at 0:30?\", \"summarize the demo\", \"list every product shown\". Upload the file once, then chat about it.\n\nVideo is too large to inline as base64, so upload it to the Gemini Files API first. `uploadGeminiFile()` uploads the file and waits until it is ready to use. `geminiVideoPart()` turns that upload into a message content part.\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { geminiText, uploadGeminiFile, geminiVideoPart } from \"@tanstack/ai-gemini\";\n\nexport async function POST(request: Request) {\n  const file = await uploadGeminiFile(\"./demo.mp4\", { mimeType: \"video/mp4\" });\n\n  const stream = chat({\n    adapter: geminiText(\"gemini-3.8-flash\"),\n    messages: [\n      {\n        role: \"user\",\n        content: [\n          { type: \"text\", content: \"Summarize this video and cite timestamps.\" },\n          geminiVideoPart(file),\n        ],\n      },\n    ],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nBy default Gemini samples the video at 1 frame per second. Tune that single-pass sampling through the part metadata:\n\n```typescript ignore\n// Watch a 30s-90s clip at half a frame per second.\ngeminiVideoPart(file, { fps: 0.5, startOffset: \"30s\", endOffset: \"90s\" });\n```\n\n### Agentic understanding\n\nSingle-pass sampling can miss detail in long or fast-moving videos. Set `processing: \"agentic\"` to let the model drive: it navigates the timeline and pulls frames, transcripts, and audio on demand. Supported models:\n\n- `gemini-3.8-flash`\n- `gemini-3.7-flash`\n- `gemini-3.6-flash`\n- `gemini-3.5-flash-lite`\n\n```typescript ignore\ngeminiVideoPart(file, { processing: \"agentic\" });\n```\n\nWith `agentic`, the adapter routes the request through Gemini's Interactions API, and you express the sampling rate in your prompt (\"watch it at 2 fps\") instead of through `fps`. It is deeper but slower, since it re-analyzes the video on each turn.\n\n## Stateful Conversations — Interactions API (Experimental)\n\nGemini's [Interactions API](https://ai.google.dev/gemini-api/docs/interactions) (currently in Beta) offers server-side conversation state — the Gemini equivalent of OpenAI's Responses API. Instead of replaying the full message history on every turn, you pass a `previous_interaction_id` and the server retains the transcript. This also improves cache hit rates for repeated prefixes.\n\nThe `geminiTextInteractions` adapter routes through `client.interactions.create` and surfaces the server-assigned interaction id via an AG-UI `CUSTOM` event (`name: 'gemini.interactionId'`) emitted just before `RUN_FINISHED`, so you can chain turns.\n\n> **⚠️ Experimental.** Google marks the Interactions API as Beta and explicitly flags possible breaking changes until it reaches general availability. The adapter is exported from the `@tanstack/ai-gemini/experimental` subpath so the experimental status is load-bearing in your editor and bundle. Text output, function tools, and the built-in tools `google_search`, `code_execution`, `url_context`, `file_search`, and `computer_use` are supported. `google_search_retrieval`, `google_maps`, and `mcp_server` still throw on this adapter — use `geminiText()` for those or wait for follow-up work.\n\n### Basic Usage\n\n```typescript ignore\nimport { chat } from \"@tanstack/ai\";\nimport { geminiTextInteractions } from \"@tanstack/ai-gemini/experimental\";\n\n// Turn 1: introduce yourself, capture the interaction id.\nlet interactionId: string | undefined;\n\nfor await (const chunk of chat({\n  adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n  messages: [{ role: \"user\", content: \"Hi, my name is Amir.\" }],\n})) {\n  if (\n    chunk.type === \"CUSTOM\" &&\n    chunk.name === \"gemini.interactionId\" &&\n    chunk.value &&\n    typeof chunk.value === \"object\" &&\n    \"interactionId\" in chunk.value\n  ) {\n    interactionId = String(chunk.value.interactionId);\n  }\n}\n\n// Turn 2: only send the new turn's content — the server has the history.\nfor await (const chunk of chat({\n  adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n  messages: [{ role: \"user\", content: \"What is my name?\" }],\n  modelOptions: {\n    previous_interaction_id: interactionId,\n  },\n})) {\n  // ...stream \"Your name is Amir.\" back to the client.\n}\n```\n\n### Wiring with `useChat` (React)\n\nThe Interactions API is stateful and **does not accept multi-turn history without a `previous_interaction_id`** — if a chat client sends `[user, assistant, user]` to a fresh interaction the adapter throws `cannot send prior conversation history on a fresh interaction`. To make `useChat` work, persist the server-assigned id and send it back on the next turn:\n\n**Server route** (e.g. TanStack Start handler):\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequestBody,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { geminiTextInteractions } from \"@tanstack/ai-gemini/experimental\";\n\nexport async function POST({ request }: { request: Request }) {\n  const params = await chatParamsFromRequestBody(await request.json());\n\n  // The client sends body.previousInteractionId; AG-UI maps `body` into\n  // `forwardedProps` on the wire.\n  const previousInteractionId =\n    typeof params.forwardedProps.previousInteractionId === \"string\"\n      ? params.forwardedProps.previousInteractionId\n      : undefined;\n\n  const stream = chat({\n    adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n    messages: params.messages,\n    modelOptions: {\n      previous_interaction_id: previousInteractionId,\n      store: true, // required for chaining on the next turn\n    },\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n**React client**:\n\n```tsx\nimport { useEffect, useMemo, useState } from \"react\";\nimport { fetchServerSentEvents, useChat } from \"@tanstack/ai-react\";\n\nfunction GeminiChat() {\n  const [interactionId, setInteractionId] = useState<string | undefined>();\n\n  const body = useMemo(\n    () => (interactionId ? { previousInteractionId: interactionId } : {}),\n    [interactionId],\n  );\n\n  const { messages, setMessages, sendMessage } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    body,\n    onCustomEvent: (eventType, data) => {\n      if (\n        eventType === \"gemini.interactionId\" &&\n        typeof data === \"object\" &&\n        data !== null &&\n        \"interactionId\" in data\n      ) {\n        setInteractionId(String(data.interactionId));\n      }\n    },\n  });\n\n  // Switching provider/model resets the server-side chain — drop the id\n  // AND the local message history together, otherwise the next turn\n  // ships multi-turn messages with no previous_interaction_id and the\n  // adapter errors out.\n  const [provider, setProvider] = useState(\"gemini-interactions\");\n  useEffect(() => {\n    setInteractionId(undefined);\n    setMessages([]);\n  }, [provider]);\n\n  // ...render messages, call sendMessage(input)\n}\n```\n\nThe full working example is in [`examples/ts-react-chat`](https://github.com/TanStack/ai/tree/main/examples/ts-react-chat) — see `src/routes/index.tsx` for the client and `src/routes/api.tanchat.ts` for the route.\n\n### How it differs from `geminiText`\n\n| Concern | `geminiText` | `geminiTextInteractions` |\n| --- | --- | --- |\n| Underlying endpoint | `models:generateContent` | `interactions:create` |\n| Conversation state | Stateless — send full history each turn | Stateful — server retains transcript via `previous_interaction_id` |\n| Provider options shape | camelCase (`stopSequences`, `responseModalities`, `safetySettings`) | snake_case (`generation_config`, `response_modalities`, `previous_interaction_id`) |\n| Built-in tools | `google_search`, `code_execution`, `url_context`, `file_search`, `google_maps`, `google_search_retrieval`, `computer_use` | `google_search`, `code_execution`, `url_context`, `file_search`, `computer_use` (only the first four stream `CUSTOM` event activity; `computer_use` is accepted in the request but does not currently emit per-delta events) |\n| Stability | GA | Experimental (Google Beta) |\n\n### Provider Options\n\nThe adapter exposes Interactions-specific options on `modelOptions`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiTextInteractions } from \"@tanstack/ai-gemini/experimental\";\n\nconst stream = chat({\n  adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    // Stateful chaining — passed only on turn 2+.\n    previous_interaction_id: \"int_abc123\",\n\n    // Persist the interaction server-side (default true). Must be true for\n    // previous_interaction_id to work on the *next* turn.\n    store: true,\n\n    // Per-request system instruction (interaction-scoped — re-specify each turn).\n    system_instruction: \"You are a helpful assistant.\",\n\n    // snake_case generation config distinct from geminiText's camelCase one.\n    generation_config: {\n      thinking_level: \"low\",\n      thinking_summaries: \"auto\",\n      stop_sequences: [\"<done>\"],\n    },\n\n    response_modalities: [\"text\"],\n  },\n});\n```\n\n### Reading the interaction id\n\nThe server's interaction id arrives as an AG-UI `CUSTOM` event emitted just before `RUN_FINISHED`:\n\n```typescript ignore\nfor await (const chunk of stream) {\n  if (\n    chunk.type === \"CUSTOM\" &&\n    chunk.name === \"gemini.interactionId\" &&\n    typeof chunk.value === \"object\" &&\n    chunk.value !== null &&\n    \"interactionId\" in chunk.value\n  ) {\n    const id = String(chunk.value.interactionId);\n    // Persist `id` wherever you store per-user conversation pointers —\n    // pass it back on the next turn as `previous_interaction_id`.\n  }\n}\n```\n\n### Caveats\n\n- **Multi-turn history requires `previous_interaction_id`.** The Interactions API has no stateless replay path — sending more than one message in `messages` without a `previous_interaction_id` throws. Chat UIs that maintain local history must capture the server-assigned id and chain (see [Wiring with `useChat`](#wiring-with-usechat-react)). On provider/model switch, also clear the local message buffer.\n- **Tools, `system_instruction`, and `generation_config` are interaction-scoped.** Per Google's docs these are NOT inherited from a prior interaction via `previous_interaction_id` — pass them again on every turn you need them.\n- `store: false` is incompatible with `previous_interaction_id` (no state to recall) and with `background: true`.\n- Retention (as of the time of writing): **55 days on the Paid Tier, 1 day on the Free Tier.** See [Google's Interactions API docs](https://ai.google.dev/gemini-api/docs/interactions) for current retention policy.\n- Built-in tools in scope (`google_search`, `code_execution`, `url_context`, `file_search`, `computer_use`) are wired through as request tools. Per-delta activity for the four search/exec tools streams back as AG-UI `CUSTOM` events — `gemini.googleSearchCall` / `gemini.googleSearchResult` (and the matching `codeExecutionCall`/`Result`, `urlContextCall`/`Result`, `fileSearchCall`/`Result`) — carrying the raw Interactions delta. `computer_use` is accepted in the request but the Interactions API does not currently emit per-delta `CUSTOM` events for it. Function-tool `TOOL_CALL_*` events are unchanged, and `finishReason` stays `stop` when only built-in tools ran.\n- `google_search_retrieval`, `google_maps`, and `mcp_server` still throw a targeted error on this adapter. Use `geminiText()` for the first two, or wait for a dedicated follow-up for `mcp_server`.\n- Image and audio output via Interactions aren't routed through this adapter yet — it's text-only. Use `geminiImage` / `geminiSpeech` for non-text generation for now.\n\n## Model Options\n\nGemini supports various model-specific options. Sampling parameters live here too — `temperature`, `topP`, and `maxOutputTokens` — rather than as root-level props on `chat()`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    maxOutputTokens: 2048,\n    temperature: 0.7,\n    topP: 0.9,\n    topK: 40,\n    stopSequences: [\"END\"],\n  },\n});\n```\n\n> If you previously passed `temperature` / `topP` / `maxTokens` at the root of `chat()`, see [Moving Sampling Options into modelOptions](../migration/sampling-options-to-model-options).\n\n### Thinking\n\nEnable thinking for models that support it:\n\n```typescript ignore\nmodelOptions: {\n  thinking: {\n    includeThoughts: true,\n  },\n}\n```\n\n### Structured Output\n\nConfigure structured output format:\n\n```typescript ignore\nmodelOptions: {\n  responseMimeType: \"application/json\",\n}\n```\n\n## Summarization\n\nSummarize long text content:\n\n```typescript\nimport { summarize } from \"@tanstack/ai\";\nimport { geminiSummarize } from \"@tanstack/ai-gemini\";\n\nconst result = await summarize({\n  adapter: geminiSummarize(\"gemini-3.1-pro-preview\"),\n  text: \"Your long text to summarize...\",\n  maxLength: 100,\n  style: \"concise\", // \"concise\" | \"bullet-points\" | \"paragraph\"\n});\n\nconsole.log(result.summary);\n```\n\n## Embeddings\n\nGenerate embedding vectors with gemini-embedding-001:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { geminiEmbedding } from \"@tanstack/ai-gemini\";\n\nconst result = await embed({\n  adapter: geminiEmbedding(\"gemini-embedding-001\"),\n  input: \"a red guitar\",\n  dimensions: 1536,\n  modelOptions: {\n    taskType: \"RETRIEVAL_DOCUMENT\",\n  },\n});\n\nconsole.log(result.embeddings[0]?.vector);\n```\n\n> The Gemini API's embedding endpoint does not report token usage, so\n> `result.usage` is absent. The Vertex-only multimodal embedding model\n> (`multimodalembedding@001`) is not supported by this adapter.\n\nSee the [Embeddings guide](../embeddings.md) for the full API.\n\n## Image Generation\n\nThe Gemini adapter has two image model groups:\n\n- **Gemini native image models** (NanoBanana). A model such as `gemini-3.1-flash-image` uses the Interactions API. You set an aspect ratio. Some models also take a resolution tier (`512`, `1K`, `2K`, or `4K`). TypeScript checks the set for the model.\n- **Imagen models**. A model such as `imagen-4.0-generate-001` uses `generateImages`. You set the size as WIDTHxHEIGHT.\n\nWhen the model is in `GEMINI_NATIVE_IMAGE_MODELS`, the adapter uses the Interactions API. An Imagen model uses `generateImages`. An unknown id uses `generateImages`. Import the list or `isGeminiNativeImageModel` from `@tanstack/ai-gemini`.\n\n### Example: Gemini Native Image Generation (NanoBanana)\n\nFrom the [media generation example app](https://github.com/TanStack/ai/tree/main/examples/ts-react-media):\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"gemini-3.1-flash-image\"),\n  prompt: \"A futuristic cityscape at sunset\",\n  numberOfImages: 1,\n  size: \"16:9_4K\",\n});\n\nconsole.log(result.images);\n```\n\n### Edit a Gemini native image\n\nYou have an image from a Gemini native model. You want to change that image without a second upload of that image.\n\nPass the last `id` back. Write only the change in `prompt`:\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst adapter = geminiImage(\"gemini-3.1-flash-image\");\n\nconst first = await generateImage({\n  adapter,\n  prompt: \"A red bicycle on a quiet street\",\n});\n\nconst edited = await generateImage({\n  adapter,\n  prompt: \"Make the bicycle blue\",\n  modelOptions: { previous_interaction_id: first.id },\n});\n```\n\n1. Generate the first image.\n2. Call `generateImage` again with `previous_interaction_id` set to `first.id`.\n3. Read `edited.images` for the new picture.\n\n`edited.id` is the id for the next edit.\n\nKeep the interaction so the next edit can run:\n\n1. Leave `store` unset.\n2. If you set `store` to `false`, a later call cannot use that id.\n\nThe API default for `store` is `true`.\n\nA free tier keeps a stored interaction for 1 day. A paid tier keeps it for 55 days.\n\nIf the model is Imagen, do not pass `previous_interaction_id`. The call throws.\n\nIf this edit needs a new reference image, add that image part on this call. Do not send the image from `first`.\n\nThe Interactions API is in Beta.\n\nThe same steps are in [Image Generation](../media/image-generation#edit-a-gemini-native-image).\n\n### Example: Imagen\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"A futuristic cityscape at sunset\",\n  numberOfImages: 1,\n});\n\nconsole.log(result.images);\n```\n\n### Image Size Options\n\n#### Gemini Native Models (NanoBanana)\n\nGemini native image models use a template literal size format combining aspect ratio and resolution tier:\n\n```typescript ignore\n// Format: \"aspectRatio_resolution\"\nsize: \"16:9_4K\"\nsize: \"1:1_2K\"\nsize: \"9:16_1K\"\n```\n\nThe accepted set differs per model, and each model's `size` is narrowed to its own set at compile time:\n\n| Model | Aspect ratios | Resolutions |\n|-------|---------------|-------------|\n| `gemini-3.1-flash-image` | `1:1`, `2:3`, `3:2`, `3:4`, `4:3`, `4:5`, `5:4`, `9:16`, `16:9`, `21:9`, `1:4`, `4:1`, `1:8`, `8:1` | `512`, `1K`, `2K`, `4K` |\n| `gemini-3.1-flash-lite-image` | same 14 as above (see note) | `1K` only |\n| `gemini-nano-banana-2.1` | same 14 as above | `1K`, `2K`, `4K` |\n| `gemini-3-pro-image` | `1:1`, `2:3`, `3:2`, `3:4`, `4:3`, `4:5`, `5:4`, `9:16`, `16:9`, `21:9` | `1K`, `2K`, `4K` |\n| `gemini-2.5-flash-image` | same 10 as above | none — pass the bare ratio, e.g. `size: \"16:9\"` |\n\nThe `K` is case-sensitive (`1k` is rejected by the API), the smallest tier's token is `512` (not `512px` or `0.5K`), and `9:21` is Vertex/Cloud-only so it is not accepted here. Google documents no `image_size` for `gemini-2.5-flash-image`, so that model takes a bare aspect ratio and the adapter sends no `imageSize`.\n\n> **Note on `gemini-3.1-flash-lite-image`.** The four extreme banner ratios (`1:4`, `4:1`, `1:8`, `8:1`) are partially inferred for this model. Unlike the other three, Flash Lite has no per-model ratio table in Google's Gemini API guide; the 14-value set comes from the Cloud model page's explicit enumeration plus the guide's bare \"a discrete set of 14 aspect ratios\" assertion. The only Gemini-API enumeration for it is a 10-item bullet headed \"New aspect ratios\", which we read as a what's-new list rather than an exhaustive one. If the API rejects those four in practice, prefer the 10 standard ratios on this model.\n\n#### Imagen Models\n\nImagen models use WIDTHxHEIGHT format, which maps to aspect ratios internally:\n\n| Size | Aspect Ratio |\n|------|-------------|\n| `1024x1024` | 1:1 |\n| `1920x1080` | 16:9 |\n| `1080x1920` | 9:16 |\n\nAlternatively, you can specify the aspect ratio directly in Model Options:\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"A landscape photo\",\n  modelOptions: {\n    aspectRatio: \"16:9\",\n  },\n});\n```\n\n### Image Model Options\n\n`modelOptions` is typed per model family, because the two families hit different APIs.\n\nImagen models (`generateImages`) take `GenerateImagesConfig` fields:\n\n```typescript ignore\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"...\",\n  modelOptions: {\n    aspectRatio: \"16:9\", // \"1:1\" | \"3:4\" | \"4:3\" | \"9:16\" | \"16:9\"\n    personGeneration: \"DONT_ALLOW\", // Control person generation\n    safetyFilterLevel: \"BLOCK_SOME\", // Safety filtering\n  },\n});\n```\n\n#### Gemini native models\n\nSet native image options on `modelOptions`:\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage, ThinkingLevel } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"gemini-3.1-flash-image\"),\n  prompt: \"A beautiful garden\",\n  size: \"16:9_4K\",\n  modelOptions: {\n    thinkingConfig: { thinkingLevel: ThinkingLevel.LOW },\n    // imageConfig replaces one field from size. The 16:9 ratio from size stays.\n    // imageConfig accepts only aspectRatio and imageSize.\n    imageConfig: { imageSize: \"2K\" },\n  },\n});\n```\n\nSet `thinkingConfig.thinkingLevel` to one of these values:\n\n- `ThinkingLevel.MINIMAL`\n- `ThinkingLevel.LOW`\n- `ThinkingLevel.MEDIUM`\n- `ThinkingLevel.HIGH`\n\n`thinkingConfig.thinkingBudget` throws.\n\nIf `systemInstruction` contains an image, a file, or a tool call, the call throws.\n\nPass the last result `id` as `previous_interaction_id`. Read [Edit a Gemini native image](#edit-a-gemini-native-image) for the edit steps.\n\nSee [Image Generation](../media/image-generation) for the full native option list.\n\n## Text-to-Speech (Experimental)\n\n> **Note:** Gemini TTS is experimental and may require the Live API for full functionality.\n\nGenerate speech from text:\n\n```typescript\nimport { generateSpeech } from \"@tanstack/ai\";\nimport { geminiSpeech } from \"@tanstack/ai-gemini\";\n\nconst result = await generateSpeech({\n  adapter: geminiSpeech(\"gemini-3.1-flash-tts-preview\"),\n  text: \"Hello from Gemini TTS!\",\n});\n\nconsole.log(result.audio); // Base64 encoded audio\n```\n\nGemini names speakers in the prompt and maps each name to a voice. Pass `turns`\nand the adapter does both for you, using the voice name as the speaker label:\n\n```typescript\nimport { generateSpeech } from \"@tanstack/ai\";\nimport { geminiSpeech } from \"@tanstack/ai-gemini\";\n\nconst result = await generateSpeech({\n  adapter: geminiSpeech(\"gemini-3.1-flash-tts-preview\"),\n  turns: [\n    { text: \"Hey, how is it going?\", voice: \"Puck\" },\n    { text: \"Not bad, you?\", voice: \"Kore\" },\n  ],\n});\n```\n\nGemini accepts **two distinct voices** per request, and a third is rejected\nbefore the call is made. Each voice must be one of the prebuilt Gemini voices.\nGemini reports no timings, so `timestamps: true` is rejected on this adapter.\n\n## Environment Variables\n\nSet your API key in environment variables:\n\n```bash\nGEMINI_API_KEY=your-api-key-here\n# or\nGOOGLE_API_KEY=your-api-key-here\n```\n\n## Getting an API Key\n\n1. Go to [Google AI Studio](https://aistudio.google.com/apikey)\n2. Create a new API key\n3. Add it to your environment variables\n\n## Popular Image Models\n\n### Gemini Native Image Models (NanoBanana)\n\nThese models use the Interactions API. Each model has its own resolution tiers.\n\n| Model | Description |\n|-------|-------------|\n| `gemini-3.1-flash-image` | Nano Banana 2 — latest and fastest Gemini native image generation (512/1K/2K/4K) |\n| `gemini-3.1-flash-lite-image` | Nano Banana 2 Lite — ultra-low-latency, low-cost image generation (1K only) |\n| `gemini-nano-banana-2.1` | Nano Banana 2.1 (1K/2K/4K, no 512 tier) |\n| `gemini-3-pro-image` | Nano Banana Pro — higher quality Gemini native image generation (1K/2K/4K) |\n| `gemini-2.5-flash-image` | Nano Banana — legacy; shuts down 2026-10-02. Takes a bare aspect ratio |\n\nThe `gemini-3.1-flash-image-preview` and `gemini-3-pro-image-preview` ids were shut down on 2026-06-25. They remain in the type union as deprecated aliases so existing code compiles, but calls to them fail — use the GA ids above.\n\n### Imagen Models\n\nThese models use the dedicated `generateImages` API.\n\n| Model | Description |\n|-------|-------------|\n| `imagen-4.0-ultra-generate-001` | Best quality Imagen image generation |\n| `imagen-4.0-generate-001` | High quality Imagen image generation |\n| `imagen-4.0-fast-generate-001` | Fast Imagen image generation |\n\n## API Reference\n\nEvery factory pair follows the same shape: the short factory (`geminiText`, `geminiImage`, …) reads `GEMINI_API_KEY` (or `GOOGLE_API_KEY`) from the environment, while the `create*` variant takes an explicit API key. Both take `model` as the first argument.\n\n### `geminiText(model, config?)` / `createGeminiChat(model, apiKey, config?)`\n\nCreates a Gemini text/chat adapter.\n\n**Parameters:**\n\n- `model` - Gemini chat model id (e.g. `\"gemini-3.1-pro-preview\"`)\n- `config?.baseURL` - Custom base URL (optional)\n\n### `geminiTextInteractions(model, config?)` / `createGeminiTextInteractions(model, apiKey, config?)` (experimental)\n\nCreates a Gemini Interactions API text adapter. Backs the stateful conversation pattern via `previous_interaction_id`. Exported from `@tanstack/ai-gemini/experimental`.\n\n**Parameters:**\n\n- `model` - Gemini chat model id (e.g. `\"gemini-3.5-flash\"`)\n- `config?.baseURL` - Custom base URL (optional)\n\n### `geminiSummarize(model, config?)` / `createGeminiSummarize(model, apiKey, config?)`\n\nCreates a Gemini summarization adapter.\n\n### `geminiImage(model, config?)` / `createGeminiImage(model, apiKey, config?)`\n\nCreates a Gemini image adapter. When the model is in `GEMINI_NATIVE_IMAGE_MODELS`, the call uses the Interactions API. `result.id` is the interaction id. An Imagen model uses `generateImages`. An unknown id uses `generateImages`.\n\n### `geminiSpeech(model, config?)` / `createGeminiSpeech(model, apiKey, config?)`\n\nCreates a Gemini text-to-speech adapter. _Experimental._\n\n### `geminiAudio(model, config?)` / `createGeminiAudio(model, apiKey, config?)`\n\nCreates a Gemini Lyria music generation adapter. _Experimental._\n\n## Next Steps\n\n- [Image Generation Guide](../media/image-generation) - Learn more about image generation\n- [Media Generation Example](https://github.com/TanStack/ai/tree/main/examples/ts-react-media) - Full working example with Gemini and fal.ai\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Other Adapters](./openai) - Explore other providers\n\n## Provider Tools\n\nGoogle Gemini exposes several native tools beyond user-defined function calls.\nImport them from `@tanstack/ai-gemini/tools` and pass them into\n`chat({ tools: [...] })`.\n\n> For the full concept, a comparison matrix, and type-gating details, see\n> [Provider Tools](../tools/provider-tools.md).\n\n### `codeExecutionTool`\n\nEnables Gemini to execute Python code in a sandboxed environment and return\nresults inline. Takes no arguments — include it in the `tools` array to\nactivate code execution.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { codeExecutionTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Calculate the first 10 Fibonacci numbers\" }],\n  tools: [codeExecutionTool()],\n});\n```\n\n**Supported models:** Gemini 1.5 Pro, Gemini 2.x, Gemini 2.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `fileSearchTool`\n\nSearches files that have been uploaded to the Gemini File API. Pass a\n`FileSearch` config object with the corpus and file IDs to scope the search.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { fileSearchTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Find the quarterly revenue figures\" }],\n  tools: [\n    fileSearchTool({\n      fileSearchStoreNames: [\"fileSearchStores/my-file-search-store-123\"],\n    }),\n  ],\n});\n```\n\n**Supported models:** Gemini 2.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `googleSearchTool`\n\nEnables Gemini to query Google Search and incorporate grounded search results\ninto its response. Pass an optional `GoogleSearch` config or call with no\narguments to use defaults.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { googleSearchTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"What's the weather in Tokyo right now?\" }],\n  tools: [googleSearchTool()],\n});\n```\n\n**Supported models:** Gemini 1.5 Pro, Gemini 2.x, Gemini 2.5. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\nWhen Google Search returns grounding data, the assistant tool-call part\nincludes `metadata.providerExecuted: true` and the normalized\n`metadata.sources` array. Gemini's raw `groundingMetadata` stays under\n`metadata.gemini`. The agent loop does not execute this call in your\napplication.\n\n### `googleSearchRetrievalTool`\n\nA retrieval-augmented variant of Google Search that returns ranked passages\nfrom the web with configurable dynamic retrieval mode. Pass an optional\n`GoogleSearchRetrieval` config.\n\n```typescript ignore\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { googleSearchRetrievalTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Explain the latest JavaScript proposals\" }],\n  tools: [\n    googleSearchRetrievalTool({\n      dynamicRetrievalConfig: { mode: \"MODE_DYNAMIC\", dynamicThreshold: 0.7 },\n    }),\n  ],\n});\n```\n\n**Supported models:** Gemini 1.5 Pro and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `googleMapsTool`\n\nConnects Gemini to the Google Maps API for location-aware queries such as\ndirections, place search, and geocoding. Pass an optional `GoogleMaps` config\nor call with no arguments.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { googleMapsTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-2.5-pro\"),\n  messages: [{ role: \"user\", content: \"Find coffee shops near Union Square, SF\" }],\n  tools: [googleMapsTool()],\n});\n```\n\n**Supported models:** Gemini 2.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `urlContextTool`\n\nFetches and includes the content of URLs mentioned in the conversation so\nGemini can reason over live web pages. Takes no arguments.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { urlContextTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Summarise https://example.com/article\" }],\n  tools: [urlContextTool()],\n});\n```\n\n**Supported models:** Gemini 2.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `computerUseTool`\n\nAllows Gemini to observe a virtual desktop via screenshots and interact with\nit using predefined computer-use functions. Provide the `environment` and\noptionally restrict callable functions via `excludedPredefinedFunctions`.\n\n```typescript ignore\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { computerUseTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Navigate to example.com in the browser\" }],\n  tools: [\n    computerUseTool({\n      environment: \"browser\",\n    }),\n  ],\n});\n```\n\n**Supported models:** Gemini 2.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n","originalRawMarkdown":"---\ntitle: Google Gemini\nid: gemini-adapter\norder: 3\ndescription: \"Use Google Gemini with TanStack AI — text, image generation via Imagen and Gemini native (NanoBanana), and experimental TTS via @tanstack/ai-gemini.\"\nkeywords:\n  - tanstack ai\n  - gemini\n  - google gemini\n  - imagen\n  - nano banana\n  - image generation\n  - adapter\n  - google ai\n---\n\nThe Google Gemini adapter provides access to Google's Gemini models, including text generation, image generation with both Imagen and Gemini native image models (NanoBanana), and experimental text-to-speech.\n\nFor a full working example with image generation, see the [media generation example app](https://github.com/TanStack/ai/tree/main/examples/ts-react-media).\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-gemini\nvue: @tanstack/ai-gemini\nsolid: @tanstack/ai-gemini\nsvelte: @tanstack/ai-gemini\npreact: @tanstack/ai-gemini\nangular: @tanstack/ai-gemini\nvanilla: @tanstack/ai-gemini\noctane: @tanstack/ai-gemini\n\n<!-- ::end:tabs -->\n\nNeed Gemini on Vertex AI (regional endpoints and Google Cloud credentials)? Use the [Vertex adapter](./vertex).\n\n## Basic Usage\n\nUse `gemini-3.8-flash` for chat with multimodal input, thinking, and built-in tools. It also supports structured output and caching.\n\nFor Gemini 3.8 Flash, set `modelOptions.thinkingConfig.thinkingLevel` to `LOW`, `MEDIUM`, or `HIGH`. The Interactions adapter uses `modelOptions.generation_config.thinking_level` with `low`, `medium`, or `high`. Gemini 3.8 Flash does not accept the `minimal` thinking level.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.8-flash\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Basic Usage - Custom API Key\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { createGeminiChat } from \"@tanstack/ai-gemini\";\n\nconst adapter = createGeminiChat(\"gemini-3.1-pro-preview\", process.env.GEMINI_API_KEY!, {\n  // ... your config options\n});\n\nconst stream = chat({\n  adapter,\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Configuration\n\n```typescript\nimport { createGeminiChat, type GeminiTextConfig } from \"@tanstack/ai-gemini\";\n\nconst config: Omit<GeminiTextConfig, \"apiKey\"> = {\n  baseURL: \"https://generativelanguage.googleapis.com/v1beta\", // Optional\n  defaultHeaders: { \"X-Custom-Header\": \"value\" }, // Optional\n};\n\nconst adapter = createGeminiChat(\"gemini-3.1-pro-preview\", process.env.GEMINI_API_KEY!, config);\n```\n  \n\n## Behind a proxy\n\nRoute every request through a gateway, such as Cloudflare AI Gateway or a corporate proxy, with `baseURL` and `defaultHeaders`. These two option names are the same on every TanStack AI adapter, so one gateway config works for all of them.\n\n```typescript\nimport { createGeminiChat } from \"@tanstack/ai-gemini\";\n\nconst adapter = createGeminiChat(\"gemini-3.8-flash\", process.env.GEMINI_API_KEY!, {\n  baseURL: \"https://gateway.example.com/google-ai-studio\",\n  defaultHeaders: { \"cf-aig-authorization\": `Bearer ${process.env.GATEWAY_TOKEN}` },\n});\n```\n\n`baseURL` sets `httpOptions.baseUrl` and `defaultHeaders` sets `httpOptions.headers`. If you set both forms, `baseURL` and `defaultHeaders` win.\n\n## Example: Chat Completion\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: geminiText(\"gemini-3.1-pro-preview\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Example: With Tools\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { z } from \"zod\";\n\nconst getCalendarEventsDef = toolDefinition({\n  name: \"get_calendar_events\",\n  description: \"Get calendar events for a date\",\n  inputSchema: z.object({\n    date: z.string(),\n  }),\n});\n\nconst getCalendarEvents = getCalendarEventsDef.server(async ({ date }) => {\n  // Fetch calendar events\n  return { events: [] };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: geminiText(\"gemini-3.1-pro-preview\"),\n    messages,\n    tools: [getCalendarEvents],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Video Understanding\n\nAsk questions about a video: \"what happens at 0:30?\", \"summarize the demo\", \"list every product shown\". Upload the file once, then chat about it.\n\nVideo is too large to inline as base64, so upload it to the Gemini Files API first. `uploadGeminiFile()` uploads the file and waits until it is ready to use. `geminiVideoPart()` turns that upload into a message content part.\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { geminiText, uploadGeminiFile, geminiVideoPart } from \"@tanstack/ai-gemini\";\n\nexport async function POST(request: Request) {\n  const file = await uploadGeminiFile(\"./demo.mp4\", { mimeType: \"video/mp4\" });\n\n  const stream = chat({\n    adapter: geminiText(\"gemini-3.8-flash\"),\n    messages: [\n      {\n        role: \"user\",\n        content: [\n          { type: \"text\", content: \"Summarize this video and cite timestamps.\" },\n          geminiVideoPart(file),\n        ],\n      },\n    ],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nBy default Gemini samples the video at 1 frame per second. Tune that single-pass sampling through the part metadata:\n\n```typescript ignore\n// Watch a 30s-90s clip at half a frame per second.\ngeminiVideoPart(file, { fps: 0.5, startOffset: \"30s\", endOffset: \"90s\" });\n```\n\n### Agentic understanding\n\nSingle-pass sampling can miss detail in long or fast-moving videos. Set `processing: \"agentic\"` to let the model drive: it navigates the timeline and pulls frames, transcripts, and audio on demand. Supported models:\n\n- `gemini-3.8-flash`\n- `gemini-3.7-flash`\n- `gemini-3.6-flash`\n- `gemini-3.5-flash-lite`\n\n```typescript ignore\ngeminiVideoPart(file, { processing: \"agentic\" });\n```\n\nWith `agentic`, the adapter routes the request through Gemini's Interactions API, and you express the sampling rate in your prompt (\"watch it at 2 fps\") instead of through `fps`. It is deeper but slower, since it re-analyzes the video on each turn.\n\n## Stateful Conversations — Interactions API (Experimental)\n\nGemini's [Interactions API](https://ai.google.dev/gemini-api/docs/interactions) (currently in Beta) offers server-side conversation state — the Gemini equivalent of OpenAI's Responses API. Instead of replaying the full message history on every turn, you pass a `previous_interaction_id` and the server retains the transcript. This also improves cache hit rates for repeated prefixes.\n\nThe `geminiTextInteractions` adapter routes through `client.interactions.create` and surfaces the server-assigned interaction id via an AG-UI `CUSTOM` event (`name: 'gemini.interactionId'`) emitted just before `RUN_FINISHED`, so you can chain turns.\n\n> **⚠️ Experimental.** Google marks the Interactions API as Beta and explicitly flags possible breaking changes until it reaches general availability. The adapter is exported from the `@tanstack/ai-gemini/experimental` subpath so the experimental status is load-bearing in your editor and bundle. Text output, function tools, and the built-in tools `google_search`, `code_execution`, `url_context`, `file_search`, and `computer_use` are supported. `google_search_retrieval`, `google_maps`, and `mcp_server` still throw on this adapter — use `geminiText()` for those or wait for follow-up work.\n\n### Basic Usage\n\n```typescript ignore\nimport { chat } from \"@tanstack/ai\";\nimport { geminiTextInteractions } from \"@tanstack/ai-gemini/experimental\";\n\n// Turn 1: introduce yourself, capture the interaction id.\nlet interactionId: string | undefined;\n\nfor await (const chunk of chat({\n  adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n  messages: [{ role: \"user\", content: \"Hi, my name is Amir.\" }],\n})) {\n  if (\n    chunk.type === \"CUSTOM\" &&\n    chunk.name === \"gemini.interactionId\" &&\n    chunk.value &&\n    typeof chunk.value === \"object\" &&\n    \"interactionId\" in chunk.value\n  ) {\n    interactionId = String(chunk.value.interactionId);\n  }\n}\n\n// Turn 2: only send the new turn's content — the server has the history.\nfor await (const chunk of chat({\n  adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n  messages: [{ role: \"user\", content: \"What is my name?\" }],\n  modelOptions: {\n    previous_interaction_id: interactionId,\n  },\n})) {\n  // ...stream \"Your name is Amir.\" back to the client.\n}\n```\n\n### Wiring with `useChat` (React)\n\nThe Interactions API is stateful and **does not accept multi-turn history without a `previous_interaction_id`** — if a chat client sends `[user, assistant, user]` to a fresh interaction the adapter throws `cannot send prior conversation history on a fresh interaction`. To make `useChat` work, persist the server-assigned id and send it back on the next turn:\n\n**Server route** (e.g. TanStack Start handler):\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequestBody,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { geminiTextInteractions } from \"@tanstack/ai-gemini/experimental\";\n\nexport async function POST({ request }: { request: Request }) {\n  const params = await chatParamsFromRequestBody(await request.json());\n\n  // The client sends body.previousInteractionId; AG-UI maps `body` into\n  // `forwardedProps` on the wire.\n  const previousInteractionId =\n    typeof params.forwardedProps.previousInteractionId === \"string\"\n      ? params.forwardedProps.previousInteractionId\n      : undefined;\n\n  const stream = chat({\n    adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n    messages: params.messages,\n    modelOptions: {\n      previous_interaction_id: previousInteractionId,\n      store: true, // required for chaining on the next turn\n    },\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n**React client**:\n\n```tsx\nimport { useEffect, useMemo, useState } from \"react\";\nimport { fetchServerSentEvents, useChat } from \"@tanstack/ai-react\";\n\nfunction GeminiChat() {\n  const [interactionId, setInteractionId] = useState<string | undefined>();\n\n  const body = useMemo(\n    () => (interactionId ? { previousInteractionId: interactionId } : {}),\n    [interactionId],\n  );\n\n  const { messages, setMessages, sendMessage } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    body,\n    onCustomEvent: (eventType, data) => {\n      if (\n        eventType === \"gemini.interactionId\" &&\n        typeof data === \"object\" &&\n        data !== null &&\n        \"interactionId\" in data\n      ) {\n        setInteractionId(String(data.interactionId));\n      }\n    },\n  });\n\n  // Switching provider/model resets the server-side chain — drop the id\n  // AND the local message history together, otherwise the next turn\n  // ships multi-turn messages with no previous_interaction_id and the\n  // adapter errors out.\n  const [provider, setProvider] = useState(\"gemini-interactions\");\n  useEffect(() => {\n    setInteractionId(undefined);\n    setMessages([]);\n  }, [provider]);\n\n  // ...render messages, call sendMessage(input)\n}\n```\n\nThe full working example is in [`examples/ts-react-chat`](https://github.com/TanStack/ai/tree/main/examples/ts-react-chat) — see `src/routes/index.tsx` for the client and `src/routes/api.tanchat.ts` for the route.\n\n### How it differs from `geminiText`\n\n| Concern | `geminiText` | `geminiTextInteractions` |\n| --- | --- | --- |\n| Underlying endpoint | `models:generateContent` | `interactions:create` |\n| Conversation state | Stateless — send full history each turn | Stateful — server retains transcript via `previous_interaction_id` |\n| Provider options shape | camelCase (`stopSequences`, `responseModalities`, `safetySettings`) | snake_case (`generation_config`, `response_modalities`, `previous_interaction_id`) |\n| Built-in tools | `google_search`, `code_execution`, `url_context`, `file_search`, `google_maps`, `google_search_retrieval`, `computer_use` | `google_search`, `code_execution`, `url_context`, `file_search`, `computer_use` (only the first four stream `CUSTOM` event activity; `computer_use` is accepted in the request but does not currently emit per-delta events) |\n| Stability | GA | Experimental (Google Beta) |\n\n### Provider Options\n\nThe adapter exposes Interactions-specific options on `modelOptions`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiTextInteractions } from \"@tanstack/ai-gemini/experimental\";\n\nconst stream = chat({\n  adapter: geminiTextInteractions(\"gemini-3.5-flash\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    // Stateful chaining — passed only on turn 2+.\n    previous_interaction_id: \"int_abc123\",\n\n    // Persist the interaction server-side (default true). Must be true for\n    // previous_interaction_id to work on the *next* turn.\n    store: true,\n\n    // Per-request system instruction (interaction-scoped — re-specify each turn).\n    system_instruction: \"You are a helpful assistant.\",\n\n    // snake_case generation config distinct from geminiText's camelCase one.\n    generation_config: {\n      thinking_level: \"low\",\n      thinking_summaries: \"auto\",\n      stop_sequences: [\"<done>\"],\n    },\n\n    response_modalities: [\"text\"],\n  },\n});\n```\n\n### Reading the interaction id\n\nThe server's interaction id arrives as an AG-UI `CUSTOM` event emitted just before `RUN_FINISHED`:\n\n```typescript ignore\nfor await (const chunk of stream) {\n  if (\n    chunk.type === \"CUSTOM\" &&\n    chunk.name === \"gemini.interactionId\" &&\n    typeof chunk.value === \"object\" &&\n    chunk.value !== null &&\n    \"interactionId\" in chunk.value\n  ) {\n    const id = String(chunk.value.interactionId);\n    // Persist `id` wherever you store per-user conversation pointers —\n    // pass it back on the next turn as `previous_interaction_id`.\n  }\n}\n```\n\n### Caveats\n\n- **Multi-turn history requires `previous_interaction_id`.** The Interactions API has no stateless replay path — sending more than one message in `messages` without a `previous_interaction_id` throws. Chat UIs that maintain local history must capture the server-assigned id and chain (see [Wiring with `useChat`](#wiring-with-usechat-react)). On provider/model switch, also clear the local message buffer.\n- **Tools, `system_instruction`, and `generation_config` are interaction-scoped.** Per Google's docs these are NOT inherited from a prior interaction via `previous_interaction_id` — pass them again on every turn you need them.\n- `store: false` is incompatible with `previous_interaction_id` (no state to recall) and with `background: true`.\n- Retention (as of the time of writing): **55 days on the Paid Tier, 1 day on the Free Tier.** See [Google's Interactions API docs](https://ai.google.dev/gemini-api/docs/interactions) for current retention policy.\n- Built-in tools in scope (`google_search`, `code_execution`, `url_context`, `file_search`, `computer_use`) are wired through as request tools. Per-delta activity for the four search/exec tools streams back as AG-UI `CUSTOM` events — `gemini.googleSearchCall` / `gemini.googleSearchResult` (and the matching `codeExecutionCall`/`Result`, `urlContextCall`/`Result`, `fileSearchCall`/`Result`) — carrying the raw Interactions delta. `computer_use` is accepted in the request but the Interactions API does not currently emit per-delta `CUSTOM` events for it. Function-tool `TOOL_CALL_*` events are unchanged, and `finishReason` stays `stop` when only built-in tools ran.\n- `google_search_retrieval`, `google_maps`, and `mcp_server` still throw a targeted error on this adapter. Use `geminiText()` for the first two, or wait for a dedicated follow-up for `mcp_server`.\n- Image and audio output via Interactions aren't routed through this adapter yet — it's text-only. Use `geminiImage` / `geminiSpeech` for non-text generation for now.\n\n## Model Options\n\nGemini supports various model-specific options. Sampling parameters live here too — `temperature`, `topP`, and `maxOutputTokens` — rather than as root-level props on `chat()`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    maxOutputTokens: 2048,\n    temperature: 0.7,\n    topP: 0.9,\n    topK: 40,\n    stopSequences: [\"END\"],\n  },\n});\n```\n\n> If you previously passed `temperature` / `topP` / `maxTokens` at the root of `chat()`, see [Moving Sampling Options into modelOptions](../migration/sampling-options-to-model-options).\n\n### Thinking\n\nEnable thinking for models that support it:\n\n```typescript ignore\nmodelOptions: {\n  thinking: {\n    includeThoughts: true,\n  },\n}\n```\n\n### Structured Output\n\nConfigure structured output format:\n\n```typescript ignore\nmodelOptions: {\n  responseMimeType: \"application/json\",\n}\n```\n\n## Summarization\n\nSummarize long text content:\n\n```typescript\nimport { summarize } from \"@tanstack/ai\";\nimport { geminiSummarize } from \"@tanstack/ai-gemini\";\n\nconst result = await summarize({\n  adapter: geminiSummarize(\"gemini-3.1-pro-preview\"),\n  text: \"Your long text to summarize...\",\n  maxLength: 100,\n  style: \"concise\", // \"concise\" | \"bullet-points\" | \"paragraph\"\n});\n\nconsole.log(result.summary);\n```\n\n## Embeddings\n\nGenerate embedding vectors with gemini-embedding-001:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { geminiEmbedding } from \"@tanstack/ai-gemini\";\n\nconst result = await embed({\n  adapter: geminiEmbedding(\"gemini-embedding-001\"),\n  input: \"a red guitar\",\n  dimensions: 1536,\n  modelOptions: {\n    taskType: \"RETRIEVAL_DOCUMENT\",\n  },\n});\n\nconsole.log(result.embeddings[0]?.vector);\n```\n\n> The Gemini API's embedding endpoint does not report token usage, so\n> `result.usage` is absent. The Vertex-only multimodal embedding model\n> (`multimodalembedding@001`) is not supported by this adapter.\n\nSee the [Embeddings guide](../embeddings.md) for the full API.\n\n## Image Generation\n\nThe Gemini adapter has two image model groups:\n\n- **Gemini native image models** (NanoBanana). A model such as `gemini-3.1-flash-image` uses the Interactions API. You set an aspect ratio. Some models also take a resolution tier (`512`, `1K`, `2K`, or `4K`). TypeScript checks the set for the model.\n- **Imagen models**. A model such as `imagen-4.0-generate-001` uses `generateImages`. You set the size as WIDTHxHEIGHT.\n\nWhen the model is in `GEMINI_NATIVE_IMAGE_MODELS`, the adapter uses the Interactions API. An Imagen model uses `generateImages`. An unknown id uses `generateImages`. Import the list or `isGeminiNativeImageModel` from `@tanstack/ai-gemini`.\n\n### Example: Gemini Native Image Generation (NanoBanana)\n\nFrom the [media generation example app](https://github.com/TanStack/ai/tree/main/examples/ts-react-media):\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"gemini-3.1-flash-image\"),\n  prompt: \"A futuristic cityscape at sunset\",\n  numberOfImages: 1,\n  size: \"16:9_4K\",\n});\n\nconsole.log(result.images);\n```\n\n### Edit a Gemini native image\n\nYou have an image from a Gemini native model. You want to change that image without a second upload of that image.\n\nPass the last `id` back. Write only the change in `prompt`:\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst adapter = geminiImage(\"gemini-3.1-flash-image\");\n\nconst first = await generateImage({\n  adapter,\n  prompt: \"A red bicycle on a quiet street\",\n});\n\nconst edited = await generateImage({\n  adapter,\n  prompt: \"Make the bicycle blue\",\n  modelOptions: { previous_interaction_id: first.id },\n});\n```\n\n1. Generate the first image.\n2. Call `generateImage` again with `previous_interaction_id` set to `first.id`.\n3. Read `edited.images` for the new picture.\n\n`edited.id` is the id for the next edit.\n\nKeep the interaction so the next edit can run:\n\n1. Leave `store` unset.\n2. If you set `store` to `false`, a later call cannot use that id.\n\nThe API default for `store` is `true`.\n\nA free tier keeps a stored interaction for 1 day. A paid tier keeps it for 55 days.\n\nIf the model is Imagen, do not pass `previous_interaction_id`. The call throws.\n\nIf this edit needs a new reference image, add that image part on this call. Do not send the image from `first`.\n\nThe Interactions API is in Beta.\n\nThe same steps are in [Image Generation](../media/image-generation#edit-a-gemini-native-image).\n\n### Example: Imagen\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"A futuristic cityscape at sunset\",\n  numberOfImages: 1,\n});\n\nconsole.log(result.images);\n```\n\n### Image Size Options\n\n#### Gemini Native Models (NanoBanana)\n\nGemini native image models use a template literal size format combining aspect ratio and resolution tier:\n\n```typescript ignore\n// Format: \"aspectRatio_resolution\"\nsize: \"16:9_4K\"\nsize: \"1:1_2K\"\nsize: \"9:16_1K\"\n```\n\nThe accepted set differs per model, and each model's `size` is narrowed to its own set at compile time:\n\n| Model | Aspect ratios | Resolutions |\n|-------|---------------|-------------|\n| `gemini-3.1-flash-image` | `1:1`, `2:3`, `3:2`, `3:4`, `4:3`, `4:5`, `5:4`, `9:16`, `16:9`, `21:9`, `1:4`, `4:1`, `1:8`, `8:1` | `512`, `1K`, `2K`, `4K` |\n| `gemini-3.1-flash-lite-image` | same 14 as above (see note) | `1K` only |\n| `gemini-nano-banana-2.1` | same 14 as above | `1K`, `2K`, `4K` |\n| `gemini-3-pro-image` | `1:1`, `2:3`, `3:2`, `3:4`, `4:3`, `4:5`, `5:4`, `9:16`, `16:9`, `21:9` | `1K`, `2K`, `4K` |\n| `gemini-2.5-flash-image` | same 10 as above | none — pass the bare ratio, e.g. `size: \"16:9\"` |\n\nThe `K` is case-sensitive (`1k` is rejected by the API), the smallest tier's token is `512` (not `512px` or `0.5K`), and `9:21` is Vertex/Cloud-only so it is not accepted here. Google documents no `image_size` for `gemini-2.5-flash-image`, so that model takes a bare aspect ratio and the adapter sends no `imageSize`.\n\n> **Note on `gemini-3.1-flash-lite-image`.** The four extreme banner ratios (`1:4`, `4:1`, `1:8`, `8:1`) are partially inferred for this model. Unlike the other three, Flash Lite has no per-model ratio table in Google's Gemini API guide; the 14-value set comes from the Cloud model page's explicit enumeration plus the guide's bare \"a discrete set of 14 aspect ratios\" assertion. The only Gemini-API enumeration for it is a 10-item bullet headed \"New aspect ratios\", which we read as a what's-new list rather than an exhaustive one. If the API rejects those four in practice, prefer the 10 standard ratios on this model.\n\n#### Imagen Models\n\nImagen models use WIDTHxHEIGHT format, which maps to aspect ratios internally:\n\n| Size | Aspect Ratio |\n|------|-------------|\n| `1024x1024` | 1:1 |\n| `1920x1080` | 16:9 |\n| `1080x1920` | 9:16 |\n\nAlternatively, you can specify the aspect ratio directly in Model Options:\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"A landscape photo\",\n  modelOptions: {\n    aspectRatio: \"16:9\",\n  },\n});\n```\n\n### Image Model Options\n\n`modelOptions` is typed per model family, because the two families hit different APIs.\n\nImagen models (`generateImages`) take `GenerateImagesConfig` fields:\n\n```typescript ignore\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"...\",\n  modelOptions: {\n    aspectRatio: \"16:9\", // \"1:1\" | \"3:4\" | \"4:3\" | \"9:16\" | \"16:9\"\n    personGeneration: \"DONT_ALLOW\", // Control person generation\n    safetyFilterLevel: \"BLOCK_SOME\", // Safety filtering\n  },\n});\n```\n\n#### Gemini native models\n\nSet native image options on `modelOptions`:\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { geminiImage, ThinkingLevel } from \"@tanstack/ai-gemini\";\n\nconst result = await generateImage({\n  adapter: geminiImage(\"gemini-3.1-flash-image\"),\n  prompt: \"A beautiful garden\",\n  size: \"16:9_4K\",\n  modelOptions: {\n    thinkingConfig: { thinkingLevel: ThinkingLevel.LOW },\n    // imageConfig replaces one field from size. The 16:9 ratio from size stays.\n    // imageConfig accepts only aspectRatio and imageSize.\n    imageConfig: { imageSize: \"2K\" },\n  },\n});\n```\n\nSet `thinkingConfig.thinkingLevel` to one of these values:\n\n- `ThinkingLevel.MINIMAL`\n- `ThinkingLevel.LOW`\n- `ThinkingLevel.MEDIUM`\n- `ThinkingLevel.HIGH`\n\n`thinkingConfig.thinkingBudget` throws.\n\nIf `systemInstruction` contains an image, a file, or a tool call, the call throws.\n\nPass the last result `id` as `previous_interaction_id`. Read [Edit a Gemini native image](#edit-a-gemini-native-image) for the edit steps.\n\nSee [Image Generation](../media/image-generation) for the full native option list.\n\n## Text-to-Speech (Experimental)\n\n> **Note:** Gemini TTS is experimental and may require the Live API for full functionality.\n\nGenerate speech from text:\n\n```typescript\nimport { generateSpeech } from \"@tanstack/ai\";\nimport { geminiSpeech } from \"@tanstack/ai-gemini\";\n\nconst result = await generateSpeech({\n  adapter: geminiSpeech(\"gemini-3.1-flash-tts-preview\"),\n  text: \"Hello from Gemini TTS!\",\n});\n\nconsole.log(result.audio); // Base64 encoded audio\n```\n\nGemini names speakers in the prompt and maps each name to a voice. Pass `turns`\nand the adapter does both for you, using the voice name as the speaker label:\n\n```typescript\nimport { generateSpeech } from \"@tanstack/ai\";\nimport { geminiSpeech } from \"@tanstack/ai-gemini\";\n\nconst result = await generateSpeech({\n  adapter: geminiSpeech(\"gemini-3.1-flash-tts-preview\"),\n  turns: [\n    { text: \"Hey, how is it going?\", voice: \"Puck\" },\n    { text: \"Not bad, you?\", voice: \"Kore\" },\n  ],\n});\n```\n\nGemini accepts **two distinct voices** per request, and a third is rejected\nbefore the call is made. Each voice must be one of the prebuilt Gemini voices.\nGemini reports no timings, so `timestamps: true` is rejected on this adapter.\n\n## Environment Variables\n\nSet your API key in environment variables:\n\n```bash\nGEMINI_API_KEY=your-api-key-here\n# or\nGOOGLE_API_KEY=your-api-key-here\n```\n\n## Getting an API Key\n\n1. Go to [Google AI Studio](https://aistudio.google.com/apikey)\n2. Create a new API key\n3. Add it to your environment variables\n\n## Popular Image Models\n\n### Gemini Native Image Models (NanoBanana)\n\nThese models use the Interactions API. Each model has its own resolution tiers.\n\n| Model | Description |\n|-------|-------------|\n| `gemini-3.1-flash-image` | Nano Banana 2 — latest and fastest Gemini native image generation (512/1K/2K/4K) |\n| `gemini-3.1-flash-lite-image` | Nano Banana 2 Lite — ultra-low-latency, low-cost image generation (1K only) |\n| `gemini-nano-banana-2.1` | Nano Banana 2.1 (1K/2K/4K, no 512 tier) |\n| `gemini-3-pro-image` | Nano Banana Pro — higher quality Gemini native image generation (1K/2K/4K) |\n| `gemini-2.5-flash-image` | Nano Banana — legacy; shuts down 2026-10-02. Takes a bare aspect ratio |\n\nThe `gemini-3.1-flash-image-preview` and `gemini-3-pro-image-preview` ids were shut down on 2026-06-25. They remain in the type union as deprecated aliases so existing code compiles, but calls to them fail — use the GA ids above.\n\n### Imagen Models\n\nThese models use the dedicated `generateImages` API.\n\n| Model | Description |\n|-------|-------------|\n| `imagen-4.0-ultra-generate-001` | Best quality Imagen image generation |\n| `imagen-4.0-generate-001` | High quality Imagen image generation |\n| `imagen-4.0-fast-generate-001` | Fast Imagen image generation |\n\n## API Reference\n\nEvery factory pair follows the same shape: the short factory (`geminiText`, `geminiImage`, …) reads `GEMINI_API_KEY` (or `GOOGLE_API_KEY`) from the environment, while the `create*` variant takes an explicit API key. Both take `model` as the first argument.\n\n### `geminiText(model, config?)` / `createGeminiChat(model, apiKey, config?)`\n\nCreates a Gemini text/chat adapter.\n\n**Parameters:**\n\n- `model` - Gemini chat model id (e.g. `\"gemini-3.1-pro-preview\"`)\n- `config?.baseURL` - Custom base URL (optional)\n\n### `geminiTextInteractions(model, config?)` / `createGeminiTextInteractions(model, apiKey, config?)` (experimental)\n\nCreates a Gemini Interactions API text adapter. Backs the stateful conversation pattern via `previous_interaction_id`. Exported from `@tanstack/ai-gemini/experimental`.\n\n**Parameters:**\n\n- `model` - Gemini chat model id (e.g. `\"gemini-3.5-flash\"`)\n- `config?.baseURL` - Custom base URL (optional)\n\n### `geminiSummarize(model, config?)` / `createGeminiSummarize(model, apiKey, config?)`\n\nCreates a Gemini summarization adapter.\n\n### `geminiImage(model, config?)` / `createGeminiImage(model, apiKey, config?)`\n\nCreates a Gemini image adapter. When the model is in `GEMINI_NATIVE_IMAGE_MODELS`, the call uses the Interactions API. `result.id` is the interaction id. An Imagen model uses `generateImages`. An unknown id uses `generateImages`.\n\n### `geminiSpeech(model, config?)` / `createGeminiSpeech(model, apiKey, config?)`\n\nCreates a Gemini text-to-speech adapter. _Experimental._\n\n### `geminiAudio(model, config?)` / `createGeminiAudio(model, apiKey, config?)`\n\nCreates a Gemini Lyria music generation adapter. _Experimental._\n\n## Next Steps\n\n- [Image Generation Guide](../media/image-generation) - Learn more about image generation\n- [Media Generation Example](https://github.com/TanStack/ai/tree/main/examples/ts-react-media) - Full working example with Gemini and fal.ai\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Other Adapters](./openai) - Explore other providers\n\n## Provider Tools\n\nGoogle Gemini exposes several native tools beyond user-defined function calls.\nImport them from `@tanstack/ai-gemini/tools` and pass them into\n`chat({ tools: [...] })`.\n\n> For the full concept, a comparison matrix, and type-gating details, see\n> [Provider Tools](../tools/provider-tools.md).\n\n### `codeExecutionTool`\n\nEnables Gemini to execute Python code in a sandboxed environment and return\nresults inline. Takes no arguments — include it in the `tools` array to\nactivate code execution.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { codeExecutionTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Calculate the first 10 Fibonacci numbers\" }],\n  tools: [codeExecutionTool()],\n});\n```\n\n**Supported models:** Gemini 1.5 Pro, Gemini 2.x, Gemini 2.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `fileSearchTool`\n\nSearches files that have been uploaded to the Gemini File API. Pass a\n`FileSearch` config object with the corpus and file IDs to scope the search.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { fileSearchTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Find the quarterly revenue figures\" }],\n  tools: [\n    fileSearchTool({\n      fileSearchStoreNames: [\"fileSearchStores/my-file-search-store-123\"],\n    }),\n  ],\n});\n```\n\n**Supported models:** Gemini 2.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `googleSearchTool`\n\nEnables Gemini to query Google Search and incorporate grounded search results\ninto its response. Pass an optional `GoogleSearch` config or call with no\narguments to use defaults.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { googleSearchTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"What's the weather in Tokyo right now?\" }],\n  tools: [googleSearchTool()],\n});\n```\n\n**Supported models:** Gemini 1.5 Pro, Gemini 2.x, Gemini 2.5. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\nWhen Google Search returns grounding data, the assistant tool-call part\nincludes `metadata.providerExecuted: true` and the normalized\n`metadata.sources` array. Gemini's raw `groundingMetadata` stays under\n`metadata.gemini`. The agent loop does not execute this call in your\napplication.\n\n### `googleSearchRetrievalTool`\n\nA retrieval-augmented variant of Google Search that returns ranked passages\nfrom the web with configurable dynamic retrieval mode. Pass an optional\n`GoogleSearchRetrieval` config.\n\n```typescript ignore\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { googleSearchRetrievalTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Explain the latest JavaScript proposals\" }],\n  tools: [\n    googleSearchRetrievalTool({\n      dynamicRetrievalConfig: { mode: \"MODE_DYNAMIC\", dynamicThreshold: 0.7 },\n    }),\n  ],\n});\n```\n\n**Supported models:** Gemini 1.5 Pro and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `googleMapsTool`\n\nConnects Gemini to the Google Maps API for location-aware queries such as\ndirections, place search, and geocoding. Pass an optional `GoogleMaps` config\nor call with no arguments.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { googleMapsTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-2.5-pro\"),\n  messages: [{ role: \"user\", content: \"Find coffee shops near Union Square, SF\" }],\n  tools: [googleMapsTool()],\n});\n```\n\n**Supported models:** Gemini 2.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `urlContextTool`\n\nFetches and includes the content of URLs mentioned in the conversation so\nGemini can reason over live web pages. Takes no arguments.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { urlContextTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Summarise https://example.com/article\" }],\n  tools: [urlContextTool()],\n});\n```\n\n**Supported models:** Gemini 2.x and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `computerUseTool`\n\nAllows Gemini to observe a virtual desktop via screenshots and interact with\nit using predefined computer-use functions. Provide the `environment` and\noptionally restrict callable functions via `excludedPredefinedFunctions`.\n\n```typescript ignore\nimport { chat } from \"@tanstack/ai\";\nimport { geminiText } from \"@tanstack/ai-gemini\";\nimport { computerUseTool } from \"@tanstack/ai-gemini/tools\";\n\nconst stream = chat({\n  adapter: geminiText(\"gemini-3.1-pro-preview\"),\n  messages: [{ role: \"user\", content: \"Navigate to example.com in the browser\" }],\n  tools: [\n    computerUseTool({\n      environment: \"browser\",\n    }),\n  ],\n});\n```\n\n**Supported models:** Gemini 2.5 and above. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n"}
