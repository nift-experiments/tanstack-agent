NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The Mistral adapter provides access to Mistral's chat models, including Mistral Large, the multimodal Pixtral family, the Magistral reasoning models, and the Codestral code-specialized model."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-mistral\"]],\"vue\":[[\"@tanstack/ai-mistral\"]],\"solid\":[[\"@tanstack/ai-mistral\"]],\"svelte\":[[\"@tanstack/ai-mistral\"]],\"preact\":[[\"@tanstack/ai-mistral\"]],\"angular\":[[\"@tanstack/ai-mistral\"]],\"vanilla\":[[\"@tanstack/ai-mistral\"]],\"octane\":[[\"@tanstack/ai-mistral\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"basic-usage-custom-api-key","children":[{"type":"text","value":"Basic Usage - Custom API Key"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { createMistralText } from \"@tanstack/ai-mistral\";\n\nconst adapter = createMistralText(\n  \"mistral-large-latest\",\n  process.env.MISTRAL_API_KEY!,\n);\n\nconst stream = chat({\n  adapter,\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"configuration","children":[{"type":"text","value":"Configuration"}]},{"type":"code","value":"import {\n  createMistralText,\n  type MistralTextConfig,\n} from \"@tanstack/ai-mistral\";\n\nconst config: Omit<MistralTextConfig, \"apiKey\"> = {\n  baseURL: \"https://api.mistral.ai\", // Optional, this is the default\n  defaultHeaders: {\n    \"X-Custom-Header\": \"value\",\n  },\n};\n\nconst adapter = createMistralText(\n  \"mistral-large-latest\",\n  process.env.MISTRAL_API_KEY!,\n  config,\n);","lang":"typescript"},{"type":"heading","depth":2,"id":"behind-a-proxy","children":[{"type":"text","value":"Behind a proxy"}]},{"type":"paragraph","children":[{"type":"text","value":"Route every request through a gateway, such as Cloudflare AI Gateway or a corporate proxy, with "},{"type":"inlineCode","value":"baseURL"},{"type":"text","value":" and "},{"type":"inlineCode","value":"defaultHeaders"},{"type":"text","value":". These two option names are the same on every TanStack AI adapter, so one gateway config works for all of them."}]},{"type":"code","value":"import { createMistralText } from \"@tanstack/ai-mistral\";\n\nconst adapter = createMistralText(\"mistral-large-latest\", process.env.MISTRAL_API_KEY!, {\n  baseURL: \"https://gateway.example.com/mistral\",\n  defaultHeaders: { \"cf-aig-authorization\": `Bearer ${process.env.GATEWAY_TOKEN}` },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"serverURL"},{"type":"text","value":" is an alias of "},{"type":"inlineCode","value":"baseURL"},{"type":"text","value":". If you set both, "},{"type":"inlineCode","value":"baseURL"},{"type":"text","value":" wins."}]},{"type":"heading","depth":2,"id":"mistral-on-vertex","children":[{"type":"text","value":"Mistral on Vertex"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"@tanstack/ai-mistral/vertex"},{"type":"text","value":" when Mistral must run on Vertex AI. That\npath uses Google Cloud credentials and the publisher "},{"type":"inlineCode","value":"rawPredict"},{"type":"text","value":" endpoint."}]},{"type":"paragraph","children":[{"type":"text","value":"Mistral on Vertex is regional only. Use "},{"type":"inlineCode","value":"us-central1"},{"type":"text","value":" or "},{"type":"inlineCode","value":"europe-west4"},{"type":"text","value":"."}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-mistral\",\"google-auth-library\"]],\"vue\":[[\"@tanstack/ai-mistral\",\"google-auth-library\"]],\"solid\":[[\"@tanstack/ai-mistral\",\"google-auth-library\"]],\"svelte\":[[\"@tanstack/ai-mistral\",\"google-auth-library\"]],\"preact\":[[\"@tanstack/ai-mistral\",\"google-auth-library\"]],\"angular\":[[\"@tanstack/ai-mistral\",\"google-auth-library\"]],\"vanilla\":[[\"@tanstack/ai-mistral\",\"google-auth-library\"]],\"octane\":[[\"@tanstack/ai-mistral\",\"google-auth-library\"]]},\"mode\":\"install\"}"}},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { mistralVertexText } from \"@tanstack/ai-mistral/vertex\";\n\nconst stream = chat({\n  adapter: mistralVertexText(\"mistral-medium-3\", {\n    project: \"my-project\",\n    location: \"europe-west4\",\n  }),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"project"},{"type":"text","value":" and "},{"type":"inlineCode","value":"location"},{"type":"text","value":" use the same names as "},{"type":"inlineCode","value":"@tanstack/ai-vertex"},{"type":"text","value":".\n"},{"type":"inlineCode","value":"location"},{"type":"text","value":" is required."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"mistralVertexText"},{"type":"text","value":" accepts only the Mistral chat models that Vertex lists:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mistral-medium-3"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mistral-small-2503"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"codestral-2"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Mistral API aliases such as "},{"type":"inlineCode","value":"mistral-large-latest"},{"type":"text","value":" and "},{"type":"inlineCode","value":"mistral-medium-latest"},{"type":"text","value":"\nare not Vertex model ids. Vertex also lists "},{"type":"inlineCode","value":"mistral-ocr-2505"},{"type":"text","value":", but that\nmodel is OCR, not chat."}]},{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"google-auth-library"},{"type":"text","value":" for Application Default Credentials, or pass\n"},{"type":"inlineCode","value":"authClient"},{"type":"text","value":" or "},{"type":"inlineCode","value":"getAccessToken"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Gemini on Vertex lives in "},{"type":"link","href":"./vertex","children":[{"type":"inlineCode","value":"@tanstack/ai-vertex"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"example-chat-completion","children":[{"type":"text","value":"Example: Chat Completion"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: mistralText(\"mistral-large-latest\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"example-with-tools","children":[{"type":"text","value":"Example: With Tools"}]},{"type":"code","value":"import { chat, toolDefinition } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\nimport { z } from \"zod\";\n\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather for a location\",\n  inputSchema: z.object({\n    location: z.string(),\n  }),\n});\n\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\" };\n});\n\nconst stream = chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [{ role: \"user\", content: \"What's the weather in Paris?\" }],\n  tools: [getWeather],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"example-multimodal-vision","children":[{"type":"text","value":"Example: Multimodal (Vision)"}]},{"type":"paragraph","children":[{"type":"text","value":"Use a vision-capable model — "},{"type":"inlineCode","value":"pixtral-large-latest"},{"type":"text","value":", "},{"type":"inlineCode","value":"pixtral-12b-2409"},{"type":"text","value":", "},{"type":"inlineCode","value":"mistral-medium-latest"},{"type":"text","value":", or "},{"type":"inlineCode","value":"mistral-small-latest"},{"type":"text","value":" — to send images alongside text:"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"pixtral-large-latest\"),\n  messages: [\n    {\n      role: \"user\",\n      content: [\n        { type: \"text\", content: \"What's in this image?\" },\n        {\n          type: \"image\",\n          source: {\n            type: \"url\",\n            value: \"https://example.com/photo.jpg\",\n          },\n        },\n      ],\n    },\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"For data-URL or base64 images, set "},{"type":"inlineCode","value":"source.type"},{"type":"text","value":" to "},{"type":"inlineCode","value":"\"data\""},{"type":"text","value":" and provide "},{"type":"inlineCode","value":"mimeType"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst base64String = \"...\"; // your base64-encoded image bytes\n\nconst stream = chat({\n  adapter: mistralText(\"pixtral-large-latest\"),\n  messages: [\n    {\n      role: \"user\",\n      content: [\n        { type: \"text\", content: \"What's in this image?\" },\n        {\n          type: \"image\",\n          source: {\n            type: \"data\",\n            mimeType: \"image/png\",\n            value: base64String,\n          },\n        },\n      ],\n    },\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../advanced/multimodal-content","children":[{"type":"text","value":"Multimodal Content"}]},{"type":"text","value":" for the full content-part shape."}]},{"type":"heading","depth":2,"id":"example-reasoning-magistral","children":[{"type":"text","value":"Example: Reasoning (Magistral)"}]},{"type":"paragraph","children":[{"type":"text","value":"Magistral models ("},{"type":"inlineCode","value":"magistral-medium-latest"},{"type":"text","value":", "},{"type":"inlineCode","value":"magistral-small-latest"},{"type":"text","value":") stream their reasoning as separate events before the final answer. The adapter emits AG-UI "},{"type":"inlineCode","value":"REASONING_*"},{"type":"text","value":" chunks for the thinking content and "},{"type":"inlineCode","value":"TEXT_MESSAGE_*"},{"type":"text","value":" chunks for the answer:"}]},{"type":"code","value":"// ignore: narrowing the raw AG-UI stream by `chunk.type` relies on @ag-ui/core's\n// discriminated-union `type` field, which kiira can't resolve in a source-only\n// check. The runtime behaviour is exactly as shown.\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"magistral-medium-latest\"),\n  messages: [{ role: \"user\", content: \"Why is the sky blue?\" }],\n});\n\nfor await (const chunk of stream) {\n  if (chunk.type === \"REASONING_MESSAGE_CONTENT\") {\n    process.stdout.write(`[thinking] ${chunk.delta}`);\n  } else if (chunk.type === \"TEXT_MESSAGE_CONTENT\") {\n    process.stdout.write(chunk.delta);\n  }\n}","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"text","value":"Reasoning events are always closed before any text or tool output begins, so consumers see a complete "},{"type":"inlineCode","value":"REASONING_START → REASONING_MESSAGE_START → REASONING_MESSAGE_CONTENT* → REASONING_MESSAGE_END → REASONING_END"},{"type":"text","value":" sequence first."}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../chat/thinking-content","children":[{"type":"text","value":"Thinking & Reasoning"}]},{"type":"text","value":" for the cross-provider event spec."}]},{"type":"heading","depth":2,"id":"example-structured-output","children":[{"type":"text","value":"Example: Structured Output"}]},{"type":"paragraph","children":[{"type":"text","value":"Generate JSON that conforms to a Zod schema using Mistral's "},{"type":"inlineCode","value":"json_schema"},{"type":"text","value":" response format:"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\nimport { z } from \"zod\";\n\nconst recipeSchema = z.object({\n  name: z.string(),\n  ingredients: z.array(z.string()),\n  steps: z.array(z.string()),\n});\n\nconst recipe = await chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [\n    { role: \"user\", content: \"Give me a chocolate chip cookie recipe.\" },\n  ],\n  outputSchema: recipeSchema,\n});\n\nconsole.log(recipe.name); // typed as z.infer<typeof recipeSchema>","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../chat/structured-outputs","children":[{"type":"text","value":"Structured Outputs"}]},{"type":"text","value":" for the full guide."}]},{"type":"heading","depth":2,"id":"model-options","children":[{"type":"text","value":"Model Options"}]},{"type":"paragraph","children":[{"type":"text","value":"Mistral exposes provider-specific options via "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    temperature: 0.7,\n    top_p: 0.9,\n    max_tokens: 1024,\n    random_seed: 42,\n    stop: [\"END\"],\n    safe_prompt: true,\n    frequency_penalty: 0.5,\n    presence_penalty: 0.5,\n    parallel_tool_calls: true,\n    tool_choice: \"auto\",\n  },\n});","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"All sampling parameters — including "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":", "},{"type":"inlineCode","value":"top_p"},{"type":"text","value":", and "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":" —\ngo inside "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" using Mistral's native (snake_case) names."}]}]},{"type":"heading","depth":2,"id":"embeddings","children":[{"type":"text","value":"Embeddings"}]},{"type":"paragraph","children":[{"type":"text","value":"Generate embedding vectors with mistral-embed or codestral-embed:"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { mistralEmbedding } from \"@tanstack/ai-mistral\";\n\nconst result = await embed({\n  adapter: mistralEmbedding(\"mistral-embed\"),\n  input: [\"a red guitar\", \"a blue drum kit\"],\n});\n\nconsole.log(result.embeddings[0]?.vector); // 1024 dimensions","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"mistral-embed"},{"type":"text","value":" has fixed 1024-dimension output; "},{"type":"inlineCode","value":"codestral-embed"},{"type":"text","value":" (tuned for code) supports the top-level "},{"type":"inlineCode","value":"dimensions"},{"type":"text","value":" option:"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { mistralEmbedding } from \"@tanstack/ai-mistral\";\n\nconst result = await embed({\n  adapter: mistralEmbedding(\"codestral-embed\"),\n  input: \"function add(a, b) { return a + b }\",\n  dimensions: 512,\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../embeddings.md","children":[{"type":"text","value":"Embeddings guide"}]},{"type":"text","value":" for the full API."}]},{"type":"heading","depth":2,"id":"environment-variables","children":[{"type":"text","value":"Environment Variables"}]},{"type":"paragraph","children":[{"type":"text","value":"Set your API key in environment variables:"}]},{"type":"code","value":"MISTRAL_API_KEY=...","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"Get a key from the "},{"type":"link","href":"https://console.mistral.ai/","children":[{"type":"text","value":"Mistral Console"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"supported-models","children":[{"type":"text","value":"Supported Models"}]},{"type":"heading","depth":3,"id":"chat","children":[{"type":"text","value":"Chat"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mistral-large-latest"},{"type":"text","value":" — Flagship general-purpose model (128k context)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mistral-medium-latest"},{"type":"text","value":" — Multimodal mid-tier model with vision"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mistral-small-latest"},{"type":"text","value":" — Fast, affordable multimodal model with vision"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ministral-8b-latest"},{"type":"text","value":" — 8B edge model"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ministral-3b-latest"},{"type":"text","value":" — 3B edge model"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"open-mistral-nemo"},{"type":"text","value":" — Open 12B model"}]}]}]},{"type":"heading","depth":3,"id":"code","children":[{"type":"text","value":"Code"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"codestral-latest"},{"type":"text","value":" — Code-specialized model (256k context)"}]}]}]},{"type":"heading","depth":3,"id":"vision","children":[{"type":"text","value":"Vision"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"pixtral-large-latest"},{"type":"text","value":" — Large vision model"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"pixtral-12b-2409"},{"type":"text","value":" — 12B vision model"}]}]}]},{"type":"heading","depth":3,"id":"reasoning","children":[{"type":"text","value":"Reasoning"}]},{"type":"paragraph","children":[{"type":"text","value":"Reasoning content is streamed as "},{"type":"inlineCode","value":"REASONING_*"},{"type":"text","value":" events before the final answer."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"magistral-medium-latest"},{"type":"text","value":" — Mid-tier reasoning model"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"magistral-small-latest"},{"type":"text","value":" — Small reasoning model"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"https://docs.mistral.ai/getting-started/models/compare","children":[{"type":"text","value":"Mistral's model comparison"}]},{"type":"text","value":" for full details."}]},{"type":"heading","depth":2,"id":"api-reference","children":[{"type":"text","value":"API Reference"}]},{"type":"heading","depth":3,"id":"mistraltext-model-config","children":[{"type":"inlineCode","value":"mistralText(model, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Mistral text adapter using the "},{"type":"inlineCode","value":"MISTRAL_API_KEY"},{"type":"text","value":" environment variable."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Parameters:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"model"},{"type":"text","value":" — The model name (e.g., "},{"type":"inlineCode","value":"'mistral-large-latest'"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"config.baseURL?"},{"type":"text","value":": custom base URL (optional). "},{"type":"inlineCode","value":"serverURL"},{"type":"text","value":" is an alias."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"config.defaultHeaders?"},{"type":"text","value":" — Headers to attach to every request (optional)"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns:"}]},{"type":"text","value":" A Mistral text adapter instance."}]},{"type":"heading","depth":3,"id":"createmistraltext-model-apikey-config","children":[{"type":"inlineCode","value":"createMistralText(model, apiKey, config?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Mistral text adapter with an explicit API key."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Parameters:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"model"},{"type":"text","value":" — The model name"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"apiKey"},{"type":"text","value":" — Your Mistral API key"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"config.baseURL?"},{"type":"text","value":": custom base URL (optional). "},{"type":"inlineCode","value":"serverURL"},{"type":"text","value":" is an alias."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"config.defaultHeaders?"},{"type":"text","value":" — Headers to attach to every request (optional)"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns:"}]},{"type":"text","value":" A Mistral text adapter instance."}]},{"type":"heading","depth":2,"id":"limitations","children":[{"type":"text","value":"Limitations"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Embeddings"}]},{"type":"text","value":": Use the "},{"type":"link","href":"https://github.com/mistralai/client-ts","children":[{"type":"text","value":"Mistral SDK"}]},{"type":"text","value":" directly for "},{"type":"inlineCode","value":"mistral-embed"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Image / Audio / Video Generation"}]},{"type":"text","value":": Mistral does not provide these endpoints. Use OpenAI, Gemini, or fal.ai."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Text-to-Speech / Transcription"}]},{"type":"text","value":": Not supported. Use OpenAI or ElevenLabs."}]}]}]},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Getting Started"}]},{"type":"text","value":" — Learn the basics"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools Guide"}]},{"type":"text","value":" — Define and call tools"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../chat/structured-outputs","children":[{"type":"text","value":"Structured Outputs"}]},{"type":"text","value":" — Generate typed JSON"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../advanced/multimodal-content","children":[{"type":"text","value":"Multimodal Content"}]},{"type":"text","value":" — Send images and other modalities"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./openai","children":[{"type":"text","value":"Other Adapters"}]},{"type":"text","value":" — Explore other providers"}]}]}]},{"type":"heading","depth":2,"id":"provider-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"paragraph","children":[{"type":"text","value":"Mistral does not currently expose provider-specific tool factories.\nDefine your own tools with "},{"type":"inlineCode","value":"toolDefinition()"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../tools/tools.md","children":[{"type":"text","value":"Tools"}]},{"type":"text","value":" for the general tool-definition flow, or\n"},{"type":"link","href":"../tools/provider-tools.md","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":" for other providers'\nnative-tool offerings."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"basic-usage-custom-api-key","text":"Basic Usage - Custom API Key","level":2},{"id":"configuration","text":"Configuration","level":2},{"id":"behind-a-proxy","text":"Behind a proxy","level":2},{"id":"mistral-on-vertex","text":"Mistral on Vertex","level":2},{"id":"example-chat-completion","text":"Example: Chat Completion","level":2},{"id":"example-with-tools","text":"Example: With Tools","level":2},{"id":"example-multimodal-vision","text":"Example: Multimodal (Vision)","level":2},{"id":"example-reasoning-magistral","text":"Example: Reasoning (Magistral)","level":2},{"id":"example-structured-output","text":"Example: Structured Output","level":2},{"id":"model-options","text":"Model Options","level":2},{"id":"embeddings","text":"Embeddings","level":2},{"id":"environment-variables","text":"Environment Variables","level":2},{"id":"supported-models","text":"Supported Models","level":2},{"id":"chat","text":"Chat","level":3},{"id":"code","text":"Code","level":3},{"id":"vision","text":"Vision","level":3},{"id":"reasoning","text":"Reasoning","level":3},{"id":"api-reference","text":"API Reference","level":2},{"id":"mistraltext-model-config","text":"mistralText(model, config?)","level":3},{"id":"createmistraltext-model-apikey-config","text":"createMistralText(model, apiKey, config?)","level":3},{"id":"limitations","text":"Limitations","level":2},{"id":"next-steps","text":"Next Steps","level":2},{"id":"provider-tools","text":"Provider Tools","level":2}]},"frameworks":["react","vue","solid","svelte","preact","angular","vanilla","octane"],"downloadMarkdown":"\nThe Mistral adapter provides access to Mistral's chat models, including Mistral Large, the multimodal Pixtral family, the Magistral reasoning models, and the Codestral code-specialized model.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-mistral\nvue: @tanstack/ai-mistral\nsolid: @tanstack/ai-mistral\nsvelte: @tanstack/ai-mistral\npreact: @tanstack/ai-mistral\nangular: @tanstack/ai-mistral\nvanilla: @tanstack/ai-mistral\noctane: @tanstack/ai-mistral\n\n<!-- ::end:tabs -->\n\n## Basic Usage\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Basic Usage - Custom API Key\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { createMistralText } from \"@tanstack/ai-mistral\";\n\nconst adapter = createMistralText(\n  \"mistral-large-latest\",\n  process.env.MISTRAL_API_KEY!,\n);\n\nconst stream = chat({\n  adapter,\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Configuration\n\n```typescript\nimport {\n  createMistralText,\n  type MistralTextConfig,\n} from \"@tanstack/ai-mistral\";\n\nconst config: Omit<MistralTextConfig, \"apiKey\"> = {\n  baseURL: \"https://api.mistral.ai\", // Optional, this is the default\n  defaultHeaders: {\n    \"X-Custom-Header\": \"value\",\n  },\n};\n\nconst adapter = createMistralText(\n  \"mistral-large-latest\",\n  process.env.MISTRAL_API_KEY!,\n  config,\n);\n```\n\n## Behind a proxy\n\nRoute every request through a gateway, such as Cloudflare AI Gateway or a corporate proxy, with `baseURL` and `defaultHeaders`. These two option names are the same on every TanStack AI adapter, so one gateway config works for all of them.\n\n```typescript\nimport { createMistralText } from \"@tanstack/ai-mistral\";\n\nconst adapter = createMistralText(\"mistral-large-latest\", process.env.MISTRAL_API_KEY!, {\n  baseURL: \"https://gateway.example.com/mistral\",\n  defaultHeaders: { \"cf-aig-authorization\": `Bearer ${process.env.GATEWAY_TOKEN}` },\n});\n```\n\n`serverURL` is an alias of `baseURL`. If you set both, `baseURL` wins.\n\n## Mistral on Vertex\n\nUse `@tanstack/ai-mistral/vertex` when Mistral must run on Vertex AI. That\npath uses Google Cloud credentials and the publisher `rawPredict` endpoint.\n\nMistral on Vertex is regional only. Use `us-central1` or `europe-west4`.\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-mistral google-auth-library\nvue: @tanstack/ai-mistral google-auth-library\nsolid: @tanstack/ai-mistral google-auth-library\nsvelte: @tanstack/ai-mistral google-auth-library\npreact: @tanstack/ai-mistral google-auth-library\nangular: @tanstack/ai-mistral google-auth-library\nvanilla: @tanstack/ai-mistral google-auth-library\noctane: @tanstack/ai-mistral google-auth-library\n\n<!-- ::end:tabs -->\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralVertexText } from \"@tanstack/ai-mistral/vertex\";\n\nconst stream = chat({\n  adapter: mistralVertexText(\"mistral-medium-3\", {\n    project: \"my-project\",\n    location: \"europe-west4\",\n  }),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n`project` and `location` use the same names as `@tanstack/ai-vertex`.\n`location` is required.\n\n`mistralVertexText` accepts only the Mistral chat models that Vertex lists:\n\n- `mistral-medium-3`\n- `mistral-small-2503`\n- `codestral-2`\n\nMistral API aliases such as `mistral-large-latest` and `mistral-medium-latest`\nare not Vertex model ids. Vertex also lists `mistral-ocr-2505`, but that\nmodel is OCR, not chat.\n\nInstall `google-auth-library` for Application Default Credentials, or pass\n`authClient` or `getAccessToken`.\n\nGemini on Vertex lives in [`@tanstack/ai-vertex`](./vertex).\n\n## Example: Chat Completion\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: mistralText(\"mistral-large-latest\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Example: With Tools\n\n```typescript\nimport { chat, toolDefinition } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\nimport { z } from \"zod\";\n\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather for a location\",\n  inputSchema: z.object({\n    location: z.string(),\n  }),\n});\n\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\" };\n});\n\nconst stream = chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [{ role: \"user\", content: \"What's the weather in Paris?\" }],\n  tools: [getWeather],\n});\n```\n\n## Example: Multimodal (Vision)\n\nUse a vision-capable model — `pixtral-large-latest`, `pixtral-12b-2409`, `mistral-medium-latest`, or `mistral-small-latest` — to send images alongside text:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"pixtral-large-latest\"),\n  messages: [\n    {\n      role: \"user\",\n      content: [\n        { type: \"text\", content: \"What's in this image?\" },\n        {\n          type: \"image\",\n          source: {\n            type: \"url\",\n            value: \"https://example.com/photo.jpg\",\n          },\n        },\n      ],\n    },\n  ],\n});\n```\n\nFor data-URL or base64 images, set `source.type` to `\"data\"` and provide `mimeType`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst base64String = \"...\"; // your base64-encoded image bytes\n\nconst stream = chat({\n  adapter: mistralText(\"pixtral-large-latest\"),\n  messages: [\n    {\n      role: \"user\",\n      content: [\n        { type: \"text\", content: \"What's in this image?\" },\n        {\n          type: \"image\",\n          source: {\n            type: \"data\",\n            mimeType: \"image/png\",\n            value: base64String,\n          },\n        },\n      ],\n    },\n  ],\n});\n```\n\nSee [Multimodal Content](../advanced/multimodal-content) for the full content-part shape.\n\n## Example: Reasoning (Magistral)\n\nMagistral models (`magistral-medium-latest`, `magistral-small-latest`) stream their reasoning as separate events before the final answer. The adapter emits AG-UI `REASONING_*` chunks for the thinking content and `TEXT_MESSAGE_*` chunks for the answer:\n\n```typescript ignore\n// ignore: narrowing the raw AG-UI stream by `chunk.type` relies on @ag-ui/core's\n// discriminated-union `type` field, which kiira can't resolve in a source-only\n// check. The runtime behaviour is exactly as shown.\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"magistral-medium-latest\"),\n  messages: [{ role: \"user\", content: \"Why is the sky blue?\" }],\n});\n\nfor await (const chunk of stream) {\n  if (chunk.type === \"REASONING_MESSAGE_CONTENT\") {\n    process.stdout.write(`[thinking] ${chunk.delta}`);\n  } else if (chunk.type === \"TEXT_MESSAGE_CONTENT\") {\n    process.stdout.write(chunk.delta);\n  }\n}\n```\n\nReasoning events are always closed before any text or tool output begins, so consumers see a complete `REASONING_START → REASONING_MESSAGE_START → REASONING_MESSAGE_CONTENT* → REASONING_MESSAGE_END → REASONING_END` sequence first.\n\nSee [Thinking & Reasoning](../chat/thinking-content) for the cross-provider event spec.\n\n## Example: Structured Output\n\nGenerate JSON that conforms to a Zod schema using Mistral's `json_schema` response format:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\nimport { z } from \"zod\";\n\nconst recipeSchema = z.object({\n  name: z.string(),\n  ingredients: z.array(z.string()),\n  steps: z.array(z.string()),\n});\n\nconst recipe = await chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [\n    { role: \"user\", content: \"Give me a chocolate chip cookie recipe.\" },\n  ],\n  outputSchema: recipeSchema,\n});\n\nconsole.log(recipe.name); // typed as z.infer<typeof recipeSchema>\n```\n\nSee [Structured Outputs](../chat/structured-outputs) for the full guide.\n\n## Model Options\n\nMistral exposes provider-specific options via `modelOptions`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    temperature: 0.7,\n    top_p: 0.9,\n    max_tokens: 1024,\n    random_seed: 42,\n    stop: [\"END\"],\n    safe_prompt: true,\n    frequency_penalty: 0.5,\n    presence_penalty: 0.5,\n    parallel_tool_calls: true,\n    tool_choice: \"auto\",\n  },\n});\n```\n\n> All sampling parameters — including `temperature`, `top_p`, and `max_tokens` —\n> go inside `modelOptions` using Mistral's native (snake_case) names.\n\n## Embeddings\n\nGenerate embedding vectors with mistral-embed or codestral-embed:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { mistralEmbedding } from \"@tanstack/ai-mistral\";\n\nconst result = await embed({\n  adapter: mistralEmbedding(\"mistral-embed\"),\n  input: [\"a red guitar\", \"a blue drum kit\"],\n});\n\nconsole.log(result.embeddings[0]?.vector); // 1024 dimensions\n```\n\n`mistral-embed` has fixed 1024-dimension output; `codestral-embed` (tuned for code) supports the top-level `dimensions` option:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { mistralEmbedding } from \"@tanstack/ai-mistral\";\n\nconst result = await embed({\n  adapter: mistralEmbedding(\"codestral-embed\"),\n  input: \"function add(a, b) { return a + b }\",\n  dimensions: 512,\n});\n```\n\nSee the [Embeddings guide](../embeddings.md) for the full API.\n\n## Environment Variables\n\nSet your API key in environment variables:\n\n```bash\nMISTRAL_API_KEY=...\n```\n\nGet a key from the [Mistral Console](https://console.mistral.ai/).\n\n## Supported Models\n\n### Chat\n\n- `mistral-large-latest` — Flagship general-purpose model (128k context)\n- `mistral-medium-latest` — Multimodal mid-tier model with vision\n- `mistral-small-latest` — Fast, affordable multimodal model with vision\n- `ministral-8b-latest` — 8B edge model\n- `ministral-3b-latest` — 3B edge model\n- `open-mistral-nemo` — Open 12B model\n\n### Code\n\n- `codestral-latest` — Code-specialized model (256k context)\n\n### Vision\n\n- `pixtral-large-latest` — Large vision model\n- `pixtral-12b-2409` — 12B vision model\n\n### Reasoning\n\nReasoning content is streamed as `REASONING_*` events before the final answer.\n\n- `magistral-medium-latest` — Mid-tier reasoning model\n- `magistral-small-latest` — Small reasoning model\n\nSee [Mistral's model comparison](https://docs.mistral.ai/getting-started/models/compare) for full details.\n\n## API Reference\n\n### `mistralText(model, config?)`\n\nCreates a Mistral text adapter using the `MISTRAL_API_KEY` environment variable.\n\n**Parameters:**\n\n- `model` — The model name (e.g., `'mistral-large-latest'`)\n- `config.baseURL?`: custom base URL (optional). `serverURL` is an alias.\n- `config.defaultHeaders?` — Headers to attach to every request (optional)\n\n**Returns:** A Mistral text adapter instance.\n\n### `createMistralText(model, apiKey, config?)`\n\nCreates a Mistral text adapter with an explicit API key.\n\n**Parameters:**\n\n- `model` — The model name\n- `apiKey` — Your Mistral API key\n- `config.baseURL?`: custom base URL (optional). `serverURL` is an alias.\n- `config.defaultHeaders?` — Headers to attach to every request (optional)\n\n**Returns:** A Mistral text adapter instance.\n\n## Limitations\n\n- **Embeddings**: Use the [Mistral SDK](https://github.com/mistralai/client-ts) directly for `mistral-embed`.\n- **Image / Audio / Video Generation**: Mistral does not provide these endpoints. Use OpenAI, Gemini, or fal.ai.\n- **Text-to-Speech / Transcription**: Not supported. Use OpenAI or ElevenLabs.\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) — Learn the basics\n- [Tools Guide](../tools/tools) — Define and call tools\n- [Structured Outputs](../chat/structured-outputs) — Generate typed JSON\n- [Multimodal Content](../advanced/multimodal-content) — Send images and other modalities\n- [Other Adapters](./openai) — Explore other providers\n\n## Provider Tools\n\nMistral does not currently expose provider-specific tool factories.\nDefine your own tools with `toolDefinition()` from `@tanstack/ai`.\n\nSee [Tools](../tools/tools.md) for the general tool-definition flow, or\n[Provider Tools](../tools/provider-tools.md) for other providers'\nnative-tool offerings.\n","originalRawMarkdown":"---\ntitle: Mistral\nid: mistral-adapter\norder: 7\ndescription: \"Use Mistral models with TanStack AI — Mistral Large, Mistral Medium, Pixtral vision models, Magistral reasoning models, and Codestral via @tanstack/ai-mistral.\"\nkeywords:\n  - tanstack ai\n  - mistral\n  - mistral large\n  - pixtral\n  - magistral\n  - codestral\n  - adapter\n  - llm\n---\n\nThe Mistral adapter provides access to Mistral's chat models, including Mistral Large, the multimodal Pixtral family, the Magistral reasoning models, and the Codestral code-specialized model.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-mistral\nvue: @tanstack/ai-mistral\nsolid: @tanstack/ai-mistral\nsvelte: @tanstack/ai-mistral\npreact: @tanstack/ai-mistral\nangular: @tanstack/ai-mistral\nvanilla: @tanstack/ai-mistral\noctane: @tanstack/ai-mistral\n\n<!-- ::end:tabs -->\n\n## Basic Usage\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Basic Usage - Custom API Key\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { createMistralText } from \"@tanstack/ai-mistral\";\n\nconst adapter = createMistralText(\n  \"mistral-large-latest\",\n  process.env.MISTRAL_API_KEY!,\n);\n\nconst stream = chat({\n  adapter,\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Configuration\n\n```typescript\nimport {\n  createMistralText,\n  type MistralTextConfig,\n} from \"@tanstack/ai-mistral\";\n\nconst config: Omit<MistralTextConfig, \"apiKey\"> = {\n  baseURL: \"https://api.mistral.ai\", // Optional, this is the default\n  defaultHeaders: {\n    \"X-Custom-Header\": \"value\",\n  },\n};\n\nconst adapter = createMistralText(\n  \"mistral-large-latest\",\n  process.env.MISTRAL_API_KEY!,\n  config,\n);\n```\n\n## Behind a proxy\n\nRoute every request through a gateway, such as Cloudflare AI Gateway or a corporate proxy, with `baseURL` and `defaultHeaders`. These two option names are the same on every TanStack AI adapter, so one gateway config works for all of them.\n\n```typescript\nimport { createMistralText } from \"@tanstack/ai-mistral\";\n\nconst adapter = createMistralText(\"mistral-large-latest\", process.env.MISTRAL_API_KEY!, {\n  baseURL: \"https://gateway.example.com/mistral\",\n  defaultHeaders: { \"cf-aig-authorization\": `Bearer ${process.env.GATEWAY_TOKEN}` },\n});\n```\n\n`serverURL` is an alias of `baseURL`. If you set both, `baseURL` wins.\n\n## Mistral on Vertex\n\nUse `@tanstack/ai-mistral/vertex` when Mistral must run on Vertex AI. That\npath uses Google Cloud credentials and the publisher `rawPredict` endpoint.\n\nMistral on Vertex is regional only. Use `us-central1` or `europe-west4`.\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-mistral google-auth-library\nvue: @tanstack/ai-mistral google-auth-library\nsolid: @tanstack/ai-mistral google-auth-library\nsvelte: @tanstack/ai-mistral google-auth-library\npreact: @tanstack/ai-mistral google-auth-library\nangular: @tanstack/ai-mistral google-auth-library\nvanilla: @tanstack/ai-mistral google-auth-library\noctane: @tanstack/ai-mistral google-auth-library\n\n<!-- ::end:tabs -->\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralVertexText } from \"@tanstack/ai-mistral/vertex\";\n\nconst stream = chat({\n  adapter: mistralVertexText(\"mistral-medium-3\", {\n    project: \"my-project\",\n    location: \"europe-west4\",\n  }),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n`project` and `location` use the same names as `@tanstack/ai-vertex`.\n`location` is required.\n\n`mistralVertexText` accepts only the Mistral chat models that Vertex lists:\n\n- `mistral-medium-3`\n- `mistral-small-2503`\n- `codestral-2`\n\nMistral API aliases such as `mistral-large-latest` and `mistral-medium-latest`\nare not Vertex model ids. Vertex also lists `mistral-ocr-2505`, but that\nmodel is OCR, not chat.\n\nInstall `google-auth-library` for Application Default Credentials, or pass\n`authClient` or `getAccessToken`.\n\nGemini on Vertex lives in [`@tanstack/ai-vertex`](./vertex).\n\n## Example: Chat Completion\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: mistralText(\"mistral-large-latest\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Example: With Tools\n\n```typescript\nimport { chat, toolDefinition } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\nimport { z } from \"zod\";\n\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather for a location\",\n  inputSchema: z.object({\n    location: z.string(),\n  }),\n});\n\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\" };\n});\n\nconst stream = chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [{ role: \"user\", content: \"What's the weather in Paris?\" }],\n  tools: [getWeather],\n});\n```\n\n## Example: Multimodal (Vision)\n\nUse a vision-capable model — `pixtral-large-latest`, `pixtral-12b-2409`, `mistral-medium-latest`, or `mistral-small-latest` — to send images alongside text:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"pixtral-large-latest\"),\n  messages: [\n    {\n      role: \"user\",\n      content: [\n        { type: \"text\", content: \"What's in this image?\" },\n        {\n          type: \"image\",\n          source: {\n            type: \"url\",\n            value: \"https://example.com/photo.jpg\",\n          },\n        },\n      ],\n    },\n  ],\n});\n```\n\nFor data-URL or base64 images, set `source.type` to `\"data\"` and provide `mimeType`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst base64String = \"...\"; // your base64-encoded image bytes\n\nconst stream = chat({\n  adapter: mistralText(\"pixtral-large-latest\"),\n  messages: [\n    {\n      role: \"user\",\n      content: [\n        { type: \"text\", content: \"What's in this image?\" },\n        {\n          type: \"image\",\n          source: {\n            type: \"data\",\n            mimeType: \"image/png\",\n            value: base64String,\n          },\n        },\n      ],\n    },\n  ],\n});\n```\n\nSee [Multimodal Content](../advanced/multimodal-content) for the full content-part shape.\n\n## Example: Reasoning (Magistral)\n\nMagistral models (`magistral-medium-latest`, `magistral-small-latest`) stream their reasoning as separate events before the final answer. The adapter emits AG-UI `REASONING_*` chunks for the thinking content and `TEXT_MESSAGE_*` chunks for the answer:\n\n```typescript ignore\n// ignore: narrowing the raw AG-UI stream by `chunk.type` relies on @ag-ui/core's\n// discriminated-union `type` field, which kiira can't resolve in a source-only\n// check. The runtime behaviour is exactly as shown.\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"magistral-medium-latest\"),\n  messages: [{ role: \"user\", content: \"Why is the sky blue?\" }],\n});\n\nfor await (const chunk of stream) {\n  if (chunk.type === \"REASONING_MESSAGE_CONTENT\") {\n    process.stdout.write(`[thinking] ${chunk.delta}`);\n  } else if (chunk.type === \"TEXT_MESSAGE_CONTENT\") {\n    process.stdout.write(chunk.delta);\n  }\n}\n```\n\nReasoning events are always closed before any text or tool output begins, so consumers see a complete `REASONING_START → REASONING_MESSAGE_START → REASONING_MESSAGE_CONTENT* → REASONING_MESSAGE_END → REASONING_END` sequence first.\n\nSee [Thinking & Reasoning](../chat/thinking-content) for the cross-provider event spec.\n\n## Example: Structured Output\n\nGenerate JSON that conforms to a Zod schema using Mistral's `json_schema` response format:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\nimport { z } from \"zod\";\n\nconst recipeSchema = z.object({\n  name: z.string(),\n  ingredients: z.array(z.string()),\n  steps: z.array(z.string()),\n});\n\nconst recipe = await chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [\n    { role: \"user\", content: \"Give me a chocolate chip cookie recipe.\" },\n  ],\n  outputSchema: recipeSchema,\n});\n\nconsole.log(recipe.name); // typed as z.infer<typeof recipeSchema>\n```\n\nSee [Structured Outputs](../chat/structured-outputs) for the full guide.\n\n## Model Options\n\nMistral exposes provider-specific options via `modelOptions`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { mistralText } from \"@tanstack/ai-mistral\";\n\nconst stream = chat({\n  adapter: mistralText(\"mistral-large-latest\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    temperature: 0.7,\n    top_p: 0.9,\n    max_tokens: 1024,\n    random_seed: 42,\n    stop: [\"END\"],\n    safe_prompt: true,\n    frequency_penalty: 0.5,\n    presence_penalty: 0.5,\n    parallel_tool_calls: true,\n    tool_choice: \"auto\",\n  },\n});\n```\n\n> All sampling parameters — including `temperature`, `top_p`, and `max_tokens` —\n> go inside `modelOptions` using Mistral's native (snake_case) names.\n\n## Embeddings\n\nGenerate embedding vectors with mistral-embed or codestral-embed:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { mistralEmbedding } from \"@tanstack/ai-mistral\";\n\nconst result = await embed({\n  adapter: mistralEmbedding(\"mistral-embed\"),\n  input: [\"a red guitar\", \"a blue drum kit\"],\n});\n\nconsole.log(result.embeddings[0]?.vector); // 1024 dimensions\n```\n\n`mistral-embed` has fixed 1024-dimension output; `codestral-embed` (tuned for code) supports the top-level `dimensions` option:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { mistralEmbedding } from \"@tanstack/ai-mistral\";\n\nconst result = await embed({\n  adapter: mistralEmbedding(\"codestral-embed\"),\n  input: \"function add(a, b) { return a + b }\",\n  dimensions: 512,\n});\n```\n\nSee the [Embeddings guide](../embeddings.md) for the full API.\n\n## Environment Variables\n\nSet your API key in environment variables:\n\n```bash\nMISTRAL_API_KEY=...\n```\n\nGet a key from the [Mistral Console](https://console.mistral.ai/).\n\n## Supported Models\n\n### Chat\n\n- `mistral-large-latest` — Flagship general-purpose model (128k context)\n- `mistral-medium-latest` — Multimodal mid-tier model with vision\n- `mistral-small-latest` — Fast, affordable multimodal model with vision\n- `ministral-8b-latest` — 8B edge model\n- `ministral-3b-latest` — 3B edge model\n- `open-mistral-nemo` — Open 12B model\n\n### Code\n\n- `codestral-latest` — Code-specialized model (256k context)\n\n### Vision\n\n- `pixtral-large-latest` — Large vision model\n- `pixtral-12b-2409` — 12B vision model\n\n### Reasoning\n\nReasoning content is streamed as `REASONING_*` events before the final answer.\n\n- `magistral-medium-latest` — Mid-tier reasoning model\n- `magistral-small-latest` — Small reasoning model\n\nSee [Mistral's model comparison](https://docs.mistral.ai/getting-started/models/compare) for full details.\n\n## API Reference\n\n### `mistralText(model, config?)`\n\nCreates a Mistral text adapter using the `MISTRAL_API_KEY` environment variable.\n\n**Parameters:**\n\n- `model` — The model name (e.g., `'mistral-large-latest'`)\n- `config.baseURL?`: custom base URL (optional). `serverURL` is an alias.\n- `config.defaultHeaders?` — Headers to attach to every request (optional)\n\n**Returns:** A Mistral text adapter instance.\n\n### `createMistralText(model, apiKey, config?)`\n\nCreates a Mistral text adapter with an explicit API key.\n\n**Parameters:**\n\n- `model` — The model name\n- `apiKey` — Your Mistral API key\n- `config.baseURL?`: custom base URL (optional). `serverURL` is an alias.\n- `config.defaultHeaders?` — Headers to attach to every request (optional)\n\n**Returns:** A Mistral text adapter instance.\n\n## Limitations\n\n- **Embeddings**: Use the [Mistral SDK](https://github.com/mistralai/client-ts) directly for `mistral-embed`.\n- **Image / Audio / Video Generation**: Mistral does not provide these endpoints. Use OpenAI, Gemini, or fal.ai.\n- **Text-to-Speech / Transcription**: Not supported. Use OpenAI or ElevenLabs.\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) — Learn the basics\n- [Tools Guide](../tools/tools) — Define and call tools\n- [Structured Outputs](../chat/structured-outputs) — Generate typed JSON\n- [Multimodal Content](../advanced/multimodal-content) — Send images and other modalities\n- [Other Adapters](./openai) — Explore other providers\n\n## Provider Tools\n\nMistral does not currently expose provider-specific tool factories.\nDefine your own tools with `toolDefinition()` from `@tanstack/ai`.\n\nSee [Tools](../tools/tools.md) for the general tool-definition flow, or\n[Provider Tools](../tools/provider-tools.md) for other providers'\nnative-tool offerings.\n"}
