  - cerebras
  - qwen
  - perplexity
  - lm studio
  - vllm
  - litellm
  - adapter
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Many providers expose the OpenAI "},{"type":"strong","children":[{"type":"text","value":"Chat Completions"}]},{"type":"text","value":" API ("},{"type":"inlineCode","value":"/chat/completions"},{"type":"text","value":") — DeepSeek, Moonshot/Kimi, Together, Fireworks, Cerebras, Alibaba Qwen, Perplexity, NVIDIA NIM, and local servers like LM Studio, Ollama, and vLLM. Instead of a dedicated package per provider, TanStack AI ships one generic adapter: point it at any compatible "},{"type":"inlineCode","value":"baseURL"},{"type":"text","value":", give it your models, and you get the same type-safe "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" experience as the first-class adapters."}]},{"type":"paragraph","children":[{"type":"text","value":"Use this when your provider speaks the OpenAI Chat Completions wire format but doesn't have its own "},{"type":"inlineCode","value":"@tanstack/ai-*"},{"type":"text","value":" package. If a dedicated adapter exists (OpenAI, Grok, Groq, OpenRouter), prefer it. Those carry curated per-model metadata. For Vercel AI Gateway, install "},{"type":"inlineCode","value":"@tanstack/ai-vercel-gateway"},{"type":"text","value":" and use "},{"type":"inlineCode","value":"vercelGatewayText"},{"type":"text","value":". See "},{"type":"link","href":"./vercel-gateway.md","children":[{"type":"text","value":"Vercel AI Gateway"}]},{"type":"text","value":". For Lovable AI Gateway, install "},{"type":"inlineCode","value":"@tanstack/ai-lovable"},{"type":"text","value":" and use "},{"type":"inlineCode","value":"lovableText"},{"type":"text","value":" (plus image, video, embeddings, and speech factories). See "},{"type":"link","href":"./lovable.md","children":[{"type":"text","value":"Lovable AI Gateway"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Perplexity Sonar chat stays on this adapter. "},{"type":"link","href":"./perplexity.md","children":[{"type":"inlineCode","value":"@tanstack/ai-perplexity"}]},{"type":"text","value":" is Search/grounding only — it does not replace "},{"type":"inlineCode","value":"openaiCompatible"},{"type":"text","value":" for "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":". Optional: pass "},{"type":"inlineCode","value":"defaultHeaders: getPerplexityIntegrationHeaders()"},{"type":"text","value":" from that package to send Perplexity's "},{"type":"inlineCode","value":"X-Pplx-Integration"},{"type":"text","value":" attribution header."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"paragraph","children":[{"type":"text","value":"The adapter ships inside "},{"type":"inlineCode","value":"@tanstack/ai-openai"},{"type":"text","value":" under the "},{"type":"inlineCode","value":"/compatible"},{"type":"text","value":" subpath — no extra install:"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-openai\"]],\"vue\":[[\"@tanstack/ai-openai\"]],\"solid\":[[\"@tanstack/ai-openai\"]],\"svelte\":[[\"@tanstack/ai-openai\"]],\"preact\":[[\"@tanstack/ai-openai\"]],\"angular\":[[\"@tanstack/ai-openai\"]],\"vanilla\":[[\"@tanstack/ai-openai\"]],\"octane\":[[\"@tanstack/ai-openai\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"paragraph","children":[{"type":"text","value":"Configure the provider once with "},{"type":"inlineCode","value":"openaiCompatible({ baseURL, apiKey, models })"},{"type":"text","value":", then select a model per call. The returned model name is a type-safe union of the models you declared:"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst deepseek = openaiCompatible({\n  name: \"deepseek\", // optional label shown in devtools/errors (default: \"openai-compatible\")\n  baseURL: \"https://api.deepseek.com/v1\",\n  apiKey: process.env.DEEPSEEK_API_KEY!,\n  models: [\"deepseek-chat\", \"deepseek-reasoner\"],\n});\n\nconst stream = chat({\n  adapter: deepseek(\"deepseek-chat\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"deepseek(\"deepseek-reasoner\")"},{"type":"text","value":" is valid; "},{"type":"inlineCode","value":"deepseek(\"gpt-4o\")"},{"type":"text","value":" is a type error — only declared models are accepted."}]},{"type":"heading","depth":2,"id":"one-shot-usage","children":[{"type":"text","value":"One-Shot Usage"}]},{"type":"paragraph","children":[{"type":"text","value":"For a single model, skip the provider-factory and build the adapter inline with "},{"type":"inlineCode","value":"openaiCompatibleText"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openaiCompatibleText } from \"@tanstack/ai-openai/compatible\";\n\nconst stream = chat({\n  adapter: openaiCompatibleText(\"deepseek-chat\", {\n    baseURL: \"https://api.deepseek.com/v1\",\n    apiKey: process.env.DEEPSEEK_API_KEY!,\n  }),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"declaring-models","children":[{"type":"text","value":"Declaring Models"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"models"},{"type":"text","value":" array accepts two forms, which you can mix:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"A bare string"}]},{"type":"text","value":" — gets optimistic defaults: "},{"type":"inlineCode","value":"text"},{"type":"text","value":" + "},{"type":"inlineCode","value":"image"},{"type":"text","value":" input, with "},{"type":"inlineCode","value":"streaming"},{"type":"text","value":", "},{"type":"inlineCode","value":"function_calling"},{"type":"text","value":", and "},{"type":"inlineCode","value":"structured_outputs"},{"type":"text","value":" support. Good for mainstream chat models."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"createModel(name, capabilities)"},{"type":"text","value":" definition"}]},{"type":"text","value":" — declares precise per-model capabilities so the types match reality (e.g. a reasoning model with no image input)."}]}]}]},{"type":"code","value":"import { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\nimport { createModel } from \"@tanstack/ai\";\n\nconst provider = openaiCompatible({\n  baseURL: \"https://api.deepseek.com/v1\",\n  apiKey: process.env.DEEPSEEK_API_KEY!,\n  models: [\n    \"deepseek-chat\", // string → optimistic defaults\n    createModel(\"deepseek-reasoner\", {\n      input: [\"text\"], // text only\n      features: [\"reasoning\", \"structured_outputs\"],\n    }),\n  ],\n});","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Capabilities are enforced at the type level. If a provider rejects a feature at runtime (e.g. tools on a model that doesn't support them), declare that model with "},{"type":"inlineCode","value":"createModel"},{"type":"text","value":" and omit the unsupported feature so the types stop you from calling it."}]}]},{"type":"heading","depth":2,"id":"configuration","children":[{"type":"text","value":"Configuration"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"openaiCompatible"},{"type":"text","value":" accepts every OpenAI SDK "},{"type":"inlineCode","value":"ClientOptions"},{"type":"text","value":" field besides "},{"type":"inlineCode","value":"apiKey"},{"type":"text","value":"/"},{"type":"inlineCode","value":"baseURL"},{"type":"text","value":" (which are required and promoted to the top level). The most useful are "},{"type":"inlineCode","value":"defaultHeaders"},{"type":"text","value":" and "},{"type":"inlineCode","value":"defaultQuery"},{"type":"text","value":", for providers that need extra auth or routing parameters:"}]},{"type":"code","value":"import { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst provider = openaiCompatible({\n  baseURL: \"https://api.example.com/v1\",\n  apiKey: process.env.EXAMPLE_API_KEY!,\n  models: [\"some-model\"],\n  defaultHeaders: { \"X-Custom-Header\": \"value\" },\n  defaultQuery: { \"api-version\": \"2026-01-01\" },\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"chat-completions-vs-responses","children":[{"type":"text","value":"Chat Completions vs Responses"}]},{"type":"paragraph","children":[{"type":"text","value":"By default the adapter targets the "},{"type":"strong","children":[{"type":"text","value":"Chat Completions"}]},{"type":"text","value":" API ("},{"type":"inlineCode","value":"/chat/completions"},{"type":"text","value":"). For providers that implement the "},{"type":"strong","children":[{"type":"text","value":"Responses"}]},{"type":"text","value":" API, select "},{"type":"inlineCode","value":"api: \"responses\""},{"type":"text","value":". This API choice also controls how "},{"type":"inlineCode","value":"ChatStreamSummarizeAdapter"},{"type":"text","value":" forwards "},{"type":"inlineCode","value":"maxLength"},{"type":"text","value":", regardless of the wrapper name:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Chat Completions uses "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Responses uses "},{"type":"inlineCode","value":"max_output_tokens"},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"An explicit token limit in "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" takes precedence over "},{"type":"inlineCode","value":"maxLength"},{"type":"text","value":"."}]},{"type":"code","value":"import { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst provider = openaiCompatible({\n  baseURL: \"https://my-resource.openai.azure.com/openai/v1\",\n  apiKey: process.env.AZURE_OPENAI_API_KEY!,\n  models: [\"gpt-4o\"],\n  api: \"responses\", // default is \"chat-completions\"\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Reasoning:"}]},{"type":"text","value":" Reasoning deltas stream as thinking content. Endpoints frozen on the pre-July-2025 OpenAI spec may still emit the legacy event name "},{"type":"inlineCode","value":"response.reasoning.delta"},{"type":"text","value":" (removed from the spec in favor of "},{"type":"inlineCode","value":"response.reasoning_text.delta"},{"type":"text","value":"); the adapter recognizes both and maps them identically."}]},{"type":"heading","depth":2,"id":"supported-providers","children":[{"type":"text","value":"Supported Providers"}]},{"type":"paragraph","children":[{"type":"text","value":"Any provider implementing the OpenAI Chat Completions API works. Common ones are below — "},{"type":"strong","children":[{"type":"text","value":"verify the "},{"type":"inlineCode","value":"baseURL"},{"type":"text","value":" and model ids against each provider's current docs"}]},{"type":"text","value":", since they change over time. Set the API key via the provider's own environment variable and pass it as "},{"type":"inlineCode","value":"apiKey"},{"type":"text","value":"."}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Provider"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"baseURL"}]},{"type":"tableCell","children":[{"type":"text","value":"Example model"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"DeepSeek"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.deepseek.com/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"deepseek-chat"},{"type":"text","value":", "},{"type":"inlineCode","value":"deepseek-reasoner"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Moonshot / Kimi"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.moonshot.ai/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"kimi-k2-0711-preview"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Alibaba Qwen (DashScope, intl)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://dashscope-intl.aliyuncs.com/compatible-mode/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"qwen-max"},{"type":"text","value":", "},{"type":"inlineCode","value":"qwen-plus"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Alibaba Qwen (DashScope, China)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://dashscope.aliyuncs.com/compatible-mode/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"qwen-max"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Together AI"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.together.xyz/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"meta-llama/Llama-3.3-70B-Instruct-Turbo"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Fireworks AI"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.fireworks.ai/inference/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"accounts/fireworks/models/llama-v3p3-70b-instruct"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Cerebras"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.cerebras.ai/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"llama-3.3-70b"}]}],[{"type":"tableCell","children":[{"type":"text","value":"DeepInfra"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.deepinfra.com/v1/openai"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"meta-llama/Llama-3.3-70B-Instruct"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Perplexity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.perplexity.ai"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"sonar"},{"type":"text","value":", "},{"type":"inlineCode","value":"sonar-pro"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Mistral"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.mistral.ai/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"mistral-large-latest"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Nebius"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.studio.nebius.ai/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"meta-llama/Llama-3.3-70B-Instruct"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Z.AI (GLM)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://api.z.ai/api/paas/v4"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"glm-4.6"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Baseten"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://inference.baseten.co/v1"}]},{"type":"tableCell","children":[{"type":"text","value":"model-dependent"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Hugging Face (router)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://router.huggingface.co/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"meta-llama/Llama-3.3-70B-Instruct"}]}],[{"type":"tableCell","children":[{"type":"text","value":"NVIDIA NIM"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"https://integrate.api.nvidia.com/v1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"meta/llama-3.3-70b-instruct"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"On Chat Completions, "},{"type":"inlineCode","value":"RUN_FINISHED.usage"},{"type":"text","value":" carries the prompt cache counts that the provider reports. Cache reads arrive on "},{"type":"inlineCode","value":"promptTokensDetails.cachedTokens"},{"type":"text","value":", and cache writes arrive on "},{"type":"inlineCode","value":"promptTokensDetails.cacheWriteTokens"},{"type":"text","value":". Moonshot / Kimi reports both."}]},{"type":"heading","depth":2,"id":"local-self-hosted-servers","children":[{"type":"text","value":"Local & Self-Hosted Servers"}]},{"type":"paragraph","children":[{"type":"text","value":"Point the adapter at any local OpenAI-compatible server. The API key is usually a placeholder:"}]},{"type":"code","value":"import { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\n// LM Studio\nconst lmstudio = openaiCompatible({\n  name: \"lmstudio\",\n  baseURL: \"http://localhost:1234/v1\",\n  apiKey: \"lm-studio\",\n  models: [\"local-model\"],\n});\n\n// vLLM\nconst vllm = openaiCompatible({\n  name: \"vllm\",\n  baseURL: \"http://localhost:8000/v1\",\n  apiKey: \"not-needed\",\n  models: [\"meta-llama/Llama-3.3-70B-Instruct\"],\n});\n\n// Ollama's OpenAI-compatible endpoint\nconst ollama = openaiCompatible({\n  name: \"ollama\",\n  baseURL: \"http://localhost:11434/v1\",\n  apiKey: \"ollama\",\n  models: [\"llama3.3\"],\n});","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Ollama also has a dedicated adapter, "},{"type":"link","href":"./ollama","children":[{"type":"inlineCode","value":"@tanstack/ai-ollama"}]},{"type":"text","value":", which understands its native API. Use "},{"type":"inlineCode","value":"openaiCompatible"},{"type":"text","value":" only if you specifically want Ollama's OpenAI-compatible surface."}]}]},{"type":"heading","depth":2,"id":"litellm-proxy","children":[{"type":"text","value":"LiteLLM Proxy"}]},{"type":"paragraph","children":[{"type":"link","href":"https://github.com/BerriAI/litellm","children":[{"type":"text","value":"LiteLLM"}]},{"type":"text","value":" is a self-hosted gateway that exposes a single OpenAI Chat Completions endpoint in front of 100+ providers (OpenAI, Anthropic, Google, Azure, AWS Bedrock, Mistral, Groq, and more). Because the proxy speaks the OpenAI wire format, it needs no dedicated package — point "},{"type":"inlineCode","value":"openaiCompatible"},{"type":"text","value":" at your proxy's "},{"type":"inlineCode","value":"baseURL"},{"type":"text","value":" (default "},{"type":"inlineCode","value":"http://localhost:4000/v1"},{"type":"text","value":") and route to a provider with LiteLLM's "},{"type":"inlineCode","value":"provider/model"},{"type":"text","value":" naming:"}]},{"type":"code","value":"import { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst litellm = openaiCompatible({\n  name: \"litellm\",\n  baseURL: \"http://localhost:4000/v1\", // your LiteLLM proxy\n  apiKey: process.env.LITELLM_API_KEY!, // a virtual key issued by the proxy\n  models: [\n    \"anthropic/claude-sonnet-5\",\n    \"openai/gpt-5.5\",\n    \"gemini/gemini-3.5-flash\",\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"litellm(\"anthropic/claude-sonnet-5\")"},{"type":"text","value":" selects the Anthropic route; "},{"type":"inlineCode","value":"litellm(\"openai/gpt-5.5\")"},{"type":"text","value":" selects OpenAI — all through the one proxy. Declare only the model routes you configured on the proxy; for precise per-model capabilities (e.g. a reasoning route without image input), use "},{"type":"inlineCode","value":"createModel"},{"type":"text","value":" as shown under "},{"type":"link","href":"#declaring-models","children":[{"type":"text","value":"Declaring Models"}]},{"type":"text","value":"."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"The proxy holds each upstream provider's real credentials; the "},{"type":"inlineCode","value":"apiKey"},{"type":"text","value":" here is the proxy's own virtual/master key, not the upstream provider's."}]}]},{"type":"heading","depth":2,"id":"azure-openai","children":[{"type":"text","value":"Azure OpenAI"}]},{"type":"paragraph","children":[{"type":"text","value":"Azure uses a resource-scoped URL and a separate API-version. Use the "},{"type":"inlineCode","value":"/openai/v1"},{"type":"text","value":" endpoint with "},{"type":"inlineCode","value":"defaultQuery"},{"type":"text","value":" for the version and "},{"type":"inlineCode","value":"defaultHeaders"},{"type":"text","value":" for the "},{"type":"inlineCode","value":"api-key"},{"type":"text","value":" header:"}]},{"type":"code","value":"import { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst azure = openaiCompatible({\n  name: \"azure\",\n  baseURL: \"https://YOUR_RESOURCE.openai.azure.com/openai/v1\",\n  apiKey: process.env.AZURE_OPENAI_API_KEY!, // also sent as Bearer; Azure accepts the api-key header below\n  models: [\"gpt-4o\"], // your Azure deployment name\n  defaultQuery: { \"api-version\": \"2026-01-01-preview\" },\n  defaultHeaders: { \"api-key\": process.env.AZURE_OPENAI_API_KEY! },\n});","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Confirm the current "},{"type":"inlineCode","value":"api-version"},{"type":"text","value":" and endpoint shape in Azure's documentation — Azure's API surface evolves independently of OpenAI's."}]}]},{"type":"heading","depth":2,"id":"example-with-tools","children":[{"type":"text","value":"Example: With Tools"}]},{"type":"paragraph","children":[{"type":"text","value":"Tools work exactly as they do with any other adapter, for models that support function calling:"}]},{"type":"code","value":"import { chat, toolDefinition } from \"@tanstack/ai\";\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\nimport { z } from \"zod\";\n\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({ location: z.string() }),\n});\n\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\" };\n});\n\nconst deepseek = openaiCompatible({\n  baseURL: \"https://api.deepseek.com/v1\",\n  apiKey: process.env.DEEPSEEK_API_KEY!,\n  models: [\"deepseek-chat\"],\n});\n\nconst stream = chat({\n  adapter: deepseek(\"deepseek-chat\"),\n  messages: [{ role: \"user\", content: \"What's the weather in Tokyo?\" }],\n  tools: [getWeather],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./openai","children":[{"type":"text","value":"OpenAI Adapter"}]},{"type":"text","value":" - The first-class OpenAI adapter"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./openrouter","children":[{"type":"text","value":"OpenRouter Adapter"}]},{"type":"text","value":" - Access 300+ models through one gateway"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools Guide"}]},{"type":"text","value":" - Learn about tools"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../advanced/extend-adapter","children":[{"type":"text","value":"Extending Adapters"}]},{"type":"text","value":" - Add custom models to any adapter"}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"one-shot-usage","text":"One-Shot Usage","level":2},{"id":"declaring-models","text":"Declaring Models","level":2},{"id":"configuration","text":"Configuration","level":2},{"id":"chat-completions-vs-responses","text":"Chat Completions vs Responses","level":2},{"id":"supported-providers","text":"Supported Providers","level":2},{"id":"local-self-hosted-servers","text":"Local & Self-Hosted Servers","level":2},{"id":"litellm-proxy","text":"LiteLLM Proxy","level":2},{"id":"azure-openai","text":"Azure OpenAI","level":2},{"id":"example-with-tools","text":"Example: With Tools","level":2},{"id":"next-steps","text":"Next Steps","level":2}]},"frameworks":["react","vue","solid","svelte","preact","angular","vanilla","octane"],"downloadMarkdown":"\nMany providers expose the OpenAI **Chat Completions** API (`/chat/completions`) — DeepSeek, Moonshot/Kimi, Together, Fireworks, Cerebras, Alibaba Qwen, Perplexity, NVIDIA NIM, and local servers like LM Studio, Ollama, and vLLM. Instead of a dedicated package per provider, TanStack AI ships one generic adapter: point it at any compatible `baseURL`, give it your models, and you get the same type-safe `chat()` experience as the first-class adapters.\n\nUse this when your provider speaks the OpenAI Chat Completions wire format but doesn't have its own `@tanstack/ai-*` package. If a dedicated adapter exists (OpenAI, Grok, Groq, OpenRouter), prefer it. Those carry curated per-model metadata. For Vercel AI Gateway, install `@tanstack/ai-vercel-gateway` and use `vercelGatewayText`. See [Vercel AI Gateway](./vercel-gateway.md). For Lovable AI Gateway, install `@tanstack/ai-lovable` and use `lovableText` (plus image, video, embeddings, and speech factories). See [Lovable AI Gateway](./lovable.md).\n\nPerplexity Sonar chat stays on this adapter. [`@tanstack/ai-perplexity`](./perplexity.md) is Search/grounding only — it does not replace `openaiCompatible` for `chat()`. Optional: pass `defaultHeaders: getPerplexityIntegrationHeaders()` from that package to send Perplexity's `X-Pplx-Integration` attribution header.\n\n## Installation\n\nThe adapter ships inside `@tanstack/ai-openai` under the `/compatible` subpath — no extra install:\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-openai\nvue: @tanstack/ai-openai\nsolid: @tanstack/ai-openai\nsvelte: @tanstack/ai-openai\npreact: @tanstack/ai-openai\nangular: @tanstack/ai-openai\nvanilla: @tanstack/ai-openai\noctane: @tanstack/ai-openai\n\n<!-- ::end:tabs -->\n\n## Basic Usage\n\nConfigure the provider once with `openaiCompatible({ baseURL, apiKey, models })`, then select a model per call. The returned model name is a type-safe union of the models you declared:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst deepseek = openaiCompatible({\n  name: \"deepseek\", // optional label shown in devtools/errors (default: \"openai-compatible\")\n  baseURL: \"https://api.deepseek.com/v1\",\n  apiKey: process.env.DEEPSEEK_API_KEY!,\n  models: [\"deepseek-chat\", \"deepseek-reasoner\"],\n});\n\nconst stream = chat({\n  adapter: deepseek(\"deepseek-chat\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n`deepseek(\"deepseek-reasoner\")` is valid; `deepseek(\"gpt-4o\")` is a type error — only declared models are accepted.\n\n## One-Shot Usage\n\nFor a single model, skip the provider-factory and build the adapter inline with `openaiCompatibleText`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openaiCompatibleText } from \"@tanstack/ai-openai/compatible\";\n\nconst stream = chat({\n  adapter: openaiCompatibleText(\"deepseek-chat\", {\n    baseURL: \"https://api.deepseek.com/v1\",\n    apiKey: process.env.DEEPSEEK_API_KEY!,\n  }),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Declaring Models\n\nThe `models` array accepts two forms, which you can mix:\n\n- **A bare string** — gets optimistic defaults: `text` + `image` input, with `streaming`, `function_calling`, and `structured_outputs` support. Good for mainstream chat models.\n- **A `createModel(name, capabilities)` definition** — declares precise per-model capabilities so the types match reality (e.g. a reasoning model with no image input).\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\nimport { createModel } from \"@tanstack/ai\";\n\nconst provider = openaiCompatible({\n  baseURL: \"https://api.deepseek.com/v1\",\n  apiKey: process.env.DEEPSEEK_API_KEY!,\n  models: [\n    \"deepseek-chat\", // string → optimistic defaults\n    createModel(\"deepseek-reasoner\", {\n      input: [\"text\"], // text only\n      features: [\"reasoning\", \"structured_outputs\"],\n    }),\n  ],\n});\n```\n\n> Capabilities are enforced at the type level. If a provider rejects a feature at runtime (e.g. tools on a model that doesn't support them), declare that model with `createModel` and omit the unsupported feature so the types stop you from calling it.\n\n## Configuration\n\n`openaiCompatible` accepts every OpenAI SDK `ClientOptions` field besides `apiKey`/`baseURL` (which are required and promoted to the top level). The most useful are `defaultHeaders` and `defaultQuery`, for providers that need extra auth or routing parameters:\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst provider = openaiCompatible({\n  baseURL: \"https://api.example.com/v1\",\n  apiKey: process.env.EXAMPLE_API_KEY!,\n  models: [\"some-model\"],\n  defaultHeaders: { \"X-Custom-Header\": \"value\" },\n  defaultQuery: { \"api-version\": \"2026-01-01\" },\n});\n```\n\n## Chat Completions vs Responses\n\nBy default the adapter targets the **Chat Completions** API (`/chat/completions`). For providers that implement the **Responses** API, select `api: \"responses\"`. This API choice also controls how `ChatStreamSummarizeAdapter` forwards `maxLength`, regardless of the wrapper name:\n\n- Chat Completions uses `max_tokens`.\n- Responses uses `max_output_tokens`.\n\nAn explicit token limit in `modelOptions` takes precedence over `maxLength`.\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst provider = openaiCompatible({\n  baseURL: \"https://my-resource.openai.azure.com/openai/v1\",\n  apiKey: process.env.AZURE_OPENAI_API_KEY!,\n  models: [\"gpt-4o\"],\n  api: \"responses\", // default is \"chat-completions\"\n});\n```\n\n**Reasoning:** Reasoning deltas stream as thinking content. Endpoints frozen on the pre-July-2025 OpenAI spec may still emit the legacy event name `response.reasoning.delta` (removed from the spec in favor of `response.reasoning_text.delta`); the adapter recognizes both and maps them identically.\n\n## Supported Providers\n\nAny provider implementing the OpenAI Chat Completions API works. Common ones are below — **verify the `baseURL` and model ids against each provider's current docs**, since they change over time. Set the API key via the provider's own environment variable and pass it as `apiKey`.\n\n| Provider | `baseURL` | Example model |\n| --- | --- | --- |\n| DeepSeek | `https://api.deepseek.com/v1` | `deepseek-chat`, `deepseek-reasoner` |\n| Moonshot / Kimi | `https://api.moonshot.ai/v1` | `kimi-k2-0711-preview` |\n| Alibaba Qwen (DashScope, intl) | `https://dashscope-intl.aliyuncs.com/compatible-mode/v1` | `qwen-max`, `qwen-plus` |\n| Alibaba Qwen (DashScope, China) | `https://dashscope.aliyuncs.com/compatible-mode/v1` | `qwen-max` |\n| Together AI | `https://api.together.xyz/v1` | `meta-llama/Llama-3.3-70B-Instruct-Turbo` |\n| Fireworks AI | `https://api.fireworks.ai/inference/v1` | `accounts/fireworks/models/llama-v3p3-70b-instruct` |\n| Cerebras | `https://api.cerebras.ai/v1` | `llama-3.3-70b` |\n| DeepInfra | `https://api.deepinfra.com/v1/openai` | `meta-llama/Llama-3.3-70B-Instruct` |\n| Perplexity | `https://api.perplexity.ai` | `sonar`, `sonar-pro` |\n| Mistral | `https://api.mistral.ai/v1` | `mistral-large-latest` |\n| Nebius | `https://api.studio.nebius.ai/v1` | `meta-llama/Llama-3.3-70B-Instruct` |\n| Z.AI (GLM) | `https://api.z.ai/api/paas/v4` | `glm-4.6` |\n| Baseten | `https://inference.baseten.co/v1` | model-dependent |\n| Hugging Face (router) | `https://router.huggingface.co/v1` | `meta-llama/Llama-3.3-70B-Instruct` |\n| NVIDIA NIM | `https://integrate.api.nvidia.com/v1` | `meta/llama-3.3-70b-instruct` |\n\nOn Chat Completions, `RUN_FINISHED.usage` carries the prompt cache counts that the provider reports. Cache reads arrive on `promptTokensDetails.cachedTokens`, and cache writes arrive on `promptTokensDetails.cacheWriteTokens`. Moonshot / Kimi reports both.\n\n## Local & Self-Hosted Servers\n\nPoint the adapter at any local OpenAI-compatible server. The API key is usually a placeholder:\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\n// LM Studio\nconst lmstudio = openaiCompatible({\n  name: \"lmstudio\",\n  baseURL: \"http://localhost:1234/v1\",\n  apiKey: \"lm-studio\",\n  models: [\"local-model\"],\n});\n\n// vLLM\nconst vllm = openaiCompatible({\n  name: \"vllm\",\n  baseURL: \"http://localhost:8000/v1\",\n  apiKey: \"not-needed\",\n  models: [\"meta-llama/Llama-3.3-70B-Instruct\"],\n});\n\n// Ollama's OpenAI-compatible endpoint\nconst ollama = openaiCompatible({\n  name: \"ollama\",\n  baseURL: \"http://localhost:11434/v1\",\n  apiKey: \"ollama\",\n  models: [\"llama3.3\"],\n});\n```\n\n> Ollama also has a dedicated adapter, [`@tanstack/ai-ollama`](./ollama), which understands its native API. Use `openaiCompatible` only if you specifically want Ollama's OpenAI-compatible surface.\n\n## LiteLLM Proxy\n\n[LiteLLM](https://github.com/BerriAI/litellm) is a self-hosted gateway that exposes a single OpenAI Chat Completions endpoint in front of 100+ providers (OpenAI, Anthropic, Google, Azure, AWS Bedrock, Mistral, Groq, and more). Because the proxy speaks the OpenAI wire format, it needs no dedicated package — point `openaiCompatible` at your proxy's `baseURL` (default `http://localhost:4000/v1`) and route to a provider with LiteLLM's `provider/model` naming:\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst litellm = openaiCompatible({\n  name: \"litellm\",\n  baseURL: \"http://localhost:4000/v1\", // your LiteLLM proxy\n  apiKey: process.env.LITELLM_API_KEY!, // a virtual key issued by the proxy\n  models: [\n    \"anthropic/claude-sonnet-5\",\n    \"openai/gpt-5.5\",\n    \"gemini/gemini-3.5-flash\",\n  ],\n});\n```\n\n`litellm(\"anthropic/claude-sonnet-5\")` selects the Anthropic route; `litellm(\"openai/gpt-5.5\")` selects OpenAI — all through the one proxy. Declare only the model routes you configured on the proxy; for precise per-model capabilities (e.g. a reasoning route without image input), use `createModel` as shown under [Declaring Models](#declaring-models).\n\n> The proxy holds each upstream provider's real credentials; the `apiKey` here is the proxy's own virtual/master key, not the upstream provider's.\n\n## Azure OpenAI\n\nAzure uses a resource-scoped URL and a separate API-version. Use the `/openai/v1` endpoint with `defaultQuery` for the version and `defaultHeaders` for the `api-key` header:\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst azure = openaiCompatible({\n  name: \"azure\",\n  baseURL: \"https://YOUR_RESOURCE.openai.azure.com/openai/v1\",\n  apiKey: process.env.AZURE_OPENAI_API_KEY!, // also sent as Bearer; Azure accepts the api-key header below\n  models: [\"gpt-4o\"], // your Azure deployment name\n  defaultQuery: { \"api-version\": \"2026-01-01-preview\" },\n  defaultHeaders: { \"api-key\": process.env.AZURE_OPENAI_API_KEY! },\n});\n```\n\n> Confirm the current `api-version` and endpoint shape in Azure's documentation — Azure's API surface evolves independently of OpenAI's.\n\n## Example: With Tools\n\nTools work exactly as they do with any other adapter, for models that support function calling:\n\n```typescript\nimport { chat, toolDefinition } from \"@tanstack/ai\";\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\nimport { z } from \"zod\";\n\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({ location: z.string() }),\n});\n\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\" };\n});\n\nconst deepseek = openaiCompatible({\n  baseURL: \"https://api.deepseek.com/v1\",\n  apiKey: process.env.DEEPSEEK_API_KEY!,\n  models: [\"deepseek-chat\"],\n});\n\nconst stream = chat({\n  adapter: deepseek(\"deepseek-chat\"),\n  messages: [{ role: \"user\", content: \"What's the weather in Tokyo?\" }],\n  tools: [getWeather],\n});\n```\n\n## Next Steps\n\n- [OpenAI Adapter](./openai) - The first-class OpenAI adapter\n- [OpenRouter Adapter](./openrouter) - Access 300+ models through one gateway\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Extending Adapters](../advanced/extend-adapter) - Add custom models to any adapter\n","originalRawMarkdown":"---\ntitle: OpenAI-Compatible Adapter\nid: openai-compatible-adapter\ndescription: \"Use any OpenAI-compatible provider (DeepSeek, Moonshot/Kimi, Together, Fireworks, Cerebras, Qwen, Perplexity, local servers, and more) in TanStack AI with one generic adapter.\"\nkeywords:\n  - tanstack ai\n  - openai compatible\n  - deepseek\n  - moonshot\n  - kimi\n  - together\n  - fireworks\n  - cerebras\n  - qwen\n  - perplexity\n  - lm studio\n  - vllm\n  - litellm\n  - adapter\n---\n\nMany providers expose the OpenAI **Chat Completions** API (`/chat/completions`) — DeepSeek, Moonshot/Kimi, Together, Fireworks, Cerebras, Alibaba Qwen, Perplexity, NVIDIA NIM, and local servers like LM Studio, Ollama, and vLLM. Instead of a dedicated package per provider, TanStack AI ships one generic adapter: point it at any compatible `baseURL`, give it your models, and you get the same type-safe `chat()` experience as the first-class adapters.\n\nUse this when your provider speaks the OpenAI Chat Completions wire format but doesn't have its own `@tanstack/ai-*` package. If a dedicated adapter exists (OpenAI, Grok, Groq, OpenRouter), prefer it. Those carry curated per-model metadata. For Vercel AI Gateway, install `@tanstack/ai-vercel-gateway` and use `vercelGatewayText`. See [Vercel AI Gateway](./vercel-gateway.md). For Lovable AI Gateway, install `@tanstack/ai-lovable` and use `lovableText` (plus image, video, embeddings, and speech factories). See [Lovable AI Gateway](./lovable.md).\n\nPerplexity Sonar chat stays on this adapter. [`@tanstack/ai-perplexity`](./perplexity.md) is Search/grounding only — it does not replace `openaiCompatible` for `chat()`. Optional: pass `defaultHeaders: getPerplexityIntegrationHeaders()` from that package to send Perplexity's `X-Pplx-Integration` attribution header.\n\n## Installation\n\nThe adapter ships inside `@tanstack/ai-openai` under the `/compatible` subpath — no extra install:\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-openai\nvue: @tanstack/ai-openai\nsolid: @tanstack/ai-openai\nsvelte: @tanstack/ai-openai\npreact: @tanstack/ai-openai\nangular: @tanstack/ai-openai\nvanilla: @tanstack/ai-openai\noctane: @tanstack/ai-openai\n\n<!-- ::end:tabs -->\n\n## Basic Usage\n\nConfigure the provider once with `openaiCompatible({ baseURL, apiKey, models })`, then select a model per call. The returned model name is a type-safe union of the models you declared:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst deepseek = openaiCompatible({\n  name: \"deepseek\", // optional label shown in devtools/errors (default: \"openai-compatible\")\n  baseURL: \"https://api.deepseek.com/v1\",\n  apiKey: process.env.DEEPSEEK_API_KEY!,\n  models: [\"deepseek-chat\", \"deepseek-reasoner\"],\n});\n\nconst stream = chat({\n  adapter: deepseek(\"deepseek-chat\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n`deepseek(\"deepseek-reasoner\")` is valid; `deepseek(\"gpt-4o\")` is a type error — only declared models are accepted.\n\n## One-Shot Usage\n\nFor a single model, skip the provider-factory and build the adapter inline with `openaiCompatibleText`:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openaiCompatibleText } from \"@tanstack/ai-openai/compatible\";\n\nconst stream = chat({\n  adapter: openaiCompatibleText(\"deepseek-chat\", {\n    baseURL: \"https://api.deepseek.com/v1\",\n    apiKey: process.env.DEEPSEEK_API_KEY!,\n  }),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Declaring Models\n\nThe `models` array accepts two forms, which you can mix:\n\n- **A bare string** — gets optimistic defaults: `text` + `image` input, with `streaming`, `function_calling`, and `structured_outputs` support. Good for mainstream chat models.\n- **A `createModel(name, capabilities)` definition** — declares precise per-model capabilities so the types match reality (e.g. a reasoning model with no image input).\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\nimport { createModel } from \"@tanstack/ai\";\n\nconst provider = openaiCompatible({\n  baseURL: \"https://api.deepseek.com/v1\",\n  apiKey: process.env.DEEPSEEK_API_KEY!,\n  models: [\n    \"deepseek-chat\", // string → optimistic defaults\n    createModel(\"deepseek-reasoner\", {\n      input: [\"text\"], // text only\n      features: [\"reasoning\", \"structured_outputs\"],\n    }),\n  ],\n});\n```\n\n> Capabilities are enforced at the type level. If a provider rejects a feature at runtime (e.g. tools on a model that doesn't support them), declare that model with `createModel` and omit the unsupported feature so the types stop you from calling it.\n\n## Configuration\n\n`openaiCompatible` accepts every OpenAI SDK `ClientOptions` field besides `apiKey`/`baseURL` (which are required and promoted to the top level). The most useful are `defaultHeaders` and `defaultQuery`, for providers that need extra auth or routing parameters:\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst provider = openaiCompatible({\n  baseURL: \"https://api.example.com/v1\",\n  apiKey: process.env.EXAMPLE_API_KEY!,\n  models: [\"some-model\"],\n  defaultHeaders: { \"X-Custom-Header\": \"value\" },\n  defaultQuery: { \"api-version\": \"2026-01-01\" },\n});\n```\n\n## Chat Completions vs Responses\n\nBy default the adapter targets the **Chat Completions** API (`/chat/completions`). For providers that implement the **Responses** API, select `api: \"responses\"`. This API choice also controls how `ChatStreamSummarizeAdapter` forwards `maxLength`, regardless of the wrapper name:\n\n- Chat Completions uses `max_tokens`.\n- Responses uses `max_output_tokens`.\n\nAn explicit token limit in `modelOptions` takes precedence over `maxLength`.\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst provider = openaiCompatible({\n  baseURL: \"https://my-resource.openai.azure.com/openai/v1\",\n  apiKey: process.env.AZURE_OPENAI_API_KEY!,\n  models: [\"gpt-4o\"],\n  api: \"responses\", // default is \"chat-completions\"\n});\n```\n\n**Reasoning:** Reasoning deltas stream as thinking content. Endpoints frozen on the pre-July-2025 OpenAI spec may still emit the legacy event name `response.reasoning.delta` (removed from the spec in favor of `response.reasoning_text.delta`); the adapter recognizes both and maps them identically.\n\n## Supported Providers\n\nAny provider implementing the OpenAI Chat Completions API works. Common ones are below — **verify the `baseURL` and model ids against each provider's current docs**, since they change over time. Set the API key via the provider's own environment variable and pass it as `apiKey`.\n\n| Provider | `baseURL` | Example model |\n| --- | --- | --- |\n| DeepSeek | `https://api.deepseek.com/v1` | `deepseek-chat`, `deepseek-reasoner` |\n| Moonshot / Kimi | `https://api.moonshot.ai/v1` | `kimi-k2-0711-preview` |\n| Alibaba Qwen (DashScope, intl) | `https://dashscope-intl.aliyuncs.com/compatible-mode/v1` | `qwen-max`, `qwen-plus` |\n| Alibaba Qwen (DashScope, China) | `https://dashscope.aliyuncs.com/compatible-mode/v1` | `qwen-max` |\n| Together AI | `https://api.together.xyz/v1` | `meta-llama/Llama-3.3-70B-Instruct-Turbo` |\n| Fireworks AI | `https://api.fireworks.ai/inference/v1` | `accounts/fireworks/models/llama-v3p3-70b-instruct` |\n| Cerebras | `https://api.cerebras.ai/v1` | `llama-3.3-70b` |\n| DeepInfra | `https://api.deepinfra.com/v1/openai` | `meta-llama/Llama-3.3-70B-Instruct` |\n| Perplexity | `https://api.perplexity.ai` | `sonar`, `sonar-pro` |\n| Mistral | `https://api.mistral.ai/v1` | `mistral-large-latest` |\n| Nebius | `https://api.studio.nebius.ai/v1` | `meta-llama/Llama-3.3-70B-Instruct` |\n| Z.AI (GLM) | `https://api.z.ai/api/paas/v4` | `glm-4.6` |\n| Baseten | `https://inference.baseten.co/v1` | model-dependent |\n| Hugging Face (router) | `https://router.huggingface.co/v1` | `meta-llama/Llama-3.3-70B-Instruct` |\n| NVIDIA NIM | `https://integrate.api.nvidia.com/v1` | `meta/llama-3.3-70b-instruct` |\n\nOn Chat Completions, `RUN_FINISHED.usage` carries the prompt cache counts that the provider reports. Cache reads arrive on `promptTokensDetails.cachedTokens`, and cache writes arrive on `promptTokensDetails.cacheWriteTokens`. Moonshot / Kimi reports both.\n\n## Local & Self-Hosted Servers\n\nPoint the adapter at any local OpenAI-compatible server. The API key is usually a placeholder:\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\n// LM Studio\nconst lmstudio = openaiCompatible({\n  name: \"lmstudio\",\n  baseURL: \"http://localhost:1234/v1\",\n  apiKey: \"lm-studio\",\n  models: [\"local-model\"],\n});\n\n// vLLM\nconst vllm = openaiCompatible({\n  name: \"vllm\",\n  baseURL: \"http://localhost:8000/v1\",\n  apiKey: \"not-needed\",\n  models: [\"meta-llama/Llama-3.3-70B-Instruct\"],\n});\n\n// Ollama's OpenAI-compatible endpoint\nconst ollama = openaiCompatible({\n  name: \"ollama\",\n  baseURL: \"http://localhost:11434/v1\",\n  apiKey: \"ollama\",\n  models: [\"llama3.3\"],\n});\n```\n\n> Ollama also has a dedicated adapter, [`@tanstack/ai-ollama`](./ollama), which understands its native API. Use `openaiCompatible` only if you specifically want Ollama's OpenAI-compatible surface.\n\n## LiteLLM Proxy\n\n[LiteLLM](https://github.com/BerriAI/litellm) is a self-hosted gateway that exposes a single OpenAI Chat Completions endpoint in front of 100+ providers (OpenAI, Anthropic, Google, Azure, AWS Bedrock, Mistral, Groq, and more). Because the proxy speaks the OpenAI wire format, it needs no dedicated package — point `openaiCompatible` at your proxy's `baseURL` (default `http://localhost:4000/v1`) and route to a provider with LiteLLM's `provider/model` naming:\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst litellm = openaiCompatible({\n  name: \"litellm\",\n  baseURL: \"http://localhost:4000/v1\", // your LiteLLM proxy\n  apiKey: process.env.LITELLM_API_KEY!, // a virtual key issued by the proxy\n  models: [\n    \"anthropic/claude-sonnet-5\",\n    \"openai/gpt-5.5\",\n    \"gemini/gemini-3.5-flash\",\n  ],\n});\n```\n\n`litellm(\"anthropic/claude-sonnet-5\")` selects the Anthropic route; `litellm(\"openai/gpt-5.5\")` selects OpenAI — all through the one proxy. Declare only the model routes you configured on the proxy; for precise per-model capabilities (e.g. a reasoning route without image input), use `createModel` as shown under [Declaring Models](#declaring-models).\n\n> The proxy holds each upstream provider's real credentials; the `apiKey` here is the proxy's own virtual/master key, not the upstream provider's.\n\n## Azure OpenAI\n\nAzure uses a resource-scoped URL and a separate API-version. Use the `/openai/v1` endpoint with `defaultQuery` for the version and `defaultHeaders` for the `api-key` header:\n\n```typescript\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\n\nconst azure = openaiCompatible({\n  name: \"azure\",\n  baseURL: \"https://YOUR_RESOURCE.openai.azure.com/openai/v1\",\n  apiKey: process.env.AZURE_OPENAI_API_KEY!, // also sent as Bearer; Azure accepts the api-key header below\n  models: [\"gpt-4o\"], // your Azure deployment name\n  defaultQuery: { \"api-version\": \"2026-01-01-preview\" },\n  defaultHeaders: { \"api-key\": process.env.AZURE_OPENAI_API_KEY! },\n});\n```\n\n> Confirm the current `api-version` and endpoint shape in Azure's documentation — Azure's API surface evolves independently of OpenAI's.\n\n## Example: With Tools\n\nTools work exactly as they do with any other adapter, for models that support function calling:\n\n```typescript\nimport { chat, toolDefinition } from \"@tanstack/ai\";\nimport { openaiCompatible } from \"@tanstack/ai-openai/compatible\";\nimport { z } from \"zod\";\n\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({ location: z.string() }),\n});\n\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\" };\n});\n\nconst deepseek = openaiCompatible({\n  baseURL: \"https://api.deepseek.com/v1\",\n  apiKey: process.env.DEEPSEEK_API_KEY!,\n  models: [\"deepseek-chat\"],\n});\n\nconst stream = chat({\n  adapter: deepseek(\"deepseek-chat\"),\n  messages: [{ role: \"user\", content: \"What's the weather in Tokyo?\" }],\n  tools: [getWeather],\n});\n```\n\n## Next Steps\n\n- [OpenAI Adapter](./openai) - The first-class OpenAI adapter\n- [OpenRouter Adapter](./openrouter) - Access 300+ models through one gateway\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Extending Adapters](../advanced/extend-adapter) - Add custom models to any adapter\n"}
