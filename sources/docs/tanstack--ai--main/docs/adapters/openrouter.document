---
title: OpenRouter Adapter
id: openrouter-adapter
description: "Access 300+ LLMs from OpenAI, Anthropic, Google, Meta, Mistral, and more through a single API with OpenRouter in TanStack AI."
keywords:
  - tanstack ai
  - openrouter
  - multi-provider
  - unified api
  - llm gateway
  - 300 models
  - adapter
  - evaluate
  - jev
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"OpenRouter is TanStack AI's first official AI partner and the recommended starting point for most projects. It provides access to 300+ models from OpenAI, Anthropic, Google, Meta, Mistral, and many more — all through a single API key and unified interface."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-openrouter\"]],\"vue\":[[\"@tanstack/ai-openrouter\"]],\"solid\":[[\"@tanstack/ai-openrouter\"]],\"svelte\":[[\"@tanstack/ai-openrouter\"]],\"preact\":[[\"@tanstack/ai-openrouter\"]],\"angular\":[[\"@tanstack/ai-openrouter\"]],\"vanilla\":[[\"@tanstack/ai-openrouter\"]],\"octane\":[[\"@tanstack/ai-openrouter\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"configuration","children":[{"type":"text","value":"Configuration"}]},{"type":"code","value":"import { createOpenRouterText } from \"@tanstack/ai-openrouter\";\n\nconst adapter = createOpenRouterText(\n  \"openai/gpt-5\",\n  process.env.OPENROUTER_API_KEY!,\n  {\n    serverURL: \"https://openrouter.ai/api/v1\", // Optional\n    httpReferer: \"https://your-app.com\", // Optional, for rankings\n    appTitle: \"Your App Name\", // Optional, for rankings\n  },\n);","lang":"typescript"},{"type":"heading","depth":3,"id":"retry-rate-limits","children":[{"type":"text","value":"Retry rate limits"}]},{"type":"paragraph","children":[{"type":"text","value":"A busy upstream provider can reply with HTTP 429. The adapter retries only 5XX errors by default. Add "},{"type":"inlineCode","value":"\"429\""},{"type":"text","value":" to "},{"type":"inlineCode","value":"retryCodes"},{"type":"text","value":" to retry rate limits too:"}]},{"type":"code","value":"import { createOpenRouterText } from \"@tanstack/ai-openrouter\";\n\nconst adapter = createOpenRouterText(\n  \"openai/gpt-5\",\n  process.env.OPENROUTER_API_KEY!,\n  {\n    retryConfig: {\n      strategy: \"backoff\",\n      backoff: {\n        initialInterval: 500,\n        maxInterval: 60000,\n        exponent: 1.5,\n        maxElapsedTime: 120000,\n      },\n      retryConnectionErrors: true,\n    },\n    retryCodes: [\"429\", \"5XX\"],\n  },\n);","lang":"typescript"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"retryCodes"},{"type":"text","value":": the HTTP status codes to retry. "},{"type":"inlineCode","value":"\"5XX\""},{"type":"text","value":" matches every 5xx code."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"retryConfig"},{"type":"text","value":": how long to wait between tries. When the response has a "},{"type":"inlineCode","value":"Retry-After"},{"type":"text","value":" header, the SDK waits that long."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Now a 429 waits, then retries, and the chat continues with the next response."}]},{"type":"heading","depth":2,"id":"available-models","children":[{"type":"text","value":"Available Models"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenRouter provides access to 300+ models from various providers. Models use the format "},{"type":"inlineCode","value":"provider/model-name"},{"type":"text","value":":"}]},{"type":"code","value":"model: \"openai/gpt-5.1\"\nmodel: \"anthropic/claude-sonnet-4.5\"\nmodel: \"google/gemini-3.1-pro-preview\"\nmodel: \"meta-llama/llama-4-maverick\"\nmodel: \"deepseek/deepseek-v3.2\"","lang":"text"},{"type":"paragraph","children":[{"type":"text","value":"See the full list at "},{"type":"link","href":"https://openrouter.ai/models","children":[{"type":"text","value":"openrouter.ai/models"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"example-chat-completion","children":[{"type":"text","value":"Example: Chat Completion"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openai/gpt-5\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"example-with-tools","children":[{"type":"text","value":"Example: With Tools"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { z } from \"zod\";\n\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({\n    location: z.string(),\n  }),\n});\n\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\" };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openai/gpt-5\"),\n    messages,\n    tools: [getWeather],\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"tools-and-structured-output-together","children":[{"type":"text","value":"Tools and structured output together"}]},{"type":"paragraph","children":[{"type":"text","value":"You can pass both "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" and "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":" on one "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" call. For some\nupstream models OpenRouter can return the typed object in that same streaming\nrequest, so the engine does not make a second finalization call."}]},{"type":"paragraph","children":[{"type":"text","value":"That happens only when "},{"type":"strong","children":[{"type":"text","value":"every"}]},{"type":"text","value":" model that can receive the request is in\n"},{"type":"inlineCode","value":"OPENROUTER_COMBINED_TOOLS_AND_SCHEMA_MODELS"},{"type":"text","value":". The set is generated from\nOpenRouter's catalog on every model sync: every chat model whose\n"},{"type":"inlineCode","value":"supported_parameters"},{"type":"text","value":" include "},{"type":"inlineCode","value":"structured_outputs"},{"type":"text","value":", "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" and "},{"type":"inlineCode","value":"tool_choice"},{"type":"text","value":"\n(Claude 4.5+, Gemini 2.5+, GPT-4o+, Grok 4, DeepSeek V3+, Llama 3.1+, and so\non). Models OpenRouter does not flag, such as "},{"type":"inlineCode","value":"anthropic/claude-opus-4.1"},{"type":"text","value":", stay\non the legacy two-call path."}]},{"type":"paragraph","children":[{"type":"text","value":"If any fallback in "},{"type":"inlineCode","value":"modelOptions.models"},{"type":"text","value":" is outside that set, OpenRouter keeps\nthe two-call path. Routing suffixes such as "},{"type":"inlineCode","value":":nitro"},{"type":"text","value":" do not change the gate."}]},{"type":"paragraph","children":[{"type":"text","value":"Import the set from "},{"type":"inlineCode","value":"@tanstack/ai-openrouter/model-meta"},{"type":"text","value":" if you need to check a\nmodel before you send:"}]},{"type":"code","value":"import { OPENROUTER_COMBINED_TOOLS_AND_SCHEMA_MODELS } from \"@tanstack/ai-openrouter/model-meta\";\n\nOPENROUTER_COMBINED_TOOLS_AND_SCHEMA_MODELS.has(\"openai/gpt-5.5\");","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Chat Completions ("},{"type":"inlineCode","value":"openRouterText"},{"type":"text","value":") and Responses ("},{"type":"inlineCode","value":"openRouterResponsesText"},{"type":"text","value":")\nboth attach the schema on this path. The client does not change: "},{"type":"inlineCode","value":"useChat({ outputSchema })"},{"type":"text","value":" still reads "},{"type":"inlineCode","value":"partial"},{"type":"text","value":" and "},{"type":"inlineCode","value":"final"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Server (Chat Completions):"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { z } from \"zod\";\n\nconst getWeather = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({ location: z.string() }),\n}).server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\", location };\n});\n\nconst AnswerSchema = z.object({\n  summary: z.string(),\n  location: z.string(),\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openai/gpt-5.5\"),\n    messages,\n    tools: [getWeather],\n    outputSchema: AnswerSchema,\n    stream: true,\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Server (Responses). Same "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" and "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":" as the Chat Completions\nexample, with "},{"type":"inlineCode","value":"openRouterResponsesText"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { openRouterResponsesText } from \"@tanstack/ai-openrouter\";\nimport { z } from \"zod\";\n\nconst getWeather = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({ location: z.string() }),\n}).server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\", location };\n});\n\nconst AnswerSchema = z.object({\n  summary: z.string(),\n  location: z.string(),\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterResponsesText(\"openai/gpt-5.5\"),\n    messages,\n    tools: [getWeather],\n    outputSchema: AnswerSchema,\n    stream: true,\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Client:"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { z } from \"zod\";\n\nconst AnswerSchema = z.object({\n  summary: z.string(),\n  location: z.string(),\n});\n\nconst { sendMessage, partial, final } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  outputSchema: AnswerSchema,\n});","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../structured-outputs/with-tools","children":[{"type":"text","value":"Structured Outputs with tools"}]},{"type":"text","value":" for the\nevent order, and "},{"type":"link","href":"../advanced/middleware","children":[{"type":"text","value":"Middleware"}]},{"type":"text","value":" for how\n"},{"type":"inlineCode","value":"structuredOutput"},{"type":"text","value":" phase behaves on this path."}]},{"type":"paragraph","children":[{"type":"text","value":"To try this in a browser, run "},{"type":"inlineCode","value":"examples/ts-react-chat"},{"type":"text","value":" and open\n"},{"type":"inlineCode","value":"/generations/openrouter-combined"},{"type":"text","value":". The page shows the tool call, the typed\nobject, and the adapter call counts. "},{"type":"inlineCode","value":"structuredOutputStream"},{"type":"text","value":" must stay at 0."}]},{"type":"heading","depth":2,"id":"environment-variables","children":[{"type":"text","value":"Environment Variables"}]},{"type":"paragraph","children":[{"type":"text","value":"Set your API key in environment variables:"}]},{"type":"code","value":"OPENROUTER_API_KEY=sk-or-...","lang":"bash"},{"type":"heading","depth":2,"id":"model-routing","children":[{"type":"text","value":"Model Routing"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenRouter can automatically route requests to the best available provider:"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openrouter/auto\"),\n    messages,\n    modelOptions: {\n      models: [\n        \"openai/gpt-5.5\",\n        \"anthropic/claude-sonnet-4.5\",\n        \"google/gemini-3.1-pro-preview\",\n      ],\n    },\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"models"},{"type":"text","value":" is the fallback list: OpenRouter tries them in order when the primary model is unavailable. The rest of OpenRouter's routing surface is also exposed through "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" and forwarded to the request as-is. The option names are the camelCase ones from the OpenRouter SDK."}]},{"type":"heading","depth":3,"id":"provider-preferences","children":[{"type":"text","value":"Provider preferences"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"provider"},{"type":"text","value":" controls which upstream providers may serve the request and in what order. Pin one provider and disable fallbacks:"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"meta-llama/llama-4-maverick\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    provider: {\n      order: [\"groq\", \"together\"], // provider slugs, in priority order\n      allowFallbacks: false, // fail instead of routing elsewhere\n    },\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Provider slugs are the lowercase ids shown on OpenRouter's model pages ("},{"type":"inlineCode","value":"\"anthropic\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"openai\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"groq\""},{"type":"text","value":", …). Other fields on "},{"type":"inlineCode","value":"provider"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"only"},{"type":"text","value":" / "},{"type":"inlineCode","value":"ignore"},{"type":"text","value":": allow-list or deny-list of provider slugs, merged with your account-wide provider settings for this request."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"requireParameters"},{"type":"text","value":": only route to providers that support every parameter in the request. Without it, OpenRouter sends each provider only the parameters it supports and silently drops the rest, so a "},{"type":"inlineCode","value":"responseFormat"},{"type":"text","value":" or a sampling option can be ignored without an error. When you stream with "},{"type":"inlineCode","value":"requireParameters: true"},{"type":"text","value":", also set "},{"type":"inlineCode","value":"modelOptions.streamOptions: { includeUsage: false }"},{"type":"text","value":". Without it, the adapter sends "},{"type":"inlineCode","value":"stream_options"},{"type":"text","value":", and OpenRouter returns a 404 for providers that do not support that parameter."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"sort"},{"type":"text","value":": "},{"type":"inlineCode","value":"\"price\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"throughput\""},{"type":"text","value":", or "},{"type":"inlineCode","value":"\"latency\""},{"type":"text","value":", or an object with "},{"type":"inlineCode","value":"by"},{"type":"text","value":" and "},{"type":"inlineCode","value":"partition"},{"type":"text","value":", applied when "},{"type":"inlineCode","value":"order"},{"type":"text","value":" is not set. Setting it disables load balancing."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"maxPrice"},{"type":"text","value":": the highest pricing you accept. It takes "},{"type":"inlineCode","value":"prompt"},{"type":"text","value":" and "},{"type":"inlineCode","value":"completion"},{"type":"text","value":" in USD per million tokens, plus "},{"type":"inlineCode","value":"request"},{"type":"text","value":" (per-request pricing) and "},{"type":"inlineCode","value":"image"},{"type":"text","value":" (per image) where a provider offers them. Providers above the limit are skipped."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"quantizations"},{"type":"text","value":": restrict to providers serving the model at given quantization levels (e.g. "},{"type":"inlineCode","value":"\"fp8\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"int4\""},{"type":"text","value":")."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"dataCollection"},{"type":"text","value":": "},{"type":"inlineCode","value":"\"deny\""},{"type":"text","value":" to use only providers that do not collect user data."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"zdr"},{"type":"text","value":": "},{"type":"inlineCode","value":"true"},{"type":"text","value":" to restrict routing to zero-data-retention endpoints."}]}]}]},{"type":"heading","depth":3,"id":"model-variants","children":[{"type":"text","value":"Model variants"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"variant"},{"type":"text","value":" appends OpenRouter's "},{"type":"inlineCode","value":":variant"},{"type":"text","value":" suffix to the model id. It is adapter metadata only and is never sent in the request body:"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"deepseek/deepseek-v4-pro\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    variant: \"free\", // requests deepseek/deepseek-v4-pro:free\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Accepted values are "},{"type":"inlineCode","value":"\"free\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"nitro\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"online\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"exacto\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"extended\""},{"type":"text","value":", and "},{"type":"inlineCode","value":"\"thinking\""},{"type":"text","value":". Which of them a model actually offers is up to OpenRouter's catalog."}]},{"type":"heading","depth":3,"id":"plugins","children":[{"type":"text","value":"Plugins"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"plugins"},{"type":"text","value":" enables OpenRouter's request-level plugins. Each entry is identified by "},{"type":"inlineCode","value":"id"},{"type":"text","value":", with plugin-specific options alongside:"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-6-astra\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    plugins: [{ id: \"web\", maxResults: 5 }],\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Plugin ids include "},{"type":"inlineCode","value":"web"},{"type":"text","value":", "},{"type":"inlineCode","value":"file-parser"},{"type":"text","value":", "},{"type":"inlineCode","value":"response-healing"},{"type":"text","value":", "},{"type":"inlineCode","value":"moderation"},{"type":"text","value":", and "},{"type":"inlineCode","value":"auto-router"},{"type":"text","value":"; see the OpenRouter documentation for each plugin's options. Web fetching is not a plugin but a server tool ("},{"type":"inlineCode","value":"openrouter:web_fetch"},{"type":"text","value":"); for web search and fetch as "},{"type":"emphasis","children":[{"type":"text","value":"tools"}]},{"type":"text","value":" the model can call, see "},{"type":"link","href":"#provider-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":" below."}]},{"type":"heading","depth":3,"id":"reasoning","children":[{"type":"text","value":"Reasoning"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"reasoning"},{"type":"text","value":" is OpenRouter's unified reasoning configuration:"}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"anthropic/claude-sonnet-5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    reasoning: { effort: \"high\" },\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"effort"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"\"none\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"minimal\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"low\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"medium\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"high\""},{"type":"text","value":", "},{"type":"inlineCode","value":"\"xhigh\""},{"type":"text","value":", and "},{"type":"inlineCode","value":"\"max\""},{"type":"text","value":". To switch reasoning off for a request, pass "},{"type":"inlineCode","value":"reasoning: { enabled: false }"},{"type":"text","value":"; the adapter sends it as "},{"type":"inlineCode","value":"effort: \"none\""},{"type":"text","value":" because the SDK's request schema drops "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"session-and-metadata","children":[{"type":"text","value":"Session and metadata"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"user"},{"type":"text","value":" (a unique user identifier), "},{"type":"inlineCode","value":"sessionId"},{"type":"text","value":", and "},{"type":"inlineCode","value":"metadata"},{"type":"text","value":" (up to 16 key-value pairs) are forwarded unchanged. "},{"type":"inlineCode","value":"sessionId"},{"type":"text","value":" doubles as OpenRouter's sticky routing key: requests that share it are routed to the same provider to maximize prompt-cache hits, and grouped together for observability."}]},{"type":"heading","depth":2,"id":"model-options","children":[{"type":"text","value":"Model Options"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenRouter supports various provider-specific options. Sampling parameters live here too — "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":", "},{"type":"inlineCode","value":"topP"},{"type":"text","value":", and "},{"type":"inlineCode","value":"maxCompletionTokens"},{"type":"text","value":" (OpenRouter's token-limit key for the chat adapter) — rather than as root-level props on "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"anthropic/claude-sonnet-4.5\"),\n    messages,\n    modelOptions: {\n      temperature: 0.7,\n      topP: 0.9,\n      maxCompletionTokens: 1024,\n    },\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"If you previously passed "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":" / "},{"type":"inlineCode","value":"topP"},{"type":"text","value":" / "},{"type":"inlineCode","value":"maxTokens"},{"type":"text","value":" at the root of "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":", see "},{"type":"link","href":"../migration/sampling-options-to-model-options","children":[{"type":"text","value":"Moving Sampling Options into modelOptions"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":2,"id":"chat-completions-vs-responses-beta","children":[{"type":"text","value":"Chat Completions vs Responses (beta)"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenRouter exposes two OpenAI-compatible wire formats, and the adapter\npackage ships one of each:"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Adapter"}]},{"type":"tableCell","children":[{"type":"text","value":"Endpoint"}]},{"type":"tableCell","children":[{"type":"text","value":"Status"}]},{"type":"tableCell","children":[{"type":"text","value":"When to use"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"openRouterText"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/v1/chat/completions"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable"}]},{"type":"tableCell","children":[{"type":"text","value":"Default for almost everything. Broadest model + tool support."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"openRouterResponsesText"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/v1/responses"}]},{"type":"tableCell","children":[{"type":"text","value":"Beta"}]},{"type":"tableCell","children":[{"type":"text","value":"OpenAI Responses-shaped request/response; richer multi-turn state on OpenAI-style models."}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Both adapters route to any underlying model OpenRouter supports\n("},{"type":"inlineCode","value":"anthropic/..."},{"type":"text","value":", "},{"type":"inlineCode","value":"google/..."},{"type":"text","value":", "},{"type":"inlineCode","value":"meta-llama/..."},{"type":"text","value":", etc.) — the wire format\ndescribes how your client talks to OpenRouter, not which provider answers.\n"},{"type":"inlineCode","value":"/v1/responses"},{"type":"text","value":" is OpenAI's newer API surface; OpenRouter implements it so\nclients that prefer that wire format can use it across the same 300+\nmodel catalogue."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openRouterResponsesText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterResponsesText(\"anthropic/claude-sonnet-4.5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Caveats while the Responses adapter is in beta:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Function tools are supported; OpenRouter's branded server-tools (web\nsearch, file search, …) are not yet wired through this path — use\n"},{"type":"inlineCode","value":"openRouterText"},{"type":"text","value":" if you need those."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If in doubt, prefer "},{"type":"inlineCode","value":"openRouterText"},{"type":"text","value":". The Chat Completions endpoint has\nbroader provider coverage and feature parity today."}]}]}]},{"type":"heading","depth":2,"id":"cost-tracking","children":[{"type":"text","value":"Cost Tracking"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenRouter reports the actual cost of each request inline on the streamed\nresponse. When present, the adapter forwards it on the terminal "},{"type":"inlineCode","value":"RUN_FINISHED"},{"type":"text","value":"\nevent under "},{"type":"inlineCode","value":"usage.cost"},{"type":"text","value":", with OpenRouter's per-request breakdown under\n"},{"type":"inlineCode","value":"usage.costDetails"},{"type":"text","value":". This is the cost OpenRouter itself reports for the\nrequest — it is "},{"type":"strong","children":[{"type":"text","value":"not"}]},{"type":"text","value":" computed locally from token counts, so it already\naccounts for routing, fallback providers, BYOK, and cached-token pricing. See\nOpenRouter's "},{"type":"link","href":"https://openrouter.ai/docs/use-cases/usage-accounting","children":[{"type":"text","value":"Usage Accounting"}]},{"type":"text","value":"\ndocs for the meaning and units of these fields."}]},{"type":"code","value":"import { chat, type RunFinishedEvent, type StreamChunk } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nfunction isRunFinished(chunk: StreamChunk): chunk is RunFinishedEvent {\n  return \"finishReason\" in chunk;\n}\n\nfor await (const chunk of chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n})) {\n  if (isRunFinished(chunk)) {\n    console.log(\"cost:\", chunk.usage?.cost);\n    console.log(\"breakdown:\", chunk.usage?.costDetails);\n  }\n}","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"text","value":"The same "},{"type":"inlineCode","value":"usage"},{"type":"text","value":" (including "},{"type":"inlineCode","value":"cost"},{"type":"text","value":" / "},{"type":"inlineCode","value":"costDetails"},{"type":"text","value":") is passed to middleware via\nthe "},{"type":"inlineCode","value":"onUsage"},{"type":"text","value":" and "},{"type":"inlineCode","value":"onFinish"},{"type":"text","value":" hooks. When OpenRouter does not report a cost, the\nfields are simply absent and the stream completes normally. Both\n"},{"type":"inlineCode","value":"openRouterText"},{"type":"text","value":" and "},{"type":"inlineCode","value":"openRouterResponsesText"},{"type":"text","value":" populate cost when OpenRouter\nreturns it."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"openRouterText"},{"type":"text","value":" adapter's "},{"type":"inlineCode","value":"structuredOutputStream()"},{"type":"text","value":" method includes\nreceived usage on its terminal "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":" event. This covers parse failures,\ntruncated responses, empty responses, and SDK errors. When "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" uses this\npath, middleware "},{"type":"inlineCode","value":"onChunk"},{"type":"text","value":" receives the error event even if the promise rejects.\nThe "},{"type":"inlineCode","value":"onUsage"},{"type":"text","value":" hook reports successful calls. Each adapter call reports usage on\none terminal event."}]},{"type":"paragraph","children":[{"type":"text","value":"A reported "},{"type":"inlineCode","value":"completionTokensDetails.reasoningTokens"},{"type":"text","value":" value of "},{"type":"inlineCode","value":"0"},{"type":"text","value":" stays zero.\nA missing count stays absent. Errors before any usage arrives have no "},{"type":"inlineCode","value":"usage"},{"type":"text","value":"\nfield. If the consumer stops reading the stream, it cannot receive later events."}]},{"type":"heading","depth":2,"id":"reranking","children":[{"type":"text","value":"Reranking"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenRouter exposes rerank models through its unified "},{"type":"inlineCode","value":"/v1/rerank"},{"type":"text","value":" endpoint\n(served via the "},{"type":"inlineCode","value":"@openrouter/sdk"},{"type":"text","value":" SDK). Any rerank model OpenRouter offers works\nby passing its slug — for example "},{"type":"inlineCode","value":"cohere/rerank-v3.5"},{"type":"text","value":", "},{"type":"inlineCode","value":"cohere/rerank-4-fast"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"cohere/rerank-4-pro"},{"type":"text","value":", or "},{"type":"inlineCode","value":"nvidia/llama-nemotron-rerank-vl-1b-v2"},{"type":"text","value":". Use\n"},{"type":"inlineCode","value":"openRouterRerank"},{"type":"text","value":" with the "},{"type":"inlineCode","value":"rerank()"},{"type":"text","value":" activity to reorder candidate documents\nby relevance to a query:"}]},{"type":"code","value":"import { rerank } from \"@tanstack/ai\";\nimport { openRouterRerank } from \"@tanstack/ai-openrouter\";\n\nconst { rerankedDocuments } = await rerank({\n  adapter: openRouterRerank(\"cohere/rerank-v3.5\"),\n  query: \"talk about rain\",\n  documents: [\"sunny day at the beach\", \"rainy afternoon in the city\"],\n  topN: 2,\n});\n\nconsole.log(rerankedDocuments[0]); // 'rainy afternoon in the city'","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"openRouterRerank"},{"type":"text","value":" reads "},{"type":"inlineCode","value":"OPENROUTER_API_KEY"},{"type":"text","value":" from the environment; pass a key\nexplicitly with "},{"type":"inlineCode","value":"createOpenRouterRerank(\"cohere/rerank-v3.5\", \"sk-or-...\")"},{"type":"text","value":". The\noptional "},{"type":"inlineCode","value":"httpReferer"},{"type":"text","value":" / "},{"type":"inlineCode","value":"appTitle"},{"type":"text","value":" config fields are forwarded as OpenRouter\nattribution headers, just like the chat adapter."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../rerank/rerank","children":[{"type":"text","value":"Reranking guide"}]},{"type":"text","value":" for object documents, RAG\npipelines, options, and the result shape."}]},{"type":"heading","depth":2,"id":"evaluate","children":[{"type":"text","value":"Evaluate"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenRouter exposes TypeSafe Jev through "},{"type":"inlineCode","value":"POST /api/alpha/decisions"},{"type":"text","value":".\nUse "},{"type":"inlineCode","value":"openRouterDecider"},{"type":"text","value":" with "},{"type":"inlineCode","value":"decide()"},{"type":"text","value":" to ask typed questions about a\nshared "},{"type":"inlineCode","value":"state"},{"type":"text","value":":"}]},{"type":"code","value":"import { decide, choice, score, boolean } from \"@tanstack/ai\";\nimport { openRouterDecider } from \"@tanstack/ai-openrouter\";\n\nconst ticket = {\n  subject: \"Charged twice for the same invoice\",\n  body: \"Please refund the extra payment.\",\n};\n\nconst result = await decide({\n  adapter: openRouterDecider(\"~typesafe/jev-latest\"),\n  state: ticket,\n  questions: {\n    queue: choice({\n      instructions: \"Which team should handle this ticket?\",\n      options: {\n        billing: \"Payments, invoices, refunds\",\n        tech: \"Bugs, outages, integrations\",\n        sales: \"Pricing, upgrades, new accounts\",\n      },\n    }),\n    urgency: score({\n      instructions: \"How urgent is this ticket?\",\n      levels: [\"low\", \"medium\", \"high\"],\n    }),\n    refund: boolean({\n      instructions: \"Is the customer asking for a refund?\",\n    }),\n  },\n});\n\nconsole.log(result.queue.value);\nconsole.log(result.queue.probability);\nconsole.log(result.queue.confidence);\nconsole.log(result.meta.usage);","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"To bill per request, read "},{"type":"inlineCode","value":"result.meta.usage.cost"},{"type":"text","value":". To look the request up later with "},{"type":"inlineCode","value":"GET /api/v1/generation?id="},{"type":"text","value":", read "},{"type":"inlineCode","value":"result.meta.id"},{"type":"text","value":". "},{"type":"inlineCode","value":"result.meta.provider"},{"type":"text","value":" names the upstream provider that served the request."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"openRouterDecider"},{"type":"text","value":" reads "},{"type":"inlineCode","value":"OPENROUTER_API_KEY"},{"type":"text","value":" from the environment. Pass a\nkey explicitly with "},{"type":"inlineCode","value":"createOpenRouterDecider(\"~typesafe/jev-latest\", \"sk-or-...\")"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Known slugs:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"~typesafe/jev-latest"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"typesafe/jev-1.13"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"typesafe/jev-1.13.0"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../evaluate/evaluate","children":[{"type":"text","value":"Evaluate guide"}]},{"type":"text","value":" for question helpers, the result\nshape, abort, and middleware."}]},{"type":"heading","depth":2,"id":"image-generation","children":[{"type":"text","value":"Image Generation"}]},{"type":"paragraph","children":[{"type":"text","value":"For a React + Start walkthrough with "},{"type":"inlineCode","value":"useGenerateImage"},{"type":"text","value":", open "},{"type":"link","href":"../tutorials/generate-image","children":[{"type":"text","value":"Generate Image"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"openRouterImage"},{"type":"text","value":" routes image generation through OpenRouter's\nchat-completions surface ("},{"type":"inlineCode","value":"modalities: ['image']"},{"type":"text","value":"). Multimodal prompts are\nsupported — text and image parts are forwarded in order for\nimage-conditioned generation:"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { openRouterImage } from \"@tanstack/ai-openrouter\";\n\nconst result = await generateImage({\n  adapter: openRouterImage(\"google/gemini-2.5-flash-image\"),\n  prompt: \"A watercolor lighthouse at dusk\",\n  size: \"1344x768\", // mapped to image_config.aspect_ratio ('16:9')\n  modelOptions: {\n    image_size: \"2K\", // resolution (Gemini models)\n    strength: 0.35, // image-to-image influence, i2i-capable models only\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Notes:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The pathway returns "},{"type":"strong","children":[{"type":"text","value":"exactly one image per request"}]},{"type":"text","value":" — "},{"type":"inlineCode","value":"numberOfImages > 1"},{"type":"text","value":"\nthrows instead of silently under-delivering. Make multiple requests if you\nneed multiple candidates."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"size"},{"type":"text","value":" must be one of the ten supported "},{"type":"inlineCode","value":"WIDTHxHEIGHT"},{"type":"text","value":" values (it is\nconverted to "},{"type":"inlineCode","value":"image_config.aspect_ratio"},{"type":"text","value":"); anything else throws with the\nsupported list."}]}]}]},{"type":"heading","depth":2,"id":"video-generation-experimental","children":[{"type":"text","value":"Video Generation (Experimental)"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"openRouterVideo"},{"type":"text","value":" targets OpenRouter's dedicated "},{"type":"strong","children":[{"type":"text","value":"async video API"}]},{"type":"text","value":"\n("},{"type":"inlineCode","value":"POST /api/v1/videos"},{"type":"text","value":") — Seedance, Veo 3.1, Wan, Kling, and Sora 2 Pro\nthrough your one OpenRouter key. It follows the jobs/polling architecture\nshared by all TanStack AI video adapters:"}]},{"type":"code","value":"// Server: create the job, then poll\nimport { generateVideo, getVideoJobStatus } from \"@tanstack/ai\";\nimport { openRouterVideo } from \"@tanstack/ai-openrouter\";\nimport { withGenerationPersistence } from \"@tanstack/ai-persistence\";\nimport { persistence } from \"./persistence\";\n\nconst adapter = openRouterVideo(\"bytedance/seedance-2.0\");\n\n// OpenRouter returns the finished video as a stream, not a URL. Persistence\n// stores the stream and sets `url`. Pass the same options to both calls.\nconst hosting = {\n  threadId: \"videos\",\n  middleware: [\n    withGenerationPersistence(persistence, {\n      artifactUrl: (ref) => `/api/artifacts/${ref.artifactId}`,\n    }),\n  ],\n};\n\nconst { jobId } = await generateVideo({\n  adapter,\n  ...hosting,\n  prompt: [\n    { type: \"text\", content: \"Animate this product shot, slow push-in\" },\n    {\n      type: \"image\",\n      source: { type: \"url\", value: \"https://your-cdn.com/product.png\" },\n      metadata: { role: \"start_frame\" },\n    },\n  ],\n  size: \"1280x720\",\n  // `duration` is typed per model from the published metadata; coerce raw\n  // seconds with adapter.snapDuration() or enumerate via adapter.availableDurations().\n  duration: 8,\n});\n\nlet status = await getVideoJobStatus({ adapter, jobId, ...hosting });\nwhile (status.status !== \"completed\" && status.status !== \"failed\") {\n  await new Promise((r) => setTimeout(r, 5000));\n  status = await getVideoJobStatus({ adapter, jobId, ...hosting });\n}\n// status.url is your artifact route. status.usage?.cost is the real billed\n// cost that the gateway reports.","lang":"typescript"},{"type":"code","value":"// Client: track the job with the useGenerateVideo hook\nimport { useGenerateVideo, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst { generate, result, videoStatus, isLoading } = useGenerateVideo({\n  connection: fetchServerSentEvents(\"/api/generate/video\"),\n});\n// result?.url renders directly: <video src={result.url} controls />","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Sizes, durations, and per-model options ("},{"type":"inlineCode","value":"resolution"},{"type":"text","value":", "},{"type":"inlineCode","value":"aspectRatio"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"generateAudio"},{"type":"text","value":", "},{"type":"inlineCode","value":"seed"},{"type":"text","value":", …) are typed and validated per model from\nOpenRouter's video model metadata. See\n"},{"type":"link","href":"../media/video-generation.md","children":[{"type":"text","value":"Video Generation"}]},{"type":"text","value":" for the full lifecycle,\nstreaming mode, and the image-to-video role-mapping table."}]},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Getting Started"}]},{"type":"text","value":" - Learn the basics"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools Guide"}]},{"type":"text","value":" - Learn about tools"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../rerank/rerank","children":[{"type":"text","value":"Reranking"}]},{"type":"text","value":" - Reorder documents by relevance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../evaluate/evaluate","children":[{"type":"text","value":"Evaluate"}]},{"type":"text","value":" - Ask typed questions about shared state"}]}]}]},{"type":"heading","depth":2,"id":"provider-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Migrated from "},{"type":"inlineCode","value":"createWebSearchTool"},{"type":"text","value":"?"}]},{"type":"text","value":" This factory was renamed to\n"},{"type":"inlineCode","value":"webSearchTool"},{"type":"text","value":" and moved to the "},{"type":"inlineCode","value":"/tools"},{"type":"text","value":" subpath in this release.\nSee "},{"type":"link","href":"../migration/migration.md#6-provider-tools-moved-to-tools-subpath","children":[{"type":"text","value":"Migration Guide §6"}]},{"type":"text","value":"\nfor the exact before/after."}]}]},{"type":"paragraph","children":[{"type":"text","value":"OpenRouter's gateway exposes web search via a plugin that works across\nany proxied chat model. Import it from "},{"type":"inlineCode","value":"@tanstack/ai-openrouter/tools"},{"type":"text","value":"."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"For the full concept, a comparison matrix, and type-gating details, see\n"},{"type":"link","href":"../tools/provider-tools.md","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":3,"id":"websearchtool","children":[{"type":"inlineCode","value":"webSearchTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Adds web search capability to any OpenRouter-proxied chat model. The factory\naccepts OpenRouter's "},{"type":"inlineCode","value":"WebSearchConfig"},{"type":"text","value":" directly — pick the "},{"type":"inlineCode","value":"engine"},{"type":"text","value":"\n("},{"type":"inlineCode","value":"auto"},{"type":"text","value":", "},{"type":"inlineCode","value":"native"},{"type":"text","value":", "},{"type":"inlineCode","value":"exa"},{"type":"text","value":", "},{"type":"inlineCode","value":"firecrawl"},{"type":"text","value":", or "},{"type":"inlineCode","value":"parallel"},{"type":"text","value":"), cap results with\n"},{"type":"inlineCode","value":"maxResults"},{"type":"text","value":" / "},{"type":"inlineCode","value":"maxTotalResults"},{"type":"text","value":", restrict which sites can appear in results\nwith "},{"type":"inlineCode","value":"allowedDomains"},{"type":"text","value":" / "},{"type":"inlineCode","value":"excludedDomains"},{"type":"text","value":", and optionally pass\n"},{"type":"inlineCode","value":"searchContextSize"},{"type":"text","value":" or "},{"type":"inlineCode","value":"userLocation"},{"type":"text","value":" for finer control."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { webSearchTool } from \"@tanstack/ai-openrouter/tools\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [{ role: \"user\", content: \"What's new in AI this week?\" }],\n  tools: [\n    webSearchTool({\n      engine: \"exa\",\n      maxResults: 5,\n      allowedDomains: [\"arxiv.org\", \"openai.com\"],\n    }),\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" all OpenRouter chat models. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"webfetchtool","children":[{"type":"inlineCode","value":"webFetchTool"}]},{"type":"paragraph","children":[{"type":"text","value":"Lets any OpenRouter-proxied chat model fetch the full contents of a URL the\nmodel chooses, instead of running a search. The factory accepts OpenRouter's\n"},{"type":"inlineCode","value":"WebFetchServerToolConfig"},{"type":"text","value":" directly — pick the fetch "},{"type":"inlineCode","value":"engine"},{"type":"text","value":" ("},{"type":"inlineCode","value":"auto"},{"type":"text","value":" — the\ndefault, "},{"type":"inlineCode","value":"native"},{"type":"text","value":", "},{"type":"inlineCode","value":"openrouter"},{"type":"text","value":", "},{"type":"inlineCode","value":"exa"},{"type":"text","value":", or "},{"type":"inlineCode","value":"firecrawl"},{"type":"text","value":"), cap how much page\ncontent the model receives with "},{"type":"inlineCode","value":"maxContentTokens"},{"type":"text","value":", cap how many fetches the\nmodel can make per request with "},{"type":"inlineCode","value":"maxUses"},{"type":"text","value":", and restrict which URLs the model\ncan fetch with "},{"type":"inlineCode","value":"allowedDomains"},{"type":"text","value":" / "},{"type":"inlineCode","value":"blockedDomains"},{"type":"text","value":"."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"native"},{"type":"text","value":" engine routes to the underlying provider's own fetch (for\nexample, Anthropic's "},{"type":"inlineCode","value":"web_fetch"},{"type":"text","value":" on Claude models). Native fetch\ncapabilities vary, so "},{"type":"inlineCode","value":"allowedDomains"},{"type":"text","value":" and "},{"type":"inlineCode","value":"blockedDomains"},{"type":"text","value":" may be\nignored. Use "},{"type":"inlineCode","value":"openrouter"},{"type":"text","value":", "},{"type":"inlineCode","value":"exa"},{"type":"text","value":", or "},{"type":"inlineCode","value":"firecrawl"},{"type":"text","value":" if you need consistent\nbehaviour across models."}]}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { webFetchTool } from \"@tanstack/ai-openrouter/tools\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [\n    { role: \"user\", content: \"Summarize https://example.com/article\" },\n  ],\n  tools: [\n    webFetchTool({\n      engine: \"openrouter\",\n      maxContentTokens: 4000,\n      allowedDomains: [\"example.com\"],\n    }),\n  ],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported models:"}]},{"type":"text","value":" all OpenRouter chat models. See "},{"type":"link","href":"../tools/provider-tools.md#which-models-support-which-tools","children":[{"type":"text","value":"Provider Tools"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"sign-in-with-openrouter-byok","children":[{"type":"text","value":"Sign in with OpenRouter (BYOK)"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenRouter can mint a user-owned API key via "},{"type":"link","href":"https://openrouter.ai/docs/guides/overview/auth/oauth","children":[{"type":"text","value":"OAuth PKCE"}]},{"type":"text","value":". Import the helpers from "},{"type":"inlineCode","value":"@tanstack/ai-openrouter/pkce"},{"type":"text","value":". The key is stored under "},{"type":"inlineCode","value":"openrouterByok.id"},{"type":"text","value":" ("},{"type":"inlineCode","value":"openrouter"},{"type":"text","value":") and sent as "},{"type":"inlineCode","value":"x-byok-openrouter"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Client: start login, then on return save the key into "},{"type":"inlineCode","value":"defineByok"},{"type":"text","value":"."}]},{"type":"code","value":"import { useEffect } from \"react\";\nimport { defineByok, defaultByokStorage } from \"@tanstack/ai-client/byok\";\nimport {\n  completeOpenRouterPkceIntoByok,\n  startOpenRouterPkceLogin,\n} from \"@tanstack/ai-openrouter/pkce\";\n\nconst byok = defineByok({\n  storage: defaultByokStorage(),\n});\n\nexport function OpenRouterSignIn() {\n  useEffect(() => {\n    void completeOpenRouterPkceIntoByok(byok);\n  }, []);\n\n  return (\n    <button\n      type=\"button\"\n      onClick={() => {\n        void startOpenRouterPkceLogin();\n      }}\n    >\n      Sign in with OpenRouter\n    </button>\n  );\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Server: read the same slug the PKCE helper wrote."}]},{"type":"code","value":"import {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { byokMissing, getByokKey } from \"@tanstack/ai/byok/server\";\nimport { createOpenRouterText } from \"@tanstack/ai-openrouter\";\nimport { openrouterByok } from \"@tanstack/ai-openrouter/byok\";\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request);\n  const apiKey = getByokKey(request, openrouterByok);\n  if (!apiKey) return byokMissing(openrouterByok);\n\n  const stream = chat({\n    adapter: createOpenRouterText(\"openai/gpt-5.5\", apiKey),\n    messages: params.messages,\n    threadId: params.threadId,\n    runId: params.runId,\n  });\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../advanced/byok","children":[{"type":"text","value":"Bring Your Own Key"}]},{"type":"text","value":" for the keyring and passkey storage."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"configuration","text":"Configuration","level":2},{"id":"retry-rate-limits","text":"Retry rate limits","level":3},{"id":"available-models","text":"Available Models","level":2},{"id":"example-chat-completion","text":"Example: Chat Completion","level":2},{"id":"example-with-tools","text":"Example: With Tools","level":2},{"id":"tools-and-structured-output-together","text":"Tools and structured output together","level":2},{"id":"environment-variables","text":"Environment Variables","level":2},{"id":"model-routing","text":"Model Routing","level":2},{"id":"provider-preferences","text":"Provider preferences","level":3},{"id":"model-variants","text":"Model variants","level":3},{"id":"plugins","text":"Plugins","level":3},{"id":"reasoning","text":"Reasoning","level":3},{"id":"session-and-metadata","text":"Session and metadata","level":3},{"id":"model-options","text":"Model Options","level":2},{"id":"chat-completions-vs-responses-beta","text":"Chat Completions vs Responses (beta)","level":2},{"id":"cost-tracking","text":"Cost Tracking","level":2},{"id":"reranking","text":"Reranking","level":2},{"id":"evaluate","text":"Evaluate","level":2},{"id":"image-generation","text":"Image Generation","level":2},{"id":"video-generation-experimental","text":"Video Generation (Experimental)","level":2},{"id":"next-steps","text":"Next Steps","level":2},{"id":"provider-tools","text":"Provider Tools","level":2},{"id":"websearchtool","text":"webSearchTool","level":3},{"id":"webfetchtool","text":"webFetchTool","level":3},{"id":"sign-in-with-openrouter-byok","text":"Sign in with OpenRouter (BYOK)","level":2}]},"frameworks":["react","vue","solid","svelte","preact","angular","vanilla","octane"],"downloadMarkdown":"\nOpenRouter is TanStack AI's first official AI partner and the recommended starting point for most projects. It provides access to 300+ models from OpenAI, Anthropic, Google, Meta, Mistral, and many more — all through a single API key and unified interface.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-openrouter\nvue: @tanstack/ai-openrouter\nsolid: @tanstack/ai-openrouter\nsvelte: @tanstack/ai-openrouter\npreact: @tanstack/ai-openrouter\nangular: @tanstack/ai-openrouter\nvanilla: @tanstack/ai-openrouter\noctane: @tanstack/ai-openrouter\n\n<!-- ::end:tabs -->\n\n## Basic Usage\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Configuration\n\n```typescript\nimport { createOpenRouterText } from \"@tanstack/ai-openrouter\";\n\nconst adapter = createOpenRouterText(\n  \"openai/gpt-5\",\n  process.env.OPENROUTER_API_KEY!,\n  {\n    serverURL: \"https://openrouter.ai/api/v1\", // Optional\n    httpReferer: \"https://your-app.com\", // Optional, for rankings\n    appTitle: \"Your App Name\", // Optional, for rankings\n  },\n);\n```\n\n### Retry rate limits\n\nA busy upstream provider can reply with HTTP 429. The adapter retries only 5XX errors by default. Add `\"429\"` to `retryCodes` to retry rate limits too:\n\n```typescript\nimport { createOpenRouterText } from \"@tanstack/ai-openrouter\";\n\nconst adapter = createOpenRouterText(\n  \"openai/gpt-5\",\n  process.env.OPENROUTER_API_KEY!,\n  {\n    retryConfig: {\n      strategy: \"backoff\",\n      backoff: {\n        initialInterval: 500,\n        maxInterval: 60000,\n        exponent: 1.5,\n        maxElapsedTime: 120000,\n      },\n      retryConnectionErrors: true,\n    },\n    retryCodes: [\"429\", \"5XX\"],\n  },\n);\n```\n\n- `retryCodes`: the HTTP status codes to retry. `\"5XX\"` matches every 5xx code.\n- `retryConfig`: how long to wait between tries. When the response has a `Retry-After` header, the SDK waits that long.\n\nNow a 429 waits, then retries, and the chat continues with the next response.\n\n## Available Models\n\nOpenRouter provides access to 300+ models from various providers. Models use the format `provider/model-name`:\n\n```text\nmodel: \"openai/gpt-5.1\"\nmodel: \"anthropic/claude-sonnet-4.5\"\nmodel: \"google/gemini-3.1-pro-preview\"\nmodel: \"meta-llama/llama-4-maverick\"\nmodel: \"deepseek/deepseek-v3.2\"\n```\n\nSee the full list at [openrouter.ai/models](https://openrouter.ai/models).\n\n## Example: Chat Completion\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openai/gpt-5\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Example: With Tools\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { z } from \"zod\";\n\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({\n    location: z.string(),\n  }),\n});\n\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\" };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openai/gpt-5\"),\n    messages,\n    tools: [getWeather],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Tools and structured output together\n\nYou can pass both `tools` and `outputSchema` on one `chat()` call. For some\nupstream models OpenRouter can return the typed object in that same streaming\nrequest, so the engine does not make a second finalization call.\n\nThat happens only when **every** model that can receive the request is in\n`OPENROUTER_COMBINED_TOOLS_AND_SCHEMA_MODELS`. The set is generated from\nOpenRouter's catalog on every model sync: every chat model whose\n`supported_parameters` include `structured_outputs`, `tools` and `tool_choice`\n(Claude 4.5+, Gemini 2.5+, GPT-4o+, Grok 4, DeepSeek V3+, Llama 3.1+, and so\non). Models OpenRouter does not flag, such as `anthropic/claude-opus-4.1`, stay\non the legacy two-call path.\n\nIf any fallback in `modelOptions.models` is outside that set, OpenRouter keeps\nthe two-call path. Routing suffixes such as `:nitro` do not change the gate.\n\nImport the set from `@tanstack/ai-openrouter/model-meta` if you need to check a\nmodel before you send:\n\n```typescript\nimport { OPENROUTER_COMBINED_TOOLS_AND_SCHEMA_MODELS } from \"@tanstack/ai-openrouter/model-meta\";\n\nOPENROUTER_COMBINED_TOOLS_AND_SCHEMA_MODELS.has(\"openai/gpt-5.5\");\n```\n\nChat Completions (`openRouterText`) and Responses (`openRouterResponsesText`)\nboth attach the schema on this path. The client does not change: `useChat({\noutputSchema })` still reads `partial` and `final`.\n\nServer (Chat Completions):\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { z } from \"zod\";\n\nconst getWeather = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({ location: z.string() }),\n}).server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\", location };\n});\n\nconst AnswerSchema = z.object({\n  summary: z.string(),\n  location: z.string(),\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openai/gpt-5.5\"),\n    messages,\n    tools: [getWeather],\n    outputSchema: AnswerSchema,\n    stream: true,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nServer (Responses). Same `tools` and `outputSchema` as the Chat Completions\nexample, with `openRouterResponsesText`:\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { openRouterResponsesText } from \"@tanstack/ai-openrouter\";\nimport { z } from \"zod\";\n\nconst getWeather = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({ location: z.string() }),\n}).server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\", location };\n});\n\nconst AnswerSchema = z.object({\n  summary: z.string(),\n  location: z.string(),\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterResponsesText(\"openai/gpt-5.5\"),\n    messages,\n    tools: [getWeather],\n    outputSchema: AnswerSchema,\n    stream: true,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nClient:\n\n```tsx\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { z } from \"zod\";\n\nconst AnswerSchema = z.object({\n  summary: z.string(),\n  location: z.string(),\n});\n\nconst { sendMessage, partial, final } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  outputSchema: AnswerSchema,\n});\n```\n\nSee [Structured Outputs with tools](../structured-outputs/with-tools) for the\nevent order, and [Middleware](../advanced/middleware) for how\n`structuredOutput` phase behaves on this path.\n\nTo try this in a browser, run `examples/ts-react-chat` and open\n`/generations/openrouter-combined`. The page shows the tool call, the typed\nobject, and the adapter call counts. `structuredOutputStream` must stay at 0.\n\n## Environment Variables\n\nSet your API key in environment variables:\n\n```bash\nOPENROUTER_API_KEY=sk-or-...\n```\n\n## Model Routing\n\nOpenRouter can automatically route requests to the best available provider:\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openrouter/auto\"),\n    messages,\n    modelOptions: {\n      models: [\n        \"openai/gpt-5.5\",\n        \"anthropic/claude-sonnet-4.5\",\n        \"google/gemini-3.1-pro-preview\",\n      ],\n    },\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n`models` is the fallback list: OpenRouter tries them in order when the primary model is unavailable. The rest of OpenRouter's routing surface is also exposed through `modelOptions` and forwarded to the request as-is. The option names are the camelCase ones from the OpenRouter SDK.\n\n### Provider preferences\n\n`provider` controls which upstream providers may serve the request and in what order. Pin one provider and disable fallbacks:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"meta-llama/llama-4-maverick\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    provider: {\n      order: [\"groq\", \"together\"], // provider slugs, in priority order\n      allowFallbacks: false, // fail instead of routing elsewhere\n    },\n  },\n});\n```\n\nProvider slugs are the lowercase ids shown on OpenRouter's model pages (`\"anthropic\"`, `\"openai\"`, `\"groq\"`, …). Other fields on `provider`:\n\n- `only` / `ignore`: allow-list or deny-list of provider slugs, merged with your account-wide provider settings for this request.\n- `requireParameters`: only route to providers that support every parameter in the request. Without it, OpenRouter sends each provider only the parameters it supports and silently drops the rest, so a `responseFormat` or a sampling option can be ignored without an error. When you stream with `requireParameters: true`, also set `modelOptions.streamOptions: { includeUsage: false }`. Without it, the adapter sends `stream_options`, and OpenRouter returns a 404 for providers that do not support that parameter.\n- `sort`: `\"price\"`, `\"throughput\"`, or `\"latency\"`, or an object with `by` and `partition`, applied when `order` is not set. Setting it disables load balancing.\n- `maxPrice`: the highest pricing you accept. It takes `prompt` and `completion` in USD per million tokens, plus `request` (per-request pricing) and `image` (per image) where a provider offers them. Providers above the limit are skipped.\n- `quantizations`: restrict to providers serving the model at given quantization levels (e.g. `\"fp8\"`, `\"int4\"`).\n- `dataCollection`: `\"deny\"` to use only providers that do not collect user data.\n- `zdr`: `true` to restrict routing to zero-data-retention endpoints.\n\n### Model variants\n\n`variant` appends OpenRouter's `:variant` suffix to the model id. It is adapter metadata only and is never sent in the request body:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"deepseek/deepseek-v4-pro\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    variant: \"free\", // requests deepseek/deepseek-v4-pro:free\n  },\n});\n```\n\nAccepted values are `\"free\"`, `\"nitro\"`, `\"online\"`, `\"exacto\"`, `\"extended\"`, and `\"thinking\"`. Which of them a model actually offers is up to OpenRouter's catalog.\n\n### Plugins\n\n`plugins` enables OpenRouter's request-level plugins. Each entry is identified by `id`, with plugin-specific options alongside:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-6-astra\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    plugins: [{ id: \"web\", maxResults: 5 }],\n  },\n});\n```\n\nPlugin ids include `web`, `file-parser`, `response-healing`, `moderation`, and `auto-router`; see the OpenRouter documentation for each plugin's options. Web fetching is not a plugin but a server tool (`openrouter:web_fetch`); for web search and fetch as _tools_ the model can call, see [Provider Tools](#provider-tools) below.\n\n### Reasoning\n\n`reasoning` is OpenRouter's unified reasoning configuration:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"anthropic/claude-sonnet-5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    reasoning: { effort: \"high\" },\n  },\n});\n```\n\n`effort` accepts `\"none\"`, `\"minimal\"`, `\"low\"`, `\"medium\"`, `\"high\"`, `\"xhigh\"`, and `\"max\"`. To switch reasoning off for a request, pass `reasoning: { enabled: false }`; the adapter sends it as `effort: \"none\"` because the SDK's request schema drops `enabled`.\n\n### Session and metadata\n\n`user` (a unique user identifier), `sessionId`, and `metadata` (up to 16 key-value pairs) are forwarded unchanged. `sessionId` doubles as OpenRouter's sticky routing key: requests that share it are routed to the same provider to maximize prompt-cache hits, and grouped together for observability.\n\n## Model Options\n\nOpenRouter supports various provider-specific options. Sampling parameters live here too — `temperature`, `topP`, and `maxCompletionTokens` (OpenRouter's token-limit key for the chat adapter) — rather than as root-level props on `chat()`:\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"anthropic/claude-sonnet-4.5\"),\n    messages,\n    modelOptions: {\n      temperature: 0.7,\n      topP: 0.9,\n      maxCompletionTokens: 1024,\n    },\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n> If you previously passed `temperature` / `topP` / `maxTokens` at the root of `chat()`, see [Moving Sampling Options into modelOptions](../migration/sampling-options-to-model-options).\n\n## Chat Completions vs Responses (beta)\n\nOpenRouter exposes two OpenAI-compatible wire formats, and the adapter\npackage ships one of each:\n\n| Adapter                   | Endpoint               | Status | When to use                                                                               |\n| ------------------------- | ---------------------- | ------ | ----------------------------------------------------------------------------------------- |\n| `openRouterText`          | `/v1/chat/completions` | Stable | Default for almost everything. Broadest model + tool support.                             |\n| `openRouterResponsesText` | `/v1/responses`        | Beta   | OpenAI Responses-shaped request/response; richer multi-turn state on OpenAI-style models. |\n\nBoth adapters route to any underlying model OpenRouter supports\n(`anthropic/...`, `google/...`, `meta-llama/...`, etc.) — the wire format\ndescribes how your client talks to OpenRouter, not which provider answers.\n`/v1/responses` is OpenAI's newer API surface; OpenRouter implements it so\nclients that prefer that wire format can use it across the same 300+\nmodel catalogue.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterResponsesText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterResponsesText(\"anthropic/claude-sonnet-4.5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\nCaveats while the Responses adapter is in beta:\n\n- Function tools are supported; OpenRouter's branded server-tools (web\n  search, file search, …) are not yet wired through this path — use\n  `openRouterText` if you need those.\n- If in doubt, prefer `openRouterText`. The Chat Completions endpoint has\n  broader provider coverage and feature parity today.\n\n## Cost Tracking\n\nOpenRouter reports the actual cost of each request inline on the streamed\nresponse. When present, the adapter forwards it on the terminal `RUN_FINISHED`\nevent under `usage.cost`, with OpenRouter's per-request breakdown under\n`usage.costDetails`. This is the cost OpenRouter itself reports for the\nrequest — it is **not** computed locally from token counts, so it already\naccounts for routing, fallback providers, BYOK, and cached-token pricing. See\nOpenRouter's [Usage Accounting](https://openrouter.ai/docs/use-cases/usage-accounting)\ndocs for the meaning and units of these fields.\n\n```typescript ignore\nimport { chat, type RunFinishedEvent, type StreamChunk } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nfunction isRunFinished(chunk: StreamChunk): chunk is RunFinishedEvent {\n  return \"finishReason\" in chunk;\n}\n\nfor await (const chunk of chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n})) {\n  if (isRunFinished(chunk)) {\n    console.log(\"cost:\", chunk.usage?.cost);\n    console.log(\"breakdown:\", chunk.usage?.costDetails);\n  }\n}\n```\n\nThe same `usage` (including `cost` / `costDetails`) is passed to middleware via\nthe `onUsage` and `onFinish` hooks. When OpenRouter does not report a cost, the\nfields are simply absent and the stream completes normally. Both\n`openRouterText` and `openRouterResponsesText` populate cost when OpenRouter\nreturns it.\n\nThe `openRouterText` adapter's `structuredOutputStream()` method includes\nreceived usage on its terminal `RUN_ERROR` event. This covers parse failures,\ntruncated responses, empty responses, and SDK errors. When `chat()` uses this\npath, middleware `onChunk` receives the error event even if the promise rejects.\nThe `onUsage` hook reports successful calls. Each adapter call reports usage on\none terminal event.\n\nA reported `completionTokensDetails.reasoningTokens` value of `0` stays zero.\nA missing count stays absent. Errors before any usage arrives have no `usage`\nfield. If the consumer stops reading the stream, it cannot receive later events.\n\n## Reranking\n\nOpenRouter exposes rerank models through its unified `/v1/rerank` endpoint\n(served via the `@openrouter/sdk` SDK). Any rerank model OpenRouter offers works\nby passing its slug — for example `cohere/rerank-v3.5`, `cohere/rerank-4-fast`,\n`cohere/rerank-4-pro`, or `nvidia/llama-nemotron-rerank-vl-1b-v2`. Use\n`openRouterRerank` with the `rerank()` activity to reorder candidate documents\nby relevance to a query:\n\n```typescript\nimport { rerank } from \"@tanstack/ai\";\nimport { openRouterRerank } from \"@tanstack/ai-openrouter\";\n\nconst { rerankedDocuments } = await rerank({\n  adapter: openRouterRerank(\"cohere/rerank-v3.5\"),\n  query: \"talk about rain\",\n  documents: [\"sunny day at the beach\", \"rainy afternoon in the city\"],\n  topN: 2,\n});\n\nconsole.log(rerankedDocuments[0]); // 'rainy afternoon in the city'\n```\n\n`openRouterRerank` reads `OPENROUTER_API_KEY` from the environment; pass a key\nexplicitly with `createOpenRouterRerank(\"cohere/rerank-v3.5\", \"sk-or-...\")`. The\noptional `httpReferer` / `appTitle` config fields are forwarded as OpenRouter\nattribution headers, just like the chat adapter.\n\nSee the [Reranking guide](../rerank/rerank) for object documents, RAG\npipelines, options, and the result shape.\n\n## Evaluate\n\nOpenRouter exposes TypeSafe Jev through `POST /api/alpha/decisions`.\nUse `openRouterDecider` with `decide()` to ask typed questions about a\nshared `state`:\n\n```typescript\nimport { decide, choice, score, boolean } from \"@tanstack/ai\";\nimport { openRouterDecider } from \"@tanstack/ai-openrouter\";\n\nconst ticket = {\n  subject: \"Charged twice for the same invoice\",\n  body: \"Please refund the extra payment.\",\n};\n\nconst result = await decide({\n  adapter: openRouterDecider(\"~typesafe/jev-latest\"),\n  state: ticket,\n  questions: {\n    queue: choice({\n      instructions: \"Which team should handle this ticket?\",\n      options: {\n        billing: \"Payments, invoices, refunds\",\n        tech: \"Bugs, outages, integrations\",\n        sales: \"Pricing, upgrades, new accounts\",\n      },\n    }),\n    urgency: score({\n      instructions: \"How urgent is this ticket?\",\n      levels: [\"low\", \"medium\", \"high\"],\n    }),\n    refund: boolean({\n      instructions: \"Is the customer asking for a refund?\",\n    }),\n  },\n});\n\nconsole.log(result.queue.value);\nconsole.log(result.queue.probability);\nconsole.log(result.queue.confidence);\nconsole.log(result.meta.usage);\n```\n\nTo bill per request, read `result.meta.usage.cost`. To look the request up later with `GET /api/v1/generation?id=`, read `result.meta.id`. `result.meta.provider` names the upstream provider that served the request.\n\n`openRouterDecider` reads `OPENROUTER_API_KEY` from the environment. Pass a\nkey explicitly with `createOpenRouterDecider(\"~typesafe/jev-latest\", \"sk-or-...\")`.\n\nKnown slugs:\n\n- `~typesafe/jev-latest`\n- `typesafe/jev-1.13`\n- `typesafe/jev-1.13.0`\n\nSee the [Evaluate guide](../evaluate/evaluate) for question helpers, the result\nshape, abort, and middleware.\n\n## Image Generation\n\nFor a React + Start walkthrough with `useGenerateImage`, open [Generate Image](../tutorials/generate-image).\n\n`openRouterImage` routes image generation through OpenRouter's\nchat-completions surface (`modalities: ['image']`). Multimodal prompts are\nsupported — text and image parts are forwarded in order for\nimage-conditioned generation:\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { openRouterImage } from \"@tanstack/ai-openrouter\";\n\nconst result = await generateImage({\n  adapter: openRouterImage(\"google/gemini-2.5-flash-image\"),\n  prompt: \"A watercolor lighthouse at dusk\",\n  size: \"1344x768\", // mapped to image_config.aspect_ratio ('16:9')\n  modelOptions: {\n    image_size: \"2K\", // resolution (Gemini models)\n    strength: 0.35, // image-to-image influence, i2i-capable models only\n  },\n});\n```\n\nNotes:\n\n- The pathway returns **exactly one image per request** — `numberOfImages > 1`\n  throws instead of silently under-delivering. Make multiple requests if you\n  need multiple candidates.\n- `size` must be one of the ten supported `WIDTHxHEIGHT` values (it is\n  converted to `image_config.aspect_ratio`); anything else throws with the\n  supported list.\n\n## Video Generation (Experimental)\n\n`openRouterVideo` targets OpenRouter's dedicated **async video API**\n(`POST /api/v1/videos`) — Seedance, Veo 3.1, Wan, Kling, and Sora 2 Pro\nthrough your one OpenRouter key. It follows the jobs/polling architecture\nshared by all TanStack AI video adapters:\n\n```typescript\n// Server: create the job, then poll\nimport { generateVideo, getVideoJobStatus } from \"@tanstack/ai\";\nimport { openRouterVideo } from \"@tanstack/ai-openrouter\";\nimport { withGenerationPersistence } from \"@tanstack/ai-persistence\";\nimport { persistence } from \"./persistence\";\n\nconst adapter = openRouterVideo(\"bytedance/seedance-2.0\");\n\n// OpenRouter returns the finished video as a stream, not a URL. Persistence\n// stores the stream and sets `url`. Pass the same options to both calls.\nconst hosting = {\n  threadId: \"videos\",\n  middleware: [\n    withGenerationPersistence(persistence, {\n      artifactUrl: (ref) => `/api/artifacts/${ref.artifactId}`,\n    }),\n  ],\n};\n\nconst { jobId } = await generateVideo({\n  adapter,\n  ...hosting,\n  prompt: [\n    { type: \"text\", content: \"Animate this product shot, slow push-in\" },\n    {\n      type: \"image\",\n      source: { type: \"url\", value: \"https://your-cdn.com/product.png\" },\n      metadata: { role: \"start_frame\" },\n    },\n  ],\n  size: \"1280x720\",\n  // `duration` is typed per model from the published metadata; coerce raw\n  // seconds with adapter.snapDuration() or enumerate via adapter.availableDurations().\n  duration: 8,\n});\n\nlet status = await getVideoJobStatus({ adapter, jobId, ...hosting });\nwhile (status.status !== \"completed\" && status.status !== \"failed\") {\n  await new Promise((r) => setTimeout(r, 5000));\n  status = await getVideoJobStatus({ adapter, jobId, ...hosting });\n}\n// status.url is your artifact route. status.usage?.cost is the real billed\n// cost that the gateway reports.\n```\n\n```tsx\n// Client: track the job with the useGenerateVideo hook\nimport { useGenerateVideo, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst { generate, result, videoStatus, isLoading } = useGenerateVideo({\n  connection: fetchServerSentEvents(\"/api/generate/video\"),\n});\n// result?.url renders directly: <video src={result.url} controls />\n```\n\nSizes, durations, and per-model options (`resolution`, `aspectRatio`,\n`generateAudio`, `seed`, …) are typed and validated per model from\nOpenRouter's video model metadata. See\n[Video Generation](../media/video-generation.md) for the full lifecycle,\nstreaming mode, and the image-to-video role-mapping table.\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Reranking](../rerank/rerank) - Reorder documents by relevance\n- [Evaluate](../evaluate/evaluate) - Ask typed questions about shared state\n\n## Provider Tools\n\n> **Migrated from `createWebSearchTool`?** This factory was renamed to\n> `webSearchTool` and moved to the `/tools` subpath in this release.\n> See [Migration Guide §6](../migration/migration.md#6-provider-tools-moved-to-tools-subpath)\n> for the exact before/after.\n\nOpenRouter's gateway exposes web search via a plugin that works across\nany proxied chat model. Import it from `@tanstack/ai-openrouter/tools`.\n\n> For the full concept, a comparison matrix, and type-gating details, see\n> [Provider Tools](../tools/provider-tools.md).\n\n### `webSearchTool`\n\nAdds web search capability to any OpenRouter-proxied chat model. The factory\naccepts OpenRouter's `WebSearchConfig` directly — pick the `engine`\n(`auto`, `native`, `exa`, `firecrawl`, or `parallel`), cap results with\n`maxResults` / `maxTotalResults`, restrict which sites can appear in results\nwith `allowedDomains` / `excludedDomains`, and optionally pass\n`searchContextSize` or `userLocation` for finer control.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { webSearchTool } from \"@tanstack/ai-openrouter/tools\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [{ role: \"user\", content: \"What's new in AI this week?\" }],\n  tools: [\n    webSearchTool({\n      engine: \"exa\",\n      maxResults: 5,\n      allowedDomains: [\"arxiv.org\", \"openai.com\"],\n    }),\n  ],\n});\n```\n\n**Supported models:** all OpenRouter chat models. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `webFetchTool`\n\nLets any OpenRouter-proxied chat model fetch the full contents of a URL the\nmodel chooses, instead of running a search. The factory accepts OpenRouter's\n`WebFetchServerToolConfig` directly — pick the fetch `engine` (`auto` — the\ndefault, `native`, `openrouter`, `exa`, or `firecrawl`), cap how much page\ncontent the model receives with `maxContentTokens`, cap how many fetches the\nmodel can make per request with `maxUses`, and restrict which URLs the model\ncan fetch with `allowedDomains` / `blockedDomains`.\n\n> The `native` engine routes to the underlying provider's own fetch (for\n> example, Anthropic's `web_fetch` on Claude models). Native fetch\n> capabilities vary, so `allowedDomains` and `blockedDomains` may be\n> ignored. Use `openrouter`, `exa`, or `firecrawl` if you need consistent\n> behaviour across models.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { webFetchTool } from \"@tanstack/ai-openrouter/tools\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [\n    { role: \"user\", content: \"Summarize https://example.com/article\" },\n  ],\n  tools: [\n    webFetchTool({\n      engine: \"openrouter\",\n      maxContentTokens: 4000,\n      allowedDomains: [\"example.com\"],\n    }),\n  ],\n});\n```\n\n**Supported models:** all OpenRouter chat models. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n## Sign in with OpenRouter (BYOK)\n\nOpenRouter can mint a user-owned API key via [OAuth PKCE](https://openrouter.ai/docs/guides/overview/auth/oauth). Import the helpers from `@tanstack/ai-openrouter/pkce`. The key is stored under `openrouterByok.id` (`openrouter`) and sent as `x-byok-openrouter`.\n\nClient: start login, then on return save the key into `defineByok`.\n\n```tsx\nimport { useEffect } from \"react\";\nimport { defineByok, defaultByokStorage } from \"@tanstack/ai-client/byok\";\nimport {\n  completeOpenRouterPkceIntoByok,\n  startOpenRouterPkceLogin,\n} from \"@tanstack/ai-openrouter/pkce\";\n\nconst byok = defineByok({\n  storage: defaultByokStorage(),\n});\n\nexport function OpenRouterSignIn() {\n  useEffect(() => {\n    void completeOpenRouterPkceIntoByok(byok);\n  }, []);\n\n  return (\n    <button\n      type=\"button\"\n      onClick={() => {\n        void startOpenRouterPkceLogin();\n      }}\n    >\n      Sign in with OpenRouter\n    </button>\n  );\n}\n```\n\nServer: read the same slug the PKCE helper wrote.\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { byokMissing, getByokKey } from \"@tanstack/ai/byok/server\";\nimport { createOpenRouterText } from \"@tanstack/ai-openrouter\";\nimport { openrouterByok } from \"@tanstack/ai-openrouter/byok\";\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request);\n  const apiKey = getByokKey(request, openrouterByok);\n  if (!apiKey) return byokMissing(openrouterByok);\n\n  const stream = chat({\n    adapter: createOpenRouterText(\"openai/gpt-5.5\", apiKey),\n    messages: params.messages,\n    threadId: params.threadId,\n    runId: params.runId,\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\nSee [Bring Your Own Key](../advanced/byok) for the keyring and passkey storage.\n","originalRawMarkdown":"---\ntitle: OpenRouter Adapter\nid: openrouter-adapter\ndescription: \"Access 300+ LLMs from OpenAI, Anthropic, Google, Meta, Mistral, and more through a single API with OpenRouter in TanStack AI.\"\nkeywords:\n  - tanstack ai\n  - openrouter\n  - multi-provider\n  - unified api\n  - llm gateway\n  - 300 models\n  - adapter\n  - evaluate\n  - jev\n---\n\nOpenRouter is TanStack AI's first official AI partner and the recommended starting point for most projects. It provides access to 300+ models from OpenAI, Anthropic, Google, Meta, Mistral, and many more — all through a single API key and unified interface.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-openrouter\nvue: @tanstack/ai-openrouter\nsolid: @tanstack/ai-openrouter\nsvelte: @tanstack/ai-openrouter\npreact: @tanstack/ai-openrouter\nangular: @tanstack/ai-openrouter\nvanilla: @tanstack/ai-openrouter\noctane: @tanstack/ai-openrouter\n\n<!-- ::end:tabs -->\n\n## Basic Usage\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\n## Configuration\n\n```typescript\nimport { createOpenRouterText } from \"@tanstack/ai-openrouter\";\n\nconst adapter = createOpenRouterText(\n  \"openai/gpt-5\",\n  process.env.OPENROUTER_API_KEY!,\n  {\n    serverURL: \"https://openrouter.ai/api/v1\", // Optional\n    httpReferer: \"https://your-app.com\", // Optional, for rankings\n    appTitle: \"Your App Name\", // Optional, for rankings\n  },\n);\n```\n\n### Retry rate limits\n\nA busy upstream provider can reply with HTTP 429. The adapter retries only 5XX errors by default. Add `\"429\"` to `retryCodes` to retry rate limits too:\n\n```typescript\nimport { createOpenRouterText } from \"@tanstack/ai-openrouter\";\n\nconst adapter = createOpenRouterText(\n  \"openai/gpt-5\",\n  process.env.OPENROUTER_API_KEY!,\n  {\n    retryConfig: {\n      strategy: \"backoff\",\n      backoff: {\n        initialInterval: 500,\n        maxInterval: 60000,\n        exponent: 1.5,\n        maxElapsedTime: 120000,\n      },\n      retryConnectionErrors: true,\n    },\n    retryCodes: [\"429\", \"5XX\"],\n  },\n);\n```\n\n- `retryCodes`: the HTTP status codes to retry. `\"5XX\"` matches every 5xx code.\n- `retryConfig`: how long to wait between tries. When the response has a `Retry-After` header, the SDK waits that long.\n\nNow a 429 waits, then retries, and the chat continues with the next response.\n\n## Available Models\n\nOpenRouter provides access to 300+ models from various providers. Models use the format `provider/model-name`:\n\n```text\nmodel: \"openai/gpt-5.1\"\nmodel: \"anthropic/claude-sonnet-4.5\"\nmodel: \"google/gemini-3.1-pro-preview\"\nmodel: \"meta-llama/llama-4-maverick\"\nmodel: \"deepseek/deepseek-v3.2\"\n```\n\nSee the full list at [openrouter.ai/models](https://openrouter.ai/models).\n\n## Example: Chat Completion\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openai/gpt-5\"),\n    messages,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Example: With Tools\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { z } from \"zod\";\n\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({\n    location: z.string(),\n  }),\n});\n\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\" };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openai/gpt-5\"),\n    messages,\n    tools: [getWeather],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n## Tools and structured output together\n\nYou can pass both `tools` and `outputSchema` on one `chat()` call. For some\nupstream models OpenRouter can return the typed object in that same streaming\nrequest, so the engine does not make a second finalization call.\n\nThat happens only when **every** model that can receive the request is in\n`OPENROUTER_COMBINED_TOOLS_AND_SCHEMA_MODELS`. The set is generated from\nOpenRouter's catalog on every model sync: every chat model whose\n`supported_parameters` include `structured_outputs`, `tools` and `tool_choice`\n(Claude 4.5+, Gemini 2.5+, GPT-4o+, Grok 4, DeepSeek V3+, Llama 3.1+, and so\non). Models OpenRouter does not flag, such as `anthropic/claude-opus-4.1`, stay\non the legacy two-call path.\n\nIf any fallback in `modelOptions.models` is outside that set, OpenRouter keeps\nthe two-call path. Routing suffixes such as `:nitro` do not change the gate.\n\nImport the set from `@tanstack/ai-openrouter/model-meta` if you need to check a\nmodel before you send:\n\n```typescript\nimport { OPENROUTER_COMBINED_TOOLS_AND_SCHEMA_MODELS } from \"@tanstack/ai-openrouter/model-meta\";\n\nOPENROUTER_COMBINED_TOOLS_AND_SCHEMA_MODELS.has(\"openai/gpt-5.5\");\n```\n\nChat Completions (`openRouterText`) and Responses (`openRouterResponsesText`)\nboth attach the schema on this path. The client does not change: `useChat({\noutputSchema })` still reads `partial` and `final`.\n\nServer (Chat Completions):\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { z } from \"zod\";\n\nconst getWeather = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({ location: z.string() }),\n}).server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\", location };\n});\n\nconst AnswerSchema = z.object({\n  summary: z.string(),\n  location: z.string(),\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openai/gpt-5.5\"),\n    messages,\n    tools: [getWeather],\n    outputSchema: AnswerSchema,\n    stream: true,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nServer (Responses). Same `tools` and `outputSchema` as the Chat Completions\nexample, with `openRouterResponsesText`:\n\n```typescript\nimport { chat, toServerSentEventsResponse, toolDefinition } from \"@tanstack/ai\";\nimport { openRouterResponsesText } from \"@tanstack/ai-openrouter\";\nimport { z } from \"zod\";\n\nconst getWeather = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get the current weather\",\n  inputSchema: z.object({ location: z.string() }),\n}).server(async ({ location }) => {\n  return { temperature: 72, conditions: \"sunny\", location };\n});\n\nconst AnswerSchema = z.object({\n  summary: z.string(),\n  location: z.string(),\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterResponsesText(\"openai/gpt-5.5\"),\n    messages,\n    tools: [getWeather],\n    outputSchema: AnswerSchema,\n    stream: true,\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\nClient:\n\n```tsx\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { z } from \"zod\";\n\nconst AnswerSchema = z.object({\n  summary: z.string(),\n  location: z.string(),\n});\n\nconst { sendMessage, partial, final } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  outputSchema: AnswerSchema,\n});\n```\n\nSee [Structured Outputs with tools](../structured-outputs/with-tools) for the\nevent order, and [Middleware](../advanced/middleware) for how\n`structuredOutput` phase behaves on this path.\n\nTo try this in a browser, run `examples/ts-react-chat` and open\n`/generations/openrouter-combined`. The page shows the tool call, the typed\nobject, and the adapter call counts. `structuredOutputStream` must stay at 0.\n\n## Environment Variables\n\nSet your API key in environment variables:\n\n```bash\nOPENROUTER_API_KEY=sk-or-...\n```\n\n## Model Routing\n\nOpenRouter can automatically route requests to the best available provider:\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"openrouter/auto\"),\n    messages,\n    modelOptions: {\n      models: [\n        \"openai/gpt-5.5\",\n        \"anthropic/claude-sonnet-4.5\",\n        \"google/gemini-3.1-pro-preview\",\n      ],\n    },\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n`models` is the fallback list: OpenRouter tries them in order when the primary model is unavailable. The rest of OpenRouter's routing surface is also exposed through `modelOptions` and forwarded to the request as-is. The option names are the camelCase ones from the OpenRouter SDK.\n\n### Provider preferences\n\n`provider` controls which upstream providers may serve the request and in what order. Pin one provider and disable fallbacks:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"meta-llama/llama-4-maverick\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    provider: {\n      order: [\"groq\", \"together\"], // provider slugs, in priority order\n      allowFallbacks: false, // fail instead of routing elsewhere\n    },\n  },\n});\n```\n\nProvider slugs are the lowercase ids shown on OpenRouter's model pages (`\"anthropic\"`, `\"openai\"`, `\"groq\"`, …). Other fields on `provider`:\n\n- `only` / `ignore`: allow-list or deny-list of provider slugs, merged with your account-wide provider settings for this request.\n- `requireParameters`: only route to providers that support every parameter in the request. Without it, OpenRouter sends each provider only the parameters it supports and silently drops the rest, so a `responseFormat` or a sampling option can be ignored without an error. When you stream with `requireParameters: true`, also set `modelOptions.streamOptions: { includeUsage: false }`. Without it, the adapter sends `stream_options`, and OpenRouter returns a 404 for providers that do not support that parameter.\n- `sort`: `\"price\"`, `\"throughput\"`, or `\"latency\"`, or an object with `by` and `partition`, applied when `order` is not set. Setting it disables load balancing.\n- `maxPrice`: the highest pricing you accept. It takes `prompt` and `completion` in USD per million tokens, plus `request` (per-request pricing) and `image` (per image) where a provider offers them. Providers above the limit are skipped.\n- `quantizations`: restrict to providers serving the model at given quantization levels (e.g. `\"fp8\"`, `\"int4\"`).\n- `dataCollection`: `\"deny\"` to use only providers that do not collect user data.\n- `zdr`: `true` to restrict routing to zero-data-retention endpoints.\n\n### Model variants\n\n`variant` appends OpenRouter's `:variant` suffix to the model id. It is adapter metadata only and is never sent in the request body:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"deepseek/deepseek-v4-pro\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    variant: \"free\", // requests deepseek/deepseek-v4-pro:free\n  },\n});\n```\n\nAccepted values are `\"free\"`, `\"nitro\"`, `\"online\"`, `\"exacto\"`, `\"extended\"`, and `\"thinking\"`. Which of them a model actually offers is up to OpenRouter's catalog.\n\n### Plugins\n\n`plugins` enables OpenRouter's request-level plugins. Each entry is identified by `id`, with plugin-specific options alongside:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-6-astra\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    plugins: [{ id: \"web\", maxResults: 5 }],\n  },\n});\n```\n\nPlugin ids include `web`, `file-parser`, `response-healing`, `moderation`, and `auto-router`; see the OpenRouter documentation for each plugin's options. Web fetching is not a plugin but a server tool (`openrouter:web_fetch`); for web search and fetch as _tools_ the model can call, see [Provider Tools](#provider-tools) below.\n\n### Reasoning\n\n`reasoning` is OpenRouter's unified reasoning configuration:\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterText(\"anthropic/claude-sonnet-5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  modelOptions: {\n    reasoning: { effort: \"high\" },\n  },\n});\n```\n\n`effort` accepts `\"none\"`, `\"minimal\"`, `\"low\"`, `\"medium\"`, `\"high\"`, `\"xhigh\"`, and `\"max\"`. To switch reasoning off for a request, pass `reasoning: { enabled: false }`; the adapter sends it as `effort: \"none\"` because the SDK's request schema drops `enabled`.\n\n### Session and metadata\n\n`user` (a unique user identifier), `sessionId`, and `metadata` (up to 16 key-value pairs) are forwarded unchanged. `sessionId` doubles as OpenRouter's sticky routing key: requests that share it are routed to the same provider to maximize prompt-cache hits, and grouped together for observability.\n\n## Model Options\n\nOpenRouter supports various provider-specific options. Sampling parameters live here too — `temperature`, `topP`, and `maxCompletionTokens` (OpenRouter's token-limit key for the chat adapter) — rather than as root-level props on `chat()`:\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openRouterText(\"anthropic/claude-sonnet-4.5\"),\n    messages,\n    modelOptions: {\n      temperature: 0.7,\n      topP: 0.9,\n      maxCompletionTokens: 1024,\n    },\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n> If you previously passed `temperature` / `topP` / `maxTokens` at the root of `chat()`, see [Moving Sampling Options into modelOptions](../migration/sampling-options-to-model-options).\n\n## Chat Completions vs Responses (beta)\n\nOpenRouter exposes two OpenAI-compatible wire formats, and the adapter\npackage ships one of each:\n\n| Adapter                   | Endpoint               | Status | When to use                                                                               |\n| ------------------------- | ---------------------- | ------ | ----------------------------------------------------------------------------------------- |\n| `openRouterText`          | `/v1/chat/completions` | Stable | Default for almost everything. Broadest model + tool support.                             |\n| `openRouterResponsesText` | `/v1/responses`        | Beta   | OpenAI Responses-shaped request/response; richer multi-turn state on OpenAI-style models. |\n\nBoth adapters route to any underlying model OpenRouter supports\n(`anthropic/...`, `google/...`, `meta-llama/...`, etc.) — the wire format\ndescribes how your client talks to OpenRouter, not which provider answers.\n`/v1/responses` is OpenAI's newer API surface; OpenRouter implements it so\nclients that prefer that wire format can use it across the same 300+\nmodel catalogue.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterResponsesText } from \"@tanstack/ai-openrouter\";\n\nconst stream = chat({\n  adapter: openRouterResponsesText(\"anthropic/claude-sonnet-4.5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n```\n\nCaveats while the Responses adapter is in beta:\n\n- Function tools are supported; OpenRouter's branded server-tools (web\n  search, file search, …) are not yet wired through this path — use\n  `openRouterText` if you need those.\n- If in doubt, prefer `openRouterText`. The Chat Completions endpoint has\n  broader provider coverage and feature parity today.\n\n## Cost Tracking\n\nOpenRouter reports the actual cost of each request inline on the streamed\nresponse. When present, the adapter forwards it on the terminal `RUN_FINISHED`\nevent under `usage.cost`, with OpenRouter's per-request breakdown under\n`usage.costDetails`. This is the cost OpenRouter itself reports for the\nrequest — it is **not** computed locally from token counts, so it already\naccounts for routing, fallback providers, BYOK, and cached-token pricing. See\nOpenRouter's [Usage Accounting](https://openrouter.ai/docs/use-cases/usage-accounting)\ndocs for the meaning and units of these fields.\n\n```typescript ignore\nimport { chat, type RunFinishedEvent, type StreamChunk } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\n\nfunction isRunFinished(chunk: StreamChunk): chunk is RunFinishedEvent {\n  return \"finishReason\" in chunk;\n}\n\nfor await (const chunk of chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n})) {\n  if (isRunFinished(chunk)) {\n    console.log(\"cost:\", chunk.usage?.cost);\n    console.log(\"breakdown:\", chunk.usage?.costDetails);\n  }\n}\n```\n\nThe same `usage` (including `cost` / `costDetails`) is passed to middleware via\nthe `onUsage` and `onFinish` hooks. When OpenRouter does not report a cost, the\nfields are simply absent and the stream completes normally. Both\n`openRouterText` and `openRouterResponsesText` populate cost when OpenRouter\nreturns it.\n\nThe `openRouterText` adapter's `structuredOutputStream()` method includes\nreceived usage on its terminal `RUN_ERROR` event. This covers parse failures,\ntruncated responses, empty responses, and SDK errors. When `chat()` uses this\npath, middleware `onChunk` receives the error event even if the promise rejects.\nThe `onUsage` hook reports successful calls. Each adapter call reports usage on\none terminal event.\n\nA reported `completionTokensDetails.reasoningTokens` value of `0` stays zero.\nA missing count stays absent. Errors before any usage arrives have no `usage`\nfield. If the consumer stops reading the stream, it cannot receive later events.\n\n## Reranking\n\nOpenRouter exposes rerank models through its unified `/v1/rerank` endpoint\n(served via the `@openrouter/sdk` SDK). Any rerank model OpenRouter offers works\nby passing its slug — for example `cohere/rerank-v3.5`, `cohere/rerank-4-fast`,\n`cohere/rerank-4-pro`, or `nvidia/llama-nemotron-rerank-vl-1b-v2`. Use\n`openRouterRerank` with the `rerank()` activity to reorder candidate documents\nby relevance to a query:\n\n```typescript\nimport { rerank } from \"@tanstack/ai\";\nimport { openRouterRerank } from \"@tanstack/ai-openrouter\";\n\nconst { rerankedDocuments } = await rerank({\n  adapter: openRouterRerank(\"cohere/rerank-v3.5\"),\n  query: \"talk about rain\",\n  documents: [\"sunny day at the beach\", \"rainy afternoon in the city\"],\n  topN: 2,\n});\n\nconsole.log(rerankedDocuments[0]); // 'rainy afternoon in the city'\n```\n\n`openRouterRerank` reads `OPENROUTER_API_KEY` from the environment; pass a key\nexplicitly with `createOpenRouterRerank(\"cohere/rerank-v3.5\", \"sk-or-...\")`. The\noptional `httpReferer` / `appTitle` config fields are forwarded as OpenRouter\nattribution headers, just like the chat adapter.\n\nSee the [Reranking guide](../rerank/rerank) for object documents, RAG\npipelines, options, and the result shape.\n\n## Evaluate\n\nOpenRouter exposes TypeSafe Jev through `POST /api/alpha/decisions`.\nUse `openRouterDecider` with `decide()` to ask typed questions about a\nshared `state`:\n\n```typescript\nimport { decide, choice, score, boolean } from \"@tanstack/ai\";\nimport { openRouterDecider } from \"@tanstack/ai-openrouter\";\n\nconst ticket = {\n  subject: \"Charged twice for the same invoice\",\n  body: \"Please refund the extra payment.\",\n};\n\nconst result = await decide({\n  adapter: openRouterDecider(\"~typesafe/jev-latest\"),\n  state: ticket,\n  questions: {\n    queue: choice({\n      instructions: \"Which team should handle this ticket?\",\n      options: {\n        billing: \"Payments, invoices, refunds\",\n        tech: \"Bugs, outages, integrations\",\n        sales: \"Pricing, upgrades, new accounts\",\n      },\n    }),\n    urgency: score({\n      instructions: \"How urgent is this ticket?\",\n      levels: [\"low\", \"medium\", \"high\"],\n    }),\n    refund: boolean({\n      instructions: \"Is the customer asking for a refund?\",\n    }),\n  },\n});\n\nconsole.log(result.queue.value);\nconsole.log(result.queue.probability);\nconsole.log(result.queue.confidence);\nconsole.log(result.meta.usage);\n```\n\nTo bill per request, read `result.meta.usage.cost`. To look the request up later with `GET /api/v1/generation?id=`, read `result.meta.id`. `result.meta.provider` names the upstream provider that served the request.\n\n`openRouterDecider` reads `OPENROUTER_API_KEY` from the environment. Pass a\nkey explicitly with `createOpenRouterDecider(\"~typesafe/jev-latest\", \"sk-or-...\")`.\n\nKnown slugs:\n\n- `~typesafe/jev-latest`\n- `typesafe/jev-1.13`\n- `typesafe/jev-1.13.0`\n\nSee the [Evaluate guide](../evaluate/evaluate) for question helpers, the result\nshape, abort, and middleware.\n\n## Image Generation\n\nFor a React + Start walkthrough with `useGenerateImage`, open [Generate Image](../tutorials/generate-image).\n\n`openRouterImage` routes image generation through OpenRouter's\nchat-completions surface (`modalities: ['image']`). Multimodal prompts are\nsupported — text and image parts are forwarded in order for\nimage-conditioned generation:\n\n```typescript\nimport { generateImage } from \"@tanstack/ai\";\nimport { openRouterImage } from \"@tanstack/ai-openrouter\";\n\nconst result = await generateImage({\n  adapter: openRouterImage(\"google/gemini-2.5-flash-image\"),\n  prompt: \"A watercolor lighthouse at dusk\",\n  size: \"1344x768\", // mapped to image_config.aspect_ratio ('16:9')\n  modelOptions: {\n    image_size: \"2K\", // resolution (Gemini models)\n    strength: 0.35, // image-to-image influence, i2i-capable models only\n  },\n});\n```\n\nNotes:\n\n- The pathway returns **exactly one image per request** — `numberOfImages > 1`\n  throws instead of silently under-delivering. Make multiple requests if you\n  need multiple candidates.\n- `size` must be one of the ten supported `WIDTHxHEIGHT` values (it is\n  converted to `image_config.aspect_ratio`); anything else throws with the\n  supported list.\n\n## Video Generation (Experimental)\n\n`openRouterVideo` targets OpenRouter's dedicated **async video API**\n(`POST /api/v1/videos`) — Seedance, Veo 3.1, Wan, Kling, and Sora 2 Pro\nthrough your one OpenRouter key. It follows the jobs/polling architecture\nshared by all TanStack AI video adapters:\n\n```typescript\n// Server: create the job, then poll\nimport { generateVideo, getVideoJobStatus } from \"@tanstack/ai\";\nimport { openRouterVideo } from \"@tanstack/ai-openrouter\";\nimport { withGenerationPersistence } from \"@tanstack/ai-persistence\";\nimport { persistence } from \"./persistence\";\n\nconst adapter = openRouterVideo(\"bytedance/seedance-2.0\");\n\n// OpenRouter returns the finished video as a stream, not a URL. Persistence\n// stores the stream and sets `url`. Pass the same options to both calls.\nconst hosting = {\n  threadId: \"videos\",\n  middleware: [\n    withGenerationPersistence(persistence, {\n      artifactUrl: (ref) => `/api/artifacts/${ref.artifactId}`,\n    }),\n  ],\n};\n\nconst { jobId } = await generateVideo({\n  adapter,\n  ...hosting,\n  prompt: [\n    { type: \"text\", content: \"Animate this product shot, slow push-in\" },\n    {\n      type: \"image\",\n      source: { type: \"url\", value: \"https://your-cdn.com/product.png\" },\n      metadata: { role: \"start_frame\" },\n    },\n  ],\n  size: \"1280x720\",\n  // `duration` is typed per model from the published metadata; coerce raw\n  // seconds with adapter.snapDuration() or enumerate via adapter.availableDurations().\n  duration: 8,\n});\n\nlet status = await getVideoJobStatus({ adapter, jobId, ...hosting });\nwhile (status.status !== \"completed\" && status.status !== \"failed\") {\n  await new Promise((r) => setTimeout(r, 5000));\n  status = await getVideoJobStatus({ adapter, jobId, ...hosting });\n}\n// status.url is your artifact route. status.usage?.cost is the real billed\n// cost that the gateway reports.\n```\n\n```tsx\n// Client: track the job with the useGenerateVideo hook\nimport { useGenerateVideo, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst { generate, result, videoStatus, isLoading } = useGenerateVideo({\n  connection: fetchServerSentEvents(\"/api/generate/video\"),\n});\n// result?.url renders directly: <video src={result.url} controls />\n```\n\nSizes, durations, and per-model options (`resolution`, `aspectRatio`,\n`generateAudio`, `seed`, …) are typed and validated per model from\nOpenRouter's video model metadata. See\n[Video Generation](../media/video-generation.md) for the full lifecycle,\nstreaming mode, and the image-to-video role-mapping table.\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Reranking](../rerank/rerank) - Reorder documents by relevance\n- [Evaluate](../evaluate/evaluate) - Ask typed questions about shared state\n\n## Provider Tools\n\n> **Migrated from `createWebSearchTool`?** This factory was renamed to\n> `webSearchTool` and moved to the `/tools` subpath in this release.\n> See [Migration Guide §6](../migration/migration.md#6-provider-tools-moved-to-tools-subpath)\n> for the exact before/after.\n\nOpenRouter's gateway exposes web search via a plugin that works across\nany proxied chat model. Import it from `@tanstack/ai-openrouter/tools`.\n\n> For the full concept, a comparison matrix, and type-gating details, see\n> [Provider Tools](../tools/provider-tools.md).\n\n### `webSearchTool`\n\nAdds web search capability to any OpenRouter-proxied chat model. The factory\naccepts OpenRouter's `WebSearchConfig` directly — pick the `engine`\n(`auto`, `native`, `exa`, `firecrawl`, or `parallel`), cap results with\n`maxResults` / `maxTotalResults`, restrict which sites can appear in results\nwith `allowedDomains` / `excludedDomains`, and optionally pass\n`searchContextSize` or `userLocation` for finer control.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { webSearchTool } from \"@tanstack/ai-openrouter/tools\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [{ role: \"user\", content: \"What's new in AI this week?\" }],\n  tools: [\n    webSearchTool({\n      engine: \"exa\",\n      maxResults: 5,\n      allowedDomains: [\"arxiv.org\", \"openai.com\"],\n    }),\n  ],\n});\n```\n\n**Supported models:** all OpenRouter chat models. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n### `webFetchTool`\n\nLets any OpenRouter-proxied chat model fetch the full contents of a URL the\nmodel chooses, instead of running a search. The factory accepts OpenRouter's\n`WebFetchServerToolConfig` directly — pick the fetch `engine` (`auto` — the\ndefault, `native`, `openrouter`, `exa`, or `firecrawl`), cap how much page\ncontent the model receives with `maxContentTokens`, cap how many fetches the\nmodel can make per request with `maxUses`, and restrict which URLs the model\ncan fetch with `allowedDomains` / `blockedDomains`.\n\n> The `native` engine routes to the underlying provider's own fetch (for\n> example, Anthropic's `web_fetch` on Claude models). Native fetch\n> capabilities vary, so `allowedDomains` and `blockedDomains` may be\n> ignored. Use `openrouter`, `exa`, or `firecrawl` if you need consistent\n> behaviour across models.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openRouterText } from \"@tanstack/ai-openrouter\";\nimport { webFetchTool } from \"@tanstack/ai-openrouter/tools\";\n\nconst stream = chat({\n  adapter: openRouterText(\"openai/gpt-5\"),\n  messages: [\n    { role: \"user\", content: \"Summarize https://example.com/article\" },\n  ],\n  tools: [\n    webFetchTool({\n      engine: \"openrouter\",\n      maxContentTokens: 4000,\n      allowedDomains: [\"example.com\"],\n    }),\n  ],\n});\n```\n\n**Supported models:** all OpenRouter chat models. See [Provider Tools](../tools/provider-tools.md#which-models-support-which-tools).\n\n## Sign in with OpenRouter (BYOK)\n\nOpenRouter can mint a user-owned API key via [OAuth PKCE](https://openrouter.ai/docs/guides/overview/auth/oauth). Import the helpers from `@tanstack/ai-openrouter/pkce`. The key is stored under `openrouterByok.id` (`openrouter`) and sent as `x-byok-openrouter`.\n\nClient: start login, then on return save the key into `defineByok`.\n\n```tsx\nimport { useEffect } from \"react\";\nimport { defineByok, defaultByokStorage } from \"@tanstack/ai-client/byok\";\nimport {\n  completeOpenRouterPkceIntoByok,\n  startOpenRouterPkceLogin,\n} from \"@tanstack/ai-openrouter/pkce\";\n\nconst byok = defineByok({\n  storage: defaultByokStorage(),\n});\n\nexport function OpenRouterSignIn() {\n  useEffect(() => {\n    void completeOpenRouterPkceIntoByok(byok);\n  }, []);\n\n  return (\n    <button\n      type=\"button\"\n      onClick={() => {\n        void startOpenRouterPkceLogin();\n      }}\n    >\n      Sign in with OpenRouter\n    </button>\n  );\n}\n```\n\nServer: read the same slug the PKCE helper wrote.\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { byokMissing, getByokKey } from \"@tanstack/ai/byok/server\";\nimport { createOpenRouterText } from \"@tanstack/ai-openrouter\";\nimport { openrouterByok } from \"@tanstack/ai-openrouter/byok\";\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request);\n  const apiKey = getByokKey(request, openrouterByok);\n  if (!apiKey) return byokMissing(openrouterByok);\n\n  const stream = chat({\n    adapter: createOpenRouterText(\"openai/gpt-5.5\", apiKey),\n    messages: params.messages,\n    threadId: params.threadId,\n    runId: params.runId,\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\nSee [Bring Your Own Key](../advanced/byok) for the keyring and passkey storage.\n"}
