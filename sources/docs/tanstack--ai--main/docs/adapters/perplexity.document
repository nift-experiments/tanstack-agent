{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-perplexity"},{"type":"text","value":" is a "},{"type":"strong","children":[{"type":"text","value":"Search API"}]},{"type":"text","value":" package. It wraps "},{"type":"inlineCode","value":"POST https://api.perplexity.ai/search"},{"type":"text","value":" as a TanStack AI tool (and a low-level HTTP client) so an agent can fetch ranked web results for citation and grounding."}]},{"type":"paragraph","children":[{"type":"text","value":"It does "},{"type":"strong","children":[{"type":"text","value":"not"}]},{"type":"text","value":" ship a TanStack text adapter. Pair the search tool with a function-calling adapter such as "},{"type":"inlineCode","value":"openaiText"},{"type":"text","value":" or "},{"type":"inlineCode","value":"anthropicText"},{"type":"text","value":". Sonar "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" still goes through "},{"type":"link","href":"./openai-compatible.md","children":[{"type":"inlineCode","value":"openaiCompatible"}]},{"type":"text","value":" — Sonar already searches the web and does not accept custom tools."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai\",\"@tanstack/ai-openai\",\"@tanstack/ai-perplexity\"]],\"vue\":[[\"@tanstack/ai\",\"@tanstack/ai-openai\",\"@tanstack/ai-perplexity\"]],\"solid\":[[\"@tanstack/ai\",\"@tanstack/ai-openai\",\"@tanstack/ai-perplexity\"]],\"svelte\":[[\"@tanstack/ai\",\"@tanstack/ai-openai\",\"@tanstack/ai-perplexity\"]],\"preact\":[[\"@tanstack/ai\",\"@tanstack/ai-openai\",\"@tanstack/ai-perplexity\"]],\"angular\":[[\"@tanstack/ai\",\"@tanstack/ai-openai\",\"@tanstack/ai-perplexity\"]],\"vanilla\":[[\"@tanstack/ai\",\"@