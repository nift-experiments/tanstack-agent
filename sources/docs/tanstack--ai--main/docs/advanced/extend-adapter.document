{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"extendAdapter"},{"type":"text","value":" utility allows you to extend existing adapter factories (like "},{"type":"inlineCode","value":"openaiText"},{"type":"text","value":", "},{"type":"inlineCode","value":"anthropicText"},{"type":"text","value":") with custom model names while maintaining full type safety for input modalities and provider options."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { createModel, extendAdapter } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Define your custom models using createModel helper\nconst myOpenaiModel = createModel('my-fine-tuned-gpt4',['text', 'image']);\nconst myOpenaiModelButCooler = createModel('my-fine-tuned-gpt5',['text', 'image']);\n \n\n// Create an extended adapter factory - simple API, no type parameters needed\nconst myOpenai = extendAdapter(openaiText, [\n  myOpenaiModel,\n  myOpenaiModelButCooler \n])\n\n// Use with original models - full type inference preserved\nconst gpt5Adapter = myOpenai('gpt-5.5')\n\n// Use with custom models - your custom types are applied\nconst customAdapter = myOpenai('my-fine-tuned-gpt4')\n\n// Works seamlessly with chat()\nimport { chat } from '@tanstack/ai'\n\nconst stream = chat({\n  adapter: myOpenai('my-fine-tuned-gpt4'),\n  messages: [{ role: 'user', content: 'Hello!' }]\n})","lang":"typescript"},{"type":"heading","depth":2,"id":"the-createmodel-helper","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"createModel"},{"type":"text","value":" Helper"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"createModel"},{"type":"text","value":" function provides a clean way to define custom models with full type inference:"}]},{"type":"code","value":"import { createModel } from '@tanstack/ai'\n\n// Arguments define name and input modalities\nconst model = createModel(\n  'my-model',      // model name (literal type inferred)\n  ['text', 'image'] // input modalities (tuple type inferred)\n)","lang":"typescript"},{"type":"heading","depth":2,"id":"model-definition-structure","children":[{"type":"text","value":"Model Definition Structure"}]},{"type":"paragraph","children":[{"type":"text","value":"A custom model definition ("},{"type":"inlineCode","value":"ExtendedModelDef"},{"type":"text","value":") has the required properties "},{"type":"inlineCode","value":"name"},{"type":"text","value":", "},{"type":"inlineCode","value":"input"},{"type":"text","value":", and "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":", plus optional "},{"type":"inlineCode","value":"features"},{"type":"text","value":" and "},{"type":"inlineCode","value":"tools"},{"type":"text","value":". The two "},{"type":"inlineCode","value":"createModel"},{"type":"text","value":" overloads let you fill these in two ways."}]},{"type":"heading","depth":3,"id":"defining-input-modalities","children":[{"type":"text","value":"Defining Input Modalities"}]},{"type":"paragraph","children":[{"type":"text","value":"The positional form takes a model name and an "},{"type":"inlineCode","value":"input"},{"type":"text","value":" array specifying which content types your model supports:"}]},{"type":"code","value":"import { createModel } from '@tanstack/ai'\n\nconst models = [\n  createModel('text-only-model', ['text']),\n  createModel('multimodal-model', ['text', 'image', 'audio']),\n] as const","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Available modalities: "},{"type":"inlineCode","value":"'text'"},{"type":"text","value":", "},{"type":"inlineCode","value":"'image'"},{"type":"text","value":", "},{"type":"inlineCode","value":"'audio'"},{"type":"text","value":", "},{"type":"inlineCode","value":"'video'"},{"type":"text","value":", "},{"type":"inlineCode","value":"'document'"}]},{"type":"heading","depth":3,"id":"capabilities-object-form","children":[{"type":"text","value":"Capabilities-object form"}]},{"type":"paragraph","children":[{"type":"text","value":"To attach typed "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":", declared "},{"type":"inlineCode","value":"features"},{"type":"text","value":", or provider "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" to a custom model, use the second "},{"type":"inlineCode","value":"createModel"},{"type":"text","value":" overload, which takes a capabilities object as its second argument:"}]},{"type":"code","value":"import { createModel } from '@tanstack/ai'\nimport type { OpenAITextProviderOptions } from '@tanstack/ai-openai'\n\n// Type brand for provider options — the value is unused at runtime.\nconst modelOptions: OpenAITextProviderOptions = {}\n\nconst reasoner = createModel('my-reasoner', {\n  input: ['text'],\n  features: ['reasoning', 'structured_outputs'],\n  tools: ['web_search'],\n  modelOptions,\n})","lang":"typescript"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"input"},{"type":"text","value":" — supported input modalities (same as the positional form)."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"features"},{"type":"text","value":" — declared feature flags (e.g. "},{"type":"inlineCode","value":"'reasoning'"},{"type":"text","value":", "},{"type":"inlineCode","value":"'structured_outputs'"},{"type":"text","value":")."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tools"},{"type":"text","value":" — declared provider tools (e.g. "},{"type":"inlineCode","value":"'web_search'"},{"type":"text","value":")."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" — a type brand for the provider options accepted by this model; the value is unused at runtime, so declare an empty object typed as the provider options (e.g. "},{"type":"inlineCode","value":"const modelOptions: OpenAITextProviderOptions = {}"},{"type":"text","value":")."}]}]}]},{"type":"heading","depth":2,"id":"preserving-original-factory-behavior","children":[{"type":"text","value":"Preserving Original Factory Behavior"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"extendAdapter"},{"type":"text","value":" fully preserves the original factory's signature, including any configuration parameters:"}]},{"type":"code","value":"import { createModel, extendAdapter } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst customModels = [createModel('my-fine-tuned-gpt4', ['text', 'image'])] as const\n\nconst myOpenai = extendAdapter(openaiText, customModels)\n\n// Config parameter is preserved\nconst adapter = myOpenai('my-fine-tuned-gpt4', {\n  baseURL: 'https://my-proxy.com/v1',\n  timeout: 30000\n})","lang":"typescript"},{"type":"heading","depth":2,"id":"type-safety","children":[{"type":"text","value":"Type Safety"}]},{"type":"paragraph","children":[{"type":"text","value":"The extended adapter provides full type safety:"}]},{"type":"code","value":"import { extendAdapter, createModel } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst myOpenai = extendAdapter(openaiText, [createModel('custom-model', ['text'])])\n\n// ✅ Original models work with their original types\nconst a1 = myOpenai('gpt-5.5')\n\n// ✅ Custom models work with your defined types\nconst a2 = myOpenai('custom-model')\n\n// ❌ Type error: invalid model name\n// Note: Type checking works when you assign the result to a variable\nconst invalid = myOpenai('nonexistent-model') // TypeScript error!","lang":"typescript","meta":"ignore"},{"type":"heading","depth":2,"id":"runtime-behavior","children":[{"type":"text","value":"Runtime Behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"At runtime, "},{"type":"inlineCode","value":"extendAdapter"},{"type":"text","value":" simply passes through to the original factory:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"No validation is performed on custom model names"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The original factory receives exactly what you pass"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This allows the original provider's API to handle the model name"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"This design is intentional - it allows you to:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use fine-tuned model names that the provider accepts but TypeScript doesn't know about"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Proxy requests to different backends that accept custom model identifiers"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add type safety without runtime overhead"}]}]}]},{"type":"heading","depth":2,"id":"example-openai-compatible-proxy","children":[{"type":"text","value":"Example: OpenAI-Compatible Proxy"}]},{"type":"paragraph","children":[{"type":"text","value":"A common use case is typing models for an OpenAI-compatible proxy:"}]},{"type":"code","value":"import { extendAdapter, createModel } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Models available through your proxy\nconst proxyModels = [\n  createModel(\n    'llama-3.1-70b',\n    ['text']\n  ),\n  createModel(\n    'mixtral-8x7b',\n    ['text']\n  ),\n] as const\n\nconst proxyAdapter = extendAdapter(openaiText, proxyModels)\n\n// Use with your proxy's base URL\nconst adapter = proxyAdapter('llama-3.1-70b', {\n  baseURL: 'https://my-llm-proxy.com/v1'\n})","lang":"typescript"},{"type":"heading","depth":2,"id":"example-fine-tuned-models","children":[{"type":"text","value":"Example: Fine-tuned Models"}]},{"type":"paragraph","children":[{"type":"text","value":"Adding type safety for your fine-tuned models:"}]},{"type":"code","value":"import { chat, createModel, extendAdapter } from '@tanstack/ai'\nimport { anthropicText } from '@tanstack/ai-anthropic'\n\nconst fineTunedModels = [\n  createModel(\n    'ft:claude-3-opus:my-org:custom-task:abc123',\n    ['text', 'image']\n  ),\n] as const\n\nconst myAnthropic = extendAdapter(anthropicText, fineTunedModels)\n\nchat({\n  adapter: myAnthropic('ft:claude-3-opus:my-org:custom-task:abc123'),\n  messages: [{ role: 'user', content: 'Analyze this...' }]\n})","lang":"typescript"}],"headings":[{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"the-createmodel-helper","text":"The createModel Helper","level":2},{"id":"model-definition-structure","text":"Model Definition Structure","level":2},{"id":"defining-input-modalities","text":"Defining Input Modalities","level":3},{"id":"capabilities-object-form","text":"Capabilities-object form","level":3},{"id":"preserving-original-factory-behavior","text":"Preserving Original Factory Behavior","level":2},{"id":"type-safety","text":"Type Safety","level":2},{"id":"runtime-behavior","text":"Runtime Behavior","level":2},{"id":"example-openai-compatible-proxy","text":"Example: OpenAI-Compatible Proxy","level":2},{"id":"example-fine-tuned-models","text":"Example: Fine-tuned Models","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe `extendAdapter` utility allows you to extend existing adapter factories (like `openaiText`, `anthropicText`) with custom model names while maintaining full type safety for input modalities and provider options.\n\n## Basic Usage\n\n```typescript\nimport { createModel, extendAdapter } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Define your custom models using createModel helper\nconst myOpenaiModel = createModel('my-fine-tuned-gpt4',['text', 'image']);\nconst myOpenaiModelButCooler = createModel('my-fine-tuned-gpt5',['text', 'image']);\n \n\n// Create an extended adapter factory - simple API, no type parameters needed\nconst myOpenai = extendAdapter(openaiText, [\n  myOpenaiModel,\n  myOpenaiModelButCooler \n])\n\n// Use with original models - full type inference preserved\nconst gpt5Adapter = myOpenai('gpt-5.5')\n\n// Use with custom models - your custom types are applied\nconst customAdapter = myOpenai('my-fine-tuned-gpt4')\n\n// Works seamlessly with chat()\nimport { chat } from '@tanstack/ai'\n\nconst stream = chat({\n  adapter: myOpenai('my-fine-tuned-gpt4'),\n  messages: [{ role: 'user', content: 'Hello!' }]\n})\n```\n\n## The `createModel` Helper\n\nThe `createModel` function provides a clean way to define custom models with full type inference:\n\n```typescript\nimport { createModel } from '@tanstack/ai'\n\n// Arguments define name and input modalities\nconst model = createModel(\n  'my-model',      // model name (literal type inferred)\n  ['text', 'image'] // input modalities (tuple type inferred)\n)\n```\n \n \n## Model Definition Structure\n\nA custom model definition (`ExtendedModelDef`) has the required properties `name`, `input`, and `modelOptions`, plus optional `features` and `tools`. The two `createModel` overloads let you fill these in two ways.\n\n### Defining Input Modalities\n\nThe positional form takes a model name and an `input` array specifying which content types your model supports:\n\n```typescript\nimport { createModel } from '@tanstack/ai'\n\nconst models = [\n  createModel('text-only-model', ['text']),\n  createModel('multimodal-model', ['text', 'image', 'audio']),\n] as const\n```\n\nAvailable modalities: `'text'`, `'image'`, `'audio'`, `'video'`, `'document'`\n\n### Capabilities-object form\n\nTo attach typed `modelOptions`, declared `features`, or provider `tools` to a custom model, use the second `createModel` overload, which takes a capabilities object as its second argument:\n\n```typescript\nimport { createModel } from '@tanstack/ai'\nimport type { OpenAITextProviderOptions } from '@tanstack/ai-openai'\n\n// Type brand for provider options — the value is unused at runtime.\nconst modelOptions: OpenAITextProviderOptions = {}\n\nconst reasoner = createModel('my-reasoner', {\n  input: ['text'],\n  features: ['reasoning', 'structured_outputs'],\n  tools: ['web_search'],\n  modelOptions,\n})\n```\n\n- `input` — supported input modalities (same as the positional form).\n- `features` — declared feature flags (e.g. `'reasoning'`, `'structured_outputs'`).\n- `tools` — declared provider tools (e.g. `'web_search'`).\n- `modelOptions` — a type brand for the provider options accepted by this model; the value is unused at runtime, so declare an empty object typed as the provider options (e.g. `const modelOptions: OpenAITextProviderOptions = {}`).\n \n## Preserving Original Factory Behavior\n\n`extendAdapter` fully preserves the original factory's signature, including any configuration parameters:\n\n```typescript\nimport { createModel, extendAdapter } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst customModels = [createModel('my-fine-tuned-gpt4', ['text', 'image'])] as const\n\nconst myOpenai = extendAdapter(openaiText, customModels)\n\n// Config parameter is preserved\nconst adapter = myOpenai('my-fine-tuned-gpt4', {\n  baseURL: 'https://my-proxy.com/v1',\n  timeout: 30000\n})\n```\n\n## Type Safety\n\nThe extended adapter provides full type safety:\n\n```typescript ignore\nimport { extendAdapter, createModel } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst myOpenai = extendAdapter(openaiText, [createModel('custom-model', ['text'])])\n\n// ✅ Original models work with their original types\nconst a1 = myOpenai('gpt-5.5')\n\n// ✅ Custom models work with your defined types\nconst a2 = myOpenai('custom-model')\n\n// ❌ Type error: invalid model name\n// Note: Type checking works when you assign the result to a variable\nconst invalid = myOpenai('nonexistent-model') // TypeScript error!\n```\n \n\n## Runtime Behavior\n\nAt runtime, `extendAdapter` simply passes through to the original factory:\n\n- No validation is performed on custom model names\n- The original factory receives exactly what you pass\n- This allows the original provider's API to handle the model name\n\nThis design is intentional - it allows you to:\n- Use fine-tuned model names that the provider accepts but TypeScript doesn't know about\n- Proxy requests to different backends that accept custom model identifiers\n- Add type safety without runtime overhead\n\n## Example: OpenAI-Compatible Proxy\n\nA common use case is typing models for an OpenAI-compatible proxy:\n\n```typescript\nimport { extendAdapter, createModel } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Models available through your proxy\nconst proxyModels = [\n  createModel(\n    'llama-3.1-70b',\n    ['text']\n  ),\n  createModel(\n    'mixtral-8x7b',\n    ['text']\n  ),\n] as const\n\nconst proxyAdapter = extendAdapter(openaiText, proxyModels)\n\n// Use with your proxy's base URL\nconst adapter = proxyAdapter('llama-3.1-70b', {\n  baseURL: 'https://my-llm-proxy.com/v1'\n})\n```\n\n## Example: Fine-tuned Models\n\nAdding type safety for your fine-tuned models:\n\n```typescript\nimport { chat, createModel, extendAdapter } from '@tanstack/ai'\nimport { anthropicText } from '@tanstack/ai-anthropic'\n\nconst fineTunedModels = [\n  createModel(\n    'ft:claude-3-opus:my-org:custom-task:abc123',\n    ['text', 'image']\n  ),\n] as const\n\nconst myAnthropic = extendAdapter(anthropicText, fineTunedModels)\n\nchat({\n  adapter: myAnthropic('ft:claude-3-opus:my-org:custom-task:abc123'),\n  messages: [{ role: 'user', content: 'Analyze this...' }]\n})\n```\n","originalRawMarkdown":"---\ntitle: Extend Adapter\nid: extend-adapter\norder: 8\ndescription: \"Extend TanStack AI adapter factories with custom model IDs and fine-tuned models while keeping full type safety for input modalities and provider options.\"\nkeywords:\n  - tanstack ai\n  - extendAdapter\n  - custom models\n  - fine-tuned models\n  - createModel\n  - type safety\n  - adapter factory\n---\n\nThe `extendAdapter` utility allows you to extend existing adapter factories (like `openaiText`, `anthropicText`) with custom model names while maintaining full type safety for input modalities and provider options.\n\n## Basic Usage\n\n```typescript\nimport { createModel, extendAdapter } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Define your custom models using createModel helper\nconst myOpenaiModel = createModel('my-fine-tuned-gpt4',['text', 'image']);\nconst myOpenaiModelButCooler = createModel('my-fine-tuned-gpt5',['text', 'image']);\n \n\n// Create an extended adapter factory - simple API, no type parameters needed\nconst myOpenai = extendAdapter(openaiText, [\n  myOpenaiModel,\n  myOpenaiModelButCooler \n])\n\n// Use with original models - full type inference preserved\nconst gpt5Adapter = myOpenai('gpt-5.5')\n\n// Use with custom models - your custom types are applied\nconst customAdapter = myOpenai('my-fine-tuned-gpt4')\n\n// Works seamlessly with chat()\nimport { chat } from '@tanstack/ai'\n\nconst stream = chat({\n  adapter: myOpenai('my-fine-tuned-gpt4'),\n  messages: [{ role: 'user', content: 'Hello!' }]\n})\n```\n\n## The `createModel` Helper\n\nThe `createModel` function provides a clean way to define custom models with full type inference:\n\n```typescript\nimport { createModel } from '@tanstack/ai'\n\n// Arguments define name and input modalities\nconst model = createModel(\n  'my-model',      // model name (literal type inferred)\n  ['text', 'image'] // input modalities (tuple type inferred)\n)\n```\n \n \n## Model Definition Structure\n\nA custom model definition (`ExtendedModelDef`) has the required properties `name`, `input`, and `modelOptions`, plus optional `features` and `tools`. The two `createModel` overloads let you fill these in two ways.\n\n### Defining Input Modalities\n\nThe positional form takes a model name and an `input` array specifying which content types your model supports:\n\n```typescript\nimport { createModel } from '@tanstack/ai'\n\nconst models = [\n  createModel('text-only-model', ['text']),\n  createModel('multimodal-model', ['text', 'image', 'audio']),\n] as const\n```\n\nAvailable modalities: `'text'`, `'image'`, `'audio'`, `'video'`, `'document'`\n\n### Capabilities-object form\n\nTo attach typed `modelOptions`, declared `features`, or provider `tools` to a custom model, use the second `createModel` overload, which takes a capabilities object as its second argument:\n\n```typescript\nimport { createModel } from '@tanstack/ai'\nimport type { OpenAITextProviderOptions } from '@tanstack/ai-openai'\n\n// Type brand for provider options — the value is unused at runtime.\nconst modelOptions: OpenAITextProviderOptions = {}\n\nconst reasoner = createModel('my-reasoner', {\n  input: ['text'],\n  features: ['reasoning', 'structured_outputs'],\n  tools: ['web_search'],\n  modelOptions,\n})\n```\n\n- `input` — supported input modalities (same as the positional form).\n- `features` — declared feature flags (e.g. `'reasoning'`, `'structured_outputs'`).\n- `tools` — declared provider tools (e.g. `'web_search'`).\n- `modelOptions` — a type brand for the provider options accepted by this model; the value is unused at runtime, so declare an empty object typed as the provider options (e.g. `const modelOptions: OpenAITextProviderOptions = {}`).\n \n## Preserving Original Factory Behavior\n\n`extendAdapter` fully preserves the original factory's signature, including any configuration parameters:\n\n```typescript\nimport { createModel, extendAdapter } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst customModels = [createModel('my-fine-tuned-gpt4', ['text', 'image'])] as const\n\nconst myOpenai = extendAdapter(openaiText, customModels)\n\n// Config parameter is preserved\nconst adapter = myOpenai('my-fine-tuned-gpt4', {\n  baseURL: 'https://my-proxy.com/v1',\n  timeout: 30000\n})\n```\n\n## Type Safety\n\nThe extended adapter provides full type safety:\n\n```typescript ignore\nimport { extendAdapter, createModel } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst myOpenai = extendAdapter(openaiText, [createModel('custom-model', ['text'])])\n\n// ✅ Original models work with their original types\nconst a1 = myOpenai('gpt-5.5')\n\n// ✅ Custom models work with your defined types\nconst a2 = myOpenai('custom-model')\n\n// ❌ Type error: invalid model name\n// Note: Type checking works when you assign the result to a variable\nconst invalid = myOpenai('nonexistent-model') // TypeScript error!\n```\n \n\n## Runtime Behavior\n\nAt runtime, `extendAdapter` simply passes through to the original factory:\n\n- No validation is performed on custom model names\n- The original factory receives exactly what you pass\n- This allows the original provider's API to handle the model name\n\nThis design is intentional - it allows you to:\n- Use fine-tuned model names that the provider accepts but TypeScript doesn't know about\n- Proxy requests to different backends that accept custom model identifiers\n- Add type safety without runtime overhead\n\n## Example: OpenAI-Compatible Proxy\n\nA common use case is typing models for an OpenAI-compatible proxy:\n\n```typescript\nimport { extendAdapter, createModel } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Models available through your proxy\nconst proxyModels = [\n  createModel(\n    'llama-3.1-70b',\n    ['text']\n  ),\n  createModel(\n    'mixtral-8x7b',\n    ['text']\n  ),\n] as const\n\nconst proxyAdapter = extendAdapter(openaiText, proxyModels)\n\n// Use with your proxy's base URL\nconst adapter = proxyAdapter('llama-3.1-70b', {\n  baseURL: 'https://my-llm-proxy.com/v1'\n})\n```\n\n## Example: Fine-tuned Models\n\nAdding type safety for your fine-tuned models:\n\n```typescript\nimport { chat, createModel, extendAdapter } from '@tanstack/ai'\nimport { anthropicText } from '@tanstack/ai-anthropic'\n\nconst fineTunedModels = [\n  createModel(\n    'ft:claude-3-opus:my-org:custom-task:abc123',\n    ['text', 'image']\n  ),\n] as const\n\nconst myAnthropic = extendAdapter(anthropicText, fineTunedModels)\n\nchat({\n  adapter: myAnthropic('ft:claude-3-opus:my-org:custom-task:abc123'),\n  messages: [{ role: 'user', content: 'Analyze this...' }]\n})\n```\n"}
