---
title: Multimodal Content
id: multimodal-content
order: 4
description: "Send images, audio, video, and documents alongside text in TanStack AI messages with typed ContentPart primitives for multimodal models."
keywords:
  - tanstack ai
  - multimodal
  - vision
  - images
  - audio
  - video
  - documents
  - ContentPart
  - ImagePart
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack AI supports multimodal content in messages, allowing you to send images, audio, video, and documents alongside text to AI models that support these modalities."}]},{"type":"paragraph","children":[{"type":"text","value":"When sending messages to AI models, you can include different types of content:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Text"}]},{"type":"text","value":" - Plain text messages"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Images"}]},{"type":"text","value":" - JPEG, PNG, GIF, WebP images"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Audio"}]},{"type":"text","value":" - Audio files (model-dependent support)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Video"}]},{"type":"text","value":" - Video files (model-dependent support)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Documents"}]},{"type":"text","value":" - PDFs and other document types"}]}]}]},{"type":"heading","depth":2,"id":"content-parts","children":[{"type":"text","value":"Content Parts"}]},{"type":"paragraph","children":[{"type":"text","value":"Multimodal messages use the "},{"type":"inlineCode","value":"ContentPart"},{"type":"text","value":" type to represent different content types:"}]},{"type":"code","value":"import type { ContentPart, ImagePart, TextPart } from '@tanstack/ai'\n\n// Text content\nconst textPart: TextPart = {\n  type: 'text',\n  content: 'What do you see in this image?'\n}\n\n// Image from base64 data (mimeType is required for data sources)\nconst imagePart: ImagePart = {\n  type: 'image',\n  source: {\n    type: 'data',\n    value: 'base64EncodedImageData...',\n    mimeType: 'image/jpeg' // Required for data sources\n  },\n  metadata: {\n    // Provider-specific metadata\n    detail: 'high' // OpenAI detail level\n  }\n}\n\n// Image from URL (mimeType is optional for URL sources)\nconst imageUrlPart: ImagePart = {\n  type: 'image',\n  source: {\n    type: 'url',\n    value: 'https://example.com/image.jpg',\n    mimeType: 'image/jpeg' // Optional hint for URL sources\n  }\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"using-multimodal-content-in-messages","children":[{"type":"text","value":"Using Multimodal Content in Messages"}]},{"type":"paragraph","children":[{"type":"text","value":"Messages can have "},{"type":"inlineCode","value":"content"},{"type":"text","value":" as either a string or an array of "},{"type":"inlineCode","value":"ContentPart"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst response = await chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', content: 'What is in this image?' },\n        {\n          type: 'image',\n          source: {\n            type: 'url',\n            value: 'https://example.com/photo.jpg'\n          }\n        }\n      ]\n    }\n  ]\n})","lang":"typescript"},{"type":"heading","depth":2,"id":"provider-support","children":[{"type":"text","value":"Provider Support"}]},{"type":"heading","depth":3,"id":"openai","children":[{"type":"text","value":"OpenAI"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenAI supports images, audio, and PDF documents in their vision, audio, and\ndocument-capable models:"}]},{"type":"code","value":"import { openaiText } from '@tanstack/ai-openai'\nimport { imageBase64, pdfBase64 } from './data'\n\nconst adapter = openaiText('gpt-5.5')\n\n// Image with detail level metadata\nconst message = {\n  role: 'user' ,\n  content: [\n    { type: 'text' , content: 'Describe this image' },\n    {\n      type: 'image' ,\n      source: { type: 'data' , value: imageBase64, mimeType: 'image/jpeg' },\n      metadata: { detail: 'high' } // 'auto' | 'low' | 'high'\n    }\n  ]\n}","lang":"typescript"},{"type":"code","value":"import { pdfBase64 } from './data'\n\n// PDF document via base64 data (the API requires a filename alongside\n// inline data; defaults to \"document.pdf\" when omitted)\nconst documentMessage = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Summarize this document' },\n    {\n      type: 'document',\n      source: { type: 'data', value: pdfBase64, mimeType: 'application/pdf' },\n      metadata: { filename: 'report.pdf' }\n    }\n  ]\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported modalities by model:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"gpt-5.5"},{"type":"text","value":", "},{"type":"inlineCode","value":"gpt-5.2"},{"type":"text","value":", "},{"type":"inlineCode","value":"gpt-5-mini"},{"type":"text","value":" (among others): text, image, PDF document"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"gpt-4o-audio"},{"type":"text","value":": text, audio"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Check each model's "},{"type":"inlineCode","value":"supports.input"},{"type":"text","value":" in "},{"type":"inlineCode","value":"@tanstack/ai-openai"},{"type":"text","value":"'s "},{"type":"inlineCode","value":"model-meta.ts"},{"type":"text","value":" for the authoritative per-model list."}]},{"type":"heading","depth":3,"id":"anthropic","children":[{"type":"text","value":"Anthropic"}]},{"type":"paragraph","children":[{"type":"text","value":"Anthropic's Claude models support images and PDF documents:"}]},{"type":"code","value":"import { anthropicText } from '@tanstack/ai-anthropic'\nimport { imageBase64, pdfBase64 } from './data'\n\nconst adapter = anthropicText('claude-sonnet-4-6')\n\n// Image with mimeType in source\nconst imageMessage = {\n  role: 'user' ,\n  content: [\n    { type: 'text' , content: 'What do you see?' },\n    {\n      type: 'image' ,\n      source: { type: 'data' , value: imageBase64, mimeType: 'image/jpeg' }\n    }\n  ]\n}\n\n// PDF document\nconst docMessage = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Summarize this document' },\n    {\n      type: 'document',\n      source: { type: 'data', value: pdfBase64, mimeType: 'application/pdf' }\n    }\n  ]\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported modalities:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"All Claude models (e.g. "},{"type":"inlineCode","value":"claude-haiku-4-5"},{"type":"text","value":", "},{"type":"inlineCode","value":"claude-sonnet-5"},{"type":"text","value":", "},{"type":"inlineCode","value":"claude-opus-4-8"},{"type":"text","value":", "},{"type":"inlineCode","value":"claude-fable-5"},{"type":"text","value":"): text, image, and document (PDF)"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Check each model's "},{"type":"inlineCode","value":"supports.input"},{"type":"text","value":" in "},{"type":"inlineCode","value":"@tanstack/ai-anthropic"},{"type":"text","value":"'s "},{"type":"inlineCode","value":"model-meta.ts"},{"type":"text","value":" for the authoritative per-model list."}]},{"type":"heading","depth":3,"id":"gemini","children":[{"type":"text","value":"Gemini"}]},{"type":"paragraph","children":[{"type":"text","value":"Google's Gemini models support a wide range of modalities:"}]},{"type":"code","value":"import { geminiText } from '@tanstack/ai-gemini'\nimport { imageBase64 } from './data'\n\nconst adapter = geminiText('gemini-3-flash-preview')\n\n// Image with mimeType in source\nconst message = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Analyze this image' },\n    {\n      type: 'image',\n      source: { type: 'data', value: imageBase64, mimeType: 'image/png' }\n    }\n  ]\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supported modalities:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"gemini-2.5-flash"},{"type":"text","value":": text, image, audio, video"}]}]}]},{"type":"heading","depth":3,"id":"ollama","children":[{"type":"text","value":"Ollama"}]},{"type":"paragraph","children":[{"type":"text","value":"Ollama supports images in compatible models:"}]},{"type":"code","value":"import { ollamaText } from '@tanstack/ai-ollama'\nimport { imageBase64 } from './data'\n\n// `ollamaText(model)` takes a model name. The host is read from the\n// `OLLAMA_HOST` environment variable (defaults to http://localhost:11434).\nconst adapter = ollamaText('llama3.2-vision')\n\n// Image as base64\nconst message = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'What is in this image?' },\n    {\n      type: 'image',\n      source: { type: 'data', value: imageBase64, mimeType: 'image/jpeg' }\n    }\n  ]\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Ollama support varies by model. Check the specific model documentation for multimodal capabilities."}]},{"type":"heading","depth":2,"id":"source-types","children":[{"type":"text","value":"Source Types"}]},{"type":"paragraph","children":[{"type":"text","value":"Content can be provided as either inline data or a URL:"}]},{"type":"heading","depth":3,"id":"data-base64","children":[{"type":"text","value":"Data (Base64)"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"type: 'data'"},{"type":"text","value":" for inline base64-encoded content. "},{"type":"strong","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"mimeType"},{"type":"text","value":" field is required"}]},{"type":"text","value":" to ensure providers receive proper content type information:"}]},{"type":"code","value":"const imagePart = {\n  type: 'image',\n  source: {\n    type: 'data',\n    value: 'iVBORw0KGgoAAAANSUhEUgAAAAUA...', // Base64 string\n    mimeType: 'image/png' // Required for data sources\n  }\n}\n\nconst audioPart = {\n  type: 'audio',\n  source: {\n    type: 'data',\n    value: 'base64AudioData...',\n    mimeType: 'audio/mp3' // Required for data sources\n  }\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"url","children":[{"type":"text","value":"URL"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"type: 'url'"},{"type":"text","value":" for content hosted at a URL. The "},{"type":"inlineCode","value":"mimeType"},{"type":"text","value":" field is "},{"type":"strong","children":[{"type":"text","value":"optional"}]},{"type":"text","value":" as providers can often infer it from the URL or response headers:"}]},{"type":"code","value":"const imagePart = {\n  type: 'image' ,\n  source: {\n    type: 'url' ,\n    value: 'https://example.com/image.jpg',\n    mimeType: 'image/jpeg' // Optional hint\n  }\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Not all providers support URL-based content for all modalities. Check provider documentation for specifics."}]},{"type":"heading","depth":3,"id":"file-handle-files-api","children":[{"type":"text","value":"File Handle (Files API)"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"type: 'file'"},{"type":"text","value":" to reference media you uploaded once via a provider's "},{"type":"link","href":"./files-api.md","children":[{"type":"text","value":"Files API"}]},{"type":"text","value":" — the provider stores the bytes and you pass a lightweight reference instead of re-sending base64 or a public URL every request. The source carries the opaque handle and the provider that issued it ("},{"type":"inlineCode","value":"{ type: 'file', value: 'file-…', provider: 'openai' }"},{"type":"text","value":"). An adapter throws if a different provider issued the handle, and adapters without Files API support reject the source before any request is built."}]},{"type":"code","value":"import { openaiFiles, openaiText } from '@tanstack/ai-openai'\nimport { chat, fileSourceFromHandle, uploadFile } from '@tanstack/ai'\nimport { pdfBase64 } from './pdf-data'\n\n// Upload once...\nconst handle = await uploadFile({\n  adapter: openaiFiles(),\n  input: { data: pdfBase64, mimeType: 'application/pdf' },\n})\n\n// ...then reference the handle by id in as many requests as you like.\nfor await (const chunk of chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', content: 'Summarize this document' },\n        { type: 'document', source: fileSourceFromHandle(handle) },\n      ],\n    },\n  ],\n})) {\n  // ...\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"fileSourceFromHandle(handle)"},{"type":"text","value":" builds the "},{"type":"inlineCode","value":"{ type: 'file', value, provider }"},{"type":"text","value":" source for you. It picks the handle URL for Gemini, fal, and Grok, or the opaque id for OpenAI and Anthropic. Each adapter maps "},{"type":"inlineCode","value":"value"},{"type":"text","value":" to the provider's native field ("},{"type":"inlineCode","value":"file_id"},{"type":"text","value":", "},{"type":"inlineCode","value":"fileData.fileUri"},{"type":"text","value":", or a URL). Sending the source to a different provider, or to an endpoint that requires raw bytes (image edits, Veo), throws a clear error. See "},{"type":"link","href":"./files-api.md","children":[{"type":"text","value":"Files API"}]},{"type":"text","value":" for uploading, retrieving, and deleting handles."}]},{"type":"heading","depth":2,"id":"backward-compatibility","children":[{"type":"text","value":"Backward Compatibility"}]},{"type":"paragraph","children":[{"type":"text","value":"String content continues to work as before:"}]},{"type":"code","value":"// This still works\nconst message = {\n  role: 'user',\n  content: 'Hello, world!'\n}\n\n// And this works for multimodal\nconst multimodalMessage = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Hello, world!' },\n    { type: 'image', source: { type: 'url', value: '...' } }\n  ]\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"type-safety","children":[{"type":"text","value":"Type Safety"}]},{"type":"paragraph","children":[{"type":"text","value":"The multimodal types are fully typed. Provider-specific metadata types are available:"}]},{"type":"code","value":"import type { \n  ContentPart,\n  ImagePart,\n  DocumentPart,\n  AudioPart,\n  VideoPart,\n  TextPart \n} from '@tanstack/ai'\n\n// Provider-specific metadata types\nimport type { OpenAIImageMetadata } from '@tanstack/ai-openai'\nimport type { AnthropicImageMetadata } from '@tanstack/ai-anthropic'\nimport type { GeminiImageMetadata } from '@tanstack/ai-gemini'","lang":"typescript"},{"type":"heading","depth":3,"id":"validating-dynamic-messages","children":[{"type":"text","value":"Validating Dynamic Messages"}]},{"type":"paragraph","children":[{"type":"text","value":"When receiving messages from external sources (like "},{"type":"inlineCode","value":"request.json()"},{"type":"text","value":"), the data is typed as "},{"type":"inlineCode","value":"any"},{"type":"text","value":". TanStack AI does not ship a runtime message validator — define a schema with your preferred Standard-Schema library (Zod, Valibot, ArkType, …) and parse the body before handing it to "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":"."}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\n\nconst ContentPartSchema = z.discriminatedUnion('type', [\n  z.object({ type: z.literal('text'), content: z.string() }),\n  z.object({\n    type: z.literal('image'),\n    source: z.object({ type: z.enum(['url', 'data']), value: z.string() }),\n  }),\n])\n\nconst MessageSchema = z.object({\n  // `ModelMessage.role` is 'user' | 'assistant' | 'tool' — there is no\n  // 'system' role. System instructions are passed separately via the\n  // `systemPrompts` option on `chat()`, not as messages.\n  role: z.enum(['user', 'assistant', 'tool']),\n  content: z.union([z.string(), z.array(ContentPartSchema)]),\n})\n\nconst BodySchema = z.object({ messages: z.array(MessageSchema) })\n\n// In an API route handler\nconst { messages } = BodySchema.parse(await request.json())\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages,\n})","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"text","value":"The TypeScript types on "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" still constrain anything you append at the call site to the modalities supported by the selected model."}]},{"type":"heading","depth":2,"id":"best-practices","children":[{"type":"text","value":"Best Practices"}]},{"type":"list","ordered":true,"start":1,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Use appropriate source type"}]},{"type":"text","value":": Use "},{"type":"inlineCode","value":"data"},{"type":"text","value":" for small content or when you need to include content inline. Use "},{"type":"inlineCode","value":"url"},{"type":"text","value":" for large files or when the content is already hosted."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Include metadata"}]},{"type":"text","value":": Provide relevant metadata (like "},{"type":"inlineCode","value":"mimeType"},{"type":"text","value":" or "},{"type":"inlineCode","value":"detail"},{"type":"text","value":") to help the model process the content correctly."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Check model support"}]},{"type":"text","value":": Not all models support all modalities. Verify the model you're using supports the content types you want to send."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Handle errors gracefully"}]},{"type":"text","value":": When a model doesn't support a particular modality, it may throw an error. Handle these cases in your application."}]}]}]},{"type":"heading","depth":2,"id":"client-side-multimodal-messages","children":[{"type":"text","value":"Client-Side Multimodal Messages"}]},{"type":"paragraph","children":[{"type":"text","value":"When using the "},{"type":"inlineCode","value":"ChatClient"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":", you can send multimodal messages directly from your UI using the "},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":" method."}]},{"type":"heading","depth":3,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":" method accepts either a simple string or a "},{"type":"inlineCode","value":"MultimodalContent"},{"type":"text","value":" object:"}]},{"type":"code","value":"import { ChatClient, fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst client = new ChatClient({\n  connection: fetchServerSentEvents('/api/chat'),\n})\n\n// Simple text message\nawait client.sendMessage('Hello!')\n\n// Multimodal message with image\nawait client.sendMessage({\n  content: [\n    { type: 'text', content: 'What is in this image?' },\n    {\n      type: 'image',\n      source: { type: 'url', value: 'https://example.com/photo.jpg' }\n    }\n  ]\n})","lang":"typescript"},{"type":"heading","depth":3,"id":"custom-message-id","children":[{"type":"text","value":"Custom Message ID"}]},{"type":"paragraph","children":[{"type":"text","value":"You can provide a custom ID for the message:"}]},{"type":"code","value":"import { ChatClient, fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst client = new ChatClient({\n  connection: fetchServerSentEvents('/api/chat'),\n})\n\nawait client.sendMessage({\n  content: 'Hello!',\n  id: 'custom-message-id-123'\n})","lang":"typescript"},{"type":"heading","depth":3,"id":"per-message-forwarded-props","children":[{"type":"text","value":"Per-Message Forwarded Props"}]},{"type":"paragraph","children":[{"type":"text","value":"The second parameter allows you to pass additional "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" for that specific request. These are shallow-merged with the client's base "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" configuration, with per-message values taking priority:"}]},{"type":"code","value":"import { ChatClient, fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst client = new ChatClient({\n  connection: fetchServerSentEvents('/api/chat'),\n  forwardedProps: { model: 'gpt-5' }, // Base forwarded props\n})\n\n// Override model for this specific message\nawait client.sendMessage('Analyze this complex problem', {\n  model: 'gpt-5',\n  temperature: 0.2,\n})","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" The legacy "},{"type":"inlineCode","value":"body"},{"type":"text","value":" constructor option is still supported but deprecated. New code should use "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":". Both populate the same wire field."}]}]},{"type":"heading","depth":3,"id":"react-example","children":[{"type":"text","value":"React Example"}]},{"type":"paragraph","children":[{"type":"text","value":"Here's how to use multimodal messages in a React component:"}]},{"type":"code","value":"import { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { useState } from 'react'\n\nfunction ChatWithImages() {\n  const [imageUrl, setImageUrl] = useState('')\n  const { sendMessage, messages } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleSendWithImage = () => {\n    if (imageUrl) {\n      sendMessage({\n        content: [\n          { type: 'text', content: 'What do you see in this image?' },\n          { type: 'image', source: { type: 'url', value: imageUrl } }\n        ]\n      })\n    }\n  }\n\n  return (\n    <div>\n      <input\n        type=\"url\"\n        placeholder=\"Image URL\"\n        value={imageUrl}\n        onChange={(e) => setImageUrl(e.target.value)}\n      />\n      <button onClick={handleSendWithImage}>Send with Image</button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"file-upload-example","children":[{"type":"text","value":"File Upload Example"}]},{"type":"paragraph","children":[{"type":"text","value":"Here's how to handle file uploads and send them as multimodal content:"}]},{"type":"code","value":"import { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nfunction ChatWithFileUpload() {\n  const { sendMessage } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleFileUpload = async (file: File) => {\n    // Convert file to base64\n    const base64 = await new Promise<string>((resolve) => {\n      const reader = new FileReader()\n      reader.onload = () => {\n        const result = reader.result as string\n        // Remove data URL prefix (e.g., \"data:image/png;base64,\")\n        resolve(result.split(',')[1]!)\n      }\n      reader.readAsDataURL(file)\n    })\n\n    // Determine content type based on file type\n    const type = file.type.startsWith('image/')\n      ? 'image'\n      : file.type.startsWith('audio/')\n        ? 'audio'\n        : file.type.startsWith('video/')\n          ? 'video'\n          : 'document'\n\n    await sendMessage({\n      content: [\n        { type: 'text', content: `Please analyze this ${type}` },\n        {\n          type,\n          source: { type: 'data', value: base64, mimeType: file.type }\n        }\n      ]\n    })\n  }\n\n  return (\n    <input\n      type=\"file\"\n      accept=\"image/*,audio/*,video/*,.pdf\"\n      onChange={(e) => {\n        const file = e.target.files?.[0]\n        if (file) handleFileUpload(file)\n      }}\n    />\n  )\n}","lang":"tsx"}],"headings":[{"id":"content-parts","text":"Content Parts","level":2},{"id":"using-multimodal-content-in-messages","text":"Using Multimodal Content in Messages","level":2},{"id":"provider-support","text":"Provider Support","level":2},{"id":"openai","text":"OpenAI","level":3},{"id":"anthropic","text":"Anthropic","level":3},{"id":"gemini","text":"Gemini","level":3},{"id":"ollama","text":"Ollama","level":3},{"id":"source-types","text":"Source Types","level":2},{"id":"data-base64","text":"Data (Base64)","level":3},{"id":"url","text":"URL","level":3},{"id":"file-handle-files-api","text":"File Handle (Files API)","level":3},{"id":"backward-compatibility","text":"Backward Compatibility","level":2},{"id":"type-safety","text":"Type Safety","level":2},{"id":"validating-dynamic-messages","text":"Validating Dynamic Messages","level":3},{"id":"best-practices","text":"Best Practices","level":2},{"id":"client-side-multimodal-messages","text":"Client-Side Multimodal Messages","level":2},{"id":"basic-usage","text":"Basic Usage","level":3},{"id":"custom-message-id","text":"Custom Message ID","level":3},{"id":"per-message-forwarded-props","text":"Per-Message Forwarded Props","level":3},{"id":"react-example","text":"React Example","level":3},{"id":"file-upload-example","text":"File Upload Example","level":3}]},"frameworks":[],"downloadMarkdown":"\nTanStack AI supports multimodal content in messages, allowing you to send images, audio, video, and documents alongside text to AI models that support these modalities.\n\nWhen sending messages to AI models, you can include different types of content:\n- **Text** - Plain text messages\n- **Images** - JPEG, PNG, GIF, WebP images\n- **Audio** - Audio files (model-dependent support)\n- **Video** - Video files (model-dependent support)\n- **Documents** - PDFs and other document types\n\n## Content Parts\n\nMultimodal messages use the `ContentPart` type to represent different content types:\n\n```typescript\nimport type { ContentPart, ImagePart, TextPart } from '@tanstack/ai'\n\n// Text content\nconst textPart: TextPart = {\n  type: 'text',\n  content: 'What do you see in this image?'\n}\n\n// Image from base64 data (mimeType is required for data sources)\nconst imagePart: ImagePart = {\n  type: 'image',\n  source: {\n    type: 'data',\n    value: 'base64EncodedImageData...',\n    mimeType: 'image/jpeg' // Required for data sources\n  },\n  metadata: {\n    // Provider-specific metadata\n    detail: 'high' // OpenAI detail level\n  }\n}\n\n// Image from URL (mimeType is optional for URL sources)\nconst imageUrlPart: ImagePart = {\n  type: 'image',\n  source: {\n    type: 'url',\n    value: 'https://example.com/image.jpg',\n    mimeType: 'image/jpeg' // Optional hint for URL sources\n  }\n}\n```\n\n## Using Multimodal Content in Messages\n\nMessages can have `content` as either a string or an array of `ContentPart`:\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst response = await chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', content: 'What is in this image?' },\n        {\n          type: 'image',\n          source: {\n            type: 'url',\n            value: 'https://example.com/photo.jpg'\n          }\n        }\n      ]\n    }\n  ]\n})\n```\n\n## Provider Support\n\n### OpenAI\n\nOpenAI supports images, audio, and PDF documents in their vision, audio, and\ndocument-capable models:\n\n```typescript\nimport { openaiText } from '@tanstack/ai-openai'\nimport { imageBase64, pdfBase64 } from './data'\n\nconst adapter = openaiText('gpt-5.5')\n\n// Image with detail level metadata\nconst message = {\n  role: 'user' ,\n  content: [\n    { type: 'text' , content: 'Describe this image' },\n    {\n      type: 'image' ,\n      source: { type: 'data' , value: imageBase64, mimeType: 'image/jpeg' },\n      metadata: { detail: 'high' } // 'auto' | 'low' | 'high'\n    }\n  ]\n}\n```\n\n```typescript\nimport { pdfBase64 } from './data'\n\n// PDF document via base64 data (the API requires a filename alongside\n// inline data; defaults to \"document.pdf\" when omitted)\nconst documentMessage = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Summarize this document' },\n    {\n      type: 'document',\n      source: { type: 'data', value: pdfBase64, mimeType: 'application/pdf' },\n      metadata: { filename: 'report.pdf' }\n    }\n  ]\n}\n```\n\n**Supported modalities by model:**\n- `gpt-5.5`, `gpt-5.2`, `gpt-5-mini` (among others): text, image, PDF document\n- `gpt-4o-audio`: text, audio\n\nCheck each model's `supports.input` in `@tanstack/ai-openai`'s `model-meta.ts` for the authoritative per-model list.\n\n### Anthropic\n\nAnthropic's Claude models support images and PDF documents:\n\n```typescript\nimport { anthropicText } from '@tanstack/ai-anthropic'\nimport { imageBase64, pdfBase64 } from './data'\n\nconst adapter = anthropicText('claude-sonnet-4-6')\n\n// Image with mimeType in source\nconst imageMessage = {\n  role: 'user' ,\n  content: [\n    { type: 'text' , content: 'What do you see?' },\n    {\n      type: 'image' ,\n      source: { type: 'data' , value: imageBase64, mimeType: 'image/jpeg' }\n    }\n  ]\n}\n\n// PDF document\nconst docMessage = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Summarize this document' },\n    {\n      type: 'document',\n      source: { type: 'data', value: pdfBase64, mimeType: 'application/pdf' }\n    }\n  ]\n}\n```\n\n**Supported modalities:**\n- All Claude models (e.g. `claude-haiku-4-5`, `claude-sonnet-5`, `claude-opus-4-8`, `claude-fable-5`): text, image, and document (PDF)\n\nCheck each model's `supports.input` in `@tanstack/ai-anthropic`'s `model-meta.ts` for the authoritative per-model list.\n\n### Gemini\n\nGoogle's Gemini models support a wide range of modalities:\n\n```typescript\nimport { geminiText } from '@tanstack/ai-gemini'\nimport { imageBase64 } from './data'\n\nconst adapter = geminiText('gemini-3-flash-preview')\n\n// Image with mimeType in source\nconst message = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Analyze this image' },\n    {\n      type: 'image',\n      source: { type: 'data', value: imageBase64, mimeType: 'image/png' }\n    }\n  ]\n}\n```\n\n**Supported modalities:**\n- `gemini-2.5-flash`: text, image, audio, video\n\n### Ollama\n\nOllama supports images in compatible models:\n\n```typescript\nimport { ollamaText } from '@tanstack/ai-ollama'\nimport { imageBase64 } from './data'\n\n// `ollamaText(model)` takes a model name. The host is read from the\n// `OLLAMA_HOST` environment variable (defaults to http://localhost:11434).\nconst adapter = ollamaText('llama3.2-vision')\n\n// Image as base64\nconst message = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'What is in this image?' },\n    {\n      type: 'image',\n      source: { type: 'data', value: imageBase64, mimeType: 'image/jpeg' }\n    }\n  ]\n}\n```\n\n**Note:** Ollama support varies by model. Check the specific model documentation for multimodal capabilities.\n\n## Source Types\n\nContent can be provided as either inline data or a URL:\n\n### Data (Base64)\n\nUse `type: 'data'` for inline base64-encoded content. **The `mimeType` field is required** to ensure providers receive proper content type information:\n\n```typescript\nconst imagePart = {\n  type: 'image',\n  source: {\n    type: 'data',\n    value: 'iVBORw0KGgoAAAANSUhEUgAAAAUA...', // Base64 string\n    mimeType: 'image/png' // Required for data sources\n  }\n}\n\nconst audioPart = {\n  type: 'audio',\n  source: {\n    type: 'data',\n    value: 'base64AudioData...',\n    mimeType: 'audio/mp3' // Required for data sources\n  }\n}\n```\n\n### URL\n\nUse `type: 'url'` for content hosted at a URL. The `mimeType` field is **optional** as providers can often infer it from the URL or response headers:\n\n```typescript\nconst imagePart = {\n  type: 'image' ,\n  source: {\n    type: 'url' ,\n    value: 'https://example.com/image.jpg',\n    mimeType: 'image/jpeg' // Optional hint\n  }\n}\n```\n\n**Note:** Not all providers support URL-based content for all modalities. Check provider documentation for specifics.\n\n### File Handle (Files API)\n\nUse `type: 'file'` to reference media you uploaded once via a provider's [Files API](./files-api.md) — the provider stores the bytes and you pass a lightweight reference instead of re-sending base64 or a public URL every request. The source carries the opaque handle and the provider that issued it (`{ type: 'file', value: 'file-…', provider: 'openai' }`). An adapter throws if a different provider issued the handle, and adapters without Files API support reject the source before any request is built.\n\n```typescript\nimport { openaiFiles, openaiText } from '@tanstack/ai-openai'\nimport { chat, fileSourceFromHandle, uploadFile } from '@tanstack/ai'\nimport { pdfBase64 } from './pdf-data'\n\n// Upload once...\nconst handle = await uploadFile({\n  adapter: openaiFiles(),\n  input: { data: pdfBase64, mimeType: 'application/pdf' },\n})\n\n// ...then reference the handle by id in as many requests as you like.\nfor await (const chunk of chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', content: 'Summarize this document' },\n        { type: 'document', source: fileSourceFromHandle(handle) },\n      ],\n    },\n  ],\n})) {\n  // ...\n}\n```\n\n`fileSourceFromHandle(handle)` builds the `{ type: 'file', value, provider }` source for you. It picks the handle URL for Gemini, fal, and Grok, or the opaque id for OpenAI and Anthropic. Each adapter maps `value` to the provider's native field (`file_id`, `fileData.fileUri`, or a URL). Sending the source to a different provider, or to an endpoint that requires raw bytes (image edits, Veo), throws a clear error. See [Files API](./files-api.md) for uploading, retrieving, and deleting handles.\n\n## Backward Compatibility\n\nString content continues to work as before:\n\n```typescript\n// This still works\nconst message = {\n  role: 'user',\n  content: 'Hello, world!'\n}\n\n// And this works for multimodal\nconst multimodalMessage = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Hello, world!' },\n    { type: 'image', source: { type: 'url', value: '...' } }\n  ]\n}\n```\n\n## Type Safety\n\nThe multimodal types are fully typed. Provider-specific metadata types are available:\n\n```typescript\nimport type { \n  ContentPart,\n  ImagePart,\n  DocumentPart,\n  AudioPart,\n  VideoPart,\n  TextPart \n} from '@tanstack/ai'\n\n// Provider-specific metadata types\nimport type { OpenAIImageMetadata } from '@tanstack/ai-openai'\nimport type { AnthropicImageMetadata } from '@tanstack/ai-anthropic'\nimport type { GeminiImageMetadata } from '@tanstack/ai-gemini'\n```\n\n### Validating Dynamic Messages\n\nWhen receiving messages from external sources (like `request.json()`), the data is typed as `any`. TanStack AI does not ship a runtime message validator — define a schema with your preferred Standard-Schema library (Zod, Valibot, ArkType, …) and parse the body before handing it to `chat()`.\n\n```typescript ignore\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\n\nconst ContentPartSchema = z.discriminatedUnion('type', [\n  z.object({ type: z.literal('text'), content: z.string() }),\n  z.object({\n    type: z.literal('image'),\n    source: z.object({ type: z.enum(['url', 'data']), value: z.string() }),\n  }),\n])\n\nconst MessageSchema = z.object({\n  // `ModelMessage.role` is 'user' | 'assistant' | 'tool' — there is no\n  // 'system' role. System instructions are passed separately via the\n  // `systemPrompts` option on `chat()`, not as messages.\n  role: z.enum(['user', 'assistant', 'tool']),\n  content: z.union([z.string(), z.array(ContentPartSchema)]),\n})\n\nconst BodySchema = z.object({ messages: z.array(MessageSchema) })\n\n// In an API route handler\nconst { messages } = BodySchema.parse(await request.json())\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages,\n})\n```\n\nThe TypeScript types on `chat()` still constrain anything you append at the call site to the modalities supported by the selected model.\n\n## Best Practices\n\n1. **Use appropriate source type**: Use `data` for small content or when you need to include content inline. Use `url` for large files or when the content is already hosted.\n\n2. **Include metadata**: Provide relevant metadata (like `mimeType` or `detail`) to help the model process the content correctly.\n\n3. **Check model support**: Not all models support all modalities. Verify the model you're using supports the content types you want to send.\n\n4. **Handle errors gracefully**: When a model doesn't support a particular modality, it may throw an error. Handle these cases in your application.\n\n## Client-Side Multimodal Messages\n\nWhen using the `ChatClient` from `@tanstack/ai-client`, you can send multimodal messages directly from your UI using the `sendMessage` method.\n\n### Basic Usage\n\nThe `sendMessage` method accepts either a simple string or a `MultimodalContent` object:\n\n```typescript\nimport { ChatClient, fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst client = new ChatClient({\n  connection: fetchServerSentEvents('/api/chat'),\n})\n\n// Simple text message\nawait client.sendMessage('Hello!')\n\n// Multimodal message with image\nawait client.sendMessage({\n  content: [\n    { type: 'text', content: 'What is in this image?' },\n    {\n      type: 'image',\n      source: { type: 'url', value: 'https://example.com/photo.jpg' }\n    }\n  ]\n})\n```\n\n### Custom Message ID\n\nYou can provide a custom ID for the message:\n\n```typescript\nimport { ChatClient, fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst client = new ChatClient({\n  connection: fetchServerSentEvents('/api/chat'),\n})\n\nawait client.sendMessage({\n  content: 'Hello!',\n  id: 'custom-message-id-123'\n})\n```\n\n### Per-Message Forwarded Props\n\nThe second parameter allows you to pass additional `forwardedProps` for that specific request. These are shallow-merged with the client's base `forwardedProps` configuration, with per-message values taking priority:\n\n```typescript\nimport { ChatClient, fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst client = new ChatClient({\n  connection: fetchServerSentEvents('/api/chat'),\n  forwardedProps: { model: 'gpt-5' }, // Base forwarded props\n})\n\n// Override model for this specific message\nawait client.sendMessage('Analyze this complex problem', {\n  model: 'gpt-5',\n  temperature: 0.2,\n})\n```\n\n> **Note:** The legacy `body` constructor option is still supported but deprecated. New code should use `forwardedProps`. Both populate the same wire field.\n\n### React Example\n\nHere's how to use multimodal messages in a React component:\n\n```tsx\nimport { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { useState } from 'react'\n\nfunction ChatWithImages() {\n  const [imageUrl, setImageUrl] = useState('')\n  const { sendMessage, messages } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleSendWithImage = () => {\n    if (imageUrl) {\n      sendMessage({\n        content: [\n          { type: 'text', content: 'What do you see in this image?' },\n          { type: 'image', source: { type: 'url', value: imageUrl } }\n        ]\n      })\n    }\n  }\n\n  return (\n    <div>\n      <input\n        type=\"url\"\n        placeholder=\"Image URL\"\n        value={imageUrl}\n        onChange={(e) => setImageUrl(e.target.value)}\n      />\n      <button onClick={handleSendWithImage}>Send with Image</button>\n    </div>\n  )\n}\n```\n\n### File Upload Example\n\nHere's how to handle file uploads and send them as multimodal content:\n\n```tsx\nimport { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nfunction ChatWithFileUpload() {\n  const { sendMessage } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleFileUpload = async (file: File) => {\n    // Convert file to base64\n    const base64 = await new Promise<string>((resolve) => {\n      const reader = new FileReader()\n      reader.onload = () => {\n        const result = reader.result as string\n        // Remove data URL prefix (e.g., \"data:image/png;base64,\")\n        resolve(result.split(',')[1]!)\n      }\n      reader.readAsDataURL(file)\n    })\n\n    // Determine content type based on file type\n    const type = file.type.startsWith('image/')\n      ? 'image'\n      : file.type.startsWith('audio/')\n        ? 'audio'\n        : file.type.startsWith('video/')\n          ? 'video'\n          : 'document'\n\n    await sendMessage({\n      content: [\n        { type: 'text', content: `Please analyze this ${type}` },\n        {\n          type,\n          source: { type: 'data', value: base64, mimeType: file.type }\n        }\n      ]\n    })\n  }\n\n  return (\n    <input\n      type=\"file\"\n      accept=\"image/*,audio/*,video/*,.pdf\"\n      onChange={(e) => {\n        const file = e.target.files?.[0]\n        if (file) handleFileUpload(file)\n      }}\n    />\n  )\n}\n```\n\n","originalRawMarkdown":"---\ntitle: Multimodal Content\nid: multimodal-content\norder: 4\ndescription: \"Send images, audio, video, and documents alongside text in TanStack AI messages with typed ContentPart primitives for multimodal models.\"\nkeywords:\n  - tanstack ai\n  - multimodal\n  - vision\n  - images\n  - audio\n  - video\n  - documents\n  - ContentPart\n  - ImagePart\n---\n\nTanStack AI supports multimodal content in messages, allowing you to send images, audio, video, and documents alongside text to AI models that support these modalities.\n\nWhen sending messages to AI models, you can include different types of content:\n- **Text** - Plain text messages\n- **Images** - JPEG, PNG, GIF, WebP images\n- **Audio** - Audio files (model-dependent support)\n- **Video** - Video files (model-dependent support)\n- **Documents** - PDFs and other document types\n\n## Content Parts\n\nMultimodal messages use the `ContentPart` type to represent different content types:\n\n```typescript\nimport type { ContentPart, ImagePart, TextPart } from '@tanstack/ai'\n\n// Text content\nconst textPart: TextPart = {\n  type: 'text',\n  content: 'What do you see in this image?'\n}\n\n// Image from base64 data (mimeType is required for data sources)\nconst imagePart: ImagePart = {\n  type: 'image',\n  source: {\n    type: 'data',\n    value: 'base64EncodedImageData...',\n    mimeType: 'image/jpeg' // Required for data sources\n  },\n  metadata: {\n    // Provider-specific metadata\n    detail: 'high' // OpenAI detail level\n  }\n}\n\n// Image from URL (mimeType is optional for URL sources)\nconst imageUrlPart: ImagePart = {\n  type: 'image',\n  source: {\n    type: 'url',\n    value: 'https://example.com/image.jpg',\n    mimeType: 'image/jpeg' // Optional hint for URL sources\n  }\n}\n```\n\n## Using Multimodal Content in Messages\n\nMessages can have `content` as either a string or an array of `ContentPart`:\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst response = await chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', content: 'What is in this image?' },\n        {\n          type: 'image',\n          source: {\n            type: 'url',\n            value: 'https://example.com/photo.jpg'\n          }\n        }\n      ]\n    }\n  ]\n})\n```\n\n## Provider Support\n\n### OpenAI\n\nOpenAI supports images, audio, and PDF documents in their vision, audio, and\ndocument-capable models:\n\n```typescript\nimport { openaiText } from '@tanstack/ai-openai'\nimport { imageBase64, pdfBase64 } from './data'\n\nconst adapter = openaiText('gpt-5.5')\n\n// Image with detail level metadata\nconst message = {\n  role: 'user' ,\n  content: [\n    { type: 'text' , content: 'Describe this image' },\n    {\n      type: 'image' ,\n      source: { type: 'data' , value: imageBase64, mimeType: 'image/jpeg' },\n      metadata: { detail: 'high' } // 'auto' | 'low' | 'high'\n    }\n  ]\n}\n```\n\n```typescript\nimport { pdfBase64 } from './data'\n\n// PDF document via base64 data (the API requires a filename alongside\n// inline data; defaults to \"document.pdf\" when omitted)\nconst documentMessage = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Summarize this document' },\n    {\n      type: 'document',\n      source: { type: 'data', value: pdfBase64, mimeType: 'application/pdf' },\n      metadata: { filename: 'report.pdf' }\n    }\n  ]\n}\n```\n\n**Supported modalities by model:**\n- `gpt-5.5`, `gpt-5.2`, `gpt-5-mini` (among others): text, image, PDF document\n- `gpt-4o-audio`: text, audio\n\nCheck each model's `supports.input` in `@tanstack/ai-openai`'s `model-meta.ts` for the authoritative per-model list.\n\n### Anthropic\n\nAnthropic's Claude models support images and PDF documents:\n\n```typescript\nimport { anthropicText } from '@tanstack/ai-anthropic'\nimport { imageBase64, pdfBase64 } from './data'\n\nconst adapter = anthropicText('claude-sonnet-4-6')\n\n// Image with mimeType in source\nconst imageMessage = {\n  role: 'user' ,\n  content: [\n    { type: 'text' , content: 'What do you see?' },\n    {\n      type: 'image' ,\n      source: { type: 'data' , value: imageBase64, mimeType: 'image/jpeg' }\n    }\n  ]\n}\n\n// PDF document\nconst docMessage = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Summarize this document' },\n    {\n      type: 'document',\n      source: { type: 'data', value: pdfBase64, mimeType: 'application/pdf' }\n    }\n  ]\n}\n```\n\n**Supported modalities:**\n- All Claude models (e.g. `claude-haiku-4-5`, `claude-sonnet-5`, `claude-opus-4-8`, `claude-fable-5`): text, image, and document (PDF)\n\nCheck each model's `supports.input` in `@tanstack/ai-anthropic`'s `model-meta.ts` for the authoritative per-model list.\n\n### Gemini\n\nGoogle's Gemini models support a wide range of modalities:\n\n```typescript\nimport { geminiText } from '@tanstack/ai-gemini'\nimport { imageBase64 } from './data'\n\nconst adapter = geminiText('gemini-3-flash-preview')\n\n// Image with mimeType in source\nconst message = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Analyze this image' },\n    {\n      type: 'image',\n      source: { type: 'data', value: imageBase64, mimeType: 'image/png' }\n    }\n  ]\n}\n```\n\n**Supported modalities:**\n- `gemini-2.5-flash`: text, image, audio, video\n\n### Ollama\n\nOllama supports images in compatible models:\n\n```typescript\nimport { ollamaText } from '@tanstack/ai-ollama'\nimport { imageBase64 } from './data'\n\n// `ollamaText(model)` takes a model name. The host is read from the\n// `OLLAMA_HOST` environment variable (defaults to http://localhost:11434).\nconst adapter = ollamaText('llama3.2-vision')\n\n// Image as base64\nconst message = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'What is in this image?' },\n    {\n      type: 'image',\n      source: { type: 'data', value: imageBase64, mimeType: 'image/jpeg' }\n    }\n  ]\n}\n```\n\n**Note:** Ollama support varies by model. Check the specific model documentation for multimodal capabilities.\n\n## Source Types\n\nContent can be provided as either inline data or a URL:\n\n### Data (Base64)\n\nUse `type: 'data'` for inline base64-encoded content. **The `mimeType` field is required** to ensure providers receive proper content type information:\n\n```typescript\nconst imagePart = {\n  type: 'image',\n  source: {\n    type: 'data',\n    value: 'iVBORw0KGgoAAAANSUhEUgAAAAUA...', // Base64 string\n    mimeType: 'image/png' // Required for data sources\n  }\n}\n\nconst audioPart = {\n  type: 'audio',\n  source: {\n    type: 'data',\n    value: 'base64AudioData...',\n    mimeType: 'audio/mp3' // Required for data sources\n  }\n}\n```\n\n### URL\n\nUse `type: 'url'` for content hosted at a URL. The `mimeType` field is **optional** as providers can often infer it from the URL or response headers:\n\n```typescript\nconst imagePart = {\n  type: 'image' ,\n  source: {\n    type: 'url' ,\n    value: 'https://example.com/image.jpg',\n    mimeType: 'image/jpeg' // Optional hint\n  }\n}\n```\n\n**Note:** Not all providers support URL-based content for all modalities. Check provider documentation for specifics.\n\n### File Handle (Files API)\n\nUse `type: 'file'` to reference media you uploaded once via a provider's [Files API](./files-api.md) — the provider stores the bytes and you pass a lightweight reference instead of re-sending base64 or a public URL every request. The source carries the opaque handle and the provider that issued it (`{ type: 'file', value: 'file-…', provider: 'openai' }`). An adapter throws if a different provider issued the handle, and adapters without Files API support reject the source before any request is built.\n\n```typescript\nimport { openaiFiles, openaiText } from '@tanstack/ai-openai'\nimport { chat, fileSourceFromHandle, uploadFile } from '@tanstack/ai'\nimport { pdfBase64 } from './pdf-data'\n\n// Upload once...\nconst handle = await uploadFile({\n  adapter: openaiFiles(),\n  input: { data: pdfBase64, mimeType: 'application/pdf' },\n})\n\n// ...then reference the handle by id in as many requests as you like.\nfor await (const chunk of chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', content: 'Summarize this document' },\n        { type: 'document', source: fileSourceFromHandle(handle) },\n      ],\n    },\n  ],\n})) {\n  // ...\n}\n```\n\n`fileSourceFromHandle(handle)` builds the `{ type: 'file', value, provider }` source for you. It picks the handle URL for Gemini, fal, and Grok, or the opaque id for OpenAI and Anthropic. Each adapter maps `value` to the provider's native field (`file_id`, `fileData.fileUri`, or a URL). Sending the source to a different provider, or to an endpoint that requires raw bytes (image edits, Veo), throws a clear error. See [Files API](./files-api.md) for uploading, retrieving, and deleting handles.\n\n## Backward Compatibility\n\nString content continues to work as before:\n\n```typescript\n// This still works\nconst message = {\n  role: 'user',\n  content: 'Hello, world!'\n}\n\n// And this works for multimodal\nconst multimodalMessage = {\n  role: 'user',\n  content: [\n    { type: 'text', content: 'Hello, world!' },\n    { type: 'image', source: { type: 'url', value: '...' } }\n  ]\n}\n```\n\n## Type Safety\n\nThe multimodal types are fully typed. Provider-specific metadata types are available:\n\n```typescript\nimport type { \n  ContentPart,\n  ImagePart,\n  DocumentPart,\n  AudioPart,\n  VideoPart,\n  TextPart \n} from '@tanstack/ai'\n\n// Provider-specific metadata types\nimport type { OpenAIImageMetadata } from '@tanstack/ai-openai'\nimport type { AnthropicImageMetadata } from '@tanstack/ai-anthropic'\nimport type { GeminiImageMetadata } from '@tanstack/ai-gemini'\n```\n\n### Validating Dynamic Messages\n\nWhen receiving messages from external sources (like `request.json()`), the data is typed as `any`. TanStack AI does not ship a runtime message validator — define a schema with your preferred Standard-Schema library (Zod, Valibot, ArkType, …) and parse the body before handing it to `chat()`.\n\n```typescript ignore\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\n\nconst ContentPartSchema = z.discriminatedUnion('type', [\n  z.object({ type: z.literal('text'), content: z.string() }),\n  z.object({\n    type: z.literal('image'),\n    source: z.object({ type: z.enum(['url', 'data']), value: z.string() }),\n  }),\n])\n\nconst MessageSchema = z.object({\n  // `ModelMessage.role` is 'user' | 'assistant' | 'tool' — there is no\n  // 'system' role. System instructions are passed separately via the\n  // `systemPrompts` option on `chat()`, not as messages.\n  role: z.enum(['user', 'assistant', 'tool']),\n  content: z.union([z.string(), z.array(ContentPartSchema)]),\n})\n\nconst BodySchema = z.object({ messages: z.array(MessageSchema) })\n\n// In an API route handler\nconst { messages } = BodySchema.parse(await request.json())\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages,\n})\n```\n\nThe TypeScript types on `chat()` still constrain anything you append at the call site to the modalities supported by the selected model.\n\n## Best Practices\n\n1. **Use appropriate source type**: Use `data` for small content or when you need to include content inline. Use `url` for large files or when the content is already hosted.\n\n2. **Include metadata**: Provide relevant metadata (like `mimeType` or `detail`) to help the model process the content correctly.\n\n3. **Check model support**: Not all models support all modalities. Verify the model you're using supports the content types you want to send.\n\n4. **Handle errors gracefully**: When a model doesn't support a particular modality, it may throw an error. Handle these cases in your application.\n\n## Client-Side Multimodal Messages\n\nWhen using the `ChatClient` from `@tanstack/ai-client`, you can send multimodal messages directly from your UI using the `sendMessage` method.\n\n### Basic Usage\n\nThe `sendMessage` method accepts either a simple string or a `MultimodalContent` object:\n\n```typescript\nimport { ChatClient, fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst client = new ChatClient({\n  connection: fetchServerSentEvents('/api/chat'),\n})\n\n// Simple text message\nawait client.sendMessage('Hello!')\n\n// Multimodal message with image\nawait client.sendMessage({\n  content: [\n    { type: 'text', content: 'What is in this image?' },\n    {\n      type: 'image',\n      source: { type: 'url', value: 'https://example.com/photo.jpg' }\n    }\n  ]\n})\n```\n\n### Custom Message ID\n\nYou can provide a custom ID for the message:\n\n```typescript\nimport { ChatClient, fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst client = new ChatClient({\n  connection: fetchServerSentEvents('/api/chat'),\n})\n\nawait client.sendMessage({\n  content: 'Hello!',\n  id: 'custom-message-id-123'\n})\n```\n\n### Per-Message Forwarded Props\n\nThe second parameter allows you to pass additional `forwardedProps` for that specific request. These are shallow-merged with the client's base `forwardedProps` configuration, with per-message values taking priority:\n\n```typescript\nimport { ChatClient, fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst client = new ChatClient({\n  connection: fetchServerSentEvents('/api/chat'),\n  forwardedProps: { model: 'gpt-5' }, // Base forwarded props\n})\n\n// Override model for this specific message\nawait client.sendMessage('Analyze this complex problem', {\n  model: 'gpt-5',\n  temperature: 0.2,\n})\n```\n\n> **Note:** The legacy `body` constructor option is still supported but deprecated. New code should use `forwardedProps`. Both populate the same wire field.\n\n### React Example\n\nHere's how to use multimodal messages in a React component:\n\n```tsx\nimport { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { useState } from 'react'\n\nfunction ChatWithImages() {\n  const [imageUrl, setImageUrl] = useState('')\n  const { sendMessage, messages } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleSendWithImage = () => {\n    if (imageUrl) {\n      sendMessage({\n        content: [\n          { type: 'text', content: 'What do you see in this image?' },\n          { type: 'image', source: { type: 'url', value: imageUrl } }\n        ]\n      })\n    }\n  }\n\n  return (\n    <div>\n      <input\n        type=\"url\"\n        placeholder=\"Image URL\"\n        value={imageUrl}\n        onChange={(e) => setImageUrl(e.target.value)}\n      />\n      <button onClick={handleSendWithImage}>Send with Image</button>\n    </div>\n  )\n}\n```\n\n### File Upload Example\n\nHere's how to handle file uploads and send them as multimodal content:\n\n```tsx\nimport { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nfunction ChatWithFileUpload() {\n  const { sendMessage } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleFileUpload = async (file: File) => {\n    // Convert file to base64\n    const base64 = await new Promise<string>((resolve) => {\n      const reader = new FileReader()\n      reader.onload = () => {\n        const result = reader.result as string\n        // Remove data URL prefix (e.g., \"data:image/png;base64,\")\n        resolve(result.split(',')[1]!)\n      }\n      reader.readAsDataURL(file)\n    })\n\n    // Determine content type based on file type\n    const type = file.type.startsWith('image/')\n      ? 'image'\n      : file.type.startsWith('audio/')\n        ? 'audio'\n        : file.type.startsWith('video/')\n          ? 'video'\n          : 'document'\n\n    await sendMessage({\n      content: [\n        { type: 'text', content: `Please analyze this ${type}` },\n        {\n          type,\n          source: { type: 'data', value: base64, mimeType: file.type }\n        }\n      ]\n    })\n  }\n\n  return (\n    <input\n      type=\"file\"\n      accept=\"image/*,audio/*,video/*,.pdf\"\n      onChange={(e) => {\n        const file = e.target.files?.[0]\n        if (file) handleFileUpload(file)\n      }}\n    />\n  )\n}\n```\n\n"}
