{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack AI is designed from the ground up for maximum tree-shakeability. The entire system—from activity functions to adapters—uses a functional, modular architecture that ensures you only bundle the code you actually use."}]},{"type":"heading","depth":2,"id":"design-philosophy","children":[{"type":"text","value":"Design Philosophy"}]},{"type":"paragraph","children":[{"type":"text","value":"Instead of a monolithic API that includes everything, TanStack AI provides:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Individual activity functions"}]},{"type":"text","value":" - Import only the activities you need ("},{"type":"inlineCode","value":"chat"},{"type":"text","value":", "},{"type":"inlineCode","value":"summarize"},{"type":"text","value":", etc.)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Individual adapter functions"}]},{"type":"text","value":" - Import only the adapters you need ("},{"type":"inlineCode","value":"openaiText"},{"type":"text","value":", "},{"type":"inlineCode","value":"openaiSummarize"},{"type":"text","value":", etc.)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Functional API design"}]},{"type":"text","value":" - Pure functions that can be easily eliminated by bundlers"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Separate modules"}]},{"type":"text","value":" - Each activity and adapter lives in its own module"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"This design means that if you only use "},{"type":"inlineCode","value":"chat"},{"type":"text","value":" with OpenAI, you won't bundle code for summarization, image generation, or other providers."}]},{"type":"heading","depth":2,"id":"activity-functions","children":[{"type":"text","value":"Activity Functions"}]},{"type":"paragraph","children":[{"type":"text","value":"Each AI activity is exported as a separate function from "},{"type":"inlineCode","value":"@tanstack/ai"},{"type":"text","value":":"}]},{"type":"code","value":"// Import only the activities you need\nimport { chat } from '@tanstack/ai'              // Chat/text generation\nimport { summarize } from '@tanstack/ai'          // Summarization\nimport { generateImage } from '@tanstack/ai'      // Image generation\nimport { generateSpeech } from '@tanstack/ai'     // Text-to-speech\nimport { generateTranscription } from '@tanstack/ai' // Audio transcription\nimport { generateVideo } from '@tanstack/ai'       // Video generation\nimport { generateLiveVideo } from '@tanstack/ai'        // Live video sessions\nimport { generateWorld } from '@tanstack/ai'       // Live world sessions","lang":"ts"},{"type":"heading","depth":3,"id":"example-chat-only","children":[{"type":"text","value":"Example: Chat Only"}]},{"type":"paragraph","children":[{"type":"text","value":"If you only need chat functionality:"}]},{"type":"code","value":"// Only chat code is bundled\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Your bundle will "},{"type":"strong","children":[{"type":"text","value":"not"}]},{"type":"text","value":" include:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Summarization logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Image generation logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Other activity implementations"}]}]}]},{"type":"heading","depth":2,"id":"adapter-functions","children":[{"type":"text","value":"Adapter Functions"}]},{"type":"paragraph","children":[{"type":"text","value":"Each provider package exports individual adapter functions for each activity type:"}]},{"type":"heading","depth":3,"id":"openai","children":[{"type":"text","value":"OpenAI"}]},{"type":"code","value":"import {\n  openaiText,       // Chat/text generation\n  openaiSummarize,  // Summarization\n  openaiImage,      // Image generation\n  openaiSpeech,     // Text-to-speech\n  openaiTranscription, // Audio transcription\n  openaiVideo,      // Video generation\n} from '@tanstack/ai-openai'","lang":"ts"},{"type":"heading","depth":3,"id":"anthropic","children":[{"type":"text","value":"Anthropic"}]},{"type":"code","value":"import {\n  anthropicText,       // Chat/text generation\n  anthropicSummarize,  // Summarization\n} from '@tanstack/ai-anthropic'","lang":"ts"},{"type":"heading","depth":3,"id":"gemini","children":[{"type":"text","value":"Gemini"}]},{"type":"code","value":"import {\n  geminiText,       // Chat/text generation\n  geminiSummarize,  // Summarization\n  geminiImage,      // Image generation\n  geminiSpeech,     // Text-to-speech (experimental)\n} from '@tanstack/ai-gemini'","lang":"ts"},{"type":"heading","depth":3,"id":"ollama","children":[{"type":"text","value":"Ollama"}]},{"type":"code","value":"import {\n  ollamaText,       // Chat/text generation\n  ollamaSummarize,  // Summarization\n} from '@tanstack/ai-ollama'","lang":"ts"},{"type":"heading","depth":2,"id":"complete-example","children":[{"type":"text","value":"Complete Example"}]},{"type":"paragraph","children":[{"type":"text","value":"Here's how the tree-shakeable design works in practice:"}]},{"type":"code","value":"// Only import what you need\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Chat generation - returns AsyncIterable<StreamChunk>\nconst chatResult = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n})\n\nfor await (const chunk of chatResult) {\n  console.log(chunk)\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"What gets bundled:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ "},{"type":"inlineCode","value":"chat"},{"type":"text","value":" function and its dependencies"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ "},{"type":"inlineCode","value":"openaiText"},{"type":"text","value":" adapter and its dependencies"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ Chat-specific streaming and tool handling logic"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"What doesn't get bundled:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"❌ "},{"type":"inlineCode","value":"summarize"},{"type":"text","value":" function"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"❌ "},{"type":"inlineCode","value":"generateImage"},{"type":"text","value":" function"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"❌ Other adapter implementations (Anthropic, Gemini, etc.)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"❌ Other activity implementations"}]}]}]},{"type":"heading","depth":2,"id":"using-multiple-activities","children":[{"type":"text","value":"Using Multiple Activities"}]},{"type":"paragraph","children":[{"type":"text","value":"If you need multiple activities, import only what you use:"}]},{"type":"code","value":"import { chat, summarize } from '@tanstack/ai'\nimport {\n  openaiText,\n  openaiSummarize\n} from '@tanstack/ai-openai'\n\n// Each activity is independent\nconst chatResult = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n})\n\nconst summarizeResult = await summarize({\n  adapter: openaiSummarize('gpt-5.4-mini'),\n  text: 'Long text to summarize...',\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Each activity is in its own module, so bundlers can eliminate unused ones."}]},{"type":"heading","depth":2,"id":"type-safety","children":[{"type":"text","value":"Type Safety"}]},{"type":"paragraph","children":[{"type":"text","value":"The tree-shakeable design doesn't sacrifice type safety. Each adapter provides full type safety for its supported models:"}]},{"type":"code","value":"import { openaiText, type OpenAIChatModel } from '@tanstack/ai-openai'\n\nconst adapter = openaiText('gpt-5.5')\n\n// TypeScript knows the exact models supported\nconst model: OpenAIChatModel = 'gpt-5.5' // ✓ Valid\nconst model2: OpenAIChatModel = 'invalid' // ✗ Type error","lang":"ts","meta":"ignore"},{"type":"heading","depth":2,"id":"create-options-functions","children":[{"type":"text","value":"Create Options Functions"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"create___Options"},{"type":"text","value":" functions are also tree-shakeable:"}]},{"type":"code","value":"import {\n  createChatOptions,\n  createImageOptions\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Only import what you need\nconst chatOptions = createChatOptions({\n  adapter: openaiText('gpt-5.5'),\n})","lang":"ts"},{"type":"heading","depth":2,"id":"bundle-size-benefits","children":[{"type":"text","value":"Bundle Size Benefits"}]},{"type":"paragraph","children":[{"type":"text","value":"The functional, modular design provides significant bundle size benefits:"}]},{"type":"heading","depth":3,"id":"importing-everything-less-efficient","children":[{"type":"text","value":"Importing Everything (Less Efficient)"}]},{"type":"code","value":"// ❌ Importing more than needed\nimport * as ai from '@tanstack/ai'\nimport * as openai from '@tanstack/ai-openai'\n\n// This bundles all exports from both packages","lang":"ts"},{"type":"heading","depth":3,"id":"importing-only-what-you-need-recommended","children":[{"type":"text","value":"Importing Only What You Need (Recommended)"}]},{"type":"code","value":"// ✅ Only what you use gets bundled\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// You only get:\n// - Chat activity implementation\n// - OpenAI text adapter\n// - Chat-specific dependencies","lang":"ts"},{"type":"heading","depth":3,"id":"real-world-impact","children":[{"type":"text","value":"Real-World Impact"}]},{"type":"paragraph","children":[{"type":"text","value":"For a typical chat application, importing a single activity and one adapter pulls in substantially less code than bundling every activity and every provider adapter. Because each activity and adapter lives in its own side-effect-free module, your bundler drops everything you don't reference — so the more providers and activities the library supports, the larger the difference between a focused import and a namespace import."}]},{"type":"heading","depth":2,"id":"how-it-works","children":[{"type":"text","value":"How It Works"}]},{"type":"paragraph","children":[{"type":"text","value":"The tree-shakeability is achieved through:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"ES Module exports"}]},{"type":"text","value":" - Each function is a named export, not a default export"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Separate modules"}]},{"type":"text","value":" - Each activity and adapter lives in its own file"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"No side effects"}]},{"type":"text","value":" - Functions are pure and don't have module-level side effects"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Functional composition"}]},{"type":"text","value":" - Functions compose together, allowing dead code elimination"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Type-only imports"}]},{"type":"text","value":" - Type imports are stripped at build time"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Modern bundlers (Vite, Webpack, Rollup, esbuild) can easily eliminate unused code because:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Functions are statically analyzable"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"No dynamic imports of unused code"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"No module-level side effects"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Clear dependency graphs"}]}]}]},{"type":"heading","depth":2,"id":"best-practices","children":[{"type":"text","value":"Best Practices"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Import only what you need"}]},{"type":"text","value":" - Don't import entire namespaces"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Use specific adapter functions"}]},{"type":"text","value":" - Import "},{"type":"inlineCode","value":"openaiText"},{"type":"text","value":" not "},{"type":"inlineCode","value":"openai"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Separate activities by route"}]},{"type":"text","value":" - Different API routes can use different activities"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Lazy load when possible"}]},{"type":"text","value":" - Use dynamic imports for code-split routes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Keep mobile chat bundles client-only"}]},{"type":"text","value":" - React Native and Expo chat screens\nshould import "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" and chat connection adapters, not provider SDKs,\nserver response helpers, React DOM UI, devtools UI, or other framework\npackages. See "},{"type":"link","href":"../getting-started/quick-start-react-native","children":[{"type":"text","value":"Quick Start: React Native"}]},{"type":"text","value":"\nfor the server-only provider boundary and mobile transport setup."}]}]}]},{"type":"code","value":"// ✅ Good - Only imports chat\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// ❌ Bad - Imports everything\nimport * as ai from '@tanstack/ai'\nimport * as openai from '@tanstack/ai-openai'","lang":"ts"},{"type":"heading","depth":2,"id":"adapter-types","children":[{"type":"text","value":"Adapter Types"}]},{"type":"paragraph","children":[{"type":"text","value":"Each adapter type implements a specific interface:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ChatAdapter"},{"type":"text","value":" - Provides "},{"type":"inlineCode","value":"chatStream()"},{"type":"text","value":" method for streaming chat responses"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SummarizeAdapter"},{"type":"text","value":" - Provides "},{"type":"inlineCode","value":"summarize()"},{"type":"text","value":" method for text summarization"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ImageAdapter"},{"type":"text","value":" - Provides "},{"type":"inlineCode","value":"generateImage()"},{"type":"text","value":" method for image generation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TTSAdapter"},{"type":"text","value":" - Provides "},{"type":"inlineCode","value":"generateSpeech()"},{"type":"text","value":" method for text-to-speech"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TranscriptionAdapter"},{"type":"text","value":" - Provides "},{"type":"inlineCode","value":"generateTranscription()"},{"type":"text","value":" method for audio transcription"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"VideoAdapter"},{"type":"text","value":" - Provides "},{"type":"inlineCode","value":"generateVideo()"},{"type":"text","value":" method for video generation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"LiveVideoAdapter"},{"type":"text","value":" - Provides "},{"type":"inlineCode","value":"createLiveVideo()"},{"type":"text","value":" method for live video sessions"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"WorldAdapter"},{"type":"text","value":" - Provides "},{"type":"inlineCode","value":"createWorld()"},{"type":"text","value":" method for live world sessions and world jobs"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"All adapters have a "},{"type":"inlineCode","value":"kind"},{"type":"text","value":" property that indicates their type:"}]},{"type":"code","value":"import { openaiText, openaiSummarize } from '@tanstack/ai-openai'\n\nconst chatAdapter = openaiText('gpt-5.5')\nconsole.log(chatAdapter.kind) // 'text'\n\nconst summarizeAdapter = openaiSummarize('gpt-5.4-mini')\nconsole.log(summarizeAdapter.kind) // 'summarize'","lang":"ts"},{"type":"heading","depth":2,"id":"summary","children":[{"type":"text","value":"Summary"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI's tree-shakeable design means:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ "},{"type":"strong","children":[{"type":"text","value":"Smaller bundles"}]},{"type":"text","value":" - Only include code you actually use"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ "},{"type":"strong","children":[{"type":"text","value":"Faster load times"}]},{"type":"text","value":" - Less JavaScript to download and parse"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ "},{"type":"strong","children":[{"type":"text","value":"Better performance"}]},{"type":"text","value":" - Less code means faster execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ "},{"type":"strong","children":[{"type":"text","value":"Type safety"}]},{"type":"text","value":" - Full TypeScript support without runtime overhead"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ "},{"type":"strong","children":[{"type":"text","value":"Flexibility"}]},{"type":"text","value":" - Mix and match activities and adapters as needed"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The functional, modular architecture ensures that modern bundlers can eliminate unused code effectively, resulting in optimal bundle sizes for your application."}]}],"headings":[{"id":"design-philosophy","text":"Design Philosophy","level":2},{"id":"activity-functions","text":"Activity Functions","level":2},{"id":"example-chat-only","text":"Example: Chat Only","level":3},{"id":"adapter-functions","text":"Adapter Functions","level":2},{"id":"openai","text":"OpenAI","level":3},{"id":"anthropic","text":"Anthropic","level":3},{"id":"gemini","text":"Gemini","level":3},{"id":"ollama","text":"Ollama","level":3},{"id":"complete-example","text":"Complete Example","level":2},{"id":"using-multiple-activities","text":"Using Multiple Activities","level":2},{"id":"type-safety","text":"Type Safety","level":2},{"id":"create-options-functions","text":"Create Options Functions","level":2},{"id":"bundle-size-benefits","text":"Bundle Size Benefits","level":2},{"id":"importing-everything-less-efficient","text":"Importing Everything (Less Efficient)","level":3},{"id":"importing-only-what-you-need-recommended","text":"Importing Only What You Need (Recommended)","level":3},{"id":"real-world-impact","text":"Real-World Impact","level":3},{"id":"how-it-works","text":"How It Works","level":2},{"id":"best-practices","text":"Best Practices","level":2},{"id":"adapter-types","text":"Adapter Types","level":2},{"id":"summary","text":"Summary","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack AI is designed from the ground up for maximum tree-shakeability. The entire system—from activity functions to adapters—uses a functional, modular architecture that ensures you only bundle the code you actually use.\n\n## Design Philosophy\n\nInstead of a monolithic API that includes everything, TanStack AI provides:\n\n- **Individual activity functions** - Import only the activities you need (`chat`, `summarize`, etc.)\n- **Individual adapter functions** - Import only the adapters you need (`openaiText`, `openaiSummarize`, etc.)\n- **Functional API design** - Pure functions that can be easily eliminated by bundlers\n- **Separate modules** - Each activity and adapter lives in its own module\n\nThis design means that if you only use `chat` with OpenAI, you won't bundle code for summarization, image generation, or other providers.\n\n## Activity Functions\n\nEach AI activity is exported as a separate function from `@tanstack/ai`:\n\n```ts\n// Import only the activities you need\nimport { chat } from '@tanstack/ai'              // Chat/text generation\nimport { summarize } from '@tanstack/ai'          // Summarization\nimport { generateImage } from '@tanstack/ai'      // Image generation\nimport { generateSpeech } from '@tanstack/ai'     // Text-to-speech\nimport { generateTranscription } from '@tanstack/ai' // Audio transcription\nimport { generateVideo } from '@tanstack/ai'       // Video generation\nimport { generateLiveVideo } from '@tanstack/ai'        // Live video sessions\nimport { generateWorld } from '@tanstack/ai'       // Live world sessions\n```\n\n### Example: Chat Only\n\nIf you only need chat functionality:\n\n```ts\n// Only chat code is bundled\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n})\n```\n\nYour bundle will **not** include:\n- Summarization logic\n- Image generation logic\n- Other activity implementations\n\n## Adapter Functions\n\nEach provider package exports individual adapter functions for each activity type:\n\n### OpenAI\n\n```ts\nimport {\n  openaiText,       // Chat/text generation\n  openaiSummarize,  // Summarization\n  openaiImage,      // Image generation\n  openaiSpeech,     // Text-to-speech\n  openaiTranscription, // Audio transcription\n  openaiVideo,      // Video generation\n} from '@tanstack/ai-openai'\n```\n\n### Anthropic\n\n```ts\nimport {\n  anthropicText,       // Chat/text generation\n  anthropicSummarize,  // Summarization\n} from '@tanstack/ai-anthropic'\n```\n\n### Gemini\n\n```ts\nimport {\n  geminiText,       // Chat/text generation\n  geminiSummarize,  // Summarization\n  geminiImage,      // Image generation\n  geminiSpeech,     // Text-to-speech (experimental)\n} from '@tanstack/ai-gemini'\n```\n\n### Ollama\n\n```ts\nimport {\n  ollamaText,       // Chat/text generation\n  ollamaSummarize,  // Summarization\n} from '@tanstack/ai-ollama'\n```\n\n## Complete Example\n\nHere's how the tree-shakeable design works in practice:\n\n```ts\n// Only import what you need\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Chat generation - returns AsyncIterable<StreamChunk>\nconst chatResult = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n})\n\nfor await (const chunk of chatResult) {\n  console.log(chunk)\n}\n```\n\n**What gets bundled:**\n- ✅ `chat` function and its dependencies\n- ✅ `openaiText` adapter and its dependencies\n- ✅ Chat-specific streaming and tool handling logic\n\n**What doesn't get bundled:**\n- ❌ `summarize` function\n- ❌ `generateImage` function\n- ❌ Other adapter implementations (Anthropic, Gemini, etc.)\n- ❌ Other activity implementations\n\n## Using Multiple Activities\n\nIf you need multiple activities, import only what you use:\n\n```ts\nimport { chat, summarize } from '@tanstack/ai'\nimport {\n  openaiText,\n  openaiSummarize\n} from '@tanstack/ai-openai'\n\n// Each activity is independent\nconst chatResult = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n})\n\nconst summarizeResult = await summarize({\n  adapter: openaiSummarize('gpt-5.4-mini'),\n  text: 'Long text to summarize...',\n})\n```\n\nEach activity is in its own module, so bundlers can eliminate unused ones.\n\n## Type Safety\n\nThe tree-shakeable design doesn't sacrifice type safety. Each adapter provides full type safety for its supported models:\n\n```ts ignore\nimport { openaiText, type OpenAIChatModel } from '@tanstack/ai-openai'\n\nconst adapter = openaiText('gpt-5.5')\n\n// TypeScript knows the exact models supported\nconst model: OpenAIChatModel = 'gpt-5.5' // ✓ Valid\nconst model2: OpenAIChatModel = 'invalid' // ✗ Type error\n```\n\n## Create Options Functions\n\nThe `create___Options` functions are also tree-shakeable:\n\n```ts\nimport {\n  createChatOptions,\n  createImageOptions\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Only import what you need\nconst chatOptions = createChatOptions({\n  adapter: openaiText('gpt-5.5'),\n})\n```\n\n## Bundle Size Benefits\n\nThe functional, modular design provides significant bundle size benefits:\n\n### Importing Everything (Less Efficient)\n\n```ts\n// ❌ Importing more than needed\nimport * as ai from '@tanstack/ai'\nimport * as openai from '@tanstack/ai-openai'\n\n// This bundles all exports from both packages\n```\n\n### Importing Only What You Need (Recommended)\n\n```ts\n// ✅ Only what you use gets bundled\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// You only get:\n// - Chat activity implementation\n// - OpenAI text adapter\n// - Chat-specific dependencies\n```\n\n### Real-World Impact\n\nFor a typical chat application, importing a single activity and one adapter pulls in substantially less code than bundling every activity and every provider adapter. Because each activity and adapter lives in its own side-effect-free module, your bundler drops everything you don't reference — so the more providers and activities the library supports, the larger the difference between a focused import and a namespace import.\n\n## How It Works\n\nThe tree-shakeability is achieved through:\n\n1. **ES Module exports** - Each function is a named export, not a default export\n2. **Separate modules** - Each activity and adapter lives in its own file\n3. **No side effects** - Functions are pure and don't have module-level side effects\n4. **Functional composition** - Functions compose together, allowing dead code elimination\n5. **Type-only imports** - Type imports are stripped at build time\n\nModern bundlers (Vite, Webpack, Rollup, esbuild) can easily eliminate unused code because:\n\n- Functions are statically analyzable\n- No dynamic imports of unused code\n- No module-level side effects\n- Clear dependency graphs\n\n## Best Practices\n\n1. **Import only what you need** - Don't import entire namespaces\n2. **Use specific adapter functions** - Import `openaiText` not `openai`\n3. **Separate activities by route** - Different API routes can use different activities\n4. **Lazy load when possible** - Use dynamic imports for code-split routes\n5. **Keep mobile chat bundles client-only** - React Native and Expo chat screens\n   should import `useChat` and chat connection adapters, not provider SDKs,\n   server response helpers, React DOM UI, devtools UI, or other framework\n   packages. See [Quick Start: React Native](../getting-started/quick-start-react-native)\n   for the server-only provider boundary and mobile transport setup.\n\n```ts\n// ✅ Good - Only imports chat\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// ❌ Bad - Imports everything\nimport * as ai from '@tanstack/ai'\nimport * as openai from '@tanstack/ai-openai'\n```\n\n## Adapter Types\n\nEach adapter type implements a specific interface:\n\n- `ChatAdapter` - Provides `chatStream()` method for streaming chat responses\n- `SummarizeAdapter` - Provides `summarize()` method for text summarization\n- `ImageAdapter` - Provides `generateImage()` method for image generation\n- `TTSAdapter` - Provides `generateSpeech()` method for text-to-speech\n- `TranscriptionAdapter` - Provides `generateTranscription()` method for audio transcription\n- `VideoAdapter` - Provides `generateVideo()` method for video generation\n- `LiveVideoAdapter` - Provides `createLiveVideo()` method for live video sessions\n- `WorldAdapter` - Provides `createWorld()` method for live world sessions and world jobs\n\nAll adapters have a `kind` property that indicates their type:\n\n```ts\nimport { openaiText, openaiSummarize } from '@tanstack/ai-openai'\n\nconst chatAdapter = openaiText('gpt-5.5')\nconsole.log(chatAdapter.kind) // 'text'\n\nconst summarizeAdapter = openaiSummarize('gpt-5.4-mini')\nconsole.log(summarizeAdapter.kind) // 'summarize'\n```\n\n## Summary\n\nTanStack AI's tree-shakeable design means:\n\n- ✅ **Smaller bundles** - Only include code you actually use\n- ✅ **Faster load times** - Less JavaScript to download and parse\n- ✅ **Better performance** - Less code means faster execution\n- ✅ **Type safety** - Full TypeScript support without runtime overhead\n- ✅ **Flexibility** - Mix and match activities and adapters as needed\n\nThe functional, modular architecture ensures that modern bundlers can eliminate unused code effectively, resulting in optimal bundle sizes for your application.\n","originalRawMarkdown":"---\ntitle: Tree-Shaking\nid: tree-shaking\norder: 7\ndescription: \"TanStack AI's tree-shakeable architecture — import only the activities and adapters you use for minimal bundle size across chat, image, and speech.\"\nkeywords:\n  - tanstack ai\n  - tree-shaking\n  - bundle size\n  - modular imports\n  - performance\n  - tree-shakeable\n---\n\nTanStack AI is designed from the ground up for maximum tree-shakeability. The entire system—from activity functions to adapters—uses a functional, modular architecture that ensures you only bundle the code you actually use.\n\n## Design Philosophy\n\nInstead of a monolithic API that includes everything, TanStack AI provides:\n\n- **Individual activity functions** - Import only the activities you need (`chat`, `summarize`, etc.)\n- **Individual adapter functions** - Import only the adapters you need (`openaiText`, `openaiSummarize`, etc.)\n- **Functional API design** - Pure functions that can be easily eliminated by bundlers\n- **Separate modules** - Each activity and adapter lives in its own module\n\nThis design means that if you only use `chat` with OpenAI, you won't bundle code for summarization, image generation, or other providers.\n\n## Activity Functions\n\nEach AI activity is exported as a separate function from `@tanstack/ai`:\n\n```ts\n// Import only the activities you need\nimport { chat } from '@tanstack/ai'              // Chat/text generation\nimport { summarize } from '@tanstack/ai'          // Summarization\nimport { generateImage } from '@tanstack/ai'      // Image generation\nimport { generateSpeech } from '@tanstack/ai'     // Text-to-speech\nimport { generateTranscription } from '@tanstack/ai' // Audio transcription\nimport { generateVideo } from '@tanstack/ai'       // Video generation\nimport { generateLiveVideo } from '@tanstack/ai'        // Live video sessions\nimport { generateWorld } from '@tanstack/ai'       // Live world sessions\n```\n\n### Example: Chat Only\n\nIf you only need chat functionality:\n\n```ts\n// Only chat code is bundled\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n})\n```\n\nYour bundle will **not** include:\n- Summarization logic\n- Image generation logic\n- Other activity implementations\n\n## Adapter Functions\n\nEach provider package exports individual adapter functions for each activity type:\n\n### OpenAI\n\n```ts\nimport {\n  openaiText,       // Chat/text generation\n  openaiSummarize,  // Summarization\n  openaiImage,      // Image generation\n  openaiSpeech,     // Text-to-speech\n  openaiTranscription, // Audio transcription\n  openaiVideo,      // Video generation\n} from '@tanstack/ai-openai'\n```\n\n### Anthropic\n\n```ts\nimport {\n  anthropicText,       // Chat/text generation\n  anthropicSummarize,  // Summarization\n} from '@tanstack/ai-anthropic'\n```\n\n### Gemini\n\n```ts\nimport {\n  geminiText,       // Chat/text generation\n  geminiSummarize,  // Summarization\n  geminiImage,      // Image generation\n  geminiSpeech,     // Text-to-speech (experimental)\n} from '@tanstack/ai-gemini'\n```\n\n### Ollama\n\n```ts\nimport {\n  ollamaText,       // Chat/text generation\n  ollamaSummarize,  // Summarization\n} from '@tanstack/ai-ollama'\n```\n\n## Complete Example\n\nHere's how the tree-shakeable design works in practice:\n\n```ts\n// Only import what you need\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Chat generation - returns AsyncIterable<StreamChunk>\nconst chatResult = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n})\n\nfor await (const chunk of chatResult) {\n  console.log(chunk)\n}\n```\n\n**What gets bundled:**\n- ✅ `chat` function and its dependencies\n- ✅ `openaiText` adapter and its dependencies\n- ✅ Chat-specific streaming and tool handling logic\n\n**What doesn't get bundled:**\n- ❌ `summarize` function\n- ❌ `generateImage` function\n- ❌ Other adapter implementations (Anthropic, Gemini, etc.)\n- ❌ Other activity implementations\n\n## Using Multiple Activities\n\nIf you need multiple activities, import only what you use:\n\n```ts\nimport { chat, summarize } from '@tanstack/ai'\nimport {\n  openaiText,\n  openaiSummarize\n} from '@tanstack/ai-openai'\n\n// Each activity is independent\nconst chatResult = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n})\n\nconst summarizeResult = await summarize({\n  adapter: openaiSummarize('gpt-5.4-mini'),\n  text: 'Long text to summarize...',\n})\n```\n\nEach activity is in its own module, so bundlers can eliminate unused ones.\n\n## Type Safety\n\nThe tree-shakeable design doesn't sacrifice type safety. Each adapter provides full type safety for its supported models:\n\n```ts ignore\nimport { openaiText, type OpenAIChatModel } from '@tanstack/ai-openai'\n\nconst adapter = openaiText('gpt-5.5')\n\n// TypeScript knows the exact models supported\nconst model: OpenAIChatModel = 'gpt-5.5' // ✓ Valid\nconst model2: OpenAIChatModel = 'invalid' // ✗ Type error\n```\n\n## Create Options Functions\n\nThe `create___Options` functions are also tree-shakeable:\n\n```ts\nimport {\n  createChatOptions,\n  createImageOptions\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Only import what you need\nconst chatOptions = createChatOptions({\n  adapter: openaiText('gpt-5.5'),\n})\n```\n\n## Bundle Size Benefits\n\nThe functional, modular design provides significant bundle size benefits:\n\n### Importing Everything (Less Efficient)\n\n```ts\n// ❌ Importing more than needed\nimport * as ai from '@tanstack/ai'\nimport * as openai from '@tanstack/ai-openai'\n\n// This bundles all exports from both packages\n```\n\n### Importing Only What You Need (Recommended)\n\n```ts\n// ✅ Only what you use gets bundled\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// You only get:\n// - Chat activity implementation\n// - OpenAI text adapter\n// - Chat-specific dependencies\n```\n\n### Real-World Impact\n\nFor a typical chat application, importing a single activity and one adapter pulls in substantially less code than bundling every activity and every provider adapter. Because each activity and adapter lives in its own side-effect-free module, your bundler drops everything you don't reference — so the more providers and activities the library supports, the larger the difference between a focused import and a namespace import.\n\n## How It Works\n\nThe tree-shakeability is achieved through:\n\n1. **ES Module exports** - Each function is a named export, not a default export\n2. **Separate modules** - Each activity and adapter lives in its own file\n3. **No side effects** - Functions are pure and don't have module-level side effects\n4. **Functional composition** - Functions compose together, allowing dead code elimination\n5. **Type-only imports** - Type imports are stripped at build time\n\nModern bundlers (Vite, Webpack, Rollup, esbuild) can easily eliminate unused code because:\n\n- Functions are statically analyzable\n- No dynamic imports of unused code\n- No module-level side effects\n- Clear dependency graphs\n\n## Best Practices\n\n1. **Import only what you need** - Don't import entire namespaces\n2. **Use specific adapter functions** - Import `openaiText` not `openai`\n3. **Separate activities by route** - Different API routes can use different activities\n4. **Lazy load when possible** - Use dynamic imports for code-split routes\n5. **Keep mobile chat bundles client-only** - React Native and Expo chat screens\n   should import `useChat` and chat connection adapters, not provider SDKs,\n   server response helpers, React DOM UI, devtools UI, or other framework\n   packages. See [Quick Start: React Native](../getting-started/quick-start-react-native)\n   for the server-only provider boundary and mobile transport setup.\n\n```ts\n// ✅ Good - Only imports chat\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// ❌ Bad - Imports everything\nimport * as ai from '@tanstack/ai'\nimport * as openai from '@tanstack/ai-openai'\n```\n\n## Adapter Types\n\nEach adapter type implements a specific interface:\n\n- `ChatAdapter` - Provides `chatStream()` method for streaming chat responses\n- `SummarizeAdapter` - Provides `summarize()` method for text summarization\n- `ImageAdapter` - Provides `generateImage()` method for image generation\n- `TTSAdapter` - Provides `generateSpeech()` method for text-to-speech\n- `TranscriptionAdapter` - Provides `generateTranscription()` method for audio transcription\n- `VideoAdapter` - Provides `generateVideo()` method for video generation\n- `LiveVideoAdapter` - Provides `createLiveVideo()` method for live video sessions\n- `WorldAdapter` - Provides `createWorld()` method for live world sessions and world jobs\n\nAll adapters have a `kind` property that indicates their type:\n\n```ts\nimport { openaiText, openaiSummarize } from '@tanstack/ai-openai'\n\nconst chatAdapter = openaiText('gpt-5.5')\nconsole.log(chatAdapter.kind) // 'text'\n\nconst summarizeAdapter = openaiSummarize('gpt-5.4-mini')\nconsole.log(summarizeAdapter.kind) // 'summarize'\n```\n\n## Summary\n\nTanStack AI's tree-shakeable design means:\n\n- ✅ **Smaller bundles** - Only include code you actually use\n- ✅ **Faster load times** - Less JavaScript to download and parse\n- ✅ **Better performance** - Less code means faster execution\n- ✅ **Type safety** - Full TypeScript support without runtime overhead\n- ✅ **Flexibility** - Mix and match activities and adapters as needed\n\nThe functional, modular architecture ensures that modern bundlers can eliminate unused code effectively, resulting in optimal bundle sizes for your application.\n"}
