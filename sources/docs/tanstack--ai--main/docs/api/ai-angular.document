NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Angular signal-based bindings for TanStack AI, providing convenient Angular bindings for the headless client."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Injection context requirement:"}]},{"type":"text","value":" Every "},{"type":"inlineCode","value":"inject*"},{"type":"text","value":" function in this package calls Angular's "},{"type":"inlineCode","value":"inject()"},{"type":"text","value":" internally. They "},{"type":"strong","children":[{"type":"text","value":"must"}]},{"type":"text","value":" be called within an Angular injection context — a component or directive class field initializer, the constructor, or inside "},{"type":"inlineCode","value":"runInInjectionContext"},{"type":"text","value":". Calling them outside an injection context will throw a runtime error."}]}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"angular\":[[\"@tanstack/ai-angular\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"injectregisterwebmcptools-tools-options","children":[{"type":"inlineCode","value":"injectRegisterWebMCPTools(tools, options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Register executable client tools for the current Angular injection owner. Angular removes them when it destroys that owner."}]},{"type":"paragraph","children":[{"type":"text","value":"For a complete setup and behavior guide, see "},{"type":"link","href":"../tools/webmcp","children":[{"type":"text","value":"WebMCP Tools"}]},{"type":"text","value":"."}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport {\n  injectRegisterWebMCPTools,\n  type InjectRegisterWebMCPToolsOptions,\n} from \"@tanstack/ai-angular\";\nimport { searchProducts } from \"./tools\";\n\nconst tools = [searchProducts];\nconst options: InjectRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error);\n  },\n};\n\n@Component({ selector: \"app-products\", standalone: true, template: \"\" })\nexport class ProductsComponent {\n  registration = injectRegisterWebMCPTools(tools, options);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"InjectRegisterWebMCPToolsOptions<TTools, TContext>"},{"type":"text","value":" contains "},{"type":"inlineCode","value":"toolOptions"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onError"},{"type":"text","value":". The injectable owns the registration signal."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"context"},{"type":"text","value":" field is required when a tool declares a required runtime context. Call this function only in an Angular injection context."}]},{"type":"heading","depth":2,"id":"injectpagewebmcptools-options","children":[{"type":"inlineCode","value":"injectPageWebMCPTools(options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Read the WebMCP tools on the page as client tools. The signal starts empty and updates when the page adds or removes a tool. Pass the signal to "},{"type":"inlineCode","value":"injectChat"},{"type":"text","value":" as "},{"type":"inlineCode","value":"tools"},{"type":"text","value":". Call it in an injection context."}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { injectPageWebMCPTools } from \"@tanstack/ai-angular\";\n\n@Component({ selector: \"app-page-tools\", standalone: true, template: \"\" })\nexport class PageTools {\n  pageTools = injectPageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  });\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"filter"},{"type":"text","value":" skips a tool when it returns "},{"type":"inlineCode","value":"false"},{"type":"text","value":". "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" gets a failed WebMCP read. For a complete guide, see "},{"type":"link","href":"../tools/webmcp-page-tools","children":[{"type":"text","value":"Page WebMCP Tools in Chat"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"injectchat-options","children":[{"type":"inlineCode","value":"injectChat(options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Main injectable for managing chat state in Angular with full type safety."}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-chat\",\n  standalone: true,\n  template: `...`,\n})\nexport class ChatComponent {\n  // injectChat is called in a field initializer — valid injection context.\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"paragraph","children":[{"type":"text","value":"Extends "},{"type":"inlineCode","value":"ChatClientOptions"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":" (minus internal state callbacks):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"connection"},{"type":"text","value":" - Connection adapter (required, or use "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"fetcher?"},{"type":"text","value":" - Direct async function for one-shot generation (alternative to "},{"type":"inlineCode","value":"connection"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tools?"},{"type":"text","value":" - Array of client tool implementations (with "},{"type":"inlineCode","value":".client()"},{"type":"text","value":" method). Reactive: pass a "},{"type":"inlineCode","value":"Signal"},{"type":"text","value":" or getter to change the tools after the chat is created."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"initialMessages?"},{"type":"text","value":" - Initial messages array"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"threadId?"},{"type":"text","value":" - The only identity for this chat. Required when persistence is on. If omitted, minted after mount."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"forwardedProps?"},{"type":"text","value":" - Arbitrary client-controlled JSON forwarded to the server in the AG-UI "},{"type":"inlineCode","value":"RunAgentInput.forwardedProps"},{"type":"text","value":" field. Reactive — accepts a plain value, an Angular "},{"type":"inlineCode","value":"Signal"},{"type":"text","value":", or a zero-arg getter; changes sync automatically via "},{"type":"inlineCode","value":"effect"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"body?"},{"type":"text","value":" - "},{"type":"strong","children":[{"type":"text","value":"Deprecated."}]},{"type":"text","value":" Use "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" instead. Still works for backward compatibility; values are merged into "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" on the wire. Reactive (same forms as "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"byok?"},{"type":"text","value":" - Optional BYOK keyring from "},{"type":"inlineCode","value":"defineByok"},{"type":"text","value":". On each send the client prepares the resolved provider and stamps "},{"type":"inlineCode","value":"x-byok-*"},{"type":"text","value":" request headers. Keys never go in the body"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"byokProvider?"},{"type":"text","value":" - Optional function that returns the provider slug for this chat. If it returns a slug, only that key is prepared and sent. Otherwise the merged "},{"type":"inlineCode","value":"provider"},{"type":"text","value":" from "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"body"},{"type":"text","value":", and per-call "},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":" "},{"type":"inlineCode","value":"body"},{"type":"text","value":" is used. Later sources win. If no slug resolves, the send throws instead of attaching every stored key"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context?"},{"type":"text","value":" - Typed client-local runtime context passed to client tool implementations. Reactive (same forms). This value is not serialized to the server"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"live?"},{"type":"text","value":" - Enable live subscription mode (auto-subscribes/unsubscribes). Reactive (same forms)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"outputSchema?"},{"type":"text","value":" - Standard-schema-compatible schema (Zod, Valibot, ArkType, or JSON Schema). When provided, adds typed "},{"type":"inlineCode","value":"partial"},{"type":"text","value":" and "},{"type":"inlineCode","value":"final"},{"type":"text","value":" signals to the return value"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"persistence?"},{"type":"text","value":" - Persistence configuration"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"devtools?"},{"type":"text","value":" - Display options for TanStack AI Devtools"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onResponse?"},{"type":"text","value":" - Callback when response is received"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onChunk?"},{"type":"text","value":" - Callback when stream chunk is received"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onFinish?"},{"type":"text","value":" - Callback when response finishes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onError?"},{"type":"text","value":" - Callback when error occurs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onInterruptStateChange?"},{"type":"text","value":" - Callback when interrupt state changes; context source is "},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" for restored state and "},{"type":"inlineCode","value":"live"},{"type":"text","value":" for streamed or client-initiated updates"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onCustomEvent?"},{"type":"text","value":" - Callback for custom stream events"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"streamProcessor?"},{"type":"text","value":" - Stream processing configuration"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Reactive options"}]},{"type":"text","value":" ("},{"type":"inlineCode","value":"body"},{"type":"text","value":", "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":", "},{"type":"inlineCode","value":"live"},{"type":"text","value":") accept a "},{"type":"inlineCode","value":"ReactiveOption<T>"},{"type":"text","value":", which is one of:"}]},{"type":"code","value":"import type { Signal } from \"@angular/core\";\n\ntype ReactiveOption<T> = T | Signal<T> | (() => T);","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"A plain value becomes a constant; a "},{"type":"inlineCode","value":"Signal"},{"type":"text","value":" is read directly; a zero-arg getter is wrapped in "},{"type":"inlineCode","value":"computed"},{"type":"text","value":" so any signals read inside it are tracked."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Client tools are automatically executed — no "},{"type":"inlineCode","value":"onToolCall"},{"type":"text","value":" callback needed!"}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"import type { Signal } from \"@angular/core\";\nimport type {\n  UIMessage,\n  MultimodalContent,\n  DeepPartial,\n} from \"@tanstack/ai-angular\";\nimport type { ModelMessage, InferSchemaType } from \"@tanstack/ai/client\";\nimport type {\n  ChatClientState,\n  ConnectionStatus,\n  SendMessageOptions,\n} from \"@tanstack/ai-client\";\ntype TSchema = any;\n\ninterface InjectChatResult {\n  messages: Signal<UIMessage[]>;\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>;\n  append: (message: ModelMessage | UIMessage) => Promise<void>;\n  addToolResult: (result: {\n    toolCallId: string;\n    tool: string;\n    output: any;\n    state?: \"output-available\" | \"output-error\";\n    errorText?: string;\n  }) => Promise<void>;\n  addToolApprovalResponse: (response: {\n    id: string;\n    approved: boolean;\n  }) => Promise<void>;\n  reload: () => Promise<void>;\n  stop: () => void;\n  clear: () => void;\n  setMessages: (messages: UIMessage[]) => void;\n  isLoading: Signal<boolean>;\n  error: Signal<Error | undefined>;\n  status: Signal<ChatClientState>;\n  isSubscribed: Signal<boolean>;\n  connectionStatus: Signal<ConnectionStatus>;\n  sessionGenerating: Signal<boolean>;\n  isHydrating: Signal<boolean>;\n  // Only present when outputSchema is supplied:\n  partial: Signal<DeepPartial<InferSchemaType<TSchema>>>;\n  final: Signal<InferSchemaType<TSchema> | null>;\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" All reactive state ("},{"type":"inlineCode","value":"messages"},{"type":"text","value":", "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":", "},{"type":"inlineCode","value":"status"},{"type":"text","value":", "},{"type":"inlineCode","value":"isSubscribed"},{"type":"text","value":", "},{"type":"inlineCode","value":"connectionStatus"},{"type":"text","value":", "},{"type":"inlineCode","value":"sessionGenerating"},{"type":"text","value":", "},{"type":"inlineCode","value":"isHydrating"},{"type":"text","value":") is exposed as read-only Angular "},{"type":"inlineCode","value":"Signal"},{"type":"text","value":"s. Read them by calling them as functions (e.g., "},{"type":"inlineCode","value":"chat.messages()"},{"type":"text","value":", "},{"type":"inlineCode","value":"chat.isLoading()"},{"type":"text","value":"). Cleanup is automatic via "},{"type":"inlineCode","value":"DestroyRef.onDestroy"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"injectbyok-client","children":[{"type":"inlineCode","value":"injectByok(client)"}]},{"type":"paragraph","children":[{"type":"text","value":"Subscribe to a "},{"type":"inlineCode","value":"ByokClient"},{"type":"text","value":" snapshot in Angular. Call it in an injection context. The return value is a read-only "},{"type":"inlineCode","value":"Signal"},{"type":"text","value":"."}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { injectByok } from \"@tanstack/ai-angular\";\nimport { byok } from \"./byok\";\n\n@Component({\n  selector: \"app-key-status\",\n  standalone: true,\n  template: `<p>{{ last4() }}</p>`,\n})\nexport class KeyStatusComponent {\n  snapshot = injectByok(byok);\n\n  last4() {\n    const openai = this.snapshot().status.openai;\n    return openai && \"masked\" in openai ? openai.masked : \"No key\";\n  }\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"snapshot()"},{"type":"text","value":" has "},{"type":"inlineCode","value":"status"},{"type":"text","value":", "},{"type":"inlineCode","value":"locked"},{"type":"text","value":", and "},{"type":"inlineCode","value":"prompt"},{"type":"text","value":". Call "},{"type":"inlineCode","value":"byok.update(provider, value)"},{"type":"text","value":" from your own UI to save a key. See "},{"type":"link","href":"../advanced/byok","children":[{"type":"text","value":"Bring Your Own Key"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"connection-adapters","children":[{"type":"text","value":"Connection Adapters"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":" for convenience:"}]},{"type":"code","value":"import {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  xhrServerSentEvents,\n  xhrHttpStream,\n  stream,\n  rpcStream,\n  type ConnectionAdapter,\n} from \"@tanstack/ai-angular\";","lang":"typescript"},{"type":"heading","depth":2,"id":"example-basic-chat","children":[{"type":"text","value":"Example: Basic Chat"}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { CommonModule } from \"@angular/common\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-chat\",\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    <ul>\n      @for (message of chat.messages(); track message.id) {\n        <li>\n          <strong>{{ message.role }}:</strong>\n          @for (part of message.parts; track $index) {\n            @if (part.type === 'thinking') {\n              <em>Thinking: {{ part.content }}</em>\n            } @else if (part.type === 'text') {\n              <span>{{ part.content }}</span>\n            }\n          }\n        </li>\n      }\n    </ul>\n    <input #input placeholder=\"Type a message...\" />\n    <button\n      (click)=\"chat.sendMessage(input.value); input.value = ''\"\n      [disabled]=\"chat.isLoading()\"\n    >\n      Send\n    </button>\n    @if (chat.isLoading()) {\n      <p>Thinking...</p>\n    }\n  `,\n})\nexport class ChatComponent {\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"example-tool-approval","children":[{"type":"text","value":"Example: Tool Approval"}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { CommonModule } from \"@angular/common\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-approval-chat\",\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    @for (message of chat.messages(); track message.id) {\n      @for (part of message.parts; track $index) {\n        @if (\n          part.type === 'tool-call' &&\n          part.state === 'approval-requested' &&\n          part.approval\n        ) {\n          <div>\n            <p>Approve: {{ part.name }}</p>\n            <button (click)=\"chat.addToolApprovalResponse({ id: part.approval!.id, approved: true })\">\n              Approve\n            </button>\n            <button (click)=\"chat.addToolApprovalResponse({ id: part.approval!.id, approved: false })\">\n              Deny\n            </button>\n          </div>\n        }\n      }\n    }\n  `,\n})\nexport class ApprovalChatComponent {\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"example-client-tools-with-type-safety","children":[{"type":"text","value":"Example: Client Tools with Type Safety"}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { CommonModule } from \"@angular/common\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Show a notification in the UI\",\n  inputSchema: z.object({ message: z.string(), type: z.string() }),\n});\n\nconst saveToStorageDef = toolDefinition({\n  name: \"saveToStorage\",\n  description: \"Save a value to localStorage\",\n  inputSchema: z.object({ key: z.string(), value: z.string() }),\n});\n\n@Component({\n  selector: \"app-typed-chat\",\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    @for (message of chat.messages(); track message.id) {\n      @for (part of message.parts; track $index) {\n        @if (part.type === 'tool-call' && part.name === 'updateUI') {\n          <div>Tool executed: {{ part.name }}</div>\n        }\n      }\n    }\n  `,\n})\nexport class TypedChatComponent {\n  // Create client implementations\n  private updateUI = updateUIDef.client((input) => {\n    // input is fully typed!\n    return { success: true };\n  });\n\n  private saveToStorage = saveToStorageDef.client((input) => {\n    localStorage.setItem(input.key, input.value);\n    return { saved: true };\n  });\n\n  // Create typed tools array (no 'as const' needed!)\n  private tools = [this.updateUI, this.saveToStorage];\n\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    tools: this.tools, // Automatic execution, full type safety\n  });\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"example-reactive-options-with-signals","children":[{"type":"text","value":"Example: Reactive Options with Signals"}]},{"type":"code","value":"import { Component, signal } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-reactive-chat\",\n  standalone: true,\n  template: `\n    <button (click)=\"toggleLanguage()\">Toggle Language</button>\n    @for (message of chat.messages(); track message.id) {\n      <p>{{ message.role }}: {{ message.parts[0]?.content }}</p>\n    }\n  `,\n})\nexport class ReactiveChatComponent {\n  language = signal(\"en\");\n\n  // forwardedProps is reactive — the signal is read on every request\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    forwardedProps: () => ({ language: this.language() }),\n  });\n\n  toggleLanguage() {\n    this.language.set(this.language() === \"en\" ? \"fr\" : \"en\");\n  }\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"example-structured-output","children":[{"type":"text","value":"Example: Structured Output"}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\nimport { z } from \"zod\";\n\nconst recipeSchema = z.object({\n  title: z.string(),\n  ingredients: z.array(z.string()),\n  steps: z.array(z.string()),\n});\n\n@Component({\n  selector: \"app-recipe-chat\",\n  standalone: true,\n  template: `\n    <button (click)=\"chat.sendMessage('Give me a pasta recipe')\">Ask</button>\n    @if (chat.partial().title) {\n      <h2>{{ chat.partial().title }}</h2>\n    }\n    @if (chat.final()) {\n      <ul>\n        @for (step of chat.final()!.steps; track $index) {\n          <li>{{ step }}</li>\n        }\n      </ul>\n    }\n  `,\n})\nexport class RecipeChatComponent {\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    outputSchema: recipeSchema,\n  });\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"generation-injectables","children":[{"type":"text","value":"Generation Injectables"}]},{"type":"paragraph","children":[{"type":"text","value":"Angular injectables for one-shot generation tasks (images, audio, speech, transcription, summarization, video). All share the same pattern: provide a "},{"type":"inlineCode","value":"connection"},{"type":"text","value":" or "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":", call "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":", and read reactive signals."}]},{"type":"heading","depth":3,"id":"injectgeneration-options","children":[{"type":"inlineCode","value":"injectGeneration(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Base injectable for custom generation types. All specialized injectables below are built on this."}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { injectGeneration } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({ selector: \"app-custom\", standalone: true, template: `...` })\nexport class CustomGenerationComponent {\n  gen = injectGeneration({\n    connection: fetchServerSentEvents(\"/api/generate/custom\"),\n  });\n\n  // Call gen.generate(input), read gen.result(), gen.isLoading(), etc.\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options:"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"connection?"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetcher?"},{"type":"text","value":", "},{"type":"inlineCode","value":"threadId?"},{"type":"text","value":", "},{"type":"inlineCode","value":"body?"},{"type":"text","value":" (reactive), "},{"type":"inlineCode","value":"devtools?"},{"type":"text","value":", "},{"type":"inlineCode","value":"onResult?"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError?"},{"type":"text","value":", "},{"type":"inlineCode","value":"onProgress?"},{"type":"text","value":", "},{"type":"inlineCode","value":"onChunk?"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns:"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"generate"},{"type":"text","value":", "},{"type":"inlineCode","value":"result"},{"type":"text","value":", "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":", "},{"type":"inlineCode","value":"status"},{"type":"text","value":", "},{"type":"inlineCode","value":"stop"},{"type":"text","value":", "},{"type":"inlineCode","value":"reset"},{"type":"text","value":", "},{"type":"inlineCode","value":"runId"},{"type":"text","value":". All reactive state is a read-only "},{"type":"inlineCode","value":"Signal<T>"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"injectgenerateimage-options","children":[{"type":"inlineCode","value":"injectGenerateImage(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Image generation injectable. "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"ImageGenerateInput"},{"type":"text","value":", result is "},{"type":"inlineCode","value":"ImageGenerationResult"},{"type":"text","value":"."}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { injectGenerateImage } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({\n  selector: \"app-image\",\n  standalone: true,\n  template: `\n    <button (click)=\"gen.generate({ prompt: 'A mountain at sunset' })\" [disabled]=\"gen.isLoading()\">\n      Generate\n    </button>\n    @if (gen.result()) {\n      <img [src]=\"gen.result()!.images[0]!.url\" alt=\"Generated image\" />\n    }\n  `,\n})\nexport class ImageComponent {\n  gen = injectGenerateImage({\n    connection: fetchServerSentEvents(\"/api/generate/image\"),\n  });\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"injectgenerateaudio-options","children":[{"type":"inlineCode","value":"injectGenerateAudio(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Audio generation injectable (music, sound effects). "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"AudioGenerateInput"},{"type":"text","value":", result is "},{"type":"inlineCode","value":"AudioGenerationResult"},{"type":"text","value":"."}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { injectGenerateAudio } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({\n  selector: \"app-audio\",\n  standalone: true,\n  template: `\n    <button (click)=\"gen.generate({ prompt: 'An upbeat electronic track', duration: 10 })\" [disabled]=\"gen.isLoading()\">\n      Generate\n    </button>\n    @if (gen.result()) {\n      <audio [src]=\"gen.result()!.audio.url\" controls></audio>\n    }\n  `,\n})\nexport class AudioComponent {\n  gen = injectGenerateAudio({\n    connection: fetchServerSentEvents(\"/api/generate/audio\"),\n  });\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"injectgeneratespeech-options","children":[{"type":"inlineCode","value":"injectGenerateSpeech(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Text-to-speech injectable. "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"SpeechGenerateInput"},{"type":"text","value":", result is "},{"type":"inlineCode","value":"TTSResult"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"injecttranscription-options","children":[{"type":"inlineCode","value":"injectTranscription(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Audio transcription injectable. "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"TranscriptionGenerateInput"},{"type":"text","value":", result is "},{"type":"inlineCode","value":"TranscriptionResult"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"injectsummarize-options","children":[{"type":"inlineCode","value":"injectSummarize(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Text summarization injectable. "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"SummarizeGenerateInput"},{"type":"text","value":", result is "},{"type":"inlineCode","value":"SummarizationResult"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"injectgeneratevideo-options","children":[{"type":"inlineCode","value":"injectGenerateVideo(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Video generation injectable with job polling. Returns additional "},{"type":"inlineCode","value":"jobId"},{"type":"text","value":" and "},{"type":"inlineCode","value":"videoStatus"},{"type":"text","value":" signals. Accepts extra "},{"type":"inlineCode","value":"onJobCreated?"},{"type":"text","value":" and "},{"type":"inlineCode","value":"onStatusUpdate?"},{"type":"text","value":" callbacks."}]},{"type":"code","value":"import { Component } from \"@angular/core\";\nimport { injectGenerateVideo } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({\n  selector: \"app-video\",\n  standalone: true,\n  template: `\n    <button (click)=\"gen.generate({ prompt: 'A time-lapse of a sunset' })\" [disabled]=\"gen.isLoading()\">\n      Generate\n    </button>\n    @if (gen.videoStatus()) {\n      <p>Status: {{ gen.videoStatus()!.status }}</p>\n    }\n    @if (gen.result()) {\n      <video [src]=\"gen.result()!.url\" controls></video>\n    }\n  `,\n})\nexport class VideoComponent {\n  gen = injectGenerateVideo({\n    connection: fetchServerSentEvents(\"/api/generate/video\"),\n    onJobCreated: (jobId) => console.log(\"Job created:\", jobId),\n  });\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Additional returns (video only):"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"jobId: Signal<string | null>"},{"type":"text","value":" — The polling job ID, once the server creates it"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"videoStatus: Signal<VideoStatusInfo | null>"},{"type":"text","value":" — Real-time status updates from the polling loop"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"All generation injectables automatically clean up via "},{"type":"inlineCode","value":"DestroyRef.onDestroy"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"injection-context","children":[{"type":"text","value":"Injection Context"}]},{"type":"paragraph","children":[{"type":"text","value":"Angular's DI system requires that "},{"type":"inlineCode","value":"inject()"},{"type":"text","value":" is called during component construction. Every "},{"type":"inlineCode","value":"inject*"},{"type":"text","value":" function in this package calls "},{"type":"inlineCode","value":"inject()"},{"type":"text","value":" internally. Valid call sites:"}]},{"type":"code","value":"import { inject, runInInjectionContext, Injector } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\nconst injector = inject(Injector);\n\n// Field initializer (recommended)\nexport class MyComponent {\n  chat = injectChat({ connection: fetchServerSentEvents(\"/api/chat\") });\n}\n\n// Constructor\nexport class MyComponentAlt {\n  chat: ReturnType<typeof injectChat>;\n  constructor() {\n    this.chat = injectChat({ connection: fetchServerSentEvents(\"/api/chat\") });\n  }\n}\n\n// Inside runInInjectionContext\nconst chat = runInInjectionContext(injector, () =>\n  injectChat({ connection: fetchServerSentEvents(\"/api/chat\") }),\n);","lang":"typescript"},{"type":"heading","depth":2,"id":"createchatclientoptions-options","children":[{"type":"inlineCode","value":"createChatClientOptions(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Helper to create typed chat options (re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":")."}]},{"type":"code","value":"import {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-angular\";\nimport { tool1, tool2 } from \"./tools\";\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [tool1, tool2];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\ntype Messages = InferChatMessages<typeof chatOptions>;","lang":"typescript"},{"type":"heading","depth":2,"id":"types","children":[{"type":"text","value":"Types"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-angular"},{"type":"text","value":" (sourced from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":"):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"UIMessage<TTools>"},{"type":"text","value":" - Message type with tool type parameter"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"InjectChatOptions<TTools, TSchema, TContext>"},{"type":"text","value":" - Chat injectable options"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"InjectChatResult<TTools, TSchema>"},{"type":"text","value":" - Chat injectable return type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveOption<T>"},{"type":"text","value":" - Union of "},{"type":"inlineCode","value":"T | Signal<T> | (() => T)"},{"type":"text","value":" for reactive option fields"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"DeepPartial<T>"},{"type":"text","value":" - Recursive partial; used to type the in-flight "},{"type":"inlineCode","value":"partial"},{"type":"text","value":" value"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ChatRequestBody"},{"type":"text","value":" - Request body type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"MultimodalContent"},{"type":"text","value":" - Multimodal content type for "},{"type":"inlineCode","value":"sendMessage"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ConnectionAdapter"},{"type":"text","value":" - Connection adapter interface"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"InferChatMessages<T>"},{"type":"text","value":" - Extract message type from options"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"GenerationClientState"},{"type":"text","value":" - Generation lifecycle state"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ImageGenerateInput"},{"type":"text","value":" - Image generation input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"AudioGenerateInput"},{"type":"text","value":" - Audio generation input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SpeechGenerateInput"},{"type":"text","value":" - Speech generation input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TranscriptionGenerateInput"},{"type":"text","value":" - Transcription input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SummarizeGenerateInput"},{"type":"text","value":" - Summarization input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"VideoGenerateInput"},{"type":"text","value":" - Video generation input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"VideoGenerateResult"},{"type":"text","value":" - Video generation result type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"VideoStatusInfo"},{"type":"text","value":" - Video job status info"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Tool authoring types — import directly from "},{"type":"inlineCode","value":"@tanstack/ai"},{"type":"text","value":" (not re-exported by "},{"type":"inlineCode","value":"@tanstack/ai-angular"},{"type":"text","value":"):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"toolDefinition()"},{"type":"text","value":" - Create isomorphic tool definition"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ToolDefinitionInstance"},{"type":"text","value":" - Tool definition type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ClientTool"},{"type":"text","value":" - Client tool type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ServerTool"},{"type":"text","value":" - Server tool type"}]}]}]},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Getting Started"}]},{"type":"text","value":" - Learn the basics"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools Guide"}]},{"type":"text","value":" - Learn about the isomorphic tool system"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/client-tools","children":[{"type":"text","value":"Client Tools"}]},{"type":"text","value":" - Learn about client-side tools"}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"injectregisterwebmcptools-tools-options","text":"injectRegisterWebMCPTools(tools, options?)","level":2},{"id":"injectpagewebmcptools-options","text":"injectPageWebMCPTools(options?)","level":2},{"id":"injectchat-options","text":"injectChat(options?)","level":2},{"id":"options","text":"Options","level":3},{"id":"returns","text":"Returns","level":3},{"id":"injectbyok-client","text":"injectByok(client)","level":2},{"id":"connection-adapters","text":"Connection Adapters","level":2},{"id":"example-basic-chat","text":"Example: Basic Chat","level":2},{"id":"example-tool-approval","text":"Example: Tool Approval","level":2},{"id":"example-client-tools-with-type-safety","text":"Example: Client Tools with Type Safety","level":2},{"id":"example-reactive-options-with-signals","text":"Example: Reactive Options with Signals","level":2},{"id":"example-structured-output","text":"Example: Structured Output","level":2},{"id":"generation-injectables","text":"Generation Injectables","level":2},{"id":"injectgeneration-options","text":"injectGeneration(options)","level":3},{"id":"injectgenerateimage-options","text":"injectGenerateImage(options)","level":3},{"id":"injectgenerateaudio-options","text":"injectGenerateAudio(options)","level":3},{"id":"injectgeneratespeech-options","text":"injectGenerateSpeech(options)","level":3},{"id":"injecttranscription-options","text":"injectTranscription(options)","level":3},{"id":"injectsummarize-options","text":"injectSummarize(options)","level":3},{"id":"injectgeneratevideo-options","text":"injectGenerateVideo(options)","level":3},{"id":"injection-context","text":"Injection Context","level":2},{"id":"createchatclientoptions-options","text":"createChatClientOptions(options)","level":2},{"id":"types","text":"Types","level":2},{"id":"next-steps","text":"Next Steps","level":2}]},"frameworks":["angular"],"downloadMarkdown":"\nAngular signal-based bindings for TanStack AI, providing convenient Angular bindings for the headless client.\n\n> **Injection context requirement:** Every `inject*` function in this package calls Angular's `inject()` internally. They **must** be called within an Angular injection context — a component or directive class field initializer, the constructor, or inside `runInInjectionContext`. Calling them outside an injection context will throw a runtime error.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nangular: @tanstack/ai-angular\n\n<!-- ::end:tabs -->\n\n## `injectRegisterWebMCPTools(tools, options?)`\n\nRegister executable client tools for the current Angular injection owner. Angular removes them when it destroys that owner.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport {\n  injectRegisterWebMCPTools,\n  type InjectRegisterWebMCPToolsOptions,\n} from \"@tanstack/ai-angular\";\nimport { searchProducts } from \"./tools\";\n\nconst tools = [searchProducts];\nconst options: InjectRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error);\n  },\n};\n\n@Component({ selector: \"app-products\", standalone: true, template: \"\" })\nexport class ProductsComponent {\n  registration = injectRegisterWebMCPTools(tools, options);\n}\n```\n\n`InjectRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The injectable owns the registration signal.\n\nThe `context` field is required when a tool declares a required runtime context. Call this function only in an Angular injection context.\n\n## `injectPageWebMCPTools(options?)`\n\nRead the WebMCP tools on the page as client tools. The signal starts empty and updates when the page adds or removes a tool. Pass the signal to `injectChat` as `tools`. Call it in an injection context.\n\n```ts\nimport { Component } from \"@angular/core\";\nimport { injectPageWebMCPTools } from \"@tanstack/ai-angular\";\n\n@Component({ selector: \"app-page-tools\", standalone: true, template: \"\" })\nexport class PageTools {\n  pageTools = injectPageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  });\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## `injectChat(options?)`\n\nMain injectable for managing chat state in Angular with full type safety.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-chat\",\n  standalone: true,\n  template: `...`,\n})\nexport class ChatComponent {\n  // injectChat is called in a field initializer — valid injection context.\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n}\n```\n\n### Options\n\nExtends `ChatClientOptions` from `@tanstack/ai-client` (minus internal state callbacks):\n\n- `connection` - Connection adapter (required, or use `fetcher`)\n- `fetcher?` - Direct async function for one-shot generation (alternative to `connection`)\n- `tools?` - Array of client tool implementations (with `.client()` method). Reactive: pass a `Signal` or getter to change the tools after the chat is created.\n- `initialMessages?` - Initial messages array\n- `threadId?` - The only identity for this chat. Required when persistence is on. If omitted, minted after mount.\n- `forwardedProps?` - Arbitrary client-controlled JSON forwarded to the server in the AG-UI `RunAgentInput.forwardedProps` field. Reactive — accepts a plain value, an Angular `Signal`, or a zero-arg getter; changes sync automatically via `effect`\n- `body?` - **Deprecated.** Use `forwardedProps` instead. Still works for backward compatibility; values are merged into `forwardedProps` on the wire. Reactive (same forms as `forwardedProps`)\n- `byok?` - Optional BYOK keyring from `defineByok`. On each send the client prepares the resolved provider and stamps `x-byok-*` request headers. Keys never go in the body\n- `byokProvider?` - Optional function that returns the provider slug for this chat. If it returns a slug, only that key is prepared and sent. Otherwise the merged `provider` from `forwardedProps`, `body`, and per-call `sendMessage` `body` is used. Later sources win. If no slug resolves, the send throws instead of attaching every stored key\n- `context?` - Typed client-local runtime context passed to client tool implementations. Reactive (same forms). This value is not serialized to the server\n- `live?` - Enable live subscription mode (auto-subscribes/unsubscribes). Reactive (same forms)\n- `outputSchema?` - Standard-schema-compatible schema (Zod, Valibot, ArkType, or JSON Schema). When provided, adds typed `partial` and `final` signals to the return value\n- `persistence?` - Persistence configuration\n- `devtools?` - Display options for TanStack AI Devtools\n- `onResponse?` - Callback when response is received\n- `onChunk?` - Callback when stream chunk is received\n- `onFinish?` - Callback when response finishes\n- `onError?` - Callback when error occurs\n- `onInterruptStateChange?` - Callback when interrupt state changes; context source is `hydrate` for restored state and `live` for streamed or client-initiated updates\n- `onCustomEvent?` - Callback for custom stream events\n- `streamProcessor?` - Stream processing configuration\n\n**Reactive options** (`body`, `forwardedProps`, `context`, `live`) accept a `ReactiveOption<T>`, which is one of:\n\n```typescript\nimport type { Signal } from \"@angular/core\";\n\ntype ReactiveOption<T> = T | Signal<T> | (() => T);\n```\n\nA plain value becomes a constant; a `Signal` is read directly; a zero-arg getter is wrapped in `computed` so any signals read inside it are tracked.\n\n**Note:** Client tools are automatically executed — no `onToolCall` callback needed!\n\n### Returns\n\n```typescript\nimport type { Signal } from \"@angular/core\";\nimport type {\n  UIMessage,\n  MultimodalContent,\n  DeepPartial,\n} from \"@tanstack/ai-angular\";\nimport type { ModelMessage, InferSchemaType } from \"@tanstack/ai/client\";\nimport type {\n  ChatClientState,\n  ConnectionStatus,\n  SendMessageOptions,\n} from \"@tanstack/ai-client\";\ntype TSchema = any;\n\ninterface InjectChatResult {\n  messages: Signal<UIMessage[]>;\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>;\n  append: (message: ModelMessage | UIMessage) => Promise<void>;\n  addToolResult: (result: {\n    toolCallId: string;\n    tool: string;\n    output: any;\n    state?: \"output-available\" | \"output-error\";\n    errorText?: string;\n  }) => Promise<void>;\n  addToolApprovalResponse: (response: {\n    id: string;\n    approved: boolean;\n  }) => Promise<void>;\n  reload: () => Promise<void>;\n  stop: () => void;\n  clear: () => void;\n  setMessages: (messages: UIMessage[]) => void;\n  isLoading: Signal<boolean>;\n  error: Signal<Error | undefined>;\n  status: Signal<ChatClientState>;\n  isSubscribed: Signal<boolean>;\n  connectionStatus: Signal<ConnectionStatus>;\n  sessionGenerating: Signal<boolean>;\n  isHydrating: Signal<boolean>;\n  // Only present when outputSchema is supplied:\n  partial: Signal<DeepPartial<InferSchemaType<TSchema>>>;\n  final: Signal<InferSchemaType<TSchema> | null>;\n}\n```\n\n**Note:** All reactive state (`messages`, `isLoading`, `error`, `status`, `isSubscribed`, `connectionStatus`, `sessionGenerating`, `isHydrating`) is exposed as read-only Angular `Signal`s. Read them by calling them as functions (e.g., `chat.messages()`, `chat.isLoading()`). Cleanup is automatic via `DestroyRef.onDestroy`.\n\n## `injectByok(client)`\n\nSubscribe to a `ByokClient` snapshot in Angular. Call it in an injection context. The return value is a read-only `Signal`.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectByok } from \"@tanstack/ai-angular\";\nimport { byok } from \"./byok\";\n\n@Component({\n  selector: \"app-key-status\",\n  standalone: true,\n  template: `<p>{{ last4() }}</p>`,\n})\nexport class KeyStatusComponent {\n  snapshot = injectByok(byok);\n\n  last4() {\n    const openai = this.snapshot().status.openai;\n    return openai && \"masked\" in openai ? openai.masked : \"No key\";\n  }\n}\n```\n\n`snapshot()` has `status`, `locked`, and `prompt`. Call `byok.update(provider, value)` from your own UI to save a key. See [Bring Your Own Key](../advanced/byok).\n\n## Connection Adapters\n\nRe-exported from `@tanstack/ai-client` for convenience:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  xhrServerSentEvents,\n  xhrHttpStream,\n  stream,\n  rpcStream,\n  type ConnectionAdapter,\n} from \"@tanstack/ai-angular\";\n```\n\n## Example: Basic Chat\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { CommonModule } from \"@angular/common\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-chat\",\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    <ul>\n      @for (message of chat.messages(); track message.id) {\n        <li>\n          <strong>{{ message.role }}:</strong>\n          @for (part of message.parts; track $index) {\n            @if (part.type === 'thinking') {\n              <em>Thinking: {{ part.content }}</em>\n            } @else if (part.type === 'text') {\n              <span>{{ part.content }}</span>\n            }\n          }\n        </li>\n      }\n    </ul>\n    <input #input placeholder=\"Type a message...\" />\n    <button\n      (click)=\"chat.sendMessage(input.value); input.value = ''\"\n      [disabled]=\"chat.isLoading()\"\n    >\n      Send\n    </button>\n    @if (chat.isLoading()) {\n      <p>Thinking...</p>\n    }\n  `,\n})\nexport class ChatComponent {\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n}\n```\n\n## Example: Tool Approval\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { CommonModule } from \"@angular/common\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-approval-chat\",\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    @for (message of chat.messages(); track message.id) {\n      @for (part of message.parts; track $index) {\n        @if (\n          part.type === 'tool-call' &&\n          part.state === 'approval-requested' &&\n          part.approval\n        ) {\n          <div>\n            <p>Approve: {{ part.name }}</p>\n            <button (click)=\"chat.addToolApprovalResponse({ id: part.approval!.id, approved: true })\">\n              Approve\n            </button>\n            <button (click)=\"chat.addToolApprovalResponse({ id: part.approval!.id, approved: false })\">\n              Deny\n            </button>\n          </div>\n        }\n      }\n    }\n  `,\n})\nexport class ApprovalChatComponent {\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n}\n```\n\n## Example: Client Tools with Type Safety\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { CommonModule } from \"@angular/common\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Show a notification in the UI\",\n  inputSchema: z.object({ message: z.string(), type: z.string() }),\n});\n\nconst saveToStorageDef = toolDefinition({\n  name: \"saveToStorage\",\n  description: \"Save a value to localStorage\",\n  inputSchema: z.object({ key: z.string(), value: z.string() }),\n});\n\n@Component({\n  selector: \"app-typed-chat\",\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    @for (message of chat.messages(); track message.id) {\n      @for (part of message.parts; track $index) {\n        @if (part.type === 'tool-call' && part.name === 'updateUI') {\n          <div>Tool executed: {{ part.name }}</div>\n        }\n      }\n    }\n  `,\n})\nexport class TypedChatComponent {\n  // Create client implementations\n  private updateUI = updateUIDef.client((input) => {\n    // input is fully typed!\n    return { success: true };\n  });\n\n  private saveToStorage = saveToStorageDef.client((input) => {\n    localStorage.setItem(input.key, input.value);\n    return { saved: true };\n  });\n\n  // Create typed tools array (no 'as const' needed!)\n  private tools = [this.updateUI, this.saveToStorage];\n\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    tools: this.tools, // Automatic execution, full type safety\n  });\n}\n```\n\n## Example: Reactive Options with Signals\n\n```typescript\nimport { Component, signal } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-reactive-chat\",\n  standalone: true,\n  template: `\n    <button (click)=\"toggleLanguage()\">Toggle Language</button>\n    @for (message of chat.messages(); track message.id) {\n      <p>{{ message.role }}: {{ message.parts[0]?.content }}</p>\n    }\n  `,\n})\nexport class ReactiveChatComponent {\n  language = signal(\"en\");\n\n  // forwardedProps is reactive — the signal is read on every request\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    forwardedProps: () => ({ language: this.language() }),\n  });\n\n  toggleLanguage() {\n    this.language.set(this.language() === \"en\" ? \"fr\" : \"en\");\n  }\n}\n```\n\n## Example: Structured Output\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\nimport { z } from \"zod\";\n\nconst recipeSchema = z.object({\n  title: z.string(),\n  ingredients: z.array(z.string()),\n  steps: z.array(z.string()),\n});\n\n@Component({\n  selector: \"app-recipe-chat\",\n  standalone: true,\n  template: `\n    <button (click)=\"chat.sendMessage('Give me a pasta recipe')\">Ask</button>\n    @if (chat.partial().title) {\n      <h2>{{ chat.partial().title }}</h2>\n    }\n    @if (chat.final()) {\n      <ul>\n        @for (step of chat.final()!.steps; track $index) {\n          <li>{{ step }}</li>\n        }\n      </ul>\n    }\n  `,\n})\nexport class RecipeChatComponent {\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    outputSchema: recipeSchema,\n  });\n}\n```\n\n## Generation Injectables\n\nAngular injectables for one-shot generation tasks (images, audio, speech, transcription, summarization, video). All share the same pattern: provide a `connection` or `fetcher`, call `generate()`, and read reactive signals.\n\n### `injectGeneration(options)`\n\nBase injectable for custom generation types. All specialized injectables below are built on this.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectGeneration } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({ selector: \"app-custom\", standalone: true, template: `...` })\nexport class CustomGenerationComponent {\n  gen = injectGeneration({\n    connection: fetchServerSentEvents(\"/api/generate/custom\"),\n  });\n\n  // Call gen.generate(input), read gen.result(), gen.isLoading(), etc.\n}\n```\n\n**Options:** `connection?`, `fetcher?`, `threadId?`, `body?` (reactive), `devtools?`, `onResult?`, `onError?`, `onProgress?`, `onChunk?`\n\n**Returns:** `generate`, `result`, `isLoading`, `error`, `status`, `stop`, `reset`, `runId`. All reactive state is a read-only `Signal<T>`.\n\n### `injectGenerateImage(options)`\n\nImage generation injectable. `generate()` accepts `ImageGenerateInput`, result is `ImageGenerationResult`.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectGenerateImage } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({\n  selector: \"app-image\",\n  standalone: true,\n  template: `\n    <button (click)=\"gen.generate({ prompt: 'A mountain at sunset' })\" [disabled]=\"gen.isLoading()\">\n      Generate\n    </button>\n    @if (gen.result()) {\n      <img [src]=\"gen.result()!.images[0]!.url\" alt=\"Generated image\" />\n    }\n  `,\n})\nexport class ImageComponent {\n  gen = injectGenerateImage({\n    connection: fetchServerSentEvents(\"/api/generate/image\"),\n  });\n}\n```\n\n### `injectGenerateAudio(options)`\n\nAudio generation injectable (music, sound effects). `generate()` accepts `AudioGenerateInput`, result is `AudioGenerationResult`.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectGenerateAudio } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({\n  selector: \"app-audio\",\n  standalone: true,\n  template: `\n    <button (click)=\"gen.generate({ prompt: 'An upbeat electronic track', duration: 10 })\" [disabled]=\"gen.isLoading()\">\n      Generate\n    </button>\n    @if (gen.result()) {\n      <audio [src]=\"gen.result()!.audio.url\" controls></audio>\n    }\n  `,\n})\nexport class AudioComponent {\n  gen = injectGenerateAudio({\n    connection: fetchServerSentEvents(\"/api/generate/audio\"),\n  });\n}\n```\n\n### `injectGenerateSpeech(options)`\n\nText-to-speech injectable. `generate()` accepts `SpeechGenerateInput`, result is `TTSResult`.\n\n### `injectTranscription(options)`\n\nAudio transcription injectable. `generate()` accepts `TranscriptionGenerateInput`, result is `TranscriptionResult`.\n\n### `injectSummarize(options)`\n\nText summarization injectable. `generate()` accepts `SummarizeGenerateInput`, result is `SummarizationResult`.\n\n### `injectGenerateVideo(options)`\n\nVideo generation injectable with job polling. Returns additional `jobId` and `videoStatus` signals. Accepts extra `onJobCreated?` and `onStatusUpdate?` callbacks.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectGenerateVideo } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({\n  selector: \"app-video\",\n  standalone: true,\n  template: `\n    <button (click)=\"gen.generate({ prompt: 'A time-lapse of a sunset' })\" [disabled]=\"gen.isLoading()\">\n      Generate\n    </button>\n    @if (gen.videoStatus()) {\n      <p>Status: {{ gen.videoStatus()!.status }}</p>\n    }\n    @if (gen.result()) {\n      <video [src]=\"gen.result()!.url\" controls></video>\n    }\n  `,\n})\nexport class VideoComponent {\n  gen = injectGenerateVideo({\n    connection: fetchServerSentEvents(\"/api/generate/video\"),\n    onJobCreated: (jobId) => console.log(\"Job created:\", jobId),\n  });\n}\n```\n\n**Additional returns (video only):**\n- `jobId: Signal<string | null>` — The polling job ID, once the server creates it\n- `videoStatus: Signal<VideoStatusInfo | null>` — Real-time status updates from the polling loop\n\nAll generation injectables automatically clean up via `DestroyRef.onDestroy`.\n\n## Injection Context\n\nAngular's DI system requires that `inject()` is called during component construction. Every `inject*` function in this package calls `inject()` internally. Valid call sites:\n\n```typescript\nimport { inject, runInInjectionContext, Injector } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\nconst injector = inject(Injector);\n\n// Field initializer (recommended)\nexport class MyComponent {\n  chat = injectChat({ connection: fetchServerSentEvents(\"/api/chat\") });\n}\n\n// Constructor\nexport class MyComponentAlt {\n  chat: ReturnType<typeof injectChat>;\n  constructor() {\n    this.chat = injectChat({ connection: fetchServerSentEvents(\"/api/chat\") });\n  }\n}\n\n// Inside runInInjectionContext\nconst chat = runInInjectionContext(injector, () =>\n  injectChat({ connection: fetchServerSentEvents(\"/api/chat\") }),\n);\n```\n\n## `createChatClientOptions(options)`\n\nHelper to create typed chat options (re-exported from `@tanstack/ai-client`).\n\n```typescript\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-angular\";\nimport { tool1, tool2 } from \"./tools\";\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [tool1, tool2];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\ntype Messages = InferChatMessages<typeof chatOptions>;\n```\n\n## Types\n\nRe-exported from `@tanstack/ai-angular` (sourced from `@tanstack/ai-client`):\n\n- `UIMessage<TTools>` - Message type with tool type parameter\n- `InjectChatOptions<TTools, TSchema, TContext>` - Chat injectable options\n- `InjectChatResult<TTools, TSchema>` - Chat injectable return type\n- `ReactiveOption<T>` - Union of `T | Signal<T> | (() => T)` for reactive option fields\n- `DeepPartial<T>` - Recursive partial; used to type the in-flight `partial` value\n- `ChatRequestBody` - Request body type\n- `MultimodalContent` - Multimodal content type for `sendMessage`\n- `ConnectionAdapter` - Connection adapter interface\n- `InferChatMessages<T>` - Extract message type from options\n- `GenerationClientState` - Generation lifecycle state\n- `ImageGenerateInput` - Image generation input type\n- `AudioGenerateInput` - Audio generation input type\n- `SpeechGenerateInput` - Speech generation input type\n- `TranscriptionGenerateInput` - Transcription input type\n- `SummarizeGenerateInput` - Summarization input type\n- `VideoGenerateInput` - Video generation input type\n- `VideoGenerateResult` - Video generation result type\n- `VideoStatusInfo` - Video job status info\n\nTool authoring types — import directly from `@tanstack/ai` (not re-exported by `@tanstack/ai-angular`):\n\n- `toolDefinition()` - Create isomorphic tool definition\n- `ToolDefinitionInstance` - Tool definition type\n- `ClientTool` - Client tool type\n- `ServerTool` - Server tool type\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about the isomorphic tool system\n- [Client Tools](../tools/client-tools) - Learn about client-side tools\n","originalRawMarkdown":"---\ntitle: \"@tanstack/ai-angular\"\nid: ai-angular\norder: 6\ndescription: \"API reference for @tanstack/ai-angular — Angular signal-based injectables including injectChat for streaming chat with full type safety.\"\nkeywords:\n  - tanstack ai\n  - \"@tanstack/ai-angular\"\n  - angular\n  - signals\n  - injectChat\n  - injectables\n  - api reference\n---\n\nAngular signal-based bindings for TanStack AI, providing convenient Angular bindings for the headless client.\n\n> **Injection context requirement:** Every `inject*` function in this package calls Angular's `inject()` internally. They **must** be called within an Angular injection context — a component or directive class field initializer, the constructor, or inside `runInInjectionContext`. Calling them outside an injection context will throw a runtime error.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nangular: @tanstack/ai-angular\n\n<!-- ::end:tabs -->\n\n## `injectRegisterWebMCPTools(tools, options?)`\n\nRegister executable client tools for the current Angular injection owner. Angular removes them when it destroys that owner.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport {\n  injectRegisterWebMCPTools,\n  type InjectRegisterWebMCPToolsOptions,\n} from \"@tanstack/ai-angular\";\nimport { searchProducts } from \"./tools\";\n\nconst tools = [searchProducts];\nconst options: InjectRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error);\n  },\n};\n\n@Component({ selector: \"app-products\", standalone: true, template: \"\" })\nexport class ProductsComponent {\n  registration = injectRegisterWebMCPTools(tools, options);\n}\n```\n\n`InjectRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The injectable owns the registration signal.\n\nThe `context` field is required when a tool declares a required runtime context. Call this function only in an Angular injection context.\n\n## `injectPageWebMCPTools(options?)`\n\nRead the WebMCP tools on the page as client tools. The signal starts empty and updates when the page adds or removes a tool. Pass the signal to `injectChat` as `tools`. Call it in an injection context.\n\n```ts\nimport { Component } from \"@angular/core\";\nimport { injectPageWebMCPTools } from \"@tanstack/ai-angular\";\n\n@Component({ selector: \"app-page-tools\", standalone: true, template: \"\" })\nexport class PageTools {\n  pageTools = injectPageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  });\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## `injectChat(options?)`\n\nMain injectable for managing chat state in Angular with full type safety.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-chat\",\n  standalone: true,\n  template: `...`,\n})\nexport class ChatComponent {\n  // injectChat is called in a field initializer — valid injection context.\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n}\n```\n\n### Options\n\nExtends `ChatClientOptions` from `@tanstack/ai-client` (minus internal state callbacks):\n\n- `connection` - Connection adapter (required, or use `fetcher`)\n- `fetcher?` - Direct async function for one-shot generation (alternative to `connection`)\n- `tools?` - Array of client tool implementations (with `.client()` method). Reactive: pass a `Signal` or getter to change the tools after the chat is created.\n- `initialMessages?` - Initial messages array\n- `threadId?` - The only identity for this chat. Required when persistence is on. If omitted, minted after mount.\n- `forwardedProps?` - Arbitrary client-controlled JSON forwarded to the server in the AG-UI `RunAgentInput.forwardedProps` field. Reactive — accepts a plain value, an Angular `Signal`, or a zero-arg getter; changes sync automatically via `effect`\n- `body?` - **Deprecated.** Use `forwardedProps` instead. Still works for backward compatibility; values are merged into `forwardedProps` on the wire. Reactive (same forms as `forwardedProps`)\n- `byok?` - Optional BYOK keyring from `defineByok`. On each send the client prepares the resolved provider and stamps `x-byok-*` request headers. Keys never go in the body\n- `byokProvider?` - Optional function that returns the provider slug for this chat. If it returns a slug, only that key is prepared and sent. Otherwise the merged `provider` from `forwardedProps`, `body`, and per-call `sendMessage` `body` is used. Later sources win. If no slug resolves, the send throws instead of attaching every stored key\n- `context?` - Typed client-local runtime context passed to client tool implementations. Reactive (same forms). This value is not serialized to the server\n- `live?` - Enable live subscription mode (auto-subscribes/unsubscribes). Reactive (same forms)\n- `outputSchema?` - Standard-schema-compatible schema (Zod, Valibot, ArkType, or JSON Schema). When provided, adds typed `partial` and `final` signals to the return value\n- `persistence?` - Persistence configuration\n- `devtools?` - Display options for TanStack AI Devtools\n- `onResponse?` - Callback when response is received\n- `onChunk?` - Callback when stream chunk is received\n- `onFinish?` - Callback when response finishes\n- `onError?` - Callback when error occurs\n- `onInterruptStateChange?` - Callback when interrupt state changes; context source is `hydrate` for restored state and `live` for streamed or client-initiated updates\n- `onCustomEvent?` - Callback for custom stream events\n- `streamProcessor?` - Stream processing configuration\n\n**Reactive options** (`body`, `forwardedProps`, `context`, `live`) accept a `ReactiveOption<T>`, which is one of:\n\n```typescript\nimport type { Signal } from \"@angular/core\";\n\ntype ReactiveOption<T> = T | Signal<T> | (() => T);\n```\n\nA plain value becomes a constant; a `Signal` is read directly; a zero-arg getter is wrapped in `computed` so any signals read inside it are tracked.\n\n**Note:** Client tools are automatically executed — no `onToolCall` callback needed!\n\n### Returns\n\n```typescript\nimport type { Signal } from \"@angular/core\";\nimport type {\n  UIMessage,\n  MultimodalContent,\n  DeepPartial,\n} from \"@tanstack/ai-angular\";\nimport type { ModelMessage, InferSchemaType } from \"@tanstack/ai/client\";\nimport type {\n  ChatClientState,\n  ConnectionStatus,\n  SendMessageOptions,\n} from \"@tanstack/ai-client\";\ntype TSchema = any;\n\ninterface InjectChatResult {\n  messages: Signal<UIMessage[]>;\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>;\n  append: (message: ModelMessage | UIMessage) => Promise<void>;\n  addToolResult: (result: {\n    toolCallId: string;\n    tool: string;\n    output: any;\n    state?: \"output-available\" | \"output-error\";\n    errorText?: string;\n  }) => Promise<void>;\n  addToolApprovalResponse: (response: {\n    id: string;\n    approved: boolean;\n  }) => Promise<void>;\n  reload: () => Promise<void>;\n  stop: () => void;\n  clear: () => void;\n  setMessages: (messages: UIMessage[]) => void;\n  isLoading: Signal<boolean>;\n  error: Signal<Error | undefined>;\n  status: Signal<ChatClientState>;\n  isSubscribed: Signal<boolean>;\n  connectionStatus: Signal<ConnectionStatus>;\n  sessionGenerating: Signal<boolean>;\n  isHydrating: Signal<boolean>;\n  // Only present when outputSchema is supplied:\n  partial: Signal<DeepPartial<InferSchemaType<TSchema>>>;\n  final: Signal<InferSchemaType<TSchema> | null>;\n}\n```\n\n**Note:** All reactive state (`messages`, `isLoading`, `error`, `status`, `isSubscribed`, `connectionStatus`, `sessionGenerating`, `isHydrating`) is exposed as read-only Angular `Signal`s. Read them by calling them as functions (e.g., `chat.messages()`, `chat.isLoading()`). Cleanup is automatic via `DestroyRef.onDestroy`.\n\n## `injectByok(client)`\n\nSubscribe to a `ByokClient` snapshot in Angular. Call it in an injection context. The return value is a read-only `Signal`.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectByok } from \"@tanstack/ai-angular\";\nimport { byok } from \"./byok\";\n\n@Component({\n  selector: \"app-key-status\",\n  standalone: true,\n  template: `<p>{{ last4() }}</p>`,\n})\nexport class KeyStatusComponent {\n  snapshot = injectByok(byok);\n\n  last4() {\n    const openai = this.snapshot().status.openai;\n    return openai && \"masked\" in openai ? openai.masked : \"No key\";\n  }\n}\n```\n\n`snapshot()` has `status`, `locked`, and `prompt`. Call `byok.update(provider, value)` from your own UI to save a key. See [Bring Your Own Key](../advanced/byok).\n\n## Connection Adapters\n\nRe-exported from `@tanstack/ai-client` for convenience:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  xhrServerSentEvents,\n  xhrHttpStream,\n  stream,\n  rpcStream,\n  type ConnectionAdapter,\n} from \"@tanstack/ai-angular\";\n```\n\n## Example: Basic Chat\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { CommonModule } from \"@angular/common\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-chat\",\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    <ul>\n      @for (message of chat.messages(); track message.id) {\n        <li>\n          <strong>{{ message.role }}:</strong>\n          @for (part of message.parts; track $index) {\n            @if (part.type === 'thinking') {\n              <em>Thinking: {{ part.content }}</em>\n            } @else if (part.type === 'text') {\n              <span>{{ part.content }}</span>\n            }\n          }\n        </li>\n      }\n    </ul>\n    <input #input placeholder=\"Type a message...\" />\n    <button\n      (click)=\"chat.sendMessage(input.value); input.value = ''\"\n      [disabled]=\"chat.isLoading()\"\n    >\n      Send\n    </button>\n    @if (chat.isLoading()) {\n      <p>Thinking...</p>\n    }\n  `,\n})\nexport class ChatComponent {\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n}\n```\n\n## Example: Tool Approval\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { CommonModule } from \"@angular/common\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-approval-chat\",\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    @for (message of chat.messages(); track message.id) {\n      @for (part of message.parts; track $index) {\n        @if (\n          part.type === 'tool-call' &&\n          part.state === 'approval-requested' &&\n          part.approval\n        ) {\n          <div>\n            <p>Approve: {{ part.name }}</p>\n            <button (click)=\"chat.addToolApprovalResponse({ id: part.approval!.id, approved: true })\">\n              Approve\n            </button>\n            <button (click)=\"chat.addToolApprovalResponse({ id: part.approval!.id, approved: false })\">\n              Deny\n            </button>\n          </div>\n        }\n      }\n    }\n  `,\n})\nexport class ApprovalChatComponent {\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n}\n```\n\n## Example: Client Tools with Type Safety\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { CommonModule } from \"@angular/common\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Show a notification in the UI\",\n  inputSchema: z.object({ message: z.string(), type: z.string() }),\n});\n\nconst saveToStorageDef = toolDefinition({\n  name: \"saveToStorage\",\n  description: \"Save a value to localStorage\",\n  inputSchema: z.object({ key: z.string(), value: z.string() }),\n});\n\n@Component({\n  selector: \"app-typed-chat\",\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    @for (message of chat.messages(); track message.id) {\n      @for (part of message.parts; track $index) {\n        @if (part.type === 'tool-call' && part.name === 'updateUI') {\n          <div>Tool executed: {{ part.name }}</div>\n        }\n      }\n    }\n  `,\n})\nexport class TypedChatComponent {\n  // Create client implementations\n  private updateUI = updateUIDef.client((input) => {\n    // input is fully typed!\n    return { success: true };\n  });\n\n  private saveToStorage = saveToStorageDef.client((input) => {\n    localStorage.setItem(input.key, input.value);\n    return { saved: true };\n  });\n\n  // Create typed tools array (no 'as const' needed!)\n  private tools = [this.updateUI, this.saveToStorage];\n\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    tools: this.tools, // Automatic execution, full type safety\n  });\n}\n```\n\n## Example: Reactive Options with Signals\n\n```typescript\nimport { Component, signal } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\n@Component({\n  selector: \"app-reactive-chat\",\n  standalone: true,\n  template: `\n    <button (click)=\"toggleLanguage()\">Toggle Language</button>\n    @for (message of chat.messages(); track message.id) {\n      <p>{{ message.role }}: {{ message.parts[0]?.content }}</p>\n    }\n  `,\n})\nexport class ReactiveChatComponent {\n  language = signal(\"en\");\n\n  // forwardedProps is reactive — the signal is read on every request\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    forwardedProps: () => ({ language: this.language() }),\n  });\n\n  toggleLanguage() {\n    this.language.set(this.language() === \"en\" ? \"fr\" : \"en\");\n  }\n}\n```\n\n## Example: Structured Output\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\nimport { z } from \"zod\";\n\nconst recipeSchema = z.object({\n  title: z.string(),\n  ingredients: z.array(z.string()),\n  steps: z.array(z.string()),\n});\n\n@Component({\n  selector: \"app-recipe-chat\",\n  standalone: true,\n  template: `\n    <button (click)=\"chat.sendMessage('Give me a pasta recipe')\">Ask</button>\n    @if (chat.partial().title) {\n      <h2>{{ chat.partial().title }}</h2>\n    }\n    @if (chat.final()) {\n      <ul>\n        @for (step of chat.final()!.steps; track $index) {\n          <li>{{ step }}</li>\n        }\n      </ul>\n    }\n  `,\n})\nexport class RecipeChatComponent {\n  chat = injectChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    outputSchema: recipeSchema,\n  });\n}\n```\n\n## Generation Injectables\n\nAngular injectables for one-shot generation tasks (images, audio, speech, transcription, summarization, video). All share the same pattern: provide a `connection` or `fetcher`, call `generate()`, and read reactive signals.\n\n### `injectGeneration(options)`\n\nBase injectable for custom generation types. All specialized injectables below are built on this.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectGeneration } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({ selector: \"app-custom\", standalone: true, template: `...` })\nexport class CustomGenerationComponent {\n  gen = injectGeneration({\n    connection: fetchServerSentEvents(\"/api/generate/custom\"),\n  });\n\n  // Call gen.generate(input), read gen.result(), gen.isLoading(), etc.\n}\n```\n\n**Options:** `connection?`, `fetcher?`, `threadId?`, `body?` (reactive), `devtools?`, `onResult?`, `onError?`, `onProgress?`, `onChunk?`\n\n**Returns:** `generate`, `result`, `isLoading`, `error`, `status`, `stop`, `reset`, `runId`. All reactive state is a read-only `Signal<T>`.\n\n### `injectGenerateImage(options)`\n\nImage generation injectable. `generate()` accepts `ImageGenerateInput`, result is `ImageGenerationResult`.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectGenerateImage } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({\n  selector: \"app-image\",\n  standalone: true,\n  template: `\n    <button (click)=\"gen.generate({ prompt: 'A mountain at sunset' })\" [disabled]=\"gen.isLoading()\">\n      Generate\n    </button>\n    @if (gen.result()) {\n      <img [src]=\"gen.result()!.images[0]!.url\" alt=\"Generated image\" />\n    }\n  `,\n})\nexport class ImageComponent {\n  gen = injectGenerateImage({\n    connection: fetchServerSentEvents(\"/api/generate/image\"),\n  });\n}\n```\n\n### `injectGenerateAudio(options)`\n\nAudio generation injectable (music, sound effects). `generate()` accepts `AudioGenerateInput`, result is `AudioGenerationResult`.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectGenerateAudio } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({\n  selector: \"app-audio\",\n  standalone: true,\n  template: `\n    <button (click)=\"gen.generate({ prompt: 'An upbeat electronic track', duration: 10 })\" [disabled]=\"gen.isLoading()\">\n      Generate\n    </button>\n    @if (gen.result()) {\n      <audio [src]=\"gen.result()!.audio.url\" controls></audio>\n    }\n  `,\n})\nexport class AudioComponent {\n  gen = injectGenerateAudio({\n    connection: fetchServerSentEvents(\"/api/generate/audio\"),\n  });\n}\n```\n\n### `injectGenerateSpeech(options)`\n\nText-to-speech injectable. `generate()` accepts `SpeechGenerateInput`, result is `TTSResult`.\n\n### `injectTranscription(options)`\n\nAudio transcription injectable. `generate()` accepts `TranscriptionGenerateInput`, result is `TranscriptionResult`.\n\n### `injectSummarize(options)`\n\nText summarization injectable. `generate()` accepts `SummarizeGenerateInput`, result is `SummarizationResult`.\n\n### `injectGenerateVideo(options)`\n\nVideo generation injectable with job polling. Returns additional `jobId` and `videoStatus` signals. Accepts extra `onJobCreated?` and `onStatusUpdate?` callbacks.\n\n```typescript\nimport { Component } from \"@angular/core\";\nimport { injectGenerateVideo } from \"@tanstack/ai-angular\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\n@Component({\n  selector: \"app-video\",\n  standalone: true,\n  template: `\n    <button (click)=\"gen.generate({ prompt: 'A time-lapse of a sunset' })\" [disabled]=\"gen.isLoading()\">\n      Generate\n    </button>\n    @if (gen.videoStatus()) {\n      <p>Status: {{ gen.videoStatus()!.status }}</p>\n    }\n    @if (gen.result()) {\n      <video [src]=\"gen.result()!.url\" controls></video>\n    }\n  `,\n})\nexport class VideoComponent {\n  gen = injectGenerateVideo({\n    connection: fetchServerSentEvents(\"/api/generate/video\"),\n    onJobCreated: (jobId) => console.log(\"Job created:\", jobId),\n  });\n}\n```\n\n**Additional returns (video only):**\n- `jobId: Signal<string | null>` — The polling job ID, once the server creates it\n- `videoStatus: Signal<VideoStatusInfo | null>` — Real-time status updates from the polling loop\n\nAll generation injectables automatically clean up via `DestroyRef.onDestroy`.\n\n## Injection Context\n\nAngular's DI system requires that `inject()` is called during component construction. Every `inject*` function in this package calls `inject()` internally. Valid call sites:\n\n```typescript\nimport { inject, runInInjectionContext, Injector } from \"@angular/core\";\nimport { injectChat, fetchServerSentEvents } from \"@tanstack/ai-angular\";\n\nconst injector = inject(Injector);\n\n// Field initializer (recommended)\nexport class MyComponent {\n  chat = injectChat({ connection: fetchServerSentEvents(\"/api/chat\") });\n}\n\n// Constructor\nexport class MyComponentAlt {\n  chat: ReturnType<typeof injectChat>;\n  constructor() {\n    this.chat = injectChat({ connection: fetchServerSentEvents(\"/api/chat\") });\n  }\n}\n\n// Inside runInInjectionContext\nconst chat = runInInjectionContext(injector, () =>\n  injectChat({ connection: fetchServerSentEvents(\"/api/chat\") }),\n);\n```\n\n## `createChatClientOptions(options)`\n\nHelper to create typed chat options (re-exported from `@tanstack/ai-client`).\n\n```typescript\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-angular\";\nimport { tool1, tool2 } from \"./tools\";\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [tool1, tool2];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\ntype Messages = InferChatMessages<typeof chatOptions>;\n```\n\n## Types\n\nRe-exported from `@tanstack/ai-angular` (sourced from `@tanstack/ai-client`):\n\n- `UIMessage<TTools>` - Message type with tool type parameter\n- `InjectChatOptions<TTools, TSchema, TContext>` - Chat injectable options\n- `InjectChatResult<TTools, TSchema>` - Chat injectable return type\n- `ReactiveOption<T>` - Union of `T | Signal<T> | (() => T)` for reactive option fields\n- `DeepPartial<T>` - Recursive partial; used to type the in-flight `partial` value\n- `ChatRequestBody` - Request body type\n- `MultimodalContent` - Multimodal content type for `sendMessage`\n- `ConnectionAdapter` - Connection adapter interface\n- `InferChatMessages<T>` - Extract message type from options\n- `GenerationClientState` - Generation lifecycle state\n- `ImageGenerateInput` - Image generation input type\n- `AudioGenerateInput` - Audio generation input type\n- `SpeechGenerateInput` - Speech generation input type\n- `TranscriptionGenerateInput` - Transcription input type\n- `SummarizeGenerateInput` - Summarization input type\n- `VideoGenerateInput` - Video generation input type\n- `VideoGenerateResult` - Video generation result type\n- `VideoStatusInfo` - Video job status info\n\nTool authoring types — import directly from `@tanstack/ai` (not re-exported by `@tanstack/ai-angular`):\n\n- `toolDefinition()` - Create isomorphic tool definition\n- `ToolDefinitionInstance` - Tool definition type\n- `ClientTool` - Client tool type\n- `ServerTool` - Server tool type\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about the isomorphic tool system\n- [Client Tools](../tools/client-tools) - Learn about client-side tools\n"}
