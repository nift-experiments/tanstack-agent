{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/ai-octane"},{"type":"text","value":", then call "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" the same way you would in React. The hook modules are "},{"type":"inlineCode","value":".tsrx"},{"type":"text","value":" and compile in your Octane plugin."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"octane\":[[\"@tanstack/ai-octane\",\"octane\"]]},\"mode\":\"install\"}"}},{"type":"paragraph","children":[{"type":"inlineCode","value":"octane"},{"type":"text","value":" is a required peer. This package publishes uncompiled source, like Svelte packages that ship "},{"type":"inlineCode","value":".svelte"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"useregisterwebmcptools-tools-options","children":[{"type":"inlineCode","value":"useRegisterWebMCPTools(tools, options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Register executable client tools after the Octane component mounts. Octane removes them on cleanup and replaces them when "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" or "},{"type":"inlineCode","value":"options"},{"type":"text","value":" change."}]},{"type":"paragraph","children":[{"type":"text","value":"For a complete setup and behavior guide, see "},{"type":"link","href":"../tools/webmcp","children":[{"type":"text","value":"WebMCP Tools"}]},{"type":"text","value":"."}]},{"type":"code","value":"import {\n  useRegisterWebMCPTools,\n  type UseRegisterWebMCPToolsOptions,\n} from '@tanstack/ai-octane'\nimport { searchProducts } from './tools'\n\nconst tools = [searchProducts]\nconst options: UseRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error)\n  },\n}\n\nfunction ProductsPage() {\n  useRegisterWebMCPTools(tools, options)\n  return null\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"UseRegisterWebMCPToolsOptions<TTools, TContext>"},{"type":"text","value":" contains "},{"type":"inlineCode","value":"toolOptions"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onError"},{"type":"text","value":". The hook owns the registration signal."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"context"},{"type":"text","value":" field is required when a tool declares a required runtime context. Keep "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" and "},{"type":"inlineCode","value":"options"},{"type":"text","value":" stable when their values do not change."}]},{"type":"heading","depth":2,"id":"usepagewebmcptools-options","children":[{"type":"inlineCode","value":"usePageWebMCPTools(options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Read the WebMCP tools on the page as client tools. The array starts empty and updates when the page adds or removes a tool. Pass it to "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" as "},{"type":"inlineCode","value":"tools"},{"type":"text","value":"."}]},{"type":"code","value":"import { usePageWebMCPTools } from \"@tanstack/ai-octane\"\n\nexport function useSameOriginPageTools() {\n  return usePageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  })\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"filter"},{"type":"text","value":" skips a tool when it returns "},{"type":"inlineCode","value":"false"},{"type":"text","value":". "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" gets a failed WebMCP read. For a complete guide, see "},{"type":"link","href":"../tools/webmcp-page-tools","children":[{"type":"text","value":"Page WebMCP Tools in Chat"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"usechat-options","children":[{"type":"inlineCode","value":"useChat(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Manages chat state in an Octane component."}]},{"type":"code","value":"import { useState } from 'octane'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-octane'\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from '@tanstack/ai-client'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst updateUIDef = toolDefinition({\n  name: 'updateUI',\n  description: 'Show a notification in the UI',\n  inputSchema: z.object({ message: z.string() }),\n})\n\nexport function ChatComponent() {\n  const [notification, setNotification] = useState<string | null>(null)\n  const updateUI = updateUIDef.client((input) => {\n    setNotification(input.message)\n    return { success: true }\n  })\n  const tools = [updateUI]\n\n  const chatOptions = createChatClientOptions({\n    connection: fetchServerSentEvents('/api/chat'),\n    tools,\n  })\n\n  type ChatMessages = InferChatMessages<typeof chatOptions>\n\n  const { messages, sendMessage, isLoading, error, addToolApprovalResponse } =\n    useChat(chatOptions)\n\n  return (\n    <div>\n      {notification}\n      {isLoading ? 'Loading' : null}\n      {error ? error.message : null}\n      <button onClick={() => void sendMessage('hi')} type=\"button\">\n        Send\n      </button>\n      <button\n        onClick={() =>\n          void addToolApprovalResponse({ id: 'approval-1', approved: true })\n        }\n        type=\"button\"\n      >\n        Approve\n      </button>\n      {messages.length}\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The matching server route still runs "},{"type":"inlineCode","value":"chat({ adapter, messages })"},{"type":"text","value":" and returns SSE. See "},{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Quick Start"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"options-you-pass-first","children":[{"type":"text","value":"Options you pass first"}]},{"type":"paragraph","children":[{"type":"text","value":"Extends "},{"type":"inlineCode","value":"ChatClientOptions"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":". Pass "},{"type":"inlineCode","value":"connection"},{"type":"text","value":" or "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":", not both."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"connection"},{"type":"text","value":" or "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":" - how the hook talks to your server"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tools?"},{"type":"text","value":" - client tool implementations from "},{"type":"inlineCode","value":".client()"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"threadId?"},{"type":"text","value":" - the only identity for this chat. Required when persistence is on"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"initialMessages?"},{"type":"text","value":" - starting transcript"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"forwardedProps?"},{"type":"text","value":" - JSON sent to the server on the AG-UI "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" field"}]}]}]},{"type":"heading","depth":3,"id":"options-you-add-later","children":[{"type":"text","value":"Options you add later"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"live?"},{"type":"text","value":" - subscribe on mount, unsubscribe on unmount"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queue?"},{"type":"text","value":" - what to do when "},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":" runs while a turn is in flight. Default queues"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"interrupts?"},{"type":"text","value":" - typed interrupt definitions"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context?"},{"type":"text","value":" - client-only runtime context for client tools. Not sent to the server"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onResponse?"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onChunk?"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onFinish?"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onError?"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onInterruptStateChange?"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"devtools?"},{"type":"text","value":" - display options. The hook always tags "},{"type":"inlineCode","value":"framework: 'octane'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"body?"},{"type":"text","value":" - deprecated. Use "},{"type":"inlineCode","value":"forwardedProps"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Client tools run automatically. There is no "},{"type":"inlineCode","value":"onToolCall"},{"type":"text","value":" callback."}]},{"type":"paragraph","children":[{"type":"text","value":"Changing "},{"type":"inlineCode","value":"connection"},{"type":"text","value":" or "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":" updates the live "},{"type":"inlineCode","value":"ChatClient"},{"type":"text","value":". Changing "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":" creates a new client."}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"import type { UIMessage } from '@tanstack/ai-octane'\nimport type { ModelMessage } from '@tanstack/ai/client'\nimport type {\n  MultimodalContent,\n  ChatClientState,\n  ConnectionStatus,\n  QueuedMessage,\n  SendMessageOptions,\n} from '@tanstack/ai-client'\n\ninterface UseChatReturn {\n  messages: Array<UIMessage>\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>\n  append: (message: ModelMessage | UIMessage) => Promise<void>\n  addToolResult: (result: {\n    toolCallId: string\n    tool: string\n    output: unknown\n    state?: 'output-available' | 'output-error'\n    errorText?: string\n  }) => Promise<void>\n  addToolApprovalResponse: (response: {\n    id: string\n    approved: boolean\n  }) => Promise<void>\n  reload: () => Promise<void>\n  stop: () => void\n  isLoading: boolean\n  error: Error | undefined\n  status: ChatClientState\n  isSubscribed: boolean\n  connectionStatus: ConnectionStatus\n  sessionGenerating: boolean\n  isHydrating: boolean\n  setMessages: (messages: Array<UIMessage>) => void\n  clear: () => void\n  queue: Array<QueuedMessage>\n  cancelQueued: (id: string) => void\n  runId: string | null\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"queue"},{"type":"text","value":" holds sends that wait while a run is busy. "},{"type":"inlineCode","value":"runId"},{"type":"text","value":" is the in-flight turn, or "},{"type":"inlineCode","value":"null"},{"type":"text","value":". Interrupt helpers ("},{"type":"inlineCode","value":"interrupts"},{"type":"text","value":", "},{"type":"inlineCode","value":"resolveInterrupts"},{"type":"text","value":", "},{"type":"inlineCode","value":"cancelInterrupts"},{"type":"text","value":", "},{"type":"inlineCode","value":"retryInterrupts"},{"type":"text","value":") are on the same object when you pass "},{"type":"inlineCode","value":"interrupts"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"connection-adapters","children":[{"type":"text","value":"Connection adapters"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":":"}]},{"type":"code","value":"import {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  stream,\n  type ConnectionAdapter,\n} from '@tanstack/ai-octane'","lang":"typescript"},{"type":"heading","depth":2,"id":"example-basic-chat","children":[{"type":"text","value":"Example: basic chat"}]},{"type":"code","value":"import { useState } from 'octane'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-octane'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  return (\n    <div>\n      {messages.map((message) => (\n        <div key={message.id}>\n          <strong>{message.role}:</strong>\n          {message.parts\n            .filter((part) => part.type === 'text')\n            .map((part) => part.content)\n            .join('')}\n        </div>\n      ))}\n      <input\n        value={input}\n        disabled={isLoading}\n        onInput={(event) => setInput(event.currentTarget.value)}\n      />\n      <button\n        disabled={isLoading}\n        onClick={() => {\n          void sendMessage(input)\n          setInput('')\n        }}\n        type=\"button\"\n      >\n        Send\n      </button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"example-tool-approval","children":[{"type":"text","value":"Example: tool approval"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from '@tanstack/ai-octane'\n\nexport function ChatWithApproval() {\n  const { messages, sendMessage, addToolApprovalResponse } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  return (\n    <div>\n      <button onClick={() => void sendMessage('run the tool')} type=\"button\">\n        Send\n      </button>\n      {messages.map((message) =>\n        message.parts.map((part) => {\n          if (\n            part.type !== 'tool-call' ||\n            part.state !== 'approval-requested' ||\n            !part.approval\n          ) {\n            return null\n          }\n          const approvalId = part.approval.id\n          return (\n            <div key={part.id}>\n              <p>Approve: {part.name}</p>\n              <button\n                onClick={() =>\n                  void addToolApprovalResponse({\n                    id: approvalId,\n                    approved: true,\n                  })\n                }\n                type=\"button\"\n              >\n                Approve\n              </button>\n              <button\n                onClick={() =>\n                  void addToolApprovalResponse({\n                    id: approvalId,\n                    approved: false,\n                  })\n                }\n                type=\"button\"\n              >\n                Deny\n              </button>\n            </div>\n          )\n        }),\n      )}\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"other-hooks","children":[{"type":"text","value":"Other hooks"}]},{"type":"paragraph","children":[{"type":"text","value":"The package also exports "},{"type":"inlineCode","value":"useRealtimeChat"},{"type":"text","value":", "},{"type":"inlineCode","value":"useMcpAppBridge"},{"type":"text","value":", "},{"type":"inlineCode","value":"useGeneration"},{"type":"text","value":", "},{"type":"inlineCode","value":"useGenerateImage"},{"type":"text","value":", "},{"type":"inlineCode","value":"useGenerateAudio"},{"type":"text","value":", "},{"type":"inlineCode","value":"useGenerateSpeech"},{"type":"text","value":", "},{"type":"inlineCode","value":"useGenerateVideo"},{"type":"text","value":", "},{"type":"inlineCode","value":"useTranscription"},{"type":"text","value":", "},{"type":"inlineCode","value":"useSummarize"},{"type":"text","value":", and "},{"type":"inlineCode","value":"useAudioRecorder"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"./mcp-apps"},{"type":"text","value":" React "},{"type":"inlineCode","value":"AppRenderer"},{"type":"text","value":" subpath is not in this package. "},{"type":"inlineCode","value":"useMcpAppBridge"},{"type":"text","value":" is."}]},{"type":"heading","depth":2,"id":"types","children":[{"type":"text","value":"Types"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"UIMessage<TTools>"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ChatClientOptions<TTools, TContext>"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"InferChatMessages<T>"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"QueuedMessage"},{"type":"text","value":", "},{"type":"inlineCode","value":"SendMessageOptions"},{"type":"text","value":", "},{"type":"inlineCode","value":"WhenBusy"}]}]}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Quick Start"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/client-tools","children":[{"type":"text","value":"Client tools"}]}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"useregisterwebmcptools-tools-options","text":"useRegisterWebMCPTools(tools, options?)","level":2},{"id":"usepagewebmcptools-options","text":"usePageWebMCPTools(options?)","level":2},{"id":"usechat-options","text":"useChat(options)","level":2},{"id":"options-you-pass-first","text":"Options you pass first","level":3},{"id":"options-you-add-later","text":"Options you add later","level":3},{"id":"returns","text":"Returns","level":3},{"id":"connection-adapters","text":"Connection adapters","level":2},{"id":"example-basic-chat","text":"Example: basic chat","level":2},{"id":"example-tool-approval","text":"Example: tool approval","level":2},{"id":"other-hooks","text":"Other hooks","level":2},{"id":"types","text":"Types","level":2},{"id":"next","text":"Next","level":2}]},"frameworks":["octane"],"downloadMarkdown":"\nInstall `@tanstack/ai-octane`, then call `useChat` the same way you would in React. The hook modules are `.tsrx` and compile in your Octane plugin.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\noctane: @tanstack/ai-octane octane\n\n<!-- ::end:tabs -->\n\n`octane` is a required peer. This package publishes uncompiled source, like Svelte packages that ship `.svelte`.\n\n## `useRegisterWebMCPTools(tools, options?)`\n\nRegister executable client tools after the Octane component mounts. Octane removes them on cleanup and replaces them when `tools` or `options` change.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```tsx\nimport {\n  useRegisterWebMCPTools,\n  type UseRegisterWebMCPToolsOptions,\n} from '@tanstack/ai-octane'\nimport { searchProducts } from './tools'\n\nconst tools = [searchProducts]\nconst options: UseRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error)\n  },\n}\n\nfunction ProductsPage() {\n  useRegisterWebMCPTools(tools, options)\n  return null\n}\n```\n\n`UseRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The hook owns the registration signal.\n\nThe `context` field is required when a tool declares a required runtime context. Keep `tools` and `options` stable when their values do not change.\n\n## `usePageWebMCPTools(options?)`\n\nRead the WebMCP tools on the page as client tools. The array starts empty and updates when the page adds or removes a tool. Pass it to `useChat` as `tools`.\n\n```tsx\nimport { usePageWebMCPTools } from \"@tanstack/ai-octane\"\n\nexport function useSameOriginPageTools() {\n  return usePageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  })\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## `useChat(options)`\n\nManages chat state in an Octane component.\n\n```tsx\nimport { useState } from 'octane'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-octane'\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from '@tanstack/ai-client'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst updateUIDef = toolDefinition({\n  name: 'updateUI',\n  description: 'Show a notification in the UI',\n  inputSchema: z.object({ message: z.string() }),\n})\n\nexport function ChatComponent() {\n  const [notification, setNotification] = useState<string | null>(null)\n  const updateUI = updateUIDef.client((input) => {\n    setNotification(input.message)\n    return { success: true }\n  })\n  const tools = [updateUI]\n\n  const chatOptions = createChatClientOptions({\n    connection: fetchServerSentEvents('/api/chat'),\n    tools,\n  })\n\n  type ChatMessages = InferChatMessages<typeof chatOptions>\n\n  const { messages, sendMessage, isLoading, error, addToolApprovalResponse } =\n    useChat(chatOptions)\n\n  return (\n    <div>\n      {notification}\n      {isLoading ? 'Loading' : null}\n      {error ? error.message : null}\n      <button onClick={() => void sendMessage('hi')} type=\"button\">\n        Send\n      </button>\n      <button\n        onClick={() =>\n          void addToolApprovalResponse({ id: 'approval-1', approved: true })\n        }\n        type=\"button\"\n      >\n        Approve\n      </button>\n      {messages.length}\n    </div>\n  )\n}\n```\n\nThe matching server route still runs `chat({ adapter, messages })` and returns SSE. See [Quick Start](../getting-started/quick-start).\n\n### Options you pass first\n\nExtends `ChatClientOptions` from `@tanstack/ai-client`. Pass `connection` or `fetcher`, not both.\n\n- `connection` or `fetcher` - how the hook talks to your server\n- `tools?` - client tool implementations from `.client()`\n- `threadId?` - the only identity for this chat. Required when persistence is on\n- `initialMessages?` - starting transcript\n- `forwardedProps?` - JSON sent to the server on the AG-UI `forwardedProps` field\n\n### Options you add later\n\n- `live?` - subscribe on mount, unsubscribe on unmount\n- `queue?` - what to do when `sendMessage` runs while a turn is in flight. Default queues\n- `interrupts?` - typed interrupt definitions\n- `context?` - client-only runtime context for client tools. Not sent to the server\n- `onResponse?` / `onChunk?` / `onFinish?` / `onError?` / `onInterruptStateChange?`\n- `devtools?` - display options. The hook always tags `framework: 'octane'`\n- `body?` - deprecated. Use `forwardedProps`\n\nClient tools run automatically. There is no `onToolCall` callback.\n\nChanging `connection` or `fetcher` updates the live `ChatClient`. Changing `threadId` creates a new client.\n\n### Returns\n\n```typescript\nimport type { UIMessage } from '@tanstack/ai-octane'\nimport type { ModelMessage } from '@tanstack/ai/client'\nimport type {\n  MultimodalContent,\n  ChatClientState,\n  ConnectionStatus,\n  QueuedMessage,\n  SendMessageOptions,\n} from '@tanstack/ai-client'\n\ninterface UseChatReturn {\n  messages: Array<UIMessage>\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>\n  append: (message: ModelMessage | UIMessage) => Promise<void>\n  addToolResult: (result: {\n    toolCallId: string\n    tool: string\n    output: unknown\n    state?: 'output-available' | 'output-error'\n    errorText?: string\n  }) => Promise<void>\n  addToolApprovalResponse: (response: {\n    id: string\n    approved: boolean\n  }) => Promise<void>\n  reload: () => Promise<void>\n  stop: () => void\n  isLoading: boolean\n  error: Error | undefined\n  status: ChatClientState\n  isSubscribed: boolean\n  connectionStatus: ConnectionStatus\n  sessionGenerating: boolean\n  isHydrating: boolean\n  setMessages: (messages: Array<UIMessage>) => void\n  clear: () => void\n  queue: Array<QueuedMessage>\n  cancelQueued: (id: string) => void\n  runId: string | null\n}\n```\n\n`queue` holds sends that wait while a run is busy. `runId` is the in-flight turn, or `null`. Interrupt helpers (`interrupts`, `resolveInterrupts`, `cancelInterrupts`, `retryInterrupts`) are on the same object when you pass `interrupts`.\n\n## Connection adapters\n\nRe-exported from `@tanstack/ai-client`:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  stream,\n  type ConnectionAdapter,\n} from '@tanstack/ai-octane'\n```\n\n## Example: basic chat\n\n```tsx\nimport { useState } from 'octane'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-octane'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  return (\n    <div>\n      {messages.map((message) => (\n        <div key={message.id}>\n          <strong>{message.role}:</strong>\n          {message.parts\n            .filter((part) => part.type === 'text')\n            .map((part) => part.content)\n            .join('')}\n        </div>\n      ))}\n      <input\n        value={input}\n        disabled={isLoading}\n        onInput={(event) => setInput(event.currentTarget.value)}\n      />\n      <button\n        disabled={isLoading}\n        onClick={() => {\n          void sendMessage(input)\n          setInput('')\n        }}\n        type=\"button\"\n      >\n        Send\n      </button>\n    </div>\n  )\n}\n```\n\n## Example: tool approval\n\n```tsx\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-octane'\n\nexport function ChatWithApproval() {\n  const { messages, sendMessage, addToolApprovalResponse } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  return (\n    <div>\n      <button onClick={() => void sendMessage('run the tool')} type=\"button\">\n        Send\n      </button>\n      {messages.map((message) =>\n        message.parts.map((part) => {\n          if (\n            part.type !== 'tool-call' ||\n            part.state !== 'approval-requested' ||\n            !part.approval\n          ) {\n            return null\n          }\n          const approvalId = part.approval.id\n          return (\n            <div key={part.id}>\n              <p>Approve: {part.name}</p>\n              <button\n                onClick={() =>\n                  void addToolApprovalResponse({\n                    id: approvalId,\n                    approved: true,\n                  })\n                }\n                type=\"button\"\n              >\n                Approve\n              </button>\n              <button\n                onClick={() =>\n                  void addToolApprovalResponse({\n                    id: approvalId,\n                    approved: false,\n                  })\n                }\n                type=\"button\"\n              >\n                Deny\n              </button>\n            </div>\n          )\n        }),\n      )}\n    </div>\n  )\n}\n```\n\n## Other hooks\n\nThe package also exports `useRealtimeChat`, `useMcpAppBridge`, `useGeneration`, `useGenerateImage`, `useGenerateAudio`, `useGenerateSpeech`, `useGenerateVideo`, `useTranscription`, `useSummarize`, and `useAudioRecorder`.\n\nThe `./mcp-apps` React `AppRenderer` subpath is not in this package. `useMcpAppBridge` is.\n\n## Types\n\nRe-exported from `@tanstack/ai-client`:\n\n- `UIMessage<TTools>`\n- `ChatClientOptions<TTools, TContext>`\n- `InferChatMessages<T>`\n- `QueuedMessage`, `SendMessageOptions`, `WhenBusy`\n\n## Next\n\n- [Quick Start](../getting-started/quick-start)\n- [Tools](../tools/tools)\n- [Client tools](../tools/client-tools)\n","originalRawMarkdown":"---\ntitle: \"@tanstack/ai-octane\"\nid: ai-octane\norder: 8\ndescription: \"API reference for @tanstack/ai-octane. Octane hooks including useChat for streaming chat with full type safety.\"\nkeywords:\n  - tanstack ai\n  - \"@tanstack/ai-octane\"\n  - octane\n  - useChat\n  - octane hooks\n  - api reference\n---\n\nInstall `@tanstack/ai-octane`, then call `useChat` the same way you would in React. The hook modules are `.tsrx` and compile in your Octane plugin.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\noctane: @tanstack/ai-octane octane\n\n<!-- ::end:tabs -->\n\n`octane` is a required peer. This package publishes uncompiled source, like Svelte packages that ship `.svelte`.\n\n## `useRegisterWebMCPTools(tools, options?)`\n\nRegister executable client tools after the Octane component mounts. Octane removes them on cleanup and replaces them when `tools` or `options` change.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```tsx\nimport {\n  useRegisterWebMCPTools,\n  type UseRegisterWebMCPToolsOptions,\n} from '@tanstack/ai-octane'\nimport { searchProducts } from './tools'\n\nconst tools = [searchProducts]\nconst options: UseRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error)\n  },\n}\n\nfunction ProductsPage() {\n  useRegisterWebMCPTools(tools, options)\n  return null\n}\n```\n\n`UseRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The hook owns the registration signal.\n\nThe `context` field is required when a tool declares a required runtime context. Keep `tools` and `options` stable when their values do not change.\n\n## `usePageWebMCPTools(options?)`\n\nRead the WebMCP tools on the page as client tools. The array starts empty and updates when the page adds or removes a tool. Pass it to `useChat` as `tools`.\n\n```tsx\nimport { usePageWebMCPTools } from \"@tanstack/ai-octane\"\n\nexport function useSameOriginPageTools() {\n  return usePageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  })\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## `useChat(options)`\n\nManages chat state in an Octane component.\n\n```tsx\nimport { useState } from 'octane'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-octane'\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from '@tanstack/ai-client'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst updateUIDef = toolDefinition({\n  name: 'updateUI',\n  description: 'Show a notification in the UI',\n  inputSchema: z.object({ message: z.string() }),\n})\n\nexport function ChatComponent() {\n  const [notification, setNotification] = useState<string | null>(null)\n  const updateUI = updateUIDef.client((input) => {\n    setNotification(input.message)\n    return { success: true }\n  })\n  const tools = [updateUI]\n\n  const chatOptions = createChatClientOptions({\n    connection: fetchServerSentEvents('/api/chat'),\n    tools,\n  })\n\n  type ChatMessages = InferChatMessages<typeof chatOptions>\n\n  const { messages, sendMessage, isLoading, error, addToolApprovalResponse } =\n    useChat(chatOptions)\n\n  return (\n    <div>\n      {notification}\n      {isLoading ? 'Loading' : null}\n      {error ? error.message : null}\n      <button onClick={() => void sendMessage('hi')} type=\"button\">\n        Send\n      </button>\n      <button\n        onClick={() =>\n          void addToolApprovalResponse({ id: 'approval-1', approved: true })\n        }\n        type=\"button\"\n      >\n        Approve\n      </button>\n      {messages.length}\n    </div>\n  )\n}\n```\n\nThe matching server route still runs `chat({ adapter, messages })` and returns SSE. See [Quick Start](../getting-started/quick-start).\n\n### Options you pass first\n\nExtends `ChatClientOptions` from `@tanstack/ai-client`. Pass `connection` or `fetcher`, not both.\n\n- `connection` or `fetcher` - how the hook talks to your server\n- `tools?` - client tool implementations from `.client()`\n- `threadId?` - the only identity for this chat. Required when persistence is on\n- `initialMessages?` - starting transcript\n- `forwardedProps?` - JSON sent to the server on the AG-UI `forwardedProps` field\n\n### Options you add later\n\n- `live?` - subscribe on mount, unsubscribe on unmount\n- `queue?` - what to do when `sendMessage` runs while a turn is in flight. Default queues\n- `interrupts?` - typed interrupt definitions\n- `context?` - client-only runtime context for client tools. Not sent to the server\n- `onResponse?` / `onChunk?` / `onFinish?` / `onError?` / `onInterruptStateChange?`\n- `devtools?` - display options. The hook always tags `framework: 'octane'`\n- `body?` - deprecated. Use `forwardedProps`\n\nClient tools run automatically. There is no `onToolCall` callback.\n\nChanging `connection` or `fetcher` updates the live `ChatClient`. Changing `threadId` creates a new client.\n\n### Returns\n\n```typescript\nimport type { UIMessage } from '@tanstack/ai-octane'\nimport type { ModelMessage } from '@tanstack/ai/client'\nimport type {\n  MultimodalContent,\n  ChatClientState,\n  ConnectionStatus,\n  QueuedMessage,\n  SendMessageOptions,\n} from '@tanstack/ai-client'\n\ninterface UseChatReturn {\n  messages: Array<UIMessage>\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>\n  append: (message: ModelMessage | UIMessage) => Promise<void>\n  addToolResult: (result: {\n    toolCallId: string\n    tool: string\n    output: unknown\n    state?: 'output-available' | 'output-error'\n    errorText?: string\n  }) => Promise<void>\n  addToolApprovalResponse: (response: {\n    id: string\n    approved: boolean\n  }) => Promise<void>\n  reload: () => Promise<void>\n  stop: () => void\n  isLoading: boolean\n  error: Error | undefined\n  status: ChatClientState\n  isSubscribed: boolean\n  connectionStatus: ConnectionStatus\n  sessionGenerating: boolean\n  isHydrating: boolean\n  setMessages: (messages: Array<UIMessage>) => void\n  clear: () => void\n  queue: Array<QueuedMessage>\n  cancelQueued: (id: string) => void\n  runId: string | null\n}\n```\n\n`queue` holds sends that wait while a run is busy. `runId` is the in-flight turn, or `null`. Interrupt helpers (`interrupts`, `resolveInterrupts`, `cancelInterrupts`, `retryInterrupts`) are on the same object when you pass `interrupts`.\n\n## Connection adapters\n\nRe-exported from `@tanstack/ai-client`:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  stream,\n  type ConnectionAdapter,\n} from '@tanstack/ai-octane'\n```\n\n## Example: basic chat\n\n```tsx\nimport { useState } from 'octane'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-octane'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  return (\n    <div>\n      {messages.map((message) => (\n        <div key={message.id}>\n          <strong>{message.role}:</strong>\n          {message.parts\n            .filter((part) => part.type === 'text')\n            .map((part) => part.content)\n            .join('')}\n        </div>\n      ))}\n      <input\n        value={input}\n        disabled={isLoading}\n        onInput={(event) => setInput(event.currentTarget.value)}\n      />\n      <button\n        disabled={isLoading}\n        onClick={() => {\n          void sendMessage(input)\n          setInput('')\n        }}\n        type=\"button\"\n      >\n        Send\n      </button>\n    </div>\n  )\n}\n```\n\n## Example: tool approval\n\n```tsx\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-octane'\n\nexport function ChatWithApproval() {\n  const { messages, sendMessage, addToolApprovalResponse } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  return (\n    <div>\n      <button onClick={() => void sendMessage('run the tool')} type=\"button\">\n        Send\n      </button>\n      {messages.map((message) =>\n        message.parts.map((part) => {\n          if (\n            part.type !== 'tool-call' ||\n            part.state !== 'approval-requested' ||\n            !part.approval\n          ) {\n            return null\n          }\n          const approvalId = part.approval.id\n          return (\n            <div key={part.id}>\n              <p>Approve: {part.name}</p>\n              <button\n                onClick={() =>\n                  void addToolApprovalResponse({\n                    id: approvalId,\n                    approved: true,\n                  })\n                }\n                type=\"button\"\n              >\n                Approve\n              </button>\n              <button\n                onClick={() =>\n                  void addToolApprovalResponse({\n                    id: approvalId,\n                    approved: false,\n                  })\n                }\n                type=\"button\"\n              >\n                Deny\n              </button>\n            </div>\n          )\n        }),\n      )}\n    </div>\n  )\n}\n```\n\n## Other hooks\n\nThe package also exports `useRealtimeChat`, `useMcpAppBridge`, `useGeneration`, `useGenerateImage`, `useGenerateAudio`, `useGenerateSpeech`, `useGenerateVideo`, `useTranscription`, `useSummarize`, and `useAudioRecorder`.\n\nThe `./mcp-apps` React `AppRenderer` subpath is not in this package. `useMcpAppBridge` is.\n\n## Types\n\nRe-exported from `@tanstack/ai-client`:\n\n- `UIMessage<TTools>`\n- `ChatClientOptions<TTools, TContext>`\n- `InferChatMessages<T>`\n- `QueuedMessage`, `SendMessageOptions`, `WhenBusy`\n\n## Next\n\n- [Quick Start](../getting-started/quick-start)\n- [Tools](../tools/tools)\n- [Client tools](../tools/client-tools)\n"}
