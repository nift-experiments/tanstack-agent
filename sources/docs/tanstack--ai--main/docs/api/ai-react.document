NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"React hooks for TanStack AI, providing convenient React bindings for the headless client."}]},{"type":"paragraph","children":[{"type":"text","value":"For a typed headless chat UI, see "},{"type":"link","href":"../ui/react","children":[{"type":"text","value":"React Chat UI"}]},{"type":"text","value":".\nFor React Native, the documented support surface is narrow: "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" with chat\nconnection adapters. React DOM-specific UI packages and TanStack AI devtools UI\nare not part of the React Native support surface."}]},{"type":"paragraph","children":[{"type":"text","value":"For a complete native journey, see\n"},{"type":"link","href":"../getting-started/quick-start-react-native","children":[{"type":"text","value":"Quick Start: React Native"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-react\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"useregisterwebmcptools-tools-options","children":[{"type":"inlineCode","value":"useRegisterWebMCPTools(tools, options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Register executable client tools after the React component mounts. React removes them on cleanup and replaces them when "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" or "},{"type":"inlineCode","value":"options"},{"type":"text","value":" change."}]},{"type":"paragraph","children":[{"type":"text","value":"For a complete setup and behavior guide, see "},{"type":"link","href":"../tools/webmcp","children":[{"type":"text","value":"WebMCP Tools"}]},{"type":"text","value":"."}]},{"type":"code","value":"import {\n  useRegisterWebMCPTools,\n  type UseRegisterWebMCPToolsOptions,\n} from \"@tanstack/ai-react\";\nimport { searchProducts } from \"./tools\";\n\nconst tools = [searchProducts];\nconst options: UseRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error);\n  },\n};\n\nfunction ProductsPage() {\n  useRegisterWebMCPTools(tools, options);\n  return null;\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"UseRegisterWebMCPToolsOptions<TTools, TContext>"},{"type":"text","value":" contains "},{"type":"inlineCode","value":"toolOptions"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onError"},{"type":"text","value":". The hook owns the registration signal."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"context"},{"type":"text","value":" field is required when a tool declares a required runtime context. Keep "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" and "},{"type":"inlineCode","value":"options"},{"type":"text","value":" stable when their values do not change."}]},{"type":"heading","depth":2,"id":"usepagewebmcptools-options","children":[{"type":"inlineCode","value":"usePageWebMCPTools(options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Read the WebMCP tools on the page as client tools. The array starts empty and updates when the page adds or removes a tool. Pass it to "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" as "},{"type":"inlineCode","value":"tools"},{"type":"text","value":"."}]},{"type":"code","value":"import { usePageWebMCPTools } from \"@tanstack/ai-react\";\n\nexport function useSameOriginPageTools() {\n  return usePageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  });\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"filter"},{"type":"text","value":" skips a tool when it returns "},{"type":"inlineCode","value":"false"},{"type":"text","value":". "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" gets a failed WebMCP read. For a complete guide, see "},{"type":"link","href":"../tools/webmcp-page-tools","children":[{"type":"text","value":"Page WebMCP Tools in Chat"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"createchathook-options","children":[{"type":"inlineCode","value":"createChatHook(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Bind "},{"type":"inlineCode","value":"chatOptions"},{"type":"text","value":" once at module scope. Call "},{"type":"inlineCode","value":"useChat()"},{"type":"text","value":" in the screen to create the instance. Per-call overrides may set "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":", "},{"type":"inlineCode","value":"initialMessages"},{"type":"text","value":", "},{"type":"inlineCode","value":"live"},{"type":"text","value":", and "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":". They must not change "},{"type":"inlineCode","value":"tools"},{"type":"text","value":", "},{"type":"inlineCode","value":"interrupts"},{"type":"text","value":", or "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":"."}]},{"type":"code","value":"import { createChatHook, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst chatOptions = {\n  connection: fetchServerSentEvents(\"/api/chat\"),\n};\n\nconst { useChat } = createChatHook(chatOptions);\n\nfunction ChatScreen() {\n  const chat = useChat({ threadId: \"support-1\" });\n  return null;\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"useChat(chatOptions)"},{"type":"text","value":" from this package still works when you want to pass the full object at the call site. Rename the bound hook if both are in one file: "},{"type":"inlineCode","value":"const { useChat: useSupportChat } = createChatHook(chatOptions)"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"usechat-options","children":[{"type":"inlineCode","value":"useChat(options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Main hook for managing chat state in React with full type safety."}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { \n  createChatClientOptions, \n  type InferChatMessages \n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\nimport { useState } from \"react\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Update the UI with a notification\",\n  inputSchema: z.object({\n    message: z.string(),\n  }),\n  outputSchema: z.object({ success: z.boolean() }),\n});\n\nfunction ChatComponent() {\n  const [notification, setNotification] = useState<string | null>(null);\n\n  // Create client tool implementations\n  const updateUI = updateUIDef.client((input) => {\n    setNotification(input.message);\n    return { success: true };\n  });\n\n  // Create typed tools array (no 'as const' needed!)\n  const tools = [updateUI];\n\n  const chatOptions = createChatClientOptions({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    tools,\n  });\n\n  // Fully typed messages!\n  type ChatMessages = InferChatMessages<typeof chatOptions>;\n\n  const { messages, sendMessage, isLoading, error, addToolApprovalResponse } =\n    useChat(chatOptions);\n\n  return <div>{/* Chat UI with typed messages */}</div>;\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"paragraph","children":[{"type":"text","value":"Extends "},{"type":"inlineCode","value":"ChatClientOptions"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"connection"},{"type":"text","value":" - Connection adapter (required)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tools?"},{"type":"text","value":" - Array of client tool implementations (with "},{"type":"inlineCode","value":".client()"},{"type":"text","value":" method)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"initialMessages?"},{"type":"text","value":" - Initial messages array"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"threadId?"},{"type":"text","value":" - The only identity for this chat. Required when persistence is on. If omitted, minted after mount."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"forwardedProps?"},{"type":"text","value":" - Arbitrary client-controlled JSON forwarded to the server in the AG-UI "},{"type":"inlineCode","value":"RunAgentInput.forwardedProps"},{"type":"text","value":" field (e.g., "},{"type":"inlineCode","value":"{ provider: 'openai', model: 'gpt-5.5' }"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"body?"},{"type":"text","value":" - "},{"type":"strong","children":[{"type":"text","value":"Deprecated."}]},{"type":"text","value":" Use "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" instead. Still works for backward compatibility; values are merged into "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" on the wire"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"byok?"},{"type":"text","value":" - Optional BYOK keyring from "},{"type":"inlineCode","value":"defineByok"},{"type":"text","value":". On each send the client prepares the resolved provider and stamps "},{"type":"inlineCode","value":"x-byok-*"},{"type":"text","value":" request headers. Keys never go in the body"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"byokProvider?"},{"type":"text","value":" - Optional function that returns the provider slug for this chat. If it returns a slug, only that key is prepared and sent. Otherwise the merged "},{"type":"inlineCode","value":"provider"},{"type":"text","value":" from "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"body"},{"type":"text","value":", and per-call "},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":" "},{"type":"inlineCode","value":"body"},{"type":"text","value":" is used. Later sources win. If no slug resolves, the send throws instead of attaching every stored key"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context?"},{"type":"text","value":" - Typed client-local runtime context passed to client tool implementations. This value is not serialized to the server"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onResponse?"},{"type":"text","value":" - Callback when response is received"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onChunk?"},{"type":"text","value":" - Callback when stream chunk is received"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onFinish?"},{"type":"text","value":" - Callback when response finishes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onError?"},{"type":"text","value":" - Callback when error occurs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onInterruptStateChange?"},{"type":"text","value":" - Callback when interrupt state changes; context source is "},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" for restored state and "},{"type":"inlineCode","value":"live"},{"type":"text","value":" for streamed or client-initiated updates"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"streamProcessor?"},{"type":"text","value":" - Stream processing configuration"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Client tools are now automatically executed - no "},{"type":"inlineCode","value":"onToolCall"},{"type":"text","value":" callback needed!"}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"import type { UIMessage } from \"@tanstack/ai-react\";\nimport type { ModelMessage } from \"@tanstack/ai\";\nimport type {\n  MultimodalContent,\n  SendMessageOptions,\n} from \"@tanstack/ai-client\";\n\ninterface UseChatReturn {\n  messages: UIMessage[];\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>;\n  append: (message: ModelMessage | UIMessage) => Promise<void>;\n  addToolResult: (result: {\n    toolCallId: string;\n    tool: string;\n    output: any;\n    state?: \"output-available\" | \"output-error\";\n    errorText?: string;\n  }) => Promise<void>;\n  addToolApprovalResponse: (response: {\n    id: string;\n    approved: boolean;\n  }) => Promise<void>;\n  reload: () => Promise<void>;\n  stop: () => void;\n  isLoading: boolean;\n  isHydrating: boolean;\n  error: Error | undefined;\n  setMessages: (messages: UIMessage[]) => void;\n  clear: () => void;\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"usebyok-client","children":[{"type":"inlineCode","value":"useByok(client)"}]},{"type":"paragraph","children":[{"type":"text","value":"Subscribe to a "},{"type":"inlineCode","value":"ByokClient"},{"type":"text","value":" snapshot in React."}]},{"type":"code","value":"import { useByok } from \"@tanstack/ai-react\";\nimport { byok } from \"./byok\";\n\nexport function KeyStatus() {\n  const snapshot = useByok(byok);\n  const openai = snapshot.status.openai;\n  const last4 = openai && \"masked\" in openai ? openai.masked : \"No key\";\n  return <p>{last4}</p>;\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"snapshot"},{"type":"text","value":" has "},{"type":"inlineCode","value":"status"},{"type":"text","value":", "},{"type":"inlineCode","value":"locked"},{"type":"text","value":", and "},{"type":"inlineCode","value":"prompt"},{"type":"text","value":". Call "},{"type":"inlineCode","value":"byok.update(provider, value)"},{"type":"text","value":" from your own UI to save a key. See "},{"type":"link","href":"../advanced/byok","children":[{"type":"text","value":"Bring Your Own Key"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"connection-adapters","children":[{"type":"text","value":"Connection Adapters"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":" for convenience:"}]},{"type":"code","value":"import {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  xhrServerSentEvents,\n  xhrHttpStream,\n  stream,\n  type ConnectionAdapter,\n  type FetchConnectionOptions,\n  type FetchJsonOptions,\n  type XhrConnectionOptions,\n} from \"@tanstack/ai-react\";","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"For React Native or Expo chat screens, use an absolute server URL and prefer\n"},{"type":"inlineCode","value":"xhrHttpStream()"},{"type":"text","value":" with a server route that returns "},{"type":"inlineCode","value":"toHttpResponse()"},{"type":"text","value":". Use\n"},{"type":"inlineCode","value":"xhrServerSentEvents()"},{"type":"text","value":" with "},{"type":"inlineCode","value":"toServerSentEventsResponse()"},{"type":"text","value":" when you want SSE.\nUse "},{"type":"inlineCode","value":"fetchHttpStream()"},{"type":"text","value":" only when the runtime supports streaming "},{"type":"inlineCode","value":"fetch"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"Response.body.getReader()"},{"type":"text","value":", and "},{"type":"inlineCode","value":"TextDecoder"},{"type":"text","value":"; otherwise it throws\n"},{"type":"inlineCode","value":"UnsupportedResponseStreamError"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"If the host cannot stream at all, use "},{"type":"inlineCode","value":"fetchJson()"},{"type":"text","value":" with a server route that\nreturns "},{"type":"inlineCode","value":"toJsonResponse()"},{"type":"text","value":". See "},{"type":"link","href":"../transports/json","children":[{"type":"text","value":"JSON"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"XHR adapter options include "},{"type":"inlineCode","value":"headers"},{"type":"text","value":", "},{"type":"inlineCode","value":"withCredentials"},{"type":"text","value":", "},{"type":"inlineCode","value":"signal"},{"type":"text","value":", "},{"type":"inlineCode","value":"body"},{"type":"text","value":", and\n"},{"type":"inlineCode","value":"xhrFactory"},{"type":"text","value":". Fetch adapter options include "},{"type":"inlineCode","value":"headers"},{"type":"text","value":", "},{"type":"inlineCode","value":"credentials"},{"type":"text","value":", "},{"type":"inlineCode","value":"signal"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"body"},{"type":"text","value":", and "},{"type":"inlineCode","value":"fetchClient"},{"type":"text","value":". "},{"type":"inlineCode","value":"fetchJson()"},{"type":"text","value":" also takes "},{"type":"inlineCode","value":"pollIntervalMs"},{"type":"text","value":". Both option objects may be provided directly or as a\nfunction that resolves per request."}]},{"type":"paragraph","children":[{"type":"text","value":"For error narrowing, import "},{"type":"inlineCode","value":"UnsupportedResponseStreamError"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"StreamTruncatedError"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"example-basic-chat","children":[{"type":"text","value":"Example: Basic Chat"}]},{"type":"code","value":"import { useState } from \"react\";\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nexport function Chat() {\n  const [input, setInput] = useState(\"\");\n\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (input.trim() && !isLoading) {\n      sendMessage(input);\n      setInput(\"\");\n    }\n  };\n\n  return (\n    <div>\n      <div>\n        {messages.map((message) => (\n          <div key={message.id}>\n            <strong>{message.role}:</strong>\n            {message.parts.map((part, idx) => {\n              if (part.type === \"thinking\") {\n                return (\n                  <div key={idx} className=\"text-sm text-gray-500 italic\">\n                    💭 Thinking: {part.content}\n                  </div>\n                );\n              }\n              if (part.type === \"text\") {\n                return <span key={idx}>{part.content}</span>;\n              }\n              return null;\n            })}\n          </div>\n        ))}\n      </div>\n      <form onSubmit={handleSubmit}>\n        <input\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n          disabled={isLoading}\n        />\n        <button type=\"submit\" disabled={isLoading}>\n          Send\n        </button>\n      </form>\n    </div>\n  );\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"example-tool-approval","children":[{"type":"text","value":"Example: Tool Approval"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nexport function ChatWithApproval() {\n  const { messages, sendMessage, addToolApprovalResponse } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n\n  return (\n    <div>\n      {messages.map((message) =>\n        message.parts.map((part) => {\n          if (\n            part.type === \"tool-call\" &&\n            part.state === \"approval-requested\" &&\n            part.approval\n          ) {\n            return (\n              <div key={part.id}>\n                <p>Approve: {part.name}</p>\n                <button\n                  onClick={() =>\n                    addToolApprovalResponse({\n                      id: part.approval!.id,\n                      approved: true,\n                    })\n                  }\n                >\n                  Approve\n                </button>\n                <button\n                  onClick={() =>\n                    addToolApprovalResponse({\n                      id: part.approval!.id,\n                      approved: false,\n                    })\n                  }\n                >\n                  Deny\n                </button>\n              </div>\n            );\n          }\n          return null;\n        })\n      )}\n    </div>\n  );\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"example-client-tools-with-type-safety","children":[{"type":"text","value":"Example: Client Tools with Type Safety"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { \n  createChatClientOptions, \n  type InferChatMessages \n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\nimport { useState } from \"react\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Update the UI with a notification\",\n  inputSchema: z.object({\n    message: z.string(),\n    type: z.string(),\n  }),\n  outputSchema: z.object({ success: z.boolean() }),\n});\n\nconst saveToStorageDef = toolDefinition({\n  name: \"saveToStorage\",\n  description: \"Save a value to storage\",\n  inputSchema: z.object({\n    key: z.string(),\n    value: z.string(),\n  }),\n  outputSchema: z.object({ saved: z.boolean() }),\n});\n\nexport function ChatWithClientTools() {\n  const [notification, setNotification] = useState<{ message: string; type: string } | null>(null);\n\n  // Create client implementations\n  const updateUI = updateUIDef.client((input) => {\n    // ✅ input is fully typed!\n    setNotification({ message: input.message, type: input.type });\n    return { success: true };\n  });\n\n  const saveToStorage = saveToStorageDef.client((input) => {\n    localStorage.setItem(input.key, input.value);\n    return { saved: true };\n  });\n\n  // Create typed tools array (no 'as const' needed!)\n  const tools = [updateUI, saveToStorage];\n\n  const { messages, sendMessage } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    tools, // ✅ Automatic execution, full type safety\n  });\n\n  return (\n    <div>\n      {messages.map((message) =>\n        message.parts.map((part) => {\n          if (part.type === \"tool-call\" && part.name === \"updateUI\") {\n            // ✅ part.input and part.output are fully typed!\n            return <div key={part.id}>Tool executed: {part.name}</div>;\n          }\n          return null;\n        })\n      )}\n    </div>\n  );\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"createchatclientoptions-options","children":[{"type":"inlineCode","value":"createChatClientOptions(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Helper to create typed chat options (re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":")."}]},{"type":"code","value":"import { \n  createChatClientOptions, \n  fetchServerSentEvents,\n  type InferChatMessages \n} from \"@tanstack/ai-client\";\nimport { tool1, tool2 } from \"./tools\";\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [tool1, tool2];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\ntype Messages = InferChatMessages<typeof chatOptions>;","lang":"typescript"},{"type":"heading","depth":2,"id":"types","children":[{"type":"text","value":"Types"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"UIMessage<TTools>"},{"type":"text","value":" - Message type with tool type parameter"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"MessagePart<TTools>"},{"type":"text","value":" - Message part with tool type parameter"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TextPart"},{"type":"text","value":" - Text content part"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ThinkingPart"},{"type":"text","value":" - Thinking content part"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ToolCallPart<TTools>"},{"type":"text","value":" - Tool call part (discriminated union)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ToolResultPart"},{"type":"text","value":" - Tool result part"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ChatClientOptions<TTools, TContext>"},{"type":"text","value":" - Chat client options with typed client runtime context"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ConnectionAdapter"},{"type":"text","value":" - Connection adapter interface"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"InferChatMessages<T>"},{"type":"text","value":" - Extract message type from options"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"toolDefinition()"},{"type":"text","value":" - Create isomorphic tool definition"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ToolDefinitionInstance"},{"type":"text","value":" - Tool definition type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ClientTool"},{"type":"text","value":" - Client tool type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ServerTool"},{"type":"text","value":" - Server tool type"}]}]}]},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Getting Started"}]},{"type":"text","value":" - Learn the basics"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../advanced/byok","children":[{"type":"text","value":"Bring Your Own Key"}]},{"type":"text","value":" - Store keys and pass "},{"type":"inlineCode","value":"byok"},{"type":"text","value":" into "},{"type":"inlineCode","value":"useChat"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools Guide"}]},{"type":"text","value":" - Learn about the isomorphic tool system"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/client-tools","children":[{"type":"text","value":"Client Tools"}]},{"type":"text","value":" - Learn about client-side tools"}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"useregisterwebmcptools-tools-options","text":"useRegisterWebMCPTools(tools, options?)","level":2},{"id":"usepagewebmcptools-options","text":"usePageWebMCPTools(options?)","level":2},{"id":"createchathook-options","text":"createChatHook(options)","level":2},{"id":"usechat-options","text":"useChat(options?)","level":2},{"id":"options","text":"Options","level":3},{"id":"returns","text":"Returns","level":3},{"id":"usebyok-client","text":"useByok(client)","level":2},{"id":"connection-adapters","text":"Connection Adapters","level":2},{"id":"example-basic-chat","text":"Example: Basic Chat","level":2},{"id":"example-tool-approval","text":"Example: Tool Approval","level":2},{"id":"example-client-tools-with-type-safety","text":"Example: Client Tools with Type Safety","level":2},{"id":"createchatclientoptions-options","text":"createChatClientOptions(options)","level":2},{"id":"types","text":"Types","level":2},{"id":"next-steps","text":"Next Steps","level":2}]},"frameworks":["react"],"downloadMarkdown":"\nReact hooks for TanStack AI, providing convenient React bindings for the headless client.\n\nFor a typed headless chat UI, see [React Chat UI](../ui/react).\nFor React Native, the documented support surface is narrow: `useChat` with chat\nconnection adapters. React DOM-specific UI packages and TanStack AI devtools UI\nare not part of the React Native support surface.\n\nFor a complete native journey, see\n[Quick Start: React Native](../getting-started/quick-start-react-native).\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-react\n\n<!-- ::end:tabs -->\n\n## `useRegisterWebMCPTools(tools, options?)`\n\nRegister executable client tools after the React component mounts. React removes them on cleanup and replaces them when `tools` or `options` change.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```tsx\nimport {\n  useRegisterWebMCPTools,\n  type UseRegisterWebMCPToolsOptions,\n} from \"@tanstack/ai-react\";\nimport { searchProducts } from \"./tools\";\n\nconst tools = [searchProducts];\nconst options: UseRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error);\n  },\n};\n\nfunction ProductsPage() {\n  useRegisterWebMCPTools(tools, options);\n  return null;\n}\n```\n\n`UseRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The hook owns the registration signal.\n\nThe `context` field is required when a tool declares a required runtime context. Keep `tools` and `options` stable when their values do not change.\n\n## `usePageWebMCPTools(options?)`\n\nRead the WebMCP tools on the page as client tools. The array starts empty and updates when the page adds or removes a tool. Pass it to `useChat` as `tools`.\n\n```tsx\nimport { usePageWebMCPTools } from \"@tanstack/ai-react\";\n\nexport function useSameOriginPageTools() {\n  return usePageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  });\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## `createChatHook(options)`\n\nBind `chatOptions` once at module scope. Call `useChat()` in the screen to create the instance. Per-call overrides may set `threadId`, `initialMessages`, `live`, and `forwardedProps`. They must not change `tools`, `interrupts`, or `outputSchema`.\n\n```tsx\nimport { createChatHook, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst chatOptions = {\n  connection: fetchServerSentEvents(\"/api/chat\"),\n};\n\nconst { useChat } = createChatHook(chatOptions);\n\nfunction ChatScreen() {\n  const chat = useChat({ threadId: \"support-1\" });\n  return null;\n}\n```\n\n`useChat(chatOptions)` from this package still works when you want to pass the full object at the call site. Rename the bound hook if both are in one file: `const { useChat: useSupportChat } = createChatHook(chatOptions)`.\n\n## `useChat(options?)`\n\nMain hook for managing chat state in React with full type safety.\n\n```tsx\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { \n  createChatClientOptions, \n  type InferChatMessages \n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\nimport { useState } from \"react\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Update the UI with a notification\",\n  inputSchema: z.object({\n    message: z.string(),\n  }),\n  outputSchema: z.object({ success: z.boolean() }),\n});\n\nfunction ChatComponent() {\n  const [notification, setNotification] = useState<string | null>(null);\n\n  // Create client tool implementations\n  const updateUI = updateUIDef.client((input) => {\n    setNotification(input.message);\n    return { success: true };\n  });\n\n  // Create typed tools array (no 'as const' needed!)\n  const tools = [updateUI];\n\n  const chatOptions = createChatClientOptions({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    tools,\n  });\n\n  // Fully typed messages!\n  type ChatMessages = InferChatMessages<typeof chatOptions>;\n\n  const { messages, sendMessage, isLoading, error, addToolApprovalResponse } =\n    useChat(chatOptions);\n\n  return <div>{/* Chat UI with typed messages */}</div>;\n}\n```\n\n### Options\n\nExtends `ChatClientOptions` from `@tanstack/ai-client`:\n\n- `connection` - Connection adapter (required)\n- `tools?` - Array of client tool implementations (with `.client()` method)\n- `initialMessages?` - Initial messages array\n- `threadId?` - The only identity for this chat. Required when persistence is on. If omitted, minted after mount.\n- `forwardedProps?` - Arbitrary client-controlled JSON forwarded to the server in the AG-UI `RunAgentInput.forwardedProps` field (e.g., `{ provider: 'openai', model: 'gpt-5.5' }`)\n- `body?` - **Deprecated.** Use `forwardedProps` instead. Still works for backward compatibility; values are merged into `forwardedProps` on the wire\n- `byok?` - Optional BYOK keyring from `defineByok`. On each send the client prepares the resolved provider and stamps `x-byok-*` request headers. Keys never go in the body\n- `byokProvider?` - Optional function that returns the provider slug for this chat. If it returns a slug, only that key is prepared and sent. Otherwise the merged `provider` from `forwardedProps`, `body`, and per-call `sendMessage` `body` is used. Later sources win. If no slug resolves, the send throws instead of attaching every stored key\n- `context?` - Typed client-local runtime context passed to client tool implementations. This value is not serialized to the server\n- `onResponse?` - Callback when response is received\n- `onChunk?` - Callback when stream chunk is received\n- `onFinish?` - Callback when response finishes\n- `onError?` - Callback when error occurs\n- `onInterruptStateChange?` - Callback when interrupt state changes; context source is `hydrate` for restored state and `live` for streamed or client-initiated updates\n- `streamProcessor?` - Stream processing configuration\n\n**Note:** Client tools are now automatically executed - no `onToolCall` callback needed!\n\n### Returns\n\n```typescript\nimport type { UIMessage } from \"@tanstack/ai-react\";\nimport type { ModelMessage } from \"@tanstack/ai\";\nimport type {\n  MultimodalContent,\n  SendMessageOptions,\n} from \"@tanstack/ai-client\";\n\ninterface UseChatReturn {\n  messages: UIMessage[];\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>;\n  append: (message: ModelMessage | UIMessage) => Promise<void>;\n  addToolResult: (result: {\n    toolCallId: string;\n    tool: string;\n    output: any;\n    state?: \"output-available\" | \"output-error\";\n    errorText?: string;\n  }) => Promise<void>;\n  addToolApprovalResponse: (response: {\n    id: string;\n    approved: boolean;\n  }) => Promise<void>;\n  reload: () => Promise<void>;\n  stop: () => void;\n  isLoading: boolean;\n  isHydrating: boolean;\n  error: Error | undefined;\n  setMessages: (messages: UIMessage[]) => void;\n  clear: () => void;\n}\n```\n\n## `useByok(client)`\n\nSubscribe to a `ByokClient` snapshot in React.\n\n```tsx\nimport { useByok } from \"@tanstack/ai-react\";\nimport { byok } from \"./byok\";\n\nexport function KeyStatus() {\n  const snapshot = useByok(byok);\n  const openai = snapshot.status.openai;\n  const last4 = openai && \"masked\" in openai ? openai.masked : \"No key\";\n  return <p>{last4}</p>;\n}\n```\n\n`snapshot` has `status`, `locked`, and `prompt`. Call `byok.update(provider, value)` from your own UI to save a key. See [Bring Your Own Key](../advanced/byok).\n\n## Connection Adapters\n\nRe-exported from `@tanstack/ai-client` for convenience:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  xhrServerSentEvents,\n  xhrHttpStream,\n  stream,\n  type ConnectionAdapter,\n  type FetchConnectionOptions,\n  type FetchJsonOptions,\n  type XhrConnectionOptions,\n} from \"@tanstack/ai-react\";\n```\n\nFor React Native or Expo chat screens, use an absolute server URL and prefer\n`xhrHttpStream()` with a server route that returns `toHttpResponse()`. Use\n`xhrServerSentEvents()` with `toServerSentEventsResponse()` when you want SSE.\nUse `fetchHttpStream()` only when the runtime supports streaming `fetch`,\n`Response.body.getReader()`, and `TextDecoder`; otherwise it throws\n`UnsupportedResponseStreamError`.\n\nIf the host cannot stream at all, use `fetchJson()` with a server route that\nreturns `toJsonResponse()`. See [JSON](../transports/json).\n\nXHR adapter options include `headers`, `withCredentials`, `signal`, `body`, and\n`xhrFactory`. Fetch adapter options include `headers`, `credentials`, `signal`,\n`body`, and `fetchClient`. `fetchJson()` also takes `pollIntervalMs`. Both option objects may be provided directly or as a\nfunction that resolves per request.\n\nFor error narrowing, import `UnsupportedResponseStreamError` and\n`StreamTruncatedError` from `@tanstack/ai-client`.\n\n## Example: Basic Chat\n\n```tsx\nimport { useState } from \"react\";\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nexport function Chat() {\n  const [input, setInput] = useState(\"\");\n\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (input.trim() && !isLoading) {\n      sendMessage(input);\n      setInput(\"\");\n    }\n  };\n\n  return (\n    <div>\n      <div>\n        {messages.map((message) => (\n          <div key={message.id}>\n            <strong>{message.role}:</strong>\n            {message.parts.map((part, idx) => {\n              if (part.type === \"thinking\") {\n                return (\n                  <div key={idx} className=\"text-sm text-gray-500 italic\">\n                    💭 Thinking: {part.content}\n                  </div>\n                );\n              }\n              if (part.type === \"text\") {\n                return <span key={idx}>{part.content}</span>;\n              }\n              return null;\n            })}\n          </div>\n        ))}\n      </div>\n      <form onSubmit={handleSubmit}>\n        <input\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n          disabled={isLoading}\n        />\n        <button type=\"submit\" disabled={isLoading}>\n          Send\n        </button>\n      </form>\n    </div>\n  );\n}\n```\n\n## Example: Tool Approval\n\n```tsx\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nexport function ChatWithApproval() {\n  const { messages, sendMessage, addToolApprovalResponse } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n\n  return (\n    <div>\n      {messages.map((message) =>\n        message.parts.map((part) => {\n          if (\n            part.type === \"tool-call\" &&\n            part.state === \"approval-requested\" &&\n            part.approval\n          ) {\n            return (\n              <div key={part.id}>\n                <p>Approve: {part.name}</p>\n                <button\n                  onClick={() =>\n                    addToolApprovalResponse({\n                      id: part.approval!.id,\n                      approved: true,\n                    })\n                  }\n                >\n                  Approve\n                </button>\n                <button\n                  onClick={() =>\n                    addToolApprovalResponse({\n                      id: part.approval!.id,\n                      approved: false,\n                    })\n                  }\n                >\n                  Deny\n                </button>\n              </div>\n            );\n          }\n          return null;\n        })\n      )}\n    </div>\n  );\n}\n```\n\n## Example: Client Tools with Type Safety\n\n```tsx\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { \n  createChatClientOptions, \n  type InferChatMessages \n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\nimport { useState } from \"react\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Update the UI with a notification\",\n  inputSchema: z.object({\n    message: z.string(),\n    type: z.string(),\n  }),\n  outputSchema: z.object({ success: z.boolean() }),\n});\n\nconst saveToStorageDef = toolDefinition({\n  name: \"saveToStorage\",\n  description: \"Save a value to storage\",\n  inputSchema: z.object({\n    key: z.string(),\n    value: z.string(),\n  }),\n  outputSchema: z.object({ saved: z.boolean() }),\n});\n\nexport function ChatWithClientTools() {\n  const [notification, setNotification] = useState<{ message: string; type: string } | null>(null);\n\n  // Create client implementations\n  const updateUI = updateUIDef.client((input) => {\n    // ✅ input is fully typed!\n    setNotification({ message: input.message, type: input.type });\n    return { success: true };\n  });\n\n  const saveToStorage = saveToStorageDef.client((input) => {\n    localStorage.setItem(input.key, input.value);\n    return { saved: true };\n  });\n\n  // Create typed tools array (no 'as const' needed!)\n  const tools = [updateUI, saveToStorage];\n\n  const { messages, sendMessage } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    tools, // ✅ Automatic execution, full type safety\n  });\n\n  return (\n    <div>\n      {messages.map((message) =>\n        message.parts.map((part) => {\n          if (part.type === \"tool-call\" && part.name === \"updateUI\") {\n            // ✅ part.input and part.output are fully typed!\n            return <div key={part.id}>Tool executed: {part.name}</div>;\n          }\n          return null;\n        })\n      )}\n    </div>\n  );\n}\n```\n\n## `createChatClientOptions(options)`\n\nHelper to create typed chat options (re-exported from `@tanstack/ai-client`).\n\n```typescript\nimport { \n  createChatClientOptions, \n  fetchServerSentEvents,\n  type InferChatMessages \n} from \"@tanstack/ai-client\";\nimport { tool1, tool2 } from \"./tools\";\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [tool1, tool2];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\ntype Messages = InferChatMessages<typeof chatOptions>;\n```\n\n## Types\n\nRe-exported from `@tanstack/ai-client`:\n\n- `UIMessage<TTools>` - Message type with tool type parameter\n- `MessagePart<TTools>` - Message part with tool type parameter\n- `TextPart` - Text content part\n- `ThinkingPart` - Thinking content part\n- `ToolCallPart<TTools>` - Tool call part (discriminated union)\n- `ToolResultPart` - Tool result part\n- `ChatClientOptions<TTools, TContext>` - Chat client options with typed client runtime context\n- `ConnectionAdapter` - Connection adapter interface\n- `InferChatMessages<T>` - Extract message type from options\n\nRe-exported from `@tanstack/ai`:\n\n- `toolDefinition()` - Create isomorphic tool definition\n- `ToolDefinitionInstance` - Tool definition type\n- `ClientTool` - Client tool type\n- `ServerTool` - Server tool type\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Bring Your Own Key](../advanced/byok) - Store keys and pass `byok` into `useChat`\n- [Tools Guide](../tools/tools) - Learn about the isomorphic tool system\n- [Client Tools](../tools/client-tools) - Learn about client-side tools\n","originalRawMarkdown":"---\ntitle: \"@tanstack/ai-react\"\nslug: /api/ai-react\norder: 3\ndescription: \"API reference for @tanstack/ai-react — React hooks including useChat for streaming chat with full type safety in React apps.\"\nkeywords:\n  - tanstack ai\n  - \"@tanstack/ai-react\"\n  - react\n  - useChat\n  - react hooks\n  - api reference\n---\n\nReact hooks for TanStack AI, providing convenient React bindings for the headless client.\n\nFor a typed headless chat UI, see [React Chat UI](../ui/react).\nFor React Native, the documented support surface is narrow: `useChat` with chat\nconnection adapters. React DOM-specific UI packages and TanStack AI devtools UI\nare not part of the React Native support surface.\n\nFor a complete native journey, see\n[Quick Start: React Native](../getting-started/quick-start-react-native).\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-react\n\n<!-- ::end:tabs -->\n\n## `useRegisterWebMCPTools(tools, options?)`\n\nRegister executable client tools after the React component mounts. React removes them on cleanup and replaces them when `tools` or `options` change.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```tsx\nimport {\n  useRegisterWebMCPTools,\n  type UseRegisterWebMCPToolsOptions,\n} from \"@tanstack/ai-react\";\nimport { searchProducts } from \"./tools\";\n\nconst tools = [searchProducts];\nconst options: UseRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error);\n  },\n};\n\nfunction ProductsPage() {\n  useRegisterWebMCPTools(tools, options);\n  return null;\n}\n```\n\n`UseRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The hook owns the registration signal.\n\nThe `context` field is required when a tool declares a required runtime context. Keep `tools` and `options` stable when their values do not change.\n\n## `usePageWebMCPTools(options?)`\n\nRead the WebMCP tools on the page as client tools. The array starts empty and updates when the page adds or removes a tool. Pass it to `useChat` as `tools`.\n\n```tsx\nimport { usePageWebMCPTools } from \"@tanstack/ai-react\";\n\nexport function useSameOriginPageTools() {\n  return usePageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  });\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## `createChatHook(options)`\n\nBind `chatOptions` once at module scope. Call `useChat()` in the screen to create the instance. Per-call overrides may set `threadId`, `initialMessages`, `live`, and `forwardedProps`. They must not change `tools`, `interrupts`, or `outputSchema`.\n\n```tsx\nimport { createChatHook, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst chatOptions = {\n  connection: fetchServerSentEvents(\"/api/chat\"),\n};\n\nconst { useChat } = createChatHook(chatOptions);\n\nfunction ChatScreen() {\n  const chat = useChat({ threadId: \"support-1\" });\n  return null;\n}\n```\n\n`useChat(chatOptions)` from this package still works when you want to pass the full object at the call site. Rename the bound hook if both are in one file: `const { useChat: useSupportChat } = createChatHook(chatOptions)`.\n\n## `useChat(options?)`\n\nMain hook for managing chat state in React with full type safety.\n\n```tsx\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { \n  createChatClientOptions, \n  type InferChatMessages \n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\nimport { useState } from \"react\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Update the UI with a notification\",\n  inputSchema: z.object({\n    message: z.string(),\n  }),\n  outputSchema: z.object({ success: z.boolean() }),\n});\n\nfunction ChatComponent() {\n  const [notification, setNotification] = useState<string | null>(null);\n\n  // Create client tool implementations\n  const updateUI = updateUIDef.client((input) => {\n    setNotification(input.message);\n    return { success: true };\n  });\n\n  // Create typed tools array (no 'as const' needed!)\n  const tools = [updateUI];\n\n  const chatOptions = createChatClientOptions({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    tools,\n  });\n\n  // Fully typed messages!\n  type ChatMessages = InferChatMessages<typeof chatOptions>;\n\n  const { messages, sendMessage, isLoading, error, addToolApprovalResponse } =\n    useChat(chatOptions);\n\n  return <div>{/* Chat UI with typed messages */}</div>;\n}\n```\n\n### Options\n\nExtends `ChatClientOptions` from `@tanstack/ai-client`:\n\n- `connection` - Connection adapter (required)\n- `tools?` - Array of client tool implementations (with `.client()` method)\n- `initialMessages?` - Initial messages array\n- `threadId?` - The only identity for this chat. Required when persistence is on. If omitted, minted after mount.\n- `forwardedProps?` - Arbitrary client-controlled JSON forwarded to the server in the AG-UI `RunAgentInput.forwardedProps` field (e.g., `{ provider: 'openai', model: 'gpt-5.5' }`)\n- `body?` - **Deprecated.** Use `forwardedProps` instead. Still works for backward compatibility; values are merged into `forwardedProps` on the wire\n- `byok?` - Optional BYOK keyring from `defineByok`. On each send the client prepares the resolved provider and stamps `x-byok-*` request headers. Keys never go in the body\n- `byokProvider?` - Optional function that returns the provider slug for this chat. If it returns a slug, only that key is prepared and sent. Otherwise the merged `provider` from `forwardedProps`, `body`, and per-call `sendMessage` `body` is used. Later sources win. If no slug resolves, the send throws instead of attaching every stored key\n- `context?` - Typed client-local runtime context passed to client tool implementations. This value is not serialized to the server\n- `onResponse?` - Callback when response is received\n- `onChunk?` - Callback when stream chunk is received\n- `onFinish?` - Callback when response finishes\n- `onError?` - Callback when error occurs\n- `onInterruptStateChange?` - Callback when interrupt state changes; context source is `hydrate` for restored state and `live` for streamed or client-initiated updates\n- `streamProcessor?` - Stream processing configuration\n\n**Note:** Client tools are now automatically executed - no `onToolCall` callback needed!\n\n### Returns\n\n```typescript\nimport type { UIMessage } from \"@tanstack/ai-react\";\nimport type { ModelMessage } from \"@tanstack/ai\";\nimport type {\n  MultimodalContent,\n  SendMessageOptions,\n} from \"@tanstack/ai-client\";\n\ninterface UseChatReturn {\n  messages: UIMessage[];\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>;\n  append: (message: ModelMessage | UIMessage) => Promise<void>;\n  addToolResult: (result: {\n    toolCallId: string;\n    tool: string;\n    output: any;\n    state?: \"output-available\" | \"output-error\";\n    errorText?: string;\n  }) => Promise<void>;\n  addToolApprovalResponse: (response: {\n    id: string;\n    approved: boolean;\n  }) => Promise<void>;\n  reload: () => Promise<void>;\n  stop: () => void;\n  isLoading: boolean;\n  isHydrating: boolean;\n  error: Error | undefined;\n  setMessages: (messages: UIMessage[]) => void;\n  clear: () => void;\n}\n```\n\n## `useByok(client)`\n\nSubscribe to a `ByokClient` snapshot in React.\n\n```tsx\nimport { useByok } from \"@tanstack/ai-react\";\nimport { byok } from \"./byok\";\n\nexport function KeyStatus() {\n  const snapshot = useByok(byok);\n  const openai = snapshot.status.openai;\n  const last4 = openai && \"masked\" in openai ? openai.masked : \"No key\";\n  return <p>{last4}</p>;\n}\n```\n\n`snapshot` has `status`, `locked`, and `prompt`. Call `byok.update(provider, value)` from your own UI to save a key. See [Bring Your Own Key](../advanced/byok).\n\n## Connection Adapters\n\nRe-exported from `@tanstack/ai-client` for convenience:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  xhrServerSentEvents,\n  xhrHttpStream,\n  stream,\n  type ConnectionAdapter,\n  type FetchConnectionOptions,\n  type FetchJsonOptions,\n  type XhrConnectionOptions,\n} from \"@tanstack/ai-react\";\n```\n\nFor React Native or Expo chat screens, use an absolute server URL and prefer\n`xhrHttpStream()` with a server route that returns `toHttpResponse()`. Use\n`xhrServerSentEvents()` with `toServerSentEventsResponse()` when you want SSE.\nUse `fetchHttpStream()` only when the runtime supports streaming `fetch`,\n`Response.body.getReader()`, and `TextDecoder`; otherwise it throws\n`UnsupportedResponseStreamError`.\n\nIf the host cannot stream at all, use `fetchJson()` with a server route that\nreturns `toJsonResponse()`. See [JSON](../transports/json).\n\nXHR adapter options include `headers`, `withCredentials`, `signal`, `body`, and\n`xhrFactory`. Fetch adapter options include `headers`, `credentials`, `signal`,\n`body`, and `fetchClient`. `fetchJson()` also takes `pollIntervalMs`. Both option objects may be provided directly or as a\nfunction that resolves per request.\n\nFor error narrowing, import `UnsupportedResponseStreamError` and\n`StreamTruncatedError` from `@tanstack/ai-client`.\n\n## Example: Basic Chat\n\n```tsx\nimport { useState } from \"react\";\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nexport function Chat() {\n  const [input, setInput] = useState(\"\");\n\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (input.trim() && !isLoading) {\n      sendMessage(input);\n      setInput(\"\");\n    }\n  };\n\n  return (\n    <div>\n      <div>\n        {messages.map((message) => (\n          <div key={message.id}>\n            <strong>{message.role}:</strong>\n            {message.parts.map((part, idx) => {\n              if (part.type === \"thinking\") {\n                return (\n                  <div key={idx} className=\"text-sm text-gray-500 italic\">\n                    💭 Thinking: {part.content}\n                  </div>\n                );\n              }\n              if (part.type === \"text\") {\n                return <span key={idx}>{part.content}</span>;\n              }\n              return null;\n            })}\n          </div>\n        ))}\n      </div>\n      <form onSubmit={handleSubmit}>\n        <input\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n          disabled={isLoading}\n        />\n        <button type=\"submit\" disabled={isLoading}>\n          Send\n        </button>\n      </form>\n    </div>\n  );\n}\n```\n\n## Example: Tool Approval\n\n```tsx\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nexport function ChatWithApproval() {\n  const { messages, sendMessage, addToolApprovalResponse } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n  });\n\n  return (\n    <div>\n      {messages.map((message) =>\n        message.parts.map((part) => {\n          if (\n            part.type === \"tool-call\" &&\n            part.state === \"approval-requested\" &&\n            part.approval\n          ) {\n            return (\n              <div key={part.id}>\n                <p>Approve: {part.name}</p>\n                <button\n                  onClick={() =>\n                    addToolApprovalResponse({\n                      id: part.approval!.id,\n                      approved: true,\n                    })\n                  }\n                >\n                  Approve\n                </button>\n                <button\n                  onClick={() =>\n                    addToolApprovalResponse({\n                      id: part.approval!.id,\n                      approved: false,\n                    })\n                  }\n                >\n                  Deny\n                </button>\n              </div>\n            );\n          }\n          return null;\n        })\n      )}\n    </div>\n  );\n}\n```\n\n## Example: Client Tools with Type Safety\n\n```tsx\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { \n  createChatClientOptions, \n  type InferChatMessages \n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\nimport { useState } from \"react\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Update the UI with a notification\",\n  inputSchema: z.object({\n    message: z.string(),\n    type: z.string(),\n  }),\n  outputSchema: z.object({ success: z.boolean() }),\n});\n\nconst saveToStorageDef = toolDefinition({\n  name: \"saveToStorage\",\n  description: \"Save a value to storage\",\n  inputSchema: z.object({\n    key: z.string(),\n    value: z.string(),\n  }),\n  outputSchema: z.object({ saved: z.boolean() }),\n});\n\nexport function ChatWithClientTools() {\n  const [notification, setNotification] = useState<{ message: string; type: string } | null>(null);\n\n  // Create client implementations\n  const updateUI = updateUIDef.client((input) => {\n    // ✅ input is fully typed!\n    setNotification({ message: input.message, type: input.type });\n    return { success: true };\n  });\n\n  const saveToStorage = saveToStorageDef.client((input) => {\n    localStorage.setItem(input.key, input.value);\n    return { saved: true };\n  });\n\n  // Create typed tools array (no 'as const' needed!)\n  const tools = [updateUI, saveToStorage];\n\n  const { messages, sendMessage } = useChat({\n    connection: fetchServerSentEvents(\"/api/chat\"),\n    tools, // ✅ Automatic execution, full type safety\n  });\n\n  return (\n    <div>\n      {messages.map((message) =>\n        message.parts.map((part) => {\n          if (part.type === \"tool-call\" && part.name === \"updateUI\") {\n            // ✅ part.input and part.output are fully typed!\n            return <div key={part.id}>Tool executed: {part.name}</div>;\n          }\n          return null;\n        })\n      )}\n    </div>\n  );\n}\n```\n\n## `createChatClientOptions(options)`\n\nHelper to create typed chat options (re-exported from `@tanstack/ai-client`).\n\n```typescript\nimport { \n  createChatClientOptions, \n  fetchServerSentEvents,\n  type InferChatMessages \n} from \"@tanstack/ai-client\";\nimport { tool1, tool2 } from \"./tools\";\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [tool1, tool2];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\ntype Messages = InferChatMessages<typeof chatOptions>;\n```\n\n## Types\n\nRe-exported from `@tanstack/ai-client`:\n\n- `UIMessage<TTools>` - Message type with tool type parameter\n- `MessagePart<TTools>` - Message part with tool type parameter\n- `TextPart` - Text content part\n- `ThinkingPart` - Thinking content part\n- `ToolCallPart<TTools>` - Tool call part (discriminated union)\n- `ToolResultPart` - Tool result part\n- `ChatClientOptions<TTools, TContext>` - Chat client options with typed client runtime context\n- `ConnectionAdapter` - Connection adapter interface\n- `InferChatMessages<T>` - Extract message type from options\n\nRe-exported from `@tanstack/ai`:\n\n- `toolDefinition()` - Create isomorphic tool definition\n- `ToolDefinitionInstance` - Tool definition type\n- `ClientTool` - Client tool type\n- `ServerTool` - Server tool type\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Bring Your Own Key](../advanced/byok) - Store keys and pass `byok` into `useChat`\n- [Tools Guide](../tools/tools) - Learn about the isomorphic tool system\n- [Client Tools](../tools/client-tools) - Learn about client-side tools\n"}
