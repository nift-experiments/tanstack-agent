---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/ai-remix"},{"type":"text","value":", then call "},{"type":"inlineCode","value":"createChat(handle, options)"},{"type":"text","value":" in a Remix setup function. The package publishes uncompiled source. Remix compiles JSX through "},{"type":"inlineCode","value":"jsxImportSource"},{"type":"text","value":" "},{"type":"inlineCode","value":"remix/ui"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"For a typed headless chat UI, see "},{"type":"link","href":"../ui/remix","children":[{"type":"text","value":"Remix Chat UI"}]},{"type":"text","value":". Import "},{"type":"inlineCode","value":"createChatHook"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-remix/ui"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"remix\":[[\"@tanstack/ai-remix\",\"remix\"]]},\"mode\":\"install\"}"}},{"type":"paragraph","children":[{"type":"inlineCode","value":"remix"},{"type":"text","value":" is a required peer."}]},{"type":"heading","depth":2,"id":"createregisterwebmcptools-handle-tools-options","children":[{"type":"inlineCode","value":"createRegisterWebMCPTools(handle, tools, options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Register executable client tools for a Remix component. Remix removes them when the component "},{"type":"inlineCode","value":"Handle"},{"type":"text","value":" signal aborts."}]},{"type":"paragraph","children":[{"type":"text","value":"For a complete setup and behavior guide, see "},{"type":"link","href":"../tools/webmcp","children":[{"type":"text","value":"WebMCP Tools"}]},{"type":"text","value":"."}]},{"type":"code","value":"import {\n  createRegisterWebMCPTools,\n  type CreateRegisterWebMCPToolsOptions,\n} from '@tanstack/ai-remix'\nimport { clientEntry, type Handle } from 'remix/ui'\nimport { searchProducts } from './tools'\n\nconst tools = [searchProducts]\nconst options: CreateRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error)\n  },\n}\n\nexport const ProductsPage = clientEntry(\n  import.meta.url,\n  function ProductsPage(handle: Handle) {\n    createRegisterWebMCPTools(handle, tools, options)\n    return () => null\n  },\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"CreateRegisterWebMCPToolsOptions<TTools, TContext>"},{"type":"text","value":" contains "},{"type":"inlineCode","value":"toolOptions"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onError"},{"type":"text","value":". The helper uses "},{"type":"inlineCode","value":"handle.signal"},{"type":"text","value":" for registration."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"context"},{"type":"text","value":" field is required when a tool declares a required runtime context."}]},{"type":"heading","depth":2,"id":"createpagewebmcptools-handle-options","children":[{"type":"inlineCode","value":"createPageWebMCPTools(handle, options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Read the WebMCP tools on the page as client tools. The "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" field starts empty. When the page adds or removes a tool, the helper updates "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" and calls "},{"type":"inlineCode","value":"handle.update()"},{"type":"text","value":". Read it in a "},{"type":"inlineCode","value":"get tools()"},{"type":"text","value":" getter on "},{"type":"inlineCode","value":"createChat"},{"type":"text","value":"."}]},{"type":"code","value":"import { createPageWebMCPTools } from '@tanstack/ai-remix'\nimport type { Handle } from 'remix/ui'\n\nexport function readPageTools(handle: Handle) {\n  return createPageWebMCPTools(handle, {\n    filter: (tool) => tool.origin === location.origin,\n  })\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"filter"},{"type":"text","value":" skips a tool when it returns "},{"type":"inlineCode","value":"false"},{"type":"text","value":". "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" gets a failed WebMCP read. For a complete guide, see "},{"type":"link","href":"../tools/webmcp-page-tools","children":[{"type":"text","value":"Page WebMCP Tools in Chat"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"server","children":[{"type":"text","value":"Server"}]},{"type":"paragraph","children":[{"type":"text","value":"A Remix controller action can return the same SSE "},{"type":"inlineCode","value":"Response"},{"type":"text","value":" as any other host."}]},{"type":"code","value":"import {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createController } from 'remix/router'\nimport { post, route } from 'remix/routes'\n\nconst routes = route({\n  chat: {\n    stream: post('/chat'),\n  },\n})\n\nexport default createController(routes.chat, {\n  actions: {\n    async stream({ request }) {\n      const { messages, threadId, runId } =\n        await chatParamsFromRequest(request)\n\n      const stream = chat({\n        adapter: openaiText('gpt-5.6'),\n        messages,\n        threadId,\n        runId,\n      })\n\n      return toServerSentEventsResponse(stream)\n    },\n  },\n})","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"The matching client calls "},{"type":"inlineCode","value":"createChat"},{"type":"text","value":" and streams from that route. See "},{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Quick Start"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"createchat-handle-options","children":[{"type":"inlineCode","value":"createChat(handle, options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Manages chat state in a Remix component. Pass the component "},{"type":"inlineCode","value":"Handle"},{"type":"text","value":" as the first argument. Put "},{"type":"inlineCode","value":"connection"},{"type":"text","value":" and "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" in setup. They are not serializable "},{"type":"inlineCode","value":"clientEntry"},{"type":"text","value":" props."}]},{"type":"code","value":"import { createChat, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from '@tanstack/ai-client'\nimport { toolDefinition } from '@tanstack/ai'\nimport { clientEntry, on, type Handle } from 'remix/ui'\nimport { z } from 'zod'\n\nconst updateUIDef = toolDefinition({\n  name: 'updateUI',\n  description: 'Show a notification in the UI',\n  inputSchema: z.object({ message: z.string() }),\n})\n\nexport const ChatComponent = clientEntry(\n  import.meta.url,\n  function ChatComponent(handle: Handle) {\n    let notification: string | null = null\n    const updateUI = updateUIDef.client((input) => {\n      notification = input.message\n      return { success: true }\n    })\n    const tools = [updateUI]\n\n    const chatOptions = createChatClientOptions({\n      connection: fetchServerSentEvents('/chat'),\n      tools,\n    })\n\n    type ChatMessages = InferChatMessages<typeof chatOptions>\n\n    const chat = createChat(handle, chatOptions)\n\n    return () => (\n      <div>\n        {notification}\n        {chat.isLoading ? 'Loading' : null}\n        {chat.error ? chat.error.message : null}\n        <button\n          type=\"button\"\n          mix={on('click', () => {\n            void chat.sendMessage('hi')\n          })}\n        >\n          Send\n        </button>\n        {chat.messages.length}\n      </div>\n    )\n  },\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Read "},{"type":"inlineCode","value":"chat.messages"},{"type":"text","value":" and "},{"type":"inlineCode","value":"chat.isLoading"},{"type":"text","value":" in the render function so each paint sees the latest values. The default thread id is "},{"type":"inlineCode","value":"options.threadId ?? handle.id"},{"type":"text","value":". When "},{"type":"inlineCode","value":"handle.signal"},{"type":"text","value":" aborts, cleanup runs."}]},{"type":"heading","depth":3,"id":"options-you-pass-first","children":[{"type":"text","value":"Options you pass first"}]},{"type":"paragraph","children":[{"type":"text","value":"Extends "},{"type":"inlineCode","value":"ChatClientOptions"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":". Pass "},{"type":"inlineCode","value":"connection"},{"type":"text","value":" or "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":", not both. "},{"type":"inlineCode","value":"Handle"},{"type":"text","value":" is the first argument, not an option."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"connection"},{"type":"text","value":" or "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":" - how the helper talks to your server"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tools?"},{"type":"text","value":" - client tool implementations from "},{"type":"inlineCode","value":".client()"},{"type":"text","value":". A "},{"type":"inlineCode","value":"get tools()"},{"type":"text","value":" getter is read each time a run starts."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"threadId?"},{"type":"text","value":" - the only identity for this chat. Required when persistence is on"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"initialMessages?"},{"type":"text","value":" - starting transcript"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"forwardedProps?"},{"type":"text","value":" - JSON sent to the server on the AG-UI "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" field"}]}]}]},{"type":"heading","depth":3,"id":"options-you-add-later","children":[{"type":"text","value":"Options you add later"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"live?"},{"type":"text","value":" - subscribe on setup, unsubscribe on dispose"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queue?"},{"type":"text","value":" - what to do when "},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":" runs while a turn is in flight. Default queues"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"interrupts?"},{"type":"text","value":" - typed interrupt definitions"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context?"},{"type":"text","value":" - client-only runtime context for client tools. Not sent to the server"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onResponse?"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onChunk?"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onFinish?"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onError?"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onInterruptStateChange?"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"devtools?"},{"type":"text","value":" - display options. The helper always tags "},{"type":"inlineCode","value":"framework: 'remix'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"body?"},{"type":"text","value":" - deprecated. Use "},{"type":"inlineCode","value":"forwardedProps"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Client tools run automatically."}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"import type { UIMessage } from '@tanstack/ai-remix'\nimport type { ModelMessage } from '@tanstack/ai/client'\nimport type {\n  BoundInterrupts,\n  MultimodalContent,\n  ChatClientState,\n  ConnectionStatus,\n  QueuedMessage,\n  SendMessageOptions,\n} from '@tanstack/ai-client'\n\ninterface CreateChatReturn {\n  messages: Array<UIMessage>\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>\n  append: (message: ModelMessage | UIMessage) => Promise<void>\n  addToolResult: (result: {\n    toolCallId: string\n    tool: string\n    output: unknown\n    state?: 'output-available' | 'output-error'\n    errorText?: string\n  }) => Promise<void>\n  interrupts: BoundInterrupts\n  resolveInterrupts: (approved: boolean) => void\n  reload: () => Promise<void>\n  stop: () => void\n  isLoading: boolean\n  error: Error | undefined\n  status: ChatClientState\n  isSubscribed: boolean\n  connectionStatus: ConnectionStatus\n  sessionGenerating: boolean\n  isHydrating: boolean\n  setMessages: (messages: Array<UIMessage>) => void\n  clear: () => void\n  queue: Array<QueuedMessage>\n  cancelQueued: (id: string) => void\n  runId: string | null\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"State fields are getters. "},{"type":"inlineCode","value":"queue"},{"type":"text","value":" holds sends that wait while a run is busy. "},{"type":"inlineCode","value":"runId"},{"type":"text","value":" is the in-flight turn, or "},{"type":"inlineCode","value":"null"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"For a tool with "},{"type":"inlineCode","value":"needsApproval: true"},{"type":"text","value":", read "},{"type":"inlineCode","value":"chat.interrupts"},{"type":"text","value":". Call "},{"type":"inlineCode","value":"interrupt.resolveInterrupt(true)"},{"type":"text","value":" on the bound "},{"type":"inlineCode","value":"tool-approval"},{"type":"text","value":" item."}]},{"type":"heading","depth":2,"id":"connection-adapters","children":[{"type":"text","value":"Connection adapters"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":":"}]},{"type":"code","value":"import {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  stream,\n  type ConnectionAdapter,\n} from '@tanstack/ai-remix'","lang":"typescript"},{"type":"heading","depth":2,"id":"example-basic-chat","children":[{"type":"text","value":"Example: basic chat"}]},{"type":"code","value":"import { createChat, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport { clientEntry, on, type Handle } from 'remix/ui'\n\nexport const Chat = clientEntry(\n  import.meta.url,\n  function Chat(handle: Handle) {\n    const chat = createChat(handle, {\n      connection: fetchServerSentEvents('/chat'),\n    })\n\n    return () => (\n      <div>\n        {chat.messages.map((message) => (\n          <div key={message.id}>\n            <strong>{message.role}:</strong>\n            {message.parts\n              .filter((part) => part.type === 'text')\n              .map((part) => part.content)\n              .join('')}\n          </div>\n        ))}\n        <form\n          mix={on('submit', (event) => {\n            event.preventDefault()\n            const form = event.currentTarget\n            const text = String(new FormData(form).get('message') ?? '').trim()\n            if (text === '') {\n              return\n            }\n            form.reset()\n            void chat.sendMessage(text)\n          })}\n        >\n          <input name=\"message\" disabled={chat.isLoading} />\n          <button type=\"submit\" disabled={chat.isLoading}>\n            Send\n          </button>\n        </form>\n      </div>\n    )\n  },\n)","lang":"tsx"},{"type":"heading","depth":2,"id":"headless-chat-ui","children":[{"type":"text","value":"Headless chat UI"}]},{"type":"paragraph","children":[{"type":"text","value":"For a typed chat layout with your own Remix components, see "},{"type":"link","href":"../ui/remix","children":[{"type":"text","value":"Remix Chat UI"}]},{"type":"text","value":". Call "},{"type":"inlineCode","value":"createChatHook"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-remix/ui"},{"type":"text","value":" once at module scope. Your app calls "},{"type":"inlineCode","value":"createAppChat(handle)"},{"type":"text","value":" and renders "},{"type":"inlineCode","value":"<ui.Chat chat={chat} />"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"other-helpers","children":[{"type":"text","value":"Other helpers"}]},{"type":"paragraph","children":[{"type":"text","value":"Each helper takes the Remix "},{"type":"inlineCode","value":"Handle"},{"type":"text","value":" as the first argument. Call it in setup."}]},{"type":"heading","depth":3,"id":"createbyok-handle-client","children":[{"type":"inlineCode","value":"createByok(handle, client)"}]},{"type":"paragraph","children":[{"type":"text","value":"Subscribe to a BYOK snapshot. The return is a getter for the latest snapshot."}]},{"type":"code","value":"import { createByok } from '@tanstack/ai-remix'\nimport type { Handle } from 'remix/ui'\nimport { byok } from './byok'\n\nfunction Keys(handle: Handle) {\n  const getSnapshot = createByok(handle, byok)\n  return () => <p>{JSON.stringify(getSnapshot().status)}</p>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Call "},{"type":"inlineCode","value":"byok.update(provider, value)"},{"type":"text","value":" from your own UI to save a key. See "},{"type":"link","href":"../advanced/byok","children":[{"type":"text","value":"Bring Your Own Key"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"createrealtimechat-handle-options","children":[{"type":"inlineCode","value":"createRealtimeChat(handle, options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Realtime voice chat. Pass "},{"type":"inlineCode","value":"getToken"},{"type":"text","value":" and "},{"type":"inlineCode","value":"adapter"},{"type":"text","value":"."}]},{"type":"code","value":"import { createRealtimeChat } from '@tanstack/ai-remix'\nimport { openaiRealtime } from '@tanstack/ai-openai'\nimport { on, type Handle } from 'remix/ui'\n\nfunction VoiceChat(handle: Handle) {\n  const chat = createRealtimeChat(handle, {\n    getToken: () => fetch('/api/realtime-token').then((response) => response.json()),\n    adapter: openaiRealtime(),\n  })\n\n  return () => (\n    <div>\n      <p>Status: {chat.status}</p>\n      <button\n        type=\"button\"\n        mix={on('click', () => {\n          if (chat.status === 'idle') {\n            void chat.connect()\n            return\n          }\n          chat.disconnect()\n        })}\n      >\n        {chat.status === 'idle' ? 'Start' : 'Stop'}\n      </button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"creategeneration-handle-options","children":[{"type":"inlineCode","value":"createGeneration(handle, options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Base helper for one-shot generation. Pass "},{"type":"inlineCode","value":"connection"},{"type":"text","value":" or "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":". Call "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":"."}]},{"type":"code","value":"import { createGeneration, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport { on, type Handle } from 'remix/ui'\n\nfunction CustomGenerator(handle: Handle) {\n  const gen = createGeneration(handle, {\n    connection: fetchServerSentEvents('/api/generate/custom'),\n  })\n\n  return () => (\n    <div>\n      <button\n        type=\"button\"\n        mix={on('click', () => {\n          void gen.generate({ prompt: 'Hello' })\n        })}\n      >\n        Generate\n      </button>\n      {gen.isLoading ? <p>Generating</p> : null}\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"creategenerateimage-handle-options","children":[{"type":"inlineCode","value":"createGenerateImage(handle, options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Image generation. "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"ImageGenerateInput"},{"type":"text","value":". The result is "},{"type":"inlineCode","value":"ImageGenerationResult"},{"type":"text","value":"."}]},{"type":"code","value":"import { createGenerateImage, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport { on, type Handle } from 'remix/ui'\n\nfunction ImageGenerator(handle: Handle) {\n  const image = createGenerateImage(handle, {\n    connection: fetchServerSentEvents('/api/generate/image'),\n  })\n\n  return () => (\n    <div>\n      <button\n        type=\"button\"\n        mix={on('click', () => {\n          void image.generate({ prompt: 'A sunset over mountains' })\n        })}\n      >\n        Generate\n      </button>\n      {image.isLoading ? <p>Generating</p> : null}\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The package also exports "},{"type":"inlineCode","value":"createGenerateAudio"},{"type":"text","value":", "},{"type":"inlineCode","value":"createGenerateSpeech"},{"type":"text","value":", "},{"type":"inlineCode","value":"createGenerateVideo"},{"type":"text","value":", "},{"type":"inlineCode","value":"createTranscription"},{"type":"text","value":", "},{"type":"inlineCode","value":"createSummarize"},{"type":"text","value":", "},{"type":"inlineCode","value":"createAudioRecorder"},{"type":"text","value":", and "},{"type":"inlineCode","value":"createMcpAppBridge"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"types","children":[{"type":"text","value":"Types"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"UIMessage<TTools>"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ChatClientOptions<TTools, TContext>"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"InferChatMessages<T>"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"QueuedMessage"},{"type":"text","value":", "},{"type":"inlineCode","value":"SendMessageOptions"},{"type":"text","value":", "},{"type":"inlineCode","value":"WhenBusy"}]}]}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Quick Start"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/client-tools","children":[{"type":"text","value":"Client tools"}]}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"createregisterwebmcptools-handle-tools-options","text":"createRegisterWebMCPTools(handle, tools, options?)","level":2},{"id":"createpagewebmcptools-handle-options","text":"createPageWebMCPTools(handle, options?)","level":2},{"id":"server","text":"Server","level":2},{"id":"createchat-handle-options","text":"createChat(handle, options)","level":2},{"id":"options-you-pass-first","text":"Options you pass first","level":3},{"id":"options-you-add-later","text":"Options you add later","level":3},{"id":"returns","text":"Returns","level":3},{"id":"connection-adapters","text":"Connection adapters","level":2},{"id":"example-basic-chat","text":"Example: basic chat","level":2},{"id":"headless-chat-ui","text":"Headless chat UI","level":2},{"id":"other-helpers","text":"Other helpers","level":2},{"id":"createbyok-handle-client","text":"createByok(handle, client)","level":3},{"id":"createrealtimechat-handle-options","text":"createRealtimeChat(handle, options)","level":3},{"id":"creategeneration-handle-options","text":"createGeneration(handle, options)","level":3},{"id":"creategenerateimage-handle-options","text":"createGenerateImage(handle, options)","level":3},{"id":"types","text":"Types","level":2},{"id":"next","text":"Next","level":2}]},"frameworks":["remix"],"downloadMarkdown":"\nInstall `@tanstack/ai-remix`, then call `createChat(handle, options)` in a Remix setup function. The package publishes uncompiled source. Remix compiles JSX through `jsxImportSource` `remix/ui`.\n\nFor a typed headless chat UI, see [Remix Chat UI](../ui/remix). Import `createChatHook` from `@tanstack/ai-remix/ui`.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nremix: @tanstack/ai-remix remix\n\n<!-- ::end:tabs -->\n\n`remix` is a required peer.\n\n## `createRegisterWebMCPTools(handle, tools, options?)`\n\nRegister executable client tools for a Remix component. Remix removes them when the component `Handle` signal aborts.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```tsx\nimport {\n  createRegisterWebMCPTools,\n  type CreateRegisterWebMCPToolsOptions,\n} from '@tanstack/ai-remix'\nimport { clientEntry, type Handle } from 'remix/ui'\nimport { searchProducts } from './tools'\n\nconst tools = [searchProducts]\nconst options: CreateRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error)\n  },\n}\n\nexport const ProductsPage = clientEntry(\n  import.meta.url,\n  function ProductsPage(handle: Handle) {\n    createRegisterWebMCPTools(handle, tools, options)\n    return () => null\n  },\n)\n```\n\n`CreateRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The helper uses `handle.signal` for registration.\n\nThe `context` field is required when a tool declares a required runtime context.\n\n## `createPageWebMCPTools(handle, options?)`\n\nRead the WebMCP tools on the page as client tools. The `tools` field starts empty. When the page adds or removes a tool, the helper updates `tools` and calls `handle.update()`. Read it in a `get tools()` getter on `createChat`.\n\n```ts\nimport { createPageWebMCPTools } from '@tanstack/ai-remix'\nimport type { Handle } from 'remix/ui'\n\nexport function readPageTools(handle: Handle) {\n  return createPageWebMCPTools(handle, {\n    filter: (tool) => tool.origin === location.origin,\n  })\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## Server\n\nA Remix controller action can return the same SSE `Response` as any other host.\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createController } from 'remix/router'\nimport { post, route } from 'remix/routes'\n\nconst routes = route({\n  chat: {\n    stream: post('/chat'),\n  },\n})\n\nexport default createController(routes.chat, {\n  actions: {\n    async stream({ request }) {\n      const { messages, threadId, runId } =\n        await chatParamsFromRequest(request)\n\n      const stream = chat({\n        adapter: openaiText('gpt-5.6'),\n        messages,\n        threadId,\n        runId,\n      })\n\n      return toServerSentEventsResponse(stream)\n    },\n  },\n})\n```\n\nThe matching client calls `createChat` and streams from that route. See [Quick Start](../getting-started/quick-start).\n\n## `createChat(handle, options)`\n\nManages chat state in a Remix component. Pass the component `Handle` as the first argument. Put `connection` and `tools` in setup. They are not serializable `clientEntry` props.\n\n```tsx\nimport { createChat, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from '@tanstack/ai-client'\nimport { toolDefinition } from '@tanstack/ai'\nimport { clientEntry, on, type Handle } from 'remix/ui'\nimport { z } from 'zod'\n\nconst updateUIDef = toolDefinition({\n  name: 'updateUI',\n  description: 'Show a notification in the UI',\n  inputSchema: z.object({ message: z.string() }),\n})\n\nexport const ChatComponent = clientEntry(\n  import.meta.url,\n  function ChatComponent(handle: Handle) {\n    let notification: string | null = null\n    const updateUI = updateUIDef.client((input) => {\n      notification = input.message\n      return { success: true }\n    })\n    const tools = [updateUI]\n\n    const chatOptions = createChatClientOptions({\n      connection: fetchServerSentEvents('/chat'),\n      tools,\n    })\n\n    type ChatMessages = InferChatMessages<typeof chatOptions>\n\n    const chat = createChat(handle, chatOptions)\n\n    return () => (\n      <div>\n        {notification}\n        {chat.isLoading ? 'Loading' : null}\n        {chat.error ? chat.error.message : null}\n        <button\n          type=\"button\"\n          mix={on('click', () => {\n            void chat.sendMessage('hi')\n          })}\n        >\n          Send\n        </button>\n        {chat.messages.length}\n      </div>\n    )\n  },\n)\n```\n\nRead `chat.messages` and `chat.isLoading` in the render function so each paint sees the latest values. The default thread id is `options.threadId ?? handle.id`. When `handle.signal` aborts, cleanup runs.\n\n### Options you pass first\n\nExtends `ChatClientOptions` from `@tanstack/ai-client`. Pass `connection` or `fetcher`, not both. `Handle` is the first argument, not an option.\n\n- `connection` or `fetcher` - how the helper talks to your server\n- `tools?` - client tool implementations from `.client()`. A `get tools()` getter is read each time a run starts.\n- `threadId?` - the only identity for this chat. Required when persistence is on\n- `initialMessages?` - starting transcript\n- `forwardedProps?` - JSON sent to the server on the AG-UI `forwardedProps` field\n\n### Options you add later\n\n- `live?` - subscribe on setup, unsubscribe on dispose\n- `queue?` - what to do when `sendMessage` runs while a turn is in flight. Default queues\n- `interrupts?` - typed interrupt definitions\n- `context?` - client-only runtime context for client tools. Not sent to the server\n- `onResponse?` / `onChunk?` / `onFinish?` / `onError?` / `onInterruptStateChange?`\n- `devtools?` - display options. The helper always tags `framework: 'remix'`\n- `body?` - deprecated. Use `forwardedProps`\n\nClient tools run automatically.\n\n### Returns\n\n```typescript\nimport type { UIMessage } from '@tanstack/ai-remix'\nimport type { ModelMessage } from '@tanstack/ai/client'\nimport type {\n  BoundInterrupts,\n  MultimodalContent,\n  ChatClientState,\n  ConnectionStatus,\n  QueuedMessage,\n  SendMessageOptions,\n} from '@tanstack/ai-client'\n\ninterface CreateChatReturn {\n  messages: Array<UIMessage>\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>\n  append: (message: ModelMessage | UIMessage) => Promise<void>\n  addToolResult: (result: {\n    toolCallId: string\n    tool: string\n    output: unknown\n    state?: 'output-available' | 'output-error'\n    errorText?: string\n  }) => Promise<void>\n  interrupts: BoundInterrupts\n  resolveInterrupts: (approved: boolean) => void\n  reload: () => Promise<void>\n  stop: () => void\n  isLoading: boolean\n  error: Error | undefined\n  status: ChatClientState\n  isSubscribed: boolean\n  connectionStatus: ConnectionStatus\n  sessionGenerating: boolean\n  isHydrating: boolean\n  setMessages: (messages: Array<UIMessage>) => void\n  clear: () => void\n  queue: Array<QueuedMessage>\n  cancelQueued: (id: string) => void\n  runId: string | null\n}\n```\n\nState fields are getters. `queue` holds sends that wait while a run is busy. `runId` is the in-flight turn, or `null`.\n\nFor a tool with `needsApproval: true`, read `chat.interrupts`. Call `interrupt.resolveInterrupt(true)` on the bound `tool-approval` item.\n\n## Connection adapters\n\nRe-exported from `@tanstack/ai-client`:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  stream,\n  type ConnectionAdapter,\n} from '@tanstack/ai-remix'\n```\n\n## Example: basic chat\n\n```tsx\nimport { createChat, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport { clientEntry, on, type Handle } from 'remix/ui'\n\nexport const Chat = clientEntry(\n  import.meta.url,\n  function Chat(handle: Handle) {\n    const chat = createChat(handle, {\n      connection: fetchServerSentEvents('/chat'),\n    })\n\n    return () => (\n      <div>\n        {chat.messages.map((message) => (\n          <div key={message.id}>\n            <strong>{message.role}:</strong>\n            {message.parts\n              .filter((part) => part.type === 'text')\n              .map((part) => part.content)\n              .join('')}\n          </div>\n        ))}\n        <form\n          mix={on('submit', (event) => {\n            event.preventDefault()\n            const form = event.currentTarget\n            const text = String(new FormData(form).get('message') ?? '').trim()\n            if (text === '') {\n              return\n            }\n            form.reset()\n            void chat.sendMessage(text)\n          })}\n        >\n          <input name=\"message\" disabled={chat.isLoading} />\n          <button type=\"submit\" disabled={chat.isLoading}>\n            Send\n          </button>\n        </form>\n      </div>\n    )\n  },\n)\n```\n\n## Headless chat UI\n\nFor a typed chat layout with your own Remix components, see [Remix Chat UI](../ui/remix). Call `createChatHook` from `@tanstack/ai-remix/ui` once at module scope. Your app calls `createAppChat(handle)` and renders `<ui.Chat chat={chat} />`.\n\n## Other helpers\n\nEach helper takes the Remix `Handle` as the first argument. Call it in setup.\n\n### `createByok(handle, client)`\n\nSubscribe to a BYOK snapshot. The return is a getter for the latest snapshot.\n\n```tsx\nimport { createByok } from '@tanstack/ai-remix'\nimport type { Handle } from 'remix/ui'\nimport { byok } from './byok'\n\nfunction Keys(handle: Handle) {\n  const getSnapshot = createByok(handle, byok)\n  return () => <p>{JSON.stringify(getSnapshot().status)}</p>\n}\n```\n\nCall `byok.update(provider, value)` from your own UI to save a key. See [Bring Your Own Key](../advanced/byok).\n\n### `createRealtimeChat(handle, options)`\n\nRealtime voice chat. Pass `getToken` and `adapter`.\n\n```tsx\nimport { createRealtimeChat } from '@tanstack/ai-remix'\nimport { openaiRealtime } from '@tanstack/ai-openai'\nimport { on, type Handle } from 'remix/ui'\n\nfunction VoiceChat(handle: Handle) {\n  const chat = createRealtimeChat(handle, {\n    getToken: () => fetch('/api/realtime-token').then((response) => response.json()),\n    adapter: openaiRealtime(),\n  })\n\n  return () => (\n    <div>\n      <p>Status: {chat.status}</p>\n      <button\n        type=\"button\"\n        mix={on('click', () => {\n          if (chat.status === 'idle') {\n            void chat.connect()\n            return\n          }\n          chat.disconnect()\n        })}\n      >\n        {chat.status === 'idle' ? 'Start' : 'Stop'}\n      </button>\n    </div>\n  )\n}\n```\n\n### `createGeneration(handle, options)`\n\nBase helper for one-shot generation. Pass `connection` or `fetcher`. Call `generate()`.\n\n```tsx\nimport { createGeneration, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport { on, type Handle } from 'remix/ui'\n\nfunction CustomGenerator(handle: Handle) {\n  const gen = createGeneration(handle, {\n    connection: fetchServerSentEvents('/api/generate/custom'),\n  })\n\n  return () => (\n    <div>\n      <button\n        type=\"button\"\n        mix={on('click', () => {\n          void gen.generate({ prompt: 'Hello' })\n        })}\n      >\n        Generate\n      </button>\n      {gen.isLoading ? <p>Generating</p> : null}\n    </div>\n  )\n}\n```\n\n### `createGenerateImage(handle, options)`\n\nImage generation. `generate()` accepts `ImageGenerateInput`. The result is `ImageGenerationResult`.\n\n```tsx\nimport { createGenerateImage, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport { on, type Handle } from 'remix/ui'\n\nfunction ImageGenerator(handle: Handle) {\n  const image = createGenerateImage(handle, {\n    connection: fetchServerSentEvents('/api/generate/image'),\n  })\n\n  return () => (\n    <div>\n      <button\n        type=\"button\"\n        mix={on('click', () => {\n          void image.generate({ prompt: 'A sunset over mountains' })\n        })}\n      >\n        Generate\n      </button>\n      {image.isLoading ? <p>Generating</p> : null}\n    </div>\n  )\n}\n```\n\nThe package also exports `createGenerateAudio`, `createGenerateSpeech`, `createGenerateVideo`, `createTranscription`, `createSummarize`, `createAudioRecorder`, and `createMcpAppBridge`.\n\n## Types\n\nRe-exported from `@tanstack/ai-client`:\n\n- `UIMessage<TTools>`\n- `ChatClientOptions<TTools, TContext>`\n- `InferChatMessages<T>`\n- `QueuedMessage`, `SendMessageOptions`, `WhenBusy`\n\n## Next\n\n- [Quick Start](../getting-started/quick-start)\n- [Tools](../tools/tools)\n- [Client tools](../tools/client-tools)\n","originalRawMarkdown":"---\ntitle: \"@tanstack/ai-remix\"\nid: ai-remix\norder: 9\ndescription: \"API reference for @tanstack/ai-remix. Remix 3 helpers including createChat for streaming chat with full type safety.\"\nkeywords:\n  - tanstack ai\n  - \"@tanstack/ai-remix\"\n  - remix\n  - createChat\n  - createChatHook\n  - api reference\n---\n\nInstall `@tanstack/ai-remix`, then call `createChat(handle, options)` in a Remix setup function. The package publishes uncompiled source. Remix compiles JSX through `jsxImportSource` `remix/ui`.\n\nFor a typed headless chat UI, see [Remix Chat UI](../ui/remix). Import `createChatHook` from `@tanstack/ai-remix/ui`.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nremix: @tanstack/ai-remix remix\n\n<!-- ::end:tabs -->\n\n`remix` is a required peer.\n\n## `createRegisterWebMCPTools(handle, tools, options?)`\n\nRegister executable client tools for a Remix component. Remix removes them when the component `Handle` signal aborts.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```tsx\nimport {\n  createRegisterWebMCPTools,\n  type CreateRegisterWebMCPToolsOptions,\n} from '@tanstack/ai-remix'\nimport { clientEntry, type Handle } from 'remix/ui'\nimport { searchProducts } from './tools'\n\nconst tools = [searchProducts]\nconst options: CreateRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error)\n  },\n}\n\nexport const ProductsPage = clientEntry(\n  import.meta.url,\n  function ProductsPage(handle: Handle) {\n    createRegisterWebMCPTools(handle, tools, options)\n    return () => null\n  },\n)\n```\n\n`CreateRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The helper uses `handle.signal` for registration.\n\nThe `context` field is required when a tool declares a required runtime context.\n\n## `createPageWebMCPTools(handle, options?)`\n\nRead the WebMCP tools on the page as client tools. The `tools` field starts empty. When the page adds or removes a tool, the helper updates `tools` and calls `handle.update()`. Read it in a `get tools()` getter on `createChat`.\n\n```ts\nimport { createPageWebMCPTools } from '@tanstack/ai-remix'\nimport type { Handle } from 'remix/ui'\n\nexport function readPageTools(handle: Handle) {\n  return createPageWebMCPTools(handle, {\n    filter: (tool) => tool.origin === location.origin,\n  })\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## Server\n\nA Remix controller action can return the same SSE `Response` as any other host.\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createController } from 'remix/router'\nimport { post, route } from 'remix/routes'\n\nconst routes = route({\n  chat: {\n    stream: post('/chat'),\n  },\n})\n\nexport default createController(routes.chat, {\n  actions: {\n    async stream({ request }) {\n      const { messages, threadId, runId } =\n        await chatParamsFromRequest(request)\n\n      const stream = chat({\n        adapter: openaiText('gpt-5.6'),\n        messages,\n        threadId,\n        runId,\n      })\n\n      return toServerSentEventsResponse(stream)\n    },\n  },\n})\n```\n\nThe matching client calls `createChat` and streams from that route. See [Quick Start](../getting-started/quick-start).\n\n## `createChat(handle, options)`\n\nManages chat state in a Remix component. Pass the component `Handle` as the first argument. Put `connection` and `tools` in setup. They are not serializable `clientEntry` props.\n\n```tsx\nimport { createChat, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from '@tanstack/ai-client'\nimport { toolDefinition } from '@tanstack/ai'\nimport { clientEntry, on, type Handle } from 'remix/ui'\nimport { z } from 'zod'\n\nconst updateUIDef = toolDefinition({\n  name: 'updateUI',\n  description: 'Show a notification in the UI',\n  inputSchema: z.object({ message: z.string() }),\n})\n\nexport const ChatComponent = clientEntry(\n  import.meta.url,\n  function ChatComponent(handle: Handle) {\n    let notification: string | null = null\n    const updateUI = updateUIDef.client((input) => {\n      notification = input.message\n      return { success: true }\n    })\n    const tools = [updateUI]\n\n    const chatOptions = createChatClientOptions({\n      connection: fetchServerSentEvents('/chat'),\n      tools,\n    })\n\n    type ChatMessages = InferChatMessages<typeof chatOptions>\n\n    const chat = createChat(handle, chatOptions)\n\n    return () => (\n      <div>\n        {notification}\n        {chat.isLoading ? 'Loading' : null}\n        {chat.error ? chat.error.message : null}\n        <button\n          type=\"button\"\n          mix={on('click', () => {\n            void chat.sendMessage('hi')\n          })}\n        >\n          Send\n        </button>\n        {chat.messages.length}\n      </div>\n    )\n  },\n)\n```\n\nRead `chat.messages` and `chat.isLoading` in the render function so each paint sees the latest values. The default thread id is `options.threadId ?? handle.id`. When `handle.signal` aborts, cleanup runs.\n\n### Options you pass first\n\nExtends `ChatClientOptions` from `@tanstack/ai-client`. Pass `connection` or `fetcher`, not both. `Handle` is the first argument, not an option.\n\n- `connection` or `fetcher` - how the helper talks to your server\n- `tools?` - client tool implementations from `.client()`. A `get tools()` getter is read each time a run starts.\n- `threadId?` - the only identity for this chat. Required when persistence is on\n- `initialMessages?` - starting transcript\n- `forwardedProps?` - JSON sent to the server on the AG-UI `forwardedProps` field\n\n### Options you add later\n\n- `live?` - subscribe on setup, unsubscribe on dispose\n- `queue?` - what to do when `sendMessage` runs while a turn is in flight. Default queues\n- `interrupts?` - typed interrupt definitions\n- `context?` - client-only runtime context for client tools. Not sent to the server\n- `onResponse?` / `onChunk?` / `onFinish?` / `onError?` / `onInterruptStateChange?`\n- `devtools?` - display options. The helper always tags `framework: 'remix'`\n- `body?` - deprecated. Use `forwardedProps`\n\nClient tools run automatically.\n\n### Returns\n\n```typescript\nimport type { UIMessage } from '@tanstack/ai-remix'\nimport type { ModelMessage } from '@tanstack/ai/client'\nimport type {\n  BoundInterrupts,\n  MultimodalContent,\n  ChatClientState,\n  ConnectionStatus,\n  QueuedMessage,\n  SendMessageOptions,\n} from '@tanstack/ai-client'\n\ninterface CreateChatReturn {\n  messages: Array<UIMessage>\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>\n  append: (message: ModelMessage | UIMessage) => Promise<void>\n  addToolResult: (result: {\n    toolCallId: string\n    tool: string\n    output: unknown\n    state?: 'output-available' | 'output-error'\n    errorText?: string\n  }) => Promise<void>\n  interrupts: BoundInterrupts\n  resolveInterrupts: (approved: boolean) => void\n  reload: () => Promise<void>\n  stop: () => void\n  isLoading: boolean\n  error: Error | undefined\n  status: ChatClientState\n  isSubscribed: boolean\n  connectionStatus: ConnectionStatus\n  sessionGenerating: boolean\n  isHydrating: boolean\n  setMessages: (messages: Array<UIMessage>) => void\n  clear: () => void\n  queue: Array<QueuedMessage>\n  cancelQueued: (id: string) => void\n  runId: string | null\n}\n```\n\nState fields are getters. `queue` holds sends that wait while a run is busy. `runId` is the in-flight turn, or `null`.\n\nFor a tool with `needsApproval: true`, read `chat.interrupts`. Call `interrupt.resolveInterrupt(true)` on the bound `tool-approval` item.\n\n## Connection adapters\n\nRe-exported from `@tanstack/ai-client`:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  stream,\n  type ConnectionAdapter,\n} from '@tanstack/ai-remix'\n```\n\n## Example: basic chat\n\n```tsx\nimport { createChat, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport { clientEntry, on, type Handle } from 'remix/ui'\n\nexport const Chat = clientEntry(\n  import.meta.url,\n  function Chat(handle: Handle) {\n    const chat = createChat(handle, {\n      connection: fetchServerSentEvents('/chat'),\n    })\n\n    return () => (\n      <div>\n        {chat.messages.map((message) => (\n          <div key={message.id}>\n            <strong>{message.role}:</strong>\n            {message.parts\n              .filter((part) => part.type === 'text')\n              .map((part) => part.content)\n              .join('')}\n          </div>\n        ))}\n        <form\n          mix={on('submit', (event) => {\n            event.preventDefault()\n            const form = event.currentTarget\n            const text = String(new FormData(form).get('message') ?? '').trim()\n            if (text === '') {\n              return\n            }\n            form.reset()\n            void chat.sendMessage(text)\n          })}\n        >\n          <input name=\"message\" disabled={chat.isLoading} />\n          <button type=\"submit\" disabled={chat.isLoading}>\n            Send\n          </button>\n        </form>\n      </div>\n    )\n  },\n)\n```\n\n## Headless chat UI\n\nFor a typed chat layout with your own Remix components, see [Remix Chat UI](../ui/remix). Call `createChatHook` from `@tanstack/ai-remix/ui` once at module scope. Your app calls `createAppChat(handle)` and renders `<ui.Chat chat={chat} />`.\n\n## Other helpers\n\nEach helper takes the Remix `Handle` as the first argument. Call it in setup.\n\n### `createByok(handle, client)`\n\nSubscribe to a BYOK snapshot. The return is a getter for the latest snapshot.\n\n```tsx\nimport { createByok } from '@tanstack/ai-remix'\nimport type { Handle } from 'remix/ui'\nimport { byok } from './byok'\n\nfunction Keys(handle: Handle) {\n  const getSnapshot = createByok(handle, byok)\n  return () => <p>{JSON.stringify(getSnapshot().status)}</p>\n}\n```\n\nCall `byok.update(provider, value)` from your own UI to save a key. See [Bring Your Own Key](../advanced/byok).\n\n### `createRealtimeChat(handle, options)`\n\nRealtime voice chat. Pass `getToken` and `adapter`.\n\n```tsx\nimport { createRealtimeChat } from '@tanstack/ai-remix'\nimport { openaiRealtime } from '@tanstack/ai-openai'\nimport { on, type Handle } from 'remix/ui'\n\nfunction VoiceChat(handle: Handle) {\n  const chat = createRealtimeChat(handle, {\n    getToken: () => fetch('/api/realtime-token').then((response) => response.json()),\n    adapter: openaiRealtime(),\n  })\n\n  return () => (\n    <div>\n      <p>Status: {chat.status}</p>\n      <button\n        type=\"button\"\n        mix={on('click', () => {\n          if (chat.status === 'idle') {\n            void chat.connect()\n            return\n          }\n          chat.disconnect()\n        })}\n      >\n        {chat.status === 'idle' ? 'Start' : 'Stop'}\n      </button>\n    </div>\n  )\n}\n```\n\n### `createGeneration(handle, options)`\n\nBase helper for one-shot generation. Pass `connection` or `fetcher`. Call `generate()`.\n\n```tsx\nimport { createGeneration, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport { on, type Handle } from 'remix/ui'\n\nfunction CustomGenerator(handle: Handle) {\n  const gen = createGeneration(handle, {\n    connection: fetchServerSentEvents('/api/generate/custom'),\n  })\n\n  return () => (\n    <div>\n      <button\n        type=\"button\"\n        mix={on('click', () => {\n          void gen.generate({ prompt: 'Hello' })\n        })}\n      >\n        Generate\n      </button>\n      {gen.isLoading ? <p>Generating</p> : null}\n    </div>\n  )\n}\n```\n\n### `createGenerateImage(handle, options)`\n\nImage generation. `generate()` accepts `ImageGenerateInput`. The result is `ImageGenerationResult`.\n\n```tsx\nimport { createGenerateImage, fetchServerSentEvents } from '@tanstack/ai-remix'\nimport { on, type Handle } from 'remix/ui'\n\nfunction ImageGenerator(handle: Handle) {\n  const image = createGenerateImage(handle, {\n    connection: fetchServerSentEvents('/api/generate/image'),\n  })\n\n  return () => (\n    <div>\n      <button\n        type=\"button\"\n        mix={on('click', () => {\n          void image.generate({ prompt: 'A sunset over mountains' })\n        })}\n      >\n        Generate\n      </button>\n      {image.isLoading ? <p>Generating</p> : null}\n    </div>\n  )\n}\n```\n\nThe package also exports `createGenerateAudio`, `createGenerateSpeech`, `createGenerateVideo`, `createTranscription`, `createSummarize`, `createAudioRecorder`, and `createMcpAppBridge`.\n\n## Types\n\nRe-exported from `@tanstack/ai-client`:\n\n- `UIMessage<TTools>`\n- `ChatClientOptions<TTools, TContext>`\n- `InferChatMessages<T>`\n- `QueuedMessage`, `SendMessageOptions`, `WhenBusy`\n\n## Next\n\n- [Quick Start](../getting-started/quick-start)\n- [Tools](../tools/tools)\n- [Client tools](../tools/client-tools)\n"}
