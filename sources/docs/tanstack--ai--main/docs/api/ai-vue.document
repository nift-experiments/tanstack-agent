{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Vue composables for TanStack AI, providing convenient Vue 3 bindings for the headless client."}]},{"type":"paragraph","children":[{"type":"text","value":"For a typed headless chat UI, see "},{"type":"link","href":"../ui/vue","children":[{"type":"text","value":"Vue Chat UI"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"vue\":[[\"@tanstack/ai-vue\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"useregisterwebmcptools-tools-options","children":[{"type":"inlineCode","value":"useRegisterWebMCPTools(tools, options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Register executable client tools for the current Vue scope. Vue removes them when the scope is disposed."}]},{"type":"paragraph","children":[{"type":"text","value":"For a complete setup and behavior guide, see "},{"type":"link","href":"../tools/webmcp","children":[{"type":"text","value":"WebMCP Tools"}]},{"type":"text","value":"."}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport {\n  useRegisterWebMCPTools,\n  type UseRegisterWebMCPToolsOptions,\n} from \"@tanstack/ai-vue\";\nimport { searchProducts } from \"./tools\";\n\nconst tools = [searchProducts];\nconst options: UseRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error);\n  },\n};\n\nuseRegisterWebMCPTools(tools, options);\n</script>","lang":"vue"},{"type":"paragraph","children":[{"type":"inlineCode","value":"UseRegisterWebMCPToolsOptions<TTools, TContext>"},{"type":"text","value":" contains "},{"type":"inlineCode","value":"toolOptions"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onError"},{"type":"text","value":". The composable owns the registration signal."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"context"},{"type":"text","value":" field is required when a tool declares a required runtime context."}]},{"type":"heading","depth":2,"id":"usepagewebmcptools-options","children":[{"type":"inlineCode","value":"usePageWebMCPTools(options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Read the WebMCP tools on the page as client tools. The ref starts empty and updates when the page adds or removes a tool. Pass the ref to "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" as "},{"type":"inlineCode","value":"tools"},{"type":"text","value":"."}]},{"type":"code","value":"import { usePageWebMCPTools } from \"@tanstack/ai-vue\";\n\nexport function useSameOriginPageTools() {\n  return usePageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  });\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"filter"},{"type":"text","value":" skips a tool when it returns "},{"type":"inlineCode","value":"false"},{"type":"text","value":". "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" gets a failed WebMCP read. For a complete guide, see "},{"type":"link","href":"../tools/webmcp-page-tools","children":[{"type":"text","value":"Page WebMCP Tools in Chat"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"createchathook-options","children":[{"type":"inlineCode","value":"createChatHook(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Bind "},{"type":"inlineCode","value":"chatOptions"},{"type":"text","value":" once at module scope. Call "},{"type":"inlineCode","value":"useChat()"},{"type":"text","value":" in the screen to create the instance. Per-call overrides may set "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":", "},{"type":"inlineCode","value":"initialMessages"},{"type":"text","value":", "},{"type":"inlineCode","value":"live"},{"type":"text","value":", and "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":". They must not change "},{"type":"inlineCode","value":"tools"},{"type":"text","value":", "},{"type":"inlineCode","value":"interrupts"},{"type":"text","value":", or "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":"."}]},{"type":"code","value":"import { createChatHook, fetchServerSentEvents } from \"@tanstack/ai-vue\";\n\nconst chatOptions = {\n  connection: fetchServerSentEvents(\"/api/chat\"),\n};\n\nconst { useChat } = createChatHook(chatOptions);\n\nconst chat = useChat({ threadId: \"support-1\" });","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"useChat(chatOptions)"},{"type":"text","value":" from this package still works when you want to pass the full object at the call site. Rename the bound composable if both are in one file: "},{"type":"inlineCode","value":"const { useChat: useSupportChat } = createChatHook(chatOptions)"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"usechat-options","children":[{"type":"inlineCode","value":"useChat(options?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Main composable for managing chat state in Vue with full type safety."}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\nimport { ref } from \"vue\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Show a notification in the UI\",\n  inputSchema: z.object({ message: z.string() }),\n});\n\nconst notification = ref<string | null>(null);\n\n// In <script setup>\nconst updateUI = updateUIDef.client((input) => {\n  notification.value = input.message;\n  return { success: true };\n});\n\nconst tools = [updateUI];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\n// Fully typed messages!\ntype ChatMessages = InferChatMessages<typeof chatOptions>;\n\nconst { messages, sendMessage, isLoading, error, addToolApprovalResponse } =\n  useChat(chatOptions);","lang":"typescript"},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"paragraph","children":[{"type":"text","value":"Extends "},{"type":"inlineCode","value":"ChatClientOptions"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":" (minus internal state callbacks):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"connection"},{"type":"text","value":" - Connection adapter (required)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tools?"},{"type":"text","value":" - Array of client tool implementations (with "},{"type":"inlineCode","value":".client()"},{"type":"text","value":" method). Pass a ref or getter to change the tools after the chat is created."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"initialMessages?"},{"type":"text","value":" - Initial messages array"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"threadId?"},{"type":"text","value":" - The only identity for this chat. Required when persistence is on. If omitted, minted after mount."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"forwardedProps?"},{"type":"text","value":" - Arbitrary client-controlled JSON forwarded to the server in the AG-UI "},{"type":"inlineCode","value":"RunAgentInput.forwardedProps"},{"type":"text","value":" field (reactive -- changes are synced automatically via "},{"type":"inlineCode","value":"watch"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"body?"},{"type":"text","value":" - "},{"type":"strong","children":[{"type":"text","value":"Deprecated."}]},{"type":"text","value":" Use "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" instead. Still works for backward compatibility; values are merged into "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" on the wire (reactive)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"byok?"},{"type":"text","value":" - Optional BYOK keyring from "},{"type":"inlineCode","value":"defineByok"},{"type":"text","value":". On each send the client prepares the resolved provider and stamps "},{"type":"inlineCode","value":"x-byok-*"},{"type":"text","value":" request headers. Keys never go in the body"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"byokProvider?"},{"type":"text","value":" - Optional function that returns the provider slug for this chat. If it returns a slug, only that key is prepared and sent. Otherwise the merged "},{"type":"inlineCode","value":"provider"},{"type":"text","value":" from "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"body"},{"type":"text","value":", and per-call "},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":" "},{"type":"inlineCode","value":"body"},{"type":"text","value":" is used. Later sources win. If no slug resolves, the send throws instead of attaching every stored key"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context?"},{"type":"text","value":" - Typed client-local runtime context passed to client tool implementations (reactive). This value is not serialized to the server"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"live?"},{"type":"text","value":" - Enable live subscription mode (auto-subscribes/unsubscribes)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onResponse?"},{"type":"text","value":" - Callback when response is received"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onChunk?"},{"type":"text","value":" - Callback when stream chunk is received"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onFinish?"},{"type":"text","value":" - Callback when response finishes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onError?"},{"type":"text","value":" - Callback when error occurs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onInterruptStateChange?"},{"type":"text","value":" - Callback when interrupt state changes; context source is "},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" for restored state and "},{"type":"inlineCode","value":"live"},{"type":"text","value":" for streamed or client-initiated updates"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onCustomEvent?"},{"type":"text","value":" - Callback for custom stream events"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"streamProcessor?"},{"type":"text","value":" - Stream processing configuration"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Client tools are now automatically executed - no "},{"type":"inlineCode","value":"onToolCall"},{"type":"text","value":" callback needed!"}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"import type { DeepReadonly, ShallowRef } from \"vue\";\nimport type { UIMessage } from \"@tanstack/ai-vue\";\nimport type { ModelMessage } from \"@tanstack/ai/client\";\nimport type {\n  MultimodalContent,\n  ChatClientState,\n  ConnectionStatus,\n  SendMessageOptions,\n} from \"@tanstack/ai-client\";\n\ninterface UseChatReturn {\n  messages: DeepReadonly<ShallowRef<UIMessage[]>>;\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>;\n  append: (message: ModelMessage | UIMessage) => Promise<void>;\n  addToolResult: (result: {\n    toolCallId: string;\n    tool: string;\n    output: any;\n    state?: \"output-available\" | \"output-error\";\n    errorText?: string;\n  }) => Promise<void>;\n  addToolApprovalResponse: (response: {\n    id: string;\n    approved: boolean;\n  }) => Promise<void>;\n  reload: () => Promise<void>;\n  stop: () => void;\n  isLoading: DeepReadonly<ShallowRef<boolean>>;\n  error: DeepReadonly<ShallowRef<Error | undefined>>;\n  status: DeepReadonly<ShallowRef<ChatClientState>>;\n  isSubscribed: DeepReadonly<ShallowRef<boolean>>;\n  connectionStatus: DeepReadonly<ShallowRef<ConnectionStatus>>;\n  sessionGenerating: DeepReadonly<ShallowRef<boolean>>;\n  isHydrating: DeepReadonly<ShallowRef<boolean>>;\n  setMessages: (messages: UIMessage[]) => void;\n  clear: () => void;\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Reactive state ("},{"type":"inlineCode","value":"messages"},{"type":"text","value":", "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":", "},{"type":"inlineCode","value":"status"},{"type":"text","value":", "},{"type":"inlineCode","value":"isSubscribed"},{"type":"text","value":", "},{"type":"inlineCode","value":"connectionStatus"},{"type":"text","value":", "},{"type":"inlineCode","value":"sessionGenerating"},{"type":"text","value":", "},{"type":"inlineCode","value":"isHydrating"},{"type":"text","value":") is wrapped in "},{"type":"inlineCode","value":"DeepReadonly<ShallowRef<T>>"},{"type":"text","value":". In "},{"type":"inlineCode","value":"<script setup>"},{"type":"text","value":" read the underlying value with "},{"type":"inlineCode","value":".value"},{"type":"text","value":" (e.g., "},{"type":"inlineCode","value":"messages.value"},{"type":"text","value":"); in "},{"type":"inlineCode","value":"<template>"},{"type":"text","value":" Vue auto-unwraps the ref, so use the bare name (e.g., "},{"type":"inlineCode","value":"v-for=\"m in messages\""},{"type":"text","value":"). Cleanup is automatic via "},{"type":"inlineCode","value":"onScopeDispose"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"usebyok-client","children":[{"type":"inlineCode","value":"useByok(client)"}]},{"type":"paragraph","children":[{"type":"text","value":"Subscribe to a "},{"type":"inlineCode","value":"ByokClient"},{"type":"text","value":" snapshot in Vue. The return value is a "},{"type":"inlineCode","value":"DeepReadonly<ShallowRef<ByokSnapshot>>"},{"type":"text","value":"."}]},{"type":"code","value":"import { useByok } from \"@tanstack/ai-vue\";\nimport { byok } from \"./byok\";\n\nconst snapshot = useByok(byok);\nconst openai = snapshot.value.status.openai;\nconst last4 = openai && \"masked\" in openai ? openai.masked : \"No key\";","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"snapshot.value"},{"type":"text","value":" has "},{"type":"inlineCode","value":"status"},{"type":"text","value":", "},{"type":"inlineCode","value":"locked"},{"type":"text","value":", and "},{"type":"inlineCode","value":"prompt"},{"type":"text","value":". Call "},{"type":"inlineCode","value":"byok.update(provider, value)"},{"type":"text","value":" from your own UI to save a key. See "},{"type":"link","href":"../advanced/byok","children":[{"type":"text","value":"Bring Your Own Key"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"connection-adapters","children":[{"type":"text","value":"Connection Adapters"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":" for convenience:"}]},{"type":"code","value":"import {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  stream,\n  type ConnectionAdapter,\n} from \"@tanstack/ai-vue\";","lang":"typescript"},{"type":"heading","depth":2,"id":"example-basic-chat","children":[{"type":"text","value":"Example: Basic Chat"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\n\nconst input = ref(\"\");\n\nconst { messages, sendMessage, isLoading } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n});\n\nconst handleSubmit = () => {\n  if (input.value.trim() && !isLoading.value) {\n    sendMessage(input.value);\n    input.value = \"\";\n  }\n};\n</script>\n\n<template>\n  <div>\n    <div>\n      <div v-for=\"message in messages\" :key=\"message.id\">\n        <strong>{{ message.role }}:</strong>\n        <template v-for=\"(part, idx) in message.parts\" :key=\"idx\">\n          <div\n            v-if=\"part.type === 'thinking'\"\n            class=\"text-sm text-gray-500 italic\"\n          >\n            Thinking: {{ part.content }}\n          </div>\n          <span v-else-if=\"part.type === 'text'\">{{ part.content }}</span>\n        </template>\n      </div>\n    </div>\n    <form @submit.prevent=\"handleSubmit\">\n      <input v-model=\"input\" :disabled=\"isLoading\" />\n      <button type=\"submit\" :disabled=\"isLoading\">Send</button>\n    </form>\n  </div>\n</template>","lang":"vue"},{"type":"heading","depth":2,"id":"example-tool-approval","children":[{"type":"text","value":"Example: Tool Approval"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\n\nconst { messages, sendMessage, addToolApprovalResponse } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n});\n</script>\n\n<template>\n  <div>\n    <template v-for=\"message in messages\" :key=\"message.id\">\n      <template v-for=\"part in message.parts\" :key=\"part.id\">\n        <div\n          v-if=\"\n            part.type === 'tool-call' &&\n            part.state === 'approval-requested' &&\n            part.approval\n          \"\n        >\n          <p>Approve: {{ part.name }}</p>\n          <button\n            @click=\"\n              addToolApprovalResponse({\n                id: part.approval!.id,\n                approved: true,\n              })\n            \"\n          >\n            Approve\n          </button>\n          <button\n            @click=\"\n              addToolApprovalResponse({\n                id: part.approval!.id,\n                approved: false,\n              })\n            \"\n          >\n            Deny\n          </button>\n        </div>\n      </template>\n    </template>\n  </div>\n</template>","lang":"vue"},{"type":"heading","depth":2,"id":"example-client-tools-with-type-safety","children":[{"type":"text","value":"Example: Client Tools with Type Safety"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Show a notification in the UI\",\n  inputSchema: z.object({ message: z.string(), type: z.string() }),\n});\n\nconst saveToStorageDef = toolDefinition({\n  name: \"saveToStorage\",\n  description: \"Save a value to localStorage\",\n  inputSchema: z.object({ key: z.string(), value: z.string() }),\n});\n\nconst notification = ref<{ message: string; type: string } | null>(null);\n\n// Create client implementations\nconst updateUI = updateUIDef.client((input) => {\n  // input is fully typed!\n  notification.value = { message: input.message, type: input.type };\n  return { success: true };\n});\n\nconst saveToStorage = saveToStorageDef.client((input) => {\n  localStorage.setItem(input.key, input.value);\n  return { saved: true };\n});\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [updateUI, saveToStorage];\n\nconst { messages, sendMessage } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools, // Automatic execution, full type safety\n});\n</script>\n\n<template>\n  <div>\n    <template v-for=\"message in messages\" :key=\"message.id\">\n      <template v-for=\"(part, idx) in message.parts\" :key=\"idx\">\n        <div v-if=\"part.type === 'tool-call' && part.name === 'updateUI'\">\n          Tool executed: {{ part.name }}\n        </div>\n      </template>\n    </template>\n  </div>\n</template>","lang":"vue"},{"type":"heading","depth":2,"id":"generation-composables","children":[{"type":"text","value":"Generation Composables"}]},{"type":"paragraph","children":[{"type":"text","value":"Vue composables for one-shot generation tasks (images, speech, transcription, summarization, video). All share the same pattern: provide a "},{"type":"inlineCode","value":"connection"},{"type":"text","value":" or "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":", call "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":", and read reactive state."}]},{"type":"heading","depth":3,"id":"usegeneration-options","children":[{"type":"inlineCode","value":"useGeneration(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Base composable for custom generation types. All specialized composables below are built on this."}]},{"type":"code","value":"import { useGeneration } from \"@tanstack/ai-vue\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\nconst { generate, result, isLoading, error, status, stop, reset } =\n  useGeneration({\n    connection: fetchServerSentEvents(\"/api/generate/custom\"),\n  });","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options:"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"connection?"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetcher?"},{"type":"text","value":", "},{"type":"inlineCode","value":"threadId?"},{"type":"text","value":", "},{"type":"inlineCode","value":"body?"},{"type":"text","value":", "},{"type":"inlineCode","value":"onResult?"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError?"},{"type":"text","value":", "},{"type":"inlineCode","value":"onProgress?"},{"type":"text","value":", "},{"type":"inlineCode","value":"onChunk?"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns:"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"generate"},{"type":"text","value":", "},{"type":"inlineCode","value":"result"},{"type":"text","value":", "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":", "},{"type":"inlineCode","value":"status"},{"type":"text","value":", "},{"type":"inlineCode","value":"stop"},{"type":"text","value":", "},{"type":"inlineCode","value":"reset"},{"type":"text","value":", "},{"type":"inlineCode","value":"runId"},{"type":"text","value":" -- all reactive state is "},{"type":"inlineCode","value":"DeepReadonly<ShallowRef<T>>"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"usegenerateimage-options","children":[{"type":"inlineCode","value":"useGenerateImage(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Image generation composable. "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"ImageGenerateInput"},{"type":"text","value":", result is "},{"type":"inlineCode","value":"ImageGenerationResult"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"usegeneratespeech-options","children":[{"type":"inlineCode","value":"useGenerateSpeech(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Text-to-speech composable. "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"SpeechGenerateInput"},{"type":"text","value":", result is "},{"type":"inlineCode","value":"TTSResult"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"usetranscription-options","children":[{"type":"inlineCode","value":"useTranscription(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Audio transcription composable. "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"TranscriptionGenerateInput"},{"type":"text","value":", result is "},{"type":"inlineCode","value":"TranscriptionResult"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"usesummarize-options","children":[{"type":"inlineCode","value":"useSummarize(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Text summarization composable. "},{"type":"inlineCode","value":"generate()"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"SummarizeGenerateInput"},{"type":"text","value":", result is "},{"type":"inlineCode","value":"SummarizationResult"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"usegeneratevideo-options","children":[{"type":"inlineCode","value":"useGenerateVideo(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Video generation composable with job polling. Returns additional "},{"type":"inlineCode","value":"jobId"},{"type":"text","value":" and "},{"type":"inlineCode","value":"videoStatus"},{"type":"text","value":" refs. Accepts extra "},{"type":"inlineCode","value":"onJobCreated?"},{"type":"text","value":" and "},{"type":"inlineCode","value":"onStatusUpdate?"},{"type":"text","value":" callbacks."}]},{"type":"paragraph","children":[{"type":"text","value":"All generation composables automatically clean up via "},{"type":"inlineCode","value":"onScopeDispose"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"createchatclientoptions-options","children":[{"type":"inlineCode","value":"createChatClientOptions(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Helper to create typed chat options (re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":")."}]},{"type":"code","value":"import {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-vue\";\nimport { tool1, tool2 } from \"./tools\";\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [tool1, tool2];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\ntype Messages = InferChatMessages<typeof chatOptions>;","lang":"typescript"},{"type":"heading","depth":2,"id":"types","children":[{"type":"text","value":"Types"}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"UIMessage<TTools>"},{"type":"text","value":" - Message type with tool type parameter"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"MessagePart<TTools>"},{"type":"text","value":" - Message part with tool type parameter"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TextPart"},{"type":"text","value":" - Text content part"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ThinkingPart"},{"type":"text","value":" - Thinking content part"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ToolCallPart<TTools>"},{"type":"text","value":" - Tool call part (discriminated union)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ToolResultPart"},{"type":"text","value":" - Tool result part"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ChatClientOptions<TTools, TContext>"},{"type":"text","value":" - Chat client options with typed client runtime context"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ConnectionAdapter"},{"type":"text","value":" - Connection adapter interface"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"InferChatMessages<T>"},{"type":"text","value":" - Extract message type from options"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ChatRequestBody"},{"type":"text","value":" - Request body type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"GenerationClientState"},{"type":"text","value":" - Generation lifecycle state"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ImageGenerateInput"},{"type":"text","value":" - Image generation input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SpeechGenerateInput"},{"type":"text","value":" - Speech generation input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TranscriptionGenerateInput"},{"type":"text","value":" - Transcription input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SummarizeGenerateInput"},{"type":"text","value":" - Summarization input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"VideoGenerateInput"},{"type":"text","value":" - Video generation input type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"VideoGenerateResult"},{"type":"text","value":" - Video generation result type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"VideoStatusInfo"},{"type":"text","value":" - Video job status info"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Re-exported from "},{"type":"inlineCode","value":"@tanstack/ai"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"toolDefinition()"},{"type":"text","value":" - Create isomorphic tool definition"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ToolDefinitionInstance"},{"type":"text","value":" - Tool definition type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ClientTool"},{"type":"text","value":" - Client tool type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ServerTool"},{"type":"text","value":" - Server tool type"}]}]}]},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Getting Started"}]},{"type":"text","value":" - Learn the basics"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools Guide"}]},{"type":"text","value":" - Learn about the isomorphic tool system"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/client-tools","children":[{"type":"text","value":"Client Tools"}]},{"type":"text","value":" - Learn about client-side tools"}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"useregisterwebmcptools-tools-options","text":"useRegisterWebMCPTools(tools, options?)","level":2},{"id":"usepagewebmcptools-options","text":"usePageWebMCPTools(options?)","level":2},{"id":"createchathook-options","text":"createChatHook(options)","level":2},{"id":"usechat-options","text":"useChat(options?)","level":2},{"id":"options","text":"Options","level":3},{"id":"returns","text":"Returns","level":3},{"id":"usebyok-client","text":"useByok(client)","level":2},{"id":"connection-adapters","text":"Connection Adapters","level":2},{"id":"example-basic-chat","text":"Example: Basic Chat","level":2},{"id":"example-tool-approval","text":"Example: Tool Approval","level":2},{"id":"example-client-tools-with-type-safety","text":"Example: Client Tools with Type Safety","level":2},{"id":"generation-composables","text":"Generation Composables","level":2},{"id":"usegeneration-options","text":"useGeneration(options)","level":3},{"id":"usegenerateimage-options","text":"useGenerateImage(options)","level":3},{"id":"usegeneratespeech-options","text":"useGenerateSpeech(options)","level":3},{"id":"usetranscription-options","text":"useTranscription(options)","level":3},{"id":"usesummarize-options","text":"useSummarize(options)","level":3},{"id":"usegeneratevideo-options","text":"useGenerateVideo(options)","level":3},{"id":"createchatclientoptions-options","text":"createChatClientOptions(options)","level":2},{"id":"types","text":"Types","level":2},{"id":"next-steps","text":"Next Steps","level":2}]},"frameworks":["vue"],"downloadMarkdown":"\nVue composables for TanStack AI, providing convenient Vue 3 bindings for the headless client.\n\nFor a typed headless chat UI, see [Vue Chat UI](../ui/vue).\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nvue: @tanstack/ai-vue\n\n<!-- ::end:tabs -->\n\n## `useRegisterWebMCPTools(tools, options?)`\n\nRegister executable client tools for the current Vue scope. Vue removes them when the scope is disposed.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```vue\n<script setup lang=\"ts\">\nimport {\n  useRegisterWebMCPTools,\n  type UseRegisterWebMCPToolsOptions,\n} from \"@tanstack/ai-vue\";\nimport { searchProducts } from \"./tools\";\n\nconst tools = [searchProducts];\nconst options: UseRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error);\n  },\n};\n\nuseRegisterWebMCPTools(tools, options);\n</script>\n```\n\n`UseRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The composable owns the registration signal.\n\nThe `context` field is required when a tool declares a required runtime context.\n\n## `usePageWebMCPTools(options?)`\n\nRead the WebMCP tools on the page as client tools. The ref starts empty and updates when the page adds or removes a tool. Pass the ref to `useChat` as `tools`.\n\n```ts\nimport { usePageWebMCPTools } from \"@tanstack/ai-vue\";\n\nexport function useSameOriginPageTools() {\n  return usePageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  });\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## `createChatHook(options)`\n\nBind `chatOptions` once at module scope. Call `useChat()` in the screen to create the instance. Per-call overrides may set `threadId`, `initialMessages`, `live`, and `forwardedProps`. They must not change `tools`, `interrupts`, or `outputSchema`.\n\n```ts\nimport { createChatHook, fetchServerSentEvents } from \"@tanstack/ai-vue\";\n\nconst chatOptions = {\n  connection: fetchServerSentEvents(\"/api/chat\"),\n};\n\nconst { useChat } = createChatHook(chatOptions);\n\nconst chat = useChat({ threadId: \"support-1\" });\n```\n\n`useChat(chatOptions)` from this package still works when you want to pass the full object at the call site. Rename the bound composable if both are in one file: `const { useChat: useSupportChat } = createChatHook(chatOptions)`.\n\n## `useChat(options?)`\n\nMain composable for managing chat state in Vue with full type safety.\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\nimport { ref } from \"vue\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Show a notification in the UI\",\n  inputSchema: z.object({ message: z.string() }),\n});\n\nconst notification = ref<string | null>(null);\n\n// In <script setup>\nconst updateUI = updateUIDef.client((input) => {\n  notification.value = input.message;\n  return { success: true };\n});\n\nconst tools = [updateUI];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\n// Fully typed messages!\ntype ChatMessages = InferChatMessages<typeof chatOptions>;\n\nconst { messages, sendMessage, isLoading, error, addToolApprovalResponse } =\n  useChat(chatOptions);\n```\n\n### Options\n\nExtends `ChatClientOptions` from `@tanstack/ai-client` (minus internal state callbacks):\n\n- `connection` - Connection adapter (required)\n- `tools?` - Array of client tool implementations (with `.client()` method). Pass a ref or getter to change the tools after the chat is created.\n- `initialMessages?` - Initial messages array\n- `threadId?` - The only identity for this chat. Required when persistence is on. If omitted, minted after mount.\n- `forwardedProps?` - Arbitrary client-controlled JSON forwarded to the server in the AG-UI `RunAgentInput.forwardedProps` field (reactive -- changes are synced automatically via `watch`)\n- `body?` - **Deprecated.** Use `forwardedProps` instead. Still works for backward compatibility; values are merged into `forwardedProps` on the wire (reactive)\n- `byok?` - Optional BYOK keyring from `defineByok`. On each send the client prepares the resolved provider and stamps `x-byok-*` request headers. Keys never go in the body\n- `byokProvider?` - Optional function that returns the provider slug for this chat. If it returns a slug, only that key is prepared and sent. Otherwise the merged `provider` from `forwardedProps`, `body`, and per-call `sendMessage` `body` is used. Later sources win. If no slug resolves, the send throws instead of attaching every stored key\n- `context?` - Typed client-local runtime context passed to client tool implementations (reactive). This value is not serialized to the server\n- `live?` - Enable live subscription mode (auto-subscribes/unsubscribes)\n- `onResponse?` - Callback when response is received\n- `onChunk?` - Callback when stream chunk is received\n- `onFinish?` - Callback when response finishes\n- `onError?` - Callback when error occurs\n- `onInterruptStateChange?` - Callback when interrupt state changes; context source is `hydrate` for restored state and `live` for streamed or client-initiated updates\n- `onCustomEvent?` - Callback for custom stream events\n- `streamProcessor?` - Stream processing configuration\n\n**Note:** Client tools are now automatically executed - no `onToolCall` callback needed!\n\n### Returns\n\n```typescript\nimport type { DeepReadonly, ShallowRef } from \"vue\";\nimport type { UIMessage } from \"@tanstack/ai-vue\";\nimport type { ModelMessage } from \"@tanstack/ai/client\";\nimport type {\n  MultimodalContent,\n  ChatClientState,\n  ConnectionStatus,\n  SendMessageOptions,\n} from \"@tanstack/ai-client\";\n\ninterface UseChatReturn {\n  messages: DeepReadonly<ShallowRef<UIMessage[]>>;\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>;\n  append: (message: ModelMessage | UIMessage) => Promise<void>;\n  addToolResult: (result: {\n    toolCallId: string;\n    tool: string;\n    output: any;\n    state?: \"output-available\" | \"output-error\";\n    errorText?: string;\n  }) => Promise<void>;\n  addToolApprovalResponse: (response: {\n    id: string;\n    approved: boolean;\n  }) => Promise<void>;\n  reload: () => Promise<void>;\n  stop: () => void;\n  isLoading: DeepReadonly<ShallowRef<boolean>>;\n  error: DeepReadonly<ShallowRef<Error | undefined>>;\n  status: DeepReadonly<ShallowRef<ChatClientState>>;\n  isSubscribed: DeepReadonly<ShallowRef<boolean>>;\n  connectionStatus: DeepReadonly<ShallowRef<ConnectionStatus>>;\n  sessionGenerating: DeepReadonly<ShallowRef<boolean>>;\n  isHydrating: DeepReadonly<ShallowRef<boolean>>;\n  setMessages: (messages: UIMessage[]) => void;\n  clear: () => void;\n}\n```\n\n**Note:** Reactive state (`messages`, `isLoading`, `error`, `status`, `isSubscribed`, `connectionStatus`, `sessionGenerating`, `isHydrating`) is wrapped in `DeepReadonly<ShallowRef<T>>`. In `<script setup>` read the underlying value with `.value` (e.g., `messages.value`); in `<template>` Vue auto-unwraps the ref, so use the bare name (e.g., `v-for=\"m in messages\"`). Cleanup is automatic via `onScopeDispose`.\n\n## `useByok(client)`\n\nSubscribe to a `ByokClient` snapshot in Vue. The return value is a `DeepReadonly<ShallowRef<ByokSnapshot>>`.\n\n```typescript\nimport { useByok } from \"@tanstack/ai-vue\";\nimport { byok } from \"./byok\";\n\nconst snapshot = useByok(byok);\nconst openai = snapshot.value.status.openai;\nconst last4 = openai && \"masked\" in openai ? openai.masked : \"No key\";\n```\n\n`snapshot.value` has `status`, `locked`, and `prompt`. Call `byok.update(provider, value)` from your own UI to save a key. See [Bring Your Own Key](../advanced/byok).\n\n## Connection Adapters\n\nRe-exported from `@tanstack/ai-client` for convenience:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  stream,\n  type ConnectionAdapter,\n} from \"@tanstack/ai-vue\";\n```\n\n## Example: Basic Chat\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\n\nconst input = ref(\"\");\n\nconst { messages, sendMessage, isLoading } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n});\n\nconst handleSubmit = () => {\n  if (input.value.trim() && !isLoading.value) {\n    sendMessage(input.value);\n    input.value = \"\";\n  }\n};\n</script>\n\n<template>\n  <div>\n    <div>\n      <div v-for=\"message in messages\" :key=\"message.id\">\n        <strong>{{ message.role }}:</strong>\n        <template v-for=\"(part, idx) in message.parts\" :key=\"idx\">\n          <div\n            v-if=\"part.type === 'thinking'\"\n            class=\"text-sm text-gray-500 italic\"\n          >\n            Thinking: {{ part.content }}\n          </div>\n          <span v-else-if=\"part.type === 'text'\">{{ part.content }}</span>\n        </template>\n      </div>\n    </div>\n    <form @submit.prevent=\"handleSubmit\">\n      <input v-model=\"input\" :disabled=\"isLoading\" />\n      <button type=\"submit\" :disabled=\"isLoading\">Send</button>\n    </form>\n  </div>\n</template>\n```\n\n## Example: Tool Approval\n\n```vue\n<script setup lang=\"ts\">\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\n\nconst { messages, sendMessage, addToolApprovalResponse } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n});\n</script>\n\n<template>\n  <div>\n    <template v-for=\"message in messages\" :key=\"message.id\">\n      <template v-for=\"part in message.parts\" :key=\"part.id\">\n        <div\n          v-if=\"\n            part.type === 'tool-call' &&\n            part.state === 'approval-requested' &&\n            part.approval\n          \"\n        >\n          <p>Approve: {{ part.name }}</p>\n          <button\n            @click=\"\n              addToolApprovalResponse({\n                id: part.approval!.id,\n                approved: true,\n              })\n            \"\n          >\n            Approve\n          </button>\n          <button\n            @click=\"\n              addToolApprovalResponse({\n                id: part.approval!.id,\n                approved: false,\n              })\n            \"\n          >\n            Deny\n          </button>\n        </div>\n      </template>\n    </template>\n  </div>\n</template>\n```\n\n## Example: Client Tools with Type Safety\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Show a notification in the UI\",\n  inputSchema: z.object({ message: z.string(), type: z.string() }),\n});\n\nconst saveToStorageDef = toolDefinition({\n  name: \"saveToStorage\",\n  description: \"Save a value to localStorage\",\n  inputSchema: z.object({ key: z.string(), value: z.string() }),\n});\n\nconst notification = ref<{ message: string; type: string } | null>(null);\n\n// Create client implementations\nconst updateUI = updateUIDef.client((input) => {\n  // input is fully typed!\n  notification.value = { message: input.message, type: input.type };\n  return { success: true };\n});\n\nconst saveToStorage = saveToStorageDef.client((input) => {\n  localStorage.setItem(input.key, input.value);\n  return { saved: true };\n});\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [updateUI, saveToStorage];\n\nconst { messages, sendMessage } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools, // Automatic execution, full type safety\n});\n</script>\n\n<template>\n  <div>\n    <template v-for=\"message in messages\" :key=\"message.id\">\n      <template v-for=\"(part, idx) in message.parts\" :key=\"idx\">\n        <div v-if=\"part.type === 'tool-call' && part.name === 'updateUI'\">\n          Tool executed: {{ part.name }}\n        </div>\n      </template>\n    </template>\n  </div>\n</template>\n```\n\n## Generation Composables\n\nVue composables for one-shot generation tasks (images, speech, transcription, summarization, video). All share the same pattern: provide a `connection` or `fetcher`, call `generate()`, and read reactive state.\n\n### `useGeneration(options)`\n\nBase composable for custom generation types. All specialized composables below are built on this.\n\n```typescript\nimport { useGeneration } from \"@tanstack/ai-vue\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\nconst { generate, result, isLoading, error, status, stop, reset } =\n  useGeneration({\n    connection: fetchServerSentEvents(\"/api/generate/custom\"),\n  });\n```\n\n**Options:** `connection?`, `fetcher?`, `threadId?`, `body?`, `onResult?`, `onError?`, `onProgress?`, `onChunk?`\n\n**Returns:** `generate`, `result`, `isLoading`, `error`, `status`, `stop`, `reset`, `runId` -- all reactive state is `DeepReadonly<ShallowRef<T>>`.\n\n### `useGenerateImage(options)`\n\nImage generation composable. `generate()` accepts `ImageGenerateInput`, result is `ImageGenerationResult`.\n\n### `useGenerateSpeech(options)`\n\nText-to-speech composable. `generate()` accepts `SpeechGenerateInput`, result is `TTSResult`.\n\n### `useTranscription(options)`\n\nAudio transcription composable. `generate()` accepts `TranscriptionGenerateInput`, result is `TranscriptionResult`.\n\n### `useSummarize(options)`\n\nText summarization composable. `generate()` accepts `SummarizeGenerateInput`, result is `SummarizationResult`.\n\n### `useGenerateVideo(options)`\n\nVideo generation composable with job polling. Returns additional `jobId` and `videoStatus` refs. Accepts extra `onJobCreated?` and `onStatusUpdate?` callbacks.\n\nAll generation composables automatically clean up via `onScopeDispose`.\n\n## `createChatClientOptions(options)`\n\nHelper to create typed chat options (re-exported from `@tanstack/ai-client`).\n\n```typescript\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-vue\";\nimport { tool1, tool2 } from \"./tools\";\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [tool1, tool2];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\ntype Messages = InferChatMessages<typeof chatOptions>;\n```\n\n## Types\n\nRe-exported from `@tanstack/ai-client`:\n\n- `UIMessage<TTools>` - Message type with tool type parameter\n- `MessagePart<TTools>` - Message part with tool type parameter\n- `TextPart` - Text content part\n- `ThinkingPart` - Thinking content part\n- `ToolCallPart<TTools>` - Tool call part (discriminated union)\n- `ToolResultPart` - Tool result part\n- `ChatClientOptions<TTools, TContext>` - Chat client options with typed client runtime context\n- `ConnectionAdapter` - Connection adapter interface\n- `InferChatMessages<T>` - Extract message type from options\n- `ChatRequestBody` - Request body type\n- `GenerationClientState` - Generation lifecycle state\n- `ImageGenerateInput` - Image generation input type\n- `SpeechGenerateInput` - Speech generation input type\n- `TranscriptionGenerateInput` - Transcription input type\n- `SummarizeGenerateInput` - Summarization input type\n- `VideoGenerateInput` - Video generation input type\n- `VideoGenerateResult` - Video generation result type\n- `VideoStatusInfo` - Video job status info\n\nRe-exported from `@tanstack/ai`:\n\n- `toolDefinition()` - Create isomorphic tool definition\n- `ToolDefinitionInstance` - Tool definition type\n- `ClientTool` - Client tool type\n- `ServerTool` - Server tool type\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about the isomorphic tool system\n- [Client Tools](../tools/client-tools) - Learn about client-side tools\n","originalRawMarkdown":"---\ntitle: \"@tanstack/ai-vue\"\nid: ai-vue\norder: 5\ndescription: \"API reference for @tanstack/ai-vue — Vue 3 composables including useChat for streaming chat with full type safety.\"\nkeywords:\n  - tanstack ai\n  - \"@tanstack/ai-vue\"\n  - vue\n  - vue 3\n  - useChat\n  - composables\n  - api reference\n---\n\nVue composables for TanStack AI, providing convenient Vue 3 bindings for the headless client.\n\nFor a typed headless chat UI, see [Vue Chat UI](../ui/vue).\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nvue: @tanstack/ai-vue\n\n<!-- ::end:tabs -->\n\n## `useRegisterWebMCPTools(tools, options?)`\n\nRegister executable client tools for the current Vue scope. Vue removes them when the scope is disposed.\n\nFor a complete setup and behavior guide, see [WebMCP Tools](../tools/webmcp).\n\n```vue\n<script setup lang=\"ts\">\nimport {\n  useRegisterWebMCPTools,\n  type UseRegisterWebMCPToolsOptions,\n} from \"@tanstack/ai-vue\";\nimport { searchProducts } from \"./tools\";\n\nconst tools = [searchProducts];\nconst options: UseRegisterWebMCPToolsOptions<typeof tools> = {\n  onError(error) {\n    console.error(error);\n  },\n};\n\nuseRegisterWebMCPTools(tools, options);\n</script>\n```\n\n`UseRegisterWebMCPToolsOptions<TTools, TContext>` contains `toolOptions`, `context`, and `onError`. The composable owns the registration signal.\n\nThe `context` field is required when a tool declares a required runtime context.\n\n## `usePageWebMCPTools(options?)`\n\nRead the WebMCP tools on the page as client tools. The ref starts empty and updates when the page adds or removes a tool. Pass the ref to `useChat` as `tools`.\n\n```ts\nimport { usePageWebMCPTools } from \"@tanstack/ai-vue\";\n\nexport function useSameOriginPageTools() {\n  return usePageWebMCPTools({\n    filter: (tool) => tool.origin === location.origin,\n  });\n}\n```\n\n`filter` skips a tool when it returns `false`. `onError` gets a failed WebMCP read. For a complete guide, see [Page WebMCP Tools in Chat](../tools/webmcp-page-tools).\n\n## `createChatHook(options)`\n\nBind `chatOptions` once at module scope. Call `useChat()` in the screen to create the instance. Per-call overrides may set `threadId`, `initialMessages`, `live`, and `forwardedProps`. They must not change `tools`, `interrupts`, or `outputSchema`.\n\n```ts\nimport { createChatHook, fetchServerSentEvents } from \"@tanstack/ai-vue\";\n\nconst chatOptions = {\n  connection: fetchServerSentEvents(\"/api/chat\"),\n};\n\nconst { useChat } = createChatHook(chatOptions);\n\nconst chat = useChat({ threadId: \"support-1\" });\n```\n\n`useChat(chatOptions)` from this package still works when you want to pass the full object at the call site. Rename the bound composable if both are in one file: `const { useChat: useSupportChat } = createChatHook(chatOptions)`.\n\n## `useChat(options?)`\n\nMain composable for managing chat state in Vue with full type safety.\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\nimport { ref } from \"vue\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Show a notification in the UI\",\n  inputSchema: z.object({ message: z.string() }),\n});\n\nconst notification = ref<string | null>(null);\n\n// In <script setup>\nconst updateUI = updateUIDef.client((input) => {\n  notification.value = input.message;\n  return { success: true };\n});\n\nconst tools = [updateUI];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\n// Fully typed messages!\ntype ChatMessages = InferChatMessages<typeof chatOptions>;\n\nconst { messages, sendMessage, isLoading, error, addToolApprovalResponse } =\n  useChat(chatOptions);\n```\n\n### Options\n\nExtends `ChatClientOptions` from `@tanstack/ai-client` (minus internal state callbacks):\n\n- `connection` - Connection adapter (required)\n- `tools?` - Array of client tool implementations (with `.client()` method). Pass a ref or getter to change the tools after the chat is created.\n- `initialMessages?` - Initial messages array\n- `threadId?` - The only identity for this chat. Required when persistence is on. If omitted, minted after mount.\n- `forwardedProps?` - Arbitrary client-controlled JSON forwarded to the server in the AG-UI `RunAgentInput.forwardedProps` field (reactive -- changes are synced automatically via `watch`)\n- `body?` - **Deprecated.** Use `forwardedProps` instead. Still works for backward compatibility; values are merged into `forwardedProps` on the wire (reactive)\n- `byok?` - Optional BYOK keyring from `defineByok`. On each send the client prepares the resolved provider and stamps `x-byok-*` request headers. Keys never go in the body\n- `byokProvider?` - Optional function that returns the provider slug for this chat. If it returns a slug, only that key is prepared and sent. Otherwise the merged `provider` from `forwardedProps`, `body`, and per-call `sendMessage` `body` is used. Later sources win. If no slug resolves, the send throws instead of attaching every stored key\n- `context?` - Typed client-local runtime context passed to client tool implementations (reactive). This value is not serialized to the server\n- `live?` - Enable live subscription mode (auto-subscribes/unsubscribes)\n- `onResponse?` - Callback when response is received\n- `onChunk?` - Callback when stream chunk is received\n- `onFinish?` - Callback when response finishes\n- `onError?` - Callback when error occurs\n- `onInterruptStateChange?` - Callback when interrupt state changes; context source is `hydrate` for restored state and `live` for streamed or client-initiated updates\n- `onCustomEvent?` - Callback for custom stream events\n- `streamProcessor?` - Stream processing configuration\n\n**Note:** Client tools are now automatically executed - no `onToolCall` callback needed!\n\n### Returns\n\n```typescript\nimport type { DeepReadonly, ShallowRef } from \"vue\";\nimport type { UIMessage } from \"@tanstack/ai-vue\";\nimport type { ModelMessage } from \"@tanstack/ai/client\";\nimport type {\n  MultimodalContent,\n  ChatClientState,\n  ConnectionStatus,\n  SendMessageOptions,\n} from \"@tanstack/ai-client\";\n\ninterface UseChatReturn {\n  messages: DeepReadonly<ShallowRef<UIMessage[]>>;\n  sendMessage: (\n    content: string | MultimodalContent,\n    options?: SendMessageOptions,\n  ) => Promise<void>;\n  append: (message: ModelMessage | UIMessage) => Promise<void>;\n  addToolResult: (result: {\n    toolCallId: string;\n    tool: string;\n    output: any;\n    state?: \"output-available\" | \"output-error\";\n    errorText?: string;\n  }) => Promise<void>;\n  addToolApprovalResponse: (response: {\n    id: string;\n    approved: boolean;\n  }) => Promise<void>;\n  reload: () => Promise<void>;\n  stop: () => void;\n  isLoading: DeepReadonly<ShallowRef<boolean>>;\n  error: DeepReadonly<ShallowRef<Error | undefined>>;\n  status: DeepReadonly<ShallowRef<ChatClientState>>;\n  isSubscribed: DeepReadonly<ShallowRef<boolean>>;\n  connectionStatus: DeepReadonly<ShallowRef<ConnectionStatus>>;\n  sessionGenerating: DeepReadonly<ShallowRef<boolean>>;\n  isHydrating: DeepReadonly<ShallowRef<boolean>>;\n  setMessages: (messages: UIMessage[]) => void;\n  clear: () => void;\n}\n```\n\n**Note:** Reactive state (`messages`, `isLoading`, `error`, `status`, `isSubscribed`, `connectionStatus`, `sessionGenerating`, `isHydrating`) is wrapped in `DeepReadonly<ShallowRef<T>>`. In `<script setup>` read the underlying value with `.value` (e.g., `messages.value`); in `<template>` Vue auto-unwraps the ref, so use the bare name (e.g., `v-for=\"m in messages\"`). Cleanup is automatic via `onScopeDispose`.\n\n## `useByok(client)`\n\nSubscribe to a `ByokClient` snapshot in Vue. The return value is a `DeepReadonly<ShallowRef<ByokSnapshot>>`.\n\n```typescript\nimport { useByok } from \"@tanstack/ai-vue\";\nimport { byok } from \"./byok\";\n\nconst snapshot = useByok(byok);\nconst openai = snapshot.value.status.openai;\nconst last4 = openai && \"masked\" in openai ? openai.masked : \"No key\";\n```\n\n`snapshot.value` has `status`, `locked`, and `prompt`. Call `byok.update(provider, value)` from your own UI to save a key. See [Bring Your Own Key](../advanced/byok).\n\n## Connection Adapters\n\nRe-exported from `@tanstack/ai-client` for convenience:\n\n```typescript\nimport {\n  fetchServerSentEvents,\n  fetchHttpStream,\n  fetchJson,\n  stream,\n  type ConnectionAdapter,\n} from \"@tanstack/ai-vue\";\n```\n\n## Example: Basic Chat\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\n\nconst input = ref(\"\");\n\nconst { messages, sendMessage, isLoading } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n});\n\nconst handleSubmit = () => {\n  if (input.value.trim() && !isLoading.value) {\n    sendMessage(input.value);\n    input.value = \"\";\n  }\n};\n</script>\n\n<template>\n  <div>\n    <div>\n      <div v-for=\"message in messages\" :key=\"message.id\">\n        <strong>{{ message.role }}:</strong>\n        <template v-for=\"(part, idx) in message.parts\" :key=\"idx\">\n          <div\n            v-if=\"part.type === 'thinking'\"\n            class=\"text-sm text-gray-500 italic\"\n          >\n            Thinking: {{ part.content }}\n          </div>\n          <span v-else-if=\"part.type === 'text'\">{{ part.content }}</span>\n        </template>\n      </div>\n    </div>\n    <form @submit.prevent=\"handleSubmit\">\n      <input v-model=\"input\" :disabled=\"isLoading\" />\n      <button type=\"submit\" :disabled=\"isLoading\">Send</button>\n    </form>\n  </div>\n</template>\n```\n\n## Example: Tool Approval\n\n```vue\n<script setup lang=\"ts\">\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\n\nconst { messages, sendMessage, addToolApprovalResponse } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n});\n</script>\n\n<template>\n  <div>\n    <template v-for=\"message in messages\" :key=\"message.id\">\n      <template v-for=\"part in message.parts\" :key=\"part.id\">\n        <div\n          v-if=\"\n            part.type === 'tool-call' &&\n            part.state === 'approval-requested' &&\n            part.approval\n          \"\n        >\n          <p>Approve: {{ part.name }}</p>\n          <button\n            @click=\"\n              addToolApprovalResponse({\n                id: part.approval!.id,\n                approved: true,\n              })\n            \"\n          >\n            Approve\n          </button>\n          <button\n            @click=\"\n              addToolApprovalResponse({\n                id: part.approval!.id,\n                approved: false,\n              })\n            \"\n          >\n            Deny\n          </button>\n        </div>\n      </template>\n    </template>\n  </div>\n</template>\n```\n\n## Example: Client Tools with Type Safety\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-vue\";\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\n\nconst updateUIDef = toolDefinition({\n  name: \"updateUI\",\n  description: \"Show a notification in the UI\",\n  inputSchema: z.object({ message: z.string(), type: z.string() }),\n});\n\nconst saveToStorageDef = toolDefinition({\n  name: \"saveToStorage\",\n  description: \"Save a value to localStorage\",\n  inputSchema: z.object({ key: z.string(), value: z.string() }),\n});\n\nconst notification = ref<{ message: string; type: string } | null>(null);\n\n// Create client implementations\nconst updateUI = updateUIDef.client((input) => {\n  // input is fully typed!\n  notification.value = { message: input.message, type: input.type };\n  return { success: true };\n});\n\nconst saveToStorage = saveToStorageDef.client((input) => {\n  localStorage.setItem(input.key, input.value);\n  return { saved: true };\n});\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [updateUI, saveToStorage];\n\nconst { messages, sendMessage } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools, // Automatic execution, full type safety\n});\n</script>\n\n<template>\n  <div>\n    <template v-for=\"message in messages\" :key=\"message.id\">\n      <template v-for=\"(part, idx) in message.parts\" :key=\"idx\">\n        <div v-if=\"part.type === 'tool-call' && part.name === 'updateUI'\">\n          Tool executed: {{ part.name }}\n        </div>\n      </template>\n    </template>\n  </div>\n</template>\n```\n\n## Generation Composables\n\nVue composables for one-shot generation tasks (images, speech, transcription, summarization, video). All share the same pattern: provide a `connection` or `fetcher`, call `generate()`, and read reactive state.\n\n### `useGeneration(options)`\n\nBase composable for custom generation types. All specialized composables below are built on this.\n\n```typescript\nimport { useGeneration } from \"@tanstack/ai-vue\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-client\";\n\nconst { generate, result, isLoading, error, status, stop, reset } =\n  useGeneration({\n    connection: fetchServerSentEvents(\"/api/generate/custom\"),\n  });\n```\n\n**Options:** `connection?`, `fetcher?`, `threadId?`, `body?`, `onResult?`, `onError?`, `onProgress?`, `onChunk?`\n\n**Returns:** `generate`, `result`, `isLoading`, `error`, `status`, `stop`, `reset`, `runId` -- all reactive state is `DeepReadonly<ShallowRef<T>>`.\n\n### `useGenerateImage(options)`\n\nImage generation composable. `generate()` accepts `ImageGenerateInput`, result is `ImageGenerationResult`.\n\n### `useGenerateSpeech(options)`\n\nText-to-speech composable. `generate()` accepts `SpeechGenerateInput`, result is `TTSResult`.\n\n### `useTranscription(options)`\n\nAudio transcription composable. `generate()` accepts `TranscriptionGenerateInput`, result is `TranscriptionResult`.\n\n### `useSummarize(options)`\n\nText summarization composable. `generate()` accepts `SummarizeGenerateInput`, result is `SummarizationResult`.\n\n### `useGenerateVideo(options)`\n\nVideo generation composable with job polling. Returns additional `jobId` and `videoStatus` refs. Accepts extra `onJobCreated?` and `onStatusUpdate?` callbacks.\n\nAll generation composables automatically clean up via `onScopeDispose`.\n\n## `createChatClientOptions(options)`\n\nHelper to create typed chat options (re-exported from `@tanstack/ai-client`).\n\n```typescript\nimport {\n  createChatClientOptions,\n  type InferChatMessages,\n} from \"@tanstack/ai-client\";\nimport { fetchServerSentEvents } from \"@tanstack/ai-vue\";\nimport { tool1, tool2 } from \"./tools\";\n\n// Create typed tools array (no 'as const' needed!)\nconst tools = [tool1, tool2];\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools,\n});\n\ntype Messages = InferChatMessages<typeof chatOptions>;\n```\n\n## Types\n\nRe-exported from `@tanstack/ai-client`:\n\n- `UIMessage<TTools>` - Message type with tool type parameter\n- `MessagePart<TTools>` - Message part with tool type parameter\n- `TextPart` - Text content part\n- `ThinkingPart` - Thinking content part\n- `ToolCallPart<TTools>` - Tool call part (discriminated union)\n- `ToolResultPart` - Tool result part\n- `ChatClientOptions<TTools, TContext>` - Chat client options with typed client runtime context\n- `ConnectionAdapter` - Connection adapter interface\n- `InferChatMessages<T>` - Extract message type from options\n- `ChatRequestBody` - Request body type\n- `GenerationClientState` - Generation lifecycle state\n- `ImageGenerateInput` - Image generation input type\n- `SpeechGenerateInput` - Speech generation input type\n- `TranscriptionGenerateInput` - Transcription input type\n- `SummarizeGenerateInput` - Summarization input type\n- `VideoGenerateInput` - Video generation input type\n- `VideoGenerateResult` - Video generation result type\n- `VideoStatusInfo` - Video job status info\n\nRe-exported from `@tanstack/ai`:\n\n- `toolDefinition()` - Create isomorphic tool definition\n- `ToolDefinitionInstance` - Tool definition type\n- `ClientTool` - Client tool type\n- `ServerTool` - Server tool type\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Tools Guide](../tools/tools) - Learn about the isomorphic tool system\n- [Client Tools](../tools/client-tools) - Learn about client-side tools\n"}
