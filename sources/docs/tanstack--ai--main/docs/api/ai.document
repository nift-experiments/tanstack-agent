{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The core AI library for TanStack AI."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai\"]],\"vue\":[[\"@tanstack/ai\"]],\"solid\":[[\"@tanstack/ai\"]],\"svelte\":[[\"@tanstack/ai\"]],\"preact\":[[\"@tanstack/ai\"]],\"angular\":[[\"@tanstack/ai\"]],\"vanilla\":[[\"@tanstack/ai\"]],\"octane\":[[\"@tanstack/ai\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"chat-options","children":[{"type":"inlineCode","value":"chat(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a streaming chat response."}]},{"type":"code","value":"import { chat, maxIterations } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { myTool } from \"./tools\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  tools: [myTool],\n  systemPrompts: [\"You are a helpful assistant\"],\n  agentLoopStrategy: maxIterations(20),\n});","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"adapter"},{"type":"text","value":" - An AI adapter instance with model (e.g., "},{"type":"inlineCode","value":"openaiText('gpt-5.2')"},{"type":"text","value":", "},{"type":"inlineCode","value":"anthropicText('claude-sonnet-4-5')"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"messages"},{"type":"text","value":" - Array of chat messages. Accepts mixed "},{"type":"inlineCode","value":"UIMessage | ModelMessage"},{"type":"text","value":" arrays — internal conversion handles AG-UI fan-out dedup, drops "},{"type":"inlineCode","value":"reasoning"},{"type":"text","value":"/"},{"type":"inlineCode","value":"activity"},{"type":"text","value":", and collapses "},{"type":"inlineCode","value":"developer"},{"type":"text","value":" → "},{"type":"inlineCode","value":"system"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tools?"},{"type":"text","value":" - Array of tools for function calling"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context?"},{"type":"text","value":" - Typed runtime context passed to server tools and middleware. If a tool or middleware declares a concrete context type, "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" requires a compatible value here"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"systemPrompts?"},{"type":"text","value":" - System prompts to prepend to messages"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"agentLoopStrategy?"},{"type":"text","value":" - Strategy for agent loops (default: "},{"type":"inlineCode","value":"maxIterations(5)"},{"type":"text","value":"). Strategies receive "},{"type":"inlineCode","value":"{ iterationCount, finishReason, messages, toolCallCount, lastTurnToolCallCount }"},{"type":"text","value":" and run between model turns. Iterations are model turns, not tool calls — for tool-call budgets use middleware ("},{"type":"inlineCode","value":"onBeforeToolCall"},{"type":"text","value":" + "},{"type":"inlineCode","value":"onShouldContinue"},{"type":"text","value":"); see "},{"type":"link","href":"../chat/agentic-cycle#tool-call-budgets-middleware-recipe","children":[{"type":"text","value":"Tool-call budgets"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"middleware?"},{"type":"text","value":" - Array of chat middleware. Use "},{"type":"inlineCode","value":"onShouldContinue"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onBeforeToolCall"},{"type":"text","value":" for app-owned tool budgets."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"abortController?"},{"type":"text","value":" - AbortController for cancellation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"modelOptions?"},{"type":"text","value":" - Provider-native model options. This is where sampling parameters live — "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":", "},{"type":"inlineCode","value":"top_p"},{"type":"text","value":"/"},{"type":"inlineCode","value":"topP"},{"type":"text","value":", and the provider's token-limit key ("},{"type":"inlineCode","value":"max_output_tokens"},{"type":"text","value":", "},{"type":"inlineCode","value":"max_tokens"},{"type":"text","value":", "},{"type":"inlineCode","value":"maxOutputTokens"},{"type":"text","value":", …) — under each provider's canonical name, rather than as generic root-level props. See "},{"type":"link","href":"../migration/sampling-options-to-model-options","children":[{"type":"text","value":"Moving Sampling Options into modelOptions"}]},{"type":"text","value":". (Renamed from "},{"type":"inlineCode","value":"providerOptions"},{"type":"text","value":".)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"threadId?"},{"type":"text","value":" - AG-UI thread identifier propagated into "},{"type":"inlineCode","value":"RUN_STARTED"},{"type":"text","value":" events for run correlation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"runId?"},{"type":"text","value":" - AG-UI run identifier (auto-generated if omitted)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"parentRunId?"},{"type":"text","value":" - AG-UI parent run identifier for nested runs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"stream?"},{"type":"text","value":" - Set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" to get one result when the run ends. See "},{"type":"link","href":"#returns","children":[{"type":"text","value":"Returns"}]},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"An async iterable of "},{"type":"inlineCode","value":"StreamChunk"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"With "},{"type":"inlineCode","value":"stream: false"},{"type":"text","value":", "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" returns "},{"type":"inlineCode","value":"Promise<ChatResult>"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"text"},{"type":"text","value":": the full reply as one string."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"chunks"},{"type":"text","value":": every chunk the run produced, in order. This includes tool calls, tool results, reasoning, usage, and the "},{"type":"inlineCode","value":"RUN_FINISHED"},{"type":"text","value":" chunk with any interrupts."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"If the run fails, the promise rejects with the error from "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":". If you also pass "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":", the promise resolves to the parsed object."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst { text, chunks } = await chat({\n  adapter: openaiText(\"gpt-5.6\"),\n  messages: [{ role: \"user\", content: \"What's the capital of France?\" }],\n  stream: false,\n});\n\nconsole.log(text);\n\nfor (const chunk of chunks) {\n  if (chunk.type === \"TOOL_CALL_START\") {\n    console.log(\"Tool call:\", chunk.toolCallName);\n  }\n  if (chunk.type === \"RUN_FINISHED\") {\n    console.log(\"Usage:\", chunk.usage);\n  }\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"If you already have a stream, "},{"type":"inlineCode","value":"streamToText(stream)"},{"type":"text","value":" reads it to the end and returns the same "},{"type":"inlineCode","value":"ChatResult"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"summarize-options","children":[{"type":"inlineCode","value":"summarize(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a text summarization."}]},{"type":"code","value":"import { summarize } from \"@tanstack/ai\";\nimport { openaiSummarize } from \"@tanstack/ai-openai\";\n\nconst result = await summarize({\n  adapter: openaiSummarize(\"gpt-5.2\"),\n  text: \"Long text to summarize...\",\n  maxLength: 100,\n  style: \"concise\",\n});","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"adapter"},{"type":"text","value":" - An AI adapter instance with model"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"text"},{"type":"text","value":" - Text to summarize"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"maxLength?"},{"type":"text","value":" - Maximum length of summary"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"style?"},{"type":"text","value":" - Summary style (\"concise\" | \"detailed\")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"modelOptions?"},{"type":"text","value":" - Model-specific options"}]}]}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"SummarizationResult"},{"type":"text","value":" with the summary text."}]},{"type":"heading","depth":2,"id":"decide-options","children":[{"type":"inlineCode","value":"decide(options)"}]},{"type":"paragraph","children":[{"type":"text","value":"Asks typed questions about a shared state and returns answers your code can\nbranch on. This call is async. There is no stream."}]},{"type":"code","value":"import { decide, choice, score, boolean } from \"@tanstack/ai\";\nimport { typesafeDecider } from \"@tanstack/ai-typesafe\";\n\nconst ticket = {\n  subject: \"Charged twice for the same invoice\",\n  body: \"Please refund the extra payment.\",\n};\n\nconst result = await decide({\n  adapter: typesafeDecider(\"jev-latest\"),\n  state: ticket,\n  questions: {\n    queue: choice({\n      instructions: \"Which team should handle this ticket?\",\n      options: {\n        billing: \"Payments, invoices, refunds\",\n        tech: \"Bugs, outages, integrations\",\n        sales: \"Pricing, upgrades, new accounts\",\n      },\n    }),\n    urgency: score({\n      instructions: \"How urgent is this ticket?\",\n      levels: [\"low\", \"medium\", \"high\"],\n    }),\n    refund: boolean({\n      instructions: \"Is the customer asking for a refund?\",\n    }),\n  },\n});\n\nconsole.log(result.queue.value);\nconsole.log(result.queue.probability);\nconsole.log(result.queue.confidence);\nconsole.log(result.meta.usage);","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-decide","children":[{"type":"text","value":"Parameters ("},{"type":"inlineCode","value":"decide"},{"type":"text","value":")"}]},{"type":"paragraph","children":[{"type":"text","value":"Required:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"adapter"},{"type":"text","value":" - An evaluate adapter created with a model (for example "},{"type":"inlineCode","value":"typesafeDecider('jev-latest')"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"state"},{"type":"text","value":" - Shared content every question judges. A string, an object, or an array. An array is one state, not a batch."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"questions"},{"type":"text","value":" - Map of "},{"type":"inlineCode","value":"choice"},{"type":"text","value":", "},{"type":"inlineCode","value":"score"},{"type":"text","value":", and "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":" questions. The key "},{"type":"inlineCode","value":"meta"},{"type":"text","value":" is reserved."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"abortSignal?"},{"type":"text","value":" - Cancel the in-flight request"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"modelOptions?"},{"type":"text","value":" - Provider-specific options"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"middleware?"},{"type":"text","value":" - Observe-only generation middleware"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"debug?"},{"type":"text","value":" - Debug logging"}]}]}]},{"type":"heading","depth":3,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"Each question key is a top-level answer. "},{"type":"inlineCode","value":"meta.model"},{"type":"text","value":" and "},{"type":"inlineCode","value":"meta.usage"},{"type":"text","value":" hold the resolved model id and token usage. When the adapter returns them, "},{"type":"inlineCode","value":"meta.id"},{"type":"text","value":" holds the provider response id and "},{"type":"inlineCode","value":"meta.provider"},{"type":"text","value":" names the upstream provider."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"choice"},{"type":"text","value":": "},{"type":"inlineCode","value":".value"},{"type":"text","value":" is the selected option key. "},{"type":"inlineCode","value":".probability"},{"type":"text","value":" is P(selected). "},{"type":"inlineCode","value":".confidence"},{"type":"text","value":" is a number from 0 to 1. "},{"type":"inlineCode","value":".probabilities"},{"type":"text","value":" is the full map."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"score"},{"type":"text","value":": "},{"type":"inlineCode","value":".value"},{"type":"text","value":" is the nearest level label. "},{"type":"inlineCode","value":".score"},{"type":"text","value":" is the raw fraction. "},{"type":"inlineCode","value":".probability"},{"type":"text","value":" is P(that level). "},{"type":"inlineCode","value":".confidence"},{"type":"text","value":" is a number from 0 to 1. "},{"type":"inlineCode","value":".legend"},{"type":"text","value":" maps each level index to its label. "},{"type":"inlineCode","value":".probabilities"},{"type":"text","value":" is the full map, keyed by level index."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"},{"type":"text","value":": When "},{"type":"inlineCode","value":".probability"},{"type":"text","value":" is 0.5 or more, "},{"type":"inlineCode","value":".value"},{"type":"text","value":" is "},{"type":"inlineCode","value":"true"},{"type":"text","value":". No "},{"type":"inlineCode","value":".confidence"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":3,"id":"helpers","children":[{"type":"text","value":"Helpers"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"choice({ instructions, options })"},{"type":"text","value":" - Pick one key from "},{"type":"inlineCode","value":"options"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"score({ instructions, levels })"},{"type":"text","value":" - Rate "},{"type":"inlineCode","value":"state"},{"type":"text","value":" on ordered "},{"type":"inlineCode","value":"levels"},{"type":"text","value":" (at least two)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean({ instructions, criteria? })"},{"type":"text","value":" - Yes or no. When P(true) is 0.5 or more, "},{"type":"inlineCode","value":".value"},{"type":"text","value":" is "},{"type":"inlineCode","value":"true"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../evaluate/evaluate","children":[{"type":"text","value":"Evaluate"}]},{"type":"text","value":" for adapters, abort, and middleware."}]},{"type":"heading","depth":2,"id":"tooldefinition-config","children":[{"type":"inlineCode","value":"toolDefinition(config)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates an isomorphic tool definition that can be instantiated for server or client execution."}]},{"type":"code","value":"import { chat, toolDefinition } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\nconst myToolDef = toolDefinition({\n  name: \"my_tool\",\n  description: \"Tool description\",\n  inputSchema: z.object({\n    param: z.string(),\n  }),\n  outputSchema: z.object({\n    result: z.string(),\n  }),\n  needsApproval: false, // Optional\n});\n\n// Or create client implementation\nconst myClientTool = myToolDef.client(async ({ param }) => {\n  // Client-side implementation\n  return { result: \"...\" };\n});\n\n// Use directly in chat() (server-side, no execute)\nchat({\n  adapter: openaiText(\"gpt-5.2\"),\n  tools: [myToolDef],\n  messages: [{ role: \"user\", content: \"...\" }],\n});\n\n// Or create server implementation\nconst myServerTool = myToolDef.server(async ({ param }) => {\n  // Server-side implementation\n  return { result: \"...\" };\n});\n\n// Use directly in chat() (server-side, no execute)\nchat({\n  adapter: openaiText(\"gpt-5.2\"),\n  tools: [myServerTool],\n  messages: [{ role: \"user\", content: \"...\" }],\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Tools can declare typed runtime context for request-scoped dependencies:"}]},{"type":"code","value":"import { chat, toolDefinition, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { session, db } from \"./app\";\n\ntype AppContext = {\n  userId: string;\n  db: { users: { findName(id: string): Promise<string> } };\n};\n\nconst currentUser = toolDefinition({\n  name: \"current_user\",\n  description: \"Get the current user\",\n}).server<AppContext>(async (_input: unknown, ctx) => {\n  return { name: await ctx.context.db.users.findName(ctx.context.userId) };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages,\n    tools: [currentUser],\n    context: { userId: session.user.id, db },\n  });\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"name"},{"type":"text","value":" - Tool name (must be unique)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"description"},{"type":"text","value":" - Tool description for the model"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"inputSchema"},{"type":"text","value":" - Zod schema for input validation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"outputSchema?"},{"type":"text","value":" - Zod schema for output validation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"needsApproval?"},{"type":"text","value":" - Whether tool requires user approval"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"metadata?"},{"type":"text","value":" - Additional metadata"}]}]}]},{"type":"heading","depth":3,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ToolDefinition"},{"type":"text","value":" object with "},{"type":"inlineCode","value":".server()"},{"type":"text","value":" and "},{"type":"inlineCode","value":".client()"},{"type":"text","value":" methods for creating concrete implementations."}]},{"type":"heading","depth":2,"id":"toserversenteventsstream-stream-abortcontroller","children":[{"type":"inlineCode","value":"toServerSentEventsStream(stream, abortController?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Converts a stream to a ReadableStream in Server-Sent Events format."}]},{"type":"code","value":"import { chat, toServerSentEventsStream } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\nconst readableStream = toServerSentEventsStream(stream);","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"stream"},{"type":"text","value":" - Async iterable of "},{"type":"inlineCode","value":"StreamChunk"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"abortController?"},{"type":"text","value":" - Optional AbortController to abort when stream is cancelled"}]}]}]},{"type":"heading","depth":3,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ReadableStream<Uint8Array>"},{"type":"text","value":" in Server-Sent Events format. Each chunk is:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Prefixed with "},{"type":"inlineCode","value":"\"data: \""}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Followed by "},{"type":"inlineCode","value":"\"\\n\\n\""}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Stream ends with "},{"type":"inlineCode","value":"\"data: [DONE]\\n\\n\""}]}]}]},{"type":"heading","depth":2,"id":"toserversenteventsresponse-stream-init","children":[{"type":"inlineCode","value":"toServerSentEventsResponse(stream, init?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Converts a stream to an HTTP Response with proper SSE headers."}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nasync function POST() {\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [{ role: \"user\", content: \"Hello!\" }],\n  });\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"stream"},{"type":"text","value":" - Async iterable of "},{"type":"inlineCode","value":"StreamChunk"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"init?"},{"type":"text","value":" - Optional ResponseInit options (including "},{"type":"inlineCode","value":"abortController"},{"type":"text","value":")"}]}]}]},{"type":"heading","depth":3,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"Response"},{"type":"text","value":" object suitable for HTTP endpoints with SSE headers ("},{"type":"inlineCode","value":"Content-Type: text/event-stream"},{"type":"text","value":", "},{"type":"inlineCode","value":"Cache-Control: no-cache"},{"type":"text","value":", "},{"type":"inlineCode","value":"Connection: keep-alive"},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"chatparamsfromrequest-req","children":[{"type":"inlineCode","value":"chatParamsFromRequest(req)"}]},{"type":"paragraph","children":[{"type":"text","value":"Reads an HTTP "},{"type":"inlineCode","value":"Request"},{"type":"text","value":", parses its JSON body, and validates it against AG-UI "},{"type":"inlineCode","value":"RunAgentInputSchema"},{"type":"text","value":". Returns parsed chat parameters ready to spread into "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":". On a malformed body, "},{"type":"strong","children":[{"type":"text","value":"throws a 400 "},{"type":"inlineCode","value":"Response"}]},{"type":"text","value":" that frameworks like TanStack Start, SolidStart, Remix, and React Router 7 return to the client automatically."}]},{"type":"code","value":"import { chat, chatParamsFromRequest, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { serverTools } from \"./tools\";\n\nexport async function POST(req: Request) {\n  const params = await chatParamsFromRequest(req);\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages: params.messages,\n    tools: serverTools,\n  });\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-6","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"req"},{"type":"text","value":" - An incoming "},{"type":"inlineCode","value":"Request"},{"type":"text","value":" whose JSON body conforms to AG-UI "},{"type":"inlineCode","value":"RunAgentInput"}]}]}]},{"type":"heading","depth":3,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise resolving to "},{"type":"inlineCode","value":"{ messages, threadId, runId, parentRunId?, tools, forwardedProps, state, aguiContext, context }"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The returned "},{"type":"inlineCode","value":"aguiContext"},{"type":"text","value":" is the AG-UI protocol "},{"type":"inlineCode","value":"RunAgentInput.context"},{"type":"text","value":" field. It is not the same as TanStack AI runtime "},{"type":"inlineCode","value":"chat({ context })"},{"type":"text","value":"; validate and map it explicitly if you want those values available to tools or middleware."}]},{"type":"paragraph","children":[{"type":"text","value":"The returned "},{"type":"inlineCode","value":"context"},{"type":"text","value":" field is a deprecated alias of "},{"type":"inlineCode","value":"aguiContext"},{"type":"text","value":" kept for backward compatibility. Prefer "},{"type":"inlineCode","value":"aguiContext"},{"type":"text","value":" in new code."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Framework note."}]},{"type":"text","value":" Next.js Route Handlers, SvelteKit, Hono, and raw Node do not auto-handle thrown "},{"type":"inlineCode","value":"Response"},{"type":"text","value":" objects. In those, wrap with try/catch or use "},{"type":"inlineCode","value":"chatParamsFromRequestBody(await req.json())"},{"type":"text","value":" directly."}]}]},{"type":"heading","depth":2,"id":"chatparamsfromrequestbody-body","children":[{"type":"inlineCode","value":"chatParamsFromRequestBody(body)"}]},{"type":"paragraph","children":[{"type":"text","value":"Lower-level variant of "},{"type":"inlineCode","value":"chatParamsFromRequest"},{"type":"text","value":" that validates an already-parsed body. Rejects with an "},{"type":"inlineCode","value":"AGUIError"},{"type":"text","value":" on malformed input. Use this when you need explicit error handling control."}]},{"type":"code","value":"import { chatParamsFromRequestBody } from \"@tanstack/ai\";\n\nasync function handler(req: Request): Promise<Response> {\n  const body = await req.json();\n  try {\n    const params = await chatParamsFromRequestBody(body);\n    // ...\n    return new Response(\"ok\");\n  } catch (error) {\n    const message = error instanceof Error ? error.message : String(error);\n    return new Response(message, { status: 400 });\n  }\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"mergeagenttools-servertools-clienttools","children":[{"type":"inlineCode","value":"mergeAgentTools(serverTools, clientTools)"}]},{"type":"paragraph","children":[{"type":"text","value":"Merges a server-side tool registry with the AG-UI client-declared tools received in the request payload. Server tools win on name collision; client-only tools become no-execute stubs that the runtime dispatches via "},{"type":"inlineCode","value":"ClientToolRequest"},{"type":"text","value":" events."}]},{"type":"code","value":"import { chat, chatParamsFromRequest, mergeAgentTools } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { serverTools } from \"./tools\";\n\nasync function handler(req: Request) {\n  const params = await chatParamsFromRequest(req);\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages: params.messages,\n    tools: mergeAgentTools(serverTools, params.tools),\n  });\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-7","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"serverTools"},{"type":"text","value":" - The server's "},{"type":"inlineCode","value":"toolDefinition().server(...)"},{"type":"text","value":" registry, keyed by tool name"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"clientTools"},{"type":"text","value":" - The "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" array from "},{"type":"inlineCode","value":"chatParamsFromRequest"},{"type":"text","value":"'s return value"}]}]}]},{"type":"heading","depth":3,"id":"returns-8","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A merged tool record suitable for "},{"type":"inlineCode","value":"chat({ tools })"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"maxiterations-count","children":[{"type":"inlineCode","value":"maxIterations(count)"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates an agent loop strategy that limits "},{"type":"strong","children":[{"type":"text","value":"model turns"}]},{"type":"text","value":" (iterations), not tool calls. One turn can still emit many parallel tool calls — use middleware for tool-call budgets ("},{"type":"link","href":"../chat/agentic-cycle#tool-call-budgets-middleware-recipe","children":[{"type":"text","value":"recipe"}]},{"type":"text","value":")."}]},{"type":"code","value":"import { chat, maxIterations } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  agentLoopStrategy: maxIterations(20),\n});","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-8","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"count"},{"type":"text","value":" - Maximum number of model turns"}]}]}]},{"type":"heading","depth":3,"id":"returns-9","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"An "},{"type":"inlineCode","value":"AgentLoopStrategy"},{"type":"text","value":" function."}]},{"type":"heading","depth":2,"id":"definebyokprovider-id-label-env-with","children":[{"type":"inlineCode","value":"defineByokProvider({ id, label, env?, with? })"}]},{"type":"paragraph","children":[{"type":"text","value":"Declare a BYOK provider from an adapter package. "},{"type":"inlineCode","value":"id"},{"type":"text","value":" is the "},{"type":"inlineCode","value":"x-byok-<id>"},{"type":"text","value":" slug and is "},{"type":"strong","children":[{"type":"text","value":"required"}]},{"type":"text","value":" — an optional or missing "},{"type":"inlineCode","value":"id"},{"type":"text","value":" does not type-check."}]},{"type":"code","value":"import { defineByokProvider } from \"@tanstack/ai/byok\";\n\nexport const openaiByok = defineByokProvider({\n  id: \"openai\",\n  label: \"OpenAI\",\n  env: \"OPENAI_API_KEY\",\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Import the object from the adapter "},{"type":"inlineCode","value":"/byok"},{"type":"text","value":" subpath ("},{"type":"inlineCode","value":"openaiByok"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-openai/byok"},{"type":"text","value":"). Pass it to "},{"type":"inlineCode","value":"getByokKey"},{"type":"text","value":" on the relay. Do not import it from the adapter main entry. That pulls in the provider SDK. Import "},{"type":"inlineCode","value":"getByokKey"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai/byok/server"},{"type":"text","value":". That entry is the only BYOK module that reads "},{"type":"inlineCode","value":"process.env"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"parameters-9","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"id"},{"type":"text","value":" - Required slug ("},{"type":"inlineCode","value":"[a-z][a-z0-9-]{0,63}"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"label"},{"type":"text","value":" - Display name"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"env?"},{"type":"text","value":" - Env var "},{"type":"strong","children":[{"type":"text","value":"name"}]},{"type":"text","value":", or a list of names tried in order. A string is stored as a one-element array. Names only — this object is imported on the client, so do not put "},{"type":"inlineCode","value":"process.env"},{"type":"text","value":" values here"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"with?"},{"type":"text","value":" - Other descriptors this credential needs, for example an account id next to a token. A store created with "},{"type":"inlineCode","value":"defineByok({ providers })"},{"type":"text","value":" sends their headers and prompts for them together with this one. Read them on the relay with "},{"type":"inlineCode","value":"getByokKeys"}]}]}]},{"type":"heading","depth":3,"id":"returns-10","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"{ id, label, env?, with? }"},{"type":"text","value":" object. "},{"type":"inlineCode","value":"id"},{"type":"text","value":" is the literal slug type."}]},{"type":"heading","depth":2,"id":"getbyokkey-request-provider","children":[{"type":"inlineCode","value":"getByokKey(request, provider)"}]},{"type":"paragraph","children":[{"type":"text","value":"Read a key on the relay. Import from "},{"type":"inlineCode","value":"@tanstack/ai/byok/server"},{"type":"text","value":" so "},{"type":"inlineCode","value":"process.env"},{"type":"text","value":" is not in the client graph. Works in any API route — it is not a TanStack Start server function."}]},{"type":"paragraph","children":[{"type":"text","value":"The header wins. A "},{"type":"inlineCode","value":"ByokProvider"},{"type":"text","value":" then tries "},{"type":"inlineCode","value":"provider.env"},{"type":"text","value":" in order. A slug is header-only. Returns "},{"type":"inlineCode","value":"null"},{"type":"text","value":" when both are empty. The JSON body is ignored."}]},{"type":"code","value":"import { getByokKey } from \"@tanstack/ai/byok/server\";\nimport { openaiByok } from \"@tanstack/ai-openai/byok\";\n\nexport async function POST(request: Request) {\n  const apiKey = getByokKey(request, openaiByok);\n  return new Response(apiKey ? \"ok\" : \"missing\");\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-10","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"request"},{"type":"text","value":" - Incoming "},{"type":"inlineCode","value":"Request"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"provider"},{"type":"text","value":" - A "},{"type":"inlineCode","value":"ByokProvider"},{"type":"text","value":" or a provider slug ("},{"type":"inlineCode","value":"[a-z][a-z0-9-]{0,63}"},{"type":"text","value":"). Becomes the "},{"type":"inlineCode","value":"x-byok-<slug>"},{"type":"text","value":" header. Not a fixed catalog."}]}]}]},{"type":"heading","depth":3,"id":"returns-11","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string | null"}]},{"type":"heading","depth":2,"id":"getbyokkeys-request-providers","children":[{"type":"inlineCode","value":"getByokKeys(request, providers)"}]},{"type":"paragraph","children":[{"type":"text","value":"Read several keys at once. Each entry obeys the same rules as "},{"type":"inlineCode","value":"getByokKey"},{"type":"text","value":". Use it when one credential is made of more than one value."}]},{"type":"code","value":"import { byokMissing, getByokKeys } from \"@tanstack/ai/byok/server\";\nimport {\n  cloudflareAccountByok,\n  cloudflareByok,\n} from \"@tanstack/ai-cloudflare/byok\";\n\nexport async function POST(request: Request) {\n  const { apiKey, accountId } = getByokKeys(request, {\n    apiKey: cloudflareByok,\n    accountId: cloudflareAccountByok,\n  });\n  if (!apiKey) return byokMissing(cloudflareByok);\n  if (!accountId) return byokMissing(cloudflareAccountByok);\n  return new Response(\"ok\");\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-11","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"request"},{"type":"text","value":" - Incoming "},{"type":"inlineCode","value":"Request"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"providers"},{"type":"text","value":" - An object whose values are a "},{"type":"inlineCode","value":"ByokProvider"},{"type":"text","value":" or a provider slug. The keys name the result."}]}]}]},{"type":"heading","depth":3,"id":"returns-12","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"An object with the same keys, each "},{"type":"inlineCode","value":"string | null"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"byokmissing-provider","children":[{"type":"inlineCode","value":"byokMissing(provider)"}]},{"type":"paragraph","children":[{"type":"text","value":"Return a "},{"type":"inlineCode","value":"401"},{"type":"text","value":" JSON "},{"type":"inlineCode","value":"Response"},{"type":"text","value":" with "},{"type":"inlineCode","value":"{ error: { type: \"byok_missing\", provider, message } }"},{"type":"text","value":". The chat and generation clients read this body and set "},{"type":"inlineCode","value":"snapshot.prompt"},{"type":"text","value":". Import from "},{"type":"inlineCode","value":"@tanstack/ai/byok"},{"type":"text","value":" or "},{"type":"inlineCode","value":"@tanstack/ai/byok/server"},{"type":"text","value":"."}]},{"type":"code","value":"import { byokMissing, getByokKey } from \"@tanstack/ai/byok/server\";\nimport { openaiByok } from \"@tanstack/ai-openai/byok\";\n\nexport async function POST(request: Request) {\n  const apiKey = getByokKey(request, openaiByok);\n  if (!apiKey) return byokMissing(openaiByok);\n  return new Response(\"ok\");\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"parameters-12","children":[{"type":"text","value":"Parameters"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"provider"},{"type":"text","value":" - A "},{"type":"inlineCode","value":"ByokProvider"},{"type":"text","value":" or a provider slug to put on the error body"}]}]}]},{"type":"heading","depth":3,"id":"returns-13","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"Response"},{"type":"text","value":" with status "},{"type":"inlineCode","value":"401"},{"type":"text","value":" and "},{"type":"inlineCode","value":"content-type: application/json"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"maskkey-key","children":[{"type":"inlineCode","value":"maskKey(key)"}]},{"type":"paragraph","children":[{"type":"text","value":"Return the last four characters of a key. Keys of four characters or fewer become "},{"type":"inlineCode","value":"\"••\""},{"type":"text","value":"."}]},{"type":"code","value":"import { maskKey } from \"@tanstack/ai/byok\";\n\nmaskKey(\"sk-abcdefghij\"); // \"ghij\"","lang":"typescript"},{"type":"heading","depth":2,"id":"scrubsecrets-input-secrets","children":[{"type":"inlineCode","value":"scrubSecrets(input, secrets)"}]},{"type":"paragraph","children":[{"type":"text","value":"Replace each listed secret in "},{"type":"inlineCode","value":"input"},{"type":"text","value":" with "},{"type":"inlineCode","value":"[redacted]"},{"type":"text","value":". Use this before you log an error string."}]},{"type":"code","value":"import { scrubSecrets } from \"@tanstack/ai/byok\";\n\nscrubSecrets(\"failed sk-live extra\", [\"sk-live\"]);\n// \"failed [redacted] extra\"","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../advanced/byok","children":[{"type":"text","value":"Bring Your Own Key"}]},{"type":"text","value":" for the client store and a full relay."}]},{"type":"heading","depth":2,"id":"types","children":[{"type":"text","value":"Types"}]},{"type":"heading","depth":3,"id":"modelmessage","children":[{"type":"inlineCode","value":"ModelMessage"}]},{"type":"code","value":"import type {\n  ContentPart,\n  StructuredOutputPart,\n  ToolCall,\n} from \"@tanstack/ai\";\n\ninterface ModelMessage<\n  TContent extends string | null | ContentPart[] =\n    | string\n    | null\n    | ContentPart[],\n> {\n  role: \"user\" | \"assistant\" | \"tool\";\n  content: TContent;\n  name?: string;\n  toolCalls?: ToolCall[];\n  toolCallId?: string;\n  thinking?: Array<{ content: string; signature?: string }>;\n  structuredOutput?: StructuredOutputPart;\n  id?: string;\n  createdAt?: Date;\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"streamchunk","children":[{"type":"inlineCode","value":"StreamChunk"}]},{"type":"code","value":"type StreamChunk =\n  | ContentStreamChunk\n  | ThinkingStreamChunk\n  | ToolCallStreamChunk\n  | ToolResultStreamChunk\n  | DoneStreamChunk\n  | ErrorStreamChunk;\n\ninterface ThinkingStreamChunk {\n  type: \"thinking\";\n  id: string;\n  model: string;\n  timestamp: number;\n  delta?: string; // Incremental thinking token\n  content: string; // Accumulated thinking content\n}","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"text","value":"Stream chunks represent different types of data in the stream:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Content chunks"}]},{"type":"text","value":" - Text content being generated"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Thinking chunks"}]},{"type":"text","value":" - Model's reasoning process (when supported by the model)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Tool call chunks"}]},{"type":"text","value":" - When the model calls a tool"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Tool result chunks"}]},{"type":"text","value":" - Results from tool execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Done chunks"}]},{"type":"text","value":" - Stream completion"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Error chunks"}]},{"type":"text","value":" - Stream errors"}]}]}]},{"type":"heading","depth":3,"id":"tool","children":[{"type":"inlineCode","value":"Tool"}]},{"type":"code","value":"import type { SchemaInput, ToolExecutionContext } from \"@tanstack/ai\";\n\ninterface Tool<TContext = unknown> {\n  name: string;\n  description: string;\n  inputSchema?: SchemaInput;\n  outputSchema?: SchemaInput;\n  execute?: (\n    args: any,\n    context?: ToolExecutionContext<TContext>\n  ) => Promise<any> | any;\n  needsApproval?: boolean;\n  lazy?: boolean;\n  metadata?: Record<string, any>;\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"toolexecutioncontexttcontext","children":[{"type":"inlineCode","value":"ToolExecutionContext<TContext>"}]},{"type":"code","value":"type ToolExecutionContext<TContext = unknown> = {\n  toolCallId?: string;\n  emitCustomEvent: (\n    eventName: string,\n    value: Record<string, any>,\n    options?: { batch?: boolean },\n  ) => void;\n} & (unknown extends TContext ? { context?: TContext } : { context: TContext });","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"inlineCode","value":"context"},{"type":"text","value":" is the runtime value from "},{"type":"inlineCode","value":"chat({ context })"},{"type":"text","value":" for server tools, or from "},{"type":"inlineCode","value":"ChatClient"},{"type":"text","value":" / framework hook options for client tools. It is required when a tool declares a concrete "},{"type":"inlineCode","value":"TContext"},{"type":"text","value":" and optional for untyped tools where the context type is "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"chatmiddlewaretcontext","children":[{"type":"inlineCode","value":"ChatMiddleware<TContext>"}]},{"type":"code","value":"import type {\n  StreamChunk,\n  ChatMiddlewarePhase,\n  ToolCallHookContext,\n  BeforeToolCallDecision,\n  AfterToolCallInfo,\n  FinishInfo,\n  AbortInfo,\n  ErrorInfo,\n} from \"@tanstack/ai\";\n\ninterface ChatMiddlewareContext<TContext = unknown> {\n  requestId: string;\n  streamId: string;\n  threadId: string;\n  phase: ChatMiddlewarePhase;\n  iteration: number;\n  context: TContext;\n  abort(reason?: string): void;\n  defer(promise: Promise<unknown>): void;\n}\n\ninterface ChatMiddleware<TContext = unknown> {\n  name?: string;\n  onStart?: (ctx: ChatMiddlewareContext<TContext>) => void | Promise<void>;\n  onChunk?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    chunk: StreamChunk\n  ) => void | StreamChunk | StreamChunk[] | null | Promise<void | StreamChunk | StreamChunk[] | null>;\n  onBeforeToolCall?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    hookCtx: ToolCallHookContext\n  ) => BeforeToolCallDecision | Promise<BeforeToolCallDecision>;\n  onAfterToolCall?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: AfterToolCallInfo\n  ) => void | Promise<void>;\n  onFinish?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: FinishInfo\n  ) => void | Promise<void>;\n  onAbort?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: AbortInfo\n  ) => void | Promise<void>;\n  onError?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: ErrorInfo\n  ) => void | Promise<void>;\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../advanced/runtime-context","children":[{"type":"text","value":"Runtime Context"}]},{"type":"text","value":" for the recommended context patterns."}]},{"type":"heading","depth":2,"id":"usage-examples","children":[{"type":"text","value":"Usage Examples"}]},{"type":"code","value":"import { chat, summarize, generateImage, toolDefinition } from \"@tanstack/ai\";\nimport {\n  openaiText,\n  openaiSummarize,\n  openaiImage,\n} from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\n// --- Streaming chat\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n\n// --- Structured response with tools\nconst weatherTool = toolDefinition({\n  name: \"getWeather\",\n  description: \"Get the current weather for a city\",\n  inputSchema: z.object({\n    city: z.string(),\n  }),\n}).server(async ({ city }) => {\n  // Implementation that fetches weather info\n  return JSON.stringify({ temperature: 72, condition: \"Sunny\" });\n});\n\nasync function examples() {\n  // --- One-shot chat response (stream: false)\n  const { text } = await chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [{ role: \"user\", content: \"What's the capital of France?\" }],\n    stream: false, // Resolves to { text, chunks } when the run ends\n  });\n\n  // --- Structured response with outputSchema\n  const parsed = await chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [{ role: \"user\", content: \"Summarize this text in JSON with keys 'summary' and 'keywords': ... \" }],\n    outputSchema: z.object({\n      summary: z.string(),\n      keywords: z.array(z.string()),\n    }),\n  });\n\n  const toolResult = await chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [\n      { role: \"user\", content: \"What's the weather in Paris?\" }\n    ],\n    tools: [weatherTool],\n    outputSchema: z.object({\n      answer: z.string(),\n      weather: z.object({\n        temperature: z.number(),\n        condition: z.string(),\n      }),\n    }),\n  });\n\n  // --- Summarization\n  const summary = await summarize({\n    adapter: openaiSummarize(\"gpt-5.2\"),\n    text: \"Long text to summarize...\",\n    maxLength: 100,\n  });\n\n  // --- Image generation\n  const image = await generateImage({\n    adapter: openaiImage(\"dall-e-3\"),\n    prompt: \"A futuristic city skyline at sunset\",\n    numberOfImages: 1,\n    size: \"1024x1024\",\n  });\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Getting Started"}]},{"type":"text","value":" - Learn the basics"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../advanced/byok","children":[{"type":"text","value":"Bring Your Own Key"}]},{"type":"text","value":" - Read user keys on the relay"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../evaluate/evaluate","children":[{"type":"text","value":"Evaluate"}]},{"type":"text","value":" - Ask typed questions about shared state"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools Guide"}]},{"type":"text","value":" - Learn about tools"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../adapters/openai","children":[{"type":"text","value":"Adapters"}]},{"type":"text","value":" - Explore adapter options"}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"chat-options","text":"chat(options)","level":2},{"id":"parameters","text":"Parameters","level":3},{"id":"returns","text":"Returns","level":3},{"id":"summarize-options","text":"summarize(options)","level":2},{"id":"parameters-2","text":"Parameters","level":3},{"id":"returns-2","text":"Returns","level":3},{"id":"decide-options","text":"decide(options)","level":2},{"id":"parameters-decide","text":"Parameters (decide)","level":3},{"id":"returns-3","text":"Returns","level":3},{"id":"helpers","text":"Helpers","level":3},{"id":"tooldefinition-config","text":"toolDefinition(config)","level":2},{"id":"parameters-3","text":"Parameters","level":3},{"id":"returns-4","text":"Returns","level":3},{"id":"toserversenteventsstream-stream-abortcontroller","text":"toServerSentEventsStream(stream, abortController?)","level":2},{"id":"parameters-4","text":"Parameters","level":3},{"id":"returns-5","text":"Returns","level":3},{"id":"toserversenteventsresponse-stream-init","text":"toServerSentEventsResponse(stream, init?)","level":2},{"id":"parameters-5","text":"Parameters","level":3},{"id":"returns-6","text":"Returns","level":3},{"id":"chatparamsfromrequest-req","text":"chatParamsFromRequest(req)","level":2},{"id":"parameters-6","text":"Parameters","level":3},{"id":"returns-7","text":"Returns","level":3},{"id":"chatparamsfromrequestbody-body","text":"chatParamsFromRequestBody(body)","level":2},{"id":"mergeagenttools-servertools-clienttools","text":"mergeAgentTools(serverTools, clientTools)","level":2},{"id":"parameters-7","text":"Parameters","level":3},{"id":"returns-8","text":"Returns","level":3},{"id":"maxiterations-count","text":"maxIterations(count)","level":2},{"id":"parameters-8","text":"Parameters","level":3},{"id":"returns-9","text":"Returns","level":3},{"id":"definebyokprovider-id-label-env-with","text":"defineByokProvider({ id, label, env?, with? })","level":2},{"id":"parameters-9","text":"Parameters","level":3},{"id":"returns-10","text":"Returns","level":3},{"id":"getbyokkey-request-provider","text":"getByokKey(request, provider)","level":2},{"id":"parameters-10","text":"Parameters","level":3},{"id":"returns-11","text":"Returns","level":3},{"id":"getbyokkeys-request-providers","text":"getByokKeys(request, providers)","level":2},{"id":"parameters-11","text":"Parameters","level":3},{"id":"returns-12","text":"Returns","level":3},{"id":"byokmissing-provider","text":"byokMissing(provider)","level":2},{"id":"parameters-12","text":"Parameters","level":3},{"id":"returns-13","text":"Returns","level":3},{"id":"maskkey-key","text":"maskKey(key)","level":2},{"id":"scrubsecrets-input-secrets","text":"scrubSecrets(input, secrets)","level":2},{"id":"types","text":"Types","level":2},{"id":"modelmessage","text":"ModelMessage","level":3},{"id":"streamchunk","text":"StreamChunk","level":3},{"id":"tool","text":"Tool","level":3},{"id":"toolexecutioncontexttcontext","text":"ToolExecutionContext<TContext>","level":3},{"id":"chatmiddlewaretcontext","text":"ChatMiddleware<TContext>","level":3},{"id":"usage-examples","text":"Usage Examples","level":2},{"id":"next-steps","text":"Next Steps","level":2}]},"frameworks":["react","vue","solid","svelte","preact","angular","vanilla","octane"],"downloadMarkdown":"\nThe core AI library for TanStack AI.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai\nvue: @tanstack/ai\nsolid: @tanstack/ai\nsvelte: @tanstack/ai\npreact: @tanstack/ai\nangular: @tanstack/ai\nvanilla: @tanstack/ai\noctane: @tanstack/ai\n\n<!-- ::end:tabs -->\n\n## `chat(options)`\n\nCreates a streaming chat response.\n\n```typescript\nimport { chat, maxIterations } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { myTool } from \"./tools\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  tools: [myTool],\n  systemPrompts: [\"You are a helpful assistant\"],\n  agentLoopStrategy: maxIterations(20),\n});\n```\n\n### Parameters\n\n- `adapter` - An AI adapter instance with model (e.g., `openaiText('gpt-5.2')`, `anthropicText('claude-sonnet-4-5')`)\n- `messages` - Array of chat messages. Accepts mixed `UIMessage | ModelMessage` arrays — internal conversion handles AG-UI fan-out dedup, drops `reasoning`/`activity`, and collapses `developer` → `system`\n- `tools?` - Array of tools for function calling\n- `context?` - Typed runtime context passed to server tools and middleware. If a tool or middleware declares a concrete context type, `chat()` requires a compatible value here\n- `systemPrompts?` - System prompts to prepend to messages\n- `agentLoopStrategy?` - Strategy for agent loops (default: `maxIterations(5)`). Strategies receive `{ iterationCount, finishReason, messages, toolCallCount, lastTurnToolCallCount }` and run between model turns. Iterations are model turns, not tool calls — for tool-call budgets use middleware (`onBeforeToolCall` + `onShouldContinue`); see [Tool-call budgets](../chat/agentic-cycle#tool-call-budgets-middleware-recipe).\n- `middleware?` - Array of chat middleware. Use `onShouldContinue` / `onBeforeToolCall` for app-owned tool budgets.\n- `abortController?` - AbortController for cancellation\n- `modelOptions?` - Provider-native model options. This is where sampling parameters live — `temperature`, `top_p`/`topP`, and the provider's token-limit key (`max_output_tokens`, `max_tokens`, `maxOutputTokens`, …) — under each provider's canonical name, rather than as generic root-level props. See [Moving Sampling Options into modelOptions](../migration/sampling-options-to-model-options). (Renamed from `providerOptions`.)\n- `threadId?` - AG-UI thread identifier propagated into `RUN_STARTED` events for run correlation\n- `runId?` - AG-UI run identifier (auto-generated if omitted)\n- `parentRunId?` - AG-UI parent run identifier for nested runs\n- `stream?` - Set to `false` to get one result when the run ends. See [Returns](#returns).\n\n### Returns\n\nAn async iterable of `StreamChunk`.\n\nWith `stream: false`, `chat()` returns `Promise<ChatResult>`:\n\n- `text`: the full reply as one string.\n- `chunks`: every chunk the run produced, in order. This includes tool calls, tool results, reasoning, usage, and the `RUN_FINISHED` chunk with any interrupts.\n\nIf the run fails, the promise rejects with the error from `RUN_ERROR`. If you also pass `outputSchema`, the promise resolves to the parsed object.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst { text, chunks } = await chat({\n  adapter: openaiText(\"gpt-5.6\"),\n  messages: [{ role: \"user\", content: \"What's the capital of France?\" }],\n  stream: false,\n});\n\nconsole.log(text);\n\nfor (const chunk of chunks) {\n  if (chunk.type === \"TOOL_CALL_START\") {\n    console.log(\"Tool call:\", chunk.toolCallName);\n  }\n  if (chunk.type === \"RUN_FINISHED\") {\n    console.log(\"Usage:\", chunk.usage);\n  }\n}\n```\n\nIf you already have a stream, `streamToText(stream)` reads it to the end and returns the same `ChatResult`.\n\n## `summarize(options)`\n\nCreates a text summarization.\n\n```typescript\nimport { summarize } from \"@tanstack/ai\";\nimport { openaiSummarize } from \"@tanstack/ai-openai\";\n\nconst result = await summarize({\n  adapter: openaiSummarize(\"gpt-5.2\"),\n  text: \"Long text to summarize...\",\n  maxLength: 100,\n  style: \"concise\",\n});\n```\n\n### Parameters\n\n- `adapter` - An AI adapter instance with model\n- `text` - Text to summarize\n- `maxLength?` - Maximum length of summary\n- `style?` - Summary style (\"concise\" | \"detailed\")\n- `modelOptions?` - Model-specific options\n\n### Returns\n\nA `SummarizationResult` with the summary text.\n\n## `decide(options)`\n\nAsks typed questions about a shared state and returns answers your code can\nbranch on. This call is async. There is no stream.\n\n```typescript\nimport { decide, choice, score, boolean } from \"@tanstack/ai\";\nimport { typesafeDecider } from \"@tanstack/ai-typesafe\";\n\nconst ticket = {\n  subject: \"Charged twice for the same invoice\",\n  body: \"Please refund the extra payment.\",\n};\n\nconst result = await decide({\n  adapter: typesafeDecider(\"jev-latest\"),\n  state: ticket,\n  questions: {\n    queue: choice({\n      instructions: \"Which team should handle this ticket?\",\n      options: {\n        billing: \"Payments, invoices, refunds\",\n        tech: \"Bugs, outages, integrations\",\n        sales: \"Pricing, upgrades, new accounts\",\n      },\n    }),\n    urgency: score({\n      instructions: \"How urgent is this ticket?\",\n      levels: [\"low\", \"medium\", \"high\"],\n    }),\n    refund: boolean({\n      instructions: \"Is the customer asking for a refund?\",\n    }),\n  },\n});\n\nconsole.log(result.queue.value);\nconsole.log(result.queue.probability);\nconsole.log(result.queue.confidence);\nconsole.log(result.meta.usage);\n```\n\n### Parameters (`decide`)\n\nRequired:\n\n- `adapter` - An evaluate adapter created with a model (for example `typesafeDecider('jev-latest')`)\n- `state` - Shared content every question judges. A string, an object, or an array. An array is one state, not a batch.\n- `questions` - Map of `choice`, `score`, and `boolean` questions. The key `meta` is reserved.\n\nOptional:\n\n- `abortSignal?` - Cancel the in-flight request\n- `modelOptions?` - Provider-specific options\n- `middleware?` - Observe-only generation middleware\n- `debug?` - Debug logging\n\n### Returns\n\nEach question key is a top-level answer. `meta.model` and `meta.usage` hold the resolved model id and token usage. When the adapter returns them, `meta.id` holds the provider response id and `meta.provider` names the upstream provider.\n\n- `choice`: `.value` is the selected option key. `.probability` is P(selected). `.confidence` is a number from 0 to 1. `.probabilities` is the full map.\n- `score`: `.value` is the nearest level label. `.score` is the raw fraction. `.probability` is P(that level). `.confidence` is a number from 0 to 1. `.legend` maps each level index to its label. `.probabilities` is the full map, keyed by level index.\n- `boolean`: When `.probability` is 0.5 or more, `.value` is `true`. No `.confidence`.\n\n### Helpers\n\n- `choice({ instructions, options })` - Pick one key from `options`\n- `score({ instructions, levels })` - Rate `state` on ordered `levels` (at least two)\n- `boolean({ instructions, criteria? })` - Yes or no. When P(true) is 0.5 or more, `.value` is `true`\n\nSee [Evaluate](../evaluate/evaluate) for adapters, abort, and middleware.\n\n## `toolDefinition(config)`\n\nCreates an isomorphic tool definition that can be instantiated for server or client execution.\n\n```typescript\nimport { chat, toolDefinition } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\nconst myToolDef = toolDefinition({\n  name: \"my_tool\",\n  description: \"Tool description\",\n  inputSchema: z.object({\n    param: z.string(),\n  }),\n  outputSchema: z.object({\n    result: z.string(),\n  }),\n  needsApproval: false, // Optional\n});\n\n// Or create client implementation\nconst myClientTool = myToolDef.client(async ({ param }) => {\n  // Client-side implementation\n  return { result: \"...\" };\n});\n\n// Use directly in chat() (server-side, no execute)\nchat({\n  adapter: openaiText(\"gpt-5.2\"),\n  tools: [myToolDef],\n  messages: [{ role: \"user\", content: \"...\" }],\n});\n\n// Or create server implementation\nconst myServerTool = myToolDef.server(async ({ param }) => {\n  // Server-side implementation\n  return { result: \"...\" };\n});\n\n// Use directly in chat() (server-side, no execute)\nchat({\n  adapter: openaiText(\"gpt-5.2\"),\n  tools: [myServerTool],\n  messages: [{ role: \"user\", content: \"...\" }],\n});\n```\n\nTools can declare typed runtime context for request-scoped dependencies:\n\n```typescript\nimport { chat, toolDefinition, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { session, db } from \"./app\";\n\ntype AppContext = {\n  userId: string;\n  db: { users: { findName(id: string): Promise<string> } };\n};\n\nconst currentUser = toolDefinition({\n  name: \"current_user\",\n  description: \"Get the current user\",\n}).server<AppContext>(async (_input: unknown, ctx) => {\n  return { name: await ctx.context.db.users.findName(ctx.context.userId) };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages,\n    tools: [currentUser],\n    context: { userId: session.user.id, db },\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\n### Parameters\n\n- `name` - Tool name (must be unique)\n- `description` - Tool description for the model\n- `inputSchema` - Zod schema for input validation\n- `outputSchema?` - Zod schema for output validation\n- `needsApproval?` - Whether tool requires user approval\n- `metadata?` - Additional metadata\n\n### Returns\n\nA `ToolDefinition` object with `.server()` and `.client()` methods for creating concrete implementations.\n\n## `toServerSentEventsStream(stream, abortController?)`\n\nConverts a stream to a ReadableStream in Server-Sent Events format.\n\n```typescript\nimport { chat, toServerSentEventsStream } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\nconst readableStream = toServerSentEventsStream(stream);\n```\n\n### Parameters\n\n- `stream` - Async iterable of `StreamChunk`\n- `abortController?` - Optional AbortController to abort when stream is cancelled\n\n### Returns\n\nA `ReadableStream<Uint8Array>` in Server-Sent Events format. Each chunk is:\n- Prefixed with `\"data: \"`\n- Followed by `\"\\n\\n\"`\n- Stream ends with `\"data: [DONE]\\n\\n\"`\n\n## `toServerSentEventsResponse(stream, init?)`\n\nConverts a stream to an HTTP Response with proper SSE headers.\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nasync function POST() {\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [{ role: \"user\", content: \"Hello!\" }],\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\n### Parameters\n\n- `stream` - Async iterable of `StreamChunk`\n- `init?` - Optional ResponseInit options (including `abortController`)\n\n### Returns\n\nA `Response` object suitable for HTTP endpoints with SSE headers (`Content-Type: text/event-stream`, `Cache-Control: no-cache`, `Connection: keep-alive`).\n\n## `chatParamsFromRequest(req)`\n\nReads an HTTP `Request`, parses its JSON body, and validates it against AG-UI `RunAgentInputSchema`. Returns parsed chat parameters ready to spread into `chat()`. On a malformed body, **throws a 400 `Response`** that frameworks like TanStack Start, SolidStart, Remix, and React Router 7 return to the client automatically.\n\n```typescript\nimport { chat, chatParamsFromRequest, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { serverTools } from \"./tools\";\n\nexport async function POST(req: Request) {\n  const params = await chatParamsFromRequest(req);\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages: params.messages,\n    tools: serverTools,\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\n### Parameters\n\n- `req` - An incoming `Request` whose JSON body conforms to AG-UI `RunAgentInput`\n\n### Returns\n\nA promise resolving to `{ messages, threadId, runId, parentRunId?, tools, forwardedProps, state, aguiContext, context }`.\n\nThe returned `aguiContext` is the AG-UI protocol `RunAgentInput.context` field. It is not the same as TanStack AI runtime `chat({ context })`; validate and map it explicitly if you want those values available to tools or middleware.\n\nThe returned `context` field is a deprecated alias of `aguiContext` kept for backward compatibility. Prefer `aguiContext` in new code.\n\n> **Framework note.** Next.js Route Handlers, SvelteKit, Hono, and raw Node do not auto-handle thrown `Response` objects. In those, wrap with try/catch or use `chatParamsFromRequestBody(await req.json())` directly.\n\n## `chatParamsFromRequestBody(body)`\n\nLower-level variant of `chatParamsFromRequest` that validates an already-parsed body. Rejects with an `AGUIError` on malformed input. Use this when you need explicit error handling control.\n\n```typescript\nimport { chatParamsFromRequestBody } from \"@tanstack/ai\";\n\nasync function handler(req: Request): Promise<Response> {\n  const body = await req.json();\n  try {\n    const params = await chatParamsFromRequestBody(body);\n    // ...\n    return new Response(\"ok\");\n  } catch (error) {\n    const message = error instanceof Error ? error.message : String(error);\n    return new Response(message, { status: 400 });\n  }\n}\n```\n\n## `mergeAgentTools(serverTools, clientTools)`\n\nMerges a server-side tool registry with the AG-UI client-declared tools received in the request payload. Server tools win on name collision; client-only tools become no-execute stubs that the runtime dispatches via `ClientToolRequest` events.\n\n```typescript\nimport { chat, chatParamsFromRequest, mergeAgentTools } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { serverTools } from \"./tools\";\n\nasync function handler(req: Request) {\n  const params = await chatParamsFromRequest(req);\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages: params.messages,\n    tools: mergeAgentTools(serverTools, params.tools),\n  });\n}\n```\n\n### Parameters\n\n- `serverTools` - The server's `toolDefinition().server(...)` registry, keyed by tool name\n- `clientTools` - The `tools` array from `chatParamsFromRequest`'s return value\n\n### Returns\n\nA merged tool record suitable for `chat({ tools })`.\n\n## `maxIterations(count)`\n\nCreates an agent loop strategy that limits **model turns** (iterations), not tool calls. One turn can still emit many parallel tool calls — use middleware for tool-call budgets ([recipe](../chat/agentic-cycle#tool-call-budgets-middleware-recipe)).\n\n```typescript\nimport { chat, maxIterations } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  agentLoopStrategy: maxIterations(20),\n});\n```\n\n### Parameters\n\n- `count` - Maximum number of model turns\n\n### Returns\n\nAn `AgentLoopStrategy` function.\n\n## `defineByokProvider({ id, label, env?, with? })`\n\nDeclare a BYOK provider from an adapter package. `id` is the `x-byok-<id>` slug and is **required** — an optional or missing `id` does not type-check.\n\n```typescript\nimport { defineByokProvider } from \"@tanstack/ai/byok\";\n\nexport const openaiByok = defineByokProvider({\n  id: \"openai\",\n  label: \"OpenAI\",\n  env: \"OPENAI_API_KEY\",\n});\n```\n\nImport the object from the adapter `/byok` subpath (`openaiByok` from `@tanstack/ai-openai/byok`). Pass it to `getByokKey` on the relay. Do not import it from the adapter main entry. That pulls in the provider SDK. Import `getByokKey` from `@tanstack/ai/byok/server`. That entry is the only BYOK module that reads `process.env`.\n\n### Parameters\n\n- `id` - Required slug (`[a-z][a-z0-9-]{0,63}`)\n- `label` - Display name\n- `env?` - Env var **name**, or a list of names tried in order. A string is stored as a one-element array. Names only — this object is imported on the client, so do not put `process.env` values here\n- `with?` - Other descriptors this credential needs, for example an account id next to a token. A store created with `defineByok({ providers })` sends their headers and prompts for them together with this one. Read them on the relay with `getByokKeys`\n\n### Returns\n\nA `{ id, label, env?, with? }` object. `id` is the literal slug type.\n\n## `getByokKey(request, provider)`\n\nRead a key on the relay. Import from `@tanstack/ai/byok/server` so `process.env` is not in the client graph. Works in any API route — it is not a TanStack Start server function.\n\nThe header wins. A `ByokProvider` then tries `provider.env` in order. A slug is header-only. Returns `null` when both are empty. The JSON body is ignored.\n\n```typescript\nimport { getByokKey } from \"@tanstack/ai/byok/server\";\nimport { openaiByok } from \"@tanstack/ai-openai/byok\";\n\nexport async function POST(request: Request) {\n  const apiKey = getByokKey(request, openaiByok);\n  return new Response(apiKey ? \"ok\" : \"missing\");\n}\n```\n\n### Parameters\n\n- `request` - Incoming `Request`\n- `provider` - A `ByokProvider` or a provider slug (`[a-z][a-z0-9-]{0,63}`). Becomes the `x-byok-<slug>` header. Not a fixed catalog.\n\n### Returns\n\n`string | null`\n\n## `getByokKeys(request, providers)`\n\nRead several keys at once. Each entry obeys the same rules as `getByokKey`. Use it when one credential is made of more than one value.\n\n```typescript\nimport { byokMissing, getByokKeys } from \"@tanstack/ai/byok/server\";\nimport {\n  cloudflareAccountByok,\n  cloudflareByok,\n} from \"@tanstack/ai-cloudflare/byok\";\n\nexport async function POST(request: Request) {\n  const { apiKey, accountId } = getByokKeys(request, {\n    apiKey: cloudflareByok,\n    accountId: cloudflareAccountByok,\n  });\n  if (!apiKey) return byokMissing(cloudflareByok);\n  if (!accountId) return byokMissing(cloudflareAccountByok);\n  return new Response(\"ok\");\n}\n```\n\n### Parameters\n\n- `request` - Incoming `Request`\n- `providers` - An object whose values are a `ByokProvider` or a provider slug. The keys name the result.\n\n### Returns\n\nAn object with the same keys, each `string | null`.\n\n## `byokMissing(provider)`\n\nReturn a `401` JSON `Response` with `{ error: { type: \"byok_missing\", provider, message } }`. The chat and generation clients read this body and set `snapshot.prompt`. Import from `@tanstack/ai/byok` or `@tanstack/ai/byok/server`.\n\n```typescript\nimport { byokMissing, getByokKey } from \"@tanstack/ai/byok/server\";\nimport { openaiByok } from \"@tanstack/ai-openai/byok\";\n\nexport async function POST(request: Request) {\n  const apiKey = getByokKey(request, openaiByok);\n  if (!apiKey) return byokMissing(openaiByok);\n  return new Response(\"ok\");\n}\n```\n\n### Parameters\n\n- `provider` - A `ByokProvider` or a provider slug to put on the error body\n\n### Returns\n\nA `Response` with status `401` and `content-type: application/json`.\n\n## `maskKey(key)`\n\nReturn the last four characters of a key. Keys of four characters or fewer become `\"••\"`.\n\n```typescript\nimport { maskKey } from \"@tanstack/ai/byok\";\n\nmaskKey(\"sk-abcdefghij\"); // \"ghij\"\n```\n\n## `scrubSecrets(input, secrets)`\n\nReplace each listed secret in `input` with `[redacted]`. Use this before you log an error string.\n\n```typescript\nimport { scrubSecrets } from \"@tanstack/ai/byok\";\n\nscrubSecrets(\"failed sk-live extra\", [\"sk-live\"]);\n// \"failed [redacted] extra\"\n```\n\nSee [Bring Your Own Key](../advanced/byok) for the client store and a full relay.\n\n## Types\n\n### `ModelMessage`\n\n```typescript\nimport type {\n  ContentPart,\n  StructuredOutputPart,\n  ToolCall,\n} from \"@tanstack/ai\";\n\ninterface ModelMessage<\n  TContent extends string | null | ContentPart[] =\n    | string\n    | null\n    | ContentPart[],\n> {\n  role: \"user\" | \"assistant\" | \"tool\";\n  content: TContent;\n  name?: string;\n  toolCalls?: ToolCall[];\n  toolCallId?: string;\n  thinking?: Array<{ content: string; signature?: string }>;\n  structuredOutput?: StructuredOutputPart;\n  id?: string;\n  createdAt?: Date;\n}\n```\n\n### `StreamChunk`\n\n```typescript ignore\ntype StreamChunk =\n  | ContentStreamChunk\n  | ThinkingStreamChunk\n  | ToolCallStreamChunk\n  | ToolResultStreamChunk\n  | DoneStreamChunk\n  | ErrorStreamChunk;\n\ninterface ThinkingStreamChunk {\n  type: \"thinking\";\n  id: string;\n  model: string;\n  timestamp: number;\n  delta?: string; // Incremental thinking token\n  content: string; // Accumulated thinking content\n}\n```\n\nStream chunks represent different types of data in the stream:\n\n- **Content chunks** - Text content being generated\n- **Thinking chunks** - Model's reasoning process (when supported by the model)\n- **Tool call chunks** - When the model calls a tool\n- **Tool result chunks** - Results from tool execution\n- **Done chunks** - Stream completion\n- **Error chunks** - Stream errors\n\n### `Tool`\n\n```typescript\nimport type { SchemaInput, ToolExecutionContext } from \"@tanstack/ai\";\n\ninterface Tool<TContext = unknown> {\n  name: string;\n  description: string;\n  inputSchema?: SchemaInput;\n  outputSchema?: SchemaInput;\n  execute?: (\n    args: any,\n    context?: ToolExecutionContext<TContext>\n  ) => Promise<any> | any;\n  needsApproval?: boolean;\n  lazy?: boolean;\n  metadata?: Record<string, any>;\n}\n```\n\n### `ToolExecutionContext<TContext>`\n\n```typescript ignore\ntype ToolExecutionContext<TContext = unknown> = {\n  toolCallId?: string;\n  emitCustomEvent: (\n    eventName: string,\n    value: Record<string, any>,\n    options?: { batch?: boolean },\n  ) => void;\n} & (unknown extends TContext ? { context?: TContext } : { context: TContext });\n```\n\n`context` is the runtime value from `chat({ context })` for server tools, or from `ChatClient` / framework hook options for client tools. It is required when a tool declares a concrete `TContext` and optional for untyped tools where the context type is `unknown`.\n\n### `ChatMiddleware<TContext>`\n\n```typescript\nimport type {\n  StreamChunk,\n  ChatMiddlewarePhase,\n  ToolCallHookContext,\n  BeforeToolCallDecision,\n  AfterToolCallInfo,\n  FinishInfo,\n  AbortInfo,\n  ErrorInfo,\n} from \"@tanstack/ai\";\n\ninterface ChatMiddlewareContext<TContext = unknown> {\n  requestId: string;\n  streamId: string;\n  threadId: string;\n  phase: ChatMiddlewarePhase;\n  iteration: number;\n  context: TContext;\n  abort(reason?: string): void;\n  defer(promise: Promise<unknown>): void;\n}\n\ninterface ChatMiddleware<TContext = unknown> {\n  name?: string;\n  onStart?: (ctx: ChatMiddlewareContext<TContext>) => void | Promise<void>;\n  onChunk?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    chunk: StreamChunk\n  ) => void | StreamChunk | StreamChunk[] | null | Promise<void | StreamChunk | StreamChunk[] | null>;\n  onBeforeToolCall?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    hookCtx: ToolCallHookContext\n  ) => BeforeToolCallDecision | Promise<BeforeToolCallDecision>;\n  onAfterToolCall?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: AfterToolCallInfo\n  ) => void | Promise<void>;\n  onFinish?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: FinishInfo\n  ) => void | Promise<void>;\n  onAbort?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: AbortInfo\n  ) => void | Promise<void>;\n  onError?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: ErrorInfo\n  ) => void | Promise<void>;\n}\n```\n\nSee [Runtime Context](../advanced/runtime-context) for the recommended context patterns.\n\n## Usage Examples\n\n```typescript\nimport { chat, summarize, generateImage, toolDefinition } from \"@tanstack/ai\";\nimport {\n  openaiText,\n  openaiSummarize,\n  openaiImage,\n} from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\n// --- Streaming chat\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n\n// --- Structured response with tools\nconst weatherTool = toolDefinition({\n  name: \"getWeather\",\n  description: \"Get the current weather for a city\",\n  inputSchema: z.object({\n    city: z.string(),\n  }),\n}).server(async ({ city }) => {\n  // Implementation that fetches weather info\n  return JSON.stringify({ temperature: 72, condition: \"Sunny\" });\n});\n\nasync function examples() {\n  // --- One-shot chat response (stream: false)\n  const { text } = await chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [{ role: \"user\", content: \"What's the capital of France?\" }],\n    stream: false, // Resolves to { text, chunks } when the run ends\n  });\n\n  // --- Structured response with outputSchema\n  const parsed = await chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [{ role: \"user\", content: \"Summarize this text in JSON with keys 'summary' and 'keywords': ... \" }],\n    outputSchema: z.object({\n      summary: z.string(),\n      keywords: z.array(z.string()),\n    }),\n  });\n\n  const toolResult = await chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [\n      { role: \"user\", content: \"What's the weather in Paris?\" }\n    ],\n    tools: [weatherTool],\n    outputSchema: z.object({\n      answer: z.string(),\n      weather: z.object({\n        temperature: z.number(),\n        condition: z.string(),\n      }),\n    }),\n  });\n\n  // --- Summarization\n  const summary = await summarize({\n    adapter: openaiSummarize(\"gpt-5.2\"),\n    text: \"Long text to summarize...\",\n    maxLength: 100,\n  });\n\n  // --- Image generation\n  const image = await generateImage({\n    adapter: openaiImage(\"dall-e-3\"),\n    prompt: \"A futuristic city skyline at sunset\",\n    numberOfImages: 1,\n    size: \"1024x1024\",\n  });\n}\n```\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Bring Your Own Key](../advanced/byok) - Read user keys on the relay\n- [Evaluate](../evaluate/evaluate) - Ask typed questions about shared state\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Adapters](../adapters/openai) - Explore adapter options\n","originalRawMarkdown":"---\ntitle: \"@tanstack/ai\"\nid: tanstack-ai-api\norder: 1\ndescription: \"API reference for @tanstack/ai, the core TanStack AI library providing chat(), decide(), generateImage(), toolDefinition(), and streaming utilities.\"\nkeywords:\n  - tanstack ai\n  - \"@tanstack/ai\"\n  - api reference\n  - chat\n  - toolDefinition\n  - generateImage\n  - decide\n  - core library\n---\n\nThe core AI library for TanStack AI.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai\nvue: @tanstack/ai\nsolid: @tanstack/ai\nsvelte: @tanstack/ai\npreact: @tanstack/ai\nangular: @tanstack/ai\nvanilla: @tanstack/ai\noctane: @tanstack/ai\n\n<!-- ::end:tabs -->\n\n## `chat(options)`\n\nCreates a streaming chat response.\n\n```typescript\nimport { chat, maxIterations } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { myTool } from \"./tools\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  tools: [myTool],\n  systemPrompts: [\"You are a helpful assistant\"],\n  agentLoopStrategy: maxIterations(20),\n});\n```\n\n### Parameters\n\n- `adapter` - An AI adapter instance with model (e.g., `openaiText('gpt-5.2')`, `anthropicText('claude-sonnet-4-5')`)\n- `messages` - Array of chat messages. Accepts mixed `UIMessage | ModelMessage` arrays — internal conversion handles AG-UI fan-out dedup, drops `reasoning`/`activity`, and collapses `developer` → `system`\n- `tools?` - Array of tools for function calling\n- `context?` - Typed runtime context passed to server tools and middleware. If a tool or middleware declares a concrete context type, `chat()` requires a compatible value here\n- `systemPrompts?` - System prompts to prepend to messages\n- `agentLoopStrategy?` - Strategy for agent loops (default: `maxIterations(5)`). Strategies receive `{ iterationCount, finishReason, messages, toolCallCount, lastTurnToolCallCount }` and run between model turns. Iterations are model turns, not tool calls — for tool-call budgets use middleware (`onBeforeToolCall` + `onShouldContinue`); see [Tool-call budgets](../chat/agentic-cycle#tool-call-budgets-middleware-recipe).\n- `middleware?` - Array of chat middleware. Use `onShouldContinue` / `onBeforeToolCall` for app-owned tool budgets.\n- `abortController?` - AbortController for cancellation\n- `modelOptions?` - Provider-native model options. This is where sampling parameters live — `temperature`, `top_p`/`topP`, and the provider's token-limit key (`max_output_tokens`, `max_tokens`, `maxOutputTokens`, …) — under each provider's canonical name, rather than as generic root-level props. See [Moving Sampling Options into modelOptions](../migration/sampling-options-to-model-options). (Renamed from `providerOptions`.)\n- `threadId?` - AG-UI thread identifier propagated into `RUN_STARTED` events for run correlation\n- `runId?` - AG-UI run identifier (auto-generated if omitted)\n- `parentRunId?` - AG-UI parent run identifier for nested runs\n- `stream?` - Set to `false` to get one result when the run ends. See [Returns](#returns).\n\n### Returns\n\nAn async iterable of `StreamChunk`.\n\nWith `stream: false`, `chat()` returns `Promise<ChatResult>`:\n\n- `text`: the full reply as one string.\n- `chunks`: every chunk the run produced, in order. This includes tool calls, tool results, reasoning, usage, and the `RUN_FINISHED` chunk with any interrupts.\n\nIf the run fails, the promise rejects with the error from `RUN_ERROR`. If you also pass `outputSchema`, the promise resolves to the parsed object.\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst { text, chunks } = await chat({\n  adapter: openaiText(\"gpt-5.6\"),\n  messages: [{ role: \"user\", content: \"What's the capital of France?\" }],\n  stream: false,\n});\n\nconsole.log(text);\n\nfor (const chunk of chunks) {\n  if (chunk.type === \"TOOL_CALL_START\") {\n    console.log(\"Tool call:\", chunk.toolCallName);\n  }\n  if (chunk.type === \"RUN_FINISHED\") {\n    console.log(\"Usage:\", chunk.usage);\n  }\n}\n```\n\nIf you already have a stream, `streamToText(stream)` reads it to the end and returns the same `ChatResult`.\n\n## `summarize(options)`\n\nCreates a text summarization.\n\n```typescript\nimport { summarize } from \"@tanstack/ai\";\nimport { openaiSummarize } from \"@tanstack/ai-openai\";\n\nconst result = await summarize({\n  adapter: openaiSummarize(\"gpt-5.2\"),\n  text: \"Long text to summarize...\",\n  maxLength: 100,\n  style: \"concise\",\n});\n```\n\n### Parameters\n\n- `adapter` - An AI adapter instance with model\n- `text` - Text to summarize\n- `maxLength?` - Maximum length of summary\n- `style?` - Summary style (\"concise\" | \"detailed\")\n- `modelOptions?` - Model-specific options\n\n### Returns\n\nA `SummarizationResult` with the summary text.\n\n## `decide(options)`\n\nAsks typed questions about a shared state and returns answers your code can\nbranch on. This call is async. There is no stream.\n\n```typescript\nimport { decide, choice, score, boolean } from \"@tanstack/ai\";\nimport { typesafeDecider } from \"@tanstack/ai-typesafe\";\n\nconst ticket = {\n  subject: \"Charged twice for the same invoice\",\n  body: \"Please refund the extra payment.\",\n};\n\nconst result = await decide({\n  adapter: typesafeDecider(\"jev-latest\"),\n  state: ticket,\n  questions: {\n    queue: choice({\n      instructions: \"Which team should handle this ticket?\",\n      options: {\n        billing: \"Payments, invoices, refunds\",\n        tech: \"Bugs, outages, integrations\",\n        sales: \"Pricing, upgrades, new accounts\",\n      },\n    }),\n    urgency: score({\n      instructions: \"How urgent is this ticket?\",\n      levels: [\"low\", \"medium\", \"high\"],\n    }),\n    refund: boolean({\n      instructions: \"Is the customer asking for a refund?\",\n    }),\n  },\n});\n\nconsole.log(result.queue.value);\nconsole.log(result.queue.probability);\nconsole.log(result.queue.confidence);\nconsole.log(result.meta.usage);\n```\n\n### Parameters (`decide`)\n\nRequired:\n\n- `adapter` - An evaluate adapter created with a model (for example `typesafeDecider('jev-latest')`)\n- `state` - Shared content every question judges. A string, an object, or an array. An array is one state, not a batch.\n- `questions` - Map of `choice`, `score`, and `boolean` questions. The key `meta` is reserved.\n\nOptional:\n\n- `abortSignal?` - Cancel the in-flight request\n- `modelOptions?` - Provider-specific options\n- `middleware?` - Observe-only generation middleware\n- `debug?` - Debug logging\n\n### Returns\n\nEach question key is a top-level answer. `meta.model` and `meta.usage` hold the resolved model id and token usage. When the adapter returns them, `meta.id` holds the provider response id and `meta.provider` names the upstream provider.\n\n- `choice`: `.value` is the selected option key. `.probability` is P(selected). `.confidence` is a number from 0 to 1. `.probabilities` is the full map.\n- `score`: `.value` is the nearest level label. `.score` is the raw fraction. `.probability` is P(that level). `.confidence` is a number from 0 to 1. `.legend` maps each level index to its label. `.probabilities` is the full map, keyed by level index.\n- `boolean`: When `.probability` is 0.5 or more, `.value` is `true`. No `.confidence`.\n\n### Helpers\n\n- `choice({ instructions, options })` - Pick one key from `options`\n- `score({ instructions, levels })` - Rate `state` on ordered `levels` (at least two)\n- `boolean({ instructions, criteria? })` - Yes or no. When P(true) is 0.5 or more, `.value` is `true`\n\nSee [Evaluate](../evaluate/evaluate) for adapters, abort, and middleware.\n\n## `toolDefinition(config)`\n\nCreates an isomorphic tool definition that can be instantiated for server or client execution.\n\n```typescript\nimport { chat, toolDefinition } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\nconst myToolDef = toolDefinition({\n  name: \"my_tool\",\n  description: \"Tool description\",\n  inputSchema: z.object({\n    param: z.string(),\n  }),\n  outputSchema: z.object({\n    result: z.string(),\n  }),\n  needsApproval: false, // Optional\n});\n\n// Or create client implementation\nconst myClientTool = myToolDef.client(async ({ param }) => {\n  // Client-side implementation\n  return { result: \"...\" };\n});\n\n// Use directly in chat() (server-side, no execute)\nchat({\n  adapter: openaiText(\"gpt-5.2\"),\n  tools: [myToolDef],\n  messages: [{ role: \"user\", content: \"...\" }],\n});\n\n// Or create server implementation\nconst myServerTool = myToolDef.server(async ({ param }) => {\n  // Server-side implementation\n  return { result: \"...\" };\n});\n\n// Use directly in chat() (server-side, no execute)\nchat({\n  adapter: openaiText(\"gpt-5.2\"),\n  tools: [myServerTool],\n  messages: [{ role: \"user\", content: \"...\" }],\n});\n```\n\nTools can declare typed runtime context for request-scoped dependencies:\n\n```typescript\nimport { chat, toolDefinition, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { session, db } from \"./app\";\n\ntype AppContext = {\n  userId: string;\n  db: { users: { findName(id: string): Promise<string> } };\n};\n\nconst currentUser = toolDefinition({\n  name: \"current_user\",\n  description: \"Get the current user\",\n}).server<AppContext>(async (_input: unknown, ctx) => {\n  return { name: await ctx.context.db.users.findName(ctx.context.userId) };\n});\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages,\n    tools: [currentUser],\n    context: { userId: session.user.id, db },\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\n### Parameters\n\n- `name` - Tool name (must be unique)\n- `description` - Tool description for the model\n- `inputSchema` - Zod schema for input validation\n- `outputSchema?` - Zod schema for output validation\n- `needsApproval?` - Whether tool requires user approval\n- `metadata?` - Additional metadata\n\n### Returns\n\nA `ToolDefinition` object with `.server()` and `.client()` methods for creating concrete implementations.\n\n## `toServerSentEventsStream(stream, abortController?)`\n\nConverts a stream to a ReadableStream in Server-Sent Events format.\n\n```typescript\nimport { chat, toServerSentEventsStream } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\nconst readableStream = toServerSentEventsStream(stream);\n```\n\n### Parameters\n\n- `stream` - Async iterable of `StreamChunk`\n- `abortController?` - Optional AbortController to abort when stream is cancelled\n\n### Returns\n\nA `ReadableStream<Uint8Array>` in Server-Sent Events format. Each chunk is:\n- Prefixed with `\"data: \"`\n- Followed by `\"\\n\\n\"`\n- Stream ends with `\"data: [DONE]\\n\\n\"`\n\n## `toServerSentEventsResponse(stream, init?)`\n\nConverts a stream to an HTTP Response with proper SSE headers.\n\n```typescript\nimport { chat, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nasync function POST() {\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [{ role: \"user\", content: \"Hello!\" }],\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\n### Parameters\n\n- `stream` - Async iterable of `StreamChunk`\n- `init?` - Optional ResponseInit options (including `abortController`)\n\n### Returns\n\nA `Response` object suitable for HTTP endpoints with SSE headers (`Content-Type: text/event-stream`, `Cache-Control: no-cache`, `Connection: keep-alive`).\n\n## `chatParamsFromRequest(req)`\n\nReads an HTTP `Request`, parses its JSON body, and validates it against AG-UI `RunAgentInputSchema`. Returns parsed chat parameters ready to spread into `chat()`. On a malformed body, **throws a 400 `Response`** that frameworks like TanStack Start, SolidStart, Remix, and React Router 7 return to the client automatically.\n\n```typescript\nimport { chat, chatParamsFromRequest, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { serverTools } from \"./tools\";\n\nexport async function POST(req: Request) {\n  const params = await chatParamsFromRequest(req);\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages: params.messages,\n    tools: serverTools,\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\n### Parameters\n\n- `req` - An incoming `Request` whose JSON body conforms to AG-UI `RunAgentInput`\n\n### Returns\n\nA promise resolving to `{ messages, threadId, runId, parentRunId?, tools, forwardedProps, state, aguiContext, context }`.\n\nThe returned `aguiContext` is the AG-UI protocol `RunAgentInput.context` field. It is not the same as TanStack AI runtime `chat({ context })`; validate and map it explicitly if you want those values available to tools or middleware.\n\nThe returned `context` field is a deprecated alias of `aguiContext` kept for backward compatibility. Prefer `aguiContext` in new code.\n\n> **Framework note.** Next.js Route Handlers, SvelteKit, Hono, and raw Node do not auto-handle thrown `Response` objects. In those, wrap with try/catch or use `chatParamsFromRequestBody(await req.json())` directly.\n\n## `chatParamsFromRequestBody(body)`\n\nLower-level variant of `chatParamsFromRequest` that validates an already-parsed body. Rejects with an `AGUIError` on malformed input. Use this when you need explicit error handling control.\n\n```typescript\nimport { chatParamsFromRequestBody } from \"@tanstack/ai\";\n\nasync function handler(req: Request): Promise<Response> {\n  const body = await req.json();\n  try {\n    const params = await chatParamsFromRequestBody(body);\n    // ...\n    return new Response(\"ok\");\n  } catch (error) {\n    const message = error instanceof Error ? error.message : String(error);\n    return new Response(message, { status: 400 });\n  }\n}\n```\n\n## `mergeAgentTools(serverTools, clientTools)`\n\nMerges a server-side tool registry with the AG-UI client-declared tools received in the request payload. Server tools win on name collision; client-only tools become no-execute stubs that the runtime dispatches via `ClientToolRequest` events.\n\n```typescript\nimport { chat, chatParamsFromRequest, mergeAgentTools } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { serverTools } from \"./tools\";\n\nasync function handler(req: Request) {\n  const params = await chatParamsFromRequest(req);\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages: params.messages,\n    tools: mergeAgentTools(serverTools, params.tools),\n  });\n}\n```\n\n### Parameters\n\n- `serverTools` - The server's `toolDefinition().server(...)` registry, keyed by tool name\n- `clientTools` - The `tools` array from `chatParamsFromRequest`'s return value\n\n### Returns\n\nA merged tool record suitable for `chat({ tools })`.\n\n## `maxIterations(count)`\n\nCreates an agent loop strategy that limits **model turns** (iterations), not tool calls. One turn can still emit many parallel tool calls — use middleware for tool-call budgets ([recipe](../chat/agentic-cycle#tool-call-budgets-middleware-recipe)).\n\n```typescript\nimport { chat, maxIterations } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n  agentLoopStrategy: maxIterations(20),\n});\n```\n\n### Parameters\n\n- `count` - Maximum number of model turns\n\n### Returns\n\nAn `AgentLoopStrategy` function.\n\n## `defineByokProvider({ id, label, env?, with? })`\n\nDeclare a BYOK provider from an adapter package. `id` is the `x-byok-<id>` slug and is **required** — an optional or missing `id` does not type-check.\n\n```typescript\nimport { defineByokProvider } from \"@tanstack/ai/byok\";\n\nexport const openaiByok = defineByokProvider({\n  id: \"openai\",\n  label: \"OpenAI\",\n  env: \"OPENAI_API_KEY\",\n});\n```\n\nImport the object from the adapter `/byok` subpath (`openaiByok` from `@tanstack/ai-openai/byok`). Pass it to `getByokKey` on the relay. Do not import it from the adapter main entry. That pulls in the provider SDK. Import `getByokKey` from `@tanstack/ai/byok/server`. That entry is the only BYOK module that reads `process.env`.\n\n### Parameters\n\n- `id` - Required slug (`[a-z][a-z0-9-]{0,63}`)\n- `label` - Display name\n- `env?` - Env var **name**, or a list of names tried in order. A string is stored as a one-element array. Names only — this object is imported on the client, so do not put `process.env` values here\n- `with?` - Other descriptors this credential needs, for example an account id next to a token. A store created with `defineByok({ providers })` sends their headers and prompts for them together with this one. Read them on the relay with `getByokKeys`\n\n### Returns\n\nA `{ id, label, env?, with? }` object. `id` is the literal slug type.\n\n## `getByokKey(request, provider)`\n\nRead a key on the relay. Import from `@tanstack/ai/byok/server` so `process.env` is not in the client graph. Works in any API route — it is not a TanStack Start server function.\n\nThe header wins. A `ByokProvider` then tries `provider.env` in order. A slug is header-only. Returns `null` when both are empty. The JSON body is ignored.\n\n```typescript\nimport { getByokKey } from \"@tanstack/ai/byok/server\";\nimport { openaiByok } from \"@tanstack/ai-openai/byok\";\n\nexport async function POST(request: Request) {\n  const apiKey = getByokKey(request, openaiByok);\n  return new Response(apiKey ? \"ok\" : \"missing\");\n}\n```\n\n### Parameters\n\n- `request` - Incoming `Request`\n- `provider` - A `ByokProvider` or a provider slug (`[a-z][a-z0-9-]{0,63}`). Becomes the `x-byok-<slug>` header. Not a fixed catalog.\n\n### Returns\n\n`string | null`\n\n## `getByokKeys(request, providers)`\n\nRead several keys at once. Each entry obeys the same rules as `getByokKey`. Use it when one credential is made of more than one value.\n\n```typescript\nimport { byokMissing, getByokKeys } from \"@tanstack/ai/byok/server\";\nimport {\n  cloudflareAccountByok,\n  cloudflareByok,\n} from \"@tanstack/ai-cloudflare/byok\";\n\nexport async function POST(request: Request) {\n  const { apiKey, accountId } = getByokKeys(request, {\n    apiKey: cloudflareByok,\n    accountId: cloudflareAccountByok,\n  });\n  if (!apiKey) return byokMissing(cloudflareByok);\n  if (!accountId) return byokMissing(cloudflareAccountByok);\n  return new Response(\"ok\");\n}\n```\n\n### Parameters\n\n- `request` - Incoming `Request`\n- `providers` - An object whose values are a `ByokProvider` or a provider slug. The keys name the result.\n\n### Returns\n\nAn object with the same keys, each `string | null`.\n\n## `byokMissing(provider)`\n\nReturn a `401` JSON `Response` with `{ error: { type: \"byok_missing\", provider, message } }`. The chat and generation clients read this body and set `snapshot.prompt`. Import from `@tanstack/ai/byok` or `@tanstack/ai/byok/server`.\n\n```typescript\nimport { byokMissing, getByokKey } from \"@tanstack/ai/byok/server\";\nimport { openaiByok } from \"@tanstack/ai-openai/byok\";\n\nexport async function POST(request: Request) {\n  const apiKey = getByokKey(request, openaiByok);\n  if (!apiKey) return byokMissing(openaiByok);\n  return new Response(\"ok\");\n}\n```\n\n### Parameters\n\n- `provider` - A `ByokProvider` or a provider slug to put on the error body\n\n### Returns\n\nA `Response` with status `401` and `content-type: application/json`.\n\n## `maskKey(key)`\n\nReturn the last four characters of a key. Keys of four characters or fewer become `\"••\"`.\n\n```typescript\nimport { maskKey } from \"@tanstack/ai/byok\";\n\nmaskKey(\"sk-abcdefghij\"); // \"ghij\"\n```\n\n## `scrubSecrets(input, secrets)`\n\nReplace each listed secret in `input` with `[redacted]`. Use this before you log an error string.\n\n```typescript\nimport { scrubSecrets } from \"@tanstack/ai/byok\";\n\nscrubSecrets(\"failed sk-live extra\", [\"sk-live\"]);\n// \"failed [redacted] extra\"\n```\n\nSee [Bring Your Own Key](../advanced/byok) for the client store and a full relay.\n\n## Types\n\n### `ModelMessage`\n\n```typescript\nimport type {\n  ContentPart,\n  StructuredOutputPart,\n  ToolCall,\n} from \"@tanstack/ai\";\n\ninterface ModelMessage<\n  TContent extends string | null | ContentPart[] =\n    | string\n    | null\n    | ContentPart[],\n> {\n  role: \"user\" | \"assistant\" | \"tool\";\n  content: TContent;\n  name?: string;\n  toolCalls?: ToolCall[];\n  toolCallId?: string;\n  thinking?: Array<{ content: string; signature?: string }>;\n  structuredOutput?: StructuredOutputPart;\n  id?: string;\n  createdAt?: Date;\n}\n```\n\n### `StreamChunk`\n\n```typescript ignore\ntype StreamChunk =\n  | ContentStreamChunk\n  | ThinkingStreamChunk\n  | ToolCallStreamChunk\n  | ToolResultStreamChunk\n  | DoneStreamChunk\n  | ErrorStreamChunk;\n\ninterface ThinkingStreamChunk {\n  type: \"thinking\";\n  id: string;\n  model: string;\n  timestamp: number;\n  delta?: string; // Incremental thinking token\n  content: string; // Accumulated thinking content\n}\n```\n\nStream chunks represent different types of data in the stream:\n\n- **Content chunks** - Text content being generated\n- **Thinking chunks** - Model's reasoning process (when supported by the model)\n- **Tool call chunks** - When the model calls a tool\n- **Tool result chunks** - Results from tool execution\n- **Done chunks** - Stream completion\n- **Error chunks** - Stream errors\n\n### `Tool`\n\n```typescript\nimport type { SchemaInput, ToolExecutionContext } from \"@tanstack/ai\";\n\ninterface Tool<TContext = unknown> {\n  name: string;\n  description: string;\n  inputSchema?: SchemaInput;\n  outputSchema?: SchemaInput;\n  execute?: (\n    args: any,\n    context?: ToolExecutionContext<TContext>\n  ) => Promise<any> | any;\n  needsApproval?: boolean;\n  lazy?: boolean;\n  metadata?: Record<string, any>;\n}\n```\n\n### `ToolExecutionContext<TContext>`\n\n```typescript ignore\ntype ToolExecutionContext<TContext = unknown> = {\n  toolCallId?: string;\n  emitCustomEvent: (\n    eventName: string,\n    value: Record<string, any>,\n    options?: { batch?: boolean },\n  ) => void;\n} & (unknown extends TContext ? { context?: TContext } : { context: TContext });\n```\n\n`context` is the runtime value from `chat({ context })` for server tools, or from `ChatClient` / framework hook options for client tools. It is required when a tool declares a concrete `TContext` and optional for untyped tools where the context type is `unknown`.\n\n### `ChatMiddleware<TContext>`\n\n```typescript\nimport type {\n  StreamChunk,\n  ChatMiddlewarePhase,\n  ToolCallHookContext,\n  BeforeToolCallDecision,\n  AfterToolCallInfo,\n  FinishInfo,\n  AbortInfo,\n  ErrorInfo,\n} from \"@tanstack/ai\";\n\ninterface ChatMiddlewareContext<TContext = unknown> {\n  requestId: string;\n  streamId: string;\n  threadId: string;\n  phase: ChatMiddlewarePhase;\n  iteration: number;\n  context: TContext;\n  abort(reason?: string): void;\n  defer(promise: Promise<unknown>): void;\n}\n\ninterface ChatMiddleware<TContext = unknown> {\n  name?: string;\n  onStart?: (ctx: ChatMiddlewareContext<TContext>) => void | Promise<void>;\n  onChunk?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    chunk: StreamChunk\n  ) => void | StreamChunk | StreamChunk[] | null | Promise<void | StreamChunk | StreamChunk[] | null>;\n  onBeforeToolCall?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    hookCtx: ToolCallHookContext\n  ) => BeforeToolCallDecision | Promise<BeforeToolCallDecision>;\n  onAfterToolCall?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: AfterToolCallInfo\n  ) => void | Promise<void>;\n  onFinish?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: FinishInfo\n  ) => void | Promise<void>;\n  onAbort?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: AbortInfo\n  ) => void | Promise<void>;\n  onError?: (\n    ctx: ChatMiddlewareContext<TContext>,\n    info: ErrorInfo\n  ) => void | Promise<void>;\n}\n```\n\nSee [Runtime Context](../advanced/runtime-context) for the recommended context patterns.\n\n## Usage Examples\n\n```typescript\nimport { chat, summarize, generateImage, toolDefinition } from \"@tanstack/ai\";\nimport {\n  openaiText,\n  openaiSummarize,\n  openaiImage,\n} from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\n// --- Streaming chat\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.2\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n\n// --- Structured response with tools\nconst weatherTool = toolDefinition({\n  name: \"getWeather\",\n  description: \"Get the current weather for a city\",\n  inputSchema: z.object({\n    city: z.string(),\n  }),\n}).server(async ({ city }) => {\n  // Implementation that fetches weather info\n  return JSON.stringify({ temperature: 72, condition: \"Sunny\" });\n});\n\nasync function examples() {\n  // --- One-shot chat response (stream: false)\n  const { text } = await chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [{ role: \"user\", content: \"What's the capital of France?\" }],\n    stream: false, // Resolves to { text, chunks } when the run ends\n  });\n\n  // --- Structured response with outputSchema\n  const parsed = await chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [{ role: \"user\", content: \"Summarize this text in JSON with keys 'summary' and 'keywords': ... \" }],\n    outputSchema: z.object({\n      summary: z.string(),\n      keywords: z.array(z.string()),\n    }),\n  });\n\n  const toolResult = await chat({\n    adapter: openaiText(\"gpt-5.2\"),\n    messages: [\n      { role: \"user\", content: \"What's the weather in Paris?\" }\n    ],\n    tools: [weatherTool],\n    outputSchema: z.object({\n      answer: z.string(),\n      weather: z.object({\n        temperature: z.number(),\n        condition: z.string(),\n      }),\n    }),\n  });\n\n  // --- Summarization\n  const summary = await summarize({\n    adapter: openaiSummarize(\"gpt-5.2\"),\n    text: \"Long text to summarize...\",\n    maxLength: 100,\n  });\n\n  // --- Image generation\n  const image = await generateImage({\n    adapter: openaiImage(\"dall-e-3\"),\n    prompt: \"A futuristic city skyline at sunset\",\n    numberOfImages: 1,\n    size: \"1024x1024\",\n  });\n}\n```\n\n## Next Steps\n\n- [Getting Started](../getting-started/quick-start) - Learn the basics\n- [Bring Your Own Key](../advanced/byok) - Read user keys on the relay\n- [Evaluate](../evaluate/evaluate) - Ask typed questions about shared state\n- [Tools Guide](../tools/tools) - Learn about tools\n- [Adapters](../adapters/openai) - Explore adapter options\n"}
