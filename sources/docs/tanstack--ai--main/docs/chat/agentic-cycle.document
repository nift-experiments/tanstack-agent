{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The agentic cycle is the pattern where the LLM repeatedly calls tools, receives results, and continues reasoning until it can provide a final answer. This enables complex multi-step operations."}]},{"type":"paragraph","children":[{"type":"text","value":"To send a turn to a named child agent, see "},{"type":"link","href":"./subagents","children":[{"type":"text","value":"Subagents"}]},{"type":"text","value":"."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Tip:"}]},{"type":"text","value":" Code Mode can reduce agent loop iterations by letting the LLM write a program that calls multiple tools in a single execution. See "},{"type":"link","href":"../code-mode/code-mode","children":[{"type":"text","value":"Code Mode"}]},{"type":"text","value":"."}]}]},{"type":"code","value":"graph TD\n    A[User sends message] --> B[LLM analyzes request]\n    B --> C{Does task need tools?}\n    C -->|No| D[Generate text response]\n    C -->|Yes| E[Call appropriate tool]\n    E --> F{Where does<br/>tool execute?}\n    F -->|Server| G[Execute on server]\n    F -->|Client| H[Execute on client]\n    G --> I[Tool returns result]\n    H --> I\n    I --> J[Add result to conversation]\n    J --> K[LLM analyzes result]\n    K --> L{Task complete?}\n    L -->|No| E\n    L -->|Yes| D\n    D --> M[Stream response to user]\n    M --> N[Done]\n    \n    style E fill:#e1f5ff\n    style G fill:#ffe1e1\n    style H fill:#ffe1e1\n    style L fill:#fff4e1","lang":"mermaid"},{"type":"heading","depth":3,"id":"detailed-agentic-flow","children":[{"type":"text","value":"Detailed Agentic Flow"}]},{"type":"code","value":"sequenceDiagram\n    participant User\n    participant Client\n    participant Server\n    participant LLM\n    participant Tools\n    \n    User->>Client: \"What's the weather in SF and LA?\"\n    Client->>Server: Send message\n    Server->>LLM: Message + tool definitions\n    \n    Note over LLM: Cycle 1: Call first tool\n    \n    LLM->>Server: tool_call: get_weather(SF)\n    Server->>Tools: Execute get_weather\n    Tools-->>Server: {temp: 65, conditions: \"sunny\"}\n    Server->>LLM: tool_result\n    \n    Note over LLM: Cycle 2: Call second tool\n    \n    LLM->>Server: tool_call: get_weather(LA)\n    Server->>Tools: Execute get_weather\n    Tools-->>Server: {temp: 75, conditions: \"clear\"}\n    Server->>LLM: tool_result\n    \n    Note over LLM: Cycle 3: Generate answer\n    \n    LLM-->>Server: content: \"SF is 65°F...\"\n    Server-->>Client: Stream response\n    Client->>User: Display answer","lang":"mermaid"},{"type":"heading","depth":3,"id":"multi-step-example","children":[{"type":"text","value":"Multi-Step Example"}]},{"type":"paragraph","children":[{"type":"text","value":"Here's a real-world example of the agentic cycle:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"User"}]},{"type":"text","value":": \"Find me flights to Paris under $500 and book the cheapest one\""}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Cycle 1"}]},{"type":"text","value":": LLM calls "},{"type":"inlineCode","value":"searchFlights({destination: \"Paris\", maxPrice: 500})"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Tool returns: "},{"type":"inlineCode","value":"[{id: \"F1\", price: 450}, {id: \"F2\", price: 480}]"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Cycle 2"}]},{"type":"text","value":": LLM analyzes results and calls "},{"type":"inlineCode","value":"bookFlight({flightId: \"F1\"})"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Tool requires approval (sensitive operation) — see "},{"type":"link","href":"../tools/tool-approval","children":[{"type":"text","value":"Tool Approval"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"User approves"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Tool returns: "},{"type":"inlineCode","value":"{bookingId: \"B123\", confirmed: true}"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Cycle 3"}]},{"type":"text","value":": LLM generates final response"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"\"I found 2 flights under $500. I've booked the cheapest one (Flight F1) for $450. Your booking ID is B123.\""}]}]}]},{"type":"heading","depth":3,"id":"code-example-agentic-weather-assistant","children":[{"type":"text","value":"Code Example: Agentic Weather Assistant"}]},{"type":"code","value":"import { chat, toolDefinition, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\n// Tool definitions\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get current weather for a city\",\n  inputSchema: z.object({\n    city: z.string(),\n  }),\n});\n\nconst getClothingAdviceDef = toolDefinition({\n  name: \"get_clothing_advice\",\n  description: \"Get clothing recommendations based on weather\",\n  inputSchema: z.object({\n    temperature: z.number(),\n    conditions: z.string(),\n  }),\n});\n\n// Server implementations\nconst getWeather = getWeatherDef.server(async ({ city }) => {\n  const response = await fetch(`https://api.weather.com/v1/${city}`);\n  return await response.json();\n});\n\nconst getClothingAdvice = getClothingAdviceDef.server(async ({ temperature, conditions }) => {\n  // Business logic for clothing recommendations\n  if (temperature < 50) {\n    return { recommendation: \"Wear a warm jacket\" };\n  }\n  return { recommendation: \"Light clothing is fine\" };\n});\n\n// Server route\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages,\n    tools: [getWeather, getClothingAdvice],\n  });\n\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"User"}]},{"type":"text","value":": \"What should I wear in San Francisco today?\""}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Agentic Cycle"}]},{"type":"text","value":":"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"LLM calls "},{"type":"inlineCode","value":"get_weather({city: \"San Francisco\"})"},{"type":"text","value":" → Returns "},{"type":"inlineCode","value":"{temp: 62, conditions: \"cloudy\"}"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"LLM calls "},{"type":"inlineCode","value":"get_clothing_advice({temperature: 62, conditions: \"cloudy\"})"},{"type":"text","value":" → Returns "},{"type":"inlineCode","value":"{recommendation: \"Light jacket recommended\"}"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"LLM generates: \"The weather in San Francisco is 62°F and cloudy. I recommend wearing a light jacket.\""}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The loop continues only while the model's finish reason is "},{"type":"inlineCode","value":"tool_calls"},{"type":"text","value":" (with pending tool calls) "},{"type":"strong","children":[{"type":"text","value":"and"}]},{"type":"text","value":" the agent loop strategy permits another iteration; it ends as soon as the model returns a normal "},{"type":"inlineCode","value":"stop"},{"type":"text","value":" finish reason."}]},{"type":"heading","depth":3,"id":"controlling-the-loop","children":[{"type":"text","value":"Controlling the loop"}]},{"type":"paragraph","children":[{"type":"text","value":"By default the loop is bounded by "},{"type":"inlineCode","value":"maxIterations(5)"},{"type":"text","value":" — after five "},{"type":"strong","children":[{"type":"text","value":"model turns"}]},{"type":"text","value":" it stops even if the model would keep calling tools. Override this with the "},{"type":"inlineCode","value":"agentLoopStrategy"},{"type":"text","value":" option."}]},{"type":"paragraph","children":[{"type":"text","value":"Other built-in strategies:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"untilFinishReason([...])"}]},{"type":"text","value":" — continue until the model returns one of the given finish reasons (e.g. "},{"type":"inlineCode","value":"untilFinishReason([\"stop\", \"length\"])"},{"type":"text","value":")."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"combineStrategies([...])"}]},{"type":"text","value":" — combine multiple strategies with AND logic; the loop continues only while every strategy agrees."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"A strategy is just a function that receives "},{"type":"inlineCode","value":"{ iterationCount, finishReason, messages, toolCallCount, lastTurnToolCallCount }"},{"type":"text","value":" and returns "},{"type":"inlineCode","value":"true"},{"type":"text","value":" to allow another iteration or "},{"type":"inlineCode","value":"false"},{"type":"text","value":" to stop, so you can also write your own:"}]},{"type":"code","value":"import { chat, combineStrategies, maxIterations, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport type { AgentLoopState } from \"@tanstack/ai\";\nimport { getWeather, getClothingAdvice } from \"./tools\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages,\n    tools: [getWeather, getClothingAdvice],\n    agentLoopStrategy: combineStrategies([\n      maxIterations(10),\n      ({ messages }: AgentLoopState) => messages.length < 100,\n    ]),\n  });\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"tool-call-budgets-middleware-recipe","children":[{"type":"text","value":"Tool-call budgets (middleware recipe)"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Iterations ≠ tool calls."}]},{"type":"text","value":" One model turn can emit many parallel tool calls. "},{"type":"inlineCode","value":"maxIterations"},{"type":"text","value":" only bounds "},{"type":"strong","children":[{"type":"text","value":"model turns"}]},{"type":"text","value":". Strategies run "},{"type":"emphasis","children":[{"type":"text","value":"between"}]},{"type":"text","value":" turns, so without a per-turn cap a single runaway turn can still fan out unbounded."}]}]},{"type":"paragraph","children":[{"type":"text","value":"There is no built-in "},{"type":"inlineCode","value":"maxToolCalls"},{"type":"text","value":" strategy. Cap tools with middleware:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"onBeforeToolCall"}]},{"type":"text","value":" — skip excess calls inside one turn ("},{"type":"inlineCode","value":"maxPerTurn"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"onShouldContinue"}]},{"type":"text","value":" — stop further turns once cumulative "},{"type":"strong","children":[{"type":"text","value":"emitted"}]},{"type":"text","value":" tools hit a budget ("},{"type":"inlineCode","value":"max"},{"type":"text","value":"); skipped calls still count toward "},{"type":"inlineCode","value":"toolCallCount"}]}]}]},{"type":"code","value":"import {\n  chat,\n  maxIterations,\n  toServerSentEventsResponse,\n  type ChatMiddleware,\n} from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { getWeather, getClothingAdvice } from \"./tools\";\n\n/** App-owned policy — not a library export. */\nfunction toolCallBudget(options: {\n  max?: number;\n  maxPerTurn?: number;\n}): ChatMiddleware {\n  const { max, maxPerTurn } = options;\n  let perTurn = 0;\n\n  return {\n    name: \"tool-call-budget\",\n    onIteration() {\n      perTurn = 0;\n    },\n    // Fresh per-turn budget for pending/resume batches (no onIteration).\n    onToolPhaseComplete() {\n      perTurn = 0;\n    },\n    onBeforeToolCall() {\n      if (maxPerTurn == null) return undefined;\n      perTurn += 1;\n      if (perTurn > maxPerTurn) {\n        return {\n          type: \"skip\",\n          result: {\n            error: `Skipped: exceeded maxToolCallsPerTurn (${maxPerTurn})`,\n          },\n        };\n      }\n      return undefined;\n    },\n    onShouldContinue(_ctx, state) {\n      if (max != null && state.toolCallCount >= max) return false;\n      return undefined;\n    },\n  };\n}\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages,\n    tools: [getWeather, getClothingAdvice],\n    agentLoopStrategy: maxIterations(20), // model turns\n    middleware: [\n      toolCallBudget({\n        maxPerTurn: 10, // cap parallel fan-out inside one turn\n        max: 20, // stop further turns once cumulative emitted tools hit 20\n      }),\n    ],\n  });\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Place this "},{"type":"strong","children":[{"type":"text","value":"before"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"toolCacheMiddleware"},{"type":"text","value":" so over-budget skips win over cache hits. See "},{"type":"link","href":"../advanced/middleware#onshouldcontinue","children":[{"type":"inlineCode","value":"onShouldContinue"}]},{"type":"text","value":" for the hook contract."}]}],"headings":[{"id":"detailed-agentic-flow","text":"Detailed Agentic Flow","level":3},{"id":"multi-step-example","text":"Multi-Step Example","level":3},{"id":"code-example-agentic-weather-assistant","text":"Code Example: Agentic Weather Assistant","level":3},{"id":"controlling-the-loop","text":"Controlling the loop","level":3},{"id":"tool-call-budgets-middleware-recipe","text":"Tool-call budgets (middleware recipe)","level":3}]},"frameworks":[],"downloadMarkdown":"\nThe agentic cycle is the pattern where the LLM repeatedly calls tools, receives results, and continues reasoning until it can provide a final answer. This enables complex multi-step operations.\n\nTo send a turn to a named child agent, see [Subagents](./subagents).\n\n> **Tip:** Code Mode can reduce agent loop iterations by letting the LLM write a program that calls multiple tools in a single execution. See [Code Mode](../code-mode/code-mode).\n\n```mermaid\ngraph TD\n    A[User sends message] --> B[LLM analyzes request]\n    B --> C{Does task need tools?}\n    C -->|No| D[Generate text response]\n    C -->|Yes| E[Call appropriate tool]\n    E --> F{Where does<br/>tool execute?}\n    F -->|Server| G[Execute on server]\n    F -->|Client| H[Execute on client]\n    G --> I[Tool returns result]\n    H --> I\n    I --> J[Add result to conversation]\n    J --> K[LLM analyzes result]\n    K --> L{Task complete?}\n    L -->|No| E\n    L -->|Yes| D\n    D --> M[Stream response to user]\n    M --> N[Done]\n    \n    style E fill:#e1f5ff\n    style G fill:#ffe1e1\n    style H fill:#ffe1e1\n    style L fill:#fff4e1\n```\n\n### Detailed Agentic Flow\n\n```mermaid\nsequenceDiagram\n    participant User\n    participant Client\n    participant Server\n    participant LLM\n    participant Tools\n    \n    User->>Client: \"What's the weather in SF and LA?\"\n    Client->>Server: Send message\n    Server->>LLM: Message + tool definitions\n    \n    Note over LLM: Cycle 1: Call first tool\n    \n    LLM->>Server: tool_call: get_weather(SF)\n    Server->>Tools: Execute get_weather\n    Tools-->>Server: {temp: 65, conditions: \"sunny\"}\n    Server->>LLM: tool_result\n    \n    Note over LLM: Cycle 2: Call second tool\n    \n    LLM->>Server: tool_call: get_weather(LA)\n    Server->>Tools: Execute get_weather\n    Tools-->>Server: {temp: 75, conditions: \"clear\"}\n    Server->>LLM: tool_result\n    \n    Note over LLM: Cycle 3: Generate answer\n    \n    LLM-->>Server: content: \"SF is 65°F...\"\n    Server-->>Client: Stream response\n    Client->>User: Display answer\n```\n\n### Multi-Step Example\n\nHere's a real-world example of the agentic cycle:\n\n**User**: \"Find me flights to Paris under $500 and book the cheapest one\"\n\n**Cycle 1**: LLM calls `searchFlights({destination: \"Paris\", maxPrice: 500})`\n- Tool returns: `[{id: \"F1\", price: 450}, {id: \"F2\", price: 480}]`\n\n**Cycle 2**: LLM analyzes results and calls `bookFlight({flightId: \"F1\"})`\n- Tool requires approval (sensitive operation) — see [Tool Approval](../tools/tool-approval)\n- User approves\n- Tool returns: `{bookingId: \"B123\", confirmed: true}`\n\n**Cycle 3**: LLM generates final response\n- \"I found 2 flights under $500. I've booked the cheapest one (Flight F1) for $450. Your booking ID is B123.\"\n\n### Code Example: Agentic Weather Assistant\n\n```typescript\nimport { chat, toolDefinition, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\n// Tool definitions\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get current weather for a city\",\n  inputSchema: z.object({\n    city: z.string(),\n  }),\n});\n\nconst getClothingAdviceDef = toolDefinition({\n  name: \"get_clothing_advice\",\n  description: \"Get clothing recommendations based on weather\",\n  inputSchema: z.object({\n    temperature: z.number(),\n    conditions: z.string(),\n  }),\n});\n\n// Server implementations\nconst getWeather = getWeatherDef.server(async ({ city }) => {\n  const response = await fetch(`https://api.weather.com/v1/${city}`);\n  return await response.json();\n});\n\nconst getClothingAdvice = getClothingAdviceDef.server(async ({ temperature, conditions }) => {\n  // Business logic for clothing recommendations\n  if (temperature < 50) {\n    return { recommendation: \"Wear a warm jacket\" };\n  }\n  return { recommendation: \"Light clothing is fine\" };\n});\n\n// Server route\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages,\n    tools: [getWeather, getClothingAdvice],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n**User**: \"What should I wear in San Francisco today?\"\n\n**Agentic Cycle**:\n1. LLM calls `get_weather({city: \"San Francisco\"})` → Returns `{temp: 62, conditions: \"cloudy\"}`\n2. LLM calls `get_clothing_advice({temperature: 62, conditions: \"cloudy\"})` → Returns `{recommendation: \"Light jacket recommended\"}`\n3. LLM generates: \"The weather in San Francisco is 62°F and cloudy. I recommend wearing a light jacket.\"\n\nThe loop continues only while the model's finish reason is `tool_calls` (with pending tool calls) **and** the agent loop strategy permits another iteration; it ends as soon as the model returns a normal `stop` finish reason.\n\n### Controlling the loop\n\nBy default the loop is bounded by `maxIterations(5)` — after five **model turns** it stops even if the model would keep calling tools. Override this with the `agentLoopStrategy` option.\n\nOther built-in strategies:\n\n- **`untilFinishReason([...])`** — continue until the model returns one of the given finish reasons (e.g. `untilFinishReason([\"stop\", \"length\"])`).\n- **`combineStrategies([...])`** — combine multiple strategies with AND logic; the loop continues only while every strategy agrees.\n\nA strategy is just a function that receives `{ iterationCount, finishReason, messages, toolCallCount, lastTurnToolCallCount }` and returns `true` to allow another iteration or `false` to stop, so you can also write your own:\n\n```typescript\nimport { chat, combineStrategies, maxIterations, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport type { AgentLoopState } from \"@tanstack/ai\";\nimport { getWeather, getClothingAdvice } from \"./tools\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages,\n    tools: [getWeather, getClothingAdvice],\n    agentLoopStrategy: combineStrategies([\n      maxIterations(10),\n      ({ messages }: AgentLoopState) => messages.length < 100,\n    ]),\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\n### Tool-call budgets (middleware recipe)\n\n> **Iterations ≠ tool calls.** One model turn can emit many parallel tool calls. `maxIterations` only bounds **model turns**. Strategies run *between* turns, so without a per-turn cap a single runaway turn can still fan out unbounded.\n\nThere is no built-in `maxToolCalls` strategy. Cap tools with middleware:\n\n- **`onBeforeToolCall`** — skip excess calls inside one turn (`maxPerTurn`)\n- **`onShouldContinue`** — stop further turns once cumulative **emitted** tools hit a budget (`max`); skipped calls still count toward `toolCallCount`\n\n```typescript\nimport {\n  chat,\n  maxIterations,\n  toServerSentEventsResponse,\n  type ChatMiddleware,\n} from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { getWeather, getClothingAdvice } from \"./tools\";\n\n/** App-owned policy — not a library export. */\nfunction toolCallBudget(options: {\n  max?: number;\n  maxPerTurn?: number;\n}): ChatMiddleware {\n  const { max, maxPerTurn } = options;\n  let perTurn = 0;\n\n  return {\n    name: \"tool-call-budget\",\n    onIteration() {\n      perTurn = 0;\n    },\n    // Fresh per-turn budget for pending/resume batches (no onIteration).\n    onToolPhaseComplete() {\n      perTurn = 0;\n    },\n    onBeforeToolCall() {\n      if (maxPerTurn == null) return undefined;\n      perTurn += 1;\n      if (perTurn > maxPerTurn) {\n        return {\n          type: \"skip\",\n          result: {\n            error: `Skipped: exceeded maxToolCallsPerTurn (${maxPerTurn})`,\n          },\n        };\n      }\n      return undefined;\n    },\n    onShouldContinue(_ctx, state) {\n      if (max != null && state.toolCallCount >= max) return false;\n      return undefined;\n    },\n  };\n}\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages,\n    tools: [getWeather, getClothingAdvice],\n    agentLoopStrategy: maxIterations(20), // model turns\n    middleware: [\n      toolCallBudget({\n        maxPerTurn: 10, // cap parallel fan-out inside one turn\n        max: 20, // stop further turns once cumulative emitted tools hit 20\n      }),\n    ],\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\nPlace this **before** `toolCacheMiddleware` so over-budget skips win over cache hits. See [`onShouldContinue`](../advanced/middleware#onshouldcontinue) for the hook contract.\n","originalRawMarkdown":"---\ntitle: Agentic Cycle\nid: agentic-cycle\norder: 1\ndescription: \"The agentic cycle in TanStack AI — how the LLM loops through tool calls, results, and reasoning until it produces a final answer.\"\nkeywords:\n  - tanstack ai\n  - agentic cycle\n  - agent loop\n  - tool calling\n  - multi-step reasoning\n  - ai agents\n---\n\nThe agentic cycle is the pattern where the LLM repeatedly calls tools, receives results, and continues reasoning until it can provide a final answer. This enables complex multi-step operations.\n\nTo send a turn to a named child agent, see [Subagents](./subagents).\n\n> **Tip:** Code Mode can reduce agent loop iterations by letting the LLM write a program that calls multiple tools in a single execution. See [Code Mode](../code-mode/code-mode).\n\n```mermaid\ngraph TD\n    A[User sends message] --> B[LLM analyzes request]\n    B --> C{Does task need tools?}\n    C -->|No| D[Generate text response]\n    C -->|Yes| E[Call appropriate tool]\n    E --> F{Where does<br/>tool execute?}\n    F -->|Server| G[Execute on server]\n    F -->|Client| H[Execute on client]\n    G --> I[Tool returns result]\n    H --> I\n    I --> J[Add result to conversation]\n    J --> K[LLM analyzes result]\n    K --> L{Task complete?}\n    L -->|No| E\n    L -->|Yes| D\n    D --> M[Stream response to user]\n    M --> N[Done]\n    \n    style E fill:#e1f5ff\n    style G fill:#ffe1e1\n    style H fill:#ffe1e1\n    style L fill:#fff4e1\n```\n\n### Detailed Agentic Flow\n\n```mermaid\nsequenceDiagram\n    participant User\n    participant Client\n    participant Server\n    participant LLM\n    participant Tools\n    \n    User->>Client: \"What's the weather in SF and LA?\"\n    Client->>Server: Send message\n    Server->>LLM: Message + tool definitions\n    \n    Note over LLM: Cycle 1: Call first tool\n    \n    LLM->>Server: tool_call: get_weather(SF)\n    Server->>Tools: Execute get_weather\n    Tools-->>Server: {temp: 65, conditions: \"sunny\"}\n    Server->>LLM: tool_result\n    \n    Note over LLM: Cycle 2: Call second tool\n    \n    LLM->>Server: tool_call: get_weather(LA)\n    Server->>Tools: Execute get_weather\n    Tools-->>Server: {temp: 75, conditions: \"clear\"}\n    Server->>LLM: tool_result\n    \n    Note over LLM: Cycle 3: Generate answer\n    \n    LLM-->>Server: content: \"SF is 65°F...\"\n    Server-->>Client: Stream response\n    Client->>User: Display answer\n```\n\n### Multi-Step Example\n\nHere's a real-world example of the agentic cycle:\n\n**User**: \"Find me flights to Paris under $500 and book the cheapest one\"\n\n**Cycle 1**: LLM calls `searchFlights({destination: \"Paris\", maxPrice: 500})`\n- Tool returns: `[{id: \"F1\", price: 450}, {id: \"F2\", price: 480}]`\n\n**Cycle 2**: LLM analyzes results and calls `bookFlight({flightId: \"F1\"})`\n- Tool requires approval (sensitive operation) — see [Tool Approval](../tools/tool-approval)\n- User approves\n- Tool returns: `{bookingId: \"B123\", confirmed: true}`\n\n**Cycle 3**: LLM generates final response\n- \"I found 2 flights under $500. I've booked the cheapest one (Flight F1) for $450. Your booking ID is B123.\"\n\n### Code Example: Agentic Weather Assistant\n\n```typescript\nimport { chat, toolDefinition, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\n// Tool definitions\nconst getWeatherDef = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get current weather for a city\",\n  inputSchema: z.object({\n    city: z.string(),\n  }),\n});\n\nconst getClothingAdviceDef = toolDefinition({\n  name: \"get_clothing_advice\",\n  description: \"Get clothing recommendations based on weather\",\n  inputSchema: z.object({\n    temperature: z.number(),\n    conditions: z.string(),\n  }),\n});\n\n// Server implementations\nconst getWeather = getWeatherDef.server(async ({ city }) => {\n  const response = await fetch(`https://api.weather.com/v1/${city}`);\n  return await response.json();\n});\n\nconst getClothingAdvice = getClothingAdviceDef.server(async ({ temperature, conditions }) => {\n  // Business logic for clothing recommendations\n  if (temperature < 50) {\n    return { recommendation: \"Wear a warm jacket\" };\n  }\n  return { recommendation: \"Light clothing is fine\" };\n});\n\n// Server route\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages,\n    tools: [getWeather, getClothingAdvice],\n  });\n\n  return toServerSentEventsResponse(stream);\n}\n```\n\n**User**: \"What should I wear in San Francisco today?\"\n\n**Agentic Cycle**:\n1. LLM calls `get_weather({city: \"San Francisco\"})` → Returns `{temp: 62, conditions: \"cloudy\"}`\n2. LLM calls `get_clothing_advice({temperature: 62, conditions: \"cloudy\"})` → Returns `{recommendation: \"Light jacket recommended\"}`\n3. LLM generates: \"The weather in San Francisco is 62°F and cloudy. I recommend wearing a light jacket.\"\n\nThe loop continues only while the model's finish reason is `tool_calls` (with pending tool calls) **and** the agent loop strategy permits another iteration; it ends as soon as the model returns a normal `stop` finish reason.\n\n### Controlling the loop\n\nBy default the loop is bounded by `maxIterations(5)` — after five **model turns** it stops even if the model would keep calling tools. Override this with the `agentLoopStrategy` option.\n\nOther built-in strategies:\n\n- **`untilFinishReason([...])`** — continue until the model returns one of the given finish reasons (e.g. `untilFinishReason([\"stop\", \"length\"])`).\n- **`combineStrategies([...])`** — combine multiple strategies with AND logic; the loop continues only while every strategy agrees.\n\nA strategy is just a function that receives `{ iterationCount, finishReason, messages, toolCallCount, lastTurnToolCallCount }` and returns `true` to allow another iteration or `false` to stop, so you can also write your own:\n\n```typescript\nimport { chat, combineStrategies, maxIterations, toServerSentEventsResponse } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport type { AgentLoopState } from \"@tanstack/ai\";\nimport { getWeather, getClothingAdvice } from \"./tools\";\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages,\n    tools: [getWeather, getClothingAdvice],\n    agentLoopStrategy: combineStrategies([\n      maxIterations(10),\n      ({ messages }: AgentLoopState) => messages.length < 100,\n    ]),\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\n### Tool-call budgets (middleware recipe)\n\n> **Iterations ≠ tool calls.** One model turn can emit many parallel tool calls. `maxIterations` only bounds **model turns**. Strategies run *between* turns, so without a per-turn cap a single runaway turn can still fan out unbounded.\n\nThere is no built-in `maxToolCalls` strategy. Cap tools with middleware:\n\n- **`onBeforeToolCall`** — skip excess calls inside one turn (`maxPerTurn`)\n- **`onShouldContinue`** — stop further turns once cumulative **emitted** tools hit a budget (`max`); skipped calls still count toward `toolCallCount`\n\n```typescript\nimport {\n  chat,\n  maxIterations,\n  toServerSentEventsResponse,\n  type ChatMiddleware,\n} from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { getWeather, getClothingAdvice } from \"./tools\";\n\n/** App-owned policy — not a library export. */\nfunction toolCallBudget(options: {\n  max?: number;\n  maxPerTurn?: number;\n}): ChatMiddleware {\n  const { max, maxPerTurn } = options;\n  let perTurn = 0;\n\n  return {\n    name: \"tool-call-budget\",\n    onIteration() {\n      perTurn = 0;\n    },\n    // Fresh per-turn budget for pending/resume batches (no onIteration).\n    onToolPhaseComplete() {\n      perTurn = 0;\n    },\n    onBeforeToolCall() {\n      if (maxPerTurn == null) return undefined;\n      perTurn += 1;\n      if (perTurn > maxPerTurn) {\n        return {\n          type: \"skip\",\n          result: {\n            error: `Skipped: exceeded maxToolCallsPerTurn (${maxPerTurn})`,\n          },\n        };\n      }\n      return undefined;\n    },\n    onShouldContinue(_ctx, state) {\n      if (max != null && state.toolCallCount >= max) return false;\n      return undefined;\n    },\n  };\n}\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json();\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.5\"),\n    messages,\n    tools: [getWeather, getClothingAdvice],\n    agentLoopStrategy: maxIterations(20), // model turns\n    middleware: [\n      toolCallBudget({\n        maxPerTurn: 10, // cap parallel fan-out inside one turn\n        max: 20, // stop further turns once cumulative emitted tools hit 20\n      }),\n    ],\n  });\n  return toServerSentEventsResponse(stream);\n}\n```\n\nPlace this **before** `toolCacheMiddleware` so over-budget skips win over cache hits. See [`onShouldContinue`](../advanced/middleware#onshouldcontinue) for the hook contract.\n"}
