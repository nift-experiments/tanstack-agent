{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"You have a stream of chunks. You need to know which ones are tokens, which ones are tools, and when the run is done."}]},{"type":"paragraph","children":[{"type":"text","value":"Branch on "},{"type":"inlineCode","value":"chunk.type"},{"type":"text","value":". Two ids frame every stream: "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":" and "},{"type":"inlineCode","value":"runId"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"event-types","children":[{"type":"text","value":"Event types"}]},{"type":"paragraph","children":[{"type":"text","value":"Public "},{"type":"inlineCode","value":"StreamChunk"},{"type":"text","value":" follows "},{"type":"link","href":"https://docs.ag-ui.com/introduction","children":[{"type":"text","value":"AG-UI"}]},{"type":"text","value":". TanStack extras live under "},{"type":"inlineCode","value":"metadata.tanstack"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Do now:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"RUN_STARTED"},{"type":"text","value":": "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":", "},{"type":"inlineCode","value":"runId"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TEXT_MESSAGE_START"},{"type":"text","value":" / "},{"type":"inlineCode","value":"CONTENT"},{"type":"text","value":" / "},{"type":"inlineCode","value":"END"},{"type":"text","value":": "},{"type":"inlineCode","value":"messageId"},{"type":"text","value":", "},{"type":"inlineCode","value":"delta"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TOOL_CALL_START"},{"type":"text","value":" / "},{"type":"inlineCode","value":"ARGS"},{"type":"text","value":" / "},{"type":"inlineCode","value":"END"},{"type":"text","value":": "},{"type":"inlineCode","value":"toolCallId"},{"type":"text","value":", "},{"type":"inlineCode","value":"toolCallName"},{"type":"text","value":", args "},{"type":"inlineCode","value":"delta"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"RUN_FINISHED"},{"type":"text","value":" / "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":": usage and finish reason"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Later:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"REASONING_*"},{"type":"text","value":" / "},{"type":"inlineCode","value":"REASONING_ENCRYPTED_VALUE"},{"type":"text","value":": thinking content. See "},{"type":"link","href":"./thinking-content","children":[{"type":"text","value":"Thinking and Reasoning"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TEXT_MESSAGE_CHUNK"},{"type":"text","value":" / "},{"type":"inlineCode","value":"TOOL_CALL_CHUNK"},{"type":"text","value":" / "},{"type":"inlineCode","value":"REASONING_MESSAGE_CHUNK"},{"type":"text","value":": other AG-UI servers can send one of these in place of START / CONTENT / END. A chunk with no id continues the open stream of the same kind. A chunk of a different kind closes that stream. The client builds the same message from both forms"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"STEP_STARTED"},{"type":"text","value":" / "},{"type":"inlineCode","value":"STEP_FINISHED"},{"type":"text","value":": "},{"type":"inlineCode","value":"stepName"},{"type":"text","value":" only"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"CUSTOM"},{"type":"text","value":": "},{"type":"inlineCode","value":"name"},{"type":"text","value":" and "},{"type":"inlineCode","value":"value"},{"type":"text","value":". See "},{"type":"link","href":"../protocol/custom-events","children":[{"type":"text","value":"Custom Events"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SUBAGENT_STARTED"},{"type":"text","value":" / "},{"type":"inlineCode","value":"SUBAGENT_FINISHED"},{"type":"text","value":" / "},{"type":"inlineCode","value":"SUBAGENT_ERROR"},{"type":"text","value":": a child agent. Attributed events carry "},{"type":"inlineCode","value":"subagentRunId"},{"type":"text","value":". A child that waits for an interrupt ends with "},{"type":"inlineCode","value":"SUBAGENT_FINISHED"},{"type":"text","value":" and "},{"type":"inlineCode","value":"outcome: { type: 'suspended' }"},{"type":"text","value":". In request messages, each child message carries "},{"type":"inlineCode","value":"subagentRunId"},{"type":"text","value":". See "},{"type":"link","href":"./subagents","children":[{"type":"text","value":"Subagents"}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"On "},{"type":"inlineCode","value":"RUN_FINISHED"},{"type":"text","value":", in-process "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" still uses TanStack "},{"type":"inlineCode","value":"TokenUsage"},{"type":"text","value":" ("},{"type":"inlineCode","value":"promptTokens"},{"type":"text","value":"). The SSE and HTTP wires use the spec "},{"type":"inlineCode","value":"usage"},{"type":"text","value":" array ("},{"type":"inlineCode","value":"inputTokens"},{"type":"text","value":"). Read "},{"type":"inlineCode","value":"finishReason"},{"type":"text","value":" from "},{"type":"inlineCode","value":"metadata.tanstack.finishReason"},{"type":"text","value":". Custom servers: see "},{"type":"link","href":"../protocol/metadata","children":[{"type":"text","value":"Event metadata"}]},{"type":"text","value":"."}]},{"type":"code","value":"import { chat } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.6\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n\nfor await (const chunk of stream) {\n  if (chunk.type === \"TEXT_MESSAGE_CONTENT\") {\n    console.log(chunk.delta);\n  }\n  if (chunk.type === \"RUN_FINISHED\") {\n    console.log(chunk.usage);\n    console.log(chunk.metadata?.tanstack?.finishReason);\n  }\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"threads-and-runs","children":[{"type":"text","value":"Threads and runs"}]},{"type":"paragraph","children":[{"type":"text","value":"Two ids frame every stream. They come from the AG-UI protocol, not from a storage layer."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"strong","children":[{"type":"text","value":"thread"}]},{"type":"text","value":" ("},{"type":"inlineCode","value":"threadId"},{"type":"text","value":") is the conversation. It stays the same across every exchange, reload, and device."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"strong","children":[{"type":"text","value":"run"}]},{"type":"text","value":" ("},{"type":"inlineCode","value":"runId"},{"type":"text","value":") is one execution inside that thread. It spans "},{"type":"inlineCode","value":"RUN_STARTED"},{"type":"text","value":" to "},{"type":"inlineCode","value":"RUN_FINISHED"},{"type":"text","value":" (or "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":"). Every start mints a fresh run id. A thread collects many runs over its life."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Tool calls and follow-up responses stream inside the same run. The whole "},{"type":"link","href":"./agentic-cycle","children":[{"type":"text","value":"agentic cycle"}]},{"type":"text","value":" is one run, however many loops it takes."}]},{"type":"code","value":"flowchart LR\n    subgraph thread [\"Thread (threadId, stable)\"]\n        direction LR\n        subgraph r1 [\"Run r1, finished\"]\n            direction TB\n            e1[\"RUN_STARTED then text then tool call then tool result then final text then RUN_FINISHED\"]\n        end\n        subgraph r2 [\"Run r2, finished\"]\n            direction TB\n            e2[\"RUN_STARTED then text then RUN_FINISHED\"]\n        end\n        subgraph r3 [\"Run r3, running\"]\n            direction TB\n            e3[\"RUN_STARTED then text\"]\n        end\n        r1 --> r2 --> r3\n    end","lang":"mermaid"},{"type":"paragraph","children":[{"type":"text","value":"Because run ids are short-lived, anything long-lived anchors on the thread:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../resumable-streams/overview","children":[{"type":"text","value":"Resumable streams"}]},{"type":"text","value":" log delivery per "},{"type":"inlineCode","value":"runId"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../persistence/chat-persistence#threads-runs-and-turns","children":[{"type":"text","value":"Server persistence"}]},{"type":"text","value":" stores the transcript per "},{"type":"inlineCode","value":"threadId"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The media generation hooks take a "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":" too. There it names a slot, not a conversation. See "},{"type":"link","href":"../persistence/id-map","children":[{"type":"text","value":"Id map"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"tool-input-and-output","children":[{"type":"text","value":"Tool input and output"}]},{"type":"paragraph","children":[{"type":"text","value":"SSE and HTTP "},{"type":"inlineCode","value":"TOOL_CALL_END"},{"type":"text","value":" does not carry parsed "},{"type":"inlineCode","value":"input"},{"type":"text","value":". In-process "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" still has "},{"type":"inlineCode","value":"input"},{"type":"text","value":". Tool input and output also live on "},{"type":"inlineCode","value":"UIMessage"},{"type":"text","value":" parts."}]},{"type":"paragraph","children":[{"type":"text","value":"On the server, feed chunks into "},{"type":"inlineCode","value":"StreamProcessor"},{"type":"text","value":". On the client, read "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" "},{"type":"inlineCode","value":"messages"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"server","children":[{"type":"text","value":"Server"}]},{"type":"code","value":"import { chat, StreamProcessor, toolDefinition } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\nconst weatherTool = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get weather for a location\",\n  inputSchema: z.object({\n    location: z.string(),\n    unit: z.enum([\"celsius\", \"fahrenheit\"]).optional(),\n  }),\n});\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.6\"),\n  messages: [{ role: \"user\", content: \"What is the weather in Paris?\" }],\n  tools: [weatherTool],\n});\n\nconst processor = new StreamProcessor();\nfor await (const chunk of stream) {\n  processor.processChunk(chunk);\n}\nprocessor.finalizeStream();\n\nfor (const message of processor.getMessages()) {\n  for (const part of message.parts) {\n    if (part.type === \"tool-call\") {\n      console.log(part.name, part.input, part.output);\n    }\n  }\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"type-safe-tool-call-events","children":[{"type":"text","value":"Type-safe tool call events"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass your "},{"type":"inlineCode","value":".client()"},{"type":"text","value":" tools to "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":". A check on "},{"type":"inlineCode","value":"part.name"},{"type":"text","value":" narrows "},{"type":"inlineCode","value":"part.input"},{"type":"text","value":" and "},{"type":"inlineCode","value":"part.output"},{"type":"text","value":":"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\n\nconst weatherTool = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get weather for a location\",\n  inputSchema: z.object({\n    location: z.string(),\n    unit: z.enum([\"celsius\", \"fahrenheit\"]).optional(),\n  }),\n}).client(async (input) => {\n  return { location: input.location };\n});\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools: [weatherTool],\n});\n\nfor (const message of messages) {\n  for (const part of message.parts) {\n    if (part.type === \"tool-call\" && part.name === \"get_weather\") {\n      console.log(part.input?.location);\n    }\n  }\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"You now know which chunk is text, which is a tool, and which id is the conversation versus one run."}]}],"headings":[{"id":"event-types","text":"Event types","level":2},{"id":"threads-and-runs","text":"Threads and runs","level":2},{"id":"tool-input-and-output","text":"Tool input and output","level":2},{"id":"server","text":"Server","level":3},{"id":"type-safe-tool-call-events","text":"Type-safe tool call events","level":3}]},"frameworks":[],"downloadMarkdown":"\nYou have a stream of chunks. You need to know which ones are tokens, which ones are tools, and when the run is done.\n\nBranch on `chunk.type`. Two ids frame every stream: `threadId` and `runId`.\n\n## Event types\n\nPublic `StreamChunk` follows [AG-UI](https://docs.ag-ui.com/introduction). TanStack extras live under `metadata.tanstack`.\n\nDo now:\n\n- `RUN_STARTED`: `threadId`, `runId`\n- `TEXT_MESSAGE_START` / `CONTENT` / `END`: `messageId`, `delta`\n- `TOOL_CALL_START` / `ARGS` / `END`: `toolCallId`, `toolCallName`, args `delta`\n- `RUN_FINISHED` / `RUN_ERROR`: usage and finish reason\n\nLater:\n\n- `REASONING_*` / `REASONING_ENCRYPTED_VALUE`: thinking content. See [Thinking and Reasoning](./thinking-content)\n- `TEXT_MESSAGE_CHUNK` / `TOOL_CALL_CHUNK` / `REASONING_MESSAGE_CHUNK`: other AG-UI servers can send one of these in place of START / CONTENT / END. A chunk with no id continues the open stream of the same kind. A chunk of a different kind closes that stream. The client builds the same message from both forms\n- `STEP_STARTED` / `STEP_FINISHED`: `stepName` only\n- `CUSTOM`: `name` and `value`. See [Custom Events](../protocol/custom-events)\n- `SUBAGENT_STARTED` / `SUBAGENT_FINISHED` / `SUBAGENT_ERROR`: a child agent. Attributed events carry `subagentRunId`. A child that waits for an interrupt ends with `SUBAGENT_FINISHED` and `outcome: { type: 'suspended' }`. In request messages, each child message carries `subagentRunId`. See [Subagents](./subagents)\n\nOn `RUN_FINISHED`, in-process `chat()` still uses TanStack `TokenUsage` (`promptTokens`). The SSE and HTTP wires use the spec `usage` array (`inputTokens`). Read `finishReason` from `metadata.tanstack.finishReason`. Custom servers: see [Event metadata](../protocol/metadata).\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.6\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n\nfor await (const chunk of stream) {\n  if (chunk.type === \"TEXT_MESSAGE_CONTENT\") {\n    console.log(chunk.delta);\n  }\n  if (chunk.type === \"RUN_FINISHED\") {\n    console.log(chunk.usage);\n    console.log(chunk.metadata?.tanstack?.finishReason);\n  }\n}\n```\n\n## Threads and runs\n\nTwo ids frame every stream. They come from the AG-UI protocol, not from a storage layer.\n\n- A **thread** (`threadId`) is the conversation. It stays the same across every exchange, reload, and device.\n- A **run** (`runId`) is one execution inside that thread. It spans `RUN_STARTED` to `RUN_FINISHED` (or `RUN_ERROR`). Every start mints a fresh run id. A thread collects many runs over its life.\n\nTool calls and follow-up responses stream inside the same run. The whole [agentic cycle](./agentic-cycle) is one run, however many loops it takes.\n\n```mermaid\nflowchart LR\n    subgraph thread [\"Thread (threadId, stable)\"]\n        direction LR\n        subgraph r1 [\"Run r1, finished\"]\n            direction TB\n            e1[\"RUN_STARTED then text then tool call then tool result then final text then RUN_FINISHED\"]\n        end\n        subgraph r2 [\"Run r2, finished\"]\n            direction TB\n            e2[\"RUN_STARTED then text then RUN_FINISHED\"]\n        end\n        subgraph r3 [\"Run r3, running\"]\n            direction TB\n            e3[\"RUN_STARTED then text\"]\n        end\n        r1 --> r2 --> r3\n    end\n```\n\nBecause run ids are short-lived, anything long-lived anchors on the thread:\n\n- [Resumable streams](../resumable-streams/overview) log delivery per `runId`\n- [Server persistence](../persistence/chat-persistence#threads-runs-and-turns) stores the transcript per `threadId`\n\nThe media generation hooks take a `threadId` too. There it names a slot, not a conversation. See [Id map](../persistence/id-map).\n\n## Tool input and output\n\nSSE and HTTP `TOOL_CALL_END` does not carry parsed `input`. In-process `chat()` still has `input`. Tool input and output also live on `UIMessage` parts.\n\nOn the server, feed chunks into `StreamProcessor`. On the client, read `useChat` `messages`.\n\n### Server\n\n```typescript\nimport { chat, StreamProcessor, toolDefinition } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\nconst weatherTool = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get weather for a location\",\n  inputSchema: z.object({\n    location: z.string(),\n    unit: z.enum([\"celsius\", \"fahrenheit\"]).optional(),\n  }),\n});\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.6\"),\n  messages: [{ role: \"user\", content: \"What is the weather in Paris?\" }],\n  tools: [weatherTool],\n});\n\nconst processor = new StreamProcessor();\nfor await (const chunk of stream) {\n  processor.processChunk(chunk);\n}\nprocessor.finalizeStream();\n\nfor (const message of processor.getMessages()) {\n  for (const part of message.parts) {\n    if (part.type === \"tool-call\") {\n      console.log(part.name, part.input, part.output);\n    }\n  }\n}\n```\n\n### Type-safe tool call events\n\nPass your `.client()` tools to `useChat`. A check on `part.name` narrows `part.input` and `part.output`:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\n\nconst weatherTool = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get weather for a location\",\n  inputSchema: z.object({\n    location: z.string(),\n    unit: z.enum([\"celsius\", \"fahrenheit\"]).optional(),\n  }),\n}).client(async (input) => {\n  return { location: input.location };\n});\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools: [weatherTool],\n});\n\nfor (const message of messages) {\n  for (const part of message.parts) {\n    if (part.type === \"tool-call\" && part.name === \"get_weather\") {\n      console.log(part.input?.location);\n    }\n  }\n}\n```\n\nYou now know which chunk is text, which is a tool, and which id is the conversation versus one run.\n","originalRawMarkdown":"---\ntitle: Stream Events\nid: stream-events\norder: 3\ndescription: \"Read AG-UI stream chunks: event types, thread vs run ids, and tool input on the wire and in UIMessage parts.\"\nkeywords:\n  - tanstack ai\n  - ag-ui\n  - stream events\n  - StreamChunk\n  - threadId\n  - runId\n  - TOOL_CALL\n  - TEXT_MESSAGE_CONTENT\n---\n\nYou have a stream of chunks. You need to know which ones are tokens, which ones are tools, and when the run is done.\n\nBranch on `chunk.type`. Two ids frame every stream: `threadId` and `runId`.\n\n## Event types\n\nPublic `StreamChunk` follows [AG-UI](https://docs.ag-ui.com/introduction). TanStack extras live under `metadata.tanstack`.\n\nDo now:\n\n- `RUN_STARTED`: `threadId`, `runId`\n- `TEXT_MESSAGE_START` / `CONTENT` / `END`: `messageId`, `delta`\n- `TOOL_CALL_START` / `ARGS` / `END`: `toolCallId`, `toolCallName`, args `delta`\n- `RUN_FINISHED` / `RUN_ERROR`: usage and finish reason\n\nLater:\n\n- `REASONING_*` / `REASONING_ENCRYPTED_VALUE`: thinking content. See [Thinking and Reasoning](./thinking-content)\n- `TEXT_MESSAGE_CHUNK` / `TOOL_CALL_CHUNK` / `REASONING_MESSAGE_CHUNK`: other AG-UI servers can send one of these in place of START / CONTENT / END. A chunk with no id continues the open stream of the same kind. A chunk of a different kind closes that stream. The client builds the same message from both forms\n- `STEP_STARTED` / `STEP_FINISHED`: `stepName` only\n- `CUSTOM`: `name` and `value`. See [Custom Events](../protocol/custom-events)\n- `SUBAGENT_STARTED` / `SUBAGENT_FINISHED` / `SUBAGENT_ERROR`: a child agent. Attributed events carry `subagentRunId`. A child that waits for an interrupt ends with `SUBAGENT_FINISHED` and `outcome: { type: 'suspended' }`. In request messages, each child message carries `subagentRunId`. See [Subagents](./subagents)\n\nOn `RUN_FINISHED`, in-process `chat()` still uses TanStack `TokenUsage` (`promptTokens`). The SSE and HTTP wires use the spec `usage` array (`inputTokens`). Read `finishReason` from `metadata.tanstack.finishReason`. Custom servers: see [Event metadata](../protocol/metadata).\n\n```typescript\nimport { chat } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.6\"),\n  messages: [{ role: \"user\", content: \"Hello!\" }],\n});\n\nfor await (const chunk of stream) {\n  if (chunk.type === \"TEXT_MESSAGE_CONTENT\") {\n    console.log(chunk.delta);\n  }\n  if (chunk.type === \"RUN_FINISHED\") {\n    console.log(chunk.usage);\n    console.log(chunk.metadata?.tanstack?.finishReason);\n  }\n}\n```\n\n## Threads and runs\n\nTwo ids frame every stream. They come from the AG-UI protocol, not from a storage layer.\n\n- A **thread** (`threadId`) is the conversation. It stays the same across every exchange, reload, and device.\n- A **run** (`runId`) is one execution inside that thread. It spans `RUN_STARTED` to `RUN_FINISHED` (or `RUN_ERROR`). Every start mints a fresh run id. A thread collects many runs over its life.\n\nTool calls and follow-up responses stream inside the same run. The whole [agentic cycle](./agentic-cycle) is one run, however many loops it takes.\n\n```mermaid\nflowchart LR\n    subgraph thread [\"Thread (threadId, stable)\"]\n        direction LR\n        subgraph r1 [\"Run r1, finished\"]\n            direction TB\n            e1[\"RUN_STARTED then text then tool call then tool result then final text then RUN_FINISHED\"]\n        end\n        subgraph r2 [\"Run r2, finished\"]\n            direction TB\n            e2[\"RUN_STARTED then text then RUN_FINISHED\"]\n        end\n        subgraph r3 [\"Run r3, running\"]\n            direction TB\n            e3[\"RUN_STARTED then text\"]\n        end\n        r1 --> r2 --> r3\n    end\n```\n\nBecause run ids are short-lived, anything long-lived anchors on the thread:\n\n- [Resumable streams](../resumable-streams/overview) log delivery per `runId`\n- [Server persistence](../persistence/chat-persistence#threads-runs-and-turns) stores the transcript per `threadId`\n\nThe media generation hooks take a `threadId` too. There it names a slot, not a conversation. See [Id map](../persistence/id-map).\n\n## Tool input and output\n\nSSE and HTTP `TOOL_CALL_END` does not carry parsed `input`. In-process `chat()` still has `input`. Tool input and output also live on `UIMessage` parts.\n\nOn the server, feed chunks into `StreamProcessor`. On the client, read `useChat` `messages`.\n\n### Server\n\n```typescript\nimport { chat, StreamProcessor, toolDefinition } from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\nimport { z } from \"zod\";\n\nconst weatherTool = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get weather for a location\",\n  inputSchema: z.object({\n    location: z.string(),\n    unit: z.enum([\"celsius\", \"fahrenheit\"]).optional(),\n  }),\n});\n\nconst stream = chat({\n  adapter: openaiText(\"gpt-5.6\"),\n  messages: [{ role: \"user\", content: \"What is the weather in Paris?\" }],\n  tools: [weatherTool],\n});\n\nconst processor = new StreamProcessor();\nfor await (const chunk of stream) {\n  processor.processChunk(chunk);\n}\nprocessor.finalizeStream();\n\nfor (const message of processor.getMessages()) {\n  for (const part of message.parts) {\n    if (part.type === \"tool-call\") {\n      console.log(part.name, part.input, part.output);\n    }\n  }\n}\n```\n\n### Type-safe tool call events\n\nPass your `.client()` tools to `useChat`. A check on `part.name` narrows `part.input` and `part.output`:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { toolDefinition } from \"@tanstack/ai\";\nimport { z } from \"zod\";\n\nconst weatherTool = toolDefinition({\n  name: \"get_weather\",\n  description: \"Get weather for a location\",\n  inputSchema: z.object({\n    location: z.string(),\n    unit: z.enum([\"celsius\", \"fahrenheit\"]).optional(),\n  }),\n}).client(async (input) => {\n  return { location: input.location };\n});\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  tools: [weatherTool],\n});\n\nfor (const message of messages) {\n  for (const part of message.parts) {\n    if (part.type === \"tool-call\" && part.name === \"get_weather\") {\n      console.log(part.input?.location);\n    }\n  }\n}\n```\n\nYou now know which chunk is text, which is a tool, and which id is the conversation versus one run.\n"}
