:"paragraph","children":[{"type":"inlineCode","value":"enableLanguageIdentification"},{"type":"text","value":" - Automatically detect spoken language"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"enableSpeakerDiarization"},{"type":"text","value":" - Identify and separate different speakers"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context"},{"type":"text","value":" - Additional context to improve accuracy"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"clientReferenceId"},{"type":"text","value":" - Optional client-defined reference ID"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"webhookUrl"},{"type":"text","value":" - Webhook URL for completion notifications"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"webhookAuthHeaderName"},{"type":"text","value":" - Webhook authentication header name"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"webhookAuthHeaderValue"},{"type":"text","value":" - Webhook authentication header value"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"translation"},{"type":"text","value":" - Translation configuration"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Check the "},{"type":"link","href":"https://soniox.com/docs/stt/api-reference/transcriptions/create_transcription","children":[{"type":"text","value":"Soniox API reference"}]},{"type":"text","value":" for more details."}]},{"type":"heading","depth":2,"id":"language-hints","children":[{"type":"text","value":"Language Hints"}]},{"type":"paragraph","children":[{"type":"text","value":"Soniox automatically detects and transcribes speech in "},{"type":"link","href":"https://soniox.com/docs/stt/concepts/supported-languages","children":[{"type":"text","value":"60+ languages"}]},{"type":"text","value":". When you know which languages are likely to appear in your audio, provide "},{"type":"inlineCode","value":"languageHints"},{"type":"text","value":" to improve accuracy by biasing recognition toward those languages."}]},{"type":"paragraph","children":[{"type":"text","value":"Language hints do not restrict recognition. If you pass the TanStack "},{"type":"inlineCode","value":"language"},{"type":"text","value":" option, this adapter merges it into "},{"type":"inlineCode","value":"languageHints"},{"type":"text","value":"."}]},{"type":"code","value":"import { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    languageHints: [\"en\", \"es\"],\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"For more details, see the "},{"type":"link","href":"https://soniox.com/docs/stt/concepts/language-hints","children":[{"type":"text","value":"Soniox language hints documentation"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"context","children":[{"type":"text","value":"Context"}]},{"type":"paragraph","children":[{"type":"text","value":"Provide custom context to improve transcription and translation accuracy. Context helps the model understand your domain, recognize important terms, and apply custom vocabulary."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"context"},{"type":"text","value":" object supports four optional sections:"}]},{"type":"code","value":"import { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    context: {\n      general: [\n        { key: \"domain\", value: \"Healthcare\" },\n        { key: \"topic\", value: \"Diabetes management consultation\" },\n        { key: \"doctor\", value: \"Dr. Martha Smith\" },\n      ],\n      text: \"The patient has a history of...\",\n      terms: [\"Celebrex\", \"Zyrtec\", \"Xanax\"],\n      translationTerms: [\n        { source: \"Mr. Smith\", target: \"Sr. Smith\" },\n        { source: \"MRI\", target: \"RM\" },\n      ],\n    },\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"For more details, see the "},{"type":"link","href":"https://soniox.com/docs/stt/concepts/context","children":[{"type":"text","value":"Soniox context documentation"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"translation","children":[{"type":"text","value":"Translation"}]},{"type":"paragraph","children":[{"type":"text","value":"Configure translation for your transcriptions:"}]},{"type":"code","value":"import { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    translation: {\n      type: \"one_way\",\n      targetLanguage: \"es\",\n    },\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"For two-way translation:"}]},{"type":"code","value":"import { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    translation: {\n      type: \"two_way\",\n      languageA: \"en\",\n      languageB: \"es\",\n    },\n  },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"When using translation, the API returns both transcription tokens and translation tokens. The "},{"type":"inlineCode","value":"segments"},{"type":"text","value":" array always includes only transcription tokens. To access translation tokens, use "},{"type":"inlineCode","value":"providerMetadata"},{"type":"text","value":" and filter by "},{"type":"inlineCode","value":"translation_status === \"translation\""},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"accessing-raw-tokens","children":[{"type":"text","value":"Accessing Raw Tokens"}]},{"type":"paragraph","children":[{"type":"text","value":"When using translation or working with multilingual audio, you may need access to raw tokens with per-token language information and translation status. The adapter attaches a non-standard "},{"type":"inlineCode","value":"providerMetadata"},{"type":"text","value":" field at runtime:"}]},{"type":"code","value":"// ignore: providerMetadata is a non-standard runtime extension not on TranscriptionResult;\n// accessing it requires a cast that cannot be expressed without `as`.\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    translation: { type: \"one_way\", targetLanguage: \"es\" },\n  },\n});\n\nconst rawTokens = (result as any).providerMetadata?.soniox?.tokens;\n\nif (rawTokens) {\n  rawTokens.forEach((token) => {\n    // token.text - token text\n    // token.start_ms - start time in milliseconds\n    // token.end_ms - end time in milliseconds\n    // token.language - detected language for this token\n    // token.translation_status - translation status (if translation enabled)\n    // token.speaker - speaker identifier\n    // token.confidence - confidence score\n  });\n}","lang":"typescript","meta":"ignore"},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next Steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://console.soniox.com","children":[{"type":"text","value":"Soniox Console"}]},{"type":"text","value":" - Manage API keys and projects"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://soniox.com/docs","children":[{"type":"text","value":"Soniox API docs"}]},{"type":"text","value":" - Complete Soniox API reference"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../media/transcription","children":[{"type":"text","value":"Transcription Guide"}]},{"type":"text","value":" - Learn about transcription in TanStack AI"}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"authentication","text":"Authentication","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"basic-usage-custom-api-key","text":"Basic Usage - Custom API Key","level":2},{"id":"adapter-configuration","text":"Adapter Configuration","level":2},{"id":"transcription-options","text":"Transcription Options","level":2},{"id":"language-hints","text":"Language Hints","level":2},{"id":"context","text":"Context","level":2},{"id":"translation","text":"Translation","level":2},{"id":"accessing-raw-tokens","text":"Accessing Raw Tokens","level":3},{"id":"next-steps","text":"Next Steps","level":2}]},"frameworks":["react","vue","solid","svelte","preact","angular","vanilla","octane"],"downloadMarkdown":"\nThe Soniox adapter provides access to Soniox transcription models.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @soniox/tanstack-ai-adapter\nvue: @soniox/tanstack-ai-adapter\nsolid: @soniox/tanstack-ai-adapter\nsvelte: @soniox/tanstack-ai-adapter\npreact: @soniox/tanstack-ai-adapter\nangular: @soniox/tanstack-ai-adapter\nvanilla: @soniox/tanstack-ai-adapter\noctane: @soniox/tanstack-ai-adapter\n\n<!-- ::end:tabs -->\n\n## Authentication\n\nSet `SONIOX_API_KEY` in your environment or pass `apiKey` when creating the adapter. Get your API key from the [Soniox Console](https://console.soniox.com).\n\n## Basic Usage\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audioFile } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio: audioFile,\n  modelOptions: {\n    enableLanguageIdentification: true,\n    enableSpeakerDiarization: true,\n  },\n});\n\nconsole.log(result.text);\nconsole.log(result.segments);\n```\n\n## Basic Usage - Custom API Key\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { createSonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audioFile } from \"./audio\";\n\nconst adapter = createSonioxTranscription(\"stt-async-v3\", process.env.SONIOX_API_KEY!);\n\nconst result = await generateTranscription({\n  adapter,\n  audio: audioFile,\n});\n```\n\n## Adapter Configuration\n\nUse `createSonioxTranscription` to customize the adapter instance:\n\n```typescript\nimport { createSonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\n\nconst adapter = createSonioxTranscription(\"stt-async-v3\", process.env.SONIOX_API_KEY!, {\n  baseUrl: \"https://api.soniox.com\",\n  pollingIntervalMs: 1000,\n  timeout: 180000,\n});\n```\n\nOptions:\n\n- `apiKey` - Override `SONIOX_API_KEY` (required when using `createSonioxTranscription`)\n- `baseUrl` - Custom API base URL. Default is `https://api.soniox.com`\n- `headers` - Additional request headers\n- `timeout` - Transcription timeout in milliseconds (default: 180000)\n- `pollingIntervalMs` - Transcription polling interval in milliseconds (default: 1000)\n\nSee the [Soniox regional endpoints](https://soniox.com/docs/stt/data-residency#regional-endpoints) if you need data residency.\n\n## Transcription Options\n\nPer-request options are passed via `modelOptions`:\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    languageHints: [\"en\", \"es\"],\n    enableLanguageIdentification: true,\n    enableSpeakerDiarization: true,\n    context: {\n      terms: [\"Soniox\", \"TanStack\"],\n    },\n  },\n});\n```\n\nAvailable options:\n\n- `languageHints` - Array of ISO language codes to bias recognition\n- `languageHintsStrict` - When true, rely more heavily on language hints (not supported by all models)\n- `enableLanguageIdentification` - Automatically detect spoken language\n- `enableSpeakerDiarization` - Identify and separate different speakers\n- `context` - Additional context to improve accuracy\n- `clientReferenceId` - Optional client-defined reference ID\n- `webhookUrl` - Webhook URL for completion notifications\n- `webhookAuthHeaderName` - Webhook authentication header name\n- `webhookAuthHeaderValue` - Webhook authentication header value\n- `translation` - Translation configuration\n\nCheck the [Soniox API reference](https://soniox.com/docs/stt/api-reference/transcriptions/create_transcription) for more details.\n\n## Language Hints\n\nSoniox automatically detects and transcribes speech in [60+ languages](https://soniox.com/docs/stt/concepts/supported-languages). When you know which languages are likely to appear in your audio, provide `languageHints` to improve accuracy by biasing recognition toward those languages.\n\nLanguage hints do not restrict recognition. If you pass the TanStack `language` option, this adapter merges it into `languageHints`.\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    languageHints: [\"en\", \"es\"],\n  },\n});\n```\n\nFor more details, see the [Soniox language hints documentation](https://soniox.com/docs/stt/concepts/language-hints).\n\n## Context\n\nProvide custom context to improve transcription and translation accuracy. Context helps the model understand your domain, recognize important terms, and apply custom vocabulary.\n\nThe `context` object supports four optional sections:\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    context: {\n      general: [\n        { key: \"domain\", value: \"Healthcare\" },\n        { key: \"topic\", value: \"Diabetes management consultation\" },\n        { key: \"doctor\", value: \"Dr. Martha Smith\" },\n      ],\n      text: \"The patient has a history of...\",\n      terms: [\"Celebrex\", \"Zyrtec\", \"Xanax\"],\n      translationTerms: [\n        { source: \"Mr. Smith\", target: \"Sr. Smith\" },\n        { source: \"MRI\", target: \"RM\" },\n      ],\n    },\n  },\n});\n```\n\nFor more details, see the [Soniox context documentation](https://soniox.com/docs/stt/concepts/context).\n\n## Translation\n\nConfigure translation for your transcriptions:\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    translation: {\n      type: \"one_way\",\n      targetLanguage: \"es\",\n    },\n  },\n});\n```\n\nFor two-way translation:\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    translation: {\n      type: \"two_way\",\n      languageA: \"en\",\n      languageB: \"es\",\n    },\n  },\n});\n```\n\nWhen using translation, the API returns both transcription tokens and translation tokens. The `segments` array always includes only transcription tokens. To access translation tokens, use `providerMetadata` and filter by `translation_status === \"translation\"`.\n\n### Accessing Raw Tokens\n\nWhen using translation or working with multilingual audio, you may need access to raw tokens with per-token language information and translation status. The adapter attaches a non-standard `providerMetadata` field at runtime:\n\n```typescript ignore\n// ignore: providerMetadata is a non-standard runtime extension not on TranscriptionResult;\n// accessing it requires a cast that cannot be expressed without `as`.\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    translation: { type: \"one_way\", targetLanguage: \"es\" },\n  },\n});\n\nconst rawTokens = (result as any).providerMetadata?.soniox?.tokens;\n\nif (rawTokens) {\n  rawTokens.forEach((token) => {\n    // token.text - token text\n    // token.start_ms - start time in milliseconds\n    // token.end_ms - end time in milliseconds\n    // token.language - detected language for this token\n    // token.translation_status - translation status (if translation enabled)\n    // token.speaker - speaker identifier\n    // token.confidence - confidence score\n  });\n}\n```\n\n## Next Steps\n\n- [Soniox Console](https://console.soniox.com) - Manage API keys and projects\n- [Soniox API docs](https://soniox.com/docs) - Complete Soniox API reference\n- [Transcription Guide](../media/transcription) - Learn about transcription in TanStack AI\n","originalRawMarkdown":"---\ntitle: Soniox\nid: soniox-adapter\norder: 3\ndescription: \"Transcribe audio with Soniox speech-to-text models in TanStack AI via the Soniox community adapter.\"\nkeywords:\n  - tanstack ai\n  - soniox\n  - transcription\n  - speech-to-text\n  - asr\n  - community adapter\n---\n\nThe Soniox adapter provides access to Soniox transcription models.\n\n## Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @soniox/tanstack-ai-adapter\nvue: @soniox/tanstack-ai-adapter\nsolid: @soniox/tanstack-ai-adapter\nsvelte: @soniox/tanstack-ai-adapter\npreact: @soniox/tanstack-ai-adapter\nangular: @soniox/tanstack-ai-adapter\nvanilla: @soniox/tanstack-ai-adapter\noctane: @soniox/tanstack-ai-adapter\n\n<!-- ::end:tabs -->\n\n## Authentication\n\nSet `SONIOX_API_KEY` in your environment or pass `apiKey` when creating the adapter. Get your API key from the [Soniox Console](https://console.soniox.com).\n\n## Basic Usage\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audioFile } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio: audioFile,\n  modelOptions: {\n    enableLanguageIdentification: true,\n    enableSpeakerDiarization: true,\n  },\n});\n\nconsole.log(result.text);\nconsole.log(result.segments);\n```\n\n## Basic Usage - Custom API Key\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { createSonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audioFile } from \"./audio\";\n\nconst adapter = createSonioxTranscription(\"stt-async-v3\", process.env.SONIOX_API_KEY!);\n\nconst result = await generateTranscription({\n  adapter,\n  audio: audioFile,\n});\n```\n\n## Adapter Configuration\n\nUse `createSonioxTranscription` to customize the adapter instance:\n\n```typescript\nimport { createSonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\n\nconst adapter = createSonioxTranscription(\"stt-async-v3\", process.env.SONIOX_API_KEY!, {\n  baseUrl: \"https://api.soniox.com\",\n  pollingIntervalMs: 1000,\n  timeout: 180000,\n});\n```\n\nOptions:\n\n- `apiKey` - Override `SONIOX_API_KEY` (required when using `createSonioxTranscription`)\n- `baseUrl` - Custom API base URL. Default is `https://api.soniox.com`\n- `headers` - Additional request headers\n- `timeout` - Transcription timeout in milliseconds (default: 180000)\n- `pollingIntervalMs` - Transcription polling interval in milliseconds (default: 1000)\n\nSee the [Soniox regional endpoints](https://soniox.com/docs/stt/data-residency#regional-endpoints) if you need data residency.\n\n## Transcription Options\n\nPer-request options are passed via `modelOptions`:\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    languageHints: [\"en\", \"es\"],\n    enableLanguageIdentification: true,\n    enableSpeakerDiarization: true,\n    context: {\n      terms: [\"Soniox\", \"TanStack\"],\n    },\n  },\n});\n```\n\nAvailable options:\n\n- `languageHints` - Array of ISO language codes to bias recognition\n- `languageHintsStrict` - When true, rely more heavily on language hints (not supported by all models)\n- `enableLanguageIdentification` - Automatically detect spoken language\n- `enableSpeakerDiarization` - Identify and separate different speakers\n- `context` - Additional context to improve accuracy\n- `clientReferenceId` - Optional client-defined reference ID\n- `webhookUrl` - Webhook URL for completion notifications\n- `webhookAuthHeaderName` - Webhook authentication header name\n- `webhookAuthHeaderValue` - Webhook authentication header value\n- `translation` - Translation configuration\n\nCheck the [Soniox API reference](https://soniox.com/docs/stt/api-reference/transcriptions/create_transcription) for more details.\n\n## Language Hints\n\nSoniox automatically detects and transcribes speech in [60+ languages](https://soniox.com/docs/stt/concepts/supported-languages). When you know which languages are likely to appear in your audio, provide `languageHints` to improve accuracy by biasing recognition toward those languages.\n\nLanguage hints do not restrict recognition. If you pass the TanStack `language` option, this adapter merges it into `languageHints`.\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    languageHints: [\"en\", \"es\"],\n  },\n});\n```\n\nFor more details, see the [Soniox language hints documentation](https://soniox.com/docs/stt/concepts/language-hints).\n\n## Context\n\nProvide custom context to improve transcription and translation accuracy. Context helps the model understand your domain, recognize important terms, and apply custom vocabulary.\n\nThe `context` object supports four optional sections:\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    context: {\n      general: [\n        { key: \"domain\", value: \"Healthcare\" },\n        { key: \"topic\", value: \"Diabetes management consultation\" },\n        { key: \"doctor\", value: \"Dr. Martha Smith\" },\n      ],\n      text: \"The patient has a history of...\",\n      terms: [\"Celebrex\", \"Zyrtec\", \"Xanax\"],\n      translationTerms: [\n        { source: \"Mr. Smith\", target: \"Sr. Smith\" },\n        { source: \"MRI\", target: \"RM\" },\n      ],\n    },\n  },\n});\n```\n\nFor more details, see the [Soniox context documentation](https://soniox.com/docs/stt/concepts/context).\n\n## Translation\n\nConfigure translation for your transcriptions:\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    translation: {\n      type: \"one_way\",\n      targetLanguage: \"es\",\n    },\n  },\n});\n```\n\nFor two-way translation:\n\n```typescript\nimport { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audio } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    translation: {\n      type: \"two_way\",\n      languageA: \"en\",\n      languageB: \"es\",\n    },\n  },\n});\n```\n\nWhen using translation, the API returns both transcription tokens and translation tokens. The `segments` array always includes only transcription tokens. To access translation tokens, use `providerMetadata` and filter by `translation_status === \"translation\"`.\n\n### Accessing Raw Tokens\n\nWhen using translation or working with multilingual audio, you may need access to raw tokens with per-token language information and translation status. The adapter attaches a non-standard `providerMetadata` field at runtime:\n\n```typescript ignore\n// ignore: providerMetadata is a non-standard runtime extension not on TranscriptionResult;\n// accessing it requires a cast that cannot be expressed without `as`.\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio,\n  modelOptions: {\n    translation: { type: \"one_way\", targetLanguage: \"es\" },\n  },\n});\n\nconst rawTokens = (result as any).providerMetadata?.soniox?.tokens;\n\nif (rawTokens) {\n  rawTokens.forEach((token) => {\n    // token.text - token text\n    // token.start_ms - start time in milliseconds\n    // token.end_ms - end time in milliseconds\n    // token.language - detected language for this token\n    // token.translation_status - translation status (if translation enabled)\n    // token.speaker - speaker identifier\n    // token.confidence - confidence score\n  });\n}\n```\n\n## Next Steps\n\n- [Soniox Console](https://console.soniox.com) - Manage API keys and projects\n- [Soniox API docs](https://soniox.com/docs) - Complete Soniox API reference\n- [Transcription Guide](../media/transcription) - Learn about transcription in TanStack AI\n"}
