{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The Soniox adapter provides access to Soniox transcription models."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@soniox/tanstack-ai-adapter\"]],\"vue\":[[\"@soniox/tanstack-ai-adapter\"]],\"solid\":[[\"@soniox/tanstack-ai-adapter\"]],\"svelte\":[[\"@soniox/tanstack-ai-adapter\"]],\"preact\":[[\"@soniox/tanstack-ai-adapter\"]],\"angular\":[[\"@soniox/tanstack-ai-adapter\"]],\"vanilla\":[[\"@soniox/tanstack-ai-adapter\"]],\"octane\":[[\"@soniox/tanstack-ai-adapter\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"authentication","children":[{"type":"text","value":"Authentication"}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"SONIOX_API_KEY"},{"type":"text","value":" in your environment or pass "},{"type":"inlineCode","value":"apiKey"},{"type":"text","value":" when creating the adapter. Get your API key from the "},{"type":"link","href":"https://console.soniox.com","children":[{"type":"text","value":"Soniox Console"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { generateTranscription } from \"@tanstack/ai\";\nimport { sonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audioFile } from \"./audio\";\n\nconst result = await generateTranscription({\n  adapter: sonioxTranscription(\"stt-async-v3\"),\n  audio: audioFile,\n  modelOptions: {\n    enableLanguageIdentification: true,\n    enableSpeakerDiarization: true,\n  },\n});\n\nconsole.log(result.text);\nconsole.log(result.segments);","lang":"typescript"},{"type":"heading","depth":2,"id":"basic-usage-custom-api-key","children":[{"type":"text","value":"Basic Usage - Custom API Key"}]},{"type":"code","value":"import { generateTranscription } from \"@tanstack/ai\";\nimport { createSonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\nimport { audioFile } from \"./audio\";\n\nconst adapter = createSonioxTranscription(\"stt-async-v3\", process.env.SONIOX_API_KEY!);\n\nconst result = await generateTranscription({\n  adapter,\n  audio: audioFile,\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"adapter-configuration","children":[{"type":"text","value":"Adapter Configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"createSonioxTranscription"},{"type":"text","value":" to customize the adapter instance:"}]},{"type":"code","value":"import { createSonioxTranscription } from \"@soniox/tanstack-ai-adapter\";\n\nconst adapter = createSonioxTranscription(\"stt-async-v3\", process.env.SONIOX_API_KEY!, {\n  baseUrl: \"https://api.soniox.com\",\n  pollingIntervalMs: 1000,\n  timeout: 180000,\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Options:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"apiKey"},{"type":"text","value":" - Override "},{"type":"inlineCode","value":"SONIOX_API_KEY"},{"type":"text","value":" (required when using "},{"type":"inlineCode","value":"createSonioxTranscription"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"baseUrl"},{"type":"text","value":" - Custom API base URL. Default is "},{"type":"inlineCode","value":"https://api.soniox.com"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"headers"},{"type":"text","value":" - Additional request headers"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"typ