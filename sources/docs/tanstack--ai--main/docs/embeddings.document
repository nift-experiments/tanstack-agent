{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack AI provides embedding generation through dedicated embedding adapters that follow the same tree-shakeable, per-model-typed architecture as every other activity. The "},{"type":"inlineCode","value":"embed()"},{"type":"text","value":" function turns text — and, for multimodal models, images — into vectors for semantic search, RAG, clustering, and classification."}]},{"type":"heading","depth":2,"id":"overview","children":[{"type":"text","value":"Overview"}]},{"type":"paragraph","children":[{"type":"text","value":"Currently supported:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"OpenAI"}]},{"type":"text","value":": text-embedding-3-small, text-embedding-3-large (text)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Cohere"}]},{"type":"text","value":": embed-v4.0 (text + image, fused multimodal)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Google Gemini"}]},{"type":"text","value":": gemini-embedding-001 (text)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Mistral"}]},{"type":"text","value":": mistral-embed, codestral-embed (text)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Amazon Bedrock"}]},{"type":"text","value":": Titan Text Embeddings V2 (text), Titan Multimodal Embeddings G1 (text + image), Cohere Embed v3 on Bedrock (text)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Ollama"}]},{"type":"text","value":": nomic-embed-text, mxbai-embed-large, and any local embedding model (text)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Vercel AI Gateway"}]},{"type":"text","value":": OpenAI-compatible embedding models such as openai/text-embedding-3-small (text)"}]}]}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-small\"),\n  input: \"a red guitar\",\n});\n\nconsole.log(result.embeddings[0]?.vector); // number[]","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Vercel AI Gateway uses the same "},{"type":"inlineCode","value":"embed()"},{"type":"text","value":" call. Pass a "},{"type":"inlineCode","value":"creator/model"},{"type":"text","value":" id such as "},{"type":"inlineCode","value":"openai/text-embedding-3-small"},{"type":"text","value":":"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { vercelGatewayEmbedding } from \"@tanstack/ai-vercel-gateway\";\n\nconst result = await embed({\n  adapter: vercelGatewayEmbedding(\"openai/text-embedding-3-small\"),\n  input: \"a red guitar\",\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"input"},{"type":"text","value":" accepts a single item or an array of items; the result always carries an "},{"type":"inlineCode","value":"embeddings"},{"type":"text","value":" array with one vector per input item, in input order:"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-large\"),\n  input: [\"a red guitar\", \"a blue drum kit\", \"a vintage synthesizer\"],\n});\n\nfor (const embedding of result.embeddings) {\n  console.log(embedding.index, embedding.vector.length);\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"requesting-dimensions","children":[{"type":"text","value":"Requesting Dimensions"}]},{"type":"paragraph","children":[{"type":"text","value":"Models with configurable (Matryoshka) dimensions accept a top-level "},{"type":"inlineCode","value":"dimensions"},{"type":"text","value":" option:"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-large\"),\n  input: \"a red guitar\",\n  dimensions: 1024,\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Adapters for fixed-dimension models (for example "},{"type":"inlineCode","value":"mistral-embed"},{"type":"text","value":" or Ollama models) throw a clear runtime error when "},{"type":"inlineCode","value":"dimensions"},{"type":"text","value":" is set."}]},{"type":"heading","depth":2,"id":"multimodal-embeddings","children":[{"type":"text","value":"Multimodal Embeddings"}]},{"type":"paragraph","children":[{"type":"text","value":"Multimodal models embed images — alone, or fused with text into a single vector. Image inputs reuse the same content-part shapes as chat messages, and the accepted item types are narrowed per model at compile time: passing an image to a text-only model is a type error."}]},{"type":"paragraph","children":[{"type":"text","value":"The top-level "},{"type":"inlineCode","value":"input"},{"type":"text","value":" array is always the list of items, and "},{"type":"strong","children":[{"type":"text","value":"each item produces exactly one vector"}]},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"a string or text part embeds that text"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"an image part embeds that image"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"a "},{"type":"strong","children":[{"type":"text","value":"nested array of parts"}]},{"type":"text","value":" ("},{"type":"inlineCode","value":"[textPart, imagePart]"},{"type":"text","value":") fuses those parts into one vector — the same "},{"type":"inlineCode","value":"Array<ContentPart>"},{"type":"text","value":" shape a chat message's "},{"type":"inlineCode","value":"content"},{"type":"text","value":" uses"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Because a top-level array is the item list, fuse by nesting: "},{"type":"inlineCode","value":"[textPart, imagePart]"},{"type":"text","value":" is two vectors, while "},{"type":"inlineCode","value":"[[textPart, imagePart]]"},{"type":"text","value":" is one fused vector."}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { cohereEmbedding } from \"@tanstack/ai-cohere\";\n\nconst productPhoto = \"iVBORw0KGgo...\"; // base64 image data\n\nconst result = await embed({\n  adapter: cohereEmbedding(\"embed-v4.0\"),\n  input: [\n    \"a red guitar\",\n    {\n      type: \"image\",\n      source: {\n        type: \"data\",\n        value: productPhoto,\n        mimeType: \"image/png\",\n      },\n    },\n    // A nested array fuses its parts into a single vector.\n    [\n      { type: \"text\", content: \"Fender Stratocaster, sunburst finish\" },\n      {\n        type: \"image\",\n        source: {\n          type: \"data\",\n          value: productPhoto,\n          mimeType: \"image/png\",\n        },\n      },\n    ],\n  ],\n  modelOptions: { inputType: \"search_document\" },\n});\n\nconsole.log(result.embeddings.length); // 3 — one vector per input item","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Amazon Titan Multimodal works the same way — nest the parts to fuse them into one vector:"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { bedrockEmbedding } from \"@tanstack/ai-bedrock\";\n\nconst productPhoto = \"iVBORw0KGgo...\"; // base64 image data\n\nconst result = await embed({\n  adapter: bedrockEmbedding(\"amazon.titan-embed-image-v1\"),\n  input: [\n    [\n      { type: \"text\", content: \"a red guitar\" },\n      {\n        type: \"image\",\n        source: {\n          type: \"data\",\n          value: productPhoto,\n          mimeType: \"image/png\",\n        },\n      },\n    ],\n  ],\n  dimensions: 1024,\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Adapters do not fetch remote image URLs by default — pass base64 data (or a "},{"type":"inlineCode","value":"data:"},{"type":"text","value":" URI). The Cohere adapter accepts an "},{"type":"inlineCode","value":"allowUrlFetch"},{"type":"text","value":" config option to opt into downloading "},{"type":"inlineCode","value":"http(s)"},{"type":"text","value":" image URLs on your behalf."}]},{"type":"heading","depth":2,"id":"search-documents-vs-queries","children":[{"type":"text","value":"Search Documents vs. Queries"}]},{"type":"paragraph","children":[{"type":"text","value":"Retrieval-tuned models embed documents and queries differently. Cohere requires an "},{"type":"inlineCode","value":"inputType"},{"type":"text","value":", which TanStack AI enforces at the type level — "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" is required for models with required options:"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { cohereEmbedding } from \"@tanstack/ai-cohere\";\n\n// Index time: embed documents\nconst docs = await embed({\n  adapter: cohereEmbedding(\"embed-v4.0\"),\n  input: [\"doc one\", \"doc two\"],\n  modelOptions: { inputType: \"search_document\" },\n});\n\n// Query time: embed the query\nconst query = await embed({\n  adapter: cohereEmbedding(\"embed-v4.0\"),\n  input: \"which doc mentions one?\",\n  modelOptions: { inputType: \"search_query\" },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Gemini expresses the same idea through an optional "},{"type":"inlineCode","value":"taskType"},{"type":"text","value":":"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { geminiEmbedding } from \"@tanstack/ai-gemini\";\n\nconst result = await embed({\n  adapter: geminiEmbedding(\"gemini-embedding-001\"),\n  input: \"a red guitar\",\n  modelOptions: { taskType: \"RETRIEVAL_DOCUMENT\" },\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"usage-and-observability","children":[{"type":"text","value":"Usage and Observability"}]},{"type":"paragraph","children":[{"type":"text","value":"Adapters report token usage when the provider does, and "},{"type":"inlineCode","value":"embed()"},{"type":"text","value":" supports the same observe-only generation middleware as the media activities (see "},{"type":"link","href":"./media/generation-hooks.md","children":[{"type":"text","value":"Generation Hooks"}]},{"type":"text","value":"):"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-small\"),\n  input: [\"a red guitar\", \"a blue drum kit\"],\n  middleware: [\n    {\n      name: \"usage-logger\",\n      onUsage: (ctx, usage) => {\n        console.log(`${ctx.model}: ${usage.promptTokens} tokens`);\n      },\n    },\n  ],\n});\n\nconsole.log(result.usage?.promptTokens);","lang":"typescript"},{"type":"heading","depth":2,"id":"error-handling","children":[{"type":"text","value":"Error Handling"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"embed()"},{"type":"text","value":" rejects with the provider error; middleware "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" hooks run before the rejection propagates:"}]},{"type":"code","value":"import { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\ntry {\n  await embed({\n    adapter: openaiEmbedding(\"text-embedding-3-small\"),\n    input: \"a red guitar\",\n  });\n} catch (error) {\n  console.error(\"embedding failed\", error);\n}","lang":"typescript"}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"requesting-dimensions","text":"Requesting Dimensions","level":2},{"id":"multimodal-embeddings","text":"Multimodal Embeddings","level":2},{"id":"search-documents-vs-queries","text":"Search Documents vs. Queries","level":2},{"id":"usage-and-observability","text":"Usage and Observability","level":2},{"id":"error-handling","text":"Error Handling","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack AI provides embedding generation through dedicated embedding adapters that follow the same tree-shakeable, per-model-typed architecture as every other activity. The `embed()` function turns text — and, for multimodal models, images — into vectors for semantic search, RAG, clustering, and classification.\n\n## Overview\n\nCurrently supported:\n\n- **OpenAI**: text-embedding-3-small, text-embedding-3-large (text)\n- **Cohere**: embed-v4.0 (text + image, fused multimodal)\n- **Google Gemini**: gemini-embedding-001 (text)\n- **Mistral**: mistral-embed, codestral-embed (text)\n- **Amazon Bedrock**: Titan Text Embeddings V2 (text), Titan Multimodal Embeddings G1 (text + image), Cohere Embed v3 on Bedrock (text)\n- **Ollama**: nomic-embed-text, mxbai-embed-large, and any local embedding model (text)\n- **Vercel AI Gateway**: OpenAI-compatible embedding models such as openai/text-embedding-3-small (text)\n\n## Basic Usage\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-small\"),\n  input: \"a red guitar\",\n});\n\nconsole.log(result.embeddings[0]?.vector); // number[]\n```\n\nVercel AI Gateway uses the same `embed()` call. Pass a `creator/model` id such as `openai/text-embedding-3-small`:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { vercelGatewayEmbedding } from \"@tanstack/ai-vercel-gateway\";\n\nconst result = await embed({\n  adapter: vercelGatewayEmbedding(\"openai/text-embedding-3-small\"),\n  input: \"a red guitar\",\n});\n```\n\n`input` accepts a single item or an array of items; the result always carries an `embeddings` array with one vector per input item, in input order:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-large\"),\n  input: [\"a red guitar\", \"a blue drum kit\", \"a vintage synthesizer\"],\n});\n\nfor (const embedding of result.embeddings) {\n  console.log(embedding.index, embedding.vector.length);\n}\n```\n\n## Requesting Dimensions\n\nModels with configurable (Matryoshka) dimensions accept a top-level `dimensions` option:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-large\"),\n  input: \"a red guitar\",\n  dimensions: 1024,\n});\n```\n\nAdapters for fixed-dimension models (for example `mistral-embed` or Ollama models) throw a clear runtime error when `dimensions` is set.\n\n## Multimodal Embeddings\n\nMultimodal models embed images — alone, or fused with text into a single vector. Image inputs reuse the same content-part shapes as chat messages, and the accepted item types are narrowed per model at compile time: passing an image to a text-only model is a type error.\n\nThe top-level `input` array is always the list of items, and **each item produces exactly one vector**:\n\n- a string or text part embeds that text\n- an image part embeds that image\n- a **nested array of parts** (`[textPart, imagePart]`) fuses those parts into one vector — the same `Array<ContentPart>` shape a chat message's `content` uses\n\nBecause a top-level array is the item list, fuse by nesting: `[textPart, imagePart]` is two vectors, while `[[textPart, imagePart]]` is one fused vector.\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { cohereEmbedding } from \"@tanstack/ai-cohere\";\n\nconst productPhoto = \"iVBORw0KGgo...\"; // base64 image data\n\nconst result = await embed({\n  adapter: cohereEmbedding(\"embed-v4.0\"),\n  input: [\n    \"a red guitar\",\n    {\n      type: \"image\",\n      source: {\n        type: \"data\",\n        value: productPhoto,\n        mimeType: \"image/png\",\n      },\n    },\n    // A nested array fuses its parts into a single vector.\n    [\n      { type: \"text\", content: \"Fender Stratocaster, sunburst finish\" },\n      {\n        type: \"image\",\n        source: {\n          type: \"data\",\n          value: productPhoto,\n          mimeType: \"image/png\",\n        },\n      },\n    ],\n  ],\n  modelOptions: { inputType: \"search_document\" },\n});\n\nconsole.log(result.embeddings.length); // 3 — one vector per input item\n```\n\nAmazon Titan Multimodal works the same way — nest the parts to fuse them into one vector:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { bedrockEmbedding } from \"@tanstack/ai-bedrock\";\n\nconst productPhoto = \"iVBORw0KGgo...\"; // base64 image data\n\nconst result = await embed({\n  adapter: bedrockEmbedding(\"amazon.titan-embed-image-v1\"),\n  input: [\n    [\n      { type: \"text\", content: \"a red guitar\" },\n      {\n        type: \"image\",\n        source: {\n          type: \"data\",\n          value: productPhoto,\n          mimeType: \"image/png\",\n        },\n      },\n    ],\n  ],\n  dimensions: 1024,\n});\n```\n\nAdapters do not fetch remote image URLs by default — pass base64 data (or a `data:` URI). The Cohere adapter accepts an `allowUrlFetch` config option to opt into downloading `http(s)` image URLs on your behalf.\n\n## Search Documents vs. Queries\n\nRetrieval-tuned models embed documents and queries differently. Cohere requires an `inputType`, which TanStack AI enforces at the type level — `modelOptions` is required for models with required options:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { cohereEmbedding } from \"@tanstack/ai-cohere\";\n\n// Index time: embed documents\nconst docs = await embed({\n  adapter: cohereEmbedding(\"embed-v4.0\"),\n  input: [\"doc one\", \"doc two\"],\n  modelOptions: { inputType: \"search_document\" },\n});\n\n// Query time: embed the query\nconst query = await embed({\n  adapter: cohereEmbedding(\"embed-v4.0\"),\n  input: \"which doc mentions one?\",\n  modelOptions: { inputType: \"search_query\" },\n});\n```\n\nGemini expresses the same idea through an optional `taskType`:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { geminiEmbedding } from \"@tanstack/ai-gemini\";\n\nconst result = await embed({\n  adapter: geminiEmbedding(\"gemini-embedding-001\"),\n  input: \"a red guitar\",\n  modelOptions: { taskType: \"RETRIEVAL_DOCUMENT\" },\n});\n```\n\n## Usage and Observability\n\nAdapters report token usage when the provider does, and `embed()` supports the same observe-only generation middleware as the media activities (see [Generation Hooks](./media/generation-hooks.md)):\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-small\"),\n  input: [\"a red guitar\", \"a blue drum kit\"],\n  middleware: [\n    {\n      name: \"usage-logger\",\n      onUsage: (ctx, usage) => {\n        console.log(`${ctx.model}: ${usage.promptTokens} tokens`);\n      },\n    },\n  ],\n});\n\nconsole.log(result.usage?.promptTokens);\n```\n\n## Error Handling\n\n`embed()` rejects with the provider error; middleware `onError` hooks run before the rejection propagates:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\ntry {\n  await embed({\n    adapter: openaiEmbedding(\"text-embedding-3-small\"),\n    input: \"a red guitar\",\n  });\n} catch (error) {\n  console.error(\"embedding failed\", error);\n}\n```\n","originalRawMarkdown":"---\ntitle: Embeddings\nid: embeddings\norder: 1\ndescription: \"Generate text and multimodal embedding vectors with OpenAI, Cohere, Gemini, Mistral, Amazon Bedrock, Ollama, and Vercel AI Gateway via TanStack AI's embed() API.\"\nkeywords:\n  - tanstack ai\n  - embeddings\n  - embedding vectors\n  - multimodal embeddings\n  - semantic search\n  - rag\n  - embed\n  - openai\n  - cohere\n  - gemini\n  - mistral\n  - bedrock\n  - ollama\n  - vercel ai gateway\n---\n\nTanStack AI provides embedding generation through dedicated embedding adapters that follow the same tree-shakeable, per-model-typed architecture as every other activity. The `embed()` function turns text — and, for multimodal models, images — into vectors for semantic search, RAG, clustering, and classification.\n\n## Overview\n\nCurrently supported:\n\n- **OpenAI**: text-embedding-3-small, text-embedding-3-large (text)\n- **Cohere**: embed-v4.0 (text + image, fused multimodal)\n- **Google Gemini**: gemini-embedding-001 (text)\n- **Mistral**: mistral-embed, codestral-embed (text)\n- **Amazon Bedrock**: Titan Text Embeddings V2 (text), Titan Multimodal Embeddings G1 (text + image), Cohere Embed v3 on Bedrock (text)\n- **Ollama**: nomic-embed-text, mxbai-embed-large, and any local embedding model (text)\n- **Vercel AI Gateway**: OpenAI-compatible embedding models such as openai/text-embedding-3-small (text)\n\n## Basic Usage\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-small\"),\n  input: \"a red guitar\",\n});\n\nconsole.log(result.embeddings[0]?.vector); // number[]\n```\n\nVercel AI Gateway uses the same `embed()` call. Pass a `creator/model` id such as `openai/text-embedding-3-small`:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { vercelGatewayEmbedding } from \"@tanstack/ai-vercel-gateway\";\n\nconst result = await embed({\n  adapter: vercelGatewayEmbedding(\"openai/text-embedding-3-small\"),\n  input: \"a red guitar\",\n});\n```\n\n`input` accepts a single item or an array of items; the result always carries an `embeddings` array with one vector per input item, in input order:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-large\"),\n  input: [\"a red guitar\", \"a blue drum kit\", \"a vintage synthesizer\"],\n});\n\nfor (const embedding of result.embeddings) {\n  console.log(embedding.index, embedding.vector.length);\n}\n```\n\n## Requesting Dimensions\n\nModels with configurable (Matryoshka) dimensions accept a top-level `dimensions` option:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-large\"),\n  input: \"a red guitar\",\n  dimensions: 1024,\n});\n```\n\nAdapters for fixed-dimension models (for example `mistral-embed` or Ollama models) throw a clear runtime error when `dimensions` is set.\n\n## Multimodal Embeddings\n\nMultimodal models embed images — alone, or fused with text into a single vector. Image inputs reuse the same content-part shapes as chat messages, and the accepted item types are narrowed per model at compile time: passing an image to a text-only model is a type error.\n\nThe top-level `input` array is always the list of items, and **each item produces exactly one vector**:\n\n- a string or text part embeds that text\n- an image part embeds that image\n- a **nested array of parts** (`[textPart, imagePart]`) fuses those parts into one vector — the same `Array<ContentPart>` shape a chat message's `content` uses\n\nBecause a top-level array is the item list, fuse by nesting: `[textPart, imagePart]` is two vectors, while `[[textPart, imagePart]]` is one fused vector.\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { cohereEmbedding } from \"@tanstack/ai-cohere\";\n\nconst productPhoto = \"iVBORw0KGgo...\"; // base64 image data\n\nconst result = await embed({\n  adapter: cohereEmbedding(\"embed-v4.0\"),\n  input: [\n    \"a red guitar\",\n    {\n      type: \"image\",\n      source: {\n        type: \"data\",\n        value: productPhoto,\n        mimeType: \"image/png\",\n      },\n    },\n    // A nested array fuses its parts into a single vector.\n    [\n      { type: \"text\", content: \"Fender Stratocaster, sunburst finish\" },\n      {\n        type: \"image\",\n        source: {\n          type: \"data\",\n          value: productPhoto,\n          mimeType: \"image/png\",\n        },\n      },\n    ],\n  ],\n  modelOptions: { inputType: \"search_document\" },\n});\n\nconsole.log(result.embeddings.length); // 3 — one vector per input item\n```\n\nAmazon Titan Multimodal works the same way — nest the parts to fuse them into one vector:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { bedrockEmbedding } from \"@tanstack/ai-bedrock\";\n\nconst productPhoto = \"iVBORw0KGgo...\"; // base64 image data\n\nconst result = await embed({\n  adapter: bedrockEmbedding(\"amazon.titan-embed-image-v1\"),\n  input: [\n    [\n      { type: \"text\", content: \"a red guitar\" },\n      {\n        type: \"image\",\n        source: {\n          type: \"data\",\n          value: productPhoto,\n          mimeType: \"image/png\",\n        },\n      },\n    ],\n  ],\n  dimensions: 1024,\n});\n```\n\nAdapters do not fetch remote image URLs by default — pass base64 data (or a `data:` URI). The Cohere adapter accepts an `allowUrlFetch` config option to opt into downloading `http(s)` image URLs on your behalf.\n\n## Search Documents vs. Queries\n\nRetrieval-tuned models embed documents and queries differently. Cohere requires an `inputType`, which TanStack AI enforces at the type level — `modelOptions` is required for models with required options:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { cohereEmbedding } from \"@tanstack/ai-cohere\";\n\n// Index time: embed documents\nconst docs = await embed({\n  adapter: cohereEmbedding(\"embed-v4.0\"),\n  input: [\"doc one\", \"doc two\"],\n  modelOptions: { inputType: \"search_document\" },\n});\n\n// Query time: embed the query\nconst query = await embed({\n  adapter: cohereEmbedding(\"embed-v4.0\"),\n  input: \"which doc mentions one?\",\n  modelOptions: { inputType: \"search_query\" },\n});\n```\n\nGemini expresses the same idea through an optional `taskType`:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { geminiEmbedding } from \"@tanstack/ai-gemini\";\n\nconst result = await embed({\n  adapter: geminiEmbedding(\"gemini-embedding-001\"),\n  input: \"a red guitar\",\n  modelOptions: { taskType: \"RETRIEVAL_DOCUMENT\" },\n});\n```\n\n## Usage and Observability\n\nAdapters report token usage when the provider does, and `embed()` supports the same observe-only generation middleware as the media activities (see [Generation Hooks](./media/generation-hooks.md)):\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\nconst result = await embed({\n  adapter: openaiEmbedding(\"text-embedding-3-small\"),\n  input: [\"a red guitar\", \"a blue drum kit\"],\n  middleware: [\n    {\n      name: \"usage-logger\",\n      onUsage: (ctx, usage) => {\n        console.log(`${ctx.model}: ${usage.promptTokens} tokens`);\n      },\n    },\n  ],\n});\n\nconsole.log(result.usage?.promptTokens);\n```\n\n## Error Handling\n\n`embed()` rejects with the provider error; middleware `onError` hooks run before the rejection propagates:\n\n```typescript\nimport { embed } from \"@tanstack/ai\";\nimport { openaiEmbedding } from \"@tanstack/ai-openai\";\n\ntry {\n  await embed({\n    adapter: openaiEmbedding(\"text-embedding-3-small\"),\n    input: \"a red guitar\",\n  });\n} catch (error) {\n  console.error(\"embedding failed\", error);\n}\n```\n"}
