NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Use a generic interrupt when the server needs data from the client but no tool\ncall caused the request. For example, ask the user to select a plan before the\nmodel runs."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"defineInterrupt"},{"type":"text","value":" defines the data that the client sees and the data it must\nreturn. Register the same definition with "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" and "},{"type":"inlineCode","value":"useChat()"},{"type":"text","value":". This gives\nboth sides the same types."}]},{"type":"heading","depth":2,"id":"define-and-emit-an-interrupt","children":[{"type":"text","value":"Define and emit an interrupt"}]},{"type":"paragraph","children":[{"type":"text","value":"Put the definition in a module that both the route and the client can import.\nThe schemas must export JSON Schema."}]},{"type":"code","value":"// app/interrupts.ts\nimport { defineInterrupt } from '@tanstack/ai'\nimport { z } from 'zod'\n\nexport const reviewPlan = defineInterrupt({\n  id: 'review-plan',\n  payloadSchema: z.object({ title: z.string(), changes: z.array(z.string()) }),\n  responseSchema: z.object({ approved: z.boolean(), note: z.string().optional() }),\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"payloadSchema"},{"type":"text","value":" describes display data that travels from the server to the\nclient. "},{"type":"inlineCode","value":"responseSchema"},{"type":"text","value":" describes data that travels from the client back to\nthe server. The display payload is optional. The response schema is required."}]},{"type":"paragraph","children":[{"type":"text","value":"Return requests from "},{"type":"inlineCode","value":"onInterruptBoundary"},{"type":"text","value":". The hook can run at each value in\n"},{"type":"inlineCode","value":"INTERRUPT_BOUNDARY_PHASES"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"beforeModel"},{"type":"text","value":": before the adapter call"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"afterModel"},{"type":"text","value":": after the model stream ends"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"beforeTools"},{"type":"text","value":": before tool execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"afterTools"},{"type":"text","value":": after tool results are in "},{"type":"inlineCode","value":"messages"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Requests from every middleware in the same boundary form one interrupt batch."}]},{"type":"paragraph","children":[{"type":"text","value":"Pick the phase with a "},{"type":"inlineCode","value":"ctx.phase"},{"type":"text","value":" guard. If "},{"type":"inlineCode","value":"ctx.parentRunId"},{"type":"text","value":" is set, skip\nthe emit. If you do not, the same pause happens again."}]},{"type":"paragraph","children":[{"type":"text","value":"When to use each phase, and what "},{"type":"inlineCode","value":"ctx"},{"type":"text","value":" contains there, is in\n"},{"type":"link","href":"./boundaries","children":[{"type":"text","value":"Lifecycle Boundaries"}]},{"type":"text","value":"."}]},{"type":"code","value":"// app/chat-middleware.ts\nimport type { ChatMiddleware } from '@tanstack/ai'\nimport { reviewPlan } from './interrupts'\n\nexport const requestReview: ChatMiddleware<unknown, typeof reviewPlan> = {\n  name: 'request-review',\n  onInterruptBoundary(ctx) {\n    if (ctx.phase !== 'beforeModel') return\n    if (ctx.parentRunId) return\n    if (ctx.iteration !== 0) return\n    return {\n      interrupts: [\n        reviewPlan.interrupt({\n          key: 'initial-plan',\n          reason: 'review-required',\n          message: 'Review the proposed plan.',\n          payload: { title: 'Release plan', changes: ['Add search', 'Add tests'] },\n        }),\n      ],\n    }\n  },\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"interrupt()"},{"type":"text","value":" accepts only "},{"type":"inlineCode","value":"key"},{"type":"text","value":", "},{"type":"inlineCode","value":"reason"},{"type":"text","value":", "},{"type":"inlineCode","value":"message"},{"type":"text","value":", "},{"type":"inlineCode","value":"expiresAt"},{"type":"text","value":", and, when\ndeclared, "},{"type":"inlineCode","value":"payload"},{"type":"text","value":". It returns an immutable request. Do not put secrets in the\npayload because the client receives it and persistence can store it."}]},{"type":"heading","depth":2,"id":"register-it-on-the-server","children":[{"type":"text","value":"Register it on the server"}]},{"type":"paragraph","children":[{"type":"text","value":"Register all definitions on "},{"type":"inlineCode","value":"chat({ interrupts })"},{"type":"text","value":". A duplicate definition id\nfails before the adapter starts."}]},{"type":"code","value":"// app/api/chat/route.ts\nimport { chat, chatParamsFromRequest, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { requestReview } from '../../chat-middleware'\nimport { reviewPlan } from '../../interrupts'\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request)\n  const stream = chat({\n    adapter: openaiText('gpt-5.5'),\n    messages: params.messages,\n    threadId: params.threadId,\n    runId: params.runId,\n    ...(params.parentRunId ? { parentRunId: params.parentRunId } : {}),\n    ...(params.resume ? { resume: params.resume } : {}),\n    interrupts: [reviewPlan],\n    middleware: [requestReview],\n  })\n  return toServerSentEventsResponse(stream)\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"An interrupt ends the current AG-UI run with one "},{"type":"inlineCode","value":"RUN_FINISHED"},{"type":"text","value":" event whose\noutcome is "},{"type":"inlineCode","value":"interrupt"},{"type":"text","value":". Resolving it starts a new run with "},{"type":"inlineCode","value":"parentRunId"},{"type":"text","value":" set to\nthe interrupted run. The continuation carries the response to the registered\nmiddleware."}]},{"type":"heading","depth":2,"id":"resolve-it-in-react","children":[{"type":"text","value":"Resolve it in React"}]},{"type":"paragraph","children":[{"type":"text","value":"Register the same definitions with "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":". A bound generic interrupt has its\ndefinition id, typed display payload, and typed "},{"type":"inlineCode","value":"resolveInterrupt"},{"type":"text","value":" method."}]},{"type":"paragraph","children":[{"type":"text","value":"Check "},{"type":"inlineCode","value":"kind"},{"type":"text","value":" and "},{"type":"inlineCode","value":"definitionId"},{"type":"text","value":". Then pass the item to a card that takes\n"},{"type":"inlineCode","value":"GenericInterrupt<typeof reviewPlan>"},{"type":"text","value":"."}]},{"type":"code","value":"// app/plan-review.tsx\nimport { fetchServerSentEvents, useChat } from '@tanstack/ai-react'\nimport type { GenericInterrupt } from '@tanstack/ai-react'\nimport { reviewPlan } from './interrupts'\n\nfunction ReviewCard({\n  interrupt,\n}: {\n  interrupt: GenericInterrupt<typeof reviewPlan>\n}) {\n  return (\n    <article>\n      <h2>{interrupt.payload?.title}</h2>\n      <button onClick={() => interrupt.resolveInterrupt({ approved: true })}>\n        Approve\n      </button>\n      <button onClick={() => interrupt.cancel()}>Cancel</button>\n    </article>\n  )\n}\n\nexport function PlanReview() {\n  const { interrupts } = useChat({\n    threadId: 'release-42',\n    connection: fetchServerSentEvents('/api/chat'),\n    interrupts: [reviewPlan],\n  })\n\n  return (\n    <>\n      {interrupts.map((interrupt) => {\n        if (interrupt.kind !== 'generic') return null\n        if (!('definitionId' in interrupt)) return null\n        if (interrupt.definitionId !== reviewPlan.id) return null\n        return <ReviewCard key={interrupt.id} interrupt={interrupt} />\n      })}\n    </>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"resolveInterrupt"},{"type":"text","value":" stages the answer. The client sends one continuation only\nafter every bound interrupt in the batch is resolved or cancelled. Use\n"},{"type":"inlineCode","value":"cancel()"},{"type":"text","value":" when the user declines to provide data."}]},{"type":"heading","depth":2,"id":"read-resumed-values-in-middleware","children":[{"type":"text","value":"Read resumed values in middleware"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"onInterruptResolution"},{"type":"text","value":" does not run in the "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" call that paused. It runs\nonce at the start of the "},{"type":"strong","children":[{"type":"text","value":"next"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" call, after the client answers."}]},{"type":"paragraph","children":[{"type":"text","value":"That second call is a new run. "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" sends "},{"type":"inlineCode","value":"parentRunId"},{"type":"text","value":" and "},{"type":"inlineCode","value":"resume"},{"type":"text","value":".\nEach generic resume item carries the original request in "},{"type":"inlineCode","value":"metadata"},{"type":"text","value":". The hook\nruns after init "},{"type":"inlineCode","value":"onConfig"},{"type":"text","value":" and before "},{"type":"inlineCode","value":"onStart"},{"type":"text","value":". "},{"type":"inlineCode","value":"ctx.phase"},{"type":"text","value":" is still "},{"type":"inlineCode","value":"'init'"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"for(definition)"},{"type":"text","value":" keeps the response type for that definition. "},{"type":"inlineCode","value":"all()"},{"type":"text","value":" reads\nall registered definitions. "},{"type":"inlineCode","value":"all(definitionA, definitionB)"},{"type":"text","value":" narrows the\nresult to those definitions."}]},{"type":"code","value":"import type { ChatMiddleware } from '@tanstack/ai'\nimport { reviewPlan } from './interrupts'\n\nexport const applyReview: ChatMiddleware<unknown, typeof reviewPlan> = {\n  name: 'apply-review',\n  onInterruptResolution(_ctx, resumedInterrupts) {\n    for (const result of resumedInterrupts.for(reviewPlan)) {\n      if (result.status === 'resolved' && !result.response.approved) {\n        return { toolResume: 'stop' }\n      }\n    }\n  },\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Middleware can return "},{"type":"inlineCode","value":"toolResume: 'continue'"},{"type":"text","value":", "},{"type":"inlineCode","value":"'cancel'"},{"type":"text","value":", or "},{"type":"inlineCode","value":"'stop'"},{"type":"text","value":".\nWhen more than one middleware returns a value, "},{"type":"inlineCode","value":"stop"},{"type":"text","value":" wins over "},{"type":"inlineCode","value":"cancel"},{"type":"text","value":", and\n"},{"type":"inlineCode","value":"cancel"},{"type":"text","value":" wins over "},{"type":"inlineCode","value":"continue"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"This hook cannot change prompts, tools, or messages. Store the answer on a\ncapability, then return those fields from "},{"type":"inlineCode","value":"onConfig"},{"type":"text","value":" when\n"},{"type":"inlineCode","value":"ctx.phase === 'beforeModel'"},{"type":"text","value":". The full order, plus a working example, is in\n"},{"type":"link","href":"./apply-answers","children":[{"type":"text","value":"Apply Answers"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"try-the-four-lifecycle-phases","children":[{"type":"text","value":"Try the four lifecycle phases"}]},{"type":"paragraph","children":[{"type":"text","value":"The React chat example has a playground for "},{"type":"inlineCode","value":"beforeModel"},{"type":"text","value":", "},{"type":"inlineCode","value":"afterModel"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"beforeTools"},{"type":"text","value":", and "},{"type":"inlineCode","value":"afterTools"},{"type":"text","value":". Each pause shows two typed cards:\n"},{"type":"inlineCode","value":"reviewPlan"},{"type":"text","value":" and "},{"type":"inlineCode","value":"chooseAudience"},{"type":"text","value":"."}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Start "},{"type":"inlineCode","value":"examples/ts-react-chat"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Open "},{"type":"inlineCode","value":"/generic-interrupts"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Pick a phase, resolve both cards, and watch the selected policy."}]}]}]},{"type":"heading","depth":2,"id":"external-generic-interrupts","children":[{"type":"text","value":"External generic interrupts"}]},{"type":"paragraph","children":[{"type":"text","value":"An external system can emit a standard AG-UI generic interrupt. TanStack AI\nshows it as "},{"type":"inlineCode","value":"kind: 'unbound'"},{"type":"text","value":" unless it has a valid TanStack binding. It stays\nvisible, but it has no resolve or cancel method. This keeps another system from\nreceiving a continuation that TanStack AI owns."}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"./multiple","children":[{"type":"text","value":"Multiple Interrupts"}]},{"type":"text","value":" for mixed tool approvals and generic\ninterrupts. See "},{"type":"link","href":"../persistence/chat-persistence","children":[{"type":"text","value":"Chat persistence"}]},{"type":"text","value":" when an\ninterrupt must survive a restart."}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"You want to"}]},{"type":"tableCell","children":[{"type":"text","value":"Page"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Pick "},{"type":"inlineCode","value":"beforeModel"},{"type":"text","value":", "},{"type":"inlineCode","value":"afterModel"},{"type":"text","value":", "},{"type":"inlineCode","value":"beforeTools"},{"type":"text","value":", or "},{"type":"inlineCode","value":"afterTools"}]},{"type":"tableCell","children":[{"type":"link","href":"./boundaries","children":[{"type":"text","value":"Lifecycle Boundaries"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"Apply the user answer to prompts, tools, or "},{"type":"inlineCode","value":"toolResume"}]},{"type":"tableCell","children":[{"type":"link","href":"./apply-answers","children":[{"type":"text","value":"Apply Answers"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"Mix generic interrupts with tool approvals"}]},{"type":"tableCell","children":[{"type":"link","href":"./multiple","children":[{"type":"text","value":"Multiple Interrupts"}]}]}]]}],"headings":[{"id":"define-and-emit-an-interrupt","text":"Define and emit an interrupt","level":2},{"id":"register-it-on-the-server","text":"Register it on the server","level":2},{"id":"resolve-it-in-react","text":"Resolve it in React","level":2},{"id":"read-resumed-values-in-middleware","text":"Read resumed values in middleware","level":2},{"id":"try-the-four-lifecycle-phases","text":"Try the four lifecycle phases","level":2},{"id":"external-generic-interrupts","text":"External generic interrupts","level":2}]},"frameworks":[],"downloadMarkdown":"\nUse a generic interrupt when the server needs data from the client but no tool\ncall caused the request. For example, ask the user to select a plan before the\nmodel runs.\n\n`defineInterrupt` defines the data that the client sees and the data it must\nreturn. Register the same definition with `chat()` and `useChat()`. This gives\nboth sides the same types.\n\n## Define and emit an interrupt\n\nPut the definition in a module that both the route and the client can import.\nThe schemas must export JSON Schema.\n\n```ts\n// app/interrupts.ts\nimport { defineInterrupt } from '@tanstack/ai'\nimport { z } from 'zod'\n\nexport const reviewPlan = defineInterrupt({\n  id: 'review-plan',\n  payloadSchema: z.object({ title: z.string(), changes: z.array(z.string()) }),\n  responseSchema: z.object({ approved: z.boolean(), note: z.string().optional() }),\n})\n```\n\n`payloadSchema` describes display data that travels from the server to the\nclient. `responseSchema` describes data that travels from the client back to\nthe server. The display payload is optional. The response schema is required.\n\nReturn requests from `onInterruptBoundary`. The hook can run at each value in\n`INTERRUPT_BOUNDARY_PHASES`:\n\n- `beforeModel`: before the adapter call\n- `afterModel`: after the model stream ends\n- `beforeTools`: before tool execution\n- `afterTools`: after tool results are in `messages`\n\nRequests from every middleware in the same boundary form one interrupt batch.\n\nPick the phase with a `ctx.phase` guard. If `ctx.parentRunId` is set, skip\nthe emit. If you do not, the same pause happens again.\n\nWhen to use each phase, and what `ctx` contains there, is in\n[Lifecycle Boundaries](./boundaries).\n\n```ts\n// app/chat-middleware.ts\nimport type { ChatMiddleware } from '@tanstack/ai'\nimport { reviewPlan } from './interrupts'\n\nexport const requestReview: ChatMiddleware<unknown, typeof reviewPlan> = {\n  name: 'request-review',\n  onInterruptBoundary(ctx) {\n    if (ctx.phase !== 'beforeModel') return\n    if (ctx.parentRunId) return\n    if (ctx.iteration !== 0) return\n    return {\n      interrupts: [\n        reviewPlan.interrupt({\n          key: 'initial-plan',\n          reason: 'review-required',\n          message: 'Review the proposed plan.',\n          payload: { title: 'Release plan', changes: ['Add search', 'Add tests'] },\n        }),\n      ],\n    }\n  },\n}\n```\n\n`interrupt()` accepts only `key`, `reason`, `message`, `expiresAt`, and, when\ndeclared, `payload`. It returns an immutable request. Do not put secrets in the\npayload because the client receives it and persistence can store it.\n\n## Register it on the server\n\nRegister all definitions on `chat({ interrupts })`. A duplicate definition id\nfails before the adapter starts.\n\n```ts\n// app/api/chat/route.ts\nimport { chat, chatParamsFromRequest, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { requestReview } from '../../chat-middleware'\nimport { reviewPlan } from '../../interrupts'\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request)\n  const stream = chat({\n    adapter: openaiText('gpt-5.5'),\n    messages: params.messages,\n    threadId: params.threadId,\n    runId: params.runId,\n    ...(params.parentRunId ? { parentRunId: params.parentRunId } : {}),\n    ...(params.resume ? { resume: params.resume } : {}),\n    interrupts: [reviewPlan],\n    middleware: [requestReview],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\nAn interrupt ends the current AG-UI run with one `RUN_FINISHED` event whose\noutcome is `interrupt`. Resolving it starts a new run with `parentRunId` set to\nthe interrupted run. The continuation carries the response to the registered\nmiddleware.\n\n## Resolve it in React\n\nRegister the same definitions with `useChat`. A bound generic interrupt has its\ndefinition id, typed display payload, and typed `resolveInterrupt` method.\n\nCheck `kind` and `definitionId`. Then pass the item to a card that takes\n`GenericInterrupt<typeof reviewPlan>`.\n\n```tsx\n// app/plan-review.tsx\nimport { fetchServerSentEvents, useChat } from '@tanstack/ai-react'\nimport type { GenericInterrupt } from '@tanstack/ai-react'\nimport { reviewPlan } from './interrupts'\n\nfunction ReviewCard({\n  interrupt,\n}: {\n  interrupt: GenericInterrupt<typeof reviewPlan>\n}) {\n  return (\n    <article>\n      <h2>{interrupt.payload?.title}</h2>\n      <button onClick={() => interrupt.resolveInterrupt({ approved: true })}>\n        Approve\n      </button>\n      <button onClick={() => interrupt.cancel()}>Cancel</button>\n    </article>\n  )\n}\n\nexport function PlanReview() {\n  const { interrupts } = useChat({\n    threadId: 'release-42',\n    connection: fetchServerSentEvents('/api/chat'),\n    interrupts: [reviewPlan],\n  })\n\n  return (\n    <>\n      {interrupts.map((interrupt) => {\n        if (interrupt.kind !== 'generic') return null\n        if (!('definitionId' in interrupt)) return null\n        if (interrupt.definitionId !== reviewPlan.id) return null\n        return <ReviewCard key={interrupt.id} interrupt={interrupt} />\n      })}\n    </>\n  )\n}\n```\n\n`resolveInterrupt` stages the answer. The client sends one continuation only\nafter every bound interrupt in the batch is resolved or cancelled. Use\n`cancel()` when the user declines to provide data.\n\n## Read resumed values in middleware\n\n`onInterruptResolution` does not run in the `chat()` call that paused. It runs\nonce at the start of the **next** `chat()` call, after the client answers.\n\nThat second call is a new run. `useChat` sends `parentRunId` and `resume`.\nEach generic resume item carries the original request in `metadata`. The hook\nruns after init `onConfig` and before `onStart`. `ctx.phase` is still `'init'`.\n\n`for(definition)` keeps the response type for that definition. `all()` reads\nall registered definitions. `all(definitionA, definitionB)` narrows the\nresult to those definitions.\n\n```ts\nimport type { ChatMiddleware } from '@tanstack/ai'\nimport { reviewPlan } from './interrupts'\n\nexport const applyReview: ChatMiddleware<unknown, typeof reviewPlan> = {\n  name: 'apply-review',\n  onInterruptResolution(_ctx, resumedInterrupts) {\n    for (const result of resumedInterrupts.for(reviewPlan)) {\n      if (result.status === 'resolved' && !result.response.approved) {\n        return { toolResume: 'stop' }\n      }\n    }\n  },\n}\n```\n\nMiddleware can return `toolResume: 'continue'`, `'cancel'`, or `'stop'`.\nWhen more than one middleware returns a value, `stop` wins over `cancel`, and\n`cancel` wins over `continue`.\n\nThis hook cannot change prompts, tools, or messages. Store the answer on a\ncapability, then return those fields from `onConfig` when\n`ctx.phase === 'beforeModel'`. The full order, plus a working example, is in\n[Apply Answers](./apply-answers).\n\n## Try the four lifecycle phases\n\nThe React chat example has a playground for `beforeModel`, `afterModel`,\n`beforeTools`, and `afterTools`. Each pause shows two typed cards:\n`reviewPlan` and `chooseAudience`.\n\n1. Start `examples/ts-react-chat`.\n2. Open `/generic-interrupts`.\n3. Pick a phase, resolve both cards, and watch the selected policy.\n\n## External generic interrupts\n\nAn external system can emit a standard AG-UI generic interrupt. TanStack AI\nshows it as `kind: 'unbound'` unless it has a valid TanStack binding. It stays\nvisible, but it has no resolve or cancel method. This keeps another system from\nreceiving a continuation that TanStack AI owns.\n\nSee [Multiple Interrupts](./multiple) for mixed tool approvals and generic\ninterrupts. See [Chat persistence](../persistence/chat-persistence) when an\ninterrupt must survive a restart.\n\n| You want to | Page |\n| --- | --- |\n| Pick `beforeModel`, `afterModel`, `beforeTools`, or `afterTools` | [Lifecycle Boundaries](./boundaries) |\n| Apply the user answer to prompts, tools, or `toolResume` | [Apply Answers](./apply-answers) |\n| Mix generic interrupts with tool approvals | [Multiple Interrupts](./multiple) |\n","originalRawMarkdown":"---\ntitle: Generic Interrupts\nid: interrupts-generic\norder: 4\ndescription: \"Ask for typed data from the client during a chat lifecycle boundary.\"\nkeywords:\n  - tanstack ai\n  - generic interrupt\n  - defineInterrupt\n  - onInterruptBoundary\n  - onInterruptResolution\n  - INTERRUPT_BOUNDARY_PHASES\n---\n\nUse a generic interrupt when the server needs data from the client but no tool\ncall caused the request. For example, ask the user to select a plan before the\nmodel runs.\n\n`defineInterrupt` defines the data that the client sees and the data it must\nreturn. Register the same definition with `chat()` and `useChat()`. This gives\nboth sides the same types.\n\n## Define and emit an interrupt\n\nPut the definition in a module that both the route and the client can import.\nThe schemas must export JSON Schema.\n\n```ts\n// app/interrupts.ts\nimport { defineInterrupt } from '@tanstack/ai'\nimport { z } from 'zod'\n\nexport const reviewPlan = defineInterrupt({\n  id: 'review-plan',\n  payloadSchema: z.object({ title: z.string(), changes: z.array(z.string()) }),\n  responseSchema: z.object({ approved: z.boolean(), note: z.string().optional() }),\n})\n```\n\n`payloadSchema` describes display data that travels from the server to the\nclient. `responseSchema` describes data that travels from the client back to\nthe server. The display payload is optional. The response schema is required.\n\nReturn requests from `onInterruptBoundary`. The hook can run at each value in\n`INTERRUPT_BOUNDARY_PHASES`:\n\n- `beforeModel`: before the adapter call\n- `afterModel`: after the model stream ends\n- `beforeTools`: before tool execution\n- `afterTools`: after tool results are in `messages`\n\nRequests from every middleware in the same boundary form one interrupt batch.\n\nPick the phase with a `ctx.phase` guard. If `ctx.parentRunId` is set, skip\nthe emit. If you do not, the same pause happens again.\n\nWhen to use each phase, and what `ctx` contains there, is in\n[Lifecycle Boundaries](./boundaries).\n\n```ts\n// app/chat-middleware.ts\nimport type { ChatMiddleware } from '@tanstack/ai'\nimport { reviewPlan } from './interrupts'\n\nexport const requestReview: ChatMiddleware<unknown, typeof reviewPlan> = {\n  name: 'request-review',\n  onInterruptBoundary(ctx) {\n    if (ctx.phase !== 'beforeModel') return\n    if (ctx.parentRunId) return\n    if (ctx.iteration !== 0) return\n    return {\n      interrupts: [\n        reviewPlan.interrupt({\n          key: 'initial-plan',\n          reason: 'review-required',\n          message: 'Review the proposed plan.',\n          payload: { title: 'Release plan', changes: ['Add search', 'Add tests'] },\n        }),\n      ],\n    }\n  },\n}\n```\n\n`interrupt()` accepts only `key`, `reason`, `message`, `expiresAt`, and, when\ndeclared, `payload`. It returns an immutable request. Do not put secrets in the\npayload because the client receives it and persistence can store it.\n\n## Register it on the server\n\nRegister all definitions on `chat({ interrupts })`. A duplicate definition id\nfails before the adapter starts.\n\n```ts\n// app/api/chat/route.ts\nimport { chat, chatParamsFromRequest, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { requestReview } from '../../chat-middleware'\nimport { reviewPlan } from '../../interrupts'\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request)\n  const stream = chat({\n    adapter: openaiText('gpt-5.5'),\n    messages: params.messages,\n    threadId: params.threadId,\n    runId: params.runId,\n    ...(params.parentRunId ? { parentRunId: params.parentRunId } : {}),\n    ...(params.resume ? { resume: params.resume } : {}),\n    interrupts: [reviewPlan],\n    middleware: [requestReview],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\nAn interrupt ends the current AG-UI run with one `RUN_FINISHED` event whose\noutcome is `interrupt`. Resolving it starts a new run with `parentRunId` set to\nthe interrupted run. The continuation carries the response to the registered\nmiddleware.\n\n## Resolve it in React\n\nRegister the same definitions with `useChat`. A bound generic interrupt has its\ndefinition id, typed display payload, and typed `resolveInterrupt` method.\n\nCheck `kind` and `definitionId`. Then pass the item to a card that takes\n`GenericInterrupt<typeof reviewPlan>`.\n\n```tsx\n// app/plan-review.tsx\nimport { fetchServerSentEvents, useChat } from '@tanstack/ai-react'\nimport type { GenericInterrupt } from '@tanstack/ai-react'\nimport { reviewPlan } from './interrupts'\n\nfunction ReviewCard({\n  interrupt,\n}: {\n  interrupt: GenericInterrupt<typeof reviewPlan>\n}) {\n  return (\n    <article>\n      <h2>{interrupt.payload?.title}</h2>\n      <button onClick={() => interrupt.resolveInterrupt({ approved: true })}>\n        Approve\n      </button>\n      <button onClick={() => interrupt.cancel()}>Cancel</button>\n    </article>\n  )\n}\n\nexport function PlanReview() {\n  const { interrupts } = useChat({\n    threadId: 'release-42',\n    connection: fetchServerSentEvents('/api/chat'),\n    interrupts: [reviewPlan],\n  })\n\n  return (\n    <>\n      {interrupts.map((interrupt) => {\n        if (interrupt.kind !== 'generic') return null\n        if (!('definitionId' in interrupt)) return null\n        if (interrupt.definitionId !== reviewPlan.id) return null\n        return <ReviewCard key={interrupt.id} interrupt={interrupt} />\n      })}\n    </>\n  )\n}\n```\n\n`resolveInterrupt` stages the answer. The client sends one continuation only\nafter every bound interrupt in the batch is resolved or cancelled. Use\n`cancel()` when the user declines to provide data.\n\n## Read resumed values in middleware\n\n`onInterruptResolution` does not run in the `chat()` call that paused. It runs\nonce at the start of the **next** `chat()` call, after the client answers.\n\nThat second call is a new run. `useChat` sends `parentRunId` and `resume`.\nEach generic resume item carries the original request in `metadata`. The hook\nruns after init `onConfig` and before `onStart`. `ctx.phase` is still `'init'`.\n\n`for(definition)` keeps the response type for that definition. `all()` reads\nall registered definitions. `all(definitionA, definitionB)` narrows the\nresult to those definitions.\n\n```ts\nimport type { ChatMiddleware } from '@tanstack/ai'\nimport { reviewPlan } from './interrupts'\n\nexport const applyReview: ChatMiddleware<unknown, typeof reviewPlan> = {\n  name: 'apply-review',\n  onInterruptResolution(_ctx, resumedInterrupts) {\n    for (const result of resumedInterrupts.for(reviewPlan)) {\n      if (result.status === 'resolved' && !result.response.approved) {\n        return { toolResume: 'stop' }\n      }\n    }\n  },\n}\n```\n\nMiddleware can return `toolResume: 'continue'`, `'cancel'`, or `'stop'`.\nWhen more than one middleware returns a value, `stop` wins over `cancel`, and\n`cancel` wins over `continue`.\n\nThis hook cannot change prompts, tools, or messages. Store the answer on a\ncapability, then return those fields from `onConfig` when\n`ctx.phase === 'beforeModel'`. The full order, plus a working example, is in\n[Apply Answers](./apply-answers).\n\n## Try the four lifecycle phases\n\nThe React chat example has a playground for `beforeModel`, `afterModel`,\n`beforeTools`, and `afterTools`. Each pause shows two typed cards:\n`reviewPlan` and `chooseAudience`.\n\n1. Start `examples/ts-react-chat`.\n2. Open `/generic-interrupts`.\n3. Pick a phase, resolve both cards, and watch the selected policy.\n\n## External generic interrupts\n\nAn external system can emit a standard AG-UI generic interrupt. TanStack AI\nshows it as `kind: 'unbound'` unless it has a valid TanStack binding. It stays\nvisible, but it has no resolve or cancel method. This keeps another system from\nreceiving a continuation that TanStack AI owns.\n\nSee [Multiple Interrupts](./multiple) for mixed tool approvals and generic\ninterrupts. See [Chat persistence](../persistence/chat-persistence) when an\ninterrupt must survive a restart.\n\n| You want to | Page |\n| --- | --- |\n| Pick `beforeModel`, `afterModel`, `beforeTools`, or `afterTools` | [Lifecycle Boundaries](./boundaries) |\n| Apply the user answer to prompts, tools, or `toolResume` | [Apply Answers](./apply-answers) |\n| Mix generic interrupts with tool approvals | [Multiple Interrupts](./multiple) |\n"}
