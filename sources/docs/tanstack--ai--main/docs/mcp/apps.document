---
title: MCP Apps
id: mcp-apps
order: 12
description: "Render interactive ui:// widget resources returned by MCP servers — static display via UIResourcePart and full interactivity via createMcpAppCallHandler and createMcpAppBridge."
keywords:
  - tanstack ai
  - mcp
  - mcp apps
  - ui resource
  - UIResourcePart
  - MCPAppResource
  - createMcpAppCallHandler
  - createMcpAppBridge
  - useMcpAppBridge
  - interactive widgets
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"MCP Apps"}]},{"type":"text","value":" is a ratified MCP extension (standardized 2026-01-26) that lets MCP servers return interactive "},{"type":"inlineCode","value":"ui://"},{"type":"text","value":" resource widgets alongside normal tool results. Instead of the model receiving raw JSON, the server embeds a resource URI that TanStack AI fetches and streams to the client as a "},{"type":"inlineCode","value":"UIResourcePart"},{"type":"text","value":" — ready to render as a full interactive iframe widget."}]},{"type":"paragraph","children":[{"type":"text","value":"There are two levels of MCP Apps support:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Static"}]},{"type":"text","value":" — the MCP tool result contains a "},{"type":"inlineCode","value":"ui://"},{"type":"text","value":" resource. TanStack AI reads it during the "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" run and surfaces it as a "},{"type":"inlineCode","value":"UIResourcePart"},{"type":"text","value":" on the assistant "},{"type":"inlineCode","value":"UIMessage"},{"type":"text","value":". No extra routes needed; render it with "},{"type":"inlineCode","value":"MCPAppResource"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Interactive"}]},{"type":"text","value":" — the widget's iframe posts tool-call or prompt actions back. You mount a server handler ("},{"type":"inlineCode","value":"createMcpAppCallHandler"},{"type":"text","value":") at a route and wire a client bridge ("},{"type":"inlineCode","value":"createMcpAppBridge"},{"type":"text","value":") so those actions reach the right MCP server."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"To link a tool to its widget from your own TanStack MCP server, see "},{"type":"link","href":"./server#tell-the-host-what-a-tool-does","children":[{"type":"text","value":"Tell the host what a tool does"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"static-widgets","children":[{"type":"text","value":"Static Widgets"}]},{"type":"paragraph","children":[{"type":"text","value":"When an MCP tool's result carries a "},{"type":"inlineCode","value":"ui://"},{"type":"text","value":" resource, TanStack AI emits a "},{"type":"inlineCode","value":"UIResourcePart"},{"type":"text","value":" on the assistant "},{"type":"inlineCode","value":"UIMessage"},{"type":"text","value":". The part is added to the message's "},{"type":"inlineCode","value":"parts"},{"type":"text","value":" array "},{"type":"strong","children":[{"type":"text","value":"alongside"}]},{"type":"text","value":" the normal "},{"type":"inlineCode","value":"ToolResultPart"},{"type":"text","value":" — it never enters model input."}]},{"type":"heading","depth":3,"id":"the-uiresourcepart-shape","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"UIResourcePart"},{"type":"text","value":" shape"}]},{"type":"code","value":"import type { UIResourcePart } from '@tanstack/ai'\n\n// Arrives on the assistant UIMessage alongside ToolCallPart / ToolResultPart:\n// {\n//   type: 'ui-resource'\n//   resource: { uri: string; mimeType: string; text?: string; blob?: string }\n//   serverId?: string     // pool prefix / config key — routes interactive calls\n//   toolCallId: string    // links to the originating tool call\n//   toolName: string      // MCP tool name whose UI this resource renders\n//   meta?: Record<string, unknown>  // reserved — currently always undefined\n// }","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"No server-side changes are needed beyond connecting an MCP server that returns "},{"type":"inlineCode","value":"ui://"},{"type":"text","value":" resources. The resource is read eagerly during the chat run. If the read fails (network error, missing resource), the tool result still flows to the model — the widget is simply absent ("},{"type":"strong","children":[{"type":"text","value":"fail-soft"}]},{"type":"text","value":")."}]},{"type":"heading","depth":3,"id":"server-route","children":[{"type":"text","value":"Server route"}]},{"type":"code","value":"// src/routes/api.chat.ts  (TanStack Start)\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const { messages } = await request.json()\n\n        const mcp = await createMCPClient({\n          transport: {\n            type: 'http',\n            url: process.env.MCP_URL!,\n          },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages,\n          mcp: { clients: [mcp] },\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})","lang":"ts","meta":"ignore"},{"type":"heading","depth":3,"id":"react-client-rendering-a-static-widget","children":[{"type":"text","value":"React client — rendering a static widget"}]},{"type":"paragraph","children":[{"type":"text","value":"Install the optional peer dependency:"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@mcp-ui/client\"]],\"preact\":[[\"@mcp-ui/client\"]]},\"mode\":\"install\"}"}},{"type":"paragraph","children":[{"type":"text","value":"Then render each "},{"type":"inlineCode","value":"ui-resource"},{"type":"text","value":" part from the assistant message."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"What is "},{"type":"inlineCode","value":"sandbox"},{"type":"text","value":"?"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"sandbox.url"},{"type":"text","value":" points to a small static "},{"type":"strong","children":[{"type":"text","value":"sandbox-proxy HTML page that you host"}]},{"type":"text","value":" (e.g. "},{"type":"inlineCode","value":"mcp-sandbox.html"},{"type":"text","value":" on your own origin). "},{"type":"inlineCode","value":"AppRenderer"},{"type":"text","value":" loads that page in an isolated iframe and renders the widget inside it — it's the security boundary, so it's a "},{"type":"strong","children":[{"type":"text","value":"deploy-time constant, the same for every widget"}]},{"type":"text","value":". It is "},{"type":"emphasis","children":[{"type":"text","value":"not"}]},{"type":"text","value":" the widget's address: the widget's identity and HTML come from the message part ("},{"type":"inlineCode","value":"part.resource"},{"type":"text","value":", a "},{"type":"inlineCode","value":"ui://…"},{"type":"text","value":" resource). See "},{"type":"link","href":"https://mcpui.dev","children":[{"type":"inlineCode","value":"@mcp-ui/client"}]},{"type":"text","value":" for the proxy page."}]}]},{"type":"code","value":"// src/components/Chat.tsx\nimport { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { MCPAppResource } from '@tanstack/ai-react/mcp-apps'\nimport type { UIResourcePart } from '@tanstack/ai'\n\nexport function Chat() {\n  const { messages, sendMessage, status } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.parts.map((part, i) => {\n            if (part.type === 'text') {\n              return <p key={i}>{part.content}</p>\n            }\n            if (part.type === 'ui-resource') {\n              return (\n                <MCPAppResource\n                  key={i}\n                  part={part}\n                  // your hosted sandbox-proxy page (a host constant, not the widget URL)\n                  sandbox={{ url: new URL('https://your-app.example.com/mcp-sandbox.html') }}\n                />\n              )\n            }\n            return null\n          })}\n        </div>\n      ))}\n      <button\n        onClick={() => sendMessage({ content: 'Show me the weather widget' })}\n        disabled={status === 'streaming'}\n      >\n        Send\n      </button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"MCPAppResource"},{"type":"text","value":" is powered by "},{"type":"inlineCode","value":"@mcp-ui/client"},{"type":"text","value":"'s "},{"type":"inlineCode","value":"AppRenderer"},{"type":"text","value":" under the hood. Without a "},{"type":"inlineCode","value":"bridge"},{"type":"text","value":" prop the widget renders in display-only mode — user interactions inside the iframe that trigger tool calls or prompts are ignored."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Framework support:"}]},{"type":"text","value":" React and Preact are shipped ("},{"type":"inlineCode","value":"@tanstack/ai-react/mcp-apps"},{"type":"text","value":" and "},{"type":"inlineCode","value":"@tanstack/ai-preact/mcp-apps"},{"type":"text","value":"). Preact requires a "},{"type":"inlineCode","value":"preact/compat"},{"type":"text","value":" alias. Solid, Vue, Svelte, and Angular wrappers are deferred — "},{"type":"inlineCode","value":"@mcp-ui/client"},{"type":"text","value":" v7's "},{"type":"inlineCode","value":"AppRenderer"},{"type":"text","value":" is React-only and a framework-agnostic renderer SDK is future work."}]}]},{"type":"heading","depth":2,"id":"interactive-widgets","children":[{"type":"text","value":"Interactive Widgets"}]},{"type":"paragraph","children":[{"type":"text","value":"For widgets that need to call tools or send prompts back to the model, you wire two extra pieces:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server"}]},{"type":"text","value":" — mount "},{"type":"inlineCode","value":"createMcpAppCallHandler"},{"type":"text","value":" at a POST route. The widget's iframe calls this route."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Client"}]},{"type":"text","value":" — create a "},{"type":"inlineCode","value":"createMcpAppBridge"},{"type":"text","value":" and pass it to "},{"type":"inlineCode","value":"MCPAppResource"},{"type":"text","value":". The bridge routes the iframe's actions (tool calls, prompts, links) to the correct handler."}]}]}]},{"type":"heading","depth":3,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai-mcp\",\"@tanstack/ai-client\",\"@mcp-ui/client\"]],\"preact\":[[\"@tanstack/ai-mcp\",\"@tanstack/ai-client\",\"@mcp-ui/client\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":3,"id":"server-the-call-handler-route","children":[{"type":"text","value":"Server — the call handler route"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"createMcpAppCallHandler"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-mcp/apps"},{"type":"text","value":" accepts the MCP client(s) you already created (a single "},{"type":"inlineCode","value":"MCPClient"},{"type":"text","value":", an "},{"type":"inlineCode","value":"MCPClients"},{"type":"text","value":" pool, or an array of either) and returns a request handler that:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Resolves each client's transport descriptor via "},{"type":"inlineCode","value":"client.getInfo()"},{"type":"text","value":" / "},{"type":"inlineCode","value":"pool.getServers()"},{"type":"text","value":" (pure config — no live socket needed)."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Reconnects to the MCP server per call using that descriptor (stateless; serverless-safe by default)."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Checks that the requested "},{"type":"inlineCode","value":"toolName"},{"type":"text","value":" is actually exposed by that server (same-server allowlist)."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Calls the tool and returns "},{"type":"inlineCode","value":"{ ok: true, result }"},{"type":"text","value":" or "},{"type":"inlineCode","value":"{ ok: false, error }"},{"type":"text","value":"."}]}]}]},{"type":"code","value":"// src/routes/api.mcp-apps-call.ts  (TanStack Start)\nimport { createFileRoute } from '@tanstack/react-router'\nimport { createMCPClients } from '@tanstack/ai-mcp'\nimport { createMcpAppCallHandler } from '@tanstack/ai-mcp/apps'\n\n// Reuse the same pool you pass to chat({ mcp: { clients: [mcp] } }).\nconst mcp = await createMCPClients({\n  weather: {\n    transport: {\n      type: 'http',\n      url: process.env.WEATHER_MCP_URL!,\n      headers: { Authorization: `Bearer ${process.env.WEATHER_MCP_TOKEN ?? ''}` },\n    },\n  },\n})\n\n// clients: a single MCPClient, an MCPClients pool, or an array of either.\n// The handler reads each client's transport descriptor via getInfo()/getServers()\n// and reconnects per call — works in long-lived servers and serverless alike.\nconst handler = createMcpAppCallHandler({ clients: mcp })\n\nexport const Route = createFileRoute('/api/mcp-apps/call')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n        // body: { threadId, serverId, toolName, args?, messageId? }\n        const result = await handler(body)\n        return new Response(JSON.stringify(result), {\n          headers: { 'Content-Type': 'application/json' },\n        })\n      },\n    },\n  },\n})","lang":"ts","meta":"ignore"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"link"},{"type":"text","value":" actions need an "},{"type":"inlineCode","value":"onLink"},{"type":"text","value":" handler."}]},{"type":"text","value":" If the widget emits a "},{"type":"inlineCode","value":"link"},{"type":"text","value":" action and no "},{"type":"inlineCode","value":"onLink"},{"type":"text","value":" handler is wired in the bridge, the bridge drops the link (logging a warning) and "},{"type":"inlineCode","value":"openLink"},{"type":"text","value":" returns "},{"type":"inlineCode","value":"{ isError: true }"},{"type":"text","value":" — the call does not hang, and the widget cannot open arbitrary URLs in the host page. Pass "},{"type":"inlineCode","value":"onLink"},{"type":"text","value":" explicitly to opt in."}]},{"type":"paragraph","children":[{"type":"text","value":"Even with an "},{"type":"inlineCode","value":"onLink"},{"type":"text","value":" handler, the bridge only forwards "},{"type":"inlineCode","value":"http:"},{"type":"text","value":", "},{"type":"inlineCode","value":"https:"},{"type":"text","value":", and "},{"type":"inlineCode","value":"mailto:"},{"type":"text","value":" URLs. Unsafe schemes ("},{"type":"inlineCode","value":"javascript:"},{"type":"text","value":", "},{"type":"inlineCode","value":"data:"},{"type":"text","value":", "},{"type":"inlineCode","value":"file:"},{"type":"text","value":", …) are "},{"type":"strong","children":[{"type":"text","value":"always rejected"}]},{"type":"text","value":" before your handler runs, so a sandboxed widget can't smuggle a script-executing or local-resource URL through."}]}]},{"type":"heading","depth":4,"id":"same-server-allowlist","children":[{"type":"text","value":"Same-server allowlist"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"createMcpAppCallHandler"},{"type":"text","value":" always verifies that "},{"type":"inlineCode","value":"toolName"},{"type":"text","value":" is in the list of tools the target server actually exposes. A request for a tool the server does not know about returns "},{"type":"inlineCode","value":"{ ok: false, error: \"Tool not allowed: <name>\" }"},{"type":"text","value":" without ever executing it. This server-exposure check is unconditional and cannot be bypassed."}]},{"type":"paragraph","children":[{"type":"text","value":"The handler also uses the "},{"type":"link","href":"../tools/mcp#limit-and-gate-tools","children":[{"type":"text","value":"tool policy"}]},{"type":"text","value":" of each client:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"toolFilter"},{"type":"text","value":": a tool that the filter hides returns "},{"type":"inlineCode","value":"Tool not allowed: <name>"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"needsApproval"},{"type":"text","value":": a widget call has no approval step. A tool that "},{"type":"inlineCode","value":"needsApproval"},{"type":"text","value":" marks returns "},{"type":"inlineCode","value":"{ ok: false, error: \"Tool needs approval: <name>\" }"},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"allowTool"},{"type":"text","value":" option to add a further restriction on top. A request must satisfy "},{"type":"strong","children":[{"type":"text","value":"both"}]},{"type":"text","value":" the server-exposure check and "},{"type":"inlineCode","value":"allowTool"},{"type":"text","value":" — it is AND-ed, not a replacement for the server check:"}]},{"type":"code","value":"import { createMCPClients } from '@tanstack/ai-mcp'\nimport { createMcpAppCallHandler } from '@tanstack/ai-mcp/apps'\n\nconst mcp = await createMCPClients({\n  weather: { transport: { type: 'http', url: process.env.MCP_URL ?? '' } },\n})\n\nconst handler = createMcpAppCallHandler({\n  clients: mcp,\n  // Additional restriction: even if the server exposes more tools,\n  // only allow this specific one through the call handler.\n  allowTool: (req) => req.toolName === 'place_order',\n})","lang":"ts"},{"type":"heading","depth":3,"id":"chat-route-wire-the-serverid","children":[{"type":"text","value":"Chat route — wire the "},{"type":"inlineCode","value":"serverId"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"serverId"},{"type":"text","value":" on a "},{"type":"inlineCode","value":"UIResourcePart"},{"type":"text","value":" comes from the "},{"type":"inlineCode","value":"prefix"},{"type":"text","value":" you gave the MCP client. Use the same key in both places:"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Multi-server routing:"}]},{"type":"text","value":" interactive calls route by "},{"type":"inlineCode","value":"serverId"},{"type":"text","value":", which is each client's "},{"type":"inlineCode","value":"prefix"},{"type":"text","value":". "},{"type":"inlineCode","value":"createMCPClients"},{"type":"text","value":" defaults every server's prefix to its config key, so routing works out of the box. If you pass multiple servers and disable prefixing on one ("},{"type":"inlineCode","value":"prefix: ''"},{"type":"text","value":"), that server has no "},{"type":"inlineCode","value":"serverId"},{"type":"text","value":" and its widgets can't make interactive calls — give each interactive server a distinct prefix (the default is fine)."}]}]},{"type":"code","value":"// src/routes/api.chat.ts\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClients } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n\n        // The pool key \"weather\" becomes the serverId on every UIResourcePart\n        // emitted by this server — must match the key used when constructing\n        // the pool passed to createMcpAppCallHandler.\n        const pool = await createMCPClients({\n          weather: {\n            transport: { type: 'http', url: process.env.WEATHER_MCP_URL! },\n          },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages: body.messages,\n          mcp: { clients: [pool] },\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})","lang":"ts","meta":"ignore"},{"type":"heading","depth":3,"id":"client-bridge-interactive-render","children":[{"type":"text","value":"Client — bridge + interactive render"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"createMcpAppBridge"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":" returns an action handler you pass to "},{"type":"inlineCode","value":"MCPAppResource"},{"type":"text","value":". It routes:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tool"},{"type":"text","value":" actions → POST to "},{"type":"inlineCode","value":"callEndpoint"},{"type":"text","value":" with the tool call payload."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"prompt"},{"type":"text","value":" actions → "},{"type":"inlineCode","value":"chat.sendMessage(prompt)"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"link"},{"type":"text","value":" actions → "},{"type":"inlineCode","value":"onLink(url)"},{"type":"text","value":" if provided; dropped (with a warning) otherwise."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"In React (or Preact), use the "},{"type":"inlineCode","value":"useMcpAppBridge"},{"type":"text","value":" hook — it returns a "},{"type":"strong","children":[{"type":"text","value":"stable"}]},{"type":"text","value":"\nbridge for the given "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":"/"},{"type":"inlineCode","value":"callEndpoint"},{"type":"text","value":" and always calls your latest\n"},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onLink"},{"type":"text","value":", so you don't hand-write "},{"type":"inlineCode","value":"useMemo"},{"type":"text","value":" or fight\n"},{"type":"inlineCode","value":"exhaustive-deps"},{"type":"text","value":". (The underlying "},{"type":"inlineCode","value":"createMcpAppBridge"},{"type":"text","value":" from\n"},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":" is framework-agnostic if you need it directly.)"}]},{"type":"code","value":"// src/components/Chat.tsx\nimport { useChat, useMcpAppBridge } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { MCPAppResource } from '@tanstack/ai-react/mcp-apps'\n\nexport function Chat() {\n  // A stable id correlating widget calls back to this conversation.\n  const threadId = 'weather-chat'\n  const { messages, sendMessage, status } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const bridge = useMcpAppBridge({\n    threadId,\n    callEndpoint: '/api/mcp-apps/call',\n    chat: { sendMessage: (content, body) => sendMessage(content, { body }) },\n    // Opt in to link navigation — absent means links are blocked.\n    onLink: (url) => window.open(url, '_blank', 'noopener'),\n  })\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.parts.map((part, i) => {\n            if (part.type === 'text') {\n              return <p key={i}>{part.content}</p>\n            }\n            if (part.type === 'ui-resource') {\n              return (\n                <MCPAppResource\n                  key={i}\n                  part={part}\n                  bridge={bridge}\n                  // your hosted sandbox-proxy page (a host constant, not the widget URL)\n                  sandbox={{ url: new URL('https://your-app.example.com/mcp-sandbox.html') }}\n                />\n              )\n            }\n            return null\n          })}\n        </div>\n      ))}\n      <button\n        onClick={() => sendMessage({ content: 'Show me the weather widget' })}\n        disabled={status === 'streaming'}\n      >\n        Send\n      </button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Writeback is client-side."}]},{"type":"text","value":" Widget tool calls do "},{"type":"strong","children":[{"type":"text","value":"not"}]},{"type":"text","value":" append to the thread's chat history by default. The conversation state writeback path is out of scope for the current release. Each widget interaction is self-contained."}]}]},{"type":"heading","depth":2,"id":"session-persistence","children":[{"type":"text","value":"Session Persistence"}]},{"type":"paragraph","children":[{"type":"text","value":"The call handler reconnects to the MCP server on every widget action using the transport descriptor it reads from "},{"type":"inlineCode","value":"client.getInfo()"},{"type":"text","value":" / "},{"type":"inlineCode","value":"pool.getServers()"},{"type":"text","value":" ("},{"type":"strong","children":[{"type":"text","value":"reconnect-per-call"}]},{"type":"text","value":" — stateless, serverless-safe). For stateful MCP transports that require a persistent session, opt in to an in-memory session store:"}]},{"type":"code","value":"import { createMCPClients } from '@tanstack/ai-mcp'\nimport {\n  createMcpAppCallHandler,\n  inMemoryMcpSessionStore,\n} from '@tanstack/ai-mcp/apps'\n\nconst mcp = await createMCPClients({\n  weather: { transport: { type: 'http', url: process.env.MCP_URL ?? '' } },\n})\n\n// In-memory store: one Node.js process, no cross-instance sharing.\n// Shape matches the McpSessionStore interface — SQL / KV stores\n// can be dropped in later with no API change.\nconst store = inMemoryMcpSessionStore({ ttlMs: 30 * 60_000 })\n\nconst handler = createMcpAppCallHandler({ clients: mcp, store })","lang":"ts"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Current limitation:"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"inMemoryMcpSessionStore"},{"type":"text","value":" is single-instance (one Node.js process). It does not survive serverless restarts or scale across replicas. The "},{"type":"inlineCode","value":"McpSessionStore"},{"type":"text","value":" interface is the persistence extension point — persistent backends (database, KV store) can be dropped in without any API changes."}]}]},{"type":"heading","depth":2,"id":"api-reference","children":[{"type":"text","value":"API Reference"}]},{"type":"heading","depth":3,"id":"createmcpappcallhandler-tanstack-ai-mcp-apps","children":[{"type":"inlineCode","value":"createMcpAppCallHandler"},{"type":"text","value":" ("},{"type":"inlineCode","value":"@tanstack/ai-mcp/apps"},{"type":"text","value":")"}]},{"type":"code","value":"import { createMCPClients } from '@tanstack/ai-mcp'\nimport { createMcpAppCallHandler } from '@tanstack/ai-mcp/apps'\nimport type { McpAppCallHandlerOptions } from '@tanstack/ai-mcp/apps'\n\nconst mcp = await createMCPClients({\n  weather: { transport: { type: 'http', url: process.env.MCP_URL ?? '' } },\n})\n\nconst options: McpAppCallHandlerOptions = {\n  // Pass the MCP client(s) you already created:\n  //   - a single MCPClient\n  //   - an MCPClients pool  (pool key = serverId on UIResourcePart)\n  //   - an array of either\n  // The handler reads each client's transport descriptor via\n  // client.getInfo() / pool.getServers() (pure config, no live socket)\n  // and reconnects per call — serverless-safe by default.\n  clients: mcp,\n\n  // Dynamic session store (opt-in for stateful transports)\n  // store: inMemoryMcpSessionStore(),\n\n  // Custom tool allowlist — default: server's own exposed tools only\n  // AND-ed on top of the always-on same-server exposure check.\n  allowTool: (req) => req.toolName === 'get_weather',\n}\n\n// Returns: (req) => Promise<{ ok: true; result: unknown } | { ok: false; error: string }>\nconst handler = createMcpAppCallHandler(options)","lang":"ts"},{"type":"heading","depth":3,"id":"inmemorymcpsessionstore-tanstack-ai-mcp-apps","children":[{"type":"inlineCode","value":"inMemoryMcpSessionStore"},{"type":"text","value":" ("},{"type":"inlineCode","value":"@tanstack/ai-mcp/apps"},{"type":"text","value":")"}]},{"type":"code","value":"import { inMemoryMcpSessionStore } from '@tanstack/ai-mcp/apps'\n\nconst store = inMemoryMcpSessionStore({\n  ttlMs: 30 * 60_000, // optional; default: 30 minutes\n})","lang":"ts"},{"type":"heading","depth":3,"id":"createmcpappbridge-tanstack-ai-client","children":[{"type":"inlineCode","value":"createMcpAppBridge"},{"type":"text","value":" ("},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":")"}]},{"type":"code","value":"import { createMcpAppBridge } from '@tanstack/ai-client'\nimport type { CreateMcpAppBridgeOptions } from '@tanstack/ai-client'\n\nconst options: CreateMcpAppBridgeOptions = {\n  threadId: 'weather-chat', // identifies the thread for the call handler\n  callEndpoint: '/api/mcp-apps/call', // POST route mounting createMcpAppCallHandler\n  chat: {\n    sendMessage: async (content, body) => {\n      console.log(content, body)\n    },\n  }, // prompt-intent path\n  fetchImpl: fetch, // optional; injectable for testing\n  onLink: (url) => window.open(url, '_blank'), // absent → link is dropped (warned), openLink returns { isError: true }\n}\n\n// Returns an McpAppBridge with callTool / sendPrompt / openLink methods.\nconst bridge = createMcpAppBridge(options)","lang":"ts"},{"type":"heading","depth":3,"id":"usemcpappbridge-tanstack-ai-react-tanstack-ai-preact","children":[{"type":"inlineCode","value":"useMcpAppBridge"},{"type":"text","value":" ("},{"type":"inlineCode","value":"@tanstack/ai-react"},{"type":"text","value":" / "},{"type":"inlineCode","value":"@tanstack/ai-preact"},{"type":"text","value":")"}]},{"type":"paragraph","children":[{"type":"text","value":"The React/Preact wrapper around "},{"type":"inlineCode","value":"createMcpAppBridge"},{"type":"text","value":". Returns a bridge that is\n"},{"type":"strong","children":[{"type":"text","value":"stable"}]},{"type":"text","value":" for a given "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":"/"},{"type":"inlineCode","value":"callEndpoint"},{"type":"text","value":" (so it won't churn "},{"type":"inlineCode","value":"MCPAppResource"},{"type":"text","value":"\non every render) while always invoking the latest "},{"type":"inlineCode","value":"chat.sendMessage"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onLink"},{"type":"text","value":".\nTakes the same options as "},{"type":"inlineCode","value":"createMcpAppBridge"},{"type":"text","value":"."}]},{"type":"code","value":"import { useChat, useMcpAppBridge } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nfunction useBridge(threadId: string) {\n  const { sendMessage } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n  return useMcpAppBridge({\n    threadId,\n    callEndpoint: '/api/mcp-apps/call',\n    chat: { sendMessage: (content, body) => sendMessage(content, { body }) },\n    onLink: (url) => window.open(url, '_blank', 'noopener'),\n  })\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"mcpappresource-tanstack-ai-react-mcp-apps","children":[{"type":"inlineCode","value":"MCPAppResource"},{"type":"text","value":" ("},{"type":"inlineCode","value":"@tanstack/ai-react/mcp-apps"},{"type":"text","value":")"}]},{"type":"code","value":"import { MCPAppResource } from '@tanstack/ai-react/mcp-apps'\n// `part` is a UIResourcePart from the assistant message; `bridge` is a\n// createMcpAppBridge result — both supplied by your component (see examples above).\nimport { part, bridge } from './chat-context'\n\nconst widget = (\n  <MCPAppResource\n    part={part} // UIResourcePart from the assistant message (carries the toolName)\n    sandbox={{ url: new URL('https://your-app.example.com/mcp-sandbox.html') }} // your hosted sandbox-proxy page (host constant; not the widget's ui:// URL)\n    bridge={bridge} // omit for static, display-only rendering\n    toolInput={{ city: 'Brooklyn' }} // optional tool input for the renderer context\n  />\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Preact: identical API from "},{"type":"inlineCode","value":"@tanstack/ai-preact/mcp-apps"},{"type":"text","value":" (requires "},{"type":"inlineCode","value":"preact/compat"},{"type":"text","value":" alias)."}]}],"headings":[{"id":"static-widgets","text":"Static Widgets","level":2},{"id":"the-uiresourcepart-shape","text":"The UIResourcePart shape","level":3},{"id":"server-route","text":"Server route","level":3},{"id":"react-client-rendering-a-static-widget","text":"React client — rendering a static widget","level":3},{"id":"interactive-widgets","text":"Interactive Widgets","level":2},{"id":"installation","text":"Installation","level":3},{"id":"server-the-call-handler-route","text":"Server — the call handler route","level":3},{"id":"same-server-allowlist","text":"Same-server allowlist","level":4},{"id":"chat-route-wire-the-serverid","text":"Chat route — wire the serverId","level":3},{"id":"client-bridge-interactive-render","text":"Client — bridge + interactive render","level":3},{"id":"session-persistence","text":"Session Persistence","level":2},{"id":"api-reference","text":"API Reference","level":2},{"id":"createmcpappcallhandler-tanstack-ai-mcp-apps","text":"createMcpAppCallHandler (@tanstack/ai-mcp/apps)","level":3},{"id":"inmemorymcpsessionstore-tanstack-ai-mcp-apps","text":"inMemoryMcpSessionStore (@tanstack/ai-mcp/apps)","level":3},{"id":"createmcpappbridge-tanstack-ai-client","text":"createMcpAppBridge (@tanstack/ai-client)","level":3},{"id":"usemcpappbridge-tanstack-ai-react-tanstack-ai-preact","text":"useMcpAppBridge (@tanstack/ai-react / @tanstack/ai-preact)","level":3},{"id":"mcpappresource-tanstack-ai-react-mcp-apps","text":"MCPAppResource (@tanstack/ai-react/mcp-apps)","level":3}]},"frameworks":["react","preact"],"downloadMarkdown":"\n**MCP Apps** is a ratified MCP extension (standardized 2026-01-26) that lets MCP servers return interactive `ui://` resource widgets alongside normal tool results. Instead of the model receiving raw JSON, the server embeds a resource URI that TanStack AI fetches and streams to the client as a `UIResourcePart` — ready to render as a full interactive iframe widget.\n\nThere are two levels of MCP Apps support:\n\n- **Static** — the MCP tool result contains a `ui://` resource. TanStack AI reads it during the `chat()` run and surfaces it as a `UIResourcePart` on the assistant `UIMessage`. No extra routes needed; render it with `MCPAppResource`.\n- **Interactive** — the widget's iframe posts tool-call or prompt actions back. You mount a server handler (`createMcpAppCallHandler`) at a route and wire a client bridge (`createMcpAppBridge`) so those actions reach the right MCP server.\n\nTo link a tool to its widget from your own TanStack MCP server, see [Tell the host what a tool does](./server#tell-the-host-what-a-tool-does).\n\n## Static Widgets\n\nWhen an MCP tool's result carries a `ui://` resource, TanStack AI emits a `UIResourcePart` on the assistant `UIMessage`. The part is added to the message's `parts` array **alongside** the normal `ToolResultPart` — it never enters model input.\n\n### The `UIResourcePart` shape\n\n```ts\nimport type { UIResourcePart } from '@tanstack/ai'\n\n// Arrives on the assistant UIMessage alongside ToolCallPart / ToolResultPart:\n// {\n//   type: 'ui-resource'\n//   resource: { uri: string; mimeType: string; text?: string; blob?: string }\n//   serverId?: string     // pool prefix / config key — routes interactive calls\n//   toolCallId: string    // links to the originating tool call\n//   toolName: string      // MCP tool name whose UI this resource renders\n//   meta?: Record<string, unknown>  // reserved — currently always undefined\n// }\n```\n\nNo server-side changes are needed beyond connecting an MCP server that returns `ui://` resources. The resource is read eagerly during the chat run. If the read fails (network error, missing resource), the tool result still flows to the model — the widget is simply absent (**fail-soft**).\n\n### Server route\n\n```ts ignore\n// src/routes/api.chat.ts  (TanStack Start)\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const { messages } = await request.json()\n\n        const mcp = await createMCPClient({\n          transport: {\n            type: 'http',\n            url: process.env.MCP_URL!,\n          },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages,\n          mcp: { clients: [mcp] },\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n### React client — rendering a static widget\n\nInstall the optional peer dependency:\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @mcp-ui/client\npreact: @mcp-ui/client\n\n<!-- ::end:tabs -->\n\nThen render each `ui-resource` part from the assistant message.\n\n> **What is `sandbox`?** `sandbox.url` points to a small static **sandbox-proxy HTML page that you host** (e.g. `mcp-sandbox.html` on your own origin). `AppRenderer` loads that page in an isolated iframe and renders the widget inside it — it's the security boundary, so it's a **deploy-time constant, the same for every widget**. It is *not* the widget's address: the widget's identity and HTML come from the message part (`part.resource`, a `ui://…` resource). See [`@mcp-ui/client`](https://mcpui.dev) for the proxy page.\n\n```tsx\n// src/components/Chat.tsx\nimport { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { MCPAppResource } from '@tanstack/ai-react/mcp-apps'\nimport type { UIResourcePart } from '@tanstack/ai'\n\nexport function Chat() {\n  const { messages, sendMessage, status } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.parts.map((part, i) => {\n            if (part.type === 'text') {\n              return <p key={i}>{part.content}</p>\n            }\n            if (part.type === 'ui-resource') {\n              return (\n                <MCPAppResource\n                  key={i}\n                  part={part}\n                  // your hosted sandbox-proxy page (a host constant, not the widget URL)\n                  sandbox={{ url: new URL('https://your-app.example.com/mcp-sandbox.html') }}\n                />\n              )\n            }\n            return null\n          })}\n        </div>\n      ))}\n      <button\n        onClick={() => sendMessage({ content: 'Show me the weather widget' })}\n        disabled={status === 'streaming'}\n      >\n        Send\n      </button>\n    </div>\n  )\n}\n```\n\n`MCPAppResource` is powered by `@mcp-ui/client`'s `AppRenderer` under the hood. Without a `bridge` prop the widget renders in display-only mode — user interactions inside the iframe that trigger tool calls or prompts are ignored.\n\n> **Framework support:** React and Preact are shipped (`@tanstack/ai-react/mcp-apps` and `@tanstack/ai-preact/mcp-apps`). Preact requires a `preact/compat` alias. Solid, Vue, Svelte, and Angular wrappers are deferred — `@mcp-ui/client` v7's `AppRenderer` is React-only and a framework-agnostic renderer SDK is future work.\n\n## Interactive Widgets\n\nFor widgets that need to call tools or send prompts back to the model, you wire two extra pieces:\n\n1. **Server** — mount `createMcpAppCallHandler` at a POST route. The widget's iframe calls this route.\n2. **Client** — create a `createMcpAppBridge` and pass it to `MCPAppResource`. The bridge routes the iframe's actions (tool calls, prompts, links) to the correct handler.\n\n### Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-mcp @tanstack/ai-client @mcp-ui/client\npreact: @tanstack/ai-mcp @tanstack/ai-client @mcp-ui/client\n\n<!-- ::end:tabs -->\n\n### Server — the call handler route\n\n`createMcpAppCallHandler` from `@tanstack/ai-mcp/apps` accepts the MCP client(s) you already created (a single `MCPClient`, an `MCPClients` pool, or an array of either) and returns a request handler that:\n\n- Resolves each client's transport descriptor via `client.getInfo()` / `pool.getServers()` (pure config — no live socket needed).\n- Reconnects to the MCP server per call using that descriptor (stateless; serverless-safe by default).\n- Checks that the requested `toolName` is actually exposed by that server (same-server allowlist).\n- Calls the tool and returns `{ ok: true, result }` or `{ ok: false, error }`.\n\n```ts ignore\n// src/routes/api.mcp-apps-call.ts  (TanStack Start)\nimport { createFileRoute } from '@tanstack/react-router'\nimport { createMCPClients } from '@tanstack/ai-mcp'\nimport { createMcpAppCallHandler } from '@tanstack/ai-mcp/apps'\n\n// Reuse the same pool you pass to chat({ mcp: { clients: [mcp] } }).\nconst mcp = await createMCPClients({\n  weather: {\n    transport: {\n      type: 'http',\n      url: process.env.WEATHER_MCP_URL!,\n      headers: { Authorization: `Bearer ${process.env.WEATHER_MCP_TOKEN ?? ''}` },\n    },\n  },\n})\n\n// clients: a single MCPClient, an MCPClients pool, or an array of either.\n// The handler reads each client's transport descriptor via getInfo()/getServers()\n// and reconnects per call — works in long-lived servers and serverless alike.\nconst handler = createMcpAppCallHandler({ clients: mcp })\n\nexport const Route = createFileRoute('/api/mcp-apps/call')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n        // body: { threadId, serverId, toolName, args?, messageId? }\n        const result = await handler(body)\n        return new Response(JSON.stringify(result), {\n          headers: { 'Content-Type': 'application/json' },\n        })\n      },\n    },\n  },\n})\n```\n\n> **`link` actions need an `onLink` handler.** If the widget emits a `link` action and no `onLink` handler is wired in the bridge, the bridge drops the link (logging a warning) and `openLink` returns `{ isError: true }` — the call does not hang, and the widget cannot open arbitrary URLs in the host page. Pass `onLink` explicitly to opt in.\n>\n> Even with an `onLink` handler, the bridge only forwards `http:`, `https:`, and `mailto:` URLs. Unsafe schemes (`javascript:`, `data:`, `file:`, …) are **always rejected** before your handler runs, so a sandboxed widget can't smuggle a script-executing or local-resource URL through.\n\n#### Same-server allowlist\n\n`createMcpAppCallHandler` always verifies that `toolName` is in the list of tools the target server actually exposes. A request for a tool the server does not know about returns `{ ok: false, error: \"Tool not allowed: <name>\" }` without ever executing it. This server-exposure check is unconditional and cannot be bypassed.\n\nThe handler also uses the [tool policy](../tools/mcp#limit-and-gate-tools) of each client:\n\n- `toolFilter`: a tool that the filter hides returns `Tool not allowed: <name>`.\n- `needsApproval`: a widget call has no approval step. A tool that `needsApproval` marks returns `{ ok: false, error: \"Tool needs approval: <name>\" }`.\n\nUse the `allowTool` option to add a further restriction on top. A request must satisfy **both** the server-exposure check and `allowTool` — it is AND-ed, not a replacement for the server check:\n\n```ts\nimport { createMCPClients } from '@tanstack/ai-mcp'\nimport { createMcpAppCallHandler } from '@tanstack/ai-mcp/apps'\n\nconst mcp = await createMCPClients({\n  weather: { transport: { type: 'http', url: process.env.MCP_URL ?? '' } },\n})\n\nconst handler = createMcpAppCallHandler({\n  clients: mcp,\n  // Additional restriction: even if the server exposes more tools,\n  // only allow this specific one through the call handler.\n  allowTool: (req) => req.toolName === 'place_order',\n})\n```\n\n### Chat route — wire the `serverId`\n\nThe `serverId` on a `UIResourcePart` comes from the `prefix` you gave the MCP client. Use the same key in both places:\n\n> **Multi-server routing:** interactive calls route by `serverId`, which is each client's `prefix`. `createMCPClients` defaults every server's prefix to its config key, so routing works out of the box. If you pass multiple servers and disable prefixing on one (`prefix: ''`), that server has no `serverId` and its widgets can't make interactive calls — give each interactive server a distinct prefix (the default is fine).\n\n\n```ts ignore\n// src/routes/api.chat.ts\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClients } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n\n        // The pool key \"weather\" becomes the serverId on every UIResourcePart\n        // emitted by this server — must match the key used when constructing\n        // the pool passed to createMcpAppCallHandler.\n        const pool = await createMCPClients({\n          weather: {\n            transport: { type: 'http', url: process.env.WEATHER_MCP_URL! },\n          },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages: body.messages,\n          mcp: { clients: [pool] },\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n### Client — bridge + interactive render\n\n`createMcpAppBridge` from `@tanstack/ai-client` returns an action handler you pass to `MCPAppResource`. It routes:\n\n- `tool` actions → POST to `callEndpoint` with the tool call payload.\n- `prompt` actions → `chat.sendMessage(prompt)`.\n- `link` actions → `onLink(url)` if provided; dropped (with a warning) otherwise.\n\nIn React (or Preact), use the `useMcpAppBridge` hook — it returns a **stable**\nbridge for the given `threadId`/`callEndpoint` and always calls your latest\n`sendMessage`/`onLink`, so you don't hand-write `useMemo` or fight\n`exhaustive-deps`. (The underlying `createMcpAppBridge` from\n`@tanstack/ai-client` is framework-agnostic if you need it directly.)\n\n```tsx\n// src/components/Chat.tsx\nimport { useChat, useMcpAppBridge } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { MCPAppResource } from '@tanstack/ai-react/mcp-apps'\n\nexport function Chat() {\n  // A stable id correlating widget calls back to this conversation.\n  const threadId = 'weather-chat'\n  const { messages, sendMessage, status } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const bridge = useMcpAppBridge({\n    threadId,\n    callEndpoint: '/api/mcp-apps/call',\n    chat: { sendMessage: (content, body) => sendMessage(content, { body }) },\n    // Opt in to link navigation — absent means links are blocked.\n    onLink: (url) => window.open(url, '_blank', 'noopener'),\n  })\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.parts.map((part, i) => {\n            if (part.type === 'text') {\n              return <p key={i}>{part.content}</p>\n            }\n            if (part.type === 'ui-resource') {\n              return (\n                <MCPAppResource\n                  key={i}\n                  part={part}\n                  bridge={bridge}\n                  // your hosted sandbox-proxy page (a host constant, not the widget URL)\n                  sandbox={{ url: new URL('https://your-app.example.com/mcp-sandbox.html') }}\n                />\n              )\n            }\n            return null\n          })}\n        </div>\n      ))}\n      <button\n        onClick={() => sendMessage({ content: 'Show me the weather widget' })}\n        disabled={status === 'streaming'}\n      >\n        Send\n      </button>\n    </div>\n  )\n}\n```\n\n> **Writeback is client-side.** Widget tool calls do **not** append to the thread's chat history by default. The conversation state writeback path is out of scope for the current release. Each widget interaction is self-contained.\n\n## Session Persistence\n\nThe call handler reconnects to the MCP server on every widget action using the transport descriptor it reads from `client.getInfo()` / `pool.getServers()` (**reconnect-per-call** — stateless, serverless-safe). For stateful MCP transports that require a persistent session, opt in to an in-memory session store:\n\n```ts\nimport { createMCPClients } from '@tanstack/ai-mcp'\nimport {\n  createMcpAppCallHandler,\n  inMemoryMcpSessionStore,\n} from '@tanstack/ai-mcp/apps'\n\nconst mcp = await createMCPClients({\n  weather: { transport: { type: 'http', url: process.env.MCP_URL ?? '' } },\n})\n\n// In-memory store: one Node.js process, no cross-instance sharing.\n// Shape matches the McpSessionStore interface — SQL / KV stores\n// can be dropped in later with no API change.\nconst store = inMemoryMcpSessionStore({ ttlMs: 30 * 60_000 })\n\nconst handler = createMcpAppCallHandler({ clients: mcp, store })\n```\n\n> **Current limitation:** `inMemoryMcpSessionStore` is single-instance (one Node.js process). It does not survive serverless restarts or scale across replicas. The `McpSessionStore` interface is the persistence extension point — persistent backends (database, KV store) can be dropped in without any API changes.\n\n## API Reference\n\n### `createMcpAppCallHandler` (`@tanstack/ai-mcp/apps`)\n\n```ts\nimport { createMCPClients } from '@tanstack/ai-mcp'\nimport { createMcpAppCallHandler } from '@tanstack/ai-mcp/apps'\nimport type { McpAppCallHandlerOptions } from '@tanstack/ai-mcp/apps'\n\nconst mcp = await createMCPClients({\n  weather: { transport: { type: 'http', url: process.env.MCP_URL ?? '' } },\n})\n\nconst options: McpAppCallHandlerOptions = {\n  // Pass the MCP client(s) you already created:\n  //   - a single MCPClient\n  //   - an MCPClients pool  (pool key = serverId on UIResourcePart)\n  //   - an array of either\n  // The handler reads each client's transport descriptor via\n  // client.getInfo() / pool.getServers() (pure config, no live socket)\n  // and reconnects per call — serverless-safe by default.\n  clients: mcp,\n\n  // Dynamic session store (opt-in for stateful transports)\n  // store: inMemoryMcpSessionStore(),\n\n  // Custom tool allowlist — default: server's own exposed tools only\n  // AND-ed on top of the always-on same-server exposure check.\n  allowTool: (req) => req.toolName === 'get_weather',\n}\n\n// Returns: (req) => Promise<{ ok: true; result: unknown } | { ok: false; error: string }>\nconst handler = createMcpAppCallHandler(options)\n```\n\n### `inMemoryMcpSessionStore` (`@tanstack/ai-mcp/apps`)\n\n```ts\nimport { inMemoryMcpSessionStore } from '@tanstack/ai-mcp/apps'\n\nconst store = inMemoryMcpSessionStore({\n  ttlMs: 30 * 60_000, // optional; default: 30 minutes\n})\n```\n\n### `createMcpAppBridge` (`@tanstack/ai-client`)\n\n```ts\nimport { createMcpAppBridge } from '@tanstack/ai-client'\nimport type { CreateMcpAppBridgeOptions } from '@tanstack/ai-client'\n\nconst options: CreateMcpAppBridgeOptions = {\n  threadId: 'weather-chat', // identifies the thread for the call handler\n  callEndpoint: '/api/mcp-apps/call', // POST route mounting createMcpAppCallHandler\n  chat: {\n    sendMessage: async (content, body) => {\n      console.log(content, body)\n    },\n  }, // prompt-intent path\n  fetchImpl: fetch, // optional; injectable for testing\n  onLink: (url) => window.open(url, '_blank'), // absent → link is dropped (warned), openLink returns { isError: true }\n}\n\n// Returns an McpAppBridge with callTool / sendPrompt / openLink methods.\nconst bridge = createMcpAppBridge(options)\n```\n\n### `useMcpAppBridge` (`@tanstack/ai-react` / `@tanstack/ai-preact`)\n\nThe React/Preact wrapper around `createMcpAppBridge`. Returns a bridge that is\n**stable** for a given `threadId`/`callEndpoint` (so it won't churn `MCPAppResource`\non every render) while always invoking the latest `chat.sendMessage`/`onLink`.\nTakes the same options as `createMcpAppBridge`.\n\n```tsx\nimport { useChat, useMcpAppBridge } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nfunction useBridge(threadId: string) {\n  const { sendMessage } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n  return useMcpAppBridge({\n    threadId,\n    callEndpoint: '/api/mcp-apps/call',\n    chat: { sendMessage: (content, body) => sendMessage(content, { body }) },\n    onLink: (url) => window.open(url, '_blank', 'noopener'),\n  })\n}\n```\n\n### `MCPAppResource` (`@tanstack/ai-react/mcp-apps`)\n\n```tsx\nimport { MCPAppResource } from '@tanstack/ai-react/mcp-apps'\n// `part` is a UIResourcePart from the assistant message; `bridge` is a\n// createMcpAppBridge result — both supplied by your component (see examples above).\nimport { part, bridge } from './chat-context'\n\nconst widget = (\n  <MCPAppResource\n    part={part} // UIResourcePart from the assistant message (carries the toolName)\n    sandbox={{ url: new URL('https://your-app.example.com/mcp-sandbox.html') }} // your hosted sandbox-proxy page (host constant; not the widget's ui:// URL)\n    bridge={bridge} // omit for static, display-only rendering\n    toolInput={{ city: 'Brooklyn' }} // optional tool input for the renderer context\n  />\n)\n```\n\nPreact: identical API from `@tanstack/ai-preact/mcp-apps` (requires `preact/compat` alias).\n","originalRawMarkdown":"---\ntitle: MCP Apps\nid: mcp-apps\norder: 12\ndescription: \"Render interactive ui:// widget resources returned by MCP servers — static display via UIResourcePart and full interactivity via createMcpAppCallHandler and createMcpAppBridge.\"\nkeywords:\n  - tanstack ai\n  - mcp\n  - mcp apps\n  - ui resource\n  - UIResourcePart\n  - MCPAppResource\n  - createMcpAppCallHandler\n  - createMcpAppBridge\n  - useMcpAppBridge\n  - interactive widgets\n---\n\n**MCP Apps** is a ratified MCP extension (standardized 2026-01-26) that lets MCP servers return interactive `ui://` resource widgets alongside normal tool results. Instead of the model receiving raw JSON, the server embeds a resource URI that TanStack AI fetches and streams to the client as a `UIResourcePart` — ready to render as a full interactive iframe widget.\n\nThere are two levels of MCP Apps support:\n\n- **Static** — the MCP tool result contains a `ui://` resource. TanStack AI reads it during the `chat()` run and surfaces it as a `UIResourcePart` on the assistant `UIMessage`. No extra routes needed; render it with `MCPAppResource`.\n- **Interactive** — the widget's iframe posts tool-call or prompt actions back. You mount a server handler (`createMcpAppCallHandler`) at a route and wire a client bridge (`createMcpAppBridge`) so those actions reach the right MCP server.\n\nTo link a tool to its widget from your own TanStack MCP server, see [Tell the host what a tool does](./server#tell-the-host-what-a-tool-does).\n\n## Static Widgets\n\nWhen an MCP tool's result carries a `ui://` resource, TanStack AI emits a `UIResourcePart` on the assistant `UIMessage`. The part is added to the message's `parts` array **alongside** the normal `ToolResultPart` — it never enters model input.\n\n### The `UIResourcePart` shape\n\n```ts\nimport type { UIResourcePart } from '@tanstack/ai'\n\n// Arrives on the assistant UIMessage alongside ToolCallPart / ToolResultPart:\n// {\n//   type: 'ui-resource'\n//   resource: { uri: string; mimeType: string; text?: string; blob?: string }\n//   serverId?: string     // pool prefix / config key — routes interactive calls\n//   toolCallId: string    // links to the originating tool call\n//   toolName: string      // MCP tool name whose UI this resource renders\n//   meta?: Record<string, unknown>  // reserved — currently always undefined\n// }\n```\n\nNo server-side changes are needed beyond connecting an MCP server that returns `ui://` resources. The resource is read eagerly during the chat run. If the read fails (network error, missing resource), the tool result still flows to the model — the widget is simply absent (**fail-soft**).\n\n### Server route\n\n```ts ignore\n// src/routes/api.chat.ts  (TanStack Start)\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const { messages } = await request.json()\n\n        const mcp = await createMCPClient({\n          transport: {\n            type: 'http',\n            url: process.env.MCP_URL!,\n          },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages,\n          mcp: { clients: [mcp] },\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n### React client — rendering a static widget\n\nInstall the optional peer dependency:\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @mcp-ui/client\npreact: @mcp-ui/client\n\n<!-- ::end:tabs -->\n\nThen render each `ui-resource` part from the assistant message.\n\n> **What is `sandbox`?** `sandbox.url` points to a small static **sandbox-proxy HTML page that you host** (e.g. `mcp-sandbox.html` on your own origin). `AppRenderer` loads that page in an isolated iframe and renders the widget inside it — it's the security boundary, so it's a **deploy-time constant, the same for every widget**. It is *not* the widget's address: the widget's identity and HTML come from the message part (`part.resource`, a `ui://…` resource). See [`@mcp-ui/client`](https://mcpui.dev) for the proxy page.\n\n```tsx\n// src/components/Chat.tsx\nimport { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { MCPAppResource } from '@tanstack/ai-react/mcp-apps'\nimport type { UIResourcePart } from '@tanstack/ai'\n\nexport function Chat() {\n  const { messages, sendMessage, status } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.parts.map((part, i) => {\n            if (part.type === 'text') {\n              return <p key={i}>{part.content}</p>\n            }\n            if (part.type === 'ui-resource') {\n              return (\n                <MCPAppResource\n                  key={i}\n                  part={part}\n                  // your hosted sandbox-proxy page (a host constant, not the widget URL)\n                  sandbox={{ url: new URL('https://your-app.example.com/mcp-sandbox.html') }}\n                />\n              )\n            }\n            return null\n          })}\n        </div>\n      ))}\n      <button\n        onClick={() => sendMessage({ content: 'Show me the weather widget' })}\n        disabled={status === 'streaming'}\n      >\n        Send\n      </button>\n    </div>\n  )\n}\n```\n\n`MCPAppResource` is powered by `@mcp-ui/client`'s `AppRenderer` under the hood. Without a `bridge` prop the widget renders in display-only mode — user interactions inside the iframe that trigger tool calls or prompts are ignored.\n\n> **Framework support:** React and Preact are shipped (`@tanstack/ai-react/mcp-apps` and `@tanstack/ai-preact/mcp-apps`). Preact requires a `preact/compat` alias. Solid, Vue, Svelte, and Angular wrappers are deferred — `@mcp-ui/client` v7's `AppRenderer` is React-only and a framework-agnostic renderer SDK is future work.\n\n## Interactive Widgets\n\nFor widgets that need to call tools or send prompts back to the model, you wire two extra pieces:\n\n1. **Server** — mount `createMcpAppCallHandler` at a POST route. The widget's iframe calls this route.\n2. **Client** — create a `createMcpAppBridge` and pass it to `MCPAppResource`. The bridge routes the iframe's actions (tool calls, prompts, links) to the correct handler.\n\n### Installation\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai-mcp @tanstack/ai-client @mcp-ui/client\npreact: @tanstack/ai-mcp @tanstack/ai-client @mcp-ui/client\n\n<!-- ::end:tabs -->\n\n### Server — the call handler route\n\n`createMcpAppCallHandler` from `@tanstack/ai-mcp/apps` accepts the MCP client(s) you already created (a single `MCPClient`, an `MCPClients` pool, or an array of either) and returns a request handler that:\n\n- Resolves each client's transport descriptor via `client.getInfo()` / `pool.getServers()` (pure config — no live socket needed).\n- Reconnects to the MCP server per call using that descriptor (stateless; serverless-safe by default).\n- Checks that the requested `toolName` is actually exposed by that server (same-server allowlist).\n- Calls the tool and returns `{ ok: true, result }` or `{ ok: false, error }`.\n\n```ts ignore\n// src/routes/api.mcp-apps-call.ts  (TanStack Start)\nimport { createFileRoute } from '@tanstack/react-router'\nimport { createMCPClients } from '@tanstack/ai-mcp'\nimport { createMcpAppCallHandler } from '@tanstack/ai-mcp/apps'\n\n// Reuse the same pool you pass to chat({ mcp: { clients: [mcp] } }).\nconst mcp = await createMCPClients({\n  weather: {\n    transport: {\n      type: 'http',\n      url: process.env.WEATHER_MCP_URL!,\n      headers: { Authorization: `Bearer ${process.env.WEATHER_MCP_TOKEN ?? ''}` },\n    },\n  },\n})\n\n// clients: a single MCPClient, an MCPClients pool, or an array of either.\n// The handler reads each client's transport descriptor via getInfo()/getServers()\n// and reconnects per call — works in long-lived servers and serverless alike.\nconst handler = createMcpAppCallHandler({ clients: mcp })\n\nexport const Route = createFileRoute('/api/mcp-apps/call')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n        // body: { threadId, serverId, toolName, args?, messageId? }\n        const result = await handler(body)\n        return new Response(JSON.stringify(result), {\n          headers: { 'Content-Type': 'application/json' },\n        })\n      },\n    },\n  },\n})\n```\n\n> **`link` actions need an `onLink` handler.** If the widget emits a `link` action and no `onLink` handler is wired in the bridge, the bridge drops the link (logging a warning) and `openLink` returns `{ isError: true }` — the call does not hang, and the widget cannot open arbitrary URLs in the host page. Pass `onLink` explicitly to opt in.\n>\n> Even with an `onLink` handler, the bridge only forwards `http:`, `https:`, and `mailto:` URLs. Unsafe schemes (`javascript:`, `data:`, `file:`, …) are **always rejected** before your handler runs, so a sandboxed widget can't smuggle a script-executing or local-resource URL through.\n\n#### Same-server allowlist\n\n`createMcpAppCallHandler` always verifies that `toolName` is in the list of tools the target server actually exposes. A request for a tool the server does not know about returns `{ ok: false, error: \"Tool not allowed: <name>\" }` without ever executing it. This server-exposure check is unconditional and cannot be bypassed.\n\nThe handler also uses the [tool policy](../tools/mcp#limit-and-gate-tools) of each client:\n\n- `toolFilter`: a tool that the filter hides returns `Tool not allowed: <name>`.\n- `needsApproval`: a widget call has no approval step. A tool that `needsApproval` marks returns `{ ok: false, error: \"Tool needs approval: <name>\" }`.\n\nUse the `allowTool` option to add a further restriction on top. A request must satisfy **both** the server-exposure check and `allowTool` — it is AND-ed, not a replacement for the server check:\n\n```ts\nimport { createMCPClients } from '@tanstack/ai-mcp'\nimport { createMcpAppCallHandler } from '@tanstack/ai-mcp/apps'\n\nconst mcp = await createMCPClients({\n  weather: { transport: { type: 'http', url: process.env.MCP_URL ?? '' } },\n})\n\nconst handler = createMcpAppCallHandler({\n  clients: mcp,\n  // Additional restriction: even if the server exposes more tools,\n  // only allow this specific one through the call handler.\n  allowTool: (req) => req.toolName === 'place_order',\n})\n```\n\n### Chat route — wire the `serverId`\n\nThe `serverId` on a `UIResourcePart` comes from the `prefix` you gave the MCP client. Use the same key in both places:\n\n> **Multi-server routing:** interactive calls route by `serverId`, which is each client's `prefix`. `createMCPClients` defaults every server's prefix to its config key, so routing works out of the box. If you pass multiple servers and disable prefixing on one (`prefix: ''`), that server has no `serverId` and its widgets can't make interactive calls — give each interactive server a distinct prefix (the default is fine).\n\n\n```ts ignore\n// src/routes/api.chat.ts\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClients } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n\n        // The pool key \"weather\" becomes the serverId on every UIResourcePart\n        // emitted by this server — must match the key used when constructing\n        // the pool passed to createMcpAppCallHandler.\n        const pool = await createMCPClients({\n          weather: {\n            transport: { type: 'http', url: process.env.WEATHER_MCP_URL! },\n          },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages: body.messages,\n          mcp: { clients: [pool] },\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n### Client — bridge + interactive render\n\n`createMcpAppBridge` from `@tanstack/ai-client` returns an action handler you pass to `MCPAppResource`. It routes:\n\n- `tool` actions → POST to `callEndpoint` with the tool call payload.\n- `prompt` actions → `chat.sendMessage(prompt)`.\n- `link` actions → `onLink(url)` if provided; dropped (with a warning) otherwise.\n\nIn React (or Preact), use the `useMcpAppBridge` hook — it returns a **stable**\nbridge for the given `threadId`/`callEndpoint` and always calls your latest\n`sendMessage`/`onLink`, so you don't hand-write `useMemo` or fight\n`exhaustive-deps`. (The underlying `createMcpAppBridge` from\n`@tanstack/ai-client` is framework-agnostic if you need it directly.)\n\n```tsx\n// src/components/Chat.tsx\nimport { useChat, useMcpAppBridge } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { MCPAppResource } from '@tanstack/ai-react/mcp-apps'\n\nexport function Chat() {\n  // A stable id correlating widget calls back to this conversation.\n  const threadId = 'weather-chat'\n  const { messages, sendMessage, status } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const bridge = useMcpAppBridge({\n    threadId,\n    callEndpoint: '/api/mcp-apps/call',\n    chat: { sendMessage: (content, body) => sendMessage(content, { body }) },\n    // Opt in to link navigation — absent means links are blocked.\n    onLink: (url) => window.open(url, '_blank', 'noopener'),\n  })\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.parts.map((part, i) => {\n            if (part.type === 'text') {\n              return <p key={i}>{part.content}</p>\n            }\n            if (part.type === 'ui-resource') {\n              return (\n                <MCPAppResource\n                  key={i}\n                  part={part}\n                  bridge={bridge}\n                  // your hosted sandbox-proxy page (a host constant, not the widget URL)\n                  sandbox={{ url: new URL('https://your-app.example.com/mcp-sandbox.html') }}\n                />\n              )\n            }\n            return null\n          })}\n        </div>\n      ))}\n      <button\n        onClick={() => sendMessage({ content: 'Show me the weather widget' })}\n        disabled={status === 'streaming'}\n      >\n        Send\n      </button>\n    </div>\n  )\n}\n```\n\n> **Writeback is client-side.** Widget tool calls do **not** append to the thread's chat history by default. The conversation state writeback path is out of scope for the current release. Each widget interaction is self-contained.\n\n## Session Persistence\n\nThe call handler reconnects to the MCP server on every widget action using the transport descriptor it reads from `client.getInfo()` / `pool.getServers()` (**reconnect-per-call** — stateless, serverless-safe). For stateful MCP transports that require a persistent session, opt in to an in-memory session store:\n\n```ts\nimport { createMCPClients } from '@tanstack/ai-mcp'\nimport {\n  createMcpAppCallHandler,\n  inMemoryMcpSessionStore,\n} from '@tanstack/ai-mcp/apps'\n\nconst mcp = await createMCPClients({\n  weather: { transport: { type: 'http', url: process.env.MCP_URL ?? '' } },\n})\n\n// In-memory store: one Node.js process, no cross-instance sharing.\n// Shape matches the McpSessionStore interface — SQL / KV stores\n// can be dropped in later with no API change.\nconst store = inMemoryMcpSessionStore({ ttlMs: 30 * 60_000 })\n\nconst handler = createMcpAppCallHandler({ clients: mcp, store })\n```\n\n> **Current limitation:** `inMemoryMcpSessionStore` is single-instance (one Node.js process). It does not survive serverless restarts or scale across replicas. The `McpSessionStore` interface is the persistence extension point — persistent backends (database, KV store) can be dropped in without any API changes.\n\n## API Reference\n\n### `createMcpAppCallHandler` (`@tanstack/ai-mcp/apps`)\n\n```ts\nimport { createMCPClients } from '@tanstack/ai-mcp'\nimport { createMcpAppCallHandler } from '@tanstack/ai-mcp/apps'\nimport type { McpAppCallHandlerOptions } from '@tanstack/ai-mcp/apps'\n\nconst mcp = await createMCPClients({\n  weather: { transport: { type: 'http', url: process.env.MCP_URL ?? '' } },\n})\n\nconst options: McpAppCallHandlerOptions = {\n  // Pass the MCP client(s) you already created:\n  //   - a single MCPClient\n  //   - an MCPClients pool  (pool key = serverId on UIResourcePart)\n  //   - an array of either\n  // The handler reads each client's transport descriptor via\n  // client.getInfo() / pool.getServers() (pure config, no live socket)\n  // and reconnects per call — serverless-safe by default.\n  clients: mcp,\n\n  // Dynamic session store (opt-in for stateful transports)\n  // store: inMemoryMcpSessionStore(),\n\n  // Custom tool allowlist — default: server's own exposed tools only\n  // AND-ed on top of the always-on same-server exposure check.\n  allowTool: (req) => req.toolName === 'get_weather',\n}\n\n// Returns: (req) => Promise<{ ok: true; result: unknown } | { ok: false; error: string }>\nconst handler = createMcpAppCallHandler(options)\n```\n\n### `inMemoryMcpSessionStore` (`@tanstack/ai-mcp/apps`)\n\n```ts\nimport { inMemoryMcpSessionStore } from '@tanstack/ai-mcp/apps'\n\nconst store = inMemoryMcpSessionStore({\n  ttlMs: 30 * 60_000, // optional; default: 30 minutes\n})\n```\n\n### `createMcpAppBridge` (`@tanstack/ai-client`)\n\n```ts\nimport { createMcpAppBridge } from '@tanstack/ai-client'\nimport type { CreateMcpAppBridgeOptions } from '@tanstack/ai-client'\n\nconst options: CreateMcpAppBridgeOptions = {\n  threadId: 'weather-chat', // identifies the thread for the call handler\n  callEndpoint: '/api/mcp-apps/call', // POST route mounting createMcpAppCallHandler\n  chat: {\n    sendMessage: async (content, body) => {\n      console.log(content, body)\n    },\n  }, // prompt-intent path\n  fetchImpl: fetch, // optional; injectable for testing\n  onLink: (url) => window.open(url, '_blank'), // absent → link is dropped (warned), openLink returns { isError: true }\n}\n\n// Returns an McpAppBridge with callTool / sendPrompt / openLink methods.\nconst bridge = createMcpAppBridge(options)\n```\n\n### `useMcpAppBridge` (`@tanstack/ai-react` / `@tanstack/ai-preact`)\n\nThe React/Preact wrapper around `createMcpAppBridge`. Returns a bridge that is\n**stable** for a given `threadId`/`callEndpoint` (so it won't churn `MCPAppResource`\non every render) while always invoking the latest `chat.sendMessage`/`onLink`.\nTakes the same options as `createMcpAppBridge`.\n\n```tsx\nimport { useChat, useMcpAppBridge } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nfunction useBridge(threadId: string) {\n  const { sendMessage } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n  return useMcpAppBridge({\n    threadId,\n    callEndpoint: '/api/mcp-apps/call',\n    chat: { sendMessage: (content, body) => sendMessage(content, { body }) },\n    onLink: (url) => window.open(url, '_blank', 'noopener'),\n  })\n}\n```\n\n### `MCPAppResource` (`@tanstack/ai-react/mcp-apps`)\n\n```tsx\nimport { MCPAppResource } from '@tanstack/ai-react/mcp-apps'\n// `part` is a UIResourcePart from the assistant message; `bridge` is a\n// createMcpAppBridge result — both supplied by your component (see examples above).\nimport { part, bridge } from './chat-context'\n\nconst widget = (\n  <MCPAppResource\n    part={part} // UIResourcePart from the assistant message (carries the toolName)\n    sandbox={{ url: new URL('https://your-app.example.com/mcp-sandbox.html') }} // your hosted sandbox-proxy page (host constant; not the widget's ui:// URL)\n    bridge={bridge} // omit for static, display-only rendering\n    toolInput={{ city: 'Brooklyn' }} // optional tool input for the renderer context\n  />\n)\n```\n\nPreact: identical API from `@tanstack/ai-preact/mcp-apps` (requires `preact/compat` alias).\n"}
