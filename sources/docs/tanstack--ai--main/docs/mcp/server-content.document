{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Until you serve a resource, a host cannot read your document. Until you serve a prompt, a host cannot start from that prompt."}]},{"type":"heading","depth":2,"id":"define-resources-and-prompts","children":[{"type":"text","value":"Define Resources and Prompts"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Define each document with "},{"type":"inlineCode","value":"resourceDefinition"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Define each prompt with "},{"type":"inlineCode","value":"promptDefinition"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Pass "},{"type":"inlineCode","value":"resources"},{"type":"text","value":" and "},{"type":"inlineCode","value":"prompts"},{"type":"text","value":" to "},{"type":"inlineCode","value":"createMCPServer"},{"type":"text","value":"."}]}]}]},{"type":"code","value":"import {\n  createMCPServer,\n  promptDefinition,\n  resourceDefinition,\n} from '@tanstack/ai-mcp/server'\nimport { z } from 'zod'\n\nconst readme = resourceDefinition({\n  name: 'readme',\n  mimeType: 'text/markdown',\n  uri: 'file:///readme.md',\n}).read(async () => ({ text: '# Hello' }))\n\nconst file = resourceDefinition({\n  name: 'file',\n  mimeType: 'text/plain',\n  uriTemplate: 'file:///{path}',\n}).read(async () => ({ text: 'file body' }))\n\nconst summarize = promptDefinition({\n  name: 'summarize',\n  description: 'Summarize a topic',\n  argsSchema: z.object({ topic: z.string() }),\n}).render(async (args) => [{ role: 'user', content: args.topic }])\n\nconst server = createMCPServer({\n  name: 'library',\n  version: '1.0.0',\n  resources: [readme, file],\n  prompts: [summarize],\n})\n\nexport function handleMcp(request: Request) {\n  return server.fetch(request)\n}","lang":"ts"},{"type":"heading","depth":2,"id":"resources","children":[{"type":"text","value":"Resources"}]},{"type":"paragraph","children":[{"type":"text","value":"A resource must have "},{"type":"inlineCode","value":"uri"},{"type":"text","value":" or "},{"type":"inlineCode","value":"uriTemplate"},{"type":"text","value":"."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"uri"},{"type":"text","value":": one document. An example is "},{"type":"inlineCode","value":"file:///readme.md"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"uriTemplate"},{"type":"text","value":": a URI pattern. An example is "},{"type":"inlineCode","value":"file:///{path}"},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"If the resource has no "},{"type":"inlineCode","value":"uri"},{"type":"text","value":" and no "},{"type":"inlineCode","value":"uriTemplate"},{"type":"text","value":", "},{"type":"inlineCode","value":"resourceDefinition"},{"type":"text","value":" throws "},{"type":"inlineCode","value":"This resource has no uri and no uriTemplate. Pass a uri or a uriTemplate."}]},{"type":"paragraph","children":[{"type":"text","value":"If you pass "},{"type":"inlineCode","value":"uri"},{"type":"text","value":" and "},{"type":"inlineCode","value":"uriTemplate"},{"type":"text","value":", the server uses "},{"type":"inlineCode","value":"uri"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"read"},{"type":"text","value":" returns "},{"type":"inlineCode","value":"{ text }"},{"type":"text","value":" for a text document. For a binary document, "},{"type":"inlineCode","value":"read"},{"type":"text","value":" returns "},{"type":"inlineCode","value":"{ blob }"},{"type":"text","value":" with a base64 string."}]},{"type":"heading","depth":2,"id":"serve-one-resource-per-item","children":[{"type":"text","value":"Serve One Resource per Item"}]},{"type":"paragraph","children":[{"type":"text","value":"A template such as "},{"type":"inlineCode","value":"myapp://items/{itemId}/summary"},{"type":"text","value":" serves many documents. The read must know which item the host asked for, and which user asks. A host also needs a list of the items that exist."}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Read "},{"type":"inlineCode","value":"itemId"},{"type":"text","value":" from the "},{"type":"inlineCode","value":"variables"},{"type":"text","value":" argument of "},{"type":"inlineCode","value":"read"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Read the user from "},{"type":"inlineCode","value":"ctx.context"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add "},{"type":"inlineCode","value":"list"},{"type":"text","value":" to return the concrete resources for "},{"type":"inlineCode","value":"resources/list"},{"type":"text","value":"."}]}]}]},{"type":"code","value":"import { createMCPServer, resourceDefinition } from '@tanstack/ai-mcp/server'\n\nconst summaries = new Map([\n  ['1', 'First item'],\n  ['2', 'Second item'],\n])\n\nconst summary = resourceDefinition({\n  name: 'item-summary',\n  mimeType: 'text/plain',\n  uriTemplate: 'myapp://items/{itemId}/summary',\n  list: async () => ({\n    resources: [...summaries.keys()].map((id) => ({\n      uri: `myapp://items/${id}/summary`,\n      name: `Item ${id}`,\n    })),\n  }),\n}).read(async (uri, variables, ctx) => {\n  const itemId = String(variables.itemId)\n  const userId = String(ctx.context.userId)\n  return { text: `${summaries.get(itemId) ?? 'Unknown'} (for ${userId})` }\n})\n\nconst server = createMCPServer({\n  name: 'items',\n  version: '1.0.0',\n  resources: [summary],\n})\n\nexport function handleMcp(request: Request, userId: string) {\n  return server.handle(request, { context: { userId } })\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"read"},{"type":"text","value":" gets three arguments:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"uri"},{"type":"text","value":": the URI the host asked for, as a "},{"type":"inlineCode","value":"URL"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"variables"},{"type":"text","value":": the values from the template. A resource with "},{"type":"inlineCode","value":"uri"},{"type":"text","value":" gets "},{"type":"inlineCode","value":"{}"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ctx.context"},{"type":"text","value":": the values from "},{"type":"inlineCode","value":"handle(request, { context })"},{"type":"text","value":", plus the verified token as "},{"type":"inlineCode","value":"authInfo"},{"type":"text","value":". A tool gets the same values, plus "},{"type":"inlineCode","value":"requestInput"},{"type":"text","value":" and "},{"type":"inlineCode","value":"sample"},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"list"},{"type":"text","value":" gets the same "},{"type":"inlineCode","value":"ctx"},{"type":"text","value":". It returns "},{"type":"inlineCode","value":"{ resources }"},{"type":"text","value":", with a "},{"type":"inlineCode","value":"uri"},{"type":"text","value":" and a "},{"type":"inlineCode","value":"name"},{"type":"text","value":" for each resource. Only a resource with "},{"type":"inlineCode","value":"uriTemplate"},{"type":"text","value":" can have "},{"type":"inlineCode","value":"list"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"prompts","children":[{"type":"text","value":"Prompts"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"argsSchema.parse"},{"type":"text","value":" runs first. Then "},{"type":"inlineCode","value":"render"},{"type":"text","value":" receives the parsed arguments."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"render"},{"type":"text","value":" returns an array of messages. Each message has these fields:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"role"},{"type":"text","value":": "},{"type":"inlineCode","value":"user"},{"type":"text","value":" or "},{"type":"inlineCode","value":"assistant"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"content"},{"type":"text","value":": the message text."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"role"},{"type":"text","value":" is not "},{"type":"inlineCode","value":"user"},{"type":"text","value":" or "},{"type":"inlineCode","value":"assistant"},{"type":"text","value":", the server sends that message as "},{"type":"inlineCode","value":"user"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"what-the-host-gets","children":[{"type":"text","value":"What the Host Gets"}]},{"type":"paragraph","children":[{"type":"text","value":"The host reads "},{"type":"inlineCode","value":"file:///readme.md"},{"type":"text","value":". The "},{"type":"inlineCode","value":"text"},{"type":"text","value":" is "},{"type":"inlineCode","value":"# Hello"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The host starts from the "},{"type":"inlineCode","value":"summarize"},{"type":"text","value":" prompt with topic "},{"type":"inlineCode","value":"weather"},{"type":"text","value":". The "},{"type":"inlineCode","value":"role"},{"type":"text","value":" is "},{"type":"inlineCode","value":"user"},{"type":"text","value":". The "},{"type":"inlineCode","value":"content"},{"type":"text","value":" string is "},{"type":"inlineCode","value":"weather"},{"type":"text","value":"."}]}],"headings":[{"id":"define-resources-and-prompts","text":"Define Resources and Prompts","level":2},{"id":"resources","text":"Resources","level":2},{"id":"serve-one-resource-per-item","text":"Serve One Resource per Item","level":2},{"id":"prompts","text":"Prompts","level":2},{"id":"what-the-host-gets","text":"What the Host Gets","level":2}]},"frameworks":[],"downloadMarkdown":"\nUntil you serve a resource, a host cannot read your document. Until you serve a prompt, a host cannot start from that prompt.\n\n## Define Resources and Prompts\n\n1. Define each document with `resourceDefinition`.\n2. Define each prompt with `promptDefinition`.\n3. Pass `resources` and `prompts` to `createMCPServer`.\n\n```ts\nimport {\n  createMCPServer,\n  promptDefinition,\n  resourceDefinition,\n} from '@tanstack/ai-mcp/server'\nimport { z } from 'zod'\n\nconst readme = resourceDefinition({\n  name: 'readme',\n  mimeType: 'text/markdown',\n  uri: 'file:///readme.md',\n}).read(async () => ({ text: '# Hello' }))\n\nconst file = resourceDefinition({\n  name: 'file',\n  mimeType: 'text/plain',\n  uriTemplate: 'file:///{path}',\n}).read(async () => ({ text: 'file body' }))\n\nconst summarize = promptDefinition({\n  name: 'summarize',\n  description: 'Summarize a topic',\n  argsSchema: z.object({ topic: z.string() }),\n}).render(async (args) => [{ role: 'user', content: args.topic }])\n\nconst server = createMCPServer({\n  name: 'library',\n  version: '1.0.0',\n  resources: [readme, file],\n  prompts: [summarize],\n})\n\nexport function handleMcp(request: Request) {\n  return server.fetch(request)\n}\n```\n\n## Resources\n\nA resource must have `uri` or `uriTemplate`.\n\n- `uri`: one document. An example is `file:///readme.md`.\n- `uriTemplate`: a URI pattern. An example is `file:///{path}`.\n\nIf the resource has no `uri` and no `uriTemplate`, `resourceDefinition` throws `This resource has no uri and no uriTemplate. Pass a uri or a uriTemplate.`\n\nIf you pass `uri` and `uriTemplate`, the server uses `uri`.\n\n`read` returns `{ text }` for a text document. For a binary document, `read` returns `{ blob }` with a base64 string.\n\n## Serve One Resource per Item\n\nA template such as `myapp://items/{itemId}/summary` serves many documents. The read must know which item the host asked for, and which user asks. A host also needs a list of the items that exist.\n\n1. Read `itemId` from the `variables` argument of `read`.\n2. Read the user from `ctx.context`.\n3. Add `list` to return the concrete resources for `resources/list`.\n\n```ts\nimport { createMCPServer, resourceDefinition } from '@tanstack/ai-mcp/server'\n\nconst summaries = new Map([\n  ['1', 'First item'],\n  ['2', 'Second item'],\n])\n\nconst summary = resourceDefinition({\n  name: 'item-summary',\n  mimeType: 'text/plain',\n  uriTemplate: 'myapp://items/{itemId}/summary',\n  list: async () => ({\n    resources: [...summaries.keys()].map((id) => ({\n      uri: `myapp://items/${id}/summary`,\n      name: `Item ${id}`,\n    })),\n  }),\n}).read(async (uri, variables, ctx) => {\n  const itemId = String(variables.itemId)\n  const userId = String(ctx.context.userId)\n  return { text: `${summaries.get(itemId) ?? 'Unknown'} (for ${userId})` }\n})\n\nconst server = createMCPServer({\n  name: 'items',\n  version: '1.0.0',\n  resources: [summary],\n})\n\nexport function handleMcp(request: Request, userId: string) {\n  return server.handle(request, { context: { userId } })\n}\n```\n\n`read` gets three arguments:\n\n- `uri`: the URI the host asked for, as a `URL`.\n- `variables`: the values from the template. A resource with `uri` gets `{}`.\n- `ctx.context`: the values from `handle(request, { context })`, plus the verified token as `authInfo`. A tool gets the same values, plus `requestInput` and `sample`.\n\n`list` gets the same `ctx`. It returns `{ resources }`, with a `uri` and a `name` for each resource. Only a resource with `uriTemplate` can have `list`.\n\n## Prompts\n\n`argsSchema.parse` runs first. Then `render` receives the parsed arguments.\n\n`render` returns an array of messages. Each message has these fields:\n\n- `role`: `user` or `assistant`.\n- `content`: the message text.\n\nIf `role` is not `user` or `assistant`, the server sends that message as `user`.\n\n## What the Host Gets\n\nThe host reads `file:///readme.md`. The `text` is `# Hello`.\n\nThe host starts from the `summarize` prompt with topic `weather`. The `role` is `user`. The `content` string is `weather`.\n","originalRawMarkdown":"---\ntitle: Serve Resources and Prompts\nid: mcp-server-content\norder: 13\ndescription: \"Serve documents and prompts from your MCP server so a host can read a document or start from a prompt.\"\nkeywords:\n  - tanstack ai\n  - mcp\n  - model context protocol\n  - mcp server\n  - resources\n  - prompts\n  - resourceDefinition\n  - promptDefinition\n  - createMCPServer\n---\n\nUntil you serve a resource, a host cannot read your document. Until you serve a prompt, a host cannot start from that prompt.\n\n## Define Resources and Prompts\n\n1. Define each document with `resourceDefinition`.\n2. Define each prompt with `promptDefinition`.\n3. Pass `resources` and `prompts` to `createMCPServer`.\n\n```ts\nimport {\n  createMCPServer,\n  promptDefinition,\n  resourceDefinition,\n} from '@tanstack/ai-mcp/server'\nimport { z } from 'zod'\n\nconst readme = resourceDefinition({\n  name: 'readme',\n  mimeType: 'text/markdown',\n  uri: 'file:///readme.md',\n}).read(async () => ({ text: '# Hello' }))\n\nconst file = resourceDefinition({\n  name: 'file',\n  mimeType: 'text/plain',\n  uriTemplate: 'file:///{path}',\n}).read(async () => ({ text: 'file body' }))\n\nconst summarize = promptDefinition({\n  name: 'summarize',\n  description: 'Summarize a topic',\n  argsSchema: z.object({ topic: z.string() }),\n}).render(async (args) => [{ role: 'user', content: args.topic }])\n\nconst server = createMCPServer({\n  name: 'library',\n  version: '1.0.0',\n  resources: [readme, file],\n  prompts: [summarize],\n})\n\nexport function handleMcp(request: Request) {\n  return server.fetch(request)\n}\n```\n\n## Resources\n\nA resource must have `uri` or `uriTemplate`.\n\n- `uri`: one document. An example is `file:///readme.md`.\n- `uriTemplate`: a URI pattern. An example is `file:///{path}`.\n\nIf the resource has no `uri` and no `uriTemplate`, `resourceDefinition` throws `This resource has no uri and no uriTemplate. Pass a uri or a uriTemplate.`\n\nIf you pass `uri` and `uriTemplate`, the server uses `uri`.\n\n`read` returns `{ text }` for a text document. For a binary document, `read` returns `{ blob }` with a base64 string.\n\n## Serve One Resource per Item\n\nA template such as `myapp://items/{itemId}/summary` serves many documents. The read must know which item the host asked for, and which user asks. A host also needs a list of the items that exist.\n\n1. Read `itemId` from the `variables` argument of `read`.\n2. Read the user from `ctx.context`.\n3. Add `list` to return the concrete resources for `resources/list`.\n\n```ts\nimport { createMCPServer, resourceDefinition } from '@tanstack/ai-mcp/server'\n\nconst summaries = new Map([\n  ['1', 'First item'],\n  ['2', 'Second item'],\n])\n\nconst summary = resourceDefinition({\n  name: 'item-summary',\n  mimeType: 'text/plain',\n  uriTemplate: 'myapp://items/{itemId}/summary',\n  list: async () => ({\n    resources: [...summaries.keys()].map((id) => ({\n      uri: `myapp://items/${id}/summary`,\n      name: `Item ${id}`,\n    })),\n  }),\n}).read(async (uri, variables, ctx) => {\n  const itemId = String(variables.itemId)\n  const userId = String(ctx.context.userId)\n  return { text: `${summaries.get(itemId) ?? 'Unknown'} (for ${userId})` }\n})\n\nconst server = createMCPServer({\n  name: 'items',\n  version: '1.0.0',\n  resources: [summary],\n})\n\nexport function handleMcp(request: Request, userId: string) {\n  return server.handle(request, { context: { userId } })\n}\n```\n\n`read` gets three arguments:\n\n- `uri`: the URI the host asked for, as a `URL`.\n- `variables`: the values from the template. A resource with `uri` gets `{}`.\n- `ctx.context`: the values from `handle(request, { context })`, plus the verified token as `authInfo`. A tool gets the same values, plus `requestInput` and `sample`.\n\n`list` gets the same `ctx`. It returns `{ resources }`, with a `uri` and a `name` for each resource. Only a resource with `uriTemplate` can have `list`.\n\n## Prompts\n\n`argsSchema.parse` runs first. Then `render` receives the parsed arguments.\n\n`render` returns an array of messages. Each message has these fields:\n\n- `role`: `user` or `assistant`.\n- `content`: the message text.\n\nIf `role` is not `user` or `assistant`, the server sends that message as `user`.\n\n## What the Host Gets\n\nThe host reads `file:///readme.md`. The `text` is `# Hello`.\n\nThe host starts from the `summarize` prompt with topic `weather`. The `role` is `user`. The `content` string is `weather`.\n"}
