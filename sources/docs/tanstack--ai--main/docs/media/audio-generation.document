{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack AI's "},{"type":"inlineCode","value":"generateAudio()"},{"type":"text","value":" activity produces audio content — music, soundscapes, or sound effects — from a text prompt. It's distinct from "},{"type":"link","href":"./text-to-speech","children":[{"type":"text","value":"Text-to-Speech"}]},{"type":"text","value":", which is optimized for spoken-word synthesis."}]},{"type":"heading","depth":2,"id":"overview","children":[{"type":"text","value":"Overview"}]},{"type":"paragraph","children":[{"type":"text","value":"Audio generation is handled by audio adapters that follow the same tree-shakeable architecture as other adapters in TanStack AI."}]},{"type":"paragraph","children":[{"type":"text","value":"Currently supported:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Google Gemini"}]},{"type":"text","value":": Lyria 3 Pro and Lyria 3 Clip music generation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"fal.ai"}]},{"type":"text","value":": MiniMax Music, DiffRhythm, Google Lyria 2, Stable Audio 2.5, MMAudio, ElevenLabs sound effects, Thinksound, and more"}]}]}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"heading","depth":3,"id":"google-lyria-music","children":[{"type":"text","value":"Google Lyria (Music)"}]},{"type":"paragraph","children":[{"type":"text","value":"Google's Lyria models generate full-length songs with vocals and instrumentation. "},{"type":"inlineCode","value":"lyria-3-pro-preview"},{"type":"text","value":" handles multi-verse compositions, while "},{"type":"inlineCode","value":"lyria-3-clip-preview"},{"type":"text","value":" produces 30-second clips."}]},{"type":"code","value":"import { generateAudio } from '@tanstack/ai'\nimport { geminiAudio } from '@tanstack/ai-gemini'\n\nconst result = await generateAudio({\n  adapter: geminiAudio('lyria-3-pro-preview'),\n  prompt: 'Uplifting indie pop with layered vocals and jangly guitars',\n})\n\nconsole.log(result.audio.b64Json) // Base64-encoded audio bytes (Gemini)\nconsole.log(result.audio.contentType) // e.g. \"audio/mpeg\"","lang":"typescript"},{"type":"heading","depth":3,"id":"fal-ai","children":[{"type":"text","value":"fal.ai"}]},{"type":"paragraph","children":[{"type":"text","value":"fal.ai gives access to a broad catalogue of music, SFX, and general audio models through a single "},{"type":"inlineCode","value":"falAudio"},{"type":"text","value":" adapter."}]},{"type":"heading","depth":4,"id":"music-generation-minimax-music-2-6","children":[{"type":"text","value":"Music Generation (MiniMax Music 2.6)"}]},{"type":"paragraph","children":[{"type":"text","value":"MiniMax's latest music model creates full compositions — vocals, backing music, and arrangements — from a single prompt."}]},{"type":"code","value":"import { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/minimax-music/v2.6'),\n  prompt: 'City Pop, 80s retro, groovy synth bass, warm female vocal, 104 BPM',\n})\n\nconsole.log(result.audio.url) // URL to the generated audio file\nconsole.log(result.audio.contentType) // e.g. \"audio/wav\"","lang":"typescript"},{"type":"heading","depth":4,"id":"music-with-explicit-lyrics-diffrhythm","children":[{"type":"text","value":"Music with Explicit Lyrics (DiffRhythm)"}]},{"type":"code","value":"import { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/diffrhythm'),\n  prompt: 'An upbeat electronic track with synths',\n  modelOptions: {\n    lyrics: '[verse]\\nHello world\\n[chorus]\\nLa la la',\n  },\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"sound-effects","children":[{"type":"text","value":"Sound Effects"}]},{"type":"code","value":"import { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/elevenlabs/sound-effects/v2'),\n  prompt: 'Thunderclap followed by heavy rain',\n  duration: 5,\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"minimax-music-v2-lyrics-prompt","children":[{"type":"text","value":"MiniMax Music v2 (lyrics_prompt)"}]},{"type":"paragraph","children":[{"type":"text","value":"Earlier MiniMax variants use a "},{"type":"inlineCode","value":"lyrics_prompt"},{"type":"text","value":" field for lyric guidance."}]},{"type":"code","value":"import { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/minimax-music/v2'),\n  prompt: 'A dreamy pop ballad in the style of the 80s',\n  modelOptions: {\n    lyrics_prompt: '[instrumental]',\n  },\n})","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"If a request doesn't return the audio you expected — a model silently truncates, a provider rejects a prompt, or the response shape looks off — pass "},{"type":"inlineCode","value":"debug: true"},{"type":"text","value":" to see every chunk the provider SDK emits. See "},{"type":"link","href":"../advanced/debug-logging","children":[{"type":"text","value":"Debug Logging"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"adapter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"AudioAdapter"}]},{"type":"tableCell","children":[{"type":"text","value":"The adapter created via "},{"type":"inlineCode","value":"falAudio()"},{"type":"text","value":" (required)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"prompt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Text description of the audio to generate (required)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"duration"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Desired duration in seconds (model-dependent)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"modelOptions"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"object"}]},{"type":"tableCell","children":[{"type":"text","value":"Provider-specific options (fully typed when the model ID is passed as a string literal)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"debug"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"DebugOption"}]},{"type":"tableCell","children":[{"type":"text","value":"Enable per-category debug logging ("},{"type":"inlineCode","value":"true"},{"type":"text","value":", "},{"type":"inlineCode","value":"false"},{"type":"text","value":", or a "},{"type":"inlineCode","value":"DebugConfig"},{"type":"text","value":" — see "},{"type":"link","href":"../advanced/debug-logging","children":[{"type":"text","value":"Debug Logging"}]},{"type":"text","value":")"}]}]]},{"type":"heading","depth":2,"id":"client-hook-usegenerateaudio","children":[{"type":"text","value":"Client Hook ("},{"type":"inlineCode","value":"useGenerateAudio"},{"type":"text","value":")"}]},{"type":"paragraph","children":[{"type":"text","value":"For client-side usage, framework integrations expose a "},{"type":"inlineCode","value":"useGenerateAudio"},{"type":"text","value":"\nhook (or "},{"type":"inlineCode","value":"createGenerateAudio"},{"type":"text","value":" in Svelte) that wraps the same generation\nflow. It mirrors the API of "},{"type":"inlineCode","value":"useGenerateSpeech"},{"type":"text","value":", "},{"type":"inlineCode","value":"useGenerateImage"},{"type":"text","value":", and\nother media hooks — see "},{"type":"link","href":"./generation-hooks","children":[{"type":"text","value":"Generation Hooks"}]},{"type":"text","value":" for the full\nshape."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" For long tracks, keep the run's status and result across a reload or\na dropped connection — and the audio after the provider's URL expires — with\n"},{"type":"link","href":"../persistence/generation-persistence","children":[{"type":"text","value":"Generation Persistence"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":3,"id":"server-streaming-sse-route","children":[{"type":"text","value":"Server (streaming SSE route)"}]},{"type":"code","value":"// routes/api/generate/audio.ts\nimport { generateAudio, toServerSentEventsResponse } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nexport async function POST(req: Request) {\n  const { prompt, duration } = await req.json()\n\n  return toServerSentEventsResponse(\n    generateAudio({\n      adapter: falAudio('fal-ai/diffrhythm'),\n      prompt,\n      duration,\n      stream: true,\n    }),\n  )\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"client-react","children":[{"type":"text","value":"Client (React)"}]},{"type":"code","value":"import { useGenerateAudio } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nfunction AudioGenerator() {\n  const { generate, result, isLoading, error, reset } = useGenerateAudio({\n    connection: fetchServerSentEvents('/api/generate/audio'),\n  })\n\n  return (\n    <div>\n      <button\n        onClick={() =>\n          generate({ prompt: 'An upbeat electronic track', duration: 10 })\n        }\n        disabled={isLoading}\n      >\n        {isLoading ? 'Generating...' : 'Generate'}\n      </button>\n      {error && <p>Error: {error.message}</p>}\n      {result?.audio.url && <audio src={result.audio.url} controls />}\n      {result && <button onClick={reset}>Clear</button>}\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"fetcher"},{"type":"text","value":" option instead of "},{"type":"inlineCode","value":"connection"},{"type":"text","value":" when calling a TanStack\nStart server function directly."}]},{"type":"heading","depth":2,"id":"advanced","children":[{"type":"text","value":"Advanced"}]},{"type":"paragraph","children":[{"type":"text","value":"Reference detail you do not need to get this working."}]},{"type":"heading","depth":3,"id":"result-shape","children":[{"type":"text","value":"Result Shape"}]},{"type":"code","value":"import type { TokenUsage } from '@tanstack/ai'\n\ninterface AudioGenerationResult {\n  id: string\n  model: string\n  audio: {\n    url?: string\n    b64Json?: string\n    contentType?: string\n    duration?: number\n  }\n  // Canonical TokenUsage (same shape as chat), present when the provider\n  // reports it (e.g. Gemini Lyria via generateContent). Usage-billed providers\n  // (fal) instead surface `usage.billed` ({ quantity, unit: 'units' }) — the\n  // real billed quantity read from fal's `x-fal-billable-units` result header.\n  // Multiply the quantity by the endpoint's unit price (fal pricing API) for\n  // the exact cost.\n  usage?: TokenUsage\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Gemini returns base64-encoded bytes in "},{"type":"inlineCode","value":"result.audio.b64Json"},{"type":"text","value":". The fal adapter returns a URL in "},{"type":"inlineCode","value":"result.audio.url"},{"type":"text","value":" — if you need raw bytes, "},{"type":"inlineCode","value":"fetch()"},{"type":"text","value":" the URL yourself:"}]},{"type":"code","value":"import { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/diffrhythm'),\n  prompt: 'An upbeat electronic track',\n})\n\nconst bytes = new Uint8Array(\n  await (await fetch(result.audio.url!)).arrayBuffer()\n)","lang":"typescript"},{"type":"heading","depth":3,"id":"differences-vs-text-to-speech","children":[{"type":"text","value":"Differences vs Text-to-Speech"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateAudio()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateSpeech()"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]},{"type":"tableCell","children":[{"type":"text","value":"Music, soundscapes, SFX"}]},{"type":"tableCell","children":[{"type":"text","value":"Spoken-word TTS"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Result"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"result.audio.url"},{"type":"text","value":" or "},{"type":"inlineCode","value":"result.audio.b64Json"}]},{"type":"tableCell","children":[{"type":"text","value":"Base64 in "},{"type":"inlineCode","value":"result.audio"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Primary input"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"prompt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"text"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Voice/speed controls"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes ("},{"type":"inlineCode","value":"voice"},{"type":"text","value":", "},{"type":"inlineCode","value":"speed"},{"type":"text","value":")"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"generateSpeech()"},{"type":"text","value":" when you want a spoken voice, and "},{"type":"inlineCode","value":"generateAudio()"},{"type":"text","value":" when you want non-speech audio."}]},{"type":"heading","depth":3,"id":"environment-variables","children":[{"type":"text","value":"Environment Variables"}]},{"type":"paragraph","children":[{"type":"text","value":"Each provider reads its own API key from the environment by default:"}]},{"type":"code","value":"GOOGLE_API_KEY=your-google-api-key\nFAL_KEY=your-fal-api-key","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"Or pass it explicitly to the adapter:"}]},{"type":"code","value":"import { createGeminiAudio } from '@tanstack/ai-gemini'\nimport { falAudio } from '@tanstack/ai-fal'\n\ncreateGeminiAudio('lyria-3-pro-preview', 'your-key')\nfalAudio('fal-ai/diffrhythm', { apiKey: 'your-key' })","lang":"typescript"}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"google-lyria-music","text":"Google Lyria (Music)","level":3},{"id":"fal-ai","text":"fal.ai","level":3},{"id":"music-generation-minimax-music-2-6","text":"Music Generation (MiniMax Music 2.6)","level":4},{"id":"music-with-explicit-lyrics-diffrhythm","text":"Music with Explicit Lyrics (DiffRhythm)","level":4},{"id":"sound-effects","text":"Sound Effects","level":4},{"id":"minimax-music-v2-lyrics-prompt","text":"MiniMax Music v2 (lyrics_prompt)","level":4},{"id":"options","text":"Options","level":2},{"id":"client-hook-usegenerateaudio","text":"Client Hook (useGenerateAudio)","level":2},{"id":"server-streaming-sse-route","text":"Server (streaming SSE route)","level":3},{"id":"client-react","text":"Client (React)","level":3},{"id":"advanced","text":"Advanced","level":2},{"id":"result-shape","text":"Result Shape","level":3},{"id":"differences-vs-text-to-speech","text":"Differences vs Text-to-Speech","level":3},{"id":"environment-variables","text":"Environment Variables","level":3}]},"frameworks":[],"downloadMarkdown":"\nTanStack AI's `generateAudio()` activity produces audio content — music, soundscapes, or sound effects — from a text prompt. It's distinct from [Text-to-Speech](./text-to-speech), which is optimized for spoken-word synthesis.\n\n## Overview\n\nAudio generation is handled by audio adapters that follow the same tree-shakeable architecture as other adapters in TanStack AI.\n\nCurrently supported:\n\n- **Google Gemini**: Lyria 3 Pro and Lyria 3 Clip music generation\n- **fal.ai**: MiniMax Music, DiffRhythm, Google Lyria 2, Stable Audio 2.5, MMAudio, ElevenLabs sound effects, Thinksound, and more\n\n## Basic Usage\n\n### Google Lyria (Music)\n\nGoogle's Lyria models generate full-length songs with vocals and instrumentation. `lyria-3-pro-preview` handles multi-verse compositions, while `lyria-3-clip-preview` produces 30-second clips.\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { geminiAudio } from '@tanstack/ai-gemini'\n\nconst result = await generateAudio({\n  adapter: geminiAudio('lyria-3-pro-preview'),\n  prompt: 'Uplifting indie pop with layered vocals and jangly guitars',\n})\n\nconsole.log(result.audio.b64Json) // Base64-encoded audio bytes (Gemini)\nconsole.log(result.audio.contentType) // e.g. \"audio/mpeg\"\n```\n\n### fal.ai\n\nfal.ai gives access to a broad catalogue of music, SFX, and general audio models through a single `falAudio` adapter.\n\n#### Music Generation (MiniMax Music 2.6)\n\nMiniMax's latest music model creates full compositions — vocals, backing music, and arrangements — from a single prompt.\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/minimax-music/v2.6'),\n  prompt: 'City Pop, 80s retro, groovy synth bass, warm female vocal, 104 BPM',\n})\n\nconsole.log(result.audio.url) // URL to the generated audio file\nconsole.log(result.audio.contentType) // e.g. \"audio/wav\"\n```\n\n#### Music with Explicit Lyrics (DiffRhythm)\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/diffrhythm'),\n  prompt: 'An upbeat electronic track with synths',\n  modelOptions: {\n    lyrics: '[verse]\\nHello world\\n[chorus]\\nLa la la',\n  },\n})\n```\n\n#### Sound Effects\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/elevenlabs/sound-effects/v2'),\n  prompt: 'Thunderclap followed by heavy rain',\n  duration: 5,\n})\n```\n\n#### MiniMax Music v2 (lyrics_prompt)\n\nEarlier MiniMax variants use a `lyrics_prompt` field for lyric guidance.\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/minimax-music/v2'),\n  prompt: 'A dreamy pop ballad in the style of the 80s',\n  modelOptions: {\n    lyrics_prompt: '[instrumental]',\n  },\n})\n```\n\nIf a request doesn't return the audio you expected — a model silently truncates, a provider rejects a prompt, or the response shape looks off — pass `debug: true` to see every chunk the provider SDK emits. See [Debug Logging](../advanced/debug-logging).\n\n## Options\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `adapter` | `AudioAdapter` | The adapter created via `falAudio()` (required) |\n| `prompt` | `string` | Text description of the audio to generate (required) |\n| `duration` | `number` | Desired duration in seconds (model-dependent) |\n| `modelOptions` | `object` | Provider-specific options (fully typed when the model ID is passed as a string literal) |\n| `debug` | `DebugOption` | Enable per-category debug logging (`true`, `false`, or a `DebugConfig` — see [Debug Logging](../advanced/debug-logging)) |\n\n## Client Hook (`useGenerateAudio`)\n\nFor client-side usage, framework integrations expose a `useGenerateAudio`\nhook (or `createGenerateAudio` in Svelte) that wraps the same generation\nflow. It mirrors the API of `useGenerateSpeech`, `useGenerateImage`, and\nother media hooks — see [Generation Hooks](./generation-hooks) for the full\nshape.\n\n> **Note:** For long tracks, keep the run's status and result across a reload or\n> a dropped connection — and the audio after the provider's URL expires — with\n> [Generation Persistence](../persistence/generation-persistence).\n\n### Server (streaming SSE route)\n\n```typescript\n// routes/api/generate/audio.ts\nimport { generateAudio, toServerSentEventsResponse } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nexport async function POST(req: Request) {\n  const { prompt, duration } = await req.json()\n\n  return toServerSentEventsResponse(\n    generateAudio({\n      adapter: falAudio('fal-ai/diffrhythm'),\n      prompt,\n      duration,\n      stream: true,\n    }),\n  )\n}\n```\n\n### Client (React)\n\n```tsx\nimport { useGenerateAudio } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nfunction AudioGenerator() {\n  const { generate, result, isLoading, error, reset } = useGenerateAudio({\n    connection: fetchServerSentEvents('/api/generate/audio'),\n  })\n\n  return (\n    <div>\n      <button\n        onClick={() =>\n          generate({ prompt: 'An upbeat electronic track', duration: 10 })\n        }\n        disabled={isLoading}\n      >\n        {isLoading ? 'Generating...' : 'Generate'}\n      </button>\n      {error && <p>Error: {error.message}</p>}\n      {result?.audio.url && <audio src={result.audio.url} controls />}\n      {result && <button onClick={reset}>Clear</button>}\n    </div>\n  )\n}\n```\n\nUse the `fetcher` option instead of `connection` when calling a TanStack\nStart server function directly.\n\n## Advanced\n\nReference detail you do not need to get this working.\n\n### Result Shape\n\n```typescript\nimport type { TokenUsage } from '@tanstack/ai'\n\ninterface AudioGenerationResult {\n  id: string\n  model: string\n  audio: {\n    url?: string\n    b64Json?: string\n    contentType?: string\n    duration?: number\n  }\n  // Canonical TokenUsage (same shape as chat), present when the provider\n  // reports it (e.g. Gemini Lyria via generateContent). Usage-billed providers\n  // (fal) instead surface `usage.billed` ({ quantity, unit: 'units' }) — the\n  // real billed quantity read from fal's `x-fal-billable-units` result header.\n  // Multiply the quantity by the endpoint's unit price (fal pricing API) for\n  // the exact cost.\n  usage?: TokenUsage\n}\n```\n\nGemini returns base64-encoded bytes in `result.audio.b64Json`. The fal adapter returns a URL in `result.audio.url` — if you need raw bytes, `fetch()` the URL yourself:\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/diffrhythm'),\n  prompt: 'An upbeat electronic track',\n})\n\nconst bytes = new Uint8Array(\n  await (await fetch(result.audio.url!)).arrayBuffer()\n)\n```\n\n### Differences vs Text-to-Speech\n\n| | `generateAudio()` | `generateSpeech()` |\n|---|---|---|\n| Purpose | Music, soundscapes, SFX | Spoken-word TTS |\n| Result | `result.audio.url` or `result.audio.b64Json` | Base64 in `result.audio` |\n| Primary input | `prompt` | `text` |\n| Voice/speed controls | No | Yes (`voice`, `speed`) |\n\nUse `generateSpeech()` when you want a spoken voice, and `generateAudio()` when you want non-speech audio.\n\n### Environment Variables\n\nEach provider reads its own API key from the environment by default:\n\n```bash\nGOOGLE_API_KEY=your-google-api-key\nFAL_KEY=your-fal-api-key\n```\n\nOr pass it explicitly to the adapter:\n\n```typescript\nimport { createGeminiAudio } from '@tanstack/ai-gemini'\nimport { falAudio } from '@tanstack/ai-fal'\n\ncreateGeminiAudio('lyria-3-pro-preview', 'your-key')\nfalAudio('fal-ai/diffrhythm', { apiKey: 'your-key' })\n```\n","originalRawMarkdown":"---\ntitle: Audio Generation\nid: audio-generation\norder: 15\n---\n\nTanStack AI's `generateAudio()` activity produces audio content — music, soundscapes, or sound effects — from a text prompt. It's distinct from [Text-to-Speech](./text-to-speech), which is optimized for spoken-word synthesis.\n\n## Overview\n\nAudio generation is handled by audio adapters that follow the same tree-shakeable architecture as other adapters in TanStack AI.\n\nCurrently supported:\n\n- **Google Gemini**: Lyria 3 Pro and Lyria 3 Clip music generation\n- **fal.ai**: MiniMax Music, DiffRhythm, Google Lyria 2, Stable Audio 2.5, MMAudio, ElevenLabs sound effects, Thinksound, and more\n\n## Basic Usage\n\n### Google Lyria (Music)\n\nGoogle's Lyria models generate full-length songs with vocals and instrumentation. `lyria-3-pro-preview` handles multi-verse compositions, while `lyria-3-clip-preview` produces 30-second clips.\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { geminiAudio } from '@tanstack/ai-gemini'\n\nconst result = await generateAudio({\n  adapter: geminiAudio('lyria-3-pro-preview'),\n  prompt: 'Uplifting indie pop with layered vocals and jangly guitars',\n})\n\nconsole.log(result.audio.b64Json) // Base64-encoded audio bytes (Gemini)\nconsole.log(result.audio.contentType) // e.g. \"audio/mpeg\"\n```\n\n### fal.ai\n\nfal.ai gives access to a broad catalogue of music, SFX, and general audio models through a single `falAudio` adapter.\n\n#### Music Generation (MiniMax Music 2.6)\n\nMiniMax's latest music model creates full compositions — vocals, backing music, and arrangements — from a single prompt.\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/minimax-music/v2.6'),\n  prompt: 'City Pop, 80s retro, groovy synth bass, warm female vocal, 104 BPM',\n})\n\nconsole.log(result.audio.url) // URL to the generated audio file\nconsole.log(result.audio.contentType) // e.g. \"audio/wav\"\n```\n\n#### Music with Explicit Lyrics (DiffRhythm)\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/diffrhythm'),\n  prompt: 'An upbeat electronic track with synths',\n  modelOptions: {\n    lyrics: '[verse]\\nHello world\\n[chorus]\\nLa la la',\n  },\n})\n```\n\n#### Sound Effects\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/elevenlabs/sound-effects/v2'),\n  prompt: 'Thunderclap followed by heavy rain',\n  duration: 5,\n})\n```\n\n#### MiniMax Music v2 (lyrics_prompt)\n\nEarlier MiniMax variants use a `lyrics_prompt` field for lyric guidance.\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/minimax-music/v2'),\n  prompt: 'A dreamy pop ballad in the style of the 80s',\n  modelOptions: {\n    lyrics_prompt: '[instrumental]',\n  },\n})\n```\n\nIf a request doesn't return the audio you expected — a model silently truncates, a provider rejects a prompt, or the response shape looks off — pass `debug: true` to see every chunk the provider SDK emits. See [Debug Logging](../advanced/debug-logging).\n\n## Options\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `adapter` | `AudioAdapter` | The adapter created via `falAudio()` (required) |\n| `prompt` | `string` | Text description of the audio to generate (required) |\n| `duration` | `number` | Desired duration in seconds (model-dependent) |\n| `modelOptions` | `object` | Provider-specific options (fully typed when the model ID is passed as a string literal) |\n| `debug` | `DebugOption` | Enable per-category debug logging (`true`, `false`, or a `DebugConfig` — see [Debug Logging](../advanced/debug-logging)) |\n\n## Client Hook (`useGenerateAudio`)\n\nFor client-side usage, framework integrations expose a `useGenerateAudio`\nhook (or `createGenerateAudio` in Svelte) that wraps the same generation\nflow. It mirrors the API of `useGenerateSpeech`, `useGenerateImage`, and\nother media hooks — see [Generation Hooks](./generation-hooks) for the full\nshape.\n\n> **Note:** For long tracks, keep the run's status and result across a reload or\n> a dropped connection — and the audio after the provider's URL expires — with\n> [Generation Persistence](../persistence/generation-persistence).\n\n### Server (streaming SSE route)\n\n```typescript\n// routes/api/generate/audio.ts\nimport { generateAudio, toServerSentEventsResponse } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nexport async function POST(req: Request) {\n  const { prompt, duration } = await req.json()\n\n  return toServerSentEventsResponse(\n    generateAudio({\n      adapter: falAudio('fal-ai/diffrhythm'),\n      prompt,\n      duration,\n      stream: true,\n    }),\n  )\n}\n```\n\n### Client (React)\n\n```tsx\nimport { useGenerateAudio } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nfunction AudioGenerator() {\n  const { generate, result, isLoading, error, reset } = useGenerateAudio({\n    connection: fetchServerSentEvents('/api/generate/audio'),\n  })\n\n  return (\n    <div>\n      <button\n        onClick={() =>\n          generate({ prompt: 'An upbeat electronic track', duration: 10 })\n        }\n        disabled={isLoading}\n      >\n        {isLoading ? 'Generating...' : 'Generate'}\n      </button>\n      {error && <p>Error: {error.message}</p>}\n      {result?.audio.url && <audio src={result.audio.url} controls />}\n      {result && <button onClick={reset}>Clear</button>}\n    </div>\n  )\n}\n```\n\nUse the `fetcher` option instead of `connection` when calling a TanStack\nStart server function directly.\n\n## Advanced\n\nReference detail you do not need to get this working.\n\n### Result Shape\n\n```typescript\nimport type { TokenUsage } from '@tanstack/ai'\n\ninterface AudioGenerationResult {\n  id: string\n  model: string\n  audio: {\n    url?: string\n    b64Json?: string\n    contentType?: string\n    duration?: number\n  }\n  // Canonical TokenUsage (same shape as chat), present when the provider\n  // reports it (e.g. Gemini Lyria via generateContent). Usage-billed providers\n  // (fal) instead surface `usage.billed` ({ quantity, unit: 'units' }) — the\n  // real billed quantity read from fal's `x-fal-billable-units` result header.\n  // Multiply the quantity by the endpoint's unit price (fal pricing API) for\n  // the exact cost.\n  usage?: TokenUsage\n}\n```\n\nGemini returns base64-encoded bytes in `result.audio.b64Json`. The fal adapter returns a URL in `result.audio.url` — if you need raw bytes, `fetch()` the URL yourself:\n\n```typescript\nimport { generateAudio } from '@tanstack/ai'\nimport { falAudio } from '@tanstack/ai-fal'\n\nconst result = await generateAudio({\n  adapter: falAudio('fal-ai/diffrhythm'),\n  prompt: 'An upbeat electronic track',\n})\n\nconst bytes = new Uint8Array(\n  await (await fetch(result.audio.url!)).arrayBuffer()\n)\n```\n\n### Differences vs Text-to-Speech\n\n| | `generateAudio()` | `generateSpeech()` |\n|---|---|---|\n| Purpose | Music, soundscapes, SFX | Spoken-word TTS |\n| Result | `result.audio.url` or `result.audio.b64Json` | Base64 in `result.audio` |\n| Primary input | `prompt` | `text` |\n| Voice/speed controls | No | Yes (`voice`, `speed`) |\n\nUse `generateSpeech()` when you want a spoken voice, and `generateAudio()` when you want non-speech audio.\n\n### Environment Variables\n\nEach provider reads its own API key from the environment by default:\n\n```bash\nGOOGLE_API_KEY=your-google-api-key\nFAL_KEY=your-fal-api-key\n```\n\nOr pass it explicitly to the adapter:\n\n```typescript\nimport { createGeminiAudio } from '@tanstack/ai-gemini'\nimport { falAudio } from '@tanstack/ai-fal'\n\ncreateGeminiAudio('lyria-3-pro-preview', 'your-key')\nfalAudio('fal-ai/diffrhythm', { apiKey: 'your-key' })\n```\n"}
