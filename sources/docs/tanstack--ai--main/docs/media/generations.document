---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"You want an image, some speech, a transcript, a video, or a live stream, not a conversation. Every one\nof those is a "},{"type":"strong","children":[{"type":"text","value":"generation"}]},{"type":"text","value":": one request, one result. They all share the same shape, so\nlearning one teaches you the rest."}]},{"type":"paragraph","children":[{"type":"text","value":"For a live, prompt-steerable stream that does not end as a file, see "},{"type":"link","href":"./live-generation","children":[{"type":"text","value":"Live Generation"}]},{"type":"text","value":" or "},{"type":"link","href":"./world-generation","children":[{"type":"text","value":"World Generation"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"the-fastest-path","children":[{"type":"text","value":"The fastest path"}]},{"type":"paragraph","children":[{"type":"text","value":"A server route that streams the result:"}]},{"type":"code","value":"import { generateImage, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const { prompt } = await request.json()\n  const stream = generateImage({\n    adapter: openaiImage('dall-e-3'),\n    prompt: typeof prompt === 'string' ? prompt : '',\n    stream: true,\n  })\n  return toServerSentEventsResponse(stream)\n}","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"text","value":"A hook that calls it:"}]},{"type":"code","value":"import { fetchServerSentEvents, useGenerateImage } from '@tanstack/ai-react'\n\nfunction ImageGenerator() {\n  const { generate, result, isLoading, error } = useGenerateImage({\n    connection: fetchServerSentEvents('/api/generate/image'),\n  })\n\n  return (\n    <div>\n      <button onClick={() => generate({ prompt: 'A sunset over mountains' })}>\n        {isLoading ? 'Generating…' : 'Generate'}\n      </button>\n      {error && <p role=\"alert\">{error.message}</p>}\n      {result?.images.map((img, i) => (\n        <img key={i} src={img.url || `data:image/png;base64,${img.b64Json}`} />\n      ))}\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"That is the whole loop. Swap "},{"type":"inlineCode","value":"generateImage"},{"type":"text","value":" and "},{"type":"inlineCode","value":"useGenerateImage"},{"type":"text","value":" for any other pair\nin the table below and nothing else changes."}]},{"type":"paragraph","children":[{"type":"text","value":"For a React + Start walkthrough with OpenRouter, open "},{"type":"link","href":"../tutorials/generate-image","children":[{"type":"text","value":"Generate Image"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"which-transport","children":[{"type":"text","value":"Which transport?"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Transport"}]},{"type":"tableCell","children":[{"type":"text","value":"Use it when"}]},{"type":"tableCell","children":[{"type":"text","value":"How"}]}],"rows":[[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Streaming route"}]}]},{"type":"tableCell","children":[{"type":"text","value":"You have an API route. The default, and what the snippets above use."}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"stream: true"},{"type":"text","value":" plus "},{"type":"inlineCode","value":"toServerSentEventsResponse"},{"type":"text","value":", and "},{"type":"inlineCode","value":"connection:"},{"type":"text","value":" on the hook"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Direct"}]}]},{"type":"tableCell","children":[{"type":"text","value":"You call a server function and want plain JSON back. Simplest, no streaming."}]},{"type":"tableCell","children":[{"type":"text","value":"Return the result from the function, and pass "},{"type":"inlineCode","value":"fetcher:"},{"type":"text","value":" on the hook"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Server function that streams"}]}]},{"type":"tableCell","children":[{"type":"text","value":"You use TanStack Start server functions and want typed input plus streaming."}]},{"type":"tableCell","children":[{"type":"text","value":"Return "},{"type":"inlineCode","value":"toServerSentEventsResponse(...)"},{"type":"text","value":" from the function, and pass "},{"type":"inlineCode","value":"fetcher:"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"The third one is the best of both when you are on Start: input is fully typed and the\nstreaming is handled for you. All three are written out in\n"},{"type":"link","href":"#transports-in-full","children":[{"type":"text","value":"Transports in full"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"available-generations","children":[{"type":"text","value":"Available Generations"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Activity"}]},{"type":"tableCell","children":[{"type":"text","value":"Server Function"}]},{"type":"tableCell","children":[{"type":"text","value":"Client Hook (React)"}]},{"type":"tableCell","children":[{"type":"text","value":"Guide"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Image generation"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateImage()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useGenerateImage()"}]},{"type":"tableCell","children":[{"type":"link","href":"./image-generation","children":[{"type":"text","value":"Image Generation"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"Audio generation"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateAudio()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useGenerateAudio()"}]},{"type":"tableCell","children":[{"type":"link","href":"./audio-generation","children":[{"type":"text","value":"Audio Generation"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"Text-to-speech"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateSpeech()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useGenerateSpeech()"}]},{"type":"tableCell","children":[{"type":"link","href":"./text-to-speech","children":[{"type":"text","value":"Text-to-Speech"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"Transcription"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateTranscription()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useTranscription()"}]},{"type":"tableCell","children":[{"type":"link","href":"./transcription","children":[{"type":"text","value":"Transcription"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"Voice creation"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateVoice()"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"link","href":"./voice-creation","children":[{"type":"text","value":"Voice Creation"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"Summarization"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"summarize()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useSummarize()"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Video generation"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateVideo()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useGenerateVideo()"}]},{"type":"tableCell","children":[{"type":"link","href":"./video-generation","children":[{"type":"text","value":"Video Generation"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"Live generation"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateLiveVideo()"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"link","href":"./live-generation","children":[{"type":"text","value":"Live Generation"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"World generation"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"generateWorld()"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"link","href":"./world-generation","children":[{"type":"text","value":"World Generation"}]}]}]]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Video adapters use a jobs/polling architecture. The "},{"type":"inlineCode","value":"useGenerateVideo"},{"type":"text","value":" hook additionally exposes "},{"type":"inlineCode","value":"jobId"},{"type":"text","value":", "},{"type":"inlineCode","value":"videoStatus"},{"type":"text","value":", "},{"type":"inlineCode","value":"onJobCreated"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onStatusUpdate"},{"type":"text","value":" for tracking the polling lifecycle. Live adapters mint a session token. World Labs world jobs return a viewer URL and asset links."}]}]},{"type":"heading","depth":2,"id":"advanced","children":[{"type":"text","value":"Advanced"}]},{"type":"heading","depth":3,"id":"transports-in-full","children":[{"type":"text","value":"Transports in full"}]},{"type":"heading","depth":4,"id":"streaming-mode-connection-adapter","children":[{"type":"text","value":"Streaming Mode (Connection Adapter)"}]},{"type":"paragraph","children":[{"type":"text","value":"The server passes "},{"type":"inlineCode","value":"stream: true"},{"type":"text","value":" to the generation function and sends the result as SSE. The client uses "},{"type":"inlineCode","value":"fetchServerSentEvents()"},{"type":"text","value":" to consume the stream."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server:"}]}]},{"type":"code","value":"import { generateImage, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\n// In your API route handler\nconst stream = generateImage({\n  adapter: openaiImage('dall-e-3'),\n  prompt: 'A sunset over mountains',\n  stream: true,\n})\n\nreturn toServerSentEventsResponse(stream)","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Client:"}]}]},{"type":"code","value":"import { useGenerateImage, fetchServerSentEvents } from '@tanstack/ai-react'\n\nconst { generate, result, isLoading } = useGenerateImage({\n  connection: fetchServerSentEvents('/api/generate/image'),\n})","lang":"tsx"},{"type":"heading","depth":4,"id":"direct-mode-fetcher","children":[{"type":"text","value":"Direct Mode (Fetcher)"}]},{"type":"paragraph","children":[{"type":"text","value":"The client calls a server function directly and receives the result as JSON. No streaming protocol needed."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server:"}]}]},{"type":"code","value":"import { createServerFn } from '@tanstack/react-start'\nimport { generateImage } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nexport const generateImageFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { prompt: string }) => data)\n  .handler(async ({ data }) => {\n    return generateImage({\n      adapter: openaiImage('dall-e-3'),\n      prompt: data.prompt,\n    })\n  })","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Client:"}]}]},{"type":"code","value":"import { useGenerateImage } from '@tanstack/ai-react'\nimport { generateImageFn } from '../lib/server-functions'\n\nconst { generate, result, isLoading } = useGenerateImage({\n  fetcher: (input) => generateImageFn({ data: input }),\n})","lang":"tsx"},{"type":"heading","depth":4,"id":"server-function-streaming-fetcher-response","children":[{"type":"text","value":"Server Function Streaming (Fetcher + Response)"}]},{"type":"paragraph","children":[{"type":"text","value":"Combines the best of both: "},{"type":"strong","children":[{"type":"text","value":"type-safe input"}]},{"type":"text","value":" from the fetcher pattern with "},{"type":"strong","children":[{"type":"text","value":"streaming"}]},{"type":"text","value":" from a server function that returns an SSE "},{"type":"inlineCode","value":"Response"},{"type":"text","value":". When the fetcher returns a "},{"type":"inlineCode","value":"Response"},{"type":"text","value":" object (instead of a plain result), the client automatically parses it as an SSE stream."}]},{"type":"paragraph","children":[{"type":"text","value":"If the client stops reading before the response ends, it cancels the response body. A "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":" event also closes the unfinished response."}]},{"type":"paragraph","children":[{"type":"text","value":"Custom cancellation hooks do not delay the client error or loading state. The client releases the reader lock even if cancellation fails or stays pending."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server:"}]}]},{"type":"code","value":"import { createServerFn } from '@tanstack/react-start'\nimport { generateImage, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nexport const generateImageStreamFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { prompt: string }) => data)\n  .handler(({ data }) => {\n    return toServerSentEventsResponse(\n      generateImage({\n        adapter: openaiImage('dall-e-3'),\n        prompt: data.prompt,\n        stream: true,\n      }),\n    )\n  })","lang":"typescript","meta":"ignore"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Client:"}]}]},{"type":"code","value":"import { useGenerateImage } from '@tanstack/ai-react'\nimport { generateImageStreamFn } from '../lib/server-functions'\n\nconst { generate, result, isLoading } = useGenerateImage({\n  fetcher: (input) => generateImageStreamFn({ data: input }),\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"This is the recommended approach when using TanStack Start server functions, the input is fully typed (e.g., "},{"type":"inlineCode","value":"ImageGenerateInput"},{"type":"text","value":"), and the streaming protocol is handled transparently."}]},{"type":"heading","depth":3,"id":"how-streaming-works","children":[{"type":"text","value":"How Streaming Works"}]},{"type":"paragraph","children":[{"type":"text","value":"When you pass "},{"type":"inlineCode","value":"stream: true"},{"type":"text","value":" to any generation function, it returns an async iterable of "},{"type":"inlineCode","value":"StreamChunk"},{"type":"text","value":" events instead of a plain result:"}]},{"type":"code","value":"1. RUN_STARTED          → Client sets status to 'generating'\n2. CUSTOM               → Client receives the result\n   name: 'generation:result'\n   value: <your result>\n3. RUN_FINISHED         → Client sets status to 'success'"},{"type":"paragraph","children":[{"type":"text","value":"If the function throws, a "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":" event is emitted instead:"}]},{"type":"code","value":"1. RUN_STARTED          → Client sets status to 'generating'\n2. RUN_ERROR            → Client sets error + status to 'error'\n   error: { message: '...' }"},{"type":"paragraph","children":[{"type":"text","value":"This is the same event protocol used by chat streaming, so the same transport layer ("},{"type":"inlineCode","value":"toServerSentEventsResponse"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchServerSentEvents"},{"type":"text","value":") works for both."}]},{"type":"paragraph","children":[{"type":"text","value":"When the server emits "},{"type":"inlineCode","value":"RUN_ERROR"},{"type":"text","value":", the client surfaces it on "},{"type":"inlineCode","value":"error"},{"type":"text","value":" (and sets "},{"type":"inlineCode","value":"status"},{"type":"text","value":" to "},{"type":"inlineCode","value":"'error'"},{"type":"text","value":"). Use the "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" callback to react, and render "},{"type":"inlineCode","value":"error?.message"},{"type":"text","value":" in your UI:"}]},{"type":"code","value":"import { useGenerateImage, fetchServerSentEvents } from '@tanstack/ai-react'\n\nfunction ImageGenerator() {\n  const { generate, result, error, status } = useGenerateImage({\n    connection: fetchServerSentEvents('/api/generate/image'),\n    onError: (err) => console.error('Generation failed:', err.message),\n  })\n\n  return (\n    <div>\n      <button onClick={() => generate({ prompt: 'A sunset over mountains' })}>\n        Generate\n      </button>\n      {status === 'error' && <p role=\"alert\">Error: {error?.message}</p>}\n      {result?.images.map((img, i) => (\n        <img key={i} src={img.url || `data:image/png;base64,${img.b64Json}`} />\n      ))}\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"common-hook-api","children":[{"type":"text","value":"Common Hook API"}]},{"type":"paragraph","children":[{"type":"text","value":"All generation hooks share the same interface:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"connection"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ConnectionAdapter"}]},{"type":"tableCell","children":[{"type":"text","value":"Streaming transport (SSE, HTTP stream, custom)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fetcher"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(input) => Promise<Result | Response>"}]},{"type":"tableCell","children":[{"type":"text","value":"Direct async function, or server function returning an SSE "},{"type":"inlineCode","value":"Response"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"threadId"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable scope for this generation. Required when "},{"type":"inlineCode","value":"persistence"},{"type":"text","value":" is on. Optional for ephemeral runs."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"body"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Record<string, any>"}]},{"type":"tableCell","children":[{"type":"text","value":"Additional body parameters (connection mode)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onResult"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(result) => T | null | void"}]},{"type":"tableCell","children":[{"type":"text","value":"Transform or react to the result"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(error) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Error callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onProgress"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(progress, message?) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Progress updates (0-100)"}]}]]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Return"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"generate"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(input) => Promise<void>"}]},{"type":"tableCell","children":[{"type":"text","value":"Trigger generation"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"T | null"}]},{"type":"tableCell","children":[{"type":"text","value":"The result (optionally transformed), or null"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"isLoading"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether generation is in progress"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"error"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Error | undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Current error, if any"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"status"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"GenerationClientState"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'idle'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'generating'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'success'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'error'"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stop"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Abort the current generation"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"reset"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Clear all state, return to idle"}]}]]},{"type":"heading","depth":4,"id":"result-transform","children":[{"type":"text","value":"Result Transform"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"onResult"},{"type":"text","value":" callback can optionally transform the stored result:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Return a "},{"type":"strong","children":[{"type":"text","value":"non-null value"}]},{"type":"text","value":", replaces the stored result with the transformed value"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Return "},{"type":"strong","children":[{"type":"inlineCode","value":"null"}]},{"type":"text","value":", keeps the previous result unchanged (useful for filtering)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Return "},{"type":"strong","children":[{"type":"text","value":"nothing"}]},{"type":"text","value":" ("},{"type":"inlineCode","value":"void"},{"type":"text","value":"), stores the raw result as-is"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"TypeScript automatically infers the result type from your "},{"type":"inlineCode","value":"onResult"},{"type":"text","value":" return value, no explicit generic parameter needed."}]},{"type":"code","value":"import { useGenerateSpeech, fetchServerSentEvents } from '@tanstack/ai-react'\nimport type { TTSResult } from '@tanstack/ai'\n\nfunction SpeechPlayer() {\n  const { result } = useGenerateSpeech({\n    connection: fetchServerSentEvents('/api/generate/speech'),\n    onResult: (raw: TTSResult) => ({\n      audioUrl: `data:${raw.contentType};base64,${raw.audio}`,\n      duration: raw.duration,\n    }),\n  })\n  // result is typed as { audioUrl: string; duration?: number } | null\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"architecture","children":[{"type":"text","value":"Architecture"}]},{"type":"code","value":"flowchart TB\n  subgraph Server [\"Server\"]\n    direction TB\n    activities[\"generateImage({ ..., stream: true })\ngenerateSpeech({ ..., stream: true })\ngenerateTranscription({ ..., stream: true })\nsummarize({ ..., stream: true })\ngenerateVideo({ ..., stream: true })\"]\n    transport[\"toServerSentEventsResponse()\"]\n    activities --> transport\n  end\n\n  transport -- \"StreamChunks via SSE\nRUN_STARTED → generation:result → RUN_FINISHED\" --> adapter\n\n  subgraph Client [\"Client\"]\n    direction TB\n    adapter[\"fetchServerSentEvents('/api/...')\"]\n    gc[\"GenerationClient\n(state machine)\"]\n    hooks[\"Framework Hooks\nuseGenerateImage() · useGenerateSpeech()\nuseGenerateVideo() · useSummarize()\nuseTranscription()\"]\n    adapter --> gc\n    gc -- \"result, isLoading, error, status\" --> hooks\n  end","lang":"mermaid"},{"type":"paragraph","children":[{"type":"text","value":"The key insight: "},{"type":"strong","children":[{"type":"text","value":"every generation activity on the server is just an async function that returns a result"}]},{"type":"text","value":". By passing "},{"type":"inlineCode","value":"stream: true"},{"type":"text","value":", the function returns a "},{"type":"inlineCode","value":"StreamChunk"},{"type":"text","value":" iterable instead of a plain result, which the client already knows how to consume."}]}],"headings":[{"id":"the-fastest-path","text":"The fastest path","level":2},{"id":"which-transport","text":"Which transport?","level":2},{"id":"available-generations","text":"Available Generations","level":2},{"id":"advanced","text":"Advanced","level":2},{"id":"transports-in-full","text":"Transports in full","level":3},{"id":"streaming-mode-connection-adapter","text":"Streaming Mode (Connection Adapter)","level":4},{"id":"direct-mode-fetcher","text":"Direct Mode (Fetcher)","level":4},{"id":"server-function-streaming-fetcher-response","text":"Server Function Streaming (Fetcher + Response)","level":4},{"id":"how-streaming-works","text":"How Streaming Works","level":3},{"id":"common-hook-api","text":"Common Hook API","level":3},{"id":"result-transform","text":"Result Transform","level":4},{"id":"architecture","text":"Architecture","level":3}]},"frameworks":[],"downloadMarkdown":"\nYou want an image, some speech, a transcript, a video, or a live stream, not a conversation. Every one\nof those is a **generation**: one request, one result. They all share the same shape, so\nlearning one teaches you the rest.\n\nFor a live, prompt-steerable stream that does not end as a file, see [Live Generation](./live-generation) or [World Generation](./world-generation).\n\n## The fastest path\n\nA server route that streams the result:\n\n```typescript ignore\nimport { generateImage, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const { prompt } = await request.json()\n  const stream = generateImage({\n    adapter: openaiImage('dall-e-3'),\n    prompt: typeof prompt === 'string' ? prompt : '',\n    stream: true,\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\nA hook that calls it:\n\n```tsx\nimport { fetchServerSentEvents, useGenerateImage } from '@tanstack/ai-react'\n\nfunction ImageGenerator() {\n  const { generate, result, isLoading, error } = useGenerateImage({\n    connection: fetchServerSentEvents('/api/generate/image'),\n  })\n\n  return (\n    <div>\n      <button onClick={() => generate({ prompt: 'A sunset over mountains' })}>\n        {isLoading ? 'Generating…' : 'Generate'}\n      </button>\n      {error && <p role=\"alert\">{error.message}</p>}\n      {result?.images.map((img, i) => (\n        <img key={i} src={img.url || `data:image/png;base64,${img.b64Json}`} />\n      ))}\n    </div>\n  )\n}\n```\n\nThat is the whole loop. Swap `generateImage` and `useGenerateImage` for any other pair\nin the table below and nothing else changes.\n\nFor a React + Start walkthrough with OpenRouter, open [Generate Image](../tutorials/generate-image).\n\n## Which transport?\n\n| Transport | Use it when | How |\n| --- | --- | --- |\n| **Streaming route** | You have an API route. The default, and what the snippets above use. | `stream: true` plus `toServerSentEventsResponse`, and `connection:` on the hook |\n| **Direct** | You call a server function and want plain JSON back. Simplest, no streaming. | Return the result from the function, and pass `fetcher:` on the hook |\n| **Server function that streams** | You use TanStack Start server functions and want typed input plus streaming. | Return `toServerSentEventsResponse(...)` from the function, and pass `fetcher:` |\n\nThe third one is the best of both when you are on Start: input is fully typed and the\nstreaming is handled for you. All three are written out in\n[Transports in full](#transports-in-full).\n\n## Available Generations\n\n| Activity | Server Function | Client Hook (React) | Guide |\n|----------|----------------|---------------------|-------|\n| Image generation | `generateImage()` | `useGenerateImage()` | [Image Generation](./image-generation) |\n| Audio generation | `generateAudio()` | `useGenerateAudio()` | [Audio Generation](./audio-generation) |\n| Text-to-speech | `generateSpeech()` | `useGenerateSpeech()` | [Text-to-Speech](./text-to-speech) |\n| Transcription | `generateTranscription()` | `useTranscription()` | [Transcription](./transcription) |\n| Voice creation | `generateVoice()` | - | [Voice Creation](./voice-creation) |\n| Summarization | `summarize()` | `useSummarize()` | - |\n| Video generation | `generateVideo()` | `useGenerateVideo()` | [Video Generation](./video-generation) |\n| Live generation | `generateLiveVideo()` | - | [Live Generation](./live-generation) |\n| World generation | `generateWorld()` | - | [World Generation](./world-generation) |\n\n> **Note:** Video adapters use a jobs/polling architecture. The `useGenerateVideo` hook additionally exposes `jobId`, `videoStatus`, `onJobCreated`, and `onStatusUpdate` for tracking the polling lifecycle. Live adapters mint a session token. World Labs world jobs return a viewer URL and asset links.\n\n## Advanced\n\n### Transports in full\n\n#### Streaming Mode (Connection Adapter)\n\nThe server passes `stream: true` to the generation function and sends the result as SSE. The client uses `fetchServerSentEvents()` to consume the stream.\n\n**Server:**\n\n```typescript ignore\nimport { generateImage, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\n// In your API route handler\nconst stream = generateImage({\n  adapter: openaiImage('dall-e-3'),\n  prompt: 'A sunset over mountains',\n  stream: true,\n})\n\nreturn toServerSentEventsResponse(stream)\n```\n\n**Client:**\n\n```tsx\nimport { useGenerateImage, fetchServerSentEvents } from '@tanstack/ai-react'\n\nconst { generate, result, isLoading } = useGenerateImage({\n  connection: fetchServerSentEvents('/api/generate/image'),\n})\n```\n\n#### Direct Mode (Fetcher)\n\nThe client calls a server function directly and receives the result as JSON. No streaming protocol needed.\n\n**Server:**\n\n```typescript ignore\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateImage } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nexport const generateImageFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { prompt: string }) => data)\n  .handler(async ({ data }) => {\n    return generateImage({\n      adapter: openaiImage('dall-e-3'),\n      prompt: data.prompt,\n    })\n  })\n```\n\n**Client:**\n\n```tsx\nimport { useGenerateImage } from '@tanstack/ai-react'\nimport { generateImageFn } from '../lib/server-functions'\n\nconst { generate, result, isLoading } = useGenerateImage({\n  fetcher: (input) => generateImageFn({ data: input }),\n})\n```\n\n#### Server Function Streaming (Fetcher + Response)\n\nCombines the best of both: **type-safe input** from the fetcher pattern with **streaming** from a server function that returns an SSE `Response`. When the fetcher returns a `Response` object (instead of a plain result), the client automatically parses it as an SSE stream.\n\nIf the client stops reading before the response ends, it cancels the response body. A `RUN_ERROR` event also closes the unfinished response.\n\nCustom cancellation hooks do not delay the client error or loading state. The client releases the reader lock even if cancellation fails or stays pending.\n\n**Server:**\n\n```typescript ignore\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateImage, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nexport const generateImageStreamFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { prompt: string }) => data)\n  .handler(({ data }) => {\n    return toServerSentEventsResponse(\n      generateImage({\n        adapter: openaiImage('dall-e-3'),\n        prompt: data.prompt,\n        stream: true,\n      }),\n    )\n  })\n```\n\n**Client:**\n\n```tsx\nimport { useGenerateImage } from '@tanstack/ai-react'\nimport { generateImageStreamFn } from '../lib/server-functions'\n\nconst { generate, result, isLoading } = useGenerateImage({\n  fetcher: (input) => generateImageStreamFn({ data: input }),\n})\n```\n\nThis is the recommended approach when using TanStack Start server functions, the input is fully typed (e.g., `ImageGenerateInput`), and the streaming protocol is handled transparently.\n\n\n### How Streaming Works\n\nWhen you pass `stream: true` to any generation function, it returns an async iterable of `StreamChunk` events instead of a plain result:\n\n```\n1. RUN_STARTED          → Client sets status to 'generating'\n2. CUSTOM               → Client receives the result\n   name: 'generation:result'\n   value: <your result>\n3. RUN_FINISHED         → Client sets status to 'success'\n```\n\nIf the function throws, a `RUN_ERROR` event is emitted instead:\n\n```\n1. RUN_STARTED          → Client sets status to 'generating'\n2. RUN_ERROR            → Client sets error + status to 'error'\n   error: { message: '...' }\n```\n\nThis is the same event protocol used by chat streaming, so the same transport layer (`toServerSentEventsResponse`, `fetchServerSentEvents`) works for both.\n\nWhen the server emits `RUN_ERROR`, the client surfaces it on `error` (and sets `status` to `'error'`). Use the `onError` callback to react, and render `error?.message` in your UI:\n\n```tsx\nimport { useGenerateImage, fetchServerSentEvents } from '@tanstack/ai-react'\n\nfunction ImageGenerator() {\n  const { generate, result, error, status } = useGenerateImage({\n    connection: fetchServerSentEvents('/api/generate/image'),\n    onError: (err) => console.error('Generation failed:', err.message),\n  })\n\n  return (\n    <div>\n      <button onClick={() => generate({ prompt: 'A sunset over mountains' })}>\n        Generate\n      </button>\n      {status === 'error' && <p role=\"alert\">Error: {error?.message}</p>}\n      {result?.images.map((img, i) => (\n        <img key={i} src={img.url || `data:image/png;base64,${img.b64Json}`} />\n      ))}\n    </div>\n  )\n}\n```\n\n\n### Common Hook API\n\nAll generation hooks share the same interface:\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `connection` | `ConnectionAdapter` | Streaming transport (SSE, HTTP stream, custom) |\n| `fetcher` | `(input) => Promise<Result \\| Response>` | Direct async function, or server function returning an SSE `Response` |\n| `threadId` | `string` | Stable scope for this generation. Required when `persistence` is on. Optional for ephemeral runs. |\n| `body` | `Record<string, any>` | Additional body parameters (connection mode) |\n| `onResult` | `(result) => T \\| null \\| void` | Transform or react to the result |\n| `onError` | `(error) => void` | Error callback |\n| `onProgress` | `(progress, message?) => void` | Progress updates (0-100) |\n\n| Return | Type | Description |\n|--------|------|-------------|\n| `generate` | `(input) => Promise<void>` | Trigger generation |\n| `result` | `T \\| null` | The result (optionally transformed), or null |\n| `isLoading` | `boolean` | Whether generation is in progress |\n| `error` | `Error \\| undefined` | Current error, if any |\n| `status` | `GenerationClientState` | `'idle'` \\| `'generating'` \\| `'success'` \\| `'error'` |\n| `stop` | `() => void` | Abort the current generation |\n| `reset` | `() => void` | Clear all state, return to idle |\n\n#### Result Transform\n\nThe `onResult` callback can optionally transform the stored result:\n\n- Return a **non-null value**, replaces the stored result with the transformed value\n- Return **`null`**, keeps the previous result unchanged (useful for filtering)\n- Return **nothing** (`void`), stores the raw result as-is\n\nTypeScript automatically infers the result type from your `onResult` return value, no explicit generic parameter needed.\n\n```tsx\nimport { useGenerateSpeech, fetchServerSentEvents } from '@tanstack/ai-react'\nimport type { TTSResult } from '@tanstack/ai'\n\nfunction SpeechPlayer() {\n  const { result } = useGenerateSpeech({\n    connection: fetchServerSentEvents('/api/generate/speech'),\n    onResult: (raw: TTSResult) => ({\n      audioUrl: `data:${raw.contentType};base64,${raw.audio}`,\n      duration: raw.duration,\n    }),\n  })\n  // result is typed as { audioUrl: string; duration?: number } | null\n}\n```\n\n\n### Architecture\n\n```mermaid\nflowchart TB\n  subgraph Server [\"Server\"]\n    direction TB\n    activities[\"generateImage({ ..., stream: true })\ngenerateSpeech({ ..., stream: true })\ngenerateTranscription({ ..., stream: true })\nsummarize({ ..., stream: true })\ngenerateVideo({ ..., stream: true })\"]\n    transport[\"toServerSentEventsResponse()\"]\n    activities --> transport\n  end\n\n  transport -- \"StreamChunks via SSE\nRUN_STARTED → generation:result → RUN_FINISHED\" --> adapter\n\n  subgraph Client [\"Client\"]\n    direction TB\n    adapter[\"fetchServerSentEvents('/api/...')\"]\n    gc[\"GenerationClient\n(state machine)\"]\n    hooks[\"Framework Hooks\nuseGenerateImage() · useGenerateSpeech()\nuseGenerateVideo() · useSummarize()\nuseTranscription()\"]\n    adapter --> gc\n    gc -- \"result, isLoading, error, status\" --> hooks\n  end\n```\n\nThe key insight: **every generation activity on the server is just an async function that returns a result**. By passing `stream: true`, the function returns a `StreamChunk` iterable instead of a plain result, which the client already knows how to consume.\n\n","originalRawMarkdown":"---\ntitle: Generations\nid: generations\norder: 1\ndescription: \"One shape for image, speech, transcription, summarization and video: a server function, a route, and a hook. Copy the snippets and pick a transport.\"\nkeywords:\n  - tanstack ai\n  - generations\n  - media generation\n  - image generation\n  - transcription\n  - tts\n  - video generation\n---\n\nYou want an image, some speech, a transcript, a video, or a live stream, not a conversation. Every one\nof those is a **generation**: one request, one result. They all share the same shape, so\nlearning one teaches you the rest.\n\nFor a live, prompt-steerable stream that does not end as a file, see [Live Generation](./live-generation) or [World Generation](./world-generation).\n\n## The fastest path\n\nA server route that streams the result:\n\n```typescript ignore\nimport { generateImage, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const { prompt } = await request.json()\n  const stream = generateImage({\n    adapter: openaiImage('dall-e-3'),\n    prompt: typeof prompt === 'string' ? prompt : '',\n    stream: true,\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\nA hook that calls it:\n\n```tsx\nimport { fetchServerSentEvents, useGenerateImage } from '@tanstack/ai-react'\n\nfunction ImageGenerator() {\n  const { generate, result, isLoading, error } = useGenerateImage({\n    connection: fetchServerSentEvents('/api/generate/image'),\n  })\n\n  return (\n    <div>\n      <button onClick={() => generate({ prompt: 'A sunset over mountains' })}>\n        {isLoading ? 'Generating…' : 'Generate'}\n      </button>\n      {error && <p role=\"alert\">{error.message}</p>}\n      {result?.images.map((img, i) => (\n        <img key={i} src={img.url || `data:image/png;base64,${img.b64Json}`} />\n      ))}\n    </div>\n  )\n}\n```\n\nThat is the whole loop. Swap `generateImage` and `useGenerateImage` for any other pair\nin the table below and nothing else changes.\n\nFor a React + Start walkthrough with OpenRouter, open [Generate Image](../tutorials/generate-image).\n\n## Which transport?\n\n| Transport | Use it when | How |\n| --- | --- | --- |\n| **Streaming route** | You have an API route. The default, and what the snippets above use. | `stream: true` plus `toServerSentEventsResponse`, and `connection:` on the hook |\n| **Direct** | You call a server function and want plain JSON back. Simplest, no streaming. | Return the result from the function, and pass `fetcher:` on the hook |\n| **Server function that streams** | You use TanStack Start server functions and want typed input plus streaming. | Return `toServerSentEventsResponse(...)` from the function, and pass `fetcher:` |\n\nThe third one is the best of both when you are on Start: input is fully typed and the\nstreaming is handled for you. All three are written out in\n[Transports in full](#transports-in-full).\n\n## Available Generations\n\n| Activity | Server Function | Client Hook (React) | Guide |\n|----------|----------------|---------------------|-------|\n| Image generation | `generateImage()` | `useGenerateImage()` | [Image Generation](./image-generation) |\n| Audio generation | `generateAudio()` | `useGenerateAudio()` | [Audio Generation](./audio-generation) |\n| Text-to-speech | `generateSpeech()` | `useGenerateSpeech()` | [Text-to-Speech](./text-to-speech) |\n| Transcription | `generateTranscription()` | `useTranscription()` | [Transcription](./transcription) |\n| Voice creation | `generateVoice()` | - | [Voice Creation](./voice-creation) |\n| Summarization | `summarize()` | `useSummarize()` | - |\n| Video generation | `generateVideo()` | `useGenerateVideo()` | [Video Generation](./video-generation) |\n| Live generation | `generateLiveVideo()` | - | [Live Generation](./live-generation) |\n| World generation | `generateWorld()` | - | [World Generation](./world-generation) |\n\n> **Note:** Video adapters use a jobs/polling architecture. The `useGenerateVideo` hook additionally exposes `jobId`, `videoStatus`, `onJobCreated`, and `onStatusUpdate` for tracking the polling lifecycle. Live adapters mint a session token. World Labs world jobs return a viewer URL and asset links.\n\n## Advanced\n\n### Transports in full\n\n#### Streaming Mode (Connection Adapter)\n\nThe server passes `stream: true` to the generation function and sends the result as SSE. The client uses `fetchServerSentEvents()` to consume the stream.\n\n**Server:**\n\n```typescript ignore\nimport { generateImage, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\n// In your API route handler\nconst stream = generateImage({\n  adapter: openaiImage('dall-e-3'),\n  prompt: 'A sunset over mountains',\n  stream: true,\n})\n\nreturn toServerSentEventsResponse(stream)\n```\n\n**Client:**\n\n```tsx\nimport { useGenerateImage, fetchServerSentEvents } from '@tanstack/ai-react'\n\nconst { generate, result, isLoading } = useGenerateImage({\n  connection: fetchServerSentEvents('/api/generate/image'),\n})\n```\n\n#### Direct Mode (Fetcher)\n\nThe client calls a server function directly and receives the result as JSON. No streaming protocol needed.\n\n**Server:**\n\n```typescript ignore\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateImage } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nexport const generateImageFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { prompt: string }) => data)\n  .handler(async ({ data }) => {\n    return generateImage({\n      adapter: openaiImage('dall-e-3'),\n      prompt: data.prompt,\n    })\n  })\n```\n\n**Client:**\n\n```tsx\nimport { useGenerateImage } from '@tanstack/ai-react'\nimport { generateImageFn } from '../lib/server-functions'\n\nconst { generate, result, isLoading } = useGenerateImage({\n  fetcher: (input) => generateImageFn({ data: input }),\n})\n```\n\n#### Server Function Streaming (Fetcher + Response)\n\nCombines the best of both: **type-safe input** from the fetcher pattern with **streaming** from a server function that returns an SSE `Response`. When the fetcher returns a `Response` object (instead of a plain result), the client automatically parses it as an SSE stream.\n\nIf the client stops reading before the response ends, it cancels the response body. A `RUN_ERROR` event also closes the unfinished response.\n\nCustom cancellation hooks do not delay the client error or loading state. The client releases the reader lock even if cancellation fails or stays pending.\n\n**Server:**\n\n```typescript ignore\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateImage, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nexport const generateImageStreamFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { prompt: string }) => data)\n  .handler(({ data }) => {\n    return toServerSentEventsResponse(\n      generateImage({\n        adapter: openaiImage('dall-e-3'),\n        prompt: data.prompt,\n        stream: true,\n      }),\n    )\n  })\n```\n\n**Client:**\n\n```tsx\nimport { useGenerateImage } from '@tanstack/ai-react'\nimport { generateImageStreamFn } from '../lib/server-functions'\n\nconst { generate, result, isLoading } = useGenerateImage({\n  fetcher: (input) => generateImageStreamFn({ data: input }),\n})\n```\n\nThis is the recommended approach when using TanStack Start server functions, the input is fully typed (e.g., `ImageGenerateInput`), and the streaming protocol is handled transparently.\n\n\n### How Streaming Works\n\nWhen you pass `stream: true` to any generation function, it returns an async iterable of `StreamChunk` events instead of a plain result:\n\n```\n1. RUN_STARTED          → Client sets status to 'generating'\n2. CUSTOM               → Client receives the result\n   name: 'generation:result'\n   value: <your result>\n3. RUN_FINISHED         → Client sets status to 'success'\n```\n\nIf the function throws, a `RUN_ERROR` event is emitted instead:\n\n```\n1. RUN_STARTED          → Client sets status to 'generating'\n2. RUN_ERROR            → Client sets error + status to 'error'\n   error: { message: '...' }\n```\n\nThis is the same event protocol used by chat streaming, so the same transport layer (`toServerSentEventsResponse`, `fetchServerSentEvents`) works for both.\n\nWhen the server emits `RUN_ERROR`, the client surfaces it on `error` (and sets `status` to `'error'`). Use the `onError` callback to react, and render `error?.message` in your UI:\n\n```tsx\nimport { useGenerateImage, fetchServerSentEvents } from '@tanstack/ai-react'\n\nfunction ImageGenerator() {\n  const { generate, result, error, status } = useGenerateImage({\n    connection: fetchServerSentEvents('/api/generate/image'),\n    onError: (err) => console.error('Generation failed:', err.message),\n  })\n\n  return (\n    <div>\n      <button onClick={() => generate({ prompt: 'A sunset over mountains' })}>\n        Generate\n      </button>\n      {status === 'error' && <p role=\"alert\">Error: {error?.message}</p>}\n      {result?.images.map((img, i) => (\n        <img key={i} src={img.url || `data:image/png;base64,${img.b64Json}`} />\n      ))}\n    </div>\n  )\n}\n```\n\n\n### Common Hook API\n\nAll generation hooks share the same interface:\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `connection` | `ConnectionAdapter` | Streaming transport (SSE, HTTP stream, custom) |\n| `fetcher` | `(input) => Promise<Result \\| Response>` | Direct async function, or server function returning an SSE `Response` |\n| `threadId` | `string` | Stable scope for this generation. Required when `persistence` is on. Optional for ephemeral runs. |\n| `body` | `Record<string, any>` | Additional body parameters (connection mode) |\n| `onResult` | `(result) => T \\| null \\| void` | Transform or react to the result |\n| `onError` | `(error) => void` | Error callback |\n| `onProgress` | `(progress, message?) => void` | Progress updates (0-100) |\n\n| Return | Type | Description |\n|--------|------|-------------|\n| `generate` | `(input) => Promise<void>` | Trigger generation |\n| `result` | `T \\| null` | The result (optionally transformed), or null |\n| `isLoading` | `boolean` | Whether generation is in progress |\n| `error` | `Error \\| undefined` | Current error, if any |\n| `status` | `GenerationClientState` | `'idle'` \\| `'generating'` \\| `'success'` \\| `'error'` |\n| `stop` | `() => void` | Abort the current generation |\n| `reset` | `() => void` | Clear all state, return to idle |\n\n#### Result Transform\n\nThe `onResult` callback can optionally transform the stored result:\n\n- Return a **non-null value**, replaces the stored result with the transformed value\n- Return **`null`**, keeps the previous result unchanged (useful for filtering)\n- Return **nothing** (`void`), stores the raw result as-is\n\nTypeScript automatically infers the result type from your `onResult` return value, no explicit generic parameter needed.\n\n```tsx\nimport { useGenerateSpeech, fetchServerSentEvents } from '@tanstack/ai-react'\nimport type { TTSResult } from '@tanstack/ai'\n\nfunction SpeechPlayer() {\n  const { result } = useGenerateSpeech({\n    connection: fetchServerSentEvents('/api/generate/speech'),\n    onResult: (raw: TTSResult) => ({\n      audioUrl: `data:${raw.contentType};base64,${raw.audio}`,\n      duration: raw.duration,\n    }),\n  })\n  // result is typed as { audioUrl: string; duration?: number } | null\n}\n```\n\n\n### Architecture\n\n```mermaid\nflowchart TB\n  subgraph Server [\"Server\"]\n    direction TB\n    activities[\"generateImage({ ..., stream: true })\ngenerateSpeech({ ..., stream: true })\ngenerateTranscription({ ..., stream: true })\nsummarize({ ..., stream: true })\ngenerateVideo({ ..., stream: true })\"]\n    transport[\"toServerSentEventsResponse()\"]\n    activities --> transport\n  end\n\n  transport -- \"StreamChunks via SSE\nRUN_STARTED → generation:result → RUN_FINISHED\" --> adapter\n\n  subgraph Client [\"Client\"]\n    direction TB\n    adapter[\"fetchServerSentEvents('/api/...')\"]\n    gc[\"GenerationClient\n(state machine)\"]\n    hooks[\"Framework Hooks\nuseGenerateImage() · useGenerateSpeech()\nuseGenerateVideo() · useSummarize()\nuseTranscription()\"]\n    adapter --> gc\n    gc -- \"result, isLoading, error, status\" --> hooks\n  end\n```\n\nThe key insight: **every generation activity on the server is just an async function that returns a result**. By passing `stream: true`, the function returns a `StreamChunk` iterable instead of a plain result, which the client already knows how to consume.\n\n"}
