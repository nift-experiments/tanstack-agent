{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack AI provides support for image generation through dedicated image adapters. This guide covers how to use the image generation functionality with OpenAI and Gemini providers."}]},{"type":"heading","depth":2,"id":"overview","children":[{"type":"text","value":"Overview"}]},{"type":"paragraph","children":[{"type":"text","value":"Image generation is handled by image adapters that follow the same tree-shakeable architecture as other adapters in TanStack AI. The image adapters support:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"OpenAI"}]},{"type":"text","value":": DALL-E 2, DALL-E 3, GPT-Image-1, GPT-Image-1-Mini, and GPT-Image-2 models"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Gemini"}]},{"type":"text","value":": Gemini native image models (NanoBanana) and Imagen 3/4 models"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"BytePlus"}]},{"type":"text","value":": Seedream 5.0, 4.5, and 4.0 models"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"fal.ai"}]},{"type":"text","value":": 600+ models including Nano Banana Pro, FLUX, and more"}]}]}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"heading","depth":3,"id":"openai-image-generation","children":[{"type":"text","value":"OpenAI Image Generation"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { openaiImage } from \"@tanstack/ai-openai\";\n\n// Generate an image (the adapter uses OPENAI_API_KEY from environment)\nconst result = await generateImage({\n  adapter: openaiImage(\"dall-e-3\"),\n  prompt: \"A beautiful sunset over mountains\",\n});\n\nconsole.log(result.images[0]?.url); // URL to the generated image","lang":"typescript"},{"type":"heading","depth":3,"id":"gemini-image-generation","children":[{"type":"text","value":"Gemini Image Generation"}]},{"type":"paragraph","children":[{"type":"text","value":"Gemini has two image model groups. Gemini native models (NanoBanana) use the Interactions API. Imagen models use "},{"type":"inlineCode","value":"generateImages"},{"type":"text","value":"."}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\n// Gemini native model (NanoBanana). Uses the Interactions API.\nconst result = await generateImage({\n  adapter: geminiImage(\"gemini-3.1-flash-image\"),\n  prompt: \"A futuristic cityscape at night\",\n  size: \"16:9_4K\",\n});\n\n// Imagen model. Uses the generateImages API.\nconst result2 = await generateImage({\n  adapter: geminiImage(\"imagen-4.0-generate-001\"),\n  prompt: \"A futuristic cityscape at night\",\n});\n\nconsole.log(result.images[0]?.b64Json); // Base64 encoded image","lang":"typescript"},{"type":"heading","depth":4,"id":"edit-a-gemini-native-image","children":[{"type":"text","value":"Edit a Gemini native image"}]},{"type":"paragraph","children":[{"type":"text","value":"You have an image from a Gemini native model. You want to change that image without a second upload of that image."}]},{"type":"paragraph","children":[{"type":"text","value":"Pass the last "},{"type":"inlineCode","value":"id"},{"type":"text","value":" back. Write only the change in "},{"type":"inlineCode","value":"prompt"},{"type":"text","value":":"}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { geminiImage } from \"@tanstack/ai-gemini\";\n\nconst adapter = geminiImage(\"gemini-3.1-flash-image\");\n\nconst first = await generateImage({\n  adapter,\n  prompt: \"A red bicycle on a quiet street\",\n});\n\nconst edited = await generateImage({\n  adapter,\n  prompt: \"Make the bicycle blue\",\n  modelOptions: { previous_interaction_id: first.id },\n});","lang":"typescript"},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Generate the first image."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Call "},{"type":"inlineCode","value":"generateImage"},{"type":"text","value":" again with "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":" set to "},{"type":"inlineCode","value":"first.id"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Read "},{"type":"inlineCode","value":"edited.images"},{"type":"text","value":" for the new picture."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Keep the interaction so the next edit can run:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Leave "},{"type":"inlineCode","value":"store"},{"type":"text","value":" unset."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you set "},{"type":"inlineCode","value":"store"},{"type":"text","value":" to "},{"type":"inlineCode","value":"false"},{"type":"text","value":", a later call cannot use that id."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The API default for "},{"type":"inlineCode","value":"store"},{"type":"text","value":" is "},{"type":"inlineCode","value":"true"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"A free tier keeps a stored interaction for 1 day. A paid tier keeps it for 55 days."}]},{"type":"paragraph","children":[{"type":"text","value":"If the model is Imagen, do not pass "},{"type":"inlineCode","value":"previous_interaction_id"},{"type":"text","value":". The call throws."}]},{"type":"paragraph","children":[{"type":"text","value":"If this edit needs a new reference image, add that image part on this call. Do not send the image from "},{"type":"inlineCode","value":"first"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The Interactions API is in Beta."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"edited.images"},{"type":"text","value":" holds the new picture. "},{"type":"inlineCode","value":"edited.id"},{"type":"text","value":" is the id for the next edit."}]},{"type":"heading","depth":3,"id":"byteplus-image-generation","children":[{"type":"text","value":"BytePlus Image Generation"}]},{"type":"paragraph","children":[{"type":"text","value":"Seedream sizes take either a token ("},{"type":"inlineCode","value":"1K"},{"type":"text","value":", "},{"type":"inlineCode","value":"2K"},{"type":"text","value":", "},{"type":"inlineCode","value":"4K"},{"type":"text","value":") or explicit pixels ("},{"type":"inlineCode","value":"2048x2048"},{"type":"text","value":") — never a mix of the two."}]},{"type":"code","value":"import { generateImage } from \"@tanstack/ai\";\nimport { byteplusImage } from \"@tanstack/ai-byteplus\";\n\nconst result = await generateImage({\n  adapter: byteplusImage(\"dola-seedream-5-0-pro-260628\"),\n  prompt: \"A futuristic cityscape at night\",\n  size: \"2K\",\n  modelOptions: { watermark: false },\n});\n\nconsole.log(result.images[0]?.url);","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Two Seedream behaviours differ from the other providers:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"watermark"},{"type":"text","value":" defaults to "},{"type":"inlineCode","value":"true"}]},{"type":"text","value":" — BytePlus stamps \"AI generated\" into the corner unless you turn it off."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"numberOfImages"},{"type":"text","value":" is an upper bound, not a count."}]},{"type":"text","value":" Seedream has no "},{"type":"inlineCode","value":"n"},{"type":"text","value":" parameter, so more than one image maps onto its group-image mode and the model decides how many the prompt warrants. A request for four can return two."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Image URLs expire after 24 hours; pass "},{"type":"inlineCode","value":"response_format: 'b64_json'"},{"type":"text","value":" in "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" for inline bytes. See the "},{"type":"link","href":"../adapters/byteplus#image-generation-seedream","children":[{"type":"text","value":"BytePlus adapter"}]},{"type":"text","value":" for details."}]},{"type":"heading","depth":2,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"heading","depth":3,"id":"common-options","children":[{"type":"text","value":"Common Options"}]},{"type":"paragraph","children":[{"type":"text","value":"All image adapters support these common options:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"adapter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ImageAdapter"}]},{"type":"tableCell","children":[{"type":"text","value":"Image adapter instance with model (required)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"prompt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string | MediaPromptPart[]"}]},{"type":"tableCell","children":[{"type":"text","value":"Description of the image to generate (required). A plain string, or — on models that support image-conditioned generation — an ordered array of content parts interleaving text with image inputs. See "},{"type":"link","href":"#image-conditioned-generation","children":[{"type":"text","value":"Image-Conditioned Generation"}]},{"type":"text","value":" below."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"numberOfImages"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Number of images to generate"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"size"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Size of the generated image in WIDTHxHEIGHT format"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"modelOptions?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"object"}]},{"type":"tableCell","children":[{"type":"text","value":"Model-specific options (renamed from "},{"type":"inlineCode","value":"providerOptions"},{"type":"text","value":")"}]}]]},{"type":"heading","depth":3,"id":"size-options","children":[{"type":"text","value":"Size Options"}]},{"type":"heading","depth":4,"id":"openai-models","children":[{"type":"text","value":"OpenAI Models"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Model"}]},{"type":"tableCell","children":[{"type":"text","value":"Supported Sizes"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"gpt-image-2.5-flare"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"1024x1024"},{"type":"text","value":", "},{"type":"inlineCode","value":"1536x1024"},{"type":"text","value":", "},{"type":"inlineCode","value":"1024x1536"},{"type":"text","value":", "},{"type":"inlineCode","value":"auto"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gpt-image