NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack AI provides support for audio transcription (speech-to-text) through dedicated transcription adapters. This guide covers how to convert spoken audio into text using OpenAI's Whisper and GPT-4o transcription models, Groq's hosted Whisper models, and fal.ai STT models."}]},{"type":"heading","depth":2,"id":"overview","children":[{"type":"text","value":"Overview"}]},{"type":"paragraph","children":[{"type":"text","value":"Audio transcription is handled by transcription adapters that follow the same tree-shakeable architecture as other adapters in TanStack AI."}]},{"type":"paragraph","children":[{"type":"text","value":"Currently supported:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"OpenAI"}]},{"type":"text","value":": Whisper-1, GPT-4o-transcribe, GPT-4o-mini-transcribe, GPT-4o-transcribe-diarize"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Groq"}]},{"type":"text","value":": whisper-large-v3-turbo, whisper-large-v3"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"BytePlus"}]},{"type":"text","value":": Seed Speech ASR ("},{"type":"inlineCode","value":"seed-asr"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"fal.ai"}]},{"type":"text","value":": Whisper, Wizper, speech-to-text turbo, ElevenLabs speech-to-text"}]}]}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"heading","depth":3,"id":"openai-transcription","children":[{"type":"text","value":"OpenAI Transcription"}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { audioBuffer } from './audio'\n\n// Transcribe audio from a file (the adapter uses OPENAI_API_KEY from environment)\nconst audioFile = new File([audioBuffer], 'audio.mp3', { type: 'audio/mpeg' })\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: audioFile,\n  language: 'en',\n})\n\nconsole.log(result.text) // The transcribed text","lang":"typescript"},{"type":"heading","depth":3,"id":"using-base64-audio","children":[{"type":"text","value":"Using Base64 Audio"}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { readFile } from 'fs/promises'\n\n// Read audio file as base64\nconst audioBuffer = await readFile('recording.mp3')\nconst base64Audio = audioBuffer.toString('base64')\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: base64Audio,\n})\n\nconsole.log(result.text)","lang":"typescript"},{"type":"heading","depth":3,"id":"using-data-urls","children":[{"type":"text","value":"Using Data URLs"}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { base64AudioData } from './audio'\n\nconst dataUrl = `data:audio/mpeg;base64,${base64AudioData}`\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: dataUrl,\n})","lang":"typescript"},{"type":"heading","depth":3,"id":"groq-transcription","children":[{"type":"text","value":"Groq Transcription"}]},{"type":"paragraph","children":[{"type":"text","value":"Groq hosts Whisper large-v3 and large-v3-turbo on its fast inference stack. The "},{"type":"inlineCode","value":"audio"},{"type":"text","value":" input accepts a "},{"type":"inlineCode","value":"File"},{"type":"text","value":", "},{"type":"inlineCode","value":"Blob"},{"type":"text","value":", "},{"type":"inlineCode","value":"ArrayBuffer"},{"type":"text","value":", base64 string, data URL, or an "},{"type":"inlineCode","value":"https://"},{"type":"text","value":" URL (which is forwarded to Groq without re-uploading)."}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { groqTranscription } from '@tanstack/ai-groq'\n\nconst result = await generateTranscription({\n  adapter: groqTranscription('whisper-large-v3-turbo'),\n  audio: 'https://example.com/recording.mp3',\n  language: 'en',\n})\n\nconsole.log(result.text)\nconsole.log(result.language)\n\n// verbose_json is the default — segments carry segment-level start/end timestamps\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.start}s → ${segment.end}s] ${segment.text}`)\n}","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Groq supports "},{"type":"inlineCode","value":"responseFormat"},{"type":"text","value":" values "},{"type":"inlineCode","value":"json"},{"type":"text","value":", "},{"type":"inlineCode","value":"text"},{"type":"text","value":", and "},{"type":"inlineCode","value":"verbose_json"},{"type":"text","value":" (default). "},{"type":"inlineCode","value":"srt"},{"type":"text","value":" and "},{"type":"inlineCode","value":"vtt"},{"type":"text","value":" are not supported — passing them throws. Provider-specific "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" are "},{"type":"inlineCode","value":"temperature"},{"type":"text","value":" and "},{"type":"inlineCode","value":"timestamp_granularities"},{"type":"text","value":" ("},{"type":"inlineCode","value":"['word']"},{"type":"text","value":", "},{"type":"inlineCode","value":"['segment']"},{"type":"text","value":", or both)."}]}]},{"type":"heading","depth":3,"id":"byteplus-transcription","children":[{"type":"text","value":"BytePlus Transcription"}]},{"type":"paragraph","children":[{"type":"text","value":"BytePlus Seed Speech ASR is synchronous — audio in, transcript out, no polling. It belongs to the Seed Speech product, so it reads "},{"type":"inlineCode","value":"BYTEPLUS_VOICE_API_KEY"},{"type":"text","value":" rather than the "},{"type":"inlineCode","value":"ARK_API_KEY"},{"type":"text","value":" used by the BytePlus chat, image and video adapters. Audio can be a "},{"type":"inlineCode","value":"File"},{"type":"text","value":", base64, a data URL or a public URL, up to two hours and 100 MB."}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { byteplusTranscription } from '@tanstack/ai-byteplus'\n\nconst result = await generateTranscription({\n  adapter: byteplusTranscription('seed-asr'),\n  audio: 'https://example.com/recording.mp3',\n  language: 'en',\n  modelOptions: { enable_punc: true, enable_speaker_info: true },\n})\n\nconsole.log(result.text)\n\n// Speaker labels land on the segment when enable_speaker_info is set\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.speaker ?? 'unknown'}] ${segment.text}`)\n}","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Provider-specific "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" are "},{"type":"inlineCode","value":"enable_itn"},{"type":"text","value":" (spoken numbers and dates as digits), "},{"type":"inlineCode","value":"enable_punc"},{"type":"text","value":" (punctuation), "},{"type":"inlineCode","value":"enable_ddc"},{"type":"text","value":" (drop fillers and stutters), "},{"type":"inlineCode","value":"enable_speaker_info"},{"type":"text","value":" (speaker labels) and "},{"type":"inlineCode","value":"show_utterances"},{"type":"text","value":" (per-utterance breakdown, on by default)."}]}]},{"type":"heading","depth":3,"id":"fal-ai-transcription","children":[{"type":"text","value":"fal.ai Transcription"}]},{"type":"paragraph","children":[{"type":"text","value":"fal.ai offers Whisper, Wizper, and other STT models. The "},{"type":"inlineCode","value":"audio"},{"type":"text","value":" input accepts a URL, "},{"type":"inlineCode","value":"File"},{"type":"text","value":", "},{"type":"inlineCode","value":"Blob"},{"type":"text","value":", or "},{"type":"inlineCode","value":"ArrayBuffer"},{"type":"text","value":" (auto-wrapped in a "},{"type":"inlineCode","value":"Blob"},{"type":"text","value":")."}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { falTranscription } from '@tanstack/ai-fal'\n\nconst result = await generateTranscription({\n  adapter: falTranscription('fal-ai/whisper'),\n  audio: 'https://example.com/recording.mp3',\n  language: 'en',\n})\n\nconsole.log(result.text)\nconsole.log(result.language)\n\n// Models that return word/chunk timestamps populate result.segments\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.start}s → ${segment.end}s] ${segment.text}`)\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"heading","depth":3,"id":"common-options","children":[{"type":"text","value":"Common Options"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"audio"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"File | string"}]},{"type":"tableCell","children":[{"type":"text","value":"Audio data (File object or base64 string) - required"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"language"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Language code (e.g., \"en\", \"es\", \"fr\")"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"prompt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional prompt to guide transcription style or terms. Not supported with "},{"type":"inlineCode","value":"gpt-4o-transcribe-diarize"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"responseFormat"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'json' | 'text' | 'srt' | 'verbose_json' | 'vtt'"}]},{"type":"tableCell","children":[{"type":"text","value":"Common output format"}]}]]},{"type":"heading","depth":3,"id":"supported-languages","children":[{"type":"text","value":"Supported Languages"}]},{"type":"paragraph","children":[{"type":"text","value":"Whisper supports many languages. Common codes include:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Code"}]},{"type":"tableCell","children":[{"type":"text","value":"Language"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"en"}]},{"type":"tableCell","children":[{"type":"text","value":"English"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"es"}]},{"type":"tableCell","children":[{"type":"text","value":"Spanish"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fr"}]},{"type":"tableCell","children":[{"type":"text","value":"French"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"de"}]},{"type":"tableCell","children":[{"type":"text","value":"German"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"it"}]},{"type":"tableCell","children":[{"type":"text","value":"Italian"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"pt"}]},{"type":"tableCell","children":[{"type":"text","value":"Portuguese"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ja"}]},{"type":"tableCell","children":[{"type":"text","value":"Japanese"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ko"}]},{"type":"tableCell","children":[{"type":"text","value":"Korean"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"zh"}]},{"type":"tableCell","children":[{"type":"text","value":"Chinese"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ru"}]},{"type":"tableCell","children":[{"type":"text","value":"Russian"}]}]]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Tip:"}]},{"type":"text","value":" Providing the correct language code improves accuracy and reduces latency."}]}]},{"type":"heading","depth":2,"id":"complete-example","children":[{"type":"text","value":"Complete Example"}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { readFile } from 'fs/promises'\n\nasync function transcribeAudio(filepath: string) {\n  // Read the audio file\n  const audioBuffer = await readFile(filepath)\n  const audioFile = new File(\n    [audioBuffer], \n    filepath.split('/').pop()!, \n    { type: 'audio/mpeg' }\n  )\n\n  // Transcribe with detailed output\n  const result = await generateTranscription({\n    adapter: openaiTranscription('whisper-1'),\n    audio: audioFile,\n    language: 'en',\n    responseFormat: 'verbose_json',\n    modelOptions: {\n      timestamp_granularities: ['segment', 'word'],\n    },\n  })\n\n  console.log('Full text:', result.text)\n  console.log('Duration:', result.duration, 'seconds')\n  \n  // Print segments with timestamps\n  if (result.segments) {\n    for (const segment of result.segments) {\n      console.log(`[${segment.start.toFixed(2)}s - ${segment.end.toFixed(2)}s]: ${segment.text}`)\n    }\n  }\n\n  return result\n}\n\n// Usage\nawait transcribeAudio('./meeting-recording.mp3')","lang":"typescript"},{"type":"heading","depth":2,"id":"browser-usage","children":[{"type":"text","value":"Browser Usage"}]},{"type":"heading","depth":3,"id":"recording-and-transcribing","children":[{"type":"text","value":"Recording and Transcribing"}]},{"type":"code","value":"async function recordAndTranscribe() {\n  // Request microphone access\n  const stream = await navigator.mediaDevices.getUserMedia({ audio: true })\n  const mediaRecorder = new MediaRecorder(stream)\n  const chunks: Blob[] = []\n\n  mediaRecorder.ondataavailable = (e) => chunks.push(e.data)\n  \n  mediaRecorder.onstop = async () => {\n    const audioBlob = new Blob(chunks, { type: 'audio/webm' })\n    const audioFile = new File([audioBlob], 'recording.webm', { type: 'audio/webm' })\n    \n    // Send to your API endpoint for transcription\n    const formData = new FormData()\n    formData.append('audio', audioFile)\n    \n    const response = await fetch('/api/transcribe', {\n      method: 'POST',\n      body: formData,\n    })\n    \n    const result = await response.json()\n    console.log('Transcription:', result.text)\n  }\n\n  // Start recording\n  mediaRecorder.start()\n  \n  // Stop after 10 seconds\n  setTimeout(() => mediaRecorder.stop(), 10000)\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"server-api-endpoint","children":[{"type":"text","value":"Server API Endpoint"}]},{"type":"code","value":"// api/transcribe.ts\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const formData = await request.formData()\n  const audioFile = formData.get('audio')\n  if (!(audioFile instanceof File)) {\n    throw new Error('Expected an audio file under \"audio\"')\n  }\n\n  const result = await generateTranscription({\n    adapter: openaiTranscription('whisper-1'),\n    audio: audioFile,\n  })\n\n  return Response.json(result)\n}","lang":"typescript","meta":"ignore"},{"type":"heading","depth":2,"id":"full-stack-usage","children":[{"type":"text","value":"Full-Stack Usage"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI provides React hooks and server-side streaming helpers to build full-stack audio transcription with minimal boilerplate."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Transcribing a big file can run long — keep its status and result\nacross a reload or a dropped connection with\n"},{"type":"link","href":"../persistence/generation-persistence","children":[{"type":"text","value":"Generation Persistence"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":3,"id":"streaming-mode-server-route-client-hook","children":[{"type":"text","value":"Streaming Mode (Server Route + Client Hook)"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server"}]},{"type":"text","value":" — Create an API route that wraps "},{"type":"inlineCode","value":"generateTranscription"},{"type":"text","value":" as a streaming response:"}]},{"type":"code","value":"// routes/api/transcribe.ts\nimport {\n  generateTranscription,\n  toServerSentEventsResponse,\n} from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/api/transcribe')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n        const { audio, language, model } = body.data\n\n        const stream = generateTranscription({\n          adapter: openaiTranscription(model ?? 'whisper-1'),\n          audio,\n          language,\n          stream: true,\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})","lang":"typescript","meta":"ignore"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" For browser-recorded audio, you'll typically send the audio as a base64 string in the JSON body. For file uploads, use a FormData-based endpoint instead (see "},{"type":"link","href":"#browser-usage","children":[{"type":"text","value":"Browser Usage"}]},{"type":"text","value":" above)."}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Client"}]},{"type":"text","value":" — Use the "},{"type":"inlineCode","value":"useTranscription"},{"type":"text","value":" hook with a connection adapter:"}]},{"type":"code","value":"import { useTranscription, fetchServerSentEvents } from '@tanstack/ai-react'\n\nfunction AudioTranscriber() {\n  const { generate, result, isLoading, error } = useTranscription({\n    connection: fetchServerSentEvents('/api/transcribe'),\n  })\n\n  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0]\n    if (!file) return\n\n    // Convert to base64 for JSON transport\n    const buffer = await file.arrayBuffer()\n    const base64 = btoa(\n      new Uint8Array(buffer).reduce((s, b) => s + String.fromCharCode(b), ''),\n    )\n    const dataUrl = `data:${file.type};base64,${base64}`\n\n    await generate({ audio: dataUrl, language: 'en' })\n  }\n\n  return (\n    <div>\n      <input type=\"file\" accept=\"audio/*\" onChange={handleFileUpload} />\n      {isLoading && <p>Transcribing...</p>}\n      {error && <p>Error: {error.message}</p>}\n      {result && (\n        <div>\n          <p>{result.text}</p>\n          {result.duration && <p>Duration: {result.duration}s</p>}\n        </div>\n      )}\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The other two transports (a server function returning JSON, or one returning an\nSSE "},{"type":"inlineCode","value":"Response"},{"type":"text","value":") work the same way here. They are in\n"},{"type":"link","href":"#other-transports","children":[{"type":"text","value":"Advanced: other transports"}]},{"type":"text","value":", and explained once in\n"},{"type":"link","href":"./generations#transports-in-full","children":[{"type":"text","value":"Generations"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"hook-api","children":[{"type":"text","value":"Hook API"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"useTranscription"},{"type":"text","value":" hook accepts:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"connection"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ConnectionAdapter"}]},{"type":"tableCell","children":[{"type":"text","value":"Streaming transport (SSE, HTTP stream, custom)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fetcher"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(input) => Promise<TranscriptionResult | Response>"}]},{"type":"tableCell","children":[{"type":"text","value":"Direct async function, or server function returning an SSE "},{"type":"inlineCode","value":"Response"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onResult"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(result) => TOutput | null | void"}]},{"type":"tableCell","children":[{"type":"text","value":"Callback when transcription completes. Optionally return a transformed value to store as "},{"type":"inlineCode","value":"result"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(error) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Callback on error"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onProgress"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(progress, message?) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Progress updates (0-100)"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"And returns:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"generate"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(input: TranscriptionGenerateInput) => Promise<void>"}]},{"type":"tableCell","children":[{"type":"text","value":"Trigger transcription"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TranscriptionResult | null"}]},{"type":"tableCell","children":[{"type":"text","value":"The result with text and segments, or null"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"isLoading"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether transcription is in progress"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"error"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Error | undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Current error, if any"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"status"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"GenerationClientState"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'idle'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'generating'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'success'"},{"type":"text","value":" | "},{"type":"inlineCode","value":"'error'"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stop"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Abort the current transcription"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"reset"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Clear result, error, and return to idle"}]}]]},{"type":"heading","depth":2,"id":"advanced","children":[{"type":"text","value":"Advanced"}]},{"type":"paragraph","children":[{"type":"text","value":"Reference detail you do not need to get this working."}]},{"type":"heading","depth":3,"id":"other-transports","children":[{"type":"text","value":"Other transports"}]},{"type":"heading","depth":4,"id":"direct-mode-server-function-fetcher","children":[{"type":"text","value":"Direct Mode (Server Function + Fetcher)"}]},{"type":"paragraph","children":[{"type":"text","value":"For non-streaming usage with TanStack Start server functions:"}]},{"type":"code","value":"// lib/server-functions.ts\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\n\nexport const transcribeFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { audio: string; language?: string }) => data)\n  .handler(async ({ data }) => {\n    return generateTranscription({\n      adapter: openaiTranscription('whisper-1'),\n      audio: data.audio,\n      language: data.language,\n    })\n  })","lang":"typescript","meta":"ignore"},{"type":"code","value":"import { useTranscription } from '@tanstack/ai-react'\nimport { transcribeFn } from '../lib/server-functions'\n\nfunction AudioTranscriber() {\n  const { generate, result, isLoading } = useTranscription({\n    fetcher: (input) => transcribeFn({ data: input }),\n  })\n  // ... same UI as above\n}","lang":"tsx"},{"type":"heading","depth":4,"id":"server-function-streaming-fetcher-response","children":[{"type":"text","value":"Server Function Streaming (Fetcher + Response)"}]},{"type":"paragraph","children":[{"type":"text","value":"For TanStack Start server functions that stream results. The fetcher receives type-safe input and returns an SSE "},{"type":"inlineCode","value":"Response"},{"type":"text","value":" — the client parses it automatically:"}]},{"type":"code","value":"// lib/server-functions.ts\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateTranscription, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\n\nexport const transcribeStreamFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { audio: string; language?: string }) => data)\n  .handler(({ data }) => {\n    return toServerSentEventsResponse(\n      generateTranscription({\n        adapter: openaiTranscription('whisper-1'),\n        audio: data.audio,\n        language: data.language,\n        stream: true,\n      }),\n    )\n  })","lang":"typescript","meta":"ignore"},{"type":"code","value":"import { useTranscription } from '@tanstack/ai-react'\nimport { transcribeStreamFn } from '../lib/server-functions'\n\nfunction AudioTranscriber() {\n  const { generate, result, isLoading } = useTranscription({\n    fetcher: (input) => {\n      if (typeof input.audio !== 'string') {\n        throw new Error('Expected base64 or data URL audio')\n      }\n      return transcribeStreamFn({\n        data: { ...input, audio: input.audio },\n      })\n    },\n  })\n  // ... same UI as above\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"model-options","children":[{"type":"text","value":"Model Options"}]},{"type":"heading","depth":4,"id":"openai-model-options","children":[{"type":"text","value":"OpenAI Model Options"}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { audioFile } from './audio'\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: audioFile,\n  responseFormat: 'verbose_json', // Top-level: detailed output with timestamps\n  prompt: 'Technical terms: API, SDK, CLI', // Top-level: guide transcription\n  modelOptions: {\n    temperature: 0, // Lower = more deterministic (provider option)\n    timestamp_granularities: ['word', 'segment'],\n  },\n})","lang":"typescript"},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"temperature"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Sampling temperature (0 to 1)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"timestamp_granularities"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Array<'word' | 'segment'>"}]},{"type":"tableCell","children":[{"type":"text","value":"Timestamp granularity to populate ("},{"type":"inlineCode","value":"whisper-1"},{"type":"text","value":" only; requires top-level "},{"type":"inlineCode","value":"responseFormat: 'verbose_json'"},{"type":"text","value":")"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"include"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string[]"}]},{"type":"tableCell","children":[{"type":"text","value":"Additional values to include in the response (e.g., "},{"type":"inlineCode","value":"logprobs"},{"type":"text","value":")"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"response_format"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'json' | 'text' | 'srt' | 'verbose_json' | 'vtt' | 'diarized_json'"}]},{"type":"tableCell","children":[{"type":"text","value":"Raw OpenAI response format. Use "},{"type":"inlineCode","value":"diarized_json"},{"type":"text","value":" here for speaker-labeled diarization output."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"chunking_strategy"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'auto' | { type: 'server_vad', ... } | null"}]},{"type":"tableCell","children":[{"type":"text","value":"Audio chunking strategy (any model; unset transcribes the audio as a single block). Required by OpenAI for "},{"type":"inlineCode","value":"gpt-4o-transcribe-diarize"},{"type":"text","value":" inputs longer than 30 seconds — the adapter defaults it to "},{"type":"inlineCode","value":"'auto'"},{"type":"text","value":" for that model"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"known_speaker_names"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string[]"}]},{"type":"tableCell","children":[{"type":"text","value":"Up to four speaker labels for diarization"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"known_speaker_references"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string[]"}]},{"type":"tableCell","children":[{"type":"text","value":"2-10 second data URL audio samples matching "},{"type":"inlineCode","value":"known_speaker_names"}]}]]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"responseFormat"},{"type":"text","value":" and "},{"type":"inlineCode","value":"prompt"},{"type":"text","value":" are "},{"type":"strong","children":[{"type":"text","value":"top-level"}]},{"type":"text","value":" options on "},{"type":"inlineCode","value":"generateTranscription"},{"type":"text","value":", not "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" keys."}]}]},{"type":"heading","depth":4,"id":"response-formats","children":[{"type":"text","value":"Response Formats"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Format"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"json"}]},{"type":"tableCell","children":[{"type":"text","value":"Simple JSON with text"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"text"}]},{"type":"tableCell","children":[{"type":"text","value":"Plain text only"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"srt"}]},{"type":"tableCell","children":[{"type":"text","value":"SubRip subtitle format"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"verbose_json"}]},{"type":"tableCell","children":[{"type":"text","value":"Detailed JSON with timestamps and segments"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"vtt"}]},{"type":"tableCell","children":[{"type":"text","value":"WebVTT subtitle format"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"OpenAI's "},{"type":"inlineCode","value":"gpt-4o-transcribe-diarize"},{"type":"text","value":" also supports "},{"type":"inlineCode","value":"modelOptions.response_format: 'diarized_json'"},{"type":"text","value":" for speaker-labeled segments."}]},{"type":"heading","depth":4,"id":"speaker-diarization","children":[{"type":"text","value":"Speaker Diarization"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"gpt-4o-transcribe-diarize"},{"type":"text","value":" when you need speaker labels. When no response format is specified, TanStack AI defaults the request to "},{"type":"inlineCode","value":"response_format: 'diarized_json'"},{"type":"text","value":" and sends "},{"type":"inlineCode","value":"chunking_strategy: 'auto'"},{"type":"text","value":" unless you provide a chunking strategy yourself. Passing a top-level "},{"type":"inlineCode","value":"responseFormat: 'json'"},{"type":"text","value":" or "},{"type":"inlineCode","value":"'text'"},{"type":"text","value":" opts out of speaker segments."}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { meetingAudioFile } from './audio'\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('gpt-4o-transcribe-diarize'),\n  audio: meetingAudioFile,\n  modelOptions: {\n    known_speaker_names: ['agent', 'customer'],\n    known_speaker_references: [\n      'data:audio/wav;base64,...',\n      'data:audio/wav;base64,...',\n    ],\n  },\n})\n\nfor (const segment of result.segments ?? []) {\n  console.log(segment.speaker, segment.start, segment.end, segment.text)\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Two constraints the adapter enforces before it calls the API:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Up to four known speaker references. "},{"type":"inlineCode","value":"known_speaker_names"},{"type":"text","value":" and "},{"type":"inlineCode","value":"known_speaker_references"},{"type":"text","value":" must be provided together, with matching lengths."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The diarization model does not support "},{"type":"inlineCode","value":"prompt"},{"type":"text","value":", "},{"type":"inlineCode","value":"include"},{"type":"text","value":", or "},{"type":"inlineCode","value":"timestamp_granularities"},{"type":"text","value":". Those combinations are rejected."}]}]}]},{"type":"heading","depth":3,"id":"response-format","children":[{"type":"text","value":"Response Format"}]},{"type":"paragraph","children":[{"type":"text","value":"The transcription result includes:"}]},{"type":"code","value":"interface TranscriptionResult {\n  id: string           // Unique identifier\n  model: string        // Model used\n  text: string         // Full transcribed text\n  language?: string    // Detected/specified language\n  duration?: number    // Audio duration in seconds\n  segments?: Array<{   // Timestamped segments\n    id: number         // Segment identifier\n    start: number      // Start time in seconds\n    end: number        // End time in seconds\n    text: string       // Segment text\n    confidence?: number // Confidence score (0-1), if available\n    speaker?: string    // Speaker identifier, if diarization is enabled\n  }>\n  words?: Array<{      // Word-level timestamps (top-level)\n    word: string\n    start: number\n    end: number\n  }>\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"model-availability","children":[{"type":"text","value":"Model Availability"}]},{"type":"heading","depth":4,"id":"openai-models","children":[{"type":"text","value":"OpenAI Models"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Model"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]},{"type":"tableCell","children":[{"type":"text","value":"Use Case"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"whisper-1"}]},{"type":"tableCell","children":[{"type":"text","value":"Whisper large-v2"}]},{"type":"tableCell","children":[{"type":"text","value":"General transcription"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gpt-4o-transcribe"}]},{"type":"tableCell","children":[{"type":"text","value":"GPT-4o-based transcription"}]},{"type":"tableCell","children":[{"type":"text","value":"Higher accuracy"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gpt-4o-transcribe-diarize"}]},{"type":"tableCell","children":[{"type":"text","value":"With speaker diarization"}]},{"type":"tableCell","children":[{"type":"text","value":"Multi-speaker audio"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gpt-4o-mini-transcribe"}]},{"type":"tableCell","children":[{"type":"text","value":"Faster, lighter model"}]},{"type":"tableCell","children":[{"type":"text","value":"Cost-effective"}]}]]},{"type":"heading","depth":4,"id":"supported-audio-formats","children":[{"type":"text","value":"Supported Audio Formats"}]},{"type":"paragraph","children":[{"type":"text","value":"OpenAI supports these audio formats:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mp3"},{"type":"text","value":" - MPEG Audio Layer 3"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mp4"},{"type":"text","value":" - MPEG-4 Audio"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mpeg"},{"type":"text","value":" - MPEG Audio"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mpga"},{"type":"text","value":" - MPEG Audio"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"m4a"},{"type":"text","value":" - MPEG-4 Audio"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"wav"},{"type":"text","value":" - Waveform Audio"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"webm"},{"type":"text","value":" - WebM Audio"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"flac"},{"type":"text","value":" - Free Lossless Audio Codec"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ogg"},{"type":"text","value":" - Ogg Vorbis"}]}]}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Maximum file size is 25 MB."}]}]},{"type":"heading","depth":3,"id":"error-handling","children":[{"type":"text","value":"Error Handling"}]},{"type":"code","value":"import { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { audioFile } from './audio'\n\ntry {\n  const result = await generateTranscription({\n    adapter: openaiTranscription('whisper-1'),\n    audio: audioFile,\n  })\n} catch (error) {\n  if (error instanceof Error) {\n    if (error.message.includes('Invalid file format')) {\n      console.error('Unsupported audio format')\n    } else if (error.message.includes('File too large')) {\n      console.error('Audio file exceeds 25 MB limit')\n    } else if (error.message.includes('Audio file is too short')) {\n      console.error('Audio must be at least 0.1 seconds')\n    } else {\n      console.error('Transcription error:', error.message)\n    }\n  }\n}","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Debugging:"}]},{"type":"text","value":" When a transcription returns garbage, empty segments, or the provider rejects your audio format, pass "},{"type":"inlineCode","value":"debug: true"},{"type":"text","value":" on "},{"type":"inlineCode","value":"generateTranscription({...})"},{"type":"text","value":" to log the outgoing request and every raw provider chunk. See "},{"type":"link","href":"../advanced/debug-logging","children":[{"type":"text","value":"Debug Logging"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":3,"id":"environment-variables","children":[{"type":"text","value":"Environment Variables"}]},{"type":"paragraph","children":[{"type":"text","value":"The transcription adapter uses:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"OPENAI_API_KEY"},{"type":"text","value":": Your OpenAI API key"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"BYTEPLUS_VOICE_API_KEY"},{"type":"text","value":": Your BytePlus Seed Speech key (not the ModelArk key)"}]}]}]},{"type":"heading","depth":3,"id":"explicit-api-keys","children":[{"type":"text","value":"Explicit API Keys"}]},{"type":"code","value":"import { createOpenaiTranscription } from '@tanstack/ai-openai'\n\nconst adapter = createOpenaiTranscription('whisper-1', 'your-openai-api-key')","lang":"typescript"},{"type":"heading","depth":3,"id":"best-practices","children":[{"type":"text","value":"Best Practices"}]},{"type":"list","ordered":true,"start":1,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Audio Quality"}]},{"type":"text","value":": Better audio quality leads to more accurate transcriptions. Reduce background noise when possible."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Language Specification"}]},{"type":"text","value":": Always specify the language if known—this improves accuracy and speed."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"File Size"}]},{"type":"text","value":": Keep audio files under 25 MB. For longer recordings, split into chunks."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Format Selection"}]},{"type":"text","value":": MP3 offers a good balance of quality and size. Use WAV or FLAC for highest quality."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Prompting"}]},{"type":"text","value":": Use the "},{"type":"inlineCode","value":"prompt"},{"type":"text","value":" option to provide context or expected vocabulary (e.g., technical terms, names)."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Timestamps"}]},{"type":"text","value":": Request "},{"type":"inlineCode","value":"responseFormat: 'verbose_json'"},{"type":"text","value":" and set "},{"type":"inlineCode","value":"modelOptions.timestamp_granularities"},{"type":"text","value":" when you need timing information for captions or synchronization."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Diarization"}]},{"type":"text","value":": Use "},{"type":"inlineCode","value":"gpt-4o-transcribe-diarize"},{"type":"text","value":" with "},{"type":"inlineCode","value":"modelOptions.response_format: 'diarized_json'"},{"type":"text","value":" output for multi-speaker audio. Keep "},{"type":"inlineCode","value":"chunking_strategy: 'auto'"},{"type":"text","value":" unless you need custom VAD tuning."}]}]}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"openai-transcription","text":"OpenAI Transcription","level":3},{"id":"using-base64-audio","text":"Using Base64 Audio","level":3},{"id":"using-data-urls","text":"Using Data URLs","level":3},{"id":"groq-transcription","text":"Groq Transcription","level":3},{"id":"byteplus-transcription","text":"BytePlus Transcription","level":3},{"id":"fal-ai-transcription","text":"fal.ai Transcription","level":3},{"id":"options","text":"Options","level":2},{"id":"common-options","text":"Common Options","level":3},{"id":"supported-languages","text":"Supported Languages","level":3},{"id":"complete-example","text":"Complete Example","level":2},{"id":"browser-usage","text":"Browser Usage","level":2},{"id":"recording-and-transcribing","text":"Recording and Transcribing","level":3},{"id":"server-api-endpoint","text":"Server API Endpoint","level":3},{"id":"full-stack-usage","text":"Full-Stack Usage","level":2},{"id":"streaming-mode-server-route-client-hook","text":"Streaming Mode (Server Route + Client Hook)","level":3},{"id":"hook-api","text":"Hook API","level":3},{"id":"advanced","text":"Advanced","level":2},{"id":"other-transports","text":"Other transports","level":3},{"id":"direct-mode-server-function-fetcher","text":"Direct Mode (Server Function + Fetcher)","level":4},{"id":"server-function-streaming-fetcher-response","text":"Server Function Streaming (Fetcher + Response)","level":4},{"id":"model-options","text":"Model Options","level":3},{"id":"openai-model-options","text":"OpenAI Model Options","level":4},{"id":"response-formats","text":"Response Formats","level":4},{"id":"speaker-diarization","text":"Speaker Diarization","level":4},{"id":"response-format","text":"Response Format","level":3},{"id":"model-availability","text":"Model Availability","level":3},{"id":"openai-models","text":"OpenAI Models","level":4},{"id":"supported-audio-formats","text":"Supported Audio Formats","level":4},{"id":"error-handling","text":"Error Handling","level":3},{"id":"environment-variables","text":"Environment Variables","level":3},{"id":"explicit-api-keys","text":"Explicit API Keys","level":3},{"id":"best-practices","text":"Best Practices","level":3}]},"frameworks":[],"downloadMarkdown":"\nTanStack AI provides support for audio transcription (speech-to-text) through dedicated transcription adapters. This guide covers how to convert spoken audio into text using OpenAI's Whisper and GPT-4o transcription models, Groq's hosted Whisper models, and fal.ai STT models.\n\n## Overview\n\nAudio transcription is handled by transcription adapters that follow the same tree-shakeable architecture as other adapters in TanStack AI.\n\nCurrently supported:\n- **OpenAI**: Whisper-1, GPT-4o-transcribe, GPT-4o-mini-transcribe, GPT-4o-transcribe-diarize\n- **Groq**: whisper-large-v3-turbo, whisper-large-v3\n- **BytePlus**: Seed Speech ASR (`seed-asr`)\n- **fal.ai**: Whisper, Wizper, speech-to-text turbo, ElevenLabs speech-to-text\n\n## Basic Usage\n\n### OpenAI Transcription\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { audioBuffer } from './audio'\n\n// Transcribe audio from a file (the adapter uses OPENAI_API_KEY from environment)\nconst audioFile = new File([audioBuffer], 'audio.mp3', { type: 'audio/mpeg' })\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: audioFile,\n  language: 'en',\n})\n\nconsole.log(result.text) // The transcribed text\n```\n\n### Using Base64 Audio\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { readFile } from 'fs/promises'\n\n// Read audio file as base64\nconst audioBuffer = await readFile('recording.mp3')\nconst base64Audio = audioBuffer.toString('base64')\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: base64Audio,\n})\n\nconsole.log(result.text)\n```\n\n### Using Data URLs\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { base64AudioData } from './audio'\n\nconst dataUrl = `data:audio/mpeg;base64,${base64AudioData}`\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: dataUrl,\n})\n```\n\n### Groq Transcription\n\nGroq hosts Whisper large-v3 and large-v3-turbo on its fast inference stack. The `audio` input accepts a `File`, `Blob`, `ArrayBuffer`, base64 string, data URL, or an `https://` URL (which is forwarded to Groq without re-uploading).\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { groqTranscription } from '@tanstack/ai-groq'\n\nconst result = await generateTranscription({\n  adapter: groqTranscription('whisper-large-v3-turbo'),\n  audio: 'https://example.com/recording.mp3',\n  language: 'en',\n})\n\nconsole.log(result.text)\nconsole.log(result.language)\n\n// verbose_json is the default — segments carry segment-level start/end timestamps\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.start}s → ${segment.end}s] ${segment.text}`)\n}\n```\n\n> **Note:** Groq supports `responseFormat` values `json`, `text`, and `verbose_json` (default). `srt` and `vtt` are not supported — passing them throws. Provider-specific `modelOptions` are `temperature` and `timestamp_granularities` (`['word']`, `['segment']`, or both).\n\n### BytePlus Transcription\n\nBytePlus Seed Speech ASR is synchronous — audio in, transcript out, no polling. It belongs to the Seed Speech product, so it reads `BYTEPLUS_VOICE_API_KEY` rather than the `ARK_API_KEY` used by the BytePlus chat, image and video adapters. Audio can be a `File`, base64, a data URL or a public URL, up to two hours and 100 MB.\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { byteplusTranscription } from '@tanstack/ai-byteplus'\n\nconst result = await generateTranscription({\n  adapter: byteplusTranscription('seed-asr'),\n  audio: 'https://example.com/recording.mp3',\n  language: 'en',\n  modelOptions: { enable_punc: true, enable_speaker_info: true },\n})\n\nconsole.log(result.text)\n\n// Speaker labels land on the segment when enable_speaker_info is set\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.speaker ?? 'unknown'}] ${segment.text}`)\n}\n```\n\n> **Note:** Provider-specific `modelOptions` are `enable_itn` (spoken numbers and dates as digits), `enable_punc` (punctuation), `enable_ddc` (drop fillers and stutters), `enable_speaker_info` (speaker labels) and `show_utterances` (per-utterance breakdown, on by default).\n\n### fal.ai Transcription\n\nfal.ai offers Whisper, Wizper, and other STT models. The `audio` input accepts a URL, `File`, `Blob`, or `ArrayBuffer` (auto-wrapped in a `Blob`).\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { falTranscription } from '@tanstack/ai-fal'\n\nconst result = await generateTranscription({\n  adapter: falTranscription('fal-ai/whisper'),\n  audio: 'https://example.com/recording.mp3',\n  language: 'en',\n})\n\nconsole.log(result.text)\nconsole.log(result.language)\n\n// Models that return word/chunk timestamps populate result.segments\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.start}s → ${segment.end}s] ${segment.text}`)\n}\n```\n\n## Options\n\n### Common Options\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `audio` | `File \\| string` | Audio data (File object or base64 string) - required |\n| `language` | `string` | Language code (e.g., \"en\", \"es\", \"fr\") |\n| `prompt` | `string` | Optional prompt to guide transcription style or terms. Not supported with `gpt-4o-transcribe-diarize`. |\n| `responseFormat` | `'json' \\| 'text' \\| 'srt' \\| 'verbose_json' \\| 'vtt'` | Common output format |\n\n### Supported Languages\n\nWhisper supports many languages. Common codes include:\n\n| Code | Language |\n|------|----------|\n| `en` | English |\n| `es` | Spanish |\n| `fr` | French |\n| `de` | German |\n| `it` | Italian |\n| `pt` | Portuguese |\n| `ja` | Japanese |\n| `ko` | Korean |\n| `zh` | Chinese |\n| `ru` | Russian |\n\n> **Tip:** Providing the correct language code improves accuracy and reduces latency.\n\n## Complete Example\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { readFile } from 'fs/promises'\n\nasync function transcribeAudio(filepath: string) {\n  // Read the audio file\n  const audioBuffer = await readFile(filepath)\n  const audioFile = new File(\n    [audioBuffer], \n    filepath.split('/').pop()!, \n    { type: 'audio/mpeg' }\n  )\n\n  // Transcribe with detailed output\n  const result = await generateTranscription({\n    adapter: openaiTranscription('whisper-1'),\n    audio: audioFile,\n    language: 'en',\n    responseFormat: 'verbose_json',\n    modelOptions: {\n      timestamp_granularities: ['segment', 'word'],\n    },\n  })\n\n  console.log('Full text:', result.text)\n  console.log('Duration:', result.duration, 'seconds')\n  \n  // Print segments with timestamps\n  if (result.segments) {\n    for (const segment of result.segments) {\n      console.log(`[${segment.start.toFixed(2)}s - ${segment.end.toFixed(2)}s]: ${segment.text}`)\n    }\n  }\n\n  return result\n}\n\n// Usage\nawait transcribeAudio('./meeting-recording.mp3')\n```\n\n## Browser Usage\n\n### Recording and Transcribing\n\n```typescript\nasync function recordAndTranscribe() {\n  // Request microphone access\n  const stream = await navigator.mediaDevices.getUserMedia({ audio: true })\n  const mediaRecorder = new MediaRecorder(stream)\n  const chunks: Blob[] = []\n\n  mediaRecorder.ondataavailable = (e) => chunks.push(e.data)\n  \n  mediaRecorder.onstop = async () => {\n    const audioBlob = new Blob(chunks, { type: 'audio/webm' })\n    const audioFile = new File([audioBlob], 'recording.webm', { type: 'audio/webm' })\n    \n    // Send to your API endpoint for transcription\n    const formData = new FormData()\n    formData.append('audio', audioFile)\n    \n    const response = await fetch('/api/transcribe', {\n      method: 'POST',\n      body: formData,\n    })\n    \n    const result = await response.json()\n    console.log('Transcription:', result.text)\n  }\n\n  // Start recording\n  mediaRecorder.start()\n  \n  // Stop after 10 seconds\n  setTimeout(() => mediaRecorder.stop(), 10000)\n}\n```\n\n### Server API Endpoint\n\n```typescript ignore\n// api/transcribe.ts\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const formData = await request.formData()\n  const audioFile = formData.get('audio')\n  if (!(audioFile instanceof File)) {\n    throw new Error('Expected an audio file under \"audio\"')\n  }\n\n  const result = await generateTranscription({\n    adapter: openaiTranscription('whisper-1'),\n    audio: audioFile,\n  })\n\n  return Response.json(result)\n}\n```\n\n## Full-Stack Usage\n\nTanStack AI provides React hooks and server-side streaming helpers to build full-stack audio transcription with minimal boilerplate.\n\n> **Note:** Transcribing a big file can run long — keep its status and result\n> across a reload or a dropped connection with\n> [Generation Persistence](../persistence/generation-persistence).\n\n### Streaming Mode (Server Route + Client Hook)\n\n**Server** — Create an API route that wraps `generateTranscription` as a streaming response:\n\n```typescript ignore\n// routes/api/transcribe.ts\nimport {\n  generateTranscription,\n  toServerSentEventsResponse,\n} from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/api/transcribe')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n        const { audio, language, model } = body.data\n\n        const stream = generateTranscription({\n          adapter: openaiTranscription(model ?? 'whisper-1'),\n          audio,\n          language,\n          stream: true,\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n> **Note:** For browser-recorded audio, you'll typically send the audio as a base64 string in the JSON body. For file uploads, use a FormData-based endpoint instead (see [Browser Usage](#browser-usage) above).\n\n**Client** — Use the `useTranscription` hook with a connection adapter:\n\n```tsx\nimport { useTranscription, fetchServerSentEvents } from '@tanstack/ai-react'\n\nfunction AudioTranscriber() {\n  const { generate, result, isLoading, error } = useTranscription({\n    connection: fetchServerSentEvents('/api/transcribe'),\n  })\n\n  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0]\n    if (!file) return\n\n    // Convert to base64 for JSON transport\n    const buffer = await file.arrayBuffer()\n    const base64 = btoa(\n      new Uint8Array(buffer).reduce((s, b) => s + String.fromCharCode(b), ''),\n    )\n    const dataUrl = `data:${file.type};base64,${base64}`\n\n    await generate({ audio: dataUrl, language: 'en' })\n  }\n\n  return (\n    <div>\n      <input type=\"file\" accept=\"audio/*\" onChange={handleFileUpload} />\n      {isLoading && <p>Transcribing...</p>}\n      {error && <p>Error: {error.message}</p>}\n      {result && (\n        <div>\n          <p>{result.text}</p>\n          {result.duration && <p>Duration: {result.duration}s</p>}\n        </div>\n      )}\n    </div>\n  )\n}\n```\n\nThe other two transports (a server function returning JSON, or one returning an\nSSE `Response`) work the same way here. They are in\n[Advanced: other transports](#other-transports), and explained once in\n[Generations](./generations#transports-in-full).\n\n### Hook API\n\nThe `useTranscription` hook accepts:\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `connection` | `ConnectionAdapter` | Streaming transport (SSE, HTTP stream, custom) |\n| `fetcher` | `(input) => Promise<TranscriptionResult \\| Response>` | Direct async function, or server function returning an SSE `Response` |\n| `onResult` | `(result) => TOutput \\| null \\| void` | Callback when transcription completes. Optionally return a transformed value to store as `result` |\n| `onError` | `(error) => void` | Callback on error |\n| `onProgress` | `(progress, message?) => void` | Progress updates (0-100) |\n\nAnd returns:\n\n| Property | Type | Description |\n|----------|------|-------------|\n| `generate` | `(input: TranscriptionGenerateInput) => Promise<void>` | Trigger transcription |\n| `result` | `TranscriptionResult \\| null` | The result with text and segments, or null |\n| `isLoading` | `boolean` | Whether transcription is in progress |\n| `error` | `Error \\| undefined` | Current error, if any |\n| `status` | `GenerationClientState` | `'idle'` \\| `'generating'` \\| `'success'` \\| `'error'` |\n| `stop` | `() => void` | Abort the current transcription |\n| `reset` | `() => void` | Clear result, error, and return to idle |\n\n## Advanced\n\nReference detail you do not need to get this working.\n\n### Other transports\n\n#### Direct Mode (Server Function + Fetcher)\n\nFor non-streaming usage with TanStack Start server functions:\n\n```typescript ignore\n// lib/server-functions.ts\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\n\nexport const transcribeFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { audio: string; language?: string }) => data)\n  .handler(async ({ data }) => {\n    return generateTranscription({\n      adapter: openaiTranscription('whisper-1'),\n      audio: data.audio,\n      language: data.language,\n    })\n  })\n```\n\n```tsx\nimport { useTranscription } from '@tanstack/ai-react'\nimport { transcribeFn } from '../lib/server-functions'\n\nfunction AudioTranscriber() {\n  const { generate, result, isLoading } = useTranscription({\n    fetcher: (input) => transcribeFn({ data: input }),\n  })\n  // ... same UI as above\n}\n```\n\n#### Server Function Streaming (Fetcher + Response)\n\nFor TanStack Start server functions that stream results. The fetcher receives type-safe input and returns an SSE `Response` — the client parses it automatically:\n\n```typescript ignore\n// lib/server-functions.ts\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateTranscription, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\n\nexport const transcribeStreamFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { audio: string; language?: string }) => data)\n  .handler(({ data }) => {\n    return toServerSentEventsResponse(\n      generateTranscription({\n        adapter: openaiTranscription('whisper-1'),\n        audio: data.audio,\n        language: data.language,\n        stream: true,\n      }),\n    )\n  })\n```\n\n```tsx\nimport { useTranscription } from '@tanstack/ai-react'\nimport { transcribeStreamFn } from '../lib/server-functions'\n\nfunction AudioTranscriber() {\n  const { generate, result, isLoading } = useTranscription({\n    fetcher: (input) => {\n      if (typeof input.audio !== 'string') {\n        throw new Error('Expected base64 or data URL audio')\n      }\n      return transcribeStreamFn({\n        data: { ...input, audio: input.audio },\n      })\n    },\n  })\n  // ... same UI as above\n}\n```\n\n### Model Options\n\n#### OpenAI Model Options\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { audioFile } from './audio'\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: audioFile,\n  responseFormat: 'verbose_json', // Top-level: detailed output with timestamps\n  prompt: 'Technical terms: API, SDK, CLI', // Top-level: guide transcription\n  modelOptions: {\n    temperature: 0, // Lower = more deterministic (provider option)\n    timestamp_granularities: ['word', 'segment'],\n  },\n})\n```\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `temperature` | `number` | Sampling temperature (0 to 1) |\n| `timestamp_granularities` | `Array<'word' \\| 'segment'>` | Timestamp granularity to populate (`whisper-1` only; requires top-level `responseFormat: 'verbose_json'`) |\n| `include` | `string[]` | Additional values to include in the response (e.g., `logprobs`) |\n| `response_format` | `'json' \\| 'text' \\| 'srt' \\| 'verbose_json' \\| 'vtt' \\| 'diarized_json'` | Raw OpenAI response format. Use `diarized_json` here for speaker-labeled diarization output. |\n| `chunking_strategy` | `'auto' \\| { type: 'server_vad', ... } \\| null` | Audio chunking strategy (any model; unset transcribes the audio as a single block). Required by OpenAI for `gpt-4o-transcribe-diarize` inputs longer than 30 seconds — the adapter defaults it to `'auto'` for that model |\n| `known_speaker_names` | `string[]` | Up to four speaker labels for diarization |\n| `known_speaker_references` | `string[]` | 2-10 second data URL audio samples matching `known_speaker_names` |\n\n> `responseFormat` and `prompt` are **top-level** options on `generateTranscription`, not `modelOptions` keys.\n\n#### Response Formats\n\n| Format | Description |\n|--------|-------------|\n| `json` | Simple JSON with text |\n| `text` | Plain text only |\n| `srt` | SubRip subtitle format |\n| `verbose_json` | Detailed JSON with timestamps and segments |\n| `vtt` | WebVTT subtitle format |\n\nOpenAI's `gpt-4o-transcribe-diarize` also supports `modelOptions.response_format: 'diarized_json'` for speaker-labeled segments.\n\n#### Speaker Diarization\n\nUse `gpt-4o-transcribe-diarize` when you need speaker labels. When no response format is specified, TanStack AI defaults the request to `response_format: 'diarized_json'` and sends `chunking_strategy: 'auto'` unless you provide a chunking strategy yourself. Passing a top-level `responseFormat: 'json'` or `'text'` opts out of speaker segments.\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { meetingAudioFile } from './audio'\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('gpt-4o-transcribe-diarize'),\n  audio: meetingAudioFile,\n  modelOptions: {\n    known_speaker_names: ['agent', 'customer'],\n    known_speaker_references: [\n      'data:audio/wav;base64,...',\n      'data:audio/wav;base64,...',\n    ],\n  },\n})\n\nfor (const segment of result.segments ?? []) {\n  console.log(segment.speaker, segment.start, segment.end, segment.text)\n}\n```\n\nTwo constraints the adapter enforces before it calls the API:\n\n- Up to four known speaker references. `known_speaker_names` and `known_speaker_references` must be provided together, with matching lengths.\n- The diarization model does not support `prompt`, `include`, or `timestamp_granularities`. Those combinations are rejected.\n\n### Response Format\n\nThe transcription result includes:\n\n```typescript\ninterface TranscriptionResult {\n  id: string           // Unique identifier\n  model: string        // Model used\n  text: string         // Full transcribed text\n  language?: string    // Detected/specified language\n  duration?: number    // Audio duration in seconds\n  segments?: Array<{   // Timestamped segments\n    id: number         // Segment identifier\n    start: number      // Start time in seconds\n    end: number        // End time in seconds\n    text: string       // Segment text\n    confidence?: number // Confidence score (0-1), if available\n    speaker?: string    // Speaker identifier, if diarization is enabled\n  }>\n  words?: Array<{      // Word-level timestamps (top-level)\n    word: string\n    start: number\n    end: number\n  }>\n}\n```\n\n### Model Availability\n\n#### OpenAI Models\n\n| Model | Description | Use Case |\n|-------|-------------|----------|\n| `whisper-1` | Whisper large-v2 | General transcription |\n| `gpt-4o-transcribe` | GPT-4o-based transcription | Higher accuracy |\n| `gpt-4o-transcribe-diarize` | With speaker diarization | Multi-speaker audio |\n| `gpt-4o-mini-transcribe` | Faster, lighter model | Cost-effective |\n\n#### Supported Audio Formats\n\nOpenAI supports these audio formats:\n\n- `mp3` - MPEG Audio Layer 3\n- `mp4` - MPEG-4 Audio\n- `mpeg` - MPEG Audio\n- `mpga` - MPEG Audio\n- `m4a` - MPEG-4 Audio\n- `wav` - Waveform Audio\n- `webm` - WebM Audio\n- `flac` - Free Lossless Audio Codec\n- `ogg` - Ogg Vorbis\n\n> **Note:** Maximum file size is 25 MB.\n\n### Error Handling\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { audioFile } from './audio'\n\ntry {\n  const result = await generateTranscription({\n    adapter: openaiTranscription('whisper-1'),\n    audio: audioFile,\n  })\n} catch (error) {\n  if (error instanceof Error) {\n    if (error.message.includes('Invalid file format')) {\n      console.error('Unsupported audio format')\n    } else if (error.message.includes('File too large')) {\n      console.error('Audio file exceeds 25 MB limit')\n    } else if (error.message.includes('Audio file is too short')) {\n      console.error('Audio must be at least 0.1 seconds')\n    } else {\n      console.error('Transcription error:', error.message)\n    }\n  }\n}\n```\n\n> **Debugging:** When a transcription returns garbage, empty segments, or the provider rejects your audio format, pass `debug: true` on `generateTranscription({...})` to log the outgoing request and every raw provider chunk. See [Debug Logging](../advanced/debug-logging).\n\n### Environment Variables\n\nThe transcription adapter uses:\n\n- `OPENAI_API_KEY`: Your OpenAI API key\n- `BYTEPLUS_VOICE_API_KEY`: Your BytePlus Seed Speech key (not the ModelArk key)\n\n### Explicit API Keys\n\n```typescript\nimport { createOpenaiTranscription } from '@tanstack/ai-openai'\n\nconst adapter = createOpenaiTranscription('whisper-1', 'your-openai-api-key')\n```\n\n### Best Practices\n\n1. **Audio Quality**: Better audio quality leads to more accurate transcriptions. Reduce background noise when possible.\n\n2. **Language Specification**: Always specify the language if known—this improves accuracy and speed.\n\n3. **File Size**: Keep audio files under 25 MB. For longer recordings, split into chunks.\n\n4. **Format Selection**: MP3 offers a good balance of quality and size. Use WAV or FLAC for highest quality.\n\n5. **Prompting**: Use the `prompt` option to provide context or expected vocabulary (e.g., technical terms, names).\n\n6. **Timestamps**: Request `responseFormat: 'verbose_json'` and set `modelOptions.timestamp_granularities` when you need timing information for captions or synchronization.\n\n7. **Diarization**: Use `gpt-4o-transcribe-diarize` with `modelOptions.response_format: 'diarized_json'` output for multi-speaker audio. Keep `chunking_strategy: 'auto'` unless you need custom VAD tuning.\n","originalRawMarkdown":"---\ntitle: Transcription\nid: transcription\norder: 4\ndescription: \"Transcribe audio to text with OpenAI Whisper and GPT-4o transcription models (including speaker diarization), Groq Whisper, BytePlus Seed Speech, and fal.ai STT models via TanStack AI's generateTranscription() API.\"\nkeywords:\n  - tanstack ai\n  - transcription\n  - speech-to-text\n  - asr\n  - whisper\n  - generateTranscription\n  - openai\n  - groq\n  - fal\n---\n\nTanStack AI provides support for audio transcription (speech-to-text) through dedicated transcription adapters. This guide covers how to convert spoken audio into text using OpenAI's Whisper and GPT-4o transcription models, Groq's hosted Whisper models, and fal.ai STT models.\n\n## Overview\n\nAudio transcription is handled by transcription adapters that follow the same tree-shakeable architecture as other adapters in TanStack AI.\n\nCurrently supported:\n- **OpenAI**: Whisper-1, GPT-4o-transcribe, GPT-4o-mini-transcribe, GPT-4o-transcribe-diarize\n- **Groq**: whisper-large-v3-turbo, whisper-large-v3\n- **BytePlus**: Seed Speech ASR (`seed-asr`)\n- **fal.ai**: Whisper, Wizper, speech-to-text turbo, ElevenLabs speech-to-text\n\n## Basic Usage\n\n### OpenAI Transcription\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { audioBuffer } from './audio'\n\n// Transcribe audio from a file (the adapter uses OPENAI_API_KEY from environment)\nconst audioFile = new File([audioBuffer], 'audio.mp3', { type: 'audio/mpeg' })\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: audioFile,\n  language: 'en',\n})\n\nconsole.log(result.text) // The transcribed text\n```\n\n### Using Base64 Audio\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { readFile } from 'fs/promises'\n\n// Read audio file as base64\nconst audioBuffer = await readFile('recording.mp3')\nconst base64Audio = audioBuffer.toString('base64')\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: base64Audio,\n})\n\nconsole.log(result.text)\n```\n\n### Using Data URLs\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { base64AudioData } from './audio'\n\nconst dataUrl = `data:audio/mpeg;base64,${base64AudioData}`\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: dataUrl,\n})\n```\n\n### Groq Transcription\n\nGroq hosts Whisper large-v3 and large-v3-turbo on its fast inference stack. The `audio` input accepts a `File`, `Blob`, `ArrayBuffer`, base64 string, data URL, or an `https://` URL (which is forwarded to Groq without re-uploading).\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { groqTranscription } from '@tanstack/ai-groq'\n\nconst result = await generateTranscription({\n  adapter: groqTranscription('whisper-large-v3-turbo'),\n  audio: 'https://example.com/recording.mp3',\n  language: 'en',\n})\n\nconsole.log(result.text)\nconsole.log(result.language)\n\n// verbose_json is the default — segments carry segment-level start/end timestamps\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.start}s → ${segment.end}s] ${segment.text}`)\n}\n```\n\n> **Note:** Groq supports `responseFormat` values `json`, `text`, and `verbose_json` (default). `srt` and `vtt` are not supported — passing them throws. Provider-specific `modelOptions` are `temperature` and `timestamp_granularities` (`['word']`, `['segment']`, or both).\n\n### BytePlus Transcription\n\nBytePlus Seed Speech ASR is synchronous — audio in, transcript out, no polling. It belongs to the Seed Speech product, so it reads `BYTEPLUS_VOICE_API_KEY` rather than the `ARK_API_KEY` used by the BytePlus chat, image and video adapters. Audio can be a `File`, base64, a data URL or a public URL, up to two hours and 100 MB.\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { byteplusTranscription } from '@tanstack/ai-byteplus'\n\nconst result = await generateTranscription({\n  adapter: byteplusTranscription('seed-asr'),\n  audio: 'https://example.com/recording.mp3',\n  language: 'en',\n  modelOptions: { enable_punc: true, enable_speaker_info: true },\n})\n\nconsole.log(result.text)\n\n// Speaker labels land on the segment when enable_speaker_info is set\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.speaker ?? 'unknown'}] ${segment.text}`)\n}\n```\n\n> **Note:** Provider-specific `modelOptions` are `enable_itn` (spoken numbers and dates as digits), `enable_punc` (punctuation), `enable_ddc` (drop fillers and stutters), `enable_speaker_info` (speaker labels) and `show_utterances` (per-utterance breakdown, on by default).\n\n### fal.ai Transcription\n\nfal.ai offers Whisper, Wizper, and other STT models. The `audio` input accepts a URL, `File`, `Blob`, or `ArrayBuffer` (auto-wrapped in a `Blob`).\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { falTranscription } from '@tanstack/ai-fal'\n\nconst result = await generateTranscription({\n  adapter: falTranscription('fal-ai/whisper'),\n  audio: 'https://example.com/recording.mp3',\n  language: 'en',\n})\n\nconsole.log(result.text)\nconsole.log(result.language)\n\n// Models that return word/chunk timestamps populate result.segments\nfor (const segment of result.segments ?? []) {\n  console.log(`[${segment.start}s → ${segment.end}s] ${segment.text}`)\n}\n```\n\n## Options\n\n### Common Options\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `audio` | `File \\| string` | Audio data (File object or base64 string) - required |\n| `language` | `string` | Language code (e.g., \"en\", \"es\", \"fr\") |\n| `prompt` | `string` | Optional prompt to guide transcription style or terms. Not supported with `gpt-4o-transcribe-diarize`. |\n| `responseFormat` | `'json' \\| 'text' \\| 'srt' \\| 'verbose_json' \\| 'vtt'` | Common output format |\n\n### Supported Languages\n\nWhisper supports many languages. Common codes include:\n\n| Code | Language |\n|------|----------|\n| `en` | English |\n| `es` | Spanish |\n| `fr` | French |\n| `de` | German |\n| `it` | Italian |\n| `pt` | Portuguese |\n| `ja` | Japanese |\n| `ko` | Korean |\n| `zh` | Chinese |\n| `ru` | Russian |\n\n> **Tip:** Providing the correct language code improves accuracy and reduces latency.\n\n## Complete Example\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { readFile } from 'fs/promises'\n\nasync function transcribeAudio(filepath: string) {\n  // Read the audio file\n  const audioBuffer = await readFile(filepath)\n  const audioFile = new File(\n    [audioBuffer], \n    filepath.split('/').pop()!, \n    { type: 'audio/mpeg' }\n  )\n\n  // Transcribe with detailed output\n  const result = await generateTranscription({\n    adapter: openaiTranscription('whisper-1'),\n    audio: audioFile,\n    language: 'en',\n    responseFormat: 'verbose_json',\n    modelOptions: {\n      timestamp_granularities: ['segment', 'word'],\n    },\n  })\n\n  console.log('Full text:', result.text)\n  console.log('Duration:', result.duration, 'seconds')\n  \n  // Print segments with timestamps\n  if (result.segments) {\n    for (const segment of result.segments) {\n      console.log(`[${segment.start.toFixed(2)}s - ${segment.end.toFixed(2)}s]: ${segment.text}`)\n    }\n  }\n\n  return result\n}\n\n// Usage\nawait transcribeAudio('./meeting-recording.mp3')\n```\n\n## Browser Usage\n\n### Recording and Transcribing\n\n```typescript\nasync function recordAndTranscribe() {\n  // Request microphone access\n  const stream = await navigator.mediaDevices.getUserMedia({ audio: true })\n  const mediaRecorder = new MediaRecorder(stream)\n  const chunks: Blob[] = []\n\n  mediaRecorder.ondataavailable = (e) => chunks.push(e.data)\n  \n  mediaRecorder.onstop = async () => {\n    const audioBlob = new Blob(chunks, { type: 'audio/webm' })\n    const audioFile = new File([audioBlob], 'recording.webm', { type: 'audio/webm' })\n    \n    // Send to your API endpoint for transcription\n    const formData = new FormData()\n    formData.append('audio', audioFile)\n    \n    const response = await fetch('/api/transcribe', {\n      method: 'POST',\n      body: formData,\n    })\n    \n    const result = await response.json()\n    console.log('Transcription:', result.text)\n  }\n\n  // Start recording\n  mediaRecorder.start()\n  \n  // Stop after 10 seconds\n  setTimeout(() => mediaRecorder.stop(), 10000)\n}\n```\n\n### Server API Endpoint\n\n```typescript ignore\n// api/transcribe.ts\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const formData = await request.formData()\n  const audioFile = formData.get('audio')\n  if (!(audioFile instanceof File)) {\n    throw new Error('Expected an audio file under \"audio\"')\n  }\n\n  const result = await generateTranscription({\n    adapter: openaiTranscription('whisper-1'),\n    audio: audioFile,\n  })\n\n  return Response.json(result)\n}\n```\n\n## Full-Stack Usage\n\nTanStack AI provides React hooks and server-side streaming helpers to build full-stack audio transcription with minimal boilerplate.\n\n> **Note:** Transcribing a big file can run long — keep its status and result\n> across a reload or a dropped connection with\n> [Generation Persistence](../persistence/generation-persistence).\n\n### Streaming Mode (Server Route + Client Hook)\n\n**Server** — Create an API route that wraps `generateTranscription` as a streaming response:\n\n```typescript ignore\n// routes/api/transcribe.ts\nimport {\n  generateTranscription,\n  toServerSentEventsResponse,\n} from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/api/transcribe')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n        const { audio, language, model } = body.data\n\n        const stream = generateTranscription({\n          adapter: openaiTranscription(model ?? 'whisper-1'),\n          audio,\n          language,\n          stream: true,\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n> **Note:** For browser-recorded audio, you'll typically send the audio as a base64 string in the JSON body. For file uploads, use a FormData-based endpoint instead (see [Browser Usage](#browser-usage) above).\n\n**Client** — Use the `useTranscription` hook with a connection adapter:\n\n```tsx\nimport { useTranscription, fetchServerSentEvents } from '@tanstack/ai-react'\n\nfunction AudioTranscriber() {\n  const { generate, result, isLoading, error } = useTranscription({\n    connection: fetchServerSentEvents('/api/transcribe'),\n  })\n\n  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0]\n    if (!file) return\n\n    // Convert to base64 for JSON transport\n    const buffer = await file.arrayBuffer()\n    const base64 = btoa(\n      new Uint8Array(buffer).reduce((s, b) => s + String.fromCharCode(b), ''),\n    )\n    const dataUrl = `data:${file.type};base64,${base64}`\n\n    await generate({ audio: dataUrl, language: 'en' })\n  }\n\n  return (\n    <div>\n      <input type=\"file\" accept=\"audio/*\" onChange={handleFileUpload} />\n      {isLoading && <p>Transcribing...</p>}\n      {error && <p>Error: {error.message}</p>}\n      {result && (\n        <div>\n          <p>{result.text}</p>\n          {result.duration && <p>Duration: {result.duration}s</p>}\n        </div>\n      )}\n    </div>\n  )\n}\n```\n\nThe other two transports (a server function returning JSON, or one returning an\nSSE `Response`) work the same way here. They are in\n[Advanced: other transports](#other-transports), and explained once in\n[Generations](./generations#transports-in-full).\n\n### Hook API\n\nThe `useTranscription` hook accepts:\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `connection` | `ConnectionAdapter` | Streaming transport (SSE, HTTP stream, custom) |\n| `fetcher` | `(input) => Promise<TranscriptionResult \\| Response>` | Direct async function, or server function returning an SSE `Response` |\n| `onResult` | `(result) => TOutput \\| null \\| void` | Callback when transcription completes. Optionally return a transformed value to store as `result` |\n| `onError` | `(error) => void` | Callback on error |\n| `onProgress` | `(progress, message?) => void` | Progress updates (0-100) |\n\nAnd returns:\n\n| Property | Type | Description |\n|----------|------|-------------|\n| `generate` | `(input: TranscriptionGenerateInput) => Promise<void>` | Trigger transcription |\n| `result` | `TranscriptionResult \\| null` | The result with text and segments, or null |\n| `isLoading` | `boolean` | Whether transcription is in progress |\n| `error` | `Error \\| undefined` | Current error, if any |\n| `status` | `GenerationClientState` | `'idle'` \\| `'generating'` \\| `'success'` \\| `'error'` |\n| `stop` | `() => void` | Abort the current transcription |\n| `reset` | `() => void` | Clear result, error, and return to idle |\n\n## Advanced\n\nReference detail you do not need to get this working.\n\n### Other transports\n\n#### Direct Mode (Server Function + Fetcher)\n\nFor non-streaming usage with TanStack Start server functions:\n\n```typescript ignore\n// lib/server-functions.ts\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\n\nexport const transcribeFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { audio: string; language?: string }) => data)\n  .handler(async ({ data }) => {\n    return generateTranscription({\n      adapter: openaiTranscription('whisper-1'),\n      audio: data.audio,\n      language: data.language,\n    })\n  })\n```\n\n```tsx\nimport { useTranscription } from '@tanstack/ai-react'\nimport { transcribeFn } from '../lib/server-functions'\n\nfunction AudioTranscriber() {\n  const { generate, result, isLoading } = useTranscription({\n    fetcher: (input) => transcribeFn({ data: input }),\n  })\n  // ... same UI as above\n}\n```\n\n#### Server Function Streaming (Fetcher + Response)\n\nFor TanStack Start server functions that stream results. The fetcher receives type-safe input and returns an SSE `Response` — the client parses it automatically:\n\n```typescript ignore\n// lib/server-functions.ts\nimport { createServerFn } from '@tanstack/react-start'\nimport { generateTranscription, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\n\nexport const transcribeStreamFn = createServerFn({ method: 'POST' })\n  .inputValidator((data: { audio: string; language?: string }) => data)\n  .handler(({ data }) => {\n    return toServerSentEventsResponse(\n      generateTranscription({\n        adapter: openaiTranscription('whisper-1'),\n        audio: data.audio,\n        language: data.language,\n        stream: true,\n      }),\n    )\n  })\n```\n\n```tsx\nimport { useTranscription } from '@tanstack/ai-react'\nimport { transcribeStreamFn } from '../lib/server-functions'\n\nfunction AudioTranscriber() {\n  const { generate, result, isLoading } = useTranscription({\n    fetcher: (input) => {\n      if (typeof input.audio !== 'string') {\n        throw new Error('Expected base64 or data URL audio')\n      }\n      return transcribeStreamFn({\n        data: { ...input, audio: input.audio },\n      })\n    },\n  })\n  // ... same UI as above\n}\n```\n\n### Model Options\n\n#### OpenAI Model Options\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { audioFile } from './audio'\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('whisper-1'),\n  audio: audioFile,\n  responseFormat: 'verbose_json', // Top-level: detailed output with timestamps\n  prompt: 'Technical terms: API, SDK, CLI', // Top-level: guide transcription\n  modelOptions: {\n    temperature: 0, // Lower = more deterministic (provider option)\n    timestamp_granularities: ['word', 'segment'],\n  },\n})\n```\n\n| Option | Type | Description |\n|--------|------|-------------|\n| `temperature` | `number` | Sampling temperature (0 to 1) |\n| `timestamp_granularities` | `Array<'word' \\| 'segment'>` | Timestamp granularity to populate (`whisper-1` only; requires top-level `responseFormat: 'verbose_json'`) |\n| `include` | `string[]` | Additional values to include in the response (e.g., `logprobs`) |\n| `response_format` | `'json' \\| 'text' \\| 'srt' \\| 'verbose_json' \\| 'vtt' \\| 'diarized_json'` | Raw OpenAI response format. Use `diarized_json` here for speaker-labeled diarization output. |\n| `chunking_strategy` | `'auto' \\| { type: 'server_vad', ... } \\| null` | Audio chunking strategy (any model; unset transcribes the audio as a single block). Required by OpenAI for `gpt-4o-transcribe-diarize` inputs longer than 30 seconds — the adapter defaults it to `'auto'` for that model |\n| `known_speaker_names` | `string[]` | Up to four speaker labels for diarization |\n| `known_speaker_references` | `string[]` | 2-10 second data URL audio samples matching `known_speaker_names` |\n\n> `responseFormat` and `prompt` are **top-level** options on `generateTranscription`, not `modelOptions` keys.\n\n#### Response Formats\n\n| Format | Description |\n|--------|-------------|\n| `json` | Simple JSON with text |\n| `text` | Plain text only |\n| `srt` | SubRip subtitle format |\n| `verbose_json` | Detailed JSON with timestamps and segments |\n| `vtt` | WebVTT subtitle format |\n\nOpenAI's `gpt-4o-transcribe-diarize` also supports `modelOptions.response_format: 'diarized_json'` for speaker-labeled segments.\n\n#### Speaker Diarization\n\nUse `gpt-4o-transcribe-diarize` when you need speaker labels. When no response format is specified, TanStack AI defaults the request to `response_format: 'diarized_json'` and sends `chunking_strategy: 'auto'` unless you provide a chunking strategy yourself. Passing a top-level `responseFormat: 'json'` or `'text'` opts out of speaker segments.\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { meetingAudioFile } from './audio'\n\nconst result = await generateTranscription({\n  adapter: openaiTranscription('gpt-4o-transcribe-diarize'),\n  audio: meetingAudioFile,\n  modelOptions: {\n    known_speaker_names: ['agent', 'customer'],\n    known_speaker_references: [\n      'data:audio/wav;base64,...',\n      'data:audio/wav;base64,...',\n    ],\n  },\n})\n\nfor (const segment of result.segments ?? []) {\n  console.log(segment.speaker, segment.start, segment.end, segment.text)\n}\n```\n\nTwo constraints the adapter enforces before it calls the API:\n\n- Up to four known speaker references. `known_speaker_names` and `known_speaker_references` must be provided together, with matching lengths.\n- The diarization model does not support `prompt`, `include`, or `timestamp_granularities`. Those combinations are rejected.\n\n### Response Format\n\nThe transcription result includes:\n\n```typescript\ninterface TranscriptionResult {\n  id: string           // Unique identifier\n  model: string        // Model used\n  text: string         // Full transcribed text\n  language?: string    // Detected/specified language\n  duration?: number    // Audio duration in seconds\n  segments?: Array<{   // Timestamped segments\n    id: number         // Segment identifier\n    start: number      // Start time in seconds\n    end: number        // End time in seconds\n    text: string       // Segment text\n    confidence?: number // Confidence score (0-1), if available\n    speaker?: string    // Speaker identifier, if diarization is enabled\n  }>\n  words?: Array<{      // Word-level timestamps (top-level)\n    word: string\n    start: number\n    end: number\n  }>\n}\n```\n\n### Model Availability\n\n#### OpenAI Models\n\n| Model | Description | Use Case |\n|-------|-------------|----------|\n| `whisper-1` | Whisper large-v2 | General transcription |\n| `gpt-4o-transcribe` | GPT-4o-based transcription | Higher accuracy |\n| `gpt-4o-transcribe-diarize` | With speaker diarization | Multi-speaker audio |\n| `gpt-4o-mini-transcribe` | Faster, lighter model | Cost-effective |\n\n#### Supported Audio Formats\n\nOpenAI supports these audio formats:\n\n- `mp3` - MPEG Audio Layer 3\n- `mp4` - MPEG-4 Audio\n- `mpeg` - MPEG Audio\n- `mpga` - MPEG Audio\n- `m4a` - MPEG-4 Audio\n- `wav` - Waveform Audio\n- `webm` - WebM Audio\n- `flac` - Free Lossless Audio Codec\n- `ogg` - Ogg Vorbis\n\n> **Note:** Maximum file size is 25 MB.\n\n### Error Handling\n\n```typescript\nimport { generateTranscription } from '@tanstack/ai'\nimport { openaiTranscription } from '@tanstack/ai-openai'\nimport { audioFile } from './audio'\n\ntry {\n  const result = await generateTranscription({\n    adapter: openaiTranscription('whisper-1'),\n    audio: audioFile,\n  })\n} catch (error) {\n  if (error instanceof Error) {\n    if (error.message.includes('Invalid file format')) {\n      console.error('Unsupported audio format')\n    } else if (error.message.includes('File too large')) {\n      console.error('Audio file exceeds 25 MB limit')\n    } else if (error.message.includes('Audio file is too short')) {\n      console.error('Audio must be at least 0.1 seconds')\n    } else {\n      console.error('Transcription error:', error.message)\n    }\n  }\n}\n```\n\n> **Debugging:** When a transcription returns garbage, empty segments, or the provider rejects your audio format, pass `debug: true` on `generateTranscription({...})` to log the outgoing request and every raw provider chunk. See [Debug Logging](../advanced/debug-logging).\n\n### Environment Variables\n\nThe transcription adapter uses:\n\n- `OPENAI_API_KEY`: Your OpenAI API key\n- `BYTEPLUS_VOICE_API_KEY`: Your BytePlus Seed Speech key (not the ModelArk key)\n\n### Explicit API Keys\n\n```typescript\nimport { createOpenaiTranscription } from '@tanstack/ai-openai'\n\nconst adapter = createOpenaiTranscription('whisper-1', 'your-openai-api-key')\n```\n\n### Best Practices\n\n1. **Audio Quality**: Better audio quality leads to more accurate transcriptions. Reduce background noise when possible.\n\n2. **Language Specification**: Always specify the language if known—this improves accuracy and speed.\n\n3. **File Size**: Keep audio files under 25 MB. For longer recordings, split into chunks.\n\n4. **Format Selection**: MP3 offers a good balance of quality and size. Use WAV or FLAC for highest quality.\n\n5. **Prompting**: Use the `prompt` option to provide context or expected vocabulary (e.g., technical terms, names).\n\n6. **Timestamps**: Request `responseFormat: 'verbose_json'` and set `modelOptions.timestamp_granularities` when you need timing information for captions or synchronization.\n\n7. **Diarization**: Use `gpt-4o-transcribe-diarize` with `modelOptions.response_format: 'diarized_json'` output for multi-speaker audio. Keep `chunking_strategy: 'auto'` unless you need custom VAD tuning.\n"}
