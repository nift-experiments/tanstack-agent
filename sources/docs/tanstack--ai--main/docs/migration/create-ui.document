, and "},{"type":"inlineCode","value":"ThinkingPart"},{"type":"text","value":" stay on the subpath until "},{"type":"inlineCode","value":"1.0.0"},{"type":"text","value":". "},{"type":"inlineCode","value":"TextPart"},{"type":"text","value":" markdown plugins did change. See "},{"type":"link","href":"./text-part-markdown","children":[{"type":"text","value":"TextPart markdown"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"useChat"},{"type":"text","value":" is not re-exported from the shim. Import it from "},{"type":"inlineCode","value":"@tanstack/ai-react"},{"type":"text","value":", or the matching framework package."}]},{"type":"heading","depth":2,"id":"why","children":[{"type":"text","value":"Why"}]},{"type":"paragraph","children":[{"type":"text","value":"A separate "},{"type":"inlineCode","value":"*-ui"},{"type":"text","value":" package split chat UI from the framework package. Form uses "},{"type":"inlineCode","value":"createFormHook"},{"type":"text","value":" on "},{"type":"inlineCode","value":"@tanstack/react-form"},{"type":"text","value":". Table uses "},{"type":"inlineCode","value":"createTableHook"},{"type":"text","value":" on "},{"type":"inlineCode","value":"@tanstack/react-table"},{"type":"text","value":". Chat now sits on "},{"type":"inlineCode","value":"@tanstack/ai-react/ui"},{"type":"text","value":" for the same reason."}]},{"type":"heading","depth":2,"id":"minimum-versions","children":[{"type":"text","value":"Minimum versions"}]},{"type":"paragraph","children":[{"type":"text","value":"New imports:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-react"},{"type":"text","value":" (next minor) "},{"type":"inlineCode","value":"/ui"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-solid"},{"type":"text","value":" (next minor) "},{"type":"inlineCode","value":"/ui"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-vue"},{"type":"text","value":" (next minor) "},{"type":"inlineCode","value":"/ui"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-svelte"},{"type":"text","value":" (next minor) "},{"type":"inlineCode","value":"/ui"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-preact"},{"type":"text","value":" (next minor) "},{"type":"inlineCode","value":"/ui"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-octane"},{"type":"text","value":" (next minor) "},{"type":"inlineCode","value":"/ui"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-angular"},{"type":"text","value":" (next minor) "},{"type":"inlineCode","value":"/ui"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-remix"},{"type":"text","value":" (next minor) "},{"type":"inlineCode","value":"/ui"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Deprecated re-exports, removed in "},{"type":"inlineCode","value":"1.0.0"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-react-ui"},{"type":"text","value":" 0.9.0"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-solid-ui"},{"type":"text","value":" 0.8.0"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/ai-vue-ui"},{"type":"text","value":" 0.3.0"}]}]}]},{"type":"heading","depth":2,"id":"coexistence","children":[{"type":"text","value":"Coexistence"}]},{"type":"paragraph","children":[{"type":"text","value":"Old "},{"type":"inlineCode","value":"*-ui"},{"type":"text","value":" packages and new "},{"type":"inlineCode","value":"/ui"},{"type":"text","value":" imports can live in the same app until "},{"type":"inlineCode","value":"1.0.0"},{"type":"text","value":". Do not mix them in one chat tree."}]},{"type":"heading","depth":2,"id":"typed-chat-ui","children":[{"type":"text","value":"Typed chat UI"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"/ui"},{"type":"text","value":" subpath also exports "},{"type":"inlineCode","value":"createChatHook"},{"type":"text","value":", a typed headless chat UI that derives tool, part, and interrupt components from your chat options. It is new, not a replacement you need to move to. The components above keep working. See the "},{"type":"link","href":"../ui/react","children":[{"type":"text","value":"React UI guide"}]},{"type":"text","value":" for how it fits together, and "},{"type":"link","href":"../ui/solid","children":[{"type":"text","value":"Solid"}]},{"type":"text","value":", "},{"type":"link","href":"../ui/vue","children":[{"type":"text","value":"Vue"}]},{"type":"text","value":", "},{"type":"link","href":"../ui/svelte","children":[{"type":"text","value":"Svelte"}]},{"type":"text","value":", "},{"type":"link","href":"../ui/preact","children":[{"type":"text","value":"Preact"}]},{"type":"text","value":", "},{"type":"link","href":"../ui/octane","children":[{"type":"text","value":"Octane"}]},{"type":"text","value":", "},{"type":"link","href":"../ui/remix","children":[{"type":"text","value":"Remix"}]},{"type":"text","value":", or "},{"type":"link","href":"../ui/angular","children":[{"type":"text","value":"Angular"}]},{"type":"text","value":" for the other adapters."}]}],"headings":[{"id":"why","text":"Why","level":2},{"id":"minimum-versions","text":"Minimum versions","level":2},{"id":"coexistence","text":"Coexistence","level":2},{"id":"typed-chat-ui","text":"Typed chat UI","level":2}]},"frameworks":[],"downloadMarkdown":"\nChange your import from `@tanstack/ai-react-ui` to `@tanstack/ai-react/ui`. The same move applies to Solid and Vue.\n\n> **Deprecated.** `@tanstack/ai-react-ui`, `@tanstack/ai-solid-ui`, and `@tanstack/ai-vue-ui` re-export the new `/ui` subpath until each package's `1.0.0`. `npm install` prints a warning. Import from `/ui` in new code. Svelte never published a `*-ui` package. Use `@tanstack/ai-svelte/ui`.\n\n```diff\n- import { Chat, ChatMessages, ChatInput } from '@tanstack/ai-react-ui'\n+ import { Chat, ChatMessages, ChatInput } from '@tanstack/ai-react/ui'\n```\n\nNothing else changes for the package move. `Chat`, `ChatMessages`, `ChatMessage`, `ChatInput`, `ToolApproval`, `TextPart`, and `ThinkingPart` stay on the subpath until `1.0.0`. `TextPart` markdown plugins did change. See [TextPart markdown](./text-part-markdown).\n\n`useChat` is not re-exported from the shim. Import it from `@tanstack/ai-react`, or the matching framework package.\n\n## Why\n\nA separate `*-ui` package split chat UI from the framework package. Form uses `createFormHook` on `@tanstack/react-form`. Table uses `createTableHook` on `@tanstack/react-table`. Chat now sits on `@tanstack/ai-react/ui` for the same reason.\n\n## Minimum versions\n\nNew imports:\n\n- `@tanstack/ai-react` (next minor) `/ui`\n- `@tanstack/ai-solid` (next minor) `/ui`\n- `@tanstack/ai-vue` (next minor) `/ui`\n- `@tanstack/ai-svelte` (next minor) `/ui`\n- `@tanstack/ai-preact` (next minor) `/ui`\n- `@tanstack/ai-octane` (next minor) `/ui`\n- `@tanstack/ai-angular` (next minor) `/ui`\n- `@tanstack/ai-remix` (next minor) `/ui`\n\nDeprecated re-exports, removed in `1.0.0`:\n\n- `@tanstack/ai-react-ui` 0.9.0\n- `@tanstack/ai-solid-ui` 0.8.0\n- `@tanstack/ai-vue-ui` 0.3.0\n\n## Coexistence\n\nOld `*-ui` packages and new `/ui` imports can live in the same app until `1.0.0`. Do not mix them in one chat tree.\n\n## Typed chat UI\n\nThe `/ui` subpath also exports `createChatHook`, a typed headless chat UI that derives tool, part, and interrupt components from your chat options. It is new, not a replacement you need to move to. The components above keep working. See the [React UI guide](../ui/react) for how it fits together, and [Solid](../ui/solid), [Vue](../ui/vue), [Svelte](../ui/svelte), [Preact](../ui/preact), [Octane](../ui/octane), [Remix](../ui/remix), or [Angular](../ui/angular) for the other adapters.\n","originalRawMarkdown":"---\ntitle: Chat UI packages\nid: migrate-create-ui\norder: 5\ndescription: \"Move from @tanstack/ai-*-ui to the framework /ui subpath.\"\nkeywords:\n  - tanstack ai\n  - migration\n  - deprecation\n---\n\nChange your import from `@tanstack/ai-react-ui` to `@tanstack/ai-react/ui`. The same move applies to Solid and Vue.\n\n> **Deprecated.** `@tanstack/ai-react-ui`, `@tanstack/ai-solid-ui`, and `@tanstack/ai-vue-ui` re-export the new `/ui` subpath until each package's `1.0.0`. `npm install` prints a warning. Import from `/ui` in new code. Svelte never published a `*-ui` package. Use `@tanstack/ai-svelte/ui`.\n\n```diff\n- import { Chat, ChatMessages, ChatInput } from '@tanstack/ai-react-ui'\n+ import { Chat, ChatMessages, ChatInput } from '@tanstack/ai-react/ui'\n```\n\nNothing else changes for the package move. `Chat`, `ChatMessages`, `ChatMessage`, `ChatInput`, `ToolApproval`, `TextPart`, and `ThinkingPart` stay on the subpath until `1.0.0`. `TextPart` markdown plugins did change. See [TextPart markdown](./text-part-markdown).\n\n`useChat` is not re-exported from the shim. Import it from `@tanstack/ai-react`, or the matching framework package.\n\n## Why\n\nA separate `*-ui` package split chat UI from the framework package. Form uses `createFormHook` on `@tanstack/react-form`. Table uses `createTableHook` on `@tanstack/react-table`. Chat now sits on `@tanstack/ai-react/ui` for the same reason.\n\n## Minimum versions\n\nNew imports:\n\n- `@tanstack/ai-react` (next minor) `/ui`\n- `@tanstack/ai-solid` (next minor) `/ui`\n- `@tanstack/ai-vue` (next minor) `/ui`\n- `@tanstack/ai-svelte` (next minor) `/ui`\n- `@tanstack/ai-preact` (next minor) `/ui`\n- `@tanstack/ai-octane` (next minor) `/ui`\n- `@tanstack/ai-angular` (next minor) `/ui`\n- `@tanstack/ai-remix` (next minor) `/ui`\n\nDeprecated re-exports, removed in `1.0.0`:\n\n- `@tanstack/ai-react-ui` 0.9.0\n- `@tanstack/ai-solid-ui` 0.8.0\n- `@tanstack/ai-vue-ui` 0.3.0\n\n## Coexistence\n\nOld `*-ui` packages and new `/ui` imports can live in the same app until `1.0.0`. Do not mix them in one chat tree.\n\n## Typed chat UI\n\nThe `/ui` subpath also exports `createChatHook`, a typed headless chat UI that derives tool, part, and interrupt components from your chat options. It is new, not a replacement you need to move to. The components above keep working. See the [React UI guide](../ui/react) for how it fits together, and [Solid](../ui/solid), [Vue](../ui/vue), [Svelte](../ui/svelte), [Preact](../ui/preact), [Octane](../ui/octane), [Remix](../ui/remix), or [Angular](../ui/angular) for the other adapters.\n"}
