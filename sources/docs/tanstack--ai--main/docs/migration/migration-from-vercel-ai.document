unctions"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"model"},{"type":"text","value":" parameter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"adapter"},{"type":"text","value":" parameter"}]},{"type":"tableCell","children":[{"type":"text","value":"Model baked into adapter"}]}]]},{"type":"heading","depth":3,"id":"full-streamtext-chat-option-mapping","children":[{"type":"text","value":"Full "},{"type":"inlineCode","value":"streamText"},{"type":"text","value":" → "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" Option Mapping"}]},{"type":"paragraph","children":[{"type":"text","value":"Options accepted by "},{"type":"inlineCode","value":"streamText"},{"type":"text","value":" as of AI SDK v6, and where each lives in TanStack AI's "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":". Options that exist on both sides keep the same semantics unless noted."}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"inlineCode","value":"streamText"},{"type":"text","value":" option"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"chat()"},{"type":"text","value":" equivalent"}]},{"type":"tableCell","children":[{"type":"text","value":"Notes"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"model: openai('gpt-4o')"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"adapter: openaiText('gpt-4o')"}]},{"type":"tableCell","children":[{"type":"text","value":"Activity-specific adapters"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"prompt: 'Hello'"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"messages: [{ role: 'user', content: 'Hello' }]"}]},{"type":"tableCell","children":[{"type":"text","value":"TanStack is messages-only"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"messages"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"messages"}]},{"ty