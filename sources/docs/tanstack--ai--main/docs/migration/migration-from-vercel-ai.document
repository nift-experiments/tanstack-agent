{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"This guide helps you migrate from the Vercel AI SDK ("},{"type":"inlineCode","value":"ai"},{"type":"text","value":" + "},{"type":"inlineCode","value":"@ai-sdk/*"},{"type":"text","value":") to TanStack AI. Both libraries cover the same problem space — LLM calls, streaming, tool use, structured output, framework hooks — but TanStack AI uses a different architecture with enhanced type safety, tree-shakeable adapters, an isomorphic tool system, and a first-class middleware pipeline."}]},{"type":"paragraph","children":[{"type":"text","value":"The \"Before\" examples target "},{"type":"strong","children":[{"type":"text","value":"AI SDK v5 and v6"}]},{"type":"text","value":". Older v4 naming is called out inline where it differs."}]},{"type":"heading","depth":2,"id":"why-migrate","children":[{"type":"text","value":"Why Migrate?"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI provides several advantages:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Tree-shakeable adapters"}]},{"type":"text","value":" - Import only what you need, reducing bundle size"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Isomorphic tools"}]},{"type":"text","value":" - Define tools once, implement for server and client separately"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Per-model type safety"}]},{"type":"text","value":" - TypeScript knows exact options available for each model"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Framework agnostic"}]},{"type":"text","value":" - Works with React, Vue, Solid, Svelte, and vanilla JS"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Full streaming type safety"}]},{"type":"text","value":" - Typed stream chunks and message parts"}]}]}]},{"type":"heading","depth":2,"id":"quick-reference","children":[{"type":"text","value":"Quick Reference"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Vercel AI SDK"}]},{"type":"tableCell","children":[{"type":"text","value":"TanStack AI"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"ai"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/ai"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@ai-sdk/openai"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/ai-openai"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@ai-sdk/anthropic"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/ai-anthropic"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@ai-sdk/google"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/ai-gemini"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@ai-sdk/google-vertex"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/ai-vertex"},{"type":"text","value":" (Gemini), "},{"type":"inlineCode","value":"@tanstack/ai-anthropic/vertex"},{"type":"text","value":" (Claude), "},{"type":"inlineCode","value":"@tanstack/ai-grok/vertex"},{"type":"text","value":" (Grok), and "},{"type":"inlineCode","value":"@tanstack/ai-mistral/vertex"},{"type":"text","value":" (Mistral)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@ai-sdk/react"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/ai-react"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@ai-sdk/vue"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/ai-vue"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@ai-sdk/solid"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/ai-solid"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@ai-sdk/svelte"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/ai-svelte"}]}]]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" Since AI SDK v5, framework hooks moved from "},{"type":"inlineCode","value":"ai/react"},{"type":"text","value":" (v4) to dedicated packages like "},{"type":"inlineCode","value":"@ai-sdk/react"},{"type":"text","value":". If you are on v4, swap the old subpaths for their v5 equivalents."}]}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"heading","depth":3,"id":"before-vercel-ai-sdk","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"ai\",\"@ai-sdk/react\",\"@ai-sdk/openai\",\"@ai-sdk/anthropic\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":3,"id":"after-tanstack-ai","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/ai\",\"@tanstack/ai-react\",\"@tanstack/ai-openai\",\"@tanstack/ai-anthropic\"]],\"vue\":[[\"@tanstack/ai\",\"@tanstack/ai-vue\",\"@tanstack/ai-openai\",\"@tanstack/ai-anthropic\"]],\"solid\":[[\"@tanstack/ai\",\"@tanstack/ai-solid\",\"@tanstack/ai-openai\",\"@tanstack/ai-anthropic\"]],\"svelte\":[[\"@tanstack/ai\",\"@tanstack/ai-svelte\",\"@tanstack/ai-openai\",\"@tanstack/ai-anthropic\"]],\"preact\":[[\"@tanstack/ai\",\"@tanstack/ai-preact\",\"@tanstack/ai-openai\",\"@tanstack/ai-anthropic\"]],\"angular\":[[\"@tanstack/ai\",\"@tanstack/ai-angular\",\"@tanstack/ai-openai\",\"@tanstack/ai-anthropic\"]],\"vanilla\":[[\"@tanstack/ai\",\"@tanstack/ai-client\",\"@tanstack/ai-openai\",\"@tanstack/ai-anthropic\"]],\"octane\":[[\"@tanstack/ai\",\"@tanstack/ai-octane\",\"@tanstack/ai-openai\",\"@tanstack/ai-anthropic\",\"octane\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"server-side-migration","children":[{"type":"text","value":"Server-Side Migration"}]},{"type":"heading","depth":3,"id":"basic-text-generation","children":[{"type":"text","value":"Basic Text Generation"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-2","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"import { streamText, convertToModelMessages } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const result = streamText({\n    model: openai('gpt-4o'),\n    messages: await convertToModelMessages(messages),\n  })\n\n  return result.toUIMessageStreamResponse()\n  // (v4: result.toDataStreamResponse())\n}","lang":"typescript"},{"type":"heading","depth":4,"id":"after-tanstack-ai-2","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n  })\n\n  return toServerSentEventsResponse(stream)\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"key-differences","children":[{"type":"text","value":"Key Differences"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","