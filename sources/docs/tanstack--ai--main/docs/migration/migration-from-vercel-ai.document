/ "},{"type":"inlineCode","value":"onUsage"}]},{"type":"tableCell","children":[{"type":"text","value":"Split into finer-grained hooks"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFinish"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"middleware.onFinish"}]},{"type":"tableCell","children":[{"type":"text","value":"Terminal hook"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onAbort"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"middleware.onAbort"}]},{"type":"tableCell","children":[{"type":"text","value":"Terminal hook"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"output: Output.object({ schema })"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"outputSchema"}]},{"type":"tableCell","children":[{"type":"text","value":"See "},{"type":"link","href":"#structured-output","children":[{"type":"text","value":"Structured Output"}]}]}],[{"type":"tableCell","children":[{"type":"text","value":"—"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"conversationId"},{"type":"text","value":" / "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":" / "},{"type":"inlineCode","value":"runId"}]},{"type":"tableCell","children":[{"type":"text","value":"TanStack-only, for correlating requests across your system and AG-UI"}]}]]},{"type":"heading","depth":3,"id":"streamtext-result-tanstack-ai-equivalents","children":[{"type":"inlineCode","value":"streamText"},{"type":"text","value":" result → TanStack AI equivalents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"streamText"},{"type":"text","value":" returns an object with accessor promises; TanStack AI returns the stream directly. Everything you can pull off that object is available via stream consumption, middleware, or response helpers."}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"inlineCode","value":"streamText"},{"type":"text","value":" result member"}]},{"type":"tableCell","children":[{"type":"text","value":"TanStack AI equivalent"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.textStream"}]},{"type":"tableCell","children":[{"type":"text","value":"Filter the async iterable: "},{"type":"inlineCode","value":"for await (const c of stream) if (c.type === 'text-delta') …"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.fullStream"}]},{"type":"tableCell","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"stream"},{"type":"text","value":" returned by "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" "},{"type":"strong","children":[{"type":"text","value":"is"}]},{"type":"text","value":" the full stream ("},{"type":"inlineCode","value":"AsyncIterable<StreamChunk>"},{"type":"text","value":")"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.text"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(await streamToText(stream)).text"},{"type":"text","value":" or "},{"type":"inlineCode","value":"(await chat({ …, stream: false })).text"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.content"}]},{"type":"tableCell","children":[{"type":"text","value":"Accumulate parts in "},{"type":"inlineCode","value":"middleware.onChunk"},{"type":"text","value":", or read the final "},{"type":"inlineCode","value":"UIMessage"},{"type":"text","value":" in "},{"type":"inlineCode","value":"onFinish"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.toolCalls"},{"type":"text","value":" / "},{"type":"inlineCode","value":"result.toolResults"}]},{"type":"tableCell","children":[{"type":"text","value":"Read from chunks in "},{"type":"inlineCode","value":"middleware.onChunk"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onAfterToolCall"},{"type":"text","value":", or from "},{"type":"inlineCode","value":"chunks"},{"type":"text","value":" on the "},{"type":"inlineCode","value":"stream: false"},{"type":"text","value":" result"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.usage"},{"type":"text","value":" / "},{"type":"inlineCode","value":"result.totalUsage"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"middleware.onUsage(ctx, usage)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.finishReason"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"middleware.onFinish(ctx, info)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.steps"}]},{"type":"tableCell","children":[{"type":"text","value":"Accumulate via "},{"type":"inlineCode","value":"middleware.onIteration"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onToolPhaseComplete"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.toUIMessageStreamResponse()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"toServerSentEventsResponse(stream)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.toTextStreamResponse()"}]},{"type":"tableCell","children":[{"type":"text","value":"Collect with "},{"type":"inlineCode","value":"streamToText(stream)"},{"type":"text","value":" and return a plain "},{"type":"inlineCode","value":"Response"},{"type":"text","value":", "},{"type":"strong","children":[{"type":"text","value":"or"}]},{"type":"text","value":" pair with the client's "},{"type":"inlineCode","value":"fetchHttpStream"},{"type":"text","value":" via "},{"type":"inlineCode","value":"toHttpResponse(stream)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.pipeUIMessageStreamToResponse(res)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"toServerSentEventsStream(stream).pipeTo(…)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"result.consumeStream()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"for await (const _ of stream) {}"}]}]]},{"type":"heading","depth":3,"id":"generation-options","children":[{"type":"text","value":"Generation Options"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI promotes a small, cross-provider set of options to the top level ("},{"type":"inlineCode","value":"temperature"},{"type":"text","value":", "},{"type":"inlineCode","value":"topP"},{"type":"text","value":", "},{"type":"inlineCode","value":"maxTokens"},{"type":"text","value":") and pushes everything provider-specific into a single typed "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" bag. There's no "},{"type":"inlineCode","value":"providerOptions: { openai: {…} }"},{"type":"text","value":" nesting — the adapter already knows which provider it is, so "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" is flat and typed against the selected model."}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-v5","children":[{"type":"text","value":"Before (Vercel AI SDK v5+)"}]},{"type":"code","value":"import { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  temperature: 0.7,\n  maxOutputTokens: 1000, // (v5+); `maxTokens` on v4\n  topP: 0.9,\n  topK: 40,\n  presencePenalty: 0.1,\n  frequencyPenalty: 0.1,\n  seed: 42,\n  stopSequences: ['\\n\\nUser:'],\n  // Provider-specific options (v5+)\n  providerOptions: {\n    openai: {\n      responseFormat: { type: 'json_object' },\n    },\n  },\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"after-tanstack-ai-3","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  messages,\n  // Provider-specific options typed for gpt-4o specifically\n  modelOptions: {\n    temperature: 0.7,\n    max_output_tokens: 1000,\n    top_p: 0.9,\n    service_tier: 'default',\n    store: true,\n    parallel_tool_calls: false,\n  },\n})","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Autocomplete in "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" reflects the "},{"type":"strong","children":[{"type":"text","value":"exact"}]},{"type":"text","value":" adapter and model you passed. Swap "},{"type":"inlineCode","value":"openaiText('gpt-4o')"},{"type":"text","value":" for "},{"type":"inlineCode","value":"anthropicText('claude-sonnet-4-5')"},{"type":"text","value":" and the shape changes to match Anthropic's options."}]}]},{"type":"heading","depth":3,"id":"system-messages","children":[{"type":"text","value":"System Messages"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI accepts system prompts at the "},{"type":"strong","children":[{"type":"text","value":"root level"}]},{"type":"text","value":" via the "},{"type":"inlineCode","value":"systemPrompts"},{"type":"text","value":" option. You pass an array of strings, and each adapter merges them into whatever format the provider expects. You don't manually prepend a "},{"type":"inlineCode","value":"system"},{"type":"text","value":" message to the "},{"type":"inlineCode","value":"messages"},{"type":"text","value":" array."}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-3","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"import { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  system: 'You are a helpful assistant.',\n  messages,\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"after-tanstack-ai-4","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  systemPrompts: ['You are a helpful assistant.'],\n  messages,\n})","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Multiple system prompts are supported — useful for composing persona, policies, and tool-usage guidance without string concatenation:"}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  systemPrompts: [\n    'You are a helpful assistant.',\n    'Respond in concise, plain English.',\n    'Never fabricate citations.',\n  ],\n  messages,\n})","lang":"typescript"},{"type":"heading","depth":2,"id":"client-side-migration","children":[{"type":"text","value":"Client-Side Migration"}]},{"type":"heading","depth":3,"id":"basic-usechat-hook","children":[{"type":"text","value":"Basic useChat Hook"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-v5-2","children":[{"type":"text","value":"Before (Vercel AI SDK v5+)"}]},{"type":"code","value":"import { useChat } from '@ai-sdk/react'\nimport { DefaultChatTransport } from 'ai'\nimport { useState } from 'react'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, status } = useChat({\n    transport: new DefaultChatTransport({ api: '/api/chat' }),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && status !== 'streaming') {\n      sendMessage({ text: input })\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.role}:{' '}\n          {m.parts.map((p, i) => (p.type === 'text' ? <span key={i}>{p.text}</span> : null))}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input value={input} onChange={(e) => setInput(e.target.value)} />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":4,"id":"after-tanstack-ai-5","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { useState } from 'react'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && !isLoading) {\n      sendMessage(input)\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((message) => (\n        <div key={message.id}>\n          {message.role}:{' '}\n          {message.parts.map((part, idx) =>\n            part.type === 'text' ? <span key={idx}>{part.content}</span> : null\n          )}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input value={input} onChange={(e) => setInput(e.target.value)} />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"usechat-api-differences","children":[{"type":"text","value":"useChat API Differences"}]},{"type":"paragraph","children":[{"type":"text","value":"Vercel AI SDK v5+ already moved away from the magic "},{"type":"inlineCode","value":"input"},{"type":"text","value":"/"},{"type":"inlineCode","value":"handleInputChange"},{"type":"text","value":"/"},{"type":"inlineCode","value":"handleSubmit"},{"type":"text","value":" of v4 and now expects you to manage your own input state. TanStack AI follows that same philosophy — the hook is headless and gives you building blocks instead of form glue."}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Vercel AI SDK (v5+)"}]},{"type":"tableCell","children":[{"type":"text","value":"TanStack AI"}]},{"type":"tableCell","children":[{"type":"text","value":"Notes"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"transport: new DefaultChatTransport({ api: '/api/chat' })"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"connection: fetchServerSentEvents('/api/chat')"}]},{"type":"tableCell","children":[{"type":"text","value":"Pluggable connection adapter"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"sendMessage({ text })"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"sendMessage(text)"}]},{"type":"tableCell","children":[{"type":"text","value":"Accepts plain string; pass "},{"type":"inlineCode","value":"UIMessage"},{"type":"text","value":" objects via "},{"type":"inlineCode","value":"append()"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":" ("},{"type":"inlineCode","value":"'submitted' | 'streaming' | 'ready' | 'error'"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"isLoading"},{"type":"text","value":" (boolean)"}]},{"type":"tableCell","children":[{"type":"text","value":"Coarser in TanStack; full stream state available via events"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"regenerate()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"reload()"}]},{"type":"tableCell","children":[{"type":"text","value":"Re-runs the last assistant turn"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stop()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"stop()"}]},{"type":"tableCell","children":[{"type":"text","value":"Cancel the in-flight stream"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"setMessages(messages)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"setMessages(messages)"}]},{"type":"tableCell","children":[{"type":"text","value":"Direct message replacement"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"addToolOutput({ tool, toolCallId, output })"},{"type":"text","value":" (v6; was "},{"type":"inlineCode","value":"addToolResult"},{"type":"text","value":" in v5)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"addToolResult({ tool, toolCallId, output })"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolve a client-side tool call"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"addToolApprovalResponse({ id, approved })"},{"type":"text","value":" (v6)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"addToolApprovalResponse({ id, approved })"}]},{"type":"tableCell","children":[{"type":"text","value":"First-class user-approval flow for tools"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"m.parts"},{"type":"text","value":" (typed union)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"message.parts"},{"type":"text","value":" (typed union)"}]},{"type":"tableCell","children":[{"type":"text","value":"Both render via structured parts"}]}]]},{"type":"heading","depth":3,"id":"message-structure","children":[{"type":"text","value":"Message Structure"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-4","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"interface Message {\n  id: string\n  role: 'user' | 'assistant' | 'system'\n  content: string\n  toolInvocations?: ToolInvocation[]\n}","lang":"typescript","meta":"ignore"},{"type":"heading","depth":4,"id":"after-tanstack-ai-6","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"paragraph","children":[{"type":"text","value":"These are the "},{"type":"inlineCode","value":"@tanstack/ai-client"},{"type":"text","value":" shapes (what "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":" gives you). The core "},{"type":"inlineCode","value":"@tanstack/ai"},{"type":"text","value":" message types are similar, but "},{"type":"inlineCode","value":"input"},{"type":"text","value":" (parsed tool input) is a client-layer projection — server-side code reads the raw JSON from "},{"type":"inlineCode","value":"arguments"},{"type":"text","value":" directly."}]},{"type":"code","value":"interface UIMessage<TTools extends ReadonlyArray<AnyClientTool> = any> {\n  id: string\n  role: 'system' | 'user' | 'assistant'\n  parts: Array<MessagePart<TTools>>\n  createdAt?: Date\n}\n\ntype MessagePart<TTools> =\n  | TextPart\n  | ToolCallPart<TTools>\n  | ToolResultPart\n  | ThinkingPart\n\ninterface TextPart {\n  type: 'text'\n  content: string\n}\n\ninterface ThinkingPart {\n  type: 'thinking'\n  content: string\n}\n\ninterface ToolCallPart {\n  type: 'tool-call'\n  id: string\n  name: string\n  arguments: string          // Raw JSON string (may be partial while streaming)\n  input?: unknown            // Parsed input (typed when tools are typed)\n  output?: unknown           // Execution output once available\n  state: ToolCallState\n  approval?: {\n    id: string               // Approval request ID\n    needsApproval: boolean\n    approved?: boolean       // undefined until the user responds\n  }\n}\n\ninterface ToolResultPart {\n  type: 'tool-result'\n  toolCallId: string\n  content: string\n  state: ToolResultState\n  error?: string             // Present when state is 'error'\n}\n\ntype ToolCallState =\n  | 'awaiting-input'\n  | 'input-streaming'\n  | 'input-complete'\n  | 'approval-requested'\n  | 'approval-responded'\n\ntype ToolResultState = 'streaming' | 'complete' | 'error'","lang":"typescript","meta":"ignore"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack AI does not have separate "},{"type":"inlineCode","value":"reasoning"},{"type":"text","value":", "},{"type":"inlineCode","value":"source-url"},{"type":"text","value":", "},{"type":"inlineCode","value":"source-document"},{"type":"text","value":", or "},{"type":"inlineCode","value":"file"},{"type":"text","value":" part types that you may have seen in other SDKs. Provider-specific reasoning traces arrive as "},{"type":"inlineCode","value":"thinking"},{"type":"text","value":" parts; citations and inline files are surfaced through "},{"type":"inlineCode","value":"metadata"},{"type":"text","value":" on text parts or through your tool outputs."}]}]},{"type":"heading","depth":3,"id":"rendering-messages","children":[{"type":"text","value":"Rendering Messages"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-5","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"{messages.map((m) => (\n  <div key={m.id}>\n    {m.role}: {m.content}\n    {m.toolInvocations?.map((tool) => (\n      <div key={tool.toolCallId}>\n        Tool: {tool.toolName} - {JSON.stringify(tool.result)}\n      </div>\n    ))}\n  </div>\n))}","lang":"tsx","meta":"ignore"},{"type":"heading","depth":4,"id":"after-tanstack-ai-7","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"{messages.map((message) => (\n  <div key={message.id}>\n    {message.role}:{' '}\n    {message.parts.map((part, idx) => {\n      if (part.type === 'text') {\n        return <span key={idx}>{part.content}</span>\n      }\n      if (part.type === 'thinking') {\n        return <em key={idx}>Thinking: {part.content}</em>\n      }\n      if (part.type === 'tool-call') {\n        return (\n          <div key={part.id}>\n            Tool: {part.name} - {JSON.stringify(part.output)}\n          </div>\n        )\n      }\n      return null\n    })}\n  </div>\n))}","lang":"tsx","meta":"ignore"},{"type":"heading","depth":2,"id":"tools-function-calling","children":[{"type":"text","value":"Tools / Function Calling"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI uses an isomorphic tool system where you define the schema once and implement it separately for server and client."}]},{"type":"heading","depth":3,"id":"basic-tool-definition","children":[{"type":"text","value":"Basic Tool Definition"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-v5-3","children":[{"type":"text","value":"Before (Vercel AI SDK v5+)"}]},{"type":"code","value":"import { streamText, tool } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  tools: {\n    getWeather: tool({\n      description: 'Get weather for a location',\n      inputSchema: z.object({ // renamed from `parameters` in v5\n        location: z.string(),\n      }),\n      execute: async ({ location }) => {\n        const weather = await fetchWeather(location)\n        return weather\n      },\n    }),\n  },\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"after-tanstack-ai-8","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { chat, toolDefinition, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\n\n// Step 1: Define the tool schema\nconst getWeatherDef = toolDefinition({\n  name: 'getWeather',\n  description: 'Get weather for a location',\n  inputSchema: z.object({\n    location: z.string(),\n  }),\n  outputSchema: z.object({\n    temperature: z.number(),\n    conditions: z.string(),\n  }),\n})\n\n// Step 2: Create server implementation\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  const weather = await fetchWeather(location)\n  return weather\n})\n\n// Step 3: Use in chat\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    tools: [getWeather],\n  })\n  return toServerSentEventsResponse(stream)\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"tool-schema-differences","children":[{"type":"text","value":"Tool Schema Differences"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Vercel AI SDK"}]},{"type":"tableCell","children":[{"type":"text","value":"TanStack AI"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"parameters"},{"type":"text","value":" (v4) / "},{"type":"inlineCode","value":"inputSchema"},{"type":"text","value":" (v5+)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"inputSchema"}]}],[{"type":"tableCell","children":[{"type":"text","value":"N/A"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":" (optional — enables end-to-end type safety)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"execute"},{"type":"text","value":" inline on the server"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":".server()"},{"type":"text","value":" or "},{"type":"inlineCode","value":".client()"},{"type":"text","value":" methods (isomorphic definition)"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Object with tool names as keys"}]},{"type":"tableCell","children":[{"type":"text","value":"Array of tool instances"}]}]]},{"type":"heading","depth":3,"id":"client-side-tools","children":[{"type":"text","value":"Client-Side Tools"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-v5-4","children":[{"type":"text","value":"Before (Vercel AI SDK v5+)"}]},{"type":"code","value":"import { DefaultChatTransport } from 'ai'\nimport { useChat } from '@ai-sdk/react'\n\nconst { messages, addToolOutput } = useChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n  onToolCall: async ({ toolCall }) => {\n    if (toolCall.toolName === 'showNotification') {\n      // v6: addToolOutput (was addToolResult in v5)\n      addToolOutput({\n        tool: 'showNotification',\n        toolCallId: toolCall.toolCallId,\n        output: { success: true },\n      })\n    }\n  },\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"after-tanstack-ai-9","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\nimport { toast } from './toast'\n\n// Define once (can be shared with server)\nconst showNotificationDef = toolDefinition({\n  name: 'showNotification',\n  description: 'Show a toast notification in the browser',\n  inputSchema: z.object({ message: z.string() }),\n  outputSchema: z.object({ success: z.boolean() }),\n})\n\n// Client implementation\nconst showNotification = showNotificationDef.client(({ message }) => {\n  toast(message)\n  return { success: true }\n})\n\n// Use in component — passing the client tools in the `tools` array wires each\n// tool's `.client(...)` handler to run automatically when the server-side\n// agent calls it; you don't need an onToolCall handler or an\n// addToolOutput/addToolResult call.\nconst { messages } = useChat({\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [showNotification],\n})","lang":"typescript"},{"type":"heading","depth":3,"id":"tool-approval-flow","children":[{"type":"text","value":"Tool Approval Flow"}]},{"type":"paragraph","children":[{"type":"text","value":"Both libraries expose first-class human-in-the-loop approval. The shapes are similar — a tool opts in with "},{"type":"inlineCode","value":"needsApproval: true"},{"type":"text","value":", the client renders UI on an "},{"type":"inlineCode","value":"approval-requested"},{"type":"text","value":" state, and you call "},{"type":"inlineCode","value":"addToolApprovalResponse"},{"type":"text","value":" with the approval ID."}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-v6","children":[{"type":"text","value":"Before (Vercel AI SDK v6)"}]},{"type":"code","value":"// Tool definition (server)\nimport { tool, DefaultChatTransport, lastAssistantMessageIsCompleteWithApprovalResponses } from 'ai'\nimport { useChat } from '@ai-sdk/react'\nimport { z } from 'zod'\nimport { bookingService } from './booking'\n\nconst bookFlight = tool({\n  description: 'Book a flight',\n  inputSchema: z.object({ flightId: z.string() }),\n  needsApproval: true, // v6: first-class approval\n  execute: async ({ flightId }) => bookingService.book(flightId),\n})\n\n// Client\nconst { messages, addToolApprovalResponse } = useChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n  sendAutomaticallyWhen: lastAssistantMessageIsCompleteWithApprovalResponses,\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"after-tanstack-ai-10","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"// Built-in approval support\nconst bookFlightDef = toolDefinition({\n  name: 'bookFlight',\n  description: 'Book a flight on behalf of the user',\n  inputSchema: z.object({ flightId: z.string() }),\n  needsApproval: true, // Request user approval\n})\n\n// In component\nconst { messages, addToolApprovalResponse } = useChat({\n  connection: fetchServerSentEvents('/api/chat'),\n})\n\n// Render approval UI\n{message.parts.map((part, idx) => {\n  if (\n    part.type === 'tool-call' &&\n    part.state === 'approval-requested' &&\n    part.approval\n  ) {\n    return (\n      <div key={idx}>\n        <p>Approve booking flight {part.input?.flightId}?</p>\n        <button\n          onClick={() => addToolApprovalResponse({ id: part.approval!.id, approved: true })}\n        >\n          Approve\n        </button>\n        <button\n          onClick={() => addToolApprovalResponse({ id: part.approval!.id, approved: false })}\n        >\n          Deny\n        </button>\n      </div>\n    )\n  }\n  return null\n})}","lang":"tsx","meta":"ignore"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"part.input"},{"type":"text","value":" is the "},{"type":"strong","children":[{"type":"text","value":"parsed"}]},{"type":"text","value":" tool input (typed when you pass a typed "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" array). The raw streaming JSON is available as "},{"type":"inlineCode","value":"part.arguments"},{"type":"text","value":" if you need to show progress before input parsing completes."}]}]},{"type":"heading","depth":2,"id":"structured-output","children":[{"type":"text","value":"Structured Output"}]},{"type":"paragraph","children":[{"type":"text","value":"This section covers the "},{"type":"inlineCode","value":"generateObject"},{"type":"text","value":" / "},{"type":"inlineCode","value":"streamObject"},{"type":"text","value":" / "},{"type":"inlineCode","value":"Output.object(...)"},{"type":"text","value":" migration path. In AI SDK v6, structured generation lives on "},{"type":"inlineCode","value":"generateText"},{"type":"text","value":" / "},{"type":"inlineCode","value":"streamText"},{"type":"text","value":" via the "},{"type":"inlineCode","value":"output:"},{"type":"text","value":" parameter (e.g. "},{"type":"inlineCode","value":"Output.object({ schema })"},{"type":"text","value":"). The dedicated "},{"type":"inlineCode","value":"generateObject"},{"type":"text","value":" / "},{"type":"inlineCode","value":"streamObject"},{"type":"text","value":" functions are deprecated but still present. TanStack AI follows the same \"one function\" philosophy — pass "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":" to "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" and it runs the full agentic loop (tools, retries, loop strategy) and returns a typed, validated value."}]},{"type":"heading","depth":3,"id":"before-vercel-ai-sdk-v6-2","children":[{"type":"text","value":"Before (Vercel AI SDK v6)"}]},{"type":"code","value":"import { generateText, Output } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { z } from 'zod'\n\nconst { output } = await generateText({\n  model: openai('gpt-4o'),\n  prompt: 'Extract the user profile from this bio…',\n  output: Output.object({\n    schema: z.object({\n      name: z.string(),\n      age: z.number(),\n      interests: z.array(z.string()),\n    }),\n  }),\n})\n// output is typed as { name: string; age: number; interests: string[] }","lang":"typescript"},{"type":"heading","depth":3,"id":"after-tanstack-ai-11","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\n\nconst profile = await chat({\n  adapter: openaiText('gpt-4o'),\n  messages: [{ role: 'user', content: 'Extract the user profile from this bio…' }],\n  outputSchema: z.object({\n    name: z.string(),\n    age: z.number(),\n    interests: z.array(z.string()),\n  }),\n})\n// profile: { name: string; age: number; interests: string[] }","lang":"typescript"},{"type":"heading","depth":3,"id":"notes","children":[{"type":"text","value":"Notes"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":" accepts any "},{"type":"strong","children":[{"type":"text","value":"Standard Schema"}]},{"type":"text","value":"-compatible library: "},{"type":"strong","children":[{"type":"text","value":"Zod v4.2+"}]},{"type":"text","value":", "},{"type":"strong","children":[{"type":"text","value":"ArkType v2.1.28+"}]},{"type":"text","value":", "},{"type":"strong","children":[{"type":"text","value":"Valibot v1.2+"}]},{"type":"text","value":" (via "},{"type":"inlineCode","value":"toStandardJsonSchema()"},{"type":"text","value":"), or a plain JSON Schema object (which loses TS inference and falls back to "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":")."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":" is set, "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" always returns a "},{"type":"inlineCode","value":"Promise<T>"},{"type":"text","value":" — the "},{"type":"inlineCode","value":"stream"},{"type":"text","value":" flag is ignored, because the value only makes sense once the schema has validated the final output."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Adapters implement structured output the best way for their provider: OpenAI uses "},{"type":"inlineCode","value":"response_format: json_schema"},{"type":"text","value":", Anthropic uses tool-based extraction, Gemini uses "},{"type":"inlineCode","value":"responseSchema"},{"type":"text","value":", Ollama uses JSON mode. You don't need to pick the strategy."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Arrays are just "},{"type":"inlineCode","value":"z.array(z.object({ … }))"},{"type":"text","value":". TanStack AI does not yet stream partial objects the way "},{"type":"inlineCode","value":"streamObject().elementStream"},{"type":"text","value":" does on the Vercel side — if that's load-bearing, stay on "},{"type":"inlineCode","value":"streamText"},{"type":"text","value":" for now and migrate the object case when partial streaming lands."}]}]}]},{"type":"heading","depth":2,"id":"agent-loop-control","children":[{"type":"text","value":"Agent Loop Control"}]},{"type":"paragraph","children":[{"type":"text","value":"Both SDKs let the model call tools in a loop. The shape of the control knob is different:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Vercel AI SDK v6"}]},{"type":"tableCell","children":[{"type":"text","value":"TanStack AI"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"stopWhen: stepCountIs(5)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"agentLoopStrategy: maxIterations(5)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stopWhen: hasToolCall('bookFlight')"}]},{"type":"tableCell","children":[{"type":"text","value":"Custom "},{"type":"inlineCode","value":"AgentLoopStrategy"},{"type":"text","value":" that inspects "},{"type":"inlineCode","value":"messages"},{"type":"text","value":" for the tool name"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stopWhen: untilFinishReason(['stop'])"},{"type":"text","value":" (custom condition)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"agentLoopStrategy: untilFinishReason(['stop'])"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stopWhen: [stepCountIs(20), hasToolCall('done')]"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"agentLoopStrategy: combineStrategies([maxIterations(20), /* your hasToolCall */ ])"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"prepareStep({ stepNumber, messages, steps, model })"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"middleware.onConfig(ctx, config)"},{"type":"text","value":" + "},{"type":"inlineCode","value":"middleware.onIteration(ctx, info)"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Default loop budget: TanStack AI defaults to "},{"type":"inlineCode","value":"maxIterations(5)"},{"type":"text","value":" if you don't pass a strategy."}]},{"type":"heading","depth":3,"id":"before-vercel-ai-sdk-v6-3","children":[{"type":"text","value":"Before (Vercel AI SDK v6)"}]},{"type":"code","value":"import { streamText, stepCountIs } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { getWeather } from './tools'\n\nconst messages = [{ role: 'user' as const, content: 'What is the weather?' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  tools: { getWeather },\n  stopWhen: stepCountIs(10),\n  prepareStep: async ({ stepNumber, messages: stepMessages }) => {\n    // log/rewrite messages between steps, filter tools, etc.\n    if (stepNumber > 0) return {}\n    return {}\n  },\n})","lang":"typescript"},{"type":"heading","depth":3,"id":"after-tanstack-ai-12","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import {\n  chat,\n  combineStrategies,\n  maxIterations,\n  untilFinishReason,\n  toServerSentEventsResponse,\n  type ChatMiddleware,\n  type ChatMiddlewareContext,\n  type ChatMiddlewareConfig,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { getWeather } from './tools'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    tools: [getWeather],\n    agentLoopStrategy: combineStrategies([\n      maxIterations(10),\n      untilFinishReason(['stop']), // stop when the model says it's done\n    ]),\n    middleware: [\n      {\n        // `prepareStep` analogue: inspect/rewrite config at the start of each iteration\n        onConfig: (ctx: ChatMiddlewareContext, config: ChatMiddlewareConfig) => {\n          if (ctx.iteration > 0) {\n            // e.g. return a Partial<ChatMiddlewareConfig> to filter tools, trim\n            // messages, or change modelOptions for this iteration\n            return undefined\n          }\n        },\n      } satisfies ChatMiddleware,\n    ],\n  })\n  return toServerSentEventsResponse(stream)\n}","lang":"typescript"},{"type":"heading","depth":4,"id":"mid-loop-model-switching","children":[{"type":"text","value":"Mid-loop model switching"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"prepareStep"},{"type":"text","value":" in AI SDK v6 lets you return a different "},{"type":"inlineCode","value":"model"},{"type":"text","value":" per step. TanStack AI doesn't support swapping the adapter inside a single "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" run — "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" is typed per adapter, which is what gives you compile-time model safety. The equivalent is to end the current loop (via an "},{"type":"inlineCode","value":"agentLoopStrategy"},{"type":"text","value":") and start a new "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" with a different adapter, feeding it the in-progress messages:"}]},{"type":"code","value":"import { chat, maxIterations } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { getWeather } from './tools'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\n// Stage 1: heavy model for the opening turn\nconst firstPass = await chat({\n  adapter: openaiText('gpt-4o'),\n  messages,\n  agentLoopStrategy: maxIterations(1),\n  stream: false,\n})\n\n// Stage 2: cheaper model for the rest\nconst followUp = chat({\n  adapter: openaiText('gpt-4o-mini'),\n  messages: [...messages, { role: 'assistant' as const, content: firstPass.text }],\n  tools: [getWeather],\n})","lang":"typescript"},{"type":"heading","depth":2,"id":"middleware","children":[{"type":"text","value":"Middleware"}]},{"type":"paragraph","children":[{"type":"text","value":"AI SDK v6 has two middleware-ish extension points:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"wrapLanguageModel({ model, middleware })"}]},{"type":"text","value":" — provider-level interception ("},{"type":"inlineCode","value":"transformParams"},{"type":"text","value":", "},{"type":"inlineCode","value":"wrapGenerate"},{"type":"text","value":", "},{"type":"inlineCode","value":"wrapStream"},{"type":"text","value":") for logging, caching, guardrails, RAG."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"experimental_transform"}]},{"type":"text","value":" on "},{"type":"inlineCode","value":"streamText"},{"type":"text","value":" — transforms the stream of chunks."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI collapses both into a single first-class "},{"type":"inlineCode","value":"middleware: ChatMiddleware[]"},{"type":"text","value":" option on "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":". It hooks into the full lifecycle, not just the model call or the chunk stream, and is the recommended place for logging, tracing, caching, redaction, and tool interception."}]},{"type":"heading","depth":3,"id":"before-vercel-ai-sdk-v6-4","children":[{"type":"text","value":"Before (Vercel AI SDK v6)"}]},{"type":"code","value":"import { wrapLanguageModel, streamText, type LanguageModelMiddleware } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst loggingMiddleware = {\n  specificationVersion: 'v3' as const,\n  wrapGenerate: async ({ doGenerate, params }) => {\n    console.log('params', params)\n    const result = await doGenerate()\n    console.log('content', result.content)\n    return result\n  },\n  wrapStream: async ({ doStream, params }) => doStream(),\n  transformParams: async ({ params }) => params,\n} satisfies LanguageModelMiddleware\n\nconst wrapped = wrapLanguageModel({\n  model: openai('gpt-4o'),\n  middleware: [loggingMiddleware],\n})\n\nconst result = streamText({ model: wrapped, messages })","lang":"typescript"},{"type":"heading","depth":3,"id":"after-tanstack-ai-13","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse, type ChatMiddleware } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\ntype AppContext = { userId: string }\n\nconst loggingMiddleware: ChatMiddleware<AppContext> = {\n  onStart: (ctx) => console.log('start', { requestId: ctx.requestId, userId: ctx.context.userId }),\n  onConfig: (ctx, config) => console.log('config', config),\n  onChunk:  (ctx, chunk) => { /* observe or transform; return null to drop */ },\n  onUsage:  (ctx, usage) => console.log('usage', usage),\n  onFinish: (ctx, info)  => console.log('finish', info),\n  onError:  (ctx, err)   => console.error('error', err),\n}\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    middleware: [loggingMiddleware],\n    context: { userId: 'u_123' }, // passed to every hook as typed ctx.context\n  })\n  return toServerSentEventsResponse(stream)\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"full-hook-inventory","children":[{"type":"text","value":"Full hook inventory"}]},{"type":"paragraph","children":[{"type":"text","value":"Each middleware is a plain object. Every hook is optional, so pick what you need."}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Hook"}]},{"type":"tableCell","children":[{"type":"text","value":"Called when"}]},{"type":"tableCell","children":[{"type":"text","value":"Can transform?"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"onStart(ctx)"}]},{"type":"tableCell","children":[{"type":"text","value":"Chat run starts"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onConfig(ctx, config)"}]},{"type":"tableCell","children":[{"type":"text","value":"Init + before each model call"}]},{"type":"tableCell","children":[{"type":"text","value":"Return "},{"type":"inlineCode","value":"Partial<ChatMiddlewareConfig>"},{"type":"text","value":" to mutate messages, systemPrompts, tools, temperature, etc."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onIteration(ctx, info)"}]},{"type":"tableCell","children":[{"type":"text","value":"Start of each agent-loop iteration"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onChunk(ctx, chunk)"}]},{"type":"tableCell","children":[{"type":"text","value":"Every yielded "},{"type":"inlineCode","value":"StreamChunk"}]},{"type":"tableCell","children":[{"type":"text","value":"Return a chunk / array of chunks / "},{"type":"inlineCode","value":"null"},{"type":"text","value":" to drop"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onBeforeToolCall(ctx, hookCtx)"}]},{"type":"tableCell","children":[{"type":"text","value":"Before a tool executes"}]},{"type":"tableCell","children":[{"type":"text","value":"Return a "},{"type":"inlineCode","value":"BeforeToolCallDecision"},{"type":"text","value":" to rewrite args, skip, or abort"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onAfterToolCall(ctx, info)"}]},{"type":"tableCell","children":[{"type":"text","value":"After a tool executes (success or failure)"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onToolPhaseComplete(ctx, info)"}]},{"type":"tableCell","children":[{"type":"text","value":"All tools in an iteration done"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onUsage(ctx, usage)"}]},{"type":"tableCell","children":[{"type":"text","value":"Provider reports token usage"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFinish(ctx, info)"}]},{"type":"tableCell","children":[{"type":"text","value":"Run finished normally (terminal)"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onAbort(ctx, info)"}]},{"type":"tableCell","children":[{"type":"text","value":"Run aborted (terminal)"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onError(ctx, info)"}]},{"type":"tableCell","children":[{"type":"text","value":"Unhandled error (terminal)"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]}]]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ctx"},{"type":"text","value":" carries "},{"type":"inlineCode","value":"requestId"},{"type":"text","value":", "},{"type":"inlineCode","value":"streamId"},{"type":"text","value":", "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":", "},{"type":"inlineCode","value":"iteration"},{"type":"text","value":", "},{"type":"inlineCode","value":"model"},{"type":"text","value":", "},{"type":"inlineCode","value":"provider"},{"type":"text","value":", "},{"type":"inlineCode","value":"systemPrompts"},{"type":"text","value":", "},{"type":"inlineCode","value":"toolNames"},{"type":"text","value":", "},{"type":"inlineCode","value":"messages"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":" (your typed runtime value), "},{"type":"inlineCode","value":"abort(reason)"},{"type":"text","value":", "},{"type":"inlineCode","value":"defer(promise)"},{"type":"text","value":", "},{"type":"inlineCode","value":"createId(prefix)"},{"type":"text","value":", and more. See "},{"type":"link","href":"../advanced/middleware","children":[{"type":"text","value":"the middleware guide"}]},{"type":"text","value":" and "},{"type":"link","href":"../advanced/runtime-context","children":[{"type":"text","value":"runtime context guide"}]},{"type":"text","value":" for the full reference."}]},{"type":"heading","depth":3,"id":"built-in-tool-call-cache","children":[{"type":"text","value":"Built-in: tool-call cache"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI ships a "},{"type":"inlineCode","value":"toolCacheMiddleware"},{"type":"text","value":" that memoizes tool results by "},{"type":"inlineCode","value":"name + args"},{"type":"text","value":". There's no direct Vercel equivalent — on the Vercel side you'd compose it yourself in "},{"type":"inlineCode","value":"wrapGenerate"},{"type":"text","value":" or inside each tool's "},{"type":"inlineCode","value":"execute"},{"type":"text","value":". Example:"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { toolCacheMiddleware } from '@tanstack/ai/middlewares'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { searchDocs, getWeather } from './tools'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    tools: [searchDocs, getWeather],\n    middleware: [\n      toolCacheMiddleware({\n        maxSize: 100,\n        ttl: 5 * 60_000, // 5 minutes\n        toolNames: ['searchDocs'], // only cache these\n        // storage: redisStorage, // plug in Redis / localStorage / custom\n      }),\n    ],\n  })\n  return toServerSentEventsResponse(stream)\n}","lang":"typescript"},{"type":"heading","depth":3,"id":"mapping-common-vercel-patterns-to-tanstack-middleware","children":[{"type":"text","value":"Mapping common Vercel patterns to TanStack middleware"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Vercel pattern"}]},{"type":"tableCell","children":[{"type":"text","value":"TanStack middleware hook"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"experimental_transform"},{"type":"text","value":" (chunk transform)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"onChunk"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"experimental_repairToolCall"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"onBeforeToolCall"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"prepareStep"},{"type":"text","value":" (dynamic model/tools/messages)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"onConfig"},{"type":"text","value":" + "},{"type":"inlineCode","value":"onIteration"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"wrapLanguageModel"},{"type":"text","value":" logging"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"onStart"},{"type":"text","value":" + "},{"type":"inlineCode","value":"onConfig"},{"type":"text","value":" + "},{"type":"inlineCode","value":"onFinish"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Custom caching in "},{"type":"inlineCode","value":"wrapGenerate"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"toolCacheMiddleware"},{"type":"text","value":" or your own "},{"type":"inlineCode","value":"onBeforeToolCall"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onAfterToolCall"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"experimental_telemetry"}]},{"type":"tableCell","children":[{"type":"text","value":"Any terminal hook ("},{"type":"inlineCode","value":"onFinish"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onAbort"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onError"},{"type":"text","value":") + your tracer"}]}]]},{"type":"heading","depth":2,"id":"observability-logging-metrics-tracing","children":[{"type":"text","value":"Observability (logging, metrics, tracing)"}]},{"type":"paragraph","children":[{"type":"text","value":"Both libraries leave the wire to your tracer of choice (OpenTelemetry, Sentry, Datadog, …). The plug point differs:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Vercel AI SDK"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"experimental_telemetry"},{"type":"text","value":" on "},{"type":"inlineCode","value":"streamText"},{"type":"text","value":" + the lifecycle callbacks ("},{"type":"inlineCode","value":"onChunk"},{"type":"text","value":", "},{"type":"inlineCode","value":"onStepFinish"},{"type":"text","value":", "},{"type":"inlineCode","value":"onFinish"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError"},{"type":"text","value":")."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"TanStack AI"}]},{"type":"text","value":": a middleware with the hooks you need. "},{"type":"inlineCode","value":"onStart"},{"type":"text","value":" + "},{"type":"inlineCode","value":"onFinish"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onAbort"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onError"},{"type":"text","value":" covers request-level spans; "},{"type":"inlineCode","value":"onChunk"},{"type":"text","value":" + "},{"type":"inlineCode","value":"onUsage"},{"type":"text","value":" gives you fine-grained timing; "},{"type":"inlineCode","value":"onBeforeToolCall"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onAfterToolCall"},{"type":"text","value":" for tool spans."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Because "},{"type":"inlineCode","value":"ctx.requestId"},{"type":"text","value":" and "},{"type":"inlineCode","value":"ctx.streamId"},{"type":"text","value":" are stable across hooks, you get one trace per request without threading IDs manually."}]},{"type":"heading","depth":2,"id":"provider-adapters","children":[{"type":"text","value":"Provider Adapters"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI uses activity-specific adapters for optimal tree-shaking."}]},{"type":"heading","depth":3,"id":"openai","children":[{"type":"text","value":"OpenAI"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-6","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"import { openai } from '@ai-sdk/openai'\n\n// Chat\nstreamText({ model: openai('gpt-4o'), ... })\n\n// Embeddings\nembed({ model: openai.embedding('text-embedding-3-small'), ... })\n\n// Image generation\ngenerateImage({ model: openai.image('dall-e-3'), ... })","lang":"typescript","meta":"ignore"},{"type":"heading","depth":4,"id":"after-tanstack-ai-14","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import {\n  openaiText,\n  openaiImage,\n  openaiSpeech,\n  openaiEmbedding,\n} from '@tanstack/ai-openai'\n\n// Chat\nchat({ adapter: openaiText('gpt-4o'), ... })\n\n// Image generation\ngenerateImage({ adapter: openaiImage('dall-e-3'), ... })\n\n// Text to speech\ngenerateSpeech({ adapter: openaiSpeech('tts-1'), ... })\n\n// Embeddings\nembed({ adapter: openaiEmbedding('text-embedding-3-small'), ... })","lang":"typescript","meta":"ignore"},{"type":"heading","depth":3,"id":"anthropic","children":[{"type":"text","value":"Anthropic"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-7","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"import { anthropic } from '@ai-sdk/anthropic'\n\nstreamText({ model: anthropic('claude-sonnet-4-5-20250514'), ... })","lang":"typescript","meta":"ignore"},{"type":"heading","depth":4,"id":"after-tanstack-ai-15","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { anthropicText } from '@tanstack/ai-anthropic'\n\nchat({ adapter: anthropicText('claude-sonnet-4-5-20250514'), ... })","lang":"typescript","meta":"ignore"},{"type":"heading","depth":3,"id":"google-gemini","children":[{"type":"text","value":"Google (Gemini)"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-8","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"import { google } from '@ai-sdk/google'\n\nstreamText({ model: google('gemini-1.5-pro'), ... })","lang":"typescript","meta":"ignore"},{"type":"heading","depth":4,"id":"after-tanstack-ai-16","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { geminiText } from '@tanstack/ai-gemini'\n\nchat({ adapter: geminiText('gemini-2.5-flash'), ... })","lang":"typescript","meta":"ignore"},{"type":"heading","depth":2,"id":"streaming-responses","children":[{"type":"text","value":"Streaming Responses"}]},{"type":"heading","depth":3,"id":"server-response-formats","children":[{"type":"text","value":"Server Response Formats"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-v5-5","children":[{"type":"text","value":"Before (Vercel AI SDK v5+)"}]},{"type":"code","value":"// UI message stream (default, for useChat)\nreturn result.toUIMessageStreamResponse()\n\n// Plain text stream\nreturn result.toTextStreamResponse()","lang":"typescript","meta":"ignore"},{"type":"heading","depth":4,"id":"after-tanstack-ai-17","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import {\n  chat,\n  toServerSentEventsResponse,\n  toServerSentEventsStream,\n  toHttpResponse,\n  toHttpStream,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst abortController = new AbortController()\nconst traceId = 'trace-123'\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nasync function handler() {\n  const stream = chat({ adapter: openaiText('gpt-4o'), messages })\n\n  // SSE response (recommended; pairs with fetchServerSentEvents on the client).\n  // Both response helpers accept a ResponseInit with an optional abortController\n  // — merge custom headers, status, or cancellation without unwrapping the helper.\n  return toServerSentEventsResponse(stream, {\n    abortController,\n    status: 200,\n    headers: { 'X-Trace-Id': traceId },\n  })\n}\n\nasync function handler2() {\n  const stream = chat({ adapter: openaiText('gpt-4o'), messages })\n\n  // Newline-delimited JSON response (pairs with fetchHttpStream on the client).\n  return toHttpResponse(stream, { abortController })\n}\n\n// Or grab the raw ReadableStream if you need to pipe it somewhere else\n// (writing to a Node ServerResponse, wrapping in a transform, etc.).\nconst stream2 = chat({ adapter: openaiText('gpt-4o'), messages })\nconst sseStream = toServerSentEventsStream(stream2, abortController)\nconst ndjsonStream = toHttpStream(stream2, abortController)","lang":"typescript"},{"type":"heading","depth":3,"id":"client-connection-adapters","children":[{"type":"text","value":"Client Connection Adapters"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-v5-6","children":[{"type":"text","value":"Before (Vercel AI SDK v5+)"}]},{"type":"code","value":"import { DefaultChatTransport } from 'ai'\nimport { useChat } from '@ai-sdk/react'\n\nuseChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"after-tanstack-ai-18","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents, fetchHttpStream, stream } from '@tanstack/ai-react'\nimport { customServerFn } from './server'\n\n// SSE (matches toServerSentEventsResponse)\nuseChat({ connection: fetchServerSentEvents('/api/chat') })\n\n// HTTP stream (matches toHttpResponse / toHttpStream on the server)\nuseChat({ connection: fetchHttpStream('/api/chat') })\n\n// Custom adapter: return an AsyncIterable<StreamChunk>, e.g. from a TanStack\n// Start server function or an RPC client\nuseChat({\n  connection: stream((messages, data) => customServerFn({ messages, data })),\n})","lang":"typescript"},{"type":"heading","depth":2,"id":"abortcontroller-cancellation","children":[{"type":"text","value":"AbortController / Cancellation"}]},{"type":"heading","depth":3,"id":"before-vercel-ai-sdk-9","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"const result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  abortSignal: controller.signal,\n})","lang":"typescript","meta":"ignore"},{"type":"heading","depth":3,"id":"after-tanstack-ai-19","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI takes an "},{"type":"inlineCode","value":"AbortController"},{"type":"text","value":" (not a bare signal) so helpers like "},{"type":"inlineCode","value":"toServerSentEventsStream"},{"type":"text","value":" can wire cancellation into the response stream for you."}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\nconst abortController = new AbortController()\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  messages,\n  abortController,\n})\n\n// Cancel the stream\nabortController.abort()","lang":"typescript"},{"type":"heading","depth":2,"id":"callbacks-and-events","children":[{"type":"text","value":"Callbacks and Events"}]},{"type":"heading","depth":3,"id":"stream-callbacks","children":[{"type":"text","value":"Stream Callbacks"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-v5-7","children":[{"type":"text","value":"Before (Vercel AI SDK v5+)"}]},{"type":"code","value":"import { DefaultChatTransport } from 'ai'\nimport { useChat } from '@ai-sdk/react'\n\nconst { messages } = useChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n  onFinish: ({ message }) => console.log('Finished:', message),\n  onError: (error) => console.error('Error:', error),\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"after-tanstack-ai-20","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents('/api/chat'),\n  onResponse: (response) => console.log('Response started'),\n  onChunk: (chunk) => console.log('Chunk received:', chunk),\n  onFinish: (message) => console.log('Finished:', message),\n  onError: (error) => console.error('Error:', error),\n})","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI also lets you hook into the "},{"type":"strong","children":[{"type":"text","value":"server-side"}]},{"type":"text","value":" stream lifecycle by subscribing to the async iterable returned from "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":", which preserves the full typed "},{"type":"inlineCode","value":"StreamChunk"},{"type":"text","value":" union — useful for logging, analytics, or sending custom SSE events alongside the response."}]},{"type":"heading","depth":2,"id":"multimodal-content","children":[{"type":"text","value":"Multimodal Content"}]},{"type":"heading","depth":3,"id":"image-inputs","children":[{"type":"text","value":"Image Inputs"}]},{"type":"heading","depth":4,"id":"before-vercel-ai-sdk-10","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"import { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { imageUrl } from './images'\n\nstreamText({\n  model: openai('gpt-4o'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', text: 'Describe this image' },\n        { type: 'image', image: imageUrl },\n      ],\n    },\n  ],\n})","lang":"typescript"},{"type":"heading","depth":4,"id":"after-tanstack-ai-21","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { imageUrl, imageData } from './images'\n\nchat({\n  adapter: openaiText('gpt-4o'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', content: 'Describe this image' },\n        { type: 'image', source: { type: 'url', value: imageUrl } },\n        // Or inline base64 data\n        { type: 'image', source: { type: 'data', value: imageData, mimeType: 'image/png' } },\n      ],\n    },\n  ],\n})","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"The source discriminant is "},{"type":"inlineCode","value":"'url'"},{"type":"text","value":" or "},{"type":"inlineCode","value":"'data'"},{"type":"text","value":". Both carry the payload on "},{"type":"inlineCode","value":"value"},{"type":"text","value":" (a URL or base64 string). "},{"type":"inlineCode","value":"mimeType"},{"type":"text","value":" is required for "},{"type":"inlineCode","value":"'data'"},{"type":"text","value":" and optional for "},{"type":"inlineCode","value":"'url'"},{"type":"text","value":"."}]}]},{"type":"heading","depth":2,"id":"dynamic-provider-switching","children":[{"type":"text","value":"Dynamic Provider Switching"}]},{"type":"heading","depth":3,"id":"before-vercel-ai-sdk-11","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"import { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { anthropic } from '@ai-sdk/anthropic'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst providers = {\n  openai: openai('gpt-4o'),\n  anthropic: anthropic('claude-sonnet-4-5-20250514'),\n}\n\nconst selectedProvider: keyof typeof providers = 'openai'\n\nstreamText({\n  model: providers[selectedProvider],\n  messages,\n})","lang":"typescript"},{"type":"heading","depth":3,"id":"after-tanstack-ai-22","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { anthropicText } from '@tanstack/ai-anthropic'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst adapters = {\n  openai: () => openaiText('gpt-4o'),\n  anthropic: () => anthropicText('claude-sonnet-4-5'),\n} as const\n\nconst selectedProvider: keyof typeof adapters = 'openai'\n\nchat({\n  adapter: adapters[selectedProvider](),\n  messages,\n})","lang":"typescript"},{"type":"heading","depth":2,"id":"type-safety-enhancements","children":[{"type":"text","value":"Type Safety Enhancements"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI provides enhanced type safety that Vercel AI SDK doesn't offer:"}]},{"type":"heading","depth":3,"id":"typed-message-parts","children":[{"type":"text","value":"Typed Message Parts"}]},{"type":"code","value":"import { createChatClientOptions, type InferChatMessages } from '@tanstack/ai-client'\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { updateUI, saveData } from './tools'\n\nconst tools = [updateUI, saveData]\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents('/api/chat'),\n  tools,\n})\n\n// Infer fully typed messages\ntype ChatMessages = InferChatMessages<typeof chatOptions>\n\n// Now TypeScript knows:\n// - Exact tool names available\n// - Input types for each tool\n// - Output types for each tool","lang":"typescript"},{"type":"heading","depth":3,"id":"per-model-type-safety","children":[{"type":"text","value":"Per-Model Type Safety"}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\nconst adapter = openaiText('gpt-4o')\n\nchat({\n  adapter,\n  messages,\n  modelOptions: {\n    // TypeScript autocompletes options specific to gpt-4o\n    service_tier: 'default',\n    store: true,\n  },\n})","lang":"typescript"},{"type":"heading","depth":2,"id":"non-streaming-generation-generatetext","children":[{"type":"text","value":"Non-streaming Generation ("},{"type":"inlineCode","value":"generateText"},{"type":"text","value":")"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI has no separate "},{"type":"inlineCode","value":"generateText"},{"type":"text","value":" function. The same "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" covers both modes. Pass "},{"type":"inlineCode","value":"stream: false"},{"type":"text","value":" and the return type changes from "},{"type":"inlineCode","value":"AsyncIterable<StreamChunk>"},{"type":"text","value":" to "},{"type":"inlineCode","value":"Promise<ChatResult>"},{"type":"text","value":":"}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst { text, chunks } = await chat({\n  adapter: openaiText('gpt-4o'),\n  messages: [{ role: 'user', content: 'Summarize TanStack AI in one sentence.' }],\n  stream: false,\n})\n// text: string\n// chunks: every chunk of the run (tool calls, usage, RUN_FINISHED)","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"If you already have a stream, "},{"type":"inlineCode","value":"streamToText(stream)"},{"type":"text","value":" reads it to the end and returns the same "},{"type":"inlineCode","value":"{ text, chunks }"},{"type":"text","value":" result:"}]},{"type":"code","value":"import { chat, streamToText } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\nconst stream = chat({ adapter: openaiText('gpt-4o'), messages })\nconst { text } = await streamToText(stream)","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"For structured (non-streaming) output — the "},{"type":"inlineCode","value":"generateObject"},{"type":"text","value":" equivalent — pass "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":" instead; see "},{"type":"link","href":"#structured-output","children":[{"type":"text","value":"Structured Output"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"embeddings","children":[{"type":"text","value":"Embeddings"}]},{"type":"paragraph","children":[{"type":"text","value":"Vercel's "},{"type":"inlineCode","value":"embed"},{"type":"text","value":" and "},{"type":"inlineCode","value":"embedMany"},{"type":"text","value":" both map to TanStack AI's single "},{"type":"inlineCode","value":"embed()"},{"type":"text","value":" function — "},{"type":"inlineCode","value":"input"},{"type":"text","value":" accepts one item or an array, and the result always carries one vector per input item."}]},{"type":"heading","depth":3,"id":"before-vercel-ai-sdk-12","children":[{"type":"text","value":"Before (Vercel AI SDK)"}]},{"type":"code","value":"import { embed, embedMany } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst { embedding } = await embed({\n  model: openai.embedding('text-embedding-3-small'),\n  value: 'Hello, world!',\n})\n\nconst { embeddings } = await embedMany({\n  model: openai.embedding('text-embedding-3-small'),\n  values: ['one', 'two'],\n})","lang":"typescript"},{"type":"heading","depth":3,"id":"after-tanstack-ai-23","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"import { embed } from '@tanstack/ai'\nimport { openaiEmbedding } from '@tanstack/ai-openai'\n\nconst single = await embed({\n  adapter: openaiEmbedding('text-embedding-3-small'),\n  input: 'Hello, world!',\n})\nconst vector = single.embeddings[0]?.vector\n\nconst batch = await embed({\n  adapter: openaiEmbedding('text-embedding-3-small'),\n  input: ['one', 'two'],\n})\nconst vectors = batch.embeddings.map((e) => e.vector)","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI's "},{"type":"inlineCode","value":"embed()"},{"type":"text","value":" additionally supports multimodal (text + image) inputs for models like Cohere embed-v4.0 and Amazon Titan Multimodal — see the "},{"type":"link","href":"../embeddings.md","children":[{"type":"text","value":"Embeddings guide"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"features-not-yet-covered","children":[{"type":"text","value":"Features Not Yet Covered"}]},{"type":"paragraph","children":[{"type":"text","value":"A few AI SDK features don't have direct TanStack AI equivalents today:"}]},{"type":"heading","depth":3,"id":"partial-object-streaming-streamobject-elementstream-partialobjectstream","children":[{"type":"text","value":"Partial object streaming ("},{"type":"inlineCode","value":"streamObject().elementStream"},{"type":"text","value":" / "},{"type":"inlineCode","value":"partialObjectStream"},{"type":"text","value":")"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack AI's "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":" always returns a "},{"type":"inlineCode","value":"Promise<T>"},{"type":"text","value":" once the full response has validated. If you need to render partial JSON as it streams, stay on "},{"type":"inlineCode","value":"streamText"},{"type":"text","value":" + "},{"type":"inlineCode","value":"onChunk"},{"type":"text","value":" for that specific case (or parse from TanStack's raw stream with your own incremental JSON parser)."}]},{"type":"heading","depth":3,"id":"built-in-retries-and-timeouts","children":[{"type":"text","value":"Built-in retries and timeouts"}]},{"type":"paragraph","children":[{"type":"text","value":"Vercel's "},{"type":"inlineCode","value":"maxRetries"},{"type":"text","value":" / "},{"type":"inlineCode","value":"timeout"},{"type":"text","value":" options have no direct "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" equivalent. Use "},{"type":"inlineCode","value":"AbortSignal.timeout(ms)"},{"type":"text","value":" via "},{"type":"inlineCode","value":"abortController"},{"type":"text","value":", and add retries in a custom middleware or in your fetch layer."}]},{"type":"heading","depth":2,"id":"complete-migration-example","children":[{"type":"text","value":"Complete Migration Example"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"On the Vercel side, the v5+ server handler runs incoming UI messages through "},{"type":"inlineCode","value":"convertToModelMessages(messages)"},{"type":"text","value":" before handing them to "},{"type":"inlineCode","value":"streamText"},{"type":"text","value":". TanStack AI's "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" accepts the UI-message shape directly — its adapters do the conversion internally — so the equivalent line simply disappears on the After side."}]}]},{"type":"heading","depth":3,"id":"before-vercel-ai-sdk-v5-8","children":[{"type":"text","value":"Before (Vercel AI SDK v5+)"}]},{"type":"code","value":"// server/api/chat.ts\nimport { streamText, tool, convertToModelMessages, DefaultChatTransport } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { useChat } from '@ai-sdk/react'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\nimport { useState } from 'react'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const result = streamText({\n    model: openai('gpt-4o'),\n    system: 'You are a helpful assistant.',\n    messages: await convertToModelMessages(messages),\n    temperature: 0.7,\n    tools: {\n      getWeather: tool({\n        description: 'Get weather',\n        inputSchema: z.object({ city: z.string() }),\n        execute: async ({ city }) => fetchWeather(city),\n      }),\n    },\n  })\n\n  return result.toUIMessageStreamResponse()\n}\n\n// components/Chat.tsx\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, status } = useChat({\n    transport: new DefaultChatTransport({ api: '/api/chat' }),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && status !== 'streaming') {\n      sendMessage({ text: input })\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.parts.map((p, i) => (p.type === 'text' ? <span key={i}>{p.text}</span> : null))}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n          disabled={status === 'streaming'}\n        />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"after-tanstack-ai-24","children":[{"type":"text","value":"After (TanStack AI)"}]},{"type":"code","value":"// server/api/chat.ts\nimport { chat, toServerSentEventsResponse, toolDefinition } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\n\nconst getWeatherDef = toolDefinition({\n  name: 'getWeather',\n  description: 'Get weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temp: z.number(), conditions: z.string() }),\n})\n\nconst getWeather = getWeatherDef.server(async ({ city }) => fetchWeather(city))\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    systemPrompts: ['You are a helpful assistant.'],\n    messages,\n    temperature: 0.7,\n    tools: [getWeather],\n  })\n\n  return toServerSentEventsResponse(stream)\n}\n\n// components/Chat.tsx\nimport { useState } from 'react'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && !isLoading) {\n      sendMessage(input)\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((message) => (\n        <div key={message.id}>\n          {message.parts.map((part, idx) =>\n            part.type === 'text' ? <span key={idx}>{part.content}</span> : null\n          )}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n          disabled={isLoading}\n        />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}","lang":"tsx","meta":"ignore"},{"type":"heading","depth":2,"id":"need-help","children":[{"type":"text","value":"Need Help?"}]},{"type":"paragraph","children":[{"type":"text","value":"If you hit something that isn't covered here, the deep-dive docs pick up where this guide stops:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../getting-started/quick-start","children":[{"type":"text","value":"Quick Start"}]},{"type":"text","value":" — minimal working setup"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../tools/tools","children":[{"type":"text","value":"Tools"}]},{"type":"text","value":", "},{"type":"link","href":"../tools/tool-architecture","children":[{"type":"text","value":"Tool Architecture"}]},{"type":"text","value":", and "},{"type":"link","href":"../tools/tool-approval","children":[{"type":"text","value":"Tool Approval"}]},{"type":"text","value":" — the isomorphic tool system"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../chat/agentic-cycle","children":[{"type":"text","value":"Agentic Cycle"}]},{"type":"text","value":" — agent loop internals and strategy composition"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../structured-outputs/overview","children":[{"type":"text","value":"Structured Outputs"}]},{"type":"text","value":" — "},{"type":"inlineCode","value":"outputSchema"},{"type":"text","value":", provider implementations, schema libraries"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../advanced/middleware","children":[{"type":"text","value":"Middleware"}]},{"type":"text","value":" — full hook reference, context object, built-in middleware"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../transports/overview","children":[{"type":"text","value":"Transports"}]},{"type":"text","value":" — SSE, HTTP stream, custom transports"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../advanced/per-model-type-safety","children":[{"type":"text","value":"Per-Model Type Safety"}]},{"type":"text","value":" — how "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":" is typed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../api/ai","children":[{"type":"text","value":"API Reference"}]},{"type":"text","value":" — every exported symbol"}]}]}]}],"headings":[{"id":"why-migrate","text":"Why Migrate?","level":2},{"id":"quick-reference","text":"Quick Reference","level":2},{"id":"installation","text":"Installation","level":2},{"id":"before-vercel-ai-sdk","text":"Before (Vercel AI SDK)","level":3},{"id":"after-tanstack-ai","text":"After (TanStack AI)","level":3},{"id":"server-side-migration","text":"Server-Side Migration","level":2},{"id":"basic-text-generation","text":"Basic Text Generation","level":3},{"id":"before-vercel-ai-sdk-2","text":"Before (Vercel AI SDK)","level":4},{"id":"after-tanstack-ai-2","text":"After (TanStack AI)","level":4},{"id":"key-differences","text":"Key Differences","level":3},{"id":"full-streamtext-chat-option-mapping","text":"Full streamText → chat() Option Mapping","level":3},{"id":"streamtext-result-tanstack-ai-equivalents","text":"streamText result → TanStack AI equivalents","level":3},{"id":"generation-options","text":"Generation Options","level":3},{"id":"before-vercel-ai-sdk-v5","text":"Before (Vercel AI SDK v5+)","level":4},{"id":"after-tanstack-ai-3","text":"After (TanStack AI)","level":4},{"id":"system-messages","text":"System Messages","level":3},{"id":"before-vercel-ai-sdk-3","text":"Before (Vercel AI SDK)","level":4},{"id":"after-tanstack-ai-4","text":"After (TanStack AI)","level":4},{"id":"client-side-migration","text":"Client-Side Migration","level":2},{"id":"basic-usechat-hook","text":"Basic useChat Hook","level":3},{"id":"before-vercel-ai-sdk-v5-2","text":"Before (Vercel AI SDK v5+)","level":4},{"id":"after-tanstack-ai-5","text":"After (TanStack AI)","level":4},{"id":"usechat-api-differences","text":"useChat API Differences","level":3},{"id":"message-structure","text":"Message Structure","level":3},{"id":"before-vercel-ai-sdk-4","text":"Before (Vercel AI SDK)","level":4},{"id":"after-tanstack-ai-6","text":"After (TanStack AI)","level":4},{"id":"rendering-messages","text":"Rendering Messages","level":3},{"id":"before-vercel-ai-sdk-5","text":"Before (Vercel AI SDK)","level":4},{"id":"after-tanstack-ai-7","text":"After (TanStack AI)","level":4},{"id":"tools-function-calling","text":"Tools / Function Calling","level":2},{"id":"basic-tool-definition","text":"Basic Tool Definition","level":3},{"id":"before-vercel-ai-sdk-v5-3","text":"Before (Vercel AI SDK v5+)","level":4},{"id":"after-tanstack-ai-8","text":"After (TanStack AI)","level":4},{"id":"tool-schema-differences","text":"Tool Schema Differences","level":3},{"id":"client-side-tools","text":"Client-Side Tools","level":3},{"id":"before-vercel-ai-sdk-v5-4","text":"Before (Vercel AI SDK v5+)","level":4},{"id":"after-tanstack-ai-9","text":"After (TanStack AI)","level":4},{"id":"tool-approval-flow","text":"Tool Approval Flow","level":3},{"id":"before-vercel-ai-sdk-v6","text":"Before (Vercel AI SDK v6)","level":4},{"id":"after-tanstack-ai-10","text":"After (TanStack AI)","level":4},{"id":"structured-output","text":"Structured Output","level":2},{"id":"before-vercel-ai-sdk-v6-2","text":"Before (Vercel AI SDK v6)","level":3},{"id":"after-tanstack-ai-11","text":"After (TanStack AI)","level":3},{"id":"notes","text":"Notes","level":3},{"id":"agent-loop-control","text":"Agent Loop Control","level":2},{"id":"before-vercel-ai-sdk-v6-3","text":"Before (Vercel AI SDK v6)","level":3},{"id":"after-tanstack-ai-12","text":"After (TanStack AI)","level":3},{"id":"mid-loop-model-switching","text":"Mid-loop model switching","level":4},{"id":"middleware","text":"Middleware","level":2},{"id":"before-vercel-ai-sdk-v6-4","text":"Before (Vercel AI SDK v6)","level":3},{"id":"after-tanstack-ai-13","text":"After (TanStack AI)","level":3},{"id":"full-hook-inventory","text":"Full hook inventory","level":3},{"id":"built-in-tool-call-cache","text":"Built-in: tool-call cache","level":3},{"id":"mapping-common-vercel-patterns-to-tanstack-middleware","text":"Mapping common Vercel patterns to TanStack middleware","level":3},{"id":"observability-logging-metrics-tracing","text":"Observability (logging, metrics, tracing)","level":2},{"id":"provider-adapters","text":"Provider Adapters","level":2},{"id":"openai","text":"OpenAI","level":3},{"id":"before-vercel-ai-sdk-6","text":"Before (Vercel AI SDK)","level":4},{"id":"after-tanstack-ai-14","text":"After (TanStack AI)","level":4},{"id":"anthropic","text":"Anthropic","level":3},{"id":"before-vercel-ai-sdk-7","text":"Before (Vercel AI SDK)","level":4},{"id":"after-tanstack-ai-15","text":"After (TanStack AI)","level":4},{"id":"google-gemini","text":"Google (Gemini)","level":3},{"id":"before-vercel-ai-sdk-8","text":"Before (Vercel AI SDK)","level":4},{"id":"after-tanstack-ai-16","text":"After (TanStack AI)","level":4},{"id":"streaming-responses","text":"Streaming Responses","level":2},{"id":"server-response-formats","text":"Server Response Formats","level":3},{"id":"before-vercel-ai-sdk-v5-5","text":"Before (Vercel AI SDK v5+)","level":4},{"id":"after-tanstack-ai-17","text":"After (TanStack AI)","level":4},{"id":"client-connection-adapters","text":"Client Connection Adapters","level":3},{"id":"before-vercel-ai-sdk-v5-6","text":"Before (Vercel AI SDK v5+)","level":4},{"id":"after-tanstack-ai-18","text":"After (TanStack AI)","level":4},{"id":"abortcontroller-cancellation","text":"AbortController / Cancellation","level":2},{"id":"before-vercel-ai-sdk-9","text":"Before (Vercel AI SDK)","level":3},{"id":"after-tanstack-ai-19","text":"After (TanStack AI)","level":3},{"id":"callbacks-and-events","text":"Callbacks and Events","level":2},{"id":"stream-callbacks","text":"Stream Callbacks","level":3},{"id":"before-vercel-ai-sdk-v5-7","text":"Before (Vercel AI SDK v5+)","level":4},{"id":"after-tanstack-ai-20","text":"After (TanStack AI)","level":4},{"id":"multimodal-content","text":"Multimodal Content","level":2},{"id":"image-inputs","text":"Image Inputs","level":3},{"id":"before-vercel-ai-sdk-10","text":"Before (Vercel AI SDK)","level":4},{"id":"after-tanstack-ai-21","text":"After (TanStack AI)","level":4},{"id":"dynamic-provider-switching","text":"Dynamic Provider Switching","level":2},{"id":"before-vercel-ai-sdk-11","text":"Before (Vercel AI SDK)","level":3},{"id":"after-tanstack-ai-22","text":"After (TanStack AI)","level":3},{"id":"type-safety-enhancements","text":"Type Safety Enhancements","level":2},{"id":"typed-message-parts","text":"Typed Message Parts","level":3},{"id":"per-model-type-safety","text":"Per-Model Type Safety","level":3},{"id":"non-streaming-generation-generatetext","text":"Non-streaming Generation (generateText)","level":2},{"id":"embeddings","text":"Embeddings","level":2},{"id":"before-vercel-ai-sdk-12","text":"Before (Vercel AI SDK)","level":3},{"id":"after-tanstack-ai-23","text":"After (TanStack AI)","level":3},{"id":"features-not-yet-covered","text":"Features Not Yet Covered","level":2},{"id":"partial-object-streaming-streamobject-elementstream-partialobjectstream","text":"Partial object streaming (streamObject().elementStream / partialObjectStream)","level":3},{"id":"built-in-retries-and-timeouts","text":"Built-in retries and timeouts","level":3},{"id":"complete-migration-example","text":"Complete Migration Example","level":2},{"id":"before-vercel-ai-sdk-v5-8","text":"Before (Vercel AI SDK v5+)","level":3},{"id":"after-tanstack-ai-24","text":"After (TanStack AI)","level":3},{"id":"need-help","text":"Need Help?","level":2}]},"frameworks":["react","vue","solid","svelte","preact","angular","vanilla","octane"],"downloadMarkdown":"\nThis guide helps you migrate from the Vercel AI SDK (`ai` + `@ai-sdk/*`) to TanStack AI. Both libraries cover the same problem space — LLM calls, streaming, tool use, structured output, framework hooks — but TanStack AI uses a different architecture with enhanced type safety, tree-shakeable adapters, an isomorphic tool system, and a first-class middleware pipeline.\n\nThe \"Before\" examples target **AI SDK v5 and v6**. Older v4 naming is called out inline where it differs.\n\n## Why Migrate?\n\nTanStack AI provides several advantages:\n\n- **Tree-shakeable adapters** - Import only what you need, reducing bundle size\n- **Isomorphic tools** - Define tools once, implement for server and client separately\n- **Per-model type safety** - TypeScript knows exact options available for each model\n- **Framework agnostic** - Works with React, Vue, Solid, Svelte, and vanilla JS\n- **Full streaming type safety** - Typed stream chunks and message parts\n\n## Quick Reference\n\n| Vercel AI SDK | TanStack AI |\n|--------------|-------------|\n| `ai` | `@tanstack/ai` |\n| `@ai-sdk/openai` | `@tanstack/ai-openai` |\n| `@ai-sdk/anthropic` | `@tanstack/ai-anthropic` |\n| `@ai-sdk/google` | `@tanstack/ai-gemini` |\n| `@ai-sdk/google-vertex` | `@tanstack/ai-vertex` (Gemini), `@tanstack/ai-anthropic/vertex` (Claude), `@tanstack/ai-grok/vertex` (Grok), and `@tanstack/ai-mistral/vertex` (Mistral) |\n| `@ai-sdk/react` | `@tanstack/ai-react` |\n| `@ai-sdk/vue` | `@tanstack/ai-vue` |\n| `@ai-sdk/solid` | `@tanstack/ai-solid` |\n| `@ai-sdk/svelte` | `@tanstack/ai-svelte` |\n\n> **Note:** Since AI SDK v5, framework hooks moved from `ai/react` (v4) to dedicated packages like `@ai-sdk/react`. If you are on v4, swap the old subpaths for their v5 equivalents.\n\n## Installation\n\n### Before (Vercel AI SDK)\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: ai @ai-sdk/react @ai-sdk/openai @ai-sdk/anthropic\n\n<!-- ::end:tabs -->\n\n### After (TanStack AI)\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai @tanstack/ai-react @tanstack/ai-openai @tanstack/ai-anthropic\nvue: @tanstack/ai @tanstack/ai-vue @tanstack/ai-openai @tanstack/ai-anthropic\nsolid: @tanstack/ai @tanstack/ai-solid @tanstack/ai-openai @tanstack/ai-anthropic\nsvelte: @tanstack/ai @tanstack/ai-svelte @tanstack/ai-openai @tanstack/ai-anthropic\npreact: @tanstack/ai @tanstack/ai-preact @tanstack/ai-openai @tanstack/ai-anthropic\nangular: @tanstack/ai @tanstack/ai-angular @tanstack/ai-openai @tanstack/ai-anthropic\nvanilla: @tanstack/ai @tanstack/ai-client @tanstack/ai-openai @tanstack/ai-anthropic\noctane: @tanstack/ai @tanstack/ai-octane @tanstack/ai-openai @tanstack/ai-anthropic octane\n\n<!-- ::end:tabs -->\n\n## Server-Side Migration\n\n### Basic Text Generation\n\n#### Before (Vercel AI SDK)\n\n```typescript\nimport { streamText, convertToModelMessages } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const result = streamText({\n    model: openai('gpt-4o'),\n    messages: await convertToModelMessages(messages),\n  })\n\n  return result.toUIMessageStreamResponse()\n  // (v4: result.toDataStreamResponse())\n}\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n  })\n\n  return toServerSentEventsResponse(stream)\n}\n```\n\n### Key Differences\n\n| Vercel AI SDK | TanStack AI | Notes |\n|--------------|-------------|-------|\n| `streamText()` | `chat()` | Main text generation function |\n| `generateText()` | `chat({ stream: false })` | Returns `Promise<{ text, chunks }>` |\n| `generateObject()` / `streamObject()` / `Output.object()` | `chat({ outputSchema })` | Returns `Promise<T>` — see [Structured Output](#structured-output) |\n| `openai('gpt-4o')` | `openaiText('gpt-4o')` | Activity-specific adapters |\n| `result.toUIMessageStreamResponse()` / `.toTextStreamResponse()` | `toServerSentEventsResponse(stream)` / `toHttpResponse(stream)` | Separate utility functions |\n| `model` parameter | `adapter` parameter | Model baked into adapter |\n\n### Full `streamText` → `chat()` Option Mapping\n\nOptions accepted by `streamText` as of AI SDK v6, and where each lives in TanStack AI's `chat()`. Options that exist on both sides keep the same semantics unless noted.\n\n| `streamText` option | `chat()` equivalent | Notes |\n|--------------------|--------------------|-------|\n| `model: openai('gpt-4o')` | `adapter: openaiText('gpt-4o')` | Activity-specific adapters |\n| `prompt: 'Hello'` | `messages: [{ role: 'user', content: 'Hello' }]` | TanStack is messages-only |\n| `messages` | `messages` | Same concept; content parts differ (see [Multimodal](#multimodal-content)) |\n| `system: 'You are…'` | `systemPrompts: ['You are…']` | Root-level `string[]` |\n| `tools: { name: tool({…}) }` | `tools: [toolInstance, …]` | Array of tool instances instead of a keyed object |\n| `toolChoice: 'auto' \\| 'required' \\| 'none' \\| { type, toolName }` | `modelOptions.toolChoice` (provider-specific) | Not a top-level option — set on the adapter's `modelOptions` |\n| `activeTools: string[]` | Filter `tools` yourself, or use `prepareStep` equivalent via middleware | No dedicated option — see [Middleware](#middleware) for dynamic tool filtering |\n| `maxOutputTokens` | `maxTokens` | Renamed to match the original OpenAI naming |\n| `temperature` | `temperature` | Same |\n| `topP` | `topP` | Same |\n| `topK` | `modelOptions.topK` (where the provider supports it) | Lives under typed `modelOptions` |\n| `presencePenalty` | `modelOptions.presencePenalty` | Lives under typed `modelOptions` |\n| `frequencyPenalty` | `modelOptions.frequencyPenalty` | Lives under typed `modelOptions` |\n| `seed` | `modelOptions.seed` | Lives under typed `modelOptions` |\n| `stopSequences` | `modelOptions.stop` (provider-specific) | Lives under typed `modelOptions` |\n| `maxRetries` | Wrap your fetch/adapter, or add a retry `middleware` | Not built into `chat()` |\n| `timeout` | Combine `abortController` + `AbortSignal.timeout(ms)` | Not built into `chat()` |\n| `abortSignal: controller.signal` | `abortController: controller` | Pass the controller itself, not just the signal |\n| `headers` | Configure on the adapter (e.g., `openaiText({ headers })`) | Not a per-call option |\n| `providerOptions: { openai: { … } }` | `modelOptions: { … }` | Flat; the adapter already knows which provider it is. Typed per model |\n| `stopWhen: stepCountIs(5)` | `agentLoopStrategy: maxIterations(5)` | See [Agent Loop Control](#agent-loop-control) |\n| `stopWhen: hasToolCall('x')` | Custom `AgentLoopStrategy` that inspects `messages` | No built-in \"stop on specific tool\" preset yet — one-liner custom strategy; see [Agent Loop Control](#agent-loop-control) |\n| `stopWhen: [a, b]` | `agentLoopStrategy: combineStrategies([a, b])` | Multiple conditions, AND semantics |\n| `prepareStep` | `middleware` with `onConfig`/`onIteration` | See [Middleware](#middleware) |\n| `experimental_transform` | `middleware.onChunk` (transform / drop / expand chunks) | See [Middleware](#middleware) |\n| `experimental_context` | `context` (root-level) | Typed runtime context passed to middleware hooks and tool implementations |\n| `experimental_telemetry` | `middleware` + your tracer of choice | See [Observability](#observability-logging-metrics-tracing) |\n| `experimental_repairToolCall` | `middleware.onBeforeToolCall` | Return transformed args or a decision |\n| `experimental_download` | Preprocess your `messages` before calling `chat()` | No built-in hook |\n| `onChunk` (streamText) | `middleware.onChunk` | Also reachable by consuming the returned iterable |\n| `onError` | `middleware.onError` | Terminal hook |\n| `onStepFinish` | `middleware.onIteration` / `onToolPhaseComplete` / `onUsage` | Split into finer-grained hooks |\n| `onFinish` | `middleware.onFinish` | Terminal hook |\n| `onAbort` | `middleware.onAbort` | Terminal hook |\n| `output: Output.object({ schema })` | `outputSchema` | See [Structured Output](#structured-output) |\n| — | `conversationId` / `threadId` / `runId` | TanStack-only, for correlating requests across your system and AG-UI |\n\n### `streamText` result → TanStack AI equivalents\n\n`streamText` returns an object with accessor promises; TanStack AI returns the stream directly. Everything you can pull off that object is available via stream consumption, middleware, or response helpers.\n\n| `streamText` result member | TanStack AI equivalent |\n|---------------------------|------------------------|\n| `result.textStream` | Filter the async iterable: `for await (const c of stream) if (c.type === 'text-delta') …` |\n| `result.fullStream` | The `stream` returned by `chat()` **is** the full stream (`AsyncIterable<StreamChunk>`) |\n| `result.text` | `(await streamToText(stream)).text` or `(await chat({ …, stream: false })).text` |\n| `result.content` | Accumulate parts in `middleware.onChunk`, or read the final `UIMessage` in `onFinish` |\n| `result.toolCalls` / `result.toolResults` | Read from chunks in `middleware.onChunk` / `onAfterToolCall`, or from `chunks` on the `stream: false` result |\n| `result.usage` / `result.totalUsage` | `middleware.onUsage(ctx, usage)` |\n| `result.finishReason` | `middleware.onFinish(ctx, info)` |\n| `result.steps` | Accumulate via `middleware.onIteration` / `onToolPhaseComplete` |\n| `result.toUIMessageStreamResponse()` | `toServerSentEventsResponse(stream)` |\n| `result.toTextStreamResponse()` | Collect with `streamToText(stream)` and return a plain `Response`, **or** pair with the client's `fetchHttpStream` via `toHttpResponse(stream)` |\n| `result.pipeUIMessageStreamToResponse(res)` | `toServerSentEventsStream(stream).pipeTo(…)` |\n| `result.consumeStream()` | `for await (const _ of stream) {}` |\n\n### Generation Options\n\nTanStack AI promotes a small, cross-provider set of options to the top level (`temperature`, `topP`, `maxTokens`) and pushes everything provider-specific into a single typed `modelOptions` bag. There's no `providerOptions: { openai: {…} }` nesting — the adapter already knows which provider it is, so `modelOptions` is flat and typed against the selected model.\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  temperature: 0.7,\n  maxOutputTokens: 1000, // (v5+); `maxTokens` on v4\n  topP: 0.9,\n  topK: 40,\n  presencePenalty: 0.1,\n  frequencyPenalty: 0.1,\n  seed: 42,\n  stopSequences: ['\\n\\nUser:'],\n  // Provider-specific options (v5+)\n  providerOptions: {\n    openai: {\n      responseFormat: { type: 'json_object' },\n    },\n  },\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  messages,\n  // Provider-specific options typed for gpt-4o specifically\n  modelOptions: {\n    temperature: 0.7,\n    max_output_tokens: 1000,\n    top_p: 0.9,\n    service_tier: 'default',\n    store: true,\n    parallel_tool_calls: false,\n  },\n})\n```\n\n> Autocomplete in `modelOptions` reflects the **exact** adapter and model you passed. Swap `openaiText('gpt-4o')` for `anthropicText('claude-sonnet-4-5')` and the shape changes to match Anthropic's options.\n\n### System Messages\n\nTanStack AI accepts system prompts at the **root level** via the `systemPrompts` option. You pass an array of strings, and each adapter merges them into whatever format the provider expects. You don't manually prepend a `system` message to the `messages` array.\n\n#### Before (Vercel AI SDK)\n\n```typescript\nimport { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  system: 'You are a helpful assistant.',\n  messages,\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  systemPrompts: ['You are a helpful assistant.'],\n  messages,\n})\n```\n\nMultiple system prompts are supported — useful for composing persona, policies, and tool-usage guidance without string concatenation:\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  systemPrompts: [\n    'You are a helpful assistant.',\n    'Respond in concise, plain English.',\n    'Never fabricate citations.',\n  ],\n  messages,\n})\n```\n\n## Client-Side Migration\n\n### Basic useChat Hook\n\n#### Before (Vercel AI SDK v5+)\n\n```tsx\nimport { useChat } from '@ai-sdk/react'\nimport { DefaultChatTransport } from 'ai'\nimport { useState } from 'react'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, status } = useChat({\n    transport: new DefaultChatTransport({ api: '/api/chat' }),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && status !== 'streaming') {\n      sendMessage({ text: input })\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.role}:{' '}\n          {m.parts.map((p, i) => (p.type === 'text' ? <span key={i}>{p.text}</span> : null))}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input value={input} onChange={(e) => setInput(e.target.value)} />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}\n```\n\n#### After (TanStack AI)\n\n```tsx\nimport { useState } from 'react'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && !isLoading) {\n      sendMessage(input)\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((message) => (\n        <div key={message.id}>\n          {message.role}:{' '}\n          {message.parts.map((part, idx) =>\n            part.type === 'text' ? <span key={idx}>{part.content}</span> : null\n          )}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input value={input} onChange={(e) => setInput(e.target.value)} />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}\n```\n\n### useChat API Differences\n\nVercel AI SDK v5+ already moved away from the magic `input`/`handleInputChange`/`handleSubmit` of v4 and now expects you to manage your own input state. TanStack AI follows that same philosophy — the hook is headless and gives you building blocks instead of form glue.\n\n| Vercel AI SDK (v5+) | TanStack AI | Notes |\n|--------------------|-------------|-------|\n| `transport: new DefaultChatTransport({ api: '/api/chat' })` | `connection: fetchServerSentEvents('/api/chat')` | Pluggable connection adapter |\n| `sendMessage({ text })` | `sendMessage(text)` | Accepts plain string; pass `UIMessage` objects via `append()` |\n| `status` (`'submitted' \\| 'streaming' \\| 'ready' \\| 'error'`) | `isLoading` (boolean) | Coarser in TanStack; full stream state available via events |\n| `regenerate()` | `reload()` | Re-runs the last assistant turn |\n| `stop()` | `stop()` | Cancel the in-flight stream |\n| `setMessages(messages)` | `setMessages(messages)` | Direct message replacement |\n| `addToolOutput({ tool, toolCallId, output })` (v6; was `addToolResult` in v5) | `addToolResult({ tool, toolCallId, output })` | Resolve a client-side tool call |\n| `addToolApprovalResponse({ id, approved })` (v6) | `addToolApprovalResponse({ id, approved })` | First-class user-approval flow for tools |\n| `m.parts` (typed union) | `message.parts` (typed union) | Both render via structured parts |\n\n### Message Structure\n\n#### Before (Vercel AI SDK)\n\n```typescript ignore\ninterface Message {\n  id: string\n  role: 'user' | 'assistant' | 'system'\n  content: string\n  toolInvocations?: ToolInvocation[]\n}\n```\n\n#### After (TanStack AI)\n\nThese are the `@tanstack/ai-client` shapes (what `useChat` gives you). The core `@tanstack/ai` message types are similar, but `input` (parsed tool input) is a client-layer projection — server-side code reads the raw JSON from `arguments` directly.\n\n```typescript ignore\ninterface UIMessage<TTools extends ReadonlyArray<AnyClientTool> = any> {\n  id: string\n  role: 'system' | 'user' | 'assistant'\n  parts: Array<MessagePart<TTools>>\n  createdAt?: Date\n}\n\ntype MessagePart<TTools> =\n  | TextPart\n  | ToolCallPart<TTools>\n  | ToolResultPart\n  | ThinkingPart\n\ninterface TextPart {\n  type: 'text'\n  content: string\n}\n\ninterface ThinkingPart {\n  type: 'thinking'\n  content: string\n}\n\ninterface ToolCallPart {\n  type: 'tool-call'\n  id: string\n  name: string\n  arguments: string          // Raw JSON string (may be partial while streaming)\n  input?: unknown            // Parsed input (typed when tools are typed)\n  output?: unknown           // Execution output once available\n  state: ToolCallState\n  approval?: {\n    id: string               // Approval request ID\n    needsApproval: boolean\n    approved?: boolean       // undefined until the user responds\n  }\n}\n\ninterface ToolResultPart {\n  type: 'tool-result'\n  toolCallId: string\n  content: string\n  state: ToolResultState\n  error?: string             // Present when state is 'error'\n}\n\ntype ToolCallState =\n  | 'awaiting-input'\n  | 'input-streaming'\n  | 'input-complete'\n  | 'approval-requested'\n  | 'approval-responded'\n\ntype ToolResultState = 'streaming' | 'complete' | 'error'\n```\n\n> TanStack AI does not have separate `reasoning`, `source-url`, `source-document`, or `file` part types that you may have seen in other SDKs. Provider-specific reasoning traces arrive as `thinking` parts; citations and inline files are surfaced through `metadata` on text parts or through your tool outputs.\n\n### Rendering Messages\n\n#### Before (Vercel AI SDK)\n\n```tsx ignore\n{messages.map((m) => (\n  <div key={m.id}>\n    {m.role}: {m.content}\n    {m.toolInvocations?.map((tool) => (\n      <div key={tool.toolCallId}>\n        Tool: {tool.toolName} - {JSON.stringify(tool.result)}\n      </div>\n    ))}\n  </div>\n))}\n```\n\n#### After (TanStack AI)\n\n```tsx ignore\n{messages.map((message) => (\n  <div key={message.id}>\n    {message.role}:{' '}\n    {message.parts.map((part, idx) => {\n      if (part.type === 'text') {\n        return <span key={idx}>{part.content}</span>\n      }\n      if (part.type === 'thinking') {\n        return <em key={idx}>Thinking: {part.content}</em>\n      }\n      if (part.type === 'tool-call') {\n        return (\n          <div key={part.id}>\n            Tool: {part.name} - {JSON.stringify(part.output)}\n          </div>\n        )\n      }\n      return null\n    })}\n  </div>\n))}\n```\n\n## Tools / Function Calling\n\nTanStack AI uses an isomorphic tool system where you define the schema once and implement it separately for server and client.\n\n### Basic Tool Definition\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { streamText, tool } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  tools: {\n    getWeather: tool({\n      description: 'Get weather for a location',\n      inputSchema: z.object({ // renamed from `parameters` in v5\n        location: z.string(),\n      }),\n      execute: async ({ location }) => {\n        const weather = await fetchWeather(location)\n        return weather\n      },\n    }),\n  },\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat, toolDefinition, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\n\n// Step 1: Define the tool schema\nconst getWeatherDef = toolDefinition({\n  name: 'getWeather',\n  description: 'Get weather for a location',\n  inputSchema: z.object({\n    location: z.string(),\n  }),\n  outputSchema: z.object({\n    temperature: z.number(),\n    conditions: z.string(),\n  }),\n})\n\n// Step 2: Create server implementation\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  const weather = await fetchWeather(location)\n  return weather\n})\n\n// Step 3: Use in chat\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    tools: [getWeather],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n### Tool Schema Differences\n\n| Vercel AI SDK | TanStack AI |\n|--------------|-------------|\n| `parameters` (v4) / `inputSchema` (v5+) | `inputSchema` |\n| N/A | `outputSchema` (optional — enables end-to-end type safety) |\n| `execute` inline on the server | `.server()` or `.client()` methods (isomorphic definition) |\n| Object with tool names as keys | Array of tool instances |\n\n### Client-Side Tools\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { DefaultChatTransport } from 'ai'\nimport { useChat } from '@ai-sdk/react'\n\nconst { messages, addToolOutput } = useChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n  onToolCall: async ({ toolCall }) => {\n    if (toolCall.toolName === 'showNotification') {\n      // v6: addToolOutput (was addToolResult in v5)\n      addToolOutput({\n        tool: 'showNotification',\n        toolCallId: toolCall.toolCallId,\n        output: { success: true },\n      })\n    }\n  },\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\nimport { toast } from './toast'\n\n// Define once (can be shared with server)\nconst showNotificationDef = toolDefinition({\n  name: 'showNotification',\n  description: 'Show a toast notification in the browser',\n  inputSchema: z.object({ message: z.string() }),\n  outputSchema: z.object({ success: z.boolean() }),\n})\n\n// Client implementation\nconst showNotification = showNotificationDef.client(({ message }) => {\n  toast(message)\n  return { success: true }\n})\n\n// Use in component — passing the client tools in the `tools` array wires each\n// tool's `.client(...)` handler to run automatically when the server-side\n// agent calls it; you don't need an onToolCall handler or an\n// addToolOutput/addToolResult call.\nconst { messages } = useChat({\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [showNotification],\n})\n```\n\n### Tool Approval Flow\n\nBoth libraries expose first-class human-in-the-loop approval. The shapes are similar — a tool opts in with `needsApproval: true`, the client renders UI on an `approval-requested` state, and you call `addToolApprovalResponse` with the approval ID.\n\n#### Before (Vercel AI SDK v6)\n\n```typescript\n// Tool definition (server)\nimport { tool, DefaultChatTransport, lastAssistantMessageIsCompleteWithApprovalResponses } from 'ai'\nimport { useChat } from '@ai-sdk/react'\nimport { z } from 'zod'\nimport { bookingService } from './booking'\n\nconst bookFlight = tool({\n  description: 'Book a flight',\n  inputSchema: z.object({ flightId: z.string() }),\n  needsApproval: true, // v6: first-class approval\n  execute: async ({ flightId }) => bookingService.book(flightId),\n})\n\n// Client\nconst { messages, addToolApprovalResponse } = useChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n  sendAutomaticallyWhen: lastAssistantMessageIsCompleteWithApprovalResponses,\n})\n```\n\n#### After (TanStack AI)\n\n```tsx ignore\n// Built-in approval support\nconst bookFlightDef = toolDefinition({\n  name: 'bookFlight',\n  description: 'Book a flight on behalf of the user',\n  inputSchema: z.object({ flightId: z.string() }),\n  needsApproval: true, // Request user approval\n})\n\n// In component\nconst { messages, addToolApprovalResponse } = useChat({\n  connection: fetchServerSentEvents('/api/chat'),\n})\n\n// Render approval UI\n{message.parts.map((part, idx) => {\n  if (\n    part.type === 'tool-call' &&\n    part.state === 'approval-requested' &&\n    part.approval\n  ) {\n    return (\n      <div key={idx}>\n        <p>Approve booking flight {part.input?.flightId}?</p>\n        <button\n          onClick={() => addToolApprovalResponse({ id: part.approval!.id, approved: true })}\n        >\n          Approve\n        </button>\n        <button\n          onClick={() => addToolApprovalResponse({ id: part.approval!.id, approved: false })}\n        >\n          Deny\n        </button>\n      </div>\n    )\n  }\n  return null\n})}\n```\n\n> `part.input` is the **parsed** tool input (typed when you pass a typed `tools` array). The raw streaming JSON is available as `part.arguments` if you need to show progress before input parsing completes.\n\n## Structured Output\n\nThis section covers the `generateObject` / `streamObject` / `Output.object(...)` migration path. In AI SDK v6, structured generation lives on `generateText` / `streamText` via the `output:` parameter (e.g. `Output.object({ schema })`). The dedicated `generateObject` / `streamObject` functions are deprecated but still present. TanStack AI follows the same \"one function\" philosophy — pass `outputSchema` to `chat()` and it runs the full agentic loop (tools, retries, loop strategy) and returns a typed, validated value.\n\n### Before (Vercel AI SDK v6)\n\n```typescript\nimport { generateText, Output } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { z } from 'zod'\n\nconst { output } = await generateText({\n  model: openai('gpt-4o'),\n  prompt: 'Extract the user profile from this bio…',\n  output: Output.object({\n    schema: z.object({\n      name: z.string(),\n      age: z.number(),\n      interests: z.array(z.string()),\n    }),\n  }),\n})\n// output is typed as { name: string; age: number; interests: string[] }\n```\n\n### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\n\nconst profile = await chat({\n  adapter: openaiText('gpt-4o'),\n  messages: [{ role: 'user', content: 'Extract the user profile from this bio…' }],\n  outputSchema: z.object({\n    name: z.string(),\n    age: z.number(),\n    interests: z.array(z.string()),\n  }),\n})\n// profile: { name: string; age: number; interests: string[] }\n```\n\n### Notes\n\n- `outputSchema` accepts any **Standard Schema**-compatible library: **Zod v4.2+**, **ArkType v2.1.28+**, **Valibot v1.2+** (via `toStandardJsonSchema()`), or a plain JSON Schema object (which loses TS inference and falls back to `unknown`).\n- When `outputSchema` is set, `chat()` always returns a `Promise<T>` — the `stream` flag is ignored, because the value only makes sense once the schema has validated the final output.\n- Adapters implement structured output the best way for their provider: OpenAI uses `response_format: json_schema`, Anthropic uses tool-based extraction, Gemini uses `responseSchema`, Ollama uses JSON mode. You don't need to pick the strategy.\n- Arrays are just `z.array(z.object({ … }))`. TanStack AI does not yet stream partial objects the way `streamObject().elementStream` does on the Vercel side — if that's load-bearing, stay on `streamText` for now and migrate the object case when partial streaming lands.\n\n## Agent Loop Control\n\nBoth SDKs let the model call tools in a loop. The shape of the control knob is different:\n\n| Vercel AI SDK v6 | TanStack AI |\n|------------------|-------------|\n| `stopWhen: stepCountIs(5)` | `agentLoopStrategy: maxIterations(5)` |\n| `stopWhen: hasToolCall('bookFlight')` | Custom `AgentLoopStrategy` that inspects `messages` for the tool name |\n| `stopWhen: untilFinishReason(['stop'])` (custom condition) | `agentLoopStrategy: untilFinishReason(['stop'])` |\n| `stopWhen: [stepCountIs(20), hasToolCall('done')]` | `agentLoopStrategy: combineStrategies([maxIterations(20), /* your hasToolCall */ ])` |\n| `prepareStep({ stepNumber, messages, steps, model })` | `middleware.onConfig(ctx, config)` + `middleware.onIteration(ctx, info)` |\n\nDefault loop budget: TanStack AI defaults to `maxIterations(5)` if you don't pass a strategy.\n\n### Before (Vercel AI SDK v6)\n\n```typescript\nimport { streamText, stepCountIs } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { getWeather } from './tools'\n\nconst messages = [{ role: 'user' as const, content: 'What is the weather?' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  tools: { getWeather },\n  stopWhen: stepCountIs(10),\n  prepareStep: async ({ stepNumber, messages: stepMessages }) => {\n    // log/rewrite messages between steps, filter tools, etc.\n    if (stepNumber > 0) return {}\n    return {}\n  },\n})\n```\n\n### After (TanStack AI)\n\n```typescript\nimport {\n  chat,\n  combineStrategies,\n  maxIterations,\n  untilFinishReason,\n  toServerSentEventsResponse,\n  type ChatMiddleware,\n  type ChatMiddlewareContext,\n  type ChatMiddlewareConfig,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { getWeather } from './tools'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    tools: [getWeather],\n    agentLoopStrategy: combineStrategies([\n      maxIterations(10),\n      untilFinishReason(['stop']), // stop when the model says it's done\n    ]),\n    middleware: [\n      {\n        // `prepareStep` analogue: inspect/rewrite config at the start of each iteration\n        onConfig: (ctx: ChatMiddlewareContext, config: ChatMiddlewareConfig) => {\n          if (ctx.iteration > 0) {\n            // e.g. return a Partial<ChatMiddlewareConfig> to filter tools, trim\n            // messages, or change modelOptions for this iteration\n            return undefined\n          }\n        },\n      } satisfies ChatMiddleware,\n    ],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n#### Mid-loop model switching\n\n`prepareStep` in AI SDK v6 lets you return a different `model` per step. TanStack AI doesn't support swapping the adapter inside a single `chat()` run — `modelOptions` is typed per adapter, which is what gives you compile-time model safety. The equivalent is to end the current loop (via an `agentLoopStrategy`) and start a new `chat()` with a different adapter, feeding it the in-progress messages:\n\n```typescript\nimport { chat, maxIterations } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { getWeather } from './tools'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\n// Stage 1: heavy model for the opening turn\nconst firstPass = await chat({\n  adapter: openaiText('gpt-4o'),\n  messages,\n  agentLoopStrategy: maxIterations(1),\n  stream: false,\n})\n\n// Stage 2: cheaper model for the rest\nconst followUp = chat({\n  adapter: openaiText('gpt-4o-mini'),\n  messages: [...messages, { role: 'assistant' as const, content: firstPass.text }],\n  tools: [getWeather],\n})\n```\n\n## Middleware\n\nAI SDK v6 has two middleware-ish extension points:\n\n1. **`wrapLanguageModel({ model, middleware })`** — provider-level interception (`transformParams`, `wrapGenerate`, `wrapStream`) for logging, caching, guardrails, RAG.\n2. **`experimental_transform`** on `streamText` — transforms the stream of chunks.\n\nTanStack AI collapses both into a single first-class `middleware: ChatMiddleware[]` option on `chat()`. It hooks into the full lifecycle, not just the model call or the chunk stream, and is the recommended place for logging, tracing, caching, redaction, and tool interception.\n\n### Before (Vercel AI SDK v6)\n\n```typescript\nimport { wrapLanguageModel, streamText, type LanguageModelMiddleware } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst loggingMiddleware = {\n  specificationVersion: 'v3' as const,\n  wrapGenerate: async ({ doGenerate, params }) => {\n    console.log('params', params)\n    const result = await doGenerate()\n    console.log('content', result.content)\n    return result\n  },\n  wrapStream: async ({ doStream, params }) => doStream(),\n  transformParams: async ({ params }) => params,\n} satisfies LanguageModelMiddleware\n\nconst wrapped = wrapLanguageModel({\n  model: openai('gpt-4o'),\n  middleware: [loggingMiddleware],\n})\n\nconst result = streamText({ model: wrapped, messages })\n```\n\n### After (TanStack AI)\n\n```typescript\nimport { chat, toServerSentEventsResponse, type ChatMiddleware } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\ntype AppContext = { userId: string }\n\nconst loggingMiddleware: ChatMiddleware<AppContext> = {\n  onStart: (ctx) => console.log('start', { requestId: ctx.requestId, userId: ctx.context.userId }),\n  onConfig: (ctx, config) => console.log('config', config),\n  onChunk:  (ctx, chunk) => { /* observe or transform; return null to drop */ },\n  onUsage:  (ctx, usage) => console.log('usage', usage),\n  onFinish: (ctx, info)  => console.log('finish', info),\n  onError:  (ctx, err)   => console.error('error', err),\n}\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    middleware: [loggingMiddleware],\n    context: { userId: 'u_123' }, // passed to every hook as typed ctx.context\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n### Full hook inventory\n\nEach middleware is a plain object. Every hook is optional, so pick what you need.\n\n| Hook | Called when | Can transform? |\n|------|-------------|----------------|\n| `onStart(ctx)` | Chat run starts | — |\n| `onConfig(ctx, config)` | Init + before each model call | Return `Partial<ChatMiddlewareConfig>` to mutate messages, systemPrompts, tools, temperature, etc. |\n| `onIteration(ctx, info)` | Start of each agent-loop iteration | — |\n| `onChunk(ctx, chunk)` | Every yielded `StreamChunk` | Return a chunk / array of chunks / `null` to drop |\n| `onBeforeToolCall(ctx, hookCtx)` | Before a tool executes | Return a `BeforeToolCallDecision` to rewrite args, skip, or abort |\n| `onAfterToolCall(ctx, info)` | After a tool executes (success or failure) | — |\n| `onToolPhaseComplete(ctx, info)` | All tools in an iteration done | — |\n| `onUsage(ctx, usage)` | Provider reports token usage | — |\n| `onFinish(ctx, info)` | Run finished normally (terminal) | — |\n| `onAbort(ctx, info)` | Run aborted (terminal) | — |\n| `onError(ctx, info)` | Unhandled error (terminal) | — |\n\n`ctx` carries `requestId`, `streamId`, `threadId`, `iteration`, `model`, `provider`, `systemPrompts`, `toolNames`, `messages`, `context` (your typed runtime value), `abort(reason)`, `defer(promise)`, `createId(prefix)`, and more. See [the middleware guide](../advanced/middleware) and [runtime context guide](../advanced/runtime-context) for the full reference.\n\n### Built-in: tool-call cache\n\nTanStack AI ships a `toolCacheMiddleware` that memoizes tool results by `name + args`. There's no direct Vercel equivalent — on the Vercel side you'd compose it yourself in `wrapGenerate` or inside each tool's `execute`. Example:\n\n```typescript\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { toolCacheMiddleware } from '@tanstack/ai/middlewares'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { searchDocs, getWeather } from './tools'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    tools: [searchDocs, getWeather],\n    middleware: [\n      toolCacheMiddleware({\n        maxSize: 100,\n        ttl: 5 * 60_000, // 5 minutes\n        toolNames: ['searchDocs'], // only cache these\n        // storage: redisStorage, // plug in Redis / localStorage / custom\n      }),\n    ],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n### Mapping common Vercel patterns to TanStack middleware\n\n| Vercel pattern | TanStack middleware hook |\n|----------------|--------------------------|\n| `experimental_transform` (chunk transform) | `onChunk` |\n| `experimental_repairToolCall` | `onBeforeToolCall` |\n| `prepareStep` (dynamic model/tools/messages) | `onConfig` + `onIteration` |\n| `wrapLanguageModel` logging | `onStart` + `onConfig` + `onFinish` |\n| Custom caching in `wrapGenerate` | `toolCacheMiddleware` or your own `onBeforeToolCall`/`onAfterToolCall` |\n| `experimental_telemetry` | Any terminal hook (`onFinish`/`onAbort`/`onError`) + your tracer |\n\n## Observability (logging, metrics, tracing)\n\nBoth libraries leave the wire to your tracer of choice (OpenTelemetry, Sentry, Datadog, …). The plug point differs:\n\n- **Vercel AI SDK**: `experimental_telemetry` on `streamText` + the lifecycle callbacks (`onChunk`, `onStepFinish`, `onFinish`, `onError`).\n- **TanStack AI**: a middleware with the hooks you need. `onStart` + `onFinish`/`onAbort`/`onError` covers request-level spans; `onChunk` + `onUsage` gives you fine-grained timing; `onBeforeToolCall`/`onAfterToolCall` for tool spans.\n\nBecause `ctx.requestId` and `ctx.streamId` are stable across hooks, you get one trace per request without threading IDs manually.\n\n## Provider Adapters\n\nTanStack AI uses activity-specific adapters for optimal tree-shaking.\n\n### OpenAI\n\n#### Before (Vercel AI SDK)\n\n```typescript ignore\nimport { openai } from '@ai-sdk/openai'\n\n// Chat\nstreamText({ model: openai('gpt-4o'), ... })\n\n// Embeddings\nembed({ model: openai.embedding('text-embedding-3-small'), ... })\n\n// Image generation\ngenerateImage({ model: openai.image('dall-e-3'), ... })\n```\n\n#### After (TanStack AI)\n\n```typescript ignore\nimport {\n  openaiText,\n  openaiImage,\n  openaiSpeech,\n  openaiEmbedding,\n} from '@tanstack/ai-openai'\n\n// Chat\nchat({ adapter: openaiText('gpt-4o'), ... })\n\n// Image generation\ngenerateImage({ adapter: openaiImage('dall-e-3'), ... })\n\n// Text to speech\ngenerateSpeech({ adapter: openaiSpeech('tts-1'), ... })\n\n// Embeddings\nembed({ adapter: openaiEmbedding('text-embedding-3-small'), ... })\n```\n\n### Anthropic\n\n#### Before (Vercel AI SDK)\n\n```typescript ignore\nimport { anthropic } from '@ai-sdk/anthropic'\n\nstreamText({ model: anthropic('claude-sonnet-4-5-20250514'), ... })\n```\n\n#### After (TanStack AI)\n\n```typescript ignore\nimport { anthropicText } from '@tanstack/ai-anthropic'\n\nchat({ adapter: anthropicText('claude-sonnet-4-5-20250514'), ... })\n```\n\n### Google (Gemini)\n\n#### Before (Vercel AI SDK)\n\n```typescript ignore\nimport { google } from '@ai-sdk/google'\n\nstreamText({ model: google('gemini-1.5-pro'), ... })\n```\n\n#### After (TanStack AI)\n\n```typescript ignore\nimport { geminiText } from '@tanstack/ai-gemini'\n\nchat({ adapter: geminiText('gemini-2.5-flash'), ... })\n```\n\n## Streaming Responses\n\n### Server Response Formats\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript ignore\n// UI message stream (default, for useChat)\nreturn result.toUIMessageStreamResponse()\n\n// Plain text stream\nreturn result.toTextStreamResponse()\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport {\n  chat,\n  toServerSentEventsResponse,\n  toServerSentEventsStream,\n  toHttpResponse,\n  toHttpStream,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst abortController = new AbortController()\nconst traceId = 'trace-123'\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nasync function handler() {\n  const stream = chat({ adapter: openaiText('gpt-4o'), messages })\n\n  // SSE response (recommended; pairs with fetchServerSentEvents on the client).\n  // Both response helpers accept a ResponseInit with an optional abortController\n  // — merge custom headers, status, or cancellation without unwrapping the helper.\n  return toServerSentEventsResponse(stream, {\n    abortController,\n    status: 200,\n    headers: { 'X-Trace-Id': traceId },\n  })\n}\n\nasync function handler2() {\n  const stream = chat({ adapter: openaiText('gpt-4o'), messages })\n\n  // Newline-delimited JSON response (pairs with fetchHttpStream on the client).\n  return toHttpResponse(stream, { abortController })\n}\n\n// Or grab the raw ReadableStream if you need to pipe it somewhere else\n// (writing to a Node ServerResponse, wrapping in a transform, etc.).\nconst stream2 = chat({ adapter: openaiText('gpt-4o'), messages })\nconst sseStream = toServerSentEventsStream(stream2, abortController)\nconst ndjsonStream = toHttpStream(stream2, abortController)\n```\n\n### Client Connection Adapters\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { DefaultChatTransport } from 'ai'\nimport { useChat } from '@ai-sdk/react'\n\nuseChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { useChat, fetchServerSentEvents, fetchHttpStream, stream } from '@tanstack/ai-react'\nimport { customServerFn } from './server'\n\n// SSE (matches toServerSentEventsResponse)\nuseChat({ connection: fetchServerSentEvents('/api/chat') })\n\n// HTTP stream (matches toHttpResponse / toHttpStream on the server)\nuseChat({ connection: fetchHttpStream('/api/chat') })\n\n// Custom adapter: return an AsyncIterable<StreamChunk>, e.g. from a TanStack\n// Start server function or an RPC client\nuseChat({\n  connection: stream((messages, data) => customServerFn({ messages, data })),\n})\n```\n\n## AbortController / Cancellation\n\n### Before (Vercel AI SDK)\n\n```typescript ignore\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  abortSignal: controller.signal,\n})\n```\n\n### After (TanStack AI)\n\nTanStack AI takes an `AbortController` (not a bare signal) so helpers like `toServerSentEventsStream` can wire cancellation into the response stream for you.\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\nconst abortController = new AbortController()\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  messages,\n  abortController,\n})\n\n// Cancel the stream\nabortController.abort()\n```\n\n## Callbacks and Events\n\n### Stream Callbacks\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { DefaultChatTransport } from 'ai'\nimport { useChat } from '@ai-sdk/react'\n\nconst { messages } = useChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n  onFinish: ({ message }) => console.log('Finished:', message),\n  onError: (error) => console.error('Error:', error),\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents('/api/chat'),\n  onResponse: (response) => console.log('Response started'),\n  onChunk: (chunk) => console.log('Chunk received:', chunk),\n  onFinish: (message) => console.log('Finished:', message),\n  onError: (error) => console.error('Error:', error),\n})\n```\n\nTanStack AI also lets you hook into the **server-side** stream lifecycle by subscribing to the async iterable returned from `chat()`, which preserves the full typed `StreamChunk` union — useful for logging, analytics, or sending custom SSE events alongside the response.\n\n## Multimodal Content\n\n### Image Inputs\n\n#### Before (Vercel AI SDK)\n\n```typescript\nimport { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { imageUrl } from './images'\n\nstreamText({\n  model: openai('gpt-4o'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', text: 'Describe this image' },\n        { type: 'image', image: imageUrl },\n      ],\n    },\n  ],\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { imageUrl, imageData } from './images'\n\nchat({\n  adapter: openaiText('gpt-4o'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', content: 'Describe this image' },\n        { type: 'image', source: { type: 'url', value: imageUrl } },\n        // Or inline base64 data\n        { type: 'image', source: { type: 'data', value: imageData, mimeType: 'image/png' } },\n      ],\n    },\n  ],\n})\n```\n\n> The source discriminant is `'url'` or `'data'`. Both carry the payload on `value` (a URL or base64 string). `mimeType` is required for `'data'` and optional for `'url'`.\n\n## Dynamic Provider Switching\n\n### Before (Vercel AI SDK)\n\n```typescript\nimport { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { anthropic } from '@ai-sdk/anthropic'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst providers = {\n  openai: openai('gpt-4o'),\n  anthropic: anthropic('claude-sonnet-4-5-20250514'),\n}\n\nconst selectedProvider: keyof typeof providers = 'openai'\n\nstreamText({\n  model: providers[selectedProvider],\n  messages,\n})\n```\n\n### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { anthropicText } from '@tanstack/ai-anthropic'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst adapters = {\n  openai: () => openaiText('gpt-4o'),\n  anthropic: () => anthropicText('claude-sonnet-4-5'),\n} as const\n\nconst selectedProvider: keyof typeof adapters = 'openai'\n\nchat({\n  adapter: adapters[selectedProvider](),\n  messages,\n})\n```\n\n## Type Safety Enhancements\n\nTanStack AI provides enhanced type safety that Vercel AI SDK doesn't offer:\n\n### Typed Message Parts\n\n```typescript\nimport { createChatClientOptions, type InferChatMessages } from '@tanstack/ai-client'\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { updateUI, saveData } from './tools'\n\nconst tools = [updateUI, saveData]\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents('/api/chat'),\n  tools,\n})\n\n// Infer fully typed messages\ntype ChatMessages = InferChatMessages<typeof chatOptions>\n\n// Now TypeScript knows:\n// - Exact tool names available\n// - Input types for each tool\n// - Output types for each tool\n```\n\n### Per-Model Type Safety\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\nconst adapter = openaiText('gpt-4o')\n\nchat({\n  adapter,\n  messages,\n  modelOptions: {\n    // TypeScript autocompletes options specific to gpt-4o\n    service_tier: 'default',\n    store: true,\n  },\n})\n```\n\n## Non-streaming Generation (`generateText`)\n\nTanStack AI has no separate `generateText` function. The same `chat()` covers both modes. Pass `stream: false` and the return type changes from `AsyncIterable<StreamChunk>` to `Promise<ChatResult>`:\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst { text, chunks } = await chat({\n  adapter: openaiText('gpt-4o'),\n  messages: [{ role: 'user', content: 'Summarize TanStack AI in one sentence.' }],\n  stream: false,\n})\n// text: string\n// chunks: every chunk of the run (tool calls, usage, RUN_FINISHED)\n```\n\nIf you already have a stream, `streamToText(stream)` reads it to the end and returns the same `{ text, chunks }` result:\n\n```typescript\nimport { chat, streamToText } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\nconst stream = chat({ adapter: openaiText('gpt-4o'), messages })\nconst { text } = await streamToText(stream)\n```\n\nFor structured (non-streaming) output — the `generateObject` equivalent — pass `outputSchema` instead; see [Structured Output](#structured-output).\n\n## Embeddings\n\nVercel's `embed` and `embedMany` both map to TanStack AI's single `embed()` function — `input` accepts one item or an array, and the result always carries one vector per input item.\n\n### Before (Vercel AI SDK)\n\n```typescript\nimport { embed, embedMany } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst { embedding } = await embed({\n  model: openai.embedding('text-embedding-3-small'),\n  value: 'Hello, world!',\n})\n\nconst { embeddings } = await embedMany({\n  model: openai.embedding('text-embedding-3-small'),\n  values: ['one', 'two'],\n})\n```\n\n### After (TanStack AI)\n\n```typescript\nimport { embed } from '@tanstack/ai'\nimport { openaiEmbedding } from '@tanstack/ai-openai'\n\nconst single = await embed({\n  adapter: openaiEmbedding('text-embedding-3-small'),\n  input: 'Hello, world!',\n})\nconst vector = single.embeddings[0]?.vector\n\nconst batch = await embed({\n  adapter: openaiEmbedding('text-embedding-3-small'),\n  input: ['one', 'two'],\n})\nconst vectors = batch.embeddings.map((e) => e.vector)\n```\n\nTanStack AI's `embed()` additionally supports multimodal (text + image) inputs for models like Cohere embed-v4.0 and Amazon Titan Multimodal — see the [Embeddings guide](../embeddings.md).\n\n## Features Not Yet Covered\n\nA few AI SDK features don't have direct TanStack AI equivalents today:\n\n### Partial object streaming (`streamObject().elementStream` / `partialObjectStream`)\n\nTanStack AI's `outputSchema` always returns a `Promise<T>` once the full response has validated. If you need to render partial JSON as it streams, stay on `streamText` + `onChunk` for that specific case (or parse from TanStack's raw stream with your own incremental JSON parser).\n\n### Built-in retries and timeouts\n\nVercel's `maxRetries` / `timeout` options have no direct `chat()` equivalent. Use `AbortSignal.timeout(ms)` via `abortController`, and add retries in a custom middleware or in your fetch layer.\n\n## Complete Migration Example\n\n> On the Vercel side, the v5+ server handler runs incoming UI messages through `convertToModelMessages(messages)` before handing them to `streamText`. TanStack AI's `chat()` accepts the UI-message shape directly — its adapters do the conversion internally — so the equivalent line simply disappears on the After side.\n\n### Before (Vercel AI SDK v5+)\n\n```tsx\n// server/api/chat.ts\nimport { streamText, tool, convertToModelMessages, DefaultChatTransport } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { useChat } from '@ai-sdk/react'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\nimport { useState } from 'react'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const result = streamText({\n    model: openai('gpt-4o'),\n    system: 'You are a helpful assistant.',\n    messages: await convertToModelMessages(messages),\n    temperature: 0.7,\n    tools: {\n      getWeather: tool({\n        description: 'Get weather',\n        inputSchema: z.object({ city: z.string() }),\n        execute: async ({ city }) => fetchWeather(city),\n      }),\n    },\n  })\n\n  return result.toUIMessageStreamResponse()\n}\n\n// components/Chat.tsx\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, status } = useChat({\n    transport: new DefaultChatTransport({ api: '/api/chat' }),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && status !== 'streaming') {\n      sendMessage({ text: input })\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.parts.map((p, i) => (p.type === 'text' ? <span key={i}>{p.text}</span> : null))}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n          disabled={status === 'streaming'}\n        />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}\n```\n\n### After (TanStack AI)\n\n```tsx ignore\n// server/api/chat.ts\nimport { chat, toServerSentEventsResponse, toolDefinition } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\n\nconst getWeatherDef = toolDefinition({\n  name: 'getWeather',\n  description: 'Get weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temp: z.number(), conditions: z.string() }),\n})\n\nconst getWeather = getWeatherDef.server(async ({ city }) => fetchWeather(city))\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    systemPrompts: ['You are a helpful assistant.'],\n    messages,\n    temperature: 0.7,\n    tools: [getWeather],\n  })\n\n  return toServerSentEventsResponse(stream)\n}\n\n// components/Chat.tsx\nimport { useState } from 'react'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && !isLoading) {\n      sendMessage(input)\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((message) => (\n        <div key={message.id}>\n          {message.parts.map((part, idx) =>\n            part.type === 'text' ? <span key={idx}>{part.content}</span> : null\n          )}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n          disabled={isLoading}\n        />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}\n```\n\n## Need Help?\n\nIf you hit something that isn't covered here, the deep-dive docs pick up where this guide stops:\n\n1. [Quick Start](../getting-started/quick-start) — minimal working setup\n2. [Tools](../tools/tools), [Tool Architecture](../tools/tool-architecture), and [Tool Approval](../tools/tool-approval) — the isomorphic tool system\n3. [Agentic Cycle](../chat/agentic-cycle) — agent loop internals and strategy composition\n4. [Structured Outputs](../structured-outputs/overview) — `outputSchema`, provider implementations, schema libraries\n5. [Middleware](../advanced/middleware) — full hook reference, context object, built-in middleware\n6. [Transports](../transports/overview) — SSE, HTTP stream, custom transports\n7. [Per-Model Type Safety](../advanced/per-model-type-safety) — how `modelOptions` is typed\n8. [API Reference](../api/ai) — every exported symbol\n","originalRawMarkdown":"---\ntitle: Migration from Vercel AI SDK\nid: migration-from-vercel-ai\norder: 2\ndescription: \"Port an app from the Vercel AI SDK (ai / @ai-sdk/*) to TanStack AI — option-by-option mapping of streamText, generateText, generateObject, useChat, tools, middleware, structured output, and the agent loop.\"\nkeywords:\n  - tanstack ai\n  - vercel ai sdk\n  - migration\n  - streamText\n  - generateText\n  - generateObject\n  - useChat\n  - ai sdk v5\n  - ai sdk v6\n  - middleware\n  - agent loop\n---\n\nThis guide helps you migrate from the Vercel AI SDK (`ai` + `@ai-sdk/*`) to TanStack AI. Both libraries cover the same problem space — LLM calls, streaming, tool use, structured output, framework hooks — but TanStack AI uses a different architecture with enhanced type safety, tree-shakeable adapters, an isomorphic tool system, and a first-class middleware pipeline.\n\nThe \"Before\" examples target **AI SDK v5 and v6**. Older v4 naming is called out inline where it differs.\n\n## Why Migrate?\n\nTanStack AI provides several advantages:\n\n- **Tree-shakeable adapters** - Import only what you need, reducing bundle size\n- **Isomorphic tools** - Define tools once, implement for server and client separately\n- **Per-model type safety** - TypeScript knows exact options available for each model\n- **Framework agnostic** - Works with React, Vue, Solid, Svelte, and vanilla JS\n- **Full streaming type safety** - Typed stream chunks and message parts\n\n## Quick Reference\n\n| Vercel AI SDK | TanStack AI |\n|--------------|-------------|\n| `ai` | `@tanstack/ai` |\n| `@ai-sdk/openai` | `@tanstack/ai-openai` |\n| `@ai-sdk/anthropic` | `@tanstack/ai-anthropic` |\n| `@ai-sdk/google` | `@tanstack/ai-gemini` |\n| `@ai-sdk/google-vertex` | `@tanstack/ai-vertex` (Gemini), `@tanstack/ai-anthropic/vertex` (Claude), `@tanstack/ai-grok/vertex` (Grok), and `@tanstack/ai-mistral/vertex` (Mistral) |\n| `@ai-sdk/react` | `@tanstack/ai-react` |\n| `@ai-sdk/vue` | `@tanstack/ai-vue` |\n| `@ai-sdk/solid` | `@tanstack/ai-solid` |\n| `@ai-sdk/svelte` | `@tanstack/ai-svelte` |\n\n> **Note:** Since AI SDK v5, framework hooks moved from `ai/react` (v4) to dedicated packages like `@ai-sdk/react`. If you are on v4, swap the old subpaths for their v5 equivalents.\n\n## Installation\n\n### Before (Vercel AI SDK)\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: ai @ai-sdk/react @ai-sdk/openai @ai-sdk/anthropic\n\n<!-- ::end:tabs -->\n\n### After (TanStack AI)\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"install\" -->\n\nreact: @tanstack/ai @tanstack/ai-react @tanstack/ai-openai @tanstack/ai-anthropic\nvue: @tanstack/ai @tanstack/ai-vue @tanstack/ai-openai @tanstack/ai-anthropic\nsolid: @tanstack/ai @tanstack/ai-solid @tanstack/ai-openai @tanstack/ai-anthropic\nsvelte: @tanstack/ai @tanstack/ai-svelte @tanstack/ai-openai @tanstack/ai-anthropic\npreact: @tanstack/ai @tanstack/ai-preact @tanstack/ai-openai @tanstack/ai-anthropic\nangular: @tanstack/ai @tanstack/ai-angular @tanstack/ai-openai @tanstack/ai-anthropic\nvanilla: @tanstack/ai @tanstack/ai-client @tanstack/ai-openai @tanstack/ai-anthropic\noctane: @tanstack/ai @tanstack/ai-octane @tanstack/ai-openai @tanstack/ai-anthropic octane\n\n<!-- ::end:tabs -->\n\n## Server-Side Migration\n\n### Basic Text Generation\n\n#### Before (Vercel AI SDK)\n\n```typescript\nimport { streamText, convertToModelMessages } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const result = streamText({\n    model: openai('gpt-4o'),\n    messages: await convertToModelMessages(messages),\n  })\n\n  return result.toUIMessageStreamResponse()\n  // (v4: result.toDataStreamResponse())\n}\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n  })\n\n  return toServerSentEventsResponse(stream)\n}\n```\n\n### Key Differences\n\n| Vercel AI SDK | TanStack AI | Notes |\n|--------------|-------------|-------|\n| `streamText()` | `chat()` | Main text generation function |\n| `generateText()` | `chat({ stream: false })` | Returns `Promise<{ text, chunks }>` |\n| `generateObject()` / `streamObject()` / `Output.object()` | `chat({ outputSchema })` | Returns `Promise<T>` — see [Structured Output](#structured-output) |\n| `openai('gpt-4o')` | `openaiText('gpt-4o')` | Activity-specific adapters |\n| `result.toUIMessageStreamResponse()` / `.toTextStreamResponse()` | `toServerSentEventsResponse(stream)` / `toHttpResponse(stream)` | Separate utility functions |\n| `model` parameter | `adapter` parameter | Model baked into adapter |\n\n### Full `streamText` → `chat()` Option Mapping\n\nOptions accepted by `streamText` as of AI SDK v6, and where each lives in TanStack AI's `chat()`. Options that exist on both sides keep the same semantics unless noted.\n\n| `streamText` option | `chat()` equivalent | Notes |\n|--------------------|--------------------|-------|\n| `model: openai('gpt-4o')` | `adapter: openaiText('gpt-4o')` | Activity-specific adapters |\n| `prompt: 'Hello'` | `messages: [{ role: 'user', content: 'Hello' }]` | TanStack is messages-only |\n| `messages` | `messages` | Same concept; content parts differ (see [Multimodal](#multimodal-content)) |\n| `system: 'You are…'` | `systemPrompts: ['You are…']` | Root-level `string[]` |\n| `tools: { name: tool({…}) }` | `tools: [toolInstance, …]` | Array of tool instances instead of a keyed object |\n| `toolChoice: 'auto' \\| 'required' \\| 'none' \\| { type, toolName }` | `modelOptions.toolChoice` (provider-specific) | Not a top-level option — set on the adapter's `modelOptions` |\n| `activeTools: string[]` | Filter `tools` yourself, or use `prepareStep` equivalent via middleware | No dedicated option — see [Middleware](#middleware) for dynamic tool filtering |\n| `maxOutputTokens` | `maxTokens` | Renamed to match the original OpenAI naming |\n| `temperature` | `temperature` | Same |\n| `topP` | `topP` | Same |\n| `topK` | `modelOptions.topK` (where the provider supports it) | Lives under typed `modelOptions` |\n| `presencePenalty` | `modelOptions.presencePenalty` | Lives under typed `modelOptions` |\n| `frequencyPenalty` | `modelOptions.frequencyPenalty` | Lives under typed `modelOptions` |\n| `seed` | `modelOptions.seed` | Lives under typed `modelOptions` |\n| `stopSequences` | `modelOptions.stop` (provider-specific) | Lives under typed `modelOptions` |\n| `maxRetries` | Wrap your fetch/adapter, or add a retry `middleware` | Not built into `chat()` |\n| `timeout` | Combine `abortController` + `AbortSignal.timeout(ms)` | Not built into `chat()` |\n| `abortSignal: controller.signal` | `abortController: controller` | Pass the controller itself, not just the signal |\n| `headers` | Configure on the adapter (e.g., `openaiText({ headers })`) | Not a per-call option |\n| `providerOptions: { openai: { … } }` | `modelOptions: { … }` | Flat; the adapter already knows which provider it is. Typed per model |\n| `stopWhen: stepCountIs(5)` | `agentLoopStrategy: maxIterations(5)` | See [Agent Loop Control](#agent-loop-control) |\n| `stopWhen: hasToolCall('x')` | Custom `AgentLoopStrategy` that inspects `messages` | No built-in \"stop on specific tool\" preset yet — one-liner custom strategy; see [Agent Loop Control](#agent-loop-control) |\n| `stopWhen: [a, b]` | `agentLoopStrategy: combineStrategies([a, b])` | Multiple conditions, AND semantics |\n| `prepareStep` | `middleware` with `onConfig`/`onIteration` | See [Middleware](#middleware) |\n| `experimental_transform` | `middleware.onChunk` (transform / drop / expand chunks) | See [Middleware](#middleware) |\n| `experimental_context` | `context` (root-level) | Typed runtime context passed to middleware hooks and tool implementations |\n| `experimental_telemetry` | `middleware` + your tracer of choice | See [Observability](#observability-logging-metrics-tracing) |\n| `experimental_repairToolCall` | `middleware.onBeforeToolCall` | Return transformed args or a decision |\n| `experimental_download` | Preprocess your `messages` before calling `chat()` | No built-in hook |\n| `onChunk` (streamText) | `middleware.onChunk` | Also reachable by consuming the returned iterable |\n| `onError` | `middleware.onError` | Terminal hook |\n| `onStepFinish` | `middleware.onIteration` / `onToolPhaseComplete` / `onUsage` | Split into finer-grained hooks |\n| `onFinish` | `middleware.onFinish` | Terminal hook |\n| `onAbort` | `middleware.onAbort` | Terminal hook |\n| `output: Output.object({ schema })` | `outputSchema` | See [Structured Output](#structured-output) |\n| — | `conversationId` / `threadId` / `runId` | TanStack-only, for correlating requests across your system and AG-UI |\n\n### `streamText` result → TanStack AI equivalents\n\n`streamText` returns an object with accessor promises; TanStack AI returns the stream directly. Everything you can pull off that object is available via stream consumption, middleware, or response helpers.\n\n| `streamText` result member | TanStack AI equivalent |\n|---------------------------|------------------------|\n| `result.textStream` | Filter the async iterable: `for await (const c of stream) if (c.type === 'text-delta') …` |\n| `result.fullStream` | The `stream` returned by `chat()` **is** the full stream (`AsyncIterable<StreamChunk>`) |\n| `result.text` | `(await streamToText(stream)).text` or `(await chat({ …, stream: false })).text` |\n| `result.content` | Accumulate parts in `middleware.onChunk`, or read the final `UIMessage` in `onFinish` |\n| `result.toolCalls` / `result.toolResults` | Read from chunks in `middleware.onChunk` / `onAfterToolCall`, or from `chunks` on the `stream: false` result |\n| `result.usage` / `result.totalUsage` | `middleware.onUsage(ctx, usage)` |\n| `result.finishReason` | `middleware.onFinish(ctx, info)` |\n| `result.steps` | Accumulate via `middleware.onIteration` / `onToolPhaseComplete` |\n| `result.toUIMessageStreamResponse()` | `toServerSentEventsResponse(stream)` |\n| `result.toTextStreamResponse()` | Collect with `streamToText(stream)` and return a plain `Response`, **or** pair with the client's `fetchHttpStream` via `toHttpResponse(stream)` |\n| `result.pipeUIMessageStreamToResponse(res)` | `toServerSentEventsStream(stream).pipeTo(…)` |\n| `result.consumeStream()` | `for await (const _ of stream) {}` |\n\n### Generation Options\n\nTanStack AI promotes a small, cross-provider set of options to the top level (`temperature`, `topP`, `maxTokens`) and pushes everything provider-specific into a single typed `modelOptions` bag. There's no `providerOptions: { openai: {…} }` nesting — the adapter already knows which provider it is, so `modelOptions` is flat and typed against the selected model.\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  temperature: 0.7,\n  maxOutputTokens: 1000, // (v5+); `maxTokens` on v4\n  topP: 0.9,\n  topK: 40,\n  presencePenalty: 0.1,\n  frequencyPenalty: 0.1,\n  seed: 42,\n  stopSequences: ['\\n\\nUser:'],\n  // Provider-specific options (v5+)\n  providerOptions: {\n    openai: {\n      responseFormat: { type: 'json_object' },\n    },\n  },\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  messages,\n  // Provider-specific options typed for gpt-4o specifically\n  modelOptions: {\n    temperature: 0.7,\n    max_output_tokens: 1000,\n    top_p: 0.9,\n    service_tier: 'default',\n    store: true,\n    parallel_tool_calls: false,\n  },\n})\n```\n\n> Autocomplete in `modelOptions` reflects the **exact** adapter and model you passed. Swap `openaiText('gpt-4o')` for `anthropicText('claude-sonnet-4-5')` and the shape changes to match Anthropic's options.\n\n### System Messages\n\nTanStack AI accepts system prompts at the **root level** via the `systemPrompts` option. You pass an array of strings, and each adapter merges them into whatever format the provider expects. You don't manually prepend a `system` message to the `messages` array.\n\n#### Before (Vercel AI SDK)\n\n```typescript\nimport { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  system: 'You are a helpful assistant.',\n  messages,\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  systemPrompts: ['You are a helpful assistant.'],\n  messages,\n})\n```\n\nMultiple system prompts are supported — useful for composing persona, policies, and tool-usage guidance without string concatenation:\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  systemPrompts: [\n    'You are a helpful assistant.',\n    'Respond in concise, plain English.',\n    'Never fabricate citations.',\n  ],\n  messages,\n})\n```\n\n## Client-Side Migration\n\n### Basic useChat Hook\n\n#### Before (Vercel AI SDK v5+)\n\n```tsx\nimport { useChat } from '@ai-sdk/react'\nimport { DefaultChatTransport } from 'ai'\nimport { useState } from 'react'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, status } = useChat({\n    transport: new DefaultChatTransport({ api: '/api/chat' }),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && status !== 'streaming') {\n      sendMessage({ text: input })\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.role}:{' '}\n          {m.parts.map((p, i) => (p.type === 'text' ? <span key={i}>{p.text}</span> : null))}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input value={input} onChange={(e) => setInput(e.target.value)} />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}\n```\n\n#### After (TanStack AI)\n\n```tsx\nimport { useState } from 'react'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && !isLoading) {\n      sendMessage(input)\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((message) => (\n        <div key={message.id}>\n          {message.role}:{' '}\n          {message.parts.map((part, idx) =>\n            part.type === 'text' ? <span key={idx}>{part.content}</span> : null\n          )}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input value={input} onChange={(e) => setInput(e.target.value)} />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}\n```\n\n### useChat API Differences\n\nVercel AI SDK v5+ already moved away from the magic `input`/`handleInputChange`/`handleSubmit` of v4 and now expects you to manage your own input state. TanStack AI follows that same philosophy — the hook is headless and gives you building blocks instead of form glue.\n\n| Vercel AI SDK (v5+) | TanStack AI | Notes |\n|--------------------|-------------|-------|\n| `transport: new DefaultChatTransport({ api: '/api/chat' })` | `connection: fetchServerSentEvents('/api/chat')` | Pluggable connection adapter |\n| `sendMessage({ text })` | `sendMessage(text)` | Accepts plain string; pass `UIMessage` objects via `append()` |\n| `status` (`'submitted' \\| 'streaming' \\| 'ready' \\| 'error'`) | `isLoading` (boolean) | Coarser in TanStack; full stream state available via events |\n| `regenerate()` | `reload()` | Re-runs the last assistant turn |\n| `stop()` | `stop()` | Cancel the in-flight stream |\n| `setMessages(messages)` | `setMessages(messages)` | Direct message replacement |\n| `addToolOutput({ tool, toolCallId, output })` (v6; was `addToolResult` in v5) | `addToolResult({ tool, toolCallId, output })` | Resolve a client-side tool call |\n| `addToolApprovalResponse({ id, approved })` (v6) | `addToolApprovalResponse({ id, approved })` | First-class user-approval flow for tools |\n| `m.parts` (typed union) | `message.parts` (typed union) | Both render via structured parts |\n\n### Message Structure\n\n#### Before (Vercel AI SDK)\n\n```typescript ignore\ninterface Message {\n  id: string\n  role: 'user' | 'assistant' | 'system'\n  content: string\n  toolInvocations?: ToolInvocation[]\n}\n```\n\n#### After (TanStack AI)\n\nThese are the `@tanstack/ai-client` shapes (what `useChat` gives you). The core `@tanstack/ai` message types are similar, but `input` (parsed tool input) is a client-layer projection — server-side code reads the raw JSON from `arguments` directly.\n\n```typescript ignore\ninterface UIMessage<TTools extends ReadonlyArray<AnyClientTool> = any> {\n  id: string\n  role: 'system' | 'user' | 'assistant'\n  parts: Array<MessagePart<TTools>>\n  createdAt?: Date\n}\n\ntype MessagePart<TTools> =\n  | TextPart\n  | ToolCallPart<TTools>\n  | ToolResultPart\n  | ThinkingPart\n\ninterface TextPart {\n  type: 'text'\n  content: string\n}\n\ninterface ThinkingPart {\n  type: 'thinking'\n  content: string\n}\n\ninterface ToolCallPart {\n  type: 'tool-call'\n  id: string\n  name: string\n  arguments: string          // Raw JSON string (may be partial while streaming)\n  input?: unknown            // Parsed input (typed when tools are typed)\n  output?: unknown           // Execution output once available\n  state: ToolCallState\n  approval?: {\n    id: string               // Approval request ID\n    needsApproval: boolean\n    approved?: boolean       // undefined until the user responds\n  }\n}\n\ninterface ToolResultPart {\n  type: 'tool-result'\n  toolCallId: string\n  content: string\n  state: ToolResultState\n  error?: string             // Present when state is 'error'\n}\n\ntype ToolCallState =\n  | 'awaiting-input'\n  | 'input-streaming'\n  | 'input-complete'\n  | 'approval-requested'\n  | 'approval-responded'\n\ntype ToolResultState = 'streaming' | 'complete' | 'error'\n```\n\n> TanStack AI does not have separate `reasoning`, `source-url`, `source-document`, or `file` part types that you may have seen in other SDKs. Provider-specific reasoning traces arrive as `thinking` parts; citations and inline files are surfaced through `metadata` on text parts or through your tool outputs.\n\n### Rendering Messages\n\n#### Before (Vercel AI SDK)\n\n```tsx ignore\n{messages.map((m) => (\n  <div key={m.id}>\n    {m.role}: {m.content}\n    {m.toolInvocations?.map((tool) => (\n      <div key={tool.toolCallId}>\n        Tool: {tool.toolName} - {JSON.stringify(tool.result)}\n      </div>\n    ))}\n  </div>\n))}\n```\n\n#### After (TanStack AI)\n\n```tsx ignore\n{messages.map((message) => (\n  <div key={message.id}>\n    {message.role}:{' '}\n    {message.parts.map((part, idx) => {\n      if (part.type === 'text') {\n        return <span key={idx}>{part.content}</span>\n      }\n      if (part.type === 'thinking') {\n        return <em key={idx}>Thinking: {part.content}</em>\n      }\n      if (part.type === 'tool-call') {\n        return (\n          <div key={part.id}>\n            Tool: {part.name} - {JSON.stringify(part.output)}\n          </div>\n        )\n      }\n      return null\n    })}\n  </div>\n))}\n```\n\n## Tools / Function Calling\n\nTanStack AI uses an isomorphic tool system where you define the schema once and implement it separately for server and client.\n\n### Basic Tool Definition\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { streamText, tool } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  tools: {\n    getWeather: tool({\n      description: 'Get weather for a location',\n      inputSchema: z.object({ // renamed from `parameters` in v5\n        location: z.string(),\n      }),\n      execute: async ({ location }) => {\n        const weather = await fetchWeather(location)\n        return weather\n      },\n    }),\n  },\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat, toolDefinition, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\n\n// Step 1: Define the tool schema\nconst getWeatherDef = toolDefinition({\n  name: 'getWeather',\n  description: 'Get weather for a location',\n  inputSchema: z.object({\n    location: z.string(),\n  }),\n  outputSchema: z.object({\n    temperature: z.number(),\n    conditions: z.string(),\n  }),\n})\n\n// Step 2: Create server implementation\nconst getWeather = getWeatherDef.server(async ({ location }) => {\n  const weather = await fetchWeather(location)\n  return weather\n})\n\n// Step 3: Use in chat\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    tools: [getWeather],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n### Tool Schema Differences\n\n| Vercel AI SDK | TanStack AI |\n|--------------|-------------|\n| `parameters` (v4) / `inputSchema` (v5+) | `inputSchema` |\n| N/A | `outputSchema` (optional — enables end-to-end type safety) |\n| `execute` inline on the server | `.server()` or `.client()` methods (isomorphic definition) |\n| Object with tool names as keys | Array of tool instances |\n\n### Client-Side Tools\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { DefaultChatTransport } from 'ai'\nimport { useChat } from '@ai-sdk/react'\n\nconst { messages, addToolOutput } = useChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n  onToolCall: async ({ toolCall }) => {\n    if (toolCall.toolName === 'showNotification') {\n      // v6: addToolOutput (was addToolResult in v5)\n      addToolOutput({\n        tool: 'showNotification',\n        toolCallId: toolCall.toolCallId,\n        output: { success: true },\n      })\n    }\n  },\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\nimport { toast } from './toast'\n\n// Define once (can be shared with server)\nconst showNotificationDef = toolDefinition({\n  name: 'showNotification',\n  description: 'Show a toast notification in the browser',\n  inputSchema: z.object({ message: z.string() }),\n  outputSchema: z.object({ success: z.boolean() }),\n})\n\n// Client implementation\nconst showNotification = showNotificationDef.client(({ message }) => {\n  toast(message)\n  return { success: true }\n})\n\n// Use in component — passing the client tools in the `tools` array wires each\n// tool's `.client(...)` handler to run automatically when the server-side\n// agent calls it; you don't need an onToolCall handler or an\n// addToolOutput/addToolResult call.\nconst { messages } = useChat({\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [showNotification],\n})\n```\n\n### Tool Approval Flow\n\nBoth libraries expose first-class human-in-the-loop approval. The shapes are similar — a tool opts in with `needsApproval: true`, the client renders UI on an `approval-requested` state, and you call `addToolApprovalResponse` with the approval ID.\n\n#### Before (Vercel AI SDK v6)\n\n```typescript\n// Tool definition (server)\nimport { tool, DefaultChatTransport, lastAssistantMessageIsCompleteWithApprovalResponses } from 'ai'\nimport { useChat } from '@ai-sdk/react'\nimport { z } from 'zod'\nimport { bookingService } from './booking'\n\nconst bookFlight = tool({\n  description: 'Book a flight',\n  inputSchema: z.object({ flightId: z.string() }),\n  needsApproval: true, // v6: first-class approval\n  execute: async ({ flightId }) => bookingService.book(flightId),\n})\n\n// Client\nconst { messages, addToolApprovalResponse } = useChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n  sendAutomaticallyWhen: lastAssistantMessageIsCompleteWithApprovalResponses,\n})\n```\n\n#### After (TanStack AI)\n\n```tsx ignore\n// Built-in approval support\nconst bookFlightDef = toolDefinition({\n  name: 'bookFlight',\n  description: 'Book a flight on behalf of the user',\n  inputSchema: z.object({ flightId: z.string() }),\n  needsApproval: true, // Request user approval\n})\n\n// In component\nconst { messages, addToolApprovalResponse } = useChat({\n  connection: fetchServerSentEvents('/api/chat'),\n})\n\n// Render approval UI\n{message.parts.map((part, idx) => {\n  if (\n    part.type === 'tool-call' &&\n    part.state === 'approval-requested' &&\n    part.approval\n  ) {\n    return (\n      <div key={idx}>\n        <p>Approve booking flight {part.input?.flightId}?</p>\n        <button\n          onClick={() => addToolApprovalResponse({ id: part.approval!.id, approved: true })}\n        >\n          Approve\n        </button>\n        <button\n          onClick={() => addToolApprovalResponse({ id: part.approval!.id, approved: false })}\n        >\n          Deny\n        </button>\n      </div>\n    )\n  }\n  return null\n})}\n```\n\n> `part.input` is the **parsed** tool input (typed when you pass a typed `tools` array). The raw streaming JSON is available as `part.arguments` if you need to show progress before input parsing completes.\n\n## Structured Output\n\nThis section covers the `generateObject` / `streamObject` / `Output.object(...)` migration path. In AI SDK v6, structured generation lives on `generateText` / `streamText` via the `output:` parameter (e.g. `Output.object({ schema })`). The dedicated `generateObject` / `streamObject` functions are deprecated but still present. TanStack AI follows the same \"one function\" philosophy — pass `outputSchema` to `chat()` and it runs the full agentic loop (tools, retries, loop strategy) and returns a typed, validated value.\n\n### Before (Vercel AI SDK v6)\n\n```typescript\nimport { generateText, Output } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { z } from 'zod'\n\nconst { output } = await generateText({\n  model: openai('gpt-4o'),\n  prompt: 'Extract the user profile from this bio…',\n  output: Output.object({\n    schema: z.object({\n      name: z.string(),\n      age: z.number(),\n      interests: z.array(z.string()),\n    }),\n  }),\n})\n// output is typed as { name: string; age: number; interests: string[] }\n```\n\n### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\n\nconst profile = await chat({\n  adapter: openaiText('gpt-4o'),\n  messages: [{ role: 'user', content: 'Extract the user profile from this bio…' }],\n  outputSchema: z.object({\n    name: z.string(),\n    age: z.number(),\n    interests: z.array(z.string()),\n  }),\n})\n// profile: { name: string; age: number; interests: string[] }\n```\n\n### Notes\n\n- `outputSchema` accepts any **Standard Schema**-compatible library: **Zod v4.2+**, **ArkType v2.1.28+**, **Valibot v1.2+** (via `toStandardJsonSchema()`), or a plain JSON Schema object (which loses TS inference and falls back to `unknown`).\n- When `outputSchema` is set, `chat()` always returns a `Promise<T>` — the `stream` flag is ignored, because the value only makes sense once the schema has validated the final output.\n- Adapters implement structured output the best way for their provider: OpenAI uses `response_format: json_schema`, Anthropic uses tool-based extraction, Gemini uses `responseSchema`, Ollama uses JSON mode. You don't need to pick the strategy.\n- Arrays are just `z.array(z.object({ … }))`. TanStack AI does not yet stream partial objects the way `streamObject().elementStream` does on the Vercel side — if that's load-bearing, stay on `streamText` for now and migrate the object case when partial streaming lands.\n\n## Agent Loop Control\n\nBoth SDKs let the model call tools in a loop. The shape of the control knob is different:\n\n| Vercel AI SDK v6 | TanStack AI |\n|------------------|-------------|\n| `stopWhen: stepCountIs(5)` | `agentLoopStrategy: maxIterations(5)` |\n| `stopWhen: hasToolCall('bookFlight')` | Custom `AgentLoopStrategy` that inspects `messages` for the tool name |\n| `stopWhen: untilFinishReason(['stop'])` (custom condition) | `agentLoopStrategy: untilFinishReason(['stop'])` |\n| `stopWhen: [stepCountIs(20), hasToolCall('done')]` | `agentLoopStrategy: combineStrategies([maxIterations(20), /* your hasToolCall */ ])` |\n| `prepareStep({ stepNumber, messages, steps, model })` | `middleware.onConfig(ctx, config)` + `middleware.onIteration(ctx, info)` |\n\nDefault loop budget: TanStack AI defaults to `maxIterations(5)` if you don't pass a strategy.\n\n### Before (Vercel AI SDK v6)\n\n```typescript\nimport { streamText, stepCountIs } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { getWeather } from './tools'\n\nconst messages = [{ role: 'user' as const, content: 'What is the weather?' }]\n\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  tools: { getWeather },\n  stopWhen: stepCountIs(10),\n  prepareStep: async ({ stepNumber, messages: stepMessages }) => {\n    // log/rewrite messages between steps, filter tools, etc.\n    if (stepNumber > 0) return {}\n    return {}\n  },\n})\n```\n\n### After (TanStack AI)\n\n```typescript\nimport {\n  chat,\n  combineStrategies,\n  maxIterations,\n  untilFinishReason,\n  toServerSentEventsResponse,\n  type ChatMiddleware,\n  type ChatMiddlewareContext,\n  type ChatMiddlewareConfig,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { getWeather } from './tools'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    tools: [getWeather],\n    agentLoopStrategy: combineStrategies([\n      maxIterations(10),\n      untilFinishReason(['stop']), // stop when the model says it's done\n    ]),\n    middleware: [\n      {\n        // `prepareStep` analogue: inspect/rewrite config at the start of each iteration\n        onConfig: (ctx: ChatMiddlewareContext, config: ChatMiddlewareConfig) => {\n          if (ctx.iteration > 0) {\n            // e.g. return a Partial<ChatMiddlewareConfig> to filter tools, trim\n            // messages, or change modelOptions for this iteration\n            return undefined\n          }\n        },\n      } satisfies ChatMiddleware,\n    ],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n#### Mid-loop model switching\n\n`prepareStep` in AI SDK v6 lets you return a different `model` per step. TanStack AI doesn't support swapping the adapter inside a single `chat()` run — `modelOptions` is typed per adapter, which is what gives you compile-time model safety. The equivalent is to end the current loop (via an `agentLoopStrategy`) and start a new `chat()` with a different adapter, feeding it the in-progress messages:\n\n```typescript\nimport { chat, maxIterations } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { getWeather } from './tools'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\n// Stage 1: heavy model for the opening turn\nconst firstPass = await chat({\n  adapter: openaiText('gpt-4o'),\n  messages,\n  agentLoopStrategy: maxIterations(1),\n  stream: false,\n})\n\n// Stage 2: cheaper model for the rest\nconst followUp = chat({\n  adapter: openaiText('gpt-4o-mini'),\n  messages: [...messages, { role: 'assistant' as const, content: firstPass.text }],\n  tools: [getWeather],\n})\n```\n\n## Middleware\n\nAI SDK v6 has two middleware-ish extension points:\n\n1. **`wrapLanguageModel({ model, middleware })`** — provider-level interception (`transformParams`, `wrapGenerate`, `wrapStream`) for logging, caching, guardrails, RAG.\n2. **`experimental_transform`** on `streamText` — transforms the stream of chunks.\n\nTanStack AI collapses both into a single first-class `middleware: ChatMiddleware[]` option on `chat()`. It hooks into the full lifecycle, not just the model call or the chunk stream, and is the recommended place for logging, tracing, caching, redaction, and tool interception.\n\n### Before (Vercel AI SDK v6)\n\n```typescript\nimport { wrapLanguageModel, streamText, type LanguageModelMiddleware } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst loggingMiddleware = {\n  specificationVersion: 'v3' as const,\n  wrapGenerate: async ({ doGenerate, params }) => {\n    console.log('params', params)\n    const result = await doGenerate()\n    console.log('content', result.content)\n    return result\n  },\n  wrapStream: async ({ doStream, params }) => doStream(),\n  transformParams: async ({ params }) => params,\n} satisfies LanguageModelMiddleware\n\nconst wrapped = wrapLanguageModel({\n  model: openai('gpt-4o'),\n  middleware: [loggingMiddleware],\n})\n\nconst result = streamText({ model: wrapped, messages })\n```\n\n### After (TanStack AI)\n\n```typescript\nimport { chat, toServerSentEventsResponse, type ChatMiddleware } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\ntype AppContext = { userId: string }\n\nconst loggingMiddleware: ChatMiddleware<AppContext> = {\n  onStart: (ctx) => console.log('start', { requestId: ctx.requestId, userId: ctx.context.userId }),\n  onConfig: (ctx, config) => console.log('config', config),\n  onChunk:  (ctx, chunk) => { /* observe or transform; return null to drop */ },\n  onUsage:  (ctx, usage) => console.log('usage', usage),\n  onFinish: (ctx, info)  => console.log('finish', info),\n  onError:  (ctx, err)   => console.error('error', err),\n}\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    middleware: [loggingMiddleware],\n    context: { userId: 'u_123' }, // passed to every hook as typed ctx.context\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n### Full hook inventory\n\nEach middleware is a plain object. Every hook is optional, so pick what you need.\n\n| Hook | Called when | Can transform? |\n|------|-------------|----------------|\n| `onStart(ctx)` | Chat run starts | — |\n| `onConfig(ctx, config)` | Init + before each model call | Return `Partial<ChatMiddlewareConfig>` to mutate messages, systemPrompts, tools, temperature, etc. |\n| `onIteration(ctx, info)` | Start of each agent-loop iteration | — |\n| `onChunk(ctx, chunk)` | Every yielded `StreamChunk` | Return a chunk / array of chunks / `null` to drop |\n| `onBeforeToolCall(ctx, hookCtx)` | Before a tool executes | Return a `BeforeToolCallDecision` to rewrite args, skip, or abort |\n| `onAfterToolCall(ctx, info)` | After a tool executes (success or failure) | — |\n| `onToolPhaseComplete(ctx, info)` | All tools in an iteration done | — |\n| `onUsage(ctx, usage)` | Provider reports token usage | — |\n| `onFinish(ctx, info)` | Run finished normally (terminal) | — |\n| `onAbort(ctx, info)` | Run aborted (terminal) | — |\n| `onError(ctx, info)` | Unhandled error (terminal) | — |\n\n`ctx` carries `requestId`, `streamId`, `threadId`, `iteration`, `model`, `provider`, `systemPrompts`, `toolNames`, `messages`, `context` (your typed runtime value), `abort(reason)`, `defer(promise)`, `createId(prefix)`, and more. See [the middleware guide](../advanced/middleware) and [runtime context guide](../advanced/runtime-context) for the full reference.\n\n### Built-in: tool-call cache\n\nTanStack AI ships a `toolCacheMiddleware` that memoizes tool results by `name + args`. There's no direct Vercel equivalent — on the Vercel side you'd compose it yourself in `wrapGenerate` or inside each tool's `execute`. Example:\n\n```typescript\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { toolCacheMiddleware } from '@tanstack/ai/middlewares'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { searchDocs, getWeather } from './tools'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    messages,\n    tools: [searchDocs, getWeather],\n    middleware: [\n      toolCacheMiddleware({\n        maxSize: 100,\n        ttl: 5 * 60_000, // 5 minutes\n        toolNames: ['searchDocs'], // only cache these\n        // storage: redisStorage, // plug in Redis / localStorage / custom\n      }),\n    ],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n### Mapping common Vercel patterns to TanStack middleware\n\n| Vercel pattern | TanStack middleware hook |\n|----------------|--------------------------|\n| `experimental_transform` (chunk transform) | `onChunk` |\n| `experimental_repairToolCall` | `onBeforeToolCall` |\n| `prepareStep` (dynamic model/tools/messages) | `onConfig` + `onIteration` |\n| `wrapLanguageModel` logging | `onStart` + `onConfig` + `onFinish` |\n| Custom caching in `wrapGenerate` | `toolCacheMiddleware` or your own `onBeforeToolCall`/`onAfterToolCall` |\n| `experimental_telemetry` | Any terminal hook (`onFinish`/`onAbort`/`onError`) + your tracer |\n\n## Observability (logging, metrics, tracing)\n\nBoth libraries leave the wire to your tracer of choice (OpenTelemetry, Sentry, Datadog, …). The plug point differs:\n\n- **Vercel AI SDK**: `experimental_telemetry` on `streamText` + the lifecycle callbacks (`onChunk`, `onStepFinish`, `onFinish`, `onError`).\n- **TanStack AI**: a middleware with the hooks you need. `onStart` + `onFinish`/`onAbort`/`onError` covers request-level spans; `onChunk` + `onUsage` gives you fine-grained timing; `onBeforeToolCall`/`onAfterToolCall` for tool spans.\n\nBecause `ctx.requestId` and `ctx.streamId` are stable across hooks, you get one trace per request without threading IDs manually.\n\n## Provider Adapters\n\nTanStack AI uses activity-specific adapters for optimal tree-shaking.\n\n### OpenAI\n\n#### Before (Vercel AI SDK)\n\n```typescript ignore\nimport { openai } from '@ai-sdk/openai'\n\n// Chat\nstreamText({ model: openai('gpt-4o'), ... })\n\n// Embeddings\nembed({ model: openai.embedding('text-embedding-3-small'), ... })\n\n// Image generation\ngenerateImage({ model: openai.image('dall-e-3'), ... })\n```\n\n#### After (TanStack AI)\n\n```typescript ignore\nimport {\n  openaiText,\n  openaiImage,\n  openaiSpeech,\n  openaiEmbedding,\n} from '@tanstack/ai-openai'\n\n// Chat\nchat({ adapter: openaiText('gpt-4o'), ... })\n\n// Image generation\ngenerateImage({ adapter: openaiImage('dall-e-3'), ... })\n\n// Text to speech\ngenerateSpeech({ adapter: openaiSpeech('tts-1'), ... })\n\n// Embeddings\nembed({ adapter: openaiEmbedding('text-embedding-3-small'), ... })\n```\n\n### Anthropic\n\n#### Before (Vercel AI SDK)\n\n```typescript ignore\nimport { anthropic } from '@ai-sdk/anthropic'\n\nstreamText({ model: anthropic('claude-sonnet-4-5-20250514'), ... })\n```\n\n#### After (TanStack AI)\n\n```typescript ignore\nimport { anthropicText } from '@tanstack/ai-anthropic'\n\nchat({ adapter: anthropicText('claude-sonnet-4-5-20250514'), ... })\n```\n\n### Google (Gemini)\n\n#### Before (Vercel AI SDK)\n\n```typescript ignore\nimport { google } from '@ai-sdk/google'\n\nstreamText({ model: google('gemini-1.5-pro'), ... })\n```\n\n#### After (TanStack AI)\n\n```typescript ignore\nimport { geminiText } from '@tanstack/ai-gemini'\n\nchat({ adapter: geminiText('gemini-2.5-flash'), ... })\n```\n\n## Streaming Responses\n\n### Server Response Formats\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript ignore\n// UI message stream (default, for useChat)\nreturn result.toUIMessageStreamResponse()\n\n// Plain text stream\nreturn result.toTextStreamResponse()\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport {\n  chat,\n  toServerSentEventsResponse,\n  toServerSentEventsStream,\n  toHttpResponse,\n  toHttpStream,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst abortController = new AbortController()\nconst traceId = 'trace-123'\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nasync function handler() {\n  const stream = chat({ adapter: openaiText('gpt-4o'), messages })\n\n  // SSE response (recommended; pairs with fetchServerSentEvents on the client).\n  // Both response helpers accept a ResponseInit with an optional abortController\n  // — merge custom headers, status, or cancellation without unwrapping the helper.\n  return toServerSentEventsResponse(stream, {\n    abortController,\n    status: 200,\n    headers: { 'X-Trace-Id': traceId },\n  })\n}\n\nasync function handler2() {\n  const stream = chat({ adapter: openaiText('gpt-4o'), messages })\n\n  // Newline-delimited JSON response (pairs with fetchHttpStream on the client).\n  return toHttpResponse(stream, { abortController })\n}\n\n// Or grab the raw ReadableStream if you need to pipe it somewhere else\n// (writing to a Node ServerResponse, wrapping in a transform, etc.).\nconst stream2 = chat({ adapter: openaiText('gpt-4o'), messages })\nconst sseStream = toServerSentEventsStream(stream2, abortController)\nconst ndjsonStream = toHttpStream(stream2, abortController)\n```\n\n### Client Connection Adapters\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { DefaultChatTransport } from 'ai'\nimport { useChat } from '@ai-sdk/react'\n\nuseChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { useChat, fetchServerSentEvents, fetchHttpStream, stream } from '@tanstack/ai-react'\nimport { customServerFn } from './server'\n\n// SSE (matches toServerSentEventsResponse)\nuseChat({ connection: fetchServerSentEvents('/api/chat') })\n\n// HTTP stream (matches toHttpResponse / toHttpStream on the server)\nuseChat({ connection: fetchHttpStream('/api/chat') })\n\n// Custom adapter: return an AsyncIterable<StreamChunk>, e.g. from a TanStack\n// Start server function or an RPC client\nuseChat({\n  connection: stream((messages, data) => customServerFn({ messages, data })),\n})\n```\n\n## AbortController / Cancellation\n\n### Before (Vercel AI SDK)\n\n```typescript ignore\nconst result = streamText({\n  model: openai('gpt-4o'),\n  messages,\n  abortSignal: controller.signal,\n})\n```\n\n### After (TanStack AI)\n\nTanStack AI takes an `AbortController` (not a bare signal) so helpers like `toServerSentEventsStream` can wire cancellation into the response stream for you.\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\nconst abortController = new AbortController()\n\nconst stream = chat({\n  adapter: openaiText('gpt-4o'),\n  messages,\n  abortController,\n})\n\n// Cancel the stream\nabortController.abort()\n```\n\n## Callbacks and Events\n\n### Stream Callbacks\n\n#### Before (Vercel AI SDK v5+)\n\n```typescript\nimport { DefaultChatTransport } from 'ai'\nimport { useChat } from '@ai-sdk/react'\n\nconst { messages } = useChat({\n  transport: new DefaultChatTransport({ api: '/api/chat' }),\n  onFinish: ({ message }) => console.log('Finished:', message),\n  onError: (error) => console.error('Error:', error),\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents('/api/chat'),\n  onResponse: (response) => console.log('Response started'),\n  onChunk: (chunk) => console.log('Chunk received:', chunk),\n  onFinish: (message) => console.log('Finished:', message),\n  onError: (error) => console.error('Error:', error),\n})\n```\n\nTanStack AI also lets you hook into the **server-side** stream lifecycle by subscribing to the async iterable returned from `chat()`, which preserves the full typed `StreamChunk` union — useful for logging, analytics, or sending custom SSE events alongside the response.\n\n## Multimodal Content\n\n### Image Inputs\n\n#### Before (Vercel AI SDK)\n\n```typescript\nimport { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { imageUrl } from './images'\n\nstreamText({\n  model: openai('gpt-4o'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', text: 'Describe this image' },\n        { type: 'image', image: imageUrl },\n      ],\n    },\n  ],\n})\n```\n\n#### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { imageUrl, imageData } from './images'\n\nchat({\n  adapter: openaiText('gpt-4o'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', content: 'Describe this image' },\n        { type: 'image', source: { type: 'url', value: imageUrl } },\n        // Or inline base64 data\n        { type: 'image', source: { type: 'data', value: imageData, mimeType: 'image/png' } },\n      ],\n    },\n  ],\n})\n```\n\n> The source discriminant is `'url'` or `'data'`. Both carry the payload on `value` (a URL or base64 string). `mimeType` is required for `'data'` and optional for `'url'`.\n\n## Dynamic Provider Switching\n\n### Before (Vercel AI SDK)\n\n```typescript\nimport { streamText } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { anthropic } from '@ai-sdk/anthropic'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst providers = {\n  openai: openai('gpt-4o'),\n  anthropic: anthropic('claude-sonnet-4-5-20250514'),\n}\n\nconst selectedProvider: keyof typeof providers = 'openai'\n\nstreamText({\n  model: providers[selectedProvider],\n  messages,\n})\n```\n\n### After (TanStack AI)\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { anthropicText } from '@tanstack/ai-anthropic'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst adapters = {\n  openai: () => openaiText('gpt-4o'),\n  anthropic: () => anthropicText('claude-sonnet-4-5'),\n} as const\n\nconst selectedProvider: keyof typeof adapters = 'openai'\n\nchat({\n  adapter: adapters[selectedProvider](),\n  messages,\n})\n```\n\n## Type Safety Enhancements\n\nTanStack AI provides enhanced type safety that Vercel AI SDK doesn't offer:\n\n### Typed Message Parts\n\n```typescript\nimport { createChatClientOptions, type InferChatMessages } from '@tanstack/ai-client'\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { updateUI, saveData } from './tools'\n\nconst tools = [updateUI, saveData]\n\nconst chatOptions = createChatClientOptions({\n  connection: fetchServerSentEvents('/api/chat'),\n  tools,\n})\n\n// Infer fully typed messages\ntype ChatMessages = InferChatMessages<typeof chatOptions>\n\n// Now TypeScript knows:\n// - Exact tool names available\n// - Input types for each tool\n// - Output types for each tool\n```\n\n### Per-Model Type Safety\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\nconst adapter = openaiText('gpt-4o')\n\nchat({\n  adapter,\n  messages,\n  modelOptions: {\n    // TypeScript autocompletes options specific to gpt-4o\n    service_tier: 'default',\n    store: true,\n  },\n})\n```\n\n## Non-streaming Generation (`generateText`)\n\nTanStack AI has no separate `generateText` function. The same `chat()` covers both modes. Pass `stream: false` and the return type changes from `AsyncIterable<StreamChunk>` to `Promise<ChatResult>`:\n\n```typescript\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst { text, chunks } = await chat({\n  adapter: openaiText('gpt-4o'),\n  messages: [{ role: 'user', content: 'Summarize TanStack AI in one sentence.' }],\n  stream: false,\n})\n// text: string\n// chunks: every chunk of the run (tool calls, usage, RUN_FINISHED)\n```\n\nIf you already have a stream, `streamToText(stream)` reads it to the end and returns the same `{ text, chunks }` result:\n\n```typescript\nimport { chat, streamToText } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\nconst stream = chat({ adapter: openaiText('gpt-4o'), messages })\nconst { text } = await streamToText(stream)\n```\n\nFor structured (non-streaming) output — the `generateObject` equivalent — pass `outputSchema` instead; see [Structured Output](#structured-output).\n\n## Embeddings\n\nVercel's `embed` and `embedMany` both map to TanStack AI's single `embed()` function — `input` accepts one item or an array, and the result always carries one vector per input item.\n\n### Before (Vercel AI SDK)\n\n```typescript\nimport { embed, embedMany } from 'ai'\nimport { openai } from '@ai-sdk/openai'\n\nconst { embedding } = await embed({\n  model: openai.embedding('text-embedding-3-small'),\n  value: 'Hello, world!',\n})\n\nconst { embeddings } = await embedMany({\n  model: openai.embedding('text-embedding-3-small'),\n  values: ['one', 'two'],\n})\n```\n\n### After (TanStack AI)\n\n```typescript\nimport { embed } from '@tanstack/ai'\nimport { openaiEmbedding } from '@tanstack/ai-openai'\n\nconst single = await embed({\n  adapter: openaiEmbedding('text-embedding-3-small'),\n  input: 'Hello, world!',\n})\nconst vector = single.embeddings[0]?.vector\n\nconst batch = await embed({\n  adapter: openaiEmbedding('text-embedding-3-small'),\n  input: ['one', 'two'],\n})\nconst vectors = batch.embeddings.map((e) => e.vector)\n```\n\nTanStack AI's `embed()` additionally supports multimodal (text + image) inputs for models like Cohere embed-v4.0 and Amazon Titan Multimodal — see the [Embeddings guide](../embeddings.md).\n\n## Features Not Yet Covered\n\nA few AI SDK features don't have direct TanStack AI equivalents today:\n\n### Partial object streaming (`streamObject().elementStream` / `partialObjectStream`)\n\nTanStack AI's `outputSchema` always returns a `Promise<T>` once the full response has validated. If you need to render partial JSON as it streams, stay on `streamText` + `onChunk` for that specific case (or parse from TanStack's raw stream with your own incremental JSON parser).\n\n### Built-in retries and timeouts\n\nVercel's `maxRetries` / `timeout` options have no direct `chat()` equivalent. Use `AbortSignal.timeout(ms)` via `abortController`, and add retries in a custom middleware or in your fetch layer.\n\n## Complete Migration Example\n\n> On the Vercel side, the v5+ server handler runs incoming UI messages through `convertToModelMessages(messages)` before handing them to `streamText`. TanStack AI's `chat()` accepts the UI-message shape directly — its adapters do the conversion internally — so the equivalent line simply disappears on the After side.\n\n### Before (Vercel AI SDK v5+)\n\n```tsx\n// server/api/chat.ts\nimport { streamText, tool, convertToModelMessages, DefaultChatTransport } from 'ai'\nimport { openai } from '@ai-sdk/openai'\nimport { useChat } from '@ai-sdk/react'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\nimport { useState } from 'react'\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const result = streamText({\n    model: openai('gpt-4o'),\n    system: 'You are a helpful assistant.',\n    messages: await convertToModelMessages(messages),\n    temperature: 0.7,\n    tools: {\n      getWeather: tool({\n        description: 'Get weather',\n        inputSchema: z.object({ city: z.string() }),\n        execute: async ({ city }) => fetchWeather(city),\n      }),\n    },\n  })\n\n  return result.toUIMessageStreamResponse()\n}\n\n// components/Chat.tsx\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, status } = useChat({\n    transport: new DefaultChatTransport({ api: '/api/chat' }),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && status !== 'streaming') {\n      sendMessage({ text: input })\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((m) => (\n        <div key={m.id}>\n          {m.parts.map((p, i) => (p.type === 'text' ? <span key={i}>{p.text}</span> : null))}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n          disabled={status === 'streaming'}\n        />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}\n```\n\n### After (TanStack AI)\n\n```tsx ignore\n// server/api/chat.ts\nimport { chat, toServerSentEventsResponse, toolDefinition } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { z } from 'zod'\nimport { fetchWeather } from './weather'\n\nconst getWeatherDef = toolDefinition({\n  name: 'getWeather',\n  description: 'Get weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temp: z.number(), conditions: z.string() }),\n})\n\nconst getWeather = getWeatherDef.server(async ({ city }) => fetchWeather(city))\n\nexport async function POST(request: Request) {\n  const { messages } = await request.json()\n\n  const stream = chat({\n    adapter: openaiText('gpt-4o'),\n    systemPrompts: ['You are a helpful assistant.'],\n    messages,\n    temperature: 0.7,\n    tools: [getWeather],\n  })\n\n  return toServerSentEventsResponse(stream)\n}\n\n// components/Chat.tsx\nimport { useState } from 'react'\nimport { useChat, fetchServerSentEvents } from '@tanstack/ai-react'\n\nexport function Chat() {\n  const [input, setInput] = useState('')\n  const { messages, sendMessage, isLoading } = useChat({\n    connection: fetchServerSentEvents('/api/chat'),\n  })\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    if (input.trim() && !isLoading) {\n      sendMessage(input)\n      setInput('')\n    }\n  }\n\n  return (\n    <div>\n      {messages.map((message) => (\n        <div key={message.id}>\n          {message.parts.map((part, idx) =>\n            part.type === 'text' ? <span key={idx}>{part.content}</span> : null\n          )}\n        </div>\n      ))}\n      <form onSubmit={handleSubmit}>\n        <input\n          value={input}\n          onChange={(e) => setInput(e.target.value)}\n          disabled={isLoading}\n        />\n        <button type=\"submit\">Send</button>\n      </form>\n    </div>\n  )\n}\n```\n\n## Need Help?\n\nIf you hit something that isn't covered here, the deep-dive docs pick up where this guide stops:\n\n1. [Quick Start](../getting-started/quick-start) — minimal working setup\n2. [Tools](../tools/tools), [Tool Architecture](../tools/tool-architecture), and [Tool Approval](../tools/tool-approval) — the isomorphic tool system\n3. [Agentic Cycle](../chat/agentic-cycle) — agent loop internals and strategy composition\n4. [Structured Outputs](../structured-outputs/overview) — `outputSchema`, provider implementations, schema libraries\n5. [Middleware](../advanced/middleware) — full hook reference, context object, built-in middleware\n6. [Transports](../transports/overview) — SSE, HTTP stream, custom transports\n7. [Per-Model Type Safety](../advanced/per-model-type-safety) — how `modelOptions` is typed\n8. [API Reference](../api/ai) — every exported symbol\n"}
