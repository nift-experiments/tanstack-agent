{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Persistence has no feature flags. What you persist is decided by which "},{"type":"strong","children":[{"type":"text","value":"state"}]},{"type":"text","value":"\nstores the backend provides, and you compose backends per store. Supply only the\nstores your workflow needs."}]},{"type":"paragraph","children":[{"type":"text","value":"Need a mutex across instances? See "},{"type":"link","href":"#locks-coordination","children":[{"type":"text","value":"Locks"}]},{"type":"text","value":" below."}]},{"type":"heading","depth":2,"id":"named-shapes-prefer-these","children":[{"type":"text","value":"Named shapes (prefer these)"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Required stores"}]},{"type":"tableCell","children":[{"type":"text","value":"Use"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"ChatTranscriptStores"},{"type":"text","value":" / "},{"type":"inlineCode","value":"ChatTranscriptPersistence"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"messages"},{"type":"text","value":" (optional runs/interrupts/metadata)"}]},{"type":"tableCell","children":[{"type":"text","value":"Floor for "},{"type":"inlineCode","value":"withPersistence"},{"type":"text","value":" / "},{"type":"inlineCode","value":"reconstructChat"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ChatPersistenceStores"},{"type":"text","value":" / "},{"type":"inlineCode","value":"ChatPersistence"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"messages"},{"type":"text","value":" + "},{"type":"inlineCode","value":"runs"},{"type":"text","value":" + "},{"type":"inlineCode","value":"interrupts"},{"type":"text","value":" + "},{"type":"inlineCode","value":"metadata"}]},{"type":"tableCell","children":[{"type":"text","value":"Packaged backends ("},{"type":"inlineCode","value":"memoryPersistence"},{"type":"text","value":", Drizzle, Prisma, D1)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ChatWithInterruptsStores"},{"type":"text","value":" / "},{"type":"inlineCode","value":"ChatWithInterruptsPersistence"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"messages"},{"type":"text","value":" + "},{"type":"inlineCode","value":"runs"},{"type":"text","value":" + "},{"type":"inlineCode","value":"interrupts"}]},{"type":"tableCell","children":[{"type":"text","value":"HITL without requiring metadata"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"There is no public sparse "},{"type":"inlineCode","value":"AIPersistenceStores"},{"type":"text","value":" export, so use a named shape or\n"},{"type":"inlineCode","value":"AIPersistence<{ messages: MessageStore, … }>"},{"type":"text","value":" for custom maps.\n"},{"type":"inlineCode","value":"defineAIPersistence"},{"type":"text","value":" / "},{"type":"inlineCode","value":"composePersistence"},{"type":"text","value":" still accept sparse maps by\ninference."}]},{"type":"heading","depth":2,"id":"what-each-state-store-gives-you","children":[{"type":"text","value":"What each state store gives you"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Requirement"}]},{"type":"tableCell","children":[{"type":"text","value":"Store"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Authoritative server transcript"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"messages"},{"type":"text","value":" ("},{"type":"strong","children":[{"type":"text","value":"required"}]},{"type":"text","value":" by "},{"type":"inlineCode","value":"withPersistence"},{"type":"text","value":" / "},{"type":"inlineCode","value":"reconstructChat"},{"type":"text","value":")"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Run status and usage"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"runs"},{"type":"text","value":" (required on "},{"type":"inlineCode","value":"ChatPersistence"},{"type":"text","value":"; required when "},{"type":"inlineCode","value":"interrupts"},{"type":"text","value":" is set)"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Durable approvals or human input"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"interrupts"},{"type":"text","value":" (requires "},{"type":"inlineCode","value":"runs"},{"type":"text","value":")"}]}],[{"type":"tableCell","children":[{"type":"text","value":"App or integration checkpoints"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"metadata"},{"type":"text","value":" (always optional)"}]}]]},{"type":"paragraph","children":[{"type":"inlineCode","value":"withPersistence(persistence)"},{"type":"text","value":" inspects the stores that are present. Store\npresence is the capability selection mechanism for optional chat features."}]},{"type":"heading","depth":2,"id":"entrypoint-requirements","children":[{"type":"text","value":"Entrypoint requirements"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Entrypoint"}]},{"type":"tableCell","children":[{"type":"text","value":"Shape"}]},{"type":"tableCell","children":[{"type":"text","value":"Notes"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"withPersistence"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChatTranscriptStores"},{"type":"text","value":" floor"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"interrupts"},{"type":"text","value":" ⇒ "},{"type":"inlineCode","value":"runs"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"reconstructChat"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChatTranscriptStores"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"runs"},{"type":"text","value":" / "},{"type":"inlineCode","value":"interrupts"},{"type":"text","value":" enrich the response when present"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Packaged "},{"type":"inlineCode","value":"*Persistence()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChatPersistence"}]},{"type":"tableCell","children":[{"type":"text","value":"messages + runs (+ interrupts + metadata)"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"defineAIPersistence"},{"type":"text","value":" / "},{"type":"inlineCode","value":"composePersistence"}]},{"type":"tableCell","children":[{"type":"text","value":"sparse by inference"}]},{"type":"tableCell","children":[{"type":"text","value":"Prefer a named shape for the result"}]}]]},{"type":"heading","depth":2,"id":"compose-and-override-stores","children":[{"type":"text","value":"Compose and override stores"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"composePersistence"},{"type":"text","value":" takes the base backend first and an overrides object\nsecond. Here it starts from the in-memory reference backend and swaps in custom\n"},{"type":"inlineCode","value":"interrupts"},{"type":"text","value":" / "},{"type":"inlineCode","value":"runs"},{"type":"text","value":" stores:"}]},{"type":"code","value":"import { composePersistence, memoryPersistence } from '@tanstack/ai-persistence'\n// Your own store implementations of the InterruptStore / RunStore contracts.\nimport { interruptStore, runStore } from './stores'\n\nconst persistence = composePersistence(memoryPersistence(), {\n  overrides: {\n    interrupts: interruptStore,\n    runs: runStore,\n  },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Each override is independent:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Override value"}]},{"type":"tableCell","children":[{"type":"text","value":"Result"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"key omitted"}]},{"type":"tableCell","children":[{"type":"text","value":"Inherit the base store."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Inherit the base store."}]}],[{"type":"tableCell","children":[{"type":"text","value":"a store object"}]},{"type":"tableCell","children":[{"type":"text","value":"Replace that store only."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"false"}]},{"type":"tableCell","children":[{"type":"text","value":"Remove that store."}]}]]},{"type":"code","value":"import { composePersistence, memoryPersistence } from '@tanstack/ai-persistence'\n\n// Drop metadata; the resulting type has no `metadata` key.\nconst withoutMetadata = composePersistence(memoryPersistence(), {\n  overrides: { metadata: false },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Unknown store names fail type checking, and are also rejected at runtime when\nvalues arrive from untyped JavaScript."}]},{"type":"heading","depth":2,"id":"valid-store-combinations","children":[{"type":"text","value":"Valid store combinations"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"withPersistence"},{"type":"text","value":" requires "},{"type":"inlineCode","value":"messages"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"interrupts"},{"type":"text","value":" requires "},{"type":"inlineCode","value":"runs"},{"type":"text","value":": an interrupt record is scoped to a run."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"withGenerationPersistence"},{"type":"text","value":" requires "},{"type":"inlineCode","value":"generationRuns"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Portable sandbox snapshots require "},{"type":"inlineCode","value":"messages"},{"type":"text","value":", "},{"type":"inlineCode","value":"artifacts"},{"type":"text","value":", and "},{"type":"inlineCode","value":"blobs"},{"type":"text","value":" on\nthe same persistence object. See\n"},{"type":"link","href":"../sandbox/portable-snapshots-configure","children":[{"type":"text","value":"Keep Files After Reload"}]},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"To define a partial backend directly rather than by composing, use\n"},{"type":"inlineCode","value":"defineAIPersistence({ stores: { ... } })"},{"type":"text","value":" and pass only the stores you have.\nSee the\n"},{"type":"link","href":"./store-reference","children":[{"type":"text","value":"store reference"}]},{"type":"text","value":"\nfor the store contracts."}]},{"type":"heading","depth":2,"id":"locks-coordination","children":[{"type":"text","value":"Locks (coordination)"}]},{"type":"paragraph","children":[{"type":"text","value":"Locks coordinate work across instances (a distributed mutex). They live in\n"},{"type":"inlineCode","value":"@tanstack/ai/locks"},{"type":"text","value":" and apply as their own middleware with "},{"type":"inlineCode","value":"withLocks"},{"type":"text","value":",\nalongside "},{"type":"inlineCode","value":"withPersistence"},{"type":"text","value":". Full guide: "},{"type":"link","href":"../advanced/locks","children":[{"type":"text","value":"Locks"}]},{"type":"text","value":"."}]},{"type":"code","value":"import { withLocks, InMemoryLockStore } from '@tanstack/ai/locks'\nimport { withPersistence, memoryPersistence } from '@tanstack/ai-persistence'\n\nconst middleware = [\n  withPersistence(memoryPersistence()),\n  withLocks(new InMemoryLockStore()), // multi-instance: distributed LockStore\n]","lang":"ts"}],"headings":[{"id":"named-shapes-prefer-these","text":"Named shapes (prefer these)","level":2},{"id":"what-each-state-store-gives-you","text":"What each state store gives you","level":2},{"id":"entrypoint-requirements","text":"Entrypoint requirements","level":2},{"id":"compose-and-override-stores","text":"Compose and override stores","level":2},{"id":"valid-store-combinations","text":"Valid store combinations","level":2},{"id":"locks-coordination","text":"Locks (coordination)","level":2}]},"frameworks":[],"downloadMarkdown":"\nPersistence has no feature flags. What you persist is decided by which **state**\nstores the backend provides, and you compose backends per store. Supply only the\nstores your workflow needs.\n\nNeed a mutex across instances? See [Locks](#locks-coordination) below.\n\n## Named shapes (prefer these)\n\n| Type | Required stores | Use |\n| --- | --- | --- |\n| `ChatTranscriptStores` / `ChatTranscriptPersistence` | `messages` (optional runs/interrupts/metadata) | Floor for `withPersistence` / `reconstructChat` |\n| `ChatPersistenceStores` / `ChatPersistence` | `messages` + `runs` + `interrupts` + `metadata` | Packaged backends (`memoryPersistence`, Drizzle, Prisma, D1) |\n| `ChatWithInterruptsStores` / `ChatWithInterruptsPersistence` | `messages` + `runs` + `interrupts` | HITL without requiring metadata |\n\nThere is no public sparse `AIPersistenceStores` export, so use a named shape or\n`AIPersistence<{ messages: MessageStore, … }>` for custom maps.\n`defineAIPersistence` / `composePersistence` still accept sparse maps by\ninference.\n\n## What each state store gives you\n\n| Requirement | Store |\n| --- | --- |\n| Authoritative server transcript | `messages` (**required** by `withPersistence` / `reconstructChat`) |\n| Run status and usage | `runs` (required on `ChatPersistence`; required when `interrupts` is set) |\n| Durable approvals or human input | `interrupts` (requires `runs`) |\n| App or integration checkpoints | `metadata` (always optional) |\n\n`withPersistence(persistence)` inspects the stores that are present. Store\npresence is the capability selection mechanism for optional chat features.\n\n## Entrypoint requirements\n\n| Entrypoint | Shape | Notes |\n| --- | --- | --- |\n| `withPersistence` | `ChatTranscriptStores` floor | `interrupts` ⇒ `runs` |\n| `reconstructChat` | `ChatTranscriptStores` | `runs` / `interrupts` enrich the response when present |\n| Packaged `*Persistence()` | `ChatPersistence` | messages + runs (+ interrupts + metadata) |\n| `defineAIPersistence` / `composePersistence` | sparse by inference | Prefer a named shape for the result |\n\n## Compose and override stores\n\n`composePersistence` takes the base backend first and an overrides object\nsecond. Here it starts from the in-memory reference backend and swaps in custom\n`interrupts` / `runs` stores:\n\n```ts\nimport { composePersistence, memoryPersistence } from '@tanstack/ai-persistence'\n// Your own store implementations of the InterruptStore / RunStore contracts.\nimport { interruptStore, runStore } from './stores'\n\nconst persistence = composePersistence(memoryPersistence(), {\n  overrides: {\n    interrupts: interruptStore,\n    runs: runStore,\n  },\n})\n```\n\nEach override is independent:\n\n| Override value | Result |\n| --- | --- |\n| key omitted | Inherit the base store. |\n| `undefined` | Inherit the base store. |\n| a store object | Replace that store only. |\n| `false` | Remove that store. |\n\n```ts\nimport { composePersistence, memoryPersistence } from '@tanstack/ai-persistence'\n\n// Drop metadata; the resulting type has no `metadata` key.\nconst withoutMetadata = composePersistence(memoryPersistence(), {\n  overrides: { metadata: false },\n})\n```\n\nUnknown store names fail type checking, and are also rejected at runtime when\nvalues arrive from untyped JavaScript.\n\n## Valid store combinations\n\n- `withPersistence` requires `messages`.\n- `interrupts` requires `runs`: an interrupt record is scoped to a run.\n- `withGenerationPersistence` requires `generationRuns`.\n- Portable sandbox snapshots require `messages`, `artifacts`, and `blobs` on\n  the same persistence object. See\n  [Keep Files After Reload](../sandbox/portable-snapshots-configure).\n\nTo define a partial backend directly rather than by composing, use\n`defineAIPersistence({ stores: { ... } })` and pass only the stores you have.\nSee the\n[store reference](./store-reference)\nfor the store contracts.\n\n## Locks (coordination)\n\nLocks coordinate work across instances (a distributed mutex). They live in\n`@tanstack/ai/locks` and apply as their own middleware with `withLocks`,\nalongside `withPersistence`. Full guide: [Locks](../advanced/locks).\n\n```ts\nimport { withLocks, InMemoryLockStore } from '@tanstack/ai/locks'\nimport { withPersistence, memoryPersistence } from '@tanstack/ai-persistence'\n\nconst middleware = [\n  withPersistence(memoryPersistence()),\n  withLocks(new InMemoryLockStore()), // multi-instance: distributed LockStore\n]\n```\n","originalRawMarkdown":"---\ntitle: Persistence Controls\nid: controls\n---\n\nPersistence has no feature flags. What you persist is decided by which **state**\nstores the backend provides, and you compose backends per store. Supply only the\nstores your workflow needs.\n\nNeed a mutex across instances? See [Locks](#locks-coordination) below.\n\n## Named shapes (prefer these)\n\n| Type | Required stores | Use |\n| --- | --- | --- |\n| `ChatTranscriptStores` / `ChatTranscriptPersistence` | `messages` (optional runs/interrupts/metadata) | Floor for `withPersistence` / `reconstructChat` |\n| `ChatPersistenceStores` / `ChatPersistence` | `messages` + `runs` + `interrupts` + `metadata` | Packaged backends (`memoryPersistence`, Drizzle, Prisma, D1) |\n| `ChatWithInterruptsStores` / `ChatWithInterruptsPersistence` | `messages` + `runs` + `interrupts` | HITL without requiring metadata |\n\nThere is no public sparse `AIPersistenceStores` export, so use a named shape or\n`AIPersistence<{ messages: MessageStore, … }>` for custom maps.\n`defineAIPersistence` / `composePersistence` still accept sparse maps by\ninference.\n\n## What each state store gives you\n\n| Requirement | Store |\n| --- | --- |\n| Authoritative server transcript | `messages` (**required** by `withPersistence` / `reconstructChat`) |\n| Run status and usage | `runs` (required on `ChatPersistence`; required when `interrupts` is set) |\n| Durable approvals or human input | `interrupts` (requires `runs`) |\n| App or integration checkpoints | `metadata` (always optional) |\n\n`withPersistence(persistence)` inspects the stores that are present. Store\npresence is the capability selection mechanism for optional chat features.\n\n## Entrypoint requirements\n\n| Entrypoint | Shape | Notes |\n| --- | --- | --- |\n| `withPersistence` | `ChatTranscriptStores` floor | `interrupts` ⇒ `runs` |\n| `reconstructChat` | `ChatTranscriptStores` | `runs` / `interrupts` enrich the response when present |\n| Packaged `*Persistence()` | `ChatPersistence` | messages + runs (+ interrupts + metadata) |\n| `defineAIPersistence` / `composePersistence` | sparse by inference | Prefer a named shape for the result |\n\n## Compose and override stores\n\n`composePersistence` takes the base backend first and an overrides object\nsecond. Here it starts from the in-memory reference backend and swaps in custom\n`interrupts` / `runs` stores:\n\n```ts\nimport { composePersistence, memoryPersistence } from '@tanstack/ai-persistence'\n// Your own store implementations of the InterruptStore / RunStore contracts.\nimport { interruptStore, runStore } from './stores'\n\nconst persistence = composePersistence(memoryPersistence(), {\n  overrides: {\n    interrupts: interruptStore,\n    runs: runStore,\n  },\n})\n```\n\nEach override is independent:\n\n| Override value | Result |\n| --- | --- |\n| key omitted | Inherit the base store. |\n| `undefined` | Inherit the base store. |\n| a store object | Replace that store only. |\n| `false` | Remove that store. |\n\n```ts\nimport { composePersistence, memoryPersistence } from '@tanstack/ai-persistence'\n\n// Drop metadata; the resulting type has no `metadata` key.\nconst withoutMetadata = composePersistence(memoryPersistence(), {\n  overrides: { metadata: false },\n})\n```\n\nUnknown store names fail type checking, and are also rejected at runtime when\nvalues arrive from untyped JavaScript.\n\n## Valid store combinations\n\n- `withPersistence` requires `messages`.\n- `interrupts` requires `runs`: an interrupt record is scoped to a run.\n- `withGenerationPersistence` requires `generationRuns`.\n- Portable sandbox snapshots require `messages`, `artifacts`, and `blobs` on\n  the same persistence object. See\n  [Keep Files After Reload](../sandbox/portable-snapshots-configure).\n\nTo define a partial backend directly rather than by composing, use\n`defineAIPersistence({ stores: { ... } })` and pass only the stores you have.\nSee the\n[store reference](./store-reference)\nfor the store contracts.\n\n## Locks (coordination)\n\nLocks coordinate work across instances (a distributed mutex). They live in\n`@tanstack/ai/locks` and apply as their own middleware with `withLocks`,\nalongside `withPersistence`. Full guide: [Locks](../advanced/locks).\n\n```ts\nimport { withLocks, InMemoryLockStore } from '@tanstack/ai/locks'\nimport { withPersistence, memoryPersistence } from '@tanstack/ai-persistence'\n\nconst middleware = [\n  withPersistence(memoryPersistence()),\n  withLocks(new InMemoryLockStore()), // multi-instance: distributed LockStore\n]\n```\n"}
