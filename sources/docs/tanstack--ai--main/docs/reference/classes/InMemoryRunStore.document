5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"threadid-2","children":[{"type":"text","value":"threadId"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/RunRecord.md","children":[{"type":"inlineCode","value":"RunRecord"}]},{"type":"text","value":"[]>"}]},{"type":"heading","depth":4,"id":"implementation-of-5","children":[{"type":"text","value":"Implementation of"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/RunStore.md","children":[{"type":"inlineCode","value":"RunStore"}]},{"type":"text","value":"."},{"type":"link","href":"../interfaces/RunStore.md#listbythread","children":[{"type":"inlineCode","value":"listByThread"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"listreclaimable","children":[{"type":"text","value":"listReclaimable()"}]},{"type":"code","value":"listReclaimable(opts): Promise<RunRecord[]>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/middleware/run-store.ts#L439","children":[{"type":"text","value":"packages/ai/src/activities/chat/middleware/run-store.ts:439"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Runs that may be reclaimed: ALL THREE of "},{"type":"inlineCode","value":"status === 'running'"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"detachedSince"},{"type":"text","value":" is set, and "},{"type":"inlineCode","value":"detachedSince <= now - ttlMs"},{"type":"text","value":". The cutoff is\n"},{"type":"strong","children":[{"type":"text","value":"inclusive"}]},{"type":"text","value":" — a run detached at exactly "},{"type":"inlineCode","value":"now - ttlMs"},{"type":"text","value":" IS reclaimable."}]},{"type":"paragraph","children":[{"type":"text","value":"OPTIONAL: only needed by a reaper. Consumers feature-detect."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"detachedSince"},{"type":"text","value":" is populated by "},{"type":"inlineCode","value":"withSandbox"},{"type":"text","value":"'s detach path (see\n"},{"type":"link","href":"../interfaces/RunRecord.md#detachedsince","children":[{"type":"text","value":"RunRecord.detachedSince"}]},{"type":"text","value":"). The sweep over the candidates this\nsurfaces is "},{"type":"inlineCode","value":"@tanstack/ai-sandbox"},{"type":"text","value":"'s "},{"type":"inlineCode","value":"reapDetachedRuns"},{"type":"text","value":": it finalizes a run\nwhose agent already finished, expires one past its TTL, and reclaims the\nsandbox. That is a function, not a scheduler — the application invokes it\n(cron, queue, "},{"type":"inlineCode","value":"alarm()"},{"type":"text","value":", "},{"type":"inlineCode","value":"waitUntil"},{"type":"text","value":") — and a backend that omits this\nmethod cannot be reaped at all."}]},{"type":"heading","depth":4,"id":"parameters-6","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"opts","children":[{"type":"text","value":"opts"}]},{"type":"heading","depth":6,"id":"now","children":[{"type":"text","value":"now"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":6,"id":"ttlms","children":[{"type":"text","value":"ttlMs"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/RunRecord.md","children":[{"type":"inlineCode","value":"RunRecord"}]},{"type":"text","value":"[]>"}]},{"type":"heading",