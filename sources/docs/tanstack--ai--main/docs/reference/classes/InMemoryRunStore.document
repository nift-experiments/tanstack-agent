own."}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"runid","children":[{"type":"text","value":"runId"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/RunRecord.md","children":[{"type":"inlineCode","value":"RunRecord"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"implementation-of-3","children":[{"type":"text","value":"Implementation of"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/RunStore.md","children":[{"type":"inlineCode","value":"RunStore"}]},{"type":"text","value":"."},{"type":"link","href":"../interfaces/RunStore.md#get","children":[{"type":"inlineCode","value":"get"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"listbyparentrun","children":[{"type":"text","value":"listByParentRun()"}]},{"type":"code","value":"listByParentRun(parentRunId): Promise<RunRecord[]>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/middleware/run-store.ts#L432","children":[{"type":"text","value":"packages/ai/src/activities/chat/middleware/run-store.ts:432"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Child runs started by "},{"type":"inlineCode","value":"parentRunId"},{"type":"text","value":", ascending by "},{"type":"inlineCode","value":"startedAt"},{"type":"text","value":".\nOPTIONAL. "},{"type":"inlineCode","value":"reconstructChat"},{"type":"text","value":" uses this to put subagent cards back\non the parent assistant message. A store that omits it reloads the\n