[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L343","children":[{"type":"text","value":"packages/ai/src/activities/chat/tools/tool-calls.ts:343"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Execute all tool calls and return tool result messages\nYields TOOL_CALL_END events for streaming"}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"finishevent","children":[{"type":"text","value":"finishEvent"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/RunFinishedEvent.md","children":[{"type":"inlineCode","value":"RunFinishedEvent"}]}]},{"type":"paragraph","children":[{"type":"text","value":"RUN_FINISHED event from the stream"}]},{"type":"heading","depth":5,"id":"contextargs","children":[{"type":"text","value":"contextArgs"}]},{"type":"paragraph","children":[{"type":"text","value":"..."},{"type":"inlineCode","value":"ExecuteToolsContextArgs"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"AsyncGenerator"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/AdapterYieldChunk.md","children":[{"type":"inlineCode","value":"AdapterYieldChunk"}]},{"type":"text","value":", "},{"type":"link","href":"../interfaces/ModelMessage.md","children":[{"type":"inlineCode","value":"ModelMessage"}]},{"type":"text","value":"<\n| "},{"type":"inlineCode","value":"string"},{"type":"text","value":"\n| "},{"type":"link","href":"../type-aliases/ContentPart.md","children":[{"type":"inlineCode","value":"ContentPart"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">[]\n| "},{"type":"inlineCode","value":"null"},{"type":"text","value":">[], "},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"gettoolcalls","children":[{"type":"text","value":"getToolCalls()"}]},{"type":"code","value":"getToolCalls(): ToolCall<unknown>[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L332","children":[{"type":"text","value":"packages/ai/src/activities/chat/tools/tool-calls.ts:332"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Get all complete tool calls (filtered for valid ID and name)"}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ToolCall.md","children":[{"type":"inlineCode","value":"ToolCall"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">[]"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"hastoolcalls","children":[{"type":"text","value":"hasToolCalls()"}]},{"type":"code","value":"hasToolCalls(): boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L325","children":[{"type":"text","value":"packages/ai/src/activities/chat/tools/tool-calls.ts:325"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Check if there are any complete tool calls to execute"}]},{"type":"heading","depth":4,"id":"returns-8","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"ttoolsorcontext","text":"TToolsOrContext","level":3},{"id":"tcontext","text":"TContext","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"tools","text":"tools","level":5},{"id":"returns","text":"Returns","level":4},{"id":"methods","text":"Methods","level":2},{"id":"addtoolcallargsevent","text":"addToolCallArgsEvent()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"event","text":"event","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"addtoolcallstartevent","text":"addToolCallStartEvent()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"event-2","text":"event","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"clear","text":"clear()","level":3},{"id":"returns-4","text":"Returns","level":4},{"id":"completetoolcall","text":"completeToolCall()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"event-3","text":"event","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"executetools","text":"executeTools()","level":3},{"id":"parameters-5","text":"Parameters","level":4},{"id":"finishevent","text":"finishEvent","level":5},{"id":"contextargs","text":"contextArgs","level":5},{"id":"returns-6","text":"Returns","level":4},{"id":"gettoolcalls","text":"getToolCalls()","level":3},{"id":"returns-7","text":"Returns","level":4},{"id":"hastoolcalls","text":"hasToolCalls()","level":3},{"id":"returns-8","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:245](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L245)\n\nManages tool call accumulation and execution for the chat() method's automatic tool execution loop.\n\nResponsibilities:\n- Accumulates streaming tool call events (ID, name, arguments)\n- Validates tool calls (filters out incomplete ones)\n- Executes tool `execute` functions with parsed arguments\n- Emits `TOOL_CALL_END` events for client visibility\n- Returns tool result messages for conversation history\n\nThis class is used internally by the AI.chat() method to handle the automatic\ntool execution loop. It can also be used independently for custom tool execution logic.\n\n## Example\n\n```typescript\nconst manager = new ToolCallManager(tools);\n\n// During streaming, accumulate tool calls\nfor await (const chunk of stream) {\n  if (chunk.type === 'TOOL_CALL_START') {\n    manager.addToolCallStartEvent(chunk);\n  } else if (chunk.type === 'TOOL_CALL_ARGS') {\n    manager.addToolCallArgsEvent(chunk);\n  }\n}\n\n// After stream completes, execute tools\nif (manager.hasToolCalls()) {\n  const toolResults = yield* manager.executeTools(finishEvent);\n  messages = [...messages, ...toolResults];\n  manager.clear();\n}\n```\n\n## Type Parameters\n\n### TToolsOrContext\n\n`TToolsOrContext` = `ReadonlyArray`\\<[`AnyTool`](../type-aliases/AnyTool.md)\\>\n\n### TContext\n\n`TContext` = `TToolsOrContext` *extends* `ReadonlyArray`\\<[`AnyTool`](../type-aliases/AnyTool.md)\\> ? `ContextFromTools`\\<`TToolsOrContext`\\> : `TToolsOrContext`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew ToolCallManager<TToolsOrContext, TContext>(tools): ToolCallManager<TToolsOrContext, TContext>;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:256](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L256)\n\n#### Parameters\n\n##### tools\n\n`TToolsOrContext` *extends* readonly [`AnyTool`](../type-aliases/AnyTool.md)[] ? `TToolsOrContext` : readonly [`AnyTool`](../type-aliases/AnyTool.md)[]\n\n#### Returns\n\n`ToolCallManager`\\<`TToolsOrContext`, `TContext`\\>\n\n## Methods\n\n### addToolCallArgsEvent()\n\n```ts\naddToolCallArgsEvent(event): void;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:293](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L293)\n\nAdd a TOOL_CALL_ARGS event to accumulate arguments (AG-UI)\n\n#### Parameters\n\n##### event\n\n[`ToolCallArgsEvent`](../interfaces/ToolCallArgsEvent.md)\n\n#### Returns\n\n`void`\n\n***\n\n### addToolCallStartEvent()\n\n```ts\naddToolCallStartEvent(event): void;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:267](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L267)\n\nAdd a TOOL_CALL_START event to begin tracking a tool call (AG-UI)\n\n#### Parameters\n\n##### event\n\n[`ToolCallStartEvent`](../interfaces/ToolCallStartEvent.md)\n\n#### Returns\n\n`void`\n\n***\n\n### clear()\n\n```ts\nclear(): void;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:464](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L464)\n\nClear the tool calls map for the next iteration\n\n#### Returns\n\n`void`\n\n***\n\n### completeToolCall()\n\n```ts\ncompleteToolCall(event): void;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:311](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L311)\n\nComplete a tool call with its final input\nCalled when TOOL_CALL_END is received\n\n#### Parameters\n\n##### event\n\n[`ToolCallEndEvent`](../interfaces/ToolCallEndEvent.md)\n\n#### Returns\n\n`void`\n\n***\n\n### executeTools()\n\n```ts\nexecuteTools(finishEvent, ...contextArgs): AsyncGenerator<AdapterYieldChunk, ModelMessage<\n  | string\n  | ContentPart<unknown, unknown, unknown, unknown, unknown>[]\n| null>[], void>;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:343](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L343)\n\nExecute all tool calls and return tool result messages\nYields TOOL_CALL_END events for streaming\n\n#### Parameters\n\n##### finishEvent\n\n[`RunFinishedEvent`](../interfaces/RunFinishedEvent.md)\n\nRUN_FINISHED event from the stream\n\n##### contextArgs\n\n...`ExecuteToolsContextArgs`\\<`TContext`\\>\n\n#### Returns\n\n`AsyncGenerator`\\<[`AdapterYieldChunk`](../type-aliases/AdapterYieldChunk.md), [`ModelMessage`](../interfaces/ModelMessage.md)\\<\n  \\| `string`\n  \\| [`ContentPart`](../type-aliases/ContentPart.md)\\<`unknown`, `unknown`, `unknown`, `unknown`, `unknown`\\>[]\n  \\| `null`\\>[], `void`\\>\n\n***\n\n### getToolCalls()\n\n```ts\ngetToolCalls(): ToolCall<unknown>[];\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:332](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L332)\n\nGet all complete tool calls (filtered for valid ID and name)\n\n#### Returns\n\n[`ToolCall`](../interfaces/ToolCall.md)\\<`unknown`\\>[]\n\n***\n\n### hasToolCalls()\n\n```ts\nhasToolCalls(): boolean;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:325](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L325)\n\nCheck if there are any complete tool calls to execute\n\n#### Returns\n\n`boolean`\n","originalRawMarkdown":"---\nid: ToolCallManager\ntitle: ToolCallManager\n---\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:245](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L245)\n\nManages tool call accumulation and execution for the chat() method's automatic tool execution loop.\n\nResponsibilities:\n- Accumulates streaming tool call events (ID, name, arguments)\n- Validates tool calls (filters out incomplete ones)\n- Executes tool `execute` functions with parsed arguments\n- Emits `TOOL_CALL_END` events for client visibility\n- Returns tool result messages for conversation history\n\nThis class is used internally by the AI.chat() method to handle the automatic\ntool execution loop. It can also be used independently for custom tool execution logic.\n\n## Example\n\n```typescript\nconst manager = new ToolCallManager(tools);\n\n// During streaming, accumulate tool calls\nfor await (const chunk of stream) {\n  if (chunk.type === 'TOOL_CALL_START') {\n    manager.addToolCallStartEvent(chunk);\n  } else if (chunk.type === 'TOOL_CALL_ARGS') {\n    manager.addToolCallArgsEvent(chunk);\n  }\n}\n\n// After stream completes, execute tools\nif (manager.hasToolCalls()) {\n  const toolResults = yield* manager.executeTools(finishEvent);\n  messages = [...messages, ...toolResults];\n  manager.clear();\n}\n```\n\n## Type Parameters\n\n### TToolsOrContext\n\n`TToolsOrContext` = `ReadonlyArray`\\<[`AnyTool`](../type-aliases/AnyTool.md)\\>\n\n### TContext\n\n`TContext` = `TToolsOrContext` *extends* `ReadonlyArray`\\<[`AnyTool`](../type-aliases/AnyTool.md)\\> ? `ContextFromTools`\\<`TToolsOrContext`\\> : `TToolsOrContext`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew ToolCallManager<TToolsOrContext, TContext>(tools): ToolCallManager<TToolsOrContext, TContext>;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:256](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L256)\n\n#### Parameters\n\n##### tools\n\n`TToolsOrContext` *extends* readonly [`AnyTool`](../type-aliases/AnyTool.md)[] ? `TToolsOrContext` : readonly [`AnyTool`](../type-aliases/AnyTool.md)[]\n\n#### Returns\n\n`ToolCallManager`\\<`TToolsOrContext`, `TContext`\\>\n\n## Methods\n\n### addToolCallArgsEvent()\n\n```ts\naddToolCallArgsEvent(event): void;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:293](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L293)\n\nAdd a TOOL_CALL_ARGS event to accumulate arguments (AG-UI)\n\n#### Parameters\n\n##### event\n\n[`ToolCallArgsEvent`](../interfaces/ToolCallArgsEvent.md)\n\n#### Returns\n\n`void`\n\n***\n\n### addToolCallStartEvent()\n\n```ts\naddToolCallStartEvent(event): void;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:267](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L267)\n\nAdd a TOOL_CALL_START event to begin tracking a tool call (AG-UI)\n\n#### Parameters\n\n##### event\n\n[`ToolCallStartEvent`](../interfaces/ToolCallStartEvent.md)\n\n#### Returns\n\n`void`\n\n***\n\n### clear()\n\n```ts\nclear(): void;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:464](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L464)\n\nClear the tool calls map for the next iteration\n\n#### Returns\n\n`void`\n\n***\n\n### completeToolCall()\n\n```ts\ncompleteToolCall(event): void;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:311](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L311)\n\nComplete a tool call with its final input\nCalled when TOOL_CALL_END is received\n\n#### Parameters\n\n##### event\n\n[`ToolCallEndEvent`](../interfaces/ToolCallEndEvent.md)\n\n#### Returns\n\n`void`\n\n***\n\n### executeTools()\n\n```ts\nexecuteTools(finishEvent, ...contextArgs): AsyncGenerator<AdapterYieldChunk, ModelMessage<\n  | string\n  | ContentPart<unknown, unknown, unknown, unknown, unknown>[]\n| null>[], void>;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:343](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L343)\n\nExecute all tool calls and return tool result messages\nYields TOOL_CALL_END events for streaming\n\n#### Parameters\n\n##### finishEvent\n\n[`RunFinishedEvent`](../interfaces/RunFinishedEvent.md)\n\nRUN_FINISHED event from the stream\n\n##### contextArgs\n\n...`ExecuteToolsContextArgs`\\<`TContext`\\>\n\n#### Returns\n\n`AsyncGenerator`\\<[`AdapterYieldChunk`](../type-aliases/AdapterYieldChunk.md), [`ModelMessage`](../interfaces/ModelMessage.md)\\<\n  \\| `string`\n  \\| [`ContentPart`](../type-aliases/ContentPart.md)\\<`unknown`, `unknown`, `unknown`, `unknown`, `unknown`\\>[]\n  \\| `null`\\>[], `void`\\>\n\n***\n\n### getToolCalls()\n\n```ts\ngetToolCalls(): ToolCall<unknown>[];\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:332](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L332)\n\nGet all complete tool calls (filtered for valid ID and name)\n\n#### Returns\n\n[`ToolCall`](../interfaces/ToolCall.md)\\<`unknown`\\>[]\n\n***\n\n### hasToolCalls()\n\n```ts\nhasToolCalls(): boolean;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-calls.ts:325](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-calls.ts#L325)\n\nCheck if there are any complete tool calls to execute\n\n#### Returns\n\n`boolean`\n"}
