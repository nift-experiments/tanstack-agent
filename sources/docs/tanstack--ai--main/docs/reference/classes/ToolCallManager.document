StartEvent(chunk);\n  } else if (chunk.type === 'TOOL_CALL_ARGS') {\n    manager.addToolCallArgsEvent(chunk);\n  }\n}\n\n// After stream completes, execute tools\nif (manager.hasToolCalls()) {\n  const toolResults = yield* manager.executeTools(finishEvent);\n  messages = [...messages, ...toolResults];\n  manager.clear();\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"ttoolsorcontext","children":[{"type":"text","value":"TToolsOrContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TToolsOrContext"},{"type":"text","value":" = "},{"type":"inlineCode","value":"ReadonlyArray"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/AnyTool.md","children":[{"type":"inlineCode","value":"AnyTool"}]},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"tcontext","children":[{"type":"text","value":"TContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TContext"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TToolsOrContext"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"ReadonlyArray"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/AnyTool.md","children":[{"type":"inlineCode","value":"AnyTool"}]},{"type":"text","value":"> ? "},{"type":"inlineCode","value":"ContextFromTools"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TToolsOrContext"},{"type":"text","value":"> : "},{"type":"inlineCode","value":"TToolsOrContext"}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,"id":"constructor","children":[{"type":"text","value":"Constructor"}]},{"type":"code","value":"new ToolCallManager<TToolsOrContext, TContext>(tools): ToolCallManager<TToolsOrContext, TContext>;","lang":"ts"}