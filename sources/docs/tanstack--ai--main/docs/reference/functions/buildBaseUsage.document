alTokens: 150\n});\n// Returns: { promptTokens: 100, completionTokens: 50, totalTokens: 150 }","lang":"typescript"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tproviderdetails","text":"TProviderDetails","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"input","text":"input","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction buildBaseUsage<TProviderDetails>(input): TokenUsage<TProviderDetails>;\n```\n\nDefined in: [packages/ai/src/utilities/usage.ts:33](https://github.com/TanStack/ai/blob/main/packages/ai/src/utilities/usage.ts#L33)\n\nBuilds the base TokenUsage object with core fields.\nProvider-specific functions should use this and then add their own details.\n\n## Type Parameters\n\n### TProviderDetails\n\n`TProviderDetails` = `ProviderUsageDetails`\n\n## Parameters\n\n### input\n\n[`BaseUsageInput`](../interfaces/BaseUsageInput.md)\n\nThe base token counts\n\n## Returns\n\n`TokenUsage`\\<`TProviderDetails`\\>\n\nA TokenUsage object with promptTokens, completionTokens, totalTokens\n\n## Example\n\n```typescript\nconst base = buildBaseUsage({\n  promptTokens: 100,\n  completionTokens: 50,\n  totalTokens: 150\n});\n// Returns: { promptTokens: 100, completionTokens: 50, totalTokens: 150 }\n```\n","originalRawMarkdown":"---\nid: buildBaseUsage\ntitle: buildBaseUsage\n---\n\n```ts\nfunction buildBaseUsage<TProviderDetails>(input): TokenUsage<TProviderDetails>;\n```\n\nDefined in: [packages/ai/src/utilities/usage.ts:33](https://github.com/TanStack/ai/blob/main/packages/ai/src/utilities/usage.ts#L33)\n\nBuilds the base TokenUsage object with core fields.\nProvider-specific functions should use this and then add their own details.\n\n## Type Parameters\n\n### TProviderDetails\n\n`TProviderDetails` = `ProviderUsageDetails`\n\n## Parameters\n\n### input\n\n[`BaseUsageInput`](../interfaces/BaseUsageInput.md)\n\nThe base token counts\n\n## Returns\n\n`TokenUsage`\\<`TProviderDetails`\\>\n\nA TokenUsage object with promptTokens, completionTokens, totalTokens\n\n## Example\n\n```typescript\nconst base = buildBaseUsage({\n  promptTokens: 100,\n  completionTokens: 50,\n  totalTokens: 150\n});\n// Returns: { promptTokens: 100, completionTokens: 50, totalTokens: 150 }\n```\n"}
