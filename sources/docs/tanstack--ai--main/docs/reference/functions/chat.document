entTool"},{"type":"text","value":"[], "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", readonly "},{"type":"link","href":"../interfaces/InterruptDefinition.md","children":[{"type":"inlineCode","value":"InterruptDefinition"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">[], "},{"type":"inlineCode","value":"any"},{"type":"text","value":">[] = readonly "},{"type":"link","href":"../interfaces/DefinedAgent.md","children":[{"type":"inlineCode","value":"DefinedAgent"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", readonly "},{"type":"inlineCode","value":"SubagentTool"},{"type":"text","value":"[], "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", readonly "},{"type":"link","href":"../interfaces/InterruptDefinition.md","children":[{"type":"inlineCode","value":"InterruptDefinition"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">[], "},{"type":"inlineCode","value":"any"},{"type":"text","value":">[]"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TextActivityOptionsWithContext"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TAdapter"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":", "},{"type":"inlineCode","value":"TStream"},{"type":"text","value":", "},{"type":"inlineCode","value":"TTools"},{"type":"text","value":", "},{"type":"inlineCode","value":"TInterrupts"},{"type":"text","value":", "},{"type":"inlineCode","value":"TContext"},{"type":"text","value":", "},{"type":"inlineCode","value":"TMiddleware"},{"type":"text","value":", "},{"type":"inlineCode","value":"TAgents"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TextActivityResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":", "},{"type":"inlineCode","value":"TStream"},{"type":"text","value":", "},{"type":"inlineCode","value":"TTools"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Full agentic text (streaming with tools)"}]}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nfor await (const chunk of chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'What is the weather?' }],\n  tools: [weatherTool]\n})) {\n  if (chunk.type === 'TEXT_MESSAGE_CONTENT') {\n    console.log(chunk.delta)\n  }\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"One-shot text (streaming without tools)"}]}]},{"type":"code","value":"for await (const chunk of chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }]\n})) {\n  console.log(chunk)\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Non-streaming text (stream: false)"}]}]},{"type":"code","value":"const text = await chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n  stream: false\n})\n// text is a string with the full response","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Agentic structured output (tools + structured response)"}]}]},{"type":"code","value":"import { z } from 'zod'\n\nconst result = await chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Research and summarize the topic' }],\n  tools: [researchTool, analyzeTool],\n  outputSchema: z.object({\n    summary: z.string(),\n    keyPoints: z.array(z.string())\n  })\n})\n// result is { summary: string, keyPoints: string[] }","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tadapter","text":"TAdapter","level":3},{"id":"tschema","text":"TSchema","level":3},{"id":"tstream","text":"TStream","level":3},{"id":"ttools","text":"TTools","level":3},{"id":"tinterrupts","text":"TInterrupts","level":3},{"id":"tcontext","text":"TContext","level":3},{"id":"tmiddleware","text":"TMiddleware","level":3},{"id":"tagents","text":"TAgents","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction chat<TAdapter, TSchema, TStream, TTools, TInterrupts, TContext, TMiddleware, TAgents>(options): TextActivityResult<TSchema, TStream, TTools>;\n```\n\nDefined in: [packages/ai/src/activities/chat/index.ts:5155](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/index.ts#L5155)\n\nText activity - handles agentic text generation, one-shot text generation, and agentic structured output.\n\nThis activity supports four modes:\n1. **Streaming agentic text**: Stream responses with automatic tool execution\n2. **Streaming one-shot text**: Simple streaming request/response without tools\n3. **Non-streaming text**: Returns collected text as a string (stream: false)\n4. **Agentic structured output**: Run tools, then return structured data\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`AnyTextAdapter`](../type-aliases/AnyTextAdapter.md)\n\n### TSchema\n\n`TSchema` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n### TStream\n\n`TStream` *extends* `boolean` = `boolean`\n\n### TTools\n\n`TTools` *extends* \n  \\| readonly (\n  \\| `Omit`\\<[`Tool`](../interfaces/Tool.md)\\<`any`, `any`, `any`, `any`\\>, `\"execute\"`\\> & `object` & `object`\n  \\| [`ProviderTool`](../interfaces/ProviderTool.md)\\<`string`, `TAdapter`\\[`\"~types\"`\\]\\[`\"toolCapabilities\"`\\]\\[`number`\\]\\>)[]\n  \\| `undefined` = \n  \\| readonly (\n  \\| `Omit`\\<[`Tool`](../interfaces/Tool.md)\\<`any`, `any`, `any`, `any`\\>, `\"execute\"`\\> & `object` & `object`\n  \\| [`ProviderTool`](../interfaces/ProviderTool.md)\\<`string`, `TAdapter`\\[`\"~types\"`\\]\\[`\"toolCapabilities\"`\\]\\[`number`\\]\\>)[]\n  \\| `undefined`\n\n### TInterrupts\n\n`TInterrupts` *extends* readonly [`InterruptDefinition`](../interfaces/InterruptDefinition.md)\\<`any`, `any`, `any`, `any`, `any`\\>[] = \\[\\]\n\n### TContext\n\n`TContext` = `unknown`\n\n### TMiddleware\n\n`TMiddleware` *extends* `unknown`[] \\| `undefined` = `undefined`\n\n### TAgents\n\n`TAgents` *extends* readonly [`DefinedAgent`](../interfaces/DefinedAgent.md)\\<`string`, readonly `SubagentTool`[], [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined`, readonly [`InterruptDefinition`](../interfaces/InterruptDefinition.md)\\<`any`, `any`, `any`, `any`, `any`\\>[], `any`\\>[] = readonly [`DefinedAgent`](../interfaces/DefinedAgent.md)\\<`string`, readonly `SubagentTool`[], [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined`, readonly [`InterruptDefinition`](../interfaces/InterruptDefinition.md)\\<`any`, `any`, `any`, `any`, `any`\\>[], `any`\\>[]\n\n## Parameters\n\n### options\n\n`TextActivityOptionsWithContext`\\<`TAdapter`, `TSchema`, `TStream`, `TTools`, `TInterrupts`, `TContext`, `TMiddleware`, `TAgents`\\>\n\n## Returns\n\n`TextActivityResult`\\<`TSchema`, `TStream`, `TTools`\\>\n\n## Examples\n\n**Full agentic text (streaming with tools)**\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nfor await (const chunk of chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'What is the weather?' }],\n  tools: [weatherTool]\n})) {\n  if (chunk.type === 'TEXT_MESSAGE_CONTENT') {\n    console.log(chunk.delta)\n  }\n}\n```\n\n**One-shot text (streaming without tools)**\n\n```ts\nfor await (const chunk of chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }]\n})) {\n  console.log(chunk)\n}\n```\n\n**Non-streaming text (stream: false)**\n\n```ts\nconst text = await chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n  stream: false\n})\n// text is a string with the full response\n```\n\n**Agentic structured output (tools + structured response)**\n\n```ts\nimport { z } from 'zod'\n\nconst result = await chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Research and summarize the topic' }],\n  tools: [researchTool, analyzeTool],\n  outputSchema: z.object({\n    summary: z.string(),\n    keyPoints: z.array(z.string())\n  })\n})\n// result is { summary: string, keyPoints: string[] }\n```\n","originalRawMarkdown":"---\nid: chat\ntitle: chat\n---\n\n```ts\nfunction chat<TAdapter, TSchema, TStream, TTools, TInterrupts, TContext, TMiddleware, TAgents>(options): TextActivityResult<TSchema, TStream, TTools>;\n```\n\nDefined in: [packages/ai/src/activities/chat/index.ts:5155](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/index.ts#L5155)\n\nText activity - handles agentic text generation, one-shot text generation, and agentic structured output.\n\nThis activity supports four modes:\n1. **Streaming agentic text**: Stream responses with automatic tool execution\n2. **Streaming one-shot text**: Simple streaming request/response without tools\n3. **Non-streaming text**: Returns collected text as a string (stream: false)\n4. **Agentic structured output**: Run tools, then return structured data\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`AnyTextAdapter`](../type-aliases/AnyTextAdapter.md)\n\n### TSchema\n\n`TSchema` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n### TStream\n\n`TStream` *extends* `boolean` = `boolean`\n\n### TTools\n\n`TTools` *extends* \n  \\| readonly (\n  \\| `Omit`\\<[`Tool`](../interfaces/Tool.md)\\<`any`, `any`, `any`, `any`\\>, `\"execute\"`\\> & `object` & `object`\n  \\| [`ProviderTool`](../interfaces/ProviderTool.md)\\<`string`, `TAdapter`\\[`\"~types\"`\\]\\[`\"toolCapabilities\"`\\]\\[`number`\\]\\>)[]\n  \\| `undefined` = \n  \\| readonly (\n  \\| `Omit`\\<[`Tool`](../interfaces/Tool.md)\\<`any`, `any`, `any`, `any`\\>, `\"execute\"`\\> & `object` & `object`\n  \\| [`ProviderTool`](../interfaces/ProviderTool.md)\\<`string`, `TAdapter`\\[`\"~types\"`\\]\\[`\"toolCapabilities\"`\\]\\[`number`\\]\\>)[]\n  \\| `undefined`\n\n### TInterrupts\n\n`TInterrupts` *extends* readonly [`InterruptDefinition`](../interfaces/InterruptDefinition.md)\\<`any`, `any`, `any`, `any`, `any`\\>[] = \\[\\]\n\n### TContext\n\n`TContext` = `unknown`\n\n### TMiddleware\n\n`TMiddleware` *extends* `unknown`[] \\| `undefined` = `undefined`\n\n### TAgents\n\n`TAgents` *extends* readonly [`DefinedAgent`](../interfaces/DefinedAgent.md)\\<`string`, readonly `SubagentTool`[], [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined`, readonly [`InterruptDefinition`](../interfaces/InterruptDefinition.md)\\<`any`, `any`, `any`, `any`, `any`\\>[], `any`\\>[] = readonly [`DefinedAgent`](../interfaces/DefinedAgent.md)\\<`string`, readonly `SubagentTool`[], [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined`, readonly [`InterruptDefinition`](../interfaces/InterruptDefinition.md)\\<`any`, `any`, `any`, `any`, `any`\\>[], `any`\\>[]\n\n## Parameters\n\n### options\n\n`TextActivityOptionsWithContext`\\<`TAdapter`, `TSchema`, `TStream`, `TTools`, `TInterrupts`, `TContext`, `TMiddleware`, `TAgents`\\>\n\n## Returns\n\n`TextActivityResult`\\<`TSchema`, `TStream`, `TTools`\\>\n\n## Examples\n\n**Full agentic text (streaming with tools)**\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nfor await (const chunk of chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'What is the weather?' }],\n  tools: [weatherTool]\n})) {\n  if (chunk.type === 'TEXT_MESSAGE_CONTENT') {\n    console.log(chunk.delta)\n  }\n}\n```\n\n**One-shot text (streaming without tools)**\n\n```ts\nfor await (const chunk of chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }]\n})) {\n  console.log(chunk)\n}\n```\n\n**Non-streaming text (stream: false)**\n\n```ts\nconst text = await chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Hello!' }],\n  stream: false\n})\n// text is a string with the full response\n```\n\n**Agentic structured output (tools + structured response)**\n\n```ts\nimport { z } from 'zod'\n\nconst result = await chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'Research and summarize the topic' }],\n  tools: [researchTool, analyzeTool],\n  outputSchema: z.object({\n    summary: z.string(),\n    keyPoints: z.array(z.string())\n  })\n})\n// result is { summary: string, keyPoints: string[] }\n```\n"}
