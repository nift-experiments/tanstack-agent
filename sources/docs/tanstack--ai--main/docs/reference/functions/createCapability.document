e","value":"TName"},{"type":"text","value":">("},{"type":"inlineCode","value":"name"},{"type":"text","value":") => "},{"type":"link","href":"../type-aliases/Capability.md","children":[{"type":"inlineCode","value":"Capability"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TName"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Provider + consumer middleware"}]}]},{"type":"code","value":"const counterCapability = createCapability<{ value: number }>()('counter')\nconst [getCounter, provideCounter] = counterCapability\n\nconst withCounter = defineChatMiddleware({\n  name: 'counter',\n  provides: [counterCapability],\n  setup(ctx) { provideCounter(ctx, { value: 0 }) },\n})\n\nconst readsCounter = defineChatMiddleware({\n  name: 'reads-counter',\n  requires: [counterCapability],\n  onChunk(ctx) { getCounter(ctx).value++ },\n})\n\nchat({ adapter, messages, middleware: [withCounter, readsCounter] })","lang":"ts"},{"type":"heading","depth":2,"id":"remarks","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"Capability "},{"type":"inlineCode","value":"name"},{"type":"text","value":"s must be unique across your app: compile-time\ncoverage tracking keys on the name literal (runtime keys on reference)."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2},{"id":"remarks","text":"Remarks","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createCapability<TValue>(): <TName>(name) => Capability<TValue, TName>;\n```\n\nDefined in: [packages/ai/src/activities/chat/middleware/capabilities.ts:114](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/middleware/capabilities.ts#L114)\n\nCreate a capability. Returns a hybrid handle that destructures to\n`[get, provide]` and is itself the identity for `requires`/`provides`.\n\nCurried so the value type is supplied explicitly while the name literal is\nINFERRED from the argument: `createCapability<T>()('name')`. (A single call\n`createCapability<T>('name')` cannot work — supplying `T` explicitly stops\nTypeScript inferring the name, collapsing it to `string` and defeating the\ncompile-time coverage check that keys on the literal name.)\n\n## Type Parameters\n\n### TValue\n\n`TValue` = `unknown`\n\n## Returns\n\n\\<`TName`\\>(`name`) => [`Capability`](../type-aliases/Capability.md)\\<`TValue`, `TName`\\>\n\n## Example\n\n**Provider + consumer middleware**\n\n```ts\nconst counterCapability = createCapability<{ value: number }>()('counter')\nconst [getCounter, provideCounter] = counterCapability\n\nconst withCounter = defineChatMiddleware({\n  name: 'counter',\n  provides: [counterCapability],\n  setup(ctx) { provideCounter(ctx, { value: 0 }) },\n})\n\nconst readsCounter = defineChatMiddleware({\n  name: 'reads-counter',\n  requires: [counterCapability],\n  onChunk(ctx) { getCounter(ctx).value++ },\n})\n\nchat({ adapter, messages, middleware: [withCounter, readsCounter] })\n```\n\n## Remarks\n\nCapability `name`s must be unique across your app: compile-time\ncoverage tracking keys on the name literal (runtime keys on reference).\n","originalRawMarkdown":"---\nid: createCapability\ntitle: createCapability\n---\n\n```ts\nfunction createCapability<TValue>(): <TName>(name) => Capability<TValue, TName>;\n```\n\nDefined in: [packages/ai/src/activities/chat/middleware/capabilities.ts:114](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/middleware/capabilities.ts#L114)\n\nCreate a capability. Returns a hybrid handle that destructures to\n`[get, provide]` and is itself the identity for `requires`/`provides`.\n\nCurried so the value type is supplied explicitly while the name literal is\nINFERRED from the argument: `createCapability<T>()('name')`. (A single call\n`createCapability<T>('name')` cannot work — supplying `T` explicitly stops\nTypeScript inferring the name, collapsing it to `string` and defeating the\ncompile-time coverage check that keys on the literal name.)\n\n## Type Parameters\n\n### TValue\n\n`TValue` = `unknown`\n\n## Returns\n\n\\<`TName`\\>(`name`) => [`Capability`](../type-aliases/Capability.md)\\<`TValue`, `TName`\\>\n\n## Example\n\n**Provider + consumer middleware**\n\n```ts\nconst counterCapability = createCapability<{ value: number }>()('counter')\nconst [getCounter, provideCounter] = counterCapability\n\nconst withCounter = defineChatMiddleware({\n  name: 'counter',\n  provides: [counterCapability],\n  setup(ctx) { provideCounter(ctx, { value: 0 }) },\n})\n\nconst readsCounter = defineChatMiddleware({\n  name: 'reads-counter',\n  requires: [counterCapability],\n  onChunk(ctx) { getCounter(ctx).value++ },\n})\n\nchat({ adapter, messages, middleware: [withCounter, readsCounter] })\n```\n\n## Remarks\n\nCapability `name`s must be unique across your app: compile-time\ncoverage tracking keys on the name literal (runtime keys on reference).\n"}
