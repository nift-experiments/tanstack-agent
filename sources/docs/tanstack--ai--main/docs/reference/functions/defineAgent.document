xt","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" = "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":3,"id":"tinterrupts","children":[{"type":"text","value":"TInterrupts"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TInterrupts"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"link","href":"../interfaces/InterruptDefinition.md","children":[{"type":"inlineCode","value":"InterruptDefinition"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">[] = readonly []"}]},{"type":"heading","depth":3,"id":"tinput","children":[{"type":"text","value":"TInput"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TInput"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" = "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"agent","children":[{"type":"text","value":"agent"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/DefinedAgent.md","children":[{"type":"inlineCode","value":"DefinedAgent"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TName"},{"type":"text","value":", "},{"type":"inlineCode","value":"TTools"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":", "},{"type":"inlineCode","value":"TInterrupts"},{"type":"text","value":", "},{"type":"inlineCode","value":"TInput"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/DefinedAgent.md","children":[{"type":"inlineCode","value":"DefinedAgent"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TName"},{"type":"text","value":", "},{"type":"inlineCode","value":"TTools"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":", "},{"type":"inlineCode","value":"TInterrupts"},{"type":"text","value":", "},{"type":"inlineCode","value":"TInput"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const researcher = defineAgent({\n  name: 'researcher',\n  description: 'Looks up facts',\n  run: (ctx) =>\n    chat({\n      adapter: openaiText('gpt-5.6'),\n      messages: ctx.messages,\n      threadId: ctx.threadId,\n      runId: ctx.runId,\n      parentRunId: ctx.parentRunId,\n      subagentRunId: ctx.subagentRunId,\n      resume: ctx.resume,\n    }),\n})","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tname","text":"TName","level":3},{"id":"ttools","text":"TTools","level":3},{"id":"tschema","text":"TSchema","level":3},{"id":"tinterrupts","text":"TInterrupts","level":3},{"id":"tinput","text":"TInput","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"agent","text":"agent","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction defineAgent<TName, TTools, TSchema, TInterrupts, TInput>(agent): DefinedAgent<TName, TTools, TSchema, TInterrupts, TInput>;\n```\n\nDefined in: [packages/ai/src/activities/chat/agents/define-agent.ts:116](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/agents/define-agent.ts#L116)\n\nDefine a named child agent. Pass the same object to `chat({ subagents })`.\nPass the agents array to `useChat({ subagents })` when you render parts\nyourself. The hook uses it for types only. It does not call `run`.\n\n## Type Parameters\n\n### TName\n\n`TName` *extends* `string`\n\n### TTools\n\n`TTools` *extends* readonly `SubagentTool`[] = readonly \\[\\]\n\n### TSchema\n\n`TSchema` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n### TInterrupts\n\n`TInterrupts` *extends* readonly [`InterruptDefinition`](../interfaces/InterruptDefinition.md)\\<`any`, `any`, `any`, `any`, `any`\\>[] = readonly \\[\\]\n\n### TInput\n\n`TInput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n## Parameters\n\n### agent\n\n[`DefinedAgent`](../interfaces/DefinedAgent.md)\\<`TName`, `TTools`, `TSchema`, `TInterrupts`, `TInput`\\>\n\n## Returns\n\n[`DefinedAgent`](../interfaces/DefinedAgent.md)\\<`TName`, `TTools`, `TSchema`, `TInterrupts`, `TInput`\\>\n\n## Example\n\n```ts\nconst researcher = defineAgent({\n  name: 'researcher',\n  description: 'Looks up facts',\n  run: (ctx) =>\n    chat({\n      adapter: openaiText('gpt-5.6'),\n      messages: ctx.messages,\n      threadId: ctx.threadId,\n      runId: ctx.runId,\n      parentRunId: ctx.parentRunId,\n      subagentRunId: ctx.subagentRunId,\n      resume: ctx.resume,\n    }),\n})\n```\n","originalRawMarkdown":"---\nid: defineAgent\ntitle: defineAgent\n---\n\n```ts\nfunction defineAgent<TName, TTools, TSchema, TInterrupts, TInput>(agent): DefinedAgent<TName, TTools, TSchema, TInterrupts, TInput>;\n```\n\nDefined in: [packages/ai/src/activities/chat/agents/define-agent.ts:116](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/agents/define-agent.ts#L116)\n\nDefine a named child agent. Pass the same object to `chat({ subagents })`.\nPass the agents array to `useChat({ subagents })` when you render parts\nyourself. The hook uses it for types only. It does not call `run`.\n\n## Type Parameters\n\n### TName\n\n`TName` *extends* `string`\n\n### TTools\n\n`TTools` *extends* readonly `SubagentTool`[] = readonly \\[\\]\n\n### TSchema\n\n`TSchema` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n### TInterrupts\n\n`TInterrupts` *extends* readonly [`InterruptDefinition`](../interfaces/InterruptDefinition.md)\\<`any`, `any`, `any`, `any`, `any`\\>[] = readonly \\[\\]\n\n### TInput\n\n`TInput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n## Parameters\n\n### agent\n\n[`DefinedAgent`](../interfaces/DefinedAgent.md)\\<`TName`, `TTools`, `TSchema`, `TInterrupts`, `TInput`\\>\n\n## Returns\n\n[`DefinedAgent`](../interfaces/DefinedAgent.md)\\<`TName`, `TTools`, `TSchema`, `TInterrupts`, `TInput`\\>\n\n## Example\n\n```ts\nconst researcher = defineAgent({\n  name: 'researcher',\n  description: 'Looks up facts',\n  run: (ctx) =>\n    chat({\n      adapter: openaiText('gpt-5.6'),\n      messages: ctx.messages,\n      threadId: ctx.threadId,\n      runId: ctx.runId,\n      parentRunId: ctx.parentRunId,\n      subagentRunId: ctx.subagentRunId,\n      resume: ctx.resume,\n    }),\n})\n```\n"}
