2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/EmbeddingResult.md","children":[{"type":"inlineCode","value":"EmbeddingResult"}]},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Embed a single text"}]}]},{"type":"code","value":"import { embed } from '@tanstack/ai'\nimport { openaiEmbedding } from '@tanstack/ai-openai'\n\nconst result = await embed({\n  adapter: openaiEmbedding('text-embedding-3-small'),\n  input: 'a red guitar',\n})\n\nconsole.log(result.embeddings[0].vector)","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Batch with requested dimensions"}]}]},{"type":"code","value":"const result = await embed({\n  adapter: openaiEmbedding('text-embedding-3-large'),\n  input: ['a red guitar', 'a blue drum kit'],\n  dimensions: 1024,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Multimodal embedding (text + image fused into one vector)"}]}]},{"type":"code","value":"import { cohereEmbedding } from '@tanstack/ai-cohere'\n\n// A nested array of parts fuses them into a single vector. The outer array\n// is the item list, so this embeds one fused item into one vector.\nconst result = await embed({\n  adapter: cohereEmbedding('embed-v4.0'),\n  input: [\n    [\n      { type: 'text', content: 'product photo' },\n      { type: 'image', source: { type: 'data', value: base64, mimeType: 'image/png' } },\n    ],\n  ],\n  modelOptions: { inputType: 'search_document' },\n})","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tadapter","text":"TAdapter","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction embed<TAdapter>(options): Promise<EmbeddingResult>;\n```\n\nDefined in: [packages/ai/src/activities/embed/index.ts:190](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/index.ts#L190)\n\nEmbed activity - generates embedding vectors from text and image inputs.\n\nAccepts a single item or an array of items; the result always carries an\n`embeddings` array with one vector per input item, in input order.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`EmbeddingAdapter`](../interfaces/EmbeddingAdapter.md)\\<`string`, `any`, `any`, `any`\\>\n\n## Parameters\n\n### options\n\n`EmbedOptions`\\<`TAdapter`\\>\n\n## Returns\n\n`Promise`\\<[`EmbeddingResult`](../interfaces/EmbeddingResult.md)\\>\n\n## Examples\n\n**Embed a single text**\n\n```ts\nimport { embed } from '@tanstack/ai'\nimport { openaiEmbedding } from '@tanstack/ai-openai'\n\nconst result = await embed({\n  adapter: openaiEmbedding('text-embedding-3-small'),\n  input: 'a red guitar',\n})\n\nconsole.log(result.embeddings[0].vector)\n```\n\n**Batch with requested dimensions**\n\n```ts\nconst result = await embed({\n  adapter: openaiEmbedding('text-embedding-3-large'),\n  input: ['a red guitar', 'a blue drum kit'],\n  dimensions: 1024,\n})\n```\n\n**Multimodal embedding (text + image fused into one vector)**\n\n```ts\nimport { cohereEmbedding } from '@tanstack/ai-cohere'\n\n// A nested array of parts fuses them into a single vector. The outer array\n// is the item list, so this embeds one fused item into one vector.\nconst result = await embed({\n  adapter: cohereEmbedding('embed-v4.0'),\n  input: [\n    [\n      { type: 'text', content: 'product photo' },\n      { type: 'image', source: { type: 'data', value: base64, mimeType: 'image/png' } },\n    ],\n  ],\n  modelOptions: { inputType: 'search_document' },\n})\n```\n","originalRawMarkdown":"---\nid: embed\ntitle: embed\n---\n\n```ts\nfunction embed<TAdapter>(options): Promise<EmbeddingResult>;\n```\n\nDefined in: [packages/ai/src/activities/embed/index.ts:190](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/index.ts#L190)\n\nEmbed activity - generates embedding vectors from text and image inputs.\n\nAccepts a single item or an array of items; the result always carries an\n`embeddings` array with one vector per input item, in input order.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`EmbeddingAdapter`](../interfaces/EmbeddingAdapter.md)\\<`string`, `any`, `any`, `any`\\>\n\n## Parameters\n\n### options\n\n`EmbedOptions`\\<`TAdapter`\\>\n\n## Returns\n\n`Promise`\\<[`EmbeddingResult`](../interfaces/EmbeddingResult.md)\\>\n\n## Examples\n\n**Embed a single text**\n\n```ts\nimport { embed } from '@tanstack/ai'\nimport { openaiEmbedding } from '@tanstack/ai-openai'\n\nconst result = await embed({\n  adapter: openaiEmbedding('text-embedding-3-small'),\n  input: 'a red guitar',\n})\n\nconsole.log(result.embeddings[0].vector)\n```\n\n**Batch with requested dimensions**\n\n```ts\nconst result = await embed({\n  adapter: openaiEmbedding('text-embedding-3-large'),\n  input: ['a red guitar', 'a blue drum kit'],\n  dimensions: 1024,\n})\n```\n\n**Multimodal embedding (text + image fused into one vector)**\n\n```ts\nimport { cohereEmbedding } from '@tanstack/ai-cohere'\n\n// A nested array of parts fuses them into a single vector. The outer array\n// is the item list, so this embeds one fused item into one vector.\nconst result = await embed({\n  adapter: cohereEmbedding('embed-v4.0'),\n  input: [\n    [\n      { type: 'text', content: 'product photo' },\n      { type: 'image', source: { type: 'data', value: base64, mimeType: 'image/png' } },\n    ],\n  ],\n  modelOptions: { inputType: 'search_document' },\n})\n```\n"}
