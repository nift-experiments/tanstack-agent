""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"image\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"audio\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"video\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"document\""},{"type":"text","value":")[], "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", readonly "},{"type":"inlineCode","value":"string"},{"type":"text","value":"[], readonly "},{"type":"inlineCode","value":"string"},{"type":"text","value":"[]>[]"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"factory","children":[{"type":"text","value":"factory"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFactory"}]},{"type":"paragraph","children":[{"type":"text","value":"The original adapter factory function (e.g., "},{"type":"inlineCode","value":"openaiText"},{"type":"text","value":", "},{"type":"inlineCode","value":"anthropicText"},{"type":"text","value":")"}]},{"type":"heading","depth":3,"id":"custommodels","children":[{"type":"text","value":"_customModels"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TDefs"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ExtendedFactory"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFactory"},{"type":"text","value":", "},{"type":"inlineCode","value":"TDefs"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A new factory function that accepts both original and custom models"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { extendAdapter, createModel } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Define custom models\nconst customModels = [\n  createModel('my-fine-tuned-gpt4', ['text', 'image']),\n  createModel('local-llama', ['text']),\n] as const\n\n// Create extended adapter\nconst myOpenai = extendAdapter(openaiText, customModels)\n\n// Use with original models - full type inference preserved\nconst gpt4 = myOpenai('gpt-4o')\n\n// Use with custom models\nconst custom = myOpenai('my-fine-tuned-gpt4')\n\n// Type error: 'invalid-model' is not a valid model\n// myOpenai('invalid-model')\n\n// Works with chat()\nchat({\n  adapter: myOpenai('my-fine-tuned-gpt4'),\n  messages: [...]\n})","lang":"typescript"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfactory","text":"TFactory","level":3},{"id":"tdefs","text":"TDefs","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"factory","text":"factory","level":3},{"id":"custommodels","text":"_customModels","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction extendAdapter<TFactory, TDefs>(factory, _customModels): ExtendedFactory<TFactory, TDefs>;\n```\n\nDefined in: [packages/ai/src/extend-adapter.ts:247](https://github.com/TanStack/ai/blob/main/packages/ai/src/extend-adapter.ts#L247)\n\nExtends an existing adapter factory with additional custom models.\n\nThe extended adapter accepts both original models (with full original type inference)\nand custom models (with types from your definitions).\n\nAt runtime, this simply passes through to the original factory - no validation is performed.\nThe original factory's signature is fully preserved, including any config parameters.\n\n## Type Parameters\n\n### TFactory\n\n`TFactory` *extends* `AnyAdapterFactory`\n\n### TDefs\n\n`TDefs` *extends* readonly [`ExtendedModelDef`](../interfaces/ExtendedModelDef.md)\\<`string`, readonly (`\"text\"` \\| `\"image\"` \\| `\"audio\"` \\| `\"video\"` \\| `\"document\"`)[], `unknown`, readonly `string`[], readonly `string`[]\\>[]\n\n## Parameters\n\n### factory\n\n`TFactory`\n\nThe original adapter factory function (e.g., `openaiText`, `anthropicText`)\n\n### \\_customModels\n\n`TDefs`\n\n## Returns\n\n`ExtendedFactory`\\<`TFactory`, `TDefs`\\>\n\nA new factory function that accepts both original and custom models\n\n## Example\n\n```typescript\nimport { extendAdapter, createModel } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Define custom models\nconst customModels = [\n  createModel('my-fine-tuned-gpt4', ['text', 'image']),\n  createModel('local-llama', ['text']),\n] as const\n\n// Create extended adapter\nconst myOpenai = extendAdapter(openaiText, customModels)\n\n// Use with original models - full type inference preserved\nconst gpt4 = myOpenai('gpt-4o')\n\n// Use with custom models\nconst custom = myOpenai('my-fine-tuned-gpt4')\n\n// Type error: 'invalid-model' is not a valid model\n// myOpenai('invalid-model')\n\n// Works with chat()\nchat({\n  adapter: myOpenai('my-fine-tuned-gpt4'),\n  messages: [...]\n})\n```\n","originalRawMarkdown":"---\nid: extendAdapter\ntitle: extendAdapter\n---\n\n```ts\nfunction extendAdapter<TFactory, TDefs>(factory, _customModels): ExtendedFactory<TFactory, TDefs>;\n```\n\nDefined in: [packages/ai/src/extend-adapter.ts:247](https://github.com/TanStack/ai/blob/main/packages/ai/src/extend-adapter.ts#L247)\n\nExtends an existing adapter factory with additional custom models.\n\nThe extended adapter accepts both original models (with full original type inference)\nand custom models (with types from your definitions).\n\nAt runtime, this simply passes through to the original factory - no validation is performed.\nThe original factory's signature is fully preserved, including any config parameters.\n\n## Type Parameters\n\n### TFactory\n\n`TFactory` *extends* `AnyAdapterFactory`\n\n### TDefs\n\n`TDefs` *extends* readonly [`ExtendedModelDef`](../interfaces/ExtendedModelDef.md)\\<`string`, readonly (`\"text\"` \\| `\"image\"` \\| `\"audio\"` \\| `\"video\"` \\| `\"document\"`)[], `unknown`, readonly `string`[], readonly `string`[]\\>[]\n\n## Parameters\n\n### factory\n\n`TFactory`\n\nThe original adapter factory function (e.g., `openaiText`, `anthropicText`)\n\n### \\_customModels\n\n`TDefs`\n\n## Returns\n\n`ExtendedFactory`\\<`TFactory`, `TDefs`\\>\n\nA new factory function that accepts both original and custom models\n\n## Example\n\n```typescript\nimport { extendAdapter, createModel } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\n// Define custom models\nconst customModels = [\n  createModel('my-fine-tuned-gpt4', ['text', 'image']),\n  createModel('local-llama', ['text']),\n] as const\n\n// Create extended adapter\nconst myOpenai = extendAdapter(openaiText, customModels)\n\n// Use with original models - full type inference preserved\nconst gpt4 = myOpenai('gpt-4o')\n\n// Use with custom models\nconst custom = myOpenai('my-fine-tuned-gpt4')\n\n// Type error: 'invalid-model' is not a valid model\n// myOpenai('invalid-model')\n\n// Works with chat()\nchat({\n  adapter: myOpenai('my-fine-tuned-gpt4'),\n  messages: [...]\n})\n```\n"}
