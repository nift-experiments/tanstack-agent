type":"link","href":"../interfaces/FileHandle.md","children":[{"type":"inlineCode","value":"FileHandle"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TProvider"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ContentPartFileSource.md","children":[{"type":"inlineCode","value":"ContentPartFileSource"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TProvider"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const handle = await uploadFile({ adapter: openaiFiles(), input })\nmessages.push({ role: 'user', content: [\n  { type: 'image', source: fileSourceFromHandle(handle) },\n] })","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tprovider","text":"TProvider","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"handle","text":"handle","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction fileSourceFromHandle<TProvider>(handle): ContentPartFileSource<TProvider>;\n```\n\nDefined in: [packages/ai/src/activities/files/index.ts:104](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/files/index.ts#L104)\n\nBuild a `{ type: 'file' }` content source from an uploaded\n[FileHandle](../interfaces/FileHandle.md), for use in a chat message (image/audio/document part\n`source`).\n\nThe source's `value` is the handle's wire form: the handle URL when the\nprovider exposes one (Gemini, fal, Grok), otherwise the opaque id (OpenAI,\nAnthropic). `provider` records the issuer, so an adapter for a different\nprovider rejects the source rather than sending a handle it cannot resolve.\n\n## Type Parameters\n\n### TProvider\n\n`TProvider` *extends* `string`\n\n## Parameters\n\n### handle\n\n[`FileHandle`](../interfaces/FileHandle.md)\\<`TProvider`\\>\n\n## Returns\n\n[`ContentPartFileSource`](../interfaces/ContentPartFileSource.md)\\<`TProvider`\\>\n\n## Example\n\n```ts\nconst handle = await uploadFile({ adapter: openaiFiles(), input })\nmessages.push({ role: 'user', content: [\n  { type: 'image', source: fileSourceFromHandle(handle) },\n] })\n```\n","originalRawMarkdown":"---\nid: fileSourceFromHandle\ntitle: fileSourceFromHandle\n---\n\n```ts\nfunction fileSourceFromHandle<TProvider>(handle): ContentPartFileSource<TProvider>;\n```\n\nDefined in: [packages/ai/src/activities/files/index.ts:104](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/files/index.ts#L104)\n\nBuild a `{ type: 'file' }` content source from an uploaded\n[FileHandle](../interfaces/FileHandle.md), for use in a chat message (image/audio/document part\n`source`).\n\nThe source's `value` is the handle's wire form: the handle URL when the\nprovider exposes one (Gemini, fal, Grok), otherwise the opaque id (OpenAI,\nAnthropic). `provider` records the issuer, so an adapter for a different\nprovider rejects the source rather than sending a handle it cannot resolve.\n\n## Type Parameters\n\n### TProvider\n\n`TProvider` *extends* `string`\n\n## Parameters\n\n### handle\n\n[`FileHandle`](../interfaces/FileHandle.md)\\<`TProvider`\\>\n\n## Returns\n\n[`ContentPartFileSource`](../interfaces/ContentPartFileSource.md)\\<`TProvider`\\>\n\n## Example\n\n```ts\nconst handle = await uploadFile({ adapter: openaiFiles(), input })\nmessages.push({ role: 'user', content: [\n  { type: 'image', source: fileSourceFromHandle(handle) },\n] })\n```\n"}
