lean"},{"type":"text","value":" = "},{"type":"inlineCode","value":"false"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ImageActivityOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TAdapter"},{"type":"text","value":", "},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ImageActivityResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Generate a single image"}]}]},{"type":"code","value":"import { generateImage } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nconst result = await generateImage({\n  adapter: openaiImage('dall-e-3'),\n  prompt: 'A serene mountain landscape at sunset'\n})\n\nconsole.log(result.images[0].url)","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Generate multiple images"}]}]},{"type":"code","value":"const result = await generateImage({\n  adapter: openaiImage('dall-e-2'),\n  prompt: 'A cute robot mascot',\n  numberOfImages: 4,\n  size: '512x512'\n})\n\nresult.images.forEach((image, i) => {\n  console.log(`Image ${i + 1}: ${image.url}`)\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"With provider-specific options"}]}]},{"type":"code","value":"const result = await generateImage({\n  adapter: openaiImage('dall-e-3'),\n  prompt: 'A professional headshot photo',\n  size: '1024x1024',\n  modelOptions: {\n    quality: 'hd',\n    style: 'natural'\n  }\n})","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tadapter","text":"TAdapter","level":3},{"id":"tstream","text":"TStream","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction generateImage<TAdapter, TStream>(options): ImageActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/generateImage/index.ts:246](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateImage/index.ts#L246)\n\nImage activity - generates images from text prompts.\n\nUses AI image generation models to create images based on natural language descriptions.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`ImageAdapter`](../interfaces/ImageAdapter.md)\\<`string`, `any`, `any`, `any`, [`ModelInputModalitiesByName`](../type-aliases/ModelInputModalitiesByName.md)\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`ImageActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`ImageActivityResult`\\<`TStream`\\>\n\n## Examples\n\n**Generate a single image**\n\n```ts\nimport { generateImage } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nconst result = await generateImage({\n  adapter: openaiImage('dall-e-3'),\n  prompt: 'A serene mountain landscape at sunset'\n})\n\nconsole.log(result.images[0].url)\n```\n\n**Generate multiple images**\n\n```ts\nconst result = await generateImage({\n  adapter: openaiImage('dall-e-2'),\n  prompt: 'A cute robot mascot',\n  numberOfImages: 4,\n  size: '512x512'\n})\n\nresult.images.forEach((image, i) => {\n  console.log(`Image ${i + 1}: ${image.url}`)\n})\n```\n\n**With provider-specific options**\n\n```ts\nconst result = await generateImage({\n  adapter: openaiImage('dall-e-3'),\n  prompt: 'A professional headshot photo',\n  size: '1024x1024',\n  modelOptions: {\n    quality: 'hd',\n    style: 'natural'\n  }\n})\n```\n","originalRawMarkdown":"---\nid: generateImage\ntitle: generateImage\n---\n\n```ts\nfunction generateImage<TAdapter, TStream>(options): ImageActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/generateImage/index.ts:246](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateImage/index.ts#L246)\n\nImage activity - generates images from text prompts.\n\nUses AI image generation models to create images based on natural language descriptions.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`ImageAdapter`](../interfaces/ImageAdapter.md)\\<`string`, `any`, `any`, `any`, [`ModelInputModalitiesByName`](../type-aliases/ModelInputModalitiesByName.md)\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`ImageActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`ImageActivityResult`\\<`TStream`\\>\n\n## Examples\n\n**Generate a single image**\n\n```ts\nimport { generateImage } from '@tanstack/ai'\nimport { openaiImage } from '@tanstack/ai-openai'\n\nconst result = await generateImage({\n  adapter: openaiImage('dall-e-3'),\n  prompt: 'A serene mountain landscape at sunset'\n})\n\nconsole.log(result.images[0].url)\n```\n\n**Generate multiple images**\n\n```ts\nconst result = await generateImage({\n  adapter: openaiImage('dall-e-2'),\n  prompt: 'A cute robot mascot',\n  numberOfImages: 4,\n  size: '512x512'\n})\n\nresult.images.forEach((image, i) => {\n  console.log(`Image ${i + 1}: ${image.url}`)\n})\n```\n\n**With provider-specific options**\n\n```ts\nconst result = await generateImage({\n  adapter: openaiImage('dall-e-3'),\n  prompt: 'A professional headshot photo',\n  size: '1024x1024',\n  modelOptions: {\n    quality: 'hd',\n    style: 'natural'\n  }\n})\n```\n"}
