:"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"LiveVideoActivityOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TAdapter"},{"type":"text","value":", "},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"LiveVideoActivityResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Mint a session token on the server"}]}]},{"type":"code","value":"import { generateLiveVideo } from '@tanstack/ai'\nimport { reactorVideo } from '@tanstack/ai-reactor'\n\nconst live = await generateLiveVideo({\n  adapter: reactorVideo('helios'),\n  prompt: 'A red sports car powerslides a mountain hairpin',\n})\n\n// Hand live.token, live.model, and live.prompt to the browser.","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Live generation is an experimental feature and may change."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tadapter","text":"TAdapter","level":3},{"id":"tstream","text":"TStream","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction generateLiveVideo<TAdapter, TStream>(options): LiveVideoActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/generateLiveVideo/index.ts:155](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateLiveVideo/index.ts#L155)\n\n**`Experimental`**\n\nLive generation activity - opens a live, prompt-steerable video session.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`LiveVideoAdapter`](../interfaces/LiveVideoAdapter.md)\\<`string`, `LiveVideoProviderOptions`\\<`TAdapter`\\>\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`LiveVideoActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`LiveVideoActivityResult`\\<`TStream`\\>\n\n## Example\n\n**Mint a session token on the server**\n\n```ts\nimport { generateLiveVideo } from '@tanstack/ai'\nimport { reactorVideo } from '@tanstack/ai-reactor'\n\nconst live = await generateLiveVideo({\n  adapter: reactorVideo('helios'),\n  prompt: 'A red sports car powerslides a mountain hairpin',\n})\n\n// Hand live.token, live.model, and live.prompt to the browser.\n```\n\n Live generation is an experimental feature and may change.\n","originalRawMarkdown":"---\nid: generateLiveVideo\ntitle: generateLiveVideo\n---\n\n```ts\nfunction generateLiveVideo<TAdapter, TStream>(options): LiveVideoActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/generateLiveVideo/index.ts:155](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateLiveVideo/index.ts#L155)\n\n**`Experimental`**\n\nLive generation activity - opens a live, prompt-steerable video session.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`LiveVideoAdapter`](../interfaces/LiveVideoAdapter.md)\\<`string`, `LiveVideoProviderOptions`\\<`TAdapter`\\>\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`LiveVideoActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`LiveVideoActivityResult`\\<`TStream`\\>\n\n## Example\n\n**Mint a session token on the server**\n\n```ts\nimport { generateLiveVideo } from '@tanstack/ai'\nimport { reactorVideo } from '@tanstack/ai-reactor'\n\nconst live = await generateLiveVideo({\n  adapter: reactorVideo('helios'),\n  prompt: 'A red sports car powerslides a mountain hairpin',\n})\n\n// Hand live.token, live.model, and live.prompt to the browser.\n```\n\n Live generation is an experimental feature and may change.\n"}
