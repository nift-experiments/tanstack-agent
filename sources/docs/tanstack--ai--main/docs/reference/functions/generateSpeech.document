value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTSActivityOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TAdapter"},{"type":"text","value":", "},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTSActivityResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Generate speech from text"}]}]},{"type":"code","value":"import { generateSpeech } from '@tanstack/ai'\nimport { openaiSpeech } from '@tanstack/ai-openai'\n\nconst result = await generateSpeech({\n  adapter: openaiSpeech('tts-1-hd'),\n  text: 'Hello, welcome to TanStack AI!',\n  voice: 'nova'\n})\n\nconsole.log(result.audio) // base64-encoded audio","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"With format and speed options"}]}]},{"type":"code","value":"const result = await generateSpeech({\n  adapter: openaiSpeech('tts-1'),\n  text: 'This is slower speech.',\n  voice: 'alloy',\n  format: 'wav',\n  speed: 0.8\n})","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tadapter","text":"TAdapter","level":3},{"id":"tstream","text":"TStream","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction generateSpeech<TAdapter, TStream>(options): TTSActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/generateSpeech/index.ts:254](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateSpeech/index.ts#L254)\n\nTTS activity - generates speech from text.\n\nUses AI text-to-speech models to create audio from natural language text.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`TTSAdapter`](../interfaces/TTSAdapter.md)\\<`string`, `TTSProviderOptions`\\<`TAdapter`\\>\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`TTSActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`TTSActivityResult`\\<`TStream`\\>\n\n## Examples\n\n**Generate speech from text**\n\n```ts\nimport { generateSpeech } from '@tanstack/ai'\nimport { openaiSpeech } from '@tanstack/ai-openai'\n\nconst result = await generateSpeech({\n  adapter: openaiSpeech('tts-1-hd'),\n  text: 'Hello, welcome to TanStack AI!',\n  voice: 'nova'\n})\n\nconsole.log(result.audio) // base64-encoded audio\n```\n\n**With format and speed options**\n\n```ts\nconst result = await generateSpeech({\n  adapter: openaiSpeech('tts-1'),\n  text: 'This is slower speech.',\n  voice: 'alloy',\n  format: 'wav',\n  speed: 0.8\n})\n```\n","originalRawMarkdown":"---\nid: generateSpeech\ntitle: generateSpeech\n---\n\n```ts\nfunction generateSpeech<TAdapter, TStream>(options): TTSActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/generateSpeech/index.ts:254](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateSpeech/index.ts#L254)\n\nTTS activity - generates speech from text.\n\nUses AI text-to-speech models to create audio from natural language text.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`TTSAdapter`](../interfaces/TTSAdapter.md)\\<`string`, `TTSProviderOptions`\\<`TAdapter`\\>\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`TTSActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`TTSActivityResult`\\<`TStream`\\>\n\n## Examples\n\n**Generate speech from text**\n\n```ts\nimport { generateSpeech } from '@tanstack/ai'\nimport { openaiSpeech } from '@tanstack/ai-openai'\n\nconst result = await generateSpeech({\n  adapter: openaiSpeech('tts-1-hd'),\n  text: 'Hello, welcome to TanStack AI!',\n  voice: 'nova'\n})\n\nconsole.log(result.audio) // base64-encoded audio\n```\n\n**With format and speed options**\n\n```ts\nconst result = await generateSpeech({\n  adapter: openaiSpeech('tts-1'),\n  text: 'This is slower speech.',\n  voice: 'alloy',\n  format: 'wav',\n  speed: 0.8\n})\n```\n"}
