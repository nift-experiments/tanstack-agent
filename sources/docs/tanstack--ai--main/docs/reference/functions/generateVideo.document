{"document":{"type":"root","children":[{"type":"code","value":"function generateVideo<TAdapter, TStream>(options): TStream extends true ? AsyncIterable<AGUIEvent, any, any> : Promise<VideoJobResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateVideo/index.ts#L425","children":[{"type":"text","value":"packages/ai/src/activities/generateVideo/index.ts:425"}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"Experimental"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Generate video - creates a video generation job from a text prompt."}]},{"type":"paragraph","children":[{"type":"text","value":"Uses AI video generation models to create videos based on natural language descriptions.\nUnlike image generation, video generation is asynchronous and requires polling for completion."}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"stream: true"},{"type":"text","value":" is passed, handles the full job lifecycle automatically:\ncreate job → poll for status → stream updates → yield final result."}]},{"type":"paragraph","children":[{"type":"text","value":"Video generation is an experimental feature and may change."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tadapter","children":[{"type":"text","value":"TAdapter"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TAdapter"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../interfaces/VideoAdapter.md","children":[{"type":"inlineCode","value":"VideoAdapter"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"tstream","children":[{"type":"text","value":"TStream"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TStream"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":" = "},{"type":"inlineCode","value":"false"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"VideoCreateOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TAdapter"},{"type":"text","value":", "},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TStream"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"true"},{"type":"text","value":" ? "},{"type":"inlineCode","value":"AsyncIterable"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/AGUIEvent.md","children":[{"type":"inlineCode","value":"AGUIEvent"}]},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":"> : "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/VideoJobResult.md","children":[{"type":"inlineCode","value":"VideoJobResult"}]},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Create a video generation job"}]}]},{"type":"code","value":"import { generateVideo, getVideoJobStatus } from '@tanstack/ai'\nimport { openaiVideo } from '@tanstack/ai-openai'\n\n// Start a video generation job\nconst { jobId } = await generateVideo({\n  adapter: openaiVideo('sora-2'),\n  prompt: 'A cat chasing a dog in a sunny park'\n})\n\nconsole.log('Job started:', jobId)\n\n// The submission only OPENS the run; the poll that sees a terminal state is\n// what completes it. The `jobId` is the whole correlation — pass the same\n// `middleware` and `threadId` when you use them.\nconst status = await getVideoJobStatus({\n  adapter: openaiVideo('sora-2'),\n  jobId,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Stream the full video generation lifecycle"}]}]},{"type":"code","value":"import { generateVideo, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiVideo } from '@tanstack/ai-openai'\n\nconst stream = generateVideo({\n  adapter: openaiVideo('sora-2'),\n  prompt: 'A cat chasing a dog in a sunny park',\n  stream: true,\n  pollingInterval: 3000,\n})\n\nreturn toServerSentEventsResponse(stream)","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tadapter","text":"TAdapter","level":3},{"id":"tstream","text":"TStream","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction generateVideo<TAdapter, TStream>(options): TStream extends true ? AsyncIterable<AGUIEvent, any, any> : Promise<VideoJobResult>;\n```\n\nDefined in: [packages/ai/src/activities/generateVideo/index.ts:425](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateVideo/index.ts#L425)\n\n**`Experimental`**\n\nGenerate video - creates a video generation job from a text prompt.\n\nUses AI video generation models to create videos based on natural language descriptions.\nUnlike image generation, video generation is asynchronous and requires polling for completion.\n\nWhen `stream: true` is passed, handles the full job lifecycle automatically:\ncreate job → poll for status → stream updates → yield final result.\n\n Video generation is an experimental feature and may change.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`VideoAdapter`](../interfaces/VideoAdapter.md)\\<`string`, `any`, `any`, `any`, `any`, `any`\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`VideoCreateOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`TStream` *extends* `true` ? `AsyncIterable`\\<[`AGUIEvent`](../type-aliases/AGUIEvent.md), `any`, `any`\\> : `Promise`\\<[`VideoJobResult`](../interfaces/VideoJobResult.md)\\>\n\n## Examples\n\n**Create a video generation job**\n\n```ts\nimport { generateVideo, getVideoJobStatus } from '@tanstack/ai'\nimport { openaiVideo } from '@tanstack/ai-openai'\n\n// Start a video generation job\nconst { jobId } = await generateVideo({\n  adapter: openaiVideo('sora-2'),\n  prompt: 'A cat chasing a dog in a sunny park'\n})\n\nconsole.log('Job started:', jobId)\n\n// The submission only OPENS the run; the poll that sees a terminal state is\n// what completes it. The `jobId` is the whole correlation — pass the same\n// `middleware` and `threadId` when you use them.\nconst status = await getVideoJobStatus({\n  adapter: openaiVideo('sora-2'),\n  jobId,\n})\n```\n\n**Stream the full video generation lifecycle**\n\n```ts\nimport { generateVideo, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiVideo } from '@tanstack/ai-openai'\n\nconst stream = generateVideo({\n  adapter: openaiVideo('sora-2'),\n  prompt: 'A cat chasing a dog in a sunny park',\n  stream: true,\n  pollingInterval: 3000,\n})\n\nreturn toServerSentEventsResponse(stream)\n```\n","originalRawMarkdown":"---\nid: generateVideo\ntitle: generateVideo\n---\n\n```ts\nfunction generateVideo<TAdapter, TStream>(options): TStream extends true ? AsyncIterable<AGUIEvent, any, any> : Promise<VideoJobResult>;\n```\n\nDefined in: [packages/ai/src/activities/generateVideo/index.ts:425](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateVideo/index.ts#L425)\n\n**`Experimental`**\n\nGenerate video - creates a video generation job from a text prompt.\n\nUses AI video generation models to create videos based on natural language descriptions.\nUnlike image generation, video generation is asynchronous and requires polling for completion.\n\nWhen `stream: true` is passed, handles the full job lifecycle automatically:\ncreate job → poll for status → stream updates → yield final result.\n\n Video generation is an experimental feature and may change.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`VideoAdapter`](../interfaces/VideoAdapter.md)\\<`string`, `any`, `any`, `any`, `any`, `any`\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`VideoCreateOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`TStream` *extends* `true` ? `AsyncIterable`\\<[`AGUIEvent`](../type-aliases/AGUIEvent.md), `any`, `any`\\> : `Promise`\\<[`VideoJobResult`](../interfaces/VideoJobResult.md)\\>\n\n## Examples\n\n**Create a video generation job**\n\n```ts\nimport { generateVideo, getVideoJobStatus } from '@tanstack/ai'\nimport { openaiVideo } from '@tanstack/ai-openai'\n\n// Start a video generation job\nconst { jobId } = await generateVideo({\n  adapter: openaiVideo('sora-2'),\n  prompt: 'A cat chasing a dog in a sunny park'\n})\n\nconsole.log('Job started:', jobId)\n\n// The submission only OPENS the run; the poll that sees a terminal state is\n// what completes it. The `jobId` is the whole correlation — pass the same\n// `middleware` and `threadId` when you use them.\nconst status = await getVideoJobStatus({\n  adapter: openaiVideo('sora-2'),\n  jobId,\n})\n```\n\n**Stream the full video generation lifecycle**\n\n```ts\nimport { generateVideo, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiVideo } from '@tanstack/ai-openai'\n\nconst stream = generateVideo({\n  adapter: openaiVideo('sora-2'),\n  prompt: 'A cat chasing a dog in a sunny park',\n  stream: true,\n  pollingInterval: 3000,\n})\n\nreturn toServerSentEventsResponse(stream)\n```\n"}
