 = "},{"type":"inlineCode","value":"false"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"VoiceActivityOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TAdapter"},{"type":"text","value":", "},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"VoiceActivityResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Design a voice from a description"}]}]},{"type":"code","value":"import { generateVoice, generateSpeech } from '@tanstack/ai'\nimport { elevenlabsVoiceDesign, elevenlabsSpeech } from '@tanstack/ai-elevenlabs'\n\nconst designed = await generateVoice({\n  adapter: elevenlabsVoiceDesign('eleven_ttv_v3'),\n  prompt: 'A warm, gravelly narrator in his sixties with a slight Irish lilt',\n})\n\nconst [preview] = designed.voices\nif (!preview) throw new Error('No voice candidates returned')\n\nconst speech = await generateSpeech({\n  adapter: elevenlabsSpeech('eleven_v4'),\n  text: 'Once upon a time...',\n  voice: preview.voiceId,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Save the voice to the provider's library"}]}]},{"type":"code","value":"const saved = await generateVoice({\n  adapter: elevenlabsVoiceDesign('eleven_ttv_v3'),\n  prompt: 'A bright, upbeat product demo host',\n  name: 'Demo Host',\n  description: 'Bright, upbeat, mid-30s',\n})","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tadapter","text":"TAdapter","level":3},{"id":"tstream","text":"TStream","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction generateVoice<TAdapter, TStream>(options): VoiceActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/generateVoice/index.ts:185](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateVoice/index.ts#L185)\n\nVoice activity - creates a reusable voice.\n\nProviders create voices in one of two ways, and some support both: design a\nnew voice from a text description, or clone one from reference audio. Either\nway the result carries voice ids you pass back to `generateSpeech()`.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`VoiceAdapter`](../interfaces/VoiceAdapter.md)\\<`string`, `VoiceProviderOptions`\\<`TAdapter`\\>\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`VoiceActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`VoiceActivityResult`\\<`TStream`\\>\n\n## Examples\n\n**Design a voice from a description**\n\n```ts\nimport { generateVoice, generateSpeech } from '@tanstack/ai'\nimport { elevenlabsVoiceDesign, elevenlabsSpeech } from '@tanstack/ai-elevenlabs'\n\nconst designed = await generateVoice({\n  adapter: elevenlabsVoiceDesign('eleven_ttv_v3'),\n  prompt: 'A warm, gravelly narrator in his sixties with a slight Irish lilt',\n})\n\nconst [preview] = designed.voices\nif (!preview) throw new Error('No voice candidates returned')\n\nconst speech = await generateSpeech({\n  adapter: elevenlabsSpeech('eleven_v4'),\n  text: 'Once upon a time...',\n  voice: preview.voiceId,\n})\n```\n\n**Save the voice to the provider's library**\n\n```ts\nconst saved = await generateVoice({\n  adapter: elevenlabsVoiceDesign('eleven_ttv_v3'),\n  prompt: 'A bright, upbeat product demo host',\n  name: 'Demo Host',\n  description: 'Bright, upbeat, mid-30s',\n})\n```\n","originalRawMarkdown":"---\nid: generateVoice\ntitle: generateVoice\n---\n\n```ts\nfunction generateVoice<TAdapter, TStream>(options): VoiceActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/generateVoice/index.ts:185](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/generateVoice/index.ts#L185)\n\nVoice activity - creates a reusable voice.\n\nProviders create voices in one of two ways, and some support both: design a\nnew voice from a text description, or clone one from reference audio. Either\nway the result carries voice ids you pass back to `generateSpeech()`.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`VoiceAdapter`](../interfaces/VoiceAdapter.md)\\<`string`, `VoiceProviderOptions`\\<`TAdapter`\\>\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`VoiceActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`VoiceActivityResult`\\<`TStream`\\>\n\n## Examples\n\n**Design a voice from a description**\n\n```ts\nimport { generateVoice, generateSpeech } from '@tanstack/ai'\nimport { elevenlabsVoiceDesign, elevenlabsSpeech } from '@tanstack/ai-elevenlabs'\n\nconst designed = await generateVoice({\n  adapter: elevenlabsVoiceDesign('eleven_ttv_v3'),\n  prompt: 'A warm, gravelly narrator in his sixties with a slight Irish lilt',\n})\n\nconst [preview] = designed.voices\nif (!preview) throw new Error('No voice candidates returned')\n\nconst speech = await generateSpeech({\n  adapter: elevenlabsSpeech('eleven_v4'),\n  text: 'Once upon a time...',\n  voice: preview.voiceId,\n})\n```\n\n**Save the voice to the provider's library**\n\n```ts\nconst saved = await generateVoice({\n  adapter: elevenlabsVoiceDesign('eleven_ttv_v3'),\n  prompt: 'A bright, upbeat product demo host',\n  name: 'Demo Host',\n  description: 'Bright, upbeat, mid-30s',\n})\n```\n"}
