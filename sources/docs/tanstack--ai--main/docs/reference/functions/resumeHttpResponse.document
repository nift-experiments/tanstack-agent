alue":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Response"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"export async function GET(request: Request) {\n  return resumeHttpResponse({ adapter: memoryStream(request) });\n}","lang":"typescript"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"toffset","text":"TOffset","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction resumeHttpResponse<TOffset>(options): Response;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:1389](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L1389)\n\nServe a resumable run from its durability log over NDJSON, without re-running\nthe model. The NDJSON counterpart of [resumeServerSentEventsResponse](resumeServerSentEventsResponse.md);\npair it with a `toHttpResponse` producer. Returns a 400 when the request\ncarries no resume offset (no `Last-Event-ID` header and no `?offset`).\n\n## Type Parameters\n\n### TOffset\n\n`TOffset` *extends* `string` = `string`\n\n## Parameters\n\n### options\n\n`ResumeResponseOptions`\\<`TOffset`\\>\n\n## Returns\n\n`Response`\n\n## Example\n\n```typescript\nexport async function GET(request: Request) {\n  return resumeHttpResponse({ adapter: memoryStream(request) });\n}\n```\n","originalRawMarkdown":"---\nid: resumeHttpResponse\ntitle: resumeHttpResponse\n---\n\n```ts\nfunction resumeHttpResponse<TOffset>(options): Response;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:1389](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L1389)\n\nServe a resumable run from its durability log over NDJSON, without re-running\nthe model. The NDJSON counterpart of [resumeServerSentEventsResponse](resumeServerSentEventsResponse.md);\npair it with a `toHttpResponse` producer. Returns a 400 when the request\ncarries no resume offset (no `Last-Event-ID` header and no `?offset`).\n\n## Type Parameters\n\n### TOffset\n\n`TOffset` *extends* `string` = `string`\n\n## Parameters\n\n### options\n\n`ResumeResponseOptions`\\<`TOffset`\\>\n\n## Returns\n\n`Response`\n\n## Example\n\n```typescript\nexport async function GET(request: Request) {\n  return resumeHttpResponse({ adapter: memoryStream(request) });\n}\n```\n"}
