vityOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TAdapter"},{"type":"text","value":", "},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"SummarizeActivityResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TStream"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Basic summarization"}]}]},{"type":"code","value":"import { summarize } from '@tanstack/ai'\nimport { openaiSummarize } from '@tanstack/ai-openai'\n\nconst result = await summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long article text here...'\n})\n\nconsole.log(result.summary)","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Summarization with style"}]}]},{"type":"code","value":"const result = await summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long article text here...',\n  style: 'bullet-points',\n  maxLength: 100\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Focused summarization"}]}]},{"type":"code","value":"const result = await summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long technical document...',\n  focus: ['key findings', 'methodology']\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Streaming summarization"}]}]},{"type":"code","value":"for await (const chunk of summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long article text here...',\n  stream: true\n})) {\n  if (chunk.type === 'content') {\n    process.stdout.write(chunk.delta)\n  }\n}","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tadapter","text":"TAdapter","level":3},{"id":"tstream","text":"TStream","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction summarize<TAdapter, TStream>(options): SummarizeActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/summarize/index.ts:207](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/summarize/index.ts#L207)\n\nSummarize activity - generates summaries from text.\n\nSupports both streaming and non-streaming modes.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`SummarizeAdapter`](../interfaces/SummarizeAdapter.md)\\<`string`, `object`\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`SummarizeActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`SummarizeActivityResult`\\<`TStream`\\>\n\n## Examples\n\n**Basic summarization**\n\n```ts\nimport { summarize } from '@tanstack/ai'\nimport { openaiSummarize } from '@tanstack/ai-openai'\n\nconst result = await summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long article text here...'\n})\n\nconsole.log(result.summary)\n```\n\n**Summarization with style**\n\n```ts\nconst result = await summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long article text here...',\n  style: 'bullet-points',\n  maxLength: 100\n})\n```\n\n**Focused summarization**\n\n```ts\nconst result = await summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long technical document...',\n  focus: ['key findings', 'methodology']\n})\n```\n\n**Streaming summarization**\n\n```ts\nfor await (const chunk of summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long article text here...',\n  stream: true\n})) {\n  if (chunk.type === 'content') {\n    process.stdout.write(chunk.delta)\n  }\n}\n```\n","originalRawMarkdown":"---\nid: summarize\ntitle: summarize\n---\n\n```ts\nfunction summarize<TAdapter, TStream>(options): SummarizeActivityResult<TStream>;\n```\n\nDefined in: [packages/ai/src/activities/summarize/index.ts:207](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/summarize/index.ts#L207)\n\nSummarize activity - generates summaries from text.\n\nSupports both streaming and non-streaming modes.\n\n## Type Parameters\n\n### TAdapter\n\n`TAdapter` *extends* [`SummarizeAdapter`](../interfaces/SummarizeAdapter.md)\\<`string`, `object`\\>\n\n### TStream\n\n`TStream` *extends* `boolean` = `false`\n\n## Parameters\n\n### options\n\n`SummarizeActivityOptions`\\<`TAdapter`, `TStream`\\>\n\n## Returns\n\n`SummarizeActivityResult`\\<`TStream`\\>\n\n## Examples\n\n**Basic summarization**\n\n```ts\nimport { summarize } from '@tanstack/ai'\nimport { openaiSummarize } from '@tanstack/ai-openai'\n\nconst result = await summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long article text here...'\n})\n\nconsole.log(result.summary)\n```\n\n**Summarization with style**\n\n```ts\nconst result = await summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long article text here...',\n  style: 'bullet-points',\n  maxLength: 100\n})\n```\n\n**Focused summarization**\n\n```ts\nconst result = await summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long technical document...',\n  focus: ['key findings', 'methodology']\n})\n```\n\n**Streaming summarization**\n\n```ts\nfor await (const chunk of summarize({\n  adapter: openaiSummarize('gpt-4o-mini'),\n  text: 'Long article text here...',\n  stream: true\n})) {\n  if (chunk.type === 'content') {\n    process.stdout.write(chunk.delta)\n  }\n}\n```\n"}
