,"value":"append"},{"type":"text","value":" (default 32), and\n"},{"type":"inlineCode","value":"batchWaitMs"},{"type":"text","value":" how long a buffered chunk waits for more (default 50)."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"toffset","children":[{"type":"text","value":"TOffset"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOffset"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" = "},{"type":"inlineCode","value":"string"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"stream","children":[{"type":"text","value":"stream"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"AsyncIterable"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/AGUIEvent.md","children":[{"type":"inlineCode","value":"AGUIEvent"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"AsyncIterable of StreamChunks from chat()"}]},{"type":"heading","depth":3,"id":"init","children":[{"type":"text","value":"init?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ResponseInit"},{"type":"text","value":" & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Optional Response initialization options (including "},{"type":"inlineCode","value":"abortController"},{"type":"text","value":", "},{"type":"inlineCode","value":"durability"},{"type":"text","value":" with its optional "},{"type":"inlineCode","value":"batch"},{"type":"text","value":" and "},{"type":"inlineCode","value":"batchWaitMs"},{"type":"text","value":", and "},{"type":"inlineCode","value":"debug"},{"type":"text","value":")"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Response"}]},{"type":"paragraph","children":[{"type":"text","value":"Response in Server-Sent Events format"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"export async function POST(request: Request) {\n  const stream = chat({ adapter: openaiText('gpt-5.5'), messages: [...] });\n  return toServerSentEventsResponse(stream, { durability: { adapter: memoryStream(request) } });\n}","lang":"typescript"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"toffset","text":"TOffset","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"stream","text":"stream","level":3},{"id":"init","text":"init?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction toServerSentEventsResponse<TOffset>(stream, init?): Response;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:863](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L863)\n\nConvert a StreamChunk async iterable to a Response in Server-Sent Events format\n\nThis creates a Response that emits chunks in SSE format:\n- Each chunk is prefixed with \"data: \"\n- Each chunk is followed by \"\\n\\n\"\n- Stream ends when the underlying iterable is exhausted (RUN_FINISHED is the terminal event)\n\nPass a `durability` sink (`memoryStream(request)` / `durableStream(request)`)\nto make the stream resumable: fresh runs are appended to the log and each SSE\nevent is tagged with an `id:` offset; a reconnect (native `Last-Event-ID`) or\na `?offset` join replays from the log without re-running the producer. `batch`\ncontrols how many chunks are buffered per `append` (default 32), and\n`batchWaitMs` how long a buffered chunk waits for more (default 50).\n\n## Type Parameters\n\n### TOffset\n\n`TOffset` *extends* `string` = `string`\n\n## Parameters\n\n### stream\n\n`AsyncIterable`\\<[`AGUIEvent`](../type-aliases/AGUIEvent.md)\\>\n\nAsyncIterable of StreamChunks from chat()\n\n### init?\n\n`ResponseInit` & `object`\n\nOptional Response initialization options (including `abortController`, `durability` with its optional `batch` and `batchWaitMs`, and `debug`)\n\n## Returns\n\n`Response`\n\nResponse in Server-Sent Events format\n\n## Example\n\n```typescript\nexport async function POST(request: Request) {\n  const stream = chat({ adapter: openaiText('gpt-5.5'), messages: [...] });\n  return toServerSentEventsResponse(stream, { durability: { adapter: memoryStream(request) } });\n}\n```\n","originalRawMarkdown":"---\nid: toServerSentEventsResponse\ntitle: toServerSentEventsResponse\n---\n\n```ts\nfunction toServerSentEventsResponse<TOffset>(stream, init?): Response;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:863](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L863)\n\nConvert a StreamChunk async iterable to a Response in Server-Sent Events format\n\nThis creates a Response that emits chunks in SSE format:\n- Each chunk is prefixed with \"data: \"\n- Each chunk is followed by \"\\n\\n\"\n- Stream ends when the underlying iterable is exhausted (RUN_FINISHED is the terminal event)\n\nPass a `durability` sink (`memoryStream(request)` / `durableStream(request)`)\nto make the stream resumable: fresh runs are appended to the log and each SSE\nevent is tagged with an `id:` offset; a reconnect (native `Last-Event-ID`) or\na `?offset` join replays from the log without re-running the producer. `batch`\ncontrols how many chunks are buffered per `append` (default 32), and\n`batchWaitMs` how long a buffered chunk waits for more (default 50).\n\n## Type Parameters\n\n### TOffset\n\n`TOffset` *extends* `string` = `string`\n\n## Parameters\n\n### stream\n\n`AsyncIterable`\\<[`AGUIEvent`](../type-aliases/AGUIEvent.md)\\>\n\nAsyncIterable of StreamChunks from chat()\n\n### init?\n\n`ResponseInit` & `object`\n\nOptional Response initialization options (including `abortController`, `durability` with its optional `batch` and `batchWaitMs`, and `debug`)\n\n## Returns\n\n`Response`\n\nResponse in Server-Sent Events format\n\n## Example\n\n```typescript\nexport async function POST(request: Request) {\n  const stream = chat({ adapter: openaiText('gpt-5.5'), messages: [...] });\n  return toServerSentEventsResponse(stream, { durability: { adapter: memoryStream(request) } });\n}\n```\n"}
