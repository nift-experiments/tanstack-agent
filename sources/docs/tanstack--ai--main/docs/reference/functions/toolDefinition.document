{"document":{"type":"root","children":[{"type":"code","value":"function toolDefinition<TInput, TOutput, TName, TNeedsApproval, TApprovalSchema>(config): ToolDefinition<TInput, TOutput, TName, TNeedsApproval, TApprovalSchema>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-definition.ts#L335","children":[{"type":"text","value":"packages/ai/src/activities/chat/tools/tool-definition.ts:335"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Create an isomorphic tool definition that can be used directly or instantiated for server/client"}]},{"type":"paragraph","children":[{"type":"text","value":"The definition contains all tool metadata (name, description, schemas) and can be:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Used directly in chat() on the server (as a tool definition without execute)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Instantiated as a server tool with .server()"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Instantiated as a client tool with .client()"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Supports any Standard JSON Schema compliant library (Zod v4+, ArkType, Valibot, etc.)\nor plain JSON Schema objects."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tinput","children":[{"type":"text","value":"TInput"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TInput"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" = "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":3,"id":"toutput","children":[{"type":"text","value":"TOutput"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOutput"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" = "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":3,"id":"tname","children":[{"type":"text","value":"TName"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TName"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" = "},{"type":"inlineCode","value":"string"}]},{"type":"heading","depth":3,"id":"tneedsapproval","children":[{"type":"text","value":"TNeedsApproval"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TNeedsApproval"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":" = "},{"type":"inlineCode","value":"false"}]},{"type":"heading","depth":3,"id":"tapprovalschema","children":[{"type":"text","value":"TApprovalSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TApprovalSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":"\n| "},{"type":"link","href":"../type-aliases/ApprovalSchemaConfig.md","children":[{"type":"inlineCode","value":"ApprovalSchemaConfig"}]},{"type":"text","value":"\n| "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" = "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"config","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/ToolDefinitionConfig.md","children":[{"type":"inlineCode","value":"ToolDefinitionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TInput"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOutput"},{"type":"text","value":", "},{"type":"inlineCode","value":"TName"},{"type":"text","value":", "},{"type":"inlineCode","value":"TNeedsApproval"},{"type":"text","value":", "},{"type":"inlineCode","value":"TApprovalSchema"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ToolDefinition.md","children":[{"type":"inlineCode","value":"ToolDefinition"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TInput"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOutput"},{"type":"text","value":", "},{"type":"inlineCode","value":"TName"},{"type":"text","value":", "},{"type":"inlineCode","value":"TNeedsApproval"},{"type":"text","value":", "},{"type":"inlineCode","value":"TApprovalSchema"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { toolDefinition } from '@tanstack/ai';\nimport { z } from 'zod';\n\n// Using Zod (natively supports Standard JSON Schema)\nconst addToCartTool = toolDefinition({\n  name: 'addToCart',\n  description: 'Add a guitar to the shopping cart (requires approval)',\n  needsApproval: true,\n  inputSchema: z.object({\n    guitarId: z.string(),\n    quantity: z.number(),\n  }),\n  outputSchema: z.object({\n    success: z.boolean(),\n    cartId: z.string(),\n    totalItems: z.number(),\n  }),\n});\n\n// Use directly in chat (server-side, no execute function)\nchat({\n  tools: [addToCartTool],\n  // ...\n});\n\n// Or create server-side implementation\nconst addToCartServer = addToCartTool.server(async (args) => {\n  // args is typed as { guitarId: string; quantity: number }\n  return {\n    success: true,\n    cartId: 'CART_' + Date.now(),\n    totalItems: args.quantity,\n  };\n});\n\n// Or create client-side implementation\nconst addToCartClient = addToCartTool.client(async (args) => {\n  // Client-specific logic (e.g., localStorage)\n  return { success: true, cartId: 'local', totalItems: 1 };\n});","lang":"typescript"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tinput","text":"TInput","level":3},{"id":"toutput","text":"TOutput","level":3},{"id":"tname","text":"TName","level":3},{"id":"tneedsapproval","text":"TNeedsApproval","level":3},{"id":"tapprovalschema","text":"TApprovalSchema","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"config","text":"config","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction toolDefinition<TInput, TOutput, TName, TNeedsApproval, TApprovalSchema>(config): ToolDefinition<TInput, TOutput, TName, TNeedsApproval, TApprovalSchema>;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-definition.ts:335](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-definition.ts#L335)\n\nCreate an isomorphic tool definition that can be used directly or instantiated for server/client\n\nThe definition contains all tool metadata (name, description, schemas) and can be:\n1. Used directly in chat() on the server (as a tool definition without execute)\n2. Instantiated as a server tool with .server()\n3. Instantiated as a client tool with .client()\n\nSupports any Standard JSON Schema compliant library (Zod v4+, ArkType, Valibot, etc.)\nor plain JSON Schema objects.\n\n## Type Parameters\n\n### TInput\n\n`TInput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n### TOutput\n\n`TOutput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n### TName\n\n`TName` *extends* `string` = `string`\n\n### TNeedsApproval\n\n`TNeedsApproval` *extends* `boolean` = `false`\n\n### TApprovalSchema\n\n`TApprovalSchema` *extends* \n  \\| [`ApprovalSchemaConfig`](../type-aliases/ApprovalSchemaConfig.md)\n  \\| `undefined` = `undefined`\n\n## Parameters\n\n### config\n\n[`ToolDefinitionConfig`](../type-aliases/ToolDefinitionConfig.md)\\<`TInput`, `TOutput`, `TName`, `TNeedsApproval`, `TApprovalSchema`\\>\n\n## Returns\n\n[`ToolDefinition`](../interfaces/ToolDefinition.md)\\<`TInput`, `TOutput`, `TName`, `TNeedsApproval`, `TApprovalSchema`\\>\n\n## Example\n\n```typescript\nimport { toolDefinition } from '@tanstack/ai';\nimport { z } from 'zod';\n\n// Using Zod (natively supports Standard JSON Schema)\nconst addToCartTool = toolDefinition({\n  name: 'addToCart',\n  description: 'Add a guitar to the shopping cart (requires approval)',\n  needsApproval: true,\n  inputSchema: z.object({\n    guitarId: z.string(),\n    quantity: z.number(),\n  }),\n  outputSchema: z.object({\n    success: z.boolean(),\n    cartId: z.string(),\n    totalItems: z.number(),\n  }),\n});\n\n// Use directly in chat (server-side, no execute function)\nchat({\n  tools: [addToCartTool],\n  // ...\n});\n\n// Or create server-side implementation\nconst addToCartServer = addToCartTool.server(async (args) => {\n  // args is typed as { guitarId: string; quantity: number }\n  return {\n    success: true,\n    cartId: 'CART_' + Date.now(),\n    totalItems: args.quantity,\n  };\n});\n\n// Or create client-side implementation\nconst addToCartClient = addToCartTool.client(async (args) => {\n  // Client-specific logic (e.g., localStorage)\n  return { success: true, cartId: 'local', totalItems: 1 };\n});\n```\n","originalRawMarkdown":"---\nid: toolDefinition\ntitle: toolDefinition\n---\n\n```ts\nfunction toolDefinition<TInput, TOutput, TName, TNeedsApproval, TApprovalSchema>(config): ToolDefinition<TInput, TOutput, TName, TNeedsApproval, TApprovalSchema>;\n```\n\nDefined in: [packages/ai/src/activities/chat/tools/tool-definition.ts:335](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-definition.ts#L335)\n\nCreate an isomorphic tool definition that can be used directly or instantiated for server/client\n\nThe definition contains all tool metadata (name, description, schemas) and can be:\n1. Used directly in chat() on the server (as a tool definition without execute)\n2. Instantiated as a server tool with .server()\n3. Instantiated as a client tool with .client()\n\nSupports any Standard JSON Schema compliant library (Zod v4+, ArkType, Valibot, etc.)\nor plain JSON Schema objects.\n\n## Type Parameters\n\n### TInput\n\n`TInput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n### TOutput\n\n`TOutput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = `undefined`\n\n### TName\n\n`TName` *extends* `string` = `string`\n\n### TNeedsApproval\n\n`TNeedsApproval` *extends* `boolean` = `false`\n\n### TApprovalSchema\n\n`TApprovalSchema` *extends* \n  \\| [`ApprovalSchemaConfig`](../type-aliases/ApprovalSchemaConfig.md)\n  \\| `undefined` = `undefined`\n\n## Parameters\n\n### config\n\n[`ToolDefinitionConfig`](../type-aliases/ToolDefinitionConfig.md)\\<`TInput`, `TOutput`, `TName`, `TNeedsApproval`, `TApprovalSchema`\\>\n\n## Returns\n\n[`ToolDefinition`](../interfaces/ToolDefinition.md)\\<`TInput`, `TOutput`, `TName`, `TNeedsApproval`, `TApprovalSchema`\\>\n\n## Example\n\n```typescript\nimport { toolDefinition } from '@tanstack/ai';\nimport { z } from 'zod';\n\n// Using Zod (natively supports Standard JSON Schema)\nconst addToCartTool = toolDefinition({\n  name: 'addToCart',\n  description: 'Add a guitar to the shopping cart (requires approval)',\n  needsApproval: true,\n  inputSchema: z.object({\n    guitarId: z.string(),\n    quantity: z.number(),\n  }),\n  outputSchema: z.object({\n    success: z.boolean(),\n    cartId: z.string(),\n    totalItems: z.number(),\n  }),\n});\n\n// Use directly in chat (server-side, no execute function)\nchat({\n  tools: [addToCartTool],\n  // ...\n});\n\n// Or create server-side implementation\nconst addToCartServer = addToCartTool.server(async (args) => {\n  // args is typed as { guitarId: string; quantity: number }\n  return {\n    success: true,\n    cartId: 'CART_' + Date.now(),\n    totalItems: args.quantity,\n  };\n});\n\n// Or create client-side implementation\nconst addToCartClient = addToCartTool.client(async (args) => {\n  // Client-specific logic (e.g., localStorage)\n  return { success: true, cartId: 'local', totalItems: 1 };\n});\n```\n"}
