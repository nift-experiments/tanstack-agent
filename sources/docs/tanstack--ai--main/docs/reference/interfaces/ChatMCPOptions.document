"text","value":"lazyTools?"}]},{"type":"code","value":"optional lazyTools?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L74","children":[{"type":"text","value":"packages/ai/src/activities/chat/mcp/types.ts:74"}]}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"true"},{"type":"text","value":", tool schemas are fetched lazily (forwarded to\n"},{"type":"inlineCode","value":"tools({ lazy: true })"},{"type":"text","value":")."}]},{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"false"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"ondiscoveryerror","children":[{"type":"text","value":"onDiscoveryError?"}]},{"type":"code","value":"optional onDiscoveryError?: (error, source) => void | Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L85","children":[{"type":"text","value":"packages/ai/src/activities/chat/mcp/types.ts:85"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called when tool discovery fails for a single source."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Throw (or re-throw) from this handler to fail the entire chat call fast."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Return normally to skip that source and continue with remaining clients."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Omit this handler entirely to rethrow the error (fail-fast by default)."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Async handlers are awaited, so a rejected promise also fails fast."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"error","children":[{"type":"text","value":"error"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":5,"id":"source","children":[{"type":"text","value":"source"}]},{"type":"paragraph","children":[{"type":"link","href":"MCPToolSource.md","children":[{"type":"inlineCode","value":"MCPToolSource"}]}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]}],"headings":[{"id":"properties","text":"Properties","level":2},{"id":"clients","text":"clients","level":3},{"id":"connection","text":"connection?","level":3},{"id":"lazytools","text":"lazyTools?","level":3},{"id":"ondiscoveryerror","text":"onDiscoveryError?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"error","text":"error","level":5},{"id":"source","text":"source","level":5},{"id":"returns","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:55](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L55)\n\nOptions controlling MCP tool discovery and lifecycle for a `chat()` call.\n\n## Properties\n\n### clients\n\n```ts\nclients: MCPToolSource[];\n```\n\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:59](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L59)\n\nThe MCP clients or client pools to discover tools from and manage.\n\n***\n\n### connection?\n\n```ts\noptional connection?: MCPConnectionPolicy;\n```\n\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:66](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L66)\n\nConnection lifecycle policy applied to all clients when the run ends.\n\nDefaults to `'close'`.\n\n***\n\n### lazyTools?\n\n```ts\noptional lazyTools?: boolean;\n```\n\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:74](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L74)\n\nWhen `true`, tool schemas are fetched lazily (forwarded to\n`tools({ lazy: true })`).\n\nDefaults to `false`.\n\n***\n\n### onDiscoveryError?\n\n```ts\noptional onDiscoveryError?: (error, source) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:85](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L85)\n\nCalled when tool discovery fails for a single source.\n\n- Throw (or re-throw) from this handler to fail the entire chat call fast.\n- Return normally to skip that source and continue with remaining clients.\n- Omit this handler entirely to rethrow the error (fail-fast by default).\n\nAsync handlers are awaited, so a rejected promise also fails fast.\n\n#### Parameters\n\n##### error\n\n`unknown`\n\n##### source\n\n[`MCPToolSource`](MCPToolSource.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n","originalRawMarkdown":"---\nid: ChatMCPOptions\ntitle: ChatMCPOptions\n---\n\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:55](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L55)\n\nOptions controlling MCP tool discovery and lifecycle for a `chat()` call.\n\n## Properties\n\n### clients\n\n```ts\nclients: MCPToolSource[];\n```\n\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:59](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L59)\n\nThe MCP clients or client pools to discover tools from and manage.\n\n***\n\n### connection?\n\n```ts\noptional connection?: MCPConnectionPolicy;\n```\n\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:66](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L66)\n\nConnection lifecycle policy applied to all clients when the run ends.\n\nDefaults to `'close'`.\n\n***\n\n### lazyTools?\n\n```ts\noptional lazyTools?: boolean;\n```\n\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:74](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L74)\n\nWhen `true`, tool schemas are fetched lazily (forwarded to\n`tools({ lazy: true })`).\n\nDefaults to `false`.\n\n***\n\n### onDiscoveryError?\n\n```ts\noptional onDiscoveryError?: (error, source) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/chat/mcp/types.ts:85](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/mcp/types.ts#L85)\n\nCalled when tool discovery fails for a single source.\n\n- Throw (or re-throw) from this handler to fail the entire chat call fast.\n- Return normally to skip that source and continue with remaining clients.\n- Omit this handler entirely to rethrow the error (fail-fast by default).\n\nAsync handlers are awaited, so a rejected promise also fails fast.\n\n#### Parameters\n\n##### error\n\n`unknown`\n\n##### source\n\n[`MCPToolSource`](MCPToolSource.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n"}
