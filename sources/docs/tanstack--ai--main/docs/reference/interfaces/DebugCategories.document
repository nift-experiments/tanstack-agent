ue":"config?"}]},{"type":"code","value":"optional config?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L54","children":[{"type":"text","value":"packages/ai/src/logger/types.ts:54"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Config transforms returned by middleware "},{"type":"inlineCode","value":"onConfig"},{"type":"text","value":" hooks. Chat-only."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"errors","children":[{"type":"text","value":"errors?"}]},{"type":"code","value":"optional errors?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L58","children":[{"type":"text","value":"packages/ai/src/logger/types.ts:58"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Caught errors throughout the pipeline. Unlike other categories, defaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" even when "},{"type":"inlineCode","value":"debug"},{"type":"text","value":" is unspecified. Explicitly set "},{"type":"inlineCode","value":"errors: false"},{"type":"text","value":" or "},{"type":"inlineCode","value":"debug: false"},{"type":"text","value":" to silence."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"middleware","children":[{"type":"text","value":"middleware?"}]},{"type":"code","value":"optional middleware?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L42","children":[{"type":"text","value":"packages/ai/src/logger/types.ts:42"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Inputs and outputs around each middleware hook invocation. Chat-only."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"output","children":[{"type":"text","value":"output?"}]},{"type":"code","value":"optional output?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L38","children":[{"type":"text","value":"packages/ai/src/logger/types.ts:38"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Chunks/results yielded to the consumer after all middleware. For streaming activities this fires per chunk; for non-streaming activities it fires once per result."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"provider","children":[{"type":"text","value":"provider?"}]},{"type":"code","value":"optional provider?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L34","children":[{"type":"text","value":"packages/ai/src/logger/types.ts:34"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Raw chunks/frames received from a provider SDK (OpenAI, Anthropic, Gemini, Ollama, Grok, Groq, OpenRouter, fal, ElevenLabs, BytePlus). Emitted inside every streaming adapter's chunk loop."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"request","children":[{"type":"text","value":"request?"}]},{"type":"code","value":"optional request?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L62","children":[{"type":"text","value":"packages/ai/src/logger/types.ts:62"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Outgoing call metadata (provider, model, message/tool counts) emitted before each adapter SDK call."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"sandbox","children":[{"type":"text","value":"sandbox?"}]},{"type":"code","value":"optional sandbox?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L67","children":[{"type":"text","value":"packages/ai/src/logger/types.ts:67"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Sandbox internals: watcher start/stop + mechanism, file events, sandbox\nhook dispatch, ensure/bootstrap and lifecycle transitions. Chat-only."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"tools","children":[{"type":"text","value":"tools?"}]},{"type":"code","value":"optional tools?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L46","children":[{"type":"text","value":"packages/ai/src/logger/types.ts:46"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Before/after tool-call execution in the chat agent loop. Chat-only."}]}],"headings":[{"id":"extended-by","text":"Extended by","level":2},{"id":"properties","text":"Properties","level":2},{"id":"agentloop","text":"agentLoop?","level":3},{"id":"config","text":"config?","level":3},{"id":"errors","text":"errors?","level":3},{"id":"middleware","text":"middleware?","level":3},{"id":"output","text":"output?","level":3},{"id":"provider","text":"provider?","level":3},{"id":"request","text":"request?","level":3},{"id":"sandbox","text":"sandbox?","level":3},{"id":"tools","text":"tools?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/logger/types.ts:30](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L30)\n\nPer-category toggles for debug logging. Each flag enables or disables one class of log message. Unspecified flags default to `true` when `DebugConfig` is partially specified; `undefined` on the `debug` option defaults all flags to `false` except `errors`.\n\n## Extended by\n\n- [`DebugConfig`](DebugConfig.md)\n\n## Properties\n\n### agentLoop?\n\n```ts\noptional agentLoop?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:50](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L50)\n\nIteration markers and phase transitions in the chat agent loop. Chat-only.\n\n***\n\n### config?\n\n```ts\noptional config?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:54](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L54)\n\nConfig transforms returned by middleware `onConfig` hooks. Chat-only.\n\n***\n\n### errors?\n\n```ts\noptional errors?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:58](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L58)\n\nCaught errors throughout the pipeline. Unlike other categories, defaults to `true` even when `debug` is unspecified. Explicitly set `errors: false` or `debug: false` to silence.\n\n***\n\n### middleware?\n\n```ts\noptional middleware?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:42](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L42)\n\nInputs and outputs around each middleware hook invocation. Chat-only.\n\n***\n\n### output?\n\n```ts\noptional output?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:38](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L38)\n\nChunks/results yielded to the consumer after all middleware. For streaming activities this fires per chunk; for non-streaming activities it fires once per result.\n\n***\n\n### provider?\n\n```ts\noptional provider?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:34](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L34)\n\nRaw chunks/frames received from a provider SDK (OpenAI, Anthropic, Gemini, Ollama, Grok, Groq, OpenRouter, fal, ElevenLabs, BytePlus). Emitted inside every streaming adapter's chunk loop.\n\n***\n\n### request?\n\n```ts\noptional request?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:62](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L62)\n\nOutgoing call metadata (provider, model, message/tool counts) emitted before each adapter SDK call.\n\n***\n\n### sandbox?\n\n```ts\noptional sandbox?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:67](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L67)\n\nSandbox internals: watcher start/stop + mechanism, file events, sandbox\nhook dispatch, ensure/bootstrap and lifecycle transitions. Chat-only.\n\n***\n\n### tools?\n\n```ts\noptional tools?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:46](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L46)\n\nBefore/after tool-call execution in the chat agent loop. Chat-only.\n","originalRawMarkdown":"---\nid: DebugCategories\ntitle: DebugCategories\n---\n\nDefined in: [packages/ai/src/logger/types.ts:30](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L30)\n\nPer-category toggles for debug logging. Each flag enables or disables one class of log message. Unspecified flags default to `true` when `DebugConfig` is partially specified; `undefined` on the `debug` option defaults all flags to `false` except `errors`.\n\n## Extended by\n\n- [`DebugConfig`](DebugConfig.md)\n\n## Properties\n\n### agentLoop?\n\n```ts\noptional agentLoop?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:50](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L50)\n\nIteration markers and phase transitions in the chat agent loop. Chat-only.\n\n***\n\n### config?\n\n```ts\noptional config?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:54](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L54)\n\nConfig transforms returned by middleware `onConfig` hooks. Chat-only.\n\n***\n\n### errors?\n\n```ts\noptional errors?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:58](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L58)\n\nCaught errors throughout the pipeline. Unlike other categories, defaults to `true` even when `debug` is unspecified. Explicitly set `errors: false` or `debug: false` to silence.\n\n***\n\n### middleware?\n\n```ts\noptional middleware?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:42](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L42)\n\nInputs and outputs around each middleware hook invocation. Chat-only.\n\n***\n\n### output?\n\n```ts\noptional output?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:38](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L38)\n\nChunks/results yielded to the consumer after all middleware. For streaming activities this fires per chunk; for non-streaming activities it fires once per result.\n\n***\n\n### provider?\n\n```ts\noptional provider?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:34](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L34)\n\nRaw chunks/frames received from a provider SDK (OpenAI, Anthropic, Gemini, Ollama, Grok, Groq, OpenRouter, fal, ElevenLabs, BytePlus). Emitted inside every streaming adapter's chunk loop.\n\n***\n\n### request?\n\n```ts\noptional request?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:62](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L62)\n\nOutgoing call metadata (provider, model, message/tool counts) emitted before each adapter SDK call.\n\n***\n\n### sandbox?\n\n```ts\noptional sandbox?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:67](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L67)\n\nSandbox internals: watcher start/stop + mechanism, file events, sandbox\nhook dispatch, ensure/bootstrap and lifecycle transitions. Chat-only.\n\n***\n\n### tools?\n\n```ts\noptional tools?: boolean;\n```\n\nDefined in: [packages/ai/src/logger/types.ts:46](https://github.com/TanStack/ai/blob/main/packages/ai/src/logger/types.ts#L46)\n\nBefore/after tool-call execution in the chat agent loop. Chat-only.\n"}
