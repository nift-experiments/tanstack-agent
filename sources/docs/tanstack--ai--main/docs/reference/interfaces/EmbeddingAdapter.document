:"text","value":"packages/ai/src/activities/embed/adapter.ts:63"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Generate embeddings for the input items (one vector per item)"}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"EmbeddingOptions.md","children":[{"type":"inlineCode","value":"EmbeddingOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TProviderOptions"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"EmbeddingResult.md","children":[{"type":"inlineCode","value":"EmbeddingResult"}]},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"kind","children":[{"type":"text","value":"kind"}]},{"type":"code","value":"readonly kind: \"embedding\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L39","children":[{"type":"text","value":"packages/ai/src/activities/embed/adapter.ts:39"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Discriminator for adapter kind"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"model","children":[{"type":"text","value":"model"}]},{"type":"code","value":"readonly model: TModel;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L49","children":[{"type":"text","value":"packages/ai/src/activities/embed/adapter.ts:49"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The model this adapter is configured for"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"name","children":[{"type":"text","value":"name"}]},{"type":"code","value":"readonly name: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L41","children":[{"type":"text","value":"packages/ai/src/activities/embed/adapter.ts:41"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Adapter name identifier"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"supportsfilesources","children":[{"type":"text","value":"supportsFileSources?"}]},{"type":"code","value":"readonly optional supportsFileSources?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L47","children":[{"type":"text","value":"packages/ai/src/activities/embed/adapter.ts:47"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Declares that this adapter can consume "},{"type":"inlineCode","value":"{ type: 'file' }"},{"type":"text","value":" content\nsources (provider Files API references). "},{"type":"inlineCode","value":"embed()"},{"type":"text","value":" rejects file sources\nin preflight for adapters that don't declare this."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tmodel","text":"TModel","level":3},{"id":"tprovideroptions","text":"TProviderOptions","level":3},{"id":"tmodelprovideroptionsbyname","text":"TModelProviderOptionsByName","level":3},{"id":"tmodelinputmodalitiesbyname","text":"TModelInputModalitiesByName","level":3},{"id":"properties","text":"Properties","level":2},{"id":"types","text":"~types","level":3},{"id":"modelinputmodalitiesbyname","text":"modelInputModalitiesByName","level":4},{"id":"modelprovideroptionsbyname","text":"modelProviderOptionsByName","level":4},{"id":"provideroptions","text":"providerOptions","level":4},{"id":"createembeddings","text":"createEmbeddings","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"options","text":"options","level":5},{"id":"returns","text":"Returns","level":4},{"id":"kind","text":"kind","level":3},{"id":"model","text":"model","level":3},{"id":"name","text":"name","level":3},{"id":"supportsfilesources","text":"supportsFileSources?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/activities/embed/adapter.ts:31](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L31)\n\nEmbedding adapter interface with pre-resolved generics.\n\nAn adapter is created by a provider function: `provider('model')` → `adapter`\nAll type resolution happens at the provider call site, not in this interface.\n\nGeneric parameters:\n- TModel: The specific model name (e.g., 'text-embedding-3-small')\n- TProviderOptions: Base provider-specific options (already resolved)\n- TModelProviderOptionsByName: Map from model name to its specific provider options\n- TModelInputModalitiesByName: Map from model name to the input modalities it\n  accepts (constrains the `input` item types at compile time)\n\n## Type Parameters\n\n### TModel\n\n`TModel` *extends* `string` = `string`\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n### TModelProviderOptionsByName\n\n`TModelProviderOptionsByName` *extends* `Record`\\<`string`, `any`\\> = `Record`\\<`string`, `any`\\>\n\n### TModelInputModalitiesByName\n\n`TModelInputModalitiesByName` *extends* [`EmbeddingModelInputModalitiesByName`](../type-aliases/EmbeddingModelInputModalitiesByName.md) = [`EmbeddingModelInputModalitiesByName`](../type-aliases/EmbeddingModelInputModalitiesByName.md)\n\n## Properties\n\n### ~types\n\n```ts\n~types: object;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:54](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L54)\n\n**`Internal`**\n\nType-only properties for inference. Not assigned at runtime.\n\n#### modelInputModalitiesByName\n\n```ts\nmodelInputModalitiesByName: TModelInputModalitiesByName;\n```\n\n#### modelProviderOptionsByName\n\n```ts\nmodelProviderOptionsByName: TModelProviderOptionsByName;\n```\n\n#### providerOptions\n\n```ts\nproviderOptions: TProviderOptions;\n```\n\n***\n\n### createEmbeddings\n\n```ts\ncreateEmbeddings: (options) => Promise<EmbeddingResult>;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:63](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L63)\n\nGenerate embeddings for the input items (one vector per item)\n\n#### Parameters\n\n##### options\n\n[`EmbeddingOptions`](EmbeddingOptions.md)\\<`TProviderOptions`\\>\n\n#### Returns\n\n`Promise`\\<[`EmbeddingResult`](EmbeddingResult.md)\\>\n\n***\n\n### kind\n\n```ts\nreadonly kind: \"embedding\";\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:39](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L39)\n\nDiscriminator for adapter kind\n\n***\n\n### model\n\n```ts\nreadonly model: TModel;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:49](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L49)\n\nThe model this adapter is configured for\n\n***\n\n### name\n\n```ts\nreadonly name: string;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:41](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L41)\n\nAdapter name identifier\n\n***\n\n### supportsFileSources?\n\n```ts\nreadonly optional supportsFileSources?: boolean;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:47](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L47)\n\nDeclares that this adapter can consume `{ type: 'file' }` content\nsources (provider Files API references). `embed()` rejects file sources\nin preflight for adapters that don't declare this.\n","originalRawMarkdown":"---\nid: EmbeddingAdapter\ntitle: EmbeddingAdapter\n---\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:31](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L31)\n\nEmbedding adapter interface with pre-resolved generics.\n\nAn adapter is created by a provider function: `provider('model')` → `adapter`\nAll type resolution happens at the provider call site, not in this interface.\n\nGeneric parameters:\n- TModel: The specific model name (e.g., 'text-embedding-3-small')\n- TProviderOptions: Base provider-specific options (already resolved)\n- TModelProviderOptionsByName: Map from model name to its specific provider options\n- TModelInputModalitiesByName: Map from model name to the input modalities it\n  accepts (constrains the `input` item types at compile time)\n\n## Type Parameters\n\n### TModel\n\n`TModel` *extends* `string` = `string`\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n### TModelProviderOptionsByName\n\n`TModelProviderOptionsByName` *extends* `Record`\\<`string`, `any`\\> = `Record`\\<`string`, `any`\\>\n\n### TModelInputModalitiesByName\n\n`TModelInputModalitiesByName` *extends* [`EmbeddingModelInputModalitiesByName`](../type-aliases/EmbeddingModelInputModalitiesByName.md) = [`EmbeddingModelInputModalitiesByName`](../type-aliases/EmbeddingModelInputModalitiesByName.md)\n\n## Properties\n\n### ~types\n\n```ts\n~types: object;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:54](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L54)\n\n**`Internal`**\n\nType-only properties for inference. Not assigned at runtime.\n\n#### modelInputModalitiesByName\n\n```ts\nmodelInputModalitiesByName: TModelInputModalitiesByName;\n```\n\n#### modelProviderOptionsByName\n\n```ts\nmodelProviderOptionsByName: TModelProviderOptionsByName;\n```\n\n#### providerOptions\n\n```ts\nproviderOptions: TProviderOptions;\n```\n\n***\n\n### createEmbeddings\n\n```ts\ncreateEmbeddings: (options) => Promise<EmbeddingResult>;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:63](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L63)\n\nGenerate embeddings for the input items (one vector per item)\n\n#### Parameters\n\n##### options\n\n[`EmbeddingOptions`](EmbeddingOptions.md)\\<`TProviderOptions`\\>\n\n#### Returns\n\n`Promise`\\<[`EmbeddingResult`](EmbeddingResult.md)\\>\n\n***\n\n### kind\n\n```ts\nreadonly kind: \"embedding\";\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:39](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L39)\n\nDiscriminator for adapter kind\n\n***\n\n### model\n\n```ts\nreadonly model: TModel;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:49](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L49)\n\nThe model this adapter is configured for\n\n***\n\n### name\n\n```ts\nreadonly name: string;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:41](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L41)\n\nAdapter name identifier\n\n***\n\n### supportsFileSources?\n\n```ts\nreadonly optional supportsFileSources?: boolean;\n```\n\nDefined in: [packages/ai/src/activities/embed/adapter.ts:47](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/embed/adapter.ts#L47)\n\nDeclares that this adapter can consume `{ type: 'file' }` content\nsources (provider Files API references). `embed()` rejects file sources\nin preflight for adapters that don't declare this.\n"}
