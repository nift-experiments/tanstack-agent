('gpt-image-1'),\n  prompt: 'A serene mountain landscape at sunset',\n  middleware: [otelMiddleware({ tracer: trace.getTracer('my-app') })],\n})","lang":"ts"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tcontext","children":[{"type":"text","value":"TContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TContext"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"name","children":[{"type":"text","value":"name?"}]},{"type":"code","value":"optional name?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L197","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:197"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional name, surfaced in diagnostics."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onabort","children":[{"type":"text","value":"onAbort?"}]},{"type":"code","value":"optional onAbort?: (ctx, info) => void | Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L211","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:211"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called when the activity is aborted (e.g. an abandoned stream)."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"ctx","children":[{"type":"text","value":"ctx"}]},{"type":"paragraph","children":[{"type":"link","href":"GenerationMiddlewar