nerationErrorInfo"}]}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onfinish","children":[{"type":"text","value":"onFinish?"}]},{"type":"code","value":"optional onFinish?: (ctx, info) => void | Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L206","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:206"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called after the activity completes successfully."}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"ctx-3","children":[{"type":"text","value":"ctx"}]},{"type":"paragraph","children":[{"type":"link","href":"GenerationMiddlewareContext.md","children":[{"type":"inlineCode","value":"GenerationMiddlewareContext"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"info-3","children":[{"type":"text","value":"info"}]},{"type":"paragraph","children":[{"type":"link","href":"GenerationFinishInfo.md","children":[{"type":"inlineCode","value":"GenerationFinishInfo"}]}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onstart","children":[{"type":"text","value":"onStart?"}]},{"type":"code","value":"optional onStart?: (ctx) => void | Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L199","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:199"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called before the adapter request begins."}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"ctx-4","children":[{"type":"text","value":"ctx"}]},{"type":"paragraph","children":[{"type":"link","href":"GenerationMiddlewareContext.md","children":[{"type":"inlineCode","value":"GenerationMiddlewareContext"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onusage","children":[{"type":"text","value":"onUsage?"}]},{"type":"code","value":"optional onUsage?: (ctx, usage) => void | Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L201","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:201"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called when the provider reports usage, before "},{"type":"inlineCode","value":"onFinish"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"ctx-5","children":[{"type":"text","value":"ctx"}]},{"type":"paragraph","children":[{"type":"link","href":"GenerationMiddlewareContext.md","children":[{"type":"inlineCode","value":"GenerationMiddlewareContext"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"usage","children":[{"type":"text","value":"usage"}]},{"type":"paragraph","children":[{"type":"link","href":"GenerationUsageInfo.md","children":[{"type":"inlineCode","value":"GenerationUsageInfo"}]}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tcontext","text":"TContext","level":3},{"id":"properties","text":"Properties","level":2},{"id":"name","text":"name?","level":3},{"id":"onabort","text":"onAbort?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"ctx","text":"ctx","level":5},{"id":"info","text":"info","level":5},{"id":"returns","text":"Returns","level":4},{"id":"onerror","text":"onError?","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"ctx-2","text":"ctx","level":5},{"id":"info-2","text":"info","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"onfinish","text":"onFinish?","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"ctx-3","text":"ctx","level":5},{"id":"info-3","text":"info","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"onstart","text":"onStart?","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"ctx-4","text":"ctx","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"onusage","text":"onUsage?","level":3},{"id":"parameters-5","text":"Parameters","level":4},{"id":"ctx-5","text":"ctx","level":5},{"id":"usage","text":"usage","level":5},{"id":"returns-5","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/activities/middleware/types.ts:195](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L195)\n\nActivity-agnostic, observe-only middleware.\n\nA thin lifecycle observer registerable on any activity via its `middleware`\noption. Unlike `ChatMiddleware` (which can also rewrite config, chunks, and\ntool calls), these hooks only observe — the right fit for the single\nrequest → response shape of media activities. Pass `otelMiddleware()` for\nOpenTelemetry, or implement the hooks directly for a custom backend.\n\nHooks are awaited in registration order. A hook that throws PROPAGATES and\nfails the activity — matching `chat()` middleware semantics. Keep them cheap;\nthey run inline with the request.\n\nExactly one of `onFinish` / `onAbort` / `onError` fires per call.\n\n## Example\n\n```ts\nimport { generateImage } from '@tanstack/ai'\nimport { otelMiddleware } from '@tanstack/ai/middlewares/otel'\nimport { openaiImage } from '@tanstack/ai-openai'\nimport { trace } from '@opentelemetry/api'\n\nawait generateImage({\n  adapter: openaiImage('gpt-image-1'),\n  prompt: 'A serene mountain landscape at sunset',\n  middleware: [otelMiddleware({ tracer: trace.getTracer('my-app') })],\n})\n```\n\n## Type Parameters\n\n### TContext\n\n`TContext` = `unknown`\n\n## Properties\n\n### name?\n\n```ts\noptional name?: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:197](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L197)\n\nOptional name, surfaced in diagnostics.\n\n***\n\n### onAbort?\n\n```ts\noptional onAbort?: (ctx, info) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:211](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L211)\n\nCalled when the activity is aborted (e.g. an abandoned stream).\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n##### info\n\n[`GenerationAbortInfo`](GenerationAbortInfo.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n\n***\n\n### onError?\n\n```ts\noptional onError?: (ctx, info) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:216](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L216)\n\nCalled when the activity throws before completing.\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n##### info\n\n[`GenerationErrorInfo`](GenerationErrorInfo.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n\n***\n\n### onFinish?\n\n```ts\noptional onFinish?: (ctx, info) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:206](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L206)\n\nCalled after the activity completes successfully.\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n##### info\n\n[`GenerationFinishInfo`](GenerationFinishInfo.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n\n***\n\n### onStart?\n\n```ts\noptional onStart?: (ctx) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:199](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L199)\n\nCalled before the adapter request begins.\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n\n***\n\n### onUsage?\n\n```ts\noptional onUsage?: (ctx, usage) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:201](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L201)\n\nCalled when the provider reports usage, before `onFinish`.\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n##### usage\n\n[`GenerationUsageInfo`](GenerationUsageInfo.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n","originalRawMarkdown":"---\nid: GenerationMiddleware\ntitle: GenerationMiddleware\n---\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:195](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L195)\n\nActivity-agnostic, observe-only middleware.\n\nA thin lifecycle observer registerable on any activity via its `middleware`\noption. Unlike `ChatMiddleware` (which can also rewrite config, chunks, and\ntool calls), these hooks only observe — the right fit for the single\nrequest → response shape of media activities. Pass `otelMiddleware()` for\nOpenTelemetry, or implement the hooks directly for a custom backend.\n\nHooks are awaited in registration order. A hook that throws PROPAGATES and\nfails the activity — matching `chat()` middleware semantics. Keep them cheap;\nthey run inline with the request.\n\nExactly one of `onFinish` / `onAbort` / `onError` fires per call.\n\n## Example\n\n```ts\nimport { generateImage } from '@tanstack/ai'\nimport { otelMiddleware } from '@tanstack/ai/middlewares/otel'\nimport { openaiImage } from '@tanstack/ai-openai'\nimport { trace } from '@opentelemetry/api'\n\nawait generateImage({\n  adapter: openaiImage('gpt-image-1'),\n  prompt: 'A serene mountain landscape at sunset',\n  middleware: [otelMiddleware({ tracer: trace.getTracer('my-app') })],\n})\n```\n\n## Type Parameters\n\n### TContext\n\n`TContext` = `unknown`\n\n## Properties\n\n### name?\n\n```ts\noptional name?: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:197](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L197)\n\nOptional name, surfaced in diagnostics.\n\n***\n\n### onAbort?\n\n```ts\noptional onAbort?: (ctx, info) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:211](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L211)\n\nCalled when the activity is aborted (e.g. an abandoned stream).\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n##### info\n\n[`GenerationAbortInfo`](GenerationAbortInfo.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n\n***\n\n### onError?\n\n```ts\noptional onError?: (ctx, info) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:216](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L216)\n\nCalled when the activity throws before completing.\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n##### info\n\n[`GenerationErrorInfo`](GenerationErrorInfo.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n\n***\n\n### onFinish?\n\n```ts\noptional onFinish?: (ctx, info) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:206](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L206)\n\nCalled after the activity completes successfully.\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n##### info\n\n[`GenerationFinishInfo`](GenerationFinishInfo.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n\n***\n\n### onStart?\n\n```ts\noptional onStart?: (ctx) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:199](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L199)\n\nCalled before the adapter request begins.\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n\n***\n\n### onUsage?\n\n```ts\noptional onUsage?: (ctx, usage) => void | Promise<void>;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:201](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L201)\n\nCalled when the provider reports usage, before `onFinish`.\n\n#### Parameters\n\n##### ctx\n\n[`GenerationMiddlewareContext`](GenerationMiddlewareContext.md)\\<`TContext`\\>\n\n##### usage\n\n[`GenerationUsageInfo`](GenerationUsageInfo.md)\n\n#### Returns\n\n`void` \\| `Promise`\\<`void`\\>\n"}
