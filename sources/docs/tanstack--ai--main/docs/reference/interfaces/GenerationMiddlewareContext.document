text","value":"Which activity this call is. Discriminates media from chat."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"artifactinputs","children":[{"type":"text","value":"artifactInputs?"}]},{"type":"code","value":"optional artifactInputs?: unknown;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L108","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:108"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Activity inputs captured for middleware that needs to transform or persist\nthe result together with reconstructable request metadata."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"context","children":[{"type":"text","value":"context"}]},{"type":"code","value":"context: TContext;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L88","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:88"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Runtime context provided by the activity options, if any."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"createid","children":[{"type":"text","value":"createId"}]},{"type":"code","value":"createId: (prefix) => string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L86","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:86"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Generate a unique id with the given prefix."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"prefix","children":[{"type":"text","value":"prefix"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"model","children":[{"type":"text","value":"model"}]},{"type":"code","value":"model: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L72","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:72"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Model id. Emitted as "},{"type":"inlineCode","value":"gen_ai.request.model"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"modeloptions","children":[{"type":"text","value":"modelOptions?"}]},{"type":"code","value":"optional modelOptions?: unknown;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L82","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:82"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Provider-specific options passed to the activity, if any. Typed "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"\nbecause each activity's options are strongly typed per model; a supertype\nof "},{"type":"inlineCode","value":"ChatMiddlewareContext"},{"type":"text","value":"'s "},{"type":"inlineCode","value":"modelOptions"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"provider","children":[{"type":"text","value":"provider"}]},{"type":"code","value":"provider: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L70","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:70"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Provider/adapter name (e.g. "},{"type":"inlineCode","value":"\"openai\""},{"type":"text","value":"). Emitted as "},{"type":"inlineCode","value":"gen_ai.system"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"requestid","children":[{"type":"text","value":"requestId"}]},{"type":"code","value":"requestId: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L66","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:66"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Stable id correlating the "},{"type":"inlineCode","value":"onStart"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onFinish"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" / "},{"type":"inlineCode","value":"onAbort"},{"type":"text","value":"\nhooks of a single activity call."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"resulttransforms","children":[{"type":"text","value":"resultTransforms"}]},{"type":"code","value":"resultTransforms: GenerationResultTransform<any, TContext>[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L103","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:103"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Result transforms registered by middleware during this activity call.\nTransforms run after the raw adapter result exists and before the final\nresult is returned or streamed. Push multiple transforms to run them in\nregistration order."}]},{"type":"paragraph","children":[{"type":"text","value":"REQUIRED (always an array, empty when nothing registered): middleware\nregisters by pushing onto it, so an optional array would let a host that\nbuilds its own context omit it and silently no-op every registration —\ngeneration persistence would then mark a run completed with neither its\nresult nor its artifacts written, with nothing to observe but the missing\ndata. Every context the library builds comes from\n"},{"type":"inlineCode","value":"createGenerationContext"},{"type":"text","value":", which always sets "},{"type":"inlineCode","value":"[]"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"runid","children":[{"type":"text","value":"runId?"}]},{"type":"code","value":"optional runId?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L76","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:76"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Stable run id, when supplied by the caller."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"source","children":[{"type":"text","value":"source"}]},{"type":"code","value":"source: \"server\" | \"client\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L84","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:84"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Where the call originates. Always "},{"type":"inlineCode","value":"'server'"},{"type":"text","value":" for media activities."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"threadid","children":[{"type":"text","value":"threadId?"}]},{"type":"code","value":"optional threadId?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L74","children":[{"type":"text","value":"packages/ai/src/activities/middleware/types.ts:74"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Stable conversation/thread id, when supplied by the caller."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tcontext","text":"TContext","level":3},{"id":"properties","text":"Properties","level":2},{"id":"activity","text":"activity","level":3},{"id":"artifactinputs","text":"artifactInputs?","level":3},{"id":"context","text":"context","level":3},{"id":"createid","text":"createId","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"prefix","text":"prefix","level":5},{"id":"returns","text":"Returns","level":4},{"id":"model","text":"model","level":3},{"id":"modeloptions","text":"modelOptions?","level":3},{"id":"provider","text":"provider","level":3},{"id":"requestid","text":"requestId","level":3},{"id":"resulttransforms","text":"resultTransforms","level":3},{"id":"runid","text":"runId?","level":3},{"id":"source","text":"source","level":3},{"id":"threadid","text":"threadId?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/activities/middleware/types.ts:61](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L61)\n\nStable context passed to every [GenerationMiddleware](GenerationMiddleware.md) hook. Created\nonce per activity call and shared across the hooks of that call.\n\nCarries only fields every activity can honor. `ChatMiddlewareContext`\nstructurally includes all of these plus chat-only state (messages,\niteration, capabilities, …), which is why a chat middleware that reads those\nextra fields is not assignable to `GenerationMiddleware`.\n\n## Type Parameters\n\n### TContext\n\n`TContext` = `unknown`\n\n## Properties\n\n### activity\n\n```ts\nactivity: GenerationActivity;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:68](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L68)\n\nWhich activity this call is. Discriminates media from chat.\n\n***\n\n### artifactInputs?\n\n```ts\noptional artifactInputs?: unknown;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:108](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L108)\n\nActivity inputs captured for middleware that needs to transform or persist\nthe result together with reconstructable request metadata.\n\n***\n\n### context\n\n```ts\ncontext: TContext;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:88](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L88)\n\nRuntime context provided by the activity options, if any.\n\n***\n\n### createId\n\n```ts\ncreateId: (prefix) => string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:86](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L86)\n\nGenerate a unique id with the given prefix.\n\n#### Parameters\n\n##### prefix\n\n`string`\n\n#### Returns\n\n`string`\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:72](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L72)\n\nModel id. Emitted as `gen_ai.request.model`.\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: unknown;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:82](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L82)\n\nProvider-specific options passed to the activity, if any. Typed `unknown`\nbecause each activity's options are strongly typed per model; a supertype\nof `ChatMiddlewareContext`'s `modelOptions`.\n\n***\n\n### provider\n\n```ts\nprovider: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:70](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L70)\n\nProvider/adapter name (e.g. `\"openai\"`). Emitted as `gen_ai.system`.\n\n***\n\n### requestId\n\n```ts\nrequestId: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:66](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L66)\n\nStable id correlating the `onStart` / `onFinish` / `onError` / `onAbort`\nhooks of a single activity call.\n\n***\n\n### resultTransforms\n\n```ts\nresultTransforms: GenerationResultTransform<any, TContext>[];\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:103](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L103)\n\nResult transforms registered by middleware during this activity call.\nTransforms run after the raw adapter result exists and before the final\nresult is returned or streamed. Push multiple transforms to run them in\nregistration order.\n\nREQUIRED (always an array, empty when nothing registered): middleware\nregisters by pushing onto it, so an optional array would let a host that\nbuilds its own context omit it and silently no-op every registration —\ngeneration persistence would then mark a run completed with neither its\nresult nor its artifacts written, with nothing to observe but the missing\ndata. Every context the library builds comes from\n`createGenerationContext`, which always sets `[]`.\n\n***\n\n### runId?\n\n```ts\noptional runId?: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:76](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L76)\n\nStable run id, when supplied by the caller.\n\n***\n\n### source\n\n```ts\nsource: \"server\" | \"client\";\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:84](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L84)\n\nWhere the call originates. Always `'server'` for media activities.\n\n***\n\n### threadId?\n\n```ts\noptional threadId?: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:74](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L74)\n\nStable conversation/thread id, when supplied by the caller.\n","originalRawMarkdown":"---\nid: GenerationMiddlewareContext\ntitle: GenerationMiddlewareContext\n---\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:61](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L61)\n\nStable context passed to every [GenerationMiddleware](GenerationMiddleware.md) hook. Created\nonce per activity call and shared across the hooks of that call.\n\nCarries only fields every activity can honor. `ChatMiddlewareContext`\nstructurally includes all of these plus chat-only state (messages,\niteration, capabilities, …), which is why a chat middleware that reads those\nextra fields is not assignable to `GenerationMiddleware`.\n\n## Type Parameters\n\n### TContext\n\n`TContext` = `unknown`\n\n## Properties\n\n### activity\n\n```ts\nactivity: GenerationActivity;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:68](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L68)\n\nWhich activity this call is. Discriminates media from chat.\n\n***\n\n### artifactInputs?\n\n```ts\noptional artifactInputs?: unknown;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:108](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L108)\n\nActivity inputs captured for middleware that needs to transform or persist\nthe result together with reconstructable request metadata.\n\n***\n\n### context\n\n```ts\ncontext: TContext;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:88](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L88)\n\nRuntime context provided by the activity options, if any.\n\n***\n\n### createId\n\n```ts\ncreateId: (prefix) => string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:86](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L86)\n\nGenerate a unique id with the given prefix.\n\n#### Parameters\n\n##### prefix\n\n`string`\n\n#### Returns\n\n`string`\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:72](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L72)\n\nModel id. Emitted as `gen_ai.request.model`.\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: unknown;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:82](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L82)\n\nProvider-specific options passed to the activity, if any. Typed `unknown`\nbecause each activity's options are strongly typed per model; a supertype\nof `ChatMiddlewareContext`'s `modelOptions`.\n\n***\n\n### provider\n\n```ts\nprovider: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:70](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L70)\n\nProvider/adapter name (e.g. `\"openai\"`). Emitted as `gen_ai.system`.\n\n***\n\n### requestId\n\n```ts\nrequestId: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:66](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L66)\n\nStable id correlating the `onStart` / `onFinish` / `onError` / `onAbort`\nhooks of a single activity call.\n\n***\n\n### resultTransforms\n\n```ts\nresultTransforms: GenerationResultTransform<any, TContext>[];\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:103](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L103)\n\nResult transforms registered by middleware during this activity call.\nTransforms run after the raw adapter result exists and before the final\nresult is returned or streamed. Push multiple transforms to run them in\nregistration order.\n\nREQUIRED (always an array, empty when nothing registered): middleware\nregisters by pushing onto it, so an optional array would let a host that\nbuilds its own context omit it and silently no-op every registration —\ngeneration persistence would then mark a run completed with neither its\nresult nor its artifacts written, with nothing to observe but the missing\ndata. Every context the library builds comes from\n`createGenerationContext`, which always sets `[]`.\n\n***\n\n### runId?\n\n```ts\noptional runId?: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:76](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L76)\n\nStable run id, when supplied by the caller.\n\n***\n\n### source\n\n```ts\nsource: \"server\" | \"client\";\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:84](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L84)\n\nWhere the call originates. Always `'server'` for media activities.\n\n***\n\n### threadId?\n\n```ts\noptional threadId?: string;\n```\n\nDefined in: [packages/ai/src/activities/middleware/types.ts:74](https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/middleware/types.ts#L74)\n\nStable conversation/thread id, when supplied by the caller.\n"}
