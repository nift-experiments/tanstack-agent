","value":" "},{"type":"inlineCode","value":"string"}]},{"type":"paragraph","children":[{"type":"text","value":"Provider identifier (e.g. "},{"type":"inlineCode","value":"'anthropic'"},{"type":"text","value":", "},{"type":"inlineCode","value":"'openai'"},{"type":"text","value":")."}]},{"type":"heading","depth":3,"id":"tkind","children":[{"type":"text","value":"TKind"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKind"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"}]},{"type":"paragraph","children":[{"type":"text","value":"Canonical tool-kind string matching the provider's\n"},{"type":"inlineCode","value":"supports.tools"},{"type":"text","value":" entries (e.g. "},{"type":"inlineCode","value":"'web_search'"},{"type":"text","value":", "},{"type":"inlineCode","value":"'code_execution'"},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"provider","children":[{"type":"text","value":"~provider"}]},{"type":"code","value":"readonly ~provider: TProvider;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/tools/provider-tool.ts#L23","children":[{"type":"text","value":"packages/ai/src/tools/provider-tool.ts:23"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"toolkind","children":[{"type":"text","value":"~toolKind"}]},{"type":"code","value":"readonly ~toolKind: TKind;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/tools/provider-tool.ts#L24","children":[{"type":"text","value":"packages/ai/src/tools/provider-tool.ts:24"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"description","children":[{"type":"text","value":"description"}]},{"type":"code","value":"description: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L863","children":[{"type":"text","value":"packages/ai/src/types.ts:863"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Clear description of what the tool does."}]},{"type":"paragraph","children":[{"type":"text","value":"This is crucial - the model uses this to decide when to call the tool.\nBe specific about what the tool does, what parameters it needs, and what it returns."}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"\"Get the current weather in a given location. Returns temperature, conditions, and forecast.\"","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"Tool.md","children":[{"type":"inlineCode","value":"Tool"}]},{"type":"text","value":"."},{"type":"link","href":"Tool.md#description","children":[{"type":"inlineCode","value":"description"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"execute","children":[{"type":"text","value":"execute?"}]},{"type":"code","value":"optional execute?: (args, context?) => any;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L943","children":[{"type":"text","value":"packages/ai/src/types.ts:943"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional function to execute when the model calls this tool."}]},{"type":"paragraph","children":[{"type":"text","value":"If provided, the SDK will automatically execute the function with the model's arguments\nand feed the result back to the model. This enables autonomous tool use loops."}]},{"type":"paragraph","children":[{"type":"text","value":"Can return any value - will be automatically stringified if needed."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"any"}]},{"type":"paragraph","children":[{"type":"text","value":"The arguments parsed from the model's tool call (validated against inputSchema)"}]},{"type":"heading","depth":5,"id":"context","children":[{"type":"text","value":"context?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/ToolExecutionContext.md","children":[{"type":"inlineCode","value":"ToolExecutionContext"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"any"}]},{"type":"paragraph","children":[{"type":"text","value":"Result to send back to the model (validated against outputSchema if provided)"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"execute: async (args) => {\n  const weather = await fetchWeather(args.location);\n  return weather; // Can return object or string\n}","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-2","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"Tool.md","children":[{"type":"inlineCode","value":"Tool"}]},{"type":"text","value":"."},{"type":"link","href":"Tool.md#execute","children":[{"type":"inlineCode","value":"execute"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"inputschema","children":[{"type":"text","value":"inputSchema?"}]},{"type":"code","value":"optional inputSchema?: SchemaInput;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L903","children":[{"type":"text","value":"packages/ai/src/types.ts:903"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Schema describing the tool's input parameters."}]},{"type":"paragraph","children":[{"type":"text","value":"Can be any Standard JSON Schema compliant schema (Zod, ArkType, Valibot, etc.) or a plain JSON Schema object.\nDefines the structure and types of arguments the tool accepts.\nThe model will generate arguments matching this schema.\nStandard JSON Schema compliant schemas are converted to JSON Schema for LLM providers."}]},{"type":"heading","depth":4,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"https://standardschema.dev/json-schema"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"https://json-schema.org/"}]}]}]},{"type":"heading","depth":4,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Using Zod v4+ schema (natively supports Standard JSON Schema)\nimport { z } from 'zod';\nz.object({\n  location: z.string().describe(\"City name or coordinates\"),\n  unit: z.enum([\"celsius\", \"fahrenheit\"]).optional()\n})","lang":"ts"},{"type":"code","value":"// Using ArkType (natively supports Standard JSON Schema)\nimport { type } from 'arktype';\ntype({\n  location: 'string',\n  unit: \"'celsius' | 'fahrenheit'\"\n})","lang":"ts"},{"type":"code","value":"// Using plain JSON Schema\n{\n  type: 'object',\n  properties: {\n    location: { type: 'string', description: 'City name or coordinates' },\n    unit: { type: 'string', enum: ['celsius', 'fahrenheit'] }\n  },\n  required: ['location']\n}","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-3","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"Tool.md","children":[{"type":"inlineCode","value":"Tool"}]},{"type":"text","value":"."},{"type":"link","href":"Tool.md#inputschema","children":[{"type":"inlineCode","value":"inputSchema"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"lazy","children":[{"type":"text","value":"lazy?"}]},{"type":"code","value":"optional lazy?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L949","children":[{"type":"text","value":"packages/ai/src/types.ts:949"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If true, this tool is lazy and will only be sent to the LLM after being discovered via the lazy tool discovery mechanism. Works with both chat() (the synthetic discovery tool) and Code Mode (kept out of the system prompt and revealed via discover_tools)."}]},{"type":"heading","depth":4,"id":"inherited-from-4","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"Tool.md","children":[{"type":"inlineCode","value":"Tool"}]},{"type":"text","value":"."},{"type":"link","href":"Tool.md#lazy","children":[{"type":"inlineCode","value":"lazy"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"metadata","children":[{"type":"text","value":"metadata?"}]},{"type":"code","value":"optional metadata?: Record<string, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L952","children":[{"type":"text","value":"packages/ai/src/types.ts:952"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Additional metadata for adapters or custom extensions"}]},{"type":"heading","depth":4,"id":"inherited-from-5","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"Tool.md","children":[{"type":"inlineCode","value":"Tool"}]},{"type":"text","value":"."},{"type":"link","href":"Tool.md#metadata","children":[{"type":"inlineCode","value":"metadata"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"name","children":[{"type":"text","value":"name"}]},{"type":"code","value":"name: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L853","children":[{"type":"text","value":"packages/ai/src/types.ts:853"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Unique name of the tool (used by the model to call it)."}]},{"type":"paragraph","children":[{"type":"text","value":"Should be descriptive and follow naming conventions (e.g., snake_case or camelCase).\nMust be unique within the tools array."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"\"get_weather\", \"search_database\", \"sendEmail\"","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-6","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"Tool.md","children":[{"type":"inlineCode","value":"Tool"}]},{"type":"text","value":"."},{"type":"link","href":"Tool.md#name","children":[{"type":"inlineCode","value":"name"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"needsapproval","children":[{"type":"text","value":"needsApproval?"}]},{"type":"code","value":"optional needsApproval?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L946","children":[{"type":"text","value":"packages/ai/src/types.ts:946"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If true, tool execution requires user approval before running. Works with both server and client tools."}]},{"type":"heading","depth":4,"id":"inherited-from-7","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"Tool.md","children":[{"type":"inlineCode","value":"Tool"}]},{"type":"text","value":"."},{"type":"link","href":"Tool.md#needsapproval","children":[{"type":"inlineCode","value":"needsApproval"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"outputschema","children":[{"type":"text","value":"outputSchema?"}]},{"type":"code","value":"optional outputSchema?: SchemaInput;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L924","children":[{"type":"text","value":"packages/ai/src/types.ts:924"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional schema for validating tool output."}]},{"type":"paragraph","children":[{"type":"text","value":"Can be any Standard JSON Schema compliant schema or a plain JSON Schema object.\nIf provided with a Standard Schema compliant schema, tool results will be validated\nagainst this schema before being sent back to the model. This catches bugs in tool\nimplementations and ensures consistent output formatting."}]},{"type":"paragraph","children":[{"type":"text","value":"Note: This is client-side validation only - not sent to LLM providers.\nNote: Plain JSON Schema output validation is not performed at runtime."}]},{"type":"heading","depth":4,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Using Zod\nz.object({\n  temperature: z.number(),\n  conditions: z.string(),\n  forecast: z.array(z.string()).optional()\n})","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-8","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"Tool.md","children":[{"type":"inlineCode","value":"Tool"}]},{"type":"text","value":"."},{"type":"link","href":"Tool.md#outputschema","children":[{"type":"inlineCode","value":"outputSchema"}]}]}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tprovider","text":"TProvider","level":3},{"id":"tkind","text":"TKind","level":3},{"id":"properties","text":"Properties","level":2},{"id":"provider","text":"~provider","level":3},{"id":"toolkind","text":"~toolKind","level":3},{"id":"description","text":"description","level":3},{"id":"example","text":"Example","level":4},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"execute","text":"execute?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"args","text":"args","level":5},{"id":"context","text":"context?","level":5},{"id":"returns","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"inherited-from-2","text":"Inherited from","level":4},{"id":"inputschema","text":"inputSchema?","level":3},{"id":"see","text":"See","level":4},{"id":"examples","text":"Examples","level":4},{"id":"inherited-from-3","text":"Inherited from","level":4},{"id":"lazy","text":"lazy?","level":3},{"id":"inherited-from-4","text":"Inherited from","level":4},{"id":"metadata","text":"metadata?","level":3},{"id":"inherited-from-5","text":"Inherited from","level":4},{"id":"name","text":"name","level":3},{"id":"example-3","text":"Example","level":4},{"id":"inherited-from-6","text":"Inherited from","level":4},{"id":"needsapproval","text":"needsApproval?","level":3},{"id":"inherited-from-7","text":"Inherited from","level":4},{"id":"outputschema","text":"outputSchema?","level":3},{"id":"example-4","text":"Example","level":4},{"id":"inherited-from-8","text":"Inherited from","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/tools/provider-tool.ts:19](https://github.com/TanStack/ai/blob/main/packages/ai/src/tools/provider-tool.ts#L19)\n\nA provider-specific tool produced by an adapter-package factory\n(e.g. `webSearchTool` from `@tanstack/ai-anthropic/tools`).\n\nThe two `~`-prefixed fields are type-only phantom brands — they are never\nassigned at runtime. They allow the core type system to match a factory's\noutput against the selected model's `supports.tools` list and surface a\ncompile-time error when the combination is unsupported.\n\nUser-defined tools (via `toolDefinition()`) remain plain `Tool` and stay\nassignable to any model.\n\n## Extends\n\n- [`Tool`](Tool.md)\n\n## Type Parameters\n\n### TProvider\n\n`TProvider` *extends* `string`\n\nProvider identifier (e.g. `'anthropic'`, `'openai'`).\n\n### TKind\n\n`TKind` *extends* `string`\n\nCanonical tool-kind string matching the provider's\n  `supports.tools` entries (e.g. `'web_search'`, `'code_execution'`).\n\n## Properties\n\n### ~provider\n\n```ts\nreadonly ~provider: TProvider;\n```\n\nDefined in: [packages/ai/src/tools/provider-tool.ts:23](https://github.com/TanStack/ai/blob/main/packages/ai/src/tools/provider-tool.ts#L23)\n\n***\n\n### ~toolKind\n\n```ts\nreadonly ~toolKind: TKind;\n```\n\nDefined in: [packages/ai/src/tools/provider-tool.ts:24](https://github.com/TanStack/ai/blob/main/packages/ai/src/tools/provider-tool.ts#L24)\n\n***\n\n### description\n\n```ts\ndescription: string;\n```\n\nDefined in: [packages/ai/src/types.ts:863](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L863)\n\nClear description of what the tool does.\n\nThis is crucial - the model uses this to decide when to call the tool.\nBe specific about what the tool does, what parameters it needs, and what it returns.\n\n#### Example\n\n```ts\n\"Get the current weather in a given location. Returns temperature, conditions, and forecast.\"\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`description`](Tool.md#description)\n\n***\n\n### execute?\n\n```ts\noptional execute?: (args, context?) => any;\n```\n\nDefined in: [packages/ai/src/types.ts:943](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L943)\n\nOptional function to execute when the model calls this tool.\n\nIf provided, the SDK will automatically execute the function with the model's arguments\nand feed the result back to the model. This enables autonomous tool use loops.\n\nCan return any value - will be automatically stringified if needed.\n\n#### Parameters\n\n##### args\n\n`any`\n\nThe arguments parsed from the model's tool call (validated against inputSchema)\n\n##### context?\n\n[`ToolExecutionContext`](../type-aliases/ToolExecutionContext.md)\\<`unknown`\\>\n\n#### Returns\n\n`any`\n\nResult to send back to the model (validated against outputSchema if provided)\n\n#### Example\n\n```ts\nexecute: async (args) => {\n  const weather = await fetchWeather(args.location);\n  return weather; // Can return object or string\n}\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`execute`](Tool.md#execute)\n\n***\n\n### inputSchema?\n\n```ts\noptional inputSchema?: SchemaInput;\n```\n\nDefined in: [packages/ai/src/types.ts:903](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L903)\n\nSchema describing the tool's input parameters.\n\nCan be any Standard JSON Schema compliant schema (Zod, ArkType, Valibot, etc.) or a plain JSON Schema object.\nDefines the structure and types of arguments the tool accepts.\nThe model will generate arguments matching this schema.\nStandard JSON Schema compliant schemas are converted to JSON Schema for LLM providers.\n\n#### See\n\n - https://standardschema.dev/json-schema\n - https://json-schema.org/\n\n#### Examples\n\n```ts\n// Using Zod v4+ schema (natively supports Standard JSON Schema)\nimport { z } from 'zod';\nz.object({\n  location: z.string().describe(\"City name or coordinates\"),\n  unit: z.enum([\"celsius\", \"fahrenheit\"]).optional()\n})\n```\n\n```ts\n// Using ArkType (natively supports Standard JSON Schema)\nimport { type } from 'arktype';\ntype({\n  location: 'string',\n  unit: \"'celsius' | 'fahrenheit'\"\n})\n```\n\n```ts\n// Using plain JSON Schema\n{\n  type: 'object',\n  properties: {\n    location: { type: 'string', description: 'City name or coordinates' },\n    unit: { type: 'string', enum: ['celsius', 'fahrenheit'] }\n  },\n  required: ['location']\n}\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`inputSchema`](Tool.md#inputschema)\n\n***\n\n### lazy?\n\n```ts\noptional lazy?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:949](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L949)\n\nIf true, this tool is lazy and will only be sent to the LLM after being discovered via the lazy tool discovery mechanism. Works with both chat() (the synthetic discovery tool) and Code Mode (kept out of the system prompt and revealed via discover_tools).\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`lazy`](Tool.md#lazy)\n\n***\n\n### metadata?\n\n```ts\noptional metadata?: Record<string, any>;\n```\n\nDefined in: [packages/ai/src/types.ts:952](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L952)\n\nAdditional metadata for adapters or custom extensions\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`metadata`](Tool.md#metadata)\n\n***\n\n### name\n\n```ts\nname: string;\n```\n\nDefined in: [packages/ai/src/types.ts:853](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L853)\n\nUnique name of the tool (used by the model to call it).\n\nShould be descriptive and follow naming conventions (e.g., snake_case or camelCase).\nMust be unique within the tools array.\n\n#### Example\n\n```ts\n\"get_weather\", \"search_database\", \"sendEmail\"\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`name`](Tool.md#name)\n\n***\n\n### needsApproval?\n\n```ts\noptional needsApproval?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:946](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L946)\n\nIf true, tool execution requires user approval before running. Works with both server and client tools.\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`needsApproval`](Tool.md#needsapproval)\n\n***\n\n### outputSchema?\n\n```ts\noptional outputSchema?: SchemaInput;\n```\n\nDefined in: [packages/ai/src/types.ts:924](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L924)\n\nOptional schema for validating tool output.\n\nCan be any Standard JSON Schema compliant schema or a plain JSON Schema object.\nIf provided with a Standard Schema compliant schema, tool results will be validated\nagainst this schema before being sent back to the model. This catches bugs in tool\nimplementations and ensures consistent output formatting.\n\nNote: This is client-side validation only - not sent to LLM providers.\nNote: Plain JSON Schema output validation is not performed at runtime.\n\n#### Example\n\n```ts\n// Using Zod\nz.object({\n  temperature: z.number(),\n  conditions: z.string(),\n  forecast: z.array(z.string()).optional()\n})\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`outputSchema`](Tool.md#outputschema)\n","originalRawMarkdown":"---\nid: ProviderTool\ntitle: ProviderTool\n---\n\nDefined in: [packages/ai/src/tools/provider-tool.ts:19](https://github.com/TanStack/ai/blob/main/packages/ai/src/tools/provider-tool.ts#L19)\n\nA provider-specific tool produced by an adapter-package factory\n(e.g. `webSearchTool` from `@tanstack/ai-anthropic/tools`).\n\nThe two `~`-prefixed fields are type-only phantom brands — they are never\nassigned at runtime. They allow the core type system to match a factory's\noutput against the selected model's `supports.tools` list and surface a\ncompile-time error when the combination is unsupported.\n\nUser-defined tools (via `toolDefinition()`) remain plain `Tool` and stay\nassignable to any model.\n\n## Extends\n\n- [`Tool`](Tool.md)\n\n## Type Parameters\n\n### TProvider\n\n`TProvider` *extends* `string`\n\nProvider identifier (e.g. `'anthropic'`, `'openai'`).\n\n### TKind\n\n`TKind` *extends* `string`\n\nCanonical tool-kind string matching the provider's\n  `supports.tools` entries (e.g. `'web_search'`, `'code_execution'`).\n\n## Properties\n\n### ~provider\n\n```ts\nreadonly ~provider: TProvider;\n```\n\nDefined in: [packages/ai/src/tools/provider-tool.ts:23](https://github.com/TanStack/ai/blob/main/packages/ai/src/tools/provider-tool.ts#L23)\n\n***\n\n### ~toolKind\n\n```ts\nreadonly ~toolKind: TKind;\n```\n\nDefined in: [packages/ai/src/tools/provider-tool.ts:24](https://github.com/TanStack/ai/blob/main/packages/ai/src/tools/provider-tool.ts#L24)\n\n***\n\n### description\n\n```ts\ndescription: string;\n```\n\nDefined in: [packages/ai/src/types.ts:863](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L863)\n\nClear description of what the tool does.\n\nThis is crucial - the model uses this to decide when to call the tool.\nBe specific about what the tool does, what parameters it needs, and what it returns.\n\n#### Example\n\n```ts\n\"Get the current weather in a given location. Returns temperature, conditions, and forecast.\"\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`description`](Tool.md#description)\n\n***\n\n### execute?\n\n```ts\noptional execute?: (args, context?) => any;\n```\n\nDefined in: [packages/ai/src/types.ts:943](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L943)\n\nOptional function to execute when the model calls this tool.\n\nIf provided, the SDK will automatically execute the function with the model's arguments\nand feed the result back to the model. This enables autonomous tool use loops.\n\nCan return any value - will be automatically stringified if needed.\n\n#### Parameters\n\n##### args\n\n`any`\n\nThe arguments parsed from the model's tool call (validated against inputSchema)\n\n##### context?\n\n[`ToolExecutionContext`](../type-aliases/ToolExecutionContext.md)\\<`unknown`\\>\n\n#### Returns\n\n`any`\n\nResult to send back to the model (validated against outputSchema if provided)\n\n#### Example\n\n```ts\nexecute: async (args) => {\n  const weather = await fetchWeather(args.location);\n  return weather; // Can return object or string\n}\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`execute`](Tool.md#execute)\n\n***\n\n### inputSchema?\n\n```ts\noptional inputSchema?: SchemaInput;\n```\n\nDefined in: [packages/ai/src/types.ts:903](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L903)\n\nSchema describing the tool's input parameters.\n\nCan be any Standard JSON Schema compliant schema (Zod, ArkType, Valibot, etc.) or a plain JSON Schema object.\nDefines the structure and types of arguments the tool accepts.\nThe model will generate arguments matching this schema.\nStandard JSON Schema compliant schemas are converted to JSON Schema for LLM providers.\n\n#### See\n\n - https://standardschema.dev/json-schema\n - https://json-schema.org/\n\n#### Examples\n\n```ts\n// Using Zod v4+ schema (natively supports Standard JSON Schema)\nimport { z } from 'zod';\nz.object({\n  location: z.string().describe(\"City name or coordinates\"),\n  unit: z.enum([\"celsius\", \"fahrenheit\"]).optional()\n})\n```\n\n```ts\n// Using ArkType (natively supports Standard JSON Schema)\nimport { type } from 'arktype';\ntype({\n  location: 'string',\n  unit: \"'celsius' | 'fahrenheit'\"\n})\n```\n\n```ts\n// Using plain JSON Schema\n{\n  type: 'object',\n  properties: {\n    location: { type: 'string', description: 'City name or coordinates' },\n    unit: { type: 'string', enum: ['celsius', 'fahrenheit'] }\n  },\n  required: ['location']\n}\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`inputSchema`](Tool.md#inputschema)\n\n***\n\n### lazy?\n\n```ts\noptional lazy?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:949](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L949)\n\nIf true, this tool is lazy and will only be sent to the LLM after being discovered via the lazy tool discovery mechanism. Works with both chat() (the synthetic discovery tool) and Code Mode (kept out of the system prompt and revealed via discover_tools).\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`lazy`](Tool.md#lazy)\n\n***\n\n### metadata?\n\n```ts\noptional metadata?: Record<string, any>;\n```\n\nDefined in: [packages/ai/src/types.ts:952](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L952)\n\nAdditional metadata for adapters or custom extensions\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`metadata`](Tool.md#metadata)\n\n***\n\n### name\n\n```ts\nname: string;\n```\n\nDefined in: [packages/ai/src/types.ts:853](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L853)\n\nUnique name of the tool (used by the model to call it).\n\nShould be descriptive and follow naming conventions (e.g., snake_case or camelCase).\nMust be unique within the tools array.\n\n#### Example\n\n```ts\n\"get_weather\", \"search_database\", \"sendEmail\"\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`name`](Tool.md#name)\n\n***\n\n### needsApproval?\n\n```ts\noptional needsApproval?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:946](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L946)\n\nIf true, tool execution requires user approval before running. Works with both server and client tools.\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`needsApproval`](Tool.md#needsapproval)\n\n***\n\n### outputSchema?\n\n```ts\noptional outputSchema?: SchemaInput;\n```\n\nDefined in: [packages/ai/src/types.ts:924](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L924)\n\nOptional schema for validating tool output.\n\nCan be any Standard JSON Schema compliant schema or a plain JSON Schema object.\nIf provided with a Standard Schema compliant schema, tool results will be validated\nagainst this schema before being sent back to the model. This catches bugs in tool\nimplementations and ensures consistent output formatting.\n\nNote: This is client-side validation only - not sent to LLM providers.\nNote: Plain JSON Schema output validation is not performed at runtime.\n\n#### Example\n\n```ts\n// Using Zod\nz.object({\n  temperature: z.number(),\n  conditions: z.string(),\n  forecast: z.array(z.string()).optional()\n})\n```\n\n#### Inherited from\n\n[`Tool`](Tool.md).[`outputSchema`](Tool.md#outputschema)\n"}
