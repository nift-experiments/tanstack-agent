pe":"text","value":"Forwarded to the provider request for cancellation."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"documents","children":[{"type":"text","value":"documents"}]},{"type":"code","value":"documents: string[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1998","children":[{"type":"text","value":"packages/ai/src/types.ts:1998"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Documents to rerank, pre-serialized to strings by the activity."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"logger","children":[{"type":"text","value":"logger"}]},{"type":"code","value":"logger: InternalLogger;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2010","children":[{"type":"text","value":"packages/ai/src/types.ts:2010"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Internal logger threaded from the rerank() entry point. Adapters must call\nlogger.request() before the provider call and logger.errors() in catch\nblocks."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"model","children":[{"type":"text","value":"model"}]},{"type":"code","value":"model: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1994","children":[{"type":"text","value":"packages/ai/src/types.ts:1994"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"modeloptions","children":[{"type":"text","value":"modelOptions?"}]},{"type":"code","value":"optional modelOptions?: TProviderOptions;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2002","children":[{"type":"text","value":"packages/ai/src/types.ts:2002"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Provider-specific options forwarded by the rerank() activity."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"query","children":[{"type":"text","value":"query"}]},{"type":"code","value":"query: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1996","children":[{"type":"text","value":"packages/ai/src/types.ts:1996"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The search query documents are scored against."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"topn","children":[{"type":"text","value":"topN?"}]},{"type":"code","value":"optional topN?: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2000","children":[{"type":"text","value":"packages/ai/src/types.ts:2000"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Return only the top N results. Passed through to the provider."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tprovideroptions","text":"TProviderOptions","level":3},{"id":"properties","text":"Properties","level":2},{"id":"abortsignal","text":"abortSignal?","level":3},{"id":"documents","text":"documents","level":3},{"id":"logger","text":"logger","level":3},{"id":"model","text":"model","level":3},{"id":"modeloptions","text":"modelOptions?","level":3},{"id":"query","text":"query","level":3},{"id":"topn","text":"topN?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/types.ts:1991](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1991)\n\nOptions passed to a [RerankAdapter](RerankAdapter.md). Documents reach the adapter\nalready serialized to strings — the `rerank()` activity stringifies object\ndocuments and maps results back to the original elements, so adapters never\ndeal with the caller's document type.\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:2004](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2004)\n\nForwarded to the provider request for cancellation.\n\n***\n\n### documents\n\n```ts\ndocuments: string[];\n```\n\nDefined in: [packages/ai/src/types.ts:1998](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1998)\n\nDocuments to rerank, pre-serialized to strings by the activity.\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:2010](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2010)\n\nInternal logger threaded from the rerank() entry point. Adapters must call\nlogger.request() before the provider call and logger.errors() in catch\nblocks.\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1994](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1994)\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:2002](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2002)\n\nProvider-specific options forwarded by the rerank() activity.\n\n***\n\n### query\n\n```ts\nquery: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1996](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1996)\n\nThe search query documents are scored against.\n\n***\n\n### topN?\n\n```ts\noptional topN?: number;\n```\n\nDefined in: [packages/ai/src/types.ts:2000](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2000)\n\nReturn only the top N results. Passed through to the provider.\n","originalRawMarkdown":"---\nid: RerankOptions\ntitle: RerankOptions\n---\n\nDefined in: [packages/ai/src/types.ts:1991](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1991)\n\nOptions passed to a [RerankAdapter](RerankAdapter.md). Documents reach the adapter\nalready serialized to strings — the `rerank()` activity stringifies object\ndocuments and maps results back to the original elements, so adapters never\ndeal with the caller's document type.\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:2004](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2004)\n\nForwarded to the provider request for cancellation.\n\n***\n\n### documents\n\n```ts\ndocuments: string[];\n```\n\nDefined in: [packages/ai/src/types.ts:1998](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1998)\n\nDocuments to rerank, pre-serialized to strings by the activity.\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:2010](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2010)\n\nInternal logger threaded from the rerank() entry point. Adapters must call\nlogger.request() before the provider call and logger.errors() in catch\nblocks.\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1994](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1994)\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:2002](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2002)\n\nProvider-specific options forwarded by the rerank() activity.\n\n***\n\n### query\n\n```ts\nquery: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1996](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1996)\n\nThe search query documents are scored against.\n\n***\n\n### topN?\n\n```ts\noptional topN?: number;\n```\n\nDefined in: [packages/ai/src/types.ts:2000](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2000)\n\nReturn only the top N results. Passed through to the provider.\n"}
