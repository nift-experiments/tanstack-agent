":"AbortSignal"}]},{"type":"heading","depth":6,"id":"threadid-2","children":[{"type":"text","value":"threadId"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"request","children":[{"type":"text","value":"request"}]},{"type":"code","value":"request: Request;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L979","children":[{"type":"text","value":"packages/ai/src/stream-to-response.ts:979"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The attach request; its run id is read with "},{"type":"link","href":"../functions/resolveResumeRunId.md","children":[{"type":"text","value":"resolveResumeRunId"}]},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"runs-2","children":[{"type":"text","value":"runs"}]},{"type":"code","value":"runs: RunStore;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L980","children":[{"type":"text","value":"packages/ai/src/stream-to-response.ts:980"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"waituntil","children":[{"type":"text","value":"waitUntil?"}]},{"type":"code","value":"optional waitUntil?: (promise) => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L1003","children":[{"type":"text","value":"packages/ai/src/stream-to-response.ts:1003"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Platform keep-alive (e.g. "},{"type":"inlineCode","value":"ctx.waitUntil"},{"type":"text","value":") for the background drive."}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"promise","children":[{"type":"text","value":"promise"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]}],"headings":[{"id":"properties","text":"Properties","level":2},{"id":"claim","text":"claim","level":3},{"id":"type-parameters","text":"Type Parameters","level":4},{"id":"t","text":"T","level":5},{"id":"parameters","text":"Parameters","level":4},{"id":"input","text":"input","level":5},{"id":"locks","text":"locks","level":6},{"id":"runid","text":"runId","level":6},{"id":"runs","text":"runs","level":6},{"id":"fn","text":"fn","level":5},{"id":"returns","text":"Returns","level":4},{"id":"drive","text":"drive","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"input-2","text":"input","level":5},{"id":"runid-2","text":"runId","level":6},{"id":"signal","text":"signal","level":6},{"id":"threadid","text":"threadId","level":6},{"id":"returns-2","text":"Returns","level":4},{"id":"locks-2","text":"locks","level":3},{"id":"logger","text":"logger?","level":3},{"id":"pipe","text":"pipe","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"stream","text":"stream","level":5},{"id":"input-3","text":"input","level":5},{"id":"runid-3","text":"runId","level":6},{"id":"signal-2","text":"signal","level":6},{"id":"threadid-2","text":"threadId","level":6},{"id":"returns-3","text":"Returns","level":4},{"id":"request","text":"request","level":3},{"id":"runs-2","text":"runs","level":3},{"id":"waituntil","text":"waitUntil?","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"promise","text":"promise","level":5},{"id":"returns-4","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/stream-to-response.ts:977](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L977)\n\nEverything the resume helpers need to take a run over as a side effect of\nserving its log.\n\n`claim` and `pipe` are **injected**, not imported. The two mechanisms a\ntakeover needs (`withRunClaim` and `pipeToRunLog`) live in\n`@tanstack/ai-sandbox`, and `@tanstack/ai` must not depend on that package —\nthat layering inversion is exactly what moving `LockStore` into core was meant\nto prevent, and it would make core depend on the sandbox package to serve a\nplain chat run. Injecting them keeps only the *shape* of a takeover in core\n(parse the run id, read the record, skip if terminal, claim, drive) and lets a\nbackground-worker-driven run supply its own pair.\n`@tanstack/ai-sandbox`'s `sandboxRunDriver` fills both in.\n\n## Properties\n\n### claim\n\n```ts\nclaim: <T>(input, fn) => Promise<T>;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:989](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L989)\n\nRun `fn` under exclusive ownership of the run, or reject if refused.\n\n#### Type Parameters\n\n##### T\n\n`T`\n\n#### Parameters\n\n##### input\n\n###### locks\n\n`LockStore`\n\n###### runId\n\n`string`\n\n###### runs\n\n[`RunStore`](RunStore.md)\n\n##### fn\n\n(`claim`) => `Promise`\\<`T`\\>\n\n#### Returns\n\n`Promise`\\<`T`\\>\n\n***\n\n### drive\n\n```ts\ndrive: (input) => AsyncIterable<AGUIEvent>;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:983](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L983)\n\nProduce the run's remaining events. Called only once the claim is held.\n\n#### Parameters\n\n##### input\n\n###### runId\n\n`string`\n\n###### signal\n\n`AbortSignal`\n\n###### threadId\n\n`string`\n\n#### Returns\n\n`AsyncIterable`\\<[`AGUIEvent`](../type-aliases/AGUIEvent.md)\\>\n\n***\n\n### locks\n\n```ts\nlocks: LockStore;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:981](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L981)\n\n***\n\n### logger?\n\n```ts\noptional logger?: InternalLogger;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:1004](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L1004)\n\n***\n\n### pipe\n\n```ts\npipe: (stream, input) => Promise<unknown>;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:998](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L998)\n\nPersist the driven stream to the run's producer-side durability log.\n\n#### Parameters\n\n##### stream\n\n`AsyncIterable`\\<[`AGUIEvent`](../type-aliases/AGUIEvent.md)\\>\n\n##### input\n\n###### runId\n\n`string`\n\n###### signal\n\n`AbortSignal`\n\n###### threadId\n\n`string`\n\n#### Returns\n\n`Promise`\\<`unknown`\\>\n\n***\n\n### request\n\n```ts\nrequest: Request;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:979](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L979)\n\nThe attach request; its run id is read with [resolveResumeRunId](../functions/resolveResumeRunId.md).\n\n***\n\n### runs\n\n```ts\nruns: RunStore;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:980](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L980)\n\n***\n\n### waitUntil?\n\n```ts\noptional waitUntil?: (promise) => void;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:1003](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L1003)\n\nPlatform keep-alive (e.g. `ctx.waitUntil`) for the background drive.\n\n#### Parameters\n\n##### promise\n\n`Promise`\\<`unknown`\\>\n\n#### Returns\n\n`void`\n","originalRawMarkdown":"---\nid: RunDriverOptions\ntitle: RunDriverOptions\n---\n\nDefined in: [packages/ai/src/stream-to-response.ts:977](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L977)\n\nEverything the resume helpers need to take a run over as a side effect of\nserving its log.\n\n`claim` and `pipe` are **injected**, not imported. The two mechanisms a\ntakeover needs (`withRunClaim` and `pipeToRunLog`) live in\n`@tanstack/ai-sandbox`, and `@tanstack/ai` must not depend on that package —\nthat layering inversion is exactly what moving `LockStore` into core was meant\nto prevent, and it would make core depend on the sandbox package to serve a\nplain chat run. Injecting them keeps only the *shape* of a takeover in core\n(parse the run id, read the record, skip if terminal, claim, drive) and lets a\nbackground-worker-driven run supply its own pair.\n`@tanstack/ai-sandbox`'s `sandboxRunDriver` fills both in.\n\n## Properties\n\n### claim\n\n```ts\nclaim: <T>(input, fn) => Promise<T>;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:989](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L989)\n\nRun `fn` under exclusive ownership of the run, or reject if refused.\n\n#### Type Parameters\n\n##### T\n\n`T`\n\n#### Parameters\n\n##### input\n\n###### locks\n\n`LockStore`\n\n###### runId\n\n`string`\n\n###### runs\n\n[`RunStore`](RunStore.md)\n\n##### fn\n\n(`claim`) => `Promise`\\<`T`\\>\n\n#### Returns\n\n`Promise`\\<`T`\\>\n\n***\n\n### drive\n\n```ts\ndrive: (input) => AsyncIterable<AGUIEvent>;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:983](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L983)\n\nProduce the run's remaining events. Called only once the claim is held.\n\n#### Parameters\n\n##### input\n\n###### runId\n\n`string`\n\n###### signal\n\n`AbortSignal`\n\n###### threadId\n\n`string`\n\n#### Returns\n\n`AsyncIterable`\\<[`AGUIEvent`](../type-aliases/AGUIEvent.md)\\>\n\n***\n\n### locks\n\n```ts\nlocks: LockStore;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:981](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L981)\n\n***\n\n### logger?\n\n```ts\noptional logger?: InternalLogger;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:1004](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L1004)\n\n***\n\n### pipe\n\n```ts\npipe: (stream, input) => Promise<unknown>;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:998](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L998)\n\nPersist the driven stream to the run's producer-side durability log.\n\n#### Parameters\n\n##### stream\n\n`AsyncIterable`\\<[`AGUIEvent`](../type-aliases/AGUIEvent.md)\\>\n\n##### input\n\n###### runId\n\n`string`\n\n###### signal\n\n`AbortSignal`\n\n###### threadId\n\n`string`\n\n#### Returns\n\n`Promise`\\<`unknown`\\>\n\n***\n\n### request\n\n```ts\nrequest: Request;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:979](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L979)\n\nThe attach request; its run id is read with [resolveResumeRunId](../functions/resolveResumeRunId.md).\n\n***\n\n### runs\n\n```ts\nruns: RunStore;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:980](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L980)\n\n***\n\n### waitUntil?\n\n```ts\noptional waitUntil?: (promise) => void;\n```\n\nDefined in: [packages/ai/src/stream-to-response.ts:1003](https://github.com/TanStack/ai/blob/main/packages/ai/src/stream-to-response.ts#L1003)\n\nPlatform keep-alive (e.g. `ctx.waitUntil`) for the background drive.\n\n#### Parameters\n\n##### promise\n\n`Promise`\\<`unknown`\\>\n\n#### Returns\n\n`void`\n"}
