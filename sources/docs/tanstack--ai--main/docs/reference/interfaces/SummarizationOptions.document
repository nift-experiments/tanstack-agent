ext","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1950","children":[{"type":"text","value":"packages/ai/src/types.ts:1950"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Provider-specific options forwarded by the summarize() activity."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"runid","children":[{"type":"text","value":"runId?"}]},{"type":"code","value":"optional runId?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1959","children":[{"type":"text","value":"packages/ai/src/types.ts:1959"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Run identity forwarded from the summarize() activity. When set, the\nstreaming adapter stamps it onto the emitted "},{"type":"inlineCode","value":"RUN_STARTED"},{"type":"text","value":" (via the wrapped\nchat), so a delivery-durable route keys the run's log by the same id the\nclient rejoins with — making a mid-run reload resumable, like the media\nactivities. Optional and non-breaking: adapters that ignore it just mint\ntheir own."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"style","children":[{"type":"text","value":"style?"}]},{"type":"code","value":"optional style?: \"bullet-points\" | \"paragraph\" | \"concise\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1947","children":[{"type":"text","value":"packages/ai/src/types.ts:1947"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"text","children":[{"type":"text","value":"text"}]},{"type":"code","value":"text: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1945","children":[{"type":"text","value":"packages/ai/src/types.ts:1945"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"threadid","children":[{"type":"text","value":"threadId?"}]},{"type":"code","value":"optional threadId?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1960","children":[{"type":"text","value":"packages/ai/src/types.ts:1960"}]}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tprovideroptions","text":"TProviderOptions","level":3},{"id":"properties","text":"Properties","level":2},{"id":"abortsignal","text":"abortSignal?","level":3},{"id":"focus","text":"focus?","level":3},{"id":"logger","text":"logger","level":3},{"id":"maxlength","text":"maxLength?","level":3},{"id":"model","text":"model","level":3},{"id":"modeloptions","text":"modelOptions?","level":3},{"id":"runid","text":"runId?","level":3},{"id":"style","text":"style?","level":3},{"id":"text","text":"text","level":3},{"id":"threadid","text":"threadId?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/types.ts:1941](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1941)\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:1971](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1971)\n\nEffective abort signal composed by the activity from caller `abortSignal`\nand/or `timeout`. Adapters should forward this to the provider SDK when\nsupported. Request-specific — never store on a global client config.\n\n***\n\n### focus?\n\n```ts\noptional focus?: string[];\n```\n\nDefined in: [packages/ai/src/types.ts:1948](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1948)\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:1965](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1965)\n\nInternal logger threaded from the summarize() entry point. Adapters must\ncall logger.request() before the SDK call and logger.errors() in catch blocks.\n\n***\n\n### maxLength?\n\n```ts\noptional maxLength?: number;\n```\n\nDefined in: [packages/ai/src/types.ts:1946](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1946)\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1944](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1944)\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:1950](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1950)\n\nProvider-specific options forwarded by the summarize() activity.\n\n***\n\n### runId?\n\n```ts\noptional runId?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1959](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1959)\n\nRun identity forwarded from the summarize() activity. When set, the\nstreaming adapter stamps it onto the emitted `RUN_STARTED` (via the wrapped\nchat), so a delivery-durable route keys the run's log by the same id the\nclient rejoins with — making a mid-run reload resumable, like the media\nactivities. Optional and non-breaking: adapters that ignore it just mint\ntheir own.\n\n***\n\n### style?\n\n```ts\noptional style?: \"bullet-points\" | \"paragraph\" | \"concise\";\n```\n\nDefined in: [packages/ai/src/types.ts:1947](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1947)\n\n***\n\n### text\n\n```ts\ntext: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1945](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1945)\n\n***\n\n### threadId?\n\n```ts\noptional threadId?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1960](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1960)\n","originalRawMarkdown":"---\nid: SummarizationOptions\ntitle: SummarizationOptions\n---\n\nDefined in: [packages/ai/src/types.ts:1941](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1941)\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:1971](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1971)\n\nEffective abort signal composed by the activity from caller `abortSignal`\nand/or `timeout`. Adapters should forward this to the provider SDK when\nsupported. Request-specific — never store on a global client config.\n\n***\n\n### focus?\n\n```ts\noptional focus?: string[];\n```\n\nDefined in: [packages/ai/src/types.ts:1948](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1948)\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:1965](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1965)\n\nInternal logger threaded from the summarize() entry point. Adapters must\ncall logger.request() before the SDK call and logger.errors() in catch blocks.\n\n***\n\n### maxLength?\n\n```ts\noptional maxLength?: number;\n```\n\nDefined in: [packages/ai/src/types.ts:1946](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1946)\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1944](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1944)\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:1950](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1950)\n\nProvider-specific options forwarded by the summarize() activity.\n\n***\n\n### runId?\n\n```ts\noptional runId?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1959](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1959)\n\nRun identity forwarded from the summarize() activity. When set, the\nstreaming adapter stamps it onto the emitted `RUN_STARTED` (via the wrapped\nchat), so a delivery-durable route keys the run's log by the same id the\nclient rejoins with — making a mid-run reload resumable, like the media\nactivities. Optional and non-breaking: adapters that ignore it just mint\ntheir own.\n\n***\n\n### style?\n\n```ts\noptional style?: \"bullet-points\" | \"paragraph\" | \"concise\";\n```\n\nDefined in: [packages/ai/src/types.ts:1947](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1947)\n\n***\n\n### text\n\n```ts\ntext: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1945](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1945)\n\n***\n\n### threadId?\n\n```ts\noptional threadId?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:1960](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L1960)\n"}
