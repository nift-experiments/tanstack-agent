alue":"optional format?: \"mp3\" | \"opus\" | \"aac\" | \"flac\" | \"wav\" | \"pcm\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2710","children":[{"type":"text","value":"packages/ai/src/types.ts:2710"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The output audio format"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"logger","children":[{"type":"text","value":"logger"}]},{"type":"code","value":"logger: InternalLogger;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2720","children":[{"type":"text","value":"packages/ai/src/types.ts:2720"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Internal logger threaded from the generateSpeech() entry point. Adapters\nmust call logger.request() before the SDK call and logger.errors() in\ncatch blocks."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"model","children":[{"type":"text","value":"model"}]},{"type":"code","value":"model: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2688","children":[{"type":"text","value":"packages/ai/src/types.ts:2688"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The model to use for TTS generation"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"modeloptions","children":[{"type":"text","value":"modelOptions?"}]},{"type":"code","value":"optional modelOptions?: TProviderOptions;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2714","children":[{"type":"text","value":"packages/ai/src/types.ts:2714"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Model-specific options for TTS generation"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"speed","children":[{"type":"text","value":"speed?"}]},{"type":"code","value":"optional speed?: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2712","children":[{"type":"text","value":"packages/ai/src/types.ts:2712"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The speed of the generated audio (0.25 to 4.0)"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"text","children":[{"type":"text","value":"text"}]},{"type":"code","value":"text: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2694","children":[{"type":"text","value":"packages/ai/src/types.ts:2694"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The text to convert to speech. When the caller passed "},{"type":"inlineCode","value":"turns"},{"type":"text","value":", the\nactivity fills this with the turn texts joined by newlines so adapters\nthat only read "},{"type":"inlineCode","value":"text"},{"type":"text","value":" still receive the full script."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"timestamps","children":[{"type":"text","value":"timestamps?"}]},{"type":"code","value":"optional timestamps?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2706","children":[{"type":"text","value":"packages/ai/src/types.ts:2706"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Ask for "},{"type":"inlineCode","value":"alignment"},{"type":"text","value":" / "},{"type":"inlineCode","value":"segments"},{"type":"text","value":" on the result. Rejected by the activity\nunless the adapter declares "},{"type":"inlineCode","value":"capabilities.timestamps"},{"type":"text","value":", because on some\nproviders this is a different endpoint rather than free metadata."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"turns","children":[{"type":"text","value":"turns?"}]},{"type":"code","value":"optional turns?: TTSTurn[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2700","children":[{"type":"text","value":"packages/ai/src/types.ts:2700"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Multi-voice dialogue turns, when the caller asked for dialogue. Only\nadapters that declare "},{"type":"inlineCode","value":"capabilities.maxSpeakers"},{"type":"text","value":" ever see this — the\nactivity rejects "},{"type":"inlineCode","value":"turns"},{"type":"text","value":" for the rest."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"voice","children":[{"type":"text","value":"voice?"}]},{"type":"code","value":"optional voice?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2708","children":[{"type":"text","value":"packages/ai/src/types.ts:2708"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The voice to use for generation"}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tprovideroptions","text":"TProviderOptions","level":3},{"id":"properties","text":"Properties","level":2},{"id":"abortsignal","text":"abortSignal?","level":3},{"id":"format","text":"format?","level":3},{"id":"logger","text":"logger","level":3},{"id":"model","text":"model","level":3},{"id":"modeloptions","text":"modelOptions?","level":3},{"id":"speed","text":"speed?","level":3},{"id":"text","text":"text","level":3},{"id":"timestamps","text":"timestamps?","level":3},{"id":"turns","text":"turns?","level":3},{"id":"voice","text":"voice?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/types.ts:2686](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2686)\n\nOptions for text-to-speech generation.\nThese are the common options supported across providers.\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `object`\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:2726](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2726)\n\nEffective abort signal composed by the activity from caller `abortSignal`\nand/or `timeout`. Adapters should forward this to the provider SDK when\nsupported. Request-specific — never store on a global client config.\n\n***\n\n### format?\n\n```ts\noptional format?: \"mp3\" | \"opus\" | \"aac\" | \"flac\" | \"wav\" | \"pcm\";\n```\n\nDefined in: [packages/ai/src/types.ts:2710](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2710)\n\nThe output audio format\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:2720](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2720)\n\nInternal logger threaded from the generateSpeech() entry point. Adapters\nmust call logger.request() before the SDK call and logger.errors() in\ncatch blocks.\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2688](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2688)\n\nThe model to use for TTS generation\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:2714](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2714)\n\nModel-specific options for TTS generation\n\n***\n\n### speed?\n\n```ts\noptional speed?: number;\n```\n\nDefined in: [packages/ai/src/types.ts:2712](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2712)\n\nThe speed of the generated audio (0.25 to 4.0)\n\n***\n\n### text\n\n```ts\ntext: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2694](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2694)\n\nThe text to convert to speech. When the caller passed `turns`, the\nactivity fills this with the turn texts joined by newlines so adapters\nthat only read `text` still receive the full script.\n\n***\n\n### timestamps?\n\n```ts\noptional timestamps?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:2706](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2706)\n\nAsk for `alignment` / `segments` on the result. Rejected by the activity\nunless the adapter declares `capabilities.timestamps`, because on some\nproviders this is a different endpoint rather than free metadata.\n\n***\n\n### turns?\n\n```ts\noptional turns?: TTSTurn[];\n```\n\nDefined in: [packages/ai/src/types.ts:2700](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2700)\n\nMulti-voice dialogue turns, when the caller asked for dialogue. Only\nadapters that declare `capabilities.maxSpeakers` ever see this — the\nactivity rejects `turns` for the rest.\n\n***\n\n### voice?\n\n```ts\noptional voice?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2708](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2708)\n\nThe voice to use for generation\n","originalRawMarkdown":"---\nid: TTSOptions\ntitle: TTSOptions\n---\n\nDefined in: [packages/ai/src/types.ts:2686](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2686)\n\nOptions for text-to-speech generation.\nThese are the common options supported across providers.\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `object`\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:2726](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2726)\n\nEffective abort signal composed by the activity from caller `abortSignal`\nand/or `timeout`. Adapters should forward this to the provider SDK when\nsupported. Request-specific — never store on a global client config.\n\n***\n\n### format?\n\n```ts\noptional format?: \"mp3\" | \"opus\" | \"aac\" | \"flac\" | \"wav\" | \"pcm\";\n```\n\nDefined in: [packages/ai/src/types.ts:2710](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2710)\n\nThe output audio format\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:2720](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2720)\n\nInternal logger threaded from the generateSpeech() entry point. Adapters\nmust call logger.request() before the SDK call and logger.errors() in\ncatch blocks.\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2688](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2688)\n\nThe model to use for TTS generation\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:2714](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2714)\n\nModel-specific options for TTS generation\n\n***\n\n### speed?\n\n```ts\noptional speed?: number;\n```\n\nDefined in: [packages/ai/src/types.ts:2712](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2712)\n\nThe speed of the generated audio (0.25 to 4.0)\n\n***\n\n### text\n\n```ts\ntext: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2694](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2694)\n\nThe text to convert to speech. When the caller passed `turns`, the\nactivity fills this with the turn texts joined by newlines so adapters\nthat only read `text` still receive the full script.\n\n***\n\n### timestamps?\n\n```ts\noptional timestamps?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:2706](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2706)\n\nAsk for `alignment` / `segments` on the result. Rejected by the activity\nunless the adapter declares `capabilities.timestamps`, because on some\nproviders this is a different endpoint rather than free metadata.\n\n***\n\n### turns?\n\n```ts\noptional turns?: TTSTurn[];\n```\n\nDefined in: [packages/ai/src/types.ts:2700](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2700)\n\nMulti-voice dialogue turns, when the caller asked for dialogue. Only\nadapters that declare `capabilities.maxSpeakers` ever see this — the\nactivity rejects `turns` for the rest.\n\n***\n\n### voice?\n\n```ts\noptional voice?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2708](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2708)\n\nThe voice to use for generation\n"}
