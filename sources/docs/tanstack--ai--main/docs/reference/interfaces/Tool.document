e":"inlineCode","value":"ProviderTool"}]}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tinput","children":[{"type":"text","value":"TInput"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TInput"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" = "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]}]},{"type":"heading","depth":3,"id":"toutput","children":[{"type":"text","value":"TOutput"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOutput"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" = "},{"type":"link","href":"../type-aliases/SchemaInput.md","children":[{"type":"inlineCode","value":"SchemaInput"}]}]},{"type":"heading","depth":3,"id":"tname","children":[{"type":"text","value":"TName"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TName"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" = "},{"type":"inlineCode","value":"string"}]},{"type":"heading","depth":3,"id":"tcontext","children":[{"type":"text","value":"TContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TContext"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"description","children":[{"type":"text","value":"description"}]},{"type":"code","value":"description: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L863","children":[{"type":"text","value":"packages/ai/src/types.ts:863"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Clear description of what the tool does."}]},{"type":"paragraph","children":[{"type":"text","value":"This is crucial - the model uses this to decide when to call the tool.\nBe specific about what the tool does, what parameters it needs, and what it returns."}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"\"Get the current weather in a given location. Returns temperature, conditions, and forecast.\"","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"execute","children":[{"type":"text","value":"execute?"}]},{"type":"code","value":"optional execute?: ToolExecuteFunction<TInput, TOutput, TContext>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L943","children":[{"type":"text","value":"packages/ai/src/types.ts:943"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional function to execute when the model calls this tool."}]},{"type":"paragraph","children":[{"type":"text","value":"If provided, the SDK will automatically execute the function with the model's arguments\nand feed the result back to the model. This enables autonomous tool use loops."}]},{"type":"paragraph","children":[{"type":"text","value":"Can return any value - will be automatically stringified if needed."}]},{"type":"heading","depth":4,"id":"param","children":[{"type":"text","value":"Param"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"args"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The arguments parsed from the model's tool call (validated against inputSchema)"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"Result to send back to the model (validated against outputSchema if provided)"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"execute: async (args) => {\n  const weather = await fetchWeather(args.location);\n  return weather; // Can return object or string\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"inputschema","children":[{"type":"text","value":"inputSchema?"}]},{"type":"code","value":"optional inputSchema?: TInput;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L903","children":[{"type":"text","value":"packages/ai/src/types.ts:903"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Schema describing the tool's input parameters."}]},{"type":"paragraph","children":[{"type":"text","value":"Can be any Standard JSON Schema compliant schema (Zod, ArkType, Valibot, etc.) or a plain JSON Schema object.\nDefines the structure and types of arguments the tool accepts.\nThe model will generate arguments matching this schema.\nStandard JSON Schema compliant schemas are converted to JSON Schema for LLM providers."}]},{"type":"heading","depth":4,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"https://standardschema.dev/json-schema"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"https://json-schema.org/"}]}]}]},{"type":"heading","depth":4,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Using Zod v4+ schema (natively supports Standard JSON Schema)\nimport { z } from 'zod';\nz.object({\n  location: z.string().describe(\"City name or coordinates\"),\n  unit: z.enum([\"celsius\", \"fahrenheit\"]).optional()\n})","lang":"ts"},{"type":"code","value":"// Using ArkType (natively supports Standard JSON Schema)\nimport { type } from 'arktype';\ntype({\n  location: 'string',\n  unit: \"'celsius' | 'fahrenheit'\"\n})","lang":"ts"},{"type":"code","value":"// Using plain JSON Schema\n{\n  type: 'object',\n  properties: {\n    location: { type: 'string', description: 'City name or coordinates' },\n    unit: { type: 'string', enum: ['celsius', 'fahrenheit'] }\n  },\n  required: ['location']\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"lazy","children":[{"type":"text","value":"lazy?"}]},{"type":"code","value":"optional lazy?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L949","children":[{"type":"text","value":"packages/ai/src/types.ts:949"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If true, this tool is lazy and will only be sent to the LLM after being discovered via the lazy tool discovery mechanism. Works with both chat() (the synthetic discovery tool) and Code Mode (kept out of the system prompt and revealed via discover_tools)."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"metadata","children":[{"type":"text","value":"metadata?"}]},{"type":"code","value":"optional metadata?: Record<string, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L952","children":[{"type":"text","value":"packages/ai/src/types.ts:952"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Additional metadata for adapters or custom extensions"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"name","children":[{"type":"text","value":"name"}]},{"type":"code","value":"name: TName;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L853","children":[{"type":"text","value":"packages/ai/src/types.ts:853"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Unique name of the tool (used by the model to call it)."}]},{"type":"paragraph","children":[{"type":"text","value":"Should be descriptive and follow naming conventions (e.g., snake_case or camelCase).\nMust be unique within the tools array."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"\"get_weather\", \"search_database\", \"sendEmail\"","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"needsapproval","children":[{"type":"text","value":"needsApproval?"}]},{"type":"code","value":"optional needsApproval?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L946","children":[{"type":"text","value":"packages/ai/src/types.ts:946"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If true, tool execution requires user approval before running. Works with both server and client tools."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"outputschema","children":[{"type":"text","value":"outputSchema?"}]},{"type":"code","value":"optional outputSchema?: TOutput;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L924","children":[{"type":"text","value":"packages/ai/src/types.ts:924"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional schema for validating tool output."}]},{"type":"paragraph","children":[{"type":"text","value":"Can be any Standard JSON Schema compliant schema or a plain JSON Schema object.\nIf provided with a Standard Schema compliant schema, tool results will be validated\nagainst this schema before being sent back to the model. This catches bugs in tool\nimplementations and ensures consistent output formatting."}]},{"type":"paragraph","children":[{"type":"text","value":"Note: This is client-side validation only - not sent to LLM providers.\nNote: Plain JSON Schema output validation is not performed at runtime."}]},{"type":"heading","depth":4,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Using Zod\nz.object({\n  temperature: z.number(),\n  conditions: z.string(),\n  forecast: z.array(z.string()).optional()\n})","lang":"ts"}],"headings":[{"id":"see","text":"See","level":2},{"id":"extended-by","text":"Extended by","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tinput","text":"TInput","level":3},{"id":"toutput","text":"TOutput","level":3},{"id":"tname","text":"TName","level":3},{"id":"tcontext","text":"TContext","level":3},{"id":"properties","text":"Properties","level":2},{"id":"description","text":"description","level":3},{"id":"example","text":"Example","level":4},{"id":"execute","text":"execute?","level":3},{"id":"param","text":"Param","level":4},{"id":"returns","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"inputschema","text":"inputSchema?","level":3},{"id":"see-2","text":"See","level":4},{"id":"examples","text":"Examples","level":4},{"id":"lazy","text":"lazy?","level":3},{"id":"metadata","text":"metadata?","level":3},{"id":"name","text":"name","level":3},{"id":"example-3","text":"Example","level":4},{"id":"needsapproval","text":"needsApproval?","level":3},{"id":"outputschema","text":"outputSchema?","level":3},{"id":"example-4","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/types.ts:839](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L839)\n\nTool/Function definition for function calling.\n\nTools allow the model to interact with external systems, APIs, or perform computations.\nThe model will decide when to call tools based on the user's request and the tool descriptions.\n\nTools can use any Standard JSON Schema compliant library (Zod, ArkType, Valibot, etc.)\nor plain JSON Schema objects for runtime validation and type safety.\n\n## See\n\n - https://platform.openai.com/docs/guides/function-calling\n - https://docs.anthropic.com/claude/docs/tool-use\n - https://standardschema.dev/json-schema\n\n## Extended by\n\n- [`ToolDefinitionInstance`](ToolDefinitionInstance.md)\n- [`ServerTool`](ServerTool.md)\n- [`ProviderTool`](ProviderTool.md)\n\n## Type Parameters\n\n### TInput\n\n`TInput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = [`SchemaInput`](../type-aliases/SchemaInput.md)\n\n### TOutput\n\n`TOutput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = [`SchemaInput`](../type-aliases/SchemaInput.md)\n\n### TName\n\n`TName` *extends* `string` = `string`\n\n### TContext\n\n`TContext` = `unknown`\n\n## Properties\n\n### description\n\n```ts\ndescription: string;\n```\n\nDefined in: [packages/ai/src/types.ts:863](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L863)\n\nClear description of what the tool does.\n\nThis is crucial - the model uses this to decide when to call the tool.\nBe specific about what the tool does, what parameters it needs, and what it returns.\n\n#### Example\n\n```ts\n\"Get the current weather in a given location. Returns temperature, conditions, and forecast.\"\n```\n\n***\n\n### execute?\n\n```ts\noptional execute?: ToolExecuteFunction<TInput, TOutput, TContext>;\n```\n\nDefined in: [packages/ai/src/types.ts:943](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L943)\n\nOptional function to execute when the model calls this tool.\n\nIf provided, the SDK will automatically execute the function with the model's arguments\nand feed the result back to the model. This enables autonomous tool use loops.\n\nCan return any value - will be automatically stringified if needed.\n\n#### Param\n\n**args**\n\nThe arguments parsed from the model's tool call (validated against inputSchema)\n\n#### Returns\n\nResult to send back to the model (validated against outputSchema if provided)\n\n#### Example\n\n```ts\nexecute: async (args) => {\n  const weather = await fetchWeather(args.location);\n  return weather; // Can return object or string\n}\n```\n\n***\n\n### inputSchema?\n\n```ts\noptional inputSchema?: TInput;\n```\n\nDefined in: [packages/ai/src/types.ts:903](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L903)\n\nSchema describing the tool's input parameters.\n\nCan be any Standard JSON Schema compliant schema (Zod, ArkType, Valibot, etc.) or a plain JSON Schema object.\nDefines the structure and types of arguments the tool accepts.\nThe model will generate arguments matching this schema.\nStandard JSON Schema compliant schemas are converted to JSON Schema for LLM providers.\n\n#### See\n\n - https://standardschema.dev/json-schema\n - https://json-schema.org/\n\n#### Examples\n\n```ts\n// Using Zod v4+ schema (natively supports Standard JSON Schema)\nimport { z } from 'zod';\nz.object({\n  location: z.string().describe(\"City name or coordinates\"),\n  unit: z.enum([\"celsius\", \"fahrenheit\"]).optional()\n})\n```\n\n```ts\n// Using ArkType (natively supports Standard JSON Schema)\nimport { type } from 'arktype';\ntype({\n  location: 'string',\n  unit: \"'celsius' | 'fahrenheit'\"\n})\n```\n\n```ts\n// Using plain JSON Schema\n{\n  type: 'object',\n  properties: {\n    location: { type: 'string', description: 'City name or coordinates' },\n    unit: { type: 'string', enum: ['celsius', 'fahrenheit'] }\n  },\n  required: ['location']\n}\n```\n\n***\n\n### lazy?\n\n```ts\noptional lazy?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:949](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L949)\n\nIf true, this tool is lazy and will only be sent to the LLM after being discovered via the lazy tool discovery mechanism. Works with both chat() (the synthetic discovery tool) and Code Mode (kept out of the system prompt and revealed via discover_tools).\n\n***\n\n### metadata?\n\n```ts\noptional metadata?: Record<string, any>;\n```\n\nDefined in: [packages/ai/src/types.ts:952](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L952)\n\nAdditional metadata for adapters or custom extensions\n\n***\n\n### name\n\n```ts\nname: TName;\n```\n\nDefined in: [packages/ai/src/types.ts:853](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L853)\n\nUnique name of the tool (used by the model to call it).\n\nShould be descriptive and follow naming conventions (e.g., snake_case or camelCase).\nMust be unique within the tools array.\n\n#### Example\n\n```ts\n\"get_weather\", \"search_database\", \"sendEmail\"\n```\n\n***\n\n### needsApproval?\n\n```ts\noptional needsApproval?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:946](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L946)\n\nIf true, tool execution requires user approval before running. Works with both server and client tools.\n\n***\n\n### outputSchema?\n\n```ts\noptional outputSchema?: TOutput;\n```\n\nDefined in: [packages/ai/src/types.ts:924](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L924)\n\nOptional schema for validating tool output.\n\nCan be any Standard JSON Schema compliant schema or a plain JSON Schema object.\nIf provided with a Standard Schema compliant schema, tool results will be validated\nagainst this schema before being sent back to the model. This catches bugs in tool\nimplementations and ensures consistent output formatting.\n\nNote: This is client-side validation only - not sent to LLM providers.\nNote: Plain JSON Schema output validation is not performed at runtime.\n\n#### Example\n\n```ts\n// Using Zod\nz.object({\n  temperature: z.number(),\n  conditions: z.string(),\n  forecast: z.array(z.string()).optional()\n})\n```\n","originalRawMarkdown":"---\nid: Tool\ntitle: Tool\n---\n\nDefined in: [packages/ai/src/types.ts:839](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L839)\n\nTool/Function definition for function calling.\n\nTools allow the model to interact with external systems, APIs, or perform computations.\nThe model will decide when to call tools based on the user's request and the tool descriptions.\n\nTools can use any Standard JSON Schema compliant library (Zod, ArkType, Valibot, etc.)\nor plain JSON Schema objects for runtime validation and type safety.\n\n## See\n\n - https://platform.openai.com/docs/guides/function-calling\n - https://docs.anthropic.com/claude/docs/tool-use\n - https://standardschema.dev/json-schema\n\n## Extended by\n\n- [`ToolDefinitionInstance`](ToolDefinitionInstance.md)\n- [`ServerTool`](ServerTool.md)\n- [`ProviderTool`](ProviderTool.md)\n\n## Type Parameters\n\n### TInput\n\n`TInput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = [`SchemaInput`](../type-aliases/SchemaInput.md)\n\n### TOutput\n\n`TOutput` *extends* [`SchemaInput`](../type-aliases/SchemaInput.md) \\| `undefined` = [`SchemaInput`](../type-aliases/SchemaInput.md)\n\n### TName\n\n`TName` *extends* `string` = `string`\n\n### TContext\n\n`TContext` = `unknown`\n\n## Properties\n\n### description\n\n```ts\ndescription: string;\n```\n\nDefined in: [packages/ai/src/types.ts:863](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L863)\n\nClear description of what the tool does.\n\nThis is crucial - the model uses this to decide when to call the tool.\nBe specific about what the tool does, what parameters it needs, and what it returns.\n\n#### Example\n\n```ts\n\"Get the current weather in a given location. Returns temperature, conditions, and forecast.\"\n```\n\n***\n\n### execute?\n\n```ts\noptional execute?: ToolExecuteFunction<TInput, TOutput, TContext>;\n```\n\nDefined in: [packages/ai/src/types.ts:943](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L943)\n\nOptional function to execute when the model calls this tool.\n\nIf provided, the SDK will automatically execute the function with the model's arguments\nand feed the result back to the model. This enables autonomous tool use loops.\n\nCan return any value - will be automatically stringified if needed.\n\n#### Param\n\n**args**\n\nThe arguments parsed from the model's tool call (validated against inputSchema)\n\n#### Returns\n\nResult to send back to the model (validated against outputSchema if provided)\n\n#### Example\n\n```ts\nexecute: async (args) => {\n  const weather = await fetchWeather(args.location);\n  return weather; // Can return object or string\n}\n```\n\n***\n\n### inputSchema?\n\n```ts\noptional inputSchema?: TInput;\n```\n\nDefined in: [packages/ai/src/types.ts:903](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L903)\n\nSchema describing the tool's input parameters.\n\nCan be any Standard JSON Schema compliant schema (Zod, ArkType, Valibot, etc.) or a plain JSON Schema object.\nDefines the structure and types of arguments the tool accepts.\nThe model will generate arguments matching this schema.\nStandard JSON Schema compliant schemas are converted to JSON Schema for LLM providers.\n\n#### See\n\n - https://standardschema.dev/json-schema\n - https://json-schema.org/\n\n#### Examples\n\n```ts\n// Using Zod v4+ schema (natively supports Standard JSON Schema)\nimport { z } from 'zod';\nz.object({\n  location: z.string().describe(\"City name or coordinates\"),\n  unit: z.enum([\"celsius\", \"fahrenheit\"]).optional()\n})\n```\n\n```ts\n// Using ArkType (natively supports Standard JSON Schema)\nimport { type } from 'arktype';\ntype({\n  location: 'string',\n  unit: \"'celsius' | 'fahrenheit'\"\n})\n```\n\n```ts\n// Using plain JSON Schema\n{\n  type: 'object',\n  properties: {\n    location: { type: 'string', description: 'City name or coordinates' },\n    unit: { type: 'string', enum: ['celsius', 'fahrenheit'] }\n  },\n  required: ['location']\n}\n```\n\n***\n\n### lazy?\n\n```ts\noptional lazy?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:949](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L949)\n\nIf true, this tool is lazy and will only be sent to the LLM after being discovered via the lazy tool discovery mechanism. Works with both chat() (the synthetic discovery tool) and Code Mode (kept out of the system prompt and revealed via discover_tools).\n\n***\n\n### metadata?\n\n```ts\noptional metadata?: Record<string, any>;\n```\n\nDefined in: [packages/ai/src/types.ts:952](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L952)\n\nAdditional metadata for adapters or custom extensions\n\n***\n\n### name\n\n```ts\nname: TName;\n```\n\nDefined in: [packages/ai/src/types.ts:853](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L853)\n\nUnique name of the tool (used by the model to call it).\n\nShould be descriptive and follow naming conventions (e.g., snake_case or camelCase).\nMust be unique within the tools array.\n\n#### Example\n\n```ts\n\"get_weather\", \"search_database\", \"sendEmail\"\n```\n\n***\n\n### needsApproval?\n\n```ts\noptional needsApproval?: boolean;\n```\n\nDefined in: [packages/ai/src/types.ts:946](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L946)\n\nIf true, tool execution requires user approval before running. Works with both server and client tools.\n\n***\n\n### outputSchema?\n\n```ts\noptional outputSchema?: TOutput;\n```\n\nDefined in: [packages/ai/src/types.ts:924](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L924)\n\nOptional schema for validating tool output.\n\nCan be any Standard JSON Schema compliant schema or a plain JSON Schema object.\nIf provided with a Standard Schema compliant schema, tool results will be validated\nagainst this schema before being sent back to the model. This catches bugs in tool\nimplementations and ensures consistent output formatting.\n\nNote: This is client-side validation only - not sent to LLM providers.\nNote: Plain JSON Schema output validation is not performed at runtime.\n\n#### Example\n\n```ts\n// Using Zod\nz.object({\n  temperature: z.number(),\n  conditions: z.string(),\n  forecast: z.array(z.string()).optional()\n})\n```\n"}
