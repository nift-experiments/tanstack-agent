,"depth":3,"id":"description","children":[{"type":"text","value":"description"}]},{"type":"code","value":"description: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L863","children":[{"type":"text","value":"packages/ai/src/types.ts:863"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Clear description of what the tool does."}]},{"type":"paragraph","children":[{"type":"text","value":"This is crucial - the model uses this to decide when to call the tool.\nBe specific about what the tool does, what parameters it needs, and what it returns."}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"\"Get the current weather in a given location. Returns temperature, conditions, and forecast.\"","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-4","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"ToolDefinitionInstance.md","children":[{"type":"inlineCode","value":"ToolDefinitionInstance"}]},{"type":"text","value":"."},{"type":"link","href":"ToolDefinitionInstance.md#description","children":[{"type":"inlineCode","value":"description"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"execute-2","children":[{"type":"text","value":"execute?"}]},{"type":"code","value":"optional execute?: (args, context?) => \n  | InferSchemaType<TOutput>\n| Promise<InferSchemaType<TOutput>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L943","children":[{"type":"text","value":"packages/ai/src/types.ts:943"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional function to execute when the model calls this tool."}]},{"type":"paragraph","children":[{"type":"text","value":"If provided, the SDK will automatically execute the function with the model's arguments\nand feed the result back to the model. This enables autonomous tool use loops."}]},{"type":"paragraph","children":[{"type":"text","value":"Can return any value - will be automatically stringified if needed."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/InferSchemaType.md","children":[{"type":"inlineCode","value":"InferSchemaType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TInput"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The arguments parsed from the model's tool call (validated against inputSchema)"}]},{"type":"heading","depth":5,"id":"context","children":[{"type":"text","value":"context?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/ToolExecutionContext.md","children":[{"type":"inlineCode","value":"ToolExecutionContext"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"| "},{"type":"link","href":"../type-aliases/InferSchemaType.md","children":[{"type":"inlineCode","value":"InferSchemaType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TOutput"},{"type":"text","value":">\n| "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/InferSchemaType.md","children":[{"type":"inlineCode","value":"InferSchemaType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TOutput"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Result to send back to the model (validated against outputSchema if provided)"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"execute: async (args) => {\n  const weather = await fetchWeather(args.location);\n  return weather; // Can return object or string\n}","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-5","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"ToolDefinitionInstance.md","children":[{"type":"inlineCode","value":"ToolDefinitionInstance"}]},{"type":"text","value":"."},{"type":"link","href":"ToolDefinitionInstance.md#execute","children":[{"type":"inlineCode","value":"execute"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"execution","children":[{"type":"text","value":"execution?"}]},{"type":"code","value":"optional execution?: \"task\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-definition.ts#L163","children":[{"type":"text","value":"packages/ai/src/activities/chat/tools/tool-definition.ts:163"}]}]},{"type":"heading","depth":4,"id":"inherited-from-6","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"ToolDefinitionInstance.md","children":[{"type":"inlineCode","value":"ToolDefinitionInstance"}]},{"type":"text","value":"."},{"type":"link","href":"ToolDefinitionInstance.md#execution","children":[{"type":"inlineCode","value":"execution"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"inputschema","children":[{"type":"text","value":"inputSchema"}]},{"type":"code","value":"inputSchema: TInput;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/activities/chat/tools/tool-definition.ts#L159","children":[{"type":"text","value":"packages/ai/src/activities/chat/tools/tool-definition.ts:159"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Schema describing the tool's input parameters."}]},{"type":"paragraph","children":[{"type":"text","value":"Can be any Standard JSON Schema compliant schema (Zod, ArkType, Valibot, etc.) or a plain JSON Schema object.\nDefines the structure and types of arguments the tool accepts.\nThe model will generate arguments matching this schema.\nStandard JSON Schema compliant schemas are converted to JSON Schema for LLM providers."}]},{"type":"heading","depth":4,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"https://standardschema.dev/json-schema"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"https://json-schema.org/"}]}]}]},{"type":"heading","depth":4,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Using Zod v4+ schema (natively supports Standard JSON Schema)\nimport { z } from 'zod';\nz.object({\n  location: z.string().describe(\"City name or coordinates\"),\n  unit: z.enum([\"celsius\", \"fahrenheit\"]).optional()\n})","lang":"ts"},{"type":"code","value":"// Using ArkType (natively supports Standard JSON Schema)\nimport { type } from 'arktype';\ntype({\n  location: 'string',\n  unit: \"'celsius' | 'fahrenheit'\"\n})","lang":"ts"},{"type":"code","value":"// Using plain JSON Schema\n{\n  type: 'object',\n  properties: {\n    location: { type: 'string', description: 'City name or coordinates' },\n    unit: { type: 'string', enum: ['celsius', 'fahrenheit'] }\n  },\n  required: ['location']\n}","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-7","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"ToolDefinitionInstance.md","children":[{"type":"inlineCode","value":"ToolDefinitionInstance"}]},{"type":"text","value":"."},{"type":"link","href":"ToolDefinitionInstance.md#inputschema","children":[{"type":"inlineCode","value":"inputSchema"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"lazy","children":[{"type":"text","value":"lazy?"}]},{"type":"code","value":"optional lazy?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L949","children":[{"type":"text","value":"packages/ai/src/types.ts:949"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If true, this tool is lazy and will only be sent to the LLM after being discovered via the lazy tool discovery mechanism. Works with both chat() (the synthetic discovery tool) and Code Mode (kept out of the system prompt and revealed via discover_tools)."}]},{"type":"heading","depth":4,"id":"inherited-from-8","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"ToolDefinitionInstance.md","children":[{"type":"inlineCode","value":"ToolDefinitionInstance"}]},{"type":"text","value":"."},{"type":"link","href":"ToolDefinitionInstance.md#lazy","children":[{"type":"inlineCode","value":"lazy"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"metadata","children":[{"type":"text","value":"metadata?"}]},{"type":"code","value":"optional metadata?: Record<string, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L952","children":[{"type":"text","value":"packages/ai/src/types.ts:952"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Additional metadata for adapters or custom extensions"}]},{"type":"heading","depth":4,"id":"inherited-from-9","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"t