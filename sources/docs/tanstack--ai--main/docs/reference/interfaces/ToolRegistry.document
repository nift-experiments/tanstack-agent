ding","depth":5,"id":"tool","children":[{"type":"text","value":"tool"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTool"}]},{"type":"paragraph","children":[{"type":"text","value":"The tool to add"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"get","children":[{"type":"text","value":"get"}]},{"type":"code","value":"get: (name) => TTool | undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L46","children":[{"type":"text","value":"packages/ai/src/tool-registry.ts:46"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Get a tool by name."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"name","children":[{"type":"text","value":"name"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"}]},{"type":"paragraph","children":[{"type":"text","value":"The name of the tool to get"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTool"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"}]},{"type":"paragraph","children":[{"type":"text","value":"The tool if found, undefined otherwise"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"gettools","children":[{"type":"text","value":"getTools"}]},{"type":"code","value":"getTools: () => TTool[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L14","children":[{"type":"text","value":"packages/ai/src/tool-registry.ts:14"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Get all current tools in the registry.\nCalled each agent loop iteration to get the latest tool list."}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTool"},{"type":"text","value":"[]"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"has","children":[{"type":"text","value":"has"}]},{"type":"code","value":"has: (name) => boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L38","children":[{"type":"text","value":"packages/ai/src/tool-registry.ts:38"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Check if a tool exists in the registry."}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"name-2","children":[{"type":"text","value":"name"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"}]},{"type":"paragraph","children":[{"type":"text","value":"The name of the tool to check"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isfrozen","children":[{"type":"text","value":"isFrozen"}]},{"type":"code","value":"readonly isFrozen: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L52","children":[{"type":"text","value":"packages/ai/src/tool-registry.ts:52"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether this registry is frozen (immutable).\nFrozen registries don't allow add/remove operations."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"remove","children":[{"type":"text","value":"remove"}]},{"type":"code","value":"remove: (name) => boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L31","children":[{"type":"text","value":"packages/ai/src/tool-registry.ts:31"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Remove a tool from the registry by name.\nFor frozen registries, this always returns false."}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"name-3","children":[{"type":"text","value":"name"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"}]},{"type":"paragraph","children":[{"type":"text","value":"The name of the tool to remove"}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"paragraph","children":[{"type":"text","value":"true if the tool was removed, false if not found or frozen"}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"ttool","text":"TTool","level":3},{"id":"properties","text":"Properties","level":2},{"id":"add","text":"add","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"tool","text":"tool","level":5},{"id":"returns","text":"Returns","level":4},{"id":"get","text":"get","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"name","text":"name","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"gettools","text":"getTools","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"has","text":"has","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"name-2","text":"name","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"isfrozen","text":"isFrozen","level":3},{"id":"remove","text":"remove","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"name-3","text":"name","level":5},{"id":"returns-5","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/tool-registry.ts:9](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L9)\n\nA registry that holds tools and allows dynamic tool management.\n\nThe registry can be either mutable (allowing additions/removals during execution)\nor frozen (static tool list, for backward compatibility with tools arrays).\n\n## Type Parameters\n\n### TTool\n\n`TTool` *extends* [`AnyTool`](../type-aliases/AnyTool.md) = [`AnyTool`](../type-aliases/AnyTool.md)\n\n## Properties\n\n### add\n\n```ts\nadd: (tool) => void;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:22](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L22)\n\nAdd a tool to the registry dynamically.\nFor frozen registries, this is a no-op.\n\n#### Parameters\n\n##### tool\n\n`TTool`\n\nThe tool to add\n\n#### Returns\n\n`void`\n\n***\n\n### get\n\n```ts\nget: (name) => TTool | undefined;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:46](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L46)\n\nGet a tool by name.\n\n#### Parameters\n\n##### name\n\n`string`\n\nThe name of the tool to get\n\n#### Returns\n\n`TTool` \\| `undefined`\n\nThe tool if found, undefined otherwise\n\n***\n\n### getTools\n\n```ts\ngetTools: () => TTool[];\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:14](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L14)\n\nGet all current tools in the registry.\nCalled each agent loop iteration to get the latest tool list.\n\n#### Returns\n\n`TTool`[]\n\n***\n\n### has\n\n```ts\nhas: (name) => boolean;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:38](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L38)\n\nCheck if a tool exists in the registry.\n\n#### Parameters\n\n##### name\n\n`string`\n\nThe name of the tool to check\n\n#### Returns\n\n`boolean`\n\n***\n\n### isFrozen\n\n```ts\nreadonly isFrozen: boolean;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:52](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L52)\n\nWhether this registry is frozen (immutable).\nFrozen registries don't allow add/remove operations.\n\n***\n\n### remove\n\n```ts\nremove: (name) => boolean;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:31](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L31)\n\nRemove a tool from the registry by name.\nFor frozen registries, this always returns false.\n\n#### Parameters\n\n##### name\n\n`string`\n\nThe name of the tool to remove\n\n#### Returns\n\n`boolean`\n\ntrue if the tool was removed, false if not found or frozen\n","originalRawMarkdown":"---\nid: ToolRegistry\ntitle: ToolRegistry\n---\n\nDefined in: [packages/ai/src/tool-registry.ts:9](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L9)\n\nA registry that holds tools and allows dynamic tool management.\n\nThe registry can be either mutable (allowing additions/removals during execution)\nor frozen (static tool list, for backward compatibility with tools arrays).\n\n## Type Parameters\n\n### TTool\n\n`TTool` *extends* [`AnyTool`](../type-aliases/AnyTool.md) = [`AnyTool`](../type-aliases/AnyTool.md)\n\n## Properties\n\n### add\n\n```ts\nadd: (tool) => void;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:22](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L22)\n\nAdd a tool to the registry dynamically.\nFor frozen registries, this is a no-op.\n\n#### Parameters\n\n##### tool\n\n`TTool`\n\nThe tool to add\n\n#### Returns\n\n`void`\n\n***\n\n### get\n\n```ts\nget: (name) => TTool | undefined;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:46](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L46)\n\nGet a tool by name.\n\n#### Parameters\n\n##### name\n\n`string`\n\nThe name of the tool to get\n\n#### Returns\n\n`TTool` \\| `undefined`\n\nThe tool if found, undefined otherwise\n\n***\n\n### getTools\n\n```ts\ngetTools: () => TTool[];\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:14](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L14)\n\nGet all current tools in the registry.\nCalled each agent loop iteration to get the latest tool list.\n\n#### Returns\n\n`TTool`[]\n\n***\n\n### has\n\n```ts\nhas: (name) => boolean;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:38](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L38)\n\nCheck if a tool exists in the registry.\n\n#### Parameters\n\n##### name\n\n`string`\n\nThe name of the tool to check\n\n#### Returns\n\n`boolean`\n\n***\n\n### isFrozen\n\n```ts\nreadonly isFrozen: boolean;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:52](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L52)\n\nWhether this registry is frozen (immutable).\nFrozen registries don't allow add/remove operations.\n\n***\n\n### remove\n\n```ts\nremove: (name) => boolean;\n```\n\nDefined in: [packages/ai/src/tool-registry.ts:31](https://github.com/TanStack/ai/blob/main/packages/ai/src/tool-registry.ts#L31)\n\nRemove a tool from the registry by name.\nFor frozen registries, this always returns false.\n\n#### Parameters\n\n##### name\n\n`string`\n\nThe name of the tool to remove\n\n#### Returns\n\n`boolean`\n\ntrue if the tool was removed, false if not found or frozen\n"}
