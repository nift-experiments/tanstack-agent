5"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"metadata","children":[{"type":"text","value":"metadata?"}]},{"type":"code","value":"optional metadata?: Record<string, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L695","children":[{"type":"text","value":"packages/ai/src/types.ts:695"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional AG-UI metadata bag. TanStack writes the "},{"type":"inlineCode","value":"tanstack"},{"type":"text","value":" key.\nUser keys stay at the top."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"name","children":[{"type":"text","value":"name?"}]},{"type":"code","value":"optional name?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L690","children":[{"type":"text","value":"packages/ai/src/types.ts:690"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional AG-UI sender name. Converters preserve it across wire and persist."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"parts","children":[{"type":"text","value":"parts"}]},{"type":"code","value":"parts: MessagePart<TData>[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L687","children":[{"type":"text","value":"packages/ai/src/types.ts:687"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"role","children":[{"type":"text","value":"role"}]},{"type":"code","value":"role: \"assistant\" | \"user\" | \"activity\" | \"system\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L686","children":[{"type":"text","value":"packages/ai/src/types.ts:686"}]}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"createdat","text":"createdAt?","level":3},{"id":"id","text":"id","level":3},{"id":"metadata","text":"metadata?","level":3},{"id":"name","text":"name?","level":3},{"id":"parts","text":"parts","level":3},{"id":"role","text":"role","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/types.ts:684](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L684)\n\nUIMessage - Domain-specific message format optimized for building chat UIs\nContains parts that can be text, tool calls, or tool results. Generic over\nthe structured-output data type so `useChat({ outputSchema })`'s schema\nnarrows `parts.find(p => p.type === 'structured-output').data` on the\nconsumer side without manual casts.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n## Properties\n\n### createdAt?\n\n```ts\noptional createdAt?: Date;\n```\n\nDefined in: [packages/ai/src/types.ts:688](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L688)\n\n***\n\n### id\n\n```ts\nid: string;\n```\n\nDefined in: [packages/ai/src/types.ts:685](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L685)\n\n***\n\n### metadata?\n\n```ts\noptional metadata?: Record<string, any>;\n```\n\nDefined in: [packages/ai/src/types.ts:695](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L695)\n\nOptional AG-UI metadata bag. TanStack writes the `tanstack` key.\nUser keys stay at the top.\n\n***\n\n### name?\n\n```ts\noptional name?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:690](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L690)\n\nOptional AG-UI sender name. Converters preserve it across wire and persist.\n\n***\n\n### parts\n\n```ts\nparts: MessagePart<TData>[];\n```\n\nDefined in: [packages/ai/src/types.ts:687](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L687)\n\n***\n\n### role\n\n```ts\nrole: \"assistant\" | \"user\" | \"activity\" | \"system\";\n```\n\nDefined in: [packages/ai/src/types.ts:686](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L686)\n","originalRawMarkdown":"---\nid: UIMessage\ntitle: UIMessage\n---\n\nDefined in: [packages/ai/src/types.ts:684](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L684)\n\nUIMessage - Domain-specific message format optimized for building chat UIs\nContains parts that can be text, tool calls, or tool results. Generic over\nthe structured-output data type so `useChat({ outputSchema })`'s schema\nnarrows `parts.find(p => p.type === 'structured-output').data` on the\nconsumer side without manual casts.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n## Properties\n\n### createdAt?\n\n```ts\noptional createdAt?: Date;\n```\n\nDefined in: [packages/ai/src/types.ts:688](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L688)\n\n***\n\n### id\n\n```ts\nid: string;\n```\n\nDefined in: [packages/ai/src/types.ts:685](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L685)\n\n***\n\n### metadata?\n\n```ts\noptional metadata?: Record<string, any>;\n```\n\nDefined in: [packages/ai/src/types.ts:695](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L695)\n\nOptional AG-UI metadata bag. TanStack writes the `tanstack` key.\nUser keys stay at the top.\n\n***\n\n### name?\n\n```ts\noptional name?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:690](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L690)\n\nOptional AG-UI sender name. Converters preserve it across wire and persist.\n\n***\n\n### parts\n\n```ts\nparts: MessagePart<TData>[];\n```\n\nDefined in: [packages/ai/src/types.ts:687](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L687)\n\n***\n\n### role\n\n```ts\nrole: \"assistant\" | \"user\" | \"activity\" | \"system\";\n```\n\nDefined in: [packages/ai/src/types.ts:686](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L686)\n"}
