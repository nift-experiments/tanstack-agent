ons"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TProviderOptions"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"},{"type":"text","value":" = "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"abortsignal","children":[{"type":"text","value":"abortSignal?"}]},{"type":"code","value":"optional abortSignal?: AbortSignal;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2861","children":[{"type":"text","value":"packages/ai/src/types.ts:2861"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Effective abort signal composed by the activity from caller "},{"type":"inlineCode","value":"abortSignal"},{"type":"text","value":"\nand/or "},{"type":"inlineCode","value":"timeout"},{"type":"text","value":". Adapters should forward this to the provider SDK when\nsupported. Request-specific - never store on a global client config."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"description","children":[{"type":"text","value":"description?"}]},{"type":"code","value":"optional description?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2847","children":[{"type":"text","value":"packages/ai/src/types.ts:2847"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Human-readable description stored alongside the voice"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"logger","children":[{"type":"text","value":"logger"}]},{"type":"code","value":"logger: InternalLogger;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2855","children":[{"type":"text","value":"packages/ai/src/types.ts:2855"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Internal logger threaded from the generateVoice() entry point. Adapters\nmust call logger.request() before the SDK call and logger.errors() in\ncatch blocks."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"model","children":[{"type":"text","value":"model"}]},{"type":"code","value":"model: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2830","children":[{"type":"text","value":"packages/ai/src/types.ts:2830"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The model to use for voice creation"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"modeloptions","children":[{"type":"text","value":"modelOptions?"}]},{"type":"code","value":"optional modelOptions?: TProviderOptions;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2849","children":[{"type":"text","value":"packages/ai/src/types.ts:2849"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Model-specific options for voice creation"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"name","children":[{"type":"text","value":"name?"}]},{"type":"code","value":"optional name?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2845","children":[{"type":"text","value":"packages/ai/src/types.ts:2845"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Name to store the voice under in the provider's voice library. Providers\ndiffer on what this implies — ElevenLabs only persists a designed voice\nwhen a name is given. Read "},{"type":"link","href":"GeneratedVoice.md#saved","children":[{"type":"text","value":"GeneratedVoice.saved"}]},{"type":"text","value":" to find out what\nactually happened."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"prompt","children":[{"type":"text","value":"prompt?"}]},{"type":"code","value":"optional prompt?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2832","children":[{"type":"text","value":"packages/ai/src/types.ts:2832"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Text description of the voice to create, for design-capable models"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"referenceaudio","children":[{"type":"text","value":"referenceAudio?"}]},{"type":"code","value":"optional referenceAudio?: string | ArrayBuffer | File | Blob;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2838","children":[{"type":"text","value":"packages/ai/src/types.ts:2838"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Reference audio of the speaker to clone - base64 string, base64 data URL,\nFile, Blob, or ArrayBuffer. For clone-capable models. Remote URLs are not\naccepted; read the file and pass the bytes."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tprovideroptions","text":"TProviderOptions","level":3},{"id":"properties","text":"Properties","level":2},{"id":"abortsignal","text":"abortSignal?","level":3},{"id":"description","text":"description?","level":3},{"id":"logger","text":"logger","level":3},{"id":"model","text":"model","level":3},{"id":"modeloptions","text":"modelOptions?","level":3},{"id":"name","text":"name?","level":3},{"id":"prompt","text":"prompt?","level":3},{"id":"referenceaudio","text":"referenceAudio?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/types.ts:2826](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2826)\n\nOptions for creating a voice.\n\nProviders create voices in one of two ways, and some support both:\n- **design** — synthesize a brand new voice from a text [prompt](#prompt).\n- **clone** — derive a voice from [referenceAudio](#referenceaudio) of a real speaker.\n\nAt least one of `prompt` / `referenceAudio` is required; which ones an\nadapter accepts depends on the model. An adapter may require both — the\nonly adapter today, `elevenlabsVoiceDesign`, always needs `prompt` and\ntakes `referenceAudio` as an additional design reference.\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `object`\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:2861](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2861)\n\nEffective abort signal composed by the activity from caller `abortSignal`\nand/or `timeout`. Adapters should forward this to the provider SDK when\nsupported. Request-specific - never store on a global client config.\n\n***\n\n### description?\n\n```ts\noptional description?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2847](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2847)\n\nHuman-readable description stored alongside the voice\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:2855](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2855)\n\nInternal logger threaded from the generateVoice() entry point. Adapters\nmust call logger.request() before the SDK call and logger.errors() in\ncatch blocks.\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2830](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2830)\n\nThe model to use for voice creation\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:2849](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2849)\n\nModel-specific options for voice creation\n\n***\n\n### name?\n\n```ts\noptional name?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2845](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2845)\n\nName to store the voice under in the provider's voice library. Providers\ndiffer on what this implies — ElevenLabs only persists a designed voice\nwhen a name is given. Read [GeneratedVoice.saved](GeneratedVoice.md#saved) to find out what\nactually happened.\n\n***\n\n### prompt?\n\n```ts\noptional prompt?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2832](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2832)\n\nText description of the voice to create, for design-capable models\n\n***\n\n### referenceAudio?\n\n```ts\noptional referenceAudio?: string | ArrayBuffer | File | Blob;\n```\n\nDefined in: [packages/ai/src/types.ts:2838](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2838)\n\nReference audio of the speaker to clone - base64 string, base64 data URL,\nFile, Blob, or ArrayBuffer. For clone-capable models. Remote URLs are not\naccepted; read the file and pass the bytes.\n","originalRawMarkdown":"---\nid: VoiceGenerationOptions\ntitle: VoiceGenerationOptions\n---\n\nDefined in: [packages/ai/src/types.ts:2826](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2826)\n\nOptions for creating a voice.\n\nProviders create voices in one of two ways, and some support both:\n- **design** — synthesize a brand new voice from a text [prompt](#prompt).\n- **clone** — derive a voice from [referenceAudio](#referenceaudio) of a real speaker.\n\nAt least one of `prompt` / `referenceAudio` is required; which ones an\nadapter accepts depends on the model. An adapter may require both — the\nonly adapter today, `elevenlabsVoiceDesign`, always needs `prompt` and\ntakes `referenceAudio` as an additional design reference.\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `object`\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:2861](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2861)\n\nEffective abort signal composed by the activity from caller `abortSignal`\nand/or `timeout`. Adapters should forward this to the provider SDK when\nsupported. Request-specific - never store on a global client config.\n\n***\n\n### description?\n\n```ts\noptional description?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2847](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2847)\n\nHuman-readable description stored alongside the voice\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:2855](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2855)\n\nInternal logger threaded from the generateVoice() entry point. Adapters\nmust call logger.request() before the SDK call and logger.errors() in\ncatch blocks.\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2830](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2830)\n\nThe model to use for voice creation\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:2849](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2849)\n\nModel-specific options for voice creation\n\n***\n\n### name?\n\n```ts\noptional name?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2845](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2845)\n\nName to store the voice under in the provider's voice library. Providers\ndiffer on what this implies — ElevenLabs only persists a designed voice\nwhen a name is given. Read [GeneratedVoice.saved](GeneratedVoice.md#saved) to find out what\nactually happened.\n\n***\n\n### prompt?\n\n```ts\noptional prompt?: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2832](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2832)\n\nText description of the voice to create, for design-capable models\n\n***\n\n### referenceAudio?\n\n```ts\noptional referenceAudio?: string | ArrayBuffer | File | Blob;\n```\n\nDefined in: [packages/ai/src/types.ts:2838](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2838)\n\nReference audio of the speaker to clone - base64 string, base64 data URL,\nFile, Blob, or ArrayBuffer. For clone-capable models. Remote URLs are not\naccepted; read the file and pass the bytes.\n"}
