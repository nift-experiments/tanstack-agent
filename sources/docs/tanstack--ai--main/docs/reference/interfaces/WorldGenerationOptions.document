value":"timeout"},{"type":"text","value":". Adapters should forward this to the provider SDK when\nsupported. Request-specific — never store on a global client config."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"logger","children":[{"type":"text","value":"logger"}]},{"type":"code","value":"logger: InternalLogger;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2481","children":[{"type":"text","value":"packages/ai/src/types.ts:2481"}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"Experimental"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Internal logger threaded from the generateWorld() entry point. Adapters\nmust call logger.request() before the SDK call and logger.errors() in\ncatch blocks."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"model","children":[{"type":"text","value":"model"}]},{"type":"code","value":"model: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2466","children":[{"type":"text","value":"packages/ai/src/types.ts:2466"}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"Experimental"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The model to use for world generation"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"modeloptions","children":[{"type":"text","value":"modelOptions?"}]},{"type":"code","value":"optional modelOptions?: TProviderOptions;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2475","children":[{"type":"text","value":"packages/ai/src/types.ts:2475"}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"Experimental"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Provider-specific options. Live adapters (Reactor) use mint fields here.\nJob adapters (World Labs) use image/video inputs, "},{"type":"inlineCode","value":"wait"},{"type":"text","value":", and poll.\nReactor resolution/seed/audio are browser "},{"type":"inlineCode","value":"sendCommand"},{"type":"text","value":" fields, not\ntoken-mint fields."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"prompt","children":[{"type":"text","value":"prompt"}]},{"type":"code","value":"prompt: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2468","children":[{"type":"text","value":"packages/ai/src/types.ts:2468"}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"Experimental"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Natural-language description of the world or scene"}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tprovideroptions","text":"TProviderOptions","level":3},{"id":"properties","text":"Properties","level":2},{"id":"abortsignal","text":"abortSignal?","level":3},{"id":"logger","text":"logger","level":3},{"id":"model","text":"model","level":3},{"id":"modeloptions","text":"modelOptions?","level":3},{"id":"prompt","text":"prompt","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ai/src/types.ts:2462](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2462)\n\n**`Experimental`**\n\nOptions for world generation (live session or finished job).\n\n World generation is an experimental feature and may change.\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `object`\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:2487](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2487)\n\n**`Experimental`**\n\nEffective abort signal composed by the activity from caller `abortSignal`\nand/or `timeout`. Adapters should forward this to the provider SDK when\nsupported. Request-specific — never store on a global client config.\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:2481](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2481)\n\n**`Experimental`**\n\nInternal logger threaded from the generateWorld() entry point. Adapters\nmust call logger.request() before the SDK call and logger.errors() in\ncatch blocks.\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2466](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2466)\n\n**`Experimental`**\n\nThe model to use for world generation\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:2475](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2475)\n\n**`Experimental`**\n\nProvider-specific options. Live adapters (Reactor) use mint fields here.\nJob adapters (World Labs) use image/video inputs, `wait`, and poll.\nReactor resolution/seed/audio are browser `sendCommand` fields, not\ntoken-mint fields.\n\n***\n\n### prompt\n\n```ts\nprompt: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2468](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2468)\n\n**`Experimental`**\n\nNatural-language description of the world or scene\n","originalRawMarkdown":"---\nid: WorldGenerationOptions\ntitle: WorldGenerationOptions\n---\n\nDefined in: [packages/ai/src/types.ts:2462](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2462)\n\n**`Experimental`**\n\nOptions for world generation (live session or finished job).\n\n World generation is an experimental feature and may change.\n\n## Type Parameters\n\n### TProviderOptions\n\n`TProviderOptions` *extends* `object` = `object`\n\n## Properties\n\n### abortSignal?\n\n```ts\noptional abortSignal?: AbortSignal;\n```\n\nDefined in: [packages/ai/src/types.ts:2487](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2487)\n\n**`Experimental`**\n\nEffective abort signal composed by the activity from caller `abortSignal`\nand/or `timeout`. Adapters should forward this to the provider SDK when\nsupported. Request-specific — never store on a global client config.\n\n***\n\n### logger\n\n```ts\nlogger: InternalLogger;\n```\n\nDefined in: [packages/ai/src/types.ts:2481](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2481)\n\n**`Experimental`**\n\nInternal logger threaded from the generateWorld() entry point. Adapters\nmust call logger.request() before the SDK call and logger.errors() in\ncatch blocks.\n\n***\n\n### model\n\n```ts\nmodel: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2466](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2466)\n\n**`Experimental`**\n\nThe model to use for world generation\n\n***\n\n### modelOptions?\n\n```ts\noptional modelOptions?: TProviderOptions;\n```\n\nDefined in: [packages/ai/src/types.ts:2475](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2475)\n\n**`Experimental`**\n\nProvider-specific options. Live adapters (Reactor) use mint fields here.\nJob adapters (World Labs) use image/video inputs, `wait`, and poll.\nReactor resolution/seed/audio are browser `sendCommand` fields, not\ntoken-mint fields.\n\n***\n\n### prompt\n\n```ts\nprompt: string;\n```\n\nDefined in: [packages/ai/src/types.ts:2468](https://github.com/TanStack/ai/blob/main/packages/ai/src/types.ts#L2468)\n\n**`Experimental`**\n\nNatural-language description of the world or scene\n"}
