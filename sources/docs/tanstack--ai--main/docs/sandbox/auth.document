{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Your laptop already has "},{"type":"inlineCode","value":"grok login"},{"type":"text","value":", "},{"type":"inlineCode","value":"claude login"},{"type":"text","value":", or "},{"type":"inlineCode","value":"codex login"},{"type":"text","value":". A GitHub\nrunner has no browser login. It only has an API key. Both can use\n"},{"type":"inlineCode","value":"localProcessSandbox()"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"authMode"},{"type":"text","value":" on the adapter. The sandbox type does not pick the credentials.\nThe default is "},{"type":"inlineCode","value":"'api-key'"},{"type":"text","value":". Most harnesses run in Docker or a cloud sandbox.\nThose have no host CLI login."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"'api-key'"},{"type":"text","value":" (default): inject the key and use it."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"'host'"},{"type":"text","value":": use the CLI login on the machine. Do not inject an API key into\nthat process."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Pass "},{"type":"inlineCode","value":"authMode"},{"type":"text","value":" in one of two places:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Adapter factory: "},{"type":"inlineCode","value":"grokBuildText('composer-2.5', { authMode: 'host' })"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"One call: "},{"type":"inlineCode","value":"chat({ modelOptions: { authMode: 'host' } })"}]}]}]},{"type":"heading","depth":2,"id":"host-login","children":[{"type":"text","value":"Host login"}]},{"type":"paragraph","children":[{"type":"text","value":"Use this when the machine already ran "},{"type":"inlineCode","value":"grok login"},{"type":"text","value":", "},{"type":"inlineCode","value":"claude login"},{"type":"text","value":", or\n"},{"type":"inlineCode","value":"codex login"},{"type":"text","value":"."}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { grokBuildText } from '@tanstack/ai-grok-build'\nimport { defineSandbox, defineWorkspace, withSandbox } from '@tanstack/ai-sandbox'\nimport { localProcessSandbox } from '@tanstack/ai-sandbox-local-process'\nimport { messages, threadId } from './chat-context'\n\nconst sandbox = defineSandbox({\n  id: 'repo-agent',\n  provider: localProcessSandbox({\n    scrubEnv: ['XAI_API_KEY', 'GROK_API_KEY'],\n  }),\n  workspace: defineWorkspace({\n    source: { type: 'local', path: '/abs/path/to/repo' },\n  }),\n})\n\nconst stream = chat({\n  threadId,\n  adapter: grokBuildText('composer-2.5', { authMode: 'host' }),\n  messages,\n  middleware: [withSandbox(sandbox)],\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"scrubEnv"},{"type":"text","value":" removes keys the host process inherited. If the CLI sees\n"},{"type":"inlineCode","value":"XAI_API_KEY"},{"type":"text","value":", it can prefer that key over your login."}]},{"type":"heading","depth":2,"id":"api-key","children":[{"type":"text","value":"API key"}]},{"type":"paragraph","children":[{"type":"text","value":"This is the default. Use it on a runner, in Docker, or on any machine that\nhas no CLI login. You can omit "},{"type":"inlineCode","value":"authMode"},{"type":"text","value":"."}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { grokBuildText } from '@tanstack/ai-grok-build'\nimport {\n  createSecrets,\n  defineSandbox,\n  defineWorkspace,\n  githubRepo,\n  withSandbox,\n} from '@tanstack/ai-sandbox'\nimport { dockerSandbox } from '@tanstack/ai-sandbox-docker'\nimport { messages, threadId } from './chat-context'\n\nconst sandbox = defineSandbox({\n  id: 'repo-agent',\n  provider: dockerSandbox({ image: 'node:22' }),\n  workspace: defineWorkspace({\n    source: githubRepo({ repo: 'owner/app' }),\n    secrets: createSecrets({\n      XAI_API_KEY: process.env.XAI_API_KEY ?? '',\n    }),\n  }),\n})\n\nconst stream = chat({\n  threadId,\n  adapter: grokBuildText('composer-2.5'),\n  messages,\n  middleware: [withSandbox(sandbox)],\n})","lang":"ts"},{"type":"heading","depth":2,"id":"each-harness","children":[{"type":"text","value":"Each harness"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Adapter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"authMode: 'api-key'"},{"type":"text","value":" (default)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"authMode: 'host'"}]}],"rows":[[{"type":"tableCell","children":[{"type":"link","href":"../adapters/grok-build","children":[{"type":"text","value":"Grok Build"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"XAI_API_KEY"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"grok login"}]}],[{"type":"tableCell","children":[{"type":"link","href":"../adapters/claude-code","children":[{"type":"text","value":"Claude Code"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ANTHROPIC_API_KEY"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"claude login"}]}],[{"type":"tableCell","children":[{"type":"link","href":"../adapters/codex","children":[{"type":"text","value":"Codex"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"CODEX_API_KEY"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"codex login"}]}],[{"type":"tableCell","children":[{"type":"link","href":"../adapters/acp-compatible","children":[{"type":"text","value":"ACP-Compatible"}]}]},{"type":"tableCell","children":[{"type":"text","value":"set "},{"type":"inlineCode","value":"authMethodId"},{"type":"text","value":" (for Grok, "},{"type":"inlineCode","value":"xai.api_key"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"text","value":"skip ACP "},{"type":"inlineCode","value":"authenticate"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"OpenCode still reads "},{"type":"inlineCode","value":"OPENAI_API_KEY"},{"type":"text","value":" from the process env. It has no "},{"type":"inlineCode","value":"authMode"},{"type":"text","value":"\nflag."}]},{"type":"heading","depth":2,"id":"client-and-server","children":[{"type":"text","value":"Client and server"}]},{"type":"paragraph","children":[{"type":"text","value":"The React chat example exposes the same choice on "},{"type":"inlineCode","value":"/repo-report"},{"type":"text","value":". The client\nsends "},{"type":"inlineCode","value":"authMode"},{"type":"text","value":". The server builds the adapter with that value."}]},{"type":"paragraph","children":[{"type":"text","value":"Client:"}]},{"type":"code","value":"import { fetchServerSentEvents, useChat } from '@tanstack/ai-react'\n\nfunction Report() {\n  const { sendMessage } = useChat({\n    connection: fetchServerSentEvents('/api/sandbox-repo-report'),\n    forwardedProps: { authMode: 'api-key' },\n  })\n\n  return (\n    <button type=\"button\" onClick={() => sendMessage('Report on this repo')}>\n      Run\n    </button>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Server:"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { grokBuildText } from '@tanstack/ai-grok-build'\nimport { withSandbox } from '@tanstack/ai-sandbox'\nimport { sandbox } from './sandbox'\n\nexport async function POST(request: Request) {\n  const body: unknown = await request.json()\n  const forwarded =\n    typeof body === 'object' &&\n    body !== null &&\n    'forwardedProps' in body &&\n    typeof body.forwardedProps === 'object' &&\n    body.forwardedProps !== null\n      ? body.forwardedProps\n      : {}\n  const authMode =\n    'authMode' in forwarded && forwarded.authMode === 'host'\n      ? 'host'\n      : 'api-key'\n\n  const stream = chat({\n    adapter: grokBuildText('composer-2.5', { authMode }),\n    messages: [{ role: 'user', content: 'Report on this repo' }],\n    stream: true,\n    middleware: [withSandbox(sandbox)],\n  })\n\n  return toServerSentEventsResponse(stream)\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"./harnesses","children":[{"type":"text","value":"Harnesses"}]},{"type":"text","value":" for which adapter to pick, and "},{"type":"link","href":"./providers","children":[{"type":"text","value":"Providers"}]},{"type":"text","value":"\nfor "},{"type":"inlineCode","value":"scrubEnv"},{"type":"text","value":" on local-process."}]}],"headings":[{"id":"host-login","text":"Host login","level":2},{"id":"api-key","text":"API key","level":2},{"id":"each-harness","text":"Each harness","level":2},{"id":"client-and-server","text":"Client and server","level":2}]},"frameworks":[],"downloadMarkdown":"\nYour laptop already has `grok login`, `claude login`, or `codex login`. A GitHub\nrunner has no browser login. It only has an API key. Both can use\n`localProcessSandbox()`.\n\nSet `authMode` on the adapter. The sandbox type does not pick the credentials.\nThe default is `'api-key'`. Most harnesses run in Docker or a cloud sandbox.\nThose have no host CLI login.\n\n- `'api-key'` (default): inject the key and use it.\n- `'host'`: use the CLI login on the machine. Do not inject an API key into\n  that process.\n\nPass `authMode` in one of two places:\n\n- Adapter factory: `grokBuildText('composer-2.5', { authMode: 'host' })`\n- One call: `chat({ modelOptions: { authMode: 'host' } })`\n\n## Host login\n\nUse this when the machine already ran `grok login`, `claude login`, or\n`codex login`.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { grokBuildText } from '@tanstack/ai-grok-build'\nimport { defineSandbox, defineWorkspace, withSandbox } from '@tanstack/ai-sandbox'\nimport { localProcessSandbox } from '@tanstack/ai-sandbox-local-process'\nimport { messages, threadId } from './chat-context'\n\nconst sandbox = defineSandbox({\n  id: 'repo-agent',\n  provider: localProcessSandbox({\n    scrubEnv: ['XAI_API_KEY', 'GROK_API_KEY'],\n  }),\n  workspace: defineWorkspace({\n    source: { type: 'local', path: '/abs/path/to/repo' },\n  }),\n})\n\nconst stream = chat({\n  threadId,\n  adapter: grokBuildText('composer-2.5', { authMode: 'host' }),\n  messages,\n  middleware: [withSandbox(sandbox)],\n})\n```\n\n`scrubEnv` removes keys the host process inherited. If the CLI sees\n`XAI_API_KEY`, it can prefer that key over your login.\n\n## API key\n\nThis is the default. Use it on a runner, in Docker, or on any machine that\nhas no CLI login. You can omit `authMode`.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { grokBuildText } from '@tanstack/ai-grok-build'\nimport {\n  createSecrets,\n  defineSandbox,\n  defineWorkspace,\n  githubRepo,\n  withSandbox,\n} from '@tanstack/ai-sandbox'\nimport { dockerSandbox } from '@tanstack/ai-sandbox-docker'\nimport { messages, threadId } from './chat-context'\n\nconst sandbox = defineSandbox({\n  id: 'repo-agent',\n  provider: dockerSandbox({ image: 'node:22' }),\n  workspace: defineWorkspace({\n    source: githubRepo({ repo: 'owner/app' }),\n    secrets: createSecrets({\n      XAI_API_KEY: process.env.XAI_API_KEY ?? '',\n    }),\n  }),\n})\n\nconst stream = chat({\n  threadId,\n  adapter: grokBuildText('composer-2.5'),\n  messages,\n  middleware: [withSandbox(sandbox)],\n})\n```\n\n## Each harness\n\n| Adapter | `authMode: 'api-key'` (default) | `authMode: 'host'` |\n| --- | --- | --- |\n| [Grok Build](../adapters/grok-build) | `XAI_API_KEY` | `grok login` |\n| [Claude Code](../adapters/claude-code) | `ANTHROPIC_API_KEY` | `claude login` |\n| [Codex](../adapters/codex) | `CODEX_API_KEY` | `codex login` |\n| [ACP-Compatible](../adapters/acp-compatible) | set `authMethodId` (for Grok, `xai.api_key`) | skip ACP `authenticate` |\n\nOpenCode still reads `OPENAI_API_KEY` from the process env. It has no `authMode`\nflag.\n\n## Client and server\n\nThe React chat example exposes the same choice on `/repo-report`. The client\nsends `authMode`. The server builds the adapter with that value.\n\nClient:\n\n```tsx\nimport { fetchServerSentEvents, useChat } from '@tanstack/ai-react'\n\nfunction Report() {\n  const { sendMessage } = useChat({\n    connection: fetchServerSentEvents('/api/sandbox-repo-report'),\n    forwardedProps: { authMode: 'api-key' },\n  })\n\n  return (\n    <button type=\"button\" onClick={() => sendMessage('Report on this repo')}>\n      Run\n    </button>\n  )\n}\n```\n\nServer:\n\n```ts\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { grokBuildText } from '@tanstack/ai-grok-build'\nimport { withSandbox } from '@tanstack/ai-sandbox'\nimport { sandbox } from './sandbox'\n\nexport async function POST(request: Request) {\n  const body: unknown = await request.json()\n  const forwarded =\n    typeof body === 'object' &&\n    body !== null &&\n    'forwardedProps' in body &&\n    typeof body.forwardedProps === 'object' &&\n    body.forwardedProps !== null\n      ? body.forwardedProps\n      : {}\n  const authMode =\n    'authMode' in forwarded && forwarded.authMode === 'host'\n      ? 'host'\n      : 'api-key'\n\n  const stream = chat({\n    adapter: grokBuildText('composer-2.5', { authMode }),\n    messages: [{ role: 'user', content: 'Report on this repo' }],\n    stream: true,\n    middleware: [withSandbox(sandbox)],\n  })\n\n  return toServerSentEventsResponse(stream)\n}\n```\n\nSee [Harnesses](./harnesses) for which adapter to pick, and [Providers](./providers)\nfor `scrubEnv` on local-process.\n","originalRawMarkdown":"---\ntitle: Harness Auth\nid: sandbox-auth\ndescription: \"Pick host login or an API key for a coding-agent harness. The same local-process sandbox can be your laptop or a CI runner.\"\n---\n\nYour laptop already has `grok login`, `claude login`, or `codex login`. A GitHub\nrunner has no browser login. It only has an API key. Both can use\n`localProcessSandbox()`.\n\nSet `authMode` on the adapter. The sandbox type does not pick the credentials.\nThe default is `'api-key'`. Most harnesses run in Docker or a cloud sandbox.\nThose have no host CLI login.\n\n- `'api-key'` (default): inject the key and use it.\n- `'host'`: use the CLI login on the machine. Do not inject an API key into\n  that process.\n\nPass `authMode` in one of two places:\n\n- Adapter factory: `grokBuildText('composer-2.5', { authMode: 'host' })`\n- One call: `chat({ modelOptions: { authMode: 'host' } })`\n\n## Host login\n\nUse this when the machine already ran `grok login`, `claude login`, or\n`codex login`.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { grokBuildText } from '@tanstack/ai-grok-build'\nimport { defineSandbox, defineWorkspace, withSandbox } from '@tanstack/ai-sandbox'\nimport { localProcessSandbox } from '@tanstack/ai-sandbox-local-process'\nimport { messages, threadId } from './chat-context'\n\nconst sandbox = defineSandbox({\n  id: 'repo-agent',\n  provider: localProcessSandbox({\n    scrubEnv: ['XAI_API_KEY', 'GROK_API_KEY'],\n  }),\n  workspace: defineWorkspace({\n    source: { type: 'local', path: '/abs/path/to/repo' },\n  }),\n})\n\nconst stream = chat({\n  threadId,\n  adapter: grokBuildText('composer-2.5', { authMode: 'host' }),\n  messages,\n  middleware: [withSandbox(sandbox)],\n})\n```\n\n`scrubEnv` removes keys the host process inherited. If the CLI sees\n`XAI_API_KEY`, it can prefer that key over your login.\n\n## API key\n\nThis is the default. Use it on a runner, in Docker, or on any machine that\nhas no CLI login. You can omit `authMode`.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { grokBuildText } from '@tanstack/ai-grok-build'\nimport {\n  createSecrets,\n  defineSandbox,\n  defineWorkspace,\n  githubRepo,\n  withSandbox,\n} from '@tanstack/ai-sandbox'\nimport { dockerSandbox } from '@tanstack/ai-sandbox-docker'\nimport { messages, threadId } from './chat-context'\n\nconst sandbox = defineSandbox({\n  id: 'repo-agent',\n  provider: dockerSandbox({ image: 'node:22' }),\n  workspace: defineWorkspace({\n    source: githubRepo({ repo: 'owner/app' }),\n    secrets: createSecrets({\n      XAI_API_KEY: process.env.XAI_API_KEY ?? '',\n    }),\n  }),\n})\n\nconst stream = chat({\n  threadId,\n  adapter: grokBuildText('composer-2.5'),\n  messages,\n  middleware: [withSandbox(sandbox)],\n})\n```\n\n## Each harness\n\n| Adapter | `authMode: 'api-key'` (default) | `authMode: 'host'` |\n| --- | --- | --- |\n| [Grok Build](../adapters/grok-build) | `XAI_API_KEY` | `grok login` |\n| [Claude Code](../adapters/claude-code) | `ANTHROPIC_API_KEY` | `claude login` |\n| [Codex](../adapters/codex) | `CODEX_API_KEY` | `codex login` |\n| [ACP-Compatible](../adapters/acp-compatible) | set `authMethodId` (for Grok, `xai.api_key`) | skip ACP `authenticate` |\n\nOpenCode still reads `OPENAI_API_KEY` from the process env. It has no `authMode`\nflag.\n\n## Client and server\n\nThe React chat example exposes the same choice on `/repo-report`. The client\nsends `authMode`. The server builds the adapter with that value.\n\nClient:\n\n```tsx\nimport { fetchServerSentEvents, useChat } from '@tanstack/ai-react'\n\nfunction Report() {\n  const { sendMessage } = useChat({\n    connection: fetchServerSentEvents('/api/sandbox-repo-report'),\n    forwardedProps: { authMode: 'api-key' },\n  })\n\n  return (\n    <button type=\"button\" onClick={() => sendMessage('Report on this repo')}>\n      Run\n    </button>\n  )\n}\n```\n\nServer:\n\n```ts\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { grokBuildText } from '@tanstack/ai-grok-build'\nimport { withSandbox } from '@tanstack/ai-sandbox'\nimport { sandbox } from './sandbox'\n\nexport async function POST(request: Request) {\n  const body: unknown = await request.json()\n  const forwarded =\n    typeof body === 'object' &&\n    body !== null &&\n    'forwardedProps' in body &&\n    typeof body.forwardedProps === 'object' &&\n    body.forwardedProps !== null\n      ? body.forwardedProps\n      : {}\n  const authMode =\n    'authMode' in forwarded && forwarded.authMode === 'host'\n      ? 'host'\n      : 'api-key'\n\n  const stream = chat({\n    adapter: grokBuildText('composer-2.5', { authMode }),\n    messages: [{ role: 'user', content: 'Report on this repo' }],\n    stream: true,\n    middleware: [withSandbox(sandbox)],\n  })\n\n  return toServerSentEventsResponse(stream)\n}\n```\n\nSee [Harnesses](./harnesses) for which adapter to pick, and [Providers](./providers)\nfor `scrubEnv` on local-process.\n"}
