NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"You have a live "},{"type":"link","href":"./mcp","children":[{"type":"text","value":"MCP client"}]},{"type":"text","value":" and want to do more than auto-discover tools: spread fully-typed tools into a "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" run, inject the server's resources and prompts into the conversation, and cancel in-flight MCP calls when the run aborts. By the end of this guide you'll have wired all of these into a single "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" call."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"createMCPClient"},{"type":"text","value":" tries protocol "},{"type":"inlineCode","value":"2026-07-28"},{"type":"text","value":" first. If the server does not support that protocol, the client uses the 2025 initialize handshake."}]},{"type":"paragraph","children":[{"type":"text","value":"Package names for an "},{"type":"inlineCode","value":"@modelcontextprotocol/sdk"},{"type":"text","value":" import are in "},{"type":"link","href":"../migration/mcp-sdk","children":[{"type":"text","value":"MCP SDK packages"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Manual ("},{"type":"inlineCode","value":"tools"},{"type":"text","value":" spread) vs managed ("},{"type":"inlineCode","value":"mcp"},{"type":"text","value":" prop)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This page covers the "},{"type":"strong","children":[{"type":"text","value":"manual"}]},{"type":"text","value":" path — you call "},{"type":"inlineCode","value":"client.tools()"},{"type":"text","value":" / "},{"type":"inlineCode","value":"client.resources()"},{"type":"text","value":" / "},{"type":"inlineCode","value":"client.getPrompt()"},{"type":"text","value":" yourself and own "},{"type":"inlineCode","value":"close()"},{"type":"text","value":". If you only need runtime-typed tools with discovery and lifecycle handled for you, use the "},{"type":"inlineCode","value":"mcp"},{"type":"text","value":" prop instead — see "},{"type":"link","href":"./mcp-managed","children":[{"type":"text","value":"Managed MCP with "},{"type":"inlineCode","value":"chat()"}]},{"type":"text","value":". Both paths build on the "},{"type":"link","href":"./mcp","children":[{"type":"inlineCode","value":"createMCPClient"},{"type":"text","value":" basics"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":2,"id":"fully-typed-tools-via-the-tools-spread","children":[{"type":"text","value":"Fully-typed tools via the "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" spread"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass "},{"type":"inlineCode","value":"toolDefinition()"},{"type":"text","value":" instances to "},{"type":"inlineCode","value":"client.tools([...])"},{"type":"text","value":" to get Zod-validated, TypeScript-typed arguments ("},{"type":"link","href":"./mcp#mode-2--explicit-definitions-clienttoolsdefs","children":[{"type":"text","value":"Mode 2"}]},{"type":"text","value":"), then spread the result into "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":"'s "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" option. You own the client, so you must close it — but "},{"type":"strong","children":[{"type":"text","value":"not before the stream is consumed"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" executes tools lazily while the response streams, so closing in a "},{"type":"inlineCode","value":"finally"},{"type":"text","value":" around the "},{"type":"inlineCode","value":"return"},{"type":"text","value":" would kill in-flight tool calls. Close in a middleware terminal hook instead (exactly one of "},{"type":"inlineCode","value":"onFinish"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onAbort"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onError"},{"type":"text","value":" fires per run)."}]},{"type":"code","value":"// src/routes/api.chat.ts\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse, toolDefinition } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\nimport { z } from 'zod'\n\nconst searchDef = toolDefinition({\n  name: 'search',\n  description: 'Search for items',\n  inputSchema: z.object({ query: z.string() }),\n  outputSchema: z.array(z.object({ id: z.string(), title: z.string() })),\n})\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const { messages } = await request.json()\n\n        const mcp = await createMCPClient({\n          transport: { type: 'http', url: process.env.MCP_URL! },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages,\n          // Fully-typed MCP tools, merged with any other tools you pass\n          tools: [...(await mcp.tools([searchDef]))],\n          // Close after the run ends — tools execute while the response streams.\n          middleware: [\n            {\n              name: 'mcp-close',\n              onFinish: () => mcp.close(),\n              onAbort: () => mcp.close(),\n              onError: () => mcp.close(),\n            },\n          ],\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})","lang":"ts","meta":"ignore"},{"type":"heading","depth":2,"id":"server-instructions","children":[{"type":"text","value":"Server instructions"}]},{"type":"paragraph","children":[{"type":"text","value":"A server can send instructions that tell the model how to use its tools. Put them in the system prompt so the model reads them before it calls a tool."}]},{"type":"paragraph","children":[{"type":"text","value":"Read them from "},{"type":"inlineCode","value":"mcp.instructions"},{"type":"text","value":" after connect. The value is "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" when the server sends none."}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'What is the weather in Paris?' }],\n  systemPrompts: mcp.instructions ? [mcp.instructions] : [],\n  tools: await mcp.tools(),\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"In a "},{"type":"link","href":"./mcp#per-server-access","children":[{"type":"text","value":"multi-server pool"}]},{"type":"text","value":", each client has its own value: "},{"type":"inlineCode","value":"pool.clients.github!.instructions"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"resources","children":[{"type":"text","value":"Resources"}]},{"type":"paragraph","children":[{"type":"text","value":"MCP resources are context documents (files, database records, web pages) the server exposes. Fetch them and inject them into "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" as content parts."}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient, mcpResourceToContentPart } from '@tanstack/ai-mcp'\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\n\nconst resources = await mcp.resources()\n// resources: Array<{ uri: string; name: string; ... }>\n\nconst readResult = await mcp.readResource(resources[0]!.uri)\nconst parts = readResult.contents.map(mcpResourceToContentPart)\n\n// Inject as part of a user message\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        ...parts,\n        { type: 'text', content: 'Summarize the above document.' },\n      ],\n    },\n  ],\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"mcpResourceToContentPart"},{"type":"text","value":" maps each MCP content block to a "},{"type":"inlineCode","value":"ContentPart"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"text"},{"type":"text","value":" field present → "},{"type":"inlineCode","value":"{ type: 'text', content: text }"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"blob"},{"type":"text","value":" field present → "},{"type":"inlineCode","value":"{ type: 'text', content: '[binary resource <uri>]' }"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"otherwise → "},{"type":"inlineCode","value":"{ type: 'text', content: JSON.stringify(content) }"}]}]}]},{"type":"heading","depth":3,"id":"resource-templates","children":[{"type":"text","value":"Resource templates"}]},{"type":"code","value":"import { createMCPClient } from '@tanstack/ai-mcp'\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\nconst templates = await mcp.resourceTemplates()\n// templates: Array<ResourceTemplate>","lang":"ts"},{"type":"heading","depth":2,"id":"prompts","children":[{"type":"text","value":"Prompts"}]},{"type":"paragraph","children":[{"type":"text","value":"MCP prompts are reusable message templates the server exposes. Fetch a prompt, convert it to "},{"type":"inlineCode","value":"ModelMessage[]"},{"type":"text","value":" with "},{"type":"inlineCode","value":"mcpPromptToMessages"},{"type":"text","value":", and spread it into "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" to seed the conversation with server-defined context or instructions."}]},{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient, mcpPromptToMessages } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const { messages } = await request.json()\n\n        const mcp = await createMCPClient({\n          transport: { type: 'http', url: process.env.MCP_URL! },\n        })\n\n        try {\n          // List all available prompts on the server\n          const available = await mcp.prompts()\n          // available: Array<{ name: string; description?: string; arguments?: ... }>\n\n          // Fetch a specific prompt, optionally passing template arguments\n          const prompt = await mcp.getPrompt('summarize', { language: 'english' })\n\n          const stream = chat({\n            adapter: openaiText('gpt-5.5'),\n            messages: [\n              // Seed the conversation with the server-defined prompt messages\n              ...mcpPromptToMessages(prompt),\n              // Then append the user's own messages\n              ...messages,\n            ],\n          })\n\n          return toServerSentEventsResponse(stream)\n        } finally {\n          // Safe here: all MCP calls (prompts/getPrompt) completed before chat()\n          // started, and no MCP tools are passed to the run. If you also spread\n          // MCP tools into `tools`, close in a middleware terminal hook instead\n          // (see \"Fully-typed tools via the `tools` spread\" above).\n          await mcp.close()\n        }\n      },\n    },\n  },\n})","lang":"ts","meta":"ignore"},{"type":"paragraph","children":[{"type":"inlineCode","value":"mcpPromptToMessages"},{"type":"text","value":" maps each MCP prompt message to a "},{"type":"inlineCode","value":"ModelMessage"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"role === 'assistant'"},{"type":"text","value":" → "},{"type":"inlineCode","value":"{ role: 'assistant', content: text }"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"any other role → "},{"type":"inlineCode","value":"{ role: 'user', content: text }"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"non-text content → "},{"type":"inlineCode","value":"content"},{"type":"text","value":" is "},{"type":"inlineCode","value":"JSON.stringify"},{"type":"text","value":"'d"}]}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"getPrompt(name, args?)"},{"type":"text","value":" accepts an optional "},{"type":"inlineCode","value":"args"},{"type":"text","value":" parameter typed as "},{"type":"inlineCode","value":"Record<string, string>"},{"type":"text","value":" for filling in template variables declared by the prompt."}]},{"type":"heading","depth":2,"id":"cancellation","children":[{"type":"text","value":"Cancellation"}]},{"type":"paragraph","children":[{"type":"text","value":"When the chat run is cancelled (e.g. the user navigates away or an "},{"type":"inlineCode","value":"AbortController"},{"type":"text","value":" fires), TanStack AI stops waiting for in-flight MCP tool calls. The abort signal from the chat run is threaded through "},{"type":"inlineCode","value":"ToolExecutionContext.abortSignal"},{"type":"text","value":" into each tool's execute function."}]},{"type":"paragraph","children":[{"type":"text","value":"For an ordinary "},{"type":"inlineCode","value":"callTool"},{"type":"text","value":" request, this aborts the request. For a task-required tool, it stops the local task stream and sends a best-effort "},{"type":"inlineCode","value":"tasks/cancel"},{"type":"text","value":" for a remote task the MCP server has already created."}]},{"type":"code","value":"import { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\nconst controller = new AbortController()\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages,\n  tools: await mcp.tools(),\n  abortController: controller,\n})\n\n// Cancel the run and stop waiting for in-flight MCP tool calls:\ncontroller.abort()","lang":"ts"},{"type":"heading","depth":2,"id":"full-server-client-example","children":[{"type":"text","value":"Full Server + Client Example"}]},{"type":"paragraph","children":[{"type":"text","value":"Here is a complete TanStack Start API route that connects to two MCP servers and streams the response to the browser."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server route ("},{"type":"inlineCode","value":"src/routes/api.chat.ts"},{"type":"text","value":"):"}]}]},{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClients } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n\n        if (typeof body !== 'object' || body === null || !Array.isArray(body.messages)) {\n          return new Response('Bad request', { status: 400 })\n        }\n\n        const pool = await createMCPClients({\n          github: {\n            transport: {\n              type: 'http',\n              url: process.env.GITHUB_MCP_URL!,\n              headers: { Authorization: `Bearer ${process.env.GITHUB_MCP_TOKEN}` },\n            },\n          },\n          linear: {\n            transport: {\n              type: 'http',\n              url: process.env.LINEAR_MCP_URL!,\n              headers: { Authorization: `Bearer ${process.env.LINEAR_MCP_TOKEN}` },\n            },\n          },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages: body.messages,\n          tools: await pool.tools(),\n          // Close after the run ends — tools execute while the response streams.\n          middleware: [\n            {\n              name: 'mcp-close',\n              onFinish: () => pool.close(),\n              onAbort: () => pool.close(),\n              onError: () => pool.close(),\n            },\n          ],\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})","lang":"ts","meta":"ignore"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Client component ("},{"type":"inlineCode","value":"src/components/Chat.tsx"},{"type":"text","value":"):"}]}]},{"type":"code","value":"import { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nexport function Chat() {\n  const { messages, sendMessage, status } = useChat(chatOptions)\n\n  return (\n    <div>\n      <ul>\n        {messages.map((m) => (\n          <li key={m.id}>\n            <strong>{m.role}:</strong>{' '}\n            {m.parts.find((p) => p.type === 'text')?.content}\n          </li>\n        ))}\n      </ul>\n      <button\n        onClick={() => sendMessage({ content: 'List my open GitHub issues' })}\n        disabled={status === 'streaming'}\n      >\n        Ask\n      </button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"going-further","children":[{"type":"text","value":"Going further"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Want "},{"type":"inlineCode","value":"chat()"},{"type":"text","value":" to discover tools and close clients for you?"}]},{"type":"text","value":" If you don't need the manual "},{"type":"inlineCode","value":"tools"},{"type":"text","value":" spread, resources, or prompts, the "},{"type":"inlineCode","value":"mcp"},{"type":"text","value":" prop removes the close-middleware boilerplate entirely. See "},{"type":"link","href":"./mcp-managed","children":[{"type":"text","value":"Managed MCP with "},{"type":"inlineCode","value":"chat()"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Want compile-checked tool names on the discovery path?"}]},{"type":"text","value":" Generate per-server interface types from your live servers and pass them as a generic to "},{"type":"inlineCode","value":"createMCPClient"},{"type":"text","value":" — discovered tool names narrow to the server's literal names, with zero runtime overhead. See "},{"type":"link","href":"./mcp-codegen","children":[{"type":"text","value":"MCP Type Generation"}]},{"type":"text","value":"."}]}]}],"headings":[{"id":"fully-typed-tools-via-the-tools-spread","text":"Fully-typed tools via the tools spread","level":2},{"id":"server-instructions","text":"Server instructions","level":2},{"id":"resources","text":"Resources","level":2},{"id":"resource-templates","text":"Resource templates","level":3},{"id":"prompts","text":"Prompts","level":2},{"id":"cancellation","text":"Cancellation","level":2},{"id":"full-server-client-example","text":"Full Server + Client Example","level":2},{"id":"going-further","text":"Going further","level":2}]},"frameworks":[],"downloadMarkdown":"\nYou have a live [MCP client](./mcp) and want to do more than auto-discover tools: spread fully-typed tools into a `chat()` run, inject the server's resources and prompts into the conversation, and cancel in-flight MCP calls when the run aborts. By the end of this guide you'll have wired all of these into a single `chat()` call.\n\n> `createMCPClient` tries protocol `2026-07-28` first. If the server does not support that protocol, the client uses the 2025 initialize handshake.\n>\n> Package names for an `@modelcontextprotocol/sdk` import are in [MCP SDK packages](../migration/mcp-sdk).\n\n> **Manual (`tools` spread) vs managed (`mcp` prop)**\n>\n> This page covers the **manual** path — you call `client.tools()` / `client.resources()` / `client.getPrompt()` yourself and own `close()`. If you only need runtime-typed tools with discovery and lifecycle handled for you, use the `mcp` prop instead — see [Managed MCP with `chat()`](./mcp-managed). Both paths build on the [`createMCPClient` basics](./mcp).\n\n## Fully-typed tools via the `tools` spread\n\nPass `toolDefinition()` instances to `client.tools([...])` to get Zod-validated, TypeScript-typed arguments ([Mode 2](./mcp#mode-2--explicit-definitions-clienttoolsdefs)), then spread the result into `chat()`'s `tools` option. You own the client, so you must close it — but **not before the stream is consumed**: `chat()` executes tools lazily while the response streams, so closing in a `finally` around the `return` would kill in-flight tool calls. Close in a middleware terminal hook instead (exactly one of `onFinish`/`onAbort`/`onError` fires per run).\n\n```ts ignore\n// src/routes/api.chat.ts\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse, toolDefinition } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\nimport { z } from 'zod'\n\nconst searchDef = toolDefinition({\n  name: 'search',\n  description: 'Search for items',\n  inputSchema: z.object({ query: z.string() }),\n  outputSchema: z.array(z.object({ id: z.string(), title: z.string() })),\n})\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const { messages } = await request.json()\n\n        const mcp = await createMCPClient({\n          transport: { type: 'http', url: process.env.MCP_URL! },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages,\n          // Fully-typed MCP tools, merged with any other tools you pass\n          tools: [...(await mcp.tools([searchDef]))],\n          // Close after the run ends — tools execute while the response streams.\n          middleware: [\n            {\n              name: 'mcp-close',\n              onFinish: () => mcp.close(),\n              onAbort: () => mcp.close(),\n              onError: () => mcp.close(),\n            },\n          ],\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n## Server instructions\n\nA server can send instructions that tell the model how to use its tools. Put them in the system prompt so the model reads them before it calls a tool.\n\nRead them from `mcp.instructions` after connect. The value is `undefined` when the server sends none.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'What is the weather in Paris?' }],\n  systemPrompts: mcp.instructions ? [mcp.instructions] : [],\n  tools: await mcp.tools(),\n})\n```\n\nIn a [multi-server pool](./mcp#per-server-access), each client has its own value: `pool.clients.github!.instructions`.\n\n## Resources\n\nMCP resources are context documents (files, database records, web pages) the server exposes. Fetch them and inject them into `chat()` as content parts.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient, mcpResourceToContentPart } from '@tanstack/ai-mcp'\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\n\nconst resources = await mcp.resources()\n// resources: Array<{ uri: string; name: string; ... }>\n\nconst readResult = await mcp.readResource(resources[0]!.uri)\nconst parts = readResult.contents.map(mcpResourceToContentPart)\n\n// Inject as part of a user message\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        ...parts,\n        { type: 'text', content: 'Summarize the above document.' },\n      ],\n    },\n  ],\n})\n```\n\n`mcpResourceToContentPart` maps each MCP content block to a `ContentPart`:\n- `text` field present → `{ type: 'text', content: text }`\n- `blob` field present → `{ type: 'text', content: '[binary resource <uri>]' }`\n- otherwise → `{ type: 'text', content: JSON.stringify(content) }`\n\n### Resource templates\n\n```ts\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\nconst templates = await mcp.resourceTemplates()\n// templates: Array<ResourceTemplate>\n```\n\n## Prompts\n\nMCP prompts are reusable message templates the server exposes. Fetch a prompt, convert it to `ModelMessage[]` with `mcpPromptToMessages`, and spread it into `chat()` to seed the conversation with server-defined context or instructions.\n\n```ts ignore\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient, mcpPromptToMessages } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const { messages } = await request.json()\n\n        const mcp = await createMCPClient({\n          transport: { type: 'http', url: process.env.MCP_URL! },\n        })\n\n        try {\n          // List all available prompts on the server\n          const available = await mcp.prompts()\n          // available: Array<{ name: string; description?: string; arguments?: ... }>\n\n          // Fetch a specific prompt, optionally passing template arguments\n          const prompt = await mcp.getPrompt('summarize', { language: 'english' })\n\n          const stream = chat({\n            adapter: openaiText('gpt-5.5'),\n            messages: [\n              // Seed the conversation with the server-defined prompt messages\n              ...mcpPromptToMessages(prompt),\n              // Then append the user's own messages\n              ...messages,\n            ],\n          })\n\n          return toServerSentEventsResponse(stream)\n        } finally {\n          // Safe here: all MCP calls (prompts/getPrompt) completed before chat()\n          // started, and no MCP tools are passed to the run. If you also spread\n          // MCP tools into `tools`, close in a middleware terminal hook instead\n          // (see \"Fully-typed tools via the `tools` spread\" above).\n          await mcp.close()\n        }\n      },\n    },\n  },\n})\n```\n\n`mcpPromptToMessages` maps each MCP prompt message to a `ModelMessage`:\n- `role === 'assistant'` → `{ role: 'assistant', content: text }`\n- any other role → `{ role: 'user', content: text }`\n- non-text content → `content` is `JSON.stringify`'d\n\n`getPrompt(name, args?)` accepts an optional `args` parameter typed as `Record<string, string>` for filling in template variables declared by the prompt.\n\n## Cancellation\n\nWhen the chat run is cancelled (e.g. the user navigates away or an `AbortController` fires), TanStack AI stops waiting for in-flight MCP tool calls. The abort signal from the chat run is threaded through `ToolExecutionContext.abortSignal` into each tool's execute function.\n\nFor an ordinary `callTool` request, this aborts the request. For a task-required tool, it stops the local task stream and sends a best-effort `tasks/cancel` for a remote task the MCP server has already created.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\nconst controller = new AbortController()\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages,\n  tools: await mcp.tools(),\n  abortController: controller,\n})\n\n// Cancel the run and stop waiting for in-flight MCP tool calls:\ncontroller.abort()\n```\n\n## Full Server + Client Example\n\nHere is a complete TanStack Start API route that connects to two MCP servers and streams the response to the browser.\n\n**Server route (`src/routes/api.chat.ts`):**\n\n```ts ignore\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClients } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n\n        if (typeof body !== 'object' || body === null || !Array.isArray(body.messages)) {\n          return new Response('Bad request', { status: 400 })\n        }\n\n        const pool = await createMCPClients({\n          github: {\n            transport: {\n              type: 'http',\n              url: process.env.GITHUB_MCP_URL!,\n              headers: { Authorization: `Bearer ${process.env.GITHUB_MCP_TOKEN}` },\n            },\n          },\n          linear: {\n            transport: {\n              type: 'http',\n              url: process.env.LINEAR_MCP_URL!,\n              headers: { Authorization: `Bearer ${process.env.LINEAR_MCP_TOKEN}` },\n            },\n          },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages: body.messages,\n          tools: await pool.tools(),\n          // Close after the run ends — tools execute while the response streams.\n          middleware: [\n            {\n              name: 'mcp-close',\n              onFinish: () => pool.close(),\n              onAbort: () => pool.close(),\n              onError: () => pool.close(),\n            },\n          ],\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n**Client component (`src/components/Chat.tsx`):**\n\n```tsx\nimport { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nexport function Chat() {\n  const { messages, sendMessage, status } = useChat(chatOptions)\n\n  return (\n    <div>\n      <ul>\n        {messages.map((m) => (\n          <li key={m.id}>\n            <strong>{m.role}:</strong>{' '}\n            {m.parts.find((p) => p.type === 'text')?.content}\n          </li>\n        ))}\n      </ul>\n      <button\n        onClick={() => sendMessage({ content: 'List my open GitHub issues' })}\n        disabled={status === 'streaming'}\n      >\n        Ask\n      </button>\n    </div>\n  )\n}\n```\n\n## Going further\n\n> **Want `chat()` to discover tools and close clients for you?** If you don't need the manual `tools` spread, resources, or prompts, the `mcp` prop removes the close-middleware boilerplate entirely. See [Managed MCP with `chat()`](./mcp-managed).\n\n> **Want compile-checked tool names on the discovery path?** Generate per-server interface types from your live servers and pass them as a generic to `createMCPClient` — discovered tool names narrow to the server's literal names, with zero runtime overhead. See [MCP Type Generation](./mcp-codegen).\n","originalRawMarkdown":"---\ntitle: \"Manual MCP: typed tools, resources & prompts\"\nid: mcp-manual\norder: 10\ndescription: \"Spread fully-typed MCP tools into chat(), inject MCP resources and prompts as content and messages, and stop in-flight MCP tool calls when a run aborts.\"\nkeywords:\n  - tanstack ai\n  - mcp\n  - model context protocol\n  - mcp resources\n  - mcp prompts\n  - mcpResourceToContentPart\n  - mcpPromptToMessages\n  - cancellation\n  - abortController\n---\n\nYou have a live [MCP client](./mcp) and want to do more than auto-discover tools: spread fully-typed tools into a `chat()` run, inject the server's resources and prompts into the conversation, and cancel in-flight MCP calls when the run aborts. By the end of this guide you'll have wired all of these into a single `chat()` call.\n\n> `createMCPClient` tries protocol `2026-07-28` first. If the server does not support that protocol, the client uses the 2025 initialize handshake.\n>\n> Package names for an `@modelcontextprotocol/sdk` import are in [MCP SDK packages](../migration/mcp-sdk).\n\n> **Manual (`tools` spread) vs managed (`mcp` prop)**\n>\n> This page covers the **manual** path — you call `client.tools()` / `client.resources()` / `client.getPrompt()` yourself and own `close()`. If you only need runtime-typed tools with discovery and lifecycle handled for you, use the `mcp` prop instead — see [Managed MCP with `chat()`](./mcp-managed). Both paths build on the [`createMCPClient` basics](./mcp).\n\n## Fully-typed tools via the `tools` spread\n\nPass `toolDefinition()` instances to `client.tools([...])` to get Zod-validated, TypeScript-typed arguments ([Mode 2](./mcp#mode-2--explicit-definitions-clienttoolsdefs)), then spread the result into `chat()`'s `tools` option. You own the client, so you must close it — but **not before the stream is consumed**: `chat()` executes tools lazily while the response streams, so closing in a `finally` around the `return` would kill in-flight tool calls. Close in a middleware terminal hook instead (exactly one of `onFinish`/`onAbort`/`onError` fires per run).\n\n```ts ignore\n// src/routes/api.chat.ts\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse, toolDefinition } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\nimport { z } from 'zod'\n\nconst searchDef = toolDefinition({\n  name: 'search',\n  description: 'Search for items',\n  inputSchema: z.object({ query: z.string() }),\n  outputSchema: z.array(z.object({ id: z.string(), title: z.string() })),\n})\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const { messages } = await request.json()\n\n        const mcp = await createMCPClient({\n          transport: { type: 'http', url: process.env.MCP_URL! },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages,\n          // Fully-typed MCP tools, merged with any other tools you pass\n          tools: [...(await mcp.tools([searchDef]))],\n          // Close after the run ends — tools execute while the response streams.\n          middleware: [\n            {\n              name: 'mcp-close',\n              onFinish: () => mcp.close(),\n              onAbort: () => mcp.close(),\n              onError: () => mcp.close(),\n            },\n          ],\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n## Server instructions\n\nA server can send instructions that tell the model how to use its tools. Put them in the system prompt so the model reads them before it calls a tool.\n\nRead them from `mcp.instructions` after connect. The value is `undefined` when the server sends none.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [{ role: 'user', content: 'What is the weather in Paris?' }],\n  systemPrompts: mcp.instructions ? [mcp.instructions] : [],\n  tools: await mcp.tools(),\n})\n```\n\nIn a [multi-server pool](./mcp#per-server-access), each client has its own value: `pool.clients.github!.instructions`.\n\n## Resources\n\nMCP resources are context documents (files, database records, web pages) the server exposes. Fetch them and inject them into `chat()` as content parts.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient, mcpResourceToContentPart } from '@tanstack/ai-mcp'\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\n\nconst resources = await mcp.resources()\n// resources: Array<{ uri: string; name: string; ... }>\n\nconst readResult = await mcp.readResource(resources[0]!.uri)\nconst parts = readResult.contents.map(mcpResourceToContentPart)\n\n// Inject as part of a user message\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages: [\n    {\n      role: 'user',\n      content: [\n        ...parts,\n        { type: 'text', content: 'Summarize the above document.' },\n      ],\n    },\n  ],\n})\n```\n\n`mcpResourceToContentPart` maps each MCP content block to a `ContentPart`:\n- `text` field present → `{ type: 'text', content: text }`\n- `blob` field present → `{ type: 'text', content: '[binary resource <uri>]' }`\n- otherwise → `{ type: 'text', content: JSON.stringify(content) }`\n\n### Resource templates\n\n```ts\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\nconst templates = await mcp.resourceTemplates()\n// templates: Array<ResourceTemplate>\n```\n\n## Prompts\n\nMCP prompts are reusable message templates the server exposes. Fetch a prompt, convert it to `ModelMessage[]` with `mcpPromptToMessages`, and spread it into `chat()` to seed the conversation with server-defined context or instructions.\n\n```ts ignore\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient, mcpPromptToMessages } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const { messages } = await request.json()\n\n        const mcp = await createMCPClient({\n          transport: { type: 'http', url: process.env.MCP_URL! },\n        })\n\n        try {\n          // List all available prompts on the server\n          const available = await mcp.prompts()\n          // available: Array<{ name: string; description?: string; arguments?: ... }>\n\n          // Fetch a specific prompt, optionally passing template arguments\n          const prompt = await mcp.getPrompt('summarize', { language: 'english' })\n\n          const stream = chat({\n            adapter: openaiText('gpt-5.5'),\n            messages: [\n              // Seed the conversation with the server-defined prompt messages\n              ...mcpPromptToMessages(prompt),\n              // Then append the user's own messages\n              ...messages,\n            ],\n          })\n\n          return toServerSentEventsResponse(stream)\n        } finally {\n          // Safe here: all MCP calls (prompts/getPrompt) completed before chat()\n          // started, and no MCP tools are passed to the run. If you also spread\n          // MCP tools into `tools`, close in a middleware terminal hook instead\n          // (see \"Fully-typed tools via the `tools` spread\" above).\n          await mcp.close()\n        }\n      },\n    },\n  },\n})\n```\n\n`mcpPromptToMessages` maps each MCP prompt message to a `ModelMessage`:\n- `role === 'assistant'` → `{ role: 'assistant', content: text }`\n- any other role → `{ role: 'user', content: text }`\n- non-text content → `content` is `JSON.stringify`'d\n\n`getPrompt(name, args?)` accepts an optional `args` parameter typed as `Record<string, string>` for filling in template variables declared by the prompt.\n\n## Cancellation\n\nWhen the chat run is cancelled (e.g. the user navigates away or an `AbortController` fires), TanStack AI stops waiting for in-flight MCP tool calls. The abort signal from the chat run is threaded through `ToolExecutionContext.abortSignal` into each tool's execute function.\n\nFor an ordinary `callTool` request, this aborts the request. For a task-required tool, it stops the local task stream and sends a best-effort `tasks/cancel` for a remote task the MCP server has already created.\n\n```ts\nimport { chat } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClient } from '@tanstack/ai-mcp'\n\nconst messages = [{ role: 'user' as const, content: 'Hello' }]\n\nconst mcp = await createMCPClient({\n  transport: { type: 'http', url: process.env.MCP_URL! },\n})\nconst controller = new AbortController()\n\nconst stream = chat({\n  adapter: openaiText('gpt-5.5'),\n  messages,\n  tools: await mcp.tools(),\n  abortController: controller,\n})\n\n// Cancel the run and stop waiting for in-flight MCP tool calls:\ncontroller.abort()\n```\n\n## Full Server + Client Example\n\nHere is a complete TanStack Start API route that connects to two MCP servers and streams the response to the browser.\n\n**Server route (`src/routes/api.chat.ts`):**\n\n```ts ignore\nimport { createFileRoute } from '@tanstack/react-router'\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\nimport { createMCPClients } from '@tanstack/ai-mcp'\n\nexport const Route = createFileRoute('/api/chat')({\n  server: {\n    handlers: {\n      POST: async ({ request }) => {\n        const body = await request.json()\n\n        if (typeof body !== 'object' || body === null || !Array.isArray(body.messages)) {\n          return new Response('Bad request', { status: 400 })\n        }\n\n        const pool = await createMCPClients({\n          github: {\n            transport: {\n              type: 'http',\n              url: process.env.GITHUB_MCP_URL!,\n              headers: { Authorization: `Bearer ${process.env.GITHUB_MCP_TOKEN}` },\n            },\n          },\n          linear: {\n            transport: {\n              type: 'http',\n              url: process.env.LINEAR_MCP_URL!,\n              headers: { Authorization: `Bearer ${process.env.LINEAR_MCP_TOKEN}` },\n            },\n          },\n        })\n\n        const stream = chat({\n          adapter: openaiText('gpt-5.5'),\n          messages: body.messages,\n          tools: await pool.tools(),\n          // Close after the run ends — tools execute while the response streams.\n          middleware: [\n            {\n              name: 'mcp-close',\n              onFinish: () => pool.close(),\n              onAbort: () => pool.close(),\n              onError: () => pool.close(),\n            },\n          ],\n        })\n\n        return toServerSentEventsResponse(stream)\n      },\n    },\n  },\n})\n```\n\n**Client component (`src/components/Chat.tsx`):**\n\n```tsx\nimport { useChat } from '@tanstack/ai-react'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nexport function Chat() {\n  const { messages, sendMessage, status } = useChat(chatOptions)\n\n  return (\n    <div>\n      <ul>\n        {messages.map((m) => (\n          <li key={m.id}>\n            <strong>{m.role}:</strong>{' '}\n            {m.parts.find((p) => p.type === 'text')?.content}\n          </li>\n        ))}\n      </ul>\n      <button\n        onClick={() => sendMessage({ content: 'List my open GitHub issues' })}\n        disabled={status === 'streaming'}\n      >\n        Ask\n      </button>\n    </div>\n  )\n}\n```\n\n## Going further\n\n> **Want `chat()` to discover tools and close clients for you?** If you don't need the manual `tools` spread, resources, or prompts, the `mcp` prop removes the close-middleware boilerplate entirely. See [Managed MCP with `chat()`](./mcp-managed).\n\n> **Want compile-checked tool names on the discovery path?** Generate per-server interface types from your live servers and pass them as a generic to `createMCPClient` — discovered tool names narrow to the server's literal names, with zero runtime overhead. See [MCP Type Generation](./mcp-codegen).\n"}
