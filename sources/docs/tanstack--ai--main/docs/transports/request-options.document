ue":" is "},{"type":"inlineCode","value":"\"same-origin\""},{"type":"text","value":" (the default) or "},{"type":"inlineCode","value":"\"include\""},{"type":"text","value":", the browser sends cookies automatically."}]},{"type":"heading","depth":2,"id":"change-the-url-per-request","children":[{"type":"text","value":"Change the URL per request"}]},{"type":"paragraph","children":[{"type":"text","value":"If the URL or the headers depend on per-request state (the current user, a new token), pass functions for both:"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { currentUserId, getToken } from \"./auth\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\n    () => `/api/chat?user=${currentUserId}`,\n    () => ({\n      headers: { Authorization: `Bearer ${getToken()}` },\n    }),\n  ),\n});","lang":"typescript"},{"type":"heading","depth":2,"id":"send-extra-data-in-the-body","children":[{"type":"text","value":"Send extra data in the body"}]},{"type":"paragraph","children":[{"type":"text","value":"The adapter merges "},{"type":"inlineCode","value":"options.body"},{"type":"text","value":" into the AG-UI "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" payload that goes to your server:"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", {\n    body: { provider: \"openai\", model: \"gpt-5.6\" },\n  }),\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"inlineCode","value":"body"},{"type":"text","value":" and "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" fill the same wire field:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Adapter "},{"type":"inlineCode","value":"body"}]},{"type":"text","value":": static defaults."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" option on "},{"type":"inlineCode","value":"useChat"},{"type":"text","value":", or "},{"type":"inlineCode","value":"sendMessage(content, { body })"}]},{"type":"text","value":": values that change. These values win over the adapter "},{"type":"inlineCode","value":"body"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":2,"id":"send-data-with-one-message","children":[{"type":"text","value":"Send data with one message"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass extra JSON for one send in the second argument of "},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":":"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst { sendMessage } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  forwardedProps: { provider: \"openai\" },\n});\n\nawait sendMessage(\"Summarize the attached files\", {\n  body: { attachmentIds: [\"att_1\", \"att_2\"] },\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"The client does a shallow merge of this "},{"type":"inlineCode","value":"body"},{"type":"text","value":" into "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":", with the chat-level "},{"type":"inlineCode","value":"body"},{"type":"text","value":" ("},{"type":"inlineCode","value":"{ ...chatBody, ...sendOptions.body }"},{"type":"text","value":"). If a key is in both, the "},{"type":"inlineCode","value":"sendMessage"},{"type":"text","value":" value wins. The merge applies to this request only."}]},{"type":"paragraph","children":[{"type":"text","value":"Read the merged object on the server with "},{"type":"inlineCode","value":"chatParamsFromRequest"},{"type":"text","value":". If the model must not see those keys, do not copy them into "},{"type":"inlineCode","value":"messages"},{"type":"text","value":":"}]},{"type":"code","value":"import {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nexport async function POST(request: Request) {\n  const { messages, forwardedProps } = await chatParamsFromRequest(request);\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.6\"),\n    messages,\n  });\n  if (\n    forwardedProps &&\n    typeof forwardedProps === \"object\" &&\n    \"attachmentIds\" in forwardedProps\n  ) {\n    const { attachmentIds } = forwardedProps\n    if (Array.isArray(attachmentIds) && attachmentIds.length > 0) {\n      // Look up the uploads. Do not add them to `messages`.\n    }\n  }\n  return toServerSentEventsResponse(stream);\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Two more rules:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"ChatClient"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"sendMessage(content, body, sendOptions)"},{"type":"text","value":" takes the same extra JSON as its second argument. The client does a shallow merge of it with "},{"type":"inlineCode","value":"sendOptions.body"},{"type":"text","value":". If a key is in both, "},{"type":"inlineCode","value":"sendOptions.body"},{"type":"text","value":" wins."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"reload()"}]},{"type":"text","value":": it starts a new request with the chat-level "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" and "},{"type":"inlineCode","value":"body"},{"type":"text","value":" only. It does not send the per-call "},{"type":"inlineCode","value":"body"},{"type":"text","value":" of the previous send again."}]}]}]},{"type":"heading","depth":2,"id":"wrap-fetch","children":[{"type":"text","value":"Wrap fetch"}]},{"type":"paragraph","children":[{"type":"text","value":"To keep SSE or HTTP streaming but wrap "},{"type":"inlineCode","value":"fetch"},{"type":"text","value":" (auth refresh, retries, logs, or an edge proxy), pass a "},{"type":"inlineCode","value":"fetchClient"},{"type":"text","value":":"}]},{"type":"code","value":"import { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { refreshToken } from \"./auth\";\n\nasync function authedFetch(input: RequestInfo | URL, init?: RequestInit) {\n  let response = await fetch(input, init);\n  if (response.status === 401) {\n    await refreshToken();\n    response = await fetch(input, init);\n  }\n  return response;\n}\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", {\n    fetchClient: authedFetch,\n  }),\n});","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"fetchClient"},{"type":"text","value":" must have the standard "},{"type":"inlineCode","value":"fetch"},{"type":"text","value":" signature. "},{"type":"inlineCode","value":"fetchHttpStream"},{"type":"text","value":" accepts the same option. For a production example, see the "},{"type":"link","href":"../community-adapters/cloudflare","children":[{"type":"text","value":"Cloudflare Adapter"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Send a message. Your server gets the header, the body data, and the messages in one request."}]}],"headings":[{"id":"add-an-auth-header","text":"Add an auth header","level":2},{"id":"change-the-url-per-request","text":"Change the URL per request","level":2},{"id":"send-extra-data-in-the-body","text":"Send extra data in the body","level":2},{"id":"send-data-with-one-message","text":"Send data with one message","level":2},{"id":"wrap-fetch","text":"Wrap fetch","level":2}]},"frameworks":[],"downloadMarkdown":"\nYour server needs more than the messages: an auth token, a user id, a model choice, or data for one message. Pass it through the adapter options.\n\nThe examples use `fetchServerSentEvents`. `fetchHttpStream` takes the same options. The XHR adapters take `headers` and `body` too, and use `withCredentials` for cookies.\n\n## Add an auth header\n\nPut static headers in `options.headers`:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { token } from \"./auth\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", {\n    headers: { Authorization: `Bearer ${token}` },\n  }),\n});\n```\n\nIf the token changes (refresh tokens, short-lived JWTs), pass a function. The adapter calls it on every send, so the header always has the latest token:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { getToken } from \"./auth\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", () => ({\n    headers: { Authorization: `Bearer ${getToken()}` },\n  })),\n});\n```\n\nIf `credentials` is `\"same-origin\"` (the default) or `\"include\"`, the browser sends cookies automatically.\n\n## Change the URL per request\n\nIf the URL or the headers depend on per-request state (the current user, a new token), pass functions for both:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { currentUserId, getToken } from \"./auth\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\n    () => `/api/chat?user=${currentUserId}`,\n    () => ({\n      headers: { Authorization: `Bearer ${getToken()}` },\n    }),\n  ),\n});\n```\n\n## Send extra data in the body\n\nThe adapter merges `options.body` into the AG-UI `forwardedProps` payload that goes to your server:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", {\n    body: { provider: \"openai\", model: \"gpt-5.6\" },\n  }),\n});\n```\n\n`body` and `forwardedProps` fill the same wire field:\n\n- **Adapter `body`**: static defaults.\n- **The `forwardedProps` option on `useChat`, or `sendMessage(content, { body })`**: values that change. These values win over the adapter `body`.\n\n## Send data with one message\n\nPass extra JSON for one send in the second argument of `sendMessage`:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst { sendMessage } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  forwardedProps: { provider: \"openai\" },\n});\n\nawait sendMessage(\"Summarize the attached files\", {\n  body: { attachmentIds: [\"att_1\", \"att_2\"] },\n});\n```\n\nThe client does a shallow merge of this `body` into `forwardedProps`, with the chat-level `body` (`{ ...chatBody, ...sendOptions.body }`). If a key is in both, the `sendMessage` value wins. The merge applies to this request only.\n\nRead the merged object on the server with `chatParamsFromRequest`. If the model must not see those keys, do not copy them into `messages`:\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nexport async function POST(request: Request) {\n  const { messages, forwardedProps } = await chatParamsFromRequest(request);\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.6\"),\n    messages,\n  });\n  if (\n    forwardedProps &&\n    typeof forwardedProps === \"object\" &&\n    \"attachmentIds\" in forwardedProps\n  ) {\n    const { attachmentIds } = forwardedProps\n    if (Array.isArray(attachmentIds) && attachmentIds.length > 0) {\n      // Look up the uploads. Do not add them to `messages`.\n    }\n  }\n  return toServerSentEventsResponse(stream);\n}\n```\n\nTwo more rules:\n\n- **`ChatClient`**: `sendMessage(content, body, sendOptions)` takes the same extra JSON as its second argument. The client does a shallow merge of it with `sendOptions.body`. If a key is in both, `sendOptions.body` wins.\n- **`reload()`**: it starts a new request with the chat-level `forwardedProps` and `body` only. It does not send the per-call `body` of the previous send again.\n\n## Wrap fetch\n\nTo keep SSE or HTTP streaming but wrap `fetch` (auth refresh, retries, logs, or an edge proxy), pass a `fetchClient`:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { refreshToken } from \"./auth\";\n\nasync function authedFetch(input: RequestInfo | URL, init?: RequestInit) {\n  let response = await fetch(input, init);\n  if (response.status === 401) {\n    await refreshToken();\n    response = await fetch(input, init);\n  }\n  return response;\n}\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", {\n    fetchClient: authedFetch,\n  }),\n});\n```\n\nThe `fetchClient` must have the standard `fetch` signature. `fetchHttpStream` accepts the same option. For a production example, see the [Cloudflare Adapter](../community-adapters/cloudflare).\n\nSend a message. Your server gets the header, the body data, and the messages in one request.\n","originalRawMarkdown":"---\ntitle: Request Options\nid: transports-request-options\norder: 7\ndescription: \"Send auth headers, dynamic URLs, extra body data, and per-message data with TanStack AI transports, and wrap fetch with fetchClient.\"\nkeywords:\n  - tanstack ai\n  - request options\n  - headers\n  - authentication\n  - forwardedProps\n  - body\n  - chatParamsFromRequest\n  - fetchClient\n---\n\nYour server needs more than the messages: an auth token, a user id, a model choice, or data for one message. Pass it through the adapter options.\n\nThe examples use `fetchServerSentEvents`. `fetchHttpStream` takes the same options. The XHR adapters take `headers` and `body` too, and use `withCredentials` for cookies.\n\n## Add an auth header\n\nPut static headers in `options.headers`:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { token } from \"./auth\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", {\n    headers: { Authorization: `Bearer ${token}` },\n  }),\n});\n```\n\nIf the token changes (refresh tokens, short-lived JWTs), pass a function. The adapter calls it on every send, so the header always has the latest token:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { getToken } from \"./auth\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", () => ({\n    headers: { Authorization: `Bearer ${getToken()}` },\n  })),\n});\n```\n\nIf `credentials` is `\"same-origin\"` (the default) or `\"include\"`, the browser sends cookies automatically.\n\n## Change the URL per request\n\nIf the URL or the headers depend on per-request state (the current user, a new token), pass functions for both:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { currentUserId, getToken } from \"./auth\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\n    () => `/api/chat?user=${currentUserId}`,\n    () => ({\n      headers: { Authorization: `Bearer ${getToken()}` },\n    }),\n  ),\n});\n```\n\n## Send extra data in the body\n\nThe adapter merges `options.body` into the AG-UI `forwardedProps` payload that goes to your server:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", {\n    body: { provider: \"openai\", model: \"gpt-5.6\" },\n  }),\n});\n```\n\n`body` and `forwardedProps` fill the same wire field:\n\n- **Adapter `body`**: static defaults.\n- **The `forwardedProps` option on `useChat`, or `sendMessage(content, { body })`**: values that change. These values win over the adapter `body`.\n\n## Send data with one message\n\nPass extra JSON for one send in the second argument of `sendMessage`:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\n\nconst { sendMessage } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\"),\n  forwardedProps: { provider: \"openai\" },\n});\n\nawait sendMessage(\"Summarize the attached files\", {\n  body: { attachmentIds: [\"att_1\", \"att_2\"] },\n});\n```\n\nThe client does a shallow merge of this `body` into `forwardedProps`, with the chat-level `body` (`{ ...chatBody, ...sendOptions.body }`). If a key is in both, the `sendMessage` value wins. The merge applies to this request only.\n\nRead the merged object on the server with `chatParamsFromRequest`. If the model must not see those keys, do not copy them into `messages`:\n\n```typescript\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from \"@tanstack/ai\";\nimport { openaiText } from \"@tanstack/ai-openai\";\n\nexport async function POST(request: Request) {\n  const { messages, forwardedProps } = await chatParamsFromRequest(request);\n  const stream = chat({\n    adapter: openaiText(\"gpt-5.6\"),\n    messages,\n  });\n  if (\n    forwardedProps &&\n    typeof forwardedProps === \"object\" &&\n    \"attachmentIds\" in forwardedProps\n  ) {\n    const { attachmentIds } = forwardedProps\n    if (Array.isArray(attachmentIds) && attachmentIds.length > 0) {\n      // Look up the uploads. Do not add them to `messages`.\n    }\n  }\n  return toServerSentEventsResponse(stream);\n}\n```\n\nTwo more rules:\n\n- **`ChatClient`**: `sendMessage(content, body, sendOptions)` takes the same extra JSON as its second argument. The client does a shallow merge of it with `sendOptions.body`. If a key is in both, `sendOptions.body` wins.\n- **`reload()`**: it starts a new request with the chat-level `forwardedProps` and `body` only. It does not send the per-call `body` of the previous send again.\n\n## Wrap fetch\n\nTo keep SSE or HTTP streaming but wrap `fetch` (auth refresh, retries, logs, or an edge proxy), pass a `fetchClient`:\n\n```typescript\nimport { useChat, fetchServerSentEvents } from \"@tanstack/ai-react\";\nimport { refreshToken } from \"./auth\";\n\nasync function authedFetch(input: RequestInfo | URL, init?: RequestInit) {\n  let response = await fetch(input, init);\n  if (response.status === 401) {\n    await refreshToken();\n    response = await fetch(input, init);\n  }\n  return response;\n}\n\nconst { messages } = useChat({\n  connection: fetchServerSentEvents(\"/api/chat\", {\n    fetchClient: authedFetch,\n  }),\n});\n```\n\nThe `fetchClient` must have the standard `fetch` signature. `fetchHttpStream` accepts the same option. For a production example, see the [Cloudflare Adapter](../community-adapters/cloudflare).\n\nSend a message. Your server gets the header, the body data, and the messages in one request.\n"}
