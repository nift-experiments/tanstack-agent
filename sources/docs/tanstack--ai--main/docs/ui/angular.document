{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/ai-angular"},{"type":"text","value":". Import the UI factory from "},{"type":"inlineCode","value":"@tanstack/ai-angular/ui"},{"type":"text","value":". Call "},{"type":"inlineCode","value":"createChatHook({ options, ...components })"},{"type":"text","value":" once at module scope."}]},{"type":"paragraph","children":[{"type":"text","value":"This is not a React port. Widgets are standalone Angular components. Chat state from "},{"type":"inlineCode","value":"injectAppChat()"},{"type":"text","value":" is signals. Layout slots are component classes. Your layout template uses "},{"type":"inlineCode","value":"NgComponentOutlet"},{"type":"text","value":" to render "},{"type":"inlineCode","value":"Messages"},{"type":"text","value":", "},{"type":"inlineCode","value":"Interrupts"},{"type":"text","value":", "},{"type":"inlineCode","value":"Queue"},{"type":"text","value":", and "},{"type":"inlineCode","value":"Input"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The factory returns "},{"type":"inlineCode","value":"injectAppChat"},{"type":"text","value":", "},{"type":"inlineCode","value":"injectChatContext"},{"type":"text","value":", and "},{"type":"inlineCode","value":"Chat"},{"type":"text","value":". Call "},{"type":"inlineCode","value":"injectAppChat()"},{"type":"text","value":" in a component injection context. Bind the instance with "},{"type":"inlineCode","value":"<ai-chat [chat]=\"chat\" />"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The factory needs a "},{"type":"inlineCode","value":"toolsComponents"},{"type":"text","value":" entry for every tool name in "},{"type":"inlineCode","value":"chatOptions"},{"type":"text","value":". It also needs an "},{"type":"inlineCode","value":"interruptsComponents.generic"},{"type":"text","value":" entry for every interrupt id. "},{"type":"inlineCode","value":"generic.fallback"},{"type":"text","value":" is optional."}]},{"type":"paragraph","children":[{"type":"text","value":"The server route matches the "},{"type":"link","href":"./react","children":[{"type":"text","value":"React page"}]},{"type":"text","value":". The "},{"type":"link","href":"./recipes/index","children":[{"type":"text","value":"chat UI recipes"}]},{"type":"text","value":" show the same option groups. The code there is React. On Angular, each widget is a component class with "},{"type":"inlineCode","value":"input()"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"client","children":[{"type":"text","value":"Client"}]},{"type":"code","value":"import { Component, input } from '@angular/core'\nimport { NgComponentOutlet } from '@angular/common'\nimport type { Type } from '@angular/core'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { createChatHook } from '@tanstack/ai-angular/ui'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst getWeather = toolDefinition({\n  name: 'getWeather',\n  description: 'Look up weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temperature: z.number() }),\n}).client()\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [getWeather],\n}\n\n@Component({\n  selector: 'app-chat-layout',\n  imports: [NgComponentOutlet],\n  template: `\n    <ng-container [ngComponentOutlet]=\"Messages()\" />\n    @if (Input(); as inputCmp) {\n      <ng-container [ngComponentOutlet]=\"inputCmp\" />\n    }\n  `,\n})\nexport class ChatLayout {\n  Messages = input.required<Type<unknown>>()\n  Interrupts = input.required<Type<unknown>>()\n  Queue = input.required<Type<unknown>>()\n  Input = input<Type<unknown>>()\n}\n\n@Component({\n  selector: 'app-chat-message',\n  imports: [NgComponentOutlet],\n  template: `\n    <article>\n      <ng-container\n        [ngComponentOutlet]=\"Parts()\"\n        [ngComponentOutletInputs]=\"{ message: message() }\"\n      />\n    </article>\n  `,\n})\nexport class ChatMessage {\n  message = input.required<unknown>()\n  Parts = input.required<Type<unknown>>()\n}\n\n@Component({\n  selector: 'app-weather-tool',\n  template: `<strong>{{ part().input?.city }}</strong>`,\n})\nexport class WeatherTool {\n  part = input.required<{ input?: { city?: string } }>()\n  result = input<unknown>()\n  interrupt = input<unknown>()\n}\n\nconst { injectAppChat, Chat } = createChatHook({\n  options: chatOptions,\n  components: { layout: ChatLayout, message: ChatMessage },\n  partsComponents: { fallback: ChatMessage },\n  toolsComponents: { getWeather: WeatherTool },\n})\n\n@Component({\n  selector: 'app-chat-screen',\n  imports: [Chat],\n  template: `<ai-chat [chat]=\"chat\" />`,\n})\nexport class ChatScreen {\n  chat = injectAppChat()\n}","lang":"ts"}],"headings":[{"id":"client","text":"Client","level":2}]},"frameworks":[],"downloadMarkdown":"\nInstall `@tanstack/ai-angular`. Import the UI factory from `@tanstack/ai-angular/ui`. Call `createChatHook({ options, ...components })` once at module scope.\n\nThis is not a React port. Widgets are standalone Angular components. Chat state from `injectAppChat()` is signals. Layout slots are component classes. Your layout template uses `NgComponentOutlet` to render `Messages`, `Interrupts`, `Queue`, and `Input`.\n\nThe factory returns `injectAppChat`, `injectChatContext`, and `Chat`. Call `injectAppChat()` in a component injection context. Bind the instance with `<ai-chat [chat]=\"chat\" />`.\n\nThe factory needs a `toolsComponents` entry for every tool name in `chatOptions`. It also needs an `interruptsComponents.generic` entry for every interrupt id. `generic.fallback` is optional.\n\nThe server route matches the [React page](./react). The [chat UI recipes](./recipes/index) show the same option groups. The code there is React. On Angular, each widget is a component class with `input()`.\n\n## Client\n\n```ts\nimport { Component, input } from '@angular/core'\nimport { NgComponentOutlet } from '@angular/common'\nimport type { Type } from '@angular/core'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { createChatHook } from '@tanstack/ai-angular/ui'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst getWeather = toolDefinition({\n  name: 'getWeather',\n  description: 'Look up weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temperature: z.number() }),\n}).client()\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [getWeather],\n}\n\n@Component({\n  selector: 'app-chat-layout',\n  imports: [NgComponentOutlet],\n  template: `\n    <ng-container [ngComponentOutlet]=\"Messages()\" />\n    @if (Input(); as inputCmp) {\n      <ng-container [ngComponentOutlet]=\"inputCmp\" />\n    }\n  `,\n})\nexport class ChatLayout {\n  Messages = input.required<Type<unknown>>()\n  Interrupts = input.required<Type<unknown>>()\n  Queue = input.required<Type<unknown>>()\n  Input = input<Type<unknown>>()\n}\n\n@Component({\n  selector: 'app-chat-message',\n  imports: [NgComponentOutlet],\n  template: `\n    <article>\n      <ng-container\n        [ngComponentOutlet]=\"Parts()\"\n        [ngComponentOutletInputs]=\"{ message: message() }\"\n      />\n    </article>\n  `,\n})\nexport class ChatMessage {\n  message = input.required<unknown>()\n  Parts = input.required<Type<unknown>>()\n}\n\n@Component({\n  selector: 'app-weather-tool',\n  template: `<strong>{{ part().input?.city }}</strong>`,\n})\nexport class WeatherTool {\n  part = input.required<{ input?: { city?: string } }>()\n  result = input<unknown>()\n  interrupt = input<unknown>()\n}\n\nconst { injectAppChat, Chat } = createChatHook({\n  options: chatOptions,\n  components: { layout: ChatLayout, message: ChatMessage },\n  partsComponents: { fallback: ChatMessage },\n  toolsComponents: { getWeather: WeatherTool },\n})\n\n@Component({\n  selector: 'app-chat-screen',\n  imports: [Chat],\n  template: `<ai-chat [chat]=\"chat\" />`,\n})\nexport class ChatScreen {\n  chat = injectAppChat()\n}\n```\n","originalRawMarkdown":"---\ntitle: Angular Chat UI\nid: typed-headless-ui-angular\norder: 8\ndescription: \"Build a typed, headless Angular chat UI with createChatHook. Widgets are standalone components. Chat state is signals.\"\nkeywords:\n  - tanstack ai\n  - createChatHook\n  - angular\n  - injectAppChat\n  - headless ui\n  - ToolProps\n---\n\nInstall `@tanstack/ai-angular`. Import the UI factory from `@tanstack/ai-angular/ui`. Call `createChatHook({ options, ...components })` once at module scope.\n\nThis is not a React port. Widgets are standalone Angular components. Chat state from `injectAppChat()` is signals. Layout slots are component classes. Your layout template uses `NgComponentOutlet` to render `Messages`, `Interrupts`, `Queue`, and `Input`.\n\nThe factory returns `injectAppChat`, `injectChatContext`, and `Chat`. Call `injectAppChat()` in a component injection context. Bind the instance with `<ai-chat [chat]=\"chat\" />`.\n\nThe factory needs a `toolsComponents` entry for every tool name in `chatOptions`. It also needs an `interruptsComponents.generic` entry for every interrupt id. `generic.fallback` is optional.\n\nThe server route matches the [React page](./react). The [chat UI recipes](./recipes/index) show the same option groups. The code there is React. On Angular, each widget is a component class with `input()`.\n\n## Client\n\n```ts\nimport { Component, input } from '@angular/core'\nimport { NgComponentOutlet } from '@angular/common'\nimport type { Type } from '@angular/core'\nimport { fetchServerSentEvents } from '@tanstack/ai-client'\nimport { createChatHook } from '@tanstack/ai-angular/ui'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst getWeather = toolDefinition({\n  name: 'getWeather',\n  description: 'Look up weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temperature: z.number() }),\n}).client()\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [getWeather],\n}\n\n@Component({\n  selector: 'app-chat-layout',\n  imports: [NgComponentOutlet],\n  template: `\n    <ng-container [ngComponentOutlet]=\"Messages()\" />\n    @if (Input(); as inputCmp) {\n      <ng-container [ngComponentOutlet]=\"inputCmp\" />\n    }\n  `,\n})\nexport class ChatLayout {\n  Messages = input.required<Type<unknown>>()\n  Interrupts = input.required<Type<unknown>>()\n  Queue = input.required<Type<unknown>>()\n  Input = input<Type<unknown>>()\n}\n\n@Component({\n  selector: 'app-chat-message',\n  imports: [NgComponentOutlet],\n  template: `\n    <article>\n      <ng-container\n        [ngComponentOutlet]=\"Parts()\"\n        [ngComponentOutletInputs]=\"{ message: message() }\"\n      />\n    </article>\n  `,\n})\nexport class ChatMessage {\n  message = input.required<unknown>()\n  Parts = input.required<Type<unknown>>()\n}\n\n@Component({\n  selector: 'app-weather-tool',\n  template: `<strong>{{ part().input?.city }}</strong>`,\n})\nexport class WeatherTool {\n  part = input.required<{ input?: { city?: string } }>()\n  result = input<unknown>()\n  interrupt = input<unknown>()\n}\n\nconst { injectAppChat, Chat } = createChatHook({\n  options: chatOptions,\n  components: { layout: ChatLayout, message: ChatMessage },\n  partsComponents: { fallback: ChatMessage },\n  toolsComponents: { getWeather: WeatherTool },\n})\n\n@Component({\n  selector: 'app-chat-screen',\n  imports: [Chat],\n  template: `<ai-chat [chat]=\"chat\" />`,\n})\nexport class ChatScreen {\n  chat = injectAppChat()\n}\n```\n"}
