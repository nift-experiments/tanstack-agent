{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Model replies include fenced code. "},{"type":"inlineCode","value":"TextPart"},{"type":"text","value":" renders those fences as plain text until you pass a "},{"type":"inlineCode","value":"highlighter"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Build a TanStack Highlight callback. Pass it to "},{"type":"inlineCode","value":"TextPart"},{"type":"text","value":". Token colors then show on fenced blocks."}]},{"type":"paragraph","children":[{"type":"text","value":"If your app still passes "},{"type":"inlineCode","value":"remarkPlugins"},{"type":"text","value":" or "},{"type":"inlineCode","value":"rehypePlugins"},{"type":"text","value":", start with "},{"type":"link","href":"../migration/text-part-markdown","children":[{"type":"text","value":"TextPart markdown"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"1-install-tanstack-highlight","children":[{"type":"text","value":"1. Install TanStack Highlight"}]},{"type":"code","value":"pnpm add @tanstack/highlight","lang":"sh"},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"@tanstack/highlight"},{"type":"text","value":" 0.0.6 or newer. The Markdown adapter lives in that package."}]},{"type":"heading","depth":2,"id":"2-create-the-highlighter","children":[{"type":"text","value":"2. Create the highlighter"}]},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/markdown-highlighter.ts"},{"type":"text","value":". Register only the languages your models emit."}]},{"type":"code","value":"import { createHighlighter } from '@tanstack/highlight/core'\nimport { js } from '@tanstack/highlight/languages/js'\nimport { json } from '@tanstack/highlight/languages/json'\nimport { plaintext } from '@tanstack/highlight/languages/plaintext'\nimport { ts } from '@tanstack/highlight/languages/ts'\nimport { tsx } from '@tanstack/highlight/languages/tsx'\nimport { createTanStackMarkdownHighlighter } from '@tanstack/highlight/markdown'\nimport type { CodeHighlighter } from '@tanstack/markdown'\n\nconst highlighter = createHighlighter({\n  languages: [plaintext, js, json, ts, tsx],\n})\n\nexport const highlightMarkdownCode: CodeHighlighter =\n  createTanStackMarkdownHighlighter(highlighter)","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Unknown fence languages render as escaped plain text."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"CAUTION:"}]},{"type":"text","value":" Highlighter output is inserted as trusted HTML. Use "},{"type":"inlineCode","value":"createTanStackMarkdownHighlighter"},{"type":"text","value":". Do not pass a highlighter that returns unescaped source text."}]}]},{"type":"heading","depth":2,"id":"3-create-the-theme-css","children":[{"type":"text","value":"3. Create the theme CSS"}]},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/markdown-highlight-theme.ts"},{"type":"text","value":". Point the selectors at a "},{"type":"inlineCode","value":".markdown-renderer"},{"type":"text","value":" wrapper."}]},{"type":"code","value":"import { createThemeCss } from '@tanstack/highlight/theme'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nexport const markdownHighlightCss = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: '.markdown-renderer',\n  darkSelector: '.dark .markdown-renderer',\n  codeBlockSelector: '.markdown-renderer pre.tm-code',\n  lineNumbersSelector: '.markdown-renderer .tm-code--line-numbers',\n})","lang":"ts"},{"type":"heading","depth":2,"id":"4-pass-it-to-textpart","children":[{"type":"text","value":"4. Pass it to TextPart"}]},{"type":"paragraph","children":[{"type":"text","value":"Put "},{"type":"inlineCode","value":"markdown-renderer"},{"type":"text","value":" on the "},{"type":"inlineCode","value":"TextPart"},{"type":"text","value":" wrapper so the theme CSS matches."}]},{"type":"code","value":"import { TextPart } from '@tanstack/ai-react/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport function Reply({ content }: { content: string }) {\n  return (\n    <TextPart\n      content={content}\n      highlighter={highlightMarkdownCode}\n      className=\"markdown-renderer\"\n    />\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"5-wire-it-into-createchathook","children":[{"type":"text","value":"5. Wire it into createChatHook"}]},{"type":"paragraph","children":[{"type":"text","value":"Inject the CSS once in "},{"type":"inlineCode","value":"layout"},{"type":"text","value":". Register "},{"type":"inlineCode","value":"TextPart"},{"type":"text","value":" as "},{"type":"inlineCode","value":"partsComponents.text"},{"type":"text","value":"."}]},{"type":"code","value":"import { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook, TextPart } from '@tanstack/ai-react/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\nimport { markdownHighlightCss } from './markdown-highlight-theme'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, useChatContext } = createChatHook({\n  options: chatOptions,\n  components: {\n    input: () => {\n      const chat = useChatContext()\n      return (\n        <form\n          onSubmit={(event) => {\n            event.preventDefault()\n            const field = event.currentTarget.elements.namedItem('message')\n            if (!(field instanceof HTMLInputElement)) return\n            const text = field.value.trim()\n            if (!text) return\n            field.value = ''\n            void chat.sendMessage(text)\n          }}\n        >\n          <input name=\"message\" />\n          <button type=\"submit\">Send</button>\n        </form>\n      )\n    },\n    layout: ({ Messages, Input }) => (\n      <main>\n        <style>{markdownHighlightCss}</style>\n        <Messages />\n        <Input />\n      </main>\n    ),\n    message: ({ message, Parts }) => (\n      <article data-role={message.role}>\n        <Parts />\n      </article>\n    ),\n  },\n  partsComponents: {\n    text: ({ part }) => (\n      <TextPart\n        content={part.content}\n        highlighter={highlightMarkdownCode}\n        className=\"markdown-renderer\"\n      />\n    ),\n    fallback: () => null,\n  },\n})\n\nexport function ChatScreen() {\n  const chat = useAppChat()\n  return <chat.AppChat />\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Send a prompt that returns a fenced "},{"type":"inlineCode","value":"ts"},{"type":"text","value":" block. The fence now shows token colors."}]},{"type":"heading","depth":2,"id":"vue-and-solid","children":[{"type":"text","value":"Vue and Solid"}]},{"type":"paragraph","children":[{"type":"text","value":"Use the same highlighter file and the same theme file. The "},{"type":"inlineCode","value":"TextPart"},{"type":"text","value":" import changes. Inject "},{"type":"inlineCode","value":"markdownHighlightCss"},{"type":"text","value":" once at the app root."}]},{"type":"heading","depth":3,"id":"vue","children":[{"type":"text","value":"Vue"}]},{"type":"code","value":"import { defineComponent, h } from 'vue'\nimport { TextPart } from '@tanstack/ai-vue/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport default defineComponent({\n  props: { content: { type: String, required: true } },\n  setup(props) {\n    return () =>\n      h(TextPart, {\n        content: props.content,\n        highlighter: highlightMarkdownCode,\n        class: 'markdown-renderer',\n      })\n  },\n})","lang":"ts"},{"type":"heading","depth":3,"id":"solid","children":[{"type":"text","value":"Solid"}]},{"type":"code","value":"import { TextPart } from '@tanstack/ai-solid/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport function Reply(props: { content: string }) {\n  return (\n    <TextPart\n      content={props.content}\n      highlighter={highlightMarkdownCode}\n      class=\"markdown-renderer\"\n    />\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Vue and Solid have no "},{"type":"inlineCode","value":"components"},{"type":"text","value":" map. Tag swaps go through a TanStack Markdown "},{"type":"inlineCode","value":"extension"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"later","children":[{"type":"text","value":"Later"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"More languages: import them from "},{"type":"inlineCode","value":"@tanstack/highlight/languages/*"},{"type":"text","value":" and add them to "},{"type":"inlineCode","value":"createHighlighter"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Fence metadata and line numbers: see the "},{"type":"link","href":"https://tanstack.com/markdown/latest/docs/guides/syntax-highlighting","children":[{"type":"text","value":"TanStack Markdown highlighting guide"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"React tag swaps ("},{"type":"inlineCode","value":"a"},{"type":"text","value":", "},{"type":"inlineCode","value":"img"},{"type":"text","value":"): pass "},{"type":"inlineCode","value":"components"},{"type":"text","value":" on "},{"type":"inlineCode","value":"TextPart"},{"type":"text","value":". That map uses normal HTML props, not "},{"type":"inlineCode","value":"react-markdown"},{"type":"text","value":" extras such as "},{"type":"inlineCode","value":"inline"},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"1-install-tanstack-highlight","text":"1. Install TanStack Highlight","level":2},{"id":"2-create-the-highlighter","text":"2. Create the highlighter","level":2},{"id":"3-create-the-theme-css","text":"3. Create the theme CSS","level":2},{"id":"4-pass-it-to-textpart","text":"4. Pass it to TextPart","level":2},{"id":"5-wire-it-into-createchathook","text":"5. Wire it into createChatHook","level":2},{"id":"vue-and-solid","text":"Vue and Solid","level":2},{"id":"vue","text":"Vue","level":3},{"id":"solid","text":"Solid","level":3},{"id":"later","text":"Later","level":2}]},"frameworks":[],"downloadMarkdown":"\nModel replies include fenced code. `TextPart` renders those fences as plain text until you pass a `highlighter`.\n\nBuild a TanStack Highlight callback. Pass it to `TextPart`. Token colors then show on fenced blocks.\n\nIf your app still passes `remarkPlugins` or `rehypePlugins`, start with [TextPart markdown](../migration/text-part-markdown).\n\n## 1. Install TanStack Highlight\n\n```sh\npnpm add @tanstack/highlight\n```\n\nUse `@tanstack/highlight` 0.0.6 or newer. The Markdown adapter lives in that package.\n\n## 2. Create the highlighter\n\nCreate `src/markdown-highlighter.ts`. Register only the languages your models emit.\n\n```ts\nimport { createHighlighter } from '@tanstack/highlight/core'\nimport { js } from '@tanstack/highlight/languages/js'\nimport { json } from '@tanstack/highlight/languages/json'\nimport { plaintext } from '@tanstack/highlight/languages/plaintext'\nimport { ts } from '@tanstack/highlight/languages/ts'\nimport { tsx } from '@tanstack/highlight/languages/tsx'\nimport { createTanStackMarkdownHighlighter } from '@tanstack/highlight/markdown'\nimport type { CodeHighlighter } from '@tanstack/markdown'\n\nconst highlighter = createHighlighter({\n  languages: [plaintext, js, json, ts, tsx],\n})\n\nexport const highlightMarkdownCode: CodeHighlighter =\n  createTanStackMarkdownHighlighter(highlighter)\n```\n\nUnknown fence languages render as escaped plain text.\n\n> **CAUTION:** Highlighter output is inserted as trusted HTML. Use `createTanStackMarkdownHighlighter`. Do not pass a highlighter that returns unescaped source text.\n\n## 3. Create the theme CSS\n\nCreate `src/markdown-highlight-theme.ts`. Point the selectors at a `.markdown-renderer` wrapper.\n\n```ts\nimport { createThemeCss } from '@tanstack/highlight/theme'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nexport const markdownHighlightCss = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: '.markdown-renderer',\n  darkSelector: '.dark .markdown-renderer',\n  codeBlockSelector: '.markdown-renderer pre.tm-code',\n  lineNumbersSelector: '.markdown-renderer .tm-code--line-numbers',\n})\n```\n\n## 4. Pass it to TextPart\n\nPut `markdown-renderer` on the `TextPart` wrapper so the theme CSS matches.\n\n```tsx\nimport { TextPart } from '@tanstack/ai-react/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport function Reply({ content }: { content: string }) {\n  return (\n    <TextPart\n      content={content}\n      highlighter={highlightMarkdownCode}\n      className=\"markdown-renderer\"\n    />\n  )\n}\n```\n\n## 5. Wire it into createChatHook\n\nInject the CSS once in `layout`. Register `TextPart` as `partsComponents.text`.\n\n```tsx\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook, TextPart } from '@tanstack/ai-react/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\nimport { markdownHighlightCss } from './markdown-highlight-theme'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, useChatContext } = createChatHook({\n  options: chatOptions,\n  components: {\n    input: () => {\n      const chat = useChatContext()\n      return (\n        <form\n          onSubmit={(event) => {\n            event.preventDefault()\n            const field = event.currentTarget.elements.namedItem('message')\n            if (!(field instanceof HTMLInputElement)) return\n            const text = field.value.trim()\n            if (!text) return\n            field.value = ''\n            void chat.sendMessage(text)\n          }}\n        >\n          <input name=\"message\" />\n          <button type=\"submit\">Send</button>\n        </form>\n      )\n    },\n    layout: ({ Messages, Input }) => (\n      <main>\n        <style>{markdownHighlightCss}</style>\n        <Messages />\n        <Input />\n      </main>\n    ),\n    message: ({ message, Parts }) => (\n      <article data-role={message.role}>\n        <Parts />\n      </article>\n    ),\n  },\n  partsComponents: {\n    text: ({ part }) => (\n      <TextPart\n        content={part.content}\n        highlighter={highlightMarkdownCode}\n        className=\"markdown-renderer\"\n      />\n    ),\n    fallback: () => null,\n  },\n})\n\nexport function ChatScreen() {\n  const chat = useAppChat()\n  return <chat.AppChat />\n}\n```\n\nSend a prompt that returns a fenced `ts` block. The fence now shows token colors.\n\n## Vue and Solid\n\nUse the same highlighter file and the same theme file. The `TextPart` import changes. Inject `markdownHighlightCss` once at the app root.\n\n### Vue\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport { TextPart } from '@tanstack/ai-vue/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport default defineComponent({\n  props: { content: { type: String, required: true } },\n  setup(props) {\n    return () =>\n      h(TextPart, {\n        content: props.content,\n        highlighter: highlightMarkdownCode,\n        class: 'markdown-renderer',\n      })\n  },\n})\n```\n\n### Solid\n\n```tsx\nimport { TextPart } from '@tanstack/ai-solid/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport function Reply(props: { content: string }) {\n  return (\n    <TextPart\n      content={props.content}\n      highlighter={highlightMarkdownCode}\n      class=\"markdown-renderer\"\n    />\n  )\n}\n```\n\nVue and Solid have no `components` map. Tag swaps go through a TanStack Markdown `extension`.\n\n## Later\n\n- More languages: import them from `@tanstack/highlight/languages/*` and add them to `createHighlighter`.\n- Fence metadata and line numbers: see the [TanStack Markdown highlighting guide](https://tanstack.com/markdown/latest/docs/guides/syntax-highlighting).\n- React tag swaps (`a`, `img`): pass `components` on `TextPart`. That map uses normal HTML props, not `react-markdown` extras such as `inline`.\n","originalRawMarkdown":"---\ntitle: Highlight markdown code\nid: ui-markdown-highlight\norder: 9\ndescription: \"Color fenced code in TextPart with TanStack Highlight.\"\nkeywords:\n  - tanstack ai\n  - TextPart\n  - markdown\n  - highlight\n  - syntax highlighting\n---\n\nModel replies include fenced code. `TextPart` renders those fences as plain text until you pass a `highlighter`.\n\nBuild a TanStack Highlight callback. Pass it to `TextPart`. Token colors then show on fenced blocks.\n\nIf your app still passes `remarkPlugins` or `rehypePlugins`, start with [TextPart markdown](../migration/text-part-markdown).\n\n## 1. Install TanStack Highlight\n\n```sh\npnpm add @tanstack/highlight\n```\n\nUse `@tanstack/highlight` 0.0.6 or newer. The Markdown adapter lives in that package.\n\n## 2. Create the highlighter\n\nCreate `src/markdown-highlighter.ts`. Register only the languages your models emit.\n\n```ts\nimport { createHighlighter } from '@tanstack/highlight/core'\nimport { js } from '@tanstack/highlight/languages/js'\nimport { json } from '@tanstack/highlight/languages/json'\nimport { plaintext } from '@tanstack/highlight/languages/plaintext'\nimport { ts } from '@tanstack/highlight/languages/ts'\nimport { tsx } from '@tanstack/highlight/languages/tsx'\nimport { createTanStackMarkdownHighlighter } from '@tanstack/highlight/markdown'\nimport type { CodeHighlighter } from '@tanstack/markdown'\n\nconst highlighter = createHighlighter({\n  languages: [plaintext, js, json, ts, tsx],\n})\n\nexport const highlightMarkdownCode: CodeHighlighter =\n  createTanStackMarkdownHighlighter(highlighter)\n```\n\nUnknown fence languages render as escaped plain text.\n\n> **CAUTION:** Highlighter output is inserted as trusted HTML. Use `createTanStackMarkdownHighlighter`. Do not pass a highlighter that returns unescaped source text.\n\n## 3. Create the theme CSS\n\nCreate `src/markdown-highlight-theme.ts`. Point the selectors at a `.markdown-renderer` wrapper.\n\n```ts\nimport { createThemeCss } from '@tanstack/highlight/theme'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nexport const markdownHighlightCss = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: '.markdown-renderer',\n  darkSelector: '.dark .markdown-renderer',\n  codeBlockSelector: '.markdown-renderer pre.tm-code',\n  lineNumbersSelector: '.markdown-renderer .tm-code--line-numbers',\n})\n```\n\n## 4. Pass it to TextPart\n\nPut `markdown-renderer` on the `TextPart` wrapper so the theme CSS matches.\n\n```tsx\nimport { TextPart } from '@tanstack/ai-react/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport function Reply({ content }: { content: string }) {\n  return (\n    <TextPart\n      content={content}\n      highlighter={highlightMarkdownCode}\n      className=\"markdown-renderer\"\n    />\n  )\n}\n```\n\n## 5. Wire it into createChatHook\n\nInject the CSS once in `layout`. Register `TextPart` as `partsComponents.text`.\n\n```tsx\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook, TextPart } from '@tanstack/ai-react/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\nimport { markdownHighlightCss } from './markdown-highlight-theme'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, useChatContext } = createChatHook({\n  options: chatOptions,\n  components: {\n    input: () => {\n      const chat = useChatContext()\n      return (\n        <form\n          onSubmit={(event) => {\n            event.preventDefault()\n            const field = event.currentTarget.elements.namedItem('message')\n            if (!(field instanceof HTMLInputElement)) return\n            const text = field.value.trim()\n            if (!text) return\n            field.value = ''\n            void chat.sendMessage(text)\n          }}\n        >\n          <input name=\"message\" />\n          <button type=\"submit\">Send</button>\n        </form>\n      )\n    },\n    layout: ({ Messages, Input }) => (\n      <main>\n        <style>{markdownHighlightCss}</style>\n        <Messages />\n        <Input />\n      </main>\n    ),\n    message: ({ message, Parts }) => (\n      <article data-role={message.role}>\n        <Parts />\n      </article>\n    ),\n  },\n  partsComponents: {\n    text: ({ part }) => (\n      <TextPart\n        content={part.content}\n        highlighter={highlightMarkdownCode}\n        className=\"markdown-renderer\"\n      />\n    ),\n    fallback: () => null,\n  },\n})\n\nexport function ChatScreen() {\n  const chat = useAppChat()\n  return <chat.AppChat />\n}\n```\n\nSend a prompt that returns a fenced `ts` block. The fence now shows token colors.\n\n## Vue and Solid\n\nUse the same highlighter file and the same theme file. The `TextPart` import changes. Inject `markdownHighlightCss` once at the app root.\n\n### Vue\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport { TextPart } from '@tanstack/ai-vue/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport default defineComponent({\n  props: { content: { type: String, required: true } },\n  setup(props) {\n    return () =>\n      h(TextPart, {\n        content: props.content,\n        highlighter: highlightMarkdownCode,\n        class: 'markdown-renderer',\n      })\n  },\n})\n```\n\n### Solid\n\n```tsx\nimport { TextPart } from '@tanstack/ai-solid/ui'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport function Reply(props: { content: string }) {\n  return (\n    <TextPart\n      content={props.content}\n      highlighter={highlightMarkdownCode}\n      class=\"markdown-renderer\"\n    />\n  )\n}\n```\n\nVue and Solid have no `components` map. Tag swaps go through a TanStack Markdown `extension`.\n\n## Later\n\n- More languages: import them from `@tanstack/highlight/languages/*` and add them to `createHighlighter`.\n- Fence metadata and line numbers: see the [TanStack Markdown highlighting guide](https://tanstack.com/markdown/latest/docs/guides/syntax-highlighting).\n- React tag swaps (`a`, `img`): pass `components` on `TextPart`. That map uses normal HTML props, not `react-markdown` extras such as `inline`.\n"}
