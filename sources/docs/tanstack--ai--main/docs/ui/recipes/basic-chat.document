{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Start here. This chat has no tools, no interrupts, and no styling."}]},{"type":"paragraph","children":[{"type":"text","value":"For a Start app with BYOK, open "},{"type":"link","href":"../../tutorials/basic-chat","children":[{"type":"text","value":"Basic Chat"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"You need three components: a "},{"type":"inlineCode","value":"layout"},{"type":"text","value":", a "},{"type":"inlineCode","value":"message"},{"type":"text","value":", and a "},{"type":"inlineCode","value":"text"},{"type":"text","value":" part. Leave the rest out."}]},{"type":"heading","depth":2,"id":"server","children":[{"type":"text","value":"Server"}]},{"type":"code","value":"import { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const json: unknown = await request.json()\n  if (typeof json !== 'object' || json === null || !('messages' in json)) {\n    return new Response('Invalid body', { status: 400 })\n  }\n  const messages = json.messages\n  const stream = chat({\n    adapter: openaiText('gpt-5.6'),\n    messages: Array.isArray(messages) ? messages : [],\n  })\n  return toServerSentEventsResponse(stream)\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"client","children":[{"type":"text","value":"Client"}]},{"type":"code","value":"import { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook } from '@tanstack/ai-react/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, useChatContext } = createChatHook({\n  options: chatOptions,\n  components: {\n    input: () => {\n      const chat = useChatContext()\n      return (\n        <form\n          onSubmit={(event) => {\n            event.preventDefault()\n            const field = event.currentTarget.elements.namedItem('message')\n            if (!(field instanceof HTMLInputElement)) return\n            const text = field.value.trim()\n            if (!text) return\n            field.value = ''\n            void chat.sendMessage(text)\n          }}\n        >\n          <input name=\"message\" />\n          <button type=\"submit\">Send</button>\n        </form>\n      )\n    },\n    layout: ({ Messages, Input }) => (\n      <main>\n        <Messages />\n        <Input />\n      </main>\n    ),\n    message: ({ message, Parts }) => (\n      <article data-role={message.role}>\n        <Parts />\n      </article>\n    ),\n  },\n  partsComponents: {\n    text: ({ part }) => <p>{part.content}</p>,\n    fallback: () => null,\n  },\n})\n\nexport function ChatScreen() {\n  const chat = useAppChat()\n  return <chat.AppChat />\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Render "},{"type":"inlineCode","value":"<ChatScreen />"},{"type":"text","value":". Type a message. The reply streams into the page."}]},{"type":"heading","depth":2,"id":"what-each-piece-does","children":[{"type":"text","value":"What each piece does"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"layout"},{"type":"text","value":" gets "},{"type":"inlineCode","value":"Messages"},{"type":"text","value":", "},{"type":"inlineCode","value":"Interrupts"},{"type":"text","value":", and "},{"type":"inlineCode","value":"Input"},{"type":"text","value":" as components. Render them where you want them. "},{"type":"inlineCode","value":"Interrupts"},{"type":"text","value":" is unused here, so leave it out."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"message"},{"type":"text","value":" gets one message plus a "},{"type":"inlineCode","value":"Parts"},{"type":"text","value":" component. "},{"type":"inlineCode","value":"Parts"},{"type":"text","value":" walks that message and picks a component per part."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"partsComponents.text"},{"type":"text","value":" renders text parts. "},{"type":"inlineCode","value":"fallback"},{"type":"text","value":" catches every part type you did not register. It returns "},{"type":"inlineCode","value":"null"},{"type":"text","value":" here, so anything else is silent."}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"One tool that renders as raw JSON? See "},{"type":"link","href":"./format-a-tool","children":[{"type":"text","value":"format a tool"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Need the user to approve something? See "},{"type":"link","href":"./tool-approval","children":[{"type":"text","value":"tool approval"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Want markdown with colored fences? See "},{"type":"link","href":"../markdown","children":[{"type":"text","value":"Highlight markdown code"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Using Solid, Vue, or Svelte? The same shape applies. See "},{"type":"link","href":"../solid","children":[{"type":"text","value":"Solid"}]},{"type":"text","value":", "},{"type":"link","href":"../vue","children":[{"type":"text","value":"Vue"}]},{"type":"text","value":", or "},{"type":"link","href":"../svelte","children":[{"type":"text","value":"Svelte"}]},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"server","text":"Server","level":2},{"id":"client","text":"Client","level":2},{"id":"what-each-piece-does","text":"What each piece does","level":2},{"id":"next","text":"Next","level":2}]},"frameworks":[],"downloadMarkdown":"\nStart here. This chat has no tools, no interrupts, and no styling.\n\nFor a Start app with BYOK, open [Basic Chat](../../tutorials/basic-chat).\n\nYou need three components: a `layout`, a `message`, and a `text` part. Leave the rest out.\n\n## Server\n\n```tsx\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const json: unknown = await request.json()\n  if (typeof json !== 'object' || json === null || !('messages' in json)) {\n    return new Response('Invalid body', { status: 400 })\n  }\n  const messages = json.messages\n  const stream = chat({\n    adapter: openaiText('gpt-5.6'),\n    messages: Array.isArray(messages) ? messages : [],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n## Client\n\n```tsx\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook } from '@tanstack/ai-react/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, useChatContext } = createChatHook({\n  options: chatOptions,\n  components: {\n    input: () => {\n      const chat = useChatContext()\n      return (\n        <form\n          onSubmit={(event) => {\n            event.preventDefault()\n            const field = event.currentTarget.elements.namedItem('message')\n            if (!(field instanceof HTMLInputElement)) return\n            const text = field.value.trim()\n            if (!text) return\n            field.value = ''\n            void chat.sendMessage(text)\n          }}\n        >\n          <input name=\"message\" />\n          <button type=\"submit\">Send</button>\n        </form>\n      )\n    },\n    layout: ({ Messages, Input }) => (\n      <main>\n        <Messages />\n        <Input />\n      </main>\n    ),\n    message: ({ message, Parts }) => (\n      <article data-role={message.role}>\n        <Parts />\n      </article>\n    ),\n  },\n  partsComponents: {\n    text: ({ part }) => <p>{part.content}</p>,\n    fallback: () => null,\n  },\n})\n\nexport function ChatScreen() {\n  const chat = useAppChat()\n  return <chat.AppChat />\n}\n```\n\nRender `<ChatScreen />`. Type a message. The reply streams into the page.\n\n## What each piece does\n\n`layout` gets `Messages`, `Interrupts`, and `Input` as components. Render them where you want them. `Interrupts` is unused here, so leave it out.\n\n`message` gets one message plus a `Parts` component. `Parts` walks that message and picks a component per part.\n\n`partsComponents.text` renders text parts. `fallback` catches every part type you did not register. It returns `null` here, so anything else is silent.\n\n## Next\n\n- One tool that renders as raw JSON? See [format a tool](./format-a-tool).\n- Need the user to approve something? See [tool approval](./tool-approval).\n- Want markdown with colored fences? See [Highlight markdown code](../markdown).\n- Using Solid, Vue, or Svelte? The same shape applies. See [Solid](../solid), [Vue](../vue), or [Svelte](../svelte).\n","originalRawMarkdown":"---\ntitle: A chat box with no tools\nid: ui-recipe-basic-chat\norder: 1\ndescription: \"The smallest working React chat UI. A layout, a message, and a text part.\"\nkeywords:\n  - tanstack ai\n  - createChatHook\n  - chat ui\n  - example\n---\n\nStart here. This chat has no tools, no interrupts, and no styling.\n\nFor a Start app with BYOK, open [Basic Chat](../../tutorials/basic-chat).\n\nYou need three components: a `layout`, a `message`, and a `text` part. Leave the rest out.\n\n## Server\n\n```tsx\nimport { chat, toServerSentEventsResponse } from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const json: unknown = await request.json()\n  if (typeof json !== 'object' || json === null || !('messages' in json)) {\n    return new Response('Invalid body', { status: 400 })\n  }\n  const messages = json.messages\n  const stream = chat({\n    adapter: openaiText('gpt-5.6'),\n    messages: Array.isArray(messages) ? messages : [],\n  })\n  return toServerSentEventsResponse(stream)\n}\n```\n\n## Client\n\n```tsx\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook } from '@tanstack/ai-react/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, useChatContext } = createChatHook({\n  options: chatOptions,\n  components: {\n    input: () => {\n      const chat = useChatContext()\n      return (\n        <form\n          onSubmit={(event) => {\n            event.preventDefault()\n            const field = event.currentTarget.elements.namedItem('message')\n            if (!(field instanceof HTMLInputElement)) return\n            const text = field.value.trim()\n            if (!text) return\n            field.value = ''\n            void chat.sendMessage(text)\n          }}\n        >\n          <input name=\"message\" />\n          <button type=\"submit\">Send</button>\n        </form>\n      )\n    },\n    layout: ({ Messages, Input }) => (\n      <main>\n        <Messages />\n        <Input />\n      </main>\n    ),\n    message: ({ message, Parts }) => (\n      <article data-role={message.role}>\n        <Parts />\n      </article>\n    ),\n  },\n  partsComponents: {\n    text: ({ part }) => <p>{part.content}</p>,\n    fallback: () => null,\n  },\n})\n\nexport function ChatScreen() {\n  const chat = useAppChat()\n  return <chat.AppChat />\n}\n```\n\nRender `<ChatScreen />`. Type a message. The reply streams into the page.\n\n## What each piece does\n\n`layout` gets `Messages`, `Interrupts`, and `Input` as components. Render them where you want them. `Interrupts` is unused here, so leave it out.\n\n`message` gets one message plus a `Parts` component. `Parts` walks that message and picks a component per part.\n\n`partsComponents.text` renders text parts. `fallback` catches every part type you did not register. It returns `null` here, so anything else is silent.\n\n## Next\n\n- One tool that renders as raw JSON? See [format a tool](./format-a-tool).\n- Need the user to approve something? See [tool approval](./tool-approval).\n- Want markdown with colored fences? See [Highlight markdown code](../markdown).\n- Using Solid, Vue, or Svelte? The same shape applies. See [Solid](../solid), [Vue](../vue), or [Svelte](../svelte).\n"}
