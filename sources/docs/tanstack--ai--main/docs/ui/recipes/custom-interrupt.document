{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"defineInterrupt"},{"type":"text","value":" when the question is not about approving a tool. The server pauses the run and asks. Your component answers."}]},{"type":"paragraph","children":[{"type":"text","value":"Two schemas define the exchange:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"payloadSchema"},{"type":"text","value":" is what the server sends you."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"responseSchema"},{"type":"text","value":" is what you send back."}]}]}]},{"type":"heading","depth":2,"id":"define-it","children":[{"type":"text","value":"Define it"}]},{"type":"code","value":"import { defineInterrupt } from '@tanstack/ai'\nimport { z } from 'zod'\n\nexport const choosePlan = defineInterrupt({\n  id: 'choosePlan',\n  payloadSchema: z.object({\n    options: z.array(z.string()),\n  }),\n  responseSchema: z.string(),\n})","lang":"tsx","meta":"group=plan-interrupt"},{"type":"paragraph","children":[{"type":"text","value":"The server sends a list of plan names. You send one name back."}]},{"type":"heading","depth":2,"id":"render-it","children":[{"type":"text","value":"Render it"}]},{"type":"paragraph","children":[{"type":"text","value":"Add the interrupt to "},{"type":"inlineCode","value":"chatOptions"},{"type":"text","value":", then register a component under "},{"type":"inlineCode","value":"interruptsComponents.generic"},{"type":"text","value":". The key is the interrupt id."}]},{"type":"code","value":"import { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook } from '@tanstack/ai-react/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  interrupts: [choosePlan],\n}\n\nconst { useAppChat } = createChatHook({\n  options: chatOptions,\n  components: {\n    layout: ({ Messages, Interrupts }) => (\n      <main>\n        <Messages />\n        <Interrupts />\n      </main>\n    ),\n    message: ({ Parts }) => <article><Parts /></article>,\n  },\n  partsComponents: {\n    text: ({ part }) => <p>{part.content}</p>,\n    fallback: () => null,\n  },\n  interruptsComponents: {\n    generic: {\n      choosePlan: ({ interrupt }) => (\n        <fieldset>\n          <legend>Pick a plan</legend>\n          {interrupt.payload?.options.map((plan) => (\n            <button key={plan} onClick={() => interrupt.resolveInterrupt(plan)}>\n              {plan}\n            </button>\n          ))}\n        </fieldset>\n      ),\n      fallback: ({ interrupt }) => <p>{interrupt.reason}</p>,\n    },\n  },\n})\n\nexport function PlanChat() {\n  const chat = useAppChat()\n  return <chat.AppChat />\n}","lang":"tsx","meta":"group=plan-interrupt"},{"type":"paragraph","children":[{"type":"inlineCode","value":"interrupt.payload"},{"type":"text","value":" matches your "},{"type":"inlineCode","value":"payloadSchema"},{"type":"text","value":", so "},{"type":"inlineCode","value":"options"},{"type":"text","value":" is a string array. "},{"type":"inlineCode","value":"resolveInterrupt"},{"type":"text","value":" accepts only what your "},{"type":"inlineCode","value":"responseSchema"},{"type":"text","value":" allows, so passing a number here is a compile error."}]},{"type":"heading","depth":2,"id":"generic-interrupts-always-render-in-the-list","children":[{"type":"text","value":"Generic interrupts always render in the list"}]},{"type":"paragraph","children":[{"type":"text","value":"A tool approval can render next to its tool. A generic interrupt cannot, because no tool owns it. Render "},{"type":"inlineCode","value":"Interrupts"},{"type":"text","value":" in your layout or it never appears."}]},{"type":"heading","depth":2,"id":"always-register-a-fallback","children":[{"type":"text","value":"Always register a fallback"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"fallback"},{"type":"text","value":" catches two things:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"An interrupt id you did not register."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"An unbound interrupt, which arrives with no id at all."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Branch on "},{"type":"inlineCode","value":"interrupt.kind === 'unbound'"},{"type":"text","value":" when the copy must differ."}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Approving a tool instead? See "},{"type":"link","href":"./tool-approval","children":[{"type":"text","value":"tool approval"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"More interrupt shapes and the protocol behind them: "},{"type":"link","href":"../../interrupts/generic","children":[{"type":"text","value":"generic interrupts"}]},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"define-it","text":"Define it","level":2},{"id":"render-it","text":"Render it","level":2},{"id":"generic-interrupts-always-render-in-the-list","text":"Generic interrupts always render in the list","level":2},{"id":"always-register-a-fallback","text":"Always register a fallback","level":2},{"id":"next","text":"Next","level":2}]},"frameworks":[],"downloadMarkdown":"\nUse `defineInterrupt` when the question is not about approving a tool. The server pauses the run and asks. Your component answers.\n\nTwo schemas define the exchange:\n\n1. `payloadSchema` is what the server sends you.\n2. `responseSchema` is what you send back.\n\n## Define it\n\n```tsx group=plan-interrupt\nimport { defineInterrupt } from '@tanstack/ai'\nimport { z } from 'zod'\n\nexport const choosePlan = defineInterrupt({\n  id: 'choosePlan',\n  payloadSchema: z.object({\n    options: z.array(z.string()),\n  }),\n  responseSchema: z.string(),\n})\n```\n\nThe server sends a list of plan names. You send one name back.\n\n## Render it\n\nAdd the interrupt to `chatOptions`, then register a component under `interruptsComponents.generic`. The key is the interrupt id.\n\n```tsx group=plan-interrupt\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook } from '@tanstack/ai-react/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  interrupts: [choosePlan],\n}\n\nconst { useAppChat } = createChatHook({\n  options: chatOptions,\n  components: {\n    layout: ({ Messages, Interrupts }) => (\n      <main>\n        <Messages />\n        <Interrupts />\n      </main>\n    ),\n    message: ({ Parts }) => <article><Parts /></article>,\n  },\n  partsComponents: {\n    text: ({ part }) => <p>{part.content}</p>,\n    fallback: () => null,\n  },\n  interruptsComponents: {\n    generic: {\n      choosePlan: ({ interrupt }) => (\n        <fieldset>\n          <legend>Pick a plan</legend>\n          {interrupt.payload?.options.map((plan) => (\n            <button key={plan} onClick={() => interrupt.resolveInterrupt(plan)}>\n              {plan}\n            </button>\n          ))}\n        </fieldset>\n      ),\n      fallback: ({ interrupt }) => <p>{interrupt.reason}</p>,\n    },\n  },\n})\n\nexport function PlanChat() {\n  const chat = useAppChat()\n  return <chat.AppChat />\n}\n```\n\n`interrupt.payload` matches your `payloadSchema`, so `options` is a string array. `resolveInterrupt` accepts only what your `responseSchema` allows, so passing a number here is a compile error.\n\n## Generic interrupts always render in the list\n\nA tool approval can render next to its tool. A generic interrupt cannot, because no tool owns it. Render `Interrupts` in your layout or it never appears.\n\n## Always register a fallback\n\n`fallback` catches two things:\n\n1. An interrupt id you did not register.\n2. An unbound interrupt, which arrives with no id at all.\n\nBranch on `interrupt.kind === 'unbound'` when the copy must differ.\n\n## Next\n\n- Approving a tool instead? See [tool approval](./tool-approval).\n- More interrupt shapes and the protocol behind them: [generic interrupts](../../interrupts/generic).\n","originalRawMarkdown":"---\ntitle: Ask the user your own question\nid: ui-recipe-custom-interrupt\norder: 4\ndescription: \"Define an interrupt with your own payload and response schemas, then render it in the chat.\"\nkeywords:\n  - tanstack ai\n  - defineInterrupt\n  - generic interrupt\n  - interruptsComponents\n  - example\n---\n\nUse `defineInterrupt` when the question is not about approving a tool. The server pauses the run and asks. Your component answers.\n\nTwo schemas define the exchange:\n\n1. `payloadSchema` is what the server sends you.\n2. `responseSchema` is what you send back.\n\n## Define it\n\n```tsx group=plan-interrupt\nimport { defineInterrupt } from '@tanstack/ai'\nimport { z } from 'zod'\n\nexport const choosePlan = defineInterrupt({\n  id: 'choosePlan',\n  payloadSchema: z.object({\n    options: z.array(z.string()),\n  }),\n  responseSchema: z.string(),\n})\n```\n\nThe server sends a list of plan names. You send one name back.\n\n## Render it\n\nAdd the interrupt to `chatOptions`, then register a component under `interruptsComponents.generic`. The key is the interrupt id.\n\n```tsx group=plan-interrupt\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook } from '@tanstack/ai-react/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  interrupts: [choosePlan],\n}\n\nconst { useAppChat } = createChatHook({\n  options: chatOptions,\n  components: {\n    layout: ({ Messages, Interrupts }) => (\n      <main>\n        <Messages />\n        <Interrupts />\n      </main>\n    ),\n    message: ({ Parts }) => <article><Parts /></article>,\n  },\n  partsComponents: {\n    text: ({ part }) => <p>{part.content}</p>,\n    fallback: () => null,\n  },\n  interruptsComponents: {\n    generic: {\n      choosePlan: ({ interrupt }) => (\n        <fieldset>\n          <legend>Pick a plan</legend>\n          {interrupt.payload?.options.map((plan) => (\n            <button key={plan} onClick={() => interrupt.resolveInterrupt(plan)}>\n              {plan}\n            </button>\n          ))}\n        </fieldset>\n      ),\n      fallback: ({ interrupt }) => <p>{interrupt.reason}</p>,\n    },\n  },\n})\n\nexport function PlanChat() {\n  const chat = useAppChat()\n  return <chat.AppChat />\n}\n```\n\n`interrupt.payload` matches your `payloadSchema`, so `options` is a string array. `resolveInterrupt` accepts only what your `responseSchema` allows, so passing a number here is a compile error.\n\n## Generic interrupts always render in the list\n\nA tool approval can render next to its tool. A generic interrupt cannot, because no tool owns it. Render `Interrupts` in your layout or it never appears.\n\n## Always register a fallback\n\n`fallback` catches two things:\n\n1. An interrupt id you did not register.\n2. An unbound interrupt, which arrives with no id at all.\n\nBranch on `interrupt.kind === 'unbound'` when the copy must differ.\n\n## Next\n\n- Approving a tool instead? See [tool approval](./tool-approval).\n- More interrupt shapes and the protocol behind them: [generic interrupts](../../interrupts/generic).\n"}
