{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Pass "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" to "},{"type":"inlineCode","value":"useAppChat()"},{"type":"text","value":". Every request from that instance carries it."}]},{"type":"code","value":"const chat = useAppChat({\n  forwardedProps: { tenantId: 'tenant_456' },\n})","lang":"tsx","meta":"ignore"},{"type":"paragraph","children":[{"type":"text","value":"The value never enters the prompt. The model does not see it."}]},{"type":"heading","depth":2,"id":"client","children":[{"type":"text","value":"Client"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" belongs on the screen, not on "},{"type":"inlineCode","value":"chatOptions"},{"type":"text","value":", because it changes per user."}]},{"type":"code","value":"import { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook } from '@tanstack/ai-react/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, useChatContext } = createChatHook({\n  options: chatOptions,\n  components: {\n    input: () => {\n      const chat = useChatContext()\n      return (\n        <button onClick={() => void chat.sendMessage('What are my invoices?')}>\n          Ask\n        </button>\n      )\n    },\n    layout: ({ Messages, Input }) => (\n      <main>\n        <Messages />\n        <Input />\n      </main>\n    ),\n    message: ({ Parts }) => <article><Parts /></article>,\n  },\n  partsComponents: {\n    text: ({ part }) => <p>{part.content}</p>,\n    fallback: () => null,\n  },\n})\n\nexport function TenantChat({ tenantId }: { tenantId: string }) {\n  const chat = useAppChat({\n    threadId: `tenant-${tenantId}`,\n    forwardedProps: { tenantId },\n  })\n  return <chat.AppChat />\n}","lang":"tsx","meta":"group=request-context"},{"type":"heading","depth":2,"id":"server","children":[{"type":"text","value":"Server"}]},{"type":"paragraph","children":[{"type":"text","value":"Read it with "},{"type":"inlineCode","value":"chatParamsFromRequest"},{"type":"text","value":", then map it into "},{"type":"inlineCode","value":"context"},{"type":"text","value":". Tools and middleware read "},{"type":"inlineCode","value":"context"},{"type":"text","value":"."}]},{"type":"code","value":"import {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request)\n\n  const tenantId =\n    typeof params.forwardedProps.tenantId === 'string'\n      ? params.forwardedProps.tenantId\n      : undefined\n  if (!tenantId) return new Response('Missing tenant', { status: 400 })\n\n  const stream = chat({\n    adapter: openaiText('gpt-5.6'),\n    messages: params.messages,\n    context: { tenantId },\n  })\n\n  return toServerSentEventsResponse(stream)\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"validate-it-always","children":[{"type":"text","value":"Validate it. Always."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" comes from the browser. A user can change it."}]},{"type":"paragraph","children":[{"type":"text","value":"Never trust it for identity or authorization. Get the user from your session or token on the server, and use "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" only for values that are safe to be wrong:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Derive the user id from the request's own auth, not from the client."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Check every forwarded field against a type or a schema."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Reject the request when a required field is missing."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The example above checks "},{"type":"inlineCode","value":"tenantId"},{"type":"text","value":" is a string, then refuses the request without it. In a real app you would also confirm the authenticated user may use that tenant."}]},{"type":"heading","depth":2,"id":"one-chat-per-user","children":[{"type":"text","value":"One chat per user"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass "},{"type":"inlineCode","value":"threadId"},{"type":"text","value":" alongside "},{"type":"inlineCode","value":"forwardedProps"},{"type":"text","value":" when a screen can show more than one chat. Two instances with different thread ids keep separate histories."}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Typed server dependencies for tools and middleware: "},{"type":"link","href":"../../advanced/runtime-context","children":[{"type":"text","value":"runtime context"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Local browser dependencies that stay on the client: "},{"type":"link","href":"../../tools/client-tools","children":[{"type":"text","value":"client tools"}]},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"client","text":"Client","level":2},{"id":"server","text":"Server","level":2},{"id":"validate-it-always","text":"Validate it. Always.","level":2},{"id":"one-chat-per-user","text":"One chat per user","level":2},{"id":"next","text":"Next","level":2}]},"frameworks":[],"downloadMarkdown":"\nPass `forwardedProps` to `useAppChat()`. Every request from that instance carries it.\n\n```tsx ignore\nconst chat = useAppChat({\n  forwardedProps: { tenantId: 'tenant_456' },\n})\n```\n\nThe value never enters the prompt. The model does not see it.\n\n## Client\n\n`forwardedProps` belongs on the screen, not on `chatOptions`, because it changes per user.\n\n```tsx group=request-context\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook } from '@tanstack/ai-react/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, useChatContext } = createChatHook({\n  options: chatOptions,\n  components: {\n    input: () => {\n      const chat = useChatContext()\n      return (\n        <button onClick={() => void chat.sendMessage('What are my invoices?')}>\n          Ask\n        </button>\n      )\n    },\n    layout: ({ Messages, Input }) => (\n      <main>\n        <Messages />\n        <Input />\n      </main>\n    ),\n    message: ({ Parts }) => <article><Parts /></article>,\n  },\n  partsComponents: {\n    text: ({ part }) => <p>{part.content}</p>,\n    fallback: () => null,\n  },\n})\n\nexport function TenantChat({ tenantId }: { tenantId: string }) {\n  const chat = useAppChat({\n    threadId: `tenant-${tenantId}`,\n    forwardedProps: { tenantId },\n  })\n  return <chat.AppChat />\n}\n```\n\n## Server\n\nRead it with `chatParamsFromRequest`, then map it into `context`. Tools and middleware read `context`.\n\n```tsx\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request)\n\n  const tenantId =\n    typeof params.forwardedProps.tenantId === 'string'\n      ? params.forwardedProps.tenantId\n      : undefined\n  if (!tenantId) return new Response('Missing tenant', { status: 400 })\n\n  const stream = chat({\n    adapter: openaiText('gpt-5.6'),\n    messages: params.messages,\n    context: { tenantId },\n  })\n\n  return toServerSentEventsResponse(stream)\n}\n```\n\n## Validate it. Always.\n\n`forwardedProps` comes from the browser. A user can change it.\n\nNever trust it for identity or authorization. Get the user from your session or token on the server, and use `forwardedProps` only for values that are safe to be wrong:\n\n1. Derive the user id from the request's own auth, not from the client.\n2. Check every forwarded field against a type or a schema.\n3. Reject the request when a required field is missing.\n\nThe example above checks `tenantId` is a string, then refuses the request without it. In a real app you would also confirm the authenticated user may use that tenant.\n\n## One chat per user\n\nPass `threadId` alongside `forwardedProps` when a screen can show more than one chat. Two instances with different thread ids keep separate histories.\n\n## Next\n\n- Typed server dependencies for tools and middleware: [runtime context](../../advanced/runtime-context).\n- Local browser dependencies that stay on the client: [client tools](../../tools/client-tools).\n","originalRawMarkdown":"---\ntitle: Send the current user to the server\nid: ui-recipe-request-context\norder: 5\ndescription: \"Pass a user id or tenant from the chat screen to your route with forwardedProps, without putting it in the prompt.\"\nkeywords:\n  - tanstack ai\n  - forwardedProps\n  - useAppChat\n  - runtime context\n  - example\n---\n\nPass `forwardedProps` to `useAppChat()`. Every request from that instance carries it.\n\n```tsx ignore\nconst chat = useAppChat({\n  forwardedProps: { tenantId: 'tenant_456' },\n})\n```\n\nThe value never enters the prompt. The model does not see it.\n\n## Client\n\n`forwardedProps` belongs on the screen, not on `chatOptions`, because it changes per user.\n\n```tsx group=request-context\nimport { fetchServerSentEvents } from '@tanstack/ai-react'\nimport { createChatHook } from '@tanstack/ai-react/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, useChatContext } = createChatHook({\n  options: chatOptions,\n  components: {\n    input: () => {\n      const chat = useChatContext()\n      return (\n        <button onClick={() => void chat.sendMessage('What are my invoices?')}>\n          Ask\n        </button>\n      )\n    },\n    layout: ({ Messages, Input }) => (\n      <main>\n        <Messages />\n        <Input />\n      </main>\n    ),\n    message: ({ Parts }) => <article><Parts /></article>,\n  },\n  partsComponents: {\n    text: ({ part }) => <p>{part.content}</p>,\n    fallback: () => null,\n  },\n})\n\nexport function TenantChat({ tenantId }: { tenantId: string }) {\n  const chat = useAppChat({\n    threadId: `tenant-${tenantId}`,\n    forwardedProps: { tenantId },\n  })\n  return <chat.AppChat />\n}\n```\n\n## Server\n\nRead it with `chatParamsFromRequest`, then map it into `context`. Tools and middleware read `context`.\n\n```tsx\nimport {\n  chat,\n  chatParamsFromRequest,\n  toServerSentEventsResponse,\n} from '@tanstack/ai'\nimport { openaiText } from '@tanstack/ai-openai'\n\nexport async function POST(request: Request) {\n  const params = await chatParamsFromRequest(request)\n\n  const tenantId =\n    typeof params.forwardedProps.tenantId === 'string'\n      ? params.forwardedProps.tenantId\n      : undefined\n  if (!tenantId) return new Response('Missing tenant', { status: 400 })\n\n  const stream = chat({\n    adapter: openaiText('gpt-5.6'),\n    messages: params.messages,\n    context: { tenantId },\n  })\n\n  return toServerSentEventsResponse(stream)\n}\n```\n\n## Validate it. Always.\n\n`forwardedProps` comes from the browser. A user can change it.\n\nNever trust it for identity or authorization. Get the user from your session or token on the server, and use `forwardedProps` only for values that are safe to be wrong:\n\n1. Derive the user id from the request's own auth, not from the client.\n2. Check every forwarded field against a type or a schema.\n3. Reject the request when a required field is missing.\n\nThe example above checks `tenantId` is a string, then refuses the request without it. In a real app you would also confirm the authenticated user may use that tenant.\n\n## One chat per user\n\nPass `threadId` alongside `forwardedProps` when a screen can show more than one chat. Two instances with different thread ids keep separate histories.\n\n## Next\n\n- Typed server dependencies for tools and middleware: [runtime context](../../advanced/runtime-context).\n- Local browser dependencies that stay on the client: [client tools](../../tools/client-tools).\n"}
