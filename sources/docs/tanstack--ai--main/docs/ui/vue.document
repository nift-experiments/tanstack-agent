NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/ai-vue"},{"type":"text","value":". Import the UI factory from "},{"type":"inlineCode","value":"@tanstack/ai-vue/ui"},{"type":"text","value":". Call "},{"type":"inlineCode","value":"createChatHook({ options, ...components })"},{"type":"text","value":" once. Your app calls "},{"type":"inlineCode","value":"useAppChat()"},{"type":"text","value":" to create the instance. Pass the descriptor as "},{"type":"inlineCode","value":"ui"},{"type":"text","value":" into "},{"type":"inlineCode","value":"UIChat"},{"type":"text","value":", "},{"type":"inlineCode","value":"UIProvider"},{"type":"text","value":", and the other static primitives."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Deprecated."}]},{"type":"text","value":" Do not install "},{"type":"inlineCode","value":"@tanstack/ai-vue-ui"},{"type":"text","value":". That package re-exports this subpath until 1.0.0. See "},{"type":"link","href":"../migration/create-ui","children":[{"type":"text","value":"Chat UI packages"}]},{"type":"text","value":"."}]}]},{"type":"paragraph","children":[{"type":"text","value":"The factory needs a "},{"type":"inlineCode","value":"toolsComponents"},{"type":"text","value":" entry for every tool name in "},{"type":"inlineCode","value":"chatOptions"},{"type":"text","value":". It also needs an "},{"type":"inlineCode","value":"interruptsComponents.generic"},{"type":"text","value":" entry for every interrupt id. "},{"type":"inlineCode","value":"generic.fallback"},{"type":"text","value":" is optional. Widgets go in "},{"type":"inlineCode","value":"components"},{"type":"text","value":", "},{"type":"inlineCode","value":"partsComponents"},{"type":"text","value":", "},{"type":"inlineCode","value":"toolsComponents"},{"type":"text","value":", and "},{"type":"inlineCode","value":"interruptsComponents"},{"type":"text","value":", the same way Form and Table register components."}]},{"type":"paragraph","children":[{"type":"text","value":"The server route matches the "},{"type":"link","href":"./react","children":[{"type":"text","value":"React page"}]},{"type":"text","value":". Use "},{"type":"inlineCode","value":"gpt-5.6"},{"type":"text","value":" on the OpenAI text adapter."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"./recipes/index","children":[{"type":"text","value":"chat UI recipes"}]},{"type":"text","value":" show the same option groups one at a time. The code there is React, and the shape carries over."}]},{"type":"heading","depth":2,"id":"client","children":[{"type":"text","value":"Client"}]},{"type":"code","value":"import { defineComponent, h } from 'vue'\nimport { fetchServerSentEvents } from '@tanstack/ai-vue'\nimport { createChatHook, UIChat } from '@tanstack/ai-vue/ui'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst getWeather = toolDefinition({\n  name: 'getWeather',\n  description: 'Look up weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temperature: z.number() }),\n}).client()\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [getWeather],\n}\n\nconst { useAppChat, ui } = createChatHook({\n  options: chatOptions,\n  components: {\n  layout: defineComponent((_, { slots }) => () =>\n    h('div', [slots.messages?.(), slots.interrupts?.(), slots.queue?.(), slots.input?.()]),\n  ),\n  message: defineComponent((_, { slots }) => () => h('article', slots.parts?.())),\n  },\n  partsComponents: {\n  fallback: defineComponent({\n    props: ['part'],\n    setup(props) {\n      return () => h('span', props.part.type)\n    },\n  }),\n  },\n  toolsComponents: {\n  getWeather: defineComponent({\n    props: ['part'],\n    setup(props) {\n      return () => h('strong', props.part.input?.city)\n    },\n  }),\n  },\n})\n\nexport default defineComponent({\n  setup() {\n    const chat = useAppChat({ threadId: 'support-1' })\n    return () => h(UIChat, { ui, chat })\n  },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Layout uses slots "},{"type":"inlineCode","value":"messages"},{"type":"text","value":", "},{"type":"inlineCode","value":"interrupts"},{"type":"text","value":", "},{"type":"inlineCode","value":"queue"},{"type":"text","value":", and "},{"type":"inlineCode","value":"input"},{"type":"text","value":". Message uses slot "},{"type":"inlineCode","value":"parts"},{"type":"text","value":". Manual lists use the default slot on "},{"type":"inlineCode","value":"UIMessages"},{"type":"text","value":" with "},{"type":"inlineCode","value":"{ messages }"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"type-a-component-in-its-own-file","children":[{"type":"text","value":"Type a component in its own file"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"ToolProps"},{"type":"text","value":" on the component props. Share the same "},{"type":"inlineCode","value":"chatOptions"},{"type":"text","value":" object that you pass to "},{"type":"inlineCode","value":"createChatHook"},{"type":"text","value":"."}]},{"type":"code","value":"import { defineComponent, h } from 'vue'\nimport { fetchServerSentEvents } from '@tanstack/ai-vue'\nimport { createChatHook, type ToolProps } from '@tanstack/ai-vue/ui'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst getWeather = toolDefinition({\n  name: 'getWeather',\n  description: 'Look up weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temperature: z.number() }),\n}).client()\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [getWeather],\n}\n\nexport const WeatherTool = defineComponent(\n  (props: ToolProps<typeof chatOptions, 'getWeather'>) => {\n    return () => h('strong', props.part.input?.city)\n  },\n)\n\nexport const { useAppChat, ui } = createChatHook({\n  options: chatOptions,\n  components: {\n    layout: defineComponent((_, { slots }) => () =>\n      h('div', [slots.messages?.(), slots.interrupts?.(), slots.input?.()]),\n    ),\n    message: defineComponent((_, { slots }) => () => h('article', slots.parts?.())),\n  },\n  partsComponents: { fallback: defineComponent(() => () => null) },\n  toolsComponents: { getWeather: WeatherTool },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Part components use "},{"type":"inlineCode","value":"PartProps<typeof chatOptions, 'text'>"},{"type":"text","value":". Then "},{"type":"inlineCode","value":"part"},{"type":"text","value":" is already a text part."}]},{"type":"paragraph","children":[{"type":"text","value":"Interrupt components use "},{"type":"inlineCode","value":"InterruptProps<typeof chatOptions, 'choosePlan'>"},{"type":"text","value":". Then "},{"type":"inlineCode","value":"interrupt.payload"},{"type":"text","value":" matches the definition."}]},{"type":"paragraph","children":[{"type":"text","value":"Mapped components do not receive "},{"type":"inlineCode","value":"chat"},{"type":"text","value":" as a prop. Call "},{"type":"inlineCode","value":"ui.useChatContext()"},{"type":"text","value":" when a component needs live chat. That call opts the component into chat updates. Nested children can call it too."}]},{"type":"heading","depth":2,"id":"read-chat-from-ui-usechatcontext","children":[{"type":"text","value":"Read chat from "},{"type":"inlineCode","value":"ui.useChatContext()"}]},{"type":"paragraph","children":[{"type":"text","value":"Call "},{"type":"inlineCode","value":"ui.useChatContext()"},{"type":"text","value":" inside a child of "},{"type":"inlineCode","value":"UIChat"},{"type":"text","value":" or "},{"type":"inlineCode","value":"UIProvider"},{"type":"text","value":"."}]},{"type":"code","value":"import { defineComponent, h } from 'vue'\nimport type { Component } from 'vue'\nimport { fetchServerSentEvents } from '@tanstack/ai-vue'\nimport { createChatHook, UIChat } from '@tanstack/ai-vue/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, ui } = createChatHook({\n  options: chatOptions,\n  components: {\n    layout: defineComponent((_, { slots }) => () =>\n      h('main', [h(StatusLine), slots.messages?.()]),\n    ),\n    message: defineComponent((_, { slots }) => () => h('article', slots.parts?.())),\n  },\n  partsComponents: { fallback: defineComponent(() => () => null) },\n})\n\n// Declared after `ui`, and annotated, so that reading `ui.useChatContext()`\n// here does not form an inference cycle with the components map that renders\n// it. `h(StatusLine)` above only runs at render time, so the order is fine.\nconst StatusLine: Component = defineComponent({\n  setup() {\n    const chat = ui.useChatContext()\n    return () => {\n      const messages = Array.isArray(chat.messages) ? chat.messages : []\n      return h('p', String(messages.length) + ' messages')\n    }\n  },\n})\n\nexport default defineComponent({\n  setup() {\n    const chat = useAppChat()\n    return () => h(UIChat, { ui, chat })\n  },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"useChat(chatOptions)"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-vue"},{"type":"text","value":" owns the state. "},{"type":"inlineCode","value":"ui.useChatContext()"},{"type":"text","value":" reads the instance you passed into "},{"type":"inlineCode","value":"UIChat"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"interrupts","children":[{"type":"text","value":"Interrupts"}]},{"type":"paragraph","children":[{"type":"text","value":"Tool approvals sit in the tool when you read the "},{"type":"inlineCode","value":"interrupt"},{"type":"text","value":" prop. Put a component on "},{"type":"inlineCode","value":"interruptsComponents.tools"},{"type":"text","value":" to send that approval to the list instead. Generic interrupts always sit in the list under "},{"type":"inlineCode","value":"interruptsComponents.generic"},{"type":"text","value":": "},{"type":"inlineCode","value":"{ choosePlan, fallback }"},{"type":"text","value":". An unbound interrupt uses "},{"type":"inlineCode","value":"fallback"},{"type":"text","value":". Branch on "},{"type":"inlineCode","value":"interrupt.kind === 'unbound'"},{"type":"text","value":" if the copy must differ."}]},{"type":"paragraph","children":[{"type":"text","value":"The full map is on the "},{"type":"link","href":"./react","children":[{"type":"text","value":"React page"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"render-markdown","children":[{"type":"text","value":"Render markdown"}]},{"type":"paragraph","children":[{"type":"text","value":"Model replies arrive as markdown. "},{"type":"inlineCode","value":"TextPart"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/ai-vue/ui"},{"type":"text","value":" renders it with "},{"type":"link","href":"https://tanstack.com/markdown","children":[{"type":"text","value":"TanStack Markdown"}]},{"type":"text","value":". By default, raw HTML is escaped and executable URLs are removed."}]},{"type":"code","value":"import { defineComponent, h } from 'vue'\nimport { TextPart } from '@tanstack/ai-vue/ui'\n\nexport default defineComponent({\n  props: { content: { type: String, required: true } },\n  setup(props) {\n    return () => h(TextPart, { content: props.content })\n  },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Fenced code stays plain until you pass a "},{"type":"inlineCode","value":"highlighter"},{"type":"text","value":". Build one with TanStack Highlight: "},{"type":"link","href":"./markdown","children":[{"type":"text","value":"Highlight markdown code"}]},{"type":"text","value":". A custom "},{"type":"inlineCode","value":"highlighter"},{"type":"text","value":" returns trusted HTML. Use "},{"type":"inlineCode","value":"createTanStackMarkdownHighlighter"},{"type":"text","value":", or another highlighter that escapes source text."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"highlighter"},{"type":"text","value":": a synchronous "},{"type":"inlineCode","value":"CodeHighlighter"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"extensions"},{"type":"text","value":": extra TanStack Markdown extensions. The streaming extension is always on."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"If you still pass "},{"type":"inlineCode","value":"remarkPlugins"},{"type":"text","value":", "},{"type":"inlineCode","value":"rehypePlugins"},{"type":"text","value":", or "},{"type":"inlineCode","value":"disableDefaultPlugins"},{"type":"text","value":", see "},{"type":"link","href":"../migration/text-part-markdown","children":[{"type":"text","value":"TextPart markdown"}]},{"type":"text","value":"."}]}],"headings":[{"id":"client","text":"Client","level":2},{"id":"type-a-component-in-its-own-file","text":"Type a component in its own file","level":2},{"id":"read-chat-from-ui-usechatcontext","text":"Read chat from ui.useChatContext()","level":2},{"id":"interrupts","text":"Interrupts","level":2},{"id":"render-markdown","text":"Render markdown","level":2}]},"frameworks":[],"downloadMarkdown":"\nInstall `@tanstack/ai-vue`. Import the UI factory from `@tanstack/ai-vue/ui`. Call `createChatHook({ options, ...components })` once. Your app calls `useAppChat()` to create the instance. Pass the descriptor as `ui` into `UIChat`, `UIProvider`, and the other static primitives.\n\n> **Deprecated.** Do not install `@tanstack/ai-vue-ui`. That package re-exports this subpath until 1.0.0. See [Chat UI packages](../migration/create-ui).\n\nThe factory needs a `toolsComponents` entry for every tool name in `chatOptions`. It also needs an `interruptsComponents.generic` entry for every interrupt id. `generic.fallback` is optional. Widgets go in `components`, `partsComponents`, `toolsComponents`, and `interruptsComponents`, the same way Form and Table register components.\n\nThe server route matches the [React page](./react). Use `gpt-5.6` on the OpenAI text adapter.\n\nThe [chat UI recipes](./recipes/index) show the same option groups one at a time. The code there is React, and the shape carries over.\n\n## Client\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport { fetchServerSentEvents } from '@tanstack/ai-vue'\nimport { createChatHook, UIChat } from '@tanstack/ai-vue/ui'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst getWeather = toolDefinition({\n  name: 'getWeather',\n  description: 'Look up weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temperature: z.number() }),\n}).client()\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [getWeather],\n}\n\nconst { useAppChat, ui } = createChatHook({\n  options: chatOptions,\n  components: {\n  layout: defineComponent((_, { slots }) => () =>\n    h('div', [slots.messages?.(), slots.interrupts?.(), slots.queue?.(), slots.input?.()]),\n  ),\n  message: defineComponent((_, { slots }) => () => h('article', slots.parts?.())),\n  },\n  partsComponents: {\n  fallback: defineComponent({\n    props: ['part'],\n    setup(props) {\n      return () => h('span', props.part.type)\n    },\n  }),\n  },\n  toolsComponents: {\n  getWeather: defineComponent({\n    props: ['part'],\n    setup(props) {\n      return () => h('strong', props.part.input?.city)\n    },\n  }),\n  },\n})\n\nexport default defineComponent({\n  setup() {\n    const chat = useAppChat({ threadId: 'support-1' })\n    return () => h(UIChat, { ui, chat })\n  },\n})\n```\n\nLayout uses slots `messages`, `interrupts`, `queue`, and `input`. Message uses slot `parts`. Manual lists use the default slot on `UIMessages` with `{ messages }`.\n\n## Type a component in its own file\n\nUse `ToolProps` on the component props. Share the same `chatOptions` object that you pass to `createChatHook`.\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport { fetchServerSentEvents } from '@tanstack/ai-vue'\nimport { createChatHook, type ToolProps } from '@tanstack/ai-vue/ui'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst getWeather = toolDefinition({\n  name: 'getWeather',\n  description: 'Look up weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temperature: z.number() }),\n}).client()\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [getWeather],\n}\n\nexport const WeatherTool = defineComponent(\n  (props: ToolProps<typeof chatOptions, 'getWeather'>) => {\n    return () => h('strong', props.part.input?.city)\n  },\n)\n\nexport const { useAppChat, ui } = createChatHook({\n  options: chatOptions,\n  components: {\n    layout: defineComponent((_, { slots }) => () =>\n      h('div', [slots.messages?.(), slots.interrupts?.(), slots.input?.()]),\n    ),\n    message: defineComponent((_, { slots }) => () => h('article', slots.parts?.())),\n  },\n  partsComponents: { fallback: defineComponent(() => () => null) },\n  toolsComponents: { getWeather: WeatherTool },\n})\n```\n\nPart components use `PartProps<typeof chatOptions, 'text'>`. Then `part` is already a text part.\n\nInterrupt components use `InterruptProps<typeof chatOptions, 'choosePlan'>`. Then `interrupt.payload` matches the definition.\n\nMapped components do not receive `chat` as a prop. Call `ui.useChatContext()` when a component needs live chat. That call opts the component into chat updates. Nested children can call it too.\n\n## Read chat from `ui.useChatContext()`\n\nCall `ui.useChatContext()` inside a child of `UIChat` or `UIProvider`.\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport type { Component } from 'vue'\nimport { fetchServerSentEvents } from '@tanstack/ai-vue'\nimport { createChatHook, UIChat } from '@tanstack/ai-vue/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, ui } = createChatHook({\n  options: chatOptions,\n  components: {\n    layout: defineComponent((_, { slots }) => () =>\n      h('main', [h(StatusLine), slots.messages?.()]),\n    ),\n    message: defineComponent((_, { slots }) => () => h('article', slots.parts?.())),\n  },\n  partsComponents: { fallback: defineComponent(() => () => null) },\n})\n\n// Declared after `ui`, and annotated, so that reading `ui.useChatContext()`\n// here does not form an inference cycle with the components map that renders\n// it. `h(StatusLine)` above only runs at render time, so the order is fine.\nconst StatusLine: Component = defineComponent({\n  setup() {\n    const chat = ui.useChatContext()\n    return () => {\n      const messages = Array.isArray(chat.messages) ? chat.messages : []\n      return h('p', String(messages.length) + ' messages')\n    }\n  },\n})\n\nexport default defineComponent({\n  setup() {\n    const chat = useAppChat()\n    return () => h(UIChat, { ui, chat })\n  },\n})\n```\n\n`useChat(chatOptions)` from `@tanstack/ai-vue` owns the state. `ui.useChatContext()` reads the instance you passed into `UIChat`.\n\n## Interrupts\n\nTool approvals sit in the tool when you read the `interrupt` prop. Put a component on `interruptsComponents.tools` to send that approval to the list instead. Generic interrupts always sit in the list under `interruptsComponents.generic`: `{ choosePlan, fallback }`. An unbound interrupt uses `fallback`. Branch on `interrupt.kind === 'unbound'` if the copy must differ.\n\nThe full map is on the [React page](./react).\n\n## Render markdown\n\nModel replies arrive as markdown. `TextPart` from `@tanstack/ai-vue/ui` renders it with [TanStack Markdown](https://tanstack.com/markdown). By default, raw HTML is escaped and executable URLs are removed.\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport { TextPart } from '@tanstack/ai-vue/ui'\n\nexport default defineComponent({\n  props: { content: { type: String, required: true } },\n  setup(props) {\n    return () => h(TextPart, { content: props.content })\n  },\n})\n```\n\nFenced code stays plain until you pass a `highlighter`. Build one with TanStack Highlight: [Highlight markdown code](./markdown). A custom `highlighter` returns trusted HTML. Use `createTanStackMarkdownHighlighter`, or another highlighter that escapes source text.\n\n- `highlighter`: a synchronous `CodeHighlighter`.\n- `extensions`: extra TanStack Markdown extensions. The streaming extension is always on.\n\nIf you still pass `remarkPlugins`, `rehypePlugins`, or `disableDefaultPlugins`, see [TextPart markdown](../migration/text-part-markdown).\n","originalRawMarkdown":"---\ntitle: Vue Chat UI\nid: typed-headless-ui-vue\norder: 3\ndescription: \"Build a typed, headless Vue chat UI with createChatHook and static primitives. Slots replace render callbacks.\"\nkeywords:\n  - tanstack ai\n  - createChatHook\n  - vue\n  - headless ui\n  - ToolProps\n---\n\nInstall `@tanstack/ai-vue`. Import the UI factory from `@tanstack/ai-vue/ui`. Call `createChatHook({ options, ...components })` once. Your app calls `useAppChat()` to create the instance. Pass the descriptor as `ui` into `UIChat`, `UIProvider`, and the other static primitives.\n\n> **Deprecated.** Do not install `@tanstack/ai-vue-ui`. That package re-exports this subpath until 1.0.0. See [Chat UI packages](../migration/create-ui).\n\nThe factory needs a `toolsComponents` entry for every tool name in `chatOptions`. It also needs an `interruptsComponents.generic` entry for every interrupt id. `generic.fallback` is optional. Widgets go in `components`, `partsComponents`, `toolsComponents`, and `interruptsComponents`, the same way Form and Table register components.\n\nThe server route matches the [React page](./react). Use `gpt-5.6` on the OpenAI text adapter.\n\nThe [chat UI recipes](./recipes/index) show the same option groups one at a time. The code there is React, and the shape carries over.\n\n## Client\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport { fetchServerSentEvents } from '@tanstack/ai-vue'\nimport { createChatHook, UIChat } from '@tanstack/ai-vue/ui'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst getWeather = toolDefinition({\n  name: 'getWeather',\n  description: 'Look up weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temperature: z.number() }),\n}).client()\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [getWeather],\n}\n\nconst { useAppChat, ui } = createChatHook({\n  options: chatOptions,\n  components: {\n  layout: defineComponent((_, { slots }) => () =>\n    h('div', [slots.messages?.(), slots.interrupts?.(), slots.queue?.(), slots.input?.()]),\n  ),\n  message: defineComponent((_, { slots }) => () => h('article', slots.parts?.())),\n  },\n  partsComponents: {\n  fallback: defineComponent({\n    props: ['part'],\n    setup(props) {\n      return () => h('span', props.part.type)\n    },\n  }),\n  },\n  toolsComponents: {\n  getWeather: defineComponent({\n    props: ['part'],\n    setup(props) {\n      return () => h('strong', props.part.input?.city)\n    },\n  }),\n  },\n})\n\nexport default defineComponent({\n  setup() {\n    const chat = useAppChat({ threadId: 'support-1' })\n    return () => h(UIChat, { ui, chat })\n  },\n})\n```\n\nLayout uses slots `messages`, `interrupts`, `queue`, and `input`. Message uses slot `parts`. Manual lists use the default slot on `UIMessages` with `{ messages }`.\n\n## Type a component in its own file\n\nUse `ToolProps` on the component props. Share the same `chatOptions` object that you pass to `createChatHook`.\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport { fetchServerSentEvents } from '@tanstack/ai-vue'\nimport { createChatHook, type ToolProps } from '@tanstack/ai-vue/ui'\nimport { toolDefinition } from '@tanstack/ai'\nimport { z } from 'zod'\n\nconst getWeather = toolDefinition({\n  name: 'getWeather',\n  description: 'Look up weather',\n  inputSchema: z.object({ city: z.string() }),\n  outputSchema: z.object({ temperature: z.number() }),\n}).client()\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n  tools: [getWeather],\n}\n\nexport const WeatherTool = defineComponent(\n  (props: ToolProps<typeof chatOptions, 'getWeather'>) => {\n    return () => h('strong', props.part.input?.city)\n  },\n)\n\nexport const { useAppChat, ui } = createChatHook({\n  options: chatOptions,\n  components: {\n    layout: defineComponent((_, { slots }) => () =>\n      h('div', [slots.messages?.(), slots.interrupts?.(), slots.input?.()]),\n    ),\n    message: defineComponent((_, { slots }) => () => h('article', slots.parts?.())),\n  },\n  partsComponents: { fallback: defineComponent(() => () => null) },\n  toolsComponents: { getWeather: WeatherTool },\n})\n```\n\nPart components use `PartProps<typeof chatOptions, 'text'>`. Then `part` is already a text part.\n\nInterrupt components use `InterruptProps<typeof chatOptions, 'choosePlan'>`. Then `interrupt.payload` matches the definition.\n\nMapped components do not receive `chat` as a prop. Call `ui.useChatContext()` when a component needs live chat. That call opts the component into chat updates. Nested children can call it too.\n\n## Read chat from `ui.useChatContext()`\n\nCall `ui.useChatContext()` inside a child of `UIChat` or `UIProvider`.\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport type { Component } from 'vue'\nimport { fetchServerSentEvents } from '@tanstack/ai-vue'\nimport { createChatHook, UIChat } from '@tanstack/ai-vue/ui'\n\nconst chatOptions = {\n  connection: fetchServerSentEvents('/api/chat'),\n}\n\nconst { useAppChat, ui } = createChatHook({\n  options: chatOptions,\n  components: {\n    layout: defineComponent((_, { slots }) => () =>\n      h('main', [h(StatusLine), slots.messages?.()]),\n    ),\n    message: defineComponent((_, { slots }) => () => h('article', slots.parts?.())),\n  },\n  partsComponents: { fallback: defineComponent(() => () => null) },\n})\n\n// Declared after `ui`, and annotated, so that reading `ui.useChatContext()`\n// here does not form an inference cycle with the components map that renders\n// it. `h(StatusLine)` above only runs at render time, so the order is fine.\nconst StatusLine: Component = defineComponent({\n  setup() {\n    const chat = ui.useChatContext()\n    return () => {\n      const messages = Array.isArray(chat.messages) ? chat.messages : []\n      return h('p', String(messages.length) + ' messages')\n    }\n  },\n})\n\nexport default defineComponent({\n  setup() {\n    const chat = useAppChat()\n    return () => h(UIChat, { ui, chat })\n  },\n})\n```\n\n`useChat(chatOptions)` from `@tanstack/ai-vue` owns the state. `ui.useChatContext()` reads the instance you passed into `UIChat`.\n\n## Interrupts\n\nTool approvals sit in the tool when you read the `interrupt` prop. Put a component on `interruptsComponents.tools` to send that approval to the list instead. Generic interrupts always sit in the list under `interruptsComponents.generic`: `{ choosePlan, fallback }`. An unbound interrupt uses `fallback`. Branch on `interrupt.kind === 'unbound'` if the copy must differ.\n\nThe full map is on the [React page](./react).\n\n## Render markdown\n\nModel replies arrive as markdown. `TextPart` from `@tanstack/ai-vue/ui` renders it with [TanStack Markdown](https://tanstack.com/markdown). By default, raw HTML is escaped and executable URLs are removed.\n\n```ts\nimport { defineComponent, h } from 'vue'\nimport { TextPart } from '@tanstack/ai-vue/ui'\n\nexport default defineComponent({\n  props: { content: { type: String, required: true } },\n  setup(props) {\n    return () => h(TextPart, { content: props.content })\n  },\n})\n```\n\nFenced code stays plain until you pass a `highlighter`. Build one with TanStack Highlight: [Highlight markdown code](./markdown). A custom `highlighter` returns trusted HTML. Use `createTanStackMarkdownHighlighter`, or another highlighter that escapes source text.\n\n- `highlighter`: a synchronous `CodeHighlighter`.\n- `extensions`: extra TanStack Markdown extensions. The streaming extension is always on.\n\nIf you still pass `remarkPlugins`, `rehypePlugins`, or `disableDefaultPlugins`, see [TextPart markdown](../migration/text-part-markdown).\n"}
