:[{"type":"inlineCode","value":"ariaLabel"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Required"}]},{"type":"tableCell","children":[{"type":"text","value":"Accessible chart name"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ariaDescription"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional accessible description"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"height"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Existing height or "},{"type":"inlineCode","value":"320"},{"type":"text","value":" without a ratio"}]},{"type":"tableCell","children":[{"type":"text","value":"Fixed CSS and scene height"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"aspectRatio"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Positive width-to-height ratio when height is absent"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"width"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Existing width or "},{"type":"inlineCode","value":"100%"}]},{"type":"tableCell","children":[{"type":"text","value":"Fixed CSS and scene width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"initialWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"640"}]},{"type":"tableCell","children":[{"type":"text","value":"Initial width before responsive measurement"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"tabIndex"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"Surface tab index; "},{"type":"inlineCode","value":"keyboard: false"},{"type":"text","value":" forces "},{"type":"inlineCode","value":"-1"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"idPrefix"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Generated"}]},{"type":"tableCell","children":[{"type":"text","value":"Prefix for renderer-owned document IDs"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"className"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Extra class on the rendered chart surface"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderSvg"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartSvgRenderer<TDatum, TXValue, TYValue>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"renderChartSvg"}]},{"type":"tableCell","children":[{"type":"text","value":"Scene-to-SVG renderer"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"measureText"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartTextMeasurer"}]},{"type":"tableCell","children":[{"type":"text","value":"Host measurer"}]},{"type":"tableCell","children":[{"type":"text","value":"Guide text measurement"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Primary focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusGroupChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(points: readonly ChartPoint[]) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Grouped focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onSelect"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Pointer or keyboard activation callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onRender"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartRenderContext) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Default SVG, complete surface, container, and scene after rendering"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderTooltipBody"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartTooltipBodyRenderContext) => AlpineChartTooltipBody"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Returns DOM content for the built-in tooltip body"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"The directive element becomes "},{"type":"inlineCode","value":".ts-chart-host"},{"type":"text","value":"; use its normal HTML class and\nstyle attributes for outer presentation. Directive cleanup removes the chart\nsurface and restores the element's prior inline layout and host class."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"renderTooltipBody"},{"type":"text","value":" receives "},{"type":"inlineCode","value":"points"},{"type":"text","value":", "},{"type":"inlineCode","value":"content"},{"type":"text","value":", a "},{"type":"inlineCode","value":"DocumentFragment"},{"type":"text","value":"\n"},{"type":"inlineCode","value":"defaultBody"},{"type":"text","value":", "},{"type":"inlineCode","value":"pinned"},{"type":"text","value":", and "},{"type":"inlineCode","value":"dismiss"},{"type":"text","value":". Return a DOM node, text, number, nested\narray, or "},{"type":"inlineCode","value":"null"},{"type":"text","value":". Include "},{"type":"inlineCode","value":"defaultBody"},{"type":"text","value":" to retain the native title, rows,\nformatting, and swatches. The directive replaces returned content when focus\nchanges and removes it when the tooltip closes."}]},{"type":"heading","depth":2,"id":"exported-types","children":[{"type":"text","value":"Exported types"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ChartOptions"},{"type":"text","value":" includes the definition and host options.\n"},{"type":"inlineCode","value":"ChartTooltipBodyRenderContext"},{"type":"text","value":" and "},{"type":"inlineCode","value":"AlpineChartTooltipBody"},{"type":"text","value":" describe custom\nbody composition. The package also re-exports "},{"type":"inlineCode","value":"ChartDefinition"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"ChartPoint"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../adapter.md","children":[{"type":"text","value":"Alpine adapter"}]},{"type":"text","value":" for lifecycle and browser requirements,\n"},{"type":"link","href":"../../../reference/focus-and-interaction.md","children":[{"type":"text","value":"Focus and interaction"}]},{"type":"text","value":" for\ncallback semantics, and "},{"type":"link","href":"../../../reference/rendering-and-export.md","children":[{"type":"text","value":"Rendering and export"}]},{"type":"text","value":"\nfor custom SVG renderers."}]}],"headings":[{"id":"directive-options","text":"Directive options","level":2},{"id":"exported-types","text":"Exported types","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nimport { charts } from '@tanstack/charts/alpine'\n```\n\nRegister `charts` with `Alpine.plugin`, then make `x-chart` evaluate to a\ncomplete `ChartOptions` value. Replace the definition identity when captured\napplication values change.\nThe definition also owns `focus`, `focusRing`, `cursor`, `tooltip`, `svgAnimation`,\n`keyboard`, `maxFocusDistance`, and `spatialIndex`.\n\n## Directive options\n\n| Option               | Type                                                                 | Default                                  | Meaning                                                             |\n| -------------------- | -------------------------------------------------------------------- | ---------------------------------------- | ------------------------------------------------------------------- |\n| `definition`         | `ChartDefinition`                                                    | Required                                 | Framework-neutral chart definition                                  |\n| `ariaLabel`          | `string`                                                             | Required                                 | Accessible chart name                                               |\n| `ariaDescription`    | `string`                                                             | None                                     | Optional accessible description                                     |\n| `height`             | `number`                                                             | Existing height or `320` without a ratio | Fixed CSS and scene height                                          |\n| `aspectRatio`        | `number`                                                             | None                                     | Positive width-to-height ratio when height is absent                |\n| `width`              | `number`                                                             | Existing width or `100%`                 | Fixed CSS and scene width                                           |\n| `initialWidth`       | `number`                                                             | `640`                                    | Initial width before responsive measurement                         |\n| `tabIndex`           | `number`                                                             | `0`                                      | Surface tab index; `keyboard: false` forces `-1`                    |\n| `idPrefix`           | `string`                                                             | Generated                                | Prefix for renderer-owned document IDs                              |\n| `className`          | `string`                                                             | None                                     | Extra class on the rendered chart surface                           |\n| `renderSvg`          | `ChartSvgRenderer<TDatum, TXValue, TYValue>`                         | `renderChartSvg`                         | Scene-to-SVG renderer                                               |\n| `measureText`        | `ChartTextMeasurer`                                                  | Host measurer                            | Guide text measurement                                              |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`                                | None                                     | Primary focus callback                                              |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void`                            | None                                     | Grouped focus callback                                              |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`                                | None                                     | Pointer or keyboard activation callback                             |\n| `onRender`           | `(context: ChartRenderContext) => void`                              | None                                     | Default SVG, complete surface, container, and scene after rendering |\n| `renderTooltipBody`  | `(context: ChartTooltipBodyRenderContext) => AlpineChartTooltipBody` | None                                     | Returns DOM content for the built-in tooltip body                   |\n\nThe directive element becomes `.ts-chart-host`; use its normal HTML class and\nstyle attributes for outer presentation. Directive cleanup removes the chart\nsurface and restores the element's prior inline layout and host class.\n\n`renderTooltipBody` receives `points`, `content`, a `DocumentFragment`\n`defaultBody`, `pinned`, and `dismiss`. Return a DOM node, text, number, nested\narray, or `null`. Include `defaultBody` to retain the native title, rows,\nformatting, and swatches. The directive replaces returned content when focus\nchanges and removes it when the tooltip closes.\n\n## Exported types\n\n`ChartOptions` includes the definition and host options.\n`ChartTooltipBodyRenderContext` and `AlpineChartTooltipBody` describe custom\nbody composition. The package also re-exports `ChartDefinition` and\n`ChartPoint`.\n\nSee the [Alpine adapter](../adapter.md) for lifecycle and browser requirements,\n[Focus and interaction](../../../reference/focus-and-interaction.md) for\ncallback semantics, and [Rendering and export](../../../reference/rendering-and-export.md)\nfor custom SVG renderers.\n","originalRawMarkdown":"---\ntitle: Alpine Chart\ndescription: Complete option and type reference for the @tanstack/charts/alpine x-chart directive.\n---\n\n```ts\nimport { charts } from '@tanstack/charts/alpine'\n```\n\nRegister `charts` with `Alpine.plugin`, then make `x-chart` evaluate to a\ncomplete `ChartOptions` value. Replace the definition identity when captured\napplication values change.\nThe definition also owns `focus`, `focusRing`, `cursor`, `tooltip`, `svgAnimation`,\n`keyboard`, `maxFocusDistance`, and `spatialIndex`.\n\n## Directive options\n\n| Option               | Type                                                                 | Default                                  | Meaning                                                             |\n| -------------------- | -------------------------------------------------------------------- | ---------------------------------------- | ------------------------------------------------------------------- |\n| `definition`         | `ChartDefinition`                                                    | Required                                 | Framework-neutral chart definition                                  |\n| `ariaLabel`          | `string`                                                             | Required                                 | Accessible chart name                                               |\n| `ariaDescription`    | `string`                                                             | None                                     | Optional accessible description                                     |\n| `height`             | `number`                                                             | Existing height or `320` without a ratio | Fixed CSS and scene height                                          |\n| `aspectRatio`        | `number`                                                             | None                                     | Positive width-to-height ratio when height is absent                |\n| `width`              | `number`                                                             | Existing width or `100%`                 | Fixed CSS and scene width                                           |\n| `initialWidth`       | `number`                                                             | `640`                                    | Initial width before responsive measurement                         |\n| `tabIndex`           | `number`                                                             | `0`                                      | Surface tab index; `keyboard: false` forces `-1`                    |\n| `idPrefix`           | `string`                                                             | Generated                                | Prefix for renderer-owned document IDs                              |\n| `className`          | `string`                                                             | None                                     | Extra class on the rendered chart surface                           |\n| `renderSvg`          | `ChartSvgRenderer<TDatum, TXValue, TYValue>`                         | `renderChartSvg`                         | Scene-to-SVG renderer                                               |\n| `measureText`        | `ChartTextMeasurer`                                                  | Host measurer                            | Guide text measurement                                              |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`                                | None                                     | Primary focus callback                                              |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void`                            | None                                     | Grouped focus callback                                              |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`                                | None                                     | Pointer or keyboard activation callback                             |\n| `onRender`           | `(context: ChartRenderContext) => void`                              | None                                     | Default SVG, complete surface, container, and scene after rendering |\n| `renderTooltipBody`  | `(context: ChartTooltipBodyRenderContext) => AlpineChartTooltipBody` | None                                     | Returns DOM content for the built-in tooltip body                   |\n\nThe directive element becomes `.ts-chart-host`; use its normal HTML class and\nstyle attributes for outer presentation. Directive cleanup removes the chart\nsurface and restores the element's prior inline layout and host class.\n\n`renderTooltipBody` receives `points`, `content`, a `DocumentFragment`\n`defaultBody`, `pinned`, and `dismiss`. Return a DOM node, text, number, nested\narray, or `null`. Include `defaultBody` to retain the native title, rows,\nformatting, and swatches. The directive replaces returned content when focus\nchanges and removes it when the tooltip closes.\n\n## Exported types\n\n`ChartOptions` includes the definition and host options.\n`ChartTooltipBodyRenderContext` and `AlpineChartTooltipBody` describe custom\nbody composition. The package also re-exports `ChartDefinition` and\n`ChartPoint`.\n\nSee the [Alpine adapter](../adapter.md) for lifecycle and browser requirements,\n[Focus and interaction](../../../reference/focus-and-interaction.md) for\ncallback semantics, and [Rendering and export](../../../reference/rendering-and-export.md)\nfor custom SVG renderers.\n"}
