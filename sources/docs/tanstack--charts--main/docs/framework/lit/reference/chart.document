e":"tableCell","children":[{"type":"inlineCode","value":"ariaLabel"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Required"}]},{"type":"tableCell","children":[{"type":"text","value":"Accessible chart name"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ariaDescription"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional accessible description"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"height"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"320"},{"type":"text","value":" without a ratio"}]},{"type":"tableCell","children":[{"type":"text","value":"Fixed CSS and scene height"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"aspectRatio"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Positive width-to-height ratio when height is absent"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"width"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Responsive"}]},{"type":"tableCell","children":[{"type":"text","value":"Fixed CSS and scene width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"initialWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"640"}]},{"type":"tableCell","children":[{"type":"text","value":"Initial width before responsive measurement"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"tabIndex"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"Surface tab index; "},{"type":"inlineCode","value":"keyboard: false"},{"type":"text","value":" forces "},{"type":"inlineCode","value":"-1"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"idPrefix"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Generated"}]},{"type":"tableCell","children":[{"type":"text","value":"Prefix for renderer-owned document IDs"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderSvg"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartSvgRenderer<TDatum, TXValue, TYValue>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"renderChartSvg"}]},{"type":"tableCell","children":[{"type":"text","value":"Scene-to-SVG renderer"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"measureText"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartTextMeasurer"}]},{"type":"tableCell","children":[{"type":"text","value":"Host measurer"}]},{"type":"tableCell","children":[{"type":"text","value":"Guide text measurement"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Primary focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusGroupChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(points: readonly ChartPoint[]) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Grouped focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onSelect"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Pointer or keyboard activation callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onRender"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartRenderContext) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Default SVG, complete surface, container, and scene after rendering"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderTooltipBody"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartTooltipBodyRenderContext) => unknown"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Composes Lit content inside the built-in tooltip body"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"class"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Extra class on the inner "},{"type":"inlineCode","value":".ts-chart-host"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"style"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Inner host declarations applied after adapter sizing"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"className"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Extra class on the rendered chart surface"}]}]]},{"type":"code","value":"const options = {\n  definition,\n  ariaLabel: 'Revenue',\n  renderTooltipBody: ({ points, defaultBody, pinned, dismiss }) => html`\n    ${defaultBody}\n    <series-detail .points=${points}></series-detail>\n    ${pinned ? html`<button @click=${dismiss}>Close</button>` : nothing}\n  `,\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The context also exposes resolved "},{"type":"inlineCode","value":"content"},{"type":"text","value":". "},{"type":"inlineCode","value":"defaultBody"},{"type":"text","value":" is a\n"},{"type":"inlineCode","value":"TemplateResult"},{"type":"text","value":". Ordering, anchoring, placement, portaling, and pinning remain\nin the definition."}]},{"type":"heading","depth":2,"id":"registration-and-exported-types","children":[{"type":"text","value":"Registration and exported types"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"defineChartElement(tagName = 'tanstack-chart')"},{"type":"text","value":" is idempotent for an already\nregistered tag. Importing "},{"type":"inlineCode","value":"Chart"},{"type":"text","value":" directly supports explicit custom-element\nregistration."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ChartCommonProps"},{"type":"text","value":" contains common host and presentation props. "},{"type":"inlineCode","value":"ChartProps"},{"type":"text","value":"\nadds the definition. "},{"type":"inlineCode","value":"ChartPresentationProps"},{"type":"text","value":" contains "},{"type":"inlineCode","value":"class"},{"type":"text","value":" and "},{"type":"inlineCode","value":"style"},{"type":"text","value":".\n"},{"type":"inlineCode","value":"ChartTooltipBodyRenderContext"},{"type":"text","value":" describes composed tooltip content. The\npackage also re-exports "},{"type":"inlineCode","value":"ChartDefinition"},{"type":"text","value":" and "},{"type":"inlineCode","value":"ChartPoint"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../adapter.md","children":[{"type":"text","value":"Lit adapter"}]},{"type":"text","value":" for lifecycle and browser behavior,\n"},{"type":"link","href":"../../../reference/focus-and-interaction.md","children":[{"type":"text","value":"Focus and interaction"}]},{"type":"text","value":" for\ncallback semantics, and "},{"type":"link","href":"../../../reference/rendering-and-export.md","children":[{"type":"text","value":"Rendering and export"}]},{"type":"text","value":"\nfor custom SVG renderers."}]}],"headings":[{"id":"options","text":"options","level":2},{"id":"registration-and-exported-types","text":"Registration and exported types","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nimport { Chart, defineChartElement } from '@tanstack/charts/lit'\n```\n\n`defineChartElement()` registers `Chart` as `tanstack-chart`. Pass the complete\nchart value through the element's `options` property, not HTML attributes.\nReplace the definition identity when captured application values change.\nThe definition also owns `focus`, `focusRing`, `cursor`, `tooltip`, `svgAnimation`,\n`keyboard`, `maxFocusDistance`, and `spatialIndex`.\n\n## `options`\n\n| Option               | Type                                                  | Default               | Meaning                                                             |\n| -------------------- | ----------------------------------------------------- | --------------------- | ------------------------------------------------------------------- |\n| `definition`         | `ChartDefinition`                                     | Required              | Framework-neutral chart definition                                  |\n| `ariaLabel`          | `string`                                              | Required              | Accessible chart name                                               |\n| `ariaDescription`    | `string`                                              | None                  | Optional accessible description                                     |\n| `height`             | `number`                                              | `320` without a ratio | Fixed CSS and scene height                                          |\n| `aspectRatio`        | `number`                                              | None                  | Positive width-to-height ratio when height is absent                |\n| `width`              | `number`                                              | Responsive            | Fixed CSS and scene width                                           |\n| `initialWidth`       | `number`                                              | `640`                 | Initial width before responsive measurement                         |\n| `tabIndex`           | `number`                                              | `0`                   | Surface tab index; `keyboard: false` forces `-1`                    |\n| `idPrefix`           | `string`                                              | Generated             | Prefix for renderer-owned document IDs                              |\n| `renderSvg`          | `ChartSvgRenderer<TDatum, TXValue, TYValue>`          | `renderChartSvg`      | Scene-to-SVG renderer                                               |\n| `measureText`        | `ChartTextMeasurer`                                   | Host measurer         | Guide text measurement                                              |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`                 | None                  | Primary focus callback                                              |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void`             | None                  | Grouped focus callback                                              |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`                 | None                  | Pointer or keyboard activation callback                             |\n| `onRender`           | `(context: ChartRenderContext) => void`               | None                  | Default SVG, complete surface, container, and scene after rendering |\n| `renderTooltipBody`  | `(context: ChartTooltipBodyRenderContext) => unknown` | None                  | Composes Lit content inside the built-in tooltip body               |\n| `class`              | `string`                                              | None                  | Extra class on the inner `.ts-chart-host`                           |\n| `style`              | `string`                                              | None                  | Inner host declarations applied after adapter sizing                |\n| `className`          | `string`                                              | None                  | Extra class on the rendered chart surface                           |\n\n```ts\nconst options = {\n  definition,\n  ariaLabel: 'Revenue',\n  renderTooltipBody: ({ points, defaultBody, pinned, dismiss }) => html`\n    ${defaultBody}\n    <series-detail .points=${points}></series-detail>\n    ${pinned ? html`<button @click=${dismiss}>Close</button>` : nothing}\n  `,\n}\n```\n\nThe context also exposes resolved `content`. `defaultBody` is a\n`TemplateResult`. Ordering, anchoring, placement, portaling, and pinning remain\nin the definition.\n\n## Registration and exported types\n\n`defineChartElement(tagName = 'tanstack-chart')` is idempotent for an already\nregistered tag. Importing `Chart` directly supports explicit custom-element\nregistration.\n\n`ChartCommonProps` contains common host and presentation props. `ChartProps`\nadds the definition. `ChartPresentationProps` contains `class` and `style`.\n`ChartTooltipBodyRenderContext` describes composed tooltip content. The\npackage also re-exports `ChartDefinition` and `ChartPoint`.\n\nSee the [Lit adapter](../adapter.md) for lifecycle and browser behavior,\n[Focus and interaction](../../../reference/focus-and-interaction.md) for\ncallback semantics, and [Rendering and export](../../../reference/rendering-and-export.md)\nfor custom SVG renderers.\n","originalRawMarkdown":"---\ntitle: Lit Chart\ndescription: Complete option and type reference for the @tanstack/charts/lit custom element.\n---\n\n```ts\nimport { Chart, defineChartElement } from '@tanstack/charts/lit'\n```\n\n`defineChartElement()` registers `Chart` as `tanstack-chart`. Pass the complete\nchart value through the element's `options` property, not HTML attributes.\nReplace the definition identity when captured application values change.\nThe definition also owns `focus`, `focusRing`, `cursor`, `tooltip`, `svgAnimation`,\n`keyboard`, `maxFocusDistance`, and `spatialIndex`.\n\n## `options`\n\n| Option               | Type                                                  | Default               | Meaning                                                             |\n| -------------------- | ----------------------------------------------------- | --------------------- | ------------------------------------------------------------------- |\n| `definition`         | `ChartDefinition`                                     | Required              | Framework-neutral chart definition                                  |\n| `ariaLabel`          | `string`                                              | Required              | Accessible chart name                                               |\n| `ariaDescription`    | `string`                                              | None                  | Optional accessible description                                     |\n| `height`             | `number`                                              | `320` without a ratio | Fixed CSS and scene height                                          |\n| `aspectRatio`        | `number`                                              | None                  | Positive width-to-height ratio when height is absent                |\n| `width`              | `number`                                              | Responsive            | Fixed CSS and scene width                                           |\n| `initialWidth`       | `number`                                              | `640`                 | Initial width before responsive measurement                         |\n| `tabIndex`           | `number`                                              | `0`                   | Surface tab index; `keyboard: false` forces `-1`                    |\n| `idPrefix`           | `string`                                              | Generated             | Prefix for renderer-owned document IDs                              |\n| `renderSvg`          | `ChartSvgRenderer<TDatum, TXValue, TYValue>`          | `renderChartSvg`      | Scene-to-SVG renderer                                               |\n| `measureText`        | `ChartTextMeasurer`                                   | Host measurer         | Guide text measurement                                              |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`                 | None                  | Primary focus callback                                              |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void`             | None                  | Grouped focus callback                                              |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`                 | None                  | Pointer or keyboard activation callback                             |\n| `onRender`           | `(context: ChartRenderContext) => void`               | None                  | Default SVG, complete surface, container, and scene after rendering |\n| `renderTooltipBody`  | `(context: ChartTooltipBodyRenderContext) => unknown` | None                  | Composes Lit content inside the built-in tooltip body               |\n| `class`              | `string`                                              | None                  | Extra class on the inner `.ts-chart-host`                           |\n| `style`              | `string`                                              | None                  | Inner host declarations applied after adapter sizing                |\n| `className`          | `string`                                              | None                  | Extra class on the rendered chart surface                           |\n\n```ts\nconst options = {\n  definition,\n  ariaLabel: 'Revenue',\n  renderTooltipBody: ({ points, defaultBody, pinned, dismiss }) => html`\n    ${defaultBody}\n    <series-detail .points=${points}></series-detail>\n    ${pinned ? html`<button @click=${dismiss}>Close</button>` : nothing}\n  `,\n}\n```\n\nThe context also exposes resolved `content`. `defaultBody` is a\n`TemplateResult`. Ordering, anchoring, placement, portaling, and pinning remain\nin the definition.\n\n## Registration and exported types\n\n`defineChartElement(tagName = 'tanstack-chart')` is idempotent for an already\nregistered tag. Importing `Chart` directly supports explicit custom-element\nregistration.\n\n`ChartCommonProps` contains common host and presentation props. `ChartProps`\nadds the definition. `ChartPresentationProps` contains `class` and `style`.\n`ChartTooltipBodyRenderContext` describes composed tooltip content. The\npackage also re-exports `ChartDefinition` and `ChartPoint`.\n\nSee the [Lit adapter](../adapter.md) for lifecycle and browser behavior,\n[Focus and interaction](../../../reference/focus-and-interaction.md) for\ncallback semantics, and [Rendering and export](../../../reference/rendering-and-export.md)\nfor custom SVG renderers.\n"}
