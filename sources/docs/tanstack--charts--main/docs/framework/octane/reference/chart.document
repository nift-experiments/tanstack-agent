ept\n"},{"type":"inlineCode","value":"renderSvg"},{"type":"text","value":". Its "},{"type":"inlineCode","value":"onRender"},{"type":"text","value":" receives "},{"type":"inlineCode","value":"ChartRendererRenderContext"},{"type":"text","value":". The "},{"type":"inlineCode","value":"/core"},{"type":"text","value":"\n"},{"type":"inlineCode","value":"Chart"},{"type":"text","value":" also requires "},{"type":"inlineCode","value":"renderer: ChartRenderer"},{"type":"text","value":". Both entries export\n"},{"type":"inlineCode","value":"ChartCommonProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartTooltipBodyRenderContext"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"ChartDefinition"},{"type":"text","value":", and "},{"type":"inlineCode","value":"ChartPoint"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"definition-props","children":[{"type":"text","value":"Definition props"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Prop"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"definition"}]},{"type":"tableCell","children":[{"type":"text","value":"Required"}]},{"type":"tableCell","children":[{"type":"text","value":"Framework-independent definition; identity is the application update boundary"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../../../reference/chart-definitions.md","children":[{"type":"text","value":"Chart Definition API"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"accessibility-and-sizing","children":[{"type":"text","value":"Accessibility and sizing"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"