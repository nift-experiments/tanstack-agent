umber"}]},{"type":"tableCell","children":[{"type":"text","value":"Responsive"}]},{"type":"tableCell","children":[{"type":"text","value":"Fixed CSS and scene width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"initialWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"640"}]},{"type":"tableCell","children":[{"type":"text","value":"Initial and server width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"class"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Extra class on the outer "},{"type":"inlineCode","value":"ts-chart-host"},{"type":"text","value":" element"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"style"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Record<string, string | number | undefined>"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Outer host styles applied after adapter sizing"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../adapter.md#sizing-and-layout","children":[{"type":"text","value":"Sizing and layout"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"focus-tooltip-and-callbacks","children":[{"type":"text","value":"Focus, tooltip, and callbacks"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Prop"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Primary focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusGroupChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(points: readonly ChartPoint[]) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Grouped focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onSelect"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Click and keyboard activation callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onRender"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartRenderContext) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Inner host, default SVG, complete surface, and scene after rendering"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderTooltipBody"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartTooltipBodyRenderContext) => OctaneNode"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Composes Octane content inside the built-in tooltip body"}]}]]},{"type":"code","value":"<Chart\n  definition={definition}\n  ariaLabel=\"Revenue\"\n  renderTooltipBody={({ points, defaultBody, pinned, dismiss }) => (\n    <div>\n      {defaultBody}\n      <SeriesDetail points={points} />\n      {pinned ? <button onClick={dismiss}>Close</button> : null}\n    </div>\n  )}\n/>","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The context also exposes the resolved "},{"type":"inlineCode","value":"content"},{"type":"text","value":". Ordering, anchoring,\nplacement, portaling, and pinning remain in the definition. The prop is\navailable from the default, "},{"type":"inlineCode","value":"/canvas"},{"type":"text","value":", and "},{"type":"inlineCode","value":"/core"},{"type":"text","value":" entries."}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../../../reference/focus-and-interaction.md","children":[{"type":"text","value":"Focus and interaction"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"rendering-and-layout-extensions","children":[{"type":"text","value":"Rendering and layout extensions"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Prop"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"idPrefix"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Generated from "},{"type":"inlineCode","value":"useId()"}]},{"type":"tableCell","children":[{"type":"text","value":"Prefix for renderer-owned resource IDs"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderSvg"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartSvgRenderer<TDatum, TXValue, TYValue>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"renderChartSvg"}]},{"type":"tableCell","children":[{"type":"text","value":"Scene-to-SVG renderer"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"measureText"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartTextMeasurer"}]},{"type":"tableCell","children":[{"type":"text","value":"DOM inherited-font measurer"}]},{"type":"tableCell","children":[{"type":"text","value":"Guide glyph measurement"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../../../reference/rendering-and-export.md","children":[{"type":"text","value":"Rendering and export"}]},{"type":"text","value":" and\n"},{"type":"link","href":"../../../reference/scales-guides-and-color.md","children":[{"type":"text","value":"Scales, guides, and color"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"exported-prop-types","children":[{"type":"text","value":"Exported prop types"}]},{"type":"paragraph","children":[{"type":"text","value":"The adapter exports "},{"type":"inlineCode","value":"ChartCommonProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartProps"},{"type":"text","value":", and\n"},{"type":"inlineCode","value":"ChartTooltipBodyRenderContext"},{"type":"text","value":"."}]},{"type":"code","value":"interface ChartCommonProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> {\n  // every common prop listed above\n}\n\ntype ChartProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> = ChartCommonProps<TDatum, TXValue, TYValue> & {\n  definition: ChartDefinition<TDatum, TXValue, TYValue>\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The package also re-exports "},{"type":"inlineCode","value":"ChartDefinition"},{"type":"text","value":" and "},{"type":"inlineCode","value":"ChartPoint"},{"type":"text","value":". Prefer\ninference at the component call site. Memoize definitions that capture\ncomponent values; see "},{"type":"link","href":"../../../reference/types.md","children":[{"type":"text","value":"Types"}]},{"type":"text","value":"."}]}],"headings":[{"id":"renderer-entry-points","text":"Renderer entry points","level":2},{"id":"definition-props","text":"Definition props","level":2},{"id":"accessibility-and-sizing","text":"Accessibility and sizing","level":2},{"id":"focus-tooltip-and-callbacks","text":"Focus, tooltip, and callbacks","level":2},{"id":"rendering-and-layout-extensions","text":"Rendering and layout extensions","level":2},{"id":"exported-prop-types","text":"Exported prop types","level":2}]},"frameworks":[],"downloadMarkdown":"\n```tsx\nimport { Chart } from '@tanstack/charts/octane'\n```\n\nThe supplied definition infers the datum, semantic x/y values, and callbacks:\n\n```ts\nfunction Chart<\n  TDatum,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n>(props: ChartProps<TDatum, TXValue, TYValue>): unknown\n```\n\nThe definition owns `focus`, `focusRing`, `cursor`, `tooltip`, `svgAnimation`,\n`keyboard`, `maxFocusDistance`, and `spatialIndex`.\n\n## Renderer entry points\n\nThe default entry uses SVG. The optional entries keep other renderer code\nexplicit:\n\n```tsx\nimport { Chart as CanvasChart } from '@tanstack/charts/octane/canvas'\nimport { Chart as RendererChart } from '@tanstack/charts/octane/core'\n\nconst canvasChart = (\n  <CanvasChart definition={definition} ariaLabel=\"Weekly revenue\" />\n)\nconst rendererChart = (\n  <RendererChart\n    definition={definition}\n    renderer={myRenderer}\n    ariaLabel=\"Weekly revenue\"\n  />\n)\n```\n\nThe Canvas `Chart` accepts the common interaction and sizing props except\n`renderSvg`. Its `onRender` receives `ChartRendererRenderContext`. The `/core`\n`Chart` also requires `renderer: ChartRenderer`. Both entries export\n`ChartCommonProps`, `ChartProps`, `ChartTooltipBodyRenderContext`,\n`ChartDefinition`, and `ChartPoint`.\n\n## Definition props\n\n| Prop         | Default  | Meaning                                                                       |\n| ------------ | -------- | ----------------------------------------------------------------------------- |\n| `definition` | Required | Framework-independent definition; identity is the application update boundary |\n\nSee [Chart Definition API](../../../reference/chart-definitions.md).\n\n## Accessibility and sizing\n\n| Prop              | Type                                            | Default                    | Meaning                                              |\n| ----------------- | ----------------------------------------------- | -------------------------- | ---------------------------------------------------- |\n| `ariaLabel`       | `string`                                        | Required                   | Accessible surface name                              |\n| `ariaDescription` | `string`                                        | None                       | Optional surface description                         |\n| `tabIndex`        | `number`                                        | `0`                        | Surface tab index while keyboard behavior is enabled |\n| `height`          | `number`                                        | `320` without aspect ratio | Fixed CSS and scene height                           |\n| `aspectRatio`     | `number`                                        | None                       | Positive width-to-height ratio when height is absent |\n| `width`           | `number`                                        | Responsive                 | Fixed CSS and scene width                            |\n| `initialWidth`    | `number`                                        | `640`                      | Initial and server width                             |\n| `class`           | `string`                                        | None                       | Extra class on the outer `ts-chart-host` element     |\n| `style`           | `Record<string, string \\| number \\| undefined>` | None                       | Outer host styles applied after adapter sizing       |\n\nSee [Sizing and layout](../adapter.md#sizing-and-layout).\n\n## Focus, tooltip, and callbacks\n\n| Prop                 | Type                                                     | Default | Meaning                                                              |\n| -------------------- | -------------------------------------------------------- | ------- | -------------------------------------------------------------------- |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`                    | None    | Primary focus callback                                               |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void`                | None    | Grouped focus callback                                               |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`                    | None    | Click and keyboard activation callback                               |\n| `onRender`           | `(context: ChartRenderContext) => void`                  | None    | Inner host, default SVG, complete surface, and scene after rendering |\n| `renderTooltipBody`  | `(context: ChartTooltipBodyRenderContext) => OctaneNode` | None    | Composes Octane content inside the built-in tooltip body             |\n\n```tsx\n<Chart\n  definition={definition}\n  ariaLabel=\"Revenue\"\n  renderTooltipBody={({ points, defaultBody, pinned, dismiss }) => (\n    <div>\n      {defaultBody}\n      <SeriesDetail points={points} />\n      {pinned ? <button onClick={dismiss}>Close</button> : null}\n    </div>\n  )}\n/>\n```\n\nThe context also exposes the resolved `content`. Ordering, anchoring,\nplacement, portaling, and pinning remain in the definition. The prop is\navailable from the default, `/canvas`, and `/core` entries.\n\nSee [Focus and interaction](../../../reference/focus-and-interaction.md).\n\n## Rendering and layout extensions\n\n| Prop          | Type                                         | Default                     | Meaning                                |\n| ------------- | -------------------------------------------- | --------------------------- | -------------------------------------- |\n| `idPrefix`    | `string`                                     | Generated from `useId()`    | Prefix for renderer-owned resource IDs |\n| `renderSvg`   | `ChartSvgRenderer<TDatum, TXValue, TYValue>` | `renderChartSvg`            | Scene-to-SVG renderer                  |\n| `measureText` | `ChartTextMeasurer`                          | DOM inherited-font measurer | Guide glyph measurement                |\n\nSee [Rendering and export](../../../reference/rendering-and-export.md) and\n[Scales, guides, and color](../../../reference/scales-guides-and-color.md).\n\n## Exported prop types\n\nThe adapter exports `ChartCommonProps`, `ChartProps`, and\n`ChartTooltipBodyRenderContext`.\n\n```ts\ninterface ChartCommonProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> {\n  // every common prop listed above\n}\n\ntype ChartProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> = ChartCommonProps<TDatum, TXValue, TYValue> & {\n  definition: ChartDefinition<TDatum, TXValue, TYValue>\n}\n```\n\nThe package also re-exports `ChartDefinition` and `ChartPoint`. Prefer\ninference at the component call site. Memoize definitions that capture\ncomponent values; see [Types](../../../reference/types.md).\n","originalRawMarkdown":"---\ntitle: Octane Chart\ndescription: Complete prop and type reference for the @tanstack/charts/octane Chart component.\n---\n\n```tsx\nimport { Chart } from '@tanstack/charts/octane'\n```\n\nThe supplied definition infers the datum, semantic x/y values, and callbacks:\n\n```ts\nfunction Chart<\n  TDatum,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n>(props: ChartProps<TDatum, TXValue, TYValue>): unknown\n```\n\nThe definition owns `focus`, `focusRing`, `cursor`, `tooltip`, `svgAnimation`,\n`keyboard`, `maxFocusDistance`, and `spatialIndex`.\n\n## Renderer entry points\n\nThe default entry uses SVG. The optional entries keep other renderer code\nexplicit:\n\n```tsx\nimport { Chart as CanvasChart } from '@tanstack/charts/octane/canvas'\nimport { Chart as RendererChart } from '@tanstack/charts/octane/core'\n\nconst canvasChart = (\n  <CanvasChart definition={definition} ariaLabel=\"Weekly revenue\" />\n)\nconst rendererChart = (\n  <RendererChart\n    definition={definition}\n    renderer={myRenderer}\n    ariaLabel=\"Weekly revenue\"\n  />\n)\n```\n\nThe Canvas `Chart` accepts the common interaction and sizing props except\n`renderSvg`. Its `onRender` receives `ChartRendererRenderContext`. The `/core`\n`Chart` also requires `renderer: ChartRenderer`. Both entries export\n`ChartCommonProps`, `ChartProps`, `ChartTooltipBodyRenderContext`,\n`ChartDefinition`, and `ChartPoint`.\n\n## Definition props\n\n| Prop         | Default  | Meaning                                                                       |\n| ------------ | -------- | ----------------------------------------------------------------------------- |\n| `definition` | Required | Framework-independent definition; identity is the application update boundary |\n\nSee [Chart Definition API](../../../reference/chart-definitions.md).\n\n## Accessibility and sizing\n\n| Prop              | Type                                            | Default                    | Meaning                                              |\n| ----------------- | ----------------------------------------------- | -------------------------- | ---------------------------------------------------- |\n| `ariaLabel`       | `string`                                        | Required                   | Accessible surface name                              |\n| `ariaDescription` | `string`                                        | None                       | Optional surface description                         |\n| `tabIndex`        | `number`                                        | `0`                        | Surface tab index while keyboard behavior is enabled |\n| `height`          | `number`                                        | `320` without aspect ratio | Fixed CSS and scene height                           |\n| `aspectRatio`     | `number`                                        | None                       | Positive width-to-height ratio when height is absent |\n| `width`           | `number`                                        | Responsive                 | Fixed CSS and scene width                            |\n| `initialWidth`    | `number`                                        | `640`                      | Initial and server width                             |\n| `class`           | `string`                                        | None                       | Extra class on the outer `ts-chart-host` element     |\n| `style`           | `Record<string, string \\| number \\| undefined>` | None                       | Outer host styles applied after adapter sizing       |\n\nSee [Sizing and layout](../adapter.md#sizing-and-layout).\n\n## Focus, tooltip, and callbacks\n\n| Prop                 | Type                                                     | Default | Meaning                                                              |\n| -------------------- | -------------------------------------------------------- | ------- | -------------------------------------------------------------------- |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`                    | None    | Primary focus callback                                               |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void`                | None    | Grouped focus callback                                               |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`                    | None    | Click and keyboard activation callback                               |\n| `onRender`           | `(context: ChartRenderContext) => void`                  | None    | Inner host, default SVG, complete surface, and scene after rendering |\n| `renderTooltipBody`  | `(context: ChartTooltipBodyRenderContext) => OctaneNode` | None    | Composes Octane content inside the built-in tooltip body             |\n\n```tsx\n<Chart\n  definition={definition}\n  ariaLabel=\"Revenue\"\n  renderTooltipBody={({ points, defaultBody, pinned, dismiss }) => (\n    <div>\n      {defaultBody}\n      <SeriesDetail points={points} />\n      {pinned ? <button onClick={dismiss}>Close</button> : null}\n    </div>\n  )}\n/>\n```\n\nThe context also exposes the resolved `content`. Ordering, anchoring,\nplacement, portaling, and pinning remain in the definition. The prop is\navailable from the default, `/canvas`, and `/core` entries.\n\nSee [Focus and interaction](../../../reference/focus-and-interaction.md).\n\n## Rendering and layout extensions\n\n| Prop          | Type                                         | Default                     | Meaning                                |\n| ------------- | -------------------------------------------- | --------------------------- | -------------------------------------- |\n| `idPrefix`    | `string`                                     | Generated from `useId()`    | Prefix for renderer-owned resource IDs |\n| `renderSvg`   | `ChartSvgRenderer<TDatum, TXValue, TYValue>` | `renderChartSvg`            | Scene-to-SVG renderer                  |\n| `measureText` | `ChartTextMeasurer`                          | DOM inherited-font measurer | Guide glyph measurement                |\n\nSee [Rendering and export](../../../reference/rendering-and-export.md) and\n[Scales, guides, and color](../../../reference/scales-guides-and-color.md).\n\n## Exported prop types\n\nThe adapter exports `ChartCommonProps`, `ChartProps`, and\n`ChartTooltipBodyRenderContext`.\n\n```ts\ninterface ChartCommonProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> {\n  // every common prop listed above\n}\n\ntype ChartProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> = ChartCommonProps<TDatum, TXValue, TYValue> & {\n  definition: ChartDefinition<TDatum, TXValue, TYValue>\n}\n```\n\nThe package also re-exports `ChartDefinition` and `ChartPoint`. Prefer\ninference at the component call site. Memoize definitions that capture\ncomponent values; see [Types](../../../reference/types.md).\n"}
