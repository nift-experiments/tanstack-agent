eCode","value":"ariaDescription"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional accessible description"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"height"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"320"},{"type":"text","value":" without a ratio"}]},{"type":"tableCell","children":[{"type":"text","value":"Fixed CSS and scene height"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"aspectRatio"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Positive width-to-height ratio when height is absent"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"width"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Responsive"}]},{"type":"tableCell","children":[{"type":"text","value":"Fixed CSS and scene width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"initialWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"640"}]},{"type":"tableCell","children":[{"type":"text","value":"Initial and server width before responsive measurement"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"tabIndex"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"Surface tab index; "},{"type":"inlineCode","value":"keyboard: false"},{"type":"text","value":" forces "},{"type":"inlineCode","value":"-1"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"idPrefix"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Generated"}]},{"type":"tableCell","children":[{"type":"text","value":"Prefix for renderer-owned document IDs"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderSvg"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartSvgRenderer<TDatum, TXValue, TYValue>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"renderChartSvg"}]},{"type":"tableCell","children":[{"type":"text","value":"Scene-to-SVG renderer"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"measureText"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartTextMeasurer"}]},{"type":"tableCell","children":[{"type":"text","value":"Host measurer"}]},{"type":"tableCell","children":[{"type":"text","value":"Guide text measurement"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Primary focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusGroupChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(points: readonly ChartPoint[]) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Grouped focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onSelect"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Pointer or keyboard activation callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onRender"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartRenderContext) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Default SVG, complete surface, container, and scene after rendering"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderTooltipBody"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartTooltipBodyRenderContext) => ComponentChildren"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Composes Preact content inside the built-in tooltip body"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"className"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Extra class on the outer "},{"type":"inlineCode","value":".ts-chart-host"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"style"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"JSX.CSSProperties"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Outer host styles applied after adapter sizing"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Custom outer styles can override the adapter's computed layout. A fixed\n"},{"type":"inlineCode","value":"width"},{"type":"text","value":" prop still controls scene measurement, so do not give "},{"type":"inlineCode","value":"style.width"},{"type":"text","value":" a\nconflicting value."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"renderTooltipBody"},{"type":"text","value":" receives "},{"type":"inlineCode","value":"points"},{"type":"text","value":", "},{"type":"inlineCode","value":"content"},{"type":"text","value":", "},{"type":"inlineCode","value":"defaultBody"},{"type":"text","value":", "},{"type":"inlineCode","value":"pinned"},{"type":"text","value":", and\n"},{"type":"inlineCode","value":"dismiss"},{"type":"text","value":". Include "},{"type":"inlineCode","value":"defaultBody"},{"type":"text","value":" to keep the native title, rows, formatting,\nand swatches. Ordering, anchoring, placement, portaling, and pinning remain in\nthe definition."}]},{"type":"heading","depth":2,"id":"exported-types","children":[{"type":"text","value":"Exported types"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ChartCommonProps"},{"type":"text","value":" contains the common host and presentation props.\n"},{"type":"inlineCode","value":"ChartProps"},{"type":"text","value":" adds the definition. "},{"type":"inlineCode","value":"ChartPresentationProps"},{"type":"text","value":" contains\n"},{"type":"inlineCode","value":"className"},{"type":"text","value":" and "},{"type":"inlineCode","value":"style"},{"type":"text","value":". "},{"type":"inlineCode","value":"ChartTooltipBodyRenderContext"},{"type":"text","value":" describes composed\ntooltip content. The package also re-exports "},{"type":"inlineCode","value":"ChartDefinition"},{"type":"text","value":" and "},{"type":"inlineCode","value":"ChartPoint"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../adapter.md","children":[{"type":"text","value":"Preact adapter"}]},{"type":"text","value":" for lifecycle and SSR behavior,\n"},{"type":"link","href":"../../../reference/focus-and-interaction.md","children":[{"type":"text","value":"Focus and interaction"}]},{"type":"text","value":" for\ncallback semantics, and "},{"type":"link","href":"../../../reference/rendering-and-export.md","children":[{"type":"text","value":"Rendering and export"}]},{"type":"text","value":"\nfor custom SVG renderers."}]}],"headings":[{"id":"props","text":"Props","level":2},{"id":"exported-types","text":"Exported types","level":2}]},"frameworks":[],"downloadMarkdown":"\n```tsx\nimport { Chart } from '@tanstack/charts/preact'\n```\n\nThe definition infers datum and coordinate types for every callback. Replace\nits identity when captured application values change.\nIt also owns `focus`, `focusRing`, `cursor`, `tooltip`, `svgAnimation`, `keyboard`,\n`maxFocusDistance`, and `spatialIndex`.\n\n## Props\n\n| Prop                 | Type                                                            | Default               | Meaning                                                             |\n| -------------------- | --------------------------------------------------------------- | --------------------- | ------------------------------------------------------------------- |\n| `definition`         | `ChartDefinition`                                               | Required              | Framework-neutral chart definition                                  |\n| `ariaLabel`          | `string`                                                        | Required              | Accessible chart name                                               |\n| `ariaDescription`    | `string`                                                        | None                  | Optional accessible description                                     |\n| `height`             | `number`                                                        | `320` without a ratio | Fixed CSS and scene height                                          |\n| `aspectRatio`        | `number`                                                        | None                  | Positive width-to-height ratio when height is absent                |\n| `width`              | `number`                                                        | Responsive            | Fixed CSS and scene width                                           |\n| `initialWidth`       | `number`                                                        | `640`                 | Initial and server width before responsive measurement              |\n| `tabIndex`           | `number`                                                        | `0`                   | Surface tab index; `keyboard: false` forces `-1`                    |\n| `idPrefix`           | `string`                                                        | Generated             | Prefix for renderer-owned document IDs                              |\n| `renderSvg`          | `ChartSvgRenderer<TDatum, TXValue, TYValue>`                    | `renderChartSvg`      | Scene-to-SVG renderer                                               |\n| `measureText`        | `ChartTextMeasurer`                                             | Host measurer         | Guide text measurement                                              |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`                           | None                  | Primary focus callback                                              |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void`                       | None                  | Grouped focus callback                                              |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`                           | None                  | Pointer or keyboard activation callback                             |\n| `onRender`           | `(context: ChartRenderContext) => void`                         | None                  | Default SVG, complete surface, container, and scene after rendering |\n| `renderTooltipBody`  | `(context: ChartTooltipBodyRenderContext) => ComponentChildren` | None                  | Composes Preact content inside the built-in tooltip body            |\n| `className`          | `string`                                                        | None                  | Extra class on the outer `.ts-chart-host`                           |\n| `style`              | `JSX.CSSProperties`                                             | None                  | Outer host styles applied after adapter sizing                      |\n\nCustom outer styles can override the adapter's computed layout. A fixed\n`width` prop still controls scene measurement, so do not give `style.width` a\nconflicting value.\n\n`renderTooltipBody` receives `points`, `content`, `defaultBody`, `pinned`, and\n`dismiss`. Include `defaultBody` to keep the native title, rows, formatting,\nand swatches. Ordering, anchoring, placement, portaling, and pinning remain in\nthe definition.\n\n## Exported types\n\n`ChartCommonProps` contains the common host and presentation props.\n`ChartProps` adds the definition. `ChartPresentationProps` contains\n`className` and `style`. `ChartTooltipBodyRenderContext` describes composed\ntooltip content. The package also re-exports `ChartDefinition` and `ChartPoint`.\n\nSee the [Preact adapter](../adapter.md) for lifecycle and SSR behavior,\n[Focus and interaction](../../../reference/focus-and-interaction.md) for\ncallback semantics, and [Rendering and export](../../../reference/rendering-and-export.md)\nfor custom SVG renderers.\n","originalRawMarkdown":"---\ntitle: Preact Chart\ndescription: Complete prop and type reference for the @tanstack/charts/preact Chart component.\n---\n\n```tsx\nimport { Chart } from '@tanstack/charts/preact'\n```\n\nThe definition infers datum and coordinate types for every callback. Replace\nits identity when captured application values change.\nIt also owns `focus`, `focusRing`, `cursor`, `tooltip`, `svgAnimation`, `keyboard`,\n`maxFocusDistance`, and `spatialIndex`.\n\n## Props\n\n| Prop                 | Type                                                            | Default               | Meaning                                                             |\n| -------------------- | --------------------------------------------------------------- | --------------------- | ------------------------------------------------------------------- |\n| `definition`         | `ChartDefinition`                                               | Required              | Framework-neutral chart definition                                  |\n| `ariaLabel`          | `string`                                                        | Required              | Accessible chart name                                               |\n| `ariaDescription`    | `string`                                                        | None                  | Optional accessible description                                     |\n| `height`             | `number`                                                        | `320` without a ratio | Fixed CSS and scene height                                          |\n| `aspectRatio`        | `number`                                                        | None                  | Positive width-to-height ratio when height is absent                |\n| `width`              | `number`                                                        | Responsive            | Fixed CSS and scene width                                           |\n| `initialWidth`       | `number`                                                        | `640`                 | Initial and server width before responsive measurement              |\n| `tabIndex`           | `number`                                                        | `0`                   | Surface tab index; `keyboard: false` forces `-1`                    |\n| `idPrefix`           | `string`                                                        | Generated             | Prefix for renderer-owned document IDs                              |\n| `renderSvg`          | `ChartSvgRenderer<TDatum, TXValue, TYValue>`                    | `renderChartSvg`      | Scene-to-SVG renderer                                               |\n| `measureText`        | `ChartTextMeasurer`                                             | Host measurer         | Guide text measurement                                              |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`                           | None                  | Primary focus callback                                              |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void`                       | None                  | Grouped focus callback                                              |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`                           | None                  | Pointer or keyboard activation callback                             |\n| `onRender`           | `(context: ChartRenderContext) => void`                         | None                  | Default SVG, complete surface, container, and scene after rendering |\n| `renderTooltipBody`  | `(context: ChartTooltipBodyRenderContext) => ComponentChildren` | None                  | Composes Preact content inside the built-in tooltip body            |\n| `className`          | `string`                                                        | None                  | Extra class on the outer `.ts-chart-host`                           |\n| `style`              | `JSX.CSSProperties`                                             | None                  | Outer host styles applied after adapter sizing                      |\n\nCustom outer styles can override the adapter's computed layout. A fixed\n`width` prop still controls scene measurement, so do not give `style.width` a\nconflicting value.\n\n`renderTooltipBody` receives `points`, `content`, `defaultBody`, `pinned`, and\n`dismiss`. Include `defaultBody` to keep the native title, rows, formatting,\nand swatches. Ordering, anchoring, placement, portaling, and pinning remain in\nthe definition.\n\n## Exported types\n\n`ChartCommonProps` contains the common host and presentation props.\n`ChartProps` adds the definition. `ChartPresentationProps` contains\n`className` and `style`. `ChartTooltipBodyRenderContext` describes composed\ntooltip content. The package also re-exports `ChartDefinition` and `ChartPoint`.\n\nSee the [Preact adapter](../adapter.md) for lifecycle and SSR behavior,\n[Focus and interaction](../../../reference/focus-and-interaction.md) for\ncallback semantics, and [Rendering and export](../../../reference/rendering-and-export.md)\nfor custom SVG renderers.\n"}
