tio"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Positive width-to-height ratio when height is absent"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"width"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Responsive"}]},{"type":"tableCell","children":[{"type":"text","value":"Fixed CSS and scene width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"initialWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"640"}]},{"type":"tableCell","children":[{"type":"text","value":"Initial and server width before responsive measurement"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"className"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Extra class on the outer "},{"type":"inlineCode","value":"ts-chart-host"},{"type":"text","value":" div"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"style"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"React.CSSProperties"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Outer host styles, applied after adapter sizing styles"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../adapter.md#sizing-and-layout","children":[{"type":"text","value":"Sizing and layout"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"callbacks","children":[{"type":"text","value":"Callbacks"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Prop"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Primary focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onFocusGroupChange"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(points: readonly ChartPoint[]) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Grouped focus callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onSelect"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(point: ChartPoint | null) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Click and keyboard activation callback"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"onRender"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartRenderContext) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Inner host, default SVG, complete surface, and scene after rendering"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../../../reference/focus-and-interaction.md","children":[{"type":"text","value":"Focus and interaction"}]},{"type":"text","value":" for\nthe behavior and complete callback values."}]},{"type":"heading","depth":2,"id":"tooltip-body","children":[{"type":"text","value":"Tooltip body"}]},{"type":"paragraph","children":[{"type":"text","value":"Import the drop-in component from the optional tooltip entry to use\n"},{"type":"inlineCode","value":"renderTooltipBody"},{"type":"text","value":":"}]},{"type":"code","value":"import {\n  Chart,\n  CanvasChart,\n  RendererChart,\n} from '@tanstack/charts/react/tooltip'","lang":"tsx"},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Prop"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderTooltipBody"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(context: ChartTooltipBodyRenderContext) => ReactNode"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Composes React content inside the native surface"}]}]]},{"type":"code","value":"interface ChartTooltipBodyRenderContext<\n  TDatum,\n  TXValue extends ChartValue,\n  TYValue extends ChartValue,\n> {\n  points: readonly ChartPoint<TDatum, TXValue, TYValue>[]\n  content: ChartTooltipContent | string\n  defaultBody: React.ReactNode\n  pinned: boolean\n  dismiss: () => void\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultBody"},{"type":"text","value":" preserves native headings, rows, formatting, and swatches.\n"},{"type":"inlineCode","value":"points"},{"type":"text","value":" follows the definition's focus and tooltip sort policy. Render\ninteractive content only when "},{"type":"inlineCode","value":"pinned"},{"type":"text","value":" is true; transient tooltips do not\naccept pointer input. "},{"type":"inlineCode","value":"dismiss()"},{"type":"text","value":" clears the tooltip and restores chart focus\nwhen focus was inside its body."}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"tooltip.visibility: 'pinned'"},{"type":"text","value":" on the definition when the React body itself\nshould mount only after activation. Returning "},{"type":"inlineCode","value":"null"},{"type":"text","value":" is not needed to suppress\na transient native shell."}]},{"type":"paragraph","children":[{"type":"text","value":"Existing users of this prop should move "},{"type":"inlineCode","value":"Chart"},{"type":"text","value":" from\n"},{"type":"inlineCode","value":"@tanstack/charts/react"},{"type":"text","value":" to "},{"type":"inlineCode","value":"@tanstack/charts/react/tooltip"},{"type":"text","value":". Replace\n"},{"type":"inlineCode","value":"Chart as CanvasChart"},{"type":"text","value":" from "},{"type":"inlineCode","value":"/canvas"},{"type":"text","value":" or "},{"type":"inlineCode","value":"Chart as RendererChart"},{"type":"text","value":" from "},{"type":"inlineCode","value":"/core"},{"type":"text","value":"\nwith the corresponding named component from "},{"type":"inlineCode","value":"/tooltip"},{"type":"text","value":". Ordering, anchoring,\nplacement, portaling, and sticky behavior remain in the chart definition."}]},{"type":"heading","depth":2,"id":"rendering-and-layout-extensions","children":[{"type":"text","value":"Rendering and layout extensions"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Prop"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"idPrefix"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Generated from "},{"type":"inlineCode","value":"useId()"}]},{"type":"tableCell","children":[{"type":"text","value":"Prefix for renderer-owned document resources"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderSvg"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartSvgRenderer<TDatum, TXValue, TYValue>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"renderChartSvg"}]},{"type":"tableCell","children":[{"type":"text","value":"Scene-to-SVG renderer"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"measureText"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartTextMeasurer"}]},{"type":"tableCell","children":[{"type":"text","value":"DOM inherited-font measurer"}]},{"type":"tableCell","children":[{"type":"text","value":"Guide glyph measurement"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../../../reference/rendering-and-export.md","children":[{"type":"text","value":"Rendering and export"}]},{"type":"text","value":" and\n"},{"type":"link","href":"../../../reference/scales-guides-and-color.md","children":[{"type":"text","value":"Scales, guides, and color"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"exported-prop-types","children":[{"type":"text","value":"Exported prop types"}]},{"type":"paragraph","children":[{"type":"text","value":"The base entries export "},{"type":"inlineCode","value":"ChartCommonProps"},{"type":"text","value":" and "},{"type":"inlineCode","value":"ChartProps"},{"type":"text","value":". The "},{"type":"inlineCode","value":"/tooltip"},{"type":"text","value":"\nentry exports its extended "},{"type":"inlineCode","value":"ChartCommonProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartProps"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"RendererChartCommonProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"RendererChartProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"CanvasChartCommonProps"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"CanvasChartProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartTooltipBodyRenderProps"},{"type":"text","value":", and\n"},{"type":"inlineCode","value":"ChartTooltipBodyRenderContext"},{"type":"text","value":"."}]},{"type":"code","value":"interface ChartCommonProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> {\n  // every common prop listed above\n}\n\ntype ChartProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> = ChartCommonProps<TDatum, TXValue, TYValue> & {\n  definition: ChartDefinition<TDatum, TXValue, TYValue>\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The package also re-exports "},{"type":"inlineCode","value":"ChartDefinition"},{"type":"text","value":" and "},{"type":"inlineCode","value":"ChartPoint"},{"type":"text","value":". Prefer\ninference at the component call site. Memoize definitions that capture\ncomponent values; see "},{"type":"link","href":"../../../reference/types.md","children":[{"type":"text","value":"Types"}]},{"type":"text","value":"."}]}],"headings":[{"id":"renderer-entry-points","text":"Renderer entry points","level":2},{"id":"definition-props","text":"Definition props","level":2},{"id":"accessibility-and-sizing","text":"Accessibility and sizing","level":2},{"id":"callbacks","text":"Callbacks","level":2},{"id":"tooltip-body","text":"Tooltip body","level":2},{"id":"rendering-and-layout-extensions","text":"Rendering and layout extensions","level":2},{"id":"exported-prop-types","text":"Exported prop types","level":2}]},"frameworks":[],"downloadMarkdown":"\n```tsx\nimport { Chart } from '@tanstack/charts/react'\n```\n\nThe supplied definition infers the datum, semantic x/y values, and callbacks.\n\n```ts\nfunction Chart<\n  TDatum,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n>(props: ChartProps<TDatum, TXValue, TYValue>): React.JSX.Element\n```\n\n## Renderer entry points\n\nThe default entry uses SVG. The optional entries keep other renderer code\nexplicit:\n\n```tsx\nimport { Chart as CanvasChart } from '@tanstack/charts/react/canvas'\nimport { Chart as RendererChart } from '@tanstack/charts/react/core'\n\nconst canvasChart = (\n  <CanvasChart definition={definition} ariaLabel=\"Weekly revenue\" />\n)\nconst rendererChart = (\n  <RendererChart\n    definition={definition}\n    renderer={myRenderer}\n    ariaLabel=\"Weekly revenue\"\n  />\n)\n```\n\nThe Canvas `Chart` accepts the same adapter props except `renderSvg`. Its\n`onRender` receives `ChartRendererRenderContext`. The `/core`\n`Chart` also requires `renderer: ChartRenderer`; use it for application-owned\nsurfaces. Both entries export `ChartCommonProps`, `ChartProps`,\n`ChartDefinition`, and `ChartPoint`.\n\nThese base entries render the built-in tooltip without React tooltip-body\ncomposition.\n\n## Definition props\n\n| Prop         | Default  | Meaning                                                                       |\n| ------------ | -------- | ----------------------------------------------------------------------------- |\n| `definition` | Required | Framework-independent definition; identity is the application update boundary |\n\nSee [Chart Definition API](../../../reference/chart-definitions.md).\n\nThe definition owns `focus`, `focusRing`, `cursor`, `maxFocusDistance`,\n`spatialIndex`, `svgAnimation`, `keyboard`, and `tooltip`. Adapters do not override\nthem.\n\nAdd the `portal` extension to the definition's tooltip options to escape\nclipping and local stacking contexts. The adapter still receives no portal\noverride.\n\n## Accessibility and sizing\n\n| Prop              | Type                  | Default                    | Meaning                                                |\n| ----------------- | --------------------- | -------------------------- | ------------------------------------------------------ |\n| `ariaLabel`       | `string`              | Required                   | Accessible surface name                                |\n| `ariaDescription` | `string`              | None                       | Optional surface description                           |\n| `tabIndex`        | `number`              | `0`                        | Surface tab index while keyboard behavior is enabled   |\n| `height`          | `number`              | `320` without aspect ratio | Fixed CSS and scene height                             |\n| `aspectRatio`     | `number`              | None                       | Positive width-to-height ratio when height is absent   |\n| `width`           | `number`              | Responsive                 | Fixed CSS and scene width                              |\n| `initialWidth`    | `number`              | `640`                      | Initial and server width before responsive measurement |\n| `className`       | `string`              | None                       | Extra class on the outer `ts-chart-host` div           |\n| `style`           | `React.CSSProperties` | None                       | Outer host styles, applied after adapter sizing styles |\n\nSee [Sizing and layout](../adapter.md#sizing-and-layout).\n\n## Callbacks\n\n| Prop                 | Type                                      | Default | Meaning                                                              |\n| -------------------- | ----------------------------------------- | ------- | -------------------------------------------------------------------- |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`     | None    | Primary focus callback                                               |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void` | None    | Grouped focus callback                                               |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`     | None    | Click and keyboard activation callback                               |\n| `onRender`           | `(context: ChartRenderContext) => void`   | None    | Inner host, default SVG, complete surface, and scene after rendering |\n\nSee [Focus and interaction](../../../reference/focus-and-interaction.md) for\nthe behavior and complete callback values.\n\n## Tooltip body\n\nImport the drop-in component from the optional tooltip entry to use\n`renderTooltipBody`:\n\n```tsx\nimport {\n  Chart,\n  CanvasChart,\n  RendererChart,\n} from '@tanstack/charts/react/tooltip'\n```\n\n| Prop                | Type                                                    | Default | Meaning                                          |\n| ------------------- | ------------------------------------------------------- | ------- | ------------------------------------------------ |\n| `renderTooltipBody` | `(context: ChartTooltipBodyRenderContext) => ReactNode` | None    | Composes React content inside the native surface |\n\n```ts\ninterface ChartTooltipBodyRenderContext<\n  TDatum,\n  TXValue extends ChartValue,\n  TYValue extends ChartValue,\n> {\n  points: readonly ChartPoint<TDatum, TXValue, TYValue>[]\n  content: ChartTooltipContent | string\n  defaultBody: React.ReactNode\n  pinned: boolean\n  dismiss: () => void\n}\n```\n\n`defaultBody` preserves native headings, rows, formatting, and swatches.\n`points` follows the definition's focus and tooltip sort policy. Render\ninteractive content only when `pinned` is true; transient tooltips do not\naccept pointer input. `dismiss()` clears the tooltip and restores chart focus\nwhen focus was inside its body.\n\nSet `tooltip.visibility: 'pinned'` on the definition when the React body itself\nshould mount only after activation. Returning `null` is not needed to suppress\na transient native shell.\n\nExisting users of this prop should move `Chart` from\n`@tanstack/charts/react` to `@tanstack/charts/react/tooltip`. Replace\n`Chart as CanvasChart` from `/canvas` or `Chart as RendererChart` from `/core`\nwith the corresponding named component from `/tooltip`. Ordering, anchoring,\nplacement, portaling, and sticky behavior remain in the chart definition.\n\n## Rendering and layout extensions\n\n| Prop          | Type                                         | Default                     | Meaning                                      |\n| ------------- | -------------------------------------------- | --------------------------- | -------------------------------------------- |\n| `idPrefix`    | `string`                                     | Generated from `useId()`    | Prefix for renderer-owned document resources |\n| `renderSvg`   | `ChartSvgRenderer<TDatum, TXValue, TYValue>` | `renderChartSvg`            | Scene-to-SVG renderer                        |\n| `measureText` | `ChartTextMeasurer`                          | DOM inherited-font measurer | Guide glyph measurement                      |\n\nSee [Rendering and export](../../../reference/rendering-and-export.md) and\n[Scales, guides, and color](../../../reference/scales-guides-and-color.md).\n\n## Exported prop types\n\nThe base entries export `ChartCommonProps` and `ChartProps`. The `/tooltip`\nentry exports its extended `ChartCommonProps`, `ChartProps`,\n`RendererChartCommonProps`, `RendererChartProps`, `CanvasChartCommonProps`,\n`CanvasChartProps`, `ChartTooltipBodyRenderProps`, and\n`ChartTooltipBodyRenderContext`.\n\n```ts\ninterface ChartCommonProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> {\n  // every common prop listed above\n}\n\ntype ChartProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> = ChartCommonProps<TDatum, TXValue, TYValue> & {\n  definition: ChartDefinition<TDatum, TXValue, TYValue>\n}\n```\n\nThe package also re-exports `ChartDefinition` and `ChartPoint`. Prefer\ninference at the component call site. Memoize definitions that capture\ncomponent values; see [Types](../../../reference/types.md).\n","originalRawMarkdown":"---\ntitle: React Chart\ndescription: Complete prop and type reference for the @tanstack/charts/react Chart component.\n---\n\n```tsx\nimport { Chart } from '@tanstack/charts/react'\n```\n\nThe supplied definition infers the datum, semantic x/y values, and callbacks.\n\n```ts\nfunction Chart<\n  TDatum,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n>(props: ChartProps<TDatum, TXValue, TYValue>): React.JSX.Element\n```\n\n## Renderer entry points\n\nThe default entry uses SVG. The optional entries keep other renderer code\nexplicit:\n\n```tsx\nimport { Chart as CanvasChart } from '@tanstack/charts/react/canvas'\nimport { Chart as RendererChart } from '@tanstack/charts/react/core'\n\nconst canvasChart = (\n  <CanvasChart definition={definition} ariaLabel=\"Weekly revenue\" />\n)\nconst rendererChart = (\n  <RendererChart\n    definition={definition}\n    renderer={myRenderer}\n    ariaLabel=\"Weekly revenue\"\n  />\n)\n```\n\nThe Canvas `Chart` accepts the same adapter props except `renderSvg`. Its\n`onRender` receives `ChartRendererRenderContext`. The `/core`\n`Chart` also requires `renderer: ChartRenderer`; use it for application-owned\nsurfaces. Both entries export `ChartCommonProps`, `ChartProps`,\n`ChartDefinition`, and `ChartPoint`.\n\nThese base entries render the built-in tooltip without React tooltip-body\ncomposition.\n\n## Definition props\n\n| Prop         | Default  | Meaning                                                                       |\n| ------------ | -------- | ----------------------------------------------------------------------------- |\n| `definition` | Required | Framework-independent definition; identity is the application update boundary |\n\nSee [Chart Definition API](../../../reference/chart-definitions.md).\n\nThe definition owns `focus`, `focusRing`, `cursor`, `maxFocusDistance`,\n`spatialIndex`, `svgAnimation`, `keyboard`, and `tooltip`. Adapters do not override\nthem.\n\nAdd the `portal` extension to the definition's tooltip options to escape\nclipping and local stacking contexts. The adapter still receives no portal\noverride.\n\n## Accessibility and sizing\n\n| Prop              | Type                  | Default                    | Meaning                                                |\n| ----------------- | --------------------- | -------------------------- | ------------------------------------------------------ |\n| `ariaLabel`       | `string`              | Required                   | Accessible surface name                                |\n| `ariaDescription` | `string`              | None                       | Optional surface description                           |\n| `tabIndex`        | `number`              | `0`                        | Surface tab index while keyboard behavior is enabled   |\n| `height`          | `number`              | `320` without aspect ratio | Fixed CSS and scene height                             |\n| `aspectRatio`     | `number`              | None                       | Positive width-to-height ratio when height is absent   |\n| `width`           | `number`              | Responsive                 | Fixed CSS and scene width                              |\n| `initialWidth`    | `number`              | `640`                      | Initial and server width before responsive measurement |\n| `className`       | `string`              | None                       | Extra class on the outer `ts-chart-host` div           |\n| `style`           | `React.CSSProperties` | None                       | Outer host styles, applied after adapter sizing styles |\n\nSee [Sizing and layout](../adapter.md#sizing-and-layout).\n\n## Callbacks\n\n| Prop                 | Type                                      | Default | Meaning                                                              |\n| -------------------- | ----------------------------------------- | ------- | -------------------------------------------------------------------- |\n| `onFocusChange`      | `(point: ChartPoint \\| null) => void`     | None    | Primary focus callback                                               |\n| `onFocusGroupChange` | `(points: readonly ChartPoint[]) => void` | None    | Grouped focus callback                                               |\n| `onSelect`           | `(point: ChartPoint \\| null) => void`     | None    | Click and keyboard activation callback                               |\n| `onRender`           | `(context: ChartRenderContext) => void`   | None    | Inner host, default SVG, complete surface, and scene after rendering |\n\nSee [Focus and interaction](../../../reference/focus-and-interaction.md) for\nthe behavior and complete callback values.\n\n## Tooltip body\n\nImport the drop-in component from the optional tooltip entry to use\n`renderTooltipBody`:\n\n```tsx\nimport {\n  Chart,\n  CanvasChart,\n  RendererChart,\n} from '@tanstack/charts/react/tooltip'\n```\n\n| Prop                | Type                                                    | Default | Meaning                                          |\n| ------------------- | ------------------------------------------------------- | ------- | ------------------------------------------------ |\n| `renderTooltipBody` | `(context: ChartTooltipBodyRenderContext) => ReactNode` | None    | Composes React content inside the native surface |\n\n```ts\ninterface ChartTooltipBodyRenderContext<\n  TDatum,\n  TXValue extends ChartValue,\n  TYValue extends ChartValue,\n> {\n  points: readonly ChartPoint<TDatum, TXValue, TYValue>[]\n  content: ChartTooltipContent | string\n  defaultBody: React.ReactNode\n  pinned: boolean\n  dismiss: () => void\n}\n```\n\n`defaultBody` preserves native headings, rows, formatting, and swatches.\n`points` follows the definition's focus and tooltip sort policy. Render\ninteractive content only when `pinned` is true; transient tooltips do not\naccept pointer input. `dismiss()` clears the tooltip and restores chart focus\nwhen focus was inside its body.\n\nSet `tooltip.visibility: 'pinned'` on the definition when the React body itself\nshould mount only after activation. Returning `null` is not needed to suppress\na transient native shell.\n\nExisting users of this prop should move `Chart` from\n`@tanstack/charts/react` to `@tanstack/charts/react/tooltip`. Replace\n`Chart as CanvasChart` from `/canvas` or `Chart as RendererChart` from `/core`\nwith the corresponding named component from `/tooltip`. Ordering, anchoring,\nplacement, portaling, and sticky behavior remain in the chart definition.\n\n## Rendering and layout extensions\n\n| Prop          | Type                                         | Default                     | Meaning                                      |\n| ------------- | -------------------------------------------- | --------------------------- | -------------------------------------------- |\n| `idPrefix`    | `string`                                     | Generated from `useId()`    | Prefix for renderer-owned document resources |\n| `renderSvg`   | `ChartSvgRenderer<TDatum, TXValue, TYValue>` | `renderChartSvg`            | Scene-to-SVG renderer                        |\n| `measureText` | `ChartTextMeasurer`                          | DOM inherited-font measurer | Guide glyph measurement                      |\n\nSee [Rendering and export](../../../reference/rendering-and-export.md) and\n[Scales, guides, and color](../../../reference/scales-guides-and-color.md).\n\n## Exported prop types\n\nThe base entries export `ChartCommonProps` and `ChartProps`. The `/tooltip`\nentry exports its extended `ChartCommonProps`, `ChartProps`,\n`RendererChartCommonProps`, `RendererChartProps`, `CanvasChartCommonProps`,\n`CanvasChartProps`, `ChartTooltipBodyRenderProps`, and\n`ChartTooltipBodyRenderContext`.\n\n```ts\ninterface ChartCommonProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> {\n  // every common prop listed above\n}\n\ntype ChartProps<\n  TDatum = unknown,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n> = ChartCommonProps<TDatum, TXValue, TYValue> & {\n  definition: ChartDefinition<TDatum, TXValue, TYValue>\n}\n```\n\nThe package also re-exports `ChartDefinition` and `ChartPoint`. Prefer\ninference at the component call site. Memoize definitions that capture\ncomponent values; see [Types](../../../reference/types.md).\n"}
