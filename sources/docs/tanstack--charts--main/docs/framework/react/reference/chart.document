{"document":{"type":"root","children":[{"type":"code","value":"import { Chart } from '@tanstack/charts/react'","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The supplied definition infers the datum, semantic x/y values, and callbacks."}]},{"type":"code","value":"function Chart<\n  TDatum,\n  TXValue extends ChartValue = ChartValue,\n  TYValue extends ChartValue = ChartValue,\n>(props: ChartProps<TDatum, TXValue, TYValue>): React.JSX.Element","lang":"ts"},{"type":"heading","depth":2,"id":"renderer-entry-points","children":[{"type":"text","value":"Renderer entry points"}]},{"type":"paragraph","children":[{"type":"text","value":"The default entry uses SVG. The optional entries keep other renderer code\nexplicit:"}]},{"type":"code","value":"import { Chart as CanvasChart } from '@tanstack/charts/react/canvas'\nimport { Chart as RendererChart } from '@tanstack/charts/react/core'\n\nconst canvasChart = (\n  <CanvasChart definition={definition} ariaLabel=\"Weekly revenue\" />\n)\nconst rendererChart = (\n  <RendererChart\n    definition={definition}\n    renderer={myRenderer}\n    ariaLabel=\"Weekly revenue\"\n  />\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The Canvas "},{"type":"inlineCode","value":"Chart"},{"type":"text","value":" accepts the same adapter props except "},{"type":"inlineCode","value":"renderSvg"},{"type":"text","value":". Its\n"},{"type":"inlineCode","value":"onRender"},{"type":"text","value":" receives "},{"type":"inlineCode","value":"ChartRendererRenderContext"},{"type":"text","value":". The "},{"type":"inlineCode","value":"/core"},{"type":"text","value":"\n"},{"type":"inlineCode","value":"Chart"},{"type":"text","value":" also requires "},{"type":"inlineCode","value":"renderer: ChartRenderer"},{"type":"text","value":"; use it for application-owned\nsurfaces. Both entries export "},{"type":"inlineCode","value":"ChartCommonProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartProps"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"ChartDefinition"},{"type":"text","value":", and "},{"type":"inlineCode","value":"ChartPoint"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"These base entries render the built-in tooltip without React tooltip-body\ncomposition."}]},{"type":"heading","depth":2,"id":"definition-props","children":[{"type":"text","value":"Definition props"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Prop"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"definition"}]},{"type":"tableCell","children":[{"type":"text","value":"Required"}]},{"type":"tableCell","children":[{"type":"text","value":"Framework-independent definition; identity is the application update boundary"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"../../../reference/chart-definitions.md","children":[{"type":"text","value":"Chart Definition API"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The definition owns "},{"type":"inlineCode","value":"focus"},{"type":"text","value":", "},{"type":"inlineCode","value":"focusRing"},{"type":"text","value":", "},{"type":"inlineCode","value":"cursor"},{"type":"text","value":", "},{"type":"inlineCode","value":"maxFocusDistance"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"spatialIndex"},{"type":"text","value":", "},{"type":"inlineCode","value":"svgAnimation"},{"type":"text","value":", "},{"type":"inlineCode","value":"keyboard"},{"type":"text","value":", and "},{"type":"inlineCode","value":"tooltip"},{"type":"text","value":". Adapters do not override\nthem."}]},{"type":"paragraph","children":[{"type":"text","value":"Add the "},{"type":"inlineCode","value":"portal"