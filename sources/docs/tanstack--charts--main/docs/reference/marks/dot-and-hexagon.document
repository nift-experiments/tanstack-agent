e":"Horizontal value"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"y"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartValue?>"}]},{"type":"tableCell","children":[{"type":"text","value":"Numeric datum"}]},{"type":"tableCell","children":[{"type":"text","value":"Vertical value"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"text","value":"No group"}]},{"type":"tableCell","children":[{"type":"text","value":"Interaction group"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"color"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"text","value":"Value sent to the chart color scale"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"key"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey>"}]},{"type":"tableCell","children":[{"type":"text","value":"ID, x, y, x/y, index"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable scene and interaction identity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"r"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number | Channel<TDatum, number?>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"3.5"}]},{"type":"tableCell","children":[{"type":"text","value":"Raw radius value"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"rScale"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(value: number) => number"}]},{"type":"tableCell","children":[{"type":"text","value":"Identity"}]},{"type":"tableCell","children":[{"type":"text","value":"Maps each valid raw radius to pixels"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fill"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolved color"}]},{"type":"tableCell","children":[{"type":"text","value":"Final constant fill override"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fillOpacity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Fill opacity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"layout"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"DodgeXLayout | DodgeYLayout"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolved collision placement"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stroke"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Constant stroke"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeOpacity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Stroke opacity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Stroke width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"states"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"readonly ChartMarkState[]"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Focus-driven presentation overrides"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"With the motion renderer, inline "},{"type":"inlineCode","value":"states"},{"type":"text","value":" wait for active entrance or data\nmotion to settle. For a dot that appears immediately on focus during motion,\nuse a separate "},{"type":"link","href":"../motion.md#motion","children":[{"type":"inlineCode","value":"whenFocused"},{"type":"text","value":" mark"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"rScale"},{"type":"text","value":" is called only for finite, nonnegative raw radii. The mapped result\nmust also be finite and nonnegative or the row is skipped."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike "},{"type":"inlineCode","value":"hexagon"},{"type":"text","value":", "},{"type":"inlineCode","value":"dot.fill"},{"type":"text","value":" and "},{"type":"inlineCode","value":"dot.stroke"},{"type":"text","value":" are constants. Use "},{"type":"inlineCode","value":"color"},{"type":"text","value":" and\nthe chart color scale for data-driven dot color."}]},{"type":"paragraph","children":[{"type":"link","href":"./dodge.md","children":[{"type":"inlineCode","value":"dodgeX"},{"type":"text","value":" and "},{"type":"inlineCode","value":"dodgeY"}]},{"type":"text","value":" derive one dot coordinate after the\nmeasured axis scale and final plot bounds resolve. The generated coordinate\ndoes not contribute a positional scale domain."}]},{"type":"paragraph","children":[{"type":"text","value":"Without an explicit key, "},{"type":"inlineCode","value":"dot"},{"type":"text","value":" tries a unique top-level or nested "},{"type":"inlineCode","value":"data.id"},{"type":"text","value":",\nthen x, y, and the x/y tuple. Supply "},{"type":"inlineCode","value":"key"},{"type":"text","value":" when positions can change while the\nsame entity should reconcile across updates."}]},{"type":"heading","depth":2,"id":"hexagon","children":[{"type":"inlineCode","value":"hexagon"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"hexagon"},{"type":"text","value":" draws a pointy-topped six-sided symbol."}]},{"type":"code","value":"const mark = hexagon(bins, {\n  x: 'x',\n  y: 'y',\n  color: 'count',\n  r: 'count',\n  rScale: radiusScale,\n})","lang":"ts"},{"type":"code","value":"function hexagon<TDatum>(\n  source: Iterable<TDatum>,\n  options?: HexagonOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>","lang":"ts"},{"type":"heading","depth":3,"id":"options-2","children":[{"type":"text","value":"Options"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer-derived"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable mark ID"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"x"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartValue?>"}]},{"type":"tableCell","children":[{"type":"text","value":"Row index"}]},{"type":"tableCell","children":[{"type":"text","value":"Horizontal center"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"y"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartValue?>"}]},{"type":"tableCell","children":[{"type":"text","value":"Numeric datum"}]},{"type":"tableCell","children":[{"type":"text","value":"Vertical center"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"text","value":"No group"}]},{"type":"tableCell","children":[{"type":"text","value":"Interaction group"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"color"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"text","value":"Value sent to the chart color scale"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"key"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey>"}]},{"type":"tableCell","children":[{"type":"text","value":"Top/nested "},{"type":"inlineCode","value":"id"},{"type":"text","value":", index"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable identity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"r"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number | Channel<TDatum, number?>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"6"}]},{"type":"tableCell","children":[{"type":"text","value":"Raw circumradius"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"rScale"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(value: number) => number"}]},{"type":"tableCell","children":[{"type":"text","value":"Identity"}]},{"type":"tableCell","children":[{"type":"text","value":"Maps radius values to pixels"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fill"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<TDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolved color"}]},{"type":"tableCell","children":[{"type":"text","value":"Final fill override"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fillOpacity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Fill opacity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stroke"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<TDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional stroke per mark or row"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeOpacity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Stroke opacity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Stroke width"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"The generated vertices begin at the top and proceed in 60-degree increments.\nThe interaction point remains at the scaled center, and its "},{"type":"inlineCode","value":"color"},{"type":"text","value":" is the\nresolved fill."}]},{"type":"heading","depth":2,"id":"valid-rows-and-points","children":[{"type":"text","value":"Valid rows and points"}]},{"type":"paragraph","children":[{"type":"text","value":"Both marks skip a row when x or y is not a valid "},{"type":"inlineCode","value":"ChartValue"},{"type":"text","value":", or when the\nfinal radius is negative, nonfinite, null, or undefined. A zero radius remains\na valid interaction point even though it has no visible area."}]},{"type":"paragraph","children":[{"type":"text","value":"Every valid row emits one "},{"type":"inlineCode","value":"ChartPoint"},{"type":"text","value":" with:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the original datum and row index"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"semantic channel values in "},{"type":"inlineCode","value":"xValue"},{"type":"text","value":" and "},{"type":"inlineCode","value":"yValue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"scaled center coordinates in "},{"type":"inlineCode","value":"x"},{"type":"text","value":" and "},{"type":"inlineCode","value":"y"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"z"},{"type":"text","value":" as its group"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"fill paint as its interaction color"}]}]}]},{"type":"heading","depth":2,"id":"radius-scales","children":[{"type":"text","value":"Radius scales"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass a numeric scale factory to infer "},{"type":"inlineCode","value":"[0, maximum]"},{"type":"text","value":" from the radius channel.\nConfigure its semantic pixel range inside the factory:"}]},{"type":"code","value":"import { scaleSqrt } from 'd3-scale'\n\nconst rScale = {\n  scale: () => scaleSqrt().range([2, 18]),\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"An ordinary numeric mapper or configured scale instance remains valid when\nthe application owns the complete mapping. The shared integration boundary is documented in\n"},{"type":"link","href":"../../concepts/scales-and-d3.md","children":[{"type":"text","value":"Scales"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Radius does not contribute to x/y guide margins. Add an explicit partial\nmargin when large edge symbols must remain fully inside the SVG viewport."}]}],"headings":[{"id":"dot","text":"dot","level":2},{"id":"options","text":"Options","level":3},{"id":"hexagon","text":"hexagon","level":2},{"id":"options-2","text":"Options","level":3},{"id":"valid-rows-and-points","text":"Valid rows and points","level":2},{"id":"radius-scales","text":"Radius scales","level":2}]},"frameworks":[],"downloadMarkdown":"\n`dot` and `hexagon` place fixed-pixel symbols at scaled x/y values. Their\nradius does not change when a positional scale zooms or a chart resizes unless\nthe application changes `r` or `rScale`.\n\n```ts\nimport { dot, hexagon } from '@tanstack/charts'\n```\n\n## `dot`\n\n```ts\nconst mark = dot(rows, {\n  x: 'date',\n  y: 'value',\n  z: 'series',\n  r: 'population',\n  rScale: radiusScale,\n})\n```\n\n```ts\nfunction dot<TDatum>(\n  source: Iterable<TDatum>,\n  options?: DotOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n```\n\n### Options\n\n| Option          | Type                                 | Default              | Meaning                               |\n| --------------- | ------------------------------------ | -------------------- | ------------------------------------- |\n| `id`            | `string`                             | Layer-derived        | Stable mark ID                        |\n| `x`             | `Channel<TDatum, ChartValue?>`       | Row index            | Horizontal value                      |\n| `y`             | `Channel<TDatum, ChartValue?>`       | Numeric datum        | Vertical value                        |\n| `z`             | `Channel<TDatum, ChartKey?>`         | No group             | Interaction group                     |\n| `color`         | `Channel<TDatum, ChartKey?>`         | `z`                  | Value sent to the chart color scale   |\n| `key`           | `Channel<TDatum, ChartKey>`          | ID, x, y, x/y, index | Stable scene and interaction identity |\n| `r`             | `number \\| Channel<TDatum, number?>` | `3.5`                | Raw radius value                      |\n| `rScale`        | `(value: number) => number`          | Identity             | Maps each valid raw radius to pixels  |\n| `fill`          | `string`                             | Resolved color       | Final constant fill override          |\n| `fillOpacity`   | `number`                             | SVG default          | Fill opacity                          |\n| `layout`        | `DodgeXLayout \\| DodgeYLayout`       | None                 | Resolved collision placement          |\n| `stroke`        | `string`                             | None                 | Constant stroke                       |\n| `strokeOpacity` | `number`                             | SVG default          | Stroke opacity                        |\n| `strokeWidth`   | `number`                             | SVG default          | Stroke width                          |\n| `states`        | `readonly ChartMarkState[]`          | None                 | Focus-driven presentation overrides   |\n\nWith the motion renderer, inline `states` wait for active entrance or data\nmotion to settle. For a dot that appears immediately on focus during motion,\nuse a separate [`whenFocused` mark](../motion.md#motion).\n\n`rScale` is called only for finite, nonnegative raw radii. The mapped result\nmust also be finite and nonnegative or the row is skipped.\n\nUnlike `hexagon`, `dot.fill` and `dot.stroke` are constants. Use `color` and\nthe chart color scale for data-driven dot color.\n\n[`dodgeX` and `dodgeY`](./dodge.md) derive one dot coordinate after the\nmeasured axis scale and final plot bounds resolve. The generated coordinate\ndoes not contribute a positional scale domain.\n\nWithout an explicit key, `dot` tries a unique top-level or nested `data.id`,\nthen x, y, and the x/y tuple. Supply `key` when positions can change while the\nsame entity should reconcile across updates.\n\n## `hexagon`\n\n`hexagon` draws a pointy-topped six-sided symbol.\n\n```ts\nconst mark = hexagon(bins, {\n  x: 'x',\n  y: 'y',\n  color: 'count',\n  r: 'count',\n  rScale: radiusScale,\n})\n```\n\n```ts\nfunction hexagon<TDatum>(\n  source: Iterable<TDatum>,\n  options?: HexagonOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n```\n\n### Options\n\n| Option          | Type                                 | Default                | Meaning                             |\n| --------------- | ------------------------------------ | ---------------------- | ----------------------------------- |\n| `id`            | `string`                             | Layer-derived          | Stable mark ID                      |\n| `x`             | `Channel<TDatum, ChartValue?>`       | Row index              | Horizontal center                   |\n| `y`             | `Channel<TDatum, ChartValue?>`       | Numeric datum          | Vertical center                     |\n| `z`             | `Channel<TDatum, ChartKey?>`         | No group               | Interaction group                   |\n| `color`         | `Channel<TDatum, ChartKey?>`         | `z`                    | Value sent to the chart color scale |\n| `key`           | `Channel<TDatum, ChartKey>`          | Top/nested `id`, index | Stable identity                     |\n| `r`             | `number \\| Channel<TDatum, number?>` | `6`                    | Raw circumradius                    |\n| `rScale`        | `(value: number) => number`          | Identity               | Maps radius values to pixels        |\n| `fill`          | `VisualChannel<TDatum, string>`      | Resolved color         | Final fill override                 |\n| `fillOpacity`   | `number`                             | SVG default            | Fill opacity                        |\n| `stroke`        | `VisualChannel<TDatum, string>`      | None                   | Optional stroke per mark or row     |\n| `strokeOpacity` | `number`                             | SVG default            | Stroke opacity                      |\n| `strokeWidth`   | `number`                             | SVG default            | Stroke width                        |\n\nThe generated vertices begin at the top and proceed in 60-degree increments.\nThe interaction point remains at the scaled center, and its `color` is the\nresolved fill.\n\n## Valid rows and points\n\nBoth marks skip a row when x or y is not a valid `ChartValue`, or when the\nfinal radius is negative, nonfinite, null, or undefined. A zero radius remains\na valid interaction point even though it has no visible area.\n\nEvery valid row emits one `ChartPoint` with:\n\n- the original datum and row index\n- semantic channel values in `xValue` and `yValue`\n- scaled center coordinates in `x` and `y`\n- `z` as its group\n- fill paint as its interaction color\n\n## Radius scales\n\nPass a numeric scale factory to infer `[0, maximum]` from the radius channel.\nConfigure its semantic pixel range inside the factory:\n\n```ts\nimport { scaleSqrt } from 'd3-scale'\n\nconst rScale = {\n  scale: () => scaleSqrt().range([2, 18]),\n}\n```\n\nAn ordinary numeric mapper or configured scale instance remains valid when\nthe application owns the complete mapping. The shared integration boundary is documented in\n[Scales](../../concepts/scales-and-d3.md).\n\nRadius does not contribute to x/y guide margins. Add an explicit partial\nmargin when large edge symbols must remain fully inside the SVG viewport.\n","originalRawMarkdown":"---\ntitle: Dot and Hexagon Marks\ndescription: Reference for dot and hexagon channels, pixel radius, injected radius scales, color, grouping, keys, and interaction points.\n---\n\n`dot` and `hexagon` place fixed-pixel symbols at scaled x/y values. Their\nradius does not change when a positional scale zooms or a chart resizes unless\nthe application changes `r` or `rScale`.\n\n```ts\nimport { dot, hexagon } from '@tanstack/charts'\n```\n\n## `dot`\n\n```ts\nconst mark = dot(rows, {\n  x: 'date',\n  y: 'value',\n  z: 'series',\n  r: 'population',\n  rScale: radiusScale,\n})\n```\n\n```ts\nfunction dot<TDatum>(\n  source: Iterable<TDatum>,\n  options?: DotOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n```\n\n### Options\n\n| Option          | Type                                 | Default              | Meaning                               |\n| --------------- | ------------------------------------ | -------------------- | ------------------------------------- |\n| `id`            | `string`                             | Layer-derived        | Stable mark ID                        |\n| `x`             | `Channel<TDatum, ChartValue?>`       | Row index            | Horizontal value                      |\n| `y`             | `Channel<TDatum, ChartValue?>`       | Numeric datum        | Vertical value                        |\n| `z`             | `Channel<TDatum, ChartKey?>`         | No group             | Interaction group                     |\n| `color`         | `Channel<TDatum, ChartKey?>`         | `z`                  | Value sent to the chart color scale   |\n| `key`           | `Channel<TDatum, ChartKey>`          | ID, x, y, x/y, index | Stable scene and interaction identity |\n| `r`             | `number \\| Channel<TDatum, number?>` | `3.5`                | Raw radius value                      |\n| `rScale`        | `(value: number) => number`          | Identity             | Maps each valid raw radius to pixels  |\n| `fill`          | `string`                             | Resolved color       | Final constant fill override          |\n| `fillOpacity`   | `number`                             | SVG default          | Fill opacity                          |\n| `layout`        | `DodgeXLayout \\| DodgeYLayout`       | None                 | Resolved collision placement          |\n| `stroke`        | `string`                             | None                 | Constant stroke                       |\n| `strokeOpacity` | `number`                             | SVG default          | Stroke opacity                        |\n| `strokeWidth`   | `number`                             | SVG default          | Stroke width                          |\n| `states`        | `readonly ChartMarkState[]`          | None                 | Focus-driven presentation overrides   |\n\nWith the motion renderer, inline `states` wait for active entrance or data\nmotion to settle. For a dot that appears immediately on focus during motion,\nuse a separate [`whenFocused` mark](../motion.md#motion).\n\n`rScale` is called only for finite, nonnegative raw radii. The mapped result\nmust also be finite and nonnegative or the row is skipped.\n\nUnlike `hexagon`, `dot.fill` and `dot.stroke` are constants. Use `color` and\nthe chart color scale for data-driven dot color.\n\n[`dodgeX` and `dodgeY`](./dodge.md) derive one dot coordinate after the\nmeasured axis scale and final plot bounds resolve. The generated coordinate\ndoes not contribute a positional scale domain.\n\nWithout an explicit key, `dot` tries a unique top-level or nested `data.id`,\nthen x, y, and the x/y tuple. Supply `key` when positions can change while the\nsame entity should reconcile across updates.\n\n## `hexagon`\n\n`hexagon` draws a pointy-topped six-sided symbol.\n\n```ts\nconst mark = hexagon(bins, {\n  x: 'x',\n  y: 'y',\n  color: 'count',\n  r: 'count',\n  rScale: radiusScale,\n})\n```\n\n```ts\nfunction hexagon<TDatum>(\n  source: Iterable<TDatum>,\n  options?: HexagonOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n```\n\n### Options\n\n| Option          | Type                                 | Default                | Meaning                             |\n| --------------- | ------------------------------------ | ---------------------- | ----------------------------------- |\n| `id`            | `string`                             | Layer-derived          | Stable mark ID                      |\n| `x`             | `Channel<TDatum, ChartValue?>`       | Row index              | Horizontal center                   |\n| `y`             | `Channel<TDatum, ChartValue?>`       | Numeric datum          | Vertical center                     |\n| `z`             | `Channel<TDatum, ChartKey?>`         | No group               | Interaction group                   |\n| `color`         | `Channel<TDatum, ChartKey?>`         | `z`                    | Value sent to the chart color scale |\n| `key`           | `Channel<TDatum, ChartKey>`          | Top/nested `id`, index | Stable identity                     |\n| `r`             | `number \\| Channel<TDatum, number?>` | `6`                    | Raw circumradius                    |\n| `rScale`        | `(value: number) => number`          | Identity               | Maps radius values to pixels        |\n| `fill`          | `VisualChannel<TDatum, string>`      | Resolved color         | Final fill override                 |\n| `fillOpacity`   | `number`                             | SVG default            | Fill opacity                        |\n| `stroke`        | `VisualChannel<TDatum, string>`      | None                   | Optional stroke per mark or row     |\n| `strokeOpacity` | `number`                             | SVG default            | Stroke opacity                      |\n| `strokeWidth`   | `number`                             | SVG default            | Stroke width                        |\n\nThe generated vertices begin at the top and proceed in 60-degree increments.\nThe interaction point remains at the scaled center, and its `color` is the\nresolved fill.\n\n## Valid rows and points\n\nBoth marks skip a row when x or y is not a valid `ChartValue`, or when the\nfinal radius is negative, nonfinite, null, or undefined. A zero radius remains\na valid interaction point even though it has no visible area.\n\nEvery valid row emits one `ChartPoint` with:\n\n- the original datum and row index\n- semantic channel values in `xValue` and `yValue`\n- scaled center coordinates in `x` and `y`\n- `z` as its group\n- fill paint as its interaction color\n\n## Radius scales\n\nPass a numeric scale factory to infer `[0, maximum]` from the radius channel.\nConfigure its semantic pixel range inside the factory:\n\n```ts\nimport { scaleSqrt } from 'd3-scale'\n\nconst rScale = {\n  scale: () => scaleSqrt().range([2, 18]),\n}\n```\n\nAn ordinary numeric mapper or configured scale instance remains valid when\nthe application owns the complete mapping. The shared integration boundary is documented in\n[Scales](../../concepts/scales-and-d3.md).\n\nRadius does not contribute to x/y guide margins. Add an explicit partial\nmargin when large edge symbols must remain fully inside the SVG viewport.\n"}
