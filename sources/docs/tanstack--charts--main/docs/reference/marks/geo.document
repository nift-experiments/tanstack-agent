dex"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable feature identity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"color"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"text","value":"No value"}]},{"type":"tableCell","children":[{"type":"text","value":"Input to the chart color scale"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"r"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number | Channel<TDatum, number?>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"4.5"}]},{"type":"tableCell","children":[{"type":"text","value":"Point and MultiPoint radius in pixels"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"rScale"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(value: number) => number"}]},{"type":"tableCell","children":[{"type":"text","value":"Identity"}]},{"type":"tableCell","children":[{"type":"text","value":"Maps a quantitative value to a pixel radius"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fill"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<TDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Color for closed shapes"}]},{"type":"tableCell","children":[{"type":"text","value":"Final fill paint override"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fillOpacity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Fill opacity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stroke"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<TDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Color for linework"}]},{"type":"tableCell","children":[{"type":"text","value":"Final stroke paint override"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeOpacity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Boundary opacity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Boundary width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeDasharray"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Boundary dash pattern"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"opacity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Whole-feature opacity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"anchor"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(datum, context) => [lon, lat]"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"geoCentroid()"}]},{"type":"tableCell","children":[{"type":"text","value":"Semantic longitude/latitude for the interaction point"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Semantic "},{"type":"inlineCode","value":"color"},{"type":"text","value":" becomes fill for closed geometry, stroke for linework, and\nboth for a mixed collection. Explicit "},{"type":"inlineCode","value":"fill"},{"type":"text","value":" or "},{"type":"inlineCode","value":"stroke"},{"type":"text","value":" channels override that\nmapped paint."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"states"},{"type":"text","value":" accepts "},{"type":"inlineCode","value":"ChartMarkState<TDatum, ChartAreaStateStyle<TDatum>>[]"},{"type":"text","value":" for\nfocus-dependent fill, stroke, and opacity, with the same callback context and\ntransitions as Cartesian area marks. The context retains the original GeoJSON\ndatum, its source index, and the complete materialized data array. State paint\ndoes not change interaction points; only features that emit a finite\ninteraction point can match a state."}]},{"type":"paragraph","children":[{"type":"text","value":"Each drawable feature becomes one SVG path. "},{"type":"inlineCode","value":"geoPath(projection).centroid()"},{"type":"text","value":"\nsets the point's screen position. "},{"type":"inlineCode","value":"anchor"},{"type":"text","value":", or "},{"type":"inlineCode","value":"geoCentroid()"},{"type":"text","value":" when omitted,\nsets its semantic x/y values. Nonfinite centroids do not emit an interaction\npoint."}]},{"type":"paragraph","children":[{"type":"text","value":"For Point and MultiPoint geometry, "},{"type":"inlineCode","value":"r"},{"type":"text","value":" is passed to D3\n"},{"type":"inlineCode","value":"geoPath().pointRadius()"},{"type":"text","value":" for each datum. Add "},{"type":"inlineCode","value":"rScale"},{"type":"text","value":" when the channel carries\na magnitude rather than a pixel radius; invalid or negative results are\nomitted."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"GeoProjectionContext"},{"type":"text","value":", "},{"type":"inlineCode","value":"GeoProjectionDescriptor"},{"type":"text","value":", "},{"type":"inlineCode","value":"GeoProjectionInput"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"GeoShapeOptions"},{"type":"text","value":", and the "},{"type":"inlineCode","value":"geoShape"},{"type":"text","value":" implementation are exported from\n"},{"type":"inlineCode","value":"@tanstack/charts/geo"},{"type":"text","value":". Omit both chart axes; the mark does not materialize\nCartesian scale channels. Boundary datasets are deliberately not part of this\nentry point; convert application-owned TopoJSON to GeoJSON before passing\nfeatures to the mark. See\n"},{"type":"link","href":"../../examples/maps-and-spatial.md","children":[{"type":"text","value":"Maps and Spatial Charts"}]},{"type":"text","value":"."}]}],"headings":[{"id":"geoshape","text":"geoShape","level":2},{"id":"geoshapeoptions","text":"GeoShapeOptions","level":3}]},"frameworks":[],"downloadMarkdown":"\n`geoShape` renders GeoJSON through a projection created for the final\nresponsive plot bounds. It is available only from the geographic capability\nsubpath:\n\n```ts\nimport { geoShape } from '@tanstack/charts/geo'\n```\n\nThe subpath owns `d3-geo` path generation and centroid calculation. The\napplication still chooses and configures the D3 projection.\n\n## `geoShape`\n\n```ts\nfunction geoShape<TDatum extends GeoPermissibleObjects>(\n  source: Iterable<TDatum>,\n  options: GeoShapeOptions<TDatum>,\n): ChartMark<TDatum, number, number, never, never>\n```\n\n`projection` accepts either a descriptor or the original callback. A descriptor\ncreates a fittable D3 projection and explicitly fits the mark data, a sphere,\nor supplied geometry to the final bounds:\n\n```ts\ngeoShape(features, {\n  projection: {\n    type: geoEqualEarth,\n    fit: 'data',\n    inset: 8,\n  },\n  color: (feature) => feature.properties.value,\n})\n```\n\nUse `fit: 'sphere'` when the full world frame must remain stable, or pass a\nspecific `GeoPermissibleObjects` value when several geo layers must share one\nfit. A callback receives `GeoProjectionContext` with the final `chart` bounds\nand materialized `data`; return a `GeoProjection`, `GeoStreamWrapper`, or\n`null`.\n\n### `GeoShapeOptions`\n\n| Option            | Type                                  | Default                 | Meaning                                               |\n| ----------------- | ------------------------------------- | ----------------------- | ----------------------------------------------------- |\n| `id`              | `string`                              | Layer-derived           | Stable mark ID                                        |\n| `className`       | `string`                              | None                    | Class added beside `ts-chart__geo`                    |\n| `projection`      | `GeoProjectionDescriptor \\| callback` | Required                | Creates/fits or directly returns a D3 projection      |\n| `key`             | `Channel<TDatum, ChartKey>`           | Top/nested `id`, index  | Stable feature identity                               |\n| `color`           | `Channel<TDatum, ChartKey?>`          | No value                | Input to the chart color scale                        |\n| `r`               | `number \\| Channel<TDatum, number?>`  | `4.5`                   | Point and MultiPoint radius in pixels                 |\n| `rScale`          | `(value: number) => number`           | Identity                | Maps a quantitative value to a pixel radius           |\n| `fill`            | `VisualChannel<TDatum, string>`       | Color for closed shapes | Final fill paint override                             |\n| `fillOpacity`     | `number`                              | SVG default             | Fill opacity                                          |\n| `stroke`          | `VisualChannel<TDatum, string>`       | Color for linework      | Final stroke paint override                           |\n| `strokeOpacity`   | `number`                              | SVG default             | Boundary opacity                                      |\n| `strokeWidth`     | `number`                              | SVG default             | Boundary width                                        |\n| `strokeDasharray` | `string`                              | SVG default             | Boundary dash pattern                                 |\n| `opacity`         | `number`                              | SVG default             | Whole-feature opacity                                 |\n| `anchor`          | `(datum, context) => [lon, lat]`      | `geoCentroid()`         | Semantic longitude/latitude for the interaction point |\n\nSemantic `color` becomes fill for closed geometry, stroke for linework, and\nboth for a mixed collection. Explicit `fill` or `stroke` channels override that\nmapped paint.\n\n`states` accepts `ChartMarkState<TDatum, ChartAreaStateStyle<TDatum>>[]` for\nfocus-dependent fill, stroke, and opacity, with the same callback context and\ntransitions as Cartesian area marks. The context retains the original GeoJSON\ndatum, its source index, and the complete materialized data array. State paint\ndoes not change interaction points; only features that emit a finite\ninteraction point can match a state.\n\nEach drawable feature becomes one SVG path. `geoPath(projection).centroid()`\nsets the point's screen position. `anchor`, or `geoCentroid()` when omitted,\nsets its semantic x/y values. Nonfinite centroids do not emit an interaction\npoint.\n\nFor Point and MultiPoint geometry, `r` is passed to D3\n`geoPath().pointRadius()` for each datum. Add `rScale` when the channel carries\na magnitude rather than a pixel radius; invalid or negative results are\nomitted.\n\n`GeoProjectionContext`, `GeoProjectionDescriptor`, `GeoProjectionInput`,\n`GeoShapeOptions`, and the `geoShape` implementation are exported from\n`@tanstack/charts/geo`. Omit both chart axes; the mark does not materialize\nCartesian scale channels. Boundary datasets are deliberately not part of this\nentry point; convert application-owned TopoJSON to GeoJSON before passing\nfeatures to the mark. See\n[Maps and Spatial Charts](../../examples/maps-and-spatial.md).\n","originalRawMarkdown":"---\ntitle: Geo Shape Mark\ndescription: Reference for projecting GeoJSON with an opt-in D3-backed geoShape mark.\n---\n\n`geoShape` renders GeoJSON through a projection created for the final\nresponsive plot bounds. It is available only from the geographic capability\nsubpath:\n\n```ts\nimport { geoShape } from '@tanstack/charts/geo'\n```\n\nThe subpath owns `d3-geo` path generation and centroid calculation. The\napplication still chooses and configures the D3 projection.\n\n## `geoShape`\n\n```ts\nfunction geoShape<TDatum extends GeoPermissibleObjects>(\n  source: Iterable<TDatum>,\n  options: GeoShapeOptions<TDatum>,\n): ChartMark<TDatum, number, number, never, never>\n```\n\n`projection` accepts either a descriptor or the original callback. A descriptor\ncreates a fittable D3 projection and explicitly fits the mark data, a sphere,\nor supplied geometry to the final bounds:\n\n```ts\ngeoShape(features, {\n  projection: {\n    type: geoEqualEarth,\n    fit: 'data',\n    inset: 8,\n  },\n  color: (feature) => feature.properties.value,\n})\n```\n\nUse `fit: 'sphere'` when the full world frame must remain stable, or pass a\nspecific `GeoPermissibleObjects` value when several geo layers must share one\nfit. A callback receives `GeoProjectionContext` with the final `chart` bounds\nand materialized `data`; return a `GeoProjection`, `GeoStreamWrapper`, or\n`null`.\n\n### `GeoShapeOptions`\n\n| Option            | Type                                  | Default                 | Meaning                                               |\n| ----------------- | ------------------------------------- | ----------------------- | ----------------------------------------------------- |\n| `id`              | `string`                              | Layer-derived           | Stable mark ID                                        |\n| `className`       | `string`                              | None                    | Class added beside `ts-chart__geo`                    |\n| `projection`      | `GeoProjectionDescriptor \\| callback` | Required                | Creates/fits or directly returns a D3 projection      |\n| `key`             | `Channel<TDatum, ChartKey>`           | Top/nested `id`, index  | Stable feature identity                               |\n| `color`           | `Channel<TDatum, ChartKey?>`          | No value                | Input to the chart color scale                        |\n| `r`               | `number \\| Channel<TDatum, number?>`  | `4.5`                   | Point and MultiPoint radius in pixels                 |\n| `rScale`          | `(value: number) => number`           | Identity                | Maps a quantitative value to a pixel radius           |\n| `fill`            | `VisualChannel<TDatum, string>`       | Color for closed shapes | Final fill paint override                             |\n| `fillOpacity`     | `number`                              | SVG default             | Fill opacity                                          |\n| `stroke`          | `VisualChannel<TDatum, string>`       | Color for linework      | Final stroke paint override                           |\n| `strokeOpacity`   | `number`                              | SVG default             | Boundary opacity                                      |\n| `strokeWidth`     | `number`                              | SVG default             | Boundary width                                        |\n| `strokeDasharray` | `string`                              | SVG default             | Boundary dash pattern                                 |\n| `opacity`         | `number`                              | SVG default             | Whole-feature opacity                                 |\n| `anchor`          | `(datum, context) => [lon, lat]`      | `geoCentroid()`         | Semantic longitude/latitude for the interaction point |\n\nSemantic `color` becomes fill for closed geometry, stroke for linework, and\nboth for a mixed collection. Explicit `fill` or `stroke` channels override that\nmapped paint.\n\n`states` accepts `ChartMarkState<TDatum, ChartAreaStateStyle<TDatum>>[]` for\nfocus-dependent fill, stroke, and opacity, with the same callback context and\ntransitions as Cartesian area marks. The context retains the original GeoJSON\ndatum, its source index, and the complete materialized data array. State paint\ndoes not change interaction points; only features that emit a finite\ninteraction point can match a state.\n\nEach drawable feature becomes one SVG path. `geoPath(projection).centroid()`\nsets the point's screen position. `anchor`, or `geoCentroid()` when omitted,\nsets its semantic x/y values. Nonfinite centroids do not emit an interaction\npoint.\n\nFor Point and MultiPoint geometry, `r` is passed to D3\n`geoPath().pointRadius()` for each datum. Add `rScale` when the channel carries\na magnitude rather than a pixel radius; invalid or negative results are\nomitted.\n\n`GeoProjectionContext`, `GeoProjectionDescriptor`, `GeoProjectionInput`,\n`GeoShapeOptions`, and the `geoShape` implementation are exported from\n`@tanstack/charts/geo`. Omit both chart axes; the mark does not materialize\nCartesian scale channels. Boundary datasets are deliberately not part of this\nentry point; convert application-owned TopoJSON to GeoJSON before passing\nfeatures to the mark. See\n[Maps and Spatial Charts](../../examples/maps-and-spatial.md).\n"}
