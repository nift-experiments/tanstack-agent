type":"text","value":"Required"}]},{"type":"tableCell","children":[{"type":"text","value":"Raw vertical observation"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"binWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"20"}]},{"type":"tableCell","children":[{"type":"text","value":"Horizontal pixel distance between bin centers"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"outputs"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TransformOutputs<TDatum>"}]},{"type":"tableCell","children":[{"type":"text","value":"Count reducer"}]},{"type":"tableCell","children":[{"type":"text","value":"Named reducers evaluated over each bin"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer-derived"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable mark ID"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<HexbinDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"text","value":"No group"}]},{"type":"tableCell","children":[{"type":"text","value":"Interaction group"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"color"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<HexbinDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"text","value":"Derived value sent to the color scale"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"r"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number | Channel<HexbinDatum, number?>"}]},{"type":"tableCell","children":[{"type":"text","value":"Bin radius minus 1px"}]},{"type":"tableCell","children":[{"type":"text","value":"Rendered hexagon circumradius"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"rScale"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartNumericScale"}]},{"type":"tableCell","children":[{"type":"text","value":"Identity"}]},{"type":"tableCell","children":[{"type":"text","value":"Maps a radius channel to pixels"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fill"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<HexbinDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolved color"}]},{"type":"tableCell","children":[{"type":"text","value":"Final fill override"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stroke"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<HexbinDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Final stroke override"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fillOpacity"},{"type":"text","value":", "},{"type":"inlineCode","value":"strokeOpacity"},{"type":"text","value":", and "},{"type":"inlineCode","value":"strokeWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Hexagon presentation"}]}]]},{"type":"paragraph","children":[{"type":"inlineCode","value":"binWidth"},{"type":"text","value":" must be positive and finite. Both positional scales must support\n"},{"type":"inlineCode","value":"invert"},{"type":"text","value":"; continuous D3 scales and the compact TanStack linear scale do. A\nband scale is not a valid hexbin position scale."}]},{"type":"heading","depth":2,"id":"reducers-and-lineage","children":[{"type":"text","value":"Reducers and lineage"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"outputs"},{"type":"text","value":" uses the same reducer contract as eager transforms. Count, sum,\nmean, minimum, maximum, and custom reducers are available:"}]},{"type":"code","value":"hexbin(rows, {\n  x: 'x',\n  y: 'y',\n  outputs: {\n    count: { reduce: 'count' },\n    total: { value: 'revenue', reduce: 'sum' },\n  },\n  color: 'total',\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The margin solver may evaluate reducers during multiple resolved-layout\npasses. Custom reducers must be synchronous, pure, deterministic, and must not\nmutate source rows."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"HexbinDatum<TDatum, TOutputs>"},{"type":"text","value":" contains:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"semantic "},{"type":"inlineCode","value":"x"},{"type":"text","value":" and "},{"type":"inlineCode","value":"y"},{"type":"text","value":" values obtained by inverting the lattice center;"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"every named reducer output;"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"source"},{"type":"text","value":", retaining the original row objects in input order; and"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"sourceIndexes"},{"type":"text","value":", retaining their original indexes."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Rows with nonfinite or missing x/y values are omitted without renumbering the\nremaining lineage. Every valid input row belongs to exactly one bin. The\ninteraction point datum is the complete "},{"type":"inlineCode","value":"HexbinDatum"},{"type":"text","value":", so tooltips can show\ncounts, custom outputs, or source records without case-owned lookup tables."}]},{"type":"heading","depth":2,"id":"responsive-behavior","children":[{"type":"text","value":"Responsive behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"Initial raw x/y channels establish the positional domains. The mark then bins\ntheir mapped pixel coordinates inside the final plot and contributes its\nderived color channel before color-scale and legend resolution. Resizing may\nchange bin membership; repeated compilation at the same size is deterministic."}]}],"headings":[{"id":"options","text":"Options","level":2},{"id":"reducers-and-lineage","text":"Reducers and lineage","level":2},{"id":"responsive-behavior","text":"Responsive behavior","level":2}]},"frameworks":[],"downloadMarkdown":"\n`hexbin` aggregates raw numeric x/y observations after the chart resolves its\npositional scales and inner bounds. Import it from the optional spatial\nsubpath; it is not included in the root or universal barrel.\n\n```ts\nimport { hexbin } from '@tanstack/charts/spatial/hexbin'\n\nconst mark = hexbin(rows, {\n  x: 'weight',\n  y: 'economy',\n  binWidth: 24,\n  color: 'count',\n  r: 11,\n  stroke: '#fff',\n})\n```\n\n```ts\nfunction hexbin<TDatum, TOutputs extends TransformOutputs<TDatum>>(\n  source: Iterable<TDatum>,\n  options: HexbinOptions<TDatum, TOutputs>,\n): ChartMark<HexbinDatum<TDatum, TOutputs>, number, number>\n```\n\nWithout `outputs`, each bin receives a numeric `count` output.\n\n## Options\n\n| Option                                            | Type                                      | Default              | Meaning                                       |\n| ------------------------------------------------- | ----------------------------------------- | -------------------- | --------------------------------------------- |\n| `x`                                               | `TransformValue<TDatum, number?>`         | Required             | Raw horizontal observation                    |\n| `y`                                               | `TransformValue<TDatum, number?>`         | Required             | Raw vertical observation                      |\n| `binWidth`                                        | `number`                                  | `20`                 | Horizontal pixel distance between bin centers |\n| `outputs`                                         | `TransformOutputs<TDatum>`                | Count reducer        | Named reducers evaluated over each bin        |\n| `id`                                              | `string`                                  | Layer-derived        | Stable mark ID                                |\n| `z`                                               | `Channel<HexbinDatum, ChartKey?>`         | No group             | Interaction group                             |\n| `color`                                           | `Channel<HexbinDatum, ChartKey?>`         | `z`                  | Derived value sent to the color scale         |\n| `r`                                               | `number \\| Channel<HexbinDatum, number?>` | Bin radius minus 1px | Rendered hexagon circumradius                 |\n| `rScale`                                          | `ChartNumericScale`                       | Identity             | Maps a radius channel to pixels               |\n| `fill`                                            | `VisualChannel<HexbinDatum, string>`      | Resolved color       | Final fill override                           |\n| `stroke`                                          | `VisualChannel<HexbinDatum, string>`      | None                 | Final stroke override                         |\n| `fillOpacity`, `strokeOpacity`, and `strokeWidth` | `number`                                  | SVG default          | Hexagon presentation                          |\n\n`binWidth` must be positive and finite. Both positional scales must support\n`invert`; continuous D3 scales and the compact TanStack linear scale do. A\nband scale is not a valid hexbin position scale.\n\n## Reducers and lineage\n\n`outputs` uses the same reducer contract as eager transforms. Count, sum,\nmean, minimum, maximum, and custom reducers are available:\n\n```ts\nhexbin(rows, {\n  x: 'x',\n  y: 'y',\n  outputs: {\n    count: { reduce: 'count' },\n    total: { value: 'revenue', reduce: 'sum' },\n  },\n  color: 'total',\n})\n```\n\nThe margin solver may evaluate reducers during multiple resolved-layout\npasses. Custom reducers must be synchronous, pure, deterministic, and must not\nmutate source rows.\n\n`HexbinDatum<TDatum, TOutputs>` contains:\n\n- semantic `x` and `y` values obtained by inverting the lattice center;\n- every named reducer output;\n- `source`, retaining the original row objects in input order; and\n- `sourceIndexes`, retaining their original indexes.\n\nRows with nonfinite or missing x/y values are omitted without renumbering the\nremaining lineage. Every valid input row belongs to exactly one bin. The\ninteraction point datum is the complete `HexbinDatum`, so tooltips can show\ncounts, custom outputs, or source records without case-owned lookup tables.\n\n## Responsive behavior\n\nInitial raw x/y channels establish the positional domains. The mark then bins\ntheir mapped pixel coordinates inside the final plot and contributes its\nderived color channel before color-scale and legend resolution. Resizing may\nchange bin membership; repeated compilation at the same size is deterministic.\n","originalRawMarkdown":"---\ntitle: Hexbin Mark\ndescription: Reference for responsive screen-space hexagonal aggregation, reducer outputs, source lineage, color, and the optional spatial import.\n---\n\n`hexbin` aggregates raw numeric x/y observations after the chart resolves its\npositional scales and inner bounds. Import it from the optional spatial\nsubpath; it is not included in the root or universal barrel.\n\n```ts\nimport { hexbin } from '@tanstack/charts/spatial/hexbin'\n\nconst mark = hexbin(rows, {\n  x: 'weight',\n  y: 'economy',\n  binWidth: 24,\n  color: 'count',\n  r: 11,\n  stroke: '#fff',\n})\n```\n\n```ts\nfunction hexbin<TDatum, TOutputs extends TransformOutputs<TDatum>>(\n  source: Iterable<TDatum>,\n  options: HexbinOptions<TDatum, TOutputs>,\n): ChartMark<HexbinDatum<TDatum, TOutputs>, number, number>\n```\n\nWithout `outputs`, each bin receives a numeric `count` output.\n\n## Options\n\n| Option                                            | Type                                      | Default              | Meaning                                       |\n| ------------------------------------------------- | ----------------------------------------- | -------------------- | --------------------------------------------- |\n| `x`                                               | `TransformValue<TDatum, number?>`         | Required             | Raw horizontal observation                    |\n| `y`                                               | `TransformValue<TDatum, number?>`         | Required             | Raw vertical observation                      |\n| `binWidth`                                        | `number`                                  | `20`                 | Horizontal pixel distance between bin centers |\n| `outputs`                                         | `TransformOutputs<TDatum>`                | Count reducer        | Named reducers evaluated over each bin        |\n| `id`                                              | `string`                                  | Layer-derived        | Stable mark ID                                |\n| `z`                                               | `Channel<HexbinDatum, ChartKey?>`         | No group             | Interaction group                             |\n| `color`                                           | `Channel<HexbinDatum, ChartKey?>`         | `z`                  | Derived value sent to the color scale         |\n| `r`                                               | `number \\| Channel<HexbinDatum, number?>` | Bin radius minus 1px | Rendered hexagon circumradius                 |\n| `rScale`                                          | `ChartNumericScale`                       | Identity             | Maps a radius channel to pixels               |\n| `fill`                                            | `VisualChannel<HexbinDatum, string>`      | Resolved color       | Final fill override                           |\n| `stroke`                                          | `VisualChannel<HexbinDatum, string>`      | None                 | Final stroke override                         |\n| `fillOpacity`, `strokeOpacity`, and `strokeWidth` | `number`                                  | SVG default          | Hexagon presentation                          |\n\n`binWidth` must be positive and finite. Both positional scales must support\n`invert`; continuous D3 scales and the compact TanStack linear scale do. A\nband scale is not a valid hexbin position scale.\n\n## Reducers and lineage\n\n`outputs` uses the same reducer contract as eager transforms. Count, sum,\nmean, minimum, maximum, and custom reducers are available:\n\n```ts\nhexbin(rows, {\n  x: 'x',\n  y: 'y',\n  outputs: {\n    count: { reduce: 'count' },\n    total: { value: 'revenue', reduce: 'sum' },\n  },\n  color: 'total',\n})\n```\n\nThe margin solver may evaluate reducers during multiple resolved-layout\npasses. Custom reducers must be synchronous, pure, deterministic, and must not\nmutate source rows.\n\n`HexbinDatum<TDatum, TOutputs>` contains:\n\n- semantic `x` and `y` values obtained by inverting the lattice center;\n- every named reducer output;\n- `source`, retaining the original row objects in input order; and\n- `sourceIndexes`, retaining their original indexes.\n\nRows with nonfinite or missing x/y values are omitted without renumbering the\nremaining lineage. Every valid input row belongs to exactly one bin. The\ninteraction point datum is the complete `HexbinDatum`, so tooltips can show\ncounts, custom outputs, or source records without case-owned lookup tables.\n\n## Responsive behavior\n\nInitial raw x/y channels establish the positional domains. The mark then bins\ntheir mapped pixel coordinates inside the final plot and contributes its\nderived color channel before color-scale and legend resolution. Resizing may\nchange bin membership; repeated compilation at the same size is deterministic.\n"}
