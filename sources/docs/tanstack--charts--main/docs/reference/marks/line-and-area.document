s transpose "},{"type":"inlineCode","value":"lineY"},{"type":"text","value":": "},{"type":"inlineCode","value":"x"},{"type":"text","value":" is the numeric value channel and defaults\nto a numeric datum; "},{"type":"inlineCode","value":"y"},{"type":"text","value":" is the longitudinal "},{"type":"inlineCode","value":"ChartValue"},{"type":"text","value":" channel and defaults\nto row index. Identity falls back to y, invalid rows create segment gaps, and\ninput order remains path order. Grouping, paint, points, curves, states, and\nmotion use the same contract. Line interaction follows y affinity so keyboard\nand pointer traversal match the longitudinal axis."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"lineX"},{"type":"text","value":" inherits these stroke-shape options from the shared line contract:"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"lineCap"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"SceneStyle[\"lineCap\"]"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"round\""}]},{"type":"tableCell","children":[{"type":"text","value":"Stroke endpoint shape"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"lineJoin"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"SceneStyle[\"lineJoin\"]"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"round\""}]},{"type":"tableCell","children":[{"type":"text","value":"Stroke corner shape"}]}]]},{"type":"heading","depth":2,"id":"areay","children":[{"type":"inlineCode","value":"areaY"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"areaY"},{"type":"text","value":" fills between a numeric upper channel and a numeric lower baseline\nalong x."}]},{"type":"code","value":"const mark = areaY(rows, {\n  x: 'date',\n  y1: 'low',\n  y2: 'high',\n  z: 'series',\n})","lang":"ts"},{"type":"code","value":"function areaY<TDatum>(\n  source: Iterable<TDatum>,\n  options?: AreaYOptions<TDatum>,\n): ChartMark<TDatum, InferredX, number>","lang":"ts"},{"type":"heading","depth":3,"id":"options-2","children":[{"type":"text","value":"Options"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer-derived"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable mark ID"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"x"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartValue?>"}]},{"type":"tableCell","children":[{"type":"text","value":"Row index"}]},{"type":"tableCell","children":[{"type":"text","value":"Shared horizontal position"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"y"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, number?>"}]},{"type":"tableCell","children":[{"type":"text","value":"Numeric datum"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer thickness; implicitly stacked at each x"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"y1"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number | Channel<TDatum, number?>"}]},{"type":"tableCell","children":[{"type":"text","value":"Implicit stack start"}]},{"type":"tableCell","children":[{"type":"text","value":"Explicit lower boundary"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"y2"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number | Channel<TDatum, number?>"}]},{"type":"tableCell","children":[{"type":"text","value":"Implicit stack end"}]},{"type":"tableCell","children":[{"type":"text","value":"Explicit upper boundary; takes precedence over y"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"text","value":"No explicit group"}]},{"type":"tableCell","children":[{"type":"text","value":"Area grouping; overrides color grouping"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"color"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"text","value":"Color-scale value; groups when "},{"type":"inlineCode","value":"z"},{"type":"text","value":" is absent"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"key"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey>"}]},{"type":"tableCell","children":[{"type":"text","value":"Top/nested "},{"type":"inlineCode","value":"id"},{"type":"text","value":", x, then index"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable interaction identity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fill"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<TDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolved color"}]},{"type":"tableCell","children":[{"type":"text","value":"Final area paint; evaluated from the group's first row"}]}],[{"type":"tableCell","children":[{"type":