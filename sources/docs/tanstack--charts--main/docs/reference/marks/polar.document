{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Polar marks are available only from the capability subpath:"}]},{"type":"code","value":"import {\n  angleGrid,\n  focusGroupAngle,\n  pie,\n  polar,\n  radialArc,\n  radialArea,\n  radialBarAngle,\n  radialBarRadius,\n  radialDot,\n  radialGrid,\n  radialLine,\n  radialRule,\n  radialText,\n} from '@tanstack/charts/polar'","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"polar"},{"type":"text","value":" resolves the responsive coordinate system. The exported "},{"type":"inlineCode","value":"PolarMark"},{"type":"text","value":"\nand "},{"type":"inlineCode","value":"PolarGuide"},{"type":"text","value":" types are opaque composition contracts returned by the\nbuilt-in radial mark and guide constructors. Use them to type collections\npassed to "},{"type":"inlineCode","value":"polar"},{"type":"text","value":"; do not implement their internal initialize or render\nlifecycle. Guide backgrounds paint first, marks paint second, and guide\nforegrounds paint last."}]},{"type":"heading","depth":2,"id":"polar","children":[{"type":"inlineCode","value":"polar"}]},{"type":"code","value":"function polar(options: PolarOptions): ChartMark","lang":"ts"},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer-derived"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable container ID"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"className"}]},{"type":"tableCell"