 range in radians"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"inset"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"Pixels removed from the maximum centered radius"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"radiusRatio"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"1"}]},{"type":"tableCell","children":[{"type":"text","value":"Multiplier applied to the radius after inset"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartMarkRenderer"}]},{"type":"tableCell","children":[{"type":"text","value":"Host renderer"}]},{"type":"tableCell","children":[{"type":"text","value":"Renderer for the complete polar container"}]}]]},{"type":"paragraph","children":[{"type":"inlineCode","value":"polar.states"},{"type":"text","value":" supplies default focus states for its child marks. Each child\nresolves those states against its own original data and interaction points;\nguides are unaffected. A child "},{"type":"inlineCode","value":"states"},{"type":"text","value":" array replaces the container defaults,\nand "},{"type":"inlineCode","value":"states: []"},{"type":"text","value":" opts out."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"radialArc"},{"type":"text","value":", "},{"type":"inlineCode","value":"radialBarRadius"},{"type":"text","value":", "},{"type":"inlineCode","value":"radialBarAngle"},{"type":"text","value":", "},{"type":"inlineCode","value":"radialArea"},{"type":"text","value":", "},{"type":"inlineCode","value":"radialLine"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"radialDot"},{"type":"text","value":", and "},{"type":"inlineCode","value":"radialText"},{"type":"text","value":" also accept their own "},{"type":"inlineCode","value":"states"},{"type":"text","value":", using the same\nselectors, callback context, and transitions as Cartesian marks. Arc and area\nstates change paint; dot states can also change "},{"type":"inlineCode","value":"r"},{"type":"text","value":", and text states can change\ntypography and offsets. A state changes presentation without changing the\ninteraction point or scale domain. Rules without interaction points do not\nmatch focus states."}]},{"type":"code","value":"radialArc(slices, {\n  states: [\n    { when: { focus: 'unmatched' }, style: { opacity: 0.25 } },\n    {\n      when: { focus: 'primary' },\n      style: { stroke: 'currentColor', strokeWidth: 2 },\n      transition: { type: 'tween', duration: 150 },\n    },\n  ],\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The default angular range is a complete circle. Angles use D3's radial\nconvention: zero is at twelve o'clock and positive values move clockwise."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"scales.angle"},{"type":"text","value":" and "},{"type":"inlineCode","value":"scales.radius"},{"type":"text","value":" accept compatible factories with\nmark-inferred domains or configured instances with fixed domains. Use "},{"type":"inlineCode","value":"null"},{"type":"text","value":"\nwhen no child mark uses that channel. "},{"type":"inlineCode","value":"nice"},{"type":"text","value":" applies after inference. TanStack\nsupplies responsive ranges without mutating an instance. An omitted "},{"type":"inlineCode","value":"wrap"},{"type":"text","value":"\ncloses a complete revolution without adding a duplicate semantic category,\nbut preserves both endpoints of a partial range. Set it explicitly to override\nthat behavior."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"PolarRadiusOptions.range"},{"type":"text","value":" overrides the default "},{"type":"inlineCode","value":"[0, radius]"},{"type":"text","value":" pixel range on\nthe copied radius scale. Each endpoint is a nonnegative pixel length or a\n"},{"type":"inlineCode","value":"PolarLength"},{"type":"text","value":" callback, so concentric layouts can resolve physical ranges from\nthe final radius:"}]},{"type":"code","value":"const radiusOptions = {\n  scale: scaleLinear().domain([0, maximum]),\n  range: [({ radius }) => radius * 0.2, ({ radius }) => radius],\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The range is re-resolved on resize and never mutates the authored D3 scale."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"PolarLayoutContext"},{"type":"text","value":" contains "},{"type":"inlineCode","value":"chart"},{"type":"text","value":", "},{"type":"inlineCode","value":"centerX"},{"type":"text","value":", "},{"type":"inlineCode","value":"centerY"},{"type":"text","value":", "},{"type":"inlineCode","value":"radius"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"startAngle"},{"type":"text","value":", "},{"type":"inlineCode","value":"endAngle"},{"type":"text","value":", and resolved position scales under "},{"type":"inlineCode","value":"scales"},{"type":"text","value":". Each\n"},{"type":"inlineCode","value":"PolarResolvedScale"},{"type":"text","value":" exposes its "},{"type":"inlineCode","value":"id"},{"type":"text","value":", "},{"type":"inlineCode","value":"channel"},{"type":"text","value":", semantic "},{"type":"inlineCode","value":"domain"},{"type":"text","value":", responsive\n"},{"type":"inlineCode","value":"map"},{"type":"text","value":", "},{"type":"inlineCode","value":"ticks"},{"type":"text","value":", and "},{"type":"inlineCode","value":"bandwidth"},{"type":"text","value":". A "},{"type":"inlineCode","value":"PolarLength"},{"type":"text","value":" is either a pixel length or a\ncallback of the layout context. Use a callback for radii that must remain\nproportional during resize."}]},{"type":"paragraph","children":[{"type":"text","value":"Additional entries support independent angle or radius mappings. Declare the\nentry's channel, then bind a radial mark to its ID:"}]},{"type":"code","value":"polar({\n  scales: {\n    angle: { scale: categoryScale },\n    radius: { scale: percentScale },\n    target: {\n      channel: 'radius',\n      scale: targetScale,\n    },\n  },\n  marks: [\n    radialLine(actual, { angle: 'metric', radius: 'value' }),\n    radialLine(target, {\n      angle: 'metric',\n      radius: 'value',\n      radiusScale: 'target',\n    }),\n  ],\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"radialLine"},{"type":"text","value":", "},{"type":"inlineCode","value":"radialArea"},{"type":"text","value":", "},{"type":"inlineCode","value":"radialDot"},{"type":"text","value":", "},{"type":"inlineCode","value":"radialText"},{"type":"text","value":", "},{"type":"inlineCode","value":"radialRule"},{"type":"text","value":", and both\nradial bar marks use "},{"type":"inlineCode","value":"angleScale"},{"type":"text","value":" and "},{"type":"inlineCode","value":"radiusScale"},{"type":"text","value":". Omitted bindings use the\nreserved "},{"type":"inlineCode","value":"angle"},{"type":"text","value":" and "},{"type":"inlineCode","value":"radius"},{"type":"text","value":" entries. "},{"type":"inlineCode","value":"radialArc"},{"type":"text","value":" uses authored angular and\nradial geometry instead of positional scale bindings."}]},{"type":"paragraph","children":[{"type":"text","value":"All radial mark option objects also accept "},{"type":"inlineCode","value":"renderer?: ChartMarkRenderer"},{"type":"text","value":".\nUse "},{"type":"inlineCode","value":"canvasChartRenderer"},{"type":"text","value":" to paint one radial mark with Canvas while sibling\nmarks and guide labels stay in SVG. Setting "},{"type":"inlineCode","value":"renderer"},{"type":"text","value":" on the outer "},{"type":"inlineCode","value":"polar"},{"type":"text","value":"\noptions moves the complete polar container, including its guides, to that\nrenderer."}]},{"type":"paragraph","children":[{"type":"text","value":"The outer chart uses "},{"type":"inlineCode","value":"scales: { x: null, y: null }"},{"type":"text","value":". Cartesian axes do not\nparticipate in the internal polar scales."}]},{"type":"heading","depth":2,"id":"focusgroupangle","children":[{"type":"inlineCode","value":"focusGroupAngle"}]},{"type":"code","value":"import { defineChart, type ChartDefinition } from '@tanstack/charts'\nimport { focusGroupAngle } from '@tanstack/charts/polar'\nimport { tooltip } from '@tanstack/charts/tooltip'\n\ndeclare const definition: ChartDefinition\n\nconst interactiveDefinition = defineChart(definition, {\n  focus: focusGroupAngle,\n  tooltip,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"focusGroupAngle"},{"type":"text","value":" is the polar equivalent of "},{"type":"inlineCode","value":"group-x"},{"type":"text","value":". Pointer resolution\nuses the nearest radial ray instead of the nearest point anchor, then returns\none point per series with the same semantic angle value. The closest radius is\nprimary. Keyboard navigation visits one representative per angle in angular\norder. "},{"type":"inlineCode","value":"maxFocusDistance"},{"type":"text","value":" is the scene-pixel distance from the pointer to the\nray; set it to "},{"type":"inlineCode","value":"Number.POSITIVE_INFINITY"},{"type":"text","value":" for continuous angular snapping."}]},{"type":"heading","depth":2,"id":"pie","children":[{"type":"inlineCode","value":"pie"}]},{"type":"code","value":"function pie<TDatum extends object>(\n  source: Iterable<TDatum>,\n  options: PieOptions<TDatum>,\n): PieDatum<TDatum>[]","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"pie"},{"type":"text","value":" eagerly allocates a nonnegative value channel into angle intervals. It\ndoes not render geometry or depend on chart dimensions."}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"value"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TransformValue<number>"}]},{"type":"tableCell","children":[{"type":"text","value":"Required"}]},{"type":"tableCell","children":[{"type":"text","value":"Nonnegative value allocated to each interval"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"orderBy"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TransformValue"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Explicit angular ordering value"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"order"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ascending | descending"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ascending"}]},{"type":"tableCell","children":[{"type":"text","value":"Direction applied to "},{"type":"inlineCode","value":"orderBy"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"startAngle"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"Overall start angle in radians"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"endAngle"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"2π"}]},{"type":"tableCell","children":[{"type":"text","value":"Overall end angle in radians"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"gapAngle"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"Direct empty angle between visible slices"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Output rows remain in source order. "},{"type":"inlineCode","value":"index"},{"type":"text","value":" records angular order, "},{"type":"inlineCode","value":"value"},{"type":"text","value":" is\nthe resolved finite value, "},{"type":"inlineCode","value":"fraction"},{"type":"text","value":" is its share of the positive total, and\n"},{"type":"inlineCode","value":"startAngle"},{"type":"text","value":", "},{"type":"inlineCode","value":"endAngle"},{"type":"text","value":", and "},{"type":"inlineCode","value":"angle"},{"type":"text","value":" are the visible interval and midpoint.\nEach row also carries direct "},{"type":"inlineCode","value":"source"},{"type":"text","value":" and "},{"type":"inlineCode","value":"sourceIndexes"},{"type":"text","value":" lineage. Missing or\nnon-finite values are omitted, zero is retained, and negative values fail."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"gapAngle"},{"type":"text","value":" is radius-independent. A complete revolution includes a seam gap;\na partial range uses only internal gaps and preserves both authored endpoints.\nThe output "},{"type":"inlineCode","value":"padAngle"},{"type":"text","value":" is intentionally "},{"type":"inlineCode","value":"0"},{"type":"text","value":" compatibility metadata so the\ndefault "},{"type":"inlineCode","value":"radialArc"},{"type":"text","value":" accessors do not pad an already-gapped interval a second\ntime. Use the mark's "},{"type":"inlineCode","value":"padAngle"},{"type":"text","value":" and "},{"type":"inlineCode","value":"padRadius"},{"type":"text","value":" only when D3's radius-dependent\narc padding is wanted instead."}]},{"type":"paragraph","children":[{"type":"text","value":"The derived fields "},{"type":"inlineCode","value":"value"},{"type":"text","value":", "},{"type":"inlineCode","value":"index"},{"type":"text","value":", "},{"type":"inlineCode","value":"fraction"},{"type":"text","value":", "},{"type":"inlineCode","value":"startAngle"},{"type":"text","value":", "},{"type":"inlineCode","value":"endAngle"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"angle"},{"type":"text","value":", "},{"type":"inlineCode","value":"padAngle"},{"type":"text","value":", "},{"type":"inlineCode","value":"source"},{"type":"text","value":", and "},{"type":"inlineCode","value":"sourceIndexes"},{"type":"text","value":" overwrite source fields with\nthe same names. Stable identity is not synthesized; preserve a semantic source\nfield and pass it to the consuming mark's "},{"type":"inlineCode","value":"key"},{"type":"text","value":" channel."}]},{"type":"heading","depth":2,"id":"radialarc","children":[{"type":"inlineCode","value":"radialArc"}]},{"type":"code","value":"function radialArc<TDatum>(\n  source: Iterable<TDatum>,\n  options?: RadialArcOptions<TDatum>,\n): PolarMark<TDatum>","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"radialArc"},{"type":"text","value":" renders one D3 arc per valid interval."}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"},{"type":"text","value":", "},{"type":"inlineCode","value":"className"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable layer ID and optional class"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"startAngle"}]},{"type":"tableCell","children":[{"type":"text","value":"Start-angle channel; defaults to datum "},{"type":"inlineCode","value":"startAngle"}]}],[{"