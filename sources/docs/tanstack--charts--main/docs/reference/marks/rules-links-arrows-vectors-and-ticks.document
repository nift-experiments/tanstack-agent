 "},{"type":"inlineCode","value":"yValue"},{"type":"text","value":" are the second endpoint."}]},{"type":"paragraph","children":[{"type":"text","value":"The optional "},{"type":"inlineCode","value":"d3Curve"},{"type":"text","value":" bridge and granular algorithm boundary are documented in\n"},{"type":"link","href":"./line-and-area.md#curves","children":[{"type":"text","value":"Line and area"}]},{"type":"text","value":" and\n"},{"type":"link","href":"../../concepts/scales-and-d3.md","children":[{"type":"text","value":"Scales"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"arrow","children":[{"type":"inlineCode","value":"arrow"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"arrow"},{"type":"text","value":" draws one straight directed segment with a fixed-pixel head:"}]},{"type":"code","value":"arrow(edges, {\n  x1: 'sourceX',\n  y1: 'sourceY',\n  x2: 'targetX',\n  y2: 'targetY',\n  headLength: 10,\n  headAngle: 28,\n})","lang":"ts"},{"type":"code","value":"function arrow<TDatum>(\n  source: Iterable<TDatum>,\n  options: ArrowOptions<TDatum>,\n): ChartMark<TDatum, InferredEndpointX, InferredEndpointY>","lang":"ts"},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer-derived"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable mark ID"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"x1"},{"type":"text","value":", "},{"type":"inlineCode","value":"y1"}]},{"type":"tableCell","children":[{"type":"text","value":"required channels"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]},{"type":"tableCell","children":[{"type":"text","value":"Tail endpoint"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"x2"},{"type":"text","value":", "},{"type":"inlineCode","value":"y2"}]},{"type":"tableCell","children":[{"type":"text","value":"required channels"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]},{"type":"tableCell","children":[{"type":"text","value":"Head endpoint"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"text","value":"No group"}]},{"type":"tableCell","children":[{"type":"text","value":"Interaction group"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"color"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"text","value":"Value sent to the chart color scale"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"key"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey>"}]},{"type":"tableCell","children":[{"type":"text","value":"Top/nested "},{"type":"inlineCode","value":"id"},{"type":"text","value":", index"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable identity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stroke"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<TDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolved color"}]},{"type":"tableCell","children":[{"type":"text","value":"Final arrow paint override"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeOpacity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]