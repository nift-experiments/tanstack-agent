{"type":"inlineCode","value":"5"}]},{"type":"tableCell","children":[{"type":"text","value":"Head length in pixels, clamped to at least zero"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"headAngle"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"30"}]},{"type":"tableCell","children":[{"type":"text","value":"Head half-angle in degrees"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Length and rotation must be finite. Negative length reverses the body direction\nwhile preserving the rotation convention. The interaction point remains the\nscaled x/y anchor for every anchor mode."}]},{"type":"heading","depth":2,"id":"tickx-and-ticky","children":[{"type":"inlineCode","value":"tickX"},{"type":"text","value":" and "},{"type":"inlineCode","value":"tickY"}]},{"type":"paragraph","children":[{"type":"text","value":"Ticks draw a short rule centered at a scaled point:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tickX"},{"type":"text","value":" draws a vertical rule, so its length spans the y direction."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"tickY"},{"type":"text","value":" draws a horizontal rule, so its length spans the x direction."}]}]}]},{"type":"code","value":"tickX(rows, { x: 'category', y: 'value', z: 'series' })\ntickY(rows, { x: 'value', y: 'category', length: 16 })\ntickY(summaries, { x: 'category', y: 'median', span: 0.36 })","lang":"ts"},{"type":"code","value":"function tickX<TDatum>(\n  source: Iterable<TDatum>,\n  options: TickXOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n\nfunction tickY<TDatum>(\n  source: Iterable<TDatum>,\n  options: TickYOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Both share:"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer-derived"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable mark ID"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"x"},{"type":"text","value":", "},{"type":"inlineCode","value":"y"}]},{"type":"tableCell","children":[{"type":"text","value":"required channels"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]},{"type":"tableCell","children":[{"type":"text","value":"Tick center"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"text","value":"No group"}]},{"type":"tableCell","children":[{"type":"text","value":"Interaction group"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"color"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"z"}]},{"type":"tableCell","children":[{"type":"text","value":"Value sent to the chart color scale"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"key"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TDatum, ChartKey>"}]},{"type":"tableCell","children":[{"type":"text","value":"Top/nested "},{"type":"inlineCode","value":"id"},{"type":"text","value":", then index"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable identity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stroke"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<TDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolved color"}]},{"type":"tableCell","children":[{"type":"text","value":"Final tick paint override"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeOpacity"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Stroke opacity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"1.5"}]},{"type":"tableCell","children":[{"type":"text","value":"Stroke width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"length"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Perpendicular scale bandwidth, otherwise "},{"type":"inlineCode","value":"6"}]},{"type":"tableCell","children":[{"type":"text","value":"Total length before inset"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"span"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Total length in category-step units"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"inset"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"Pixels removed from both ends"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Available length is clamped to at least zero after subtracting twice the inset.\n"},{"type":"inlineCode","value":"length"},{"type":"text","value":" and "},{"type":"inlineCode","value":"span"},{"type":"text","value":" are mutually exclusive. "},{"type":"inlineCode","value":"span"},{"type":"text","value":" requires a point or band\nscale on the perpendicular axis and uses the complete configured domain,\nincluding empty category slots, to derive its step.\nEach valid row emits one interaction point at the tick center."}]},{"type":"heading","depth":2,"id":"invalid-rows-and-identity","children":[{"type":"text","value":"Invalid rows and identity"}]},{"type":"paragraph","children":[{"type":"text","value":"Links, arrows, vectors, and ticks skip rows with any invalid required\npositional value. Links and arrows require all four endpoints. Stable "},{"type":"inlineCode","value":"key"},{"type":"text","value":"\nchannels are especially important for independent segments because keyed\nreconciliation otherwise falls back to row index."}]}],"headings":[{"id":"rulex-and-ruley","text":"ruleX and ruleY","level":2},{"id":"link","text":"link","level":2},{"id":"arrow","text":"arrow","level":2},{"id":"vector","text":"vector","level":2},{"id":"tickx-and-ticky","text":"tickX and tickY","level":2},{"id":"invalid-rows-and-identity","text":"Invalid rows and identity","level":2}]},"frameworks":[],"downloadMarkdown":"\nThese marks cover reference lines, independent segments, directed\nrelationships, fixed-pixel vectors, and compact glyphs. They compose with any\nother mark and use the chart's shared positional and color scales.\n\n```ts\nimport {\n  arrow,\n  link,\n  ruleX,\n  ruleY,\n  tickX,\n  tickY,\n  vector,\n} from '@tanstack/charts'\n```\n\n## `ruleX` and `ruleY`\n\n`ruleX` draws a vertical rule through the complete inner chart height.\n`ruleY` draws a horizontal rule through the complete inner chart width.\n\n```ts\nruleX(events, { x: 'date', stroke: '#dc2626' })\nruleY([0], { strokeOpacity: 0.7, strokeDasharray: '4 2' })\n```\n\n```ts\nfunction ruleX<TDatum>(\n  source: Iterable<TDatum>,\n  options?: RuleXOptions<TDatum>,\n): ChartMark<never, InferredX, never>\n\nfunction ruleY<TDatum>(\n  source: Iterable<TDatum>,\n  options?: RuleYOptions<TDatum>,\n): ChartMark<never, never, InferredY>\n```\n\nOptions are orientation-specific:\n\n| Option            | Type                            | Default                               | Meaning                             |\n| ----------------- | ------------------------------- | ------------------------------------- | ----------------------------------- |\n| `id`              | `string`                        | Layer-derived                         | Stable mark ID                      |\n| `x`               | `Channel<TDatum, ChartValue?>`  | Datum itself when it is a chart value | `ruleX` position                    |\n| `y`               | `Channel<TDatum, ChartValue?>`  | Datum itself when it is a chart value | `ruleY` position                    |\n| `color`           | `Channel<TDatum, ChartKey?>`    | No value                              | Value sent to the chart color scale |\n| `stroke`          | `VisualChannel<TDatum, string>` | Resolved color or theme foreground    | Final rule paint override           |\n| `strokeOpacity`   | `number`                        | `0.5`                                 | Stroke opacity                      |\n| `strokeWidth`     | `number`                        | SVG default                           | Stroke width                        |\n| `strokeDasharray` | `string`                        | None                                  | SVG dash array                      |\n\nRules emit no interaction points and therefore do not participate in native\nfocus or tooltips. Their datum type is intentionally absent from the chart's\ninteraction union.\n\n## `link`\n\n`link` draws one independent segment per row. It is appropriate for networks,\nslopegraphs, error intervals, and annotations. Use `lineY` when consecutive\nrows form one path.\n\n```ts\nlink(edges, {\n  x1: 'sourceX',\n  y1: 'sourceY',\n  x2: 'targetX',\n  y2: 'targetY',\n  z: 'kind',\n  strokeWidth: (edge) => edge.weight,\n  lineCap: 'butt',\n})\n```\n\n```ts\nfunction link<TDatum>(\n  source: Iterable<TDatum>,\n  options: LinkOptions<TDatum>,\n): ChartMark<TDatum, InferredEndpointX, InferredEndpointY>\n```\n\n| Option            | Type                            | Default                | Meaning                             |\n| ----------------- | ------------------------------- | ---------------------- | ----------------------------------- |\n| `id`              | `string`                        | Layer-derived          | Stable mark ID                      |\n| `x1`, `y1`        | required channels               | —                      | First endpoint                      |\n| `x2`, `y2`        | required channels               | —                      | Second endpoint                     |\n| `z`               | `Channel<TDatum, ChartKey?>`    | No group               | Interaction group                   |\n| `color`           | `Channel<TDatum, ChartKey?>`    | `z`                    | Value sent to the chart color scale |\n| `key`             | `Channel<TDatum, ChartKey>`     | Top/nested `id`, index | Stable identity                     |\n| `stroke`          | `VisualChannel<TDatum, string>` | Resolved color         | Final segment paint override        |\n| `strokeOpacity`   | `VisualChannel<TDatum, number>` | SVG default            | Stroke opacity                      |\n| `strokeWidth`     | `VisualChannel<TDatum, number>` | `1.5`                  | Stroke width                        |\n| `strokeDasharray` | `string`                        | None                   | SVG dash array                      |\n| `lineCap`         | `\"butt\" \\| \"round\" \\| \"square\"` | `\"round\"`              | Stroke cap                          |\n| `curve`           | `ChartCurve`                    | Straight rule          | Optional path generator             |\n\nWith no curve, the scene contains a rule. With a curve, it contains a\ntwo-point polyline with the generated path. The interaction coordinate is the\npixel midpoint; semantic `xValue` and `yValue` are the second endpoint.\n\nThe optional `d3Curve` bridge and granular algorithm boundary are documented in\n[Line and area](./line-and-area.md#curves) and\n[Scales](../../concepts/scales-and-d3.md).\n\n## `arrow`\n\n`arrow` draws one straight directed segment with a fixed-pixel head:\n\n```ts\narrow(edges, {\n  x1: 'sourceX',\n  y1: 'sourceY',\n  x2: 'targetX',\n  y2: 'targetY',\n  headLength: 10,\n  headAngle: 28,\n})\n```\n\n```ts\nfunction arrow<TDatum>(\n  source: Iterable<TDatum>,\n  options: ArrowOptions<TDatum>,\n): ChartMark<TDatum, InferredEndpointX, InferredEndpointY>\n```\n\n| Option          | Type                            | Default                | Meaning                                         |\n| --------------- | ------------------------------- | ---------------------- | ----------------------------------------------- |\n| `id`            | `string`                        | Layer-derived          | Stable mark ID                                  |\n| `x1`, `y1`      | required channels               | —                      | Tail endpoint                                   |\n| `x2`, `y2`      | required channels               | —                      | Head endpoint                                   |\n| `z`             | `Channel<TDatum, ChartKey?>`    | No group               | Interaction group                               |\n| `color`         | `Channel<TDatum, ChartKey?>`    | `z`                    | Value sent to the chart color scale             |\n| `key`           | `Channel<TDatum, ChartKey>`     | Top/nested `id`, index | Stable identity                                 |\n| `stroke`        | `VisualChannel<TDatum, string>` | Resolved color         | Final arrow paint override                      |\n| `strokeOpacity` | `number`                        | SVG default            | Stroke opacity                                  |\n| `strokeWidth`   | `number`                        | `1.5`                  | Stroke width                                    |\n| `headLength`    | `number`                        | `8`                    | Head length in pixels, clamped to at least zero |\n| `headAngle`     | `number`                        | `30`                   | Half-angle in degrees                           |\n\nThe arrowhead stays the same pixel size as scales and container dimensions\nchange. The interaction coordinate and semantic x/y values are the head\nendpoint.\n\n## `vector`\n\n`vector` places a fixed-pixel directed vector at a scaled anchor:\n\n```ts\nvector(wind, {\n  x: 'longitude',\n  y: 'latitude',\n  length: 'speed',\n  rotate: 'bearing',\n  anchor: 'middle',\n  z: 'region',\n})\n```\n\n```ts\nfunction vector<TDatum>(\n  source: Iterable<TDatum>,\n  options: VectorOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n```\n\n| Option          | Type                                 | Default                | Meaning                                         |\n| --------------- | ------------------------------------ | ---------------------- | ----------------------------------------------- |\n| `id`            | `string`                             | Layer-derived          | Stable mark ID                                  |\n| `x`, `y`        | required channels                    | —                      | Scaled anchor                                   |\n| `length`        | `number \\| Channel<TDatum, number?>` | `12`                   | Vector length in pixels                         |\n| `rotate`        | `number \\| Channel<TDatum, number?>` | `0`                    | Clockwise degrees; zero points up               |\n| `anchor`        | `'start' \\| 'middle' \\| 'end'`       | `'middle'`             | Which vector position stays at x/y              |\n| `z`             | `Channel<TDatum, ChartKey?>`         | No group               | Interaction group                               |\n| `color`         | `Channel<TDatum, ChartKey?>`         | `z`                    | Value sent to the chart color scale             |\n| `key`           | `Channel<TDatum, ChartKey>`          | Top/nested `id`, index | Stable identity                                 |\n| `stroke`        | `VisualChannel<TDatum, string>`      | Resolved color         | Final stroke override                           |\n| `strokeOpacity` | `number`                             | SVG default            | Stroke opacity                                  |\n| `strokeWidth`   | `number`                             | `1.5`                  | Stroke width                                    |\n| `headLength`    | `number`                             | `5`                    | Head length in pixels, clamped to at least zero |\n| `headAngle`     | `number`                             | `30`                   | Head half-angle in degrees                      |\n\nLength and rotation must be finite. Negative length reverses the body direction\nwhile preserving the rotation convention. The interaction point remains the\nscaled x/y anchor for every anchor mode.\n\n## `tickX` and `tickY`\n\nTicks draw a short rule centered at a scaled point:\n\n- `tickX` draws a vertical rule, so its length spans the y direction.\n- `tickY` draws a horizontal rule, so its length spans the x direction.\n\n```ts\ntickX(rows, { x: 'category', y: 'value', z: 'series' })\ntickY(rows, { x: 'value', y: 'category', length: 16 })\ntickY(summaries, { x: 'category', y: 'median', span: 0.36 })\n```\n\n```ts\nfunction tickX<TDatum>(\n  source: Iterable<TDatum>,\n  options: TickXOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n\nfunction tickY<TDatum>(\n  source: Iterable<TDatum>,\n  options: TickYOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n```\n\nBoth share:\n\n| Option          | Type                            | Default                                      | Meaning                             |\n| --------------- | ------------------------------- | -------------------------------------------- | ----------------------------------- |\n| `id`            | `string`                        | Layer-derived                                | Stable mark ID                      |\n| `x`, `y`        | required channels               | —                                            | Tick center                         |\n| `z`             | `Channel<TDatum, ChartKey?>`    | No group                                     | Interaction group                   |\n| `color`         | `Channel<TDatum, ChartKey?>`    | `z`                                          | Value sent to the chart color scale |\n| `key`           | `Channel<TDatum, ChartKey>`     | Top/nested `id`, then index                  | Stable identity                     |\n| `stroke`        | `VisualChannel<TDatum, string>` | Resolved color                               | Final tick paint override           |\n| `strokeOpacity` | `number`                        | SVG default                                  | Stroke opacity                      |\n| `strokeWidth`   | `number`                        | `1.5`                                        | Stroke width                        |\n| `length`        | `number`                        | Perpendicular scale bandwidth, otherwise `6` | Total length before inset           |\n| `span`          | `number`                        | None                                         | Total length in category-step units |\n| `inset`         | `number`                        | `0`                                          | Pixels removed from both ends       |\n\nAvailable length is clamped to at least zero after subtracting twice the inset.\n`length` and `span` are mutually exclusive. `span` requires a point or band\nscale on the perpendicular axis and uses the complete configured domain,\nincluding empty category slots, to derive its step.\nEach valid row emits one interaction point at the tick center.\n\n## Invalid rows and identity\n\nLinks, arrows, vectors, and ticks skip rows with any invalid required\npositional value. Links and arrows require all four endpoints. Stable `key`\nchannels are especially important for independent segments because keyed\nreconciliation otherwise falls back to row index.\n","originalRawMarkdown":"---\ntitle: Rules, Links, Arrows, Vectors, and Ticks\ndescription: Reference for ruleX, ruleY, link, arrow, vector, tickX, and tickY geometry, channels, defaults, curves, and focus anchors.\n---\n\nThese marks cover reference lines, independent segments, directed\nrelationships, fixed-pixel vectors, and compact glyphs. They compose with any\nother mark and use the chart's shared positional and color scales.\n\n```ts\nimport {\n  arrow,\n  link,\n  ruleX,\n  ruleY,\n  tickX,\n  tickY,\n  vector,\n} from '@tanstack/charts'\n```\n\n## `ruleX` and `ruleY`\n\n`ruleX` draws a vertical rule through the complete inner chart height.\n`ruleY` draws a horizontal rule through the complete inner chart width.\n\n```ts\nruleX(events, { x: 'date', stroke: '#dc2626' })\nruleY([0], { strokeOpacity: 0.7, strokeDasharray: '4 2' })\n```\n\n```ts\nfunction ruleX<TDatum>(\n  source: Iterable<TDatum>,\n  options?: RuleXOptions<TDatum>,\n): ChartMark<never, InferredX, never>\n\nfunction ruleY<TDatum>(\n  source: Iterable<TDatum>,\n  options?: RuleYOptions<TDatum>,\n): ChartMark<never, never, InferredY>\n```\n\nOptions are orientation-specific:\n\n| Option            | Type                            | Default                               | Meaning                             |\n| ----------------- | ------------------------------- | ------------------------------------- | ----------------------------------- |\n| `id`              | `string`                        | Layer-derived                         | Stable mark ID                      |\n| `x`               | `Channel<TDatum, ChartValue?>`  | Datum itself when it is a chart value | `ruleX` position                    |\n| `y`               | `Channel<TDatum, ChartValue?>`  | Datum itself when it is a chart value | `ruleY` position                    |\n| `color`           | `Channel<TDatum, ChartKey?>`    | No value                              | Value sent to the chart color scale |\n| `stroke`          | `VisualChannel<TDatum, string>` | Resolved color or theme foreground    | Final rule paint override           |\n| `strokeOpacity`   | `number`                        | `0.5`                                 | Stroke opacity                      |\n| `strokeWidth`     | `number`                        | SVG default                           | Stroke width                        |\n| `strokeDasharray` | `string`                        | None                                  | SVG dash array                      |\n\nRules emit no interaction points and therefore do not participate in native\nfocus or tooltips. Their datum type is intentionally absent from the chart's\ninteraction union.\n\n## `link`\n\n`link` draws one independent segment per row. It is appropriate for networks,\nslopegraphs, error intervals, and annotations. Use `lineY` when consecutive\nrows form one path.\n\n```ts\nlink(edges, {\n  x1: 'sourceX',\n  y1: 'sourceY',\n  x2: 'targetX',\n  y2: 'targetY',\n  z: 'kind',\n  strokeWidth: (edge) => edge.weight,\n  lineCap: 'butt',\n})\n```\n\n```ts\nfunction link<TDatum>(\n  source: Iterable<TDatum>,\n  options: LinkOptions<TDatum>,\n): ChartMark<TDatum, InferredEndpointX, InferredEndpointY>\n```\n\n| Option            | Type                            | Default                | Meaning                             |\n| ----------------- | ------------------------------- | ---------------------- | ----------------------------------- |\n| `id`              | `string`                        | Layer-derived          | Stable mark ID                      |\n| `x1`, `y1`        | required channels               | —                      | First endpoint                      |\n| `x2`, `y2`        | required channels               | —                      | Second endpoint                     |\n| `z`               | `Channel<TDatum, ChartKey?>`    | No group               | Interaction group                   |\n| `color`           | `Channel<TDatum, ChartKey?>`    | `z`                    | Value sent to the chart color scale |\n| `key`             | `Channel<TDatum, ChartKey>`     | Top/nested `id`, index | Stable identity                     |\n| `stroke`          | `VisualChannel<TDatum, string>` | Resolved color         | Final segment paint override        |\n| `strokeOpacity`   | `VisualChannel<TDatum, number>` | SVG default            | Stroke opacity                      |\n| `strokeWidth`     | `VisualChannel<TDatum, number>` | `1.5`                  | Stroke width                        |\n| `strokeDasharray` | `string`                        | None                   | SVG dash array                      |\n| `lineCap`         | `\"butt\" \\| \"round\" \\| \"square\"` | `\"round\"`              | Stroke cap                          |\n| `curve`           | `ChartCurve`                    | Straight rule          | Optional path generator             |\n\nWith no curve, the scene contains a rule. With a curve, it contains a\ntwo-point polyline with the generated path. The interaction coordinate is the\npixel midpoint; semantic `xValue` and `yValue` are the second endpoint.\n\nThe optional `d3Curve` bridge and granular algorithm boundary are documented in\n[Line and area](./line-and-area.md#curves) and\n[Scales](../../concepts/scales-and-d3.md).\n\n## `arrow`\n\n`arrow` draws one straight directed segment with a fixed-pixel head:\n\n```ts\narrow(edges, {\n  x1: 'sourceX',\n  y1: 'sourceY',\n  x2: 'targetX',\n  y2: 'targetY',\n  headLength: 10,\n  headAngle: 28,\n})\n```\n\n```ts\nfunction arrow<TDatum>(\n  source: Iterable<TDatum>,\n  options: ArrowOptions<TDatum>,\n): ChartMark<TDatum, InferredEndpointX, InferredEndpointY>\n```\n\n| Option          | Type                            | Default                | Meaning                                         |\n| --------------- | ------------------------------- | ---------------------- | ----------------------------------------------- |\n| `id`            | `string`                        | Layer-derived          | Stable mark ID                                  |\n| `x1`, `y1`      | required channels               | —                      | Tail endpoint                                   |\n| `x2`, `y2`      | required channels               | —                      | Head endpoint                                   |\n| `z`             | `Channel<TDatum, ChartKey?>`    | No group               | Interaction group                               |\n| `color`         | `Channel<TDatum, ChartKey?>`    | `z`                    | Value sent to the chart color scale             |\n| `key`           | `Channel<TDatum, ChartKey>`     | Top/nested `id`, index | Stable identity                                 |\n| `stroke`        | `VisualChannel<TDatum, string>` | Resolved color         | Final arrow paint override                      |\n| `strokeOpacity` | `number`                        | SVG default            | Stroke opacity                                  |\n| `strokeWidth`   | `number`                        | `1.5`                  | Stroke width                                    |\n| `headLength`    | `number`                        | `8`                    | Head length in pixels, clamped to at least zero |\n| `headAngle`     | `number`                        | `30`                   | Half-angle in degrees                           |\n\nThe arrowhead stays the same pixel size as scales and container dimensions\nchange. The interaction coordinate and semantic x/y values are the head\nendpoint.\n\n## `vector`\n\n`vector` places a fixed-pixel directed vector at a scaled anchor:\n\n```ts\nvector(wind, {\n  x: 'longitude',\n  y: 'latitude',\n  length: 'speed',\n  rotate: 'bearing',\n  anchor: 'middle',\n  z: 'region',\n})\n```\n\n```ts\nfunction vector<TDatum>(\n  source: Iterable<TDatum>,\n  options: VectorOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n```\n\n| Option          | Type                                 | Default                | Meaning                                         |\n| --------------- | ------------------------------------ | ---------------------- | ----------------------------------------------- |\n| `id`            | `string`                             | Layer-derived          | Stable mark ID                                  |\n| `x`, `y`        | required channels                    | —                      | Scaled anchor                                   |\n| `length`        | `number \\| Channel<TDatum, number?>` | `12`                   | Vector length in pixels                         |\n| `rotate`        | `number \\| Channel<TDatum, number?>` | `0`                    | Clockwise degrees; zero points up               |\n| `anchor`        | `'start' \\| 'middle' \\| 'end'`       | `'middle'`             | Which vector position stays at x/y              |\n| `z`             | `Channel<TDatum, ChartKey?>`         | No group               | Interaction group                               |\n| `color`         | `Channel<TDatum, ChartKey?>`         | `z`                    | Value sent to the chart color scale             |\n| `key`           | `Channel<TDatum, ChartKey>`          | Top/nested `id`, index | Stable identity                                 |\n| `stroke`        | `VisualChannel<TDatum, string>`      | Resolved color         | Final stroke override                           |\n| `strokeOpacity` | `number`                             | SVG default            | Stroke opacity                                  |\n| `strokeWidth`   | `number`                             | `1.5`                  | Stroke width                                    |\n| `headLength`    | `number`                             | `5`                    | Head length in pixels, clamped to at least zero |\n| `headAngle`     | `number`                             | `30`                   | Head half-angle in degrees                      |\n\nLength and rotation must be finite. Negative length reverses the body direction\nwhile preserving the rotation convention. The interaction point remains the\nscaled x/y anchor for every anchor mode.\n\n## `tickX` and `tickY`\n\nTicks draw a short rule centered at a scaled point:\n\n- `tickX` draws a vertical rule, so its length spans the y direction.\n- `tickY` draws a horizontal rule, so its length spans the x direction.\n\n```ts\ntickX(rows, { x: 'category', y: 'value', z: 'series' })\ntickY(rows, { x: 'value', y: 'category', length: 16 })\ntickY(summaries, { x: 'category', y: 'median', span: 0.36 })\n```\n\n```ts\nfunction tickX<TDatum>(\n  source: Iterable<TDatum>,\n  options: TickXOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n\nfunction tickY<TDatum>(\n  source: Iterable<TDatum>,\n  options: TickYOptions<TDatum>,\n): ChartMark<TDatum, InferredX, InferredY>\n```\n\nBoth share:\n\n| Option          | Type                            | Default                                      | Meaning                             |\n| --------------- | ------------------------------- | -------------------------------------------- | ----------------------------------- |\n| `id`            | `string`                        | Layer-derived                                | Stable mark ID                      |\n| `x`, `y`        | required channels               | —                                            | Tick center                         |\n| `z`             | `Channel<TDatum, ChartKey?>`    | No group                                     | Interaction group                   |\n| `color`         | `Channel<TDatum, ChartKey?>`    | `z`                                          | Value sent to the chart color scale |\n| `key`           | `Channel<TDatum, ChartKey>`     | Top/nested `id`, then index                  | Stable identity                     |\n| `stroke`        | `VisualChannel<TDatum, string>` | Resolved color                               | Final tick paint override           |\n| `strokeOpacity` | `number`                        | SVG default                                  | Stroke opacity                      |\n| `strokeWidth`   | `number`                        | `1.5`                                        | Stroke width                        |\n| `length`        | `number`                        | Perpendicular scale bandwidth, otherwise `6` | Total length before inset           |\n| `span`          | `number`                        | None                                         | Total length in category-step units |\n| `inset`         | `number`                        | `0`                                          | Pixels removed from both ends       |\n\nAvailable length is clamped to at least zero after subtracting twice the inset.\n`length` and `span` are mutually exclusive. `span` requires a point or band\nscale on the perpendicular axis and uses the complete configured domain,\nincluding empty category slots, to derive its step.\nEach valid row emits one interaction point at the tick center.\n\n## Invalid rows and identity\n\nLinks, arrows, vectors, and ticks skip rows with any invalid required\npositional value. Links and arrows require all four endpoints. Stable `key`\nchannels are especially important for independent segments because keyed\nreconciliation otherwise falls back to row index.\n"}
