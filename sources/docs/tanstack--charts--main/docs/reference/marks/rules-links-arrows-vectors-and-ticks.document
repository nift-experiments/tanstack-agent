{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"These marks cover reference lines, independent segments, directed\nrelationships, fixed-pixel vectors, and compact glyphs. They compose with any\nother mark and use the chart's shared positional and color scales."}]},{"type":"code","value":"import {\n  arrow,\n  link,\n  ruleX,\n  ruleY,\n  tickX,\n  tickY,\n  vector,\n} from '@tanstack/charts'","lang":"ts"},{"type":"heading","depth":2,"id":"rulex-and-ruley","children":[{"type":"inlineCode","value":"ruleX"},{"type":"text","value":" and "},{"type":"inlineCode","value":"ruleY"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ruleX"},{"type":"text","value":" draws a vertical rule through the complete inner chart height.\n"},{"type":"inlineCode","value":"ruleY"},{"type":"text","value":" draws a horizontal rule through the complete inner chart width."}]},{"type":"code","value":"ruleX(events, { x: 'date', stroke: '#dc2626' })\nruleY([0], { strokeOpacity: 0.7, strokeDasharray: '4 2' })","lang":"ts"},{"type":"code","value":"function ruleX<TDatum>(\n  source: Iterable<TDatum>,\n  options?: RuleXOptions<TDatum>,\n): ChartMark<never, InferredX, never>\n\nfunction ruleY<TDatum>(\n  source: Iterable<TDatum>,\n  options?: RuleYOptions<TDatum>,\n): ChartMark<never, never, InferredY>","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Options are orientation-specific:"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer-deriv