:"text","value":"SVG default"}]},{"type":"tableCell","children":[{"type":"text","value":"Stroke width"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"strokeDasharray"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"SVG dash array"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Rules emit no interaction points and therefore do not participate in native\nfocus or tooltips. Their datum type is intentionally absent from the chart's\ninteraction union."}]},{"type":"heading","depth":2,"id":"link","children":[{"type":"inlineCode","value":"link"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"link"},{"type":"text","value":" draws one independent segment per row. It is appropriate for networks,\nslopegraphs, error intervals, and annotations. Use "},{"type":"inlineCode","value":"lineY"},{"type":"text","value":" when consecutive\nrows form one path."}]},{"type":"code","value":"link(edges, {\n  x1: 'sourceX',\n  y1: 'sourceY',\n  x2: 'targetX',\n  y2: 'targetY',\n  z: 'kind',\n  strokeWidth: (edge) => edge.weight,\n  lineCap: 'butt',\n})","lang":"ts"},{"type":"code","value":"function link<TDatum>(\n  source: Iterable<TDatum>,\n  options: LinkOptions<TDatum>,\n): ChartMark<TDatum, InferredEndpointX, InferredEndpointY>","lang":"ts"},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer-derived"}]},{"type":"t