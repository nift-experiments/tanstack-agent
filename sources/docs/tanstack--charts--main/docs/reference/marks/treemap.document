{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"treemap"},{"type":"text","value":" converts flat hierarchy rows into area-proportional leaf rectangles.\nIt runs after the final plot bounds resolve, so tiling, padding, and labels use\nCSS pixels without application-owned coordinates or Cartesian scales."}]},{"type":"code","value":"import { treemap } from '@tanstack/charts/hierarchy/treemap'\n\nconst mark = treemap(rows, {\n  path: 'name',\n  delimiter: '.',\n  value: 'size',\n  color: (node) => node.ancestorIds.at(-1) ?? node.id,\n  label: 'name',\n  inset: 1,\n  stroke: '#fff',\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The exact optional subpath keeps hierarchy tiling out of root and ordinary-mark\nconsumers."}]},{"type":"heading","depth":2,"id":"hierarchy-input","children":[{"type":"text","value":"Hierarchy input"}]},{"type":"paragraph","children":[{"type":"text","value":"Path input constructs parent-child relationships from a string channel:"}]},{"type":"code","value":"treemap(rows, {\n  path: 'name',\n  delimiter: '.',\n  value: 'size',\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Explicit parent references use "},{"type":"inlineCode","value":"nodeId"},{"type":"text","value":" because "},{"type":"inlineCode","value":"id"},{"type":"text","value":" is reserved for the mark:"}]},{"type":"code","value":"treemap(rows, {\n  id: 'package-sizes',\n  nodeId: 'id',\n  parentId: 'parentId',\n  value: 'size',\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Path input may omit ancestors. The mark imputes those structural nodes with\n"},{"type":"inlineCode","value":"data: null"},{"type":"text","value":" and empty direct lineage. Duplicate identities, invalid parents,\nmultiple roots, and cycles throw before rendering. Authored child order is\npreserved unless "},{"type":"inlineCode","value":"sort"},{"type":"text","value":" is supplied."}]},{"type":"paragraph","children":[{"type":"text","value":"Path-mode IDs use canonical slash form and "},{"type":"inlineCode","value":"name"},{"type":"text","value":" is the terminal path segment.\nExplicit-parent IDs are opaque, so "},{"type":"inlineCode","value":"name"},{"type":"text","value":" is the complete authored ID even\nwhen it contains a slash."}]},{"type":"heading","depth":2,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TreemapPathOptions<TDatum>"},{"type":"text","value":" and "},{"type":"inlineCode","value":"TreemapParentOptions<TDatum>"},{"type":"text","value":" form the\n"},{"type":"inlineCode","value":"TreemapOptions<TDatum>"},{"type":"text","value":" union."}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"path"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TransformValue<TDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Path mode only"}]},{"type":"tableCell","children":[{"type":"text","value":"Full hierarchy path"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"delimiter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/"}]},{"type":"tableCell","children":[{"type":"text","value":"One-character path separator"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"nodeId"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TransformValue<TDatum, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Parent mode only"}]},{"type":"tableCell","c