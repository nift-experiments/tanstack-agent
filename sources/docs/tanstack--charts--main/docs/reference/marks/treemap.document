"value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"Pixel gap between adjacent children"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"paddingOuter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"Pixel gap between parent edges and children"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"sort"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TreemapNodeComparator<TDatum>"}]},{"type":"tableCell","children":[{"type":"text","value":"Authored order"}]},{"type":"tableCell","children":[{"type":"text","value":"Sibling comparator over immutable node contexts"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Layer-derived"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable mark identity"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"color"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TreemapNode<TDatum>, ChartKey?>"}]},{"type":"tableCell","children":[{"type":"text","value":"No group"}]},{"type":"tableCell","children":[{"type":"text","value":"Node value sent to the color scale"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fill"},{"type":"text","value":", "},{"type":"inlineCode","value":"stroke"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<TreemapNode<TDatum>, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Resolved color / none"}]},{"type":"tableCell","children":[{"type":"text","value":"Per-node paint"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"fillOpacity"},{"type":"text","value":", "},{"type":"inlineCode","value":"strokeOpacity"},{"type":"text","value":", "},{"type":"inlineCode","value":"strokeWidth"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"Renderer default"}]},{"type":"tableCell","children":[{"type":"text","value":"Rectangle presentation"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"inset"},{"type":"text","value":", "},{"type":"inlineCode","value":"radius"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0.75"},{"type":"text","value":" / none"}]},{"type":"tableCell","children":[{"type":"text","value":"Painted rectangle inset and corner radius"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"label"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Channel<TreemapNode<TDatum>, string | number?>"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Centered in-cell label"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"labelFill"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VisualChannel<TreemapNode<TDatum>, string>"}]},{"type":"tableCell","children":[{"type":"text","value":"Theme foreground"}]},{"type":"tableCell","children":[{"type":"text","value":"Label paint"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"labelFontSize"},{"type":"text","value":", "},{"type":"inlineCode","value":"labelFontWeight"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"11"},{"type":"text","value":" / renderer default"}]},{"type":"tableCell","children":[{"type":"text","value":"Label typography"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"labelPadding"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"4"}]},{"type":"tableCell","children":[{"type":"text","value":"Minimum painted pixels around a label"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"states"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"readonly ChartMarkState[]"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Focus-driven rectangle states"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"motion"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartMarkMotionOptions<TreemapNode<TDatum>>['motion']"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]},{"type":"tableCell","children":[{"type":"text","value":"Per-node motion policy"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Nullish values contribute zero. Other values must be nonnegative and finite.\n"},{"type":"inlineCode","value":"ratio"},{"type":"text","value":" is valid only with "},{"type":"inlineCode","value":"squarify"},{"type":"text","value":". Padding, inset, and label padding are\nnonnegative CSS-pixel values."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"method"},{"type":"text","value":" also accepts a native D3 tiler or a compatible callable:"}]},{"type":"code","value":"import { treemapBinary } from 'd3-hierarchy'\n\ntreemap(rows, {\n  path: 'name',\n  value: 'size',\n  method: treemapBinary,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"A callable receives a "},{"type":"inlineCode","value":"HierarchyRectangularNode<TreemapTileDatum<TDatum>>"},{"type":"text","value":"\nfrom the mark's private hierarchy copy plus the tile bounds. It must assign\nchild coordinates synchronously using the D3 tile contract. The datum wrapper\ncontains hierarchy identity, the nullable raw row, and its source index. Do\nnot retain or mutate the authored row. Configure callable-specific behavior in\nthe callable itself; "},{"type":"inlineCode","value":"ratio"},{"type":"text","value":" remains exclusive to the "},{"type":"inlineCode","value":"squarify"},{"type":"text","value":" shorthand."}]},{"type":"heading","depth":2,"id":"responsive-layout","children":[{"type":"text","value":"Responsive layout"}]},{"type":"paragraph","children":[{"type":"text","value":"Treemap row grouping depends on the final plot aspect ratio. The mark sizes the\nselected tiler to the resolved inner width and height on every layout pass;\nresizing may therefore change rectangle adjacency as well as dimensions.\nCoordinates use the screen convention where y increases downward and never\nenter a Cartesian scale."}]},{"type":"paragraph","children":[{"type":"text","value":"Each pass lays out a private hierarchy copy. Value and path accessors are not\nrerun, input rows are not mutated, and repeated compilation at one size is\ndeterministic. Stateful "},{"type":"inlineCode","value":"resquarify"},{"type":"text","value":" is intentionally not a method."}]},{"type":"heading","depth":2,"id":"nodes-labels-and-interaction","children":[{"type":"text","value":"Nodes, labels, and interaction"}]},{"type":"paragraph","children":[{"type":"text","value":"Only positive-area leaves render. Every rectangle and interaction point carries\none "},{"type":"inlineCode","value":"TreemapNode<TDatum>"},{"type":"text","value":" with:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"stable "},{"type":"inlineCode","value":"id"},{"type":"text","value":", "},{"type":"inlineCode","value":"parentId"},{"type":"text","value":", and root-to-parent "},{"type":"inlineCode","value":"ancestorIds"},{"type":"text","value":";"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"name"},{"type":"text","value":", "},{"type":"inlineCode","value":"depth"},{"type":"text","value":", "},{"type":"inlineCode","value":"height"},{"type":"text","value":", and "},{"type":"inlineCode","value":"internal"},{"type":"text","value":" / "},{"type":"inlineCode","value":"external"},{"type":"text","value":" metadata;"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"aggregate "},{"type":"inlineCode","value":"value"},{"type":"text","value":";"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the authored "},{"type":"inlineCode","value":"data"},{"type":"text","value":" row, or "},{"type":"inlineCode","value":"null"},{"type":"text","value":" for an imputed node; and"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"direct "},{"type":"inlineCode","value":"source"},{"type":"text","value":" and "},{"type":"inlineCode","value":"sourceIndexes"},{"type":"text","value":" lineage."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Color, paint, state, and label channels receive these nodes. A label is emitted\nonly when its measured bounds plus "},{"type":"inlineCode","value":"labelPadding"},{"type":"text","value":" fit inside the painted cell.\nThis uses the chart host's text measurer when available and the deterministic\nscene estimator otherwise."}]},{"type":"heading","depth":2,"id":"types","children":[{"type":"text","value":"Types"}]},{"type":"paragraph","children":[{"type":"text","value":"The exact entry exports "},{"type":"inlineCode","value":"treemap"},{"type":"text","value":", "},{"type":"inlineCode","value":"TreemapMethod"},{"type":"text","value":", "},{"type":"inlineCode","value":"TreemapTileDatum"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"TreemapTile"},{"type":"text","value":", "},{"type":"inlineCode","value":"TreemapNode"},{"type":"text","value":", "},{"type":"inlineCode","value":"TreemapNodeComparator"},{"type":"text","value":", "},{"type":"inlineCode","value":"TreemapPathOptions"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"TreemapParentOptions"},{"type":"text","value":", and "},{"type":"inlineCode","value":"TreemapOptions"},{"type":"text","value":"."}]}],"headings":[{"id":"hierarchy-input","text":"Hierarchy input","level":2},{"id":"options","text":"Options","level":2},{"id":"responsive-layout","text":"Responsive layout","level":2},{"id":"nodes-labels-and-interaction","text":"Nodes, labels, and interaction","level":2},{"id":"types","text":"Types","level":2}]},"frameworks":[],"downloadMarkdown":"\n`treemap` converts flat hierarchy rows into area-proportional leaf rectangles.\nIt runs after the final plot bounds resolve, so tiling, padding, and labels use\nCSS pixels without application-owned coordinates or Cartesian scales.\n\n```ts\nimport { treemap } from '@tanstack/charts/hierarchy/treemap'\n\nconst mark = treemap(rows, {\n  path: 'name',\n  delimiter: '.',\n  value: 'size',\n  color: (node) => node.ancestorIds.at(-1) ?? node.id,\n  label: 'name',\n  inset: 1,\n  stroke: '#fff',\n})\n```\n\nThe exact optional subpath keeps hierarchy tiling out of root and ordinary-mark\nconsumers.\n\n## Hierarchy input\n\nPath input constructs parent-child relationships from a string channel:\n\n```ts\ntreemap(rows, {\n  path: 'name',\n  delimiter: '.',\n  value: 'size',\n})\n```\n\nExplicit parent references use `nodeId` because `id` is reserved for the mark:\n\n```ts\ntreemap(rows, {\n  id: 'package-sizes',\n  nodeId: 'id',\n  parentId: 'parentId',\n  value: 'size',\n})\n```\n\nPath input may omit ancestors. The mark imputes those structural nodes with\n`data: null` and empty direct lineage. Duplicate identities, invalid parents,\nmultiple roots, and cycles throw before rendering. Authored child order is\npreserved unless `sort` is supplied.\n\nPath-mode IDs use canonical slash form and `name` is the terminal path segment.\nExplicit-parent IDs are opaque, so `name` is the complete authored ID even\nwhen it contains a slash.\n\n## Options\n\n`TreemapPathOptions<TDatum>` and `TreemapParentOptions<TDatum>` form the\n`TreemapOptions<TDatum>` union.\n\n| Option                                        | Type                                                    | Default                 | Meaning                                               |\n| --------------------------------------------- | ------------------------------------------------------- | ----------------------- | ----------------------------------------------------- |\n| `path`                                        | `TransformValue<TDatum, string>`                        | Path mode only          | Full hierarchy path                                   |\n| `delimiter`                                   | `string`                                                | `/`                     | One-character path separator                          |\n| `nodeId`                                      | `TransformValue<TDatum, string>`                        | Parent mode only        | Explicit node identity                                |\n| `parentId`                                    | `TransformValue<TDatum, string?>`                       | Parent mode only        | Explicit parent identity                              |\n| `value`                                       | `TransformValue<TDatum, number?>`                       | Required                | Nonnegative contribution summed through the hierarchy |\n| `method`                                      | `TreemapMethod \\| TreemapTile<TDatum>`                  | `squarify`              | Built-in shorthand or D3-compatible tile callable     |\n| `ratio`                                       | `number`                                                | Golden ratio            | Squarify target aspect ratio, at least `1`            |\n| `round`                                       | `boolean`                                               | `false`                 | Round final rectangle coordinates to pixels           |\n| `paddingInner`                                | `number`                                                | `0`                     | Pixel gap between adjacent children                   |\n| `paddingOuter`                                | `number`                                                | `0`                     | Pixel gap between parent edges and children           |\n| `sort`                                        | `TreemapNodeComparator<TDatum>`                         | Authored order          | Sibling comparator over immutable node contexts       |\n| `id`                                          | `string`                                                | Layer-derived           | Stable mark identity                                  |\n| `color`                                       | `Channel<TreemapNode<TDatum>, ChartKey?>`               | No group                | Node value sent to the color scale                    |\n| `fill`, `stroke`                              | `VisualChannel<TreemapNode<TDatum>, string>`            | Resolved color / none   | Per-node paint                                        |\n| `fillOpacity`, `strokeOpacity`, `strokeWidth` | `number`                                                | Renderer default        | Rectangle presentation                                |\n| `inset`, `radius`                             | `number`                                                | `0.75` / none           | Painted rectangle inset and corner radius             |\n| `label`                                       | `Channel<TreemapNode<TDatum>, string \\| number?>`       | None                    | Centered in-cell label                                |\n| `labelFill`                                   | `VisualChannel<TreemapNode<TDatum>, string>`            | Theme foreground        | Label paint                                           |\n| `labelFontSize`, `labelFontWeight`            | `number`                                                | `11` / renderer default | Label typography                                      |\n| `labelPadding`                                | `number`                                                | `4`                     | Minimum painted pixels around a label                 |\n| `states`                                      | `readonly ChartMarkState[]`                             | None                    | Focus-driven rectangle states                         |\n| `motion`                                      | `ChartMarkMotionOptions<TreemapNode<TDatum>>['motion']` | None                    | Per-node motion policy                                |\n\nNullish values contribute zero. Other values must be nonnegative and finite.\n`ratio` is valid only with `squarify`. Padding, inset, and label padding are\nnonnegative CSS-pixel values.\n\n`method` also accepts a native D3 tiler or a compatible callable:\n\n```ts\nimport { treemapBinary } from 'd3-hierarchy'\n\ntreemap(rows, {\n  path: 'name',\n  value: 'size',\n  method: treemapBinary,\n})\n```\n\nA callable receives a `HierarchyRectangularNode<TreemapTileDatum<TDatum>>`\nfrom the mark's private hierarchy copy plus the tile bounds. It must assign\nchild coordinates synchronously using the D3 tile contract. The datum wrapper\ncontains hierarchy identity, the nullable raw row, and its source index. Do\nnot retain or mutate the authored row. Configure callable-specific behavior in\nthe callable itself; `ratio` remains exclusive to the `squarify` shorthand.\n\n## Responsive layout\n\nTreemap row grouping depends on the final plot aspect ratio. The mark sizes the\nselected tiler to the resolved inner width and height on every layout pass;\nresizing may therefore change rectangle adjacency as well as dimensions.\nCoordinates use the screen convention where y increases downward and never\nenter a Cartesian scale.\n\nEach pass lays out a private hierarchy copy. Value and path accessors are not\nrerun, input rows are not mutated, and repeated compilation at one size is\ndeterministic. Stateful `resquarify` is intentionally not a method.\n\n## Nodes, labels, and interaction\n\nOnly positive-area leaves render. Every rectangle and interaction point carries\none `TreemapNode<TDatum>` with:\n\n- stable `id`, `parentId`, and root-to-parent `ancestorIds`;\n- `name`, `depth`, `height`, and `internal` / `external` metadata;\n- aggregate `value`;\n- the authored `data` row, or `null` for an imputed node; and\n- direct `source` and `sourceIndexes` lineage.\n\nColor, paint, state, and label channels receive these nodes. A label is emitted\nonly when its measured bounds plus `labelPadding` fit inside the painted cell.\nThis uses the chart host's text measurer when available and the deterministic\nscene estimator otherwise.\n\n## Types\n\nThe exact entry exports `treemap`, `TreemapMethod`, `TreemapTileDatum`,\n`TreemapTile`, `TreemapNode`, `TreemapNodeComparator`, `TreemapPathOptions`,\n`TreemapParentOptions`, and `TreemapOptions`.\n","originalRawMarkdown":"---\ntitle: Treemap Mark\ndescription: Reference for responsive hierarchy tiling, flat-row construction, node lineage, color, labels, and the optional treemap import.\n---\n\n`treemap` converts flat hierarchy rows into area-proportional leaf rectangles.\nIt runs after the final plot bounds resolve, so tiling, padding, and labels use\nCSS pixels without application-owned coordinates or Cartesian scales.\n\n```ts\nimport { treemap } from '@tanstack/charts/hierarchy/treemap'\n\nconst mark = treemap(rows, {\n  path: 'name',\n  delimiter: '.',\n  value: 'size',\n  color: (node) => node.ancestorIds.at(-1) ?? node.id,\n  label: 'name',\n  inset: 1,\n  stroke: '#fff',\n})\n```\n\nThe exact optional subpath keeps hierarchy tiling out of root and ordinary-mark\nconsumers.\n\n## Hierarchy input\n\nPath input constructs parent-child relationships from a string channel:\n\n```ts\ntreemap(rows, {\n  path: 'name',\n  delimiter: '.',\n  value: 'size',\n})\n```\n\nExplicit parent references use `nodeId` because `id` is reserved for the mark:\n\n```ts\ntreemap(rows, {\n  id: 'package-sizes',\n  nodeId: 'id',\n  parentId: 'parentId',\n  value: 'size',\n})\n```\n\nPath input may omit ancestors. The mark imputes those structural nodes with\n`data: null` and empty direct lineage. Duplicate identities, invalid parents,\nmultiple roots, and cycles throw before rendering. Authored child order is\npreserved unless `sort` is supplied.\n\nPath-mode IDs use canonical slash form and `name` is the terminal path segment.\nExplicit-parent IDs are opaque, so `name` is the complete authored ID even\nwhen it contains a slash.\n\n## Options\n\n`TreemapPathOptions<TDatum>` and `TreemapParentOptions<TDatum>` form the\n`TreemapOptions<TDatum>` union.\n\n| Option                                        | Type                                                    | Default                 | Meaning                                               |\n| --------------------------------------------- | ------------------------------------------------------- | ----------------------- | ----------------------------------------------------- |\n| `path`                                        | `TransformValue<TDatum, string>`                        | Path mode only          | Full hierarchy path                                   |\n| `delimiter`                                   | `string`                                                | `/`                     | One-character path separator                          |\n| `nodeId`                                      | `TransformValue<TDatum, string>`                        | Parent mode only        | Explicit node identity                                |\n| `parentId`                                    | `TransformValue<TDatum, string?>`                       | Parent mode only        | Explicit parent identity                              |\n| `value`                                       | `TransformValue<TDatum, number?>`                       | Required                | Nonnegative contribution summed through the hierarchy |\n| `method`                                      | `TreemapMethod \\| TreemapTile<TDatum>`                  | `squarify`              | Built-in shorthand or D3-compatible tile callable     |\n| `ratio`                                       | `number`                                                | Golden ratio            | Squarify target aspect ratio, at least `1`            |\n| `round`                                       | `boolean`                                               | `false`                 | Round final rectangle coordinates to pixels           |\n| `paddingInner`                                | `number`                                                | `0`                     | Pixel gap between adjacent children                   |\n| `paddingOuter`                                | `number`                                                | `0`                     | Pixel gap between parent edges and children           |\n| `sort`                                        | `TreemapNodeComparator<TDatum>`                         | Authored order          | Sibling comparator over immutable node contexts       |\n| `id`                                          | `string`                                                | Layer-derived           | Stable mark identity                                  |\n| `color`                                       | `Channel<TreemapNode<TDatum>, ChartKey?>`               | No group                | Node value sent to the color scale                    |\n| `fill`, `stroke`                              | `VisualChannel<TreemapNode<TDatum>, string>`            | Resolved color / none   | Per-node paint                                        |\n| `fillOpacity`, `strokeOpacity`, `strokeWidth` | `number`                                                | Renderer default        | Rectangle presentation                                |\n| `inset`, `radius`                             | `number`                                                | `0.75` / none           | Painted rectangle inset and corner radius             |\n| `label`                                       | `Channel<TreemapNode<TDatum>, string \\| number?>`       | None                    | Centered in-cell label                                |\n| `labelFill`                                   | `VisualChannel<TreemapNode<TDatum>, string>`            | Theme foreground        | Label paint                                           |\n| `labelFontSize`, `labelFontWeight`            | `number`                                                | `11` / renderer default | Label typography                                      |\n| `labelPadding`                                | `number`                                                | `4`                     | Minimum painted pixels around a label                 |\n| `states`                                      | `readonly ChartMarkState[]`                             | None                    | Focus-driven rectangle states                         |\n| `motion`                                      | `ChartMarkMotionOptions<TreemapNode<TDatum>>['motion']` | None                    | Per-node motion policy                                |\n\nNullish values contribute zero. Other values must be nonnegative and finite.\n`ratio` is valid only with `squarify`. Padding, inset, and label padding are\nnonnegative CSS-pixel values.\n\n`method` also accepts a native D3 tiler or a compatible callable:\n\n```ts\nimport { treemapBinary } from 'd3-hierarchy'\n\ntreemap(rows, {\n  path: 'name',\n  value: 'size',\n  method: treemapBinary,\n})\n```\n\nA callable receives a `HierarchyRectangularNode<TreemapTileDatum<TDatum>>`\nfrom the mark's private hierarchy copy plus the tile bounds. It must assign\nchild coordinates synchronously using the D3 tile contract. The datum wrapper\ncontains hierarchy identity, the nullable raw row, and its source index. Do\nnot retain or mutate the authored row. Configure callable-specific behavior in\nthe callable itself; `ratio` remains exclusive to the `squarify` shorthand.\n\n## Responsive layout\n\nTreemap row grouping depends on the final plot aspect ratio. The mark sizes the\nselected tiler to the resolved inner width and height on every layout pass;\nresizing may therefore change rectangle adjacency as well as dimensions.\nCoordinates use the screen convention where y increases downward and never\nenter a Cartesian scale.\n\nEach pass lays out a private hierarchy copy. Value and path accessors are not\nrerun, input rows are not mutated, and repeated compilation at one size is\ndeterministic. Stateful `resquarify` is intentionally not a method.\n\n## Nodes, labels, and interaction\n\nOnly positive-area leaves render. Every rectangle and interaction point carries\none `TreemapNode<TDatum>` with:\n\n- stable `id`, `parentId`, and root-to-parent `ancestorIds`;\n- `name`, `depth`, `height`, and `internal` / `external` metadata;\n- aggregate `value`;\n- the authored `data` row, or `null` for an imputed node; and\n- direct `source` and `sourceIndexes` lineage.\n\nColor, paint, state, and label channels receive these nodes. A label is emitted\nonly when its measured bounds plus `labelPadding` fit inside the painted cell.\nThis uses the chart host's text measurer when available and the deterministic\nscene estimator otherwise.\n\n## Types\n\nThe exact entry exports `treemap`, `TreemapMethod`, `TreemapTileDatum`,\n`TreemapTile`, `TreemapNode`, `TreemapNodeComparator`, `TreemapPathOptions`,\n`TreemapParentOptions`, and `TreemapOptions`.\n"}
