t","value":" is the union of:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SceneGroup"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SceneRule"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ScenePolyline"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SceneArea"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SceneDot"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SceneRect"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"SceneLabel"}]}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ScenePolygonRing"},{"type":"text","value":" is one closed boundary. "},{"type":"inlineCode","value":"ScenePolygon"},{"type":"text","value":" is an exterior ring\nfollowed by zero or more holes; "},{"type":"inlineCode","value":"SceneArea.polygons"},{"type":"text","value":" can contain several\ndisconnected polygons. "},{"type":"inlineCode","value":"SceneStyle"},{"type":"text","value":" is shared presentation. "},{"type":"inlineCode","value":"ChartSize"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"ChartBounds"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartMargin"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartLayoutOptions"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartTextTypography"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"ChartTextMeasurer"},{"type":"text","value":", "},{"type":"inlineCode","value":"ChartTextMeasureOptions"},{"type":"text","value":", and "},{"type":"inlineCode","value":"ChartTextMetrics"},{"type":"text","value":" describe\nscene and text geometry. Typography includes family, style, stretch, letter\nspacing, direction, locale, and host font scale."}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"./runtime-and-scene.md#scene-nodes","children":[{"type":"text","value":"Scene nodes"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"scale-guide-color-and-theme-types","children":[{"type":"text","value":"Scale, guide, color, and theme types"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartScales"}]},{"type":"tableCell","children":[{"type":"text","value":"Reserved x/y entries plus optional named positional scales"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartPositionScaleOptions"}]},{"type":"tableCell","children":[{"type":"text","value":"One registry entry, its Cartesian channel, side, and axis behavior"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartAxisOptions"}]},{"type":"tableCell","children":[{"type":"text","value":"Positional scale and optional axis behavior"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartPositionChannel"}]},{"type":"tableCell","children":[{"type":"text","value":"Cartesian registry channel, "},{"type":"inlineCode","value":"x"},{"type":"text","value":" or "},{"type":"inlineCode","value":"y"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"ChartAxisSide"}]},{"type":"tableCell","children":[{"type":"text","value":"Cartesian axis side"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"CartesianScaleBindings"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional mark bindings to named "},{"type":"inlineCode","value":"xScale"},{"type":"text","value":" and "},{"type":"inlineCode","value":"yScale"},{"type":"text","value":" entries"}]}],[{