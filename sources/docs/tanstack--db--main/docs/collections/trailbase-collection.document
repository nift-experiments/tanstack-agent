{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TrailBase collections provide seamless integration between TanStack DB and "},{"type":"link","href":"https://trailbase.io","children":[{"type":"text","value":"TrailBase"}]},{"type":"text","value":", enabling real-time data synchronization with TrailBase's self-hosted application backend."}]},{"type":"heading","depth":2,"id":"overview","children":[{"type":"text","value":"Overview"}]},{"type":"paragraph","children":[{"type":"link","href":"https://trailbase.io","children":[{"type":"text","value":"TrailBase"}]},{"type":"text","value":" is an easy-to-self-host, single-executable application backend with built-in SQLite, a V8 JS runtime, auth, admin UIs and sync functionality."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"@tanstack/trailbase-db-collection"},{"type":"text","value":" package allows you to create collections that:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Automatically sync data from TrailBase Record APIs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Support real-time subscriptions when "},{"type":"inlineCode","value":"enable_subscriptions"},{"type":"text","value":" is enabled"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Handle optimistic updates with automatic rollback on errors"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Provide parse/serialize functions for data transformation"}]}]}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"code","value":"npm install @tanstack/trailbase-db-collection @tanstack/react-db trailbase","lang":"bash"},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"code","value":"import { createCollection } from '@tanstack/react-db'\nimport { trailBaseCollectionOptions } from '@tanstack/trailbase-db-collection'\nimport { initClient } from 'trailbase'\n\nconst trailBaseClient = initClient(`https://your-trailbase-instance.com`)\n\nconst todosCollection = createCollection(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n  })\n)","lang":"typescript"},{"type":"heading","depth":2,"id":"configuration-options","children":[{"type":"text","value":"Configuration Options"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"trailBaseCollectionOptions"},{"type":"text","value":" function accepts the following options:"}]},{"type":"heading","depth":3,"id":"required-options","children":[{"type":"text","value":"Required Options"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"id"},{"type":"text","value":": Unique identifier for the collection"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"recordApi"},{"type":"text","value":": TrailBase Record API instance created via "},{"type":"inlineCode","value":"trailBaseClient.records()"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"getKey"},{"type":"text","value":": Function to extract the unique key from an item"}]}]}]},{"type":"heading","depth":3,"id":"optional-options","children":[{"type":"text","value":"Optional Options"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"schema"},{"type":"text","value":": "},{"type":"link","href":"https://standardschema.dev","children":[{"type":"text","value":"Standard Schema"}]},{"type":"text","value":" compatible schema (e.g., Zod, Effect) for client-side validation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"parse"},{"type":"text","value":": Object mapping field names to parsing functions that transform data coming from TrailBase"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"serialize"},{"type":"text","value":": Object mapping field names to serialization functions that transform data going to TrailBase"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onInsert"},{"type":"text","value":": Handler function called when items are inserted"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onUpdate"},{"type":"text","value":": Handler function called when items are updated"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onDelete"},{"type":"text","value":": Handler function called when items are deleted"}]}]}]},{"type":"heading","depth":2,"id":"data-transformation","children":[{"type":"text","value":"Data Transformation"}]},{"type":"paragraph","children":[{"type":"text","value":"TrailBase uses different data formats for storage (e.g., Unix timestamps). Use "},{"type":"inlineCode","value":"parse"},{"type":"text","value":" and "},{"type":"inlineCode","value":"serialize"},{"type":"text","value":" to handle these transformations:"}]},{"type":"code","value":"type SelectTodo = {\n  id: string\n  text: string\n  created_at: number // Unix timestamp from TrailBase\n  completed: boolean\n}\n\ntype Todo = {\n  id: string\n  text: string\n  created_at: Date // JavaScript Date for app usage\n  completed: boolean\n}\n\nconst todosCollection = createCollection<SelectTodo, Todo>(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    schema: todoSchema,\n    // Transform TrailBase data to application format\n    parse: {\n      created_at: (ts) => new Date(ts * 1000),\n    },\n    // Transform application data to TrailBase format\n    serialize: {\n      created_at: (date) => Math.floor(date.valueOf() / 1000),\n    },\n  })\n)","lang":"typescript"},{"type":"heading","depth":2,"id":"real-time-subscriptions","children":[{"type":"text","value":"Real-time Subscriptions"}]},{"type":"paragraph","children":[{"type":"text","value":"TrailBase supports real-time subscriptions when enabled on the server. The collection automatically subscribes to changes and updates in real-time:"}]},{"type":"code","value":"const todosCollection = createCollection(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    // Real-time updates work automatically when\n    // enable_subscriptions is set in TrailBase config\n  })\n)\n\n// Changes from other clients will automatically update\n// the collection in real-time","lang":"typescript"},{"type":"heading","depth":2,"id":"mutation-handlers","children":[{"type":"text","value":"Mutation Handlers"}]},{"type":"paragraph","children":[{"type":"text","value":"Handle inserts, updates, and deletes by providing mutation handlers:"}]},{"type":"code","value":"const todosCollection = createCollection(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      const newTodo = transaction.mutations[0].modified\n      // TrailBase handles the persistence automatically\n      // Add custom logic here if needed\n    },\n    onUpdate: async ({ transaction }) => {\n      const { original, modified } = transaction.mutations[0]\n      // TrailBase handles the persistence automatically\n      // Add custom logic here if needed\n    },\n    onDelete: async ({ transaction }) => {\n      const deletedTodo = transaction.mutations[0].original\n      // TrailBase handles the persistence automatically\n      // Add custom logic here if needed\n    },\n  })\n)","lang":"typescript"},{"type":"heading","depth":2,"id":"complete-example","children":[{"type":"text","value":"Complete Example"}]},{"type":"code","value":"import { createCollection } from '@tanstack/react-db'\nimport { not } from '@tanstack/db'\nimport { trailBaseCollectionOptions } from '@tanstack/trailbase-db-collection'\nimport { initClient } from 'trailbase'\nimport { z } from 'zod'\n\nconst trailBaseClient = initClient(`https://your-trailbase-instance.com`)\n\n// Define schema\nconst todoSchema = z.object({\n  id: z.string(),\n  text: z.string(),\n  completed: z.boolean(),\n  created_at: z.date(),\n})\n\ntype SelectTodo = {\n  id: string\n  text: string\n  completed: boolean\n  created_at: number\n}\n\ntype Todo = z.infer<typeof todoSchema>\n\n// Create collection\nexport const todosCollection = createCollection<SelectTodo, Todo>(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    schema: todoSchema,\n    parse: {\n      created_at: (ts) => new Date(ts * 1000),\n    },\n    serialize: {\n      created_at: (date) => Math.floor(date.valueOf() / 1000),\n    },\n    onInsert: async ({ transaction }) => {\n      const newTodo = transaction.mutations[0].modified\n      console.log('Todo created:', newTodo)\n    },\n  })\n)\n\n// Use in component\nfunction TodoList() {\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todo: todosCollection })\n        .where(({ todo }) => not(todo.completed))\n        .orderBy(({ todo }) => todo.created_at, 'desc'),\n  })\n\n  const addTodo = (text: string) => {\n    todosCollection.insert({\n      id: crypto.randomUUID(),\n      text,\n      completed: false,\n      created_at: new Date(),\n    })\n  }\n\n  return (\n    <div>\n      {todos.map((todo) => (\n        <div key={todo.id}>{todo.text}</div>\n      ))}\n    </div>\n  )\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"learn-more","children":[{"type":"text","value":"Learn More"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://trailbase.io/documentation/","children":[{"type":"text","value":"TrailBase Documentation"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://trailbase.io/documentation/apis_record/","children":[{"type":"text","value":"TrailBase Record APIs"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../guides/mutations.md","children":[{"type":"text","value":"Optimistic Mutations"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../guides/live-queries.md","children":[{"type":"text","value":"Live Queries"}]}]}]}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"installation","text":"Installation","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"configuration-options","text":"Configuration Options","level":2},{"id":"required-options","text":"Required Options","level":3},{"id":"optional-options","text":"Optional Options","level":3},{"id":"data-transformation","text":"Data Transformation","level":2},{"id":"real-time-subscriptions","text":"Real-time Subscriptions","level":2},{"id":"mutation-handlers","text":"Mutation Handlers","level":2},{"id":"complete-example","text":"Complete Example","level":2},{"id":"learn-more","text":"Learn More","level":2}]},"frameworks":[],"downloadMarkdown":"\nTrailBase collections provide seamless integration between TanStack DB and [TrailBase](https://trailbase.io), enabling real-time data synchronization with TrailBase's self-hosted application backend.\n\n## Overview\n\n[TrailBase](https://trailbase.io) is an easy-to-self-host, single-executable application backend with built-in SQLite, a V8 JS runtime, auth, admin UIs and sync functionality.\n\nThe `@tanstack/trailbase-db-collection` package allows you to create collections that:\n- Automatically sync data from TrailBase Record APIs\n- Support real-time subscriptions when `enable_subscriptions` is enabled\n- Handle optimistic updates with automatic rollback on errors\n- Provide parse/serialize functions for data transformation\n\n## Installation\n\n```bash\nnpm install @tanstack/trailbase-db-collection @tanstack/react-db trailbase\n```\n\n## Basic Usage\n\n```typescript\nimport { createCollection } from '@tanstack/react-db'\nimport { trailBaseCollectionOptions } from '@tanstack/trailbase-db-collection'\nimport { initClient } from 'trailbase'\n\nconst trailBaseClient = initClient(`https://your-trailbase-instance.com`)\n\nconst todosCollection = createCollection(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n  })\n)\n```\n\n## Configuration Options\n\nThe `trailBaseCollectionOptions` function accepts the following options:\n\n### Required Options\n\n- `id`: Unique identifier for the collection\n- `recordApi`: TrailBase Record API instance created via `trailBaseClient.records()`\n- `getKey`: Function to extract the unique key from an item\n\n### Optional Options\n\n- `schema`: [Standard Schema](https://standardschema.dev) compatible schema (e.g., Zod, Effect) for client-side validation\n- `parse`: Object mapping field names to parsing functions that transform data coming from TrailBase\n- `serialize`: Object mapping field names to serialization functions that transform data going to TrailBase\n- `onInsert`: Handler function called when items are inserted\n- `onUpdate`: Handler function called when items are updated\n- `onDelete`: Handler function called when items are deleted\n\n## Data Transformation\n\nTrailBase uses different data formats for storage (e.g., Unix timestamps). Use `parse` and `serialize` to handle these transformations:\n\n```typescript\ntype SelectTodo = {\n  id: string\n  text: string\n  created_at: number // Unix timestamp from TrailBase\n  completed: boolean\n}\n\ntype Todo = {\n  id: string\n  text: string\n  created_at: Date // JavaScript Date for app usage\n  completed: boolean\n}\n\nconst todosCollection = createCollection<SelectTodo, Todo>(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    schema: todoSchema,\n    // Transform TrailBase data to application format\n    parse: {\n      created_at: (ts) => new Date(ts * 1000),\n    },\n    // Transform application data to TrailBase format\n    serialize: {\n      created_at: (date) => Math.floor(date.valueOf() / 1000),\n    },\n  })\n)\n```\n\n## Real-time Subscriptions\n\nTrailBase supports real-time subscriptions when enabled on the server. The collection automatically subscribes to changes and updates in real-time:\n\n```typescript\nconst todosCollection = createCollection(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    // Real-time updates work automatically when\n    // enable_subscriptions is set in TrailBase config\n  })\n)\n\n// Changes from other clients will automatically update\n// the collection in real-time\n```\n\n## Mutation Handlers\n\nHandle inserts, updates, and deletes by providing mutation handlers:\n\n```typescript\nconst todosCollection = createCollection(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      const newTodo = transaction.mutations[0].modified\n      // TrailBase handles the persistence automatically\n      // Add custom logic here if needed\n    },\n    onUpdate: async ({ transaction }) => {\n      const { original, modified } = transaction.mutations[0]\n      // TrailBase handles the persistence automatically\n      // Add custom logic here if needed\n    },\n    onDelete: async ({ transaction }) => {\n      const deletedTodo = transaction.mutations[0].original\n      // TrailBase handles the persistence automatically\n      // Add custom logic here if needed\n    },\n  })\n)\n```\n\n## Complete Example\n\n```typescript\nimport { createCollection } from '@tanstack/react-db'\nimport { not } from '@tanstack/db'\nimport { trailBaseCollectionOptions } from '@tanstack/trailbase-db-collection'\nimport { initClient } from 'trailbase'\nimport { z } from 'zod'\n\nconst trailBaseClient = initClient(`https://your-trailbase-instance.com`)\n\n// Define schema\nconst todoSchema = z.object({\n  id: z.string(),\n  text: z.string(),\n  completed: z.boolean(),\n  created_at: z.date(),\n})\n\ntype SelectTodo = {\n  id: string\n  text: string\n  completed: boolean\n  created_at: number\n}\n\ntype Todo = z.infer<typeof todoSchema>\n\n// Create collection\nexport const todosCollection = createCollection<SelectTodo, Todo>(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    schema: todoSchema,\n    parse: {\n      created_at: (ts) => new Date(ts * 1000),\n    },\n    serialize: {\n      created_at: (date) => Math.floor(date.valueOf() / 1000),\n    },\n    onInsert: async ({ transaction }) => {\n      const newTodo = transaction.mutations[0].modified\n      console.log('Todo created:', newTodo)\n    },\n  })\n)\n\n// Use in component\nfunction TodoList() {\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todo: todosCollection })\n        .where(({ todo }) => not(todo.completed))\n        .orderBy(({ todo }) => todo.created_at, 'desc'),\n  })\n\n  const addTodo = (text: string) => {\n    todosCollection.insert({\n      id: crypto.randomUUID(),\n      text,\n      completed: false,\n      created_at: new Date(),\n    })\n  }\n\n  return (\n    <div>\n      {todos.map((todo) => (\n        <div key={todo.id}>{todo.text}</div>\n      ))}\n    </div>\n  )\n}\n```\n\n## Learn More\n\n- [TrailBase Documentation](https://trailbase.io/documentation/)\n- [TrailBase Record APIs](https://trailbase.io/documentation/apis_record/)\n- [Optimistic Mutations](../guides/mutations.md)\n- [Live Queries](../guides/live-queries.md)\n","originalRawMarkdown":"---\ntitle: TrailBase Collection\n---\n\nTrailBase collections provide seamless integration between TanStack DB and [TrailBase](https://trailbase.io), enabling real-time data synchronization with TrailBase's self-hosted application backend.\n\n## Overview\n\n[TrailBase](https://trailbase.io) is an easy-to-self-host, single-executable application backend with built-in SQLite, a V8 JS runtime, auth, admin UIs and sync functionality.\n\nThe `@tanstack/trailbase-db-collection` package allows you to create collections that:\n- Automatically sync data from TrailBase Record APIs\n- Support real-time subscriptions when `enable_subscriptions` is enabled\n- Handle optimistic updates with automatic rollback on errors\n- Provide parse/serialize functions for data transformation\n\n## Installation\n\n```bash\nnpm install @tanstack/trailbase-db-collection @tanstack/react-db trailbase\n```\n\n## Basic Usage\n\n```typescript\nimport { createCollection } from '@tanstack/react-db'\nimport { trailBaseCollectionOptions } from '@tanstack/trailbase-db-collection'\nimport { initClient } from 'trailbase'\n\nconst trailBaseClient = initClient(`https://your-trailbase-instance.com`)\n\nconst todosCollection = createCollection(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n  })\n)\n```\n\n## Configuration Options\n\nThe `trailBaseCollectionOptions` function accepts the following options:\n\n### Required Options\n\n- `id`: Unique identifier for the collection\n- `recordApi`: TrailBase Record API instance created via `trailBaseClient.records()`\n- `getKey`: Function to extract the unique key from an item\n\n### Optional Options\n\n- `schema`: [Standard Schema](https://standardschema.dev) compatible schema (e.g., Zod, Effect) for client-side validation\n- `parse`: Object mapping field names to parsing functions that transform data coming from TrailBase\n- `serialize`: Object mapping field names to serialization functions that transform data going to TrailBase\n- `onInsert`: Handler function called when items are inserted\n- `onUpdate`: Handler function called when items are updated\n- `onDelete`: Handler function called when items are deleted\n\n## Data Transformation\n\nTrailBase uses different data formats for storage (e.g., Unix timestamps). Use `parse` and `serialize` to handle these transformations:\n\n```typescript\ntype SelectTodo = {\n  id: string\n  text: string\n  created_at: number // Unix timestamp from TrailBase\n  completed: boolean\n}\n\ntype Todo = {\n  id: string\n  text: string\n  created_at: Date // JavaScript Date for app usage\n  completed: boolean\n}\n\nconst todosCollection = createCollection<SelectTodo, Todo>(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    schema: todoSchema,\n    // Transform TrailBase data to application format\n    parse: {\n      created_at: (ts) => new Date(ts * 1000),\n    },\n    // Transform application data to TrailBase format\n    serialize: {\n      created_at: (date) => Math.floor(date.valueOf() / 1000),\n    },\n  })\n)\n```\n\n## Real-time Subscriptions\n\nTrailBase supports real-time subscriptions when enabled on the server. The collection automatically subscribes to changes and updates in real-time:\n\n```typescript\nconst todosCollection = createCollection(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    // Real-time updates work automatically when\n    // enable_subscriptions is set in TrailBase config\n  })\n)\n\n// Changes from other clients will automatically update\n// the collection in real-time\n```\n\n## Mutation Handlers\n\nHandle inserts, updates, and deletes by providing mutation handlers:\n\n```typescript\nconst todosCollection = createCollection(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      const newTodo = transaction.mutations[0].modified\n      // TrailBase handles the persistence automatically\n      // Add custom logic here if needed\n    },\n    onUpdate: async ({ transaction }) => {\n      const { original, modified } = transaction.mutations[0]\n      // TrailBase handles the persistence automatically\n      // Add custom logic here if needed\n    },\n    onDelete: async ({ transaction }) => {\n      const deletedTodo = transaction.mutations[0].original\n      // TrailBase handles the persistence automatically\n      // Add custom logic here if needed\n    },\n  })\n)\n```\n\n## Complete Example\n\n```typescript\nimport { createCollection } from '@tanstack/react-db'\nimport { not } from '@tanstack/db'\nimport { trailBaseCollectionOptions } from '@tanstack/trailbase-db-collection'\nimport { initClient } from 'trailbase'\nimport { z } from 'zod'\n\nconst trailBaseClient = initClient(`https://your-trailbase-instance.com`)\n\n// Define schema\nconst todoSchema = z.object({\n  id: z.string(),\n  text: z.string(),\n  completed: z.boolean(),\n  created_at: z.date(),\n})\n\ntype SelectTodo = {\n  id: string\n  text: string\n  completed: boolean\n  created_at: number\n}\n\ntype Todo = z.infer<typeof todoSchema>\n\n// Create collection\nexport const todosCollection = createCollection<SelectTodo, Todo>(\n  trailBaseCollectionOptions({\n    id: 'todos',\n    recordApi: trailBaseClient.records('todos'),\n    getKey: (item) => item.id,\n    schema: todoSchema,\n    parse: {\n      created_at: (ts) => new Date(ts * 1000),\n    },\n    serialize: {\n      created_at: (date) => Math.floor(date.valueOf() / 1000),\n    },\n    onInsert: async ({ transaction }) => {\n      const newTodo = transaction.mutations[0].modified\n      console.log('Todo created:', newTodo)\n    },\n  })\n)\n\n// Use in component\nfunction TodoList() {\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todo: todosCollection })\n        .where(({ todo }) => not(todo.completed))\n        .orderBy(({ todo }) => todo.created_at, 'desc'),\n  })\n\n  const addTodo = (text: string) => {\n    todosCollection.insert({\n      id: crypto.randomUUID(),\n      text,\n      completed: false,\n      created_at: new Date(),\n    })\n  }\n\n  return (\n    <div>\n      {todos.map((todo) => (\n        <div key={todo.id}>{todo.text}</div>\n      ))}\n    </div>\n  )\n}\n```\n\n## Learn More\n\n- [TrailBase Documentation](https://trailbase.io/documentation/)\n- [TrailBase Record APIs](https://trailbase.io/documentation/apis_record/)\n- [Optimistic Mutations](../guides/mutations.md)\n- [Live Queries](../guides/live-queries.md)\n"}
