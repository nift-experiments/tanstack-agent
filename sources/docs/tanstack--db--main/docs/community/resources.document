","value":"PGLite"}]},{"type":"text","value":" adapter for TanStack DB"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use PostgreSQL-compatible databases in the browser via WebAssembly"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Install: "},{"type":"inlineCode","value":"npm install tanstack-db-pglite"}]}]}]}]}]},{"type":"heading","depth":3,"id":"contributing-your-package","children":[{"type":"text","value":"Contributing Your Package"}]},{"type":"paragraph","children":[{"type":"text","value":"Have you created a collection adapter or integration? We'd love to feature it here! "},{"type":"link","href":"https://github.com/TanStack/db/pulls","children":[{"type":"text","value":"Submit a PR"}]},{"type":"text","value":" to add your package."}]},{"type":"heading","depth":2,"id":"examples-templates","children":[{"type":"text","value":"Examples & Templates"}]},{"type":"heading","depth":3,"id":"starter-templates","children":[{"type":"text","value":"Starter Templates"}]},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"Share your starter templates and boilerplates here"}]}]},{"type":"heading","depth":3,"id":"example-applications","children":[{"type":"text","value":"Example Applications"}]},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"Community-built example apps showcasing TanStack DB features"}]}]},{"type":"heading","depth":2,"id":"learning-resources","children":[{"type":"text","value":"Learning Resources"}]},{"type":"heading","depth":3,"id":"tutorials-guides","children":[{"type":"text","value":"Tutorials & Guides"}]},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"Community tutorials and blog posts about TanStack DB"}]}]},{"type":"heading","depth":3,"id":"videos-courses","children":[{"type":"text","value":"Videos & Courses"}]},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"Video tutorials and online courses"}]}]},{"type":"heading","depth":2,"id":"contributing","children":[{"type":"text","value":"Contributing"}]},{"type":"paragraph","children":[{"type":"text","value":"We welcome contributions to this community resources page! If you've created something useful for the TanStack DB ecosystem:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Fork the repository"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add your resource to the appropriate section"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Include a brief description and link"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Submit a pull request"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Please ensure all submissions are relevant to TanStack DB and provide value to the community."}]}],"headings":[{"id":"community-packages","text":"Community Packages","level":2},{"id":"dexie-js-integration-unofficial","text":"Dexie.js Integration (Unofficial)","level":3},{"id":"pglite-integration-unofficial","text":"PGLite Integration (Unofficial)","level":3},{"id":"contributing-your-package","text":"Contributing Your Package","level":3},{"id":"examples-templates","text":"Examples & Templates","level":2},{"id":"starter-templates","text":"Starter Templates","level":3},{"id":"example-applications","text":"Example Applications","level":3},{"id":"learning-resources","text":"Learning Resources","level":2},{"id":"tutorials-guides","text":"Tutorials & Guides","level":3},{"id":"videos-courses","text":"Videos & Courses","level":3},{"id":"contributing","text":"Contributing","level":2}]},"frameworks":[],"downloadMarkdown":"\nThis page contains a curated list of community-created packages, tools, and resources that extend or complement TanStack DB.\n\n## Community Packages\n\n### Dexie.js Integration (Unofficial)\n- **[tanstack-dexie-db-collection](https://github.com/HimanshuKumarDutt094/tanstack-dexie-db-collection)** - Community-maintained Dexie.js adapter for TanStack DB\n  - Local persistence using [Dexie.js](https://dexie.org) (IndexedDB wrapper)\n  - Lightweight integration for browser-based storage\n  - Install: `npm install tanstack-dexie-db-collection`\n\n### PGLite Integration (Unofficial)\n- **[tanstack-db-pglite](https://github.com/letstri/tanstack-db-pglite)** - Community-maintained [PGLite](https://pglite.dev/) adapter for TanStack DB\n  - Use PostgreSQL-compatible databases in the browser via WebAssembly\n  - Install: `npm install tanstack-db-pglite`\n\n### Contributing Your Package\n\nHave you created a collection adapter or integration? We'd love to feature it here! [Submit a PR](https://github.com/TanStack/db/pulls) to add your package.\n\n## Examples & Templates\n\n### Starter Templates\n*Share your starter templates and boilerplates here*\n\n### Example Applications\n*Community-built example apps showcasing TanStack DB features*\n\n## Learning Resources\n\n### Tutorials & Guides\n*Community tutorials and blog posts about TanStack DB*\n\n### Videos & Courses\n*Video tutorials and online courses*\n\n## Contributing\n\nWe welcome contributions to this community resources page! If you've created something useful for the TanStack DB ecosystem:\n\n1. Fork the repository\n2. Add your resource to the appropriate section\n3. Include a brief description and link\n4. Submit a pull request\n\nPlease ensure all submissions are relevant to TanStack DB and provide value to the community.\n","originalRawMarkdown":"---\ntitle: Community Resources\nid: community-resources\n---\n\nThis page contains a curated list of community-created packages, tools, and resources that extend or complement TanStack DB.\n\n## Community Packages\n\n### Dexie.js Integration (Unofficial)\n- **[tanstack-dexie-db-collection](https://github.com/HimanshuKumarDutt094/tanstack-dexie-db-collection)** - Community-maintained Dexie.js adapter for TanStack DB\n  - Local persistence using [Dexie.js](https://dexie.org) (IndexedDB wrapper)\n  - Lightweight integration for browser-based storage\n  - Install: `npm install tanstack-dexie-db-collection`\n\n### PGLite Integration (Unofficial)\n- **[tanstack-db-pglite](https://github.com/letstri/tanstack-db-pglite)** - Community-maintained [PGLite](https://pglite.dev/) adapter for TanStack DB\n  - Use PostgreSQL-compatible databases in the browser via WebAssembly\n  - Install: `npm install tanstack-db-pglite`\n\n### Contributing Your Package\n\nHave you created a collection adapter or integration? We'd love to feature it here! [Submit a PR](https://github.com/TanStack/db/pulls) to add your package.\n\n## Examples & Templates\n\n### Starter Templates\n*Share your starter templates and boilerplates here*\n\n### Example Applications\n*Community-built example apps showcasing TanStack DB features*\n\n## Learning Resources\n\n### Tutorials & Guides\n*Community tutorials and blog posts about TanStack DB*\n\n### Videos & Courses\n*Video tutorials and online courses*\n\n## Contributing\n\nWe welcome contributions to this community resources page! If you've created something useful for the TanStack DB ecosystem:\n\n1. Fork the repository\n2. Add your resource to the appropriate section\n3. Include a brief description and link\n4. Submit a pull request\n\nPlease ensure all submissions are relevant to TanStack DB and provide value to the community.\n"}
