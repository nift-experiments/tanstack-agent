ach field with draft equality. A wrong edge can\nmake the array mark itself reverted early, but the row then compares the field\nby value and still reports the change. The refactor's native iterator records\nthe right edge through the "},{"type":"inlineCode","value":"get"},{"type":"text","value":" trap."}]},{"type":"heading","depth":3,"id":"on-the-refactor-6b68b8dc3","children":[{"type":"text","value":"On the refactor ("},{"type":"inlineCode","value":"6b68b8dc3"},{"type":"text","value":")"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Mutant"}]},{"type":"tableCell","children":[{"type":"text","value":"Owners"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"N1: a nested revert does not reach the parent"}]},{"type":"tableCell","children":[{"type":"text","value":"assertion failure (25/441)"}]}],[{"type":"tableCell","children":[{"type":"text","value":"N2: a partial revert in the "},{"type":"inlineCode","value":"set"},{"type":"text","value":" trap clears all tracking"}]},{"type":"tableCell","children":[{"type":"text","value":"assertion failure (26/441)"}]}],[{"type":"tableCell","children":[{"type":"text","value":"N3: the array iterator binds the raw copy"}]},{"type":"tableCell","children":[{"type":"text","value":"assertion failure (4/441)"}]}],[{"type":"tableCell","children":[{"type":"text","value":"N4: "},{"type":"inlineCode","value":"deepClone"},{"type":"text","value":" drops non-enumerable symbols"}]},{"type":"tableCell","children":[{"type":"text","value":"assertion failure (2/441)"}]}],[{"type":"tableCell","children":[{"type":"text","value":"N4b: "},{"type":"inlineCode","value":"deepClone"},{"type":"text","value":" drops every symbol"}]},{"type":"tableCell","children":[{"type":"text","value":"assertion failure (4/441)"}]}],[{"type":"tableCell","children":[{"type":"text","value":"N5: "},{"type":"inlineCode","value":"deepClone"},{"type":"text","value":" copies non-enumerable strings"}]},{"ty