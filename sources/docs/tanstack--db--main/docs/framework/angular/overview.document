{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"code","value":"npm install @tanstack/angular-db","lang":"sh"},{"type":"heading","depth":2,"id":"angular-inject-function","children":[{"type":"text","value":"Angular inject function"}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./reference/index.md","children":[{"type":"text","value":"Angular Functions Reference"}]},{"type":"text","value":" to see the full list of functions available in the Angular Adapter."}]},{"type":"paragraph","children":[{"type":"text","value":"For comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the "},{"type":"link","href":"../../guides/live-queries","children":[{"type":"text","value":"Live Queries Guide"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"heading","depth":3,"id":"injectlivequery","children":[{"type":"text","value":"injectLiveQuery"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"injectLiveQuery"},{"type":"text","value":" function creates a live query that automatically updates your component when data changes. It returns an object containing Angular signals for reactive state management:"}]},{"type":"code","value":"import { Component } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todo-list',\n  standalone: true,\n  template: `\n    @if (query.isLoading()) {\n      <div>Loading...</div>\n    } @else {\n      <ul>\n        @for (todo of query.data(); track todo.id) {\n          <li>{{ todo.text }}</li>\n        }\n      </ul>\n    }\n  `\n})\nexport class TodoListComponent {\n  query = injectLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.completed, false))\n     .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  )\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" All return values ("},{"type":"inlineCode","value":"data"},{"type":"text","value":", "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", "},{"type":"inlineCode","value":"status"},{"type":"text","value":", etc.) are Angular signals, so call them with "},{"type":"inlineCode","value":"()"},{"type":"text","value":" in your template: "},{"type":"inlineCode","value":"query.data()"},{"type":"text","value":", "},{"type":"inlineCode","value":"query.isLoading()"},{"type":"text","value":"."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Template Syntax:"}]},{"type":"text","value":" Examples use Angular 17+ control flow ("},{"type":"inlineCode","value":"@if"},{"type":"text","value":", "},{"type":"inlineCode","value":"@for"},{"type":"text","value":"). For Angular 16, use "},{"type":"inlineCode","value":"*ngIf"},{"type":"text","value":" and "},{"type":"inlineCode","value":"*ngFor"},{"type":"text","value":" instead."}]}]},{"type":"heading","depth":3,"id":"reactive-parameters","children":[{"type":"text","value":"Reactive Parameters"}]},{"type":"paragraph","children":[{"type":"text","value":"For queries that depend on reactive values, use the "},{"type":"inlineCode","value":"params"},{"type":"text","value":" option to re-run the query when those values change:"}]},{"type":"code","value":"import { Component, signal } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { gt } from '@tanstack/db'\n\n@Component({\n  selector: 'app-filtered-todos',\n  standalone: true,\n  template: `\n    <div>{{ query.data().length }} high-priority todos</div>\n  `\n})\nexport class FilteredTodosComponent {\n  minPriority = signal(5)\n\n  query = injectLiveQuery({\n    params: () => ({ minPriority: this.minPriority() }),\n    query: ({ params, q }) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => gt(todos.priority, params.minPriority))\n  })\n}","lang":"typescript"},{"type":"heading","depth":4,"id":"when-to-use-reactive-parameters","children":[{"type":"text","value":"When to Use Reactive Parameters"}]},{"type":"paragraph","children":[{"type":"text","value":"Use the reactive "},{"type":"inlineCode","value":"params"},{"type":"text","value":" option when your query depends on:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Component signals"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Input properties"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Computed values"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Other reactive state"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"When any reactive value accessed in the "},{"type":"inlineCode","value":"params"},{"type":"text","value":" function changes, the query is recreated and re-executed."}]},{"type":"heading","depth":4,"id":"what-happens-when-parameters-change","children":[{"type":"text","value":"What Happens When Parameters Change"}]},{"type":"paragraph","children":[{"type":"text","value":"When a parameter value changes:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The previous live-query collection is disposed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A new query is created with the updated parameter values"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status()"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isLoading()"},{"type":"text","value":" reflect the new query's lifecycle"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"data()"},{"type":"text","value":" updates automatically when the new results arrive"}]}]}]},{"type":"heading","depth":4,"id":"best-practices","children":[{"type":"text","value":"Best Practices"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Use reactive params for dynamic queries:"}]}]},{"type":"code","value":"import { Component, Input, signal } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq, and } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todo-list',\n  standalone: true,\n  template: `<div>{{ query.data().length }} todos</div>`\n})\nexport class TodoListComponent {\n  // Angular 16+ compatible input\n  @Input({ required: true }) userId!: number\n  status = signal('active')\n\n  // Good - reactive params track all dependencies\n  query = injectLiveQuery({\n    params: () => ({\n      userId: this.userId,\n      status: this.status()\n    }),\n    query: ({ params, q }) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => and(\n         eq(todos.userId, params.userId),\n         eq(todos.status, params.status)\n       ))\n  })\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Using Angular 17+ signal inputs:"}]}]},{"type":"code","value":"import { Component, input, signal } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq, and } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todo-list',\n  standalone: true,\n  template: `<div>{{ query.data().length }} todos</div>`\n})\nexport class TodoListComponent {\n  // Angular 17+ signal-based input\n  userId = input.required<number>()\n  status = signal('active')\n\n  query = injectLiveQuery({\n    params: () => ({\n      userId: this.userId(),\n      status: this.status()\n    }),\n    query: ({ params, q }) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => and(\n         eq(todos.userId, params.userId),\n         eq(todos.status, params.status)\n       ))\n  })\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Static queries don't need params:"}]}]},{"type":"code","value":"import { Component } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\n\n@Component({\n  selector: 'app-all-todos',\n  standalone: true,\n  template: `<div>{{ query.data().length }} todos</div>`\n})\nexport class AllTodosComponent {\n  // No reactive dependencies - query never changes\n  query = injectLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n  )\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Access multiple signals in template:"}]}]},{"type":"code","value":"import { Component } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todos',\n  standalone: true,\n  template: `\n    <div>Status: {{ query.status() }}</div>\n    <div>Loading: {{ query.isLoading() }}</div>\n    <div>Ready: {{ query.isReady() }}</div>\n    <div>Total: {{ query.data().length }}</div>\n  `\n})\nexport class TodosComponent {\n  query = injectLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.completed, false))\n  )\n}","lang":"typescript"}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"angular-inject-function","text":"Angular inject function","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"injectlivequery","text":"injectLiveQuery","level":3},{"id":"reactive-parameters","text":"Reactive Parameters","level":3},{"id":"when-to-use-reactive-parameters","text":"When to Use Reactive Parameters","level":4},{"id":"what-happens-when-parameters-change","text":"What Happens When Parameters Change","level":4},{"id":"best-practices","text":"Best Practices","level":4}]},"frameworks":[],"downloadMarkdown":"\n## Installation\n\n```sh\nnpm install @tanstack/angular-db\n```\n\n## Angular inject function\n\nSee the [Angular Functions Reference](./reference/index.md) to see the full list of functions available in the Angular Adapter.\n\nFor comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the [Live Queries Guide](../../guides/live-queries).\n\n## Basic Usage\n\n### injectLiveQuery\n\nThe `injectLiveQuery` function creates a live query that automatically updates your component when data changes. It returns an object containing Angular signals for reactive state management:\n\n```typescript\nimport { Component } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todo-list',\n  standalone: true,\n  template: `\n    @if (query.isLoading()) {\n      <div>Loading...</div>\n    } @else {\n      <ul>\n        @for (todo of query.data(); track todo.id) {\n          <li>{{ todo.text }}</li>\n        }\n      </ul>\n    }\n  `\n})\nexport class TodoListComponent {\n  query = injectLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.completed, false))\n     .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  )\n}\n```\n\n**Note:** All return values (`data`, `isLoading`, `status`, etc.) are Angular signals, so call them with `()` in your template: `query.data()`, `query.isLoading()`.\n\n> **Template Syntax:** Examples use Angular 17+ control flow (`@if`, `@for`). For Angular 16, use `*ngIf` and `*ngFor` instead.\n\n### Reactive Parameters\n\nFor queries that depend on reactive values, use the `params` option to re-run the query when those values change:\n\n```typescript\nimport { Component, signal } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { gt } from '@tanstack/db'\n\n@Component({\n  selector: 'app-filtered-todos',\n  standalone: true,\n  template: `\n    <div>{{ query.data().length }} high-priority todos</div>\n  `\n})\nexport class FilteredTodosComponent {\n  minPriority = signal(5)\n\n  query = injectLiveQuery({\n    params: () => ({ minPriority: this.minPriority() }),\n    query: ({ params, q }) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => gt(todos.priority, params.minPriority))\n  })\n}\n```\n\n#### When to Use Reactive Parameters\n\nUse the reactive `params` option when your query depends on:\n- Component signals\n- Input properties\n- Computed values\n- Other reactive state\n\nWhen any reactive value accessed in the `params` function changes, the query is recreated and re-executed.\n\n#### What Happens When Parameters Change\n\nWhen a parameter value changes:\n1. The previous live-query collection is disposed\n2. A new query is created with the updated parameter values\n3. `status()`/`isLoading()` reflect the new query's lifecycle\n4. `data()` updates automatically when the new results arrive\n\n#### Best Practices\n\n**Use reactive params for dynamic queries:**\n\n```typescript\nimport { Component, Input, signal } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq, and } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todo-list',\n  standalone: true,\n  template: `<div>{{ query.data().length }} todos</div>`\n})\nexport class TodoListComponent {\n  // Angular 16+ compatible input\n  @Input({ required: true }) userId!: number\n  status = signal('active')\n\n  // Good - reactive params track all dependencies\n  query = injectLiveQuery({\n    params: () => ({\n      userId: this.userId,\n      status: this.status()\n    }),\n    query: ({ params, q }) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => and(\n         eq(todos.userId, params.userId),\n         eq(todos.status, params.status)\n       ))\n  })\n}\n```\n\n**Using Angular 17+ signal inputs:**\n\n```typescript\nimport { Component, input, signal } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq, and } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todo-list',\n  standalone: true,\n  template: `<div>{{ query.data().length }} todos</div>`\n})\nexport class TodoListComponent {\n  // Angular 17+ signal-based input\n  userId = input.required<number>()\n  status = signal('active')\n\n  query = injectLiveQuery({\n    params: () => ({\n      userId: this.userId(),\n      status: this.status()\n    }),\n    query: ({ params, q }) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => and(\n         eq(todos.userId, params.userId),\n         eq(todos.status, params.status)\n       ))\n  })\n}\n```\n\n**Static queries don't need params:**\n\n```typescript\nimport { Component } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\n\n@Component({\n  selector: 'app-all-todos',\n  standalone: true,\n  template: `<div>{{ query.data().length }} todos</div>`\n})\nexport class AllTodosComponent {\n  // No reactive dependencies - query never changes\n  query = injectLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n  )\n}\n```\n\n**Access multiple signals in template:**\n\n```typescript\nimport { Component } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todos',\n  standalone: true,\n  template: `\n    <div>Status: {{ query.status() }}</div>\n    <div>Loading: {{ query.isLoading() }}</div>\n    <div>Ready: {{ query.isReady() }}</div>\n    <div>Total: {{ query.data().length }}</div>\n  `\n})\nexport class TodosComponent {\n  query = injectLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.completed, false))\n  )\n}\n```\n","originalRawMarkdown":"---\ntitle: TanStack DB Angular Adapter\nid: adapter\n---\n\n## Installation\n\n```sh\nnpm install @tanstack/angular-db\n```\n\n## Angular inject function\n\nSee the [Angular Functions Reference](./reference/index.md) to see the full list of functions available in the Angular Adapter.\n\nFor comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the [Live Queries Guide](../../guides/live-queries).\n\n## Basic Usage\n\n### injectLiveQuery\n\nThe `injectLiveQuery` function creates a live query that automatically updates your component when data changes. It returns an object containing Angular signals for reactive state management:\n\n```typescript\nimport { Component } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todo-list',\n  standalone: true,\n  template: `\n    @if (query.isLoading()) {\n      <div>Loading...</div>\n    } @else {\n      <ul>\n        @for (todo of query.data(); track todo.id) {\n          <li>{{ todo.text }}</li>\n        }\n      </ul>\n    }\n  `\n})\nexport class TodoListComponent {\n  query = injectLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.completed, false))\n     .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  )\n}\n```\n\n**Note:** All return values (`data`, `isLoading`, `status`, etc.) are Angular signals, so call them with `()` in your template: `query.data()`, `query.isLoading()`.\n\n> **Template Syntax:** Examples use Angular 17+ control flow (`@if`, `@for`). For Angular 16, use `*ngIf` and `*ngFor` instead.\n\n### Reactive Parameters\n\nFor queries that depend on reactive values, use the `params` option to re-run the query when those values change:\n\n```typescript\nimport { Component, signal } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { gt } from '@tanstack/db'\n\n@Component({\n  selector: 'app-filtered-todos',\n  standalone: true,\n  template: `\n    <div>{{ query.data().length }} high-priority todos</div>\n  `\n})\nexport class FilteredTodosComponent {\n  minPriority = signal(5)\n\n  query = injectLiveQuery({\n    params: () => ({ minPriority: this.minPriority() }),\n    query: ({ params, q }) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => gt(todos.priority, params.minPriority))\n  })\n}\n```\n\n#### When to Use Reactive Parameters\n\nUse the reactive `params` option when your query depends on:\n- Component signals\n- Input properties\n- Computed values\n- Other reactive state\n\nWhen any reactive value accessed in the `params` function changes, the query is recreated and re-executed.\n\n#### What Happens When Parameters Change\n\nWhen a parameter value changes:\n1. The previous live-query collection is disposed\n2. A new query is created with the updated parameter values\n3. `status()`/`isLoading()` reflect the new query's lifecycle\n4. `data()` updates automatically when the new results arrive\n\n#### Best Practices\n\n**Use reactive params for dynamic queries:**\n\n```typescript\nimport { Component, Input, signal } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq, and } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todo-list',\n  standalone: true,\n  template: `<div>{{ query.data().length }} todos</div>`\n})\nexport class TodoListComponent {\n  // Angular 16+ compatible input\n  @Input({ required: true }) userId!: number\n  status = signal('active')\n\n  // Good - reactive params track all dependencies\n  query = injectLiveQuery({\n    params: () => ({\n      userId: this.userId,\n      status: this.status()\n    }),\n    query: ({ params, q }) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => and(\n         eq(todos.userId, params.userId),\n         eq(todos.status, params.status)\n       ))\n  })\n}\n```\n\n**Using Angular 17+ signal inputs:**\n\n```typescript\nimport { Component, input, signal } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq, and } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todo-list',\n  standalone: true,\n  template: `<div>{{ query.data().length }} todos</div>`\n})\nexport class TodoListComponent {\n  // Angular 17+ signal-based input\n  userId = input.required<number>()\n  status = signal('active')\n\n  query = injectLiveQuery({\n    params: () => ({\n      userId: this.userId(),\n      status: this.status()\n    }),\n    query: ({ params, q }) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => and(\n         eq(todos.userId, params.userId),\n         eq(todos.status, params.status)\n       ))\n  })\n}\n```\n\n**Static queries don't need params:**\n\n```typescript\nimport { Component } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\n\n@Component({\n  selector: 'app-all-todos',\n  standalone: true,\n  template: `<div>{{ query.data().length }} todos</div>`\n})\nexport class AllTodosComponent {\n  // No reactive dependencies - query never changes\n  query = injectLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n  )\n}\n```\n\n**Access multiple signals in template:**\n\n```typescript\nimport { Component } from '@angular/core'\nimport { injectLiveQuery } from '@tanstack/angular-db'\nimport { eq } from '@tanstack/db'\n\n@Component({\n  selector: 'app-todos',\n  standalone: true,\n  template: `\n    <div>Status: {{ query.status() }}</div>\n    <div>Loading: {{ query.isLoading() }}</div>\n    <div>Ready: {{ query.isReady() }}</div>\n    <div>Total: {{ query.data().length }}</div>\n  `\n})\nexport class TodosComponent {\n  query = injectLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.completed, false))\n  )\n}\n```\n"}
