}) => ({ id: todos.id, text: todos.text })),\n  })\n\n  if (isLoading) return <div>Loading...</div>\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"query-identity","children":[{"type":"text","value":"Query Identity"}]},{"type":"paragraph","children":[{"type":"text","value":"React live query hooks derive the live query identity from structured query IR by default. The hook runs the query builder, normalizes the resulting IR, and uses that as the identity. When the derived identity changes, the old live query collection is cleaned up and a new one is created."}]},{"type":"paragraph","children":[{"type":"text","value":"That means normal structured queries do not need a separate "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":". Collection descriptors provide stable collection IDs, and captured values inside structured expressions become part of the derived identity:"}]},{"type":"code","value":"function FilteredTodos({ minPriority }: { minPriority: number }) {\n  const { data } = useLiveQuery({\n    query: (q) => q.from({ todos: todoCollection })\n           .where(({ todos }) => gt(todos.priority, minPriority)),\n  })\n\n  return <div>{data.length} high-priority todos</div>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"For derived-identity queries in one mounted hook and "},{"type":"inlineCode","value":"DbClient"},{"type":"text","value":" scope, a source\nCollection ID must keep referring to the same Collection object. If a render\nsupplies a different source object with a previously used ID, the hook throws\ninstead of returning rows from the old source. To reuse an ID within that hook,\nunmount it, clean up its source and client scope, then mount the replacement.\nSeparate hooks and independent client scopes can use the same ID."}]},{"type":"heading","depth":4,"id":"collection-hooks","children":[{"type":"text","value":"Collection Hooks"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":" resolves collection descriptors from "},{"type":"inlineCode","value":"DbProvider"},{"type":"text","value":" automatically. Create small collection hooks when components need imperative collection methods like "},{"type":"inlineCode","value":"insert"},{"type":"text","value":", "},{"type":"inlineCode","value":"update"},{"type":"text","value":", "},{"type":"inlineCode","value":"delete"},{"type":"text","value":", or "},{"type":"inlineCode","value":"preload"},{"type":"text","value":":"}]},{"type":"code","value":"function useTodoCollection() {\n  return useDbClient().collection(todoCollection)\n}","lang":"tsx"},{"type":"heading","depth":4,"id":"when-to-use-query-keys","children":[{"type":"text","value":"When to Use Query Keys"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" only when DB cannot derive identity from structured IR, or when you intentionally want to avoid deriving identity on a hot render path. The common case is a functional query variant such as "},{"type":"inlineCode","value":".fn.where"},{"type":"text","value":", "},{"type":"inlineCode","value":".fn.select"},{"type":"text","value":", or "},{"type":"inlineCode","value":".fn.having"},{"type":"text","value":":"}]},{"type":"code","value":"function SearchTodos({ search }: { search: string }) {\n  const { data } = useLiveQuery({\n    queryKey: [todoCollection.id, 'search', search],\n    query: (q) => q.from({ todos: todoCollection })\n           .fn.where(({ todos }) =>\n             todos.text.toLowerCase().includes(search.toLowerCase())\n           ),\n  })\n\n  return <div>{data.length} matching todos</div>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"An explicit "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" is the caller's identity contract. If its source object\nchanges, change the key too, even when the source ID stays the same. Use a\nprimitive scope token in the key; Collection objects cannot be hashed there."}]},{"type":"paragraph","children":[{"type":"text","value":"Before 1.0, an unhashable query warns in development and keeps its legacy\nmount-stable identity. The query still runs, but captured values inside opaque\nlogic only become reactive when they are represented in "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":". In 1.0, an\nunhashable query without "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" will throw. If deriving identity becomes\nexpensive across renders, the hook warns once and suggests adding a "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":"\nas a performance escape hatch."}]},{"type":"heading","depth":4,"id":"what-happens-when-identity-changes","children":[{"type":"text","value":"What Happens When Identity Changes"}]},{"type":"paragraph","children":[{"type":"text","value":"When the derived identity or explicit query key changes:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The previous live query collection is cleaned up"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A new query is created with the updated values"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The component re-renders with the new data"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The hook suspends (for "},{"type":"inlineCode","value":"useLiveSuspenseQuery"},{"type":"text","value":") or shows loading state"}]}]}]},{"type":"heading","depth":4,"id":"best-practices","children":[{"type":"text","value":"Best Practices"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Use structured expressions when possible:"}]}]},{"type":"code","value":"// Good - DB can derive identity from this structured IR\nconst { data } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection })\n         .where(({ todos }) => and(\n           eq(todos.userId, userId),\n           eq(todos.status, status)\n         )),\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Add a query key for opaque runtime logic:"}]}]},{"type":"code","value":"const { data } = useLiveQuery({\n  queryKey: [todoCollection.id, 'by-user-fn', userId],\n  query: (q) => q.from({ todos: todoCollection })\n         .fn.where(({ todos }) => todos.userId === userId),\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Omit query keys for static structured queries:"}]}]},{"type":"code","value":"const { data } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection }),\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Dependency arrays are still accepted for backwards compatibility, but they warn in development and will be removed in 1.0."}]},{"type":"paragraph","children":[{"type":"text","value":"For SSR setup, collection hydration, and migration details, see the "},{"type":"link","href":"../../guides/ssr.md","children":[{"type":"text","value":"SSR and Hydration guide"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"useliveinfinitequery","children":[{"type":"text","value":"useLiveInfiniteQuery"}]},{"type":"paragraph","children":[{"type":"text","value":"For paginated data with live updates, use "},{"type":"inlineCode","value":"useLiveInfiniteQuery"},{"type":"text","value":":"}]},{"type":"code","value":"const { data, pages, fetchNextPage, hasNextPage } = useLiveInfiniteQuery(\n  (q) => q\n    .from({ posts: postsCollection })\n    .where(({ posts }) => eq(posts.category, category))\n    .orderBy(({ posts }) => posts.createdAt, 'desc'),\n  {\n    pageSize: 20,\n  }\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"fetchNextPage()"},{"type":"text","value":" returns a promise that resolves after the page request settles. Failures are exposed through the returned "},{"type":"inlineCode","value":"error"},{"type":"text","value":" value and do not reject the promise."}]},{"type":"paragraph","children":[{"type":"text","value":"This hook widens an ordered live query; it is not TanStack Query's\n"},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":". "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":" was previously ignored and is now rejected.\n"},{"type":"inlineCode","value":"initialPageParam"},{"type":"text","value":" only labels the returned pages; it does not set a server cursor\nor skip remote rows. For server pagination, use an on-demand Query Collection\nwhose "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" fulfills "},{"type":"inlineCode","value":"meta.loadSubsetOptions"},{"type":"text","value":". See the\n"},{"type":"link","href":"../../collections/query-collection.md#server-pagination-with-live-queries","children":[{"type":"text","value":"server pagination guide"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The deprecated dependency array is only available when using the query function variant, not when passing a pre-created collection."}]},{"type":"heading","depth":3,"id":"uselivesuspensequery","children":[{"type":"text","value":"useLiveSuspenseQuery"}]},{"type":"paragraph","children":[{"type":"text","value":"For React Suspense integration, use "},{"type":"inlineCode","value":"useLiveSuspenseQuery"},{"type":"text","value":":"}]},{"type":"code","value":"function TodoList({ filter }: { filter: string }) {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) => q.from({ todos: todoCollection })\n           .where(({ todos }) => eq(todos.filter, filter)),\n  })\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList filter=\"active\" />\n    </Suspense>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"When the derived identity or explicit "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" changes, "},{"type":"inlineCode","value":"useLiveSuspenseQuery"},{"type":"text","value":" will re-suspend, showing your Suspense fallback until the new data is ready."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"react-hooks","text":"React Hooks","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"uselivequery","text":"useLiveQuery","level":3},{"id":"query-identity","text":"Query Identity","level":3},{"id":"collection-hooks","text":"Collection Hooks","level":4},{"id":"when-to-use-query-keys","text":"When to Use Query Keys","level":4},{"id":"what-happens-when-identity-changes","text":"What Happens When Identity Changes","level":4},{"id":"best-practices","text":"Best Practices","level":4},{"id":"useliveinfinitequery","text":"useLiveInfiniteQuery","level":3},{"id":"uselivesuspensequery","text":"useLiveSuspenseQuery","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Installation\n\n```sh\nnpm install @tanstack/react-db\n```\n\n## React Hooks\n\nSee the [React Functions Reference](./reference/index.md) to see the full list of hooks available in the React Adapter.\n\nFor comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the [Live Queries Guide](../../guides/live-queries).\n\n## Basic Usage\n\nCreate a `DbClient` and provide it to your React tree:\n\n```tsx\nimport { DbClient, DbProvider } from '@tanstack/react-db'\n\nconst dbClient = new DbClient()\n\nroot.render(\n  <DbProvider client={dbClient}>\n    <App />\n  </DbProvider>\n)\n```\n\n### useLiveQuery\n\nThe `useLiveQuery` hook creates a live query that automatically updates your component when data changes:\n\n```tsx\nimport { and, eq, gt, useDbClient, useLiveQuery } from '@tanstack/react-db'\n\nfunction TodoList() {\n  const { data, isLoading } = useLiveQuery({\n    query: (q) =>\n      q.from({ todos: todoCollection })\n       .where(({ todos }) => eq(todos.completed, false))\n       .select(({ todos }) => ({ id: todos.id, text: todos.text })),\n  })\n\n  if (isLoading) return <div>Loading...</div>\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}\n```\n\n### Query Identity\n\nReact live query hooks derive the live query identity from structured query IR by default. The hook runs the query builder, normalizes the resulting IR, and uses that as the identity. When the derived identity changes, the old live query collection is cleaned up and a new one is created.\n\nThat means normal structured queries do not need a separate `queryKey`. Collection descriptors provide stable collection IDs, and captured values inside structured expressions become part of the derived identity:\n\n```tsx\nfunction FilteredTodos({ minPriority }: { minPriority: number }) {\n  const { data } = useLiveQuery({\n    query: (q) => q.from({ todos: todoCollection })\n           .where(({ todos }) => gt(todos.priority, minPriority)),\n  })\n\n  return <div>{data.length} high-priority todos</div>\n}\n```\n\nFor derived-identity queries in one mounted hook and `DbClient` scope, a source\nCollection ID must keep referring to the same Collection object. If a render\nsupplies a different source object with a previously used ID, the hook throws\ninstead of returning rows from the old source. To reuse an ID within that hook,\nunmount it, clean up its source and client scope, then mount the replacement.\nSeparate hooks and independent client scopes can use the same ID.\n\n#### Collection Hooks\n\n`useLiveQuery` resolves collection descriptors from `DbProvider` automatically. Create small collection hooks when components need imperative collection methods like `insert`, `update`, `delete`, or `preload`:\n\n```tsx\nfunction useTodoCollection() {\n  return useDbClient().collection(todoCollection)\n}\n```\n\n#### When to Use Query Keys\n\nUse `queryKey` only when DB cannot derive identity from structured IR, or when you intentionally want to avoid deriving identity on a hot render path. The common case is a functional query variant such as `.fn.where`, `.fn.select`, or `.fn.having`:\n\n```tsx\nfunction SearchTodos({ search }: { search: string }) {\n  const { data } = useLiveQuery({\n    queryKey: [todoCollection.id, 'search', search],\n    query: (q) => q.from({ todos: todoCollection })\n           .fn.where(({ todos }) =>\n             todos.text.toLowerCase().includes(search.toLowerCase())\n           ),\n  })\n\n  return <div>{data.length} matching todos</div>\n}\n```\n\nAn explicit `queryKey` is the caller's identity contract. If its source object\nchanges, change the key too, even when the source ID stays the same. Use a\nprimitive scope token in the key; Collection objects cannot be hashed there.\n\nBefore 1.0, an unhashable query warns in development and keeps its legacy\nmount-stable identity. The query still runs, but captured values inside opaque\nlogic only become reactive when they are represented in `queryKey`. In 1.0, an\nunhashable query without `queryKey` will throw. If deriving identity becomes\nexpensive across renders, the hook warns once and suggests adding a `queryKey`\nas a performance escape hatch.\n\n#### What Happens When Identity Changes\n\nWhen the derived identity or explicit query key changes:\n1. The previous live query collection is cleaned up\n2. A new query is created with the updated values\n3. The component re-renders with the new data\n4. The hook suspends (for `useLiveSuspenseQuery`) or shows loading state\n\n#### Best Practices\n\n**Use structured expressions when possible:**\n\n```tsx\n// Good - DB can derive identity from this structured IR\nconst { data } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection })\n         .where(({ todos }) => and(\n           eq(todos.userId, userId),\n           eq(todos.status, status)\n         )),\n})\n```\n\n**Add a query key for opaque runtime logic:**\n\n```tsx\nconst { data } = useLiveQuery({\n  queryKey: [todoCollection.id, 'by-user-fn', userId],\n  query: (q) => q.from({ todos: todoCollection })\n         .fn.where(({ todos }) => todos.userId === userId),\n})\n```\n\n**Omit query keys for static structured queries:**\n\n```tsx\nconst { data } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection }),\n})\n```\n\nDependency arrays are still accepted for backwards compatibility, but they warn in development and will be removed in 1.0.\n\nFor SSR setup, collection hydration, and migration details, see the [SSR and Hydration guide](../../guides/ssr.md).\n\n### useLiveInfiniteQuery\n\nFor paginated data with live updates, use `useLiveInfiniteQuery`:\n\n```tsx\nconst { data, pages, fetchNextPage, hasNextPage } = useLiveInfiniteQuery(\n  (q) => q\n    .from({ posts: postsCollection })\n    .where(({ posts }) => eq(posts.category, category))\n    .orderBy(({ posts }) => posts.createdAt, 'desc'),\n  {\n    pageSize: 20,\n  }\n)\n```\n\n`fetchNextPage()` returns a promise that resolves after the page request settles. Failures are exposed through the returned `error` value and do not reject the promise.\n\nThis hook widens an ordered live query; it is not TanStack Query's\n`useInfiniteQuery`. `getNextPageParam` was previously ignored and is now rejected.\n`initialPageParam` only labels the returned pages; it does not set a server cursor\nor skip remote rows. For server pagination, use an on-demand Query Collection\nwhose `queryFn` fulfills `meta.loadSubsetOptions`. See the\n[server pagination guide](../../collections/query-collection.md#server-pagination-with-live-queries).\n\nThe deprecated dependency array is only available when using the query function variant, not when passing a pre-created collection.\n\n### useLiveSuspenseQuery\n\nFor React Suspense integration, use `useLiveSuspenseQuery`:\n\n```tsx\nfunction TodoList({ filter }: { filter: string }) {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) => q.from({ todos: todoCollection })\n           .where(({ todos }) => eq(todos.filter, filter)),\n  })\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList filter=\"active\" />\n    </Suspense>\n  )\n}\n```\n\nWhen the derived identity or explicit `queryKey` changes, `useLiveSuspenseQuery` will re-suspend, showing your Suspense fallback until the new data is ready.\n","originalRawMarkdown":"---\ntitle: TanStack DB React Adapter\nid: adapter\n---\n\n## Installation\n\n```sh\nnpm install @tanstack/react-db\n```\n\n## React Hooks\n\nSee the [React Functions Reference](./reference/index.md) to see the full list of hooks available in the React Adapter.\n\nFor comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the [Live Queries Guide](../../guides/live-queries).\n\n## Basic Usage\n\nCreate a `DbClient` and provide it to your React tree:\n\n```tsx\nimport { DbClient, DbProvider } from '@tanstack/react-db'\n\nconst dbClient = new DbClient()\n\nroot.render(\n  <DbProvider client={dbClient}>\n    <App />\n  </DbProvider>\n)\n```\n\n### useLiveQuery\n\nThe `useLiveQuery` hook creates a live query that automatically updates your component when data changes:\n\n```tsx\nimport { and, eq, gt, useDbClient, useLiveQuery } from '@tanstack/react-db'\n\nfunction TodoList() {\n  const { data, isLoading } = useLiveQuery({\n    query: (q) =>\n      q.from({ todos: todoCollection })\n       .where(({ todos }) => eq(todos.completed, false))\n       .select(({ todos }) => ({ id: todos.id, text: todos.text })),\n  })\n\n  if (isLoading) return <div>Loading...</div>\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}\n```\n\n### Query Identity\n\nReact live query hooks derive the live query identity from structured query IR by default. The hook runs the query builder, normalizes the resulting IR, and uses that as the identity. When the derived identity changes, the old live query collection is cleaned up and a new one is created.\n\nThat means normal structured queries do not need a separate `queryKey`. Collection descriptors provide stable collection IDs, and captured values inside structured expressions become part of the derived identity:\n\n```tsx\nfunction FilteredTodos({ minPriority }: { minPriority: number }) {\n  const { data } = useLiveQuery({\n    query: (q) => q.from({ todos: todoCollection })\n           .where(({ todos }) => gt(todos.priority, minPriority)),\n  })\n\n  return <div>{data.length} high-priority todos</div>\n}\n```\n\nFor derived-identity queries in one mounted hook and `DbClient` scope, a source\nCollection ID must keep referring to the same Collection object. If a render\nsupplies a different source object with a previously used ID, the hook throws\ninstead of returning rows from the old source. To reuse an ID within that hook,\nunmount it, clean up its source and client scope, then mount the replacement.\nSeparate hooks and independent client scopes can use the same ID.\n\n#### Collection Hooks\n\n`useLiveQuery` resolves collection descriptors from `DbProvider` automatically. Create small collection hooks when components need imperative collection methods like `insert`, `update`, `delete`, or `preload`:\n\n```tsx\nfunction useTodoCollection() {\n  return useDbClient().collection(todoCollection)\n}\n```\n\n#### When to Use Query Keys\n\nUse `queryKey` only when DB cannot derive identity from structured IR, or when you intentionally want to avoid deriving identity on a hot render path. The common case is a functional query variant such as `.fn.where`, `.fn.select`, or `.fn.having`:\n\n```tsx\nfunction SearchTodos({ search }: { search: string }) {\n  const { data } = useLiveQuery({\n    queryKey: [todoCollection.id, 'search', search],\n    query: (q) => q.from({ todos: todoCollection })\n           .fn.where(({ todos }) =>\n             todos.text.toLowerCase().includes(search.toLowerCase())\n           ),\n  })\n\n  return <div>{data.length} matching todos</div>\n}\n```\n\nAn explicit `queryKey` is the caller's identity contract. If its source object\nchanges, change the key too, even when the source ID stays the same. Use a\nprimitive scope token in the key; Collection objects cannot be hashed there.\n\nBefore 1.0, an unhashable query warns in development and keeps its legacy\nmount-stable identity. The query still runs, but captured values inside opaque\nlogic only become reactive when they are represented in `queryKey`. In 1.0, an\nunhashable query without `queryKey` will throw. If deriving identity becomes\nexpensive across renders, the hook warns once and suggests adding a `queryKey`\nas a performance escape hatch.\n\n#### What Happens When Identity Changes\n\nWhen the derived identity or explicit query key changes:\n1. The previous live query collection is cleaned up\n2. A new query is created with the updated values\n3. The component re-renders with the new data\n4. The hook suspends (for `useLiveSuspenseQuery`) or shows loading state\n\n#### Best Practices\n\n**Use structured expressions when possible:**\n\n```tsx\n// Good - DB can derive identity from this structured IR\nconst { data } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection })\n         .where(({ todos }) => and(\n           eq(todos.userId, userId),\n           eq(todos.status, status)\n         )),\n})\n```\n\n**Add a query key for opaque runtime logic:**\n\n```tsx\nconst { data } = useLiveQuery({\n  queryKey: [todoCollection.id, 'by-user-fn', userId],\n  query: (q) => q.from({ todos: todoCollection })\n         .fn.where(({ todos }) => todos.userId === userId),\n})\n```\n\n**Omit query keys for static structured queries:**\n\n```tsx\nconst { data } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection }),\n})\n```\n\nDependency arrays are still accepted for backwards compatibility, but they warn in development and will be removed in 1.0.\n\nFor SSR setup, collection hydration, and migration details, see the [SSR and Hydration guide](../../guides/ssr.md).\n\n### useLiveInfiniteQuery\n\nFor paginated data with live updates, use `useLiveInfiniteQuery`:\n\n```tsx\nconst { data, pages, fetchNextPage, hasNextPage } = useLiveInfiniteQuery(\n  (q) => q\n    .from({ posts: postsCollection })\n    .where(({ posts }) => eq(posts.category, category))\n    .orderBy(({ posts }) => posts.createdAt, 'desc'),\n  {\n    pageSize: 20,\n  }\n)\n```\n\n`fetchNextPage()` returns a promise that resolves after the page request settles. Failures are exposed through the returned `error` value and do not reject the promise.\n\nThis hook widens an ordered live query; it is not TanStack Query's\n`useInfiniteQuery`. `getNextPageParam` was previously ignored and is now rejected.\n`initialPageParam` only labels the returned pages; it does not set a server cursor\nor skip remote rows. For server pagination, use an on-demand Query Collection\nwhose `queryFn` fulfills `meta.loadSubsetOptions`. See the\n[server pagination guide](../../collections/query-collection.md#server-pagination-with-live-queries).\n\nThe deprecated dependency array is only available when using the query function variant, not when passing a pre-created collection.\n\n### useLiveSuspenseQuery\n\nFor React Suspense integration, use `useLiveSuspenseQuery`:\n\n```tsx\nfunction TodoList({ filter }: { filter: string }) {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) => q.from({ todos: todoCollection })\n           .where(({ todos }) => eq(todos.filter, filter)),\n  })\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList filter=\"active\" />\n    </Suspense>\n  )\n}\n```\n\nWhen the derived identity or explicit `queryKey` changes, `useLiveSuspenseQuery` will re-suspend, showing your Suspense fallback until the new data is ready.\n"}
