:"text","value":"isError"}]},{"type":"code","value":"isError: boolean;","lang":"ts"},{"type":"heading","depth":4,"id":"isidle-11","children":[{"type":"text","value":"isIdle"}]},{"type":"code","value":"isIdle: boolean;","lang":"ts"},{"type":"heading","depth":4,"id":"isloading-11","children":[{"type":"text","value":"isLoading"}]},{"type":"code","value":"isLoading: boolean;","lang":"ts"},{"type":"heading","depth":4,"id":"ispersistedready-11","children":[{"type":"text","value":"isPersistedReady"}]},{"type":"code","value":"isPersistedReady: boolean;","lang":"ts"},{"type":"heading","depth":4,"id":"isready-11","children":[{"type":"text","value":"isReady"}]},{"type":"code","value":"isReady: boolean;","lang":"ts"},{"type":"heading","depth":4,"id":"persistederror-11","children":[{"type":"text","value":"persistedError"}]},{"type":"code","value":"persistedError: unknown;","lang":"ts"},{"type":"heading","depth":4,"id":"persistedstatus-11","children":[{"type":"text","value":"persistedStatus"}]},{"type":"code","value":"persistedStatus: LiveQueryPersistedStatus;","lang":"ts"},{"type":"heading","depth":4,"id":"state-11","children":[{"type":"text","value":"state"}]},{"type":"code","value":"state: Map<TKey, TResult>;","lang":"ts"},{"type":"heading","depth":4,"id":"status-11","children":[{"type":"text","value":"status"}]},{"type":"code","value":"status: CollectionStatus;","lang":"ts"},{"type":"heading","depth":3,"id":"examples-11","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Prefer config object syntax\nconst { data, isLoading } = useLiveQuery({\n  query: (q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.completed, false))\n     .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n})","lang":"ts"},{"type":"code","value":"// Single result query\nconst { data } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.id, 1))\n         .findOne()\n})","lang":"ts"},{"type":"code","value":"// Structured captured values are included in derived query identity\nconst { data, state } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority)),\n})","lang":"ts"},{"type":"code","value":"// Return undefined or null to disable a query\nconst { data, isEnabled } = useLiveQuery({\n  query: (q) => {\n    if (!userId) return undefined\n    return q.from({ todos: todosCollection })\n            .where(({ todos }) => eq(todos.userId, userId))\n  },\n})","lang":"ts"},{"type":"code","value":"// Join pattern\nconst { data } = useLiveQuery({\n  query: (q) =>\n    q.from({ issues: issueCollection })\n     .join({ persons: personCollection }, ({ issues, persons }) =>\n       eq(issues.userId, persons.id)\n     )\n     .select(({ issues, persons }) => ({\n       id: issues.id,\n       title: issues.title,\n       userName: persons.name\n     }))\n})","lang":"ts"},{"type":"code","value":"// Handle loading and error states\nconst { data, isLoading, isError, status } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection })\n})\n\nif (isLoading) return <div>Loading...</div>\nif (isError) return <div>Error: {status}</div>\n\nreturn (\n  <ul>\n    {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n  </ul>\n)","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tcontext","text":"TContext","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"queryfn","text":"queryFn","level":4},{"id":"deps","text":"deps?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"collection","text":"collection","level":4},{"id":"data","text":"data","level":4},{"id":"iscleanedup","text":"isCleanedUp","level":4},{"id":"isenabled","text":"isEnabled","level":4},{"id":"iserror","text":"isError","level":4},{"id":"isidle","text":"isIdle","level":4},{"id":"isloading","text":"i