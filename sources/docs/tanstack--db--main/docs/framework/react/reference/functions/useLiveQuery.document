meters-7","text":"Parameters","level":3},{"id":"config-2","text":"config","level":4},{"id":"returns-7","text":"Returns","level":3},{"id":"collection-7","text":"collection","level":4},{"id":"data-7","text":"data","level":4},{"id":"iscleanedup-7","text":"isCleanedUp","level":4},{"id":"isenabled-7","text":"isEnabled","level":4},{"id":"iserror-7","text":"isError","level":4},{"id":"isidle-7","text":"isIdle","level":4},{"id":"isloading-7","text":"isLoading","level":4},{"id":"ispersistedready-7","text":"isPersistedReady","level":4},{"id":"isready-7","text":"isReady","level":4},{"id":"persistederror-7","text":"persistedError","level":4},{"id":"persistedstatus-7","text":"persistedStatus","level":4},{"id":"state-7","text":"state","level":4},{"id":"status-7","text":"status","level":4},{"id":"examples-7","text":"Examples","level":3},{"id":"call-signature-8","text":"Call Signature","level":2},{"id":"type-parameters-8","text":"Type Parameters","level":3},{"id":"tcontext-7","text":"TContext","level":4},{"id":"parameters-8","text":"Parameters","level":3},{"id":"config-3","text":"config","level":4},{"id":"deps-6","text":"deps?","level":4},{"id":"returns-8","text":"Returns","level":3},{"id":"collection-8","text":"collection","level":4},{"id":"data-8","text":"data","level":4},{"id":"iscleanedup-8","text":"isCleanedUp","level":4},{"id":"isenabled-8","text":"isEnabled","level":4},{"id":"iserror-8","text":"isError","level":4},{"id":"isidle-8","text":"isIdle","level":4},{"id":"isloading-8","text":"isLoading","level":4},{"id":"ispersistedready-8","text":"isPersistedReady","level":4},{"id":"isready-8","text":"isReady","level":4},{"id":"persistederror-8","text":"persistedError","level":4},{"id":"persistedstatus-8","text":"persistedStatus","level":4},{"id":"state-8","text":"state","level":4},{"id":"status-8","text":"status","level":4},{"id":"examples-8","text":"Examples","level":3},{"id":"call-signature-9","text":"Call Signature","level":2},{"id":"type-parameters-9","text":"Type Parameters","level":3},{"id":"tcontext-8","text":"TContext","level":4},{"id":"parameters-9","text":"Parameters","level":3},{"id":"config-4","text":"config","level":4},{"id":"deps-7","text":"deps","level":4},{"id":"returns-9","text":"Returns","level":3},{"id":"collection-9","text":"collection","level":4},{"id":"data-9","text":"data","level":4},{"id":"iscleanedup-9","text":"isCleanedUp","level":4},{"id":"isenabled-9","text":"isEnabled","level":4},{"id":"iserror-9","text":"isError","level":4},{"id":"isidle-9","text":"isIdle","level":4},{"id":"isloading-9","text":"isLoading","level":4},{"id":"ispersistedready-9","text":"isPersistedReady","level":4},{"id":"isready-9","text":"isReady","level":4},{"id":"persistederror-9","text":"persistedError","level":4},{"id":"persistedstatus-9","text":"persistedStatus","level":4},{"id":"state-9","text":"state","level":4},{"id":"status-9","text":"status","level":4},{"id":"examples-9","text":"Examples","level":3},{"id":"call-signature-10","text":"Call Signature","level":2},{"id":"type-parameters-10","text":"Type Parameters","level":3},{"id":"tresult-3","text":"TResult","level":4},{"id":"tkey-3","text":"TKey","level":4},{"id":"tutils-3","text":"TUtils","level":4},{"id":"parameters-10","text":"Parameters","level":3},{"id":"livequerycollection","text":"liveQueryCollection","level":4},{"id":"returns-10","text":"Returns","level":3},{"id":"collection-10","text":"collection","level":4},{"id":"data-10","text":"data","level":4},{"id":"iscleanedup-10","text":"isCleanedUp","level":4},{"id":"isenabled-10","text":"isEnabled","level":4},{"id":"iserror-10","text":"isError","level":4},{"id":"isidle-10","text":"isIdle","level":4},{"id":"isloading-10","text":"isLoading","level":4},{"id":"ispersistedready-10","text":"isPersistedReady","level":4},{"id":"isready-10","text":"isReady","level":4},{"id":"persistederror-10","text":"persistedError","level":4},{"id":"persistedstatus-10","text":"persistedStatus","level":4},{"id":"state-10","text":"state","level":4},{"id":"status-10","text":"status","level":4},{"id":"examples-10","text":"Examples","level":3},{"id":"call-signature-11","text":"Call Signature","level":2},{"id":"type-parameters-11","text":"Type Parameters","level":3},{"id":"tresult-4","text":"TResult","level":4},{"id":"tkey-4","text":"TKey","level":4},{"id":"tutils-4","text":"TUtils","level":4},{"id":"parameters-11","text":"Parameters","level":3},{"id":"livequerycollection-2","text":"liveQueryCollection","level":4},{"id":"returns-11","text":"Returns","level":3},{"id":"collection-11","text":"collection","level":4},{"id":"data-11","text":"data","level":4},{"id":"iscleanedup-11","text":"isCleanedUp","level":4},{"id":"isenabled-11","text":"isEnabled","level":4},{"id":"iserror-11","text":"isError","level":4},{"id":"isidle-11","text":"isIdle","level":4},{"id":"isloading-11","text":"isLoading","level":4},{"id":"ispersistedready-11","text":"isPersistedReady","level":4},{"id":"isready-11","text":"isReady","level":4},{"id":"persistederror-11","text":"persistedError","level":4},{"id":"persistedstatus-11","text":"persistedStatus","level":4},{"id":"state-11","text":"state","level":4},{"id":"status-11","text":"status","level":4},{"id":"examples-11","text":"Examples","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(queryFn, deps?): object;\n```\n\nDefined in: [useLiveQuery.ts:407](https://github.com/TanStack/db/blob/main/packages/react-db/src/useLiveQuery.ts#L407)\n\nCreate a live query using a query function.\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### queryFn\n\n(`q`) => `QueryBuilder`\\<`TContext`\\>\n\nQuery function that defines what data to fetch\n\n#### deps?\n\n`unknown`[]\n\nDeprecated array of dependencies that trigger query re-execution when changed\n\n### Returns\n\n`object`\n\nObject with reactive data, state, and status information\n\n#### collection\n\n```ts\ncollection: Collection<{ [K in string | number | symbol]: ResultValue<TContext>[K] }, string | number, {\n}>;\n```\n\n#### data\n\n```ts\ndata: InferResultType<TContext>;\n```\n\n#### isCleanedUp\n\n```ts\nisCleanedUp: boolean;\n```\n\n#### isEnabled\n\n```ts\nisEnabled: true;\n```\n\n#### isError\n\n```ts\nisError: boolean;\n```\n\n#### isIdle\n\n```ts\nisIdle: boolean;\n```\n\n#### isLoading\n\n```ts\nisLoading: boolean;\n```\n\n#### isPersistedReady\n\n```ts\nisPersistedReady: boolean;\n```\n\n#### isReady\n\n```ts\nisReady: boolean;\n```\n\n#### persistedError\n\n```ts\npersistedError: unknown;\n```\n\n#### persistedStatus\n\n```ts\npersistedStatus: LiveQueryPersistedStatus;\n```\n\n#### state\n\n```ts\nstate: Map<string | number, { [K in string | number | symbol]: ResultValue<TContext>[K] }>;\n```\n\n#### status\n\n```ts\nstatus: CollectionStatus;\n```\n\n### Examples\n\n```ts\n// Prefer config object syntax\nconst { data, isLoading } = useLiveQuery({\n  query: (q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.completed, false))\n     .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n})\n```\n\n```ts\n// Single result query\nconst { data } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.id, 1))\n         .findOne()\n})\n```\n\n```ts\n// Structured captured values are included in derived query identity\nconst { data, state } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority)),\n})\n```\n\n```ts\n// Return undefined or null to disable a query\nconst { data, isEnabled } = useLiveQuery({\n  query: (q) => {\n    if (!userId) return undefined\n    return q.from({ todos: todosCollection })\n            .where(({ todos }) => eq(todos.userId, userId))\n  },\n})\n```\n\n```ts\n// Join pattern\nconst { data } = useLiveQuery({\n  query: (q) =>\n    q.from({ issues: issueCollection })\n     .join({ persons: personCollection }, ({ issues, persons }) =>\n       eq(issues.userId, persons.id)\n     )\n     .select(({ issues, persons }) => ({\n       id: issues.id,\n       title: issues.title,\n       userName: persons.name\n     }))\n})\n```\n\n```ts\n// Handle loading and error states\nconst { data, isLoading, isError, status } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection })\n})\n\nif (isLoading) return <div>Loading...</div>\nif (isError) return <div>Error: {status}</div>\n\nreturn (\n  <ul>\n    {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n  </ul>\n)\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(queryFn, deps?): object;\n```\n\nDefined in: [useLiveQuery.ts:427](https://github.com/TanStack/db/blob/main/packages/react-db/src/useLiveQuery.ts#L427)\n\nCreate a live query using a query function.\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### queryFn\n\n(`q`) => `QueryBuilder`\\<`TContext`\\> \\| `null` \\| `undefined`\n\nQuery function that defines what data to fetch\n\n#### deps?\n\n`unknown`[]\n\nDeprecated array of dependencies that trigger query re-execution when changed\n\n### Returns\n\n`object`\n\nObject with reactive data, state, and status information\n\n#### collection\n\n```ts\ncollection: \n  | Collection<{ [K in string | number | symbol]: ResultValue<TContext>[K] }, string | number, {\n}, StandardSchemaV1<unknown, unknown>, { [K in string | number | symbol]: ResultValue<TContext>[K] }>\n  | undefined;\n```\n\n#### data\n\n```ts\ndata: InferResultType<TContext> | undefined;\n```\n\n#### isCleanedUp\n\n```ts\nisCleanedUp: boolean;\n```\n\n#### isEnabled\n\n```ts\nisEnabled: boolean;\n```\n\n#### isError\n\n```ts\nisError: boolean;\n```\n\n#### isIdle\n\n```ts\nisIdle: boolean;\n```\n\n#### isLoading\n\n```ts\nisLoading: boolean;\n```\n\n#### isPersistedReady\n\n```ts\nisPersistedReady: boolean;\n```\n\n#### isReady\n\n```ts\nisReady: boolean;\n```\n\n#### persistedError\n\n```ts\npersistedErro