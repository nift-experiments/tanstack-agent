 Handle loading and error states\nconst { data, isLoading, isError, status } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection })\n})\n\nif (isLoading) return <div>Loading...</div>\nif (isError) return <div>Error: {status}</div>\n\nreturn (\n  <ul>\n    {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n  </ul>\n)","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TContext>(queryFn, deps?): object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/react-db/src/useLiveQuery.ts#L427","children":[{"type":"text","value":"useLiveQuery.ts:427"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Create a live query using a query function."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tcontext-2","children":[{"type":"text","value":"TContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TContext"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Context"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"queryfn-2","children":[{"type":"text","value":"queryFn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"q"},{"type":"text","value":") => "},{"type":"inlineCode","value":"QueryBuilder"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":"> | "},{"type":"inlineCode","value":"null"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"}]},{"type":"paragraph","children":[{"type":"text","value":"Query function that defines wha