redCollection)\n\nif (isLoading) return <div>Loading...</div>\nif (isError) return <div>Error loading data</div>\n\nreturn <div>{data.map(item => <Item key={item.id} {...item} />)}</div>","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-11","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/react-db/src/useLiveQuery.ts#L698","children":[{"type":"text","value":"useLiveQuery.ts:698"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Create a live query using a query function."}]},{"type":"heading","depth":3,"id":"type-parameters-11","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tresult-4","children":[{"type":"text","value":"TResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TResult"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":4,"id":"tkey-4","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":4,"id":"tutils-4","children":[{"type":"text","value":"TUtils"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TUtils"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text"