s\nconst { data, isLoading, isError, status } = useLiveQuery({\n  query: (q) => q.from({ todos: todoCollection })\n})\n\nif (isLoading) return <div>Loading...</div>\nif (isError) return <div>Error: {status}</div>\n\nreturn (\n  <ul>\n    {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n  </ul>\n)","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-6","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TContext>(config): object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/react-db/src/useLiveQuery.ts#L568","children":[{"type":"text","value":"useLiveQuery.ts:568"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Create a live query using configuration object"}]},{"type":"heading","depth":3,"id":"type-parameters-6","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tcontext-5","children":[{"type":"text","value":"TContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TContext"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Context"}]},{"type":"heading","depth":3,"id":"parameters-6","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"config","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseLiveQueryConfig.md","children":[{"type":"inlineCode","value":"UseLiveQueryConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration object with query and options"}]},{"type":"heading","depth":3,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","