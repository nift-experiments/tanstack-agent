ue":"TResult"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":4,"id":"tkey-2","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":4,"id":"tutils-2","children":[{"type":"text","value":"TUtils"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TUtils"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"livequerycollection-2","children":[{"type":"text","value":"liveQueryCollection"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Collection"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TUtils"},{"type":"text","value":", "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TResult"},{"type":"text","value":"> & "},{"type":"inlineCode","value":"SingleResult"}]},{"type":"heading","depth":3,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Object with reactive data and state - data is guaranteed to be defined"}]},{"type":"heading","depth":4,"id":"collection-5","children":[{"type":"text","value":"collection"}]},{"type":"code","value":"collection: Collection<TResult, TKey, TUtils, StandardSchemaV1<unknown, unknown>, TResult> & SingleResult;","lang":"ts"},{"type":"heading","depth":4,"id":"data-5","children":[{"type":"text","value":"data"}]},{"type":"code","value":"data: TResult | undefined;","lang":"ts"},{"type":"heading","depth":4,"id":"state-5","children":[{"type":"text","value":"state"}]},{"type":"code","value":"state: Map<TKey, TResult>;","lang":"ts"},{"type":"heading","depth":3,"id":"throws-9","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"Promise when data is loading (caught by Suspense boundary)"}]},{"type":"heading","depth":3,"id":"throws-10","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"Error when collection fails (caught by Error boundary)"}]},{"type":"heading","depth":3,"id":"examples-5","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic usage with Suspense\nfunction TodoList() {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => eq(todos.completed, false))\n       .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  })\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList />\n    </Suspense>\n  )\n}","lang":"ts"},{"type":"code","value":"// Single result query\nconst { data } = useLiveSuspenseQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.id, 1))\n         .findOne()\n)\n// data is guaranteed to be the single item (or undefined if not found)","lang":"ts"},{"type":"code","value":"// Structured captured values are included in derived query identity and trigger re-suspension\nconst { data } = useLiveSuspenseQuery({\n  query: (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority)),\n})","lang":"ts"},{"type":"code","value":"// With Error boundary\nfunction App() {\n  return (\n    <ErrorBoundary fallback={<div>Error loading data</div>}>\n      <Suspense fallback={<div>Loading...</div>}>\n        <TodoList />\n      </Suspense>\n    </ErrorBoundary>\n  )\n}","lang":"ts"},{"type":"heading","depth":3,"id":"remarks-5","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Important:"}]},{"type":"text","value":" This hook does NOT support disabled queries (returning undefined/null).\nFollowing TanStack Query's useSuspenseQuery design, the query callback must always\nreturn a valid query, collection, or config object."}]},{"type":"paragraph","children":[{"type":"text","value":"❌ "},{"type":"strong","children":[{"type":"text","value":"This will cause a type error:"}]}]},{"type":"code","value":"useLiveSuspenseQuery(\n  (q) => userId ? q.from({ users }) : undefined  // ❌ Error!\n)","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"✅ "},{"type":"strong","children":[{"type":"text","value":"Use conditional rendering instead:"}]}]},{"type":"code","value":"function Profile({ userId }: { userId: string }) {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) => q.from({ users }).where(({ users }) => eq(users.id, userId)),\n  })\n  return <div>{data.name}</div>\n}\n\n// In parent component:\n{userId ? <Profile userId={userId} /> : <div>No user</div>}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"✅ "},{"type":"strong","children":[{"type":"text","value":"For optional inputs, conditionally render a component with complete query inputs:"}]}]},{"type":"code","value":"{userId ? <Profile userId={userId} /> : <div>No user</div>}","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tcontext","text":"TContext","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"queryfn","text":"queryFn","level":4},{"id":"deps","text":"deps?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"collection","text":"collection","level":4},{"id":"data","text":"data","level":4},{"id":"state","text":"state","level":4},{"id":"throws","text":"Throws","level":3},{"id":"throws-2","text":"Throws","level":3},{"id":"examples","text":"Examples","level":3},{"id":"remarks","text":"Remarks","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tcontext-2","text":"TContext","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"config","text":"config","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"collection-2","text":"collection","level":4},{"id":"data-2","text":"data","level":4},{"id":"state-2","text":"state","level":4},{"id":"throws-3","text":"Throws","level":3},{"id":"throws-4","text":"Throws","level":3},{"id":"examples-2","text":"Examples","level":3},{"id":"remarks-2","text":"Remarks","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tcontext-3","text":"TContext","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"config-2","text":"config","level":4},{"id":"deps-2","text":"deps?","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"collection-3","text":"collection","level":4},{"id":"data-3","text":"data","level":4},{"id":"state-3","text":"state","level":4},{"id":"throws-5","text":"Throws","level":3},{"id":"throws-6","text":"Throws","level":3},{"id":"examples-3","text":"Examples","level":3},{"id":"remarks-3","text":"Remarks","level":3},{"id":"call-signature-4","text":"Call Signature","level":2},{"id":"type-parameters-4","text":"Type Parameters","level":3},{"id":"tresult","text":"TResult","level":4},{"id":"tkey","text":"TKey","level":4},{"id":"tutils","text":"TUtils","level":4},{"id":"parameters-4","text":"Parameters","level":3},{"id":"livequerycollection","text":"liveQueryCollection","level":4},{"id":"returns-4","text":"Returns","level":3},{"id":"collection-4","text":"collection","level":4},{"id":"data-4","text":"data","level":4},{"id":"state-4","text":"state","level":4},{"id":"throws-7","text":"Throws","level":3},{"id":"throws-8","text":"Throws","level":3},{"id":"examples-4","text":"Examples","level":3},{"id":"remarks-4","text":"Remarks","level":3},{"id":"call-signature-5","text":"Call Signature","level":2},{"id":"type-parameters-5","text":"Type Parameters","level":3},{"id":"tresult-2","text":"TResult","level":4},{"id":"tkey-2","text":"TKey","level":4},{"id":"tutils-2","text":"TUtils","level":4},{"id":"parameters-5","text":"Parameters","level":3},{"id":"livequerycollection-2","text":"liveQueryCollection","level":4},{"id":"returns-5","text":"Returns","level":3},{"id":"collection-5","text":"collection","level":4},{"id":"data-5","text":"data","level":4},{"id":"state-5","text":"state","level":4},{"id":"throws-9","text":"Throws","level":3},{"id":"throws-10","text":"Throws","level":3},{"id":"examples-5","text":"Examples","level":3},{"id":"remarks-5","text":"Remarks","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction useLiveSuspenseQuery<TContext>(queryFn, deps?): object;\n```\n\nDefined in: [useLiveSuspenseQuery.ts:151](https://github.com/TanStack/db/blob/main/packages/react-db/src/useLiveSuspenseQuery.ts#L151)\n\nCreate a live query with React Suspense support\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### queryFn\n\n(`q`) => `QueryBuilder`\\<`TContext`\\>\n\nQuery function that defines what data to fetch\n\n#### deps?\n\n`unknown`[]\n\nDeprecated array of dependencies that trigger query re-execution when changed\n\n### Returns\n\n`object`\n\nObject with reactive data and state - data is guaranteed to be defined\n\n#### collection\n\n```ts\ncollection: Collection<{ [K in string | number | symbol]: ResultValue<TContext>[K] }, string | number, {\n}>;\n```\n\n#### data\n\n```ts\ndata: InferResultType<TContext>;\n```\n\n#### state\n\n```ts\nstate: Map<string | number, { [K in string | number | symbol]: ResultValue<TContext>[K] }>;\n```\n\n### Throws\n\nPromise when data is loading (caught by Suspense boundary)\n\n### Throws\n\nError when collection fails (caught by Error boundary)\n\n### Examples\n\n```ts\n// Basic usage with Suspense\nfunction TodoList() {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => eq(todos.completed, false))\n       .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  })\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList />\n    </Suspense>\n  )\n}\n```\n\n```ts\n// Single result query\nconst { data } = useLiveSuspenseQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.id, 1))\n         .findOne()\n)\n// data is guaranteed to be the single item (or undefined if not found)\n```\n\n```ts\n// Structured captured values are included in derived query identity and trigger re-suspension\nconst { data } = useLiveSuspenseQuery({\n  query: (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority)),\n})\n```\n\n```ts\n// With Error boundary\nfunction App() {\n  return (\n    <ErrorBoundary fallback={<div>Error loading data</div>}>\n      <Suspense fallback={<div>Loading...</div>}>\n        <TodoList />\n      </Suspense>\n    </ErrorBoundary>\n  )\n}\n```\n\n### Remarks\n\n**Important:** This hook does NOT support disabled queries (returning undefined/null).\nFollowing TanStack Query's useSuspenseQuery design, the query callback must always\nreturn a valid query, collection, or config object.\n\n❌ **This will cause a type error:**\n```ts\nuseLiveSuspenseQuery(\n  (q) => userId ? q.from({ users }) : undefined  // ❌ Error!\n)\n```\n\n✅ **Use conditional rendering instead:**\n```ts\nfunction Profile({ userId }: { userId: string }) {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) => q.from({ users }).where(({ users }) => eq(users.id, userId)),\n  })\n  return <div>{data.name}</div>\n}\n\n// In parent component:\n{userId ? <Profile userId={userId} /> : <div>No user</div>}\n```\n\n✅ **For optional inputs, conditionally render a component with complete query inputs:**\n```ts\n{userId ? <Profile userId={userId} /> : <div>No user</div>}\n```\n\n## Call Signature\n\n```ts\nfunction useLiveSuspenseQuery<TContext>(config): object;\n```\n\nDefined in: [useLiveSuspenseQuery.ts:161](https://github.com/TanStack/db/blob/main/packages/react-db/src/useLiveSuspenseQuery.ts#L161)\n\nCreate a live query with React Suspense support\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### config\n\n[`UseLiveQueryConfig`](../type-aliases/UseLiveQueryConfig.md)\\<`TContext`\\>\n\n### Returns\n\n`object`\n\nObject with reactive data and state - data is guaranteed to be defined\n\n#### collection\n\n```ts\ncollection: Collection<{ [K in string | number | symbol]: ResultValue<TContext>[K] }, string | number, {\n}>;\n```\n\n#### data\n\n```ts\ndata: InferResultType<TContext>;\n```\n\n#### state\n\n```ts\nstate: Map<string | number, { [K in string | number | symbol]: ResultValue<TContext>[K] }>;\n```\n\n### Throws\n\nPromise when data is loading (caught by Suspense boundary)\n\n### Throws\n\nError when collection fails (caught by Error boundary)\n\n### Examples\n\n```ts\n// Basic usage with Suspense\nfunction TodoList() {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => eq(todos.completed, false))\n       .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  })\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList />\n    </Suspense>\n  )\n}\n```\n\n```ts\n// Single result query\nconst { data } = useLiveSuspenseQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.id, 1))\n         .findOne()\n)\n// data is guaranteed to be the single item (or undefined if not found)\n```\n\n```ts\n// Structured captured values are included in derived query identity and trigger re-suspension\nconst { data } = useLiveSuspenseQuery({\n  query: (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority)),\n})\n```\n\n```ts\n// With Error boundary\nfunction App() {\n  return (\n    <ErrorBoundary fallback={<div>Error loading data</div>}>\n      <Suspense fallback={<div>Loading...</div>}>\n        <TodoList />\n      </Suspense>\n    </ErrorBoundary>\n  )\n}\n```\n\n### Remarks\n\n**Important:** This hook does NOT support disabled queries (returning undefined/null).\nFollowing TanStack Query's useSuspenseQuery design, the query callback must always\nreturn a valid query, collection, or config object.\n\n❌ **This will cause a type error:**\n```ts\nuseLiveSuspenseQuery(\n  (q) => userId ? q.from({ users }) : undefined  // ❌ Error!\n)\n```\n\n✅ **Use conditional rendering instead:**\n```ts\nfunction Profile({ userId }: { userId: string }) {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) => q.from({ users }).where(({ users }) => eq(users.id, userId)),\n  })\n  return <div>{data.name}</div>\n}\n\n// In parent component:\n{userId ? <Profile userId={userId} /> : <div>No user</div>}\n```\n\n✅ **For optional inputs, conditionally render a component with complete query inputs:**\n```ts\n{userId ? <Profile userId={userId} /> : <div>No user</div>}\n```\n\n## Call Signature\n\n```ts\nfunction useLiveSuspenseQuery<TContext>(config, deps?): object;\n```\n\nDefined in: [useLiveSuspenseQuery.ts:170](https://github.com/TanStack/db/blob/main/packages/react-db/src/useLiveSuspenseQuery.ts#L170)\n\nCreate a live query with React Suspense support\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### config\n\n`LiveQueryCollectionConfig`\\<`TContext`\\>\n\n#### deps?\n\n`unknown`[]\n\nDeprecated array of dependencies that trigger query re-execution when changed\n\n### Returns\n\n`object`\n\nObject with reactive data and state - data is guaranteed to be defined\n\n#### collection\n\n```ts\ncollection: Collection<{ [K in string | number | symbol]: ResultValue<TContext>[K] }, string | number, {\n}>;\n```\n\n#### data\n\n```ts\ndata: InferResultType<TContext>;\n```\n\n#### state\n\n```ts\nstate: Map<string | number, { [K in string | number | symbol]: ResultValue<TContext>[K] }>;\n```\n\n### Throws\n\nPromise when data is loading (caught by Suspense boundary)\n\n### Throws\n\nError when collection fails (caught by Error boundary)\n\n### Examples\n\n```ts\n// Basic usage with Suspense\nfunction TodoList() {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => eq(todos.completed, false))\n       .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  })\n\n  return (\n    <ul>\n      {data.map(todo => <li key={todo.id}>{todo.text}</li>)}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList />\n    </Suspense>\n  )\n}\n```\n\n```ts\n// Single result query\nconst { data } = useLiveSuspenseQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.id, 1))\n         .findOne()\n)\n// data is guaranteed to be the single item (or undefined if not found)\n```\n\n```ts\n// Structured captured values are included in derived query identity and trigger re-suspension\nconst { data } = useLiveSuspenseQuery({\n  query: (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority)),\n})\n```\n\n```ts\n// With Error boundary\nfunction App() {\n  return (\n    <ErrorBoundary fallback={<div>Error loading data</div>}>\n      <Suspense fallback={<div>Loading...</div>}>\n        <TodoList />\n      </Suspense>\n    </ErrorBoundary>\n  )\n}\n```\n\n### Remarks\n\n**Important:** This hook does NOT support disabled queries (returning undefined/null).\nFollowing TanStack Query's useSuspenseQuery design, the query callback must always\nreturn a valid query, collection, or config object.\n\n❌ **This will cause a type error:**\n```ts\nuseLiveSuspenseQuery(\n  (q) => userId ? q.from({ users }) : undefined  // ❌ Error!\n)\n```\n\n✅ **Use conditional rendering instead:**\n```ts\nfunction Profile({ userId }: { userId: string }) {\n  const { data } = useLiveSuspenseQuery({\n    query: (q) => q.from({ users }).where(({ users }) => eq(users.id, userId)),\n  })\n  return <div>{data.name}</div>\n}\n\n// In parent component:\n{userId ? <Profile userId={userId} /> : <div>No user</div>}\n```\n\n✅ **For optional inputs, conditionally render a component with complete query inputs:**\n```ts\n{userId ? <Profile userId={userId} /> : <div>No user</div>}\n```\n\n## Call Signature\n\n```ts\nfunction useLiveSuspenseQuery<TResult, TKey, TUtils>(liveQueryCollection): object;\n```\n\nDefined in: [useLiveSuspenseQuery.ts:180](https://github.com/TanStack/db/blob/main/packages/react-db/src/useLiveSuspenseQuer