{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"call-signature","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TContext>(queryFn): Accessor<InferResultType<TContext>> & object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/solid-db/src/useLiveQuery.ts#L112","children":[{"type":"text","value":"useLiveQuery.ts:112"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Create a live query using a query function"}]},{"type":"heading","depth":3,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tcontext","children":[{"type":"text","value":"TContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TContext"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Context"}]},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"queryfn","children":[{"type":"text","value":"queryFn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"q"},{"type":"text","value":") => "},{"type":"inlineCode","value":"QueryBuilder"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Query function that defines what data to fetch"}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"Accessor that returns data with Suspense support, with state and status information as properties"}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic query with object syntax\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)","lang":"ts"},{"type":"code","value":"// With dependencies that trigger re-execution\nconst todosQuery = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority())),\n)","lang":"ts"},{"type":"code","value":"// Join pattern\nconst personIssues = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)","lang":"ts"},{"type":"code","value":"// Handle loading and error states\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Switch>\n    <Match when={todosQuery.isLoading}>\n      <div>Loading...</div>\n    </Match>\n    <Match when={todosQuery.isError}>\n      <div>Error: {todosQuery.status}</div>\n    </Match>\n    <Match when={todosQuery.isReady}>\n      <For each={todosQuery()}>\n        {(todo) => <li key={todo.id}>{todo.text}</li>}\n      </For>\n    </Match>\n  </Switch>\n)","lang":"ts"},{"type":"code","value":"// Use Suspense boundaries\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Suspense fallback={<div>Loading...</div>}>\n    <For each={todosQuery()}>\n      {(todo) => <li key={todo.id}>{todo.text}</li>}\n    </For>\n  </Suspense>\n)","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TContext>(queryFn): Accessor<InferConditionalResultType<TContext>> & object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "