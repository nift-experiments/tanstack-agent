)","lang":"ts"},{"type":"code","value":"// With dependencies that trigger re-execution\nconst todosQuery = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority())),\n)","lang":"ts"},{"type":"code","value":"// Join pattern\nconst personIssues = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)","lang":"ts"},{"type":"code","value":"// Handle loading and error states\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Switch>\n    <Match when={todosQuery.isLoading}>\n      <div>Loading...</div>\n    </Match>\n    <Match when={todosQuery.isError}>\n      <div>Error: {todosQuery.status}</div>\n    </Match>\n    <Match when={todosQuery.isReady}>\n      <For each={todosQuery()}>\n        {(todo) => <li key={todo.id}>{todo.text}</li>}\n      </For>\n    </Match>\n  </Switch>\n)","lang":"ts"},{"type":"code","value":"// Use Suspense boundaries\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Suspense fallback={<div>Loading...</div>}>\n    <For each={todosQuery()}>\n      {(todo) => <li key={todo.id}>{todo.text}</li>}\n    </For>\n  </Suspense>\n)","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-3","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TContext>(config): Accessor<InferResultType<TContext>> & object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/solid-db/src/useLiveQuery.ts#L198","children":[{"type":"text","value":"useLiveQuery.ts:198"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Create a live query using configuration object"}]},{"type":"heading","depth":3,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tcontext-3","children":[{"type":"text","value":"TContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TContext"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Context"}]},{"type":"heading","depth":3,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"config","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"inlineCode","value":"LiveQueryCollectionConfig"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":", "},{"type":"inlineCode","value":"RootQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">>>"}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration object with query and options"}]},{"type":"heading","depth":3,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"Accessor that returns data with Suspense support, with state and status information as properties"}]},{"type":"heading","depth":3,"id":"examples-3","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic config object usage\nconst todosQuery = useLiveQuery(() => ({\n  query: (q) => q.from({ todos: todosCollection }),\n  gcTime: 60000\n}))","lang":"ts"},{"type":"code","value":"// With query builder and options\nconst queryBuilder = new Query()\n  .from({ persons: collection })\n  .where(({ persons }) => gt(persons.age, 30))\n  .select(({ persons }) => ({ id: persons.id, name: persons.name }))\n\nconst personsQuery = useLiveQuery(() => ({ query: queryBuilder }))","lang":"ts"},{"type":"code","value":"// Handle all states uniformly\nconst itemsQuery = useLiveQuery(() => ({\n  query: (q) => q.from({ items: itemCollection })\n}))\n\nreturn (\n  <Switch fallback={<div>{itemsQuery().length} items loaded</div>}>\n    <Match when={itemsQuery.isLoading}>\n      <div>Loading...</div>\n    </Match>\n    <Match when={itemsQuery.isError}>\n      <div>Something went wrong</div>\n    </Match>\n    <Match when={!itemsQuery.isReady}>\n      <div>Preparing...</div>\n    </Match>\n  </Switch>\n)","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-4","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): Accessor<TResult[]> & object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/solid-db/src/useLiveQuery.ts#L255","children":[{"type":"text","value":"useLiveQuery.ts:255"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Subscribe to an existing live query collection"}]},{"type":"heading","depth":3,"id":"type-parameters-4","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tresult","children":[{"type":"text","value":"TResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TResult"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":4,"id":"tkey","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":4,"id":"tutils","children":[{"type":"text","value":"TUtils"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TUtils"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"livequerycollection","children":[{"type":"text","value":"liveQueryCollection"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Collection"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TUtils"},{"type":"text","value":", "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TResult"},{"type":"text","value":"> & "},{"type":"inlineCode","value":"NonSingleResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Pre-created live query collection to subscribe to"}]},{"type":"heading","depth":3,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"Accessor that returns data with Suspense support, with state and status information as properties"}]},{"type":"heading","depth":3,"id":"examples-4","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Using pre-created live query collection\nconst myLiveQuery = createLiveQueryCollection((q) =>\n  q.from({ todos: todosCollection }).where(({ todos }) => eq(todos.active, true))\n)\nconst todosQuery = useLiveQuery(() => myLiveQuery)","lang":"ts"},{"type":"code","value":"// Access collection methods directly\nconst existingQuery = useLiveQuery(() => existingCollection)\n\n// Use collection for mutations\nconst handleToggle = (id) => {\n  existingQuery.collection.update(id, draft => { draft.completed = !draft.completed })\n}","lang":"ts"},{"type":"code","value":"// Handle states consistently\nconst sharedQuery = useLiveQuery(() => sharedCollection)\n\nreturn (\n <Switch fallback={<div><For each={sharedQuery()}>{(item) => <Item key={item.id} {...item} />}</For></div>}>\n   <Match when={sharedQuery.isLoading}>\n     <div>Loading...</div>\n   </Match>\n   <Match when={sharedQuery.isError}>\n     <div>Error loading data</div>\n   </Match>\n </Switch>\n)","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-5","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): Accessor<TResult | undefined> & object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/solid-db/src/useLiveQuery.ts#L283","children":[{"type":"text","value":"useLiveQuery.ts:283"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Create a live query using a query function"}]},{"type":"heading","depth":3,"id":"type-parameters-5","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tresult-2","children":[{"type":"text","value":"TResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TResult"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":4,"id":"tkey-2","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":4,"id":"tutils-2","children":[{"type":"text","value":"TUtils"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TUtils"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"livequerycollection-2","children":[{"type":"text","value":"liveQueryCollection"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Collection"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TUtils"},{"type":"text","value":", "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TResult"},{"type":"text","value":"> & "},{"type":"inlineCode","value":"SingleResult"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"Accessor that returns data with Suspense support, with state and status information as properties"}]},{"type":"heading","depth":3,"id":"examples-5","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic query with object syntax\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)","lang":"ts"},{"type":"code","value":"// With dependencies that trigger re-execution\nconst todosQuery = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority())),\n)","lang":"ts"},{"type":"code","value":"// Join pattern\nconst personIssues = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)","lang":"ts"},{"type":"code","value":"// Handle loading and error states\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Switch>\n    <Match when={todosQuery.isLoading}>\n      <div>Loading...</div>\n    </Match>\n    <Match when={todosQuery.isError}>\n      <div>Error: {todosQuery.status}</div>\n    </Match>\n    <Match when={todosQuery.isReady}>\n      <For each={todosQuery()}>\n        {(todo) => <li key={todo.id}>{todo.text}</li>}\n      </For>\n    </Match>\n  </Switch>\n)","lang":"ts"},{"type":"code","value":"// Use Suspense boundaries\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Suspense fallback={<div>Loading...</div>}>\n    <For each={todosQuery()}>\n      {(todo) => <li key={todo.id}>{todo.text}</li>}\n    </For>\n  </Suspense>\n)","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tcontext","text":"TContext","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"queryfn","text":"queryFn","level":4},{"id":"returns","text":"Returns","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tcontext-2","text":"TContext","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"queryfn-2","text":"queryFn","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"examples-2","text":"Examples","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tcontext-3","text":"TContext","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"config","text":"config","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"examples-3","text":"Examples","level":3},{"id":"call-signature-4","text":"Call Signature","level":2},{"id":"type-parameters-4","text":"Type Parameters","level":3},{"id":"tresult","text":"TResult","level":4},{"id":"tkey","text":"TKey","level":4},{"id":"tutils","text":"TUtils","level":4},{"id":"parameters-4","text":"Parameters","level":3},{"id":"livequerycollection","text":"liveQueryCollection","level":4},{"id":"returns-4","text":"Returns","level":3},{"id":"examples-4","text":"Examples","level":3},{"id":"call-signature-5","text":"Call Signature","level":2},{"id":"type-parameters-5","text":"Type Parameters","level":3},{"id":"tresult-2","text":"TResult","level":4},{"id":"tkey-2","text":"TKey","level":4},{"id":"tutils-2","text":"TUtils","level":4},{"id":"parameters-5","text":"Parameters","level":3},{"id":"livequerycollection-2","text":"liveQueryCollection","level":4},{"id":"returns-5","text":"Returns","level":3},{"id":"examples-5","text":"Examples","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(queryFn): Accessor<InferResultType<TContext>> & object;\n```\n\nDefined in: [useLiveQuery.ts:112](https://github.com/TanStack/db/blob/main/packages/solid-db/src/useLiveQuery.ts#L112)\n\nCreate a live query using a query function\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### queryFn\n\n(`q`) => `QueryBuilder`\\<`TContext`\\>\n\nQuery function that defines what data to fetch\n\n### Returns\n\nAccessor that returns data with Suspense support, with state and status information as properties\n\n### Examples\n\n```ts\n// Basic query with object syntax\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n```\n\n```ts\n// With dependencies that trigger re-execution\nconst todosQuery = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority())),\n)\n```\n\n```ts\n// Join pattern\nconst personIssues = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)\n```\n\n```ts\n// Handle loading and error states\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Switch>\n    <Match when={todosQuery.isLoading}>\n      <div>Loading...</div>\n    </Match>\n    <Match when={todosQuery.isError}>\n      <div>Error: {todosQuery.status}</div>\n    </Match>\n    <Match when={todosQuery.isReady}>\n      <For each={todosQuery()}>\n        {(todo) => <li key={todo.id}>{todo.text}</li>}\n      </For>\n    </Match>\n  </Switch>\n)\n```\n\n```ts\n// Use Suspense boundaries\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Suspense fallback={<div>Loading...</div>}>\n    <For each={todosQuery()}>\n      {(todo) => <li key={todo.id}>{todo.text}</li>}\n    </For>\n  </Suspense>\n)\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(queryFn): Accessor<InferConditionalResultType<TContext>> & object;\n```\n\nDefined in: [useLiveQuery.ts:134](https://github.com/TanStack/db/blob/main/packages/solid-db/src/useLiveQuery.ts#L134)\n\nCreate a live query using a query function\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### queryFn\n\n(`q`) => `QueryBuilder`\\<`TContext`\\> \\| `null` \\| `undefined`\n\nQuery function that defines what data to fetch\n\n### Returns\n\nAccessor that returns data with Suspense support, with state and status information as properties\n\n### Examples\n\n```ts\n// Basic query with object syntax\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n```\n\n```ts\n// With dependencies that trigger re-execution\nconst todosQuery = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority())),\n)\n```\n\n```ts\n// Join pattern\nconst personIssues = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)\n```\n\n```ts\n// Handle loading and error states\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Switch>\n    <Match when={todosQuery.isLoading}>\n      <div>Loading...</div>\n    </Match>\n    <Match when={todosQuery.isError}>\n      <div>Error: {todosQuery.status}</div>\n    </Match>\n    <Match when={todosQuery.isReady}>\n      <For each={todosQuery()}>\n        {(todo) => <li key={todo.id}>{todo.text}</li>}\n      </For>\n    </Match>\n  </Switch>\n)\n```\n\n```ts\n// Use Suspense boundaries\nconst todosQuery = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\nreturn (\n  <Suspense fallback={<div>Loading...</div>}>\n    <For each={todosQuery()}>\n      {(todo) => <li key={todo.id}>{todo.text}</li>}\n    </For>\n  </Suspense>\n)\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(config): Accessor<InferResultType<TContext>> & object;\n```\n\nDefined in: [useLiveQuery.ts:198](https://github.com/TanStack/db/blob/main/packages/solid-db/src/useLiveQuery.ts#L198)\n\nCreate a live query using configuration object\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### config\n\n`Accessor`\\<`LiveQueryCollectionConfig`\\<`TContext`, `RootQueryResult`\\<`TContext`\\>\\>\\>\n\nConfiguration object with query and options\n\n### Returns\n\nAccessor that returns data with Suspense support, with state and status information as properties\n\n### Examples\n\n```ts\n// Basic config object usage\nconst todosQuery = useLiveQuery(() => ({\n  query: (q) => q.from({ todos: todosCollection }),\n  gcTime: 60000\n}))\n```\n\n```ts\n// With query builder and options\nconst queryBuilder = new Query()\n  .from({ persons: collection })\n  .where(({ persons }) => gt(persons.age, 30))\n  .select(({ persons }) => ({ id: persons.id, name: persons.name }))\n\nconst personsQuery = useLiveQuery(() => ({ query: queryBuilder }))\n```\n\n```ts\n// Handle all states uniformly\nconst itemsQuery = useLiveQuery(() => ({\n  query: (q) => q.from({ items: itemCollection })\n}))\n\nreturn (\n  <Switch fallback={<div>{itemsQuery().length} items loaded</div>}>\n    <Match when={itemsQuery.isLoading}>\n      <div>Loading...</div>\n    </Match>\n    <Match when={itemsQuery.isError}>\n      <div>Something went wrong</div>\n    </Match>\n    <Match when={!itemsQuery.isReady}>\n      <div>Preparing...</div>\n    </Match>\n  </Switch>\n)\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): Accessor<TResult[]> & object;\n```\n\nDefined in: [useLiveQuery.ts:255](https://github.com/TanStack/db/blob/main/packages/solid-db/src/useLiveQuery.ts#L255)\n\nSubscribe to an existing live query collection\n\n### Type Parameters\n\n#### TResult\n\n`TResult` *extends* `object`\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number`\n\n#### TUtils\n\n`TUtils` *extends* `Record`\\<`string`, `any`\\>\n\n### Parameters\n\n#### liveQueryCollection\n\n`Accessor`\\<`Collection`\\<`TResult`, `TKey`, `TUtils`, `StandardSchemaV1`\\<`unknown`, `unknown`\\>, `TResult`\\> & `NonSingleResult`\\>\n\nPre-created live query collection to subscribe to\n\n### Returns\n\nAccessor that returns data with Suspense support, with state and status information as properties\n\n### Examples\n\n```ts\n// Using pre-created live query collection\nconst myLiveQuery = createLiveQueryCollection((q) =>\n  q.from({ todos: todosCollection }).where(({ todos }) => eq(todos.active, true))\n)\nconst todosQuery = useLiveQuery(() => myLiveQuery)\n```\n\n```ts\n// Access collection methods directly\nconst existingQuery = useLiveQuery(() => existingCollection)\n\n// Use collection for mutations\nconst handleToggle = (id) => {\n  existingQuery.collection.update(id, draft => { draft.completed = !draft.completed })\n}\n```\n\n```ts\n// Handle states consistently\nconst sharedQuery = useLiveQuery(() => sharedCollection)\n\nreturn (\n <Switch fallback={<div><For each={sharedQuery()}>{(item) => <Item key={item.id} {...item} />}</For></div>}>\n   <Match when={sharedQuery.isLoading}>\n     <div>Loading...</div>\n   </Match>\n   <Match when={sharedQuery.isError}>\n     <div>Error loading data</div>\n   </Match>\n </Switch>\n)\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): Accessor<TResult | undefined> & object;\n```\n\nDefined in: [useLiveQue