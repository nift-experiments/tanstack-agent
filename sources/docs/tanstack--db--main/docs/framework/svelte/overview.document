":"useLiveQuery"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":" utility creates a live query that automatically updates your component when data changes. It returns reactive values powered by Svelte 5 runes:"}]},{"type":"code","value":"<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n  import { eq } from '@tanstack/db'\n\n  const query = useLiveQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => eq(todos.completed, false))\n       .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  })\n</script>\n\n{#if query.isLoading}\n  <div>Loading...</div>\n{:else}\n  <ul>\n    {#each query.data as todo (todo.id)}\n      <li>{todo.text}</li>\n    {/each}\n  </ul>\n{/if}","lang":"svelte"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" With Svelte 5, "},{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":" returns reactive values through getters. Access "},{"type":"inlineCode","value":"query.data"},{"type":"text","value":" and "},{"type":"inlineCode","value":"query.isLoading"},{"type":"text","value":" directly (no "},{"type":"inlineCode","value":"$"},{"type":"text","value":" prefix needed)."}]},{"type":"heading","depth":3,"id":"useliveinfinitequery","children":[{"type":"text","value":"useLiveInfiniteQuery"}]},{"type":"paragraph","children":[{"type":"text","value":"For ordered, paginated data with live updates, use "},{"type":"inlineCode","value":"useLiveInfiniteQuery"},{"type":"text","value":":"}]},{"type":"code","value":"<script>\n  import { useLiveInfiniteQuery } from '@tanstack/svelte-db'\n  import { eq } from '@tanstack/db'\n\n  let category = $state('news')\n  const query = useLiveInfiniteQuery(\n    (q) =>\n      q\n        .from({ posts: postsCollection })\n        .where(({ posts }) => eq(posts.category, category))\n        .orderBy(({ posts }) => posts.createdAt, 'desc'),\n    { pageSize: 20 },\n    [() => category],\n  )\n</script>\n\n{#each query.data as post (post.id)}\n  <article>{post.title}</article>\n{/each}\n\n{#if query.hasNextPage}\n  <button\n    disabled={query.isFetchingNextPage}\n    onclick={() => query.fetchNextPage()}\n  >\n    Load more\n  </button>\n{/if}","lang":"svelte"},{"type":"paragraph","children":[{"type":"inlineCode","value":"fetchNextPage()"},{"type":"text","value":" returns a promise that resolves after the page request settles. Failures are exposed through "},{"type":"inlineCode","value":"query.error"},{"type":"text","value":" and do not reject the promise."}]},{"type":"paragraph","children":[{"type":"text","value":"The query must include "},{"type":"inlineCode","value":"orderBy"},{"type":"text","value":". The dependency array is available only with\nthe query-function form. You can also pass an ordered, pre-created live query\ncollection directly."}]},{"type":"heading","depth":3,"id":"query-identity","children":[{"type":"text","value":"Query Identity"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":" derives identity from structured query IR. Svelte also tracks\nreactive values read while building the query, so normal builder queries do not\nneed a dependency array or "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Captured props and state become part of the derived identity:"}]},{"type":"code","value":"<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n  import { gt } from '@tanstack/db'\n\n  let { minPriority } = $props()\n\n  const query = useLiveQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => gt(todos.priority, minPriority))\n  })\n</script>\n\n<div>{query.data.length} high-priority todos</div>","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"When the derived identity changes:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The previous live query collection is cleaned up"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A new query is created with the updated values"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The component re-renders with the new data"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The utility shows loading state again"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" for opaque functional variants such as "},{"type":"inlineCode","value":".fn.where"},{"type":"text","value":", because DB\ncannot inspect their closed-over values. Pass reactive key values through a\ngetter:"}]},{"type":"code","value":"<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n\n  let search = $state('ship')\n\n  const query = useLiveQuery({\n    queryKey: () => [todosCollection.id, 'search', search],\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .fn.where(({ todos }) => todos.title.includes(search))\n  })\n</script>","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"The legacy dependency array remains supported. Prefer derived identity for\nstructured queries and "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" for opaque ones."}]},{"type":"heading","depth":3,"id":"accessing-multiple-properties","children":[{"type":"text","value":"Accessing Multiple Properties"}]},{"type":"paragraph","children":[{"type":"text","value":"You can access all status properties directly on the query result:"}]},{"type":"code","value":"<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n  import { eq } from '@tanstack/db'\n\n  const query = useLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.active, true))\n  )\n</script>\n\n<div>\n  <div>Status: {query.status}</div>\n  <div>Loading: {query.isLoading}</div>\n  <div>Ready: {query.isReady}</div>\n  <div>Total: {query.data.length}</div>\n</div>","lang":"svelte"}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"svelte-utilities","text":"Svelte Utilities","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"dbprovider","text":"DbProvider","level":3},{"id":"uselivequery","text":"useLiveQuery","level":3},{"id":"useliveinfinitequery","text":"useLiveInfiniteQuery","level":3},{"id":"query-identity","text":"Query Identity","level":3},{"id":"accessing-multiple-properties","text":"Accessing Multiple Properties","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Installation\n\n```sh\nnpm install @tanstack/svelte-db\n```\n\n## Svelte Utilities\n\nSee the [Svelte Functions Reference](./reference/index.md) to see the full list of utilities available in the Svelte Adapter.\n\nFor comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the [Live Queries Guide](../../guides/live-queries).\n\n## Basic Usage\n\n### DbProvider\n\nUse one `DbClient` for each browser app and one per server request. `DbProvider`\nlets queries resolve collection descriptors against that client:\n\n```svelte\n<script lang=\"ts\">\n  import { DbClient, DbProvider } from '@tanstack/svelte-db'\n  import App from './App.svelte'\n\n  const client = new DbClient()\n</script>\n\n<DbProvider {client}>\n  <App />\n</DbProvider>\n```\n\nSee [SSR and Hydration](../../guides/ssr.md) for server preloading,\ndehydration, and snapshot handoff.\n\n### useLiveQuery\n\nThe `useLiveQuery` utility creates a live query that automatically updates your component when data changes. It returns reactive values powered by Svelte 5 runes:\n\n```svelte\n<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n  import { eq } from '@tanstack/db'\n\n  const query = useLiveQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => eq(todos.completed, false))\n       .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  })\n</script>\n\n{#if query.isLoading}\n  <div>Loading...</div>\n{:else}\n  <ul>\n    {#each query.data as todo (todo.id)}\n      <li>{todo.text}</li>\n    {/each}\n  </ul>\n{/if}\n```\n\n**Note:** With Svelte 5, `useLiveQuery` returns reactive values through getters. Access `query.data` and `query.isLoading` directly (no `$` prefix needed).\n\n### useLiveInfiniteQuery\n\nFor ordered, paginated data with live updates, use `useLiveInfiniteQuery`:\n\n```svelte\n<script>\n  import { useLiveInfiniteQuery } from '@tanstack/svelte-db'\n  import { eq } from '@tanstack/db'\n\n  let category = $state('news')\n  const query = useLiveInfiniteQuery(\n    (q) =>\n      q\n        .from({ posts: postsCollection })\n        .where(({ posts }) => eq(posts.category, category))\n        .orderBy(({ posts }) => posts.createdAt, 'desc'),\n    { pageSize: 20 },\n    [() => category],\n  )\n</script>\n\n{#each query.data as post (post.id)}\n  <article>{post.title}</article>\n{/each}\n\n{#if query.hasNextPage}\n  <button\n    disabled={query.isFetchingNextPage}\n    onclick={() => query.fetchNextPage()}\n  >\n    Load more\n  </button>\n{/if}\n```\n\n`fetchNextPage()` returns a promise that resolves after the page request settles. Failures are exposed through `query.error` and do not reject the promise.\n\nThe query must include `orderBy`. The dependency array is available only with\nthe query-function form. You can also pass an ordered, pre-created live query\ncollection directly.\n\n### Query Identity\n\n`useLiveQuery` derives identity from structured query IR. Svelte also tracks\nreactive values read while building the query, so normal builder queries do not\nneed a dependency array or `queryKey`.\n\nCaptured props and state become part of the derived identity:\n\n```svelte\n<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n  import { gt } from '@tanstack/db'\n\n  let { minPriority } = $props()\n\n  const query = useLiveQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => gt(todos.priority, minPriority))\n  })\n</script>\n\n<div>{query.data.length} high-priority todos</div>\n```\n\nWhen the derived identity changes:\n1. The previous live query collection is cleaned up\n2. A new query is created with the updated values\n3. The component re-renders with the new data\n4. The utility shows loading state again\n\nUse `queryKey` for opaque functional variants such as `.fn.where`, because DB\ncannot inspect their closed-over values. Pass reactive key values through a\ngetter:\n\n```svelte\n<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n\n  let search = $state('ship')\n\n  const query = useLiveQuery({\n    queryKey: () => [todosCollection.id, 'search', search],\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .fn.where(({ todos }) => todos.title.includes(search))\n  })\n</script>\n```\n\nThe legacy dependency array remains supported. Prefer derived identity for\nstructured queries and `queryKey` for opaque ones.\n\n### Accessing Multiple Properties\n\nYou can access all status properties directly on the query result:\n\n```svelte\n<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n  import { eq } from '@tanstack/db'\n\n  const query = useLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.active, true))\n  )\n</script>\n\n<div>\n  <div>Status: {query.status}</div>\n  <div>Loading: {query.isLoading}</div>\n  <div>Ready: {query.isReady}</div>\n  <div>Total: {query.data.length}</div>\n</div>\n```\n","originalRawMarkdown":"---\ntitle: TanStack DB Svelte Adapter\nid: adapter\n---\n\n## Installation\n\n```sh\nnpm install @tanstack/svelte-db\n```\n\n## Svelte Utilities\n\nSee the [Svelte Functions Reference](./reference/index.md) to see the full list of utilities available in the Svelte Adapter.\n\nFor comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the [Live Queries Guide](../../guides/live-queries).\n\n## Basic Usage\n\n### DbProvider\n\nUse one `DbClient` for each browser app and one per server request. `DbProvider`\nlets queries resolve collection descriptors against that client:\n\n```svelte\n<script lang=\"ts\">\n  import { DbClient, DbProvider } from '@tanstack/svelte-db'\n  import App from './App.svelte'\n\n  const client = new DbClient()\n</script>\n\n<DbProvider {client}>\n  <App />\n</DbProvider>\n```\n\nSee [SSR and Hydration](../../guides/ssr.md) for server preloading,\ndehydration, and snapshot handoff.\n\n### useLiveQuery\n\nThe `useLiveQuery` utility creates a live query that automatically updates your component when data changes. It returns reactive values powered by Svelte 5 runes:\n\n```svelte\n<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n  import { eq } from '@tanstack/db'\n\n  const query = useLiveQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => eq(todos.completed, false))\n       .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n  })\n</script>\n\n{#if query.isLoading}\n  <div>Loading...</div>\n{:else}\n  <ul>\n    {#each query.data as todo (todo.id)}\n      <li>{todo.text}</li>\n    {/each}\n  </ul>\n{/if}\n```\n\n**Note:** With Svelte 5, `useLiveQuery` returns reactive values through getters. Access `query.data` and `query.isLoading` directly (no `$` prefix needed).\n\n### useLiveInfiniteQuery\n\nFor ordered, paginated data with live updates, use `useLiveInfiniteQuery`:\n\n```svelte\n<script>\n  import { useLiveInfiniteQuery } from '@tanstack/svelte-db'\n  import { eq } from '@tanstack/db'\n\n  let category = $state('news')\n  const query = useLiveInfiniteQuery(\n    (q) =>\n      q\n        .from({ posts: postsCollection })\n        .where(({ posts }) => eq(posts.category, category))\n        .orderBy(({ posts }) => posts.createdAt, 'desc'),\n    { pageSize: 20 },\n    [() => category],\n  )\n</script>\n\n{#each query.data as post (post.id)}\n  <article>{post.title}</article>\n{/each}\n\n{#if query.hasNextPage}\n  <button\n    disabled={query.isFetchingNextPage}\n    onclick={() => query.fetchNextPage()}\n  >\n    Load more\n  </button>\n{/if}\n```\n\n`fetchNextPage()` returns a promise that resolves after the page request settles. Failures are exposed through `query.error` and do not reject the promise.\n\nThe query must include `orderBy`. The dependency array is available only with\nthe query-function form. You can also pass an ordered, pre-created live query\ncollection directly.\n\n### Query Identity\n\n`useLiveQuery` derives identity from structured query IR. Svelte also tracks\nreactive values read while building the query, so normal builder queries do not\nneed a dependency array or `queryKey`.\n\nCaptured props and state become part of the derived identity:\n\n```svelte\n<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n  import { gt } from '@tanstack/db'\n\n  let { minPriority } = $props()\n\n  const query = useLiveQuery({\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .where(({ todos }) => gt(todos.priority, minPriority))\n  })\n</script>\n\n<div>{query.data.length} high-priority todos</div>\n```\n\nWhen the derived identity changes:\n1. The previous live query collection is cleaned up\n2. A new query is created with the updated values\n3. The component re-renders with the new data\n4. The utility shows loading state again\n\nUse `queryKey` for opaque functional variants such as `.fn.where`, because DB\ncannot inspect their closed-over values. Pass reactive key values through a\ngetter:\n\n```svelte\n<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n\n  let search = $state('ship')\n\n  const query = useLiveQuery({\n    queryKey: () => [todosCollection.id, 'search', search],\n    query: (q) =>\n      q.from({ todos: todosCollection })\n       .fn.where(({ todos }) => todos.title.includes(search))\n  })\n</script>\n```\n\nThe legacy dependency array remains supported. Prefer derived identity for\nstructured queries and `queryKey` for opaque ones.\n\n### Accessing Multiple Properties\n\nYou can access all status properties directly on the query result:\n\n```svelte\n<script>\n  import { useLiveQuery } from '@tanstack/svelte-db'\n  import { eq } from '@tanstack/db'\n\n  const query = useLiveQuery((q) =>\n    q.from({ todos: todosCollection })\n     .where(({ todos }) => eq(todos.active, true))\n  )\n</script>\n\n<div>\n  <div>Status: {query.status}</div>\n  <div>Loading: {query.isLoading}</div>\n  <div>Ready: {query.isReady}</div>\n  <div>Total: {query.data.length}</div>\n</div>\n```\n"}
