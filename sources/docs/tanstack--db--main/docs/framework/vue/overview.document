{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"code","value":"npm install @tanstack/vue-db","lang":"sh"},{"type":"heading","depth":2,"id":"vue-composables","children":[{"type":"text","value":"Vue Composables"}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./reference/index.md","children":[{"type":"text","value":"Vue Functions Reference"}]},{"type":"text","value":" to see the full list of composables available in the Vue Adapter."}]},{"type":"paragraph","children":[{"type":"text","value":"For comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the "},{"type":"link","href":"../../guides/live-queries","children":[{"type":"text","value":"Live Queries Guide"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"heading","depth":3,"id":"uselivequery","children":[{"type":"text","value":"useLiveQuery"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":" composable creates a live query that automatically updates your component when data changes. It returns reactive computed refs:"}]},{"type":"code","value":"<script setup>\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n</script>\n\n<template>\n  <div v-if=\"isLoading\">Loading...</div>\n  <ul v-else>\n    <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n  </ul>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" All return values ("},{"type":"inlineCode","value":"data"},{"type":"text","value":", "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", "},{"type":"inlineCode","value":"status"},{"type":"text","value":", etc.) are computed refs, so access them with "},{"type":"inlineCode","value":".value"},{"type":"text","value":" in "},{"type":"inlineCode","value":"<script>"},{"type":"text","value":" but directly in "},{"type":"inlineCode","value":"<template>"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"useliveinfinitequery","children":[{"type":"text","value":"useLiveInfiniteQuery"}]},{"type":"paragraph","children":[{"type":"text","value":"For ordered, paginated data with live updates, use "},{"type":"inlineCode","value":"useLiveInfiniteQuery"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup>\nimport { ref } from 'vue'\nimport { useLiveInfiniteQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\nconst category = ref('news')\nconst { data, fetchNextPage, hasNextPage, isFetchingNextPage } =\n  useLiveInfiniteQuery(\n    (q) =>\n      q\n        .from({ posts: postsCollection })\n        .where(({ posts }) => eq(posts.category, category.value))\n        .orderBy(({ posts }) => posts.createdAt, 'desc'),\n    { pageSize: 20 },\n    [category],\n  )\n</script>\n\n<template>\n  <article v-for=\"post in data\" :key=\"post.id\">\n    {{ post.title }}\n  </article>\n  <button\n    v-if=\"hasNextPage\"\n    :disabled=\"isFetchingNextPage\"\n    @click=\"fetchNextPage()\"\n  >\n    Load more\n  </button>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"inlineCode","value":"fetchNextPage()"},{"type":"text","value":" returns a promise that resolves after the page request settles. Failures are exposed through the returned "},{"type":"inlineCode","value":"error"},{"type":"text","value":" ref and do not reject the promise."}]},{"type":"paragraph","children":[{"type":"text","value":"The query must include "},{"type":"inlineCode","value":"orderBy"},{"type":"text","value":". The dependency array is available only with\nthe query-function form. You can also pass an ordered, pre-created live query\ncollection directly."}]},{"type":"heading","depth":3,"id":"dependency-arrays","children":[{"type":"text","value":"Dependency Arrays"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":" composable accepts an optional dependency array as its last parameter. When any reactive value in the array changes, the query is recreated and re-executed."}]},{"type":"heading","depth":4,"id":"when-to-use-dependency-arrays","children":[{"type":"text","value":"When to Use Dependency Arrays"}]},{"type":"paragraph","children":[{"type":"text","value":"Use dependency arrays when your query depends on external reactive values (refs, props, or reactive objects):"}]},{"type":"code","value":"<script setup>\nimport { ref } from 'vue'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { gt } from '@tanstack/db'\n\nconst minPriority = ref(5)\n\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Pass the ref directly, it will be unwrapped automatically\n)\n</script>\n\n<template>\n  <div>{{ data.length }} high-priority todos</div>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Important:"}]},{"type":"text","value":" Pass refs directly in the dependency array, not as functions. Vue will automatically track them."}]},{"type":"heading","depth":4,"id":"what-happens-when-dependencies-change","children":[{"type":"text","value":"What Happens When Dependencies Change"}]},{"type":"paragraph","children":[{"type":"text","value":"When a dependency value changes:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The previous live query collection is cleaned up"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A new query is created with the updated values"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The component re-renders with the new data"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The composable shows loading state again"}]}]}]},{"type":"heading","depth":4,"id":"best-practices","children":[{"type":"text","value":"Best Practices"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Include all external refs used in the query:"}]}]},{"type":"code","value":"<script setup>\nimport { ref } from 'vue'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq, and } from '@tanstack/db'\n\nconst userId = ref(1)\nconst status = ref('active')\n\n// Good - all refs in deps array\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => and(\n           eq(todos.userId, userId.value),\n           eq(todos.status, status.value)\n         )),\n  [userId, status] // Pass refs directly\n)\n\n// Bad - missing dependencies\nconst { data: badData } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.userId, userId.value)),\n  [] // Missing userId!\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Using with props:"}]}]},{"type":"code","value":"<script setup>\nimport { toRef } from 'vue'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\nconst props = defineProps<{ userId: number }>()\n\n// Option 1: Convert prop to ref\nconst userIdRef = toRef(props, 'userId')\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.userId, userIdRef.value)),\n  [userIdRef]\n)\n\n// Option 2: Use a getter function for the prop\nconst { data: data2 } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.userId, props.userId)),\n  [() => props.userId] // Getter function for non-ref values\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Empty array for static queries:"}]}]},{"type":"code","value":"<script setup>\nimport { useLiveQuery } from '@tanstack/vue-db'\n\n// No external dependencies - query never changes\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection }),\n  []\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Omit the array for queries with no external dependencies:"}]}]},{"type":"code","value":"<script setup>\nimport { useLiveQuery } from '@tanstack/vue-db'\n\n// Same as above - no deps needed\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>","lang":"vue"},{"type":"heading","depth":3,"id":"using-pre-created-collections","children":[{"type":"text","value":"Using Pre-created Collections"}]},{"type":"paragraph","children":[{"type":"text","value":"You can also pass an existing collection to "},{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":". This is useful for sharing queries across components:"}]},{"type":"code","value":"<script setup>\nimport { ref } from 'vue'\nimport { createLiveQueryCollection } from '@tanstack/db'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\n// Create collection outside component or in a composable\nconst todosQuery = createLiveQueryCollection({\n  query: (q) => q.from({ todos: todosCollection })\n               .where(({ todos }) => eq(todos.active, true)),\n  startSync: true\n})\n\n// Use the pre-created collection\nconst { data, collection } = useLiveQuery(todosQuery)\n\n// Or use a reactive ref to switch between collections\nconst currentQuery = ref(todosQuery)\nconst { data: reactiveData } = useLiveQuery(currentQuery)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>","lang":"vue"}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"vue-composables","text":"Vue Composables","level":2},{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"uselivequery","text":"useLiveQuery","level":3},{"id":"useliveinfinitequery","text":"useLiveInfiniteQuery","level":3},{"id":"dependency-arrays","text":"Dependency Arrays","level":3},{"id":"when-to-use-dependency-arrays","text":"When to Use Dependency Arrays","level":4},{"id":"what-happens-when-dependencies-change","text":"What Happens When Dependencies Change","level":4},{"id":"best-practices","text":"Best Practices","level":4},{"id":"using-pre-created-collections","text":"Using Pre-created Collections","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Installation\n\n```sh\nnpm install @tanstack/vue-db\n```\n\n## Vue Composables\n\nSee the [Vue Functions Reference](./reference/index.md) to see the full list of composables available in the Vue Adapter.\n\nFor comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the [Live Queries Guide](../../guides/live-queries).\n\n## Basic Usage\n\n### useLiveQuery\n\nThe `useLiveQuery` composable creates a live query that automatically updates your component when data changes. It returns reactive computed refs:\n\n```vue\n<script setup>\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n</script>\n\n<template>\n  <div v-if=\"isLoading\">Loading...</div>\n  <ul v-else>\n    <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n  </ul>\n</template>\n```\n\n**Note:** All return values (`data`, `isLoading`, `status`, etc.) are computed refs, so access them with `.value` in `<script>` but directly in `<template>`.\n\n### useLiveInfiniteQuery\n\nFor ordered, paginated data with live updates, use `useLiveInfiniteQuery`:\n\n```vue\n<script setup>\nimport { ref } from 'vue'\nimport { useLiveInfiniteQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\nconst category = ref('news')\nconst { data, fetchNextPage, hasNextPage, isFetchingNextPage } =\n  useLiveInfiniteQuery(\n    (q) =>\n      q\n        .from({ posts: postsCollection })\n        .where(({ posts }) => eq(posts.category, category.value))\n        .orderBy(({ posts }) => posts.createdAt, 'desc'),\n    { pageSize: 20 },\n    [category],\n  )\n</script>\n\n<template>\n  <article v-for=\"post in data\" :key=\"post.id\">\n    {{ post.title }}\n  </article>\n  <button\n    v-if=\"hasNextPage\"\n    :disabled=\"isFetchingNextPage\"\n    @click=\"fetchNextPage()\"\n  >\n    Load more\n  </button>\n</template>\n```\n\n`fetchNextPage()` returns a promise that resolves after the page request settles. Failures are exposed through the returned `error` ref and do not reject the promise.\n\nThe query must include `orderBy`. The dependency array is available only with\nthe query-function form. You can also pass an ordered, pre-created live query\ncollection directly.\n\n### Dependency Arrays\n\nThe `useLiveQuery` composable accepts an optional dependency array as its last parameter. When any reactive value in the array changes, the query is recreated and re-executed.\n\n#### When to Use Dependency Arrays\n\nUse dependency arrays when your query depends on external reactive values (refs, props, or reactive objects):\n\n```vue\n<script setup>\nimport { ref } from 'vue'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { gt } from '@tanstack/db'\n\nconst minPriority = ref(5)\n\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Pass the ref directly, it will be unwrapped automatically\n)\n</script>\n\n<template>\n  <div>{{ data.length }} high-priority todos</div>\n</template>\n```\n\n**Important:** Pass refs directly in the dependency array, not as functions. Vue will automatically track them.\n\n#### What Happens When Dependencies Change\n\nWhen a dependency value changes:\n1. The previous live query collection is cleaned up\n2. A new query is created with the updated values\n3. The component re-renders with the new data\n4. The composable shows loading state again\n\n#### Best Practices\n\n**Include all external refs used in the query:**\n\n```vue\n<script setup>\nimport { ref } from 'vue'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq, and } from '@tanstack/db'\n\nconst userId = ref(1)\nconst status = ref('active')\n\n// Good - all refs in deps array\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => and(\n           eq(todos.userId, userId.value),\n           eq(todos.status, status.value)\n         )),\n  [userId, status] // Pass refs directly\n)\n\n// Bad - missing dependencies\nconst { data: badData } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.userId, userId.value)),\n  [] // Missing userId!\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n\n**Using with props:**\n\n```vue\n<script setup>\nimport { toRef } from 'vue'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\nconst props = defineProps<{ userId: number }>()\n\n// Option 1: Convert prop to ref\nconst userIdRef = toRef(props, 'userId')\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.userId, userIdRef.value)),\n  [userIdRef]\n)\n\n// Option 2: Use a getter function for the prop\nconst { data: data2 } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.userId, props.userId)),\n  [() => props.userId] // Getter function for non-ref values\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n\n**Empty array for static queries:**\n\n```vue\n<script setup>\nimport { useLiveQuery } from '@tanstack/vue-db'\n\n// No external dependencies - query never changes\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection }),\n  []\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n\n**Omit the array for queries with no external dependencies:**\n\n```vue\n<script setup>\nimport { useLiveQuery } from '@tanstack/vue-db'\n\n// Same as above - no deps needed\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n\n### Using Pre-created Collections\n\nYou can also pass an existing collection to `useLiveQuery`. This is useful for sharing queries across components:\n\n```vue\n<script setup>\nimport { ref } from 'vue'\nimport { createLiveQueryCollection } from '@tanstack/db'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\n// Create collection outside component or in a composable\nconst todosQuery = createLiveQueryCollection({\n  query: (q) => q.from({ todos: todosCollection })\n               .where(({ todos }) => eq(todos.active, true)),\n  startSync: true\n})\n\n// Use the pre-created collection\nconst { data, collection } = useLiveQuery(todosQuery)\n\n// Or use a reactive ref to switch between collections\nconst currentQuery = ref(todosQuery)\nconst { data: reactiveData } = useLiveQuery(currentQuery)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n","originalRawMarkdown":"---\ntitle: TanStack DB Vue Adapter\nid: adapter\n---\n\n## Installation\n\n```sh\nnpm install @tanstack/vue-db\n```\n\n## Vue Composables\n\nSee the [Vue Functions Reference](./reference/index.md) to see the full list of composables available in the Vue Adapter.\n\nFor comprehensive documentation on writing queries (filtering, joins, aggregations, etc.), see the [Live Queries Guide](../../guides/live-queries).\n\n## Basic Usage\n\n### useLiveQuery\n\nThe `useLiveQuery` composable creates a live query that automatically updates your component when data changes. It returns reactive computed refs:\n\n```vue\n<script setup>\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n</script>\n\n<template>\n  <div v-if=\"isLoading\">Loading...</div>\n  <ul v-else>\n    <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n  </ul>\n</template>\n```\n\n**Note:** All return values (`data`, `isLoading`, `status`, etc.) are computed refs, so access them with `.value` in `<script>` but directly in `<template>`.\n\n### useLiveInfiniteQuery\n\nFor ordered, paginated data with live updates, use `useLiveInfiniteQuery`:\n\n```vue\n<script setup>\nimport { ref } from 'vue'\nimport { useLiveInfiniteQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\nconst category = ref('news')\nconst { data, fetchNextPage, hasNextPage, isFetchingNextPage } =\n  useLiveInfiniteQuery(\n    (q) =>\n      q\n        .from({ posts: postsCollection })\n        .where(({ posts }) => eq(posts.category, category.value))\n        .orderBy(({ posts }) => posts.createdAt, 'desc'),\n    { pageSize: 20 },\n    [category],\n  )\n</script>\n\n<template>\n  <article v-for=\"post in data\" :key=\"post.id\">\n    {{ post.title }}\n  </article>\n  <button\n    v-if=\"hasNextPage\"\n    :disabled=\"isFetchingNextPage\"\n    @click=\"fetchNextPage()\"\n  >\n    Load more\n  </button>\n</template>\n```\n\n`fetchNextPage()` returns a promise that resolves after the page request settles. Failures are exposed through the returned `error` ref and do not reject the promise.\n\nThe query must include `orderBy`. The dependency array is available only with\nthe query-function form. You can also pass an ordered, pre-created live query\ncollection directly.\n\n### Dependency Arrays\n\nThe `useLiveQuery` composable accepts an optional dependency array as its last parameter. When any reactive value in the array changes, the query is recreated and re-executed.\n\n#### When to Use Dependency Arrays\n\nUse dependency arrays when your query depends on external reactive values (refs, props, or reactive objects):\n\n```vue\n<script setup>\nimport { ref } from 'vue'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { gt } from '@tanstack/db'\n\nconst minPriority = ref(5)\n\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Pass the ref directly, it will be unwrapped automatically\n)\n</script>\n\n<template>\n  <div>{{ data.length }} high-priority todos</div>\n</template>\n```\n\n**Important:** Pass refs directly in the dependency array, not as functions. Vue will automatically track them.\n\n#### What Happens When Dependencies Change\n\nWhen a dependency value changes:\n1. The previous live query collection is cleaned up\n2. A new query is created with the updated values\n3. The component re-renders with the new data\n4. The composable shows loading state again\n\n#### Best Practices\n\n**Include all external refs used in the query:**\n\n```vue\n<script setup>\nimport { ref } from 'vue'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq, and } from '@tanstack/db'\n\nconst userId = ref(1)\nconst status = ref('active')\n\n// Good - all refs in deps array\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => and(\n           eq(todos.userId, userId.value),\n           eq(todos.status, status.value)\n         )),\n  [userId, status] // Pass refs directly\n)\n\n// Bad - missing dependencies\nconst { data: badData } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.userId, userId.value)),\n  [] // Missing userId!\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n\n**Using with props:**\n\n```vue\n<script setup>\nimport { toRef } from 'vue'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\nconst props = defineProps<{ userId: number }>()\n\n// Option 1: Convert prop to ref\nconst userIdRef = toRef(props, 'userId')\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.userId, userIdRef.value)),\n  [userIdRef]\n)\n\n// Option 2: Use a getter function for the prop\nconst { data: data2 } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => eq(todos.userId, props.userId)),\n  [() => props.userId] // Getter function for non-ref values\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n\n**Empty array for static queries:**\n\n```vue\n<script setup>\nimport { useLiveQuery } from '@tanstack/vue-db'\n\n// No external dependencies - query never changes\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection }),\n  []\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n\n**Omit the array for queries with no external dependencies:**\n\n```vue\n<script setup>\nimport { useLiveQuery } from '@tanstack/vue-db'\n\n// Same as above - no deps needed\nconst { data } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n\n### Using Pre-created Collections\n\nYou can also pass an existing collection to `useLiveQuery`. This is useful for sharing queries across components:\n\n```vue\n<script setup>\nimport { ref } from 'vue'\nimport { createLiveQueryCollection } from '@tanstack/db'\nimport { useLiveQuery } from '@tanstack/vue-db'\nimport { eq } from '@tanstack/db'\n\n// Create collection outside component or in a composable\nconst todosQuery = createLiveQueryCollection({\n  query: (q) => q.from({ todos: todosCollection })\n               .where(({ todos }) => eq(todos.active, true)),\n  startSync: true\n})\n\n// Use the pre-created collection\nconst { data, collection } = useLiveQuery(todosQuery)\n\n// Or use a reactive ref to switch between collections\nconst currentQuery = ref(todosQuery)\nconst { data: reactiveData } = useLiveQuery(currentQuery)\n</script>\n\n<template>\n  <div>{{ data.length }} todos</div>\n</template>\n```\n"}
