e":"paragraph","children":[{"type":"text","value":"Pre-created query collection to subscribe to (can be a ref)"}]},{"type":"heading","depth":3,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/UseLiveQueryReturnWithCollection.md","children":[{"type":"inlineCode","value":"UseLiveQueryReturnWithCollection"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TUtils"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Reactive object with query data, state, and status information"}]},{"type":"heading","depth":3,"id":"examples-4","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Using pre-created query collection\nconst myLiveQuery = createLiveQueryCollection((q) =>\n  q.from({ todos: todosCollection }).where(({ todos }) => eq(todos.active, true))\n)\nconst { data, collection } = useLiveQuery(myLiveQuery)","lang":"ts"},{"type":"code","value":"// Reactive query collection reference\nconst selectedQuery = ref(todosQuery)\nconst { data, collection } = useLiveQuery(selectedQuery)\n\n// Switch queries reactively\nselectedQuery.value = archiveQuery","lang":"ts"},{"type":"code","value":"// Access query collection methods directly\nconst { data, collection, isReady } = useLiveQuery(existingQuery)\n\n// Use underlying collection for mutations\nconst handleToggle = (id) => {\n  collection.value.update(id, draft => { draft.completed = !draft.completed })\n}","lang":"ts"},{"type":"code","value":"// Handle states consistently\nconst { data, isLoading, isError } = useLiveQuery(sharedQuery)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error loading data</div>\n// <div v-else>\n//   <Item v-for=\"item in data\" :key=\"item.id\" v-bind=\"item\" />\n// </div>","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-5","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): UseLiveQueryReturnWithSingleResultCollection<TResult, TKey, TUtils>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L272","children":[{"type":"text","value":"useLiveQuery.ts:272"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Create a live query using a query function"}]},{"type":"heading","depth":3,"id":"type-parameters-5","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tresult-2","children":[{"type":"text","value":"TResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TResult"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":4,"id":"tkey-2","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":4,"id":"tutils-2","children":[{"type":"text","value":"TUtils"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TUtils"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"livequerycollection-2","children":[{"type":"text","value":"liveQueryCollection"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefOrGetter"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Collection"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TUtils"},{"type":"text","value":", "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TResult"},{"type":"text","value":"> & "},{"type":"inlineCode","value":"SingleResult"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/UseLiveQueryReturnWithSingleResultCollection.md","children":[{"type":"inlineCode","value":"UseLiveQueryReturnWithSingleResultCollection"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TUtils"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Reactive object with query data, state, and status information"}]},{"type":"heading","depth":3,"id":"examples-5","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic query with object syntax\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)","lang":"ts"},{"type":"code","value":"// With reactive dependencies\nconst minPriority = ref(5)\nconst { data, state } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Re-run when minPriority changes\n)","lang":"ts"},{"type":"code","value":"// Join pattern\nconst { data } = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)","lang":"ts"},{"type":"code","value":"// Handle loading and error states in template\nconst { data, isLoading, isError, status } = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error: {{ status }}</div>\n// <ul v-else>\n//   <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n// </ul>","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tcontext","text":"TContext","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"queryfn","text":"queryFn","level":4},{"id":"deps","text":"deps?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tcontext-2","text":"TContext","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"queryfn-2","text":"queryFn","level":4},{"id":"deps-2","text":"deps?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"examples-2","text":"Examples","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tcontext-3","text":"TContext","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"config","text":"config","level":4},{"id":"deps-3","text":"deps?","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"examples-3","text":"Examples","level":3},{"id":"call-signature-4","text":"Call Signature","level":2},{"id":"type-parameters-4","text":"Type Parameters","level":3},{"id":"tresult","text":"TResult","level":4},{"id":"tkey","text":"TKey","level":4},{"id":"tutils","text":"TUtils","level":4},{"id":"parameters-4","text":"Parameters","level":3},{"id":"livequerycollection","text":"liveQueryCollection","level":4},{"id":"returns-4","text":"Returns","level":3},{"id":"examples-4","text":"Examples","level":3},{"id":"call-signature-5","text":"Call Signature","level":2},{"id":"type-parameters-5","text":"Type Parameters","level":3},{"id":"tresult-2","text":"TResult","level":4},{"id":"tkey-2","text":"TKey","level":4},{"id":"tutils-2","text":"TUtils","level":4},{"id":"parameters-5","text":"Parameters","level":3},{"id":"livequerycollection-2","text":"liveQueryCollection","level":4},{"id":"returns-5","text":"Returns","level":3},{"id":"examples-5","text":"Examples","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(queryFn, deps?): UseLiveQueryReturn<TContext>;\n```\n\nDefined in: [useLiveQuery.ts:170](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L170)\n\nCreate a live query using a query function\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### queryFn\n\n(`q`) => `QueryBuilder`\\<`TContext`\\>\n\nQuery function that defines what data to fetch\n\n#### deps?\n\n`unknown`[]\n\nArray of reactive dependencies that trigger query re-execution when changed\n\n### Returns\n\n[`UseLiveQueryReturn`](../interfaces/UseLiveQueryReturn.md)\\<`TContext`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Basic query with object syntax\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n```\n\n```ts\n// With reactive dependencies\nconst minPriority = ref(5)\nconst { data, state } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Re-run when minPriority changes\n)\n```\n\n```ts\n// Join pattern\nconst { data } = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)\n```\n\n```ts\n// Handle loading and error states in template\nconst { data, isLoading, isError, status } = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error: {{ status }}</div>\n// <ul v-else>\n//   <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n// </ul>\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(queryFn, deps?): ConditionalUseLiveQueryReturn<TContext>;\n```\n\nDefined in: [useLiveQuery.ts:176](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L176)\n\nCreate a live query using a query function\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### queryFn\n\n(`q`) => `QueryBuilder`\\<`TContext`\\> \\| `null` \\| `undefined`\n\nQuery function that defines what data to fetch\n\n#### deps?\n\n`unknown`[]\n\nArray of reactive dependencies that trigger query re-execution when changed\n\n### Returns\n\n[`ConditionalUseLiveQueryReturn`](../type-aliases/ConditionalUseLiveQueryReturn.md)\\<`TContext`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Basic query with object syntax\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n```\n\n```ts\n// With reactive dependencies\nconst minPriority = ref(5)\nconst { data, state } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Re-run when minPriority changes\n)\n```\n\n```ts\n// Join pattern\nconst { data } = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)\n```\n\n```ts\n// Handle loading and error states in template\nconst { data, isLoading, isError, status } = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error: {{ status }}</div>\n// <ul v-else>\n//   <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n// </ul>\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(config, deps?): UseLiveQueryReturn<TContext>;\n```\n\nDefined in: [useLiveQuery.ts:216](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L216)\n\nCreate a live query using configuration object\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### config\n\n`LiveQueryCollectionConfig`\\<`TContext`\\>\n\nConfiguration object with query and options\n\n#### deps?\n\n`unknown`[]\n\nArray of reactive dependencies that trigger query re-execution when changed\n\n### Returns\n\n[`UseLiveQueryReturn`](../interfaces/UseLiveQueryReturn.md)\\<`TContext`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Basic config object usage\nconst { data, status } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection }),\n  gcTime: 60000\n})\n```\n\n```ts\n// With reactive dependencies\nconst filter = ref('active')\nconst { data, isReady } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection })\n                 .where(({ todos }) => eq(todos.status, filter.value))\n}, [filter])\n```\n\n```ts\n// Handle all states uniformly\nconst { data, isLoading, isReady, isError } = useLiveQuery({\n  query: (q) => q.from({ items: itemCollection })\n})\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Something went wrong</div>\n// <div v-else-if=\"!isReady\">Preparing...</div>\n// <div v-else>{{ data.length }} items loaded</div>\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): UseLiveQueryReturnWithCollection<TResult, TKey, TUtils>;\n```\n\nDefined in: [useLiveQuery.ts:261](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L261)\n\nSubscribe to an existing query collection (can be reactive)\n\n### Type Parameters\n\n#### TResult\n\n`TResult` *extends* `object`\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number`\n\n#### TUtils\n\n`TUtils` *extends* `Record`\\<`string`, `any`\\>\n\n### Parameters\n\n#### liveQueryCollection\n\n`MaybeRefOrGetter`\\<`Collection`\\<`TResult`, `TKey`, `TUtils`, `StandardSchemaV1`\\<`unknown`, `unknown`\\>, `TResult`\\> & `NonSingleResult`\\>\n\nPre-created query collection to subscribe to (can be a ref)\n\n### Returns\n\n[`UseLiveQueryReturnWithCollection`](../interfaces/UseLiveQueryReturnWithCollection.md)\\<`TResult`, `TKey`, `TUtils`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Using pre-created query collection\nconst myLiveQuery = createLiveQueryCollection((q) =>\n  q.from({ todos: todosCollection }).where(({ todos }) => eq(todos.active, true))\n)\nconst { data, collection } = useLiveQuery(myLiveQuery)\n```\n\n```ts\n// Reactive query collection reference\nconst selectedQuery = ref(todosQuery)\nconst { data, collection } = useLiveQuery(selectedQuery)\n\n// Switch queries reactively\nselectedQuery.value = archiveQuery\n```\n\n```ts\n// Access query collection methods directly\nconst { data, collection, isReady } = useLiveQuery(existingQuery)\n\n// Use underlying collection for mutations\nconst handleToggle = (id) => {\n  collection.value.update(id, draft => { draft.completed = !draft.completed })\n}\n```\n\n```ts\n// Handle states consistently\nconst { data, isLoading, isError } = useLiveQuery(sharedQuery)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error loading data</div>\n// <div v-else>\n//   <Item v-for=\"item in data\" :key=\"item.id\" v-bind=\"item\" />\n// </div>\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): UseLiveQueryReturnWithSingleResultCollection<TResult, TKey, TUtils>;\n```\n\nDefined in: [useLiveQuery.ts:272](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L272)\n\nCreate a live query using a query function\n\n### Type Parameters\n\n#### TResult\n\n`TResult` *extends* `object`\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number`\n\n#### TUtils\n\n`TUtils` *extends* `Record`\\<`string`, `any`\\>\n\n### Parameters\n\n#### liveQueryCollection\n\n`MaybeRefOrGetter`\\<`Collection`\\<`TResult`, `TKey`, `TUtils`, `StandardSchemaV1`\\<`unknown`, `unknown`\\>, `TResult`\\> & `SingleResult`\\>\n\n### Returns\n\n[`UseLiveQueryReturnWithSingleResultCollection`](../interfaces/UseLiveQueryReturnWithSingleResultCollection.md)\\<`TResult`, `TKey`, `TUtils`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Basic query with object syntax\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n```\n\n```ts\n// With reactive dependencies\nconst minPriority = ref(5)\nconst { data, state } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Re-run when minPriority changes\n)\n```\n\n```ts\n// Join pattern\nconst { data } = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)\n```\n\n```ts\n// Handle loading and error states in template\nconst { data, isLoading, isError, status } = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error: {{ status }}</div>\n// <ul v-else>\n//   <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n// </ul>\n```\n","originalRawMarkdown":"---\nid: useLiveQuery\ntitle: useLiveQuery\n---\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(queryFn, deps?): UseLiveQueryReturn<TContext>;\n```\n\nDefined in: [useLiveQuery.ts:170](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L170)\n\nCreate a live query using a query function\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### queryFn\n\n(`q`) => `QueryBuilder`\\<`TContext`\\>\n\nQuery function that defines what data to fetch\n\n#### deps?\n\n`unknown`[]\n\nArray of reactive dependencies that trigger query re-execution when changed\n\n### Returns\n\n[`UseLiveQueryReturn`](../interfaces/UseLiveQueryReturn.md)\\<`TContext`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Basic query with object syntax\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n```\n\n```ts\n// With reactive dependencies\nconst minPriority = ref(5)\nconst { data, state } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Re-run when minPriority changes\n)\n```\n\n```ts\n// Join pattern\nconst { data } = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)\n```\n\n```ts\n// Handle loading and error states in template\nconst { data, isLoading, isError, status } = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error: {{ status }}</div>\n// <ul v-else>\n//   <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n// </ul>\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(queryFn, deps?): ConditionalUseLiveQueryReturn<TContext>;\n```\n\nDefined in: [useLiveQuery.ts:176](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L176)\n\nCreate a live query using a query function\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### queryFn\n\n(`q`) => `QueryBuilder`\\<`TContext`\\> \\| `null` \\| `undefined`\n\nQuery function that defines what data to fetch\n\n#### deps?\n\n`unknown`[]\n\nArray of reactive dependencies that trigger query re-execution when changed\n\n### Returns\n\n[`ConditionalUseLiveQueryReturn`](../type-aliases/ConditionalUseLiveQueryReturn.md)\\<`TContext`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Basic query with object syntax\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n```\n\n```ts\n// With reactive dependencies\nconst minPriority = ref(5)\nconst { data, state } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Re-run when minPriority changes\n)\n```\n\n```ts\n// Join pattern\nconst { data } = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)\n```\n\n```ts\n// Handle loading and error states in template\nconst { data, isLoading, isError, status } = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error: {{ status }}</div>\n// <ul v-else>\n//   <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n// </ul>\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TContext>(config, deps?): UseLiveQueryReturn<TContext>;\n```\n\nDefined in: [useLiveQuery.ts:216](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L216)\n\nCreate a live query using configuration object\n\n### Type Parameters\n\n#### TContext\n\n`TContext` *extends* `Context`\n\n### Parameters\n\n#### config\n\n`LiveQueryCollectionConfig`\\<`TContext`\\>\n\nConfiguration object with query and options\n\n#### deps?\n\n`unknown`[]\n\nArray of reactive dependencies that trigger query re-execution when changed\n\n### Returns\n\n[`UseLiveQueryReturn`](../interfaces/UseLiveQueryReturn.md)\\<`TContext`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Basic config object usage\nconst { data, status } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection }),\n  gcTime: 60000\n})\n```\n\n```ts\n// With reactive dependencies\nconst filter = ref('active')\nconst { data, isReady } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection })\n                 .where(({ todos }) => eq(todos.status, filter.value))\n}, [filter])\n```\n\n```ts\n// Handle all states uniformly\nconst { data, isLoading, isReady, isError } = useLiveQuery({\n  query: (q) => q.from({ items: itemCollection })\n})\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Something went wrong</div>\n// <div v-else-if=\"!isReady\">Preparing...</div>\n// <div v-else>{{ data.length }} items loaded</div>\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): UseLiveQueryReturnWithCollection<TResult, TKey, TUtils>;\n```\n\nDefined in: [useLiveQuery.ts:261](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L261)\n\nSubscribe to an existing query collection (can be reactive)\n\n### Type Parameters\n\n#### TResult\n\n`TResult` *extends* `object`\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number`\n\n#### TUtils\n\n`TUtils` *extends* `Record`\\<`string`, `any`\\>\n\n### Parameters\n\n#### liveQueryCollection\n\n`MaybeRefOrGetter`\\<`Collection`\\<`TResult`, `TKey`, `TUtils`, `StandardSchemaV1`\\<`unknown`, `unknown`\\>, `TResult`\\> & `NonSingleResult`\\>\n\nPre-created query collection to subscribe to (can be a ref)\n\n### Returns\n\n[`UseLiveQueryReturnWithCollection`](../interfaces/UseLiveQueryReturnWithCollection.md)\\<`TResult`, `TKey`, `TUtils`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Using pre-created query collection\nconst myLiveQuery = createLiveQueryCollection((q) =>\n  q.from({ todos: todosCollection }).where(({ todos }) => eq(todos.active, true))\n)\nconst { data, collection } = useLiveQuery(myLiveQuery)\n```\n\n```ts\n// Reactive query collection reference\nconst selectedQuery = ref(todosQuery)\nconst { data, collection } = useLiveQuery(selectedQuery)\n\n// Switch queries reactively\nselectedQuery.value = archiveQuery\n```\n\n```ts\n// Access query collection methods directly\nconst { data, collection, isReady } = useLiveQuery(existingQuery)\n\n// Use underlying collection for mutations\nconst handleToggle = (id) => {\n  collection.value.update(id, draft => { draft.completed = !draft.completed })\n}\n```\n\n```ts\n// Handle states consistently\nconst { data, isLoading, isError } = useLiveQuery(sharedQuery)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error loading data</div>\n// <div v-else>\n//   <Item v-for=\"item in data\" :key=\"item.id\" v-bind=\"item\" />\n// </div>\n```\n\n## Call Signature\n\n```ts\nfunction useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): UseLiveQueryReturnWithSingleResultCollection<TResult, TKey, TUtils>;\n```\n\nDefined in: [useLiveQuery.ts:272](https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L272)\n\nCreate a live query using a query function\n\n### Type Parameters\n\n#### TResult\n\n`TResult` *extends* `object`\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number`\n\n#### TUtils\n\n`TUtils` *extends* `Record`\\<`string`, `any`\\>\n\n### Parameters\n\n#### liveQueryCollection\n\n`MaybeRefOrGetter`\\<`Collection`\\<`TResult`, `TKey`, `TUtils`, `StandardSchemaV1`\\<`unknown`, `unknown`\\>, `TResult`\\> & `SingleResult`\\>\n\n### Returns\n\n[`UseLiveQueryReturnWithSingleResultCollection`](../interfaces/UseLiveQueryReturnWithSingleResultCollection.md)\\<`TResult`, `TKey`, `TUtils`\\>\n\nReactive object with query data, state, and status information\n\n### Examples\n\n```ts\n// Basic query with object syntax\nconst { data, isLoading } = useLiveQuery((q) =>\n  q.from({ todos: todosCollection })\n   .where(({ todos }) => eq(todos.completed, false))\n   .select(({ todos }) => ({ id: todos.id, text: todos.text }))\n)\n```\n\n```ts\n// With reactive dependencies\nconst minPriority = ref(5)\nconst { data, state } = useLiveQuery(\n  (q) => q.from({ todos: todosCollection })\n         .where(({ todos }) => gt(todos.priority, minPriority.value)),\n  [minPriority] // Re-run when minPriority changes\n)\n```\n\n```ts\n// Join pattern\nconst { data } = useLiveQuery((q) =>\n  q.from({ issues: issueCollection })\n   .join({ persons: personCollection }, ({ issues, persons }) =>\n     eq(issues.userId, persons.id)\n   )\n   .select(({ issues, persons }) => ({\n     id: issues.id,\n     title: issues.title,\n     userName: persons.name\n   }))\n)\n```\n\n```ts\n// Handle loading and error states in template\nconst { data, isLoading, isError, status } = useLiveQuery((q) =>\n  q.from({ todos: todoCollection })\n)\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Error: {{ status }}</div>\n// <ul v-else>\n//   <li v-for=\"todo in data\" :key=\"todo.id\">{{ todo.text }}</li>\n// </ul>\n```\n"}
