:">"}]},{"type":"paragraph","children":[{"type":"text","value":"Reactive object with query data, state, and status information"}]},{"type":"heading","depth":3,"id":"examples-3","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic config object usage\nconst { data, status } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection }),\n  gcTime: 60000\n})","lang":"ts"},{"type":"code","value":"// With reactive dependencies\nconst filter = ref('active')\nconst { data, isReady } = useLiveQuery({\n  query: (q) => q.from({ todos: todosCollection })\n                 .where(({ todos }) => eq(todos.status, filter.value))\n}, [filter])","lang":"ts"},{"type":"code","value":"// Handle all states uniformly\nconst { data, isLoading, isReady, isError } = useLiveQuery({\n  query: (q) => q.from({ items: itemCollection })\n})\n\n// In template:\n// <div v-if=\"isLoading\">Loading...</div>\n// <div v-else-if=\"isError\">Something went wrong</div>\n// <div v-else-if=\"!isReady\">Preparing...</div>\n// <div v-else>{{ data.length }} items loaded</div>","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-4","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useLiveQuery<TResult, TKey, TUtils>(liveQueryCollection): UseLiveQueryReturnWithCollection<TResult, TKey, TUtils>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/vue-db/src/useLiveQuery.ts#L261","children":[{"type":"text","value":"useLiveQuery.ts:261"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Subscribe to an existing query collection (can be reactive)"}]},{"type":"heading","depth":3,"id":"type-parameters-4","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tresult","children":[{"type":"text","value":"TResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TResult"},{"