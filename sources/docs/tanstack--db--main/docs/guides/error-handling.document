---
title: Error Handling
id: error-handling
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack DB provides comprehensive error handling capabilities to ensure robust data synchronization and state management. This guide covers the built-in error handling mechanisms and how to work with them effectively."}]},{"type":"heading","depth":2,"id":"error-types","children":[{"type":"text","value":"Error Types"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack DB provides named error classes for better error handling and type safety. All error classes can be imported from "},{"type":"inlineCode","value":"@tanstack/db"},{"type":"text","value":" (or more commonly, the framework-specific package e.g. "},{"type":"inlineCode","value":"@tanstack/react-db"},{"type":"text","value":"):"}]},{"type":"code","value":"import {\n  SchemaValidationError,\n  CollectionInErrorStateError,\n  DuplicateKeyError,\n  MissingHandlerError,\n  TransactionError,\n  // ... and many more\n} from \"@tanstack/db\"","lang":"ts"},{"type":"heading","depth":3,"id":"schemavalidationerror","children":[{"type":"text","value":"SchemaValidationError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when data doesn't match the collection's schema during insert or update operations:"}]},{"type":"code","value":"import { SchemaValidationError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.insert({ text: 123 }) // Invalid type\n} catch (error) {\n  if (error instanceof SchemaValidationError) {\n    console.log(error.type) // 'insert' or 'update'\n    console.log(error.issues) // Array of validation issues\n    // Example issue: { message: \"Expected string, received number\", path: [\"text\"] }\n  }\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The error includes:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"type"},{"type":"text","value":": Whether it was an 'insert' or 'update' operation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"issues"},{"type":"text","value":": Array of validation issues with messages and paths"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"message"},{"type":"text","value":": A formatted error message listing all issues"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"When schema validation occurs:"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Schema validation happens only for "},{"type":"strong","children":[{"type":"text","value":"client mutations"}]},{"type":"text","value":" - when you explicitly insert or update data:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"During inserts"}]},{"type":"text","value":" - When "},{"type":"inlineCode","value":"collection.insert()"},{"type":"text","value":" is called"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"During updates"}]},{"type":"text","value":" - When "},{"type":"inlineCode","value":"collection.update()"},{"type":"text","value":" is called"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Schemas do "},{"type":"strong","children":[{"type":"text","value":"not"}]},{"type":"text","value":" validate data coming from your server or sync layer. That data is assumed to already be valid."}]},{"type":"code","value":"const schema = z.object({\n  id: z.string(),\n  created_at: z.string().transform(val => new Date(val))\n  // TInput: string, TOutput: Date\n})\n\n// Validation happens here ✓\ncollection.insert({\n  id: \"1\",\n  created_at: \"2024-01-01\"  // TInput: string\n})\n// If successful, stores: { created_at: Date }  // TOutput: Date","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"For more details on schema validation and type transformations, see the "},{"type":"link","href":"./schemas.md","children":[{"type":"text","value":"Schemas guide"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"query-collection-error-tracking","children":[{"type":"text","value":"Query Collection Error Tracking"}]},{"type":"paragraph","children":[{"type":"text","value":"Query collections provide enhanced error tracking utilities through the "},{"type":"inlineCode","value":"utils"},{"type":"text","value":" object. These methods expose error state information and provide recovery mechanisms for failed queries:"}]},{"type":"code","value":"import { createCollection } from \"@tanstack/db\"\nimport { queryCollectionOptions } from \"@tanstack/query-db-collection\"\nimport { useLiveQuery } from \"@tanstack/react-db\"\n\nconst syncedCollection = createCollection(\n  queryCollectionOptions({\n    queryClient,\n    queryKey: ['synced-data'],\n    queryFn: fetchData,\n    getKey: (item) => item.id,\n  })\n)\n\n// Component can check error state\nfunction DataList() {\n  const { data } = useLiveQuery({\n    query: (q) => q.from({ item: syncedCollection }),\n  })\n  const isError = syncedCollection.utils.isError\n  const errorCount = syncedCollection.utils.errorCount\n  \n  return (\n    <>\n      {isError && errorCount > 3 && (\n        <Alert>\n          Unable to sync. Showing cached data.\n          <button onClick={() => syncedCollection.utils.clearError()}>\n            Retry\n          </button>\n        </Alert>\n      )}\n      {/* Render data */}\n    </>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Error tracking methods:"}]},{"type":"list","ordered":false,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"lastError"}]},{"type":"text","value":": Returns the most recent error encountered by the query, or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" if no errors have occurred since a successful result applied:"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"isError"}]},{"type":"text","value":": Returns a boolean indicating whether the collection is currently in an error state:"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"errorCount"}]},{"type":"text","value":": Returns the number of consecutive sync failures. This counter is incremented only when queries fail completely (not per retry attempt) and is reset after a successful result applies:"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"clearError()"}]},{"type":"text","value":": Triggers a refetch. The current error remains visible until a successful result applies to the Collection. An applied result clears "},{"type":"inlineCode","value":"lastError"},{"type":"text","value":" and resets "},{"type":"inlineCode","value":"errorCount"},{"type":"text","value":"; a failed retry records another consecutive failure and rejects the returned promise. During a mutation handler, the promise can resolve at the fetch boundary before application clears the error:"}]},{"type":"code","value":"error visible → clearError() → retry pending, error still visible\n                                 ├─ applied success → error cleared\n                                 └─ failure → new error visible, count increased","lang":"text"}]}]},{"type":"heading","depth":2,"id":"incremental-subset-load-errors","children":[{"type":"text","value":"Incremental Subset Load Errors"}]},{"type":"paragraph","children":[{"type":"text","value":"An incremental "},{"type":"inlineCode","value":"loadSubset"},{"type":"text","value":" failure does not discard rows that are already\navailable or put the shared source collection into "},{"type":"inlineCode","value":"error"},{"type":"text","value":". The failure belongs\nto the subscription that requested that subset:"}]},{"type":"code","value":"const subscription = todoCollection.subscribeChanges(handleChanges, {\n  includeInitialState: false,\n})\n\nsubscription.on('loadSubset:error', ({ error, options }) => {\n  console.error('Subset failed', options, error)\n})\n\nsubscription.requestSnapshot()\n\n// The most recent failure remains available for diagnostics.\nconsole.log(subscription.lastError)","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"For ordered live queries, "},{"type":"inlineCode","value":"utils.setWindow()"},{"type":"text","value":" rejects with the same error. The\nlast failure is also available as "},{"type":"inlineCode","value":"utils.lastSubsetError"},{"type":"text","value":", while the last\nsuccessful snapshot remains readable:"}]},{"type":"code","value":"try {\n  await liveTodos.utils.setWindow({ offset: 0, limit: 100 })\n} catch (error) {\n  console.error(liveTodos.utils.lastSubsetError)\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Effects report subset failures through "},{"type":"inlineCode","value":"onSourceError"},{"type":"text","value":" and dispose because\ntheir incremental result can no longer be kept complete."}]},{"type":"paragraph","children":[{"type":"text","value":"When a source change invalidates an ordered window, automatic full-source\nrepair keeps the last complete snapshot visible. A failed repair exposes\n"},{"type":"inlineCode","value":"utils.lastSubsetError"},{"type":"text","value":" and retries at most twice, after 250 ms and 500 ms.\nExhausting those retries does not put an already-ready query into a terminal\nerror state or clear its rows. The app can show the error and explicitly retry\nwith "},{"type":"inlineCode","value":"setWindow()"},{"type":"text","value":". Cleanup or truncate cancels the old repair timer. Failed\nimperative window moves and initial loads do not use this background retry."}]},{"type":"paragraph","children":[{"type":"text","value":"For SQLite-persisted on-demand collections, a failed upstream "},{"type":"inlineCode","value":"loadSubset"},{"type":"text","value":"\nrejects even when hydration succeeded. Cached rows remain readable; their\navailability does not mean the remote request succeeded. Background coordinator\nretry, where supported, does not change the failed caller's outcome."}]},{"type":"paragraph","children":[{"type":"text","value":"When a must-refetch truncate cannot reload every active subset, a subscription\nkeeps its last successful snapshot and reports the subset error. It discards\nthe incomplete replay batch and keeps later source changes private because they\ncannot prove a complete replacement. The next truncate retries every active\nsubset. Overlapping truncates form one atomic replay: all in-flight requests\nsettle, the newest attempt decides the result, and subscribers receive the\nreplacement only when that attempt succeeds. Cleanup rejects window moves that\nare waiting for replay with "},{"type":"inlineCode","value":"AbortError"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"collection-status-and-error-states","children":[{"type":"text","value":"Collection Status and Error States"}]},{"type":"paragraph","children":[{"type":"text","value":"Collections track their status and transition between states:"}]},{"type":"code","value":"import { useLiveQuery } from \"@tanstack/react-db\"\n\nconst TodoList = () => {\n  const { data, status, isError, isLoading, isReady } = useLiveQuery(\n    (query) => query.from({ todos: todoCollection })\n  )\n\n  if (isError) {\n    return <div>Collection is in error state</div>\n  }\n\n  if (isLoading) {\n    return <div>Loading...</div>\n  }\n\n  return <div>{data?.map(todo => <div key={todo.id}>{todo.text}</div>)}</div>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Collection status values:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"idle"},{"type":"text","value":" - Not yet started"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"loading"},{"type":"text","value":" - Loading initial data"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"initialCommit"},{"type":"text","value":" - Processing initial data"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ready"},{"type":"text","value":" - Ready for use"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"error"},{"type":"text","value":" - In error state"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"cleaned-up"},{"type":"text","value":" - Cleaned up and no longer usable"}]}]}]},{"type":"heading","depth":3,"id":"using-suspense-and-error-boundaries-react","children":[{"type":"text","value":"Using Suspense and Error Boundaries (React)"}]},{"type":"paragraph","children":[{"type":"text","value":"For React applications, you can handle loading and error states with "},{"type":"inlineCode","value":"useLiveSuspenseQuery"},{"type":"text","value":", React Suspense, and Error Boundaries:"}]},{"type":"code","value":"import { useLiveSuspenseQuery } from \"@tanstack/react-db\"\nimport { Suspense } from \"react\"\nimport { ErrorBoundary } from \"react-error-boundary\"\n\nconst TodoList = () => {\n  // No need to check status - Suspense and ErrorBoundary handle it\n  const { data } = useLiveSuspenseQuery(\n    (query) => query.from({ todos: todoCollection })\n  )\n\n  // data is always defined here\n  return <div>{data.map(todo => <div key={todo.id}>{todo.text}</div>)}</div>\n}\n\nconst App = () => (\n  <ErrorBoundary fallback={<div>Failed to load todos</div>}>\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList />\n    </Suspense>\n  </ErrorBoundary>\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"With this approach, loading states are handled by "},{"type":"inlineCode","value":"<Suspense>"},{"type":"text","value":" and error states are handled by "},{"type":"inlineCode","value":"<ErrorBoundary>"},{"type":"text","value":" instead of within your component logic. See the "},{"type":"link","href":"./live-queries#using-with-react-suspense","children":[{"type":"text","value":"React Suspense section in Live Queries"}]},{"type":"text","value":" for more details."}]},{"type":"paragraph","children":[{"type":"text","value":"When every eager SQLite persisted source opts in, a failed client query stream can produce a different initial result. React waits for every persisted restore. If each restore succeeds, React renders the query result. A derived-query failure still reaches the Error Boundary. See "},{"type":"link","href":"./sqlite-persistence.md#render-after-sqlite-restore","children":[{"type":"text","value":"Render after SQLite restore"}]},{"type":"text","value":" for the option and its limits."}]},{"type":"heading","depth":2,"id":"transaction-error-handling","children":[{"type":"text","value":"Transaction Error Handling"}]},{"type":"paragraph","children":[{"type":"text","value":"When mutations fail, TanStack DB automatically rolls back optimistic updates:"}]},{"type":"code","value":"const todoCollection = createCollection({\n  id: \"todos\",\n  onInsert: async ({ transaction }) => {\n    const response = await fetch(\"/api/todos\", {\n      method: \"POST\",\n      body: JSON.stringify(transaction.mutations[0].modified),\n    })\n    \n    if (!response.ok) {\n      // Throwing an error will rollback the optimistic state\n      throw new Error(`HTTP Error: ${response.status}`)\n    }\n    \n    return response.json()\n  },\n})\n\n// Usage - optimistic update will be rolled back if the mutation fails\ntry {\n  const tx = todoCollection.insert({\n    id: \"1\",\n    text: \"New todo\",\n    completed: false,\n  })\n  \n  await tx.when('settled')\n} catch (error) {\n  // The optimistic update has been automatically rolled back\n  console.error(\"Failed to create todo:\", error)\n}","lang":"ts"},{"type":"heading","depth":3,"id":"transaction-states-and-error-information","children":[{"type":"text","value":"Transaction States and Error Information"}]},{"type":"paragraph","children":[{"type":"text","value":"Transactions have the following states:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"pending"},{"type":"text","value":" - Transaction is being processed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"persisting"},{"type":"text","value":" - Currently executing the mutation function"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"completed"},{"type":"text","value":" - Transaction completed successfully"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"failed"},{"type":"text","value":" - Transaction failed and was rolled back"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Access transaction error information from collection operations:"}]},{"type":"code","value":"const todoCollection = createCollection({\n  id: \"todos\",\n  onUpdate: async ({ transaction }) => {\n    const response = await fetch(`/api/todos/${transaction.mutations[0].key}`, {\n      method: \"PUT\",\n      body: JSON.stringify(transaction.mutations[0].modified),\n    })\n    \n    if (!response.ok) {\n      throw new Error(`Update failed: ${response.status}`)\n    }\n  },\n})\n\ntry {\n  const tx = await todoCollection.update(\"todo-1\", (draft) => {\n    draft.completed = true\n  })\n  \n  await tx.when('settled')\n} catch (error) {\n  // Transaction has been rolled back\n  console.log(tx.state) // \"failed\"\n  console.log(tx.error) // { message: \"Update failed: 500\", error: Error }\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Or with manual transaction creation:"}]},{"type":"code","value":"const tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    throw new Error(\"API failed\")\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Item\" })\n})\n\ntry {\n  await tx.commit()\n} catch (error) {\n  // Transaction has been rolled back\n  console.log(tx.state) // \"failed\"\n  console.log(tx.error) // { message: \"API failed\", error: Error }\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Explicit cancellation is different from a mutation failure. If you call\n"},{"type":"inlineCode","value":"tx.rollback()"},{"type":"text","value":" while "},{"type":"inlineCode","value":"mutationFn"},{"type":"text","value":" is pending, the rollback settles\n"},{"type":"inlineCode","value":"tx.when('settled')"},{"type":"text","value":" as rejected. A later result or rejection from that\nmutation function is ignored: the outstanding "},{"type":"inlineCode","value":"commit()"},{"type":"text","value":" call resolves and\n"},{"type":"inlineCode","value":"tx.error"},{"type":"text","value":" is not populated by that late rejection. Observe "},{"type":"inlineCode","value":"tx.when('settled')"},{"type":"text","value":"\nwhen you need the transaction's outcome, including explicit cancellation."}]},{"type":"paragraph","children":[{"type":"text","value":"After the mutation function succeeds, a publication listener can still throw\nwhile the completed transaction updates its collections. In that case\n"},{"type":"inlineCode","value":"commit()"},{"type":"text","value":" rejects with the listener error, but "},{"type":"inlineCode","value":"tx.when('settled')"},{"type":"text","value":" resolves\nand the transaction remains completed. This is not a persistence failure."}]},{"type":"heading","depth":2,"id":"collection-operation-errors","children":[{"type":"text","value":"Collection Operation Errors"}]},{"type":"heading","depth":3,"id":"invalid-collection-state","children":[{"type":"text","value":"Invalid Collection State"}]},{"type":"paragraph","children":[{"type":"text","value":"Collections in an "},{"type":"inlineCode","value":"error"},{"type":"text","value":" state cannot perform operations and must be manually recovered:"}]},{"type":"code","value":"import { CollectionInErrorStateError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.insert(newTodo)\n} catch (error) {\n  if (error instanceof CollectionInErrorStateError) {\n    // Collection needs to be cleaned up and restarted\n    await todoCollection.cleanup()\n    await todoCollection.preload()\n    \n    // Now retry the operation\n    todoCollection.insert(newTodo)\n  }\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"If a live query depends on this Collection, restart both Collections as shown\nin "},{"type":"link","href":"#collection-cleanup-and-restart","children":[{"type":"text","value":"Collection Cleanup and Restart"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"missing-mutation-handlers","children":[{"type":"text","value":"Missing Mutation Handlers"}]},{"type":"paragraph","children":[{"type":"text","value":"Direct mutations require handlers to be configured:"}]},{"type":"code","value":"const todoCollection = createCollection({\n  id: \"todos\",\n  getKey: (todo) => todo.id,\n  // Missing onInsert handler\n})\n\n// This will throw an error\ntodoCollection.insert(newTodo)\n// Error: Collection.insert called directly (not within an explicit transaction) but no 'onInsert' handler is configured","lang":"ts"},{"type":"heading","depth":3,"id":"insert-operation-errors","children":[{"type":"text","value":"Insert Operation Errors"}]},{"type":"heading","depth":4,"id":"duplicatekeyerror","children":[{"type":"text","value":"DuplicateKeyError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when inserting items with existing keys:"}]},{"type":"code","value":"import { DuplicateKeyError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.insert({ id: \"existing-id\", text: \"Todo\" })\n} catch (error) {\n  if (error instanceof DuplicateKeyError) {\n    console.log(`Duplicate key: ${error.message}`)\n    // Consider using update() instead, or check if item exists first\n  }\n}","lang":"ts"},{"type":"heading","depth":4,"id":"undefinedkeyerror","children":[{"type":"text","value":"UndefinedKeyError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when an object is created without a defined key:"}]},{"type":"code","value":"import { UndefinedKeyError } from \"@tanstack/db\"\n\nconst collection = createCollection({\n  id: \"todos\",\n  getKey: (item) => item.id,\n})\n\ntry {\n  collection.insert({ text: \"Todo\" }) // Missing 'id' field\n} catch (error) {\n  if (error instanceof UndefinedKeyError) {\n    console.log(\"Item is missing required key field\")\n    // Ensure your items have the key field defined by getKey\n  }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"update-operation-errors","children":[{"type":"text","value":"Update Operation Errors"}]},{"type":"heading","depth":4,"id":"updatekeynotfounderror","children":[{"type":"text","value":"UpdateKeyNotFoundError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when trying to update a key that doesn't exist in the collection:"}]},{"type":"code","value":"import { UpdateKeyNotFoundError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.update(\"nonexistent-key\", draft => {\n    draft.completed = true\n  })\n} catch (error) {\n  if (error instanceof UpdateKeyNotFoundError) {\n    console.log(\"Key not found - item may have been deleted\")\n    // Consider using insert() if the item doesn't exist\n  }\n}","lang":"ts"},{"type":"heading","depth":4,"id":"keyupdatenotallowederror","children":[{"type":"text","value":"KeyUpdateNotAllowedError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when attempting to change an item's key (not allowed - delete and re-insert instead):"}]},{"type":"code","value":"import { KeyUpdateNotAllowedError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.update(\"todo-1\", draft => {\n    draft.id = \"todo-2\" // Not allowed!\n  })\n} catch (error) {\n  if (error instanceof KeyUpdateNotAllowedError) {\n    console.log(\"Cannot change item keys\")\n    // Instead, delete the old item and insert a new one\n  }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"delete-operation-errors","children":[{"type":"text","value":"Delete Operation Errors"}]},{"type":"heading","depth":4,"id":"deletekeynotfounderror","children":[{"type":"text","value":"DeleteKeyNotFoundError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when trying to delete a key that doesn't exist:"}]},{"type":"code","value":"import { DeleteKeyNotFoundError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.delete(\"nonexistent-key\")\n} catch (error) {\n  if (error instanceof DeleteKeyNotFoundError) {\n    console.log(\"Key not found - item may have already been deleted\")\n    // This may be acceptable in some scenarios (idempotent deletes)\n  }\n}","lang":"ts"},{"type":"heading","depth":2,"id":"sync-error-handling","children":[{"type":"text","value":"Sync Error Handling"}]},{"type":"heading","depth":3,"id":"query-collection-sync-errors","children":[{"type":"text","value":"Query Collection Sync Errors"}]},{"type":"paragraph","children":[{"type":"text","value":"Query collections distinguish an initial load failure from a later refetch failure:"}]},{"type":"code","value":"import { queryCollectionOptions } from \"@tanstack/query-db-collection\"\n\nconst todoCollection = createCollection(\n  queryCollectionOptions({\n    queryKey: [\"todos\"],\n    queryFn: async () => {\n      const response = await fetch(\"/api/todos\")\n      if (!response.ok) {\n        throw new Error(`Failed to fetch: ${response.status}`)\n      }\n      return response.json()\n    },\n    queryClient,\n    getKey: (item) => item.id,\n    schema: todoSchema,\n    // Standard TanStack Query error handling options\n    retry: 3,\n    retryDelay: (attemptIndex) => Math.min(1000 * 2 ** attemptIndex, 30000),\n  })\n)","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"When sync errors occur:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Error is logged to console: "},{"type":"inlineCode","value":"[QueryCollection] Error observing query..."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"An initial failure marks the collection as "},{"type":"inlineCode","value":"error"},{"type":"text","value":" because no usable snapshot exists"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Readiness waits such as "},{"type":"inlineCode","value":"preload()"},{"type":"text","value":" and "},{"type":"inlineCode","value":"toArrayWhenReady()"},{"type":"text","value":" reject with the cause passed to "},{"type":"inlineCode","value":"markError(error)"},{"type":"text","value":" while the collection is in that initial error state"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A later refetch failure keeps the collection "},{"type":"inlineCode","value":"ready"},{"type":"text","value":" and preserves its cached data"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Error tracking counters are updated ("},{"type":"inlineCode","value":"lastError"},{"type":"text","value":", "},{"type":"inlineCode","value":"errorCount"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A later successful refetch recovers an initial "},{"type":"inlineCode","value":"error"},{"type":"text","value":" collection to "},{"type":"inlineCode","value":"ready"},{"type":"text","value":"; a new readiness wait then resolves normally"}]}]}]},{"type":"heading","depth":3,"id":"sync-write-errors","children":[{"type":"text","value":"Sync Write Errors"}]},{"type":"paragraph","children":[{"type":"text","value":"Sync functions must handle their own errors during write operations:"}]},{"type":"code","value":"const collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ begin, write, commit }) => {\n      begin()\n      \n      try {\n        // Will throw if key already exists\n        write({ type: \"insert\", value: { id: \"existing-id\", text: \"Todo\" } })\n      } catch (error) {\n        // Error: Cannot insert document with key \"existing-id\" from sync because it already exists\n      }\n      \n      commit()\n    }\n  }\n})","lang":"ts"},{"type":"heading","depth":3,"id":"cleanup-error-handling","children":[{"type":"text","value":"Cleanup Error Handling"}]},{"type":"paragraph","children":[{"type":"text","value":"Cleanup errors are isolated to prevent blocking the cleanup process:"}]},{"type":"code","value":"const collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ begin, commit }) => {\n      begin()\n      commit()\n      \n      // Return a cleanup function\n      return () => {\n        // If this throws, the error is re-thrown in a microtask\n        // but cleanup continues successfully\n        throw new Error(\"Sync cleanup failed\")\n      }\n    },\n  },\n})\n\n// Cleanup completes even if the sync cleanup function throws\nawait collection.cleanup() // Resolves successfully\n// Error is re-thrown asynchronously via queueMicrotask","lang":"ts"},{"type":"heading","depth":2,"id":"error-recovery-patterns","children":[{"type":"text","value":"Error Recovery Patterns"}]},{"type":"heading","depth":3,"id":"collection-cleanup-and-restart","children":[{"type":"text","value":"Collection Cleanup and Restart"}]},{"type":"paragraph","children":[{"type":"text","value":"Cleanup ends the current sync run and releases the resources installed by its\n"},{"type":"inlineCode","value":"sync()"},{"type":"text","value":" call. A later access can start a new sync run. If no live query or\nEffect depends on the source Collection, restart it like this:"}]},{"type":"code","value":"if (todoCollection.status === \"error\") {\n  // Cleanup ends the current sync run and resets the collection\n  await todoCollection.cleanup()\n  \n  // Start a new sync run and wait for readiness\n  await todoCollection.preload()\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Cleaning up a source Collection while a live-query Collection depends on it\nputs that live query in a terminal error state. Restarting the source alone\ndoes not revive the live query. If you own both Collections, clean up the\ndependent live query first. Preloading it after source cleanup starts fresh\nsync runs for both Collections and waits for the query's required data:"}]},{"type":"code","value":"const todosQuery = createLiveQueryCollection((q) =>\n  q.from({ todos: todoCollection }),\n)\nawait todosQuery.preload()\n\n// Later, if todoCollection enters an error state:\nawait todosQuery.cleanup()\nawait todoCollection.cleanup()\nawait todosQuery.preload()","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The same "},{"type":"inlineCode","value":"todosQuery"},{"type":"text","value":" object and its subscribers can receive later source\nupdates after this sequence. A framework hook that creates its own live-query\nCollection may retain it across renders or remounts. Use a pre-created\nlive-query Collection when you need to control this cleanup and restart\nsequence. A successful preload establishes Collection readiness; whether the\nsource has caught up with a remote service depends on its sync adapter.\nCleanup also disposes dependent Effects; recreate them after the source restarts."}]},{"type":"heading","depth":3,"id":"graceful-degradation","children":[{"type":"text","value":"Graceful Degradation"}]},{"type":"paragraph","children":[{"type":"text","value":"Collections continue to work with cached data even when sync fails:"}]},{"type":"code","value":"const TodoApp = () => {\n  const { data, isError } = useLiveQuery((query) => \n    query.from({ todos: todoCollection })\n  )\n\n  return (\n    <div>\n      {isError && (\n        <div>Sync failed, but you can still view cached data</div>\n      )}\n      {data?.map(todo => <TodoItem key={todo.id} todo={todo} />)}\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"transaction-rollback-cascading","children":[{"type":"text","value":"Transaction Rollback Cascading"}]},{"type":"paragraph","children":[{"type":"text","value":"When a transaction fails, conflicting transactions are automatically rolled back:"}]},{"type":"code","value":"const tx1 = createTransaction({ mutationFn: async () => {} })\nconst tx2 = createTransaction({ mutationFn: async () => {} })\n\ntx1.mutate(() => collection.update(\"1\", draft => { draft.value = \"A\" }))\ntx2.mutate(() => collection.update(\"1\", draft => { draft.value = \"B\" })) // Same item\n\n// Rolling back tx1 will also rollback tx2 due to conflict\ntx1.rollback() // tx2 is automatically rolled back","lang":"ts"},{"type":"heading","depth":3,"id":"transaction-lifecycle-errors","children":[{"type":"text","value":"Transaction Lifecycle Errors"}]},{"type":"paragraph","children":[{"type":"text","value":"Transactions validate their state before operations to prevent misuse. Here are the specific errors you may encounter:"}]},{"type":"heading","depth":4,"id":"missingmutationfunctionerror","children":[{"type":"text","value":"MissingMutationFunctionError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when creating a transaction without a required "},{"type":"inlineCode","value":"mutationFn"},{"type":"text","value":":"}]},{"type":"code","value":"import { MissingMutationFunctionError } from \"@tanstack/db\"\n\ntry {\n  const tx = createTransaction({}) // Missing mutationFn\n} catch (error) {\n  if (error instanceof MissingMutationFunctionError) {\n    console.log(\"mutationFn is required when creating a transaction\")\n  }\n}","lang":"ts"},{"type":"heading","depth":4,"id":"transactionnotpendingmutateerror","children":[{"type":"text","value":"TransactionNotPendingMutateError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when calling "},{"type":"inlineCode","value":"mutate()"},{"type":"text","value":" after a transaction is no longer pending:"}]},{"type":"code","value":"import { TransactionNotPendingMutateError } from \"@tanstack/db\"\n\nconst tx = createTransaction({ mutationFn: async () => {} })\n\nawait tx.commit()\n\ntry {\n  tx.mutate(() => {\n    collection.insert({ id: \"1\", text: \"Item\" })\n  })\n} catch (error) {\n  if (error instanceof TransactionNotPendingMutateError) {\n    console.log(\"Cannot mutate - transaction is no longer pending\")\n  }\n}","lang":"ts"},{"type":"heading","depth":4,"id":"transactionnotpendingcommiterror","children":[{"type":"text","value":"TransactionNotPendingCommitError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when calling "},{"type":"inlineCode","value":"commit()"},{"type":"text","value":" after a transaction is no longer pending:"}]},{"type":"code","value":"import { TransactionNotPendingCommitError } from \"@tanstack/db\"\n\nconst tx = createTransaction({ mutationFn: async () => {} })\ntx.mutate(() => collection.insert({ id: \"1\", text: \"Item\" }))\n\nawait tx.commit()\n\ntry {\n  await tx.commit() // Trying to commit again\n} catch (error) {\n  if (error instanceof TransactionNotPendingCommitError) {\n    console.log(\"Transaction already committed\")\n  }\n}","lang":"ts"},{"type":"heading","depth":4,"id":"transactionalreadycompletedrollbackerror","children":[{"type":"text","value":"TransactionAlreadyCompletedRollbackError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when calling "},{"type":"inlineCode","value":"rollback()"},{"type":"text","value":" on a transaction that's already completed:"}]},{"type":"code","value":"import { TransactionAlreadyCompletedRollbackError } from \"@tanstack/db\"\n\nconst tx = createTransaction({ mutationFn: async () => {} })\ntx.mutate(() => collection.insert({ id: \"1\", text: \"Item\" }))\n\nawait tx.commit()\n\ntry {\n  tx.rollback() // Can't rollback after commit\n} catch (error) {\n  if (error instanceof TransactionAlreadyCompletedRollbackError) {\n    console.log(\"Cannot rollback - transaction already completed\")\n  }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"sync-transaction-errors","children":[{"type":"text","value":"Sync Transaction Errors"}]},{"type":"paragraph","children":[{"type":"text","value":"When working with sync transactions, these errors can occur:"}]},{"type":"heading","depth":4,"id":"nopendingsynctransactionwriteerror","children":[{"type":"text","value":"NoPendingSyncTransactionWriteError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when calling "},{"type":"inlineCode","value":"write()"},{"type":"text","value":" without an active sync transaction:"}]},{"type":"code","value":"const collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ write }) => {\n      // Calling write without begin() first\n      write({ type: \"insert\", value: { id: \"1\", text: \"Todo\" } })\n      // Error: No pending sync transaction to write to\n    }\n  }\n})","lang":"ts"},{"type":"heading","depth":4,"id":"synctransactionalreadycommittedwriteerror","children":[{"type":"text","value":"SyncTransactionAlreadyCommittedWriteError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when calling "},{"type":"inlineCode","value":"write()"},{"type":"text","value":" after the sync transaction is already committed:"}]},{"type":"code","value":"const collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ begin, write, commit }) => {\n      begin()\n      commit()\n\n      // Trying to write after commit\n      write({ type: \"insert\", value: { id: \"1\", text: \"Todo\" } })\n      // Error: The pending sync transaction is already committed\n    }\n  }\n})","lang":"ts"},{"type":"heading","depth":4,"id":"nopendingsynctransactioncommiterror","children":[{"type":"text","value":"NoPendingSyncTransactionCommitError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when calling "},{"type":"inlineCode","value":"commit()"},{"type":"text","value":" without an active sync transaction."}]},{"type":"heading","depth":4,"id":"synctransactionalreadycommittederror","children":[{"type":"text","value":"SyncTransactionAlreadyCommittedError"}]},{"type":"paragraph","children":[{"type":"text","value":"Thrown when calling "},{"type":"inlineCode","value":"commit()"},{"type":"text","value":" on a sync transaction that's already committed."}]},{"type":"heading","depth":2,"id":"best-practices","children":[{"type":"text","value":"Best Practices"}]},{"type":"list","ordered":true,"start":1,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Use instanceof checks"}]},{"type":"text","value":" - Use "},{"type":"inlineCode","value":"instanceof"},{"type":"text","value":" instead of string matching for error handling:"}]},{"type":"code","value":"// ✅ Good - type-safe error handling\nif (error instanceof SchemaValidationError) {\n  // Handle validation error\n}\n\n// ❌ Avoid - brittle string matching  \nif (error.message.includes(\"validation failed\")) {\n  // Handle validation error\n}","lang":"ts"}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Import specific error types"}]},{"type":"text","value":" - Import only the error classes you need for better tree-shaking"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Always handle SchemaValidationError"}]},{"type":"text","value":" - Provide clear feedback for validation failures"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Check collection status"}]},{"type":"text","value":" - Use "},{"type":"inlineCode","value":"isError"},{"type":"text","value":", "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", "},{"type":"inlineCode","value":"isReady"},{"type":"text","value":" flags in React components"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Handle transaction promises"}]},{"type":"text","value":" - Always handle "},{"type":"inlineCode","value":"when('settled')"},{"type":"text","value":" rejections"}]}]}]},{"type":"heading","depth":2,"id":"example-complete-error-handling","children":[{"type":"text","value":"Example: Complete Error Handling"}]},{"type":"code","value":"import {\n  createCollection,\n  createLiveQueryCollection,\n  SchemaValidationError,\n  DuplicateKeyError,\n  UpdateKeyNotFoundError,\n  DeleteKeyNotFoundError,\n  TransactionNotPendingCommitError,\n  createTransaction\n} from \"@tanstack/db\"\nimport { useLiveQuery } from \"@tanstack/react-db\"\n\nconst todoCollection = createCollection({\n  id: \"todos\",\n  schema: todoSchema,\n  getKey: (todo) => todo.id,\n  onInsert: async ({ transaction }) => {\n    const response = await fetch(\"/api/todos\", {\n      method: \"POST\",\n      body: JSON.stringify(transaction.mutations[0].modified),\n    })\n\n    if (!response.ok) {\n      throw new Error(`HTTP ${response.status}: ${response.statusText}`)\n    }\n\n    return response.json()\n  },\n  sync: {\n    sync: ({ begin, write, commit, markReady }) => {\n      // Your sync implementation\n      begin()\n      // ... sync logic\n      commit()\n      markReady()\n    }\n  }\n})\n\nconst todosQuery = createLiveQueryCollection((query) =>\n  query.from({ todos: todoCollection })\n)\n\nconst TodoApp = () => {\n  const { data, isError, isLoading } = useLiveQuery(todosQuery)\n\n  const handleAddTodo = async (text: string) => {\n    try {\n      const tx = await todoCollection.insert({\n        id: crypto.randomUUID(),\n        text,\n        completed: false,\n      })\n      \n      // Wait for persistence\n      await tx.when('settled')\n    } catch (error) {\n      if (error instanceof SchemaValidationError) {\n        alert(`Validation error: ${error.issues[0]?.message}`)\n      } else if (error instanceof DuplicateKeyError) {\n        alert(\"A todo with this ID already exists\")\n      } else {\n        alert(`Failed to add todo: ${error.message}`)\n      }\n    }\n  }\n\n  const handleRestart = async () => {\n    try {\n      await todosQuery.cleanup()\n      await todoCollection.cleanup()\n      await todosQuery.preload()\n    } catch (error) {\n      alert(`Failed to restart todos: ${String(error)}`)\n    }\n  }\n\n  if (isError) {\n    return (\n      <div>\n        <div>Collection error - data may be stale</div>\n        <button onClick={handleRestart}>Restart Collections</button>\n      </div>\n    )\n  }\n\n  if (isLoading) {\n    return <div>Loading todos...</div>\n  }\n\n  return (\n    <div>\n      <button onClick={() => handleAddTodo(\"New todo\")}>\n        Add Todo\n      </button>\n      {data?.map(todo => (\n        <div key={todo.id}>{todo.text}</div>\n      ))}\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"see-also","children":[{"type":"text","value":"See Also"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../overview.md#api-reference","children":[{"type":"text","value":"API Reference"}]},{"type":"text","value":" - Detailed API documentation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../overview.md#making-optimistic-mutations","children":[{"type":"text","value":"Mutations Guide"}]},{"type":"text","value":" - Learn about optimistic updates and rollbacks"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://tanstack.com/query/latest/docs/react/guides/error-handling","children":[{"type":"text","value":"TanStack Query Error Handling"}]},{"type":"text","value":" - Query-specific error handling"}]}]}]}],"headings":[{"id":"error-types","text":"Error Types","level":2},{"id":"schemavalidationerror","text":"SchemaValidationError","level":3},{"id":"query-collection-error-tracking","text":"Query Collection Error Tracking","level":2},{"id":"incremental-subset-load-errors","text":"Incremental Subset Load Errors","level":2},{"id":"collection-status-and-error-states","text":"Collection Status and Error States","level":2},{"id":"using-suspense-and-error-boundaries-react","text":"Using Suspense and Error Boundaries (React)","level":3},{"id":"transaction-error-handling","text":"Transaction Error Handling","level":2},{"id":"transaction-states-and-error-information","text":"Transaction States and Error Information","level":3},{"id":"collection-operation-errors","text":"Collection Operation Errors","level":2},{"id":"invalid-collection-state","text":"Invalid Collection State","level":3},{"id":"missing-mutation-handlers","text":"Missing Mutation Handlers","level":3},{"id":"insert-operation-errors","text":"Insert Operation Errors","level":3},{"id":"duplicatekeyerror","text":"DuplicateKeyError","level":4},{"id":"undefinedkeyerror","text":"UndefinedKeyError","level":4},{"id":"update-operation-errors","text":"Update Operation Errors","level":3},{"id":"updatekeynotfounderror","text":"UpdateKeyNotFoundError","level":4},{"id":"keyupdatenotallowederror","text":"KeyUpdateNotAllowedError","level":4},{"id":"delete-operation-errors","text":"Delete Operation Errors","level":3},{"id":"deletekeynotfounderror","text":"DeleteKeyNotFoundError","level":4},{"id":"sync-error-handling","text":"Sync Error Handling","level":2},{"id":"query-collection-sync-errors","text":"Query Collection Sync Errors","level":3},{"id":"sync-write-errors","text":"Sync Write Errors","level":3},{"id":"cleanup-error-handling","text":"Cleanup Error Handling","level":3},{"id":"error-recovery-patterns","text":"Error Recovery Patterns","level":2},{"id":"collection-cleanup-and-restart","text":"Collection Cleanup and Restart","level":3},{"id":"graceful-degradation","text":"Graceful Degradation","level":3},{"id":"transaction-rollback-cascading","text":"Transaction Rollback Cascading","level":3},{"id":"transaction-lifecycle-errors","text":"Transaction Lifecycle Errors","level":3},{"id":"missingmutationfunctionerror","text":"MissingMutationFunctionError","level":4},{"id":"transactionnotpendingmutateerror","text":"TransactionNotPendingMutateError","level":4},{"id":"transactionnotpendingcommiterror","text":"TransactionNotPendingCommitError","level":4},{"id":"transactionalreadycompletedrollbackerror","text":"TransactionAlreadyCompletedRollbackError","level":4},{"id":"sync-transaction-errors","text":"Sync Transaction Errors","level":3},{"id":"nopendingsynctransactionwriteerror","text":"NoPendingSyncTransactionWriteError","level":4},{"id":"synctransactionalreadycommittedwriteerror","text":"SyncTransactionAlreadyCommittedWriteError","level":4},{"id":"nopendingsynctransactioncommiterror","text":"NoPendingSyncTransactionCommitError","level":4},{"id":"synctransactionalreadycommittederror","text":"SyncTransactionAlreadyCommittedError","level":4},{"id":"best-practices","text":"Best Practices","level":2},{"id":"example-complete-error-handling","text":"Example: Complete Error Handling","level":2},{"id":"see-also","text":"See Also","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack DB provides comprehensive error handling capabilities to ensure robust data synchronization and state management. This guide covers the built-in error handling mechanisms and how to work with them effectively.\n\n## Error Types\n\nTanStack DB provides named error classes for better error handling and type safety. All error classes can be imported from `@tanstack/db` (or more commonly, the framework-specific package e.g. `@tanstack/react-db`):\n\n```ts\nimport {\n  SchemaValidationError,\n  CollectionInErrorStateError,\n  DuplicateKeyError,\n  MissingHandlerError,\n  TransactionError,\n  // ... and many more\n} from \"@tanstack/db\"\n```\n\n### SchemaValidationError\n\nThrown when data doesn't match the collection's schema during insert or update operations:\n\n```ts\nimport { SchemaValidationError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.insert({ text: 123 }) // Invalid type\n} catch (error) {\n  if (error instanceof SchemaValidationError) {\n    console.log(error.type) // 'insert' or 'update'\n    console.log(error.issues) // Array of validation issues\n    // Example issue: { message: \"Expected string, received number\", path: [\"text\"] }\n  }\n}\n```\n\nThe error includes:\n- `type`: Whether it was an 'insert' or 'update' operation\n- `issues`: Array of validation issues with messages and paths\n- `message`: A formatted error message listing all issues\n\n**When schema validation occurs:**\n\nSchema validation happens only for **client mutations** - when you explicitly insert or update data:\n\n1. **During inserts** - When `collection.insert()` is called\n2. **During updates** - When `collection.update()` is called\n\nSchemas do **not** validate data coming from your server or sync layer. That data is assumed to already be valid.\n\n```typescript\nconst schema = z.object({\n  id: z.string(),\n  created_at: z.string().transform(val => new Date(val))\n  // TInput: string, TOutput: Date\n})\n\n// Validation happens here ✓\ncollection.insert({\n  id: \"1\",\n  created_at: \"2024-01-01\"  // TInput: string\n})\n// If successful, stores: { created_at: Date }  // TOutput: Date\n```\n\nFor more details on schema validation and type transformations, see the [Schemas guide](./schemas.md).\n\n## Query Collection Error Tracking\n\nQuery collections provide enhanced error tracking utilities through the `utils` object. These methods expose error state information and provide recovery mechanisms for failed queries:\n\n```tsx\nimport { createCollection } from \"@tanstack/db\"\nimport { queryCollectionOptions } from \"@tanstack/query-db-collection\"\nimport { useLiveQuery } from \"@tanstack/react-db\"\n\nconst syncedCollection = createCollection(\n  queryCollectionOptions({\n    queryClient,\n    queryKey: ['synced-data'],\n    queryFn: fetchData,\n    getKey: (item) => item.id,\n  })\n)\n\n// Component can check error state\nfunction DataList() {\n  const { data } = useLiveQuery({\n    query: (q) => q.from({ item: syncedCollection }),\n  })\n  const isError = syncedCollection.utils.isError\n  const errorCount = syncedCollection.utils.errorCount\n  \n  return (\n    <>\n      {isError && errorCount > 3 && (\n        <Alert>\n          Unable to sync. Showing cached data.\n          <button onClick={() => syncedCollection.utils.clearError()}>\n            Retry\n          </button>\n        </Alert>\n      )}\n      {/* Render data */}\n    </>\n  )\n}\n```\n\nError tracking methods:\n- **`lastError`**: Returns the most recent error encountered by the query, or `undefined` if no errors have occurred since a successful result applied:\n- **`isError`**: Returns a boolean indicating whether the collection is currently in an error state:\n- **`errorCount`**: Returns the number of consecutive sync failures. This counter is incremented only when queries fail completely (not per retry attempt) and is reset after a successful result applies:\n- **`clearError()`**: Triggers a refetch. The current error remains visible until a successful result applies to the Collection. An applied result clears `lastError` and resets `errorCount`; a failed retry records another consecutive failure and rejects the returned promise. During a mutation handler, the promise can resolve at the fetch boundary before application clears the error:\n\n  ```text\n  error visible → clearError() → retry pending, error still visible\n                                   ├─ applied success → error cleared\n                                   └─ failure → new error visible, count increased\n  ```\n\n## Incremental Subset Load Errors\n\nAn incremental `loadSubset` failure does not discard rows that are already\navailable or put the shared source collection into `error`. The failure belongs\nto the subscription that requested that subset:\n\n```ts\nconst subscription = todoCollection.subscribeChanges(handleChanges, {\n  includeInitialState: false,\n})\n\nsubscription.on('loadSubset:error', ({ error, options }) => {\n  console.error('Subset failed', options, error)\n})\n\nsubscription.requestSnapshot()\n\n// The most recent failure remains available for diagnostics.\nconsole.log(subscription.lastError)\n```\n\nFor ordered live queries, `utils.setWindow()` rejects with the same error. The\nlast failure is also available as `utils.lastSubsetError`, while the last\nsuccessful snapshot remains readable:\n\n```ts\ntry {\n  await liveTodos.utils.setWindow({ offset: 0, limit: 100 })\n} catch (error) {\n  console.error(liveTodos.utils.lastSubsetError)\n}\n```\n\nEffects report subset failures through `onSourceError` and dispose because\ntheir incremental result can no longer be kept complete.\n\nWhen a source change invalidates an ordered window, automatic full-source\nrepair keeps the last complete snapshot visible. A failed repair exposes\n`utils.lastSubsetError` and retries at most twice, after 250 ms and 500 ms.\nExhausting those retries does not put an already-ready query into a terminal\nerror state or clear its rows. The app can show the error and explicitly retry\nwith `setWindow()`. Cleanup or truncate cancels the old repair timer. Failed\nimperative window moves and initial loads do not use this background retry.\n\nFor SQLite-persisted on-demand collections, a failed upstream `loadSubset`\nrejects even when hydration succeeded. Cached rows remain readable; their\navailability does not mean the remote request succeeded. Background coordinator\nretry, where supported, does not change the failed caller's outcome.\n\nWhen a must-refetch truncate cannot reload every active subset, a subscription\nkeeps its last successful snapshot and reports the subset error. It discards\nthe incomplete replay batch and keeps later source changes private because they\ncannot prove a complete replacement. The next truncate retries every active\nsubset. Overlapping truncates form one atomic replay: all in-flight requests\nsettle, the newest attempt decides the result, and subscribers receive the\nreplacement only when that attempt succeeds. Cleanup rejects window moves that\nare waiting for replay with `AbortError`.\n\n## Collection Status and Error States\n\nCollections track their status and transition between states:\n\n```tsx\nimport { useLiveQuery } from \"@tanstack/react-db\"\n\nconst TodoList = () => {\n  const { data, status, isError, isLoading, isReady } = useLiveQuery(\n    (query) => query.from({ todos: todoCollection })\n  )\n\n  if (isError) {\n    return <div>Collection is in error state</div>\n  }\n\n  if (isLoading) {\n    return <div>Loading...</div>\n  }\n\n  return <div>{data?.map(todo => <div key={todo.id}>{todo.text}</div>)}</div>\n}\n```\n\nCollection status values:\n- `idle` - Not yet started\n- `loading` - Loading initial data\n- `initialCommit` - Processing initial data\n- `ready` - Ready for use\n- `error` - In error state\n- `cleaned-up` - Cleaned up and no longer usable\n\n### Using Suspense and Error Boundaries (React)\n\nFor React applications, you can handle loading and error states with `useLiveSuspenseQuery`, React Suspense, and Error Boundaries:\n\n```tsx\nimport { useLiveSuspenseQuery } from \"@tanstack/react-db\"\nimport { Suspense } from \"react\"\nimport { ErrorBoundary } from \"react-error-boundary\"\n\nconst TodoList = () => {\n  // No need to check status - Suspense and ErrorBoundary handle it\n  const { data } = useLiveSuspenseQuery(\n    (query) => query.from({ todos: todoCollection })\n  )\n\n  // data is always defined here\n  return <div>{data.map(todo => <div key={todo.id}>{todo.text}</div>)}</div>\n}\n\nconst App = () => (\n  <ErrorBoundary fallback={<div>Failed to load todos</div>}>\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList />\n    </Suspense>\n  </ErrorBoundary>\n)\n```\n\nWith this approach, loading states are handled by `<Suspense>` and error states are handled by `<ErrorBoundary>` instead of within your component logic. See the [React Suspense section in Live Queries](./live-queries#using-with-react-suspense) for more details.\n\nWhen every eager SQLite persisted source opts in, a failed client query stream can produce a different initial result. React waits for every persisted restore. If each restore succeeds, React renders the query result. A derived-query failure still reaches the Error Boundary. See [Render after SQLite restore](./sqlite-persistence.md#render-after-sqlite-restore) for the option and its limits.\n\n## Transaction Error Handling\n\nWhen mutations fail, TanStack DB automatically rolls back optimistic updates:\n\n```ts\nconst todoCollection = createCollection({\n  id: \"todos\",\n  onInsert: async ({ transaction }) => {\n    const response = await fetch(\"/api/todos\", {\n      method: \"POST\",\n      body: JSON.stringify(transaction.mutations[0].modified),\n    })\n    \n    if (!response.ok) {\n      // Throwing an error will rollback the optimistic state\n      throw new Error(`HTTP Error: ${response.status}`)\n    }\n    \n    return response.json()\n  },\n})\n\n// Usage - optimistic update will be rolled back if the mutation fails\ntry {\n  const tx = todoCollection.insert({\n    id: \"1\",\n    text: \"New todo\",\n    completed: false,\n  })\n  \n  await tx.when('settled')\n} catch (error) {\n  // The optimistic update has been automatically rolled back\n  console.error(\"Failed to create todo:\", error)\n}\n```\n\n### Transaction States and Error Information\n\nTransactions have the following states:\n- `pending` - Transaction is being processed\n- `persisting` - Currently executing the mutation function\n- `completed` - Transaction completed successfully\n- `failed` - Transaction failed and was rolled back\n\nAccess transaction error information from collection operations:\n\n```ts\nconst todoCollection = createCollection({\n  id: \"todos\",\n  onUpdate: async ({ transaction }) => {\n    const response = await fetch(`/api/todos/${transaction.mutations[0].key}`, {\n      method: \"PUT\",\n      body: JSON.stringify(transaction.mutations[0].modified),\n    })\n    \n    if (!response.ok) {\n      throw new Error(`Update failed: ${response.status}`)\n    }\n  },\n})\n\ntry {\n  const tx = await todoCollection.update(\"todo-1\", (draft) => {\n    draft.completed = true\n  })\n  \n  await tx.when('settled')\n} catch (error) {\n  // Transaction has been rolled back\n  console.log(tx.state) // \"failed\"\n  console.log(tx.error) // { message: \"Update failed: 500\", error: Error }\n}\n```\n\nOr with manual transaction creation:\n\n```ts\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    throw new Error(\"API failed\")\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Item\" })\n})\n\ntry {\n  await tx.commit()\n} catch (error) {\n  // Transaction has been rolled back\n  console.log(tx.state) // \"failed\"\n  console.log(tx.error) // { message: \"API failed\", error: Error }\n}\n```\n\nExplicit cancellation is different from a mutation failure. If you call\n`tx.rollback()` while `mutationFn` is pending, the rollback settles\n`tx.when('settled')` as rejected. A later result or rejection from that\nmutation function is ignored: the outstanding `commit()` call resolves and\n`tx.error` is not populated by that late rejection. Observe `tx.when('settled')`\nwhen you need the transaction's outcome, including explicit cancellation.\n\nAfter the mutation function succeeds, a publication listener can still throw\nwhile the completed transaction updates its collections. In that case\n`commit()` rejects with the listener error, but `tx.when('settled')` resolves\nand the transaction remains completed. This is not a persistence failure.\n\n## Collection Operation Errors\n\n### Invalid Collection State\n\nCollections in an `error` state cannot perform operations and must be manually recovered:\n\n```ts\nimport { CollectionInErrorStateError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.insert(newTodo)\n} catch (error) {\n  if (error instanceof CollectionInErrorStateError) {\n    // Collection needs to be cleaned up and restarted\n    await todoCollection.cleanup()\n    await todoCollection.preload()\n    \n    // Now retry the operation\n    todoCollection.insert(newTodo)\n  }\n}\n```\n\nIf a live query depends on this Collection, restart both Collections as shown\nin [Collection Cleanup and Restart](#collection-cleanup-and-restart).\n\n### Missing Mutation Handlers\n\nDirect mutations require handlers to be configured:\n\n```ts\nconst todoCollection = createCollection({\n  id: \"todos\",\n  getKey: (todo) => todo.id,\n  // Missing onInsert handler\n})\n\n// This will throw an error\ntodoCollection.insert(newTodo)\n// Error: Collection.insert called directly (not within an explicit transaction) but no 'onInsert' handler is configured\n```\n\n### Insert Operation Errors\n\n#### DuplicateKeyError\n\nThrown when inserting items with existing keys:\n\n```ts\nimport { DuplicateKeyError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.insert({ id: \"existing-id\", text: \"Todo\" })\n} catch (error) {\n  if (error instanceof DuplicateKeyError) {\n    console.log(`Duplicate key: ${error.message}`)\n    // Consider using update() instead, or check if item exists first\n  }\n}\n```\n\n#### UndefinedKeyError\n\nThrown when an object is created without a defined key:\n\n```ts\nimport { UndefinedKeyError } from \"@tanstack/db\"\n\nconst collection = createCollection({\n  id: \"todos\",\n  getKey: (item) => item.id,\n})\n\ntry {\n  collection.insert({ text: \"Todo\" }) // Missing 'id' field\n} catch (error) {\n  if (error instanceof UndefinedKeyError) {\n    console.log(\"Item is missing required key field\")\n    // Ensure your items have the key field defined by getKey\n  }\n}\n```\n\n### Update Operation Errors\n\n#### UpdateKeyNotFoundError\n\nThrown when trying to update a key that doesn't exist in the collection:\n\n```ts\nimport { UpdateKeyNotFoundError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.update(\"nonexistent-key\", draft => {\n    draft.completed = true\n  })\n} catch (error) {\n  if (error instanceof UpdateKeyNotFoundError) {\n    console.log(\"Key not found - item may have been deleted\")\n    // Consider using insert() if the item doesn't exist\n  }\n}\n```\n\n#### KeyUpdateNotAllowedError\n\nThrown when attempting to change an item's key (not allowed - delete and re-insert instead):\n\n```ts\nimport { KeyUpdateNotAllowedError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.update(\"todo-1\", draft => {\n    draft.id = \"todo-2\" // Not allowed!\n  })\n} catch (error) {\n  if (error instanceof KeyUpdateNotAllowedError) {\n    console.log(\"Cannot change item keys\")\n    // Instead, delete the old item and insert a new one\n  }\n}\n```\n\n### Delete Operation Errors\n\n#### DeleteKeyNotFoundError\n\nThrown when trying to delete a key that doesn't exist:\n\n```ts\nimport { DeleteKeyNotFoundError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.delete(\"nonexistent-key\")\n} catch (error) {\n  if (error instanceof DeleteKeyNotFoundError) {\n    console.log(\"Key not found - item may have already been deleted\")\n    // This may be acceptable in some scenarios (idempotent deletes)\n  }\n}\n```\n\n## Sync Error Handling\n\n### Query Collection Sync Errors\n\nQuery collections distinguish an initial load failure from a later refetch failure:\n\n```ts\nimport { queryCollectionOptions } from \"@tanstack/query-db-collection\"\n\nconst todoCollection = createCollection(\n  queryCollectionOptions({\n    queryKey: [\"todos\"],\n    queryFn: async () => {\n      const response = await fetch(\"/api/todos\")\n      if (!response.ok) {\n        throw new Error(`Failed to fetch: ${response.status}`)\n      }\n      return response.json()\n    },\n    queryClient,\n    getKey: (item) => item.id,\n    schema: todoSchema,\n    // Standard TanStack Query error handling options\n    retry: 3,\n    retryDelay: (attemptIndex) => Math.min(1000 * 2 ** attemptIndex, 30000),\n  })\n)\n```\n\nWhen sync errors occur:\n- Error is logged to console: `[QueryCollection] Error observing query...`\n- An initial failure marks the collection as `error` because no usable snapshot exists\n- Readiness waits such as `preload()` and `toArrayWhenReady()` reject with the cause passed to `markError(error)` while the collection is in that initial error state\n- A later refetch failure keeps the collection `ready` and preserves its cached data\n- Error tracking counters are updated (`lastError`, `errorCount`)\n- A later successful refetch recovers an initial `error` collection to `ready`; a new readiness wait then resolves normally\n\n### Sync Write Errors\n\nSync functions must handle their own errors during write operations:\n\n```ts\nconst collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ begin, write, commit }) => {\n      begin()\n      \n      try {\n        // Will throw if key already exists\n        write({ type: \"insert\", value: { id: \"existing-id\", text: \"Todo\" } })\n      } catch (error) {\n        // Error: Cannot insert document with key \"existing-id\" from sync because it already exists\n      }\n      \n      commit()\n    }\n  }\n})\n```\n\n### Cleanup Error Handling\n\nCleanup errors are isolated to prevent blocking the cleanup process:\n\n```ts\nconst collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ begin, commit }) => {\n      begin()\n      commit()\n      \n      // Return a cleanup function\n      return () => {\n        // If this throws, the error is re-thrown in a microtask\n        // but cleanup continues successfully\n        throw new Error(\"Sync cleanup failed\")\n      }\n    },\n  },\n})\n\n// Cleanup completes even if the sync cleanup function throws\nawait collection.cleanup() // Resolves successfully\n// Error is re-thrown asynchronously via queueMicrotask\n```\n\n## Error Recovery Patterns\n\n### Collection Cleanup and Restart\n\nCleanup ends the current sync run and releases the resources installed by its\n`sync()` call. A later access can start a new sync run. If no live query or\nEffect depends on the source Collection, restart it like this:\n\n```ts\nif (todoCollection.status === \"error\") {\n  // Cleanup ends the current sync run and resets the collection\n  await todoCollection.cleanup()\n  \n  // Start a new sync run and wait for readiness\n  await todoCollection.preload()\n}\n```\n\nCleaning up a source Collection while a live-query Collection depends on it\nputs that live query in a terminal error state. Restarting the source alone\ndoes not revive the live query. If you own both Collections, clean up the\ndependent live query first. Preloading it after source cleanup starts fresh\nsync runs for both Collections and waits for the query's required data:\n\n```ts\nconst todosQuery = createLiveQueryCollection((q) =>\n  q.from({ todos: todoCollection }),\n)\nawait todosQuery.preload()\n\n// Later, if todoCollection enters an error state:\nawait todosQuery.cleanup()\nawait todoCollection.cleanup()\nawait todosQuery.preload()\n```\n\nThe same `todosQuery` object and its subscribers can receive later source\nupdates after this sequence. A framework hook that creates its own live-query\nCollection may retain it across renders or remounts. Use a pre-created\nlive-query Collection when you need to control this cleanup and restart\nsequence. A successful preload establishes Collection readiness; whether the\nsource has caught up with a remote service depends on its sync adapter.\nCleanup also disposes dependent Effects; recreate them after the source restarts.\n\n### Graceful Degradation\n\nCollections continue to work with cached data even when sync fails:\n\n```tsx\nconst TodoApp = () => {\n  const { data, isError } = useLiveQuery((query) => \n    query.from({ todos: todoCollection })\n  )\n\n  return (\n    <div>\n      {isError && (\n        <div>Sync failed, but you can still view cached data</div>\n      )}\n      {data?.map(todo => <TodoItem key={todo.id} todo={todo} />)}\n    </div>\n  )\n}\n```\n\n### Transaction Rollback Cascading\n\nWhen a transaction fails, conflicting transactions are automatically rolled back:\n\n```ts\nconst tx1 = createTransaction({ mutationFn: async () => {} })\nconst tx2 = createTransaction({ mutationFn: async () => {} })\n\ntx1.mutate(() => collection.update(\"1\", draft => { draft.value = \"A\" }))\ntx2.mutate(() => collection.update(\"1\", draft => { draft.value = \"B\" })) // Same item\n\n// Rolling back tx1 will also rollback tx2 due to conflict\ntx1.rollback() // tx2 is automatically rolled back\n```\n\n### Transaction Lifecycle Errors\n\nTransactions validate their state before operations to prevent misuse. Here are the specific errors you may encounter:\n\n#### MissingMutationFunctionError\n\nThrown when creating a transaction without a required `mutationFn`:\n\n```ts\nimport { MissingMutationFunctionError } from \"@tanstack/db\"\n\ntry {\n  const tx = createTransaction({}) // Missing mutationFn\n} catch (error) {\n  if (error instanceof MissingMutationFunctionError) {\n    console.log(\"mutationFn is required when creating a transaction\")\n  }\n}\n```\n\n#### TransactionNotPendingMutateError\n\nThrown when calling `mutate()` after a transaction is no longer pending:\n\n```ts\nimport { TransactionNotPendingMutateError } from \"@tanstack/db\"\n\nconst tx = createTransaction({ mutationFn: async () => {} })\n\nawait tx.commit()\n\ntry {\n  tx.mutate(() => {\n    collection.insert({ id: \"1\", text: \"Item\" })\n  })\n} catch (error) {\n  if (error instanceof TransactionNotPendingMutateError) {\n    console.log(\"Cannot mutate - transaction is no longer pending\")\n  }\n}\n```\n\n#### TransactionNotPendingCommitError\n\nThrown when calling `commit()` after a transaction is no longer pending:\n\n```ts\nimport { TransactionNotPendingCommitError } from \"@tanstack/db\"\n\nconst tx = createTransaction({ mutationFn: async () => {} })\ntx.mutate(() => collection.insert({ id: \"1\", text: \"Item\" }))\n\nawait tx.commit()\n\ntry {\n  await tx.commit() // Trying to commit again\n} catch (error) {\n  if (error instanceof TransactionNotPendingCommitError) {\n    console.log(\"Transaction already committed\")\n  }\n}\n```\n\n#### TransactionAlreadyCompletedRollbackError\n\nThrown when calling `rollback()` on a transaction that's already completed:\n\n```ts\nimport { TransactionAlreadyCompletedRollbackError } from \"@tanstack/db\"\n\nconst tx = createTransaction({ mutationFn: async () => {} })\ntx.mutate(() => collection.insert({ id: \"1\", text: \"Item\" }))\n\nawait tx.commit()\n\ntry {\n  tx.rollback() // Can't rollback after commit\n} catch (error) {\n  if (error instanceof TransactionAlreadyCompletedRollbackError) {\n    console.log(\"Cannot rollback - transaction already completed\")\n  }\n}\n```\n\n### Sync Transaction Errors\n\nWhen working with sync transactions, these errors can occur:\n\n#### NoPendingSyncTransactionWriteError\n\nThrown when calling `write()` without an active sync transaction:\n\n```ts\nconst collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ write }) => {\n      // Calling write without begin() first\n      write({ type: \"insert\", value: { id: \"1\", text: \"Todo\" } })\n      // Error: No pending sync transaction to write to\n    }\n  }\n})\n```\n\n#### SyncTransactionAlreadyCommittedWriteError\n\nThrown when calling `write()` after the sync transaction is already committed:\n\n```ts\nconst collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ begin, write, commit }) => {\n      begin()\n      commit()\n\n      // Trying to write after commit\n      write({ type: \"insert\", value: { id: \"1\", text: \"Todo\" } })\n      // Error: The pending sync transaction is already committed\n    }\n  }\n})\n```\n\n#### NoPendingSyncTransactionCommitError\n\nThrown when calling `commit()` without an active sync transaction.\n\n#### SyncTransactionAlreadyCommittedError\n\nThrown when calling `commit()` on a sync transaction that's already committed.\n\n## Best Practices\n\n1. **Use instanceof checks** - Use `instanceof` instead of string matching for error handling:\n   ```ts\n   // ✅ Good - type-safe error handling\n   if (error instanceof SchemaValidationError) {\n     // Handle validation error\n   }\n   \n   // ❌ Avoid - brittle string matching  \n   if (error.message.includes(\"validation failed\")) {\n     // Handle validation error\n   }\n   ```\n\n2. **Import specific error types** - Import only the error classes you need for better tree-shaking\n3. **Always handle SchemaValidationError** - Provide clear feedback for validation failures\n4. **Check collection status** - Use `isError`, `isLoading`, `isReady` flags in React components\n5. **Handle transaction promises** - Always handle `when('settled')` rejections\n\n## Example: Complete Error Handling\n\n```tsx\nimport {\n  createCollection,\n  createLiveQueryCollection,\n  SchemaValidationError,\n  DuplicateKeyError,\n  UpdateKeyNotFoundError,\n  DeleteKeyNotFoundError,\n  TransactionNotPendingCommitError,\n  createTransaction\n} from \"@tanstack/db\"\nimport { useLiveQuery } from \"@tanstack/react-db\"\n\nconst todoCollection = createCollection({\n  id: \"todos\",\n  schema: todoSchema,\n  getKey: (todo) => todo.id,\n  onInsert: async ({ transaction }) => {\n    const response = await fetch(\"/api/todos\", {\n      method: \"POST\",\n      body: JSON.stringify(transaction.mutations[0].modified),\n    })\n\n    if (!response.ok) {\n      throw new Error(`HTTP ${response.status}: ${response.statusText}`)\n    }\n\n    return response.json()\n  },\n  sync: {\n    sync: ({ begin, write, commit, markReady }) => {\n      // Your sync implementation\n      begin()\n      // ... sync logic\n      commit()\n      markReady()\n    }\n  }\n})\n\nconst todosQuery = createLiveQueryCollection((query) =>\n  query.from({ todos: todoCollection })\n)\n\nconst TodoApp = () => {\n  const { data, isError, isLoading } = useLiveQuery(todosQuery)\n\n  const handleAddTodo = async (text: string) => {\n    try {\n      const tx = await todoCollection.insert({\n        id: crypto.randomUUID(),\n        text,\n        completed: false,\n      })\n      \n      // Wait for persistence\n      await tx.when('settled')\n    } catch (error) {\n      if (error instanceof SchemaValidationError) {\n        alert(`Validation error: ${error.issues[0]?.message}`)\n      } else if (error instanceof DuplicateKeyError) {\n        alert(\"A todo with this ID already exists\")\n      } else {\n        alert(`Failed to add todo: ${error.message}`)\n      }\n    }\n  }\n\n  const handleRestart = async () => {\n    try {\n      await todosQuery.cleanup()\n      await todoCollection.cleanup()\n      await todosQuery.preload()\n    } catch (error) {\n      alert(`Failed to restart todos: ${String(error)}`)\n    }\n  }\n\n  if (isError) {\n    return (\n      <div>\n        <div>Collection error - data may be stale</div>\n        <button onClick={handleRestart}>Restart Collections</button>\n      </div>\n    )\n  }\n\n  if (isLoading) {\n    return <div>Loading todos...</div>\n  }\n\n  return (\n    <div>\n      <button onClick={() => handleAddTodo(\"New todo\")}>\n        Add Todo\n      </button>\n      {data?.map(todo => (\n        <div key={todo.id}>{todo.text}</div>\n      ))}\n    </div>\n  )\n}\n```\n\n## See Also\n\n- [API Reference](../overview.md#api-reference) - Detailed API documentation\n- [Mutations Guide](../overview.md#making-optimistic-mutations) - Learn about optimistic updates and rollbacks\n- [TanStack Query Error Handling](https://tanstack.com/query/latest/docs/react/guides/error-handling) - Query-specific error handling\n","originalRawMarkdown":"---\ntitle: Error Handling\nid: error-handling\n---\n\nTanStack DB provides comprehensive error handling capabilities to ensure robust data synchronization and state management. This guide covers the built-in error handling mechanisms and how to work with them effectively.\n\n## Error Types\n\nTanStack DB provides named error classes for better error handling and type safety. All error classes can be imported from `@tanstack/db` (or more commonly, the framework-specific package e.g. `@tanstack/react-db`):\n\n```ts\nimport {\n  SchemaValidationError,\n  CollectionInErrorStateError,\n  DuplicateKeyError,\n  MissingHandlerError,\n  TransactionError,\n  // ... and many more\n} from \"@tanstack/db\"\n```\n\n### SchemaValidationError\n\nThrown when data doesn't match the collection's schema during insert or update operations:\n\n```ts\nimport { SchemaValidationError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.insert({ text: 123 }) // Invalid type\n} catch (error) {\n  if (error instanceof SchemaValidationError) {\n    console.log(error.type) // 'insert' or 'update'\n    console.log(error.issues) // Array of validation issues\n    // Example issue: { message: \"Expected string, received number\", path: [\"text\"] }\n  }\n}\n```\n\nThe error includes:\n- `type`: Whether it was an 'insert' or 'update' operation\n- `issues`: Array of validation issues with messages and paths\n- `message`: A formatted error message listing all issues\n\n**When schema validation occurs:**\n\nSchema validation happens only for **client mutations** - when you explicitly insert or update data:\n\n1. **During inserts** - When `collection.insert()` is called\n2. **During updates** - When `collection.update()` is called\n\nSchemas do **not** validate data coming from your server or sync layer. That data is assumed to already be valid.\n\n```typescript\nconst schema = z.object({\n  id: z.string(),\n  created_at: z.string().transform(val => new Date(val))\n  // TInput: string, TOutput: Date\n})\n\n// Validation happens here ✓\ncollection.insert({\n  id: \"1\",\n  created_at: \"2024-01-01\"  // TInput: string\n})\n// If successful, stores: { created_at: Date }  // TOutput: Date\n```\n\nFor more details on schema validation and type transformations, see the [Schemas guide](./schemas.md).\n\n## Query Collection Error Tracking\n\nQuery collections provide enhanced error tracking utilities through the `utils` object. These methods expose error state information and provide recovery mechanisms for failed queries:\n\n```tsx\nimport { createCollection } from \"@tanstack/db\"\nimport { queryCollectionOptions } from \"@tanstack/query-db-collection\"\nimport { useLiveQuery } from \"@tanstack/react-db\"\n\nconst syncedCollection = createCollection(\n  queryCollectionOptions({\n    queryClient,\n    queryKey: ['synced-data'],\n    queryFn: fetchData,\n    getKey: (item) => item.id,\n  })\n)\n\n// Component can check error state\nfunction DataList() {\n  const { data } = useLiveQuery({\n    query: (q) => q.from({ item: syncedCollection }),\n  })\n  const isError = syncedCollection.utils.isError\n  const errorCount = syncedCollection.utils.errorCount\n  \n  return (\n    <>\n      {isError && errorCount > 3 && (\n        <Alert>\n          Unable to sync. Showing cached data.\n          <button onClick={() => syncedCollection.utils.clearError()}>\n            Retry\n          </button>\n        </Alert>\n      )}\n      {/* Render data */}\n    </>\n  )\n}\n```\n\nError tracking methods:\n- **`lastError`**: Returns the most recent error encountered by the query, or `undefined` if no errors have occurred since a successful result applied:\n- **`isError`**: Returns a boolean indicating whether the collection is currently in an error state:\n- **`errorCount`**: Returns the number of consecutive sync failures. This counter is incremented only when queries fail completely (not per retry attempt) and is reset after a successful result applies:\n- **`clearError()`**: Triggers a refetch. The current error remains visible until a successful result applies to the Collection. An applied result clears `lastError` and resets `errorCount`; a failed retry records another consecutive failure and rejects the returned promise. During a mutation handler, the promise can resolve at the fetch boundary before application clears the error:\n\n  ```text\n  error visible → clearError() → retry pending, error still visible\n                                   ├─ applied success → error cleared\n                                   └─ failure → new error visible, count increased\n  ```\n\n## Incremental Subset Load Errors\n\nAn incremental `loadSubset` failure does not discard rows that are already\navailable or put the shared source collection into `error`. The failure belongs\nto the subscription that requested that subset:\n\n```ts\nconst subscription = todoCollection.subscribeChanges(handleChanges, {\n  includeInitialState: false,\n})\n\nsubscription.on('loadSubset:error', ({ error, options }) => {\n  console.error('Subset failed', options, error)\n})\n\nsubscription.requestSnapshot()\n\n// The most recent failure remains available for diagnostics.\nconsole.log(subscription.lastError)\n```\n\nFor ordered live queries, `utils.setWindow()` rejects with the same error. The\nlast failure is also available as `utils.lastSubsetError`, while the last\nsuccessful snapshot remains readable:\n\n```ts\ntry {\n  await liveTodos.utils.setWindow({ offset: 0, limit: 100 })\n} catch (error) {\n  console.error(liveTodos.utils.lastSubsetError)\n}\n```\n\nEffects report subset failures through `onSourceError` and dispose because\ntheir incremental result can no longer be kept complete.\n\nWhen a source change invalidates an ordered window, automatic full-source\nrepair keeps the last complete snapshot visible. A failed repair exposes\n`utils.lastSubsetError` and retries at most twice, after 250 ms and 500 ms.\nExhausting those retries does not put an already-ready query into a terminal\nerror state or clear its rows. The app can show the error and explicitly retry\nwith `setWindow()`. Cleanup or truncate cancels the old repair timer. Failed\nimperative window moves and initial loads do not use this background retry.\n\nFor SQLite-persisted on-demand collections, a failed upstream `loadSubset`\nrejects even when hydration succeeded. Cached rows remain readable; their\navailability does not mean the remote request succeeded. Background coordinator\nretry, where supported, does not change the failed caller's outcome.\n\nWhen a must-refetch truncate cannot reload every active subset, a subscription\nkeeps its last successful snapshot and reports the subset error. It discards\nthe incomplete replay batch and keeps later source changes private because they\ncannot prove a complete replacement. The next truncate retries every active\nsubset. Overlapping truncates form one atomic replay: all in-flight requests\nsettle, the newest attempt decides the result, and subscribers receive the\nreplacement only when that attempt succeeds. Cleanup rejects window moves that\nare waiting for replay with `AbortError`.\n\n## Collection Status and Error States\n\nCollections track their status and transition between states:\n\n```tsx\nimport { useLiveQuery } from \"@tanstack/react-db\"\n\nconst TodoList = () => {\n  const { data, status, isError, isLoading, isReady } = useLiveQuery(\n    (query) => query.from({ todos: todoCollection })\n  )\n\n  if (isError) {\n    return <div>Collection is in error state</div>\n  }\n\n  if (isLoading) {\n    return <div>Loading...</div>\n  }\n\n  return <div>{data?.map(todo => <div key={todo.id}>{todo.text}</div>)}</div>\n}\n```\n\nCollection status values:\n- `idle` - Not yet started\n- `loading` - Loading initial data\n- `initialCommit` - Processing initial data\n- `ready` - Ready for use\n- `error` - In error state\n- `cleaned-up` - Cleaned up and no longer usable\n\n### Using Suspense and Error Boundaries (React)\n\nFor React applications, you can handle loading and error states with `useLiveSuspenseQuery`, React Suspense, and Error Boundaries:\n\n```tsx\nimport { useLiveSuspenseQuery } from \"@tanstack/react-db\"\nimport { Suspense } from \"react\"\nimport { ErrorBoundary } from \"react-error-boundary\"\n\nconst TodoList = () => {\n  // No need to check status - Suspense and ErrorBoundary handle it\n  const { data } = useLiveSuspenseQuery(\n    (query) => query.from({ todos: todoCollection })\n  )\n\n  // data is always defined here\n  return <div>{data.map(todo => <div key={todo.id}>{todo.text}</div>)}</div>\n}\n\nconst App = () => (\n  <ErrorBoundary fallback={<div>Failed to load todos</div>}>\n    <Suspense fallback={<div>Loading...</div>}>\n      <TodoList />\n    </Suspense>\n  </ErrorBoundary>\n)\n```\n\nWith this approach, loading states are handled by `<Suspense>` and error states are handled by `<ErrorBoundary>` instead of within your component logic. See the [React Suspense section in Live Queries](./live-queries#using-with-react-suspense) for more details.\n\nWhen every eager SQLite persisted source opts in, a failed client query stream can produce a different initial result. React waits for every persisted restore. If each restore succeeds, React renders the query result. A derived-query failure still reaches the Error Boundary. See [Render after SQLite restore](./sqlite-persistence.md#render-after-sqlite-restore) for the option and its limits.\n\n## Transaction Error Handling\n\nWhen mutations fail, TanStack DB automatically rolls back optimistic updates:\n\n```ts\nconst todoCollection = createCollection({\n  id: \"todos\",\n  onInsert: async ({ transaction }) => {\n    const response = await fetch(\"/api/todos\", {\n      method: \"POST\",\n      body: JSON.stringify(transaction.mutations[0].modified),\n    })\n    \n    if (!response.ok) {\n      // Throwing an error will rollback the optimistic state\n      throw new Error(`HTTP Error: ${response.status}`)\n    }\n    \n    return response.json()\n  },\n})\n\n// Usage - optimistic update will be rolled back if the mutation fails\ntry {\n  const tx = todoCollection.insert({\n    id: \"1\",\n    text: \"New todo\",\n    completed: false,\n  })\n  \n  await tx.when('settled')\n} catch (error) {\n  // The optimistic update has been automatically rolled back\n  console.error(\"Failed to create todo:\", error)\n}\n```\n\n### Transaction States and Error Information\n\nTransactions have the following states:\n- `pending` - Transaction is being processed\n- `persisting` - Currently executing the mutation function\n- `completed` - Transaction completed successfully\n- `failed` - Transaction failed and was rolled back\n\nAccess transaction error information from collection operations:\n\n```ts\nconst todoCollection = createCollection({\n  id: \"todos\",\n  onUpdate: async ({ transaction }) => {\n    const response = await fetch(`/api/todos/${transaction.mutations[0].key}`, {\n      method: \"PUT\",\n      body: JSON.stringify(transaction.mutations[0].modified),\n    })\n    \n    if (!response.ok) {\n      throw new Error(`Update failed: ${response.status}`)\n    }\n  },\n})\n\ntry {\n  const tx = await todoCollection.update(\"todo-1\", (draft) => {\n    draft.completed = true\n  })\n  \n  await tx.when('settled')\n} catch (error) {\n  // Transaction has been rolled back\n  console.log(tx.state) // \"failed\"\n  console.log(tx.error) // { message: \"Update failed: 500\", error: Error }\n}\n```\n\nOr with manual transaction creation:\n\n```ts\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    throw new Error(\"API failed\")\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Item\" })\n})\n\ntry {\n  await tx.commit()\n} catch (error) {\n  // Transaction has been rolled back\n  console.log(tx.state) // \"failed\"\n  console.log(tx.error) // { message: \"API failed\", error: Error }\n}\n```\n\nExplicit cancellation is different from a mutation failure. If you call\n`tx.rollback()` while `mutationFn` is pending, the rollback settles\n`tx.when('settled')` as rejected. A later result or rejection from that\nmutation function is ignored: the outstanding `commit()` call resolves and\n`tx.error` is not populated by that late rejection. Observe `tx.when('settled')`\nwhen you need the transaction's outcome, including explicit cancellation.\n\nAfter the mutation function succeeds, a publication listener can still throw\nwhile the completed transaction updates its collections. In that case\n`commit()` rejects with the listener error, but `tx.when('settled')` resolves\nand the transaction remains completed. This is not a persistence failure.\n\n## Collection Operation Errors\n\n### Invalid Collection State\n\nCollections in an `error` state cannot perform operations and must be manually recovered:\n\n```ts\nimport { CollectionInErrorStateError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.insert(newTodo)\n} catch (error) {\n  if (error instanceof CollectionInErrorStateError) {\n    // Collection needs to be cleaned up and restarted\n    await todoCollection.cleanup()\n    await todoCollection.preload()\n    \n    // Now retry the operation\n    todoCollection.insert(newTodo)\n  }\n}\n```\n\nIf a live query depends on this Collection, restart both Collections as shown\nin [Collection Cleanup and Restart](#collection-cleanup-and-restart).\n\n### Missing Mutation Handlers\n\nDirect mutations require handlers to be configured:\n\n```ts\nconst todoCollection = createCollection({\n  id: \"todos\",\n  getKey: (todo) => todo.id,\n  // Missing onInsert handler\n})\n\n// This will throw an error\ntodoCollection.insert(newTodo)\n// Error: Collection.insert called directly (not within an explicit transaction) but no 'onInsert' handler is configured\n```\n\n### Insert Operation Errors\n\n#### DuplicateKeyError\n\nThrown when inserting items with existing keys:\n\n```ts\nimport { DuplicateKeyError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.insert({ id: \"existing-id\", text: \"Todo\" })\n} catch (error) {\n  if (error instanceof DuplicateKeyError) {\n    console.log(`Duplicate key: ${error.message}`)\n    // Consider using update() instead, or check if item exists first\n  }\n}\n```\n\n#### UndefinedKeyError\n\nThrown when an object is created without a defined key:\n\n```ts\nimport { UndefinedKeyError } from \"@tanstack/db\"\n\nconst collection = createCollection({\n  id: \"todos\",\n  getKey: (item) => item.id,\n})\n\ntry {\n  collection.insert({ text: \"Todo\" }) // Missing 'id' field\n} catch (error) {\n  if (error instanceof UndefinedKeyError) {\n    console.log(\"Item is missing required key field\")\n    // Ensure your items have the key field defined by getKey\n  }\n}\n```\n\n### Update Operation Errors\n\n#### UpdateKeyNotFoundError\n\nThrown when trying to update a key that doesn't exist in the collection:\n\n```ts\nimport { UpdateKeyNotFoundError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.update(\"nonexistent-key\", draft => {\n    draft.completed = true\n  })\n} catch (error) {\n  if (error instanceof UpdateKeyNotFoundError) {\n    console.log(\"Key not found - item may have been deleted\")\n    // Consider using insert() if the item doesn't exist\n  }\n}\n```\n\n#### KeyUpdateNotAllowedError\n\nThrown when attempting to change an item's key (not allowed - delete and re-insert instead):\n\n```ts\nimport { KeyUpdateNotAllowedError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.update(\"todo-1\", draft => {\n    draft.id = \"todo-2\" // Not allowed!\n  })\n} catch (error) {\n  if (error instanceof KeyUpdateNotAllowedError) {\n    console.log(\"Cannot change item keys\")\n    // Instead, delete the old item and insert a new one\n  }\n}\n```\n\n### Delete Operation Errors\n\n#### DeleteKeyNotFoundError\n\nThrown when trying to delete a key that doesn't exist:\n\n```ts\nimport { DeleteKeyNotFoundError } from \"@tanstack/db\"\n\ntry {\n  todoCollection.delete(\"nonexistent-key\")\n} catch (error) {\n  if (error instanceof DeleteKeyNotFoundError) {\n    console.log(\"Key not found - item may have already been deleted\")\n    // This may be acceptable in some scenarios (idempotent deletes)\n  }\n}\n```\n\n## Sync Error Handling\n\n### Query Collection Sync Errors\n\nQuery collections distinguish an initial load failure from a later refetch failure:\n\n```ts\nimport { queryCollectionOptions } from \"@tanstack/query-db-collection\"\n\nconst todoCollection = createCollection(\n  queryCollectionOptions({\n    queryKey: [\"todos\"],\n    queryFn: async () => {\n      const response = await fetch(\"/api/todos\")\n      if (!response.ok) {\n        throw new Error(`Failed to fetch: ${response.status}`)\n      }\n      return response.json()\n    },\n    queryClient,\n    getKey: (item) => item.id,\n    schema: todoSchema,\n    // Standard TanStack Query error handling options\n    retry: 3,\n    retryDelay: (attemptIndex) => Math.min(1000 * 2 ** attemptIndex, 30000),\n  })\n)\n```\n\nWhen sync errors occur:\n- Error is logged to console: `[QueryCollection] Error observing query...`\n- An initial failure marks the collection as `error` because no usable snapshot exists\n- Readiness waits such as `preload()` and `toArrayWhenReady()` reject with the cause passed to `markError(error)` while the collection is in that initial error state\n- A later refetch failure keeps the collection `ready` and preserves its cached data\n- Error tracking counters are updated (`lastError`, `errorCount`)\n- A later successful refetch recovers an initial `error` collection to `ready`; a new readiness wait then resolves normally\n\n### Sync Write Errors\n\nSync functions must handle their own errors during write operations:\n\n```ts\nconst collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ begin, write, commit }) => {\n      begin()\n      \n      try {\n        // Will throw if key already exists\n        write({ type: \"insert\", value: { id: \"existing-id\", text: \"Todo\" } })\n      } catch (error) {\n        // Error: Cannot insert document with key \"existing-id\" from sync because it already exists\n      }\n      \n      commit()\n    }\n  }\n})\n```\n\n### Cleanup Error Handling\n\nCleanup errors are isolated to prevent blocking the cleanup process:\n\n```ts\nconst collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ begin, commit }) => {\n      begin()\n      commit()\n      \n      // Return a cleanup function\n      return () => {\n        // If this throws, the error is re-thrown in a microtask\n        // but cleanup continues successfully\n        throw new Error(\"Sync cleanup failed\")\n      }\n    },\n  },\n})\n\n// Cleanup completes even if the sync cleanup function throws\nawait collection.cleanup() // Resolves successfully\n// Error is re-thrown asynchronously via queueMicrotask\n```\n\n## Error Recovery Patterns\n\n### Collection Cleanup and Restart\n\nCleanup ends the current sync run and releases the resources installed by its\n`sync()` call. A later access can start a new sync run. If no live query or\nEffect depends on the source Collection, restart it like this:\n\n```ts\nif (todoCollection.status === \"error\") {\n  // Cleanup ends the current sync run and resets the collection\n  await todoCollection.cleanup()\n  \n  // Start a new sync run and wait for readiness\n  await todoCollection.preload()\n}\n```\n\nCleaning up a source Collection while a live-query Collection depends on it\nputs that live query in a terminal error state. Restarting the source alone\ndoes not revive the live query. If you own both Collections, clean up the\ndependent live query first. Preloading it after source cleanup starts fresh\nsync runs for both Collections and waits for the query's required data:\n\n```ts\nconst todosQuery = createLiveQueryCollection((q) =>\n  q.from({ todos: todoCollection }),\n)\nawait todosQuery.preload()\n\n// Later, if todoCollection enters an error state:\nawait todosQuery.cleanup()\nawait todoCollection.cleanup()\nawait todosQuery.preload()\n```\n\nThe same `todosQuery` object and its subscribers can receive later source\nupdates after this sequence. A framework hook that creates its own live-query\nCollection may retain it across renders or remounts. Use a pre-created\nlive-query Collection when you need to control this cleanup and restart\nsequence. A successful preload establishes Collection readiness; whether the\nsource has caught up with a remote service depends on its sync adapter.\nCleanup also disposes dependent Effects; recreate them after the source restarts.\n\n### Graceful Degradation\n\nCollections continue to work with cached data even when sync fails:\n\n```tsx\nconst TodoApp = () => {\n  const { data, isError } = useLiveQuery((query) => \n    query.from({ todos: todoCollection })\n  )\n\n  return (\n    <div>\n      {isError && (\n        <div>Sync failed, but you can still view cached data</div>\n      )}\n      {data?.map(todo => <TodoItem key={todo.id} todo={todo} />)}\n    </div>\n  )\n}\n```\n\n### Transaction Rollback Cascading\n\nWhen a transaction fails, conflicting transactions are automatically rolled back:\n\n```ts\nconst tx1 = createTransaction({ mutationFn: async () => {} })\nconst tx2 = createTransaction({ mutationFn: async () => {} })\n\ntx1.mutate(() => collection.update(\"1\", draft => { draft.value = \"A\" }))\ntx2.mutate(() => collection.update(\"1\", draft => { draft.value = \"B\" })) // Same item\n\n// Rolling back tx1 will also rollback tx2 due to conflict\ntx1.rollback() // tx2 is automatically rolled back\n```\n\n### Transaction Lifecycle Errors\n\nTransactions validate their state before operations to prevent misuse. Here are the specific errors you may encounter:\n\n#### MissingMutationFunctionError\n\nThrown when creating a transaction without a required `mutationFn`:\n\n```ts\nimport { MissingMutationFunctionError } from \"@tanstack/db\"\n\ntry {\n  const tx = createTransaction({}) // Missing mutationFn\n} catch (error) {\n  if (error instanceof MissingMutationFunctionError) {\n    console.log(\"mutationFn is required when creating a transaction\")\n  }\n}\n```\n\n#### TransactionNotPendingMutateError\n\nThrown when calling `mutate()` after a transaction is no longer pending:\n\n```ts\nimport { TransactionNotPendingMutateError } from \"@tanstack/db\"\n\nconst tx = createTransaction({ mutationFn: async () => {} })\n\nawait tx.commit()\n\ntry {\n  tx.mutate(() => {\n    collection.insert({ id: \"1\", text: \"Item\" })\n  })\n} catch (error) {\n  if (error instanceof TransactionNotPendingMutateError) {\n    console.log(\"Cannot mutate - transaction is no longer pending\")\n  }\n}\n```\n\n#### TransactionNotPendingCommitError\n\nThrown when calling `commit()` after a transaction is no longer pending:\n\n```ts\nimport { TransactionNotPendingCommitError } from \"@tanstack/db\"\n\nconst tx = createTransaction({ mutationFn: async () => {} })\ntx.mutate(() => collection.insert({ id: \"1\", text: \"Item\" }))\n\nawait tx.commit()\n\ntry {\n  await tx.commit() // Trying to commit again\n} catch (error) {\n  if (error instanceof TransactionNotPendingCommitError) {\n    console.log(\"Transaction already committed\")\n  }\n}\n```\n\n#### TransactionAlreadyCompletedRollbackError\n\nThrown when calling `rollback()` on a transaction that's already completed:\n\n```ts\nimport { TransactionAlreadyCompletedRollbackError } from \"@tanstack/db\"\n\nconst tx = createTransaction({ mutationFn: async () => {} })\ntx.mutate(() => collection.insert({ id: \"1\", text: \"Item\" }))\n\nawait tx.commit()\n\ntry {\n  tx.rollback() // Can't rollback after commit\n} catch (error) {\n  if (error instanceof TransactionAlreadyCompletedRollbackError) {\n    console.log(\"Cannot rollback - transaction already completed\")\n  }\n}\n```\n\n### Sync Transaction Errors\n\nWhen working with sync transactions, these errors can occur:\n\n#### NoPendingSyncTransactionWriteError\n\nThrown when calling `write()` without an active sync transaction:\n\n```ts\nconst collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ write }) => {\n      // Calling write without begin() first\n      write({ type: \"insert\", value: { id: \"1\", text: \"Todo\" } })\n      // Error: No pending sync transaction to write to\n    }\n  }\n})\n```\n\n#### SyncTransactionAlreadyCommittedWriteError\n\nThrown when calling `write()` after the sync transaction is already committed:\n\n```ts\nconst collection = createCollection({\n  id: \"todos\",\n  sync: {\n    sync: ({ begin, write, commit }) => {\n      begin()\n      commit()\n\n      // Trying to write after commit\n      write({ type: \"insert\", value: { id: \"1\", text: \"Todo\" } })\n      // Error: The pending sync transaction is already committed\n    }\n  }\n})\n```\n\n#### NoPendingSyncTransactionCommitError\n\nThrown when calling `commit()` without an active sync transaction.\n\n#### SyncTransactionAlreadyCommittedError\n\nThrown when calling `commit()` on a sync transaction that's already committed.\n\n## Best Practices\n\n1. **Use instanceof checks** - Use `instanceof` instead of string matching for error handling:\n   ```ts\n   // ✅ Good - type-safe error handling\n   if (error instanceof SchemaValidationError) {\n     // Handle validation error\n   }\n   \n   // ❌ Avoid - brittle string matching  \n   if (error.message.includes(\"validation failed\")) {\n     // Handle validation error\n   }\n   ```\n\n2. **Import specific error types** - Import only the error classes you need for better tree-shaking\n3. **Always handle SchemaValidationError** - Provide clear feedback for validation failures\n4. **Check collection status** - Use `isError`, `isLoading`, `isReady` flags in React components\n5. **Handle transaction promises** - Always handle `when('settled')` rejections\n\n## Example: Complete Error Handling\n\n```tsx\nimport {\n  createCollection,\n  createLiveQueryCollection,\n  SchemaValidationError,\n  DuplicateKeyError,\n  UpdateKeyNotFoundError,\n  DeleteKeyNotFoundError,\n  TransactionNotPendingCommitError,\n  createTransaction\n} from \"@tanstack/db\"\nimport { useLiveQuery } from \"@tanstack/react-db\"\n\nconst todoCollection = createCollection({\n  id: \"todos\",\n  schema: todoSchema,\n  getKey: (todo) => todo.id,\n  onInsert: async ({ transaction }) => {\n    const response = await fetch(\"/api/todos\", {\n      method: \"POST\",\n      body: JSON.stringify(transaction.mutations[0].modified),\n    })\n\n    if (!response.ok) {\n      throw new Error(`HTTP ${response.status}: ${response.statusText}`)\n    }\n\n    return response.json()\n  },\n  sync: {\n    sync: ({ begin, write, commit, markReady }) => {\n      // Your sync implementation\n      begin()\n      // ... sync logic\n      commit()\n      markReady()\n    }\n  }\n})\n\nconst todosQuery = createLiveQueryCollection((query) =>\n  query.from({ todos: todoCollection })\n)\n\nconst TodoApp = () => {\n  const { data, isError, isLoading } = useLiveQuery(todosQuery)\n\n  const handleAddTodo = async (text: string) => {\n    try {\n      const tx = await todoCollection.insert({\n        id: crypto.randomUUID(),\n        text,\n        completed: false,\n      })\n      \n      // Wait for persistence\n      await tx.when('settled')\n    } catch (error) {\n      if (error instanceof SchemaValidationError) {\n        alert(`Validation error: ${error.issues[0]?.message}`)\n      } else if (error instanceof DuplicateKeyError) {\n        alert(\"A todo with this ID already exists\")\n      } else {\n        alert(`Failed to add todo: ${error.message}`)\n      }\n    }\n  }\n\n  const handleRestart = async () => {\n    try {\n      await todosQuery.cleanup()\n      await todoCollection.cleanup()\n      await todosQuery.preload()\n    } catch (error) {\n      alert(`Failed to restart todos: ${String(error)}`)\n    }\n  }\n\n  if (isError) {\n    return (\n      <div>\n        <div>Collection error - data may be stale</div>\n        <button onClick={handleRestart}>Restart Collections</button>\n      </div>\n    )\n  }\n\n  if (isLoading) {\n    return <div>Loading todos...</div>\n  }\n\n  return (\n    <div>\n      <button onClick={() => handleAddTodo(\"New todo\")}>\n        Add Todo\n      </button>\n      {data?.map(todo => (\n        <div key={todo.id}>{todo.text}</div>\n      ))}\n    </div>\n  )\n}\n```\n\n## See Also\n\n- [API Reference](../overview.md#api-reference) - Detailed API documentation\n- [Mutations Guide](../overview.md#making-optimistic-mutations) - Learn about optimistic updates and rollbacks\n- [TanStack Query Error Handling](https://tanstack.com/query/latest/docs/react/guides/error-handling) - Query-specific error handling\n"}
