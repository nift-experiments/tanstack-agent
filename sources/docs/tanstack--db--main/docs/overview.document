title: Overview
id: overview
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Welcome to the TanStack DB documentation."}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack DB is the reactive client store for your API. It solves the problems of building fast, modern apps, helping you:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"avoid endpoint sprawl and network waterfalls by loading data into normalized collections"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"optimise client performance with sub-millisecond live queries and real-time reactivity"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"take the network off the interaction path with instant optimistic writes"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Data loading is optimized. Interactions feel instantaneous. Your backend stays simple and your app stays blazing fast. No matter how much data you load."}]},{"type":"heading","depth":2,"id":"remove-the-complexity-from-building-fast-modern-apps","children":[{"type":"text","value":"Remove the complexity from building fast, modern apps"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack DB lets you query your data however your components need it, with a blazing-fast local query engine, real-time reactivity and instant optimistic updates."}]},{"type":"paragraph","children":[{"type":"text","value":"Instead of choosing between the least of two evils:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"view-specific APIs"}]},{"type":"text","value":" - complicating your backend and leading to network waterfalls"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"load everything and filter"}]},{"type":"text","value":" - leading to slow loads and sluggish client performance"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack DB enables a new way:"}]},{"type":"list","ordered":true,"start":3,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"normalized collections"}]},{"type":"text","value":" - keep your backend simple"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"query-driven sync"}]},{"type":"text","value":" - optimizes your data loading"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"sub-millisecond live queries"}]},{"type":"text","value":" - keep your app fast and responsive"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"It extends TanStack Query with collections, live queries and optimistic mutations, working seamlessly with REST APIs, sync engines, or any data source."}]},{"type":"heading","depth":2,"id":"contents","children":[{"type":"text","value":"Contents"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#how-it-works","children":[{"type":"text","value":"How it works"}]},{"type":"text","value":" — understand the TanStack DB development model and how the pieces fit together"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/ssr.md","children":[{"type":"text","value":"SSR and hydration"}]},{"type":"text","value":" — use "},{"type":"inlineCode","value":"DbClient"},{"type":"text","value":" to transport explicit collection rows or live-query result snapshots"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/sqlite-persistence.md","children":[{"type":"text","value":"SQLite persistence"}]},{"type":"text","value":" — retain Collection rows across restarts and save sync metadata for supported adapters"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/offline-transactions.md","children":[{"type":"text","value":"Offline transactions"}]},{"type":"text","value":" — retain pending mutations and retry them later"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#api-reference","children":[{"type":"text","value":"API reference"}]},{"type":"text","value":" — for the primitives and function interfaces"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#usage-examples","children":[{"type":"text","value":"Usage examples"}]},{"type":"text","value":" — examples of common usage patterns"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#more-info","children":[{"type":"text","value":"More info"}]},{"type":"text","value":" — where to find support and more information"}]}]}]},{"type":"heading","depth":2,"id":"how-it-works","children":[{"type":"text","value":"How it works"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack DB works by:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#defining-collections","children":[{"type":"text","value":"defining collections"}]},{"type":"text","value":" typed sets of objects that can be populated with data"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#using-live-queries","children":[{"type":"text","value":"using live queries"}]},{"type":"text","value":" to query data from/across collections"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#making-optimistic-mutations","children":[{"type":"text","value":"making optimistic mutations"}]},{"type":"text","value":" using transactional mutators"}]}]}]},{"type":"code","value":"import {\n  DbClient,\n  DbProvider,\n  collectionOptions,\n  not,\n  useDbClient,\n  useLiveQuery,\n} from '@tanstack/react-db'\n\n// Define stable collection descriptors to load data into\nconst todoCollection = collectionOptions('todos', () => ({\n  id: 'todos',\n  // ...your config\n  onUpdate: updateMutationFn,\n}))\n\nfunction useTodoCollection() {\n  return useDbClient().collection(todoCollection)\n}\n\nconst Todos = () => {\n  const todosCollection = useTodoCollection()\n\n  // Bind data using live queries\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q.from({ todo: todoCollection }).where(({ todo }) => not(todo.completed)),\n  })\n\n  const complete = (todo) => {\n    // Instantly applies optimistic state\n    todosCollection.update(todo.id, (draft) => {\n      draft.completed = true\n    })\n  }\n\n  return (\n    <ul>\n      {todos.map((todo) => (\n        <li key={todo.id} onClick={() => complete(todo)}>\n          {todo.text}\n        </li>\n      ))}\n    </ul>\n  )\n}\n\nconst dbClient = new DbClient()\n\nconst App = () => (\n  <DbProvider client={dbClient}>\n    <Todos />\n  </DbProvider>\n)","lang":"tsx"},{"type":"heading","depth":3,"id":"defining-collections","children":[{"type":"text","value":"Defining collections"}]},{"type":"paragraph","children":[{"type":"text","value":"Collections are typed sets of objects that can be populated with data. They're designed to de-couple loading data into your app from binding data to your components."}]},{"type":"paragraph","children":[{"type":"text","value":"Collections can be populated in many ways, including:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"fetching data, for example "},{"type":"link","href":"https://tanstack.com/query/latest","children":[{"type":"text","value":"from API endpoints using TanStack Query"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"syncing data, for example "},{"type":"link","href":"https://electric-sql.com/","children":[{"type":"text","value":"using a sync engine like ElectricSQL"}]},{"type":"text","value":" or "},{"type":"link","href":"https://powersync.com","children":[{"type":"text","value":"PowerSync"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"storing local data, for example "},{"type":"link","href":"./collections/local-storage-collection.md","children":[{"type":"text","value":"using localStorage for user preferences and settings"}]},{"type":"text","value":" or "},{"type":"link","href":"./collections/local-only-collection.md","children":[{"type":"text","value":"in-memory client data or UI state"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"from live collection queries, creating "},{"type":"link","href":"#using-live-queries","children":[{"type":"text","value":"derived collections as materialised views"}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Once you have your data in collections, you can query across them using live queries in your components."}]},{"type":"heading","depth":4,"id":"sync-modes","children":[{"type":"text","value":"Sync Modes"}]},{"type":"paragraph","children":[{"type":"text","value":"Collections support three sync modes to optimize data loading:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Eager mode"}]},{"type":"text","value":" (default): Loads entire collection upfront. Best for <10k rows of mostly static data like user preferences or small reference tables."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"On-demand mode"}]},{"type":"text","value":": Loads only what queries request. Best for large datasets (>50k rows), search interfaces, and catalogs where most data won't be accessed."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Progressive mode"}]},{"type":"text","value":": Loads query subset immediately, syncs full dataset in background. Best for collaborative apps needing instant first paint AND sub-millisecond queries."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"With on-demand mode, your component's query becomes the API call:"}]},{"type":"code","value":"const productsCollection = collectionOptions('products', (client) =>\n  queryCollectionOptions({\n    id: 'products',\n    queryKey: ['products'],\n    queryClient: client.requireDependency<QueryClient>('queryClient'),\n    queryFn: async (ctx) => {\n      // Query predicates passed automatically in ctx.meta\n      const params = parseLoadSubsetOptions(ctx.meta?.loadSubsetOptions)\n      return api.getProducts(params) // e.g., GET /api/products?category=electronics&price_lt=100\n    },\n    getKey: (product) => product.id,\n    syncMode: 'on-demand', // ← Enable query-driven sync\n  })\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"TanStack DB automatically collapses duplicate requests, performs delta loading when expanding queries, optimizes joins into minimal batched requests, and respects your TanStack Query cache policies. You often end up with "},{"type":"emphasis","children":[{"type":"text","value":"fewer"}]},{"type":"text","value":" network requests than custom view-specific APIs."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./collections/query-collection.md#queryfn-and-predicate-push-down","children":[{"type":"text","value":"Query Collection documentation"}]},{"type":"text","value":" for full predicate mapping details."}]},{"type":"heading","depth":3,"id":"using-live-queries","children":[{"type":"text","value":"Using live queries"}]},{"type":"paragraph","children":[{"type":"text","value":"Live queries are used to query data out of collections. Live queries are reactive: when the underlying data changes in a way that would affect the query result, the result is incrementally updated and returned from the query, triggering a re-render."}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack DB live queries are implemented using "},{"type":"link","href":"https://github.com/electric-sql/d2ts","children":[{"type":"text","value":"d2ts"}]},{"type":"text","value":", a TypeScript implementation of differential dataflow. This allows the query results to update "},{"type":"emphasis","children":[{"type":"text","value":"incrementally"}]},{"type":"text","value":" (rather than by re-running the whole query). This makes them blazing fast, usually sub-millisecond, even for highly complex queries."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Performance:"}]},{"type":"text","value":" Updating one row in a sorted 100,000-item collection completes in ~0.7ms on an M1 Pro MacBook—fast enough that optimistic updates feel truly instantaneous, even with complex queries and large datasets."}]},{"type":"paragraph","children":[{"type":"text","value":"Live queries support joins across collections. This allows you to:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"load normalised data into collections and then de-normalise it through queries; simplifying your backend by avoiding the need for bespoke API endpoints that match your client"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"join data from multiple sources; for example, syncing some data out of a database, fetching some other data from an external API and then joining these into a unified data model for your front-end code"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Every query returns another collection which can "},{"type":"emphasis","children":[{"type":"text","value":"also"}]},{"type":"text","value":" be queried."}]},{"type":"paragraph","children":[{"type":"text","value":"For more details on live queries, see the "},{"type":"link","href":"./guides/live-queries.md","children":[{"type":"text","value":"Live Queries"}]},{"type":"text","value":" documentation."}]},{"type":"heading","depth":3,"id":"making-optimistic-mutations","children":[{"type":"text","value":"Making optimistic mutations"}]},{"type":"paragraph","children":[{"type":"text","value":"Collections support "},{"type":"inlineCode","value":"insert"},{"type":"text","value":", "},{"type":"inlineCode","value":"update"},{"type":"text","value":" and "},{"type":"inlineCode","value":"delete"},{"type":"text","value":" operations. When called, by default they trigger the corresponding "},{"type":"inlineCode","value":"onInsert"},{"type":"text","value":", "},{"type":"inlineCode","value":"onUpdate"},{"type":"text","value":", "},{"type":"inlineCode","value":"onDelete"},{"type":"text","value":" handlers which are responsible for writing the mutation to the backend."}]},{"type":"code","value":"// Define collection with persistence handlers\nconst todoCollection = collectionOptions('todos', () => ({\n  id: \"todos\",\n  // ... other config\n  onUpdate: async ({ transaction }) => {\n    const { original, changes } = transaction.mutations[0]\n    await api.todos.update(original.id, changes)\n  },\n}))\nconst todosCollection = dbClient.collection(todoCollection)\n\n// Immediately applies optimistic state\ntodosCollection.update(todo.id, (draft) => {\n  draft.completed = true\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The collection maintains optimistic state separately from synced data. When live queries read from the collection, they see a local view that overlays the optimistic mutations on top of the immutable synced data."}]},{"type":"paragraph","children":[{"type":"text","value":"The optimistic state is held until the handler resolves, at which point the data is persisted to the server and synced back. If the handler throws an error, the optimistic state is rolled back."}]},{"type":"paragraph","children":[{"type":"text","value":"For more complex mutations, you can create custom actions with "},{"type":"inlineCode","value":"createOptimisticAction"},{"type":"text","value":" or custom transactions with "},{"type":"inlineCode","value":"createTransaction"},{"type":"text","value":". See the "},{"type":"link","href":"./guides/mutations.md","children":[{"type":"text","value":"Mutations guide"}]},{"type":"text","value":" for details."}]},{"type":"heading","depth":3,"id":"uni-directional-data-flow","children":[{"type":"text","value":"Uni-directional data flow"}]},{"type":"paragraph","children":[{"type":"text","value":"This combines to support a model of uni-directional data flow, extending the redux/flux style state management pattern beyond the client, to take in the server as well:"}]},{"type":"html","value":"<figure>\n  <a href=\"https://raw.githubusercontent.com/TanStack/db/main/docs/unidirectional-data-flow.lg.png\" target=\"_blank\">\n    <img src=\"https://raw.githubusercontent.com/TanStack/db/main/docs/unidirectional-data-flow.png\" />\n  </a>\n</figure>"},{"type":"paragraph","children":[{"type":"text","value":"With an instant inner loop of optimistic state, superseded in time by the slower outer loop of persisting to the server and syncing the updated server state back into the collection."}]},{"type":"heading","depth":2,"id":"api-reference","children":[{"type":"text","value":"API reference"}]},{"type":"heading","depth":3,"id":"collections","children":[{"type":"text","value":"Collections"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack DB provides several built-in collection types for different data sources and use cases. Each collection type has its own detailed documentation page:"}]},{"type":"heading","depth":4,"id":"built-in-collection-types","children":[{"type":"text","value":"Built-in Collection Types"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Fetch Collections"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"link","href":"./collections/query-collection.md","children":[{"type":"text","value":"QueryCollection"}]}]},{"type":"text","value":" — Load data into collections using TanStack Query for REST APIs and data fetching."}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Sync Collections"}]}]},{"type":"list","ordered":false,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"link","href":"./collections/electric-collection.md","children":[{"type":"text","value":"ElectricCollection"}]}]},{"type":"text","value":" — Sync data into collections from Postgres using ElectricSQL's real-time sync engine."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"link","href":"./collections/trailbase-collection.md","children":[{"type":"text","value":"TrailBaseCollection"}]}]},{"type":"text","value":" — Sync data into collections using TrailBase's self-hosted backend with real-time subscriptions."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"link","href":"./collections/rxdb-collection.md","children":[{"type":"text","value":"RxDBCollection"}]}]},{"type":"text","value":" — Integrate with RxDB for offline-first local persistence with powerful replication and sync capabilities."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"link","href":"./collections/powersync-collection.md","children":[{"type":"text","value":"PowerSyncCollection"}]}]},{"type":"text","value":" — Sync with PowerSync's SQLite-based database for offline-first persistence with real-time synchronization with PostgreSQL, MongoDB, and MySQL backends."}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Local Collections"}]}]},{"type":"list","ordered":false,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"link","href":"./collections/indexed-db-collection.md","children":[{"type":"text","value":"IndexedDB Collection"}]}]},{"type":"text","value":" — Persist local browser data in IndexedDB with asynchronous writes and cross-tab notifications."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"link","href":"./collections/local-storage-collection.md","children":[{"type":"text","value":"LocalStorageCollection"}]}]},{"type":"text","value":" — Store small amounts of local-only state that persists across sessions and syncs across browser tabs."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"link","href":"./collections/local-only-collection.md","children":[{"type":"text","value":"LocalOnlyCollection"}]}]},{"type":"text","value":" — Manage in-memory client data or UI state that doesn't need persistence or cross-tab sync."}]}]}]},{"type":"heading","depth":4,"id":"collection-schemas","children":[{"type":"text","value":"Collection Schemas"}]},{"type":"paragraph","children":[{"type":"text","value":"All collections optionally (though strongly recommended) support adding a "},{"type":"inlineCode","value":"schema"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"If provided, this must be a "},{"type":"link","href":"https://standardschema.dev","children":[{"type":"text","value":"Standard Schema"}]},{"type":"text","value":" compatible schema instance, such as "},{"type":"link","href":"https://zod.dev","children":[{"type":"text","value":"Zod"}]},{"type":"text","value":", "},{"type":"link","href":"https://valibot.dev","children":[{"type":"text","value":"Valibot"}]},{"type":"text","value":", "},{"type":"link","href":"https://arktype.io","children":[{"type":"text","value":"ArkType"}]},{"type":"text","value":", or "},{"type":"link","href":"https://effect.website/docs/schema/introduction/","children":[{"type":"text","value":"Effect"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"What schemas do:"}]}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Runtime validation"}]},{"type":"text","value":" - Ensures data meets your constraints before entering the collection"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Type transformations"}]},{"type":"text","value":" - Convert input types to rich output types (e.g., string → Date)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Default values"}]},{"type":"text","value":" - Automatically populate missing fields"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Type safety"}]},{"type":"text","value":" - Infer TypeScript types from your schema"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Example:"}]}]},{"type":"code","value":"const todoSchema = z.object({\n  id: z.string(),\n  text: z.string(),\n  completed: z.boolean().default(false),\n  created_at: z.string().transform(val => new Date(val)),  // string → Date\n  priority: z.number().default(0)\n})\n\nconst todoCollection = collectionOptions(\n  queryCollectionOptions({\n    id: \"todos\",\n    schema: todoSchema,\n    // ...\n  })\n)\nconst collection = dbClient.collection(todoCollection)\n\n// Users provide simple inputs\ncollection.insert({\n  id: \"1\",\n  text: \"Buy groceries\",\n  created_at: \"2024-01-01T00:00:00Z\"  // string\n  // completed and priority filled automatically\n})\n\n// Collection stores and returns rich types\nconst todo = collection.get(\"1\")\nconsole.log(todo.created_at.getFullYear())  // It's a Date!\nconsole.log(todo.completed)  // false (default)","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"The collection will use the schema for its type inference. If you provide a schema, you cannot also pass an explicit type parameter (e.g., "},{"type":"inlineCode","value":"createCollection<Todo>()"},{"type":"text","value":")."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Learn more:"}]},{"type":"text","value":" See the "},{"type":"link","href":"./guides/schemas.md","children":[{"type":"text","value":"Schemas guide"}]},{"type":"text","value":" for comprehensive documentation on schema validation, type transformations, and best practices."}]},{"type":"heading","depth":4,"id":"creating-custom-collection-types","children":[{"type":"text","value":"Creating Custom Collection Types"}]},{"type":"paragraph","children":[{"type":"text","value":"You can create your own collection types by implementing the "},{"type":"inlineCode","value":"Collection"},{"type":"text","value":" interface found in "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts","children":[{"type":"inlineCode","value":"../packages/db/src/collection/index.ts"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"See the existing implementations in "},{"type":"link","href":"https://github.com/TanStack/db/tree/main/packages/db","children":[{"type":"inlineCode","value":"../packages/db"}]},{"type":"text","value":", "},{"type":"link","href":"https://github.com/TanStack/db/tree/main/packages/query-db-collection","children":[{"type":"inlineCode","value":"../packages/query-db-collection"}]},{"type":"text","value":", "},{"type":"link","href":"https://github.com/TanStack/db/tree/main/packages/electric-db-collection","children":[{"type":"inlineCode","value":"../packages/electric-db-collection"}]},{"type":"text","value":", "},{"type":"link","href":"https://github.com/TanStack/db/tree/main/packages/trailbase-db-collection","children":[{"type":"inlineCode","value":"../packages/trailbase-db-collection"}]},{"type":"text","value":" and "},{"type":"link","href":"https://github.com/TanStack/db/tree/main/packages/powersync-db-collection","children":[{"type":"inlineCode","value":"../packages/powersync-db-collection"}]},{"type":"text","value":" for reference. Also see the "},{"type":"link","href":"./guides/collection-options-creator.md","children":[{"type":"text","value":"Collection Options Creator guide"}]},{"type":"text","value":" for a pattern to create reusable collection configuration factories."}]},{"type":"heading","depth":3,"id":"live-queries","children":[{"type":"text","value":"Live queries"}]},{"type":"heading","depth":4,"id":"uselivequery-hook","children":[{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":" hook"}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":" hook to assign live query results to a state variable in your React components:"}]},{"type":"code","value":"import { useLiveQuery } from '@tanstack/react-db'\nimport { eq } from '@tanstack/db'\n\nconst Todos = () => {\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todo: todoCollection })\n        .where(({ todo }) => eq(todo.completed, false))\n        .orderBy(({ todo }) => todo.created_at, 'asc')\n        .select(({ todo }) => ({\n          id: todo.id,\n          text: todo.text\n        })),\n  })\n\n  return <List items={ todos } />\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"You can also query across collections with joins:"}]},{"type":"code","value":"import { useLiveQuery } from '@tanstack/react-db'\nimport { eq } from '@tanstack/db'\n\nconst Todos = () => {\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todos: todoCollection })\n        .join(\n          { lists: listCollection },\n          ({ todos, lists }) => eq(lists.id, todos.listId),\n          'inner'\n        )\n        .where(({ lists }) => eq(lists.active, true))\n        .select(({ todos, lists }) => ({\n          id: todos.id,\n          title: todos.title,\n          listName: lists.name\n        })),\n  })\n\n  return <List items={ todos } />\n}","lang":"ts"},{"type":"heading","depth":4,"id":"uselivesuspensequery-hook","children":[{"type":"inlineCode","value":"useLiveSuspenseQuery"},{"type":"text","value":" hook"}]},{"type":"paragraph","children":[{"type":"text","value":"For React Suspense support, use "},{"type":"inlineCode","value":"useLiveSuspenseQuery"},{"type":"text","value":". This hook suspends rendering during initial data load and guarantees that "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is always defined:"}]},{"type":"code","value":"import { useLiveSuspenseQuery } from '@tanstack/react-db'\nimport { Suspense } from 'react'\n\nconst Todos = () => {\n  // data is always defined - no need for optional chaining\n  const { data: todos } = useLiveSuspenseQuery({\n    query: (q) =>\n      q\n        .from({ todo: todoCollection })\n        .where(({ todo }) => eq(todo.completed, false)),\n  })\n\n  return <List items={ todos } />\n}\n\nconst App = () => (\n  <Suspense fallback={<div>Loading...</div>}>\n    <Todos />\n  </Suspense>\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./guides/live-queries#using-with-react-suspense","children":[{"type":"text","value":"React Suspense section in Live Queries"}]},{"type":"text","value":" for detailed usage patterns and when to use "},{"type":"inlineCode","value":"useLiveSuspenseQuery"},{"type":"text","value":" vs "},{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"querybuilder","children":[{"type":"inlineCode","value":"queryBuilder"}]},{"type":"paragraph","children":[{"type":"text","value":"You can also build queries directly (outside of the component lifecycle) using the underlying "},{"type":"inlineCode","value":"queryBuilder"},{"type":"text","value":" API:"}]},{"type":"code","value":"import { createLiveQueryCollection, eq } from \"@tanstack/db\"\n\nconst completedTodos = createLiveQueryCollection({\n  startSync: true,\n  query: (q) =>\n    q\n      .from({ todo: todoCollection })\n      .where(({ todo }) => eq(todo.completed, true)),\n})\n\nconst results = completedTodos.toArray","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Note also that:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the query results "},{"type":"link","href":"#derived-collections","children":[{"type":"text","value":"are themselves a collection"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the "},{"type":"inlineCode","value":"useLiveQuery"},{"type":"text","value":" automatically starts and stops live query subscriptions when you mount and unmount your components; if you're creating queries manually, you need to manually manage the subscription lifecycle yourself"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./guides/live-queries.md","children":[{"type":"text","value":"Live Queries"}]},{"type":"text","value":" documentation for more details."}]},{"type":"heading","depth":3,"id":"transactional-mutators","children":[{"type":"text","value":"Transactional mutators"}]},{"type":"paragraph","children":[{"type":"text","value":"For more complex mutations beyond simple CRUD operations, TanStack DB provides "},{"type":"inlineCode","value":"createOptimisticAction"},{"type":"text","value":" and "},{"type":"inlineCode","value":"createTransaction"},{"type":"text","value":" for creating custom mutations with full control over the mutation lifecycle."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./guides/mutations.md","children":[{"type":"text","value":"Mutations guide"}]},{"type":"text","value":" for comprehensive documentation on:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Creating custom actions with "},{"type":"inlineCode","value":"createOptimisticAction"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Manual transactions with "},{"type":"inlineCode","value":"createTransaction"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Mutation merging behavior"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Controlling optimistic vs non-optimistic updates"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Handling temporary IDs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Transaction lifecycle states"}]}]}]},{"type":"heading","depth":2,"id":"usage-examples","children":[{"type":"text","value":"Usage examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Here we illustrate two common ways of using TanStack DB:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#1-tanstack-query","children":[{"type":"text","value":"using TanStack Query"}]},{"type":"text","value":" with an existing REST API"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#2-sync-engine","children":[{"type":"text","value":"using a sync engine"}]},{"type":"text","value":" for real-time sync with your backend"}]}]}]},{"type":"callout","kind":"tip","title":"Tip","children":[{"type":"paragraph","children":[{"type":"text","value":"You can combine these patterns. One of the benefits of TanStack DB is that you can integrate different ways of loading data and handling mutations into the same app. Your components don't need to know where the data came from or goes."}]}]},{"type":"heading","depth":3,"id":"1-tanstack-query","children":[{"type":"text","value":"1. TanStack Query"}]},{"type":"paragraph","children":[{"type":"text","value":"You can use TanStack DB with your existing REST API via TanStack Query."}]},{"type":"paragraph","children":[{"type":"text","value":"The steps are to:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"create "},{"type":"link","href":"./collections/query-collection.md","children":[{"type":"text","value":"QueryCollection"}]},{"type":"text","value":"s that load data using TanStack Query"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"implement mutation handlers that handle mutations by posting them to your API endpoints"}]}]}]},{"type":"code","value":"import {\n  DbClient,\n  DbProvider,\n  collectionOptions,\n  useLiveQuery,\n} from \"@tanstack/react-db\"\nimport { queryCollectionOptions } from \"@tanstack/query-db-collection\"\nimport { QueryClient } from \"@tanstack/query-core\"\n\nconst queryClient = new QueryClient()\nconst dbClient = new DbClient({ queryClient })\n\n// Load data into collections using TanStack Query.\n// It's common to define these in a `collections` module.\nconst todoCollection = collectionOptions(\"todos\", (client) =>\n  queryCollectionOptions({\n    id: \"todos\",\n    queryKey: [\"todos\"],\n    queryClient: client.requireDependency<QueryClient>(\"queryClient\"),\n    queryFn: async () => fetch(\"/api/todos\").then((response) => response.json()),\n    getKey: (item) => item.id,\n    schema: todoSchema, // any standard schema\n    onInsert: async ({ transaction, collection }) => {\n      const { changes: newTodo } = transaction.mutations[0]\n\n      // Handle the local write by sending it to your API.\n      await api.todos.create(newTodo)\n      await collection.utils.refetch()\n      // Prevent the pre-1.0 compatibility wrapper from refetching again.\n      return { refetch: false }\n    },\n    // also add onUpdate, onDelete as needed.\n  })\n)\nconst listCollection = collectionOptions(\"todo-lists\", (client) =>\n  queryCollectionOptions({\n    id: \"todo-lists\",\n    queryKey: [\"todo-lists\"],\n    queryClient: client.requireDependency<QueryClient>(\"queryClient\"),\n    queryFn: async () =>\n      fetch(\"/api/todo-lists\").then((response) => response.json()),\n    getKey: (item) => item.id,\n    schema: todoListSchema,\n    onInsert: async ({ transaction, collection }) => {\n      const { changes: newTodo } = transaction.mutations[0]\n\n      // Handle the local write by sending it to your API.\n      await api.todoLists.create(newTodo)\n      await collection.utils.refetch()\n      // Prevent the pre-1.0 compatibility wrapper from refetching again.\n      return { refetch: false }\n    },\n    // also add onUpdate, onDelete as needed.\n  })\n)\n\nconst Todos = () => {\n  // Read the data using live queries. Here we show a live\n  // query that joins across two collections.\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todo: todoCollection })\n        .join(\n          { list: listCollection },\n          ({ todo, list }) => eq(list.id, todo.list_id),\n          \"inner\"\n        )\n        .where(({ list }) => eq(list.active, true))\n        .select(({ todo, list }) => ({\n          id: todo.id,\n          text: todo.text,\n          status: todo.status,\n          listName: list.name,\n        })),\n  })\n\n  // ...\n}\n\nconst App = () => (\n  <DbProvider client={dbClient}>\n    <Todos />\n  </DbProvider>\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"This pattern allows you to extend an existing TanStack Query application, or any application built on a REST API, with blazing fast, cross-collection live queries and local optimistic mutations with automatically managed optimistic state."}]},{"type":"heading","depth":3,"id":"2-sync-engine","children":[{"type":"text","value":"2. Sync Engine"}]},{"type":"paragraph","children":[{"type":"text","value":"One of the most powerful ways of using TanStack DB is with a sync engine, for a fully local-first experience with real-time sync. This allows you to incrementally adopt sync into an existing app, whilst still handling writes with your existing API."}]},{"type":"heading","depth":4,"id":"why-sync-engines","children":[{"type":"text","value":"Why Sync Engines?"}]},{"type":"paragraph","children":[{"type":"text","value":"While TanStack DB works great with REST APIs, sync engines provide powerful benefits:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Easy real-time updates"}]},{"type":"text","value":": No WebSocket plumbing—write to your database and changes stream automatically to all clients"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Automatic side-effects"}]},{"type":"text","value":": When a mutation triggers cascading changes across tables, all affected data syncs automatically without manual cache invalidation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Efficient delta updates"}]},{"type":"text","value":": Only changed rows cross the wire, making it practical to load large datasets client-side"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"This pattern enables the \"load everything once\" approach that makes apps like Linear and Figma feel instant."}]},{"type":"paragraph","children":[{"type":"text","value":"Here, we illustrate this pattern using "},{"type":"link","href":"https://electric-sql.com","children":[{"type":"text","value":"ElectricSQL"}]},{"type":"text","value":" as the sync engine, but this pattern also works with other sync engines like "},{"type":"link","href":"https://www.powersync.com/?utm_source=tanstack&utm_campaign=tanstack_partner","children":[{"type":"text","value":"PowerSync"}]},{"type":"text","value":", "},{"type":"link","href":"https://rxdb.info/","children":[{"type":"text","value":"RxDB"}]},{"type":"text","value":", and "},{"type":"link","href":"https://trailbase.io/","children":[{"type":"text","value":"TrailBase"}]},{"type":"text","value":"."}]},{"type":"code","value":"import type {\n  MutationFn,\n  PendingMutation,\n} from \"@tanstack/react-db\"\nimport { collectionOptions, useDbClient } from \"@tanstack/react-db\"\nimport { electricCollectionOptions } from \"@tanstack/electric-db-collection\"\n\nexport const todoCollection = collectionOptions(\n  electricCollectionOptions({\n    id: \"todos\",\n    schema: todoSchema,\n    // Electric syncs data using \"shapes\". These are filtered views\n    // on database tables that Electric keeps in sync for you.\n    shapeOptions: {\n      url: \"https://api.electric-sql.cloud/v1/shape\",\n      params: {\n        table: \"todos\",\n      },\n    },\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction, collection }) => {\n      const response = await api.todos.create(transaction.mutations[0].modified)\n\n      // Wait for txid to sync\n      await collection.utils.awaitTxId(response.txid)\n    },\n    // You can also implement onUpdate, onDelete as needed.\n  })\n)\n\nconst AddTodo = () => {\n  const todosCollection = useDbClient().collection(todoCollection)\n\n  return (\n    <Button\n      onClick={() => todosCollection.insert({ text: \"🔥 Make app faster\" })}\n    />\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"react-native","children":[{"type":"text","value":"React Native"}]},{"type":"paragraph","children":[{"type":"text","value":"When using TanStack DB with React Native, you need to install and configure a UUID generation library since React Native doesn't include crypto.randomUUID() by default."}]},{"type":"paragraph","children":[{"type":"text","value":"Install the "},{"type":"inlineCode","value":"react-native-random-uuid"},{"type":"text","value":" package:"}]},{"type":"code","value":"npm install react-native-random-uuid","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"Then import it at the entry point of your React Native app (e.g., in your "},{"type":"inlineCode","value":"App.js"},{"type":"text","value":" or "},{"type":"inlineCode","value":"index.js"},{"type":"text","value":"):"}]},{"type":"code","value":"import \"react-native-random-uuid\"","lang":"javascript"},{"type":"paragraph","children":[{"type":"text","value":"This polyfill provides the "},{"type":"inlineCode","value":"crypto.randomUUID()"},{"type":"text","value":" function that TanStack DB uses internally for generating unique identifiers."}]},{"type":"heading","depth":2,"id":"more-info","children":[{"type":"text","value":"More info"}]},{"type":"paragraph","children":[{"type":"text","value":"If you have questions / need help using TanStack DB, let us know on the Discord or start a GitHub discussion:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://discord.gg/yjUNbvbraC","children":[{"type":"inlineCode","value":"#db"},{"type":"text","value":" channel in the TanStack discord"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://github.com/tanstack/db/discussions","children":[{"type":"text","value":"GitHub discussions"}]}]}]}]}],"headings":[{"id":"remove-the-complexity-from-building-fast-modern-apps","text":"Remove the complexity from building fast, modern apps","level":2},{"id":"contents","text":"Contents","level":2},{"id":"how-it-works","text":"How it works","level":2},{"id":"defining-collections","text":"Defining collections","level":3},{"id":"sync-modes","text":"Sync Modes","level":4},{"id":"using-live-queries","text":"Using live queries","level":3},{"id":"making-optimistic-mutations","text":"Making optimistic mutations","level":3},{"id":"uni-directional-data-flow","text":"Uni-directional data flow","level":3},{"id":"api-reference","text":"API reference","level":2},{"id":"collections","text":"Collections","level":3},{"id":"built-in-collection-types","text":"Built-in Collection Types","level":4},{"id":"collection-schemas","text":"Collection Schemas","level":4},{"id":"creating-custom-collection-types","text":"Creating Custom Collection Types","level":4},{"id":"live-queries","text":"Live queries","level":3},{"id":"uselivequery-hook","text":"useLiveQuery hook","level":4},{"id":"uselivesuspensequery-hook","text":"useLiveSuspenseQuery hook","level":4},{"id":"querybuilder","text":"queryBuilder","level":4},{"id":"transactional-mutators","text":"Transactional mutators","level":3},{"id":"usage-examples","text":"Usage examples","level":2},{"id":"1-tanstack-query","text":"1. TanStack Query","level":3},{"id":"2-sync-engine","text":"2. Sync Engine","level":3},{"id":"why-sync-engines","text":"Why Sync Engines?","level":4},{"id":"react-native","text":"React Native","level":2},{"id":"more-info","text":"More info","level":2}]},"frameworks":[],"downloadMarkdown":"\nWelcome to the TanStack DB documentation.\n\nTanStack DB is the reactive client store for your API. It solves the problems of building fast, modern apps, helping you:\n\n- avoid endpoint sprawl and network waterfalls by loading data into normalized collections\n- optimise client performance with sub-millisecond live queries and real-time reactivity\n- take the network off the interaction path with instant optimistic writes\n\nData loading is optimized. Interactions feel instantaneous. Your backend stays simple and your app stays blazing fast. No matter how much data you load.\n\n## Remove the complexity from building fast, modern apps\n\nTanStack DB lets you query your data however your components need it, with a blazing-fast local query engine, real-time reactivity and instant optimistic updates.\n\nInstead of choosing between the least of two evils:\n\n1. **view-specific APIs** - complicating your backend and leading to network waterfalls\n2. **load everything and filter** - leading to slow loads and sluggish client performance\n\nTanStack DB enables a new way:\n\n3. **normalized collections** - keep your backend simple\n4. **query-driven sync** - optimizes your data loading\n5. **sub-millisecond live queries** - keep your app fast and responsive\n\nIt extends TanStack Query with collections, live queries and optimistic mutations, working seamlessly with REST APIs, sync engines, or any data source.\n\n## Contents\n\n- [How it works](#how-it-works) — understand the TanStack DB development model and how the pieces fit together\n- [SSR and hydration](./guides/ssr.md) — use `DbClient` to transport explicit collection rows or live-query result snapshots\n- [SQLite persistence](./guides/sqlite-persistence.md) — retain Collection rows across restarts and save sync metadata for supported adapters\n- [Offline transactions](./guides/offline-transactions.md) — retain pending mutations and retry them later\n- [API reference](#api-reference) — for the primitives and function interfaces\n- [Usage examples](#usage-examples) — examples of common usage patterns\n- [More info](#more-info) — where to find support and more information\n\n## How it works\n\nTanStack DB works by:\n\n- [defining collections](#defining-collections) typed sets of objects that can be populated with data\n- [using live queries](#using-live-queries) to query data from/across collections\n- [making optimistic mutations](#making-optimistic-mutations) using transactional mutators\n\n```tsx\nimport {\n  DbClient,\n  DbProvider,\n  collectionOptions,\n  not,\n  useDbClient,\n  useLiveQuery,\n} from '@tanstack/react-db'\n\n// Define stable collection descriptors to load data into\nconst todoCollection = collectionOptions('todos', () => ({\n  id: 'todos',\n  // ...your config\n  onUpdate: updateMutationFn,\n}))\n\nfunction useTodoCollection() {\n  return useDbClient().collection(todoCollection)\n}\n\nconst Todos = () => {\n  const todosCollection = useTodoCollection()\n\n  // Bind data using live queries\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q.from({ todo: todoCollection }).where(({ todo }) => not(todo.completed)),\n  })\n\n  const complete = (todo) => {\n    // Instantly applies optimistic state\n    todosCollection.update(todo.id, (draft) => {\n      draft.completed = true\n    })\n  }\n\n  return (\n    <ul>\n      {todos.map((todo) => (\n        <li key={todo.id} onClick={() => complete(todo)}>\n          {todo.text}\n        </li>\n      ))}\n    </ul>\n  )\n}\n\nconst dbClient = new DbClient()\n\nconst App = () => (\n  <DbProvider client={dbClient}>\n    <Todos />\n  </DbProvider>\n)\n```\n\n### Defining collections\n\nCollections are typed sets of objects that can be populated with data. They're designed to de-couple loading data into your app from binding data to your components.\n\nCollections can be populated in many ways, including:\n\n- fetching data, for example [from API endpoints using TanStack Query](https://tanstack.com/query/latest)\n- syncing data, for example [using a sync engine like ElectricSQL](https://electric-sql.com/) or [PowerSync](https://powersync.com)\n- storing local data, for example [using localStorage for user preferences and settings](./collections/local-storage-collection.md) or [in-memory client data or UI state](./collections/local-only-collection.md)\n- from live collection queries, creating [derived collections as materialised views](#using-live-queries)\n\nOnce you have your data in collections, you can query across them using live queries in your components.\n\n#### Sync Modes\n\nCollections support three sync modes to optimize data loading:\n\n- **Eager mode** (default): Loads entire collection upfront. Best for <10k rows of mostly static data like user preferences or small reference tables.\n- **On-demand mode**: Loads only what queries request. Best for large datasets (>50k rows), search interfaces, and catalogs where most data won't be accessed.\n- **Progressive mode**: Loads query subset immediately, syncs full dataset in background. Best for collaborative apps needing instant first paint AND sub-millisecond queries.\n\nWith on-demand mode, your component's query becomes the API call:\n\n```tsx\nconst productsCollection = collectionOptions('products', (client) =>\n  queryCollectionOptions({\n    id: 'products',\n    queryKey: ['products'],\n    queryClient: client.requireDependency<QueryClient>('queryClient'),\n    queryFn: async (ctx) => {\n      // Query predicates passed automatically in ctx.meta\n      const params = parseLoadSubsetOptions(ctx.meta?.loadSubsetOptions)\n      return api.getProducts(params) // e.g., GET /api/products?category=electronics&price_lt=100\n    },\n    getKey: (product) => product.id,\n    syncMode: 'on-demand', // ← Enable query-driven sync\n  })\n)\n```\n\nTanStack DB automatically collapses duplicate requests, performs delta loading when expanding queries, optimizes joins into minimal batched requests, and respects your TanStack Query cache policies. You often end up with _fewer_ network requests than custom view-specific APIs.\n\nSee the [Query Collection documentation](./collections/query-collection.md#queryfn-and-predicate-push-down) for full predicate mapping details.\n\n### Using live queries\n\nLive queries are used to query data out of collections. Live queries are reactive: when the underlying data changes in a way that would affect the query result, the result is incrementally updated and returned from the query, triggering a re-render.\n\nTanStack DB live queries are implemented using [d2ts](https://github.com/electric-sql/d2ts), a TypeScript implementation of differential dataflow. This allows the query results to update _incrementally_ (rather than by re-running the whole query). This makes them blazing fast, usually sub-millisecond, even for highly complex queries.\n\n**Performance:** Updating one row in a sorted 100,000-item collection completes in ~0.7ms on an M1 Pro MacBook—fast enough that optimistic updates feel truly instantaneous, even with complex queries and large datasets.\n\nLive queries support joins across collections. This allows you to:\n\n1. load normalised data into collections and then de-normalise it through queries; simplifying your backend by avoiding the need for bespoke API endpoints that match your client\n2. join data from multiple sources; for example, syncing some data out of a database, fetching some other data from an external API and then joining these into a unified data model for your front-end code\n\nEvery query returns another collection which can _also_ be queried.\n\nFor more details on live queries, see the [Live Queries](./guides/live-queries.md) documentation.\n\n### Making optimistic mutations\n\nCollections support `insert`, `update` and `delete` operations. When called, by default they trigger the corresponding `onInsert`, `onUpdate`, `onDelete` handlers which are responsible for writing the mutation to the backend.\n\n```ts\n// Define collection with persistence handlers\nconst todoCollection = collectionOptions('todos', () => ({\n  id: \"todos\",\n  // ... other config\n  onUpdate: async ({ transaction }) => {\n    const { original, changes } = transaction.mutations[0]\n    await api.todos.update(original.id, changes)\n  },\n}))\nconst todosCollection = dbClient.collection(todoCollection)\n\n// Immediately applies optimistic state\ntodosCollection.update(todo.id, (draft) => {\n  draft.completed = true\n})\n```\n\nThe collection maintains optimistic state separately from synced data. When live queries read from the collection, they see a local view that overlays the optimistic mutations on top of the immutable synced data.\n\nThe optimistic state is held until the handler resolves, at which point the data is persisted to the server and synced back. If the handler throws an error, the optimistic state is rolled back.\n\nFor more complex mutations, you can create custom actions with `createOptimisticAction` or custom transactions with `createTransaction`. See the [Mutations guide](./guides/mutations.md) for details.\n\n### Uni-directional data flow\n\nThis combines to support a model of uni-directional data flow, extending the redux/flux style state management pattern beyond the client, to take in the server as well:\n\n<figure>\n  <a href=\"https://raw.githubusercontent.com/TanStack/db/main/docs/unidirectional-data-flow.lg.png\" target=\"_blank\">\n    <img src=\"https://raw.githubusercontent.com/TanStack/db/main/docs/unidirectional-data-flow.png\" />\n  </a>\n</figure>\n\nWith an instant inner loop of optimistic state, superseded in time by the slower outer loop of persisting to the server and syncing the updated server state back into the collection.\n\n## API reference\n\n### Collections\n\nTanStack DB provides several built-in collection types for different data sources and use cases. Each collection type has its own detailed documentation page:\n\n#### Built-in Collection Types\n\n**Fetch Collections**\n\n- **[QueryCollection](./collections/query-collection.md)** — Load data into collections using TanStack Query for REST APIs and data fetching.\n\n**Sync Collections**\n\n- **[ElectricCollection](./collections/electric-collection.md)** — Sync data into collections from Postgres using ElectricSQL's real-time sync engine.\n\n- **[TrailBaseCollection](./collections/trailbase-collection.md)** — Sync data into collections using TrailBase's self-hosted backend with real-time subscriptions.\n\n- **[RxDBCollection](./collections/rxdb-collection.md)** — Integrate with RxDB for offline-first local persistence with powerful replication and sync capabilities.\n\n- **[PowerSyncCollection](./collections/powersync-collection.md)** — Sync with PowerSync's SQLite-based database for offline-first persistence with real-time synchronization with PostgreSQL, MongoDB, and MySQL backends.\n\n**Local Collections**\n\n- **[IndexedDB Collection](./collections/indexed-db-collection.md)** — Persist local browser data in IndexedDB with asynchronous writes and cross-tab notifications.\n\n- **[LocalStorageCollection](./collections/local-storage-collection.md)** — Store small amounts of local-only state that persists across sessions and syncs across browser tabs.\n\n- **[LocalOnlyCollection](./collections/local-only-collection.md)** — Manage in-memory client data or UI state that doesn't need persistence or cross-tab sync.\n\n#### Collection Schemas\n\nAll collections optionally (though strongly recommended) support adding a `schema`.\n\nIf provided, this must be a [Standard Schema](https://standardschema.dev) compatible schema instance, such as [Zod](https://zod.dev), [Valibot](https://valibot.dev), [ArkType](https://arktype.io), or [Effect](https://effect.website/docs/schema/introduction/).\n\n**What schemas do:**\n\n1. **Runtime validation** - Ensures data meets your constraints before entering the collection\n2. **Type transformations** - Convert input types to rich output types (e.g., string → Date)\n3. **Default values** - Automatically populate missing fields\n4. **Type safety** - Infer TypeScript types from your schema\n\n**Example:**\n```typescript\nconst todoSchema = z.object({\n  id: z.string(),\n  text: z.string(),\n  completed: z.boolean().default(false),\n  created_at: z.string().transform(val => new Date(val)),  // string → Date\n  priority: z.number().default(0)\n})\n\nconst todoCollection = collectionOptions(\n  queryCollectionOptions({\n    id: \"todos\",\n    schema: todoSchema,\n    // ...\n  })\n)\nconst collection = dbClient.collection(todoCollection)\n\n// Users provide simple inputs\ncollection.insert({\n  id: \"1\",\n  text: \"Buy groceries\",\n  created_at: \"2024-01-01T00:00:00Z\"  // string\n  // completed and priority filled automatically\n})\n\n// Collection stores and returns rich types\nconst todo = collection.get(\"1\")\nconsole.log(todo.created_at.getFullYear())  // It's a Date!\nconsole.log(todo.completed)  // false (default)\n```\n\nThe collection will use the schema for its type inference. If you provide a schema, you cannot also pass an explicit type parameter (e.g., `createCollection<Todo>()`).\n\n**Learn more:** See the [Schemas guide](./guides/schemas.md) for comprehensive documentation on schema validation, type transformations, and best practices.\n\n#### Creating Custom Collection Types\n\nYou can create your own collection types by implementing the `Collection` interface found in [`../packages/db/src/collection/index.ts`](https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts).\n\nSee the existing implementations in [`../packages/db`](https://github.com/TanStack/db/tree/main/packages/db), [`../packages/query-db-collection`](https://github.com/TanStack/db/tree/main/packages/query-db-collection), [`../packages/electric-db-collection`](https://github.com/TanStack/db/tree/main/packages/electric-db-collection), [`../packages/trailbase-db-collection`](https://github.com/TanStack/db/tree/main/packages/trailbase-db-collection) and [`../packages/powersync-db-collection`](https://github.com/TanStack/db/tree/main/packages/powersync-db-collection) for reference. Also see the [Collection Options Creator guide](./guides/collection-options-creator.md) for a pattern to create reusable collection configuration factories.\n\n### Live queries\n\n#### `useLiveQuery` hook\n\nUse the `useLiveQuery` hook to assign live query results to a state variable in your React components:\n\n```ts\nimport { useLiveQuery } from '@tanstack/react-db'\nimport { eq } from '@tanstack/db'\n\nconst Todos = () => {\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todo: todoCollection })\n        .where(({ todo }) => eq(todo.completed, false))\n        .orderBy(({ todo }) => todo.created_at, 'asc')\n        .select(({ todo }) => ({\n          id: todo.id,\n          text: todo.text\n        })),\n  })\n\n  return <List items={ todos } />\n}\n```\n\nYou can also query across collections with joins:\n\n```ts\nimport { useLiveQuery } from '@tanstack/react-db'\nimport { eq } from '@tanstack/db'\n\nconst Todos = () => {\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todos: todoCollection })\n        .join(\n          { lists: listCollection },\n          ({ todos, lists }) => eq(lists.id, todos.listId),\n          'inner'\n        )\n        .where(({ lists }) => eq(lists.active, true))\n        .select(({ todos, lists }) => ({\n          id: todos.id,\n          title: todos.title,\n          listName: lists.name\n        })),\n  })\n\n  return <List items={ todos } />\n}\n```\n\n#### `useLiveSuspenseQuery` hook\n\nFor React Suspense support, use `useLiveSuspenseQuery`. This hook suspends rendering during initial data load and guarantees that `data` is always defined:\n\n```tsx\nimport { useLiveSuspenseQuery } from '@tanstack/react-db'\nimport { Suspense } from 'react'\n\nconst Todos = () => {\n  // data is always defined - no need for optional chaining\n  const { data: todos } = useLiveSuspenseQuery({\n    query: (q) =>\n      q\n        .from({ todo: todoCollection })\n        .where(({ todo }) => eq(todo.completed, false)),\n  })\n\n  return <List items={ todos } />\n}\n\nconst App = () => (\n  <Suspense fallback={<div>Loading...</div>}>\n    <Todos />\n  </Suspense>\n)\n```\n\nSee the [React Suspense section in Live Queries](./guides/live-queries#using-with-react-suspense) for detailed usage patterns and when to use `useLiveSuspenseQuery` vs `useLiveQuery`.\n\n#### `queryBuilder`\n\nYou can also build queries directly (outside of the component lifecycle) using the underlying `queryBuilder` API:\n\n```ts\nimport { createLiveQueryCollection, eq } from \"@tanstack/db\"\n\nconst completedTodos = createLiveQueryCollection({\n  startSync: true,\n  query: (q) =>\n    q\n      .from({ todo: todoCollection })\n      .where(({ todo }) => eq(todo.completed, true)),\n})\n\nconst results = completedTodos.toArray\n```\n\nNote also that:\n\n1. the query results [are themselves a collection](#derived-collections)\n2. the `useLiveQuery` automatically starts and stops live query subscriptions when you mount and unmount your components; if you're creating queries manually, you need to manually manage the subscription lifecycle yourself\n\nSee the [Live Queries](./guides/live-queries.md) documentation for more details.\n\n### Transactional mutators\n\nFor more complex mutations beyond simple CRUD operations, TanStack DB provides `createOptimisticAction` and `createTransaction` for creating custom mutations with full control over the mutation lifecycle.\n\nSee the [Mutations guide](./guides/mutations.md) for comprehensive documentation on:\n\n- Creating custom actions with `createOptimisticAction`\n- Manual transactions with `createTransaction`\n- Mutation merging behavior\n- Controlling optimistic vs non-optimistic updates\n- Handling temporary IDs\n- Transaction lifecycle states\n\n## Usage examples\n\nHere we illustrate two common ways of using TanStack DB:\n\n1. [using TanStack Query](#1-tanstack-query) with an existing REST API\n2. [using a sync engine](#2-sync-engine) for real-time sync with your backend\n\n> [!TIP]\n> You can combine these patterns. One of the benefits of TanStack DB is that you can integrate different ways of loading data and handling mutations into the same app. Your components don't need to know where the data came from or goes.\n\n### 1. TanStack Query\n\nYou can use TanStack DB with your existing REST API via TanStack Query.\n\nThe steps are to:\n\n1. create [QueryCollection](./collections/query-collection.md)s that load data using TanStack Query\n2. implement mutation handlers that handle mutations by posting them to your API endpoints\n\n```tsx\nimport {\n  DbClient,\n  DbProvider,\n  collectionOptions,\n  useLiveQuery,\n} from \"@tanstack/react-db\"\nimport { queryCollectionOptions } from \"@tanstack/query-db-collection\"\nimport { QueryClient } from \"@tanstack/query-core\"\n\nconst queryClient = new QueryClient()\nconst dbClient = new DbClient({ queryClient })\n\n// Load data into collections using TanStack Query.\n// It's common to define these in a `collections` module.\nconst todoCollection = collectionOptions(\"todos\", (client) =>\n  queryCollectionOptions({\n    id: \"todos\",\n    queryKey: [\"todos\"],\n    queryClient: client.requireDependency<QueryClient>(\"queryClient\"),\n    queryFn: async () => fetch(\"/api/todos\").then((response) => response.json()),\n    getKey: (item) => item.id,\n    schema: todoSchema, // any standard schema\n    onInsert: async ({ transaction, collection }) => {\n      const { changes: newTodo } = transaction.mutations[0]\n\n      // Handle the local write by sending it to your API.\n      await api.todos.create(newTodo)\n      await collection.utils.refetch()\n      // Prevent the pre-1.0 compatibility wrapper from refetching again.\n      return { refetch: false }\n    },\n    // also add onUpdate, onDelete as needed.\n  })\n)\nconst listCollection = collectionOptions(\"todo-lists\", (client) =>\n  queryCollectionOptions({\n    id: \"todo-lists\",\n    queryKey: [\"todo-lists\"],\n    queryClient: client.requireDependency<QueryClient>(\"queryClient\"),\n    queryFn: async () =>\n      fetch(\"/api/todo-lists\").then((response) => response.json()),\n    getKey: (item) => item.id,\n    schema: todoListSchema,\n    onInsert: async ({ transaction, collection }) => {\n      const { changes: newTodo } = transaction.mutations[0]\n\n      // Handle the local write by sending it to your API.\n      await api.todoLists.create(newTodo)\n      await collection.utils.refetch()\n      // Prevent the pre-1.0 compatibility wrapper from refetching again.\n      return { refetch: false }\n    },\n    // also add onUpdate, onDelete as needed.\n  })\n)\n\nconst Todos = () => {\n  // Read the data using live queries. Here we show a live\n  // query that joins across two collections.\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todo: todoCollection })\n        .join(\n          { list: listCollection },\n          ({ todo, list }) => eq(list.id, todo.list_id),\n          \"inner\"\n        )\n        .where(({ list }) => eq(list.active, true))\n        .select(({ todo, list }) => ({\n          id: todo.id,\n          text: todo.text,\n          status: todo.status,\n          listName: list.name,\n        })),\n  })\n\n  // ...\n}\n\nconst App = () => (\n  <DbProvider client={dbClient}>\n    <Todos />\n  </DbProvider>\n)\n```\n\nThis pattern allows you to extend an existing TanStack Query application, or any application built on a REST API, with blazing fast, cross-collection live queries and local optimistic mutations with automatically managed optimistic state.\n\n### 2. Sync Engine\n\nOne of the most powerful ways of using TanStack DB is with a sync engine, for a fully local-first experience with real-time sync. This allows you to incrementally adopt sync into an existing app, whilst still handling writes with your existing API.\n\n#### Why Sync Engines?\n\nWhile TanStack DB works great with REST APIs, sync engines provide powerful benefits:\n\n- **Easy real-time updates**: No WebSocket plumbing—write to your database and changes stream automatically to all clients\n- **Automatic side-effects**: When a mutation triggers cascading changes across tables, all affected data syncs automatically without manual cache invalidation\n- **Efficient delta updates**: Only changed rows cross the wire, making it practical to load large datasets client-side\n\nThis pattern enables the \"load everything once\" approach that makes apps like Linear and Figma feel instant.\n\nHere, we illustrate this pattern using [ElectricSQL](https://electric-sql.com) as the sync engine, but this pattern also works with other sync engines like [PowerSync](https://www.powersync.com/?utm_source=tanstack&utm_campaign=tanstack_partner), [RxDB](https://rxdb.info/), and [TrailBase](https://trailbase.io/).\n\n```tsx\nimport type {\n  MutationFn,\n  PendingMutation,\n} from \"@tanstack/react-db\"\nimport { collectionOptions, useDbClient } from \"@tanstack/react-db\"\nimport { electricCollectionOptions } from \"@tanstack/electric-db-collection\"\n\nexport const todoCollection = collectionOptions(\n  electricCollectionOptions({\n    id: \"todos\",\n    schema: todoSchema,\n    // Electric syncs data using \"shapes\". These are filtered views\n    // on database tables that Electric keeps in sync for you.\n    shapeOptions: {\n      url: \"https://api.electric-sql.cloud/v1/shape\",\n      params: {\n        table: \"todos\",\n      },\n    },\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction, collection }) => {\n      const response = await api.todos.create(transaction.mutations[0].modified)\n\n      // Wait for txid to sync\n      await collection.utils.awaitTxId(response.txid)\n    },\n    // You can also implement onUpdate, onDelete as needed.\n  })\n)\n\nconst AddTodo = () => {\n  const todosCollection = useDbClient().collection(todoCollection)\n\n  return (\n    <Button\n      onClick={() => todosCollection.insert({ text: \"🔥 Make app faster\" })}\n    />\n  )\n}\n```\n\n## React Native\n\nWhen using TanStack DB with React Native, you need to install and configure a UUID generation library since React Native doesn't include crypto.randomUUID() by default.\n\nInstall the `react-native-random-uuid` package:\n\n```bash\nnpm install react-native-random-uuid\n```\n\nThen import it at the entry point of your React Native app (e.g., in your `App.js` or `index.js`):\n\n```javascript\nimport \"react-native-random-uuid\"\n```\n\nThis polyfill provides the `crypto.randomUUID()` function that TanStack DB uses internally for generating unique identifiers.\n\n## More info\n\nIf you have questions / need help using TanStack DB, let us know on the Discord or start a GitHub discussion:\n\n- [`#db` channel in the TanStack discord](https://discord.gg/yjUNbvbraC)\n- [GitHub discussions](https://github.com/tanstack/db/discussions)\n","originalRawMarkdown":"---\ntitle: Overview\nid: overview\n---\n\nWelcome to the TanStack DB documentation.\n\nTanStack DB is the reactive client store for your API. It solves the problems of building fast, modern apps, helping you:\n\n- avoid endpoint sprawl and network waterfalls by loading data into normalized collections\n- optimise client performance with sub-millisecond live queries and real-time reactivity\n- take the network off the interaction path with instant optimistic writes\n\nData loading is optimized. Interactions feel instantaneous. Your backend stays simple and your app stays blazing fast. No matter how much data you load.\n\n## Remove the complexity from building fast, modern apps\n\nTanStack DB lets you query your data however your components need it, with a blazing-fast local query engine, real-time reactivity and instant optimistic updates.\n\nInstead of choosing between the least of two evils:\n\n1. **view-specific APIs** - complicating your backend and leading to network waterfalls\n2. **load everything and filter** - leading to slow loads and sluggish client performance\n\nTanStack DB enables a new way:\n\n3. **normalized collections** - keep your backend simple\n4. **query-driven sync** - optimizes your data loading\n5. **sub-millisecond live queries** - keep your app fast and responsive\n\nIt extends TanStack Query with collections, live queries and optimistic mutations, working seamlessly with REST APIs, sync engines, or any data source.\n\n## Contents\n\n- [How it works](#how-it-works) — understand the TanStack DB development model and how the pieces fit together\n- [SSR and hydration](./guides/ssr.md) — use `DbClient` to transport explicit collection rows or live-query result snapshots\n- [SQLite persistence](./guides/sqlite-persistence.md) — retain Collection rows across restarts and save sync metadata for supported adapters\n- [Offline transactions](./guides/offline-transactions.md) — retain pending mutations and retry them later\n- [API reference](#api-reference) — for the primitives and function interfaces\n- [Usage examples](#usage-examples) — examples of common usage patterns\n- [More info](#more-info) — where to find support and more information\n\n## How it works\n\nTanStack DB works by:\n\n- [defining collections](#defining-collections) typed sets of objects that can be populated with data\n- [using live queries](#using-live-queries) to query data from/across collections\n- [making optimistic mutations](#making-optimistic-mutations) using transactional mutators\n\n```tsx\nimport {\n  DbClient,\n  DbProvider,\n  collectionOptions,\n  not,\n  useDbClient,\n  useLiveQuery,\n} from '@tanstack/react-db'\n\n// Define stable collection descriptors to load data into\nconst todoCollection = collectionOptions('todos', () => ({\n  id: 'todos',\n  // ...your config\n  onUpdate: updateMutationFn,\n}))\n\nfunction useTodoCollection() {\n  return useDbClient().collection(todoCollection)\n}\n\nconst Todos = () => {\n  const todosCollection = useTodoCollection()\n\n  // Bind data using live queries\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q.from({ todo: todoCollection }).where(({ todo }) => not(todo.completed)),\n  })\n\n  const complete = (todo) => {\n    // Instantly applies optimistic state\n    todosCollection.update(todo.id, (draft) => {\n      draft.completed = true\n    })\n  }\n\n  return (\n    <ul>\n      {todos.map((todo) => (\n        <li key={todo.id} onClick={() => complete(todo)}>\n          {todo.text}\n        </li>\n      ))}\n    </ul>\n  )\n}\n\nconst dbClient = new DbClient()\n\nconst App = () => (\n  <DbProvider client={dbClient}>\n    <Todos />\n  </DbProvider>\n)\n```\n\n### Defining collections\n\nCollections are typed sets of objects that can be populated with data. They're designed to de-couple loading data into your app from binding data to your components.\n\nCollections can be populated in many ways, including:\n\n- fetching data, for example [from API endpoints using TanStack Query](https://tanstack.com/query/latest)\n- syncing data, for example [using a sync engine like ElectricSQL](https://electric-sql.com/) or [PowerSync](https://powersync.com)\n- storing local data, for example [using localStorage for user preferences and settings](./collections/local-storage-collection.md) or [in-memory client data or UI state](./collections/local-only-collection.md)\n- from live collection queries, creating [derived collections as materialised views](#using-live-queries)\n\nOnce you have your data in collections, you can query across them using live queries in your components.\n\n#### Sync Modes\n\nCollections support three sync modes to optimize data loading:\n\n- **Eager mode** (default): Loads entire collection upfront. Best for <10k rows of mostly static data like user preferences or small reference tables.\n- **On-demand mode**: Loads only what queries request. Best for large datasets (>50k rows), search interfaces, and catalogs where most data won't be accessed.\n- **Progressive mode**: Loads query subset immediately, syncs full dataset in background. Best for collaborative apps needing instant first paint AND sub-millisecond queries.\n\nWith on-demand mode, your component's query becomes the API call:\n\n```tsx\nconst productsCollection = collectionOptions('products', (client) =>\n  queryCollectionOptions({\n    id: 'products',\n    queryKey: ['products'],\n    queryClient: client.requireDependency<QueryClient>('queryClient'),\n    queryFn: async (ctx) => {\n      // Query predicates passed automatically in ctx.meta\n      const params = parseLoadSubsetOptions(ctx.meta?.loadSubsetOptions)\n      return api.getProducts(params) // e.g., GET /api/products?category=electronics&price_lt=100\n    },\n    getKey: (product) => product.id,\n    syncMode: 'on-demand', // ← Enable query-driven sync\n  })\n)\n```\n\nTanStack DB automatically collapses duplicate requests, performs delta loading when expanding queries, optimizes joins into minimal batched requests, and respects your TanStack Query cache policies. You often end up with _fewer_ network requests than custom view-specific APIs.\n\nSee the [Query Collection documentation](./collections/query-collection.md#queryfn-and-predicate-push-down) for full predicate mapping details.\n\n### Using live queries\n\nLive queries are used to query data out of collections. Live queries are reactive: when the underlying data changes in a way that would affect the query result, the result is incrementally updated and returned from the query, triggering a re-render.\n\nTanStack DB live queries are implemented using [d2ts](https://github.com/electric-sql/d2ts), a TypeScript implementation of differential dataflow. This allows the query results to update _incrementally_ (rather than by re-running the whole query). This makes them blazing fast, usually sub-millisecond, even for highly complex queries.\n\n**Performance:** Updating one row in a sorted 100,000-item collection completes in ~0.7ms on an M1 Pro MacBook—fast enough that optimistic updates feel truly instantaneous, even with complex queries and large datasets.\n\nLive queries support joins across collections. This allows you to:\n\n1. load normalised data into collections and then de-normalise it through queries; simplifying your backend by avoiding the need for bespoke API endpoints that match your client\n2. join data from multiple sources; for example, syncing some data out of a database, fetching some other data from an external API and then joining these into a unified data model for your front-end code\n\nEvery query returns another collection which can _also_ be queried.\n\nFor more details on live queries, see the [Live Queries](./guides/live-queries.md) documentation.\n\n### Making optimistic mutations\n\nCollections support `insert`, `update` and `delete` operations. When called, by default they trigger the corresponding `onInsert`, `onUpdate`, `onDelete` handlers which are responsible for writing the mutation to the backend.\n\n```ts\n// Define collection with persistence handlers\nconst todoCollection = collectionOptions('todos', () => ({\n  id: \"todos\",\n  // ... other config\n  onUpdate: async ({ transaction }) => {\n    const { original, changes } = transaction.mutations[0]\n    await api.todos.update(original.id, changes)\n  },\n}))\nconst todosCollection = dbClient.collection(todoCollection)\n\n// Immediately applies optimistic state\ntodosCollection.update(todo.id, (draft) => {\n  draft.completed = true\n})\n```\n\nThe collection maintains optimistic state separately from synced data. When live queries read from the collection, they see a local view that overlays the optimistic mutations on top of the immutable synced data.\n\nThe optimistic state is held until the handler resolves, at which point the data is persisted to the server and synced back. If the handler throws an error, the optimistic state is rolled back.\n\nFor more complex mutations, you can create custom actions with `createOptimisticAction` or custom transactions with `createTransaction`. See the [Mutations guide](./guides/mutations.md) for details.\n\n### Uni-directional data flow\n\nThis combines to support a model of uni-directional data flow, extending the redux/flux style state management pattern beyond the client, to take in the server as well:\n\n<figure>\n  <a href=\"https://raw.githubusercontent.com/TanStack/db/main/docs/unidirectional-data-flow.lg.png\" target=\"_blank\">\n    <img src=\"https://raw.githubusercontent.com/TanStack/db/main/docs/unidirectional-data-flow.png\" />\n  </a>\n</figure>\n\nWith an instant inner loop of optimistic state, superseded in time by the slower outer loop of persisting to the server and syncing the updated server state back into the collection.\n\n## API reference\n\n### Collections\n\nTanStack DB provides several built-in collection types for different data sources and use cases. Each collection type has its own detailed documentation page:\n\n#### Built-in Collection Types\n\n**Fetch Collections**\n\n- **[QueryCollection](./collections/query-collection.md)** — Load data into collections using TanStack Query for REST APIs and data fetching.\n\n**Sync Collections**\n\n- **[ElectricCollection](./collections/electric-collection.md)** — Sync data into collections from Postgres using ElectricSQL's real-time sync engine.\n\n- **[TrailBaseCollection](./collections/trailbase-collection.md)** — Sync data into collections using TrailBase's self-hosted backend with real-time subscriptions.\n\n- **[RxDBCollection](./collections/rxdb-collection.md)** — Integrate with RxDB for offline-first local persistence with powerful replication and sync capabilities.\n\n- **[PowerSyncCollection](./collections/powersync-collection.md)** — Sync with PowerSync's SQLite-based database for offline-first persistence with real-time synchronization with PostgreSQL, MongoDB, and MySQL backends.\n\n**Local Collections**\n\n- **[IndexedDB Collection](./collections/indexed-db-collection.md)** — Persist local browser data in IndexedDB with asynchronous writes and cross-tab notifications.\n\n- **[LocalStorageCollection](./collections/local-storage-collection.md)** — Store small amounts of local-only state that persists across sessions and syncs across browser tabs.\n\n- **[LocalOnlyCollection](./collections/local-only-collection.md)** — Manage in-memory client data or UI state that doesn't need persistence or cross-tab sync.\n\n#### Collection Schemas\n\nAll collections optionally (though strongly recommended) support adding a `schema`.\n\nIf provided, this must be a [Standard Schema](https://standardschema.dev) compatible schema instance, such as [Zod](https://zod.dev), [Valibot](https://valibot.dev), [ArkType](https://arktype.io), or [Effect](https://effect.website/docs/schema/introduction/).\n\n**What schemas do:**\n\n1. **Runtime validation** - Ensures data meets your constraints before entering the collection\n2. **Type transformations** - Convert input types to rich output types (e.g., string → Date)\n3. **Default values** - Automatically populate missing fields\n4. **Type safety** - Infer TypeScript types from your schema\n\n**Example:**\n```typescript\nconst todoSchema = z.object({\n  id: z.string(),\n  text: z.string(),\n  completed: z.boolean().default(false),\n  created_at: z.string().transform(val => new Date(val)),  // string → Date\n  priority: z.number().default(0)\n})\n\nconst todoCollection = collectionOptions(\n  queryCollectionOptions({\n    id: \"todos\",\n    schema: todoSchema,\n    // ...\n  })\n)\nconst collection = dbClient.collection(todoCollection)\n\n// Users provide simple inputs\ncollection.insert({\n  id: \"1\",\n  text: \"Buy groceries\",\n  created_at: \"2024-01-01T00:00:00Z\"  // string\n  // completed and priority filled automatically\n})\n\n// Collection stores and returns rich types\nconst todo = collection.get(\"1\")\nconsole.log(todo.created_at.getFullYear())  // It's a Date!\nconsole.log(todo.completed)  // false (default)\n```\n\nThe collection will use the schema for its type inference. If you provide a schema, you cannot also pass an explicit type parameter (e.g., `createCollection<Todo>()`).\n\n**Learn more:** See the [Schemas guide](./guides/schemas.md) for comprehensive documentation on schema validation, type transformations, and best practices.\n\n#### Creating Custom Collection Types\n\nYou can create your own collection types by implementing the `Collection` interface found in [`../packages/db/src/collection/index.ts`](https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts).\n\nSee the existing implementations in [`../packages/db`](https://github.com/TanStack/db/tree/main/packages/db), [`../packages/query-db-collection`](https://github.com/TanStack/db/tree/main/packages/query-db-collection), [`../packages/electric-db-collection`](https://github.com/TanStack/db/tree/main/packages/electric-db-collection), [`../packages/trailbase-db-collection`](https://github.com/TanStack/db/tree/main/packages/trailbase-db-collection) and [`../packages/powersync-db-collection`](https://github.com/TanStack/db/tree/main/packages/powersync-db-collection) for reference. Also see the [Collection Options Creator guide](./guides/collection-options-creator.md) for a pattern to create reusable collection configuration factories.\n\n### Live queries\n\n#### `useLiveQuery` hook\n\nUse the `useLiveQuery` hook to assign live query results to a state variable in your React components:\n\n```ts\nimport { useLiveQuery } from '@tanstack/react-db'\nimport { eq } from '@tanstack/db'\n\nconst Todos = () => {\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todo: todoCollection })\n        .where(({ todo }) => eq(todo.completed, false))\n        .orderBy(({ todo }) => todo.created_at, 'asc')\n        .select(({ todo }) => ({\n          id: todo.id,\n          text: todo.text\n        })),\n  })\n\n  return <List items={ todos } />\n}\n```\n\nYou can also query across collections with joins:\n\n```ts\nimport { useLiveQuery } from '@tanstack/react-db'\nimport { eq } from '@tanstack/db'\n\nconst Todos = () => {\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todos: todoCollection })\n        .join(\n          { lists: listCollection },\n          ({ todos, lists }) => eq(lists.id, todos.listId),\n          'inner'\n        )\n        .where(({ lists }) => eq(lists.active, true))\n        .select(({ todos, lists }) => ({\n          id: todos.id,\n          title: todos.title,\n          listName: lists.name\n        })),\n  })\n\n  return <List items={ todos } />\n}\n```\n\n#### `useLiveSuspenseQuery` hook\n\nFor React Suspense support, use `useLiveSuspenseQuery`. This hook suspends rendering during initial data load and guarantees that `data` is always defined:\n\n```tsx\nimport { useLiveSuspenseQuery } from '@tanstack/react-db'\nimport { Suspense } from 'react'\n\nconst Todos = () => {\n  // data is always defined - no need for optional chaining\n  const { data: todos } = useLiveSuspenseQuery({\n    query: (q) =>\n      q\n        .from({ todo: todoCollection })\n        .where(({ todo }) => eq(todo.completed, false)),\n  })\n\n  return <List items={ todos } />\n}\n\nconst App = () => (\n  <Suspense fallback={<div>Loading...</div>}>\n    <Todos />\n  </Suspense>\n)\n```\n\nSee the [React Suspense section in Live Queries](./guides/live-queries#using-with-react-suspense) for detailed usage patterns and when to use `useLiveSuspenseQuery` vs `useLiveQuery`.\n\n#### `queryBuilder`\n\nYou can also build queries directly (outside of the component lifecycle) using the underlying `queryBuilder` API:\n\n```ts\nimport { createLiveQueryCollection, eq } from \"@tanstack/db\"\n\nconst completedTodos = createLiveQueryCollection({\n  startSync: true,\n  query: (q) =>\n    q\n      .from({ todo: todoCollection })\n      .where(({ todo }) => eq(todo.completed, true)),\n})\n\nconst results = completedTodos.toArray\n```\n\nNote also that:\n\n1. the query results [are themselves a collection](#derived-collections)\n2. the `useLiveQuery` automatically starts and stops live query subscriptions when you mount and unmount your components; if you're creating queries manually, you need to manually manage the subscription lifecycle yourself\n\nSee the [Live Queries](./guides/live-queries.md) documentation for more details.\n\n### Transactional mutators\n\nFor more complex mutations beyond simple CRUD operations, TanStack DB provides `createOptimisticAction` and `createTransaction` for creating custom mutations with full control over the mutation lifecycle.\n\nSee the [Mutations guide](./guides/mutations.md) for comprehensive documentation on:\n\n- Creating custom actions with `createOptimisticAction`\n- Manual transactions with `createTransaction`\n- Mutation merging behavior\n- Controlling optimistic vs non-optimistic updates\n- Handling temporary IDs\n- Transaction lifecycle states\n\n## Usage examples\n\nHere we illustrate two common ways of using TanStack DB:\n\n1. [using TanStack Query](#1-tanstack-query) with an existing REST API\n2. [using a sync engine](#2-sync-engine) for real-time sync with your backend\n\n> [!TIP]\n> You can combine these patterns. One of the benefits of TanStack DB is that you can integrate different ways of loading data and handling mutations into the same app. Your components don't need to know where the data came from or goes.\n\n### 1. TanStack Query\n\nYou can use TanStack DB with your existing REST API via TanStack Query.\n\nThe steps are to:\n\n1. create [QueryCollection](./collections/query-collection.md)s that load data using TanStack Query\n2. implement mutation handlers that handle mutations by posting them to your API endpoints\n\n```tsx\nimport {\n  DbClient,\n  DbProvider,\n  collectionOptions,\n  useLiveQuery,\n} from \"@tanstack/react-db\"\nimport { queryCollectionOptions } from \"@tanstack/query-db-collection\"\nimport { QueryClient } from \"@tanstack/query-core\"\n\nconst queryClient = new QueryClient()\nconst dbClient = new DbClient({ queryClient })\n\n// Load data into collections using TanStack Query.\n// It's common to define these in a `collections` module.\nconst todoCollection = collectionOptions(\"todos\", (client) =>\n  queryCollectionOptions({\n    id: \"todos\",\n    queryKey: [\"todos\"],\n    queryClient: client.requireDependency<QueryClient>(\"queryClient\"),\n    queryFn: async () => fetch(\"/api/todos\").then((response) => response.json()),\n    getKey: (item) => item.id,\n    schema: todoSchema, // any standard schema\n    onInsert: async ({ transaction, collection }) => {\n      const { changes: newTodo } = transaction.mutations[0]\n\n      // Handle the local write by sending it to your API.\n      await api.todos.create(newTodo)\n      await collection.utils.refetch()\n      // Prevent the pre-1.0 compatibility wrapper from refetching again.\n      return { refetch: false }\n    },\n    // also add onUpdate, onDelete as needed.\n  })\n)\nconst listCollection = collectionOptions(\"todo-lists\", (client) =>\n  queryCollectionOptions({\n    id: \"todo-lists\",\n    queryKey: [\"todo-lists\"],\n    queryClient: client.requireDependency<QueryClient>(\"queryClient\"),\n    queryFn: async () =>\n      fetch(\"/api/todo-lists\").then((response) => response.json()),\n    getKey: (item) => item.id,\n    schema: todoListSchema,\n    onInsert: async ({ transaction, collection }) => {\n      const { changes: newTodo } = transaction.mutations[0]\n\n      // Handle the local write by sending it to your API.\n      await api.todoLists.create(newTodo)\n      await collection.utils.refetch()\n      // Prevent the pre-1.0 compatibility wrapper from refetching again.\n      return { refetch: false }\n    },\n    // also add onUpdate, onDelete as needed.\n  })\n)\n\nconst Todos = () => {\n  // Read the data using live queries. Here we show a live\n  // query that joins across two collections.\n  const { data: todos } = useLiveQuery({\n    query: (q) =>\n      q\n        .from({ todo: todoCollection })\n        .join(\n          { list: listCollection },\n          ({ todo, list }) => eq(list.id, todo.list_id),\n          \"inner\"\n        )\n        .where(({ list }) => eq(list.active, true))\n        .select(({ todo, list }) => ({\n          id: todo.id,\n          text: todo.text,\n          status: todo.status,\n          listName: list.name,\n        })),\n  })\n\n  // ...\n}\n\nconst App = () => (\n  <DbProvider client={dbClient}>\n    <Todos />\n  </DbProvider>\n)\n```\n\nThis pattern allows you to extend an existing TanStack Query application, or any application built on a REST API, with blazing fast, cross-collection live queries and local optimistic mutations with automatically managed optimistic state.\n\n### 2. Sync Engine\n\nOne of the most powerful ways of using TanStack DB is with a sync engine, for a fully local-first experience with real-time sync. This allows you to incrementally adopt sync into an existing app, whilst still handling writes with your existing API.\n\n#### Why Sync Engines?\n\nWhile TanStack DB works great with REST APIs, sync engines provide powerful benefits:\n\n- **Easy real-time updates**: No WebSocket plumbing—write to your database and changes stream automatically to all clients\n- **Automatic side-effects**: When a mutation triggers cascading changes across tables, all affected data syncs automatically without manual cache invalidation\n- **Efficient delta updates**: Only changed rows cross the wire, making it practical to load large datasets client-side\n\nThis pattern enables the \"load everything once\" approach that makes apps like Linear and Figma feel instant.\n\nHere, we illustrate this pattern using [ElectricSQL](https://electric-sql.com) as the sync engine, but this pattern also works with other sync engines like [PowerSync](https://www.powersync.com/?utm_source=tanstack&utm_campaign=tanstack_partner), [RxDB](https://rxdb.info/), and [TrailBase](https://trailbase.io/).\n\n```tsx\nimport type {\n  MutationFn,\n  PendingMutation,\n} from \"@tanstack/react-db\"\nimport { collectionOptions, useDbClient } from \"@tanstack/react-db\"\nimport { electricCollectionOptions } from \"@tanstack/electric-db-collection\"\n\nexport const todoCollection = collectionOptions(\n  electricCollectionOptions({\n    id: \"todos\",\n    schema: todoSchema,\n    // Electric syncs data using \"shapes\". These are filtered views\n    // on database tables that Electric keeps in sync for you.\n    shapeOptions: {\n      url: \"https://api.electric-sql.cloud/v1/shape\",\n      params: {\n        table: \"todos\",\n      },\n    },\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction, collection }) => {\n      const response = await api.todos.create(transaction.mutations[0].modified)\n\n      // Wait for txid to sync\n      await collection.utils.awaitTxId(response.txid)\n    },\n    // You can also implement onUpdate, onDelete as needed.\n  })\n)\n\nconst AddTodo = () => {\n  const todosCollection = useDbClient().collection(todoCollection)\n\n  return (\n    <Button\n      onClick={() => todosCollection.insert({ text: \"🔥 Make app faster\" })}\n    />\n  )\n}\n```\n\n## React Native\n\nWhen using TanStack DB with React Native, you need to install and configure a UUID generation library since React Native doesn't include crypto.randomUUID() by default.\n\nInstall the `react-native-random-uuid` package:\n\n```bash\nnpm install react-native-random-uuid\n```\n\nThen import it at the entry point of your React Native app (e.g., in your `App.js` or `index.js`):\n\n```javascript\nimport \"react-native-random-uuid\"\n```\n\nThis polyfill provides the `crypto.randomUUID()` function that TanStack DB uses internally for generating unique identifiers.\n\n## More info\n\nIf you have questions / need help using TanStack DB, let us know on the Discord or start a GitHub discussion:\n\n- [`#db` channel in the TanStack discord](https://discord.gg/yjUNbvbraC)\n- [GitHub discussions](https://github.com/tanstack/db/discussions)\n"}
