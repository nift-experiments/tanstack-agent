},{"type":"heading","depth":3,"id":"groupby","children":[{"type":"text","value":"groupBy()"}]},{"type":"code","value":"groupBy(callback): QueryBuilder<TContext>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/index.ts#L776","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:776"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Group rows by one or more columns for aggregation"}]},{"type":"heading","depth":4,"id":"parameters-7","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"callback-4","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/GroupByCallback.md","children":[{"type":"inlineCode","value":"GroupByCallback"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that receives table references and returns the field(s) to group by"}]},{"type":"heading","depth":4,"id":"returns-11","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryBuilder.md","children":[{"type":"inlineCode","value":"QueryBuilder"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A QueryBuilder with grouping applied (enables aggregate functions in SELECT and HAVING)"}]},{"type":"heading","depth":4,"id":"example-9","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Group by a single column\nquery\n  .from({ posts: postsCollection })\n  .groupBy(({posts}) => posts.userId)\n  .select(({posts, count}) => ({\n    userId: posts.userId,\n    postCount: count()\n  }))\n\n// Group by multiple columns\nquery\n  .from({ sales: salesCollection })\n  .groupBy(({sales}) => [sales.region, sales.category])\n  .select(({sales, sum}) => ({\n    region: sales.region,\n    category: sales.category,\n    totalSales: sum(sales.amount)\n  }))","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"having-2","children":[{"type":"text","value":"having()"}]},{"type":"code","value":"having(callback): QueryBuilder<TContext>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/index.ts#L566","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:566"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Filter grouped rows based on aggregate conditions"}]},{"type":"heading","depth":4,"id":"parameters-8","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"callback-5","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/WhereCallback.md","children":[{"type":"inlineCode","value":"WhereCallback"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that receives table references and returns an expression"}]},{"type":"heading","depth":4,"id":"returns-12","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryBuilder.md","children":[{"type":"inlineCode","value":"QueryBuilder"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A QueryBuilder with the having condition applied"}]},{"type":"heading","depth":4,"id":"example-10","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Filter groups by count\nquery\n  .from({ posts: postsCollection })\n  .groupBy(({posts}) => posts.userId)\n  .having(({posts}) => gt(count(posts.id), 5))\n\n// Filter by average\nquery\n  .from({ orders: ordersCollection })\n  .groupBy(({orders}) => orders.customerId)\n  .having(({orders}) => gt(avg(orders.total), 100))\n\n// Multiple having calls are ANDed together\nquery\n  .from({ orders: ordersCollection })\n  .groupBy(({orders}) => orders.customerId)\n  .having(({orders}) => gt(count(orders.id), 5))\n  .having(({orders}) => gt(avg(orders.total), 100))","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"innerjoin","children":[{"type":"text","value":"innerJoin()"}]},{"type":"code","value":"innerJoin<TSource>(source, onCallback): QueryBuilder<MergeContextWithJoinType<TContext, SchemaFromSource<TSource>, \"inner\">>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/index.ts#L446","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:446"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Perform an INNER JOIN with another table or subquery"}]},{"type":"heading","depth":4,"id":"type-parameters-5","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tsource-3","children":[{"type":"text","value":"TSource"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSource"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/Source.md","children":[{"type":"inlineCode","value":"Source"}]}]},{"type":"heading","depth":4,"id":"parameters-9","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"source-3","children":[{"type":"text","value":"source"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSource"}]},{"type":"paragraph","children":[{"type":"text","value":