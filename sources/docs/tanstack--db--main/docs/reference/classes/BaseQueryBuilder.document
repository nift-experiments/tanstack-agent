lue":"q.fn.select((row) => ({\n  name: row.user.name.toUpperCase(),\n  age: row.user.age + 1,\n}))","lang":"ts"},{"type":"heading","depth":5,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"heading","depth":6,"id":"having","children":[{"type":"text","value":"having()"}]},{"type":"code","value":"having(callback): QueryBuilder<TContext>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Filter grouped rows using a function that operates on each aggregated row\nWarning: This cannot be optimized by the query compiler"}]},{"type":"heading","depth":6,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":6,"id":"callback","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"row"},{"type":"text","value":") => "},{"type":"inlineCode","value":"any"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that receives an aggregated row (with $selected when select() was called) and returns a boolean"}]},{"type":"heading","depth":6,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryBuilder.md","children":[{"type":"inlineCode","value":"QueryBuilder"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A QueryBuilder with functional having filter applied"}]},{"type":"heading","depth":6,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Functional having (not optimized)\nquery\n  .from({ posts: postsCollection })\n  .groupBy(({posts}) => posts.userId)\n  .select(({posts}) => ({ userId: posts.userId, count: count(posts.id) }))\n  .fn.having(({ $selected }) => $selected.count > 5)","lang":"ts"},{"type":"heading","depth":6,"id":"select","children":[{"type":"text","value":"select()"}]},{"type":"code","value":"select<TFuncSelectResult>(callback): FnSelectQueryResult<TContext, TFuncSelectResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Select fields using a function that operates on each row\nWarning: This cannot be optimized by the query compiler"}]},{"type":"heading","depth":6,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":6,"id":"tfuncselectresult","children":[{"type":"text","value":"TFuncSelectResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFuncSelectResult"}]},{"type":"heading","depth":6,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":6,"id":"callback-2","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"row"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TFuncSelectResult"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that receives a row and returns the selected value"}]},{"type":"heading","depth":6,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"FnSelectQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFuncSelectResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A QueryBuilder with functional selection applied"}]},{"type":"heading","depth":6,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Functional select (not optimized)\nquery\n  .from({ users: usersCollection })\n  .fn.select(row => ({\n    name: row.users.name.toUpperCase(),\n    age: row.users.age + 1,\n  }))","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Child query builders, query expressions, and helpers such as eq(),\ntoArray(), and materialize() cannot be returned from fn.select(). Use\nthem as fields in select() so the compiler can add them to the query\ngraph."}]},{"type":"paragraph","children":[{"type":"text","value":"Compiled Collection-valued includes cannot be inputs to fn.select(),\nincluding nested descendants. Use toArray() or materialize() in the\nupstream select(), or do parent-only functional work before adding\nlive Collection includes with select()."}]},{"type":"heading","depth":6,"id":"where","children":[{"type":"text","value":"where()"}]},{"type":"code","value":"where(callback): QueryBuilder<TContext>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Filter rows using a function that operates on each row\nWarning: This cannot be optimized by the query compiler"}]},{"type":"heading","depth":6,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":6,"id":"callback-3","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"row"},{"type":"text","value":") => "},{"type":"inlineCode","value":"any"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that receives a row and returns a boolean"}]},{"type":"heading","depth":6,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryBuilder.md","children":[{"type":"inlineCode","value":"QueryBuilder"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A QueryBuilder with functional filtering applied"}]},{"type":"heading","depth":6,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Functional where (not optimized)\nquery\n  .from({ users: usersCollection })\n  .fn.where(row => row.users.name.startsWith('A'))","lang":"ts"},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"getquery","children":[{"type":"text","value":"_getQuery()"}]},{"type":"code","value":"_getQuery(): QueryIR;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/index.ts#L1018","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:1018"}]}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../@tanstack/namespaces/IR/interfaces/QueryIR.md","children":[{"type":"inlineCode","value":"QueryIR"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"distinct","children":[{"type":"text","value":"distinct()"}]},{"type":"code","value":"distinct(): QueryBuilder<TContext>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/index.ts#L854","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:854"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Specify that the query should return distinct rows.\nDeduplicates rows based on the selected columns."}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryBuilder.md","children":[{"type":"inlineCode","value":"QueryBuilder"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A QueryBuilder with distinct enabled"}]},{"type":"heading","depth":4,"id":"example-5","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Get countries our users are from\nquery\n  .from({ users: usersCollection })\n  .select(({users}) => ({ country: users.country }))\n  .distinct()","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"findone","children":[{"type":"text","value":"findOne()"}]},{"type":"code","value":"findOne(): QueryBuilder<TContext & SingleResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/index.ts#L874","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:874"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Specify that the query should return a single result"}]},{"type":"heading","depth":4,"id":"returns-8","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryBuilder.md","children":[{"type":"inlineCode","value":"QueryBuilder"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":" & "},{"type":"link","href":"../type-aliases/SingleResult.md","children":[{"type":"inlineCode","value":"SingleResult"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A QueryBuilder that returns the first result"}]},{"type":"heading","depth":4,"id":"example-6","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Get the user matching the query\nquery\n  .from({ users: usersCollection })\n  .where(({users}) => eq(users.id, 1))\n  .findOne()","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"from","children":[{"type":"text","value":"from()"}]},{"type":"code","value":"from<TSource>(source): QueryBuilder<ContextFromSource<TSource>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/index.ts#L257","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:257"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Specify the source table or subquery for the query"}]},{"type":"heading","depth":4,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tsource","children":[{"type":"text","value":"TSource"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSource"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/Source.md","children":[{"type":"inlineCode","value":"Source"}]}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"source","children":[{"type":"text","value":"source"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/SingleSource.md","children":[{"type":"inlineCode","value":"SingleSource"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSource"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An object with a single key-value pair where the key is the table alias and the value is a Collection or subquery"}]},{"type":"heading","depth":4,"id":"returns-9","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryBuilder.md","children":[{"type":"inlineCode","value":"QueryBuilder"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/ContextFromSource.md","children":[{"type":"inlineCode","value":"ContextFromSource"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSource"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"A QueryBuilder with the specified source"}]},{"type":"heading","depth":4,"id":"example-7","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Query from a collection\nquery.from({ users: usersCollection })\n\n// Query from a subquery\nconst activeUsers = query.from({ u: usersCollection }).where(({u}) => u.active)\nquery.from({ activeUsers })","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"fulljoin","children":[{"type":"text","value":"fullJoin()"}]},{"type":"code","value":"fullJoin<TSource>(source, onCallback): QueryBuilder<MergeContextWithJoinType<TContext, SchemaFromSource<TSource>, \"full\">>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/index.ts#L472","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:472"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Perform a FULL JOIN with another table or subquery"}]},{"type":"heading","depth":4,"id":"type-parameters-4","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tsource-2","children":[{"type":"text","value":"TSource"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSource"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/Source.md","children":[{"type":"inlineCode","value":"Source"}]}]},{"type":"heading","depth":4,"id":"parameters-6","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"source-2","children":[{"type":"text","value":"source"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSource"}]},{"type":"paragraph","children":[{"type":"text","value":"An object with a single key-value pair where the key is the table alias and the value is a Collection or subquery"}]},{"type":"heading","depth":5,"id":"oncallback","children":[{"type":"text","value":"onCallback"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/JoinOnCallback.md","children":[{"type":"inlineCode","value":"Jo