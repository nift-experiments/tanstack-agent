for "},{"type":"inlineCode","value":"limit"}]},{"type":"heading","depth":4,"id":"parameters-12","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"count","children":[{"type":"text","value":"count"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"Maximum number of rows to return"}]},{"type":"heading","depth":4,"id":"returns-16","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryBuilder.md","children":[{"type":"inlineCode","value":"QueryBuilder"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A QueryBuilder with the limit applied"}]},{"type":"heading","depth":4,"id":"example-14","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Get top 5 posts by likes\nquery\n  .from({ posts: postsCollection })\n  .orderBy(({posts}) => posts.likes, 'desc')\n  .limit(5)","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"offset","children":[{"type":"text","value":"offset()"}]},{"type":"code","value":"offset(count): QueryBuilder<TContext>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/index.ts#L833","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:833"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Skip a number of rows before returning results\n"},{"type":"inlineCode","value":"orderBy"},{"type":"text","value":" is required for "},{"type":"inlineCode","value":"offset"}]},{"type":"heading","depth":4,"id":"parameters-13","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"count-2","children":[{"type":"text","value":"count"}]},{"type":"paragraph",