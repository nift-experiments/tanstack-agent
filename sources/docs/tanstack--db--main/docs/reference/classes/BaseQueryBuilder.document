dex.ts#L394","children":[{"type":"text","value":"packages/db/src/query/builder/index.ts:394"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Perform a LEFT JOIN with another table or subquery"}]},{"type":"heading","depth":4,"id":"type-parameters-7","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tsource-5","children":[{"type":"text","value":"TSource"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSource"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/Source.md","children":[{"type":"inlineCode","value":"Source"}]}]},{"type":"heading","depth":4,"id":"parameters-11","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"source-5","children":[{"type":"text","value":"source"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSource"}]},{"type":"paragraph","children":[{"type":"text","value":"An object with a single key-value pair where the key is the table alias and the value is a Collection or subquery"}]},{"type":"heading","depth":5,"id":"oncallback-4","children":[{"type":"text","value":"onCallback"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/JoinOnCallback.md","children":[{"type":"inlineCode","value":"JoinOnCallback"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/MergeContextForJoinCallback.md","children":[{"type":"inlineCode","value":"MergeContextForJoinCallback"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":", { [K in string | number | symbol]: { [K in string | number | symbol]: TSource[K] extends CollectionImpl<any, any, any, any, any> ? InferCollectionType<any[any]> : TSource[K] extends CollectionOptionsIdentity<any, any, any, any, any> ? InferCollectionType<any[any]> : TSource[K] extends QueryBuilder<TContext> ? ResultValue<TContext>