update"}]}]}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tkey","text":"TKey","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"id","text":"id","level":5},{"id":"expression","text":"expression","level":5},{"id":"name","text":"name?","level":5},{"id":"options","text":"options?","level":5},{"id":"returns","text":"Returns","level":4},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"properties","text":"Properties","level":2},{"id":"comparefn","text":"compareFn()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"a","text":"a","level":5},{"id":"b","text":"b","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"inherited-from-2","text":"Inherited from","level":4},{"id":"compareoptions","text":"compareOptions","level":3},{"id":"inherited-from-3","text":"Inherited from","level":4},{"id":"expression-2","text":"expression","level":3},{"id":"inherited-from-4","text":"Inherited from","level":4},{"id":"hascustomcomparator","text":"hasCustomComparator","level":3},{"id":"inherited-from-5","text":"Inherited from","level":4},{"id":"id-2","text":"id","level":3},{"id":"inherited-from-6","text":"Inherited from","level":4},{"id":"name-2","text":"name?","level":3},{"id":"inherited-from-7","text":"Inherited from","level":4},{"id":"supportedoperations","text":"supportedOperations","level":3},{"id":"overrides","text":"Overrides","level":4},{"id":"accessors","text":"Accessors","level":2},{"id":"keycount","text":"keyCount","level":3},{"id":"get-signature","text":"Get Signature","level":4},{"id":"returns-3","text":"Returns","level":5},{"id":"overrides-2","text":"Overrides","level":4},{"id":"supportsrangeoptimization","text":"supportsRangeOptimization","level":3},{"id":"get-signature-2","text":"Get Signature","level":4},{"id":"returns-4","text":"Ret