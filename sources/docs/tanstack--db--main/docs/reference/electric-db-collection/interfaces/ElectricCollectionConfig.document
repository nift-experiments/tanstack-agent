<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"> = "},{"type":"inlineCode","value":"Row"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The type of items in the collection"}]},{"type":"heading","depth":3,"id":"tschema","children":[{"type":"text","value":"TSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":" = "},{"type":"inlineCode","value":"never"}]},{"type":"paragraph","children":[{"type":"text","value":"The schema type for validation"}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"electric-test-hooks","children":[{"type":"text","value":"[ELECTRIC_TEST_HOOKS]?"}]},{"type":"code","value":"optional [ELECTRIC_TEST_HOOKS]: ElectricTestHooks;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L359","children":[{"type":"text","value":"packages/electric-db-collection/src/electric.ts:359"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Internal test hooks (for testing only)\nHidden via Symbol to prevent accidental usage in production"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"ondelete","children":[{"type":"text","value":"onDelete()?"}]},{"type":"code","value":"optional onDelete: (params) => Promise<MatchingStrategy>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L545","children":[{"type":"text","value":"packages/electric-db-collection/src/electric.ts:545"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional asynchronous handler function called before a delete operation"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"IMPORTANT - Electric Synchronization:"}]},{"type":"text","value":"\nThis handler "},{"type":"strong","children":[{"type":"text","value":"must not resolve"}]},{"type":"text","value":" until synchronization is confirmed.\nAwait one of these synchronization utilities before the handler completes:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"await collection.utils.awaitTxId(txid)"},{"type":"text","value":" (recommended for most cases)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"await collection.utils.awaitMatch(fn)"},{"type":"text","value":" for custom matching logic"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Simply returning without waiting for sync will drop optimistic state too early, causing UI glitches."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"params","children":[{"type":"text","value":"params"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"DeleteMutationFnParams"},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":", "},{"type":"link","href":"ElectricCollectionUtils.md","children":[{"type":"inlineCode","value":"ElectricCollectionUtils"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Object containing transaction and collection information"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"MatchingStrategy"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Promise that should resolve after synchronization is complete"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Deprecation notice:"}]},{"type":"text","value":" Returning "},{"type":"inlineCode","value":"{ txid }"},{"type":"text","value":" from handlers is deprecated and will be removed in v1.0.\nUse "},{"type":"inlineCode","value":"await collection.utils.awaitTxId(txid)"},{"type":"text","value":" within the handler instead."}]},{"type":"heading","depth":4,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Recommended: Wait for txid to sync\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const result = await api.todos.delete({\n    id: mutation.original.id\n  })\n  // Wait for txid to sync before handler completes\n  await collection.utils.awaitTxId(result.txid)\n}","lang":"ts"},{"type":"code","value":"// Alternative: Use awaitMatch utility for custom matching logic\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  await api.todos.delete({ id: mutation.original.id })\n  // Wait for specific change to appear in sync stream\n  await collection.utils.awaitMatch(\n    (message) => isChangeMessage(message) &&\n                 message.headers.operation === 'delete' &&\n                 message.value.id === mutation.original.id\n  )\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"oninsert","children":[{"type":"text","value":"onInsert()?"}]},{"type":"code","value":"optional onInsert: (params) => Promise<MatchingStrategy>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L446","children":[{"type":"text","value":"packages/electric-db-collection/src/electric.ts:446"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional asynchronous handler function called before an insert operation"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"IMPORTANT - Electric Synchronization:"}]},{"type":"text","value":"\nThis handler "},{"type":"strong","children":[{"type":"text","value":"must not resolve"}]},{"type":"text","value":" until synchronization is confirmed.\nAwait one of these synchronization utilities before the handler completes:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"await collection.utils.awaitTxId(txid)"},{"type":"text","value":" (recommended for most cases)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"await collection.utils.awaitMatch(fn)"},{"type":"text","value":" for custom matching logic"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Simply returning without waiting for sync will drop optimistic state too early, causing UI glitches."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"params-2","children":[{"type":"text","value":"params"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"InsertMutationFnParams"},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":", "},{"type":"link","href":"ElectricCollectionUtils.md","children":[{"type":"inlineCode","value":"ElectricCollectionUtils"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Object containing transaction and collection information"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"MatchingStrategy"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Promise that should resolve after synchronization is complete"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Deprecation notice:"}]},{"type":"text","value":" Returning "},{"type":"inlineCode","value":"{ txid }"},{"type":"text","value":" from handlers is deprecated and will be removed in v1.0.\nUse "},{"type":"inlineCode","value":"await collection.utils.awaitTxId(txid)"},{"type":"text","value":" within the handler instead."}]},{"type":"heading","depth":4,"id":"examples-2","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Recommended: Wait for txid to sync\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.todos.create({\n    data: newItem\n  })\n  // Wait for txid to sync before handler completes\n  await collection.utils.awaitTxId(result.txid)\n}","lang":"ts"},{"type":"code","value":"// Insert handler with custom timeout\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.todos.create({\n    data: newItem\n  })\n  // Wait up to 10 seconds for txid\n  await collection.utils.awaitTxId(result.txid, 10000)\n}","lang":"ts"},{"type":"code","value":"// Insert handler with timeout error handling\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.todos.create({\n    data: newItem\n  })\n\n  try {\n    await collection.utils.awaitTxId(result.txid, 5000)\n  } catch (error) {\n    // Decide sync timeout policy:\n    // - Throw to rollback optimistic state\n    // - Catch to keep optimistic state (eventual consistency)\n    // - Schedule background retry\n    console.warn('Sync timeout, keeping optimistic state:', error)\n    // Don't throw - allow optimistic state to persist\n  }\n}","lang":"ts"},{"type":"code","value":"// Insert handler with multiple items\nonInsert: async ({ transaction, collection }) => {\n  const items = transaction.mutations.map(m => m.modified)\n  const results = await Promise.all(\n    items.map(item => api.todos.create({ data: item }))\n  )\n  // Wait for all txids to sync\n  await Promise.all(\n    results.map(r => collection.utils.awaitTxId(r.txid))\n  )\n}","lang":"ts"},{"type":"code","value":"// Alternative: Use awaitMatch utility for custom matching logic\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  await api.todos.create({ data: newItem })\n  // Wait for specific change to appear in sync stream\n  await collection.utils.awaitMatch(\n    (message) => isChangeMessage(message) &&\n                 message.headers.operation === 'insert' &&\n                 message.value.name === newItem.name\n  )\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onupdate","children":[{"type":"text","value":"onUpdate()?"}]},{"type":"code","value":"optional onUpdate: (params) => Promise<MatchingStrategy>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L496","children":[{"type":"text","value":"packages/electric-db-collection/src/electric.ts:496"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional asynchronous handler function called before an update operation"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"IMPORTANT - Electric Synchronization:"}]},{"type":"text","value":"\nThis handler "},{"type":"strong","children":[{"type":"text","value":"must not resolve"}]},{"type":"text","value":" until synchronization is confirmed.\nAwait one of these synchronization utilities before the handler completes:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"await collection.utils.awaitTxId(txid)"},{"type":"text","value":" (recommended for most cases)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"await collection.utils.awaitMatch(fn)"},{"type":"text","value":" for custom matching logic"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Simply returning without waiting for sync will drop optimistic state too early, causing UI glitches."}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"params-3","children":[{"type":"text","value":"params"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"UpdateMutationFnParams"},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":", "},{"type":"link","href":"ElectricCollectionUtils.md","children":[{"type":"inlineCode","value":"ElectricCollectionUtils"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Object containing transaction and collection information"}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"MatchingStrategy"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Promise that should resolve after synchronization is complete"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Deprecation notice:"}]},{"type":"text","value":" Returning "},{"type":"inlineCode","value":"{ txid }"},{"type":"text","value":" from handlers is deprecated and will be removed in v1.0.\nUse "},{"type":"inlineCode","value":"await collection.utils.awaitTxId(txid)"},{"type":"text","value":" within the handler instead."}]},{"type":"heading","depth":4,"id":"examples-3","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Recommended: Wait for txid to sync\nonUpdate: async ({ transaction, collection }) => {\n  const { original, changes } = transaction.mutations[0]\n  const result = await api.todos.update({\n    where: { id: original.id },\n    data: changes\n  })\n  // Wait for txid to sync before handler completes\n  await collection.utils.awaitTxId(result.txid)\n}","lang":"ts"},{"type":"code","value":"// Alternative: Use awaitMatch utility for custom matching logic\nonUpdate: async ({ transaction, collection }) => {\n  const { original, changes } = transaction.mutations[0]\n  await api.todos.update({ where: { id: original.id }, data: changes })\n  // Wait for specific change to appear in sync stream\n  await collection.utils.awaitMatch(\n    (message) => isChangeMessage(message) &&\n                 message.headers.operation === 'update' &&\n                 message.value.id === original.id\n  )\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"shapeoptions","children":[{"type":"text","value":"shapeOptions"}]},{"type":"code","value":"shapeOptions: ShapeStreamOptions<GetExtensions<T>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L352","children":[{"type":"text","value":"packages/electric-db-collection/src/electric.ts:352"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration options for the ElectricSQL ShapeStream"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"syncmode","children":[{"type":"text","value":"syncMode?"}]},{"type":"code","value":"optional syncMode: ElectricSyncMode;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L353","children":[{"type":"text","value":"packages/electric-db-collection/src/electric.ts:353"}]}]}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"tschema","text":"TSchema","level":3},{"id":"properties","text":"Properties","level":2},{"id":"electric-test-hooks","text":"[ELECTRIC_TEST_HOOKS]?","level":3},{"id":"ondelete","text":"onDelete()?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"params","text":"params","level":5},{"id":"returns","text":"Returns","level":4},{"id":"examples","text":"Examples","level":4},{"id":"oninsert","text":"onInsert()?","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"params-2","text":"params","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"examples-2","text":"Examples","level":4},{"id":"onupdate","text":"onUpdate()?","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"params-3","text":"params","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"examples-3","text":"Examples","level":4},{"id":"shapeoptions","text":"shapeOptions","level":3},{"id":"syncmode","text":"syncMode?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/electric-db-collection/src/electric.ts:342](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L342)\n\nConfiguration interface for Electric collection options\n\n## Extends\n\n- `Omit`\\<`BaseCollectionConfig`\\<`T`, `string` \\| `number`, `TSchema`, [`ElectricCollectionUtils`](ElectricCollectionUtils.md)\\<`T`\\>\\>, `\"onInsert\"` \\| `\"onUpdate\"` \\| `\"onDelete\"` \\| `\"syncMode\"`\\>\n\n## Type Parameters\n\n### T\n\n`T` *extends* `Row`\\<`unknown`\\> = `Row`\\<`unknown`\\>\n\nThe type of items in the collection\n\n### TSchema\n\n`TSchema` *extends* `StandardSchemaV1` = `never`\n\nThe schema type for validation\n\n## Properties\n\n### \\[ELECTRIC\\_TEST\\_HOOKS\\]?\n\n```ts\noptional [ELECTRIC_TEST_HOOKS]: ElectricTestHooks;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:359](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L359)\n\nInternal test hooks (for testing only)\nHidden via Symbol to prevent accidental usage in production\n\n***\n\n### onDelete()?\n\n```ts\noptional onDelete: (params) => Promise<MatchingStrategy>;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:545](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L545)\n\nOptional asynchronous handler function called before a delete operation\n\n**IMPORTANT - Electric Synchronization:**\nThis handler **must not resolve** until synchronization is confirmed.\nAwait one of these synchronization utilities before the handler completes:\n1. `await collection.utils.awaitTxId(txid)` (recommended for most cases)\n2. `await collection.utils.awaitMatch(fn)` for custom matching logic\n\nSimply returning without waiting for sync will drop optimistic state too early, causing UI glitches.\n\n#### Parameters\n\n##### params\n\n`DeleteMutationFnParams`\\<`T`, `string` \\| `number`, [`ElectricCollectionUtils`](ElectricCollectionUtils.md)\\<`T`\\>\\>\n\nObject containing transaction and collection information\n\n#### Returns\n\n`Promise`\\<`MatchingStrategy`\\>\n\nPromise that should resolve after synchronization is complete\n\n**Deprecation notice:** Returning `{ txid }` from handlers is deprecated and will be removed in v1.0.\nUse `await collection.utils.awaitTxId(txid)` within the handler instead.\n\n#### Examples\n\n```ts\n// Recommended: Wait for txid to sync\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const result = await api.todos.delete({\n    id: mutation.original.id\n  })\n  // Wait for txid to sync before handler completes\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Alternative: Use awaitMatch utility for custom matching logic\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  await api.todos.delete({ id: mutation.original.id })\n  // Wait for specific change to appear in sync stream\n  await collection.utils.awaitMatch(\n    (message) => isChangeMessage(message) &&\n                 message.headers.operation === 'delete' &&\n                 message.value.id === mutation.original.id\n  )\n}\n```\n\n***\n\n### onInsert()?\n\n```ts\noptional onInsert: (params) => Promise<MatchingStrategy>;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:446](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L446)\n\nOptional asynchronous handler function called before an insert operation\n\n**IMPORTANT - Electric Synchronization:**\nThis handler **must not resolve** until synchronization is confirmed.\nAwait one of these synchronization utilities before the handler completes:\n1. `await collection.utils.awaitTxId(txid)` (recommended for most cases)\n2. `await collection.utils.awaitMatch(fn)` for custom matching logic\n\nSimply returning without waiting for sync will drop optimistic state too early, causing UI glitches.\n\n#### Parameters\n\n##### params\n\n`InsertMutationFnParams`\\<`T`, `string` \\| `number`, [`ElectricCollectionUtils`](ElectricCollectionUtils.md)\\<`T`\\>\\>\n\nObject containing transaction and collection information\n\n#### Returns\n\n`Promise`\\<`MatchingStrategy`\\>\n\nPromise that should resolve after synchronization is complete\n\n**Deprecation notice:** Returning `{ txid }` from handlers is deprecated and will be removed in v1.0.\nUse `await collection.utils.awaitTxId(txid)` within the handler instead.\n\n#### Examples\n\n```ts\n// Recommended: Wait for txid to sync\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.todos.create({\n    data: newItem\n  })\n  // Wait for txid to sync before handler completes\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Insert handler with custom timeout\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.todos.create({\n    data: newItem\n  })\n  // Wait up to 10 seconds for txid\n  await collection.utils.awaitTxId(result.txid, 10000)\n}\n```\n\n```ts\n// Insert handler with timeout error handling\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.todos.create({\n    data: newItem\n  })\n\n  try {\n    await collection.utils.awaitTxId(result.txid, 5000)\n  } catch (error) {\n    // Decide sync timeout policy:\n    // - Throw to rollback optimistic state\n    // - Catch to keep optimistic state (eventual consistency)\n    // - Schedule background retry\n    console.warn('Sync timeout, keeping optimistic state:', error)\n    // Don't throw - allow optimistic state to persist\n  }\n}\n```\n\n```ts\n// Insert handler with multiple items\nonInsert: async ({ transaction, collection }) => {\n  const items = transaction.mutations.map(m => m.modified)\n  const results = await Promise.all(\n    items.map(item => api.todos.create({ data: item }))\n  )\n  // Wait for all txids to sync\n  await Promise.all(\n    results.map(r => collection.utils.awaitTxId(r.txid))\n  )\n}\n```\n\n```ts\n// Alternative: Use awaitMatch utility for custom matching logic\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  await api.todos.create({ data: newItem })\n  // Wait for specific change to appear in sync stream\n  await collection.utils.awaitMatch(\n    (message) => isChangeMessage(message) &&\n                 message.headers.operation === 'insert' &&\n                 message.value.name === newItem.name\n  )\n}\n```\n\n***\n\n### onUpdate()?\n\n```ts\noptional onUpdate: (params) => Promise<MatchingStrategy>;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:496](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L496)\n\nOptional asynchronous handler function called before an update operation\n\n**IMPORTANT - Electric Synchronization:**\nThis handler **must not resolve** until synchronization is confirmed.\nAwait one of these synchronization utilities before the handler completes:\n1. `await collection.utils.awaitTxId(txid)` (recommended for most cases)\n2. `await collection.utils.awaitMatch(fn)` for custom matching logic\n\nSimply returning without waiting for sync will drop optimistic state too early, causing UI glitches.\n\n#### Parameters\n\n##### params\n\n`UpdateMutationFnParams`\\<`T`, `string` \\| `number`, [`ElectricCollectionUtils`](ElectricCollectionUtils.md)\\<`T`\\>\\>\n\nObject containing transaction and collection information\n\n#### Returns\n\n`Promise`\\<`MatchingStrategy`\\>\n\nPromise that should resolve after synchronization is complete\n\n**Deprecation notice:** Returning `{ txid }` from handlers is deprecated and will be removed in v1.0.\nUse `await collection.utils.awaitTxId(txid)` within the handler instead.\n\n#### Examples\n\n```ts\n// Recommended: Wait for txid to sync\nonUpdate: async ({ transaction, collection }) => {\n  const { original, changes } = transaction.mutations[0]\n  const result = await api.todos.update({\n    where: { id: original.id },\n    data: changes\n  })\n  // Wait for txid to sync before handler completes\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Alternative: Use awaitMatch utility for custom matching logic\nonUpdate: async ({ transaction, collection }) => {\n  const { original, changes } = transaction.mutations[0]\n  await api.todos.update({ where: { id: original.id }, data: changes })\n  // Wait for specific change to appear in sync stream\n  await collection.utils.awaitMatch(\n    (message) => isChangeMessage(message) &&\n                 message.headers.operation === 'update' &&\n                 message.value.id === original.id\n  )\n}\n```\n\n***\n\n### shapeOptions\n\n```ts\nshapeOptions: ShapeStreamOptions<GetExtensions<T>>;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:352](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L352)\n\nConfiguration options for the ElectricSQL ShapeStream\n\n***\n\n### syncMode?\n\n```ts\noptional syncMode: ElectricSyncMode;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:353](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L353)\n","originalRawMarkdown":"---\nid: ElectricCollectionConfig\ntitle: ElectricCollectionConfig\n---\n\nDefined in: [packages/electric-db-collection/src/electric.ts:342](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L342)\n\nConfiguration interface for Electric collection options\n\n## Extends\n\n- `Omit`\\<`BaseCollectionConfig`\\<`T`, `string` \\| `number`, `TSchema`, [`ElectricCollectionUtils`](ElectricCollectionUtils.md)\\<`T`\\>\\>, `\"onInsert\"` \\| `\"onUpdate\"` \\| `\"onDelete\"` \\| `\"syncMode\"`\\>\n\n## Type Parameters\n\n### T\n\n`T` *extends* `Row`\\<`unknown`\\> = `Row`\\<`unknown`\\>\n\nThe type of items in the collection\n\n### TSchema\n\n`TSchema` *extends* `StandardSchemaV1` = `never`\n\nThe schema type for validation\n\n## Properties\n\n### \\[ELECTRIC\\_TEST\\_HOOKS\\]?\n\n```ts\noptional [ELECTRIC_TEST_HOOKS]: ElectricTestHooks;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:359](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L359)\n\nInternal test hooks (for testing only)\nHidden via Symbol to prevent accidental usage in production\n\n***\n\n### onDelete()?\n\n```ts\noptional onDelete: (params) => Promise<MatchingStrategy>;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:545](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L545)\n\nOptional asynchronous handler function called before a delete operation\n\n**IMPORTANT - Electric Synchronization:**\nThis handler **must not resolve** until synchronization is confirmed.\nAwait one of these synchronization utilities before the handler completes:\n1. `await collection.utils.awaitTxId(txid)` (recommended for most cases)\n2. `await collection.utils.awaitMatch(fn)` for custom matching logic\n\nSimply returning without waiting for sync will drop optimistic state too early, causing UI glitches.\n\n#### Parameters\n\n##### params\n\n`DeleteMutationFnParams`\\<`T`, `string` \\| `number`, [`ElectricCollectionUtils`](ElectricCollectionUtils.md)\\<`T`\\>\\>\n\nObject containing transaction and collection information\n\n#### Returns\n\n`Promise`\\<`MatchingStrategy`\\>\n\nPromise that should resolve after synchronization is complete\n\n**Deprecation notice:** Returning `{ txid }` from handlers is deprecated and will be removed in v1.0.\nUse `await collection.utils.awaitTxId(txid)` within the handler instead.\n\n#### Examples\n\n```ts\n// Recommended: Wait for txid to sync\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const result = await api.todos.delete({\n    id: mutation.original.id\n  })\n  // Wait for txid to sync before handler completes\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Alternative: Use awaitMatch utility for custom matching logic\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  await api.todos.delete({ id: mutation.original.id })\n  // Wait for specific change to appear in sync stream\n  await collection.utils.awaitMatch(\n    (message) => isChangeMessage(message) &&\n                 message.headers.operation === 'delete' &&\n                 message.value.id === mutation.original.id\n  )\n}\n```\n\n***\n\n### onInsert()?\n\n```ts\noptional onInsert: (params) => Promise<MatchingStrategy>;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:446](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L446)\n\nOptional asynchronous handler function called before an insert operation\n\n**IMPORTANT - Electric Synchronization:**\nThis handler **must not resolve** until synchronization is confirmed.\nAwait one of these synchronization utilities before the handler completes:\n1. `await collection.utils.awaitTxId(txid)` (recommended for most cases)\n2. `await collection.utils.awaitMatch(fn)` for custom matching logic\n\nSimply returning without waiting for sync will drop optimistic state too early, causing UI glitches.\n\n#### Parameters\n\n##### params\n\n`InsertMutationFnParams`\\<`T`, `string` \\| `number`, [`ElectricCollectionUtils`](ElectricCollectionUtils.md)\\<`T`\\>\\>\n\nObject containing transaction and collection information\n\n#### Returns\n\n`Promise`\\<`MatchingStrategy`\\>\n\nPromise that should resolve after synchronization is complete\n\n**Deprecation notice:** Returning `{ txid }` from handlers is deprecated and will be removed in v1.0.\nUse `await collection.utils.awaitTxId(txid)` within the handler instead.\n\n#### Examples\n\n```ts\n// Recommended: Wait for txid to sync\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.todos.create({\n    data: newItem\n  })\n  // Wait for txid to sync before handler completes\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Insert handler with custom timeout\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.todos.create({\n    data: newItem\n  })\n  // Wait up to 10 seconds for txid\n  await collection.utils.awaitTxId(result.txid, 10000)\n}\n```\n\n```ts\n// Insert handler with timeout error handling\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.todos.create({\n    data: newItem\n  })\n\n  try {\n    await collection.utils.awaitTxId(result.txid, 5000)\n  } catch (error) {\n    // Decide sync timeout policy:\n    // - Throw to rollback optimistic state\n    // - Catch to keep optimistic state (eventual consistency)\n    // - Schedule background retry\n    console.warn('Sync timeout, keeping optimistic state:', error)\n    // Don't throw - allow optimistic state to persist\n  }\n}\n```\n\n```ts\n// Insert handler with multiple items\nonInsert: async ({ transaction, collection }) => {\n  const items = transaction.mutations.map(m => m.modified)\n  const results = await Promise.all(\n    items.map(item => api.todos.create({ data: item }))\n  )\n  // Wait for all txids to sync\n  await Promise.all(\n    results.map(r => collection.utils.awaitTxId(r.txid))\n  )\n}\n```\n\n```ts\n// Alternative: Use awaitMatch utility for custom matching logic\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  await api.todos.create({ data: newItem })\n  // Wait for specific change to appear in sync stream\n  await collection.utils.awaitMatch(\n    (message) => isChangeMessage(message) &&\n                 message.headers.operation === 'insert' &&\n                 message.value.name === newItem.name\n  )\n}\n```\n\n***\n\n### onUpdate()?\n\n```ts\noptional onUpdate: (params) => Promise<MatchingStrategy>;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:496](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L496)\n\nOptional asynchronous handler function called before an update operation\n\n**IMPORTANT - Electric Synchronization:**\nThis handler **must not resolve** until synchronization is confirmed.\nAwait one of these synchronization utilities before the handler completes:\n1. `await collection.utils.awaitTxId(txid)` (recommended for most cases)\n2. `await collection.utils.awaitMatch(fn)` for custom matching logic\n\nSimply returning without waiting for sync will drop optimistic state too early, causing UI glitches.\n\n#### Parameters\n\n##### params\n\n`UpdateMutationFnParams`\\<`T`, `string` \\| `number`, [`ElectricCollectionUtils`](ElectricCollectionUtils.md)\\<`T`\\>\\>\n\nObject containing transaction and collection information\n\n#### Returns\n\n`Promise`\\<`MatchingStrategy`\\>\n\nPromise that should resolve after synchronization is complete\n\n**Deprecation notice:** Returning `{ txid }` from handlers is deprecated and will be removed in v1.0.\nUse `await collection.utils.awaitTxId(txid)` within the handler instead.\n\n#### Examples\n\n```ts\n// Recommended: Wait for txid to sync\nonUpdate: async ({ transaction, collection }) => {\n  const { original, changes } = transaction.mutations[0]\n  const result = await api.todos.update({\n    where: { id: original.id },\n    data: changes\n  })\n  // Wait for txid to sync before handler completes\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Alternative: Use awaitMatch utility for custom matching logic\nonUpdate: async ({ transaction, collection }) => {\n  const { original, changes } = transaction.mutations[0]\n  await api.todos.update({ where: { id: original.id }, data: changes })\n  // Wait for specific change to appear in sync stream\n  await collection.utils.awaitMatch(\n    (message) => isChangeMessage(message) &&\n                 message.headers.operation === 'update' &&\n                 message.value.id === original.id\n  )\n}\n```\n\n***\n\n### shapeOptions\n\n```ts\nshapeOptions: ShapeStreamOptions<GetExtensions<T>>;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:352](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L352)\n\nConfiguration options for the ElectricSQL ShapeStream\n\n***\n\n### syncMode?\n\n```ts\noptional syncMode: ElectricSyncMode;\n```\n\nDefined in: [packages/electric-db-collection/src/electric.ts:353](https://github.com/TanStack/db/blob/main/packages/electric-db-collection/src/electric.ts#L353)\n"}
