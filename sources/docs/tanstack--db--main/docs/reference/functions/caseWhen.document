rameters","level":3},{"id":"condition1-9","text":"condition1","level":4},{"id":"value1-9","text":"value1","level":4},{"id":"condition2-7","text":"condition2","level":4},{"id":"value2-7","text":"value2","level":4},{"id":"condition3-5","text":"condition3","level":4},{"id":"value3-5","text":"value3","level":4},{"id":"condition4-3","text":"condition4","level":4},{"id":"value4-3","text":"value4","level":4},{"id":"condition5","text":"condition5","level":4},{"id":"value5","text":"value5","level":4},{"id":"returns-9","text":"Returns","level":3},{"id":"examples-9","text":"Examples","level":3},{"id":"call-signature-10","text":"Call Signature","level":2},{"id":"type-parameters-10","text":"Type Parameters","level":3},{"id":"c1-10","text":"C1","level":4},{"id":"v1-10","text":"V1","level":4},{"id":"c2-8","text":"C2","level":4},{"id":"v2-8","text":"V2","level":4},{"id":"c3-6","text":"C3","level":4},{"id":"v3-6","text":"V3","level":4},{"id":"c4-4","text":"C4","level":4},{"id":"v4-4","text":"V4","level":4},{"id":"c5-2","text":"C5","level":4},{"id":"v5-2","text":"V5","level":4},{"id":"d-5","text":"D","level":4},{"id":"parameters-10","text":"Parameters","level":3},{"id":"condition1-10","text":"condition1","level":4},{"id":"value1-10","text":"value1","level":4},{"id":"condition2-8","text":"condition2","level":4},{"id":"value2-8","text":"value2","level":4},{"id":"condition3-6","text":"condition3","level":4},{"id":"value3-6","text":"value3","level":4},{"id":"condition4-4","text":"condition4","level":4},{"id":"value4-4","text":"value4","level":4},{"id":"condition5-2","text":"condition5","level":4},{"id":"value5-2","text":"value5","level":4},{"id":"defaultvalue-5","text":"defaultValue","level":4},{"id":"returns-10","text":"Returns","level":3},{"id":"examples-10","text":"Examples","level":3},{"id":"call-signature-11","text":"Call Signature","level":2},{"id":"type-parameters-11","text":"Type Parameters","level":3},{"id":"c1-11","text":"C1","level":4},{"id":"v1-11","text":"V1","level":4},{"id":"c2-9","text":"C2","level":4},{"id":"v2-9","text":"V2","level":4},{"id":"c3-7","text":"C3","level":4},{"id":"v3-7","text":"V3","level":4},{"id":"c4-5","text":"C4","level":4},{"id":"v4-5","text":"V4","level":4},{"id":"c5-3","text":"C5","level":4},{"id":"v5-3","text":"V5","level":4},{"id":"parameters-11","text":"Parameters","level":3},{"id":"condition1-11","text":"condition1","level":4},{"id":"value1-11","text":"value1","level":4},{"id":"condition2-9","text":"condition2","level":4},{"id":"value2-9","text":"value2","level":4},{"id":"condition3-7","text":"condition3","level":4},{"id":"value3-7","text":"value3","level":4},{"id":"condition4-5","text":"condition4","level":4},{"id":"value4-5","text":"value4","level":4},{"id":"condition5-3","text":"condition5","level":4},{"id":"value5-3","text":"value5","level":4},{"id":"condition6","text":"condition6","level":4},{"id":"value6","text":"value6","level":4},{"id":"rest","text":"rest","level":4},{"id":"returns-11","text":"Returns","level":3},{"id":"examples-11","text":"Examples","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction caseWhen<C1, V1>(condition1, value1): CaseWhenResult<[V1], false>;\n```\n\nDefined in: [packages/db/src/query/builder/functions.ts:405](https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/functions.ts#L405)\n\nReturns the value for the first matching condition, similar to SQL\n`CASE WHEN`.\n\nArguments are evaluated as condition/value pairs followed by an optional\ndefault value. Scalar branch values return a query expression and can be used\nin expression contexts like `select`, `where`, `orderBy`, `groupBy`,\n`having`, and equality join operands. If no scalar branch matches and no\ndefault is provided, the result is `null`.\n\nWhen a branch value is a projection object, `caseWhen` becomes a select-only\nprojection value. Projection branches can include nested fields, ref spreads,\nand includes. If no projection branch matches and no default is provided, the\nresult is `undefined`.\n\n### Type Parameters\n\n#### C1\n\n`C1` *extends* `ExpressionLike`\n\n#### V1\n\n`V1` *extends* `CaseWhenValue`\n\n### Parameters\n\n#### condition1\n\n`C1`\n\n#### value1\n\n`V1`\n\n### Returns\n\n`CaseWhenResult`\\<\\[`V1`\\], `false`\\>\n\n### Examples\n\n```ts\ncaseWhen(gt(user.age, 18), `adult`, `minor`)\n```\n\n```ts\ncaseWhen(\n  gt(user.age, 65),\n  `senior`,\n  gt(user.age, 18),\n  `adult`,\n  `minor`,\n)\n```\n\n```ts\ncaseWhen(gt(user.age, 18), {\n  ...user,\n  posts: q\n    .from({ post: postsCollection })\n    .where(({ post }) => eq(post.userId, user.id)),\n})\n```\n\n## Call Signature\n\n```ts\nfunction caseWhen<C1, V1, D>(\n   condition1, \n   value1, \ndefaultValue): CaseWhenResult<[V1, D], true>;\n```\n\nDefined in: [packages/db/src/query/builder/functions.ts:409](https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/functions.ts#L409)\n\nReturns the value for the first matching condition, similar to SQL\n`CASE WHEN`.\n\nArguments are evaluated as condition/value pairs followed by an optional\ndefault value. Scalar branch values return a query expression and can be used\nin expression contexts like `select`, `where`, `orderBy`, `groupBy`,\n`having`, and equality join operands. If no scalar branch matches and no\ndefault is provided, the result is `null`.\n\nWhen a branch value is a projection object, `caseWhen` becomes a select-only\nprojection value. Projection branches can include nested fields, ref spreads,\nand includes. If no projection branch matches and no default is provided, the\nresult is `undefined`.\n\n### Type Parameters\n\n#### C1\n\n`C1` *extends* `ExpressionLike`\n\n#### V1\n\n`V1` *extends* `CaseWhenValue`\n\n#### D\n\n`D` *extends* `CaseWhenValue`\n\n### Parameters\n\n#### condition1\n\n`C1`\n\n#### value1\n\n`V1`\n\n#### defaultValue\n\n`D`\n\n### Returns\n\n`CaseWhenResult`\\<\\[`V1`, `D`\\], `true`\\>\n\n### Examples\n\n```ts\ncaseWhen(gt(user.age, 18), `adult`, `minor`)\n```\n\n```ts\ncaseWhen(\n  gt(user.age, 65),\n  `senior`,\n  gt(user.age, 18),\n  `adult`,\n  `minor`,\n)\n```\n\n```ts\ncaseWhen(gt(user.age, 18), {\n  ...user,\n  posts: q\n    .from({ post: postsCollection })\n    .where(({ post }) => eq(post.userId, user.id)),\n})\n```\n\n## Call Signature\n\n```ts\nfunction caseWhen<C1, V1, C2, V2>(\n   condition1, \n   value1, \n   condition2, \nvalue2): CaseWhenResult<[V1, V2], false>;\n```\n\nDefined in: [packages/db/src/query/builder/functions.ts:414](https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/functions.ts#L414)\n\nReturns the value for the first matching condition, similar to SQL\n`CASE WHEN`.\n\nArguments are evaluated as condition/value pairs followed by an optional\ndefault value. Scalar branch values return a query expression and can be used\nin expression contexts like `select`, `where`, `orderBy`, `groupBy`,\n`having`, and equality join operands. If no scalar branch matches and no\ndefault is provided, the result is `null`.\n\nWhen a branch value is a projection object, `caseWhen` becomes a select-only\nprojection value. Projection branches can include nested fields, ref spreads,\nand includes. If no projection branch matches and no default is provided, the\nresult is `undefined`.\n\n### Type Parameters\n\n#### C1\n\n`C1` *extends* `ExpressionLike`\n\n#### V1\n\n`V1` *extends* `CaseWhenValue`\n\n#### C2\n\n`C2` *extends* `ExpressionLike`\n\n#### V2\n\n`V2` *extends* `CaseWhenValue`\n\n### Parameters\n\n#### condition1\n\n`C1`\n\n#### value1\n\n`V1`\n\n#### condition2\n\n`C2`\n\n#### value2\n\n`V2`\n\n### Returns\n\n`CaseWhenResult`\\<\\[`V1`, `V2`\\], `false`\\>\n\n### Examples\n\n```ts\ncaseWhen(gt(user.age, 18), `adult`, `minor`)\n```\n\n```ts\ncaseWhen(\n  gt(user.age, 65),\n  `senior`,\n  gt(user.age, 18),\n  `adult`,\n  `minor`,\n)\n```\n\n```ts\ncaseWhen(gt(user.age, 18), {\n  ...user,\n  posts: q\n    .from({ post: postsCollection })\n    .where(({ post }) => eq(post.userId, user.id)),\n})\n```\n\n## Call Signature\n\n```ts\nfunction caseWhen<C1, V1, C2, V2, D>(\n   condition1, \n   value1, \n   condition2, \n   value2, \ndefaultValue): CaseWhenResult<[V1, V2, D], true>;\n```\n\nDefined in: [packages/db/src/query/builder/functions.ts:425](https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/functions.ts#L425)\n\nReturns the value for the first matching condition, similar to SQL\n`CASE WHEN`.\n\nArguments are evaluated as condition/value pairs followed by an optional\ndefault value. Scalar branch values return a query expression and can be used\nin expression contexts like `select`, `where`, `orderBy`, `groupBy`,\n`having`, and equality join operands. If no scalar branch matches and no\ndefault is provided, the result is `null`.\n\nWhen a branch value is a projection object, `caseWhen` becomes a select-only\nprojection value. Projection branches can include nested fields, ref spreads,\nand includes. If no projection branch matches and no default is provided, the\nresult is `undefined`.\n\n### Type Parameters\n\n#### C1\n\n`C1` *extends* `ExpressionLike`\n\n#### V1\n\n`V1` *extends* `CaseWhenValue`\n\n#### C2\n\n`C2` *extends* `ExpressionLike`\n\n#### V2\n\n`V2` *extends* `CaseWhenValue`\n\n#### D\n\n`D` *extends* `CaseWhenValue`\n\n### Parameters\n\n#### condition1\n\n`C1`\n\n#### value1\n\n`V1`\n\n#### condition2\n\n`C2`\n\n#### value2\n\n`V2`\n\n#### defaultValue\n\n`D`\n\n### Returns\n\n`CaseWhenResult`\\<\\[`V1`, `V2`, `D`\\], `true`\\>\n\n### Examples\n\n```ts\ncaseWhen(gt(user.age, 18), `adult`, `minor`)\n```\n\n```ts\ncaseWhen(\n  gt(user.age, 65),\n  `senior`,\n  gt(user.age, 18),\n  `adult`,\n  `minor`,\n)\n```\n\n```ts\ncaseWhen(gt(user.age, 18), {\n  ...user,\n  posts: q\n    .from({ post: postsCollection })\n    .where(({ post }) => eq(post.userId, user.id)),\n})\n```\n\n## Call Signature\n\n```ts\nfunction caseWhen<C1, V1, C2, V2, C3, V3>(\n   condition1, \n   value1, \n   condition2, \n   value2, \n   condition3,