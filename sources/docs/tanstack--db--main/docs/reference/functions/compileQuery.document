ype":"text","value":"optimizableOrderByCollections"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"OrderByOptimizationInfo"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Map of source IDs to order-by optimization info"}]},{"type":"heading","depth":3,"id":"setwindowfn","children":[{"type":"text","value":"setWindowFn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"windowFn"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"cache","children":[{"type":"text","value":"cache"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"QueryCache"},{"type":"text","value":" = "},{"type":"inlineCode","value":"..."}]},{"type":"paragraph","children":[{"type":"text","value":"Optional cache for compiled subqueries (used internally for recursion)"}]},{"type":"heading","depth":3,"id":"querymapping","children":[{"type":"text","value":"queryMapping"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"QueryMapping"},{"type":"text","value":" = "},{"type":"inlineCode","value":"..."}]},{"type":"paragraph","children":[{"type":"text","value":"Optional lineage from optimized queries to user-defined queries"}]},{"type":"heading","depth":3,"id":"parentkeystream","children":[{"type":"text","value":"parentKeyStream?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/KeyedStream.md","children":[{"type":"inlineCode","value":"KeyedStream"}]}]},{"type":"heading","depth":3,"id":"childcorrelationfield","children":[{"type":"text","value":"childCorrelationField?"}]},{"type":"paragraph","children":[{"type":"link","href":"../@tanstack/namespaces/IR/classes/PropRef.md","children":[{"type":"inlineCode","value":"PropRef"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"CompilationResult"}]},{"type":"paragraph","children":[{"type":"text","value":"A CompilationResult with the pipeline, source WHERE clauses, and alias metadata"}]}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"rawquery","text":"rawQuery","level":3},{"id":"inputs","text":"inputs","level":3},{"id":"collections","text":"collections","level":3},{"id":"subscriptions","text":"subscriptions","level":3},{"id":"callbacks","text":"callbacks","level":3},{"id":"lazysources","text":"lazySources","level":3},{"id":"optimizableorderbycollections","text":"optimizableOrderByCollections","level":3},{"id":"setwindowfn","text":"setWindowFn","level":3},{"id":"cache","text":"cache","level":3},{"id":"querymapping","text":"queryMapping","level":3},{"id":"parentkeystream","text":"parentKeyStream?","level":3},{"id":"childcorrelationfield","text":"childCorrelationField?","level":3},{"id":"returns","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction compileQuery(\n   rawQuery, \n   inputs, \n   collections, \n   subscriptions, \n   callbacks, \n   lazySources, \n   optimizableOrderByCollections, \n   setWindowFn, \n   cache, \n   queryMapping, \n   parentKeyStream?, \n   childCorrelationField?): CompilationResult;\n```\n\nDefined in: [packages/db/src/query/compiler/index.ts:368](https://github.com/TanStack/db/blob/main/packages/db/src/query/compiler/index.ts#L368)\n\nCompiles a query IR into a D2 pipeline\n\n## Parameters\n\n### rawQuery\n\n[`QueryIR`](../@tanstack/namespaces/IR/interfaces/QueryIR.md)\n\nThe query IR to compile\n\n### inputs\n\n`Record`\\<`string`, [`KeyedStream`](../type-aliases/KeyedStream.md)\\>\n\nMapping of source aliases to input streams (e.g., `{ employee: input1, manager: input2 }`)\n\n### collections\n\n`Record`\\<`string`, [`Collection`](../interfaces/Collection.md)\\<`any`, `any`, `any`, `any`, `any`\\>\\>\n\nMapping of collection IDs to Collection instances\n\n### subscriptions\n\n`Record`\\<`string`, `CollectionSubscription`\\>\n\nMapping of source aliases to CollectionSubscription instances\n\n### callbacks\n\n`Record`\\<`string`, `LazyCollectionCallbacks`\\>\n\nMapping of source aliases to lazy loading callbacks\n\n### lazySources\n\n`Set`\\<`string`\\>\n\nSet of source identities that should load data lazily\n\n### optimizableOrderByCollections\n\n`Record`\\<`string`, `OrderByOptimizationInfo`\\>\n\nMap of source IDs to order-by optimization info\n\n### setWindowFn\n\n(`windowFn`) => `void`\n\n### cache\n\n`QueryCache` = `...`\n\nOptional cache for compiled subqueries (used internally for recursion)\n\n### queryMapping\n\n`QueryMapping` = `...`\n\nOptional lineage from optimized queries to user-defined queries\n\n### parentKeyStream?\n\n[`KeyedStream`](../type-aliases/KeyedStream.md)\n\n### childCorrelationField?\n\n[`PropRef`](../@tanstack/namespaces/IR/classes/PropRef.md)\\<`any`\\>\n\n## Returns\n\n`CompilationResult`\n\nA CompilationResult with the pipeline, source WHERE clauses, and alias metadata\n","originalRawMarkdown":"---\nid: compileQuery\ntitle: compileQuery\n---\n\n```ts\nfunction compileQuery(\n   rawQuery, \n   inputs, \n   collections, \n   subscriptions, \n   callbacks, \n   lazySources, \n   optimizableOrderByCollections, \n   setWindowFn, \n   cache, \n   queryMapping, \n   parentKeyStream?, \n   childCorrelationField?): CompilationResult;\n```\n\nDefined in: [packages/db/src/query/compiler/index.ts:368](https://github.com/TanStack/db/blob/main/packages/db/src/query/compiler/index.ts#L368)\n\nCompiles a query IR into a D2 pipeline\n\n## Parameters\n\n### rawQuery\n\n[`QueryIR`](../@tanstack/namespaces/IR/interfaces/QueryIR.md)\n\nThe query IR to compile\n\n### inputs\n\n`Record`\\<`string`, [`KeyedStream`](../type-aliases/KeyedStream.md)\\>\n\nMapping of source aliases to input streams (e.g., `{ employee: input1, manager: input2 }`)\n\n### collections\n\n`Record`\\<`string`, [`Collection`](../interfaces/Collection.md)\\<`any`, `any`, `any`, `any`, `any`\\>\\>\n\nMapping of collection IDs to Collection instances\n\n### subscriptions\n\n`Record`\\<`string`, `CollectionSubscription`\\>\n\nMapping of source aliases to CollectionSubscription instances\n\n### callbacks\n\n`Record`\\<`string`, `LazyCollectionCallbacks`\\>\n\nMapping of source aliases to lazy loading callbacks\n\n### lazySources\n\n`Set`\\<`string`\\>\n\nSet of source identities that should load data lazily\n\n### optimizableOrderByCollections\n\n`Record`\\<`string`, `OrderByOptimizationInfo`\\>\n\nMap of source IDs to order-by optimization info\n\n### setWindowFn\n\n(`windowFn`) => `void`\n\n### cache\n\n`QueryCache` = `...`\n\nOptional cache for compiled subqueries (used internally for recursion)\n\n### queryMapping\n\n`QueryMapping` = `...`\n\nOptional lineage from optimized queries to user-defined queries\n\n### parentKeyStream?\n\n[`KeyedStream`](../type-aliases/KeyedStream.md)\n\n### childCorrelationField?\n\n[`PropRef`](../@tanstack/namespaces/IR/classes/PropRef.md)\\<`any`\\>\n\n## Returns\n\n`CompilationResult`\n\nA CompilationResult with the pipeline, source WHERE clauses, and alias metadata\n"}
