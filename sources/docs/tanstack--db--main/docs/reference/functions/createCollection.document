on({\n  schema: todoSchema,\n  getKey: (todo) => todo.id,\n  sync: { sync: () => {} }\n})","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"t","text":"T","level":4},{"id":"tkey","text":"TKey","level":4},{"id":"tutils","text":"TUtils","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"returns","text":"Returns","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"t-2","text":"T","level":4},{"id":"tkey-2","text":"TKey","level":4},{"id":"tutils-2","text":"TUtils","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"examples-2","text":"Examples","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"t-3","text":"T","level":4},{"id":"tkey-3","text":"TKey","level":4},{"id":"tutils-3","text":"TUtils","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"options-3","text":"options","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"examples-3","text":"Examples","level":3},{"id":"call-signature-4","text":"Call Signature","level":2},{"id":"type-parameters-4","text":"Type Parameters","level":3},{"id":"t-4","text":"T","level":4},{"id":"tkey-4","text":"TKey","level":4},{"id":"tutils-4","text":"TUtils","level":4},{"id":"parameters-4","text":"Parameters","level":3},{"id":"options-4","text":"options","level":4},{"id":"returns-4","text":"Returns","level":3},{"id":"examples-4","text":"Examples","level":3},{"id":"call-signature-5","text":"Call Signature","level":2},{"id":"type-parameters-5","text":"Type Parameters","level":3},{"id":"t-5","text":"T","level":4},{"id":"tkey-5","text":"TKey","level":4},{"id":"tutils-5","text":"TUtils","level":4},{"id":"parameters-5","text":"Parameters","level":3},{"id":"options-5","text":"options","level":4},{"id":"returns-5","text":"Returns","level":3},{"id":"examples-5","text":"Examples","level":3},{"id":"call-signature-6","text":"Call Signature","level":2},{"id":"type-parameters-6","text":"Type Parameters","level":3},{"id":"t-6","text":"T","level":4},{"id":"tkey-6","text":"TKey","level":4},{"id":"tutils-6","text":"TUtils","level":4},{"id":"parameters-6","text":"Parameters","level":3},{"id":"options-6","text":"options","level":4},{"id":"returns-6","text":"Returns","level":3},{"id":"examples-6","text":"Examples","level":3},{"id":"call-signature-7","text":"Call Signature","level":2},{"id":"type-parameters-7","text":"Type Parameters","level":3},{"id":"t-7","text":"T","level":4},{"id":"tkey-7","text":"TKey","level":4},{"id":"tutils-7","text":"TUtils","level":4},{"id":"parameters-7","text":"Parameters","level":3},{"id":"options-7","text":"options","level":4},{"id":"returns-7","text":"Returns","level":3},{"id":"examples-7","text":"Examples","level":3},{"id":"call-signature-8","text":"Call Signature","level":2},{"id":"type-parameters-8","text":"Type Parameters","level":3},{"id":"t-8","text":"T","level":4},{"id":"tkey-8","text":"TKey","level":4},{"id":"tutils-8","text":"TUtils","level":4},{"id":"parameters-8","text":"Parameters","level":3},{"id":"options-8","text":"options","level":4},{"id":"returns-8","text":"Returns","level":3},{"id":"examples-8","text":"Examples","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction createCollection<T, TKey, TUtils>(options): Collection<InferSchemaOutput<T>, TKey, TUtils, T, InferSchemaInput<T>> & NonSingleResult;\n```\n\nDefined in: [packages/db/src/collection/index.ts:232](https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts#L232)\n\nCreates a new Collection instance with the given configuration\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `StandardSchemaV1`\\<`unknown`, `unknown`\\>\n\nThe schema type if a schema is provided, otherwise the type of items in the collection\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number`\n\nThe type of the key for the collection\n\n#### TUtils\n\n`TUtils` *extends* [`UtilsRecord`](../type-aliases/UtilsRecord.md)\n\nThe utilities record type\n\n### Parameters\n\n#### options\n\n`Omit`\\<[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `T`, `TUtils`\\>, `\"utils\"`\\> & `object` & [`NonSingleResult`](../type-aliases/NonSingleResult.md)\n\nCollection options with optional utilities\n\n### Returns\n\n[`Collection`](../interfaces/Collection.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `TUtils`, `T`, [`InferSchemaInput`](../type-aliases/InferSchemaInput.md)\\<`T`\\>\\> & [`NonSingleResult`](../type-aliases/NonSingleResult.md)\n\nA new Collection with utilities exposed both at top level and under .utils\n\n### Examples\n\n```ts\n// Pattern 1: With operation handlers (direct collection calls)\nconst todos = createCollection({\n  id: \"todos\",\n  getKey: (todo) => todo.id,\n  schema,\n  onInsert: async ({ transaction, collection }) => {\n    // Send to API\n    await api.createTodo(transaction.mutations[0].modified)\n  },\n  onUpdate: async ({ transaction, collection }) => {\n    await api.updateTodo(transaction.mutations[0].modified)\n  },\n  onDelete: async ({ transaction, collection }) => {\n    await api.deleteTodo(transaction.mutations[0].key)\n  },\n  sync: { sync: () => {} }\n})\n\n// Direct usage (handlers manage transactions)\nconst tx = todos.insert({ id: \"1\", text: \"Buy milk\", completed: false })\nawait tx.when('settled')\n```\n\n```ts\n// Pattern 2: Manual transaction management\nconst todos = createCollection({\n  getKey: (todo) => todo.id,\n  schema: todoSchema,\n  sync: { sync: () => {} }\n})\n\n// Explicit transaction usage\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Handle all mutations in transaction\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  todos.insert({ id: \"1\", text: \"Buy milk\" })\n  todos.update(\"2\", draft => { draft.completed = true })\n})\n\nawait tx.when('settled')\n```\n\n```ts\n// Using schema for type inference (preferred as it also gives you client side validation)\nconst todoSchema = z.object({\n  id: z.string(),\n  title: z.string(),\n  completed: z.boolean()\n})\n\nconst todos = createCollection({\n  schema: todoSchema,\n  getKey: (todo) => todo.id,\n  sync: { sync: () => {} }\n})\n```\n\n## Call Signature\n\n```ts\nfunction createCollection<T, TKey, TUtils>(options): Collection<InferSchemaOutput<T>, TKey, Exclude<TUtils, undefined>, T, InferSchemaInput<T>> & NonSingleResult;\n```\n\nDefined in: [packages/db/src/collection/index.ts:249](https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts#L249)\n\nCreates a new Collection instance with the given configuration\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `StandardSchemaV1`\\<`unknown`, `unknown`\\>\n\nThe schema type if a schema is provided, otherwise the type of items in the collection\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number`\n\nThe type of the key for the collection\n\n#### TUtils\n\n`TUtils` *extends* [`UtilsRecord`](../type-aliases/UtilsRecord.md)\n\nThe utilities record type\n\n### Parameters\n\n#### options\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `T`, `TUtils`\\> & `object` & [`NonSingleResult`](../type-aliases/NonSingleResult.md)\n\nCollection options with optional utilities\n\n### Returns\n\n[`Collection`](../interfaces/Collection.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `Exclude`\\<`TUtils`, `undefined`\\>, `T`, [`InferSchemaInput`](../type-aliases/InferSchemaInput.md)\\<`T`\\>\\> & [`NonSingleResult`](../type-aliases/NonSingleResult.md)\n\nA new Collection with utilities exposed both at top level and under .utils\n\n### Examples\n\n```ts\n// Pattern 1: With operation handlers (direct collection calls)\nconst todos = createCollection({\n  id: \"todos\",\n  getKey: (todo) => todo.id,\n  schema,\n  onInsert: async ({ transaction, collection }) => {\n    // Send to API\n    await api.createTodo(transaction.mutations[0].modified)\n  },\n  onUpdate: async ({ transaction, collection }) => {\n    await api.updateTodo(transaction.mutations[0].modified)\n  },\n  onDelete: async ({ transaction, collection }) => {\n    await api.deleteTodo(transaction.mutations[0].key)\n  },\n  sync: { sync: () => {} }\n})\n\n// Direct usage (handlers manage transactions)\nconst tx = todos.insert({ id: \"1\", text: \"Buy milk\", completed: false })\nawait tx.when('settled')\n```\n\n```ts\n// Pattern 2: Manual transaction management\nconst todos = createCollection({\n  getKey: (todo) => todo.id,\n  schema: todoSchema,\n  sync: { sync: () => {} }\n})\n\n// Explicit transaction usage\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Handle all mutations in transaction\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  todos.insert({ id: \"1\", text: \"Buy milk\" })\n  todos.update(\"2\", draft => { draft.completed = true })\n})\n\nawait tx.when('settled')\n```\n\n```ts\n// Using schema for type inference (preferred as it also gives you client side validation)\nconst todoSchema = z.object({\n  id: z.string(),\n  title: z.string(),\n  completed: z.boolean()\n})\n\nconst todos = createCollection({\n  schema: todoSchema,\n  getKey: (todo) => todo.id,\n  sync: { sync: () => {} }\n})\n```\n\n## Call Signature\n\n```ts\nfunction createCollection<T, TKey, TUtils>(options): Collection<InferSchemaOutput<T>, TKey, TUtils, T, InferSchemaInput<T>> & SingleResult;\n```\n\nDefined in: [packages/db/src/collection/index.ts:267](https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts#L267)\n\nCreates a new Collection instance with the given configuration\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `StandardSchemaV1`\\<`unknown`, `unknown`\\>\n\nThe schema type if a schema is provided, otherwise the type of items in the collection\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number`\n\nThe type of the key for the collection\n\n#### TUtils\n\n`TUtils` *extends* [`UtilsRecord`](../type-aliases/UtilsRecord.md)\n\nThe utilities record type\n\n### Parameters\n\n#### options\n\n`Omit`\\<[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `T`, `TUtils`\\>, `\"utils\"`\\> & `object` & [`SingleResult`](../type-aliases/SingleResult.md)\n\nCollection options with optional utilities\n\n### Returns\n\n[`Collection`](../interfaces/Collection.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `TUtils`, `T`, [`InferSchemaInput`](../type-aliases/InferSchemaInput.md)\\<`T`\\>\\> & [`SingleResult`](../type-aliases/SingleResult.md)\n\nA new Collection with utilities exposed both at top level and under .utils\n\n### Examples\n\n```ts\n// Pattern 1: With operation handlers (direct collection calls)\nconst todos = createCollection({\n  id: \"todos\",\n  getKey: (todo) => todo.id,\n  schema,\n  onInsert: async ({ transaction, collection }) => {\n    // Send to API\n    await api.createTodo(transaction.mutations[0].modified)\n  },\n  onUpdate: async ({ transaction, collection }) => {\n    await api.updateTodo(transaction.mutations[0].modified)\n  },\n  onDelete: async ({ transaction, collection }) => {\n    await api.deleteTodo(transaction.mutations[0].key)\n  },\n  sync: { sync: () => {} }\n})\n\n// Direct usage (handlers manage transactions)\nconst tx = todos.insert({ id: \"1\", text: \"Buy milk\", completed: false })\nawait tx.when('settled')\n```\n\n```ts\n// Pattern 2: Manual transaction management\nconst todos = createCollection({\n  getKey: (todo) => todo.id,\n  schema: todoSchema,\n  sync: { sync: () => {} }\n})\n\n// Explicit transaction usage\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Handle all mutations in transaction\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  todos.insert({ id: \"1\", text: \"Buy milk\" })\n  todos.update(\"2\", draft => { draft.completed = true })\n})\n\nawait tx.when('settled')\n```\n\n```ts\n// Using schema for type inference (preferred as it also gives you client side validation)\nconst todoSchema = z.object({\n  id: z.string(),\n  title: z.string(),\n  completed: z.boolean()\n})\n\nconst todos = createCollection({\n  schema: todoSchema,\n  getKey: (todo) => todo.id,\n  sync: { sync: () => {} }\n})\n```\n\n## Call Signature\n\n```ts\nfunction createCollection<T, TKey, TUtils>(options): Collection<InferSchemaOutput<T>, TKey, TUtils, T, InferSchemaInput<T>> & SingleResult;\n```\n\nDefined in: [packages/db/src/collection/index.ts:283](https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts#L283)\n\nCreates a new Collection instance with the given configuration\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `StandardSchemaV1`\\<`unknown`, `unknown`\\>\n\nThe schema type if a schema is provided, otherwise the type of items in the collection\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number`\n\nThe type of the key for the collection\n\n#### TUtils\n\n`TUtils` *extends* [`UtilsRecord`](../type-aliases/UtilsRecord.md)\n\nThe utilities record type\n\n### Parameters\n\n#### options\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `T`, `TUtils`\\> & `object` & [`SingleResult`](../type-aliases/SingleResult.md)\n\nCollection options with optional utilities\n\n### Returns\n\n[`Collection`](../interfaces/Collection.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `TUtils`, `T`, [`InferSchemaInput`](../type-aliases/InferSchemaInput.md)\\<`T`\\>\\> & [`SingleResult`](../type-aliases/SingleResult.md)\n\nA new Collection with utilities exposed both at top level and under .utils\n\n### Examples\n\n```ts\n// Pattern 1: With operation handlers (direct collection calls)\nconst todos = createCollection({\n  id: \"todos\",\n  getKey: (todo) => todo.id,\n  schema,\n  onInsert: async ({ transaction, collection }) => {\n    // Send to API\n    await api.createTodo(transaction.mutations[0].modified)\n  },\n  onUpdate: async ({ transaction, collection }) => {\n    await api.updateTodo(transaction.mutations[0].modified)\n  },\n  onDelete: async ({ transaction, collection }) => {\n    await api.deleteTodo(transaction.mutations[0].key)\n  },\n  sync: { sync: () => {} }\n})\n\n// Direct usage (handlers manage transactions)\nconst tx = todos.insert({ id: \"1\", text: \"Buy milk\", completed: false })\nawait tx.when('settled')\n```\n\n```ts\n// Pattern 2: Manual transaction management\nconst todos = createCollection({\n  getKey: (todo) => todo.id,\n  schema: todoSchema,\n  sync: { sync: () => {} }\n})\n\n// Explicit transaction usage\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Handle all mutations in transaction\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  todos.insert({ id: \"1\", text: \"Buy milk\" })\n  todos.update(\"2\", draft => { draft.completed = true })\n})\n\nawait tx.when('settled')\n```\n\n```ts\n// Using schema for type inference (preferred as it also gives you client side validation)\nconst todoSchema = z.object({\n  id: z.string(),\n  title: z.string(),\n  completed: z.boolean()\n})\n\nconst todos = createCollection({\n  schema: todoSchema,\n  getKey: (todo) => todo.id,\n  sync: { sync: () => {} }\n})\n```\n\n#