transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  todos.insert({ id: \"1\", text: \"Buy milk\" })\n  todos.update(\"2\", draft => { draft.completed = true })\n})\n\nawait tx.when('settled')","lang":"ts"},{"type":"code","value":"// Using schema for type inference (preferred as it also gives you client side validation)\nconst todoSchema = z.object({\n  id: z.string(),\n  title: z.string(),\n  completed: z.boolean()\n})\n\nconst todos = createCollection({\n  schema: todoSchema,\n  getKey: (todo) => todo.id,\n  sync: { sync: () => {} }\n})","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function createCollection<T, TKey, TUtils>(options): Collection<InferSchemaOutput<T>, TKey, Exclude<TUtils, undefined>, T, InferSchemaInput<T>> & NonSingleResult;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts#L249","children":[{"type":"text","value":"packages/db/src/collection/index.ts:249"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a new Collection instance with the given configuration"}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"t-2","children":[{"type":"text","value":"T"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The schema type if a schema is provided, otherwise the type of items in the collection"}]},{"type