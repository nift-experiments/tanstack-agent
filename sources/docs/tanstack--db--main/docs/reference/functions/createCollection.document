nc: { sync: () => {} }\n})","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-5","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function createCollection<T, TKey, TUtils>(options): Collection<T, TKey, TUtils, never, T> & NonSingleResult;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts#L296","children":[{"type":"text","value":"packages/db/src/collection/index.ts:296"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a new Collection instance with the given configuration"}]},{"type":"heading","depth":3,"id":"type-parameters-5","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"t-5","children":[{"type":"text","value":"T"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"The schema type if a schema is provided, otherwise the type of items in the collection"}]},{"type":"heading","depth":4,"id":"tkey-5","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"The type of the key for the collection"}]},{"type":"heading","depth":4,"id":"tutils-5","children":[{"type":"text","value":"TUtils"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TUtils"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"t