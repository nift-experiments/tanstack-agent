{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A new Transaction instance"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic transaction usage\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Send all mutations to API\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n  collection.update(\"2\", draft => { draft.completed = true })\n})\n\nawait tx.when('settled')","lang":"ts"},{"type":"code","value":"// Handle transaction errors\ntry {\n  const tx = createTransaction({\n    mutationFn: async () => { throw new Error(\"API failed\") }\n  })\n\n  tx.mutate(() => {\n    collection.insert({ id: \"1\", text: \"New item\" })\n  })\n\n  await tx.when('settled')\n} catch (error) {\n  console.log('Transaction failed:', error)\n}","lang":"ts"},{"type":"code","value":"// Manual commit control\nconst tx = createTransaction({\n  autoCommit: false,\n  mutationFn: async () => {\n    // API call\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Item\" })\n})\n\n// Commit later\nawait tx.commit()","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"config","text":"config","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createTransaction<T>(config): Transaction<T>;\n```\n\nDefined in: [packages/db/src/transactions.ts:316](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L316)\n\nCreates a new transaction for grouping multiple collection operations\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n## Parameters\n\n### config\n\n[`TransactionConfig`](../interfaces/TransactionConfig.md)\\<`T`\\>\n\nTransaction configuration with mutation function\n\n## Returns\n\n[`Transaction`](../interfaces/Transaction.md)\\<`T`\\>\n\nA new Transaction instance\n\n## Examples\n\n```ts\n// Basic transaction usage\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Send all mutations to API\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n  collection.update(\"2\", draft => { draft.completed = true })\n})\n\nawait tx.when('settled')\n```\n\n```ts\n// Handle transaction errors\ntry {\n  const tx = createTransaction({\n    mutationFn: async () => { throw new Error(\"API failed\") }\n  })\n\n  tx.mutate(() => {\n    collection.insert({ id: \"1\", text: \"New item\" })\n  })\n\n  await tx.when('settled')\n} catch (error) {\n  console.log('Transaction failed:', error)\n}\n```\n\n```ts\n// Manual commit control\nconst tx = createTransaction({\n  autoCommit: false,\n  mutationFn: async () => {\n    // API call\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Item\" })\n})\n\n// Commit later\nawait tx.commit()\n```\n","originalRawMarkdown":"---\nid: createTransaction\ntitle: createTransaction\n---\n\n```ts\nfunction createTransaction<T>(config): Transaction<T>;\n```\n\nDefined in: [packages/db/src/transactions.ts:316](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L316)\n\nCreates a new transaction for grouping multiple collection operations\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n## Parameters\n\n### config\n\n[`TransactionConfig`](../interfaces/TransactionConfig.md)\\<`T`\\>\n\nTransaction configuration with mutation function\n\n## Returns\n\n[`Transaction`](../interfaces/Transaction.md)\\<`T`\\>\n\nA new Transaction instance\n\n## Examples\n\n```ts\n// Basic transaction usage\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Send all mutations to API\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n  collection.update(\"2\", draft => { draft.completed = true })\n})\n\nawait tx.when('settled')\n```\n\n```ts\n// Handle transaction errors\ntry {\n  const tx = createTransaction({\n    mutationFn: async () => { throw new Error(\"API failed\") }\n  })\n\n  tx.mutate(() => {\n    collection.insert({ id: \"1\", text: \"New item\" })\n  })\n\n  await tx.when('settled')\n} catch (error) {\n  console.log('Transaction failed:', error)\n}\n```\n\n```ts\n// Manual commit control\nconst tx = createTransaction({\n  autoCommit: false,\n  mutationFn: async () => {\n    // API call\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Item\" })\n})\n\n// Commit later\nawait tx.commit()\n```\n"}
