{"document":{"type":"root","children":[{"type":"code","value":"function hasVirtualProps(value): value is VirtualRowProps<string | number>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/virtual-props.ts#L194","children":[{"type":"text","value":"packages/db/src/virtual-props.ts:194"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Checks if a value has virtual properties attached. Legacy rows with the\noriginal four properties still match; only rows published by this version\nare guaranteed to carry "},{"type":"inlineCode","value":"$hasPendingWrites"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"unknown"}]},{"type":"paragraph","children":[{"type":"text","value":"The value to check"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"value is VirtualRowProps<string | number>"}]},{"type":"paragraph","children":[{"type":"text","value":"true if the value has virtual properties"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"if (hasVirtualProps(row) && row.$hasPendingWrites !== undefined) {\n  console.log('Pending local writes:', row.$hasPendingWrites)\n}","lang":"typescript"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"value","text":"value","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction hasVirtualProps(value): value is VirtualRowProps<string | number>;\n```\n\nDefined in: [packages/db/src/virtual-props.ts:194](https://github.com/TanStack/db/blob/main/packages/db/src/virtual-props.ts#L194)\n\nChecks if a value has virtual properties attached. Legacy rows with the\noriginal four properties still match; only rows published by this version\nare guaranteed to carry `$hasPendingWrites`.\n\n## Parameters\n\n### value\n\n`unknown`\n\nThe value to check\n\n## Returns\n\nvalue is VirtualRowProps\\<string \\| number\\>\n\ntrue if the value has virtual properties\n\n## Example\n\n```typescript\nif (hasVirtualProps(row) && row.$hasPendingWrites !== undefined) {\n  console.log('Pending local writes:', row.$hasPendingWrites)\n}\n```\n","originalRawMarkdown":"---\nid: hasVirtualProps\ntitle: hasVirtualProps\n---\n\n```ts\nfunction hasVirtualProps(value): value is VirtualRowProps<string | number>;\n```\n\nDefined in: [packages/db/src/virtual-props.ts:194](https://github.com/TanStack/db/blob/main/packages/db/src/virtual-props.ts#L194)\n\nChecks if a value has virtual properties attached. Legacy rows with the\noriginal four properties still match; only rows published by this version\nare guaranteed to carry `$hasPendingWrites`.\n\n## Parameters\n\n### value\n\n`unknown`\n\nThe value to check\n\n## Returns\n\nvalue is VirtualRowProps\\<string \\| number\\>\n\ntrue if the value has virtual properties\n\n## Example\n\n```typescript\nif (hasVirtualProps(row) && row.$hasPendingWrites !== undefined) {\n  console.log('Pending local writes:', row.$hasPendingWrites)\n}\n```\n"}
