value":"TResult"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"},{"type":"text","value":" = "},{"type":"inlineCode","value":"RootQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"config","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/LiveQueryCollectionConfig.md","children":[{"type":"inlineCode","value":"LiveQueryCollectionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":", "},{"type":"inlineCode","value":"TResult"},{"type":"text","value":"> & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration options for the live query collection"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"CollectionConfigForContext"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TContext"},{"type":"text","value":", "},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", {\n}> & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Collection options that can be passed to createCollection"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const options = liveQueryCollectionOptions({\n  // id is optional - will auto-generate if not provided\n  query: (q) => q\n    .from({ post: postsCollection })\n    .where(({ post }) => eq(post.published, true))\n    .select(({ post }) => ({\n      id: post.id,\n      title: post.title,\n      content: post.content,\n    })),\n  // getKey is optional - will use stream key if not provided\n})\n\nconst collection = createCollection(options)","lang":"typescript"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tquery","text":"TQuery","level":3},{"id":"tcontext","text":"TContext","level":3},{"id":"tresult","text":"TResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"config","text":"config","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction liveQueryCollectionOptions<TQuery, TContext, TResult>(config): CollectionConfigForContext<TContext, TResult, {\n}> & object;\n```\n\nDefined in: [packages/db/src/query/live-query-collection.ts:72](https://github.com/TanStack/db/blob/main/packages/db/src/query/live-query-collection.ts#L72)\n\nCreates live query collection options for use with createCollection\n\n## Type Parameters\n\n### TQuery\n\n`TQuery` *extends* [`QueryBuilder`](../type-aliases/QueryBuilder.md)\\<`any`\\>\n\n### TContext\n\n`TContext` *extends* [`Context`](../interfaces/Context.md) = [`ExtractContext`](../type-aliases/ExtractContext.md)\\<`TQuery`\\>\n\n### TResult\n\n`TResult` *extends* `object` = `RootQueryResult`\\<`TContext`\\>\n\n## Parameters\n\n### config\n\n[`LiveQueryCollectionConfig`](../interfaces/LiveQueryCollectionConfig.md)\\<`TContext`, `TResult`\\> & `object`\n\nConfiguration options for the live query collection\n\n## Returns\n\n`CollectionConfigForContext`\\<`TContext`, `TResult`, \\{\n\\}\\> & `object`\n\nCollection options that can be passed to createCollection\n\n## Example\n\n```typescript\nconst options = liveQueryCollectionOptions({\n  // id is optional - will auto-generate if not provided\n  query: (q) => q\n    .from({ post: postsCollection })\n    .where(({ post }) => eq(post.published, true))\n    .select(({ post }) => ({\n      id: post.id,\n      title: post.title,\n      content: post.content,\n    })),\n  // getKey is optional - will use stream key if not provided\n})\n\nconst collection = createCollection(options)\n```\n","originalRawMarkdown":"---\nid: liveQueryCollectionOptions\ntitle: liveQueryCollectionOptions\n---\n\n```ts\nfunction liveQueryCollectionOptions<TQuery, TContext, TResult>(config): CollectionConfigForContext<TContext, TResult, {\n}> & object;\n```\n\nDefined in: [packages/db/src/query/live-query-collection.ts:72](https://github.com/TanStack/db/blob/main/packages/db/src/query/live-query-collection.ts#L72)\n\nCreates live query collection options for use with createCollection\n\n## Type Parameters\n\n### TQuery\n\n`TQuery` *extends* [`QueryBuilder`](../type-aliases/QueryBuilder.md)\\<`any`\\>\n\n### TContext\n\n`TContext` *extends* [`Context`](../interfaces/Context.md) = [`ExtractContext`](../type-aliases/ExtractContext.md)\\<`TQuery`\\>\n\n### TResult\n\n`TResult` *extends* `object` = `RootQueryResult`\\<`TContext`\\>\n\n## Parameters\n\n### config\n\n[`LiveQueryCollectionConfig`](../interfaces/LiveQueryCollectionConfig.md)\\<`TContext`, `TResult`\\> & `object`\n\nConfiguration options for the live query collection\n\n## Returns\n\n`CollectionConfigForContext`\\<`TContext`, `TResult`, \\{\n\\}\\> & `object`\n\nCollection options that can be passed to createCollection\n\n## Example\n\n```typescript\nconst options = liveQueryCollectionOptions({\n  // id is optional - will auto-generate if not provided\n  query: (q) => q\n    .from({ post: postsCollection })\n    .where(({ post }) => eq(post.published, true))\n    .select(({ post }) => ({\n      id: post.id,\n      title: post.title,\n      content: post.content,\n    })),\n  // getKey is optional - will use stream key if not provided\n})\n\nconst collection = createCollection(options)\n```\n"}
