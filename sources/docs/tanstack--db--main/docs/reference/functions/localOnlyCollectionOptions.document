"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/CollectionConfig.md","children":[{"type":"inlineCode","value":"CollectionConfig"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/InferSchemaOutput.md","children":[{"type":"inlineCode","value":"InferSchemaOutput"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"link","href":"../interfaces/LocalOnlyCollectionUtils.md","children":[{"type":"inlineCode","value":"LocalOnlyCollectionUtils"}]},{"type":"text","value":"> & "},{"type":"inlineCode","value":"object"},{"type":"text","value":" & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Collection options with utilities including acceptMutations"}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic local-only collection\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)","lang":"ts"},{"type":"code","value":"// Local-only collection with initial data\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    initialData: [\n      { id: 1, name: 'Item 1' },\n      { id: 2, name: 'Item 2' },\n    ],\n  })\n)","lang":"ts"},{"type":"code","value":"// Local-only collection with mutation handlers\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n      // Custom logic after insert\n    },\n  })\n)","lang":"ts"},{"type":"code","value":"// Using with manual transactions\nconst localData = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use local data in API call\n    const localMutations = transaction.mutations.filter(m => m.collection === localData)\n    await api.save({ metadata: localMutations[0]?.modified })\n\n    // Persist local-only mutations after API success\n    localData.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localData.insert({ id: 1, data: 'metadata' })\n  apiCollection.insert({ id: 2, data: 'main data' })\n})\n\nawait tx.commit()","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function localOnlyCollectionOptions<T, TKey>(config): CollectionConfig<T, TKey, never, LocalOnlyCollectionUtils> & object & object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/local-only.ts#L164","children":[{"type":"text","value":"packages/db/src/local-only.ts:164"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates Local-only collection options for use with a standard Collection"}]},{"type":"paragraph","children":[{"type":"text","value":"This is an in-memory collection that doesn't sync with external sources but uses a loopback sync config\nthat immediately \"syncs\" all optimistic changes to the collection, making them permanent.\nPerfect for local-only data that doesn't need persistence or external synchronization."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Using with Manual Transactions:"}]}]},{"type":"paragraph","children":[{"type":"text","value":"For manual transactions, you must call "},{"type":"inlineCode","value":"utils.acceptMutations()"},{"type":"text","value":" in your transaction's "},{"type":"inlineCode","value":"mutationFn"},{"type":"text","value":"\nto persist changes made during "},{"type":"inlineCode","value":"tx.mutate()"},{"type":"text","value":". This is necessary because local-only collections\ndon't participate in the standard mutation handler flow for manual transactions."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"t-2","children":[{"type":"text","value":"T"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"The schema type if a schema is provided, otherwise the type of items in the collection"}]},{"type":"heading","depth":4,"id":"tkey-2","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":" = "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"The type of the key returned by getKey"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"config-2","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/LocalOnlyCollectionConfig.md","children":[{"type":"inlineCode","value":"LocalOnlyCollectionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"never"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":"> & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration options for the Local-only collection"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/CollectionConfig.md","children":[{"type":"inlineCode","value":"CollectionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"never"},{"type":"text","value":", "},{"type":"link","href":"../interfaces/LocalOnlyCollectionUtils.md","children":[{"type":"inlineCode","value":"LocalOnlyCollectionUtils"}]},{"type":"text","value":"> & "},{"type":"inlineCode","value":"object"},{"type":"text","value":" & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Collection options with utilities including acceptMutations"}]},{"type":"heading","depth":3,"id":"examples-2","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic local-only collection\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)","lang":"ts"},{"type":"code","value":"// Local-only collection with initial data\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    initialData: [\n      { id: 1, name: 'Item 1' },\n      { id: 2, name: 'Item 2' },\n    ],\n  })\n)","lang":"ts"},{"type":"code","value":"// Local-only collection with mutation handlers\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n      // Custom logic after insert\n    },\n  })\n)","lang":"ts"},{"type":"code","value":"// Using with manual transactions\nconst localData = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use local data in API call\n    const localMutations = transaction.mutations.filter(m => m.collection === localData)\n    await api.save({ metadata: localMutations[0]?.modified })\n\n    // Persist local-only mutations after API success\n    localData.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localData.insert({ id: 1, data: 'metadata' })\n  apiCollection.insert({ id: 2, data: 'main data' })\n})\n\nawait tx.commit()","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"t","text":"T","level":4},{"id":"tkey","text":"TKey","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"config","text":"config","level":4},{"id":"returns","text":"Returns","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"t-2","text":"T","level":4},{"id":"tkey-2","text":"TKey","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"config-2","text":"config","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"examples-2","text":"Examples","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction localOnlyCollectionOptions<T, TKey>(config): CollectionConfig<InferSchemaOutput<T>, TKey, T, LocalOnlyCollectionUtils> & object & object;\n```\n\nDefined in: [packages/db/src/local-only.ts:151](https://github.com/TanStack/db/blob/main/packages/db/src/local-only.ts#L151)\n\nCreates Local-only collection options for use with a standard Collection\n\nThis is an in-memory collection that doesn't sync with external sources but uses a loopback sync config\nthat immediately \"syncs\" all optimistic changes to the collection, making them permanent.\nPerfect for local-only data that doesn't need persistence or external synchronization.\n\n**Using with Manual Transactions:**\n\nFor manual transactions, you must call `utils.acceptMutations()` in your transaction's `mutationFn`\nto persist changes made during `tx.mutate()`. This is necessary because local-only collections\ndon't participate in the standard mutation handler flow for manual transactions.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `StandardSchemaV1`\\<`unknown`, `unknown`\\>\n\nThe schema type if a schema is provided, otherwise the type of items in the collection\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\nThe type of the key returned by getKey\n\n### Parameters\n\n#### config\n\n[`LocalOnlyCollectionConfig`](../interfaces/LocalOnlyCollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `T`, `TKey`\\> & `object`\n\nConfiguration options for the Local-only collection\n\n### Returns\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `T`, [`LocalOnlyCollectionUtils`](../interfaces/LocalOnlyCollectionUtils.md)\\> & `object` & `object`\n\nCollection options with utilities including acceptMutations\n\n### Examples\n\n```ts\n// Basic local-only collection\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// Local-only collection with initial data\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    initialData: [\n      { id: 1, name: 'Item 1' },\n      { id: 2, name: 'Item 2' },\n    ],\n  })\n)\n```\n\n```ts\n// Local-only collection with mutation handlers\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n      // Custom logic after insert\n    },\n  })\n)\n```\n\n```ts\n// Using with manual transactions\nconst localData = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use local data in API call\n    const localMutations = transaction.mutations.filter(m => m.collection === localData)\n    await api.save({ metadata: localMutations[0]?.modified })\n\n    // Persist local-only mutations after API success\n    localData.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localData.insert({ id: 1, data: 'metadata' })\n  apiCollection.insert({ id: 2, data: 'main data' })\n})\n\nawait tx.commit()\n```\n\n## Call Signature\n\n```ts\nfunction localOnlyCollectionOptions<T, TKey>(config): CollectionConfig<T, TKey, never, LocalOnlyCollectionUtils> & object & object;\n```\n\nDefined in: [packages/db/src/local-only.ts:164](https://github.com/TanStack/db/blob/main/packages/db/src/local-only.ts#L164)\n\nCreates Local-only collection options for use with a standard Collection\n\nThis is an in-memory collection that doesn't sync with external sources but uses a loopback sync config\nthat immediately \"syncs\" all optimistic changes to the collection, making them permanent.\nPerfect for local-only data that doesn't need persistence or external synchronization.\n\n**Using with Manual Transactions:**\n\nFor manual transactions, you must call `utils.acceptMutations()` in your transaction's `mutationFn`\nto persist changes made during `tx.mutate()`. This is necessary because local-only collections\ndon't participate in the standard mutation handler flow for manual transactions.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `object`\n\nThe schema type if a schema is provided, otherwise the type of items in the collection\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\nThe type of the key returned by getKey\n\n### Parameters\n\n#### config\n\n[`LocalOnlyCollectionConfig`](../interfaces/LocalOnlyCollectionConfig.md)\\<`T`, `never`, `TKey`\\> & `object`\n\nConfiguration options for the Local-only collection\n\n### Returns\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<`T`, `TKey`, `never`, [`LocalOnlyCollectionUtils`](../interfaces/LocalOnlyCollectionUtils.md)\\> & `object` & `object`\n\nCollection options with utilities including acceptMutations\n\n### Examples\n\n```ts\n// Basic local-only collection\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// Local-only collection with initial data\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    initialData: [\n      { id: 1, name: 'Item 1' },\n      { id: 2, name: 'Item 2' },\n    ],\n  })\n)\n```\n\n```ts\n// Local-only collection with mutation handlers\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n      // Custom logic after insert\n    },\n  })\n)\n```\n\n```ts\n// Using with manual transactions\nconst localData = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use local data in API call\n    const localMutations = transaction.mutations.filter(m => m.collection === localData)\n    await api.save({ metadata: localMutations[0]?.modified })\n\n    // Persist local-only mutations after API success\n    localData.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localData.insert({ id: 1, data: 'metadata' })\n  apiCollection.insert({ id: 2, data: 'main data' })\n})\n\nawait tx.commit()\n```\n","originalRawMarkdown":"---\nid: localOnlyCollectionOptions\ntitle: localOnlyCollectionOptions\n---\n\n## Call Signature\n\n```ts\nfunction localOnlyCollectionOptions<T, TKey>(config): CollectionConfig<InferSchemaOutput<T>, TKey, T, LocalOnlyCollectionUtils> & object & object;\n```\n\nDefined in: [packages/db/src/local-only.ts:151](https://github.com/TanStack/db/blob/main/packages/db/src/local-only.ts#L151)\n\nCreates Local-only collection options for use with a standard Collection\n\nThis is an in-memory collection that doesn't sync with external sources but uses a loopback sync config\nthat immediately \"syncs\" all optimistic changes to the collection, making them permanent.\nPerfect for local-only data that doesn't need persistence or external synchronization.\n\n**Using with Manual Transactions:**\n\nFor manual transactions, you must call `utils.acceptMutations()` in your transaction's `mutationFn`\nto persist changes made during `tx.mutate()`. This is necessary because local-only collections\ndon't participate in the standard mutation handler flow for manual transactions.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `StandardSchemaV1`\\<`unknown`, `unknown`\\>\n\nThe schema type if a schema is provided, otherwise the type of items in the collection\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\nThe type of the key returned by getKey\n\n### Parameters\n\n#### config\n\n[`LocalOnlyCollectionConfig`](../interfaces/LocalOnlyCollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `T`, `TKey`\\> & `object`\n\nConfiguration options for the Local-only collection\n\n### Returns\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `T`, [`LocalOnlyCollectionUtils`](../interfaces/LocalOnlyCollectionUtils.md)\\> & `object` & `object`\n\nCollection options with utilities including acceptMutations\n\n### Examples\n\n```ts\n// Basic local-only collection\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// Local-only collection with initial data\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    initialData: [\n      { id: 1, name: 'Item 1' },\n      { id: 2, name: 'Item 2' },\n    ],\n  })\n)\n```\n\n```ts\n// Local-only collection with mutation handlers\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n      // Custom logic after insert\n    },\n  })\n)\n```\n\n```ts\n// Using with manual transactions\nconst localData = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use local data in API call\n    const localMutations = transaction.mutations.filter(m => m.collection === localData)\n    await api.save({ metadata: localMutations[0]?.modified })\n\n    // Persist local-only mutations after API success\n    localData.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localData.insert({ id: 1, data: 'metadata' })\n  apiCollection.insert({ id: 2, data: 'main data' })\n})\n\nawait tx.commit()\n```\n\n## Call Signature\n\n```ts\nfunction localOnlyCollectionOptions<T, TKey>(config): CollectionConfig<T, TKey, never, LocalOnlyCollectionUtils> & object & object;\n```\n\nDefined in: [packages/db/src/local-only.ts:164](https://github.com/TanStack/db/blob/main/packages/db/src/local-only.ts#L164)\n\nCreates Local-only collection options for use with a standard Collection\n\nThis is an in-memory collection that doesn't sync with external sources but uses a loopback sync config\nthat immediately \"syncs\" all optimistic changes to the collection, making them permanent.\nPerfect for local-only data that doesn't need persistence or external synchronization.\n\n**Using with Manual Transactions:**\n\nFor manual transactions, you must call `utils.acceptMutations()` in your transaction's `mutationFn`\nto persist changes made during `tx.mutate()`. This is necessary because local-only collections\ndon't participate in the standard mutation handler flow for manual transactions.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `object`\n\nThe schema type if a schema is provided, otherwise the type of items in the collection\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\nThe type of the key returned by getKey\n\n### Parameters\n\n#### config\n\n[`LocalOnlyCollectionConfig`](../interfaces/LocalOnlyCollectionConfig.md)\\<`T`, `never`, `TKey`\\> & `object`\n\nConfiguration options for the Local-only collection\n\n### Returns\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<`T`, `TKey`, `never`, [`LocalOnlyCollectionUtils`](../interfaces/LocalOnlyCollectionUtils.md)\\> & `object` & `object`\n\nCollection options with utilities including acceptMutations\n\n### Examples\n\n```ts\n// Basic local-only collection\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// Local-only collection with initial data\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    initialData: [\n      { id: 1, name: 'Item 1' },\n      { id: 2, name: 'Item 2' },\n    ],\n  })\n)\n```\n\n```ts\n// Local-only collection with mutation handlers\nconst collection = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n      // Custom logic after insert\n    },\n  })\n)\n```\n\n```ts\n// Using with manual transactions\nconst localData = createCollection(\n  localOnlyCollectionOptions({\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use local data in API call\n    const localMutations = transaction.mutations.filter(m => m.collection === localData)\n    await api.save({ metadata: localMutations[0]?.modified })\n\n    // Persist local-only mutations after API success\n    localData.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localData.insert({ id: 1, data: 'metadata' })\n  apiCollection.insert({ id: 2, data: 'main data' })\n})\n\nawait tx.commit()\n```\n"}
