ype":"inlineCode","value":"mutationFn"},{"type":"text","value":"\nto persist changes made during "},{"type":"inlineCode","value":"tx.mutate()"},{"type":"text","value":". The transaction receipt waits for that storage\nwrite even if the call is not awaited. Await it when later work depends on the write."}]},{"type":"heading","depth":3,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"t","children":[{"type":"text","value":"T"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"tkey","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":" = "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"config","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/LocalStorageCollectionConfig.md","children":[{"type":"inlineCode","value":"LocalStorageCollectionConfig"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/InferSchemaOutput.md","children":[{"type":"inlineCode","value":"InferSchemaOutput"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">, "},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":"> & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration options for the localStorage collection"}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/CollectionConfig.md","children":[{"type":"inlineCode","value":"CollectionConfig"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/InferSchemaOutput.md","children":[{"type":"inlineCode","value":"InferSchemaOutput"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"link","href":"../interfaces/LocalStorageCollectionUtils.md","children":[{"type":"inlineCode","value":"LocalStorageCollectionUtils"}]},{"type":"text","value":"> & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Collection options with utilities including clearStorage, getStorageSize, and acceptMutations"}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic localStorage collection\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n  })\n)","lang":"ts"},{"type":"code","value":"// localStorage collection with custom storage\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    storage: window.sessionStorage, // Use sessionStorage instead\n    getKey: (item) => item.id,\n  })\n)","lang":"ts"},{"type":"code","value":"// localStorage collection with mutation handlers\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n    },\n  })\n)","lang":"ts"},{"type":"code","value":"// Using with manual transactions\nconst localSettings = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'user-settings',\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use settings data in API call\n    const settingsMutations = transaction.mutations.filter(m => m.collection === localSettings)\n    await api.updateUserProfile({ settings: settingsMutations[0]?.modified })\n\n    // Persist local-storage mutations after API success\n    await localSettings.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localSettings.insert({ id: 'theme', value: 'dark' })\n  apiCollection.insert({ id: 2, data: 'profile data' })\n})\n\nawait tx.commit()","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function localStorageCollectionOptions<T, TKey>(config): CollectionConfig<T, TKey, never, LocalStorageCollectionUtils> & object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L338","children":[{"type":"text","value":"packages/db/src/local-storage.ts:338"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates localStorage collection options for use with a standard Collection"}]},{"type":"paragraph","children":[{"type":"text","value":"This function creates a collection that persists data to localStorage/sessionStorage\nand synchronizes changes across browser tabs using storage events.\nCreate fresh options for each direct "},{"type":"inlineCode","value":"createCollection()"},{"type":"text","value":" call. One options\nobject contains state owned by one Collection and cannot be reused."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Fallback Behavior:"}]}]},{"type":"paragraph","children":[{"type":"text","value":"When localStorage is not available (e.g., in server-side rendering environments),\nthis function automatically falls back to an in-memory storage implementation.\nThis prevents errors during module initialization and allows the collection to\nwork in any environment, though data will not persist across page reloads or\nbe shared across tabs when using the in-memory fallback."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Using with Manual Transactions:"}]}]},{"type":"paragraph","children":[{"type":"text","value":"For manual transactions, call "},{"type":"inlineCode","value":"utils.acceptMutations()"},{"type":"text","value":" in your transaction's "},{"type":"inlineCode","value":"mutationFn"},{"type":"text","value":"\nto persist changes made during "},{"type":"inlineCode","value":"tx.mutate()"},{"type":"text","value":". The transaction receipt waits for that storage\nwrite even if the call is not awaited. Await it when later work depends on the write."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"t-2","children":[{"type":"text","value":"T"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":4,"id":"tkey-2","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":" = "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"config-2","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/LocalStorageCollectionConfig.md","children":[{"type":"inlineCode","value":"LocalStorageCollectionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"never"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":"> & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration options for the localStorage collection"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/CollectionConfig.md","children":[{"type":"inlineCode","value":"CollectionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"never"},{"type":"text","value":", "},{"type":"link","href":"../interfaces/LocalStorageCollectionUtils.md","children":[{"type":"inlineCode","value":"LocalStorageCollectionUtils"}]},{"type":"text","value":"> & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Collection options with utilities including clearStorage, getStorageSize, and acceptMutations"}]},{"type":"heading","depth":3,"id":"examples-2","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic localStorage collection\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n  })\n)","lang":"ts"},{"type":"code","value":"// localStorage collection with custom storage\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    storage: window.sessionStorage, // Use sessionStorage instead\n    getKey: (item) => item.id,\n  })\n)","lang":"ts"},{"type":"code","value":"// localStorage collection with mutation handlers\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n    },\n  })\n)","lang":"ts"},{"type":"code","value":"// Using with manual transactions\nconst localSettings = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'user-settings',\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use settings data in API call\n    const settingsMutations = transaction.mutations.filter(m => m.collection === localSettings)\n    await api.updateUserProfile({ settings: settingsMutations[0]?.modified })\n\n    // Persist local-storage mutations after API success\n    await localSettings.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localSettings.insert({ id: 'theme', value: 'dark' })\n  apiCollection.insert({ id: 2, data: 'profile data' })\n})\n\nawait tx.commit()","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"t","text":"T","level":4},{"id":"tkey","text":"TKey","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"config","text":"config","level":4},{"id":"returns","text":"Returns","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"t-2","text":"T","level":4},{"id":"tkey-2","text":"TKey","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"config-2","text":"config","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"examples-2","text":"Examples","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction localStorageCollectionOptions<T, TKey>(config): CollectionConfig<InferSchemaOutput<T>, TKey, T, LocalStorageCollectionUtils> & object;\n```\n\nDefined in: [packages/db/src/local-storage.ts:318](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L318)\n\nCreates localStorage collection options for use with a standard Collection\n\nThis function creates a collection that persists data to localStorage/sessionStorage\nand synchronizes changes across browser tabs using storage events.\nCreate fresh options for each direct `createCollection()` call. One options\nobject contains state owned by one Collection and cannot be reused.\n\n**Fallback Behavior:**\n\nWhen localStorage is not available (e.g., in server-side rendering environments),\nthis function automatically falls back to an in-memory storage implementation.\nThis prevents errors during module initialization and allows the collection to\nwork in any environment, though data will not persist across page reloads or\nbe shared across tabs when using the in-memory fallback.\n\n**Using with Manual Transactions:**\n\nFor manual transactions, call `utils.acceptMutations()` in your transaction's `mutationFn`\nto persist changes made during `tx.mutate()`. The transaction receipt waits for that storage\nwrite even if the call is not awaited. Await it when later work depends on the write.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `StandardSchemaV1`\\<`unknown`, `unknown`\\>\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\n### Parameters\n\n#### config\n\n[`LocalStorageCollectionConfig`](../interfaces/LocalStorageCollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `T`, `TKey`\\> & `object`\n\nConfiguration options for the localStorage collection\n\n### Returns\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `T`, [`LocalStorageCollectionUtils`](../interfaces/LocalStorageCollectionUtils.md)\\> & `object`\n\nCollection options with utilities including clearStorage, getStorageSize, and acceptMutations\n\n### Examples\n\n```ts\n// Basic localStorage collection\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// localStorage collection with custom storage\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    storage: window.sessionStorage, // Use sessionStorage instead\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// localStorage collection with mutation handlers\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n    },\n  })\n)\n```\n\n```ts\n// Using with manual transactions\nconst localSettings = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'user-settings',\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use settings data in API call\n    const settingsMutations = transaction.mutations.filter(m => m.collection === localSettings)\n    await api.updateUserProfile({ settings: settingsMutations[0]?.modified })\n\n    // Persist local-storage mutations after API success\n    await localSettings.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localSettings.insert({ id: 'theme', value: 'dark' })\n  apiCollection.insert({ id: 2, data: 'profile data' })\n})\n\nawait tx.commit()\n```\n\n## Call Signature\n\n```ts\nfunction localStorageCollectionOptions<T, TKey>(config): CollectionConfig<T, TKey, never, LocalStorageCollectionUtils> & object;\n```\n\nDefined in: [packages/db/src/local-storage.ts:338](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L338)\n\nCreates localStorage collection options for use with a standard Collection\n\nThis function creates a collection that persists data to localStorage/sessionStorage\nand synchronizes changes across browser tabs using storage events.\nCreate fresh options for each direct `createCollection()` call. One options\nobject contains state owned by one Collection and cannot be reused.\n\n**Fallback Behavior:**\n\nWhen localStorage is not available (e.g., in server-side rendering environments),\nthis function automatically falls back to an in-memory storage implementation.\nThis prevents errors during module initialization and allows the collection to\nwork in any environment, though data will not persist across page reloads or\nbe shared across tabs when using the in-memory fallback.\n\n**Using with Manual Transactions:**\n\nFor manual transactions, call `utils.acceptMutations()` in your transaction's `mutationFn`\nto persist changes made during `tx.mutate()`. The transaction receipt waits for that storage\nwrite even if the call is not awaited. Await it when later work depends on the write.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `object`\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\n### Parameters\n\n#### config\n\n[`LocalStorageCollectionConfig`](../interfaces/LocalStorageCollectionConfig.md)\\<`T`, `never`, `TKey`\\> & `object`\n\nConfiguration options for the localStorage collection\n\n### Returns\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<`T`, `TKey`, `never`, [`LocalStorageCollectionUtils`](../interfaces/LocalStorageCollectionUtils.md)\\> & `object`\n\nCollection options with utilities including clearStorage, getStorageSize, and acceptMutations\n\n### Examples\n\n```ts\n// Basic localStorage collection\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// localStorage collection with custom storage\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    storage: window.sessionStorage, // Use sessionStorage instead\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// localStorage collection with mutation handlers\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n    },\n  })\n)\n```\n\n```ts\n// Using with manual transactions\nconst localSettings = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'user-settings',\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use settings data in API call\n    const settingsMutations = transaction.mutations.filter(m => m.collection === localSettings)\n    await api.updateUserProfile({ settings: settingsMutations[0]?.modified })\n\n    // Persist local-storage mutations after API success\n    await localSettings.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localSettings.insert({ id: 'theme', value: 'dark' })\n  apiCollection.insert({ id: 2, data: 'profile data' })\n})\n\nawait tx.commit()\n```\n","originalRawMarkdown":"---\nid: localStorageCollectionOptions\ntitle: localStorageCollectionOptions\n---\n\n## Call Signature\n\n```ts\nfunction localStorageCollectionOptions<T, TKey>(config): CollectionConfig<InferSchemaOutput<T>, TKey, T, LocalStorageCollectionUtils> & object;\n```\n\nDefined in: [packages/db/src/local-storage.ts:318](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L318)\n\nCreates localStorage collection options for use with a standard Collection\n\nThis function creates a collection that persists data to localStorage/sessionStorage\nand synchronizes changes across browser tabs using storage events.\nCreate fresh options for each direct `createCollection()` call. One options\nobject contains state owned by one Collection and cannot be reused.\n\n**Fallback Behavior:**\n\nWhen localStorage is not available (e.g., in server-side rendering environments),\nthis function automatically falls back to an in-memory storage implementation.\nThis prevents errors during module initialization and allows the collection to\nwork in any environment, though data will not persist across page reloads or\nbe shared across tabs when using the in-memory fallback.\n\n**Using with Manual Transactions:**\n\nFor manual transactions, call `utils.acceptMutations()` in your transaction's `mutationFn`\nto persist changes made during `tx.mutate()`. The transaction receipt waits for that storage\nwrite even if the call is not awaited. Await it when later work depends on the write.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `StandardSchemaV1`\\<`unknown`, `unknown`\\>\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\n### Parameters\n\n#### config\n\n[`LocalStorageCollectionConfig`](../interfaces/LocalStorageCollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `T`, `TKey`\\> & `object`\n\nConfiguration options for the localStorage collection\n\n### Returns\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<[`InferSchemaOutput`](../type-aliases/InferSchemaOutput.md)\\<`T`\\>, `TKey`, `T`, [`LocalStorageCollectionUtils`](../interfaces/LocalStorageCollectionUtils.md)\\> & `object`\n\nCollection options with utilities including clearStorage, getStorageSize, and acceptMutations\n\n### Examples\n\n```ts\n// Basic localStorage collection\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// localStorage collection with custom storage\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    storage: window.sessionStorage, // Use sessionStorage instead\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// localStorage collection with mutation handlers\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n    },\n  })\n)\n```\n\n```ts\n// Using with manual transactions\nconst localSettings = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'user-settings',\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use settings data in API call\n    const settingsMutations = transaction.mutations.filter(m => m.collection === localSettings)\n    await api.updateUserProfile({ settings: settingsMutations[0]?.modified })\n\n    // Persist local-storage mutations after API success\n    await localSettings.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localSettings.insert({ id: 'theme', value: 'dark' })\n  apiCollection.insert({ id: 2, data: 'profile data' })\n})\n\nawait tx.commit()\n```\n\n## Call Signature\n\n```ts\nfunction localStorageCollectionOptions<T, TKey>(config): CollectionConfig<T, TKey, never, LocalStorageCollectionUtils> & object;\n```\n\nDefined in: [packages/db/src/local-storage.ts:338](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L338)\n\nCreates localStorage collection options for use with a standard Collection\n\nThis function creates a collection that persists data to localStorage/sessionStorage\nand synchronizes changes across browser tabs using storage events.\nCreate fresh options for each direct `createCollection()` call. One options\nobject contains state owned by one Collection and cannot be reused.\n\n**Fallback Behavior:**\n\nWhen localStorage is not available (e.g., in server-side rendering environments),\nthis function automatically falls back to an in-memory storage implementation.\nThis prevents errors during module initialization and allows the collection to\nwork in any environment, though data will not persist across page reloads or\nbe shared across tabs when using the in-memory fallback.\n\n**Using with Manual Transactions:**\n\nFor manual transactions, call `utils.acceptMutations()` in your transaction's `mutationFn`\nto persist changes made during `tx.mutate()`. The transaction receipt waits for that storage\nwrite even if the call is not awaited. Await it when later work depends on the write.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `object`\n\n#### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\n### Parameters\n\n#### config\n\n[`LocalStorageCollectionConfig`](../interfaces/LocalStorageCollectionConfig.md)\\<`T`, `never`, `TKey`\\> & `object`\n\nConfiguration options for the localStorage collection\n\n### Returns\n\n[`CollectionConfig`](../interfaces/CollectionConfig.md)\\<`T`, `TKey`, `never`, [`LocalStorageCollectionUtils`](../interfaces/LocalStorageCollectionUtils.md)\\> & `object`\n\nCollection options with utilities including clearStorage, getStorageSize, and acceptMutations\n\n### Examples\n\n```ts\n// Basic localStorage collection\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// localStorage collection with custom storage\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    storage: window.sessionStorage, // Use sessionStorage instead\n    getKey: (item) => item.id,\n  })\n)\n```\n\n```ts\n// localStorage collection with mutation handlers\nconst collection = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'todos',\n    getKey: (item) => item.id,\n    onInsert: async ({ transaction }) => {\n      console.log('Item inserted:', transaction.mutations[0].modified)\n    },\n  })\n)\n```\n\n```ts\n// Using with manual transactions\nconst localSettings = createCollection(\n  localStorageCollectionOptions({\n    storageKey: 'user-settings',\n    getKey: (item) => item.id,\n  })\n)\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Use settings data in API call\n    const settingsMutations = transaction.mutations.filter(m => m.collection === localSettings)\n    await api.updateUserProfile({ settings: settingsMutations[0]?.modified })\n\n    // Persist local-storage mutations after API success\n    await localSettings.utils.acceptMutations(transaction)\n  }\n})\n\ntx.mutate(() => {\n  localSettings.insert({ id: 'theme', value: 'dark' })\n  apiCollection.insert({ id: 2, data: 'profile data' })\n})\n\nawait tx.commit()\n```\n"}
