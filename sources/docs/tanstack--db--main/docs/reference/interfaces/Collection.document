anges to the same key retain their causal order within a callback.\nChanges to different keys have no promised order within a callback."}]},{"type":"heading","depth":5,"id":"parameters-19","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":6,"id":"callback-6","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"changes"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"}]},{"type":"paragraph","children":[{"type":"text","value":"Function called when items change"}]},{"type":"heading","depth":6,"id":"options-2","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"SubscribeChangesOptions.md","children":[{"type":"inlineCode","value":"SubscribeChangesOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Subscription options including includeInitialState and where filter"}]},{"type":"heading","depth":5,"id":"returns-48","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"CollectionSubscription"}]},{"type":"paragraph","children":[{"type":"text","value":"Unsubscribe function - Call this to stop listening for changes"}]},{"type":"heading","depth":5,"id":"examples-3","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic subscription\nconst subscription = collection.subscribeChanges((changes) => {\n  changes.forEach(change => {\n    console.log(`${change.type}: ${change.key}`, change.value)\n  })\n})\n\n// Later: subscription.unsubscribe()","lang":"ts"},{"type":"code","value":"// Include current state immediately\nconst subscription = collection.subscribeChanges((changes) => {\n  updateUI(changes)\n}, { includeInitialState: true })","lang":"ts"},{"type":"code","value":"// Subscribe only to changes matching a condition using where callback\nimport { eq } from \"@tanstack/db\"\n\nconst subscription = collection.subscribeChanges((changes) => {\n  updateUI(changes)\n}, {\n  includeInitialState: true,\n  where: (row) => eq(row.status, \"active\")\n})","lang":"ts"},{"type":"code","value":"// Using multiple conditions with and()\nimport { and, eq, gt } from \"@tanstack/db\"\n\nconst subscription = collection.subscribeChanges((changes) => {\n  updateUI(changes)\n}, {\n  where: (row) => and(eq(row.status, \"active\"), gt(row.priority, 5))\n})","lang":"ts"},{"type":"heading","depth":5,"id":"inherited-from-49","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/CollectionImpl.md","children":[{"type":"inlineCode","value":"CollectionImpl"}]},{"type":"text","value":"."},{"type":"link","href":"../classes/CollectionImpl.md#subscribechanges","children":[{"type":"inlineCode","value":"subscribeChanges"}]}]},{"type":"heading","depth":4,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"subscribeChanges(callback, options?): CollectionSubscription;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts#L1148","children":[{"type":"text","value":"packages/db/src/collection/index.ts:1148"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Subscribe to changes in the collection\nChanges to the same key retain their causal order within a callback.\nChanges to different keys have no promised order within a callback."}]},{"type":"heading","depth":5,"id":"parameters-20","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":6,"id":"callback-7","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"text","value":"Function called when items change"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"changes"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"},{"type":"text","value":" | ("},{"type":"inlineCode","value":"changes"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":6,"id":"options-3","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"SubscribeChangesOptions.md","children":[{"type":"inlineCode","value":"SubscribeChangesOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Subscription options including includeInitialState and where filter"}]},{"type":"heading","depth":5,"id":"returns-49","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"CollectionSubscription"}]},{"type":"paragraph","children":[{"type":"text","value":"Unsubscribe function - Call this to stop listening for changes"}]},{"type":"heading","depth":5,"id":"examples-4","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic subscription\nconst subscription = collection.subscribeChanges((changes) => {\n  changes.forEach(change => {\n    console.log(`${change.type}: ${change.key}`, change.value)\n  })\n})\n\n// Later: subscription.unsubscribe()","lang":"ts"},{"type":"code","value":"// Include current state immediately\nconst subscription = collection.subscribeChanges((changes) => {\n  updateUI(changes)\n}, { includeInitialState: true })","lang":"ts"},{"type":"code","value":"// Subscribe only to changes matching a condition using where callback\nimport { eq } from \"@tanstack/db\"\n\nconst subscription = collection.subscribeChanges((changes) => {\n  updateUI(changes)\n}, {\n  includeInitialState: true,\n  where: (row) => eq(row.status, \"active\")\n})","lang":"ts"},{"type":"code","value":"// Using multiple conditions with and()\nimport { and, eq, gt } from \"@tanstack/db\"\n\nconst subscription = collection.subscribeChanges((changes) => {\n  updateUI(changes)\n}, {\n  where: (row) => and(eq(row.status, \"active\"), gt(row.priority, 5))\n})","lang":"ts"},{"type":"heading","depth":5,"id":"inherited-from-50","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/CollectionImpl.md","children":[{"type":"inlineCode","value":"CollectionImpl"}]},{"type":"text","value":"."},{"type":"link","href":"../classes/CollectionImpl.md#subscribechanges","children":[{"type":"inlineCode","value":"subscribeChanges"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"toarraywhenready","children":[{"type":"text","value":"toArrayWhenReady()"}]},{"type":"code","value":"toArrayWhenReady(): Promise<WithVirtualProps<T, TKey>[]>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts#L1060","children":[{"type":"text","value":"packages/db/src/collection/index.ts:1060"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Gets the current state of the collection as an Array, but only resolves when data is available\nWaits for the first sync commit to complete before resolving"}]},{"type":"heading","depth":4,"id":"returns-50","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/WithVirtualProps.md","children":[{"type":"inlineCode","value":"WithVirtualProps"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":">[]>"}]},{"type":"paragraph","children":[{"type":"tex