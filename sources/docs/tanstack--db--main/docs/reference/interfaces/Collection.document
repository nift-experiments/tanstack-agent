m '@tanstack/db'\n\n// Create an index with explicit type\nconst ageIndex = collection.createIndex((row) => row.age, {\n  indexType: BasicIndex\n})\n\n// Create an index with collection's default type\nconst nameIndex = collection.createIndex((row) => row.name)","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-28","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/CollectionImpl.md","children":[{"type":"inlineCode","value":"CollectionImpl"}]},{"type":"text","value":"."},{"type":"link","href":"../classes/CollectionImpl.md#createindex","children":[{"type":"inlineCode","value":"createIndex"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"currentstateaschanges","children":[{"type":"text","value":"currentStateAsChanges()"}]},{"type":"code","value":"currentStateAsChanges(options): \n  | void\n  | ChangeMessage<WithVirtualProps<T, TKey>, TKey>[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/collection/index.ts#L1088","children":[{"type":"text","value":"packages/db/src/collection/index.ts:1088"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns the current state of the collection as an array of changes"}]},{"type":"heading","depth":4,"id":"parameters-6","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"CurrentStateAsChangesOptions.md","children":[{"type":"inlineCode","value":"CurrentStateAsChangesOptions"}]},{"type":"text","value":" = "},{"type":"inlineCode","value":"{}"}]},{"type":"paragraph","children":[{"type":"text","value":"Options including optional where filter"}]},{"type":"heading","depth":4,"id":"returns-25","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{