","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":3,"id":"tschema","children":[{"type":"text","value":"TSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":" = "},{"type":"inlineCode","value":"never"}]},{"type":"heading","depth":3,"id":"tutils","children":[{"type":"text","value":"TUtils"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TUtils"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/UtilsRecord.md","children":[{"type":"inlineCode","value":"UtilsRecord"}]},{"type":"text","value":" = "},{"type":"link","href":"../type-aliases/UtilsRecord.md","children":[{"type":"inlineCode","value":"UtilsRecord"}]}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"autoindex","children":[{"type":"text","value":"autoIndex?"}]},{"type":"code","value":"optional autoIndex: \"off\" | \"eager\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L767","children":[{"type":"text","value":"packages/db/src/types.ts:767"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Auto-indexing mode for the collection.\nWhen enabled, indexes will be automatically created for simple where expressions."}]},{"type":"heading","depth":4,"id":"default","children":[{"type":"text","value":"Default"}]},{"type":"code","value":"\"off\"","lang":"ts"},{"type":"heading","depth":4,"id":"description","children":[{"type":"text","value":"Description"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"\"off\": No automatic indexing (default). Use explicit indexes for better bundle size."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"\"eager\": Automatically create indexes for simple where expressions in subscribeChanges.\nRequires setting defaultIndexType."}]}]}]},{"type":"heading","depth":4,"id":"inherited-from","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#autoindex","children":[{"type":"inlineCode","value":"autoIndex"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"compare","children":[{"type":"text","value":"compare()?"}]},{"type":"code","value":"optional compare: (x, y) => number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L792","children":[{"type":"text","value":"packages/db/src/types.ts:792"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional function to compare two items.\nThis is used to order the items in the collection."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"x","children":[{"type":"text","value":"x"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"}]},{"type":"paragraph","children":[{"type":"text","value":"The first item to compare"}]},{"type":"heading","depth":5,"id":"y","children":[{"type":"text","value":"y"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"}]},{"type":"paragraph","children":[{"type":"text","value":"The second item to compare"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"A number indicating the order of the items"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// For a collection with a 'createdAt' field\ncompare: (x, y) => x.createdAt.getTime() - y.createdAt.getTime()","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-2","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#compare","children":[{"type":"inlineCode","value":"compare"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"defaultindextype","children":[{"type":"text","value":"defaultIndexType?"}]},{"type":"code","value":"optional defaultIndexType: IndexConstructor<TKey>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L781","children":[{"type":"text","value":"packages/db/src/types.ts:781"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Default index type to use when creating indexes without an explicit type.\nRequired for auto-indexing. Import from '@tanstack/db'."}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { BasicIndex } from '@tanstack/db'\nconst collection = createCollection({\n  defaultIndexType: BasicIndex,\n  autoIndex: 'eager',\n  // ...\n})","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-3","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#defaultindextype","children":[{"type":"inlineCode","value":"defaultIndexType"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"defaultstringcollation","children":[{"type":"text","value":"defaultStringCollation?"}]},{"type":"code","value":"optional defaultStringCollation: StringCollationConfig;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L987","children":[{"type":"text","value":"packages/db/src/types.ts:987"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Specifies how to compare data in the collection.\nThis should be configured to match data ordering on the backend.\nE.g., when using the Electric DB collection these options\nshould match the database's collation settings."}]},{"type":"heading","depth":4,"id":"inherited-from-4","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#defaultstringcollation","children":[{"type":"inlineCode","value":"defaultStringCollation"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"gctime","children":[{"type":"text","value":"gcTime?"}]},{"type":"code","value":"optional gcTime: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L746","children":[{"type":"text","value":"packages/db/src/types.ts:746"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Time in milliseconds after which the collection will be garbage collected\nwhen it has no active subscribers. Defaults to 5 minutes (300000ms).\nSync started without subscribers gets a minimum 50ms grace period.\nPending preloads retain the collection until they settle. Preloading ready\ndata refreshes the retention period. A non-positive or non-finite value\ndisables automatic garbage collection."}]},{"type":"heading","depth":4,"id":"inherited-from-5","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#gctime","children":[{"type":"inlineCode","value":"gcTime"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getkey","children":[{"type":"text","value":"getKey()"}]},{"type":"code","value":"getKey: (item) => TKey;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L737","children":[{"type":"text","value":"packages/db/src/types.ts:737"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Function to extract the ID from an object\nThis is required for update/delete operations which now only accept IDs"}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"item","children":[{"type":"text","value":"item"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"}]},{"type":"paragraph","children":[{"type":"text","value":"The item to extract the ID from"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"}]},{"type":"paragraph","children":[{"type":"text","value":"The ID string for the item"}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// For a collection with a 'uuid' field as the primary key\ngetKey: (item) => item.uuid","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-6","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#getkey","children":[{"type":"inlineCode","value":"getKey"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"id","children":[{"type":"text","value":"id?"}]},{"type":"code","value":"optional id: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L726","children":[{"type":"text","value":"packages/db/src/types.ts:726"}]}]},{"type":"heading","depth":4,"id":"inherited-from-7","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#id","children":[{"type":"inlineCode","value":"id"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"ondelete","children":[{"type":"text","value":"onDelete?"}]},{"type":"code","value":"optional onDelete: \n  | DeleteMutationFn<T, TKey, TUtils, void>\n| DeleteMutationFn<T, TKey, TUtils, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L976","children":[{"type":"text","value":"packages/db/src/types.ts:976"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional asynchronous handler function called before a delete operation\nReturning a value is deprecated; coordinate synchronization through collection utilities instead."}]},{"type":"heading","depth":4,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic delete handler\nonDelete: async ({ transaction, collection }) => {\n  const deletedKey = transaction.mutations[0].key\n  await api.deleteTodo(deletedKey)\n}","lang":"ts"},{"type":"code","value":"// Delete handler with refetch (Query Collection)\nonDelete: async ({ transaction, collection }) => {\n  const keysToDelete = transaction.mutations.map(m => m.key)\n  await api.deleteTodos(keysToDelete)\n  // Trigger refetch to sync server state\n  await collection.utils.refetch()\n  // Prevent the pre-1.0 compatibility wrapper from refetching again.\n  return { refetch: false }\n}","lang":"ts"},{"type":"code","value":"// Delete handler with sync wait (Electric Collection)\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const result = await api.deleteTodo(mutation.original.id)\n  // Wait for txid to sync\n  await collection.utils.awaitTxId(result.txid)\n}","lang":"ts"},{"type":"code","value":"// Delete handler with confirmation\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const shouldDelete = await confirmDeletion(mutation.original)\n  if (!shouldDelete) {\n    throw new Error('Delete cancelled by user')\n  }\n  await api.deleteTodo(mutation.original.id)\n}","lang":"ts"},{"type":"code","value":"// Delete handler with optimistic rollback\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  try {\n    await api.deleteTodo(mutation.original.id)\n  } catch (error) {\n    // Transaction will automatically rollback optimistic changes\n    console.error('Delete failed, rolling back:', error)\n    throw error\n  }\n}","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-8","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#ondelete","children":[{"type":"inlineCode","value":"onDelete"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"oninsert","children":[{"type":"text","value":"onInsert?"}]},{"type":"code","value":"optional onInsert: \n  | InsertMutationFn<T, TKey, TUtils, void>\n| InsertMutationFn<T, TKey, TUtils, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L855","children":[{"type":"text","value":"packages/db/src/types.ts:855"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional asynchronous handler function called before an insert operation\nReturning a value is deprecated; coordinate synchronization through collection utilities instead."}]},{"type":"heading","depth":4,"id":"examples-2","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic insert handler\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  await api.createTodo(newItem)\n}","lang":"ts"},{"type":"code","value":"// Insert handler with refetch (Query Collection)\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  await api.createTodo(newItem)\n  // Trigger refetch to sync server state\n  await collection.utils.refetch()\n  // Prevent the pre-1.0 compatibility wrapper from refetching again.\n  return { refetch: false }\n}","lang":"ts"},{"type":"code","value":"// Insert handler with sync wait (Electric Collection)\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.createTodo(newItem)\n  // Wait for txid to sync\n  await collection.utils.awaitTxId(result.txid)\n}","lang":"ts"},{"type":"code","value":"// Insert handler with multiple items\nonInsert: async ({ transaction, collection }) => {\n  const items = transaction.mutations.map(m => m.modified)\n  await api.createTodos(items)\n  // Refetch to get updated data from server\n  await collection.utils.refetch()\n  return { refetch: false }\n}","lang":"ts"},{"type":"code","value":"// Insert handler with error handling\nonInsert: async ({ transaction, collection }) => {\n  try {\n    const newItem = transaction.mutations[0].modified\n    await api.createTodo(newItem)\n  } catch (error) {\n    console.error('Insert failed:', error)\n    throw error // This will cause the transaction to rollback\n  }\n}","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-9","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#oninsert","children":[{"type":"inlineCode","value":"onInsert"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onupdate","children":[{"type":"text","value":"onUpdate?"}]},{"type":"code","value":"optional onUpdate: \n  | UpdateMutationFn<T, TKey, TUtils, void>\n| UpdateMutationFn<T, TKey, TUtils, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L917","children":[{"type":"text","value":"packages/db/src/types.ts:917"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional asynchronous handler function called before an update operation\nReturning a value is deprecated; coordinate synchronization through collection utilities instead."}]},{"type":"heading","depth":4,"id":"examples-3","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic update handler\nonUpdate: async ({ transaction, collection }) => {\n  const updatedItem = transaction.mutations[0].modified\n  await api.updateTodo(updatedItem.id, updatedItem)\n}","lang":"ts"},{"type":"code","value":"// Update handler with refetch (Query Collection)\nonUpdate: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const changes = mutation.changes // Only the changed fields\n  await api.updateTodo(mutation.original.id, changes)\n  // Trigger refetch to sync server state\n  await collection.utils.refetch()\n  // Prevent the pre-1.0 compatibility wrapper from refetching again.\n  return { refetch: false }\n}","lang":"ts"},{"type":"code","value":"// Update handler with sync wait (Electric Collection)\nonUpdate: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const result = await api.updateTodo(mutation.original.id, mutation.changes)\n  // Wait for txid to sync\n  await collection.utils.awaitTxId(result.txid)\n}","lang":"ts"},{"type":"code","value":"// Update handler with multiple items\nonUpdate: async ({ transaction, collection }) => {\n  const updates = transaction.mutations.map(m => ({\n    id: m.key,\n    changes: m.changes\n  }))\n  await api.updateTodos(updates)\n  await collection.utils.refetch()\n  return { refetch: false }\n}","lang":"ts"},{"type":"code","value":"// Update handler with optimistic rollback\nonUpdate: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  try {\n    await api.updateTodo(mutation.original.id, mutation.changes)\n  } catch (error) {\n    // Transaction will automatically rollback optimistic changes\n    console.error('Update failed, rolling back:', error)\n    throw error\n  }\n}","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-10","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#onupdate","children":[{"type":"inlineCode","value":"onUpdate"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"schema","children":[{"type":"text","value":"schema?"}]},{"type":"code","value":"optional schema: TSchema;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L727","children":[{"type":"text","value":"packages/db/src/types.ts:727"}]}]},{"type":"heading","depth":4,"id":"inherited-from-11","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#schema","children":[{"type":"inlineCode","value":"schema"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"startsync","children":[{"type":"text","value":"startSync?"}]},{"type":"code","value":"optional startSync: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L757","children":[{"type":"text","value":"packages/db/src/types.ts:757"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether to eagerly start syncing on collection creation.\nWhen true, syncing begins immediately. When false, syncing starts when the first subscriber attaches."}]},{"type":"paragraph","children":[{"type":"text","value":"Note: Even with startSync=true, collections will pause syncing when there are no active\nsubscribers (typically when components querying the collection unmount), resuming when new\nsubscribers attach. This preserves normal staleTime/gcTime behavior."}]},{"type":"heading","depth":4,"id":"default-2","children":[{"type":"text","value":"Default"}]},{"type":"code","value":"false","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-12","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#startsync","children":[{"type":"inlineCode","value":"startSync"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"sync","children":[{"type":"text","value":"sync"}]},{"type":"code","value":"sync: SyncConfig<T, TKey>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L998","children":[{"type":"text","value":"packages/db/src/types.ts:998"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"syncmode","children":[{"type":"text","value":"syncMode?"}]},{"type":"code","value":"optional syncMode: SyncMode;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L801","children":[{"type":"text","value":"packages/db/src/types.ts:801"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The mode of sync to use for the collection."}]},{"type":"heading","depth":4,"id":"default-3","children":[{"type":"text","value":"Default"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"eager"}]},{"type":"heading","depth":4,"id":"description-2","children":[{"type":"text","value":"Description"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"eager"},{"type":"text","value":": syncs all data immediately on preload"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"on-demand"},{"type":"text","value":": syncs data in incremental snapshots when the collection is queried\nThe exact implementation of the sync mode is up to the sync implementation."}]}]}]},{"type":"heading","depth":4,"id":"inherited-from-13","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#syncmode","children":[{"type":"inlineCode","value":"syncMode"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"utils","children":[{"type":"text","value":"utils?"}]},{"type":"code","value":"optional utils: TUtils;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L989","children":[{"type":"text","value":"packages/db/src/types.ts:989"}]}]},{"type":"heading","depth":4,"id":"inherited-from-14","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type":"link","href":"BaseCollectionConfig.md","children":[{"type":"inlineCode","value":"BaseCollectionConfig"}]},{"type":"text","value":"."},{"type":"link","href":"BaseCollectionConfig.md#utils","children":[{"type":"inlineCode","value":"utils"}]}]}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"tkey","text":"TKey","level":3},{"id":"tschema","text":"TSchema","level":3},{"id":"tutils","text":"TUtils","level":3},{"id":"properties","text":"Properties","level":2},{"id":"autoindex","text":"autoIndex?","level":3},{"id":"default","text":"Default","level":4},{"id":"description","text":"Description","level":4},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"compare","text":"compare()?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"x","text":"x","level":5},{"id":"y","text":"y","level":5},{"id":"returns","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"inherited-from-2","text":"Inherited from","level":4},{"id":"defaultindextype","text":"defaultIndexType?","level":3},{"id":"example-2","text":"Example","level":4},{"id":"inherited-from-3","text":"Inherited from","level":4},{"id":"defaultstringcollation","text":"defaultStringCollation?","level":3},{"id":"inherited-from-4","text":"Inherited from","level":4},{"id":"gctime","text":"gcTime?","level":3},{"id":"inherited-from-5","text":"Inherited from","level":4},{"id":"getkey","text":"getKey()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"item","text":"item","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"example-3","text":"Example","level":4},{"id":"inherited-from-6","text":"Inherited from","level":4},{"id":"id","text":"id?","level":3},{"id":"inherited-from-7","text":"Inherited from","level":4},{"id":"ondelete","text":"onDelete?","level":3},{"id":"examples","text":"Examples","level":4},{"id":"inherited-from-8","text":"Inherited from","level":4},{"id":"oninsert","text":"onInsert?","level":3},{"id":"examples-2","text":"Examples","level":4},{"id":"inherited-from-9","text":"Inherited from","level":4},{"id":"onupdate","text":"onUpdate?","level":3},{"id":"examples-3","text":"Examples","level":4},{"id":"inherited-from-10","text":"Inherited from","level":4},{"id":"schema","text":"schema?","level":3},{"id":"inherited-from-11","text":"Inherited from","level":4},{"id":"startsync","text":"startSync?","level":3},{"id":"default-2","text":"Default","level":4},{"id":"inherited-from-12","text":"Inherited from","level":4},{"id":"sync","text":"sync","level":3},{"id":"syncmode","text":"syncMode?","level":3},{"id":"default-3","text":"Default","level":4},{"id":"description-2","text":"Description","level":4},{"id":"inherited-from-13","text":"Inherited from","level":4},{"id":"utils","text":"utils?","level":3},{"id":"inherited-from-14","text":"Inherited from","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/db/src/types.ts:992](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L992)\n\n## Extends\n\n- [`BaseCollectionConfig`](BaseCollectionConfig.md)\\<`T`, `TKey`, `TSchema`, `TUtils`\\>\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\n### TSchema\n\n`TSchema` *extends* `StandardSchemaV1` = `never`\n\n### TUtils\n\n`TUtils` *extends* [`UtilsRecord`](../type-aliases/UtilsRecord.md) = [`UtilsRecord`](../type-aliases/UtilsRecord.md)\n\n## Properties\n\n### autoIndex?\n\n```ts\noptional autoIndex: \"off\" | \"eager\";\n```\n\nDefined in: [packages/db/src/types.ts:767](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L767)\n\nAuto-indexing mode for the collection.\nWhen enabled, indexes will be automatically created for simple where expressions.\n\n#### Default\n\n```ts\n\"off\"\n```\n\n#### Description\n\n- \"off\": No automatic indexing (default). Use explicit indexes for better bundle size.\n- \"eager\": Automatically create indexes for simple where expressions in subscribeChanges.\n           Requires setting defaultIndexType.\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`autoIndex`](BaseCollectionConfig.md#autoindex)\n\n***\n\n### compare()?\n\n```ts\noptional compare: (x, y) => number;\n```\n\nDefined in: [packages/db/src/types.ts:792](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L792)\n\nOptional function to compare two items.\nThis is used to order the items in the collection.\n\n#### Parameters\n\n##### x\n\n`T`\n\nThe first item to compare\n\n##### y\n\n`T`\n\nThe second item to compare\n\n#### Returns\n\n`number`\n\nA number indicating the order of the items\n\n#### Example\n\n```ts\n// For a collection with a 'createdAt' field\ncompare: (x, y) => x.createdAt.getTime() - y.createdAt.getTime()\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`compare`](BaseCollectionConfig.md#compare)\n\n***\n\n### defaultIndexType?\n\n```ts\noptional defaultIndexType: IndexConstructor<TKey>;\n```\n\nDefined in: [packages/db/src/types.ts:781](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L781)\n\nDefault index type to use when creating indexes without an explicit type.\nRequired for auto-indexing. Import from '@tanstack/db'.\n\n#### Example\n\n```ts\nimport { BasicIndex } from '@tanstack/db'\nconst collection = createCollection({\n  defaultIndexType: BasicIndex,\n  autoIndex: 'eager',\n  // ...\n})\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`defaultIndexType`](BaseCollectionConfig.md#defaultindextype)\n\n***\n\n### defaultStringCollation?\n\n```ts\noptional defaultStringCollation: StringCollationConfig;\n```\n\nDefined in: [packages/db/src/types.ts:987](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L987)\n\nSpecifies how to compare data in the collection.\nThis should be configured to match data ordering on the backend.\nE.g., when using the Electric DB collection these options\n      should match the database's collation settings.\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`defaultStringCollation`](BaseCollectionConfig.md#defaultstringcollation)\n\n***\n\n### gcTime?\n\n```ts\noptional gcTime: number;\n```\n\nDefined in: [packages/db/src/types.ts:746](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L746)\n\nTime in milliseconds after which the collection will be garbage collected\nwhen it has no active subscribers. Defaults to 5 minutes (300000ms).\nSync started without subscribers gets a minimum 50ms grace period.\nPending preloads retain the collection until they settle. Preloading ready\ndata refreshes the retention period. A non-positive or non-finite value\ndisables automatic garbage collection.\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`gcTime`](BaseCollectionConfig.md#gctime)\n\n***\n\n### getKey()\n\n```ts\ngetKey: (item) => TKey;\n```\n\nDefined in: [packages/db/src/types.ts:737](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L737)\n\nFunction to extract the ID from an object\nThis is required for update/delete operations which now only accept IDs\n\n#### Parameters\n\n##### item\n\n`T`\n\nThe item to extract the ID from\n\n#### Returns\n\n`TKey`\n\nThe ID string for the item\n\n#### Example\n\n```ts\n// For a collection with a 'uuid' field as the primary key\ngetKey: (item) => item.uuid\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`getKey`](BaseCollectionConfig.md#getkey)\n\n***\n\n### id?\n\n```ts\noptional id: string;\n```\n\nDefined in: [packages/db/src/types.ts:726](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L726)\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`id`](BaseCollectionConfig.md#id)\n\n***\n\n### onDelete?\n\n```ts\noptional onDelete: \n  | DeleteMutationFn<T, TKey, TUtils, void>\n| DeleteMutationFn<T, TKey, TUtils, any>;\n```\n\nDefined in: [packages/db/src/types.ts:976](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L976)\n\nOptional asynchronous handler function called before a delete operation\nReturning a value is deprecated; coordinate synchronization through collection utilities instead.\n\n#### Examples\n\n```ts\n// Basic delete handler\nonDelete: async ({ transaction, collection }) => {\n  const deletedKey = transaction.mutations[0].key\n  await api.deleteTodo(deletedKey)\n}\n```\n\n```ts\n// Delete handler with refetch (Query Collection)\nonDelete: async ({ transaction, collection }) => {\n  const keysToDelete = transaction.mutations.map(m => m.key)\n  await api.deleteTodos(keysToDelete)\n  // Trigger refetch to sync server state\n  await collection.utils.refetch()\n  // Prevent the pre-1.0 compatibility wrapper from refetching again.\n  return { refetch: false }\n}\n```\n\n```ts\n// Delete handler with sync wait (Electric Collection)\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const result = await api.deleteTodo(mutation.original.id)\n  // Wait for txid to sync\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Delete handler with confirmation\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const shouldDelete = await confirmDeletion(mutation.original)\n  if (!shouldDelete) {\n    throw new Error('Delete cancelled by user')\n  }\n  await api.deleteTodo(mutation.original.id)\n}\n```\n\n```ts\n// Delete handler with optimistic rollback\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  try {\n    await api.deleteTodo(mutation.original.id)\n  } catch (error) {\n    // Transaction will automatically rollback optimistic changes\n    console.error('Delete failed, rolling back:', error)\n    throw error\n  }\n}\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`onDelete`](BaseCollectionConfig.md#ondelete)\n\n***\n\n### onInsert?\n\n```ts\noptional onInsert: \n  | InsertMutationFn<T, TKey, TUtils, void>\n| InsertMutationFn<T, TKey, TUtils, any>;\n```\n\nDefined in: [packages/db/src/types.ts:855](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L855)\n\nOptional asynchronous handler function called before an insert operation\nReturning a value is deprecated; coordinate synchronization through collection utilities instead.\n\n#### Examples\n\n```ts\n// Basic insert handler\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  await api.createTodo(newItem)\n}\n```\n\n```ts\n// Insert handler with refetch (Query Collection)\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  await api.createTodo(newItem)\n  // Trigger refetch to sync server state\n  await collection.utils.refetch()\n  // Prevent the pre-1.0 compatibility wrapper from refetching again.\n  return { refetch: false }\n}\n```\n\n```ts\n// Insert handler with sync wait (Electric Collection)\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.createTodo(newItem)\n  // Wait for txid to sync\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Insert handler with multiple items\nonInsert: async ({ transaction, collection }) => {\n  const items = transaction.mutations.map(m => m.modified)\n  await api.createTodos(items)\n  // Refetch to get updated data from server\n  await collection.utils.refetch()\n  return { refetch: false }\n}\n```\n\n```ts\n// Insert handler with error handling\nonInsert: async ({ transaction, collection }) => {\n  try {\n    const newItem = transaction.mutations[0].modified\n    await api.createTodo(newItem)\n  } catch (error) {\n    console.error('Insert failed:', error)\n    throw error // This will cause the transaction to rollback\n  }\n}\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`onInsert`](BaseCollectionConfig.md#oninsert)\n\n***\n\n### onUpdate?\n\n```ts\noptional onUpdate: \n  | UpdateMutationFn<T, TKey, TUtils, void>\n| UpdateMutationFn<T, TKey, TUtils, any>;\n```\n\nDefined in: [packages/db/src/types.ts:917](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L917)\n\nOptional asynchronous handler function called before an update operation\nReturning a value is deprecated; coordinate synchronization through collection utilities instead.\n\n#### Examples\n\n```ts\n// Basic update handler\nonUpdate: async ({ transaction, collection }) => {\n  const updatedItem = transaction.mutations[0].modified\n  await api.updateTodo(updatedItem.id, updatedItem)\n}\n```\n\n```ts\n// Update handler with refetch (Query Collection)\nonUpdate: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const changes = mutation.changes // Only the changed fields\n  await api.updateTodo(mutation.original.id, changes)\n  // Trigger refetch to sync server state\n  await collection.utils.refetch()\n  // Prevent the pre-1.0 compatibility wrapper from refetching again.\n  return { refetch: false }\n}\n```\n\n```ts\n// Update handler with sync wait (Electric Collection)\nonUpdate: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const result = await api.updateTodo(mutation.original.id, mutation.changes)\n  // Wait for txid to sync\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Update handler with multiple items\nonUpdate: async ({ transaction, collection }) => {\n  const updates = transaction.mutations.map(m => ({\n    id: m.key,\n    changes: m.changes\n  }))\n  await api.updateTodos(updates)\n  await collection.utils.refetch()\n  return { refetch: false }\n}\n```\n\n```ts\n// Update handler with optimistic rollback\nonUpdate: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  try {\n    await api.updateTodo(mutation.original.id, mutation.changes)\n  } catch (error) {\n    // Transaction will automatically rollback optimistic changes\n    console.error('Update failed, rolling back:', error)\n    throw error\n  }\n}\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`onUpdate`](BaseCollectionConfig.md#onupdate)\n\n***\n\n### schema?\n\n```ts\noptional schema: TSchema;\n```\n\nDefined in: [packages/db/src/types.ts:727](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L727)\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`schema`](BaseCollectionConfig.md#schema)\n\n***\n\n### startSync?\n\n```ts\noptional startSync: boolean;\n```\n\nDefined in: [packages/db/src/types.ts:757](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L757)\n\nWhether to eagerly start syncing on collection creation.\nWhen true, syncing begins immediately. When false, syncing starts when the first subscriber attaches.\n\nNote: Even with startSync=true, collections will pause syncing when there are no active\nsubscribers (typically when components querying the collection unmount), resuming when new\nsubscribers attach. This preserves normal staleTime/gcTime behavior.\n\n#### Default\n\n```ts\nfalse\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`startSync`](BaseCollectionConfig.md#startsync)\n\n***\n\n### sync\n\n```ts\nsync: SyncConfig<T, TKey>;\n```\n\nDefined in: [packages/db/src/types.ts:998](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L998)\n\n***\n\n### syncMode?\n\n```ts\noptional syncMode: SyncMode;\n```\n\nDefined in: [packages/db/src/types.ts:801](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L801)\n\nThe mode of sync to use for the collection.\n\n#### Default\n\n`eager`\n\n#### Description\n\n- `eager`: syncs all data immediately on preload\n- `on-demand`: syncs data in incremental snapshots when the collection is queried\nThe exact implementation of the sync mode is up to the sync implementation.\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`syncMode`](BaseCollectionConfig.md#syncmode)\n\n***\n\n### utils?\n\n```ts\noptional utils: TUtils;\n```\n\nDefined in: [packages/db/src/types.ts:989](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L989)\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`utils`](BaseCollectionConfig.md#utils)\n","originalRawMarkdown":"---\nid: CollectionConfig\ntitle: CollectionConfig\n---\n\nDefined in: [packages/db/src/types.ts:992](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L992)\n\n## Extends\n\n- [`BaseCollectionConfig`](BaseCollectionConfig.md)\\<`T`, `TKey`, `TSchema`, `TUtils`\\>\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\n### TSchema\n\n`TSchema` *extends* `StandardSchemaV1` = `never`\n\n### TUtils\n\n`TUtils` *extends* [`UtilsRecord`](../type-aliases/UtilsRecord.md) = [`UtilsRecord`](../type-aliases/UtilsRecord.md)\n\n## Properties\n\n### autoIndex?\n\n```ts\noptional autoIndex: \"off\" | \"eager\";\n```\n\nDefined in: [packages/db/src/types.ts:767](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L767)\n\nAuto-indexing mode for the collection.\nWhen enabled, indexes will be automatically created for simple where expressions.\n\n#### Default\n\n```ts\n\"off\"\n```\n\n#### Description\n\n- \"off\": No automatic indexing (default). Use explicit indexes for better bundle size.\n- \"eager\": Automatically create indexes for simple where expressions in subscribeChanges.\n           Requires setting defaultIndexType.\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`autoIndex`](BaseCollectionConfig.md#autoindex)\n\n***\n\n### compare()?\n\n```ts\noptional compare: (x, y) => number;\n```\n\nDefined in: [packages/db/src/types.ts:792](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L792)\n\nOptional function to compare two items.\nThis is used to order the items in the collection.\n\n#### Parameters\n\n##### x\n\n`T`\n\nThe first item to compare\n\n##### y\n\n`T`\n\nThe second item to compare\n\n#### Returns\n\n`number`\n\nA number indicating the order of the items\n\n#### Example\n\n```ts\n// For a collection with a 'createdAt' field\ncompare: (x, y) => x.createdAt.getTime() - y.createdAt.getTime()\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`compare`](BaseCollectionConfig.md#compare)\n\n***\n\n### defaultIndexType?\n\n```ts\noptional defaultIndexType: IndexConstructor<TKey>;\n```\n\nDefined in: [packages/db/src/types.ts:781](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L781)\n\nDefault index type to use when creating indexes without an explicit type.\nRequired for auto-indexing. Import from '@tanstack/db'.\n\n#### Example\n\n```ts\nimport { BasicIndex } from '@tanstack/db'\nconst collection = createCollection({\n  defaultIndexType: BasicIndex,\n  autoIndex: 'eager',\n  // ...\n})\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`defaultIndexType`](BaseCollectionConfig.md#defaultindextype)\n\n***\n\n### defaultStringCollation?\n\n```ts\noptional defaultStringCollation: StringCollationConfig;\n```\n\nDefined in: [packages/db/src/types.ts:987](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L987)\n\nSpecifies how to compare data in the collection.\nThis should be configured to match data ordering on the backend.\nE.g., when using the Electric DB collection these options\n      should match the database's collation settings.\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`defaultStringCollation`](BaseCollectionConfig.md#defaultstringcollation)\n\n***\n\n### gcTime?\n\n```ts\noptional gcTime: number;\n```\n\nDefined in: [packages/db/src/types.ts:746](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L746)\n\nTime in milliseconds after which the collection will be garbage collected\nwhen it has no active subscribers. Defaults to 5 minutes (300000ms).\nSync started without subscribers gets a minimum 50ms grace period.\nPending preloads retain the collection until they settle. Preloading ready\ndata refreshes the retention period. A non-positive or non-finite value\ndisables automatic garbage collection.\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`gcTime`](BaseCollectionConfig.md#gctime)\n\n***\n\n### getKey()\n\n```ts\ngetKey: (item) => TKey;\n```\n\nDefined in: [packages/db/src/types.ts:737](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L737)\n\nFunction to extract the ID from an object\nThis is required for update/delete operations which now only accept IDs\n\n#### Parameters\n\n##### item\n\n`T`\n\nThe item to extract the ID from\n\n#### Returns\n\n`TKey`\n\nThe ID string for the item\n\n#### Example\n\n```ts\n// For a collection with a 'uuid' field as the primary key\ngetKey: (item) => item.uuid\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`getKey`](BaseCollectionConfig.md#getkey)\n\n***\n\n### id?\n\n```ts\noptional id: string;\n```\n\nDefined in: [packages/db/src/types.ts:726](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L726)\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`id`](BaseCollectionConfig.md#id)\n\n***\n\n### onDelete?\n\n```ts\noptional onDelete: \n  | DeleteMutationFn<T, TKey, TUtils, void>\n| DeleteMutationFn<T, TKey, TUtils, any>;\n```\n\nDefined in: [packages/db/src/types.ts:976](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L976)\n\nOptional asynchronous handler function called before a delete operation\nReturning a value is deprecated; coordinate synchronization through collection utilities instead.\n\n#### Examples\n\n```ts\n// Basic delete handler\nonDelete: async ({ transaction, collection }) => {\n  const deletedKey = transaction.mutations[0].key\n  await api.deleteTodo(deletedKey)\n}\n```\n\n```ts\n// Delete handler with refetch (Query Collection)\nonDelete: async ({ transaction, collection }) => {\n  const keysToDelete = transaction.mutations.map(m => m.key)\n  await api.deleteTodos(keysToDelete)\n  // Trigger refetch to sync server state\n  await collection.utils.refetch()\n  // Prevent the pre-1.0 compatibility wrapper from refetching again.\n  return { refetch: false }\n}\n```\n\n```ts\n// Delete handler with sync wait (Electric Collection)\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const result = await api.deleteTodo(mutation.original.id)\n  // Wait for txid to sync\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Delete handler with confirmation\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const shouldDelete = await confirmDeletion(mutation.original)\n  if (!shouldDelete) {\n    throw new Error('Delete cancelled by user')\n  }\n  await api.deleteTodo(mutation.original.id)\n}\n```\n\n```ts\n// Delete handler with optimistic rollback\nonDelete: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  try {\n    await api.deleteTodo(mutation.original.id)\n  } catch (error) {\n    // Transaction will automatically rollback optimistic changes\n    console.error('Delete failed, rolling back:', error)\n    throw error\n  }\n}\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`onDelete`](BaseCollectionConfig.md#ondelete)\n\n***\n\n### onInsert?\n\n```ts\noptional onInsert: \n  | InsertMutationFn<T, TKey, TUtils, void>\n| InsertMutationFn<T, TKey, TUtils, any>;\n```\n\nDefined in: [packages/db/src/types.ts:855](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L855)\n\nOptional asynchronous handler function called before an insert operation\nReturning a value is deprecated; coordinate synchronization through collection utilities instead.\n\n#### Examples\n\n```ts\n// Basic insert handler\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  await api.createTodo(newItem)\n}\n```\n\n```ts\n// Insert handler with refetch (Query Collection)\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  await api.createTodo(newItem)\n  // Trigger refetch to sync server state\n  await collection.utils.refetch()\n  // Prevent the pre-1.0 compatibility wrapper from refetching again.\n  return { refetch: false }\n}\n```\n\n```ts\n// Insert handler with sync wait (Electric Collection)\nonInsert: async ({ transaction, collection }) => {\n  const newItem = transaction.mutations[0].modified\n  const result = await api.createTodo(newItem)\n  // Wait for txid to sync\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Insert handler with multiple items\nonInsert: async ({ transaction, collection }) => {\n  const items = transaction.mutations.map(m => m.modified)\n  await api.createTodos(items)\n  // Refetch to get updated data from server\n  await collection.utils.refetch()\n  return { refetch: false }\n}\n```\n\n```ts\n// Insert handler with error handling\nonInsert: async ({ transaction, collection }) => {\n  try {\n    const newItem = transaction.mutations[0].modified\n    await api.createTodo(newItem)\n  } catch (error) {\n    console.error('Insert failed:', error)\n    throw error // This will cause the transaction to rollback\n  }\n}\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`onInsert`](BaseCollectionConfig.md#oninsert)\n\n***\n\n### onUpdate?\n\n```ts\noptional onUpdate: \n  | UpdateMutationFn<T, TKey, TUtils, void>\n| UpdateMutationFn<T, TKey, TUtils, any>;\n```\n\nDefined in: [packages/db/src/types.ts:917](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L917)\n\nOptional asynchronous handler function called before an update operation\nReturning a value is deprecated; coordinate synchronization through collection utilities instead.\n\n#### Examples\n\n```ts\n// Basic update handler\nonUpdate: async ({ transaction, collection }) => {\n  const updatedItem = transaction.mutations[0].modified\n  await api.updateTodo(updatedItem.id, updatedItem)\n}\n```\n\n```ts\n// Update handler with refetch (Query Collection)\nonUpdate: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const changes = mutation.changes // Only the changed fields\n  await api.updateTodo(mutation.original.id, changes)\n  // Trigger refetch to sync server state\n  await collection.utils.refetch()\n  // Prevent the pre-1.0 compatibility wrapper from refetching again.\n  return { refetch: false }\n}\n```\n\n```ts\n// Update handler with sync wait (Electric Collection)\nonUpdate: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  const result = await api.updateTodo(mutation.original.id, mutation.changes)\n  // Wait for txid to sync\n  await collection.utils.awaitTxId(result.txid)\n}\n```\n\n```ts\n// Update handler with multiple items\nonUpdate: async ({ transaction, collection }) => {\n  const updates = transaction.mutations.map(m => ({\n    id: m.key,\n    changes: m.changes\n  }))\n  await api.updateTodos(updates)\n  await collection.utils.refetch()\n  return { refetch: false }\n}\n```\n\n```ts\n// Update handler with optimistic rollback\nonUpdate: async ({ transaction, collection }) => {\n  const mutation = transaction.mutations[0]\n  try {\n    await api.updateTodo(mutation.original.id, mutation.changes)\n  } catch (error) {\n    // Transaction will automatically rollback optimistic changes\n    console.error('Update failed, rolling back:', error)\n    throw error\n  }\n}\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`onUpdate`](BaseCollectionConfig.md#onupdate)\n\n***\n\n### schema?\n\n```ts\noptional schema: TSchema;\n```\n\nDefined in: [packages/db/src/types.ts:727](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L727)\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`schema`](BaseCollectionConfig.md#schema)\n\n***\n\n### startSync?\n\n```ts\noptional startSync: boolean;\n```\n\nDefined in: [packages/db/src/types.ts:757](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L757)\n\nWhether to eagerly start syncing on collection creation.\nWhen true, syncing begins immediately. When false, syncing starts when the first subscriber attaches.\n\nNote: Even with startSync=true, collections will pause syncing when there are no active\nsubscribers (typically when components querying the collection unmount), resuming when new\nsubscribers attach. This preserves normal staleTime/gcTime behavior.\n\n#### Default\n\n```ts\nfalse\n```\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`startSync`](BaseCollectionConfig.md#startsync)\n\n***\n\n### sync\n\n```ts\nsync: SyncConfig<T, TKey>;\n```\n\nDefined in: [packages/db/src/types.ts:998](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L998)\n\n***\n\n### syncMode?\n\n```ts\noptional syncMode: SyncMode;\n```\n\nDefined in: [packages/db/src/types.ts:801](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L801)\n\nThe mode of sync to use for the collection.\n\n#### Default\n\n`eager`\n\n#### Description\n\n- `eager`: syncs all data immediately on preload\n- `on-demand`: syncs data in incremental snapshots when the collection is queried\nThe exact implementation of the sync mode is up to the sync implementation.\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`syncMode`](BaseCollectionConfig.md#syncmode)\n\n***\n\n### utils?\n\n```ts\noptional utils: TUtils;\n```\n\nDefined in: [packages/db/src/types.ts:989](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L989)\n\n#### Inherited from\n\n[`BaseCollectionConfig`](BaseCollectionConfig.md).[`utils`](BaseCollectionConfig.md#utils)\n"}
