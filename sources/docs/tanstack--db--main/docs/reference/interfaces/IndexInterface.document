tion","level":5},{"id":"returns-9","text":"Returns","level":4},{"id":"matchesfield","text":"matchesField()","level":3},{"id":"parameters-9","text":"Parameters","level":4},{"id":"fieldpath","text":"fieldPath","level":5},{"id":"returns-10","text":"Returns","level":4},{"id":"rangequery","text":"rangeQuery()","level":3},{"id":"parameters-10","text":"Parameters","level":4},{"id":"options","text":"options","level":5},{"id":"returns-11","text":"Returns","level":4},{"id":"rangequeryreversed","text":"rangeQueryReversed()","level":3},{"id":"parameters-11","text":"Parameters","level":4},{"id":"options-2","text":"options","level":5},{"id":"returns-12","text":"Returns","level":4},{"id":"remove","text":"remove()","level":3},{"id":"parameters-12","text":"Parameters","level":4},{"id":"key-2","text":"key","level":5},{"id":"item-2","text":"item","level":5},{"id":"returns-13","text":"Returns","level":4},{"id":"supports","text":"supports()","level":3},{"id":"parameters-13","text":"Parameters","level":4},{"id":"operation-2","text":"operation","level":5},{"id":"returns-14","text":"Returns","level":4},{"id":"take","text":"take()","level":3},{"id":"parameters-14","text":"Parameters","level":4},{"id":"n","text":"n","level":5},{"id":"from","text":"from","level":5},{"id":"filterfn","text":"filterFn?","level":5},{"id":"returns-15","text":"Returns","level":4},{"id":"takefromstart","text":"takeFromStart()","level":3},{"id":"parameters-15","text":"Parameters","level":4},{"id":"n-2","text":"n","level":5},{"id":"filterfn-2","text":"filterFn?","level":5},{"id":"returns-16","text":"Returns","level":4},{"id":"takereversed","text":"takeReversed()","level":3},{"id":"parameters-16","text":"Parameters","level":4},{"id":"n-3","text":"n","level":5},{"id":"from-2","text":"from","level":5},{"id":"filterfn-3","text":"filterFn?","level":5},{"id":"returns-17","text":"Returns","level":4},{"id":"takereversedfromend","text":"takeReversedFromEnd()","level":3},{"id":"parameters-17","text":"Parameters","level":4},{"id