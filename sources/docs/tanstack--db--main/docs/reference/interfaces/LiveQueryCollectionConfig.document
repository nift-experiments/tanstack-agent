 using the key from the D2 stream"}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"item","children":[{"type":"text","value":"item"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TResult"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"id","children":[{"type":"text","value":"id?"}]},{"type":"code","value":"optional id: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L73","children":[{"type":"text","value":"packages/db/src/query/live/types.ts:73"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Unique identifier for the collection\nIf not provided, defaults to "},{"type":"inlineCode","value":"live-query-${number}"},{"type":"text","value":" with auto-incrementing number"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"ondelete","children":[{"type":"text","value":"onDelete?"}]},{"type":"code","value":"optional onDelete: \n  | DeleteMutationFn<TResult, string | number, UtilsRecord, void>\n| DeleteMutationFn<TResult, string | number, UtilsRecord, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L100","children":[{"type":"text","value":"packages/db/src/query/live/types.ts:100"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"oninsert","children":[{"type":"text","value":"onInsert?"}]},{"type":"code","value":"optional onInsert: \n  | InsertMutationFn<TResult, string | number, UtilsRecord, void>\n| InsertMutationFn<TResult, string | number, UtilsRecord, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L98","children":[{"type":"text","value":"packages/db/src/query/live/types.ts:98"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional mutation handlers"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onupdate","children":[{"type":"text","value":"onUpdate?"}]},{"type":"code","value":"optional onUpdate: \n  | UpdateMutationFn<TResult, string | number, UtilsRecord, void>\n| UpdateMutationFn<TResult, string | number, UtilsRecord, any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L99","children":[{"type":"text","value":"packages/db/src/query/live/types.ts:99"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"query","children":[{"type":"text","value":"query"}]},{"type":"code","value":"query: \n  | (q) => QueryBuilder<TContext> & RootObjectResultConstraint<TContext>\n| QueryBuilder<TContext> & RootObjectResultConstraint<TContext>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L78","children":[{"type":"text","value":"packages/db/src/query/live/types.ts:78"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Query builder function that defines the live query"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"schema","children":[{"type":"text","value":"schema?"}]},{"type":"code","value":"optional schema: undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L93","children":[{"type":"text","value":"packages/db/src/query/live/types.ts:93"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional schema for validation"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"singleresult","children":[{"type":"text","value":"singleResult?"}]},{"type":"code","value":"optional singleResult: true;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L115","children":[{"type":"text","value":"packages/db/src/query/live/types.ts:115"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If enabled the collection will return a single object instead of an array"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"startsync","children":[{"type":"text","value":"startSync?"}]},{"type":"code","value":"optional startSync: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L105","children":[{"type":"text","value":"packages/db/src/query/live/types.ts:105"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Start sync / the query immediately"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tcontext","text":"TContext","level":3},{"id":"tresult","text":"TResult","level":3},{"id":"properties","text":"Properties","level":2},{"id":"defaultstringcollation","text":"defaultStringCollation?","level":3},{"id":"gctime","text":"gcTime?","level":3},{"id":"getkey","text":"getKey()?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"item","text":"item","level":5},{"id":"returns","text":"Returns","level":4},{"id":"id","text":"id?","level":3},{"id":"ondelete","text":"onDelete?","level":3},{"id":"oninsert","text":"onInsert?","level":3},{"id":"onupdate","text":"onUpdate?","level":3},{"id":"query","text":"query","level":3},{"id":"schema","text":"schema?","level":3},{"id":"singleresult","text":"singleResult?","level":3},{"id":"startsync","text":"startSync?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/db/src/query/live/types.ts:65](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L65)\n\nConfiguration interface for live query collection options\n\n## Example\n\n```typescript\nconst config: LiveQueryCollectionConfig<any, any> = {\n  // id is optional - will auto-generate \"live-query-1\", \"live-query-2\", etc.\n  query: (q) => q\n    .from({ comment: commentsCollection })\n    .join(\n      { user: usersCollection },\n      ({ comment, user }) => eq(comment.user_id, user.id)\n    )\n    .where(({ comment }) => eq(comment.active, true))\n    .select(({ comment, user }) => ({\n      id: comment.id,\n      content: comment.content,\n      authorName: user.name,\n    })),\n  // getKey is optional - defaults to using stream key\n  getKey: (item) => item.id,\n}\n```\n\n## Type Parameters\n\n### TContext\n\n`TContext` *extends* [`Context`](Context.md)\n\n### TResult\n\n`TResult` *extends* `object` = `RootQueryResult`\\<`TContext`\\>\n\n## Properties\n\n### defaultStringCollation?\n\n```ts\noptional defaultStringCollation: StringCollationConfig;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:121](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L121)\n\nOptional compare options for string sorting.\nIf provided, these will be used instead of inheriting from the FROM collection.\n\n***\n\n### gcTime?\n\n```ts\noptional gcTime: number;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:110](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L110)\n\nGC time for the collection\n\n***\n\n### getKey()?\n\n```ts\noptional getKey: (item) => string | number;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:88](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L88)\n\nFunction to extract the key from result items\nIf not provided, defaults to using the key from the D2 stream\n\n#### Parameters\n\n##### item\n\n`TResult`\n\n#### Returns\n\n`string` \\| `number`\n\n***\n\n### id?\n\n```ts\noptional id: string;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:73](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L73)\n\nUnique identifier for the collection\nIf not provided, defaults to `live-query-${number}` with auto-incrementing number\n\n***\n\n### onDelete?\n\n```ts\noptional onDelete: \n  | DeleteMutationFn<TResult, string | number, UtilsRecord, void>\n| DeleteMutationFn<TResult, string | number, UtilsRecord, any>;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:100](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L100)\n\n***\n\n### onInsert?\n\n```ts\noptional onInsert: \n  | InsertMutationFn<TResult, string | number, UtilsRecord, void>\n| InsertMutationFn<TResult, string | number, UtilsRecord, any>;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:98](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L98)\n\nOptional mutation handlers\n\n***\n\n### onUpdate?\n\n```ts\noptional onUpdate: \n  | UpdateMutationFn<TResult, string | number, UtilsRecord, void>\n| UpdateMutationFn<TResult, string | number, UtilsRecord, any>;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:99](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L99)\n\n***\n\n### query\n\n```ts\nquery: \n  | (q) => QueryBuilder<TContext> & RootObjectResultConstraint<TContext>\n| QueryBuilder<TContext> & RootObjectResultConstraint<TContext>;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:78](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L78)\n\nQuery builder function that defines the live query\n\n***\n\n### schema?\n\n```ts\noptional schema: undefined;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:93](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L93)\n\nOptional schema for validation\n\n***\n\n### singleResult?\n\n```ts\noptional singleResult: true;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:115](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L115)\n\nIf enabled the collection will return a single object instead of an array\n\n***\n\n### startSync?\n\n```ts\noptional startSync: boolean;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:105](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L105)\n\nStart sync / the query immediately\n","originalRawMarkdown":"---\nid: LiveQueryCollectionConfig\ntitle: LiveQueryCollectionConfig\n---\n\nDefined in: [packages/db/src/query/live/types.ts:65](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L65)\n\nConfiguration interface for live query collection options\n\n## Example\n\n```typescript\nconst config: LiveQueryCollectionConfig<any, any> = {\n  // id is optional - will auto-generate \"live-query-1\", \"live-query-2\", etc.\n  query: (q) => q\n    .from({ comment: commentsCollection })\n    .join(\n      { user: usersCollection },\n      ({ comment, user }) => eq(comment.user_id, user.id)\n    )\n    .where(({ comment }) => eq(comment.active, true))\n    .select(({ comment, user }) => ({\n      id: comment.id,\n      content: comment.content,\n      authorName: user.name,\n    })),\n  // getKey is optional - defaults to using stream key\n  getKey: (item) => item.id,\n}\n```\n\n## Type Parameters\n\n### TContext\n\n`TContext` *extends* [`Context`](Context.md)\n\n### TResult\n\n`TResult` *extends* `object` = `RootQueryResult`\\<`TContext`\\>\n\n## Properties\n\n### defaultStringCollation?\n\n```ts\noptional defaultStringCollation: StringCollationConfig;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:121](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L121)\n\nOptional compare options for string sorting.\nIf provided, these will be used instead of inheriting from the FROM collection.\n\n***\n\n### gcTime?\n\n```ts\noptional gcTime: number;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:110](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L110)\n\nGC time for the collection\n\n***\n\n### getKey()?\n\n```ts\noptional getKey: (item) => string | number;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:88](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L88)\n\nFunction to extract the key from result items\nIf not provided, defaults to using the key from the D2 stream\n\n#### Parameters\n\n##### item\n\n`TResult`\n\n#### Returns\n\n`string` \\| `number`\n\n***\n\n### id?\n\n```ts\noptional id: string;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:73](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L73)\n\nUnique identifier for the collection\nIf not provided, defaults to `live-query-${number}` with auto-incrementing number\n\n***\n\n### onDelete?\n\n```ts\noptional onDelete: \n  | DeleteMutationFn<TResult, string | number, UtilsRecord, void>\n| DeleteMutationFn<TResult, string | number, UtilsRecord, any>;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:100](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L100)\n\n***\n\n### onInsert?\n\n```ts\noptional onInsert: \n  | InsertMutationFn<TResult, string | number, UtilsRecord, void>\n| InsertMutationFn<TResult, string | number, UtilsRecord, any>;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:98](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L98)\n\nOptional mutation handlers\n\n***\n\n### onUpdate?\n\n```ts\noptional onUpdate: \n  | UpdateMutationFn<TResult, string | number, UtilsRecord, void>\n| UpdateMutationFn<TResult, string | number, UtilsRecord, any>;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:99](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L99)\n\n***\n\n### query\n\n```ts\nquery: \n  | (q) => QueryBuilder<TContext> & RootObjectResultConstraint<TContext>\n| QueryBuilder<TContext> & RootObjectResultConstraint<TContext>;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:78](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L78)\n\nQuery builder function that defines the live query\n\n***\n\n### schema?\n\n```ts\noptional schema: undefined;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:93](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L93)\n\nOptional schema for validation\n\n***\n\n### singleResult?\n\n```ts\noptional singleResult: true;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:115](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L115)\n\nIf enabled the collection will return a single object instead of an array\n\n***\n\n### startSync?\n\n```ts\noptional startSync: boolean;\n```\n\nDefined in: [packages/db/src/query/live/types.ts:105](https://github.com/TanStack/db/blob/main/packages/db/src/query/live/types.ts#L105)\n\nStart sync / the query immediately\n"}
