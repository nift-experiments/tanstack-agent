:"text","value":"isReady"}]},{"type":"code","value":"isReady: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L89","children":[{"type":"text","value":"packages/db/src/live-query-observer.ts:89"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"layoutrevision","children":[{"type":"text","value":"layoutRevision"}]},{"type":"code","value":"layoutRevision: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L86","children":[{"type":"text","value":"packages/db/src/live-query-observer.ts:86"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Monotonic counter bumped whenever the visible layout (the ordered key\nsequence) changes — membership, ordering, or an order-only move. Lets\nconsumers detect a reorder that changed no row value (which "},{"type":"inlineCode","value":"data"},{"type":"text","value":"/"},{"type":"inlineCode","value":"state"},{"type":"text","value":"\nidentity alone can't express once row values are structurally shared)."}]},{"type":"paragraph","children":[{"type":"text","value":"It is NOT in lockstep with snapshot identity: a value-only update produces a\nnew snapshot while "},{"type":"inlineCode","value":"layoutRevision"},{"type":"text","value":" stays put. A "},{"type":"inlineCode","value":"layoutRevision"},{"type":"text","value":" change\nalways accompanies a new snapshot, but not vice versa."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"persistederror","children":[{"type":"text","value":"persistedError"}]},{"type":"code","value":"persistedError: unknown;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L93","children":[{"type":"text","value":"packages/db/src/live-query-observer.ts:93"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"persistedstatus","children":[{"type":"text","value":"persistedStatus"}]},{"type":"code","value":"persistedStatus: LiveQueryPersistedStatus;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L91","children":[{"type":"text","value":"packages/db/src/live-query-observer.ts:91"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Persisted restore is separate from upstream/Collection readiness."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"state","children":[{"type":"text","value":"state"}]},{"type":"code","value":"state: ReadonlyMap<TKey, T> | undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L71","children":[{"type":"text","value":"packages/db/src/live-query-observer.ts:71"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Keyed results, or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" for a disabled query."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"status","children":[{"type":"text","value":"status"}]},{"type":"code","value":"status: CollectionStatus | \"disabled\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L87","children":[{"type":"text","value":"packages/db/src/live-query-observer.ts:87"}]}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"tkey","text":"TKey","level":3},{"id":"properties","text":"Properties","level":2},{"id":"collection","text":"collection","level":3},{"id":"data","text":"data","level":3},{"id":"iscleanedup","text":"isCleanedUp","level":3},{"id":"isenabled","text":"isEnabled","level":3},{"id":"iserror","text":"isError","level":3},{"id":"isidle","text":"isIdle","level":3},{"id":"isloading","text":"isLoading","level":3},{"id":"ispersistedready","text":"isPersistedReady","level":3},{"id":"isready","text":"isReady","level":3},{"id":"layoutrevision","text":"layoutRevision","level":3},{"id":"persistederror","text":"persistedError","level":3},{"id":"persistedstatus","text":"persistedStatus","level":3},{"id":"state","text":"state","level":3},{"id":"status","text":"status","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/db/src/live-query-observer.ts:66](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L66)\n\nThe canonical, adapter-agnostic view of a live query at a point in time.\n\n`getSnapshot()` returns a stable object identity that only changes when the\nquery changes, so `useSyncExternalStore`-style consumers can compare by\nreference. Each snapshot owns a captured view of `state`/`data`, so reading\nan older snapshot cannot expose rows from a later revision.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object`\n\n### TKey\n\n`TKey` *extends* `string` \\| `number`\n\n## Properties\n\n### collection\n\n```ts\ncollection: \n  | Collection<T, TKey, any, StandardSchemaV1<unknown, unknown>, T>\n  | undefined;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:75](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L75)\n\nThe underlying collection, or `undefined` when disabled.\n\n***\n\n### data\n\n```ts\ndata: T | readonly T[] | undefined;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:73](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L73)\n\nOrdered results (single row for `findOne`), or `undefined` when disabled.\n\n***\n\n### isCleanedUp\n\n```ts\nisCleanedUp: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:96](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L96)\n\n***\n\n### isEnabled\n\n```ts\nisEnabled: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:97](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L97)\n\n***\n\n### isError\n\n```ts\nisError: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:95](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L95)\n\n***\n\n### isIdle\n\n```ts\nisIdle: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:94](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L94)\n\n***\n\n### isLoading\n\n```ts\nisLoading: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:88](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L88)\n\n***\n\n### isPersistedReady\n\n```ts\nisPersistedReady: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:92](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L92)\n\n***\n\n### isReady\n\n```ts\nisReady: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:89](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L89)\n\n***\n\n### layoutRevision\n\n```ts\nlayoutRevision: number;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:86](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L86)\n\nMonotonic counter bumped whenever the visible layout (the ordered key\nsequence) changes — membership, ordering, or an order-only move. Lets\nconsumers detect a reorder that changed no row value (which `data`/`state`\nidentity alone can't express once row values are structurally shared).\n\nIt is NOT in lockstep with snapshot identity: a value-only update produces a\nnew snapshot while `layoutRevision` stays put. A `layoutRevision` change\nalways accompanies a new snapshot, but not vice versa.\n\n***\n\n### persistedError\n\n```ts\npersistedError: unknown;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:93](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L93)\n\n***\n\n### persistedStatus\n\n```ts\npersistedStatus: LiveQueryPersistedStatus;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:91](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L91)\n\nPersisted restore is separate from upstream/Collection readiness.\n\n***\n\n### state\n\n```ts\nstate: ReadonlyMap<TKey, T> | undefined;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:71](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L71)\n\nKeyed results, or `undefined` for a disabled query.\n\n***\n\n### status\n\n```ts\nstatus: CollectionStatus | \"disabled\";\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:87](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L87)\n","originalRawMarkdown":"---\nid: LiveQuerySnapshot\ntitle: LiveQuerySnapshot\n---\n\nDefined in: [packages/db/src/live-query-observer.ts:66](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L66)\n\nThe canonical, adapter-agnostic view of a live query at a point in time.\n\n`getSnapshot()` returns a stable object identity that only changes when the\nquery changes, so `useSyncExternalStore`-style consumers can compare by\nreference. Each snapshot owns a captured view of `state`/`data`, so reading\nan older snapshot cannot expose rows from a later revision.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object`\n\n### TKey\n\n`TKey` *extends* `string` \\| `number`\n\n## Properties\n\n### collection\n\n```ts\ncollection: \n  | Collection<T, TKey, any, StandardSchemaV1<unknown, unknown>, T>\n  | undefined;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:75](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L75)\n\nThe underlying collection, or `undefined` when disabled.\n\n***\n\n### data\n\n```ts\ndata: T | readonly T[] | undefined;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:73](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L73)\n\nOrdered results (single row for `findOne`), or `undefined` when disabled.\n\n***\n\n### isCleanedUp\n\n```ts\nisCleanedUp: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:96](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L96)\n\n***\n\n### isEnabled\n\n```ts\nisEnabled: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:97](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L97)\n\n***\n\n### isError\n\n```ts\nisError: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:95](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L95)\n\n***\n\n### isIdle\n\n```ts\nisIdle: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:94](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L94)\n\n***\n\n### isLoading\n\n```ts\nisLoading: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:88](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L88)\n\n***\n\n### isPersistedReady\n\n```ts\nisPersistedReady: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:92](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L92)\n\n***\n\n### isReady\n\n```ts\nisReady: boolean;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:89](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L89)\n\n***\n\n### layoutRevision\n\n```ts\nlayoutRevision: number;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:86](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L86)\n\nMonotonic counter bumped whenever the visible layout (the ordered key\nsequence) changes — membership, ordering, or an order-only move. Lets\nconsumers detect a reorder that changed no row value (which `data`/`state`\nidentity alone can't express once row values are structurally shared).\n\nIt is NOT in lockstep with snapshot identity: a value-only update produces a\nnew snapshot while `layoutRevision` stays put. A `layoutRevision` change\nalways accompanies a new snapshot, but not vice versa.\n\n***\n\n### persistedError\n\n```ts\npersistedError: unknown;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:93](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L93)\n\n***\n\n### persistedStatus\n\n```ts\npersistedStatus: LiveQueryPersistedStatus;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:91](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L91)\n\nPersisted restore is separate from upstream/Collection readiness.\n\n***\n\n### state\n\n```ts\nstate: ReadonlyMap<TKey, T> | undefined;\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:71](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L71)\n\nKeyed results, or `undefined` for a disabled query.\n\n***\n\n### status\n\n```ts\nstatus: CollectionStatus | \"disabled\";\n```\n\nDefined in: [packages/db/src/live-query-observer.ts:87](https://github.com/TanStack/db/blob/main/packages/db/src/live-query-observer.ts#L87)\n"}
