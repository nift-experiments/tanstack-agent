"text","value":"The transaction containing mutations to accept"}]},{"type":"heading","depth":6,"id":"mutations","children":[{"type":"text","value":"mutations"}]},{"type":"paragraph","children":[{"type":"link","href":"PendingMutation.md","children":[{"type":"inlineCode","value":"PendingMutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">, "},{"type":"link","href":"../type-aliases/OperationType.md","children":[{"type":"inlineCode","value":"OperationType"}]},{"type":"text","value":", "},{"type":"link","href":"Collection.md","children":[{"type":"inlineCode","value":"Collection"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">, "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">>[]"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const localSettings = createCollection(localStorageCollectionOptions({...}))\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Make API call first\n    await api.save(...)\n    // Then persist local-storage mutations after success\n    await localSettings.utils.acceptMutations(transaction)\n  }\n})","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"clearstorage","children":[{"type":"text","value":"clearStorage"}]},{"type":"code","value":"clearStorage: ClearStorageFn;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L103","children":[{"type":"text","value":"packages/db/src/local-storage.ts:103"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getstoragesize","children":[{"type":"text","value":"getStorageSize"}]},{"type":"code","value":"getStorageSize: GetStorageSizeFn;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L104","children":[{"type":"text","value":"packages/db/src/local-storage.ts:104"}]}]}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"indexable","text":"Indexable","level":2},{"id":"properties","text":"Properties","level":2},{"id":"acceptmutations","text":"acceptMutations()","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"transaction","text":"transaction","level":5},{"id":"mutations","text":"mutations","level":6},{"id":"returns","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"clearstorage","text":"clearStorage","level":3},{"id":"getstoragesize","text":"getStorageSize","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/db/src/local-storage.ts:102](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L102)\n\nLocalStorage collection utilities type\n\n## Extends\n\n- [`UtilsRecord`](../type-aliases/UtilsRecord.md)\n\n## Indexable\n\n```ts\n[key: string]: any\n```\n\n## Properties\n\n### acceptMutations()\n\n```ts\nacceptMutations: (transaction) => Promise<void>;\n```\n\nDefined in: [packages/db/src/local-storage.ts:122](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L122)\n\nAccepts mutations from a transaction that belong to this collection and persists them to localStorage.\nCall this in your transaction's mutationFn. Its persistence receipt follows the storage write even\nif the returned Promise is not awaited. Await it when later mutationFn work depends on the write.\n\n#### Parameters\n\n##### transaction\n\nThe transaction containing mutations to accept\n\n###### mutations\n\n[`PendingMutation`](PendingMutation.md)\\<`Record`\\<`string`, `unknown`\\>, [`OperationType`](../type-aliases/OperationType.md), [`Collection`](Collection.md)\\<`Record`\\<`string`, `unknown`\\>, `any`, `any`, `any`, `any`\\>\\>[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n#### Example\n\n```ts\nconst localSettings = createCollection(localStorageCollectionOptions({...}))\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Make API call first\n    await api.save(...)\n    // Then persist local-storage mutations after success\n    await localSettings.utils.acceptMutations(transaction)\n  }\n})\n```\n\n***\n\n### clearStorage\n\n```ts\nclearStorage: ClearStorageFn;\n```\n\nDefined in: [packages/db/src/local-storage.ts:103](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L103)\n\n***\n\n### getStorageSize\n\n```ts\ngetStorageSize: GetStorageSizeFn;\n```\n\nDefined in: [packages/db/src/local-storage.ts:104](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L104)\n","originalRawMarkdown":"---\nid: LocalStorageCollectionUtils\ntitle: LocalStorageCollectionUtils\n---\n\nDefined in: [packages/db/src/local-storage.ts:102](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L102)\n\nLocalStorage collection utilities type\n\n## Extends\n\n- [`UtilsRecord`](../type-aliases/UtilsRecord.md)\n\n## Indexable\n\n```ts\n[key: string]: any\n```\n\n## Properties\n\n### acceptMutations()\n\n```ts\nacceptMutations: (transaction) => Promise<void>;\n```\n\nDefined in: [packages/db/src/local-storage.ts:122](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L122)\n\nAccepts mutations from a transaction that belong to this collection and persists them to localStorage.\nCall this in your transaction's mutationFn. Its persistence receipt follows the storage write even\nif the returned Promise is not awaited. Await it when later mutationFn work depends on the write.\n\n#### Parameters\n\n##### transaction\n\nThe transaction containing mutations to accept\n\n###### mutations\n\n[`PendingMutation`](PendingMutation.md)\\<`Record`\\<`string`, `unknown`\\>, [`OperationType`](../type-aliases/OperationType.md), [`Collection`](Collection.md)\\<`Record`\\<`string`, `unknown`\\>, `any`, `any`, `any`, `any`\\>\\>[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n#### Example\n\n```ts\nconst localSettings = createCollection(localStorageCollectionOptions({...}))\n\nconst tx = createTransaction({\n  mutationFn: async ({ transaction }) => {\n    // Make API call first\n    await api.save(...)\n    // Then persist local-storage mutations after success\n    await localSettings.utils.acceptMutations(transaction)\n  }\n})\n```\n\n***\n\n### clearStorage\n\n```ts\nclearStorage: ClearStorageFn;\n```\n\nDefined in: [packages/db/src/local-storage.ts:103](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L103)\n\n***\n\n### getStorageSize\n\n```ts\ngetStorageSize: GetStorageSizeFn;\n```\n\nDefined in: [packages/db/src/local-storage.ts:104](https://github.com/TanStack/db/blob/main/packages/db/src/local-storage.ts#L104)\n"}
