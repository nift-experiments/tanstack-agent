lue":"optional error: object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L362","children":[{"type":"text","value":"packages/db/src/transactions.ts:362"}]}]},{"type":"heading","depth":4,"id":"error-2","children":[{"type":"text","value":"error"}]},{"type":"code","value":"error: Error;","lang":"ts"},{"type":"heading","depth":4,"id":"message","children":[{"type":"text","value":"message"}]},{"type":"code","value":"message: string;","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"id","children":[{"type":"text","value":"id"}]},{"type":"code","value":"id: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L338","children":[{"type":"text","value":"packages/db/src/transactions.ts:338"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"ispersisted","children":[{"type":"strike","children":[{"type":"text","value":"isPersisted"}]}]},{"type":"code","value":"isPersisted: Deferred<Transaction<T>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L357","children":[{"type":"text","value":"packages/db/src/transactions.ts:357"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Deferred that settles when this transaction settles."}]},{"type":"paragraph","children":[{"type":"text","value":"Await "},{"type":"inlineCode","value":"when('settled')"},{"type":"text","value":" instead. This legacy promise resolves\nwhen the transaction completes successfully and rejects if the transaction\nfails or is rolled back."}]},{"type":"paragraph","children":[{"type":"text","value":"For non-empty commits, the mutation function is the normal settlement\nboundary. This does not inherently prove that a backend has uploaded,\nconfirmed, or read back the write unless the mutation function waits for\nthat backend observation before returning."}]},{"type":"heading","depth":4,"id":"deprecated","children":[{"type":"text","value":"Deprecated"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"when('settled')"},{"type":"text","value":" instead. This alias will be removed in\nthe 1.0 RC."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"metadata","children":[{"type":"text","value":"metadata"}]},{"type":"code","value":"metadata: Record<string, unknown>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L361","children":[{"type":"text","value":"packages/db/src/transactions.ts:361"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"mutationfn","children":[{"type":"text","value":"mutationFn"}]},{"type":"code","value":"mutationFn: MutationFn<T>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L340","children":[{"type":"text","value":"packages/db/src/transactions.ts:340"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"mutations","children":[{"type":"text","value":"mutations"}]},{"type":"code","value":"mutations: PendingMutation<T, OperationType, Collection<T, any, any, any, any>>[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L341","children":[{"type":"text","value":"packages/db/src/transactions.ts:341"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"sequencenumber","children":[{"type":"text","value":"sequenceNumber"}]},{"type":"code","value":"sequenceNumber: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L360","children":[{"type":"text","value":"packages/db/src/transactions.ts:360"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"state","children":[{"type":"text","value":"state"}]},{"type":"code","value":"state: TransactionState;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L339","children":[{"type":"text","value":"packages/db/src/transactions.ts:339"}]}]},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"applymutations","children":[{"type":"text","value":"applyMutations()"}]},{"type":"code","value":"applyMutations(mutations): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L509","children":[{"type":"text","value":"packages/db/src/transactions.ts:509"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Apply new mutations to this transaction, intelligently merging with existing mutations"}]},{"type":"paragraph","children":[{"type":"text","value":"When mutations operate on the same item (same globalKey), they are merged according to\nthe following rules:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"insert + update"}]},{"type":"text","value":" → insert (merge changes, keep empty original)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"insert + delete"}]},{"type":"text","value":" → removed (mutations cancel each other out)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"update + delete"}]},{"type":"text","value":" → delete (delete dominates)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"update + update"}]},{"type":"text","value":" → update (union changes, keep first original)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"delete + insert"}]},{"type":"text","value":" → removed if restored, otherwise update"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"same type"}]},{"type":"text","value":" → replace with latest"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"This merging reduces over-the-wire churn and keeps the optimistic local view\naligned with user intent."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"mutations-2","children":[{"type":"text","value":"mutations"}]},{"type":"paragraph","children":[{"type":"link","href":"PendingMutation.md","children":[{"type":"inlineCode","value":"PendingMutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"link","href":"../type-aliases/OperationType.md","children":[{"type":"inlineCode","value":"OperationType"}]},{"type":"text","value":", "},{"type":"link","href":"Collection.md","children":[{"type":"inlineCode","value":"Collection"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">>[]"}]},{"type":"paragraph","children":[{"type":"text","value":"Array of new mutations to apply"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"commit","children":[{"type":"text","value":"commit()"}]},{"type":"code","value":"commit(): Promise<Transaction<T>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L674","children":[{"type":"text","value":"packages/db/src/transactions.ts:674"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Commit the transaction and execute the mutation function"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Transaction"},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Promise that resolves to this transaction when complete"}]},{"type":"heading","depth":4,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Manual commit (when autoCommit is false)\nconst tx = createTransaction({\n  autoCommit: false,\n  mutationFn: async ({ transaction }) => {\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n})\n\nawait tx.commit() // Manually commit","lang":"ts"},{"type":"code","value":"// Handle commit errors\ntry {\n  const tx = createTransaction({\n    mutationFn: async () => { throw new Error(\"API failed\") }\n  })\n\n  tx.mutate(() => {\n    collection.insert({ id: \"1\", text: \"Item\" })\n  })\n\n  await tx.commit()\n} catch (error) {\n  console.log('Commit failed, transaction rolled back:', error)\n}","lang":"ts"},{"type":"code","value":"// Check transaction state after commit\nawait tx.commit()\nconsole.log(tx.state) // \"completed\" or \"failed\"","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"comparecreatedat","children":[{"type":"text","value":"compareCreatedAt()"}]},{"type":"code","value":"compareCreatedAt(other): number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L735","children":[{"type":"text","value":"packages/db/src/transactions.ts:735"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Compare two transactions by their createdAt time and sequence number in order\nto sort them in the order they were created."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"other","children":[{"type":"text","value":"other"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Transaction"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The other transaction to compare to"}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"-1 if this transaction was created before the other, 1 if it was created after, 0 if they were created at the same time"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"mutate","children":[{"type":"text","value":"mutate()"}]},{"type":"code","value":"mutate(callback): Transaction<T>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L458","children":[{"type":"text","value":"packages/db/src/transactions.ts:458"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Execute collection operations within this transaction"}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"callback","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"inlineCode","value":"void"}]},{"type":"paragraph","children":[{"type":"text","value":"Synchronous function containing collection operations to group together.\nThe transaction context is active only for the synchronous duration of this callback.\nAsync work should happen in "},{"type":"inlineCode","value":"mutationFn"},{"type":"text","value":"; collection operations after "},{"type":"inlineCode","value":"await"},{"type":"text","value":" boundaries\ninside this callback will not be part of this transaction. For manual transactions, call\n"},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" multiple times before committing to add more synchronous operations to the same\ntransaction."}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Transaction"},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"This transaction for chaining"}]},{"type":"heading","depth":4,"id":"examples-2","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Group multiple operations\nconst tx = createTransaction({ mutationFn: async () => {\n  // Send to API\n}})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n  collection.update(\"2\", draft => { draft.completed = true })\n  collection.delete(\"3\")\n})\n\nawait tx.when('settled')","lang":"ts"},{"type":"code","value":"// Handle mutate errors\ntry {\n  tx.mutate(() => {\n    collection.insert({ id: \"invalid\" }) // This might throw\n  })\n} catch (error) {\n  console.log('Mutation failed:', error)\n}","lang":"ts"},{"type":"code","value":"// Manual commit control\nconst tx = createTransaction({ autoCommit: false, mutationFn: async () => {} })\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Item\" })\n})\n\n// Add more synchronous mutations to the same transaction\ntx.mutate(() => {\n  collection.update(\"1\", draft => { draft.text = \"Updated item\" })\n})\n\n// Commit later when ready\nawait tx.commit()","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"rollback","children":[{"type":"text","value":"rollback()"}]},{"type":"code","value":"rollback(config?): Transaction<T>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L583","children":[{"type":"text","value":"packages/db/src/transactions.ts:583"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Rollback the transaction and any conflicting transactions"}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"config","children":[{"type":"text","value":"config?"}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration for rollback behavior"}]},{"type":"heading","depth":6,"id":"error-3","children":[{"type":"text","value":"error?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":6,"id":"issecondaryrollback","children":[{"type":"text","value":"isSecondaryRollback?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Transaction"},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"This transaction for chaining"}]},{"type":"heading","depth":4,"id":"examples-3","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Manual rollback\nconst tx = createTransaction({ mutationFn: async () => {\n  // Send to API\n}})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n})\n\n// Rollback if needed\nif (shouldCancel) {\n  tx.rollback()\n}","lang":"ts"},{"type":"code","value":"// Handle rollback cascade (automatic)\nconst tx1 = createTransaction({ mutationFn: async () => {} })\nconst tx2 = createTransaction({ mutationFn: async () => {} })\n\ntx1.mutate(() => collection.update(\"1\", draft => { draft.value = \"A\" }))\ntx2.mutate(() => collection.update(\"1\", draft => { draft.value = \"B\" })) // Same item\n\ntx1.rollback() // This will also rollback tx2 due to conflict","lang":"ts"},{"type":"code","value":"// Handle rollback in error scenarios\ntry {\n  await tx.when('settled')\n} catch (error) {\n  console.log('Transaction was rolled back:', error)\n  // Transaction automatically rolled back on mutation function failure\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setstate","children":[{"type":"text","value":"setState()"}]},{"type":"code","value":"setState(newState): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L401","children":[{"type":"text","value":"packages/db/src/transactions.ts:401"}]}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"newstate","children":[{"type":"text","value":"newState"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/TransactionState.md","children":[{"type":"inlineCode","value":"TransactionState"}]}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"touchcollection","children":[{"type":"text","value":"touchCollection()"}]},{"type":"code","value":"touchCollection(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L619","children":[{"type":"text","value":"packages/db/src/transactions.ts:619"}]}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"when","children":[{"type":"text","value":"when()"}]},{"type":"code","value":"when(_state): Promise<Transaction<T>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L397","children":[{"type":"text","value":"packages/db/src/transactions.ts:397"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Wait for this transaction to complete successfully or fail."}]},{"type":"paragraph","children":[{"type":"text","value":"The promise resolves with this transaction on success and rejects with\nthe original error on failure (or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" for a rollback without an\nerror). For non-empty commits, this\nboundary is the mutation function's completion; it does not inherently\nprove backend acknowledgement or read-back."}]},{"type":"heading","depth":4,"id":"parameters-6","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"state-2","children":[{"type":"text","value":"_state"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"\"settled\""}]},{"type":"heading","depth":4,"id":"returns-8","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Transaction"},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">>"}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"properties","text":"Properties","level":2},{"id":"autocommit","text":"autoCommit","level":3},{"id":"createdat","text":"createdAt","level":3},{"id":"error","text":"error?","level":3},{"id":"error-2","text":"error","level":4},{"id":"message","text":"message","level":4},{"id":"id","text":"id","level":3},{"id":"ispersisted","text":"isPersisted","level":3},{"id":"deprecated","text":"Deprecated","level":4},{"id":"metadata","text":"metadata","level":3},{"id":"mutationfn","text":"mutationFn","level":3},{"id":"mutations","text":"mutations","level":3},{"id":"sequencenumber","text":"sequenceNumber","level":3},{"id":"state","text":"state","level":3},{"id":"methods","text":"Methods","level":2},{"id":"applymutations","text":"applyMutations()","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"mutations-2","text":"mutations","level":5},{"id":"returns","text":"Returns","level":4},{"id":"commit","text":"commit()","level":3},{"id":"returns-2","text":"Returns","level":4},{"id":"examples","text":"Examples","level":4},{"id":"comparecreatedat","text":"compareCreatedAt()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"other","text":"other","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"mutate","text":"mutate()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"callback","text":"callback","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"examples-2","text":"Examples","level":4},{"id":"rollback","text":"rollback()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"config","text":"config?","level":5},{"id":"error-3","text":"error?","level":6},{"id":"issecondaryrollback","text":"isSecondaryRollback?","level":6},{"id":"returns-5","text":"Returns","level":4},{"id":"examples-3","text":"Examples","level":4},{"id":"setstate","text":"setState()","level":3},{"id":"parameters-5","text":"Parameters","level":4},{"id":"newstate","text":"newState","level":5},{"id":"returns-6","text":"Returns","level":4},{"id":"touchcollection","text":"touchCollection()","level":3},{"id":"returns-7","text":"Returns","level":4},{"id":"when","text":"when()","level":3},{"id":"parameters-6","text":"Parameters","level":4},{"id":"state-2","text":"_state","level":5},{"id":"returns-8","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/db/src/transactions.ts:337](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L337)\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n## Properties\n\n### autoCommit\n\n```ts\nautoCommit: boolean;\n```\n\nDefined in: [packages/db/src/transactions.ts:358](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L358)\n\n***\n\n### createdAt\n\n```ts\ncreatedAt: Date;\n```\n\nDefined in: [packages/db/src/transactions.ts:359](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L359)\n\n***\n\n### error?\n\n```ts\noptional error: object;\n```\n\nDefined in: [packages/db/src/transactions.ts:362](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L362)\n\n#### error\n\n```ts\nerror: Error;\n```\n\n#### message\n\n```ts\nmessage: string;\n```\n\n***\n\n### id\n\n```ts\nid: string;\n```\n\nDefined in: [packages/db/src/transactions.ts:338](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L338)\n\n***\n\n### ~~isPersisted~~\n\n```ts\nisPersisted: Deferred<Transaction<T>>;\n```\n\nDefined in: [packages/db/src/transactions.ts:357](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L357)\n\nDeferred that settles when this transaction settles.\n\nAwait `when('settled')` instead. This legacy promise resolves\nwhen the transaction completes successfully and rejects if the transaction\nfails or is rolled back.\n\nFor non-empty commits, the mutation function is the normal settlement\nboundary. This does not inherently prove that a backend has uploaded,\nconfirmed, or read back the write unless the mutation function waits for\nthat backend observation before returning.\n\n#### Deprecated\n\nUse `when('settled')` instead. This alias will be removed in\nthe 1.0 RC.\n\n***\n\n### metadata\n\n```ts\nmetadata: Record<string, unknown>;\n```\n\nDefined in: [packages/db/src/transactions.ts:361](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L361)\n\n***\n\n### mutationFn\n\n```ts\nmutationFn: MutationFn<T>;\n```\n\nDefined in: [packages/db/src/transactions.ts:340](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L340)\n\n***\n\n### mutations\n\n```ts\nmutations: PendingMutation<T, OperationType, Collection<T, any, any, any, any>>[];\n```\n\nDefined in: [packages/db/src/transactions.ts:341](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L341)\n\n***\n\n### sequenceNumber\n\n```ts\nsequenceNumber: number;\n```\n\nDefined in: [packages/db/src/transactions.ts:360](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L360)\n\n***\n\n### state\n\n```ts\nstate: TransactionState;\n```\n\nDefined in: [packages/db/src/transactions.ts:339](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L339)\n\n## Methods\n\n### applyMutations()\n\n```ts\napplyMutations(mutations): void;\n```\n\nDefined in: [packages/db/src/transactions.ts:509](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L509)\n\nApply new mutations to this transaction, intelligently merging with existing mutations\n\nWhen mutations operate on the same item (same globalKey), they are merged according to\nthe following rules:\n\n- **insert + update** → insert (merge changes, keep empty original)\n- **insert + delete** → removed (mutations cancel each other out)\n- **update + delete** → delete (delete dominates)\n- **update + update** → update (union changes, keep first original)\n- **delete + insert** → removed if restored, otherwise update\n- **same type** → replace with latest\n\nThis merging reduces over-the-wire churn and keeps the optimistic local view\naligned with user intent.\n\n#### Parameters\n\n##### mutations\n\n[`PendingMutation`](PendingMutation.md)\\<`any`, [`OperationType`](../type-aliases/OperationType.md), [`Collection`](Collection.md)\\<`any`, `any`, `any`, `any`, `any`\\>\\>[]\n\nArray of new mutations to apply\n\n#### Returns\n\n`void`\n\n***\n\n### commit()\n\n```ts\ncommit(): Promise<Transaction<T>>;\n```\n\nDefined in: [packages/db/src/transactions.ts:674](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L674)\n\nCommit the transaction and execute the mutation function\n\n#### Returns\n\n`Promise`\\<`Transaction`\\<`T`\\>\\>\n\nPromise that resolves to this transaction when complete\n\n#### Examples\n\n```ts\n// Manual commit (when autoCommit is false)\nconst tx = createTransaction({\n  autoCommit: false,\n  mutationFn: async ({ transaction }) => {\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n})\n\nawait tx.commit() // Manually commit\n```\n\n```ts\n// Handle commit errors\ntry {\n  const tx = createTransaction({\n    mutationFn: async () => { throw new Error(\"API failed\") }\n  })\n\n  tx.mutate(() => {\n    collection.insert({ id: \"1\", text: \"Item\" })\n  })\n\n  await tx.commit()\n} catch (error) {\n  console.log('Commit failed, transaction rolled back:', error)\n}\n```\n\n```ts\n// Check transaction state after commit\nawait tx.commit()\nconsole.log(tx.state) // \"completed\" or \"failed\"\n```\n\n***\n\n### compareCreatedAt()\n\n```ts\ncompareCreatedAt(other): number;\n```\n\nDefined in: [packages/db/src/transactions.ts:735](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L735)\n\nCompare two transactions by their createdAt time and sequence number in order\nto sort them in the order they were created.\n\n#### Parameters\n\n##### other\n\n`Transaction`\\<`any`\\>\n\nThe other transaction to compare to\n\n#### Returns\n\n`number`\n\n-1 if this transaction was created before the other, 1 if it was created after, 0 if they were created at the same time\n\n***\n\n### mutate()\n\n```ts\nmutate(callback): Transaction<T>;\n```\n\nDefined in: [packages/db/src/transactions.ts:458](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L458)\n\nExecute collection operations within this transaction\n\n#### Parameters\n\n##### callback\n\n() => `void`\n\nSynchronous function containing collection operations to group together.\nThe transaction context is active only for the synchronous duration of this callback.\nAsync work should happen in `mutationFn`; collection operations after `await` boundaries\ninside this callback will not be part of this transaction. For manual transactions, call\n`mutate` multiple times before committing to add more synchronous operations to the same\ntransaction.\n\n#### Returns\n\n`Transaction`\\<`T`\\>\n\nThis transaction for chaining\n\n#### Examples\n\n```ts\n// Group multiple operations\nconst tx = createTransaction({ mutationFn: async () => {\n  // Send to API\n}})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n  collection.update(\"2\", draft => { draft.completed = true })\n  collection.delete(\"3\")\n})\n\nawait tx.when('settled')\n```\n\n```ts\n// Handle mutate errors\ntry {\n  tx.mutate(() => {\n    collection.insert({ id: \"invalid\" }) // This might throw\n  })\n} catch (error) {\n  console.log('Mutation failed:', error)\n}\n```\n\n```ts\n// Manual commit control\nconst tx = createTransaction({ autoCommit: false, mutationFn: async () => {} })\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Item\" })\n})\n\n// Add more synchronous mutations to the same transaction\ntx.mutate(() => {\n  collection.update(\"1\", draft => { draft.text = \"Updated item\" })\n})\n\n// Commit later when ready\nawait tx.commit()\n```\n\n***\n\n### rollback()\n\n```ts\nrollback(config?): Transaction<T>;\n```\n\nDefined in: [packages/db/src/transactions.ts:583](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L583)\n\nRollback the transaction and any conflicting transactions\n\n#### Parameters\n\n##### config?\n\nConfiguration for rollback behavior\n\n###### error?\n\n`Error`\n\n###### isSecondaryRollback?\n\n`boolean`\n\n#### Returns\n\n`Transaction`\\<`T`\\>\n\nThis transaction for chaining\n\n#### Examples\n\n```ts\n// Manual rollback\nconst tx = createTransaction({ mutationFn: async () => {\n  // Send to API\n}})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n})\n\n// Rollback if needed\nif (shouldCancel) {\n  tx.rollback()\n}\n```\n\n```ts\n// Handle rollback cascade (automatic)\nconst tx1 = createTransaction({ mutationFn: async () => {} })\nconst tx2 = createTransaction({ mutationFn: async () => {} })\n\ntx1.mutate(() => collection.update(\"1\", draft => { draft.value = \"A\" }))\ntx2.mutate(() => collection.update(\"1\", draft => { draft.value = \"B\" })) // Same item\n\ntx1.rollback() // This will also rollback tx2 due to conflict\n```\n\n```ts\n// Handle rollback in error scenarios\ntry {\n  await tx.when('settled')\n} catch (error) {\n  console.log('Transaction was rolled back:', error)\n  // Transaction automatically rolled back on mutation function failure\n}\n```\n\n***\n\n### setState()\n\n```ts\nsetState(newState): void;\n```\n\nDefined in: [packages/db/src/transactions.ts:401](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L401)\n\n#### Parameters\n\n##### newState\n\n[`TransactionState`](../type-aliases/TransactionState.md)\n\n#### Returns\n\n`void`\n\n***\n\n### touchCollection()\n\n```ts\ntouchCollection(): void;\n```\n\nDefined in: [packages/db/src/transactions.ts:619](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L619)\n\n#### Returns\n\n`void`\n\n***\n\n### when()\n\n```ts\nwhen(_state): Promise<Transaction<T>>;\n```\n\nDefined in: [packages/db/src/transactions.ts:397](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L397)\n\nWait for this transaction to complete successfully or fail.\n\nThe promise resolves with this transaction on success and rejects with\nthe original error on failure (or `undefined` for a rollback without an\nerror). For non-empty commits, this\nboundary is the mutation function's completion; it does not inherently\nprove backend acknowledgement or read-back.\n\n#### Parameters\n\n##### \\_state\n\n`\"settled\"`\n\n#### Returns\n\n`Promise`\\<`Transaction`\\<`T`\\>\\>\n","originalRawMarkdown":"---\nid: Transaction\ntitle: Transaction\n---\n\nDefined in: [packages/db/src/transactions.ts:337](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L337)\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n## Properties\n\n### autoCommit\n\n```ts\nautoCommit: boolean;\n```\n\nDefined in: [packages/db/src/transactions.ts:358](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L358)\n\n***\n\n### createdAt\n\n```ts\ncreatedAt: Date;\n```\n\nDefined in: [packages/db/src/transactions.ts:359](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L359)\n\n***\n\n### error?\n\n```ts\noptional error: object;\n```\n\nDefined in: [packages/db/src/transactions.ts:362](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L362)\n\n#### error\n\n```ts\nerror: Error;\n```\n\n#### message\n\n```ts\nmessage: string;\n```\n\n***\n\n### id\n\n```ts\nid: string;\n```\n\nDefined in: [packages/db/src/transactions.ts:338](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L338)\n\n***\n\n### ~~isPersisted~~\n\n```ts\nisPersisted: Deferred<Transaction<T>>;\n```\n\nDefined in: [packages/db/src/transactions.ts:357](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L357)\n\nDeferred that settles when this transaction settles.\n\nAwait `when('settled')` instead. This legacy promise resolves\nwhen the transaction completes successfully and rejects if the transaction\nfails or is rolled back.\n\nFor non-empty commits, the mutation function is the normal settlement\nboundary. This does not inherently prove that a backend has uploaded,\nconfirmed, or read back the write unless the mutation function waits for\nthat backend observation before returning.\n\n#### Deprecated\n\nUse `when('settled')` instead. This alias will be removed in\nthe 1.0 RC.\n\n***\n\n### metadata\n\n```ts\nmetadata: Record<string, unknown>;\n```\n\nDefined in: [packages/db/src/transactions.ts:361](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L361)\n\n***\n\n### mutationFn\n\n```ts\nmutationFn: MutationFn<T>;\n```\n\nDefined in: [packages/db/src/transactions.ts:340](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L340)\n\n***\n\n### mutations\n\n```ts\nmutations: PendingMutation<T, OperationType, Collection<T, any, any, any, any>>[];\n```\n\nDefined in: [packages/db/src/transactions.ts:341](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L341)\n\n***\n\n### sequenceNumber\n\n```ts\nsequenceNumber: number;\n```\n\nDefined in: [packages/db/src/transactions.ts:360](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L360)\n\n***\n\n### state\n\n```ts\nstate: TransactionState;\n```\n\nDefined in: [packages/db/src/transactions.ts:339](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L339)\n\n## Methods\n\n### applyMutations()\n\n```ts\napplyMutations(mutations): void;\n```\n\nDefined in: [packages/db/src/transactions.ts:509](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L509)\n\nApply new mutations to this transaction, intelligently merging with existing mutations\n\nWhen mutations operate on the same item (same globalKey), they are merged according to\nthe following rules:\n\n- **insert + update** → insert (merge changes, keep empty original)\n- **insert + delete** → removed (mutations cancel each other out)\n- **update + delete** → delete (delete dominates)\n- **update + update** → update (union changes, keep first original)\n- **delete + insert** → removed if restored, otherwise update\n- **same type** → replace with latest\n\nThis merging reduces over-the-wire churn and keeps the optimistic local view\naligned with user intent.\n\n#### Parameters\n\n##### mutations\n\n[`PendingMutation`](PendingMutation.md)\\<`any`, [`OperationType`](../type-aliases/OperationType.md), [`Collection`](Collection.md)\\<`any`, `any`, `any`, `any`, `any`\\>\\>[]\n\nArray of new mutations to apply\n\n#### Returns\n\n`void`\n\n***\n\n### commit()\n\n```ts\ncommit(): Promise<Transaction<T>>;\n```\n\nDefined in: [packages/db/src/transactions.ts:674](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L674)\n\nCommit the transaction and execute the mutation function\n\n#### Returns\n\n`Promise`\\<`Transaction`\\<`T`\\>\\>\n\nPromise that resolves to this transaction when complete\n\n#### Examples\n\n```ts\n// Manual commit (when autoCommit is false)\nconst tx = createTransaction({\n  autoCommit: false,\n  mutationFn: async ({ transaction }) => {\n    await api.saveChanges(transaction.mutations)\n  }\n})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n})\n\nawait tx.commit() // Manually commit\n```\n\n```ts\n// Handle commit errors\ntry {\n  const tx = createTransaction({\n    mutationFn: async () => { throw new Error(\"API failed\") }\n  })\n\n  tx.mutate(() => {\n    collection.insert({ id: \"1\", text: \"Item\" })\n  })\n\n  await tx.commit()\n} catch (error) {\n  console.log('Commit failed, transaction rolled back:', error)\n}\n```\n\n```ts\n// Check transaction state after commit\nawait tx.commit()\nconsole.log(tx.state) // \"completed\" or \"failed\"\n```\n\n***\n\n### compareCreatedAt()\n\n```ts\ncompareCreatedAt(other): number;\n```\n\nDefined in: [packages/db/src/transactions.ts:735](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L735)\n\nCompare two transactions by their createdAt time and sequence number in order\nto sort them in the order they were created.\n\n#### Parameters\n\n##### other\n\n`Transaction`\\<`any`\\>\n\nThe other transaction to compare to\n\n#### Returns\n\n`number`\n\n-1 if this transaction was created before the other, 1 if it was created after, 0 if they were created at the same time\n\n***\n\n### mutate()\n\n```ts\nmutate(callback): Transaction<T>;\n```\n\nDefined in: [packages/db/src/transactions.ts:458](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L458)\n\nExecute collection operations within this transaction\n\n#### Parameters\n\n##### callback\n\n() => `void`\n\nSynchronous function containing collection operations to group together.\nThe transaction context is active only for the synchronous duration of this callback.\nAsync work should happen in `mutationFn`; collection operations after `await` boundaries\ninside this callback will not be part of this transaction. For manual transactions, call\n`mutate` multiple times before committing to add more synchronous operations to the same\ntransaction.\n\n#### Returns\n\n`Transaction`\\<`T`\\>\n\nThis transaction for chaining\n\n#### Examples\n\n```ts\n// Group multiple operations\nconst tx = createTransaction({ mutationFn: async () => {\n  // Send to API\n}})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n  collection.update(\"2\", draft => { draft.completed = true })\n  collection.delete(\"3\")\n})\n\nawait tx.when('settled')\n```\n\n```ts\n// Handle mutate errors\ntry {\n  tx.mutate(() => {\n    collection.insert({ id: \"invalid\" }) // This might throw\n  })\n} catch (error) {\n  console.log('Mutation failed:', error)\n}\n```\n\n```ts\n// Manual commit control\nconst tx = createTransaction({ autoCommit: false, mutationFn: async () => {} })\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Item\" })\n})\n\n// Add more synchronous mutations to the same transaction\ntx.mutate(() => {\n  collection.update(\"1\", draft => { draft.text = \"Updated item\" })\n})\n\n// Commit later when ready\nawait tx.commit()\n```\n\n***\n\n### rollback()\n\n```ts\nrollback(config?): Transaction<T>;\n```\n\nDefined in: [packages/db/src/transactions.ts:583](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L583)\n\nRollback the transaction and any conflicting transactions\n\n#### Parameters\n\n##### config?\n\nConfiguration for rollback behavior\n\n###### error?\n\n`Error`\n\n###### isSecondaryRollback?\n\n`boolean`\n\n#### Returns\n\n`Transaction`\\<`T`\\>\n\nThis transaction for chaining\n\n#### Examples\n\n```ts\n// Manual rollback\nconst tx = createTransaction({ mutationFn: async () => {\n  // Send to API\n}})\n\ntx.mutate(() => {\n  collection.insert({ id: \"1\", text: \"Buy milk\" })\n})\n\n// Rollback if needed\nif (shouldCancel) {\n  tx.rollback()\n}\n```\n\n```ts\n// Handle rollback cascade (automatic)\nconst tx1 = createTransaction({ mutationFn: async () => {} })\nconst tx2 = createTransaction({ mutationFn: async () => {} })\n\ntx1.mutate(() => collection.update(\"1\", draft => { draft.value = \"A\" }))\ntx2.mutate(() => collection.update(\"1\", draft => { draft.value = \"B\" })) // Same item\n\ntx1.rollback() // This will also rollback tx2 due to conflict\n```\n\n```ts\n// Handle rollback in error scenarios\ntry {\n  await tx.when('settled')\n} catch (error) {\n  console.log('Transaction was rolled back:', error)\n  // Transaction automatically rolled back on mutation function failure\n}\n```\n\n***\n\n### setState()\n\n```ts\nsetState(newState): void;\n```\n\nDefined in: [packages/db/src/transactions.ts:401](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L401)\n\n#### Parameters\n\n##### newState\n\n[`TransactionState`](../type-aliases/TransactionState.md)\n\n#### Returns\n\n`void`\n\n***\n\n### touchCollection()\n\n```ts\ntouchCollection(): void;\n```\n\nDefined in: [packages/db/src/transactions.ts:619](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L619)\n\n#### Returns\n\n`void`\n\n***\n\n### when()\n\n```ts\nwhen(_state): Promise<Transaction<T>>;\n```\n\nDefined in: [packages/db/src/transactions.ts:397](https://github.com/TanStack/db/blob/main/packages/db/src/transactions.ts#L397)\n\nWait for this transaction to complete successfully or fail.\n\nThe promise resolves with this transaction on success and rejects with\nthe original error on failure (or `undefined` for a rollback without an\nerror). For non-empty commits, this\nboundary is the mutation function's completion; it does not inherently\nprove backend acknowledgement or read-back.\n\n#### Parameters\n\n##### \\_state\n\n`\"settled\"`\n\n#### Returns\n\n`Promise`\\<`Transaction`\\<`T`\\>\\>\n"}
