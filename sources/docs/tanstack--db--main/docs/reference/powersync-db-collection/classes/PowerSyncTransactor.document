{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L55","children":[{"type":"text","value":"PowerSyncTransactor.ts:55"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Applies mutations to the PowerSync database. This method is called automatically by the collection's\ninsert, update, and delete operations. You typically don't need to call this directly unless you\nhave special transaction requirements."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Create a collection\nconst collection = createCollection(\n  powerSyncCollectionOptions<Document>({\n    database: db,\n    table: APP_SCHEMA.props.documents,\n  })\n)\n\nconst addTx = createTransaction({\n  autoCommit: false,\n  mutationFn: async ({ transaction }) => {\n    await new PowerSyncTransactor({ database: db }).applyTransaction(transaction)\n  },\n})\n\naddTx.mutate(() => {\n  for (let i = 0; i < 5; i++) {\n    collection.insert({ id: randomUUID(), name: `tx-${i}` })\n  }\n})\n\nawait addTx.commit()\nawait addTx.when('settled')","lang":"typescript"},{"type":"heading","depth":2,"id":"param","children":[{"type":"text","value":"Param"}]},{"type":"paragraph","children":[{"type":"text","value":"The transaction containing mutations to apply"}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,"id":"constructor","children":[{"type":"text","value":"Constructor"}]},{"type":"code","value":"new PowerSyncTransactor(options): PowerSyncTransactor;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L59","children":[{"type":"te