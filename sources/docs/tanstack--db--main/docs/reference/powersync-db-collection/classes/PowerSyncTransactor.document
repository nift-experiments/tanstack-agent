ert(\n   mutation, \n   context, \nwaitForCompletion): Promise<PendingOperation | null>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L180","children":[{"type":"text","value":"PowerSyncTransactor.ts:180"}]}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"mutation-3","children":[{"type":"text","value":"mutation"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"PendingMutation"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"context-2","children":[{"type":"text","value":"context"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"LockContext"}]},{"type":"heading","depth":5,"id":"waitforcompletion-2","children":[{"type":"text","value":"waitForCompletion"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"},{"type":"text","value":" = "},{"type":"inlineCode","value":"false"}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"PendingOperation"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"handleoperationwithcompletion","children":[{"type":"text","value":"handleOperationWithCompletion()"}]},{"type":"code","value":"protected handleOperationWithCompletion(\n   mutation, \n   context, \n   waitForCompletion, \nhandler): Promise<PendingOperation | null>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L301","children":[{"type":"text","value":"PowerSyncTransactor.ts:301"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Helper function which wraps a persistence operation by:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Fetching the mutation's collection's SQLite table details"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Executing the mutation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Returning the last pending diff operation if required"}]}]}]},{"type":"heading","depth":4,"id":"parameters-6","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"mutation-4","children":[{"type":"text","value":"mutation"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"PendingMutation"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"context-3","children":[{"type":"text","value":"context"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"LockContext"}]},{"type":"heading","depth":5,"id":"waitforcompletion-3","children":[{"type":"text","value":"waitForCompletion"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":5,"id":"handler","children":[{"type":"text","value":"handler"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"tableName"},{"type":"text","value":", "},{"type":"inlineCode","value":"mutation"},{"type":"text","value":", "},{"type":"inlineCode","value":"serializeValue"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"false"},{"type":"text","value":" | "},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"PendingOperation"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"handleupdate","children":[{"type":"text","value":"handleUpdate()"}]},{"type":"code","value":"protected handleUpdate(\n   mutation, \n   context, \nwaitForCompletion): Promise<PendingOperation | null>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L216","children":[{"type":"text","value":"PowerSyncTransactor.ts:216"}]}]},{"type":"heading","depth":4,"id":"parameters-7","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"mutation-5","children":[{"type":"text","value":"mutation"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"PendingMutation"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"context-4","children":[{"type":"text","value":"context"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"LockContext"}]},{"type":"heading","depth":5,"id":"waitforcompletion-4","children":[{"type":"text","value":"waitForCompletion"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"},{"type":"text","value":" = "},{"type":"inlineCode","value":"false"}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"PendingOperation"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"processmutationmetadata","children":[{"type":"text","value":"processMutationMetadata()"}]},{"type":"code","value":"protected processMutationMetadata(mutation): string | null;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L359","children":[{"type":"text","value":"PowerSyncTransactor.ts:359"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Processes collection mutation metadata for persistence to the database.\nWe only support storing string metadata."}]},{"type":"heading","depth":4,"id":"parameters-8","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"mutation-6","children":[{"type":"text","value":"mutation"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"PendingMutation"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-8","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"paragraph","children":[{"type":"text","value":"null if no metadata should be stored."}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"param","text":"Param","level":2},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"options","text":"options","level":5},{"id":"returns","text":"Returns","level":4},{"id":"properties","text":"Properties","level":2},{"id":"database","text":"database","level":3},{"id":"pendingoperationstore","text":"pendingOperationStore","level":3},{"id":"methods","text":"Methods","level":2},{"id":"applytransaction","text":"applyTransaction()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"transaction","text":"transaction","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"getmutationcollectionmeta","text":"getMutationCollectionMeta()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"mutation","text":"mutation","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"handledelete","text":"handleDelete()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"mutation-2","text":"mutation","level":5},{"id":"context","text":"context","level":5},{"id":"waitforcompletion","text":"waitForCompletion","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"handleinsert","text":"handleInsert()","level":3},{"id":"parameters-5","text":"Parameters","level":4},{"id":"mutation-3","text":"mutation","level":5},{"id":"context-2","text":"context","level":5},{"id":"waitforcompletion-2","text":"waitForCompletion","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"handleoperationwithcompletion","text":"handleOperationWithCompletion()","level":3},{"id":"parameters-6","text":"Parameters","level":4},{"id":"mutation-4","text":"mutation","level":5},{"id":"context-3","text":"context","level":5},{"id":"waitforcompletion-3","text":"waitForCompletion","level":5},{"id":"handler","text":"handler","level":5},{"id":"returns-6","text":"Returns","level":4},{"id":"handleupdate","text":"handleUpdate()","level":3},{"id":"parameters-7","text":"Parameters","level":4},{"id":"mutation-5","text":"mutation","level":5},{"id":"context-4","text":"context","level":5},{"id":"waitforcompletion-4","text":"waitForCompletion","level":5},{"id":"returns-7","text":"Returns","level":4},{"id":"processmutationmetadata","text":"processMutationMetadata()","level":3},{"id":"parameters-8","text":"Parameters","level":4},{"id":"mutation-6","text":"mutation","level":5},{"id":"returns-8","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [PowerSyncTransactor.ts:55](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L55)\n\nApplies mutations to the PowerSync database. This method is called automatically by the collection's\ninsert, update, and delete operations. You typically don't need to call this directly unless you\nhave special transaction requirements.\n\n## Example\n\n```typescript\n// Create a collection\nconst collection = createCollection(\n  powerSyncCollectionOptions<Document>({\n    database: db,\n    table: APP_SCHEMA.props.documents,\n  })\n)\n\nconst addTx = createTransaction({\n  autoCommit: false,\n  mutationFn: async ({ transaction }) => {\n    await new PowerSyncTransactor({ database: db }).applyTransaction(transaction)\n  },\n})\n\naddTx.mutate(() => {\n  for (let i = 0; i < 5; i++) {\n    collection.insert({ id: randomUUID(), name: `tx-${i}` })\n  }\n})\n\nawait addTx.commit()\nawait addTx.when('settled')\n```\n\n## Param\n\nThe transaction containing mutations to apply\n\n## Constructors\n\n### Constructor\n\n```ts\nnew PowerSyncTransactor(options): PowerSyncTransactor;\n```\n\nDefined in: [PowerSyncTransactor.ts:59](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L59)\n\n#### Parameters\n\n##### options\n\n[`TransactorOptions`](../type-aliases/TransactorOptions.md)\n\n#### Returns\n\n`PowerSyncTransactor`\n\n## Properties\n\n### database\n\n```ts\ndatabase: CommonPowerSyncDatabase;\n```\n\nDefined in: [PowerSyncTransactor.ts:56](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L56)\n\n***\n\n### pendingOperationStore\n\n```ts\npendingOperationStore: PendingOperationStore;\n```\n\nDefined in: [PowerSyncTransactor.ts:57](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L57)\n\n## Methods\n\n### applyTransaction()\n\n```ts\napplyTransaction(transaction): Promise<void>;\n```\n\nDefined in: [PowerSyncTransactor.ts:67](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L67)\n\nPersists a Transaction to the PowerSync SQLite database.\n\n#### Parameters\n\n##### transaction\n\n`Transaction`\\<`any`\\>\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### getMutationCollectionMeta()\n\n```ts\nprotected getMutationCollectionMeta(mutation): PowerSyncCollectionMeta<any>;\n```\n\nDefined in: [PowerSyncTransactor.ts:340](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L340)\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n#### Returns\n\n[`PowerSyncCollectionMeta`](../type-aliases/PowerSyncCollectionMeta.md)\\<`any`\\>\n\n***\n\n### handleDelete()\n\n```ts\nprotected handleDelete(\n   mutation, \n   context, \nwaitForCompletion): Promise<PendingOperation | null>;\n```\n\nDefined in: [PowerSyncTransactor.ts:258](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L258)\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n##### context\n\n`LockContext`\n\n##### waitForCompletion\n\n`boolean` = `false`\n\n#### Returns\n\n`Promise`\\<`PendingOperation` \\| `null`\\>\n\n***\n\n### handleInsert()\n\n```ts\nprotected handleInsert(\n   mutation, \n   context, \nwaitForCompletion): Promise<PendingOperation | null>;\n```\n\nDefined in: [PowerSyncTransactor.ts:180](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L180)\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n##### context\n\n`LockContext`\n\n##### waitForCompletion\n\n`boolean` = `false`\n\n#### Returns\n\n`Promise`\\<`PendingOperation` \\| `null`\\>\n\n***\n\n### handleOperationWithCompletion()\n\n```ts\nprotected handleOperationWithCompletion(\n   mutation, \n   context, \n   waitForCompletion, \nhandler): Promise<PendingOperation | null>;\n```\n\nDefined in: [PowerSyncTransactor.ts:301](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L301)\n\nHelper function which wraps a persistence operation by:\n- Fetching the mutation's collection's SQLite table details\n- Executing the mutation\n- Returning the last pending diff operation if required\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n##### context\n\n`LockContext`\n\n##### waitForCompletion\n\n`boolean`\n\n##### handler\n\n(`tableName`, `mutation`, `serializeValue`) => `Promise`\\<`false` \\| `void`\\>\n\n#### Returns\n\n`Promise`\\<`PendingOperation` \\| `null`\\>\n\n***\n\n### handleUpdate()\n\n```ts\nprotected handleUpdate(\n   mutation, \n   context, \nwaitForCompletion): Promise<PendingOperation | null>;\n```\n\nDefined in: [PowerSyncTransactor.ts:216](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L216)\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n##### context\n\n`LockContext`\n\n##### waitForCompletion\n\n`boolean` = `false`\n\n#### Returns\n\n`Promise`\\<`PendingOperation` \\| `null`\\>\n\n***\n\n### processMutationMetadata()\n\n```ts\nprotected processMutationMetadata(mutation): string | null;\n```\n\nDefined in: [PowerSyncTransactor.ts:359](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L359)\n\nProcesses collection mutation metadata for persistence to the database.\nWe only support storing string metadata.\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n#### Returns\n\n`string` \\| `null`\n\nnull if no metadata should be stored.\n","originalRawMarkdown":"---\nid: PowerSyncTransactor\ntitle: PowerSyncTransactor\n---\n\nDefined in: [PowerSyncTransactor.ts:55](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L55)\n\nApplies mutations to the PowerSync database. This method is called automatically by the collection's\ninsert, update, and delete operations. You typically don't need to call this directly unless you\nhave special transaction requirements.\n\n## Example\n\n```typescript\n// Create a collection\nconst collection = createCollection(\n  powerSyncCollectionOptions<Document>({\n    database: db,\n    table: APP_SCHEMA.props.documents,\n  })\n)\n\nconst addTx = createTransaction({\n  autoCommit: false,\n  mutationFn: async ({ transaction }) => {\n    await new PowerSyncTransactor({ database: db }).applyTransaction(transaction)\n  },\n})\n\naddTx.mutate(() => {\n  for (let i = 0; i < 5; i++) {\n    collection.insert({ id: randomUUID(), name: `tx-${i}` })\n  }\n})\n\nawait addTx.commit()\nawait addTx.when('settled')\n```\n\n## Param\n\nThe transaction containing mutations to apply\n\n## Constructors\n\n### Constructor\n\n```ts\nnew PowerSyncTransactor(options): PowerSyncTransactor;\n```\n\nDefined in: [PowerSyncTransactor.ts:59](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L59)\n\n#### Parameters\n\n##### options\n\n[`TransactorOptions`](../type-aliases/TransactorOptions.md)\n\n#### Returns\n\n`PowerSyncTransactor`\n\n## Properties\n\n### database\n\n```ts\ndatabase: CommonPowerSyncDatabase;\n```\n\nDefined in: [PowerSyncTransactor.ts:56](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L56)\n\n***\n\n### pendingOperationStore\n\n```ts\npendingOperationStore: PendingOperationStore;\n```\n\nDefined in: [PowerSyncTransactor.ts:57](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L57)\n\n## Methods\n\n### applyTransaction()\n\n```ts\napplyTransaction(transaction): Promise<void>;\n```\n\nDefined in: [PowerSyncTransactor.ts:67](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L67)\n\nPersists a Transaction to the PowerSync SQLite database.\n\n#### Parameters\n\n##### transaction\n\n`Transaction`\\<`any`\\>\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### getMutationCollectionMeta()\n\n```ts\nprotected getMutationCollectionMeta(mutation): PowerSyncCollectionMeta<any>;\n```\n\nDefined in: [PowerSyncTransactor.ts:340](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L340)\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n#### Returns\n\n[`PowerSyncCollectionMeta`](../type-aliases/PowerSyncCollectionMeta.md)\\<`any`\\>\n\n***\n\n### handleDelete()\n\n```ts\nprotected handleDelete(\n   mutation, \n   context, \nwaitForCompletion): Promise<PendingOperation | null>;\n```\n\nDefined in: [PowerSyncTransactor.ts:258](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L258)\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n##### context\n\n`LockContext`\n\n##### waitForCompletion\n\n`boolean` = `false`\n\n#### Returns\n\n`Promise`\\<`PendingOperation` \\| `null`\\>\n\n***\n\n### handleInsert()\n\n```ts\nprotected handleInsert(\n   mutation, \n   context, \nwaitForCompletion): Promise<PendingOperation | null>;\n```\n\nDefined in: [PowerSyncTransactor.ts:180](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L180)\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n##### context\n\n`LockContext`\n\n##### waitForCompletion\n\n`boolean` = `false`\n\n#### Returns\n\n`Promise`\\<`PendingOperation` \\| `null`\\>\n\n***\n\n### handleOperationWithCompletion()\n\n```ts\nprotected handleOperationWithCompletion(\n   mutation, \n   context, \n   waitForCompletion, \nhandler): Promise<PendingOperation | null>;\n```\n\nDefined in: [PowerSyncTransactor.ts:301](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L301)\n\nHelper function which wraps a persistence operation by:\n- Fetching the mutation's collection's SQLite table details\n- Executing the mutation\n- Returning the last pending diff operation if required\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n##### context\n\n`LockContext`\n\n##### waitForCompletion\n\n`boolean`\n\n##### handler\n\n(`tableName`, `mutation`, `serializeValue`) => `Promise`\\<`false` \\| `void`\\>\n\n#### Returns\n\n`Promise`\\<`PendingOperation` \\| `null`\\>\n\n***\n\n### handleUpdate()\n\n```ts\nprotected handleUpdate(\n   mutation, \n   context, \nwaitForCompletion): Promise<PendingOperation | null>;\n```\n\nDefined in: [PowerSyncTransactor.ts:216](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L216)\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n##### context\n\n`LockContext`\n\n##### waitForCompletion\n\n`boolean` = `false`\n\n#### Returns\n\n`Promise`\\<`PendingOperation` \\| `null`\\>\n\n***\n\n### processMutationMetadata()\n\n```ts\nprotected processMutationMetadata(mutation): string | null;\n```\n\nDefined in: [PowerSyncTransactor.ts:359](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/PowerSyncTransactor.ts#L359)\n\nProcesses collection mutation metadata for persistence to the database.\nWe only support storing string metadata.\n\n#### Parameters\n\n##### mutation\n\n`PendingMutation`\\<`any`\\>\n\n#### Returns\n\n`string` \\| `null`\n\nnull if no metadata should be stored.\n"}
