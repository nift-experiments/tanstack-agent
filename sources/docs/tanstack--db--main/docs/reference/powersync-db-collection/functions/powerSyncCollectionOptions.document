{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Implementation of powerSyncCollectionOptions that handles both schema and non-schema configurations."}]},{"type":"heading","depth":2,"id":"call-signature","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function powerSyncCollectionOptions<TTable>(config): EnhancedPowerSyncCollectionConfig<TTable, OptionalExtractedTable<TTable>, never>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/powersync.ts#L84","children":[{"type":"text","value":"powersync.ts:84"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a PowerSync collection configuration with basic default validation.\nInput and Output types are the SQLite column types."}]},{"type":"heading","depth":3,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"ttable","children":[{"type":"text","value":"TTable"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTable"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Table"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ColumnsType"},{"type":"text","value":"> = "},{"type":"inlineCode","value":"Table"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ColumnsType"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"config","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/BasePowerSyncCollectionConfig.md","children":[{"type":"inlineCode","value":"BasePowerSyncCollectionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":", "},{"type":"inlineCode","value":"never"},{"type":"text","value":"> & "},{"type":"link","href":"../type-aliases/ConfigWithSQLiteTypes.md","children":[{"type":"inlineCode","value":"ConfigWithSQLiteTypes"}]}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/EnhancedPowerSyncCollectionConfig.md","children":[{"type":"inlineCode","value":"EnhancedPowerSyncCollectionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":", "},{"type":"link","href":"../type-aliases/OptionalExtractedTable.md","children":[{"type":"inlineCode","value":"OptionalExtractedTable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":">, "},{"type":"inlineCode","value":"never"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const APP_SCHEMA = new Schema({\n  documents: new Table({\n    name: column.text,\n  }),\n})\n\ntype Document = (typeof APP_SCHEMA)[\"types\"][\"documents\"]\n\nconst db = new PowerSyncDatabase({\n  database: {\n    dbFilename: \"test.sqlite\",\n  },\n  schema: APP_SCHEMA,\n})\n\nconst collection = createCollection(\n  powerSyncCollectionOptions({\n    database: db,\n    table: APP_SCHEMA.props.documents\n  })\n)","lang":"typescript"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function powerSyncCollectionOptions<TTable, TSchema>(config): CollectionConfig<InferPowerSyncOutputType<TTable, TSchema>, string, TSchema, PowerSyncCollectionUtils<TTable>> & object & object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/powersync.ts#L141","children":[{"type":"text","value":"powersync.ts:141"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a PowerSync collection configuration with schema validation."}]},{"type":"paragraph","children":[{"type":"text","value":"The input types satisfy the SQLite column types."}]},{"type":"paragraph","children":[{"type":"text","value":"The output types are defined by the provided schema. This schema can enforce additional\nvalidation or type transforms.\nArbitrary output typed mutations are encoded to SQLite for persistence. We provide a basic standard\nserialization implementation to serialize column values. Custom or advanced types require providing additional\nserializer specifications. Partial column overrides can be supplied to "},{"type":"inlineCode","value":"serializer"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"ttable-2","children":[{"type":"text","value":"TTable"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTable"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Table"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ColumnsType"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"tschema","children":[{"type":"text","value":"TSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/OptionalExtractedTable.md","children":[{"type":"inlineCode","value":"OptionalExtractedTable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":">, "},{"type":"inlineCode","value":"AnyTableColumnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"config-2","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/BasePowerSyncCollectionConfig.md","children":[{"type":"inlineCode","value":"BasePowerSyncCollectionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":"> & "},{"type":"link","href":"../type-aliases/SerializerConfig.md","children":[{"type":"inlineCode","value":"SerializerConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"InferOutput"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">, "},{"type":"inlineCode","value":"ExtractedTable"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":">> & "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"CollectionConfig"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/InferPowerSyncOutputType.md","children":[{"type":"inlineCode","value":"InferPowerSyncOutputType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">, "},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":", "},{"type":"link","href":"../type-aliases/PowerSyncCollectionUtils.md","children":[{"type":"inlineCode","value":"PowerSyncCollectionUtils"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":">> & "},{"type":"inlineCode","value":"object"},{"type":"text","value":" & "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":3,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { z } from \"zod\"\n\n// The PowerSync SQLite schema\nconst APP_SCHEMA = new Schema({\n  documents: new Table({\n    name: column.text,\n    // Dates are stored as ISO date strings in SQLite\n    created_at: column.text\n  }),\n})\n\n// Advanced Zod validations. The output type of this schema\n// is constrained to the SQLite schema of APP_SCHEMA\nconst schema = z.object({\n  id: z.string(),\n  // Notice that `name` is not nullable (is required) here and it has additional validation\n  name: z.string().min(3, { message: \"Should be at least 3 characters\" }).nullable(),\n  // The input type is still the SQLite string type. While collections will output smart Date instances.\n  created_at: z.string().transform(val => new Date(val))\n})\n\nconst collection = createCollection(\n  powerSyncCollectionOptions({\n    database: db,\n    table: APP_SCHEMA.props.documents,\n    schema,\n    serializer: {\n       // The default is toISOString, this is just to demonstrate custom overrides\n       created_at: (outputValue) => outputValue.toISOString(),\n    },\n  })\n)","lang":"typescript"},{"type":"heading","depth":2,"id":"call-signature-3","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function powerSyncCollectionOptions<TTable, TSchema>(config): CollectionConfig<InferPowerSyncOutputType<TTable, TSchema>, string, TSchema, PowerSyncCollectionUtils<TTable>> & object & object;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/powersync.ts#L209","children":[{"type":"text","value":"powersync.ts:209"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a PowerSync collection configuration with schema validation."}]},{"type":"paragraph","children":[{"type":"text","value":"The input types are not linked to the internal SQLite table types. This can\ngive greater flexibility, e.g. by accepting rich types as input for "},{"type":"inlineCode","value":"insert"},{"type":"text","value":" or "},{"type":"inlineCode","value":"update"},{"type":"text","value":" operations.\nAn additional "},{"type":"inlineCode","value":"deserializationSchema"},{"type":"text","value":" is required in order to process incoming SQLite updates to the output type."}]},{"type":"paragraph","children":[{"type":"text","value":"The output types are defined by the provided schema. This schema can enforce additional\nvalidation or type transforms.\nArbitrary output typed mutations are encoded to SQLite for persistence. We provide a basic standard\nserialization implementation to serialize column values. Custom or advanced types require providing additional\nserializer specifications. Partial column overrides can be supplied to "},{"type":"inlineCode","value":"serializer"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"ttable-3","children":[{"type":"text","value":"TTable"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTable"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Table"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ColumnsType"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"tschema-2","children":[{"type":"text","value":"TSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":"<"},{"type":"inlineCode","value":"AnyTableColumnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":">, "},{"type":"inlineCode","value":"AnyTableColumnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"config-3","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/BasePowerSyncCollectionConfig.md","children":[{"type":"inlineCode","value":"BasePowerSyncCollectionConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":"> & "},{"type":"link","href":"../type-aliases/SerializerConfig.md","children":[{"type":"inlineCode","value":"SerializerConfig"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"InferOutput"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">, "},{"type":"inlineCode","value":"ExtractedTable"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":">> & "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":3,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"CollectionConfig"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/InferPowerSyncOutputType.md","children":[{"type":"inlineCode","value":"InferPowerSyncOutputType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">, "},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":", "},{"type":"link","href":"../type-aliases/PowerSyncCollectionUtils.md","children":[{"type":"inlineCode","value":"PowerSyncCollectionUtils"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTable"},{"type":"text","value":">> & "},{"type":"inlineCode","value":"object"},{"type":"text","value":" & "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":3,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { z } from \"zod\"\n\n// The PowerSync SQLite schema\nconst APP_SCHEMA = new Schema({\n  documents: new Table({\n    name: column.text,\n    // Booleans are represented as integers in SQLite\n    is_active: column.integer\n  }),\n})\n\n// Advanced Zod validations.\n// We accept boolean values as input for operations and expose Booleans in query results\nconst schema = z.object({\n  id: z.string(),\n  isActive: z.boolean(), // TInput and TOutput are boolean\n})\n\n// The deserializationSchema converts the SQLite synced INTEGER (0/1) values to booleans.\nconst deserializationSchema = z.object({\n  id: z.string(),\n  isActive: z.number().nullable().transform((val) => val == null ? true : val > 0),\n})\n\nconst collection = createCollection(\n  powerSyncCollectionOptions({\n    database: db,\n    table: APP_SCHEMA.props.documents,\n    schema,\n    deserializationSchema,\n  })\n)","lang":"typescript"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"ttable","text":"TTable","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"config","text":"config","level":4},{"id":"returns","text":"Returns","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"ttable-2","text":"TTable","level":4},{"id":"tschema","text":"TSchema","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"config-2","text":"config","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example-2","text":"Example","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"ttable-3","text":"TTable","level":4},{"id":"tschema-2","text":"TSchema","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"config-3","text":"config","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"example-3","text":"Example","level":3}]},"frameworks":[],"downloadMarkdown":"\nImplementation of powerSyncCollectionOptions that handles both schema and non-schema configurations.\n\n## Call Signature\n\n```ts\nfunction powerSyncCollectionOptions<TTable>(config): EnhancedPowerSyncCollectionConfig<TTable, OptionalExtractedTable<TTable>, never>;\n```\n\nDefined in: [powersync.ts:84](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/powersync.ts#L84)\n\nCreates a PowerSync collection configuration with basic default validation.\nInput and Output types are the SQLite column types.\n\n### Type Parameters\n\n#### TTable\n\n`TTable` *extends* `Table`\\<`ColumnsType`\\> = `Table`\\<`ColumnsType`\\>\n\n### Parameters\n\n#### config\n\n[`BasePowerSyncCollectionConfig`](../type-aliases/BasePowerSyncCollectionConfig.md)\\<`TTable`, `never`\\> & [`ConfigWithSQLiteTypes`](../type-aliases/ConfigWithSQLiteTypes.md)\n\n### Returns\n\n[`EnhancedPowerSyncCollectionConfig`](../type-aliases/EnhancedPowerSyncCollectionConfig.md)\\<`TTable`, [`OptionalExtractedTable`](../type-aliases/OptionalExtractedTable.md)\\<`TTable`\\>, `never`\\>\n\n### Example\n\n```typescript\nconst APP_SCHEMA = new Schema({\n  documents: new Table({\n    name: column.text,\n  }),\n})\n\ntype Document = (typeof APP_SCHEMA)[\"types\"][\"documents\"]\n\nconst db = new PowerSyncDatabase({\n  database: {\n    dbFilename: \"test.sqlite\",\n  },\n  schema: APP_SCHEMA,\n})\n\nconst collection = createCollection(\n  powerSyncCollectionOptions({\n    database: db,\n    table: APP_SCHEMA.props.documents\n  })\n)\n```\n\n## Call Signature\n\n```ts\nfunction powerSyncCollectionOptions<TTable, TSchema>(config): CollectionConfig<InferPowerSyncOutputType<TTable, TSchema>, string, TSchema, PowerSyncCollectionUtils<TTable>> & object & object;\n```\n\nDefined in: [powersync.ts:141](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/powersync.ts#L141)\n\nCreates a PowerSync collection configuration with schema validation.\n\nThe input types satisfy the SQLite column types.\n\nThe output types are defined by the provided schema. This schema can enforce additional\nvalidation or type transforms.\nArbitrary output typed mutations are encoded to SQLite for persistence. We provide a basic standard\nserialization implementation to serialize column values. Custom or advanced types require providing additional\nserializer specifications. Partial column overrides can be supplied to `serializer`.\n\n### Type Parameters\n\n#### TTable\n\n`TTable` *extends* `Table`\\<`ColumnsType`\\>\n\n#### TSchema\n\n`TSchema` *extends* `StandardSchemaV1`\\<[`OptionalExtractedTable`](../type-aliases/OptionalExtractedTable.md)\\<`TTable`\\>, `AnyTableColumnType`\\<`TTable`\\>\\>\n\n### Parameters\n\n#### config\n\n[`BasePowerSyncCollectionConfig`](../type-aliases/BasePowerSyncCollectionConfig.md)\\<`TTable`, `TSchema`\\> & [`SerializerConfig`](../type-aliases/SerializerConfig.md)\\<`InferOutput`\\<`TSchema`\\>, `ExtractedTable`\\<`TTable`\\>\\> & `object`\n\n### Returns\n\n`CollectionConfig`\\<[`InferPowerSyncOutputType`](../type-aliases/InferPowerSyncOutputType.md)\\<`TTable`, `TSchema`\\>, `string`, `TSchema`, [`PowerSyncCollectionUtils`](../type-aliases/PowerSyncCollectionUtils.md)\\<`TTable`\\>\\> & `object` & `object`\n\n### Example\n\n```typescript\nimport { z } from \"zod\"\n\n// The PowerSync SQLite schema\nconst APP_SCHEMA = new Schema({\n  documents: new Table({\n    name: column.text,\n    // Dates are stored as ISO date strings in SQLite\n    created_at: column.text\n  }),\n})\n\n// Advanced Zod validations. The output type of this schema\n// is constrained to the SQLite schema of APP_SCHEMA\nconst schema = z.object({\n  id: z.string(),\n  // Notice that `name` is not nullable (is required) here and it has additional validation\n  name: z.string().min(3, { message: \"Should be at least 3 characters\" }).nullable(),\n  // The input type is still the SQLite string type. While collections will output smart Date instances.\n  created_at: z.string().transform(val => new Date(val))\n})\n\nconst collection = createCollection(\n  powerSyncCollectionOptions({\n    database: db,\n    table: APP_SCHEMA.props.documents,\n    schema,\n    serializer: {\n       // The default is toISOString, this is just to demonstrate custom overrides\n       created_at: (outputValue) => outputValue.toISOString(),\n    },\n  })\n)\n```\n\n## Call Signature\n\n```ts\nfunction powerSyncCollectionOptions<TTable, TSchema>(config): CollectionConfig<InferPowerSyncOutputType<TTable, TSchema>, string, TSchema, PowerSyncCollectionUtils<TTable>> & object & object;\n```\n\nDefined in: [powersync.ts:209](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/powersync.ts#L209)\n\nCreates a PowerSync collection configuration with schema validation.\n\nThe input types are not linked to the internal SQLite table types. This can\ngive greater flexibility, e.g. by accepting rich types as input for `insert` or `update` operations.\nAn additional `deserializationSchema` is required in order to process incoming SQLite updates to the output type.\n\nThe output types are defined by the provided schema. This schema can enforce additional\nvalidation or type transforms.\nArbitrary output typed mutations are encoded to SQLite for persistence. We provide a basic standard\nserialization implementation to serialize column values. Custom or advanced types require providing additional\nserializer specifications. Partial column overrides can be supplied to `serializer`.\n\n### Type Parameters\n\n#### TTable\n\n`TTable` *extends* `Table`\\<`ColumnsType`\\>\n\n#### TSchema\n\n`TSchema` *extends* `StandardSchemaV1`\\<`AnyTableColumnType`\\<`TTable`\\>, `AnyTableColumnType`\\<`TTable`\\>\\>\n\n### Parameters\n\n#### config\n\n[`BasePowerSyncCollectionConfig`](../type-aliases/BasePowerSyncCollectionConfig.md)\\<`TTable`, `TSchema`\\> & [`SerializerConfig`](../type-aliases/SerializerConfig.md)\\<`InferOutput`\\<`TSchema`\\>, `ExtractedTable`\\<`TTable`\\>\\> & `object`\n\n### Returns\n\n`CollectionConfig`\\<[`InferPowerSyncOutputType`](../type-aliases/InferPowerSyncOutputType.md)\\<`TTable`, `TSchema`\\>, `string`, `TSchema`, [`PowerSyncCollectionUtils`](../type-aliases/PowerSyncCollectionUtils.md)\\<`TTable`\\>\\> & `object` & `object`\n\n### Example\n\n```typescript\nimport { z } from \"zod\"\n\n// The PowerSync SQLite schema\nconst APP_SCHEMA = new Schema({\n  documents: new Table({\n    name: column.text,\n    // Booleans are represented as integers in SQLite\n    is_active: column.integer\n  }),\n})\n\n// Advanced Zod validations.\n// We accept boolean values as input for operations and expose Booleans in query results\nconst schema = z.object({\n  id: z.string(),\n  isActive: z.boolean(), // TInput and TOutput are boolean\n})\n\n// The deserializationSchema converts the SQLite synced INTEGER (0/1) values to booleans.\nconst deserializationSchema = z.object({\n  id: z.string(),\n  isActive: z.number().nullable().transform((val) => val == null ? true : val > 0),\n})\n\nconst collection = createCollection(\n  powerSyncCollectionOptions({\n    database: db,\n    table: APP_SCHEMA.props.documents,\n    schema,\n    deserializationSchema,\n  })\n)\n```\n","originalRawMarkdown":"---\nid: powerSyncCollectionOptions\ntitle: powerSyncCollectionOptions\n---\n\nImplementation of powerSyncCollectionOptions that handles both schema and non-schema configurations.\n\n## Call Signature\n\n```ts\nfunction powerSyncCollectionOptions<TTable>(config): EnhancedPowerSyncCollectionConfig<TTable, OptionalExtractedTable<TTable>, never>;\n```\n\nDefined in: [powersync.ts:84](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/powersync.ts#L84)\n\nCreates a PowerSync collection configuration with basic default validation.\nInput and Output types are the SQLite column types.\n\n### Type Parameters\n\n#### TTable\n\n`TTable` *extends* `Table`\\<`ColumnsType`\\> = `Table`\\<`ColumnsType`\\>\n\n### Parameters\n\n#### config\n\n[`BasePowerSyncCollectionConfig`](../type-aliases/BasePowerSyncCollectionConfig.md)\\<`TTable`, `never`\\> & [`ConfigWithSQLiteTypes`](../type-aliases/ConfigWithSQLiteTypes.md)\n\n### Returns\n\n[`EnhancedPowerSyncCollectionConfig`](../type-aliases/EnhancedPowerSyncCollectionConfig.md)\\<`TTable`, [`OptionalExtractedTable`](../type-aliases/OptionalExtractedTable.md)\\<`TTable`\\>, `never`\\>\n\n### Example\n\n```typescript\nconst APP_SCHEMA = new Schema({\n  documents: new Table({\n    name: column.text,\n  }),\n})\n\ntype Document = (typeof APP_SCHEMA)[\"types\"][\"documents\"]\n\nconst db = new PowerSyncDatabase({\n  database: {\n    dbFilename: \"test.sqlite\",\n  },\n  schema: APP_SCHEMA,\n})\n\nconst collection = createCollection(\n  powerSyncCollectionOptions({\n    database: db,\n    table: APP_SCHEMA.props.documents\n  })\n)\n```\n\n## Call Signature\n\n```ts\nfunction powerSyncCollectionOptions<TTable, TSchema>(config): CollectionConfig<InferPowerSyncOutputType<TTable, TSchema>, string, TSchema, PowerSyncCollectionUtils<TTable>> & object & object;\n```\n\nDefined in: [powersync.ts:141](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/powersync.ts#L141)\n\nCreates a PowerSync collection configuration with schema validation.\n\nThe input types satisfy the SQLite column types.\n\nThe output types are defined by the provided schema. This schema can enforce additional\nvalidation or type transforms.\nArbitrary output typed mutations are encoded to SQLite for persistence. We provide a basic standard\nserialization implementation to serialize column values. Custom or advanced types require providing additional\nserializer specifications. Partial column overrides can be supplied to `serializer`.\n\n### Type Parameters\n\n#### TTable\n\n`TTable` *extends* `Table`\\<`ColumnsType`\\>\n\n#### TSchema\n\n`TSchema` *extends* `StandardSchemaV1`\\<[`OptionalExtractedTable`](../type-aliases/OptionalExtractedTable.md)\\<`TTable`\\>, `AnyTableColumnType`\\<`TTable`\\>\\>\n\n### Parameters\n\n#### config\n\n[`BasePowerSyncCollectionConfig`](../type-aliases/BasePowerSyncCollectionConfig.md)\\<`TTable`, `TSchema`\\> & [`SerializerConfig`](../type-aliases/SerializerConfig.md)\\<`InferOutput`\\<`TSchema`\\>, `ExtractedTable`\\<`TTable`\\>\\> & `object`\n\n### Returns\n\n`CollectionConfig`\\<[`InferPowerSyncOutputType`](../type-aliases/InferPowerSyncOutputType.md)\\<`TTable`, `TSchema`\\>, `string`, `TSchema`, [`PowerSyncCollectionUtils`](../type-aliases/PowerSyncCollectionUtils.md)\\<`TTable`\\>\\> & `object` & `object`\n\n### Example\n\n```typescript\nimport { z } from \"zod\"\n\n// The PowerSync SQLite schema\nconst APP_SCHEMA = new Schema({\n  documents: new Table({\n    name: column.text,\n    // Dates are stored as ISO date strings in SQLite\n    created_at: column.text\n  }),\n})\n\n// Advanced Zod validations. The output type of this schema\n// is constrained to the SQLite schema of APP_SCHEMA\nconst schema = z.object({\n  id: z.string(),\n  // Notice that `name` is not nullable (is required) here and it has additional validation\n  name: z.string().min(3, { message: \"Should be at least 3 characters\" }).nullable(),\n  // The input type is still the SQLite string type. While collections will output smart Date instances.\n  created_at: z.string().transform(val => new Date(val))\n})\n\nconst collection = createCollection(\n  powerSyncCollectionOptions({\n    database: db,\n    table: APP_SCHEMA.props.documents,\n    schema,\n    serializer: {\n       // The default is toISOString, this is just to demonstrate custom overrides\n       created_at: (outputValue) => outputValue.toISOString(),\n    },\n  })\n)\n```\n\n## Call Signature\n\n```ts\nfunction powerSyncCollectionOptions<TTable, TSchema>(config): CollectionConfig<InferPowerSyncOutputType<TTable, TSchema>, string, TSchema, PowerSyncCollectionUtils<TTable>> & object & object;\n```\n\nDefined in: [powersync.ts:209](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/powersync.ts#L209)\n\nCreates a PowerSync collection configuration with schema validation.\n\nThe input types are not linked to the internal SQLite table types. This can\ngive greater flexibility, e.g. by accepting rich types as input for `insert` or `update` operations.\nAn additional `deserializationSchema` is required in order to process incoming SQLite updates to the output type.\n\nThe output types are defined by the provided schema. This schema can enforce additional\nvalidation or type transforms.\nArbitrary output typed mutations are encoded to SQLite for persistence. We provide a basic standard\nserialization implementation to serialize column values. Custom or advanced types require providing additional\nserializer specifications. Partial column overrides can be supplied to `serializer`.\n\n### Type Parameters\n\n#### TTable\n\n`TTable` *extends* `Table`\\<`ColumnsType`\\>\n\n#### TSchema\n\n`TSchema` *extends* `StandardSchemaV1`\\<`AnyTableColumnType`\\<`TTable`\\>, `AnyTableColumnType`\\<`TTable`\\>\\>\n\n### Parameters\n\n#### config\n\n[`BasePowerSyncCollectionConfig`](../type-aliases/BasePowerSyncCollectionConfig.md)\\<`TTable`, `TSchema`\\> & [`SerializerConfig`](../type-aliases/SerializerConfig.md)\\<`InferOutput`\\<`TSchema`\\>, `ExtractedTable`\\<`TTable`\\>\\> & `object`\n\n### Returns\n\n`CollectionConfig`\\<[`InferPowerSyncOutputType`](../type-aliases/InferPowerSyncOutputType.md)\\<`TTable`, `TSchema`\\>, `string`, `TSchema`, [`PowerSyncCollectionUtils`](../type-aliases/PowerSyncCollectionUtils.md)\\<`TTable`\\>\\> & `object` & `object`\n\n### Example\n\n```typescript\nimport { z } from \"zod\"\n\n// The PowerSync SQLite schema\nconst APP_SCHEMA = new Schema({\n  documents: new Table({\n    name: column.text,\n    // Booleans are represented as integers in SQLite\n    is_active: column.integer\n  }),\n})\n\n// Advanced Zod validations.\n// We accept boolean values as input for operations and expose Booleans in query results\nconst schema = z.object({\n  id: z.string(),\n  isActive: z.boolean(), // TInput and TOutput are boolean\n})\n\n// The deserializationSchema converts the SQLite synced INTEGER (0/1) values to booleans.\nconst deserializationSchema = z.object({\n  id: z.string(),\n  isActive: z.number().nullable().transform((val) => val == null ? true : val > 0),\n})\n\nconst collection = createCollection(\n  powerSyncCollectionOptions({\n    database: db,\n    table: APP_SCHEMA.props.documents,\n    schema,\n    deserializationSchema,\n  })\n)\n```\n"}
