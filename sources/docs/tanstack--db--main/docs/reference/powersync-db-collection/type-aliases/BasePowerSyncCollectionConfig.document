type":"paragraph","children":[{"type":"text","value":"Smaller values may lower memory usage and allow earlier\nstreaming of initial results, at the cost of more query calls."}]}]}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"code","value":"table: TTable;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The PowerSync schema Table definition"}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"ttable","children":[{"type":"text","value":"TTable"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTable"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Table"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Table"}]},{"type":"heading","depth":3,"id":"tschema","children":[{"type":"text","value":"TSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":"> = "},{"type":"inlineCode","value":"never"}]}],"headings":[{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"database","text":"database","level":3},{"id":"syncbatchsize","text":"syncBatchSize?","level":3},{"id":"remarks","text":"Remarks","level":4},{"id":"table","text":"table","level":3},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"ttable","text":"TTable","level":3},{"id":"tschema","text":"TSchema","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype BasePowerSyncCollectionConfig<TTable, TSchema> = Omit<BaseCollectionConfig<InferPowerSyncOutputType<TTable, TSchema>, string, TSchema>, \"onInsert\" | \"onUpdate\" | \"onDelete\" | \"getKey\" | \"syncMode\"> & object & \n  | EagerSyncHooks\n  | OnDemandSyncHooks;\n```\n\nDefined in: [definitions.ts:205](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/definitions.ts#L205)\n\n## Type Declaration\n\n### database\n\n```ts\ndatabase: CommonPowerSyncDatabase;\n```\n\nThe PowerSync database instance\n\n### syncBatchSize?\n\n```ts\noptional syncBatchSize: number;\n```\n\nThe maximum number of documents to read from the SQLite table\nin a single batch during the initial sync between PowerSync and the\nin-memory TanStack DB collection.\n\n#### Remarks\n\n- Defaults to [DEFAULT\\_BATCH\\_SIZE](../variables/DEFAULT_BATCH_SIZE.md) if not specified.\n- Larger values reduce the number of round trips to the storage\n  engine but increase memory usage per batch.\n- Smaller values may lower memory usage and allow earlier\n  streaming of initial results, at the cost of more query calls.\n\n### table\n\n```ts\ntable: TTable;\n```\n\nThe PowerSync schema Table definition\n\n## Type Parameters\n\n### TTable\n\n`TTable` *extends* `Table` = `Table`\n\n### TSchema\n\n`TSchema` *extends* `StandardSchemaV1`\\<`any`\\> = `never`\n","originalRawMarkdown":"---\nid: BasePowerSyncCollectionConfig\ntitle: BasePowerSyncCollectionConfig\n---\n\n```ts\ntype BasePowerSyncCollectionConfig<TTable, TSchema> = Omit<BaseCollectionConfig<InferPowerSyncOutputType<TTable, TSchema>, string, TSchema>, \"onInsert\" | \"onUpdate\" | \"onDelete\" | \"getKey\" | \"syncMode\"> & object & \n  | EagerSyncHooks\n  | OnDemandSyncHooks;\n```\n\nDefined in: [definitions.ts:205](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/definitions.ts#L205)\n\n## Type Declaration\n\n### database\n\n```ts\ndatabase: CommonPowerSyncDatabase;\n```\n\nThe PowerSync database instance\n\n### syncBatchSize?\n\n```ts\noptional syncBatchSize: number;\n```\n\nThe maximum number of documents to read from the SQLite table\nin a single batch during the initial sync between PowerSync and the\nin-memory TanStack DB collection.\n\n#### Remarks\n\n- Defaults to [DEFAULT\\_BATCH\\_SIZE](../variables/DEFAULT_BATCH_SIZE.md) if not specified.\n- Larger values reduce the number of round trips to the storage\n  engine but increase memory usage per batch.\n- Smaller values may lower memory usage and allow earlier\n  streaming of initial results, at the cost of more query calls.\n\n### table\n\n```ts\ntable: TTable;\n```\n\nThe PowerSync schema Table definition\n\n## Type Parameters\n\n### TTable\n\n`TTable` *extends* `Table` = `Table`\n\n### TSchema\n\n`TSchema` *extends* `StandardSchemaV1`\\<`any`\\> = `never`\n"}
