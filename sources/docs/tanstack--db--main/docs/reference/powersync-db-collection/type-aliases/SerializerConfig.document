itions.ts:98"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Application logic should ensure that incoming synced data is always valid.\nFailing to deserialize and apply incoming changes results in data inconsistency - which is a fatal error.\nUse this callback to react to deserialization errors."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"error","children":[{"type":"text","value":"error"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"StandardSchemaV1.FailureResult"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"serializer","children":[{"type":"text","value":"serializer?"}]},{"type":"code","value":"optional serializer: CustomSQLiteSerializer<TOutput, TSQLite>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/definitions.ts#L91","children":[{"type":"text","value":"definitions.ts:91"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional partial serializer object for customizing how individual columns are serialized for SQLite."}]},{"type":"paragraph","children":[{"type":"text","value":"This should be a partial map of column keys to serialization functions, following the\n"},{"type":"link","href":"CustomSQLiteSerializer.md","children":[{"type":"text","value":"CustomSQLiteSerializer"}]},{"type":"text","value":" type. Each function receives the column value and returns a value\ncompatible with SQLite storage."}]},{"type":"paragraph","children":[{"type":"text","value":"If not provided for a column, the default behavior is used:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TEXT"},{"type":"text","value":": Strings are stored as-is; Dates are converted to ISO strings; other types are JSON-stringified."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"INTEGER"},{"type":"text","value":"/"},{"type":"inlineCode","value":"REAL"},{"type":"text","value":": Numbers are stored as-is; booleans are mapped to 1/0."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this option to override serialization for specific columns, such as formatting dates, handling enums,\nor serializing complex objects."}]},{"type":"paragraph","children":[{"type":"text","value":"Example:"}]},{"type":"code","value":"serializer: {\n  createdAt: (date) => date.getTime(), // Store as timestamp\n  meta: (meta) => JSON.stringify(meta), // Custom object serialization\n}","lang":"typescript"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"toutput","text":"TOutput","level":3},{"id":"tsqlite","text":"TSQLite","level":3},{"id":"properties","text":"Properties","level":2},{"id":"ondeserializationerror","text":"onDeserializationError()","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"error","text":"error","level":5},{"id":"returns","text":"Returns","level":4},{"id":"serializer","text":"serializer?","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype SerializerConfig<TOutput, TSQLite> = object;\n```\n\nDefined in: [definitions.ts:65](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/definitions.ts#L65)\n\n## Type Parameters\n\n### TOutput\n\n`TOutput` *extends* `Record`\\<`string`, `unknown`\\>\n\n### TSQLite\n\n`TSQLite` *extends* `Record`\\<`string`, `unknown`\\>\n\n## Properties\n\n### onDeserializationError()\n\n```ts\nonDeserializationError: (error) => void;\n```\n\nDefined in: [definitions.ts:98](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/definitions.ts#L98)\n\nApplication logic should ensure that incoming synced data is always valid.\nFailing to deserialize and apply incoming changes results in data inconsistency - which is a fatal error.\nUse this callback to react to deserialization errors.\n\n#### Parameters\n\n##### error\n\n`StandardSchemaV1.FailureResult`\n\n#### Returns\n\n`void`\n\n***\n\n### serializer?\n\n```ts\noptional serializer: CustomSQLiteSerializer<TOutput, TSQLite>;\n```\n\nDefined in: [definitions.ts:91](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/definitions.ts#L91)\n\nOptional partial serializer object for customizing how individual columns are serialized for SQLite.\n\nThis should be a partial map of column keys to serialization functions, following the\n[CustomSQLiteSerializer](CustomSQLiteSerializer.md) type. Each function receives the column value and returns a value\ncompatible with SQLite storage.\n\nIf not provided for a column, the default behavior is used:\n  - `TEXT`: Strings are stored as-is; Dates are converted to ISO strings; other types are JSON-stringified.\n  - `INTEGER`/`REAL`: Numbers are stored as-is; booleans are mapped to 1/0.\n\nUse this option to override serialization for specific columns, such as formatting dates, handling enums,\nor serializing complex objects.\n\nExample:\n```typescript\nserializer: {\n  createdAt: (date) => date.getTime(), // Store as timestamp\n  meta: (meta) => JSON.stringify(meta), // Custom object serialization\n}\n```\n","originalRawMarkdown":"---\nid: SerializerConfig\ntitle: SerializerConfig\n---\n\n```ts\ntype SerializerConfig<TOutput, TSQLite> = object;\n```\n\nDefined in: [definitions.ts:65](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/definitions.ts#L65)\n\n## Type Parameters\n\n### TOutput\n\n`TOutput` *extends* `Record`\\<`string`, `unknown`\\>\n\n### TSQLite\n\n`TSQLite` *extends* `Record`\\<`string`, `unknown`\\>\n\n## Properties\n\n### onDeserializationError()\n\n```ts\nonDeserializationError: (error) => void;\n```\n\nDefined in: [definitions.ts:98](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/definitions.ts#L98)\n\nApplication logic should ensure that incoming synced data is always valid.\nFailing to deserialize and apply incoming changes results in data inconsistency - which is a fatal error.\nUse this callback to react to deserialization errors.\n\n#### Parameters\n\n##### error\n\n`StandardSchemaV1.FailureResult`\n\n#### Returns\n\n`void`\n\n***\n\n### serializer?\n\n```ts\noptional serializer: CustomSQLiteSerializer<TOutput, TSQLite>;\n```\n\nDefined in: [definitions.ts:91](https://github.com/TanStack/db/blob/main/packages/powersync-db-collection/src/definitions.ts#L91)\n\nOptional partial serializer object for customizing how individual columns are serialized for SQLite.\n\nThis should be a partial map of column keys to serialization functions, following the\n[CustomSQLiteSerializer](CustomSQLiteSerializer.md) type. Each function receives the column value and returns a value\ncompatible with SQLite storage.\n\nIf not provided for a column, the default behavior is used:\n  - `TEXT`: Strings are stored as-is; Dates are converted to ISO strings; other types are JSON-stringified.\n  - `INTEGER`/`REAL`: Numbers are stored as-is; booleans are mapped to 1/0.\n\nUse this option to override serialization for specific columns, such as formatting dates, handling enums,\nor serializing complex objects.\n\nExample:\n```typescript\nserializer: {\n  createdAt: (date) => date.getTime(), // Store as timestamp\n  meta: (meta) => JSON.stringify(meta), // Custom object serialization\n}\n```\n"}
