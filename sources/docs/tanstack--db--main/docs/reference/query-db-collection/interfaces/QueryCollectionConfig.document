value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":" = "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"The type of the item keys"}]},{"type":"heading","depth":3,"id":"tschema","children":[{"type":"text","value":"TSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"StandardSchemaV1"},{"type":"text","value":" = "},{"type":"inlineCode","value":"never"}]},{"type":"paragraph","children":[{"type":"text","value":"The schema type for validation"}]},{"type":"heading","depth":3,"id":"tquerydata","children":[{"type":"text","value":"TQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Awaited"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReturnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFn"},{"type":"text","value":">>"}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"enabled","children":[{"type":"text","value":"enabled?"}]},{"type":"code","value":"optional enabled: Enabled<TQueryData, TError, TQueryData, TQueryKey>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L147","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:147"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether the query should automatically run (default: true)"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"gctime","children":[{"type":"text","value":"gcTime?"}]},{"type":"code","value":"optional gcTime: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L182","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:182"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Time in milliseconds after which the collection will be garbage collected\nwhen it has no active subscribers. Defaults to 5 minutes (300000ms).\nSync started without subscribers gets a minimum 50ms grace period.\nPending preloads retain the collection until they settle. Preloading ready\ndata refreshes the retention period. A non-positive or non-finite value\ndisables automatic garbage collection."}]},{"type":"heading","depth":4,"id":"overrides","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"BaseCollectionConfig.gcTime","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"initialdata","children":[{"type":"text","value":"initialData?"}]},{"type":"code","value":"optional initialData: TQueryData | InitialDataFunction<TQueryData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L222","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:222"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Data used to initialize the TanStack Query cache for an eager collection.\nThe value has the original Query response shape and is projected through\nthe collection's select option before rows are materialized."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"initialdataupdatedat","children":[{"type":"text","value":"initialDataUpdatedAt?"}]},{"type":"code","value":"optional initialDataUpdatedAt: number | () => number | undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L230","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:230"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The timestamp TanStack Query uses to determine initialData freshness."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"meta","children":[{"type":"text","value":"meta?"}]},{"type":"code","value":"optional meta: Record<string, unknown>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L259","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:259"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Metadata to pass to the query.\nAvailable in queryFn via context.meta"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Using meta for error context\nqueryFn: async (context) => {\n  try {\n    return await api.getTodos(userId)\n  } catch (error) {\n    // Use meta for better error messages\n    throw new Error(\n      context.meta?.errorMessage || 'Failed to load todos'\n    )\n  }\n},\nmeta: {\n  errorMessage: `Failed to load todos for user ${userId}`\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"networkmode","children":[{"type":"text","value":"networkMode?"}]},{"type":"code","value":"optional networkMode: NetworkMode;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L210","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:210"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"persistedgctime","children":[{"type":"text","value":"persistedGcTime?"}]},{"type":"code","value":"optional persistedGcTime: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L237","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:237"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient"}]},{"type":"code","value":"queryClient: QueryClient;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L143","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:143"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The TanStack Query client instance"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"queryfn","children":[{"type":"text","value":"queryFn"}]},{"type":"code","value":"queryFn: TQueryFn extends (context) => any[] | Promise<any[]> ? (context) => T[] | Promise<T[]> : TQueryFn;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L132","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:132"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Function that fetches data from the server. Must return the complete collection state"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"querykey","children":[{"type":"text","value":"queryKey"}]},{"type":"code","value":"queryKey: TQueryKey | TQueryKeyBuilder<TQueryKey>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L130","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:130"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The query key used by TanStack Query to identify this query"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"refetchinterval","children":[{"type":"text","value":"refetchInterval?"}]},{"type":"code","value":"optional refetchInterval: number | false | (query) => number | false | undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L154","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:154"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"refetchonmount","children":[{"type":"text","value":"refetchOnMount?"}]},{"type":"code","value":"optional refetchOnMount: boolean | \"always\" | (query) => boolean | \"always\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L203","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:203"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"refetchonreconnect","children":[{"type":"text","value":"refetchOnReconnect?"}]},{"type":"code","value":"optional refetchOnReconnect: boolean | \"always\" | (query) => boolean | \"always\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L196","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:196"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"refetchonwindowfocus","children":[{"type":"text","value":"refetchOnWindowFocus?"}]},{"type":"code","value":"optional refetchOnWindowFocus: boolean | \"always\" | (query) => boolean | \"always\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L189","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:189"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"retry","children":[{"type":"text","value":"retry?"}]},{"type":"code","value":"optional retry: RetryValue<TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L161","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:161"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"retrydelay","children":[{"type":"text","value":"retryDelay?"}]},{"type":"code","value":"optional retryDelay: RetryDelayValue<TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L168","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:168"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"select","children":[{"type":"text","value":"select()?"}]},{"type":"code","value":"optional select: (data) => T[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L141","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:141"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Extracts the row array TanStack DB materializes from the Query response.\nThe Query cache keeps the original response shape."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"data","children":[{"type":"text","value":"data"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryData"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":"[]"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"staletime","children":[{"type":"text","value":"staleTime?"}]},{"type":"code","value":"optional staleTime: StaleTimeFunction<TQueryData, TError, TQueryData, TQueryKey>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L175","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:175"}]}]}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"tqueryfn","text":"TQueryFn","level":3},{"id":"terror","text":"TError","level":3},{"id":"tquerykey","text":"TQueryKey","level":3},{"id":"tkey","text":"TKey","level":3},{"id":"tschema","text":"TSchema","level":3},{"id":"tquerydata","text":"TQueryData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"enabled","text":"enabled?","level":3},{"id":"gctime","text":"gcTime?","level":3},{"id":"overrides","text":"Overrides","level":4},{"id":"initialdata","text":"initialData?","level":3},{"id":"initialdataupdatedat","text":"initialDataUpdatedAt?","level":3},{"id":"meta","text":"meta?","level":3},{"id":"example","text":"Example","level":4},{"id":"networkmode","text":"networkMode?","level":3},{"id":"persistedgctime","text":"persistedGcTime?","level":3},{"id":"queryclient","text":"queryClient","level":3},{"id":"queryfn","text":"queryFn","level":3},{"id":"querykey","text":"queryKey","level":3},{"id":"refetchinterval","text":"refetchInterval?","level":3},{"id":"refetchonmount","text":"refetchOnMount?","level":3},{"id":"refetchonreconnect","text":"refetchOnReconnect?","level":3},{"id":"refetchonwindowfocus","text":"refetchOnWindowFocus?","level":3},{"id":"retry","text":"retry?","level":3},{"id":"retrydelay","text":"retryDelay?","level":3},{"id":"select","text":"select()?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"data","text":"data","level":5},{"id":"returns","text":"Returns","level":4},{"id":"staletime","text":"staleTime?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-db-collection/src/query.ts:108](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L108)\n\nConfiguration options for creating a Query Collection\n\n## Extends\n\n- `BaseCollectionConfig`\\<`T`, `TKey`, `TSchema`, [`QueryCollectionUtils`](QueryCollectionUtils.md)\\<`T`, `TKey`, \\[`TSchema`\\] *extends* \\[`never`\\] ? `T` : `InferSchemaInput`\\<`TSchema`\\>, `TError`\\>\\>\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `object`\n\nThe explicit type of items stored in the collection\n\n### TQueryFn\n\n`TQueryFn` *extends* (`context`) => `any` = (`context`) => `any`\n\nThe queryFn type\n\n### TError\n\n`TError` = `unknown`\n\nThe type of errors that can occur during queries\n\n### TQueryKey\n\n`TQueryKey` *extends* `QueryKey` = `QueryKey`\n\nThe type of the query key\n\n### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\nThe type of the item keys\n\n### TSchema\n\n`TSchema` *extends* `StandardSchemaV1` = `never`\n\nThe schema type for validation\n\n### TQueryData\n\n`TQueryData` = `Awaited`\\<`ReturnType`\\<`TQueryFn`\\>\\>\n\n## Properties\n\n### enabled?\n\n```ts\noptional enabled: Enabled<TQueryData, TError, TQueryData, TQueryKey>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:147](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L147)\n\nWhether the query should automatically run (default: true)\n\n***\n\n### gcTime?\n\n```ts\noptional gcTime: number;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:182](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L182)\n\nTime in milliseconds after which the collection will be garbage collected\nwhen it has no active subscribers. Defaults to 5 minutes (300000ms).\nSync started without subscribers gets a minimum 50ms grace period.\nPending preloads retain the collection until they settle. Preloading ready\ndata refreshes the retention period. A non-positive or non-finite value\ndisables automatic garbage collection.\n\n#### Overrides\n\n```ts\nBaseCollectionConfig.gcTime\n```\n\n***\n\n### initialData?\n\n```ts\noptional initialData: TQueryData | InitialDataFunction<TQueryData>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:222](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L222)\n\nData used to initialize the TanStack Query cache for an eager collection.\nThe value has the original Query response shape and is projected through\nthe collection's select option before rows are materialized.\n\n***\n\n### initialDataUpdatedAt?\n\n```ts\noptional initialDataUpdatedAt: number | () => number | undefined;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:230](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L230)\n\nThe timestamp TanStack Query uses to determine initialData freshness.\n\n***\n\n### meta?\n\n```ts\noptional meta: Record<string, unknown>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:259](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L259)\n\nMetadata to pass to the query.\nAvailable in queryFn via context.meta\n\n#### Example\n\n```ts\n// Using meta for error context\nqueryFn: async (context) => {\n  try {\n    return await api.getTodos(userId)\n  } catch (error) {\n    // Use meta for better error messages\n    throw new Error(\n      context.meta?.errorMessage || 'Failed to load todos'\n    )\n  }\n},\nmeta: {\n  errorMessage: `Failed to load todos for user ${userId}`\n}\n```\n\n***\n\n### networkMode?\n\n```ts\noptional networkMode: NetworkMode;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:210](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L210)\n\n***\n\n### persistedGcTime?\n\n```ts\noptional persistedGcTime: number;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:237](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L237)\n\n***\n\n### queryClient\n\n```ts\nqueryClient: QueryClient;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:143](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L143)\n\nThe TanStack Query client instance\n\n***\n\n### queryFn\n\n```ts\nqueryFn: TQueryFn extends (context) => any[] | Promise<any[]> ? (context) => T[] | Promise<T[]> : TQueryFn;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:132](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L132)\n\nFunction that fetches data from the server. Must return the complete collection state\n\n***\n\n### queryKey\n\n```ts\nqueryKey: TQueryKey | TQueryKeyBuilder<TQueryKey>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:130](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L130)\n\nThe query key used by TanStack Query to identify this query\n\n***\n\n### refetchInterval?\n\n```ts\noptional refetchInterval: number | false | (query) => number | false | undefined;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:154](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L154)\n\n***\n\n### refetchOnMount?\n\n```ts\noptional refetchOnMount: boolean | \"always\" | (query) => boolean | \"always\";\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:203](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L203)\n\n***\n\n### refetchOnReconnect?\n\n```ts\noptional refetchOnReconnect: boolean | \"always\" | (query) => boolean | \"always\";\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:196](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L196)\n\n***\n\n### refetchOnWindowFocus?\n\n```ts\noptional refetchOnWindowFocus: boolean | \"always\" | (query) => boolean | \"always\";\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:189](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L189)\n\n***\n\n### retry?\n\n```ts\noptional retry: RetryValue<TError>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:161](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L161)\n\n***\n\n### retryDelay?\n\n```ts\noptional retryDelay: RetryDelayValue<TError>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:168](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L168)\n\n***\n\n### select()?\n\n```ts\noptional select: (data) => T[];\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:141](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L141)\n\nExtracts the row array TanStack DB materializes from the Query response.\nThe Query cache keeps the original response shape.\n\n#### Parameters\n\n##### data\n\n`TQueryData`\n\n#### Returns\n\n`T`[]\n\n***\n\n### staleTime?\n\n```ts\noptional staleTime: StaleTimeFunction<TQueryData, TError, TQueryData, TQueryKey>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:175](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L175)\n","originalRawMarkdown":"---\nid: QueryCollectionConfig\ntitle: QueryCollectionConfig\n---\n\nDefined in: [packages/query-db-collection/src/query.ts:108](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L108)\n\nConfiguration options for creating a Query Collection\n\n## Extends\n\n- `BaseCollectionConfig`\\<`T`, `TKey`, `TSchema`, [`QueryCollectionUtils`](QueryCollectionUtils.md)\\<`T`, `TKey`, \\[`TSchema`\\] *extends* \\[`never`\\] ? `T` : `InferSchemaInput`\\<`TSchema`\\>, `TError`\\>\\>\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `object`\n\nThe explicit type of items stored in the collection\n\n### TQueryFn\n\n`TQueryFn` *extends* (`context`) => `any` = (`context`) => `any`\n\nThe queryFn type\n\n### TError\n\n`TError` = `unknown`\n\nThe type of errors that can occur during queries\n\n### TQueryKey\n\n`TQueryKey` *extends* `QueryKey` = `QueryKey`\n\nThe type of the query key\n\n### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\nThe type of the item keys\n\n### TSchema\n\n`TSchema` *extends* `StandardSchemaV1` = `never`\n\nThe schema type for validation\n\n### TQueryData\n\n`TQueryData` = `Awaited`\\<`ReturnType`\\<`TQueryFn`\\>\\>\n\n## Properties\n\n### enabled?\n\n```ts\noptional enabled: Enabled<TQueryData, TError, TQueryData, TQueryKey>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:147](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L147)\n\nWhether the query should automatically run (default: true)\n\n***\n\n### gcTime?\n\n```ts\noptional gcTime: number;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:182](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L182)\n\nTime in milliseconds after which the collection will be garbage collected\nwhen it has no active subscribers. Defaults to 5 minutes (300000ms).\nSync started without subscribers gets a minimum 50ms grace period.\nPending preloads retain the collection until they settle. Preloading ready\ndata refreshes the retention period. A non-positive or non-finite value\ndisables automatic garbage collection.\n\n#### Overrides\n\n```ts\nBaseCollectionConfig.gcTime\n```\n\n***\n\n### initialData?\n\n```ts\noptional initialData: TQueryData | InitialDataFunction<TQueryData>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:222](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L222)\n\nData used to initialize the TanStack Query cache for an eager collection.\nThe value has the original Query response shape and is projected through\nthe collection's select option before rows are materialized.\n\n***\n\n### initialDataUpdatedAt?\n\n```ts\noptional initialDataUpdatedAt: number | () => number | undefined;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:230](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L230)\n\nThe timestamp TanStack Query uses to determine initialData freshness.\n\n***\n\n### meta?\n\n```ts\noptional meta: Record<string, unknown>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:259](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L259)\n\nMetadata to pass to the query.\nAvailable in queryFn via context.meta\n\n#### Example\n\n```ts\n// Using meta for error context\nqueryFn: async (context) => {\n  try {\n    return await api.getTodos(userId)\n  } catch (error) {\n    // Use meta for better error messages\n    throw new Error(\n      context.meta?.errorMessage || 'Failed to load todos'\n    )\n  }\n},\nmeta: {\n  errorMessage: `Failed to load todos for user ${userId}`\n}\n```\n\n***\n\n### networkMode?\n\n```ts\noptional networkMode: NetworkMode;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:210](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L210)\n\n***\n\n### persistedGcTime?\n\n```ts\noptional persistedGcTime: number;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:237](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L237)\n\n***\n\n### queryClient\n\n```ts\nqueryClient: QueryClient;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:143](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L143)\n\nThe TanStack Query client instance\n\n***\n\n### queryFn\n\n```ts\nqueryFn: TQueryFn extends (context) => any[] | Promise<any[]> ? (context) => T[] | Promise<T[]> : TQueryFn;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:132](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L132)\n\nFunction that fetches data from the server. Must return the complete collection state\n\n***\n\n### queryKey\n\n```ts\nqueryKey: TQueryKey | TQueryKeyBuilder<TQueryKey>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:130](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L130)\n\nThe query key used by TanStack Query to identify this query\n\n***\n\n### refetchInterval?\n\n```ts\noptional refetchInterval: number | false | (query) => number | false | undefined;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:154](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L154)\n\n***\n\n### refetchOnMount?\n\n```ts\noptional refetchOnMount: boolean | \"always\" | (query) => boolean | \"always\";\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:203](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L203)\n\n***\n\n### refetchOnReconnect?\n\n```ts\noptional refetchOnReconnect: boolean | \"always\" | (query) => boolean | \"always\";\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:196](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L196)\n\n***\n\n### refetchOnWindowFocus?\n\n```ts\noptional refetchOnWindowFocus: boolean | \"always\" | (query) => boolean | \"always\";\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:189](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L189)\n\n***\n\n### retry?\n\n```ts\noptional retry: RetryValue<TError>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:161](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L161)\n\n***\n\n### retryDelay?\n\n```ts\noptional retryDelay: RetryDelayValue<TError>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:168](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L168)\n\n***\n\n### select()?\n\n```ts\noptional select: (data) => T[];\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:141](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L141)\n\nExtracts the row array TanStack DB materializes from the Query response.\nThe Query cache keeps the original response shape.\n\n#### Parameters\n\n##### data\n\n`TQueryData`\n\n#### Returns\n\n`T`[]\n\n***\n\n### staleTime?\n\n```ts\noptional staleTime: StaleTimeFunction<TQueryData, TError, TQueryData, TQueryKey>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:175](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L175)\n"}
