]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"writeinsert","children":[{"type":"text","value":"writeInsert()"}]},{"type":"code","value":"writeInsert: (data) => Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L302","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:302"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Insert items without an optimistic update. Resolves when the sync commit applies."}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"data","children":[{"type":"text","value":"data"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TInsertInput"},{"type":"text","value":" | "},{"type":"inlineCode","value":"TInsertInput"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"writeupdate","children":[{"type":"text","value":"writeUpdate()"}]},{"type":"code","value":"writeUpdate: (updates) => Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L304","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:304"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Update items without an optimistic update. Resolves when the sync commit applies."}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"updates","children":[{"type":"text","value":"updates"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TItem"},{"type":"text","value":"> | "},{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TItem"},{"type":"text","value":">[]"}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"writeupsert","children":[{"type":"text","value":"writeUpsert()"}]},{"type":"code","value":"writeUpsert: (data) => Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L310","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:310"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Insert or update items without an optimistic update. Resolves when the sync commit applies."}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"data-2","children":[{"type":"text","value":"data"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TItem"},{"type":"text","value":"> | "},{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TItem"},{"type":"text","value":">[]"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"titem","text":"TItem","level":3},{"id":"tkey","text":"TKey","level":3},{"id":"tinsertinput","text":"TInsertInput","level":3},{"id":"terror","text":"TError","level":3},{"id":"properties","text":"Properties","level":2},{"id":"clearerror","text":"clearError()","level":3},{"id":"returns","text":"Returns","level":4},{"id":"throws","text":"Throws","level":4},{"id":"dataupdatedat","text":"dataUpdatedAt","level":3},{"id":"errorcount","text":"errorCount","level":3},{"id":"fetchstatus","text":"fetchStatus","level":3},{"id":"iserror","text":"isError","level":3},{"id":"isfetching","text":"isFetching","level":3},{"id":"isloading","text":"isLoading","level":3},{"id":"isrefetching","text":"isRefetching","level":3},{"id":"lasterror","text":"lastError","level":3},{"id":"refetch","text":"refetch","level":3},{"id":"writebatch","text":"writeBatch()","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"callback","text":"callback","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"writedelete","text":"writeDelete()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"keys","text":"keys","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"writeinsert","text":"writeInsert()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"data","text":"data","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"writeupdate","text":"writeUpdate()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"updates","text":"updates","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"writeupsert","text":"writeUpsert()","level":3},{"id":"parameters-5","text":"Parameters","level":4},{"id":"data-2","text":"data","level":5},{"id":"returns-6","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-db-collection/src/query.ts:291](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L291)\n\nUtility methods available on Query Collections for direct writes and manual operations.\nDirect writes bypass optimistic mutations and write to the synced data store.\nEager collections patch Query cache; on-demand collections revalidate scoped entries.\n\n## Type Parameters\n\n### TItem\n\n`TItem` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\nThe type of items stored in the collection\n\n### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\nThe type of the item keys\n\n### TInsertInput\n\n`TInsertInput` *extends* `object` = `TItem`\n\nThe type accepted for insert operations\n\n### TError\n\n`TError` = `unknown`\n\nThe type of errors that can occur during queries\n\n## Properties\n\n### clearError()\n\n```ts\nclearError: () => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:347](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L347)\n\nRefetch, retaining errors until a successful result applies. While a user\nmutation is persisting or its handler is active, this retains the Query\nfetch boundary so it cannot wait on publication blocked by that\ntransaction.\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\nPromise that resolves when the applicable refetch boundary completes\n\n#### Throws\n\nError if the refetch fails\n\n***\n\n### dataUpdatedAt\n\n```ts\ndataUpdatedAt: number;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:331](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L331)\n\nGet timestamp of last successful data update (in milliseconds)\n\n***\n\n### errorCount\n\n```ts\nerrorCount: number;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:323](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L323)\n\nGet the number of consecutive sync failures.\nIncremented only when query fails completely (not per retry attempt); reset after a successful result applies.\n\n***\n\n### fetchStatus\n\n```ts\nfetchStatus: \"idle\" | \"fetching\" | \"paused\";\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:337](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L337)\n\nGet the aggregate observer fetch status. Returns `fetching` if any\nobserver is fetching, otherwise `paused` if any observer is paused, and\n`idle` when every observer is idle or no observers exist.\n\n***\n\n### isError\n\n```ts\nisError: boolean;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:318](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L318)\n\nCheck if the collection is in an error state\n\n***\n\n### isFetching\n\n```ts\nisFetching: boolean;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:325](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L325)\n\nCheck if query is currently fetching (initial or background)\n\n***\n\n### isLoading\n\n```ts\nisLoading: boolean;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:329](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L329)\n\nCheck if query is loading for the first time (no data yet)\n\n***\n\n### isRefetching\n\n```ts\nisRefetching: boolean;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:327](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L327)\n\nCheck if query is refetching in background (not initial fetch)\n\n***\n\n### lastError\n\n```ts\nlastError: TError | undefined;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:316](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L316)\n\nGet the last error encountered by the query (if any); reset after a successful result applies\n\n***\n\n### refetch\n\n```ts\nrefetch: RefetchFn;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:300](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L300)\n\nManually refetch and await the applicable fetch or application boundary.\n\n***\n\n### writeBatch()\n\n```ts\nwriteBatch: (callback) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:312](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L312)\n\nExecute direct writes as one atomic batch. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### callback\n\n() => `void`\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### writeDelete()\n\n```ts\nwriteDelete: (keys) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:308](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L308)\n\nDelete items without an optimistic update. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### keys\n\n`TKey` | `TKey`[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### writeInsert()\n\n```ts\nwriteInsert: (data) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:302](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L302)\n\nInsert items without an optimistic update. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### data\n\n`TInsertInput` | `TInsertInput`[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### writeUpdate()\n\n```ts\nwriteUpdate: (updates) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:304](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L304)\n\nUpdate items without an optimistic update. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### updates\n\n`Partial`\\<`TItem`\\> | `Partial`\\<`TItem`\\>[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### writeUpsert()\n\n```ts\nwriteUpsert: (data) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:310](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L310)\n\nInsert or update items without an optimistic update. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### data\n\n`Partial`\\<`TItem`\\> | `Partial`\\<`TItem`\\>[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n","originalRawMarkdown":"---\nid: QueryCollectionUtils\ntitle: QueryCollectionUtils\n---\n\nDefined in: [packages/query-db-collection/src/query.ts:291](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L291)\n\nUtility methods available on Query Collections for direct writes and manual operations.\nDirect writes bypass optimistic mutations and write to the synced data store.\nEager collections patch Query cache; on-demand collections revalidate scoped entries.\n\n## Type Parameters\n\n### TItem\n\n`TItem` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\nThe type of items stored in the collection\n\n### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\nThe type of the item keys\n\n### TInsertInput\n\n`TInsertInput` *extends* `object` = `TItem`\n\nThe type accepted for insert operations\n\n### TError\n\n`TError` = `unknown`\n\nThe type of errors that can occur during queries\n\n## Properties\n\n### clearError()\n\n```ts\nclearError: () => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:347](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L347)\n\nRefetch, retaining errors until a successful result applies. While a user\nmutation is persisting or its handler is active, this retains the Query\nfetch boundary so it cannot wait on publication blocked by that\ntransaction.\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\nPromise that resolves when the applicable refetch boundary completes\n\n#### Throws\n\nError if the refetch fails\n\n***\n\n### dataUpdatedAt\n\n```ts\ndataUpdatedAt: number;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:331](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L331)\n\nGet timestamp of last successful data update (in milliseconds)\n\n***\n\n### errorCount\n\n```ts\nerrorCount: number;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:323](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L323)\n\nGet the number of consecutive sync failures.\nIncremented only when query fails completely (not per retry attempt); reset after a successful result applies.\n\n***\n\n### fetchStatus\n\n```ts\nfetchStatus: \"idle\" | \"fetching\" | \"paused\";\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:337](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L337)\n\nGet the aggregate observer fetch status. Returns `fetching` if any\nobserver is fetching, otherwise `paused` if any observer is paused, and\n`idle` when every observer is idle or no observers exist.\n\n***\n\n### isError\n\n```ts\nisError: boolean;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:318](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L318)\n\nCheck if the collection is in an error state\n\n***\n\n### isFetching\n\n```ts\nisFetching: boolean;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:325](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L325)\n\nCheck if query is currently fetching (initial or background)\n\n***\n\n### isLoading\n\n```ts\nisLoading: boolean;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:329](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L329)\n\nCheck if query is loading for the first time (no data yet)\n\n***\n\n### isRefetching\n\n```ts\nisRefetching: boolean;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:327](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L327)\n\nCheck if query is refetching in background (not initial fetch)\n\n***\n\n### lastError\n\n```ts\nlastError: TError | undefined;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:316](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L316)\n\nGet the last error encountered by the query (if any); reset after a successful result applies\n\n***\n\n### refetch\n\n```ts\nrefetch: RefetchFn;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:300](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L300)\n\nManually refetch and await the applicable fetch or application boundary.\n\n***\n\n### writeBatch()\n\n```ts\nwriteBatch: (callback) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:312](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L312)\n\nExecute direct writes as one atomic batch. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### callback\n\n() => `void`\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### writeDelete()\n\n```ts\nwriteDelete: (keys) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:308](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L308)\n\nDelete items without an optimistic update. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### keys\n\n`TKey` | `TKey`[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### writeInsert()\n\n```ts\nwriteInsert: (data) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:302](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L302)\n\nInsert items without an optimistic update. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### data\n\n`TInsertInput` | `TInsertInput`[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### writeUpdate()\n\n```ts\nwriteUpdate: (updates) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:304](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L304)\n\nUpdate items without an optimistic update. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### updates\n\n`Partial`\\<`TItem`\\> | `Partial`\\<`TItem`\\>[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n\n***\n\n### writeUpsert()\n\n```ts\nwriteUpsert: (data) => Promise<void>;\n```\n\nDefined in: [packages/query-db-collection/src/query.ts:310](https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L310)\n\nInsert or update items without an optimistic update. Resolves when the sync commit applies.\n\n#### Parameters\n\n##### data\n\n`Partial`\\<`TItem`\\> | `Partial`\\<`TItem`\\>[]\n\n#### Returns\n\n`Promise`\\<`void`\\>\n"}
