{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L291","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:291"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Utility methods available on Query Collections for direct writes and manual operations.\nDirect writes bypass optimistic mutations and write to the synced data store.\nEager collections patch Query cache; on-demand collections revalidate scoped entries."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"titem","children":[{"type":"text","value":"TItem"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TItem"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The type of items stored in the collection"}]},{"type":"heading","depth":3,"id":"tkey","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":" = "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"The type of the item keys"}]},{"type":"heading","depth":3,"id":"tinsertinput","children":[{"type":"text","value":"TInsertInput"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TInsertInput"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TItem"}]},{"type":"paragraph","children":[{"type":"text","value":"The type accepted for insert operations"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"paragraph","children":[{"type":"text","value":"The type of errors that can occur during queries"}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"clearerror","children":[{"type":"text","value":"clearError()"}]},{"type":"code","value":"clearError: () => Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L347","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:347"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Refetch, retaining errors until a successful result applies. While a user\nmutation is persisting or its handler is active, this retains the Query\nfetch boundary so it cannot wait on publication blocked by that\ntransaction."}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Promise that resolves when the applicable refetch boundary completes"}]},{"type":"heading","depth":4,"id":"throws","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"Error if the refetch fails"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"dataupdatedat","children":[{"type":"text","value":"dataUpdatedAt"}]},{"type":"code","value":"dataUpdatedAt: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L331","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:331"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Get timestamp of last successful data update (in milliseconds)"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"errorcount","children":[{"type":"text","value":"errorCount"}]},{"type":"code","value":"errorCount: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L323","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:323"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Get the number of consecutive sync failures.\nIncremented only when query fails completely (not per retry attempt); reset after a successful result applies."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"fetchstatus","children":[{"type":"text","value":"fetchStatus"}]},{"type":"code","value":"fetchStatus: \"idle\" | \"fetching\" | \"paused\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L337","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:337"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Get the aggregate observer fetch status. Returns "},{"type":"inlineCode","value":"fetching"},{"type":"text","value":" if any\nobserver is fetching, otherwise "},{"type":"inlineCode","value":"paused"},{"type":"text","value":" if any observer is paused, and\n"},{"type":"inlineCode","value":"idle"},{"type":"text","value":" when every observer is idle or no observers exist."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"iserror","children":[{"type":"text","value":"isError"}]},{"type":"code","value":"isError: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L318","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:318"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Check if the collection is in an error state"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isfetching","children":[{"type":"text","value":"isFetching"}]},{"type":"code","value":"isFetching: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L325","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:325"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Check if query is currently fetching (initial or background)"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isloading","children":[{"type":"text","value":"isLoading"}]},{"type":"code","value":"isLoading: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/query-db-collection/src/query.ts#L329","children":[{"type":"text","value":"packages/query-db-collection/src/query.ts:329"}]}]},{"type":"paragraph","chil