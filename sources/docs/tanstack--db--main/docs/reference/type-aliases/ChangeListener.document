{"document":{"type":"root","children":[{"type":"code","value":"type ChangeListener<T, TKey> = (changes) => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L1173","children":[{"type":"text","value":"packages/db/src/types.ts:1173"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Function type for listening to collection changes\nChanges to the same key retain their causal order within a callback.\nChanges to different keys have no promised order within a callback."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"t","children":[{"type":"text","value":"T"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"tkey","children":[{"type":"text","value":"TKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":" = "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"changes","children":[{"type":"text","value":"changes"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ChangeMessage.md","children":[{"type":"inlineCode","value":"ChangeMessage"}]},{"type":"text","value":"<"},{"type":"link","href":"WithVirtualProps.md","children":[{"type":"inlineCode","value":"WithVirtualProps"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TKey"},{"type":"text","value":">[]"}]},{"type":"paragraph","children":[{"type":"text","value":"Array of change messages describing what happened"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// Basic change listener\nconst listener: ChangeListener = (changes) => {\n  changes.forEach(change => {\n    console.log(`${change.type}: ${change.key}`, change.value)\n  })\n}\n\ncollection.subscribeChanges(listener)","lang":"ts"},{"type":"code","value":"// Handle different change types\nconst listener: ChangeListener<Todo> = (changes) => {\n  for (const change of changes) {\n    switch (change.type) {\n      case 'insert':\n        addToUI(change.value)\n        break\n      case 'update':\n        updateInUI(change.key, change.value, change.previousValue)\n        break\n      case 'delete':\n        removeFromUI(change.key)\n        break\n    }\n  }\n}","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"tkey","text":"TKey","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"changes","text":"changes","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype ChangeListener<T, TKey> = (changes) => void;\n```\n\nDefined in: [packages/db/src/types.ts:1173](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L1173)\n\nFunction type for listening to collection changes\nChanges to the same key retain their causal order within a callback.\nChanges to different keys have no promised order within a callback.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\n## Parameters\n\n### changes\n\n[`ChangeMessage`](../interfaces/ChangeMessage.md)\\<[`WithVirtualProps`](WithVirtualProps.md)\\<`T`, `TKey`\\>, `TKey`\\>[]\n\nArray of change messages describing what happened\n\n## Returns\n\n`void`\n\n## Examples\n\n```ts\n// Basic change listener\nconst listener: ChangeListener = (changes) => {\n  changes.forEach(change => {\n    console.log(`${change.type}: ${change.key}`, change.value)\n  })\n}\n\ncollection.subscribeChanges(listener)\n```\n\n```ts\n// Handle different change types\nconst listener: ChangeListener<Todo> = (changes) => {\n  for (const change of changes) {\n    switch (change.type) {\n      case 'insert':\n        addToUI(change.value)\n        break\n      case 'update':\n        updateInUI(change.key, change.value, change.previousValue)\n        break\n      case 'delete':\n        removeFromUI(change.key)\n        break\n    }\n  }\n}\n```\n","originalRawMarkdown":"---\nid: ChangeListener\ntitle: ChangeListener\n---\n\n```ts\ntype ChangeListener<T, TKey> = (changes) => void;\n```\n\nDefined in: [packages/db/src/types.ts:1173](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L1173)\n\nFunction type for listening to collection changes\nChanges to the same key retain their causal order within a callback.\nChanges to different keys have no promised order within a callback.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n### TKey\n\n`TKey` *extends* `string` \\| `number` = `string` \\| `number`\n\n## Parameters\n\n### changes\n\n[`ChangeMessage`](../interfaces/ChangeMessage.md)\\<[`WithVirtualProps`](WithVirtualProps.md)\\<`T`, `TKey`\\>, `TKey`\\>[]\n\nArray of change messages describing what happened\n\n## Returns\n\n`void`\n\n## Examples\n\n```ts\n// Basic change listener\nconst listener: ChangeListener = (changes) => {\n  changes.forEach(change => {\n    console.log(`${change.type}: ${change.key}`, change.value)\n  })\n}\n\ncollection.subscribeChanges(listener)\n```\n\n```ts\n// Handle different change types\nconst listener: ChangeListener<Todo> = (changes) => {\n  for (const change of changes) {\n    switch (change.type) {\n      case 'insert':\n        addToUI(change.value)\n        break\n      case 'update':\n        updateInUI(change.key, change.value, change.previousValue)\n        break\n      case 'delete':\n        removeFromUI(change.key)\n        break\n    }\n  }\n}\n```\n"}
