type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"INNER JOIN"},{"type":"text","value":": No tables become optional"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"State Tracking"}]},{"type":"text","value":": Updates hasJoins and joinTypes for future operations"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Context Evolution"}]},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"baseSchema"},{"type":"text","value":": Unchanged (always the original "},{"type":"inlineCode","value":"from()"},{"type":"text","value":" tables)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"schema"},{"type":"text","value":": Expanded with new tables and proper optionality"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"hasJoins"},{"type":"text","value":": Set to true"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"joinTypes"},{"type":"text","value":": Updated to track this join type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"result"},{"type":"text","value":": Preserved from previous operations"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"All other context state is preserved"}]}]}]},{"type":"heading","depth":2,"id":"type-declaration","children":[{"type":"text","value":"Type Declaration"}]},{"type":"heading","depth":3,"id":"baseschema","children":[{"type":"text","value":"baseSchema"}]},{"type":"code","value":"baseSchema: TContext[\"baseSchema\"];","lang":"ts"},{"type":"heading","depth":3,"id":"fromsourcename","children":[{"type":"text","value":"fromSourceName"}]},{"type":"code","value":"fromSourceName: TContext[\"fromSourceName\"];","lang":"ts"},{"type":"heading","depth":3,"id":"hasjoins","children":[{"type":"text","value":"hasJoins"}]},{"type":"code","value":"hasJoins: true;","lang":"ts"},{"type":"heading","depth":3,"id":"jointypes","children":[{"type":"text","value":"joinTypes"}]},{"type":"code","value":"joinTypes: TContext[\"joinTypes\"] extends Record<string, any> ? TContext[\"joinTypes\"] : object & { [K in keyof TNewSchema & string]: TJoinType };","lang":"ts"},{"type":"heading","depth":3,"id":"refsschema","children":[{"type":"text","value":"refsSchema"}]},{"type":"code","value":"refsSchema: ApplyJoinOptionalityToMergedSchema<RefsSchemaForContext<TContext>, TNewSchema, TJoinType, FromSourceNamesForOptionality<TContext>>;","lang":"ts"},{"type":"heading","depth":3,"id":"schema","children":[{"type":"text","value":"schema"}]},{"type":"code","value":"schema: ApplyJoinOptionalityToMergedSchema<TContext[\"schema\"], TNewSchema, TJoinType, FromSourceNamesForOptionality<TContext>>;","lang":"ts"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tcontext","children":[{"type":"text","value":"TContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TContext"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../interfaces/Context.md","children":[{"type":"inlineCode","value":"Context"}]}]},{"type":"heading","depth":3,"id":"tnewschema","children":[{"type":"text","value":"TNewSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TNewSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"ContextSchema.md","children":[{"type":"inlineCode","value":"ContextSchema"}]}]},{"type":"heading","depth":3,"id":"tjointype","children":[{"type":"text","value":"TJoinType"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TJoinType"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"\"inner\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"left\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"right\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"full\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"outer\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"cross\""}]}],"headings":[{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"baseschema","text":"baseSchema","level":3},{"id":"fromsourcename","text":"fromSourceName","level":3},{"id":"hasjoins","text":"hasJoins","level":3},{"id":"jointypes","text":"joinTypes","level":3},{"id":"refsschema","text":"refsSchema","level":3},{"id":"schema","text":"schema","level":3},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tcontext","text":"TContext","level":3},{"id":"tnewschema","text":"TNewSchema","level":3},{"id":"tjointype","text":"TJoinType","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype MergeContextWithJoinType<TContext, TNewSchema, TJoinType> = Omit<TContext, \"schema\" | \"refsSchema\" | \"hasJoins\" | \"joinTypes\"> & object;\n```\n\nDefined in: [packages/db/src/query/builder/types.ts:983](https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/types.ts#L983)\n\nMergeContextWithJoinType - Creates a new context after a join operation\n\nThis is the core type that handles the complex logic of merging schemas\nwhen tables are joined, applying the correct optionality based on join type.\n\n**Key Responsibilities**:\n1. **Schema Merging**: Combines existing schema with newly joined tables\n2. **Optionality Logic**: Applies join-specific optionality rules:\n   - `LEFT JOIN`: New table becomes optional\n   - `RIGHT JOIN`: Existing tables become optional\n   - `FULL JOIN`: Both existing and new become optional\n   - `INNER JOIN`: No tables become optional\n3. **State Tracking**: Updates hasJoins and joinTypes for future operations\n\n**Context Evolution**:\n- `baseSchema`: Unchanged (always the original `from()` tables)\n- `schema`: Expanded with new tables and proper optionality\n- `hasJoins`: Set to true\n- `joinTypes`: Updated to track this join type\n- `result`: Preserved from previous operations\n- All other context state is preserved\n\n## Type Declaration\n\n### baseSchema\n\n```ts\nbaseSchema: TContext[\"baseSchema\"];\n```\n\n### fromSourceName\n\n```ts\nfromSourceName: TContext[\"fromSourceName\"];\n```\n\n### hasJoins\n\n```ts\nhasJoins: true;\n```\n\n### joinTypes\n\n```ts\njoinTypes: TContext[\"joinTypes\"] extends Record<string, any> ? TContext[\"joinTypes\"] : object & { [K in keyof TNewSchema & string]: TJoinType };\n```\n\n### refsSchema\n\n```ts\nrefsSchema: ApplyJoinOptionalityToMergedSchema<RefsSchemaForContext<TContext>, TNewSchema, TJoinType, FromSourceNamesForOptionality<TContext>>;\n```\n\n### schema\n\n```ts\nschema: ApplyJoinOptionalityToMergedSchema<TContext[\"schema\"], TNewSchema, TJoinType, FromSourceNamesForOptionality<TContext>>;\n```\n\n## Type Parameters\n\n### TContext\n\n`TContext` *extends* [`Context`](../interfaces/Context.md)\n\n### TNewSchema\n\n`TNewSchema` *extends* [`ContextSchema`](ContextSchema.md)\n\n### TJoinType\n\n`TJoinType` *extends* `\"inner\"` \\| `\"left\"` \\| `\"right\"` \\| `\"full\"` \\| `\"outer\"` \\| `\"cross\"`\n","originalRawMarkdown":"---\nid: MergeContextWithJoinType\ntitle: MergeContextWithJoinType\n---\n\n```ts\ntype MergeContextWithJoinType<TContext, TNewSchema, TJoinType> = Omit<TContext, \"schema\" | \"refsSchema\" | \"hasJoins\" | \"joinTypes\"> & object;\n```\n\nDefined in: [packages/db/src/query/builder/types.ts:983](https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/types.ts#L983)\n\nMergeContextWithJoinType - Creates a new context after a join operation\n\nThis is the core type that handles the complex logic of merging schemas\nwhen tables are joined, applying the correct optionality based on join type.\n\n**Key Responsibilities**:\n1. **Schema Merging**: Combines existing schema with newly joined tables\n2. **Optionality Logic**: Applies join-specific optionality rules:\n   - `LEFT JOIN`: New table becomes optional\n   - `RIGHT JOIN`: Existing tables become optional\n   - `FULL JOIN`: Both existing and new become optional\n   - `INNER JOIN`: No tables become optional\n3. **State Tracking**: Updates hasJoins and joinTypes for future operations\n\n**Context Evolution**:\n- `baseSchema`: Unchanged (always the original `from()` tables)\n- `schema`: Expanded with new tables and proper optionality\n- `hasJoins`: Set to true\n- `joinTypes`: Updated to track this join type\n- `result`: Preserved from previous operations\n- All other context state is preserved\n\n## Type Declaration\n\n### baseSchema\n\n```ts\nbaseSchema: TContext[\"baseSchema\"];\n```\n\n### fromSourceName\n\n```ts\nfromSourceName: TContext[\"fromSourceName\"];\n```\n\n### hasJoins\n\n```ts\nhasJoins: true;\n```\n\n### joinTypes\n\n```ts\njoinTypes: TContext[\"joinTypes\"] extends Record<string, any> ? TContext[\"joinTypes\"] : object & { [K in keyof TNewSchema & string]: TJoinType };\n```\n\n### refsSchema\n\n```ts\nrefsSchema: ApplyJoinOptionalityToMergedSchema<RefsSchemaForContext<TContext>, TNewSchema, TJoinType, FromSourceNamesForOptionality<TContext>>;\n```\n\n### schema\n\n```ts\nschema: ApplyJoinOptionalityToMergedSchema<TContext[\"schema\"], TNewSchema, TJoinType, FromSourceNamesForOptionality<TContext>>;\n```\n\n## Type Parameters\n\n### TContext\n\n`TContext` *extends* [`Context`](../interfaces/Context.md)\n\n### TNewSchema\n\n`TNewSchema` *extends* [`ContextSchema`](ContextSchema.md)\n\n### TJoinType\n\n`TJoinType` *extends* `\"inner\"` \\| `\"left\"` \\| `\"right\"` \\| `\"full\"` \\| `\"outer\"` \\| `\"cross\"`\n"}
