text","value":" → "},{"type":"inlineCode","value":"T | undefined"},{"type":"text","value":": Preserves optionality"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Ref<T> | null"},{"type":"text","value":" → "},{"type":"inlineCode","value":"T | null"},{"type":"text","value":": Preserves nullability"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Expression Types"}]},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"BasicExpression<T>"},{"type":"text","value":" → "},{"type":"inlineCode","value":"T"},{"type":"text","value":": Function results like "},{"type":"inlineCode","value":"upper()"},{"type":"text","value":" → "},{"type":"inlineCode","value":"string"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Aggregate<T>"},{"type":"text","value":" → "},{"type":"inlineCode","value":"T"},{"type":"text","value":": Aggregation results like "},{"type":"inlineCode","value":"count()"},{"type":"text","value":" → "},{"type":"inlineCode","value":"number"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"JavaScript Literals"}]},{"type":"text","value":" (pass through as-is):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"string"},{"type":"text","value":" → "},{"type":"inlineCode","value":"string"},{"type":"text","value":": String literals remain strings"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"number"},{"type":"text","value":" → "},{"type":"inlineCode","value":"number"},{"type":"text","value":": Numeric literals remain numbers"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"},{"type":"text","value":" → "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":": Boolean literals remain booleans"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"null"},{"type":"text","value":" → "},{"type":"inlineCode","value":"null"},{"type":"text","value":": Explicit null remains null"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"undefined"},{"type":"text","value":" → "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":": Direct undefined values"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Nested Objects"}]},{"type":"text","value":" (recursive):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Plain objects are recursively processed to handle nested projections"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"RefProxy objects are detected and their types extracted"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Example transformation:"}]},{"type":"code","value":"// Input:\n{ id: Ref<number>, name: Ref<string>, status: 'active', count: 42, profile: { bio: Ref<string> } }\n\n// Output:\n{ id: number, name: string, status: 'active', count: 42, profile: { bio: string } }","lang":"typescript"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tselectobject","children":[{"type":"text","value":"TSelectObject"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelectObject"}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tselectobject","text":"TSelectObject","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype ResultTypeFromSelect<TSelectObject> = IsAny<TSelectObject> extends true ? any : IsTrueRef<TSelectObject> extends true ? ExtractDirectSelectRef<TSelectObject> : WithoutRefBrand<Prettify<{ [K in keyof TSelectObject]: NeedsExtraction<TSelectObject[K]> extends true ? ExtractExpressionType<TSelectObject[K]> : TSelectObject[K] extends ToArrayWrapper<infer T> ? T[] : TSelectObject[K] extends ConcatToArrayWrapper<any> ? string : TSelectObject[K] extends MaterializeWrapper<infer T, infer IsSingle> ? IsSingle extends true ? (...) | (...) : (...)[] : (...)[(...)] extends { __brand: ...; _result?: ... } ? ResultTypeFromCaseWhen<(...)> : (...) extends (...) ? (...) : (...) }>>;\n```\n\nDefined in: [packages/db/src/query/builder/types.ts:413](https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/types.ts#L413)\n\nResultTypeFromSelect - Infers the result type from a select object\n\nThis complex type transforms the input to `select()` into the actual TypeScript\ntype that the query will return. It handles all the different kinds of values\nthat can appear in a select clause:\n\n**Ref/RefProxy Extraction**:\n- `RefProxy<T>` → `T`: Extracts the underlying type\n- `Ref<T> | undefined` → `T | undefined`: Preserves optionality\n- `Ref<T> | null` → `T | null`: Preserves nullability\n\n**Expression Types**:\n- `BasicExpression<T>` → `T`: Function results like `upper()` → `string`\n- `Aggregate<T>` → `T`: Aggregation results like `count()` → `number`\n\n**JavaScript Literals** (pass through as-is):\n- `string` → `string`: String literals remain strings\n- `number` → `number`: Numeric literals remain numbers\n- `boolean` → `boolean`: Boolean literals remain booleans\n- `null` → `null`: Explicit null remains null\n- `undefined` → `undefined`: Direct undefined values\n\n**Nested Objects** (recursive):\n- Plain objects are recursively processed to handle nested projections\n- RefProxy objects are detected and their types extracted\n\nExample transformation:\n```typescript\n// Input:\n{ id: Ref<number>, name: Ref<string>, status: 'active', count: 42, profile: { bio: Ref<string> } }\n\n// Output:\n{ id: number, name: string, status: 'active', count: 42, profile: { bio: string } }\n```\n\n## Type Parameters\n\n### TSelectObject\n\n`TSelectObject`\n","originalRawMarkdown":"---\nid: ResultTypeFromSelect\ntitle: ResultTypeFromSelect\n---\n\n```ts\ntype ResultTypeFromSelect<TSelectObject> = IsAny<TSelectObject> extends true ? any : IsTrueRef<TSelectObject> extends true ? ExtractDirectSelectRef<TSelectObject> : WithoutRefBrand<Prettify<{ [K in keyof TSelectObject]: NeedsExtraction<TSelectObject[K]> extends true ? ExtractExpressionType<TSelectObject[K]> : TSelectObject[K] extends ToArrayWrapper<infer T> ? T[] : TSelectObject[K] extends ConcatToArrayWrapper<any> ? string : TSelectObject[K] extends MaterializeWrapper<infer T, infer IsSingle> ? IsSingle extends true ? (...) | (...) : (...)[] : (...)[(...)] extends { __brand: ...; _result?: ... } ? ResultTypeFromCaseWhen<(...)> : (...) extends (...) ? (...) : (...) }>>;\n```\n\nDefined in: [packages/db/src/query/builder/types.ts:413](https://github.com/TanStack/db/blob/main/packages/db/src/query/builder/types.ts#L413)\n\nResultTypeFromSelect - Infers the result type from a select object\n\nThis complex type transforms the input to `select()` into the actual TypeScript\ntype that the query will return. It handles all the different kinds of values\nthat can appear in a select clause:\n\n**Ref/RefProxy Extraction**:\n- `RefProxy<T>` → `T`: Extracts the underlying type\n- `Ref<T> | undefined` → `T | undefined`: Preserves optionality\n- `Ref<T> | null` → `T | null`: Preserves nullability\n\n**Expression Types**:\n- `BasicExpression<T>` → `T`: Function results like `upper()` → `string`\n- `Aggregate<T>` → `T`: Aggregation results like `count()` → `number`\n\n**JavaScript Literals** (pass through as-is):\n- `string` → `string`: String literals remain strings\n- `number` → `number`: Numeric literals remain numbers\n- `boolean` → `boolean`: Boolean literals remain booleans\n- `null` → `null`: Explicit null remains null\n- `undefined` → `undefined`: Direct undefined values\n\n**Nested Objects** (recursive):\n- Plain objects are recursively processed to handle nested projections\n- RefProxy objects are detected and their types extracted\n\nExample transformation:\n```typescript\n// Input:\n{ id: Ref<number>, name: Ref<string>, status: 'active', count: 42, profile: { bio: Ref<string> } }\n\n// Output:\n{ id: number, name: string, status: 'active', count: 42, profile: { bio: string } }\n```\n\n## Type Parameters\n\n### TSelectObject\n\n`TSelectObject`\n"}
