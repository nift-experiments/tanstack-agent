r this array, TypeScript widens "},{"type":"inlineCode","value":"TOperation"},{"type":"text","value":" from the specific literal\n(e.g., "},{"type":"inlineCode","value":"\"delete\""},{"type":"text","value":") to the union "},{"type":"inlineCode","value":"OperationType"},{"type":"text","value":" ("},{"type":"inlineCode","value":"\"insert\" | \"update\" | \"delete\""},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This causes "},{"type":"inlineCode","value":"PendingMutation<T, OperationType>"},{"type":"text","value":" to evaluate the conditional type\n"},{"type":"inlineCode","value":"original: TOperation extends 'insert' ? {} : T"},{"type":"text","value":" as "},{"type":"inlineCode","value":"{} | T"},{"type":"text","value":" instead of just "},{"type":"inlineCode","value":"T"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"With "},{"type":"inlineCode","value":"Omit"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"We remove "},{"type":"inlineCode","value":"mutations"},{"type":"text","value":" from "},{"type":"inlineCode","value":"Transaction<T>"},{"type":"text","value":" first"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Then add back "},{"type":"inlineCode","value":"mutations: NonEmptyArray<PendingMutation<T, TOperation>>"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"TypeScript can properly narrow "},{"type":"inlineCode","value":"TOperation"},{"type":"text","value":" to the specific literal type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This ensures "},{"type":"inlineCode","value":"mutation.original"},{"type":"text","value":" is correctly typed as "},{"type":"inlineCode","value":"T"},{"type":"text","value":" (not "},{"type":"inlineCode","value":"{} | T"},{"type":"text","value":") when mapping"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"t","children":[{"type":"text","value":"T"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"toperation","children":[{"type":"text","value":"TOperation"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOperation"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"OperationType.md","children":[{"type":"inlineCode","value":"OperationType"}]},{"type":"text","value":" = "},{"type":"link","href":"OperationType.md","children":[{"type":"inlineCode","value":"OperationType"}]}]},{"type":"heading","depth":3,"id":"tcollection","children":[{"type":"text","value":"TCollection"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCollection"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../interfaces/Collection.md","children":[{"type":"inlineCode","value":"Collection"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":"> = "},{"type":"link","href":"../interfaces/Collection.md","children":[{"type":"inlineCode","value":"Collection"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]}],"headings":[{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"mutations","text":"mutations","level":3},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"toperation","text":"TOperation","level":3},{"id":"tcollection","text":"TCollection","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype TransactionWithMutations<T, TOperation, TCollection> = Omit<Transaction<T>, \"mutations\"> & object;\n```\n\nDefined in: [packages/db/src/types.ts:156](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L156)\n\nUtility type for a Transaction with at least one mutation\nThis is used internally by the Transaction.commit method\n\n## Type Declaration\n\n### mutations\n\n```ts\nmutations: NonEmptyArray<PendingMutation<T, TOperation, TCollection>>;\n```\n\nWe must omit the `mutations` property from `Transaction<T>` before intersecting\nbecause TypeScript intersects property types when the same property appears on\nboth sides of an intersection.\n\nWithout `Omit`:\n- `Transaction<T>` has `mutations: Array<PendingMutation<T>>`\n- The intersection would create: `Array<PendingMutation<T>> & NonEmptyArray<PendingMutation<T, TOperation>>`\n- When mapping over this array, TypeScript widens `TOperation` from the specific literal\n  (e.g., `\"delete\"`) to the union `OperationType` (`\"insert\" | \"update\" | \"delete\"`)\n- This causes `PendingMutation<T, OperationType>` to evaluate the conditional type\n  `original: TOperation extends 'insert' ? {} : T` as `{} | T` instead of just `T`\n\nWith `Omit`:\n- We remove `mutations` from `Transaction<T>` first\n- Then add back `mutations: NonEmptyArray<PendingMutation<T, TOperation>>`\n- TypeScript can properly narrow `TOperation` to the specific literal type\n- This ensures `mutation.original` is correctly typed as `T` (not `{} | T`) when mapping\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n### TOperation\n\n`TOperation` *extends* [`OperationType`](OperationType.md) = [`OperationType`](OperationType.md)\n\n### TCollection\n\n`TCollection` *extends* [`Collection`](../interfaces/Collection.md)\\<`T`, `any`, `any`, `any`, `any`\\> = [`Collection`](../interfaces/Collection.md)\\<`T`, `any`, `any`, `any`, `any`\\>\n","originalRawMarkdown":"---\nid: TransactionWithMutations\ntitle: TransactionWithMutations\n---\n\n```ts\ntype TransactionWithMutations<T, TOperation, TCollection> = Omit<Transaction<T>, \"mutations\"> & object;\n```\n\nDefined in: [packages/db/src/types.ts:156](https://github.com/TanStack/db/blob/main/packages/db/src/types.ts#L156)\n\nUtility type for a Transaction with at least one mutation\nThis is used internally by the Transaction.commit method\n\n## Type Declaration\n\n### mutations\n\n```ts\nmutations: NonEmptyArray<PendingMutation<T, TOperation, TCollection>>;\n```\n\nWe must omit the `mutations` property from `Transaction<T>` before intersecting\nbecause TypeScript intersects property types when the same property appears on\nboth sides of an intersection.\n\nWithout `Omit`:\n- `Transaction<T>` has `mutations: Array<PendingMutation<T>>`\n- The intersection would create: `Array<PendingMutation<T>> & NonEmptyArray<PendingMutation<T, TOperation>>`\n- When mapping over this array, TypeScript widens `TOperation` from the specific literal\n  (e.g., `\"delete\"`) to the union `OperationType` (`\"insert\" | \"update\" | \"delete\"`)\n- This causes `PendingMutation<T, OperationType>` to evaluate the conditional type\n  `original: TOperation extends 'insert' ? {} : T` as `{} | T` instead of just `T`\n\nWith `Omit`:\n- We remove `mutations` from `Transaction<T>` first\n- Then add back `mutations: NonEmptyArray<PendingMutation<T, TOperation>>`\n- TypeScript can properly narrow `TOperation` to the specific literal type\n- This ensures `mutation.original` is correctly typed as `T` (not `{} | T`) when mapping\n\n## Type Parameters\n\n### T\n\n`T` *extends* `object` = `Record`\\<`string`, `unknown`\\>\n\n### TOperation\n\n`TOperation` *extends* [`OperationType`](OperationType.md) = [`OperationType`](OperationType.md)\n\n### TCollection\n\n`TCollection` *extends* [`Collection`](../interfaces/Collection.md)\\<`T`, `any`, `any`, `any`, `any`\\> = [`Collection`](../interfaces/Collection.md)\\<`T`, `any`, `any`, `any`, `any`\\>\n"}
