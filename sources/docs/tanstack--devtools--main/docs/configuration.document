set to open the devtools"}]}]}]},{"type":"code","value":"type ModifierKey = 'Alt' | 'Control' | 'Meta' | 'Shift' | 'CtrlOrMeta';\ntype KeyboardKey = ModifierKey | (string & {});\n\n{ openHotkey: Array<KeyboardKey> }","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"inspectHotkey"},{"type":"text","value":" - The hotkey set to open the source inspector"}]}]}]},{"type":"code","value":"type ModifierKey = 'Alt' | 'Control' | 'Meta' | 'Shift' | 'CtrlOrMeta';\ntype KeyboardKey = ModifierKey | (string & {});\n\n{ inspectHotkey: Array<KeyboardKey> }","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"requireUrlFlag"},{"type":"text","value":" - Requires a flag present in the url to enable devtools"}]}]}]},{"type":"code","value":"{ requireUrlFlag: boolean }","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"triggerImage"},{"type":"text","value":" - The image used for the dev tools trigger"}]}]}]},{"type":"code","value":"{ triggerImage: string }","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"urlFlag"},{"type":"text","value":" - The required flag that must be present in the url to enable devtools."}]}]}]},{"type":"code","value":"{ urlFlag: string }","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"eventBusConfig"},{"type":"text","value":" is configuration for the back bone of the devtools, the "},{"type":"inlineCode","value":"EventClient"},{"type":"text","value":", and accepts the following properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"debug"},{"type":"text","value":" - Enables debug mode for the EventBus"}]}]}]},{"type":"code","value":"{ debug: boolean }","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"connectToServerBus"},{"type":"text","value":" - Optional flag to indicate if the devtools server event bus is available to connect to"}]}]}]},{"type":"code","value":"{ connectToServerBus: boolean }","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"port"},{"type":"text","value":" - The port at which the client connects to the devtools server event bus"}]}]}]},{"type":"code","value":"{ port: number }","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Put together here is an example in react:"}]},{"type":"code","value":"import { StrictMode } from 'react'\nimport { createRoot } from 'react-dom/client'\nimport { FormDevtools } from '@tanstack/react-form'\n\nimport { TanStackDevtools } from '@tanstack/react-devtools'\n\nimport App from './App'\n\ncreateRoot(document.getElementById('root')!).render(\n  <StrictMode>\n    <App />\n\n    <TanStackDevtools\n      config={{ hideUntilHover: true }}\n      eventBusConfig={{ debug: true }}\n      plugins={[\n        {\n          name: 'TanStack Form',\n          render: <FormDevtools />,\n          defaultOpen: true,\n        },\n      ]}\n    />\n  </StrictMode>,\n)\n","lang":"tsx"},{"type":"heading","depth":2,"id":"eventclient-configuration","children":[{"type":"text","value":"EventClient Configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration for the "},{"type":"inlineCode","value":"EventClient"},{"type":"text","value":" is as follows"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"pluginId"},{"type":"text","value":" (required) - The plugin identifier used by the event bus to direct events to listeners"}]}]}]},{"type":"code","value":"{ pluginId: string }","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"debug"},{"type":"text","value":" - Enables debug mode for the EventClient"}]}]}]},{"type":"code","value":"{ debug: boolean }","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Put together the "},{"type":"inlineCode","value":"EventClient"},{"type":"text","value":" configuration looks like:"}]},{"type":"code","value":"import { EventClient } from '@tanstack/devtools-event-client'\n\ntype EventMap = {\n  'custom-state': { state: string }\n}\n\nclass customEventClient extends EventClient<EventMap> {\n  constructor() {\n    super({\n      debug: true,\n      pluginId: 'custom-devtools',\n    })\n  }\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"More information about EventClient configuration can be found in our "},{"type":"link","href":"https://tanstack.com/devtools/latest/docs/framework/react/examples/custom-devtools","children":[{"type":"text","value":"custom-plugins example"}]}]}],"headings":[{"id":"devtools-component-configuration","text":"Devtools Component Configuration","level":2},{"id":"eventclient-configuration","text":"EventClient Configuration","level":2}]},"frameworks":[],"downloadMarkdown":"\nBoth TanStack `DevTools` and `EventClient` can be configured.\n\n> [!IMPORTANT] \n> All configuration is optional unless marked (required)\n\n## Devtools Component Configuration\n\nThe `Devtools` component has two configuration props, regardless of Frameworks these are the same.\n\n- `config` - Configuration for the devtool panel and interaction with it.\n- `eventBusConfig` - Configuration for the event bus.\n\nThe `config` object is mainly focused around user interaction with the devtools panel and accepts the following properties:\n\n- `defaultOpen` - If the devtools are open by default\n\n```ts\n{ defaultOpen: boolean }\n```\n\n- `hideUntilHover` - Hides the TanStack devtools trigger until hovered\n\n```ts\n{ hideUntilHover: boolean }\n```\n\n- `position` - The position of the TanStack devtools trigger (used when `triggerMode` is `'fixed'`)\n\n```ts\n{ position: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'middle-left' | 'middle-right' }\n```\n\n- `triggerMode` - How the trigger is placed. `'floating'` (the default) lets you drag the trigger anywhere on screen, and throw it: it glides with momentum and springs back off the edges. Drag it off any screen edge to dock it as a slim tab. Hover the tab to show the TanStack mark, click it to open the panel, or drag it to pull the trigger back out, and hold it still over a glowing corner for two seconds to drop it there without pinning. `'fixed'` anchors it to `position`. The floating spot is persisted in local storage.\n\n```ts\n{ triggerMode: 'fixed' | 'floating' }\n```\n\n- `panelLocation` - The location of the devtools panel\n\n```ts\n{ panelLocation: 'top' | 'bottom' }\n```\n\n- `openHotkey` - The hotkey set to open the devtools\n\n```ts\ntype ModifierKey = 'Alt' | 'Control' | 'Meta' | 'Shift' | 'CtrlOrMeta';\ntype KeyboardKey = ModifierKey | (string & {});\n\n{ openHotkey: Array<KeyboardKey> }\n```\n\n- `inspectHotkey` - The hotkey set to open the source inspector\n\n```ts\ntype ModifierKey = 'Alt' | 'Control' | 'Meta' | 'Shift' | 'CtrlOrMeta';\ntype KeyboardKey = ModifierKey | (string & {});\n\n{ inspectHotkey: Array<KeyboardKey> }\n```\n\n- `requireUrlFlag` - Requires a flag present in the url to enable devtools\n\n```ts\n{ requireUrlFlag: boolean }\n```\n\n- `triggerImage` - The image used for the dev tools trigger\n\n```ts\n{ triggerImage: string }\n```\n\n- `urlFlag` - The required flag that must be present in the url to enable devtools.\n\n```ts\n{ urlFlag: string }\n```\n\nThe `eventBusConfig` is configuration for the back bone of the devtools, the `EventClient`, and accepts the following properties:\n\n- `debug` - Enables debug mode for the EventBus\n\n```ts\n{ debug: boolean }\n```\n\n- `connectToServerBus` - Optional flag to indicate if the devtools server event bus is available to connect to\n\n```ts\n{ connectToServerBus: boolean }\n```\n\n- `port` - The port at which the client connects to the devtools server event bus\n\n```ts\n{ port: number }\n```\n\nPut together here is an example in react:\n\n```tsx\nimport { StrictMode } from 'react'\nimport { createRoot } from 'react-dom/client'\nimport { FormDevtools } from '@tanstack/react-form'\n\nimport { TanStackDevtools } from '@tanstack/react-devtools'\n\nimport App from './App'\n\ncreateRoot(document.getElementById('root')!).render(\n  <StrictMode>\n    <App />\n\n    <TanStackDevtools\n      config={{ hideUntilHover: true }}\n      eventBusConfig={{ debug: true }}\n      plugins={[\n        {\n          name: 'TanStack Form',\n          render: <FormDevtools />,\n          defaultOpen: true,\n        },\n      ]}\n    />\n  </StrictMode>,\n)\n\n```\n\n## EventClient Configuration\n\nConfiguration for the `EventClient` is as follows\n\n- `pluginId` (required) - The plugin identifier used by the event bus to direct events to listeners\n\n```ts\n{ pluginId: string }\n```\n\n- `debug` - Enables debug mode for the EventClient\n\n```ts\n{ debug: boolean }\n```\n\nPut together the `EventClient` configuration looks like:\n\n```tsx\nimport { EventClient } from '@tanstack/devtools-event-client'\n\ntype EventMap = {\n  'custom-state': { state: string }\n}\n\nclass customEventClient extends EventClient<EventMap> {\n  constructor() {\n    super({\n      debug: true,\n      pluginId: 'custom-devtools',\n    })\n  }\n}\n```\n\nMore information about EventClient configuration can be found in our [custom-plugins example](https://tanstack.com/devtools/latest/docs/framework/react/examples/custom-devtools)\n","originalRawMarkdown":"---\ntitle: Configuration\nid: configuration\n---\n\nBoth TanStack `DevTools` and `EventClient` can be configured.\n\n> [!IMPORTANT] \n> All configuration is optional unless marked (required)\n\n## Devtools Component Configuration\n\nThe `Devtools` component has two configuration props, regardless of Frameworks these are the same.\n\n- `config` - Configuration for the devtool panel and interaction with it.\n- `eventBusConfig` - Configuration for the event bus.\n\nThe `config` object is mainly focused around user interaction with the devtools panel and accepts the following properties:\n\n- `defaultOpen` - If the devtools are open by default\n\n```ts\n{ defaultOpen: boolean }\n```\n\n- `hideUntilHover` - Hides the TanStack devtools trigger until hovered\n\n```ts\n{ hideUntilHover: boolean }\n```\n\n- `position` - The position of the TanStack devtools trigger (used when `triggerMode` is `'fixed'`)\n\n```ts\n{ position: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'middle-left' | 'middle-right' }\n```\n\n- `triggerMode` - How the trigger is placed. `'floating'` (the default) lets you drag the trigger anywhere on screen, and throw it: it glides with momentum and springs back off the edges. Drag it off any screen edge to dock it as a slim tab. Hover the tab to show the TanStack mark, click it to open the panel, or drag it to pull the trigger back out, and hold it still over a glowing corner for two seconds to drop it there without pinning. `'fixed'` anchors it to `position`. The floating spot is persisted in local storage.\n\n```ts\n{ triggerMode: 'fixed' | 'floating' }\n```\n\n- `panelLocation` - The location of the devtools panel\n\n```ts\n{ panelLocation: 'top' | 'bottom' }\n```\n\n- `openHotkey` - The hotkey set to open the devtools\n\n```ts\ntype ModifierKey = 'Alt' | 'Control' | 'Meta' | 'Shift' | 'CtrlOrMeta';\ntype KeyboardKey = ModifierKey | (string & {});\n\n{ openHotkey: Array<KeyboardKey> }\n```\n\n- `inspectHotkey` - The hotkey set to open the source inspector\n\n```ts\ntype ModifierKey = 'Alt' | 'Control' | 'Meta' | 'Shift' | 'CtrlOrMeta';\ntype KeyboardKey = ModifierKey | (string & {});\n\n{ inspectHotkey: Array<KeyboardKey> }\n```\n\n- `requireUrlFlag` - Requires a flag present in the url to enable devtools\n\n```ts\n{ requireUrlFlag: boolean }\n```\n\n- `triggerImage` - The image used for the dev tools trigger\n\n```ts\n{ triggerImage: string }\n```\n\n- `urlFlag` - The required flag that must be present in the url to enable devtools.\n\n```ts\n{ urlFlag: string }\n```\n\nThe `eventBusConfig` is configuration for the back bone of the devtools, the `EventClient`, and accepts the following properties:\n\n- `debug` - Enables debug mode for the EventBus\n\n```ts\n{ debug: boolean }\n```\n\n- `connectToServerBus` - Optional flag to indicate if the devtools server event bus is available to connect to\n\n```ts\n{ connectToServerBus: boolean }\n```\n\n- `port` - The port at which the client connects to the devtools server event bus\n\n```ts\n{ port: number }\n```\n\nPut together here is an example in react:\n\n```tsx\nimport { StrictMode } from 'react'\nimport { createRoot } from 'react-dom/client'\nimport { FormDevtools } from '@tanstack/react-form'\n\nimport { TanStackDevtools } from '@tanstack/react-devtools'\n\nimport App from './App'\n\ncreateRoot(document.getElementById('root')!).render(\n  <StrictMode>\n    <App />\n\n    <TanStackDevtools\n      config={{ hideUntilHover: true }}\n      eventBusConfig={{ debug: true }}\n      plugins={[\n        {\n          name: 'TanStack Form',\n          render: <FormDevtools />,\n          defaultOpen: true,\n        },\n      ]}\n    />\n  </StrictMode>,\n)\n\n```\n\n## EventClient Configuration\n\nConfiguration for the `EventClient` is as follows\n\n- `pluginId` (required) - The plugin identifier used by the event bus to direct events to listeners\n\n```ts\n{ pluginId: string }\n```\n\n- `debug` - Enables debug mode for the EventClient\n\n```ts\n{ debug: boolean }\n```\n\nPut together the `EventClient` configuration looks like:\n\n```tsx\nimport { EventClient } from '@tanstack/devtools-event-client'\n\ntype EventMap = {\n  'custom-state': { state: string }\n}\n\nclass customEventClient extends EventClient<EventMap> {\n  constructor() {\n    super({\n      debug: true,\n      pluginId: 'custom-devtools',\n    })\n  }\n}\n```\n\nMore information about EventClient configuration can be found in our [custom-plugins example](https://tanstack.com/devtools/latest/docs/framework/react/examples/custom-devtools)\n"}
