(eventSuffix, payload)"},{"type":"text","value":" to dispatch an event. You pass only the "},{"type":"strong","children":[{"type":"text","value":"suffix"}]},{"type":"text","value":" (the part after the colon). The "},{"type":"inlineCode","value":"pluginId"},{"type":"text","value":" is prepended automatically:"}]},{"type":"code","value":"// If pluginId is 'my-plugin' and event map has 'state-update'\nmyEventClient.emit('state-update', { count: 42 })\n// Dispatches event named 'my-plugin:state-update'","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"If the client is not yet connected to the bus, the event is queued and flushed once the connection succeeds (see "},{"type":"link","href":"#connection-lifecycle","children":[{"type":"text","value":"Connection Lifecycle"}]},{"type":"text","value":" below)."}]},{"type":"heading","depth":2,"id":"listening-to-events","children":[{"type":"text","value":"Listening to Events"}]},{"type":"paragraph","children":[{"type":"text","value":"There are three methods for subscribing to events. Each returns a cleanup function you call to unsubscribe."}]},{"type":"heading","depth":3,"id":"on-eventsuffix-callback","children":[{"type":"inlineCode","value":"on(eventSuffix, callback)"}]},{"type":"paragraph","children":[{"type":"text","value":"Listen to a specific event from this plugin. Like "},{"type":"inlineCode","value":"emit"},{"type":"text","value":", you pass only the suffix:"}]},{"type":"code","value":"const cleanup = myEventClient.on('state-update', (event) => {\n  console.log(event.payload.count) // typed as { count: number }\n})\n\n// Later: stop listening\ncleanup()","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The callback receives the full event object:"}]},{"type":"code","value":"{\n  type: 'my-plugin:state-update', // fully qualified event name\n  payload: { count: number },     // typed payload\n  pluginId: 'my-plugin'           // originating plugin\n}","lang":"ts"},{"type":"heading","depth":3,"id":"onall-callback","children":[{"type":"inlineCode","value":"onAll(callback)"}]},{"type":"paragraph","children":[{"type":"text","value":"Listen to "},{"type":"strong","children":[{"type":"text","value":"all"}]},{"type":"text","value":" events from "},{"type":"strong","children":[{"type":"text","value":"all"}]},{"type":"text","value":" plugins. Useful for logging, debugging, or building cross-plugin features:"}]},{"type":"code","value":"const cleanup = myEventClient.onAll((event) => {\n  console.log(event.type, event.payload)\n})","lang":"ts"},{"type":"heading","depth":3,"id":"onallpluginevents-callback","children":[{"type":"inlineCode","value":"onAllPluginEvents(callback)"}]},{"type":"paragraph","children":[{"type":"text","value":"Listen to all events from "},{"type":"strong","children":[{"type":"text","value":"this"}]},{"type":"text","value":" plugin only (filtered by "},{"type":"inlineCode","value":"pluginId"},{"type":"text","value":"):"}]},{"type":"code","value":"const cleanup = myEventClient.onAllPluginEvents((event) => {\n  // Only fires for events where event.pluginId === 'my-plugin'\n  console.log(event.type, event.payload)\n})","lang":"ts"},{"type":"heading","depth":2,"id":"connection-lifecycle","children":[{"type":"text","value":"Connection Lifecycle"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"EventClient"},{"type":"text","value":" manages its connection to the event bus automatically:"}]},{"type":"code","value":"stateDiagram-v2\n    [*] --> Queueing: First emit() call\n    Queueing --> Connecting: Dispatches tanstack-connect\n    Connecting --> Retrying: No response\n    Retrying --> Connecting: Every 300ms (up to 5×)\n    Connecting --> Connected: tanstack-connect-success\n    Connected --> Connected: Emit events directly\n    Queueing --> Connected: Flush queued events\n    Retrying --> Failed: 5 retries exhausted\n    Failed --> [*]: Subsequent emits dropped","lang":"mermaid"},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Queueing"}]},{"type":"text","value":" — When you call "},{"type":"inlineCode","value":"emit()"},{"type":"text","value":" before the client is connected, events are queued in memory."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Connection"}]},{"type":"text","value":" — On the first "},{"type":"inlineCode","value":"emit()"},{"type":"text","value":", the client dispatches a "},{"type":"inlineCode","value":"tanstack-connect"},{"type":"text","value":" event and starts a retry loop."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Retries"}]},{"type":"text","value":" — The client retries every "},{"type":"inlineCode","value":"reconnectEveryMs"},{"type":"text","value":" (default: 300ms) up to a maximum of 5 attempts."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Flush"}]},{"type":"text","value":" — Once a "},{"type":"inlineCode","value":"tanstack-connect-success"},{"type":"text","value":" event is received, all queued events are flushed to the bus in order."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Failure"}]},{"type":"text","value":" — If all 5 retries are exhausted without a successful connection, the client stops retrying. Subsequent "},{"type":"inlineCode","value":"emit()"},{"type":"text","value":" calls are silently dropped (they will not be queued)."}]}]}]},{"type":"heading","depth":3,"id":"the-enabled-option","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" Option"}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" is set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":", the EventClient is effectively inert — "},{"type":"inlineCode","value":"emit()"},{"type":"text","value":" is a no-op and "},{"type":"inlineCode","value":"on()"},{"type":"text","value":" returns a no-op cleanup function. This is useful for conditionally disabling devtools instrumentation (e.g., in production)."}]},{"type":"heading","depth":2,"id":"server-event-bus","children":[{"type":"text","value":"Server Event Bus"}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"connectToServerBus: true"},{"type":"text","value":" is set in the component's "},{"type":"inlineCode","value":"eventBusConfig"},{"type":"text","value":" prop, the "},{"type":"inlineCode","value":"ClientEventBus"},{"type":"text","value":" connects to the "},{"type":"inlineCode","value":"ServerEventBus"},{"type":"text","value":" started by the Vite plugin (default port 4206). This enables server-side features like console piping and the plugin marketplace."}]},{"type":"code","value":"<TanStackDevtools\n  eventBusConfig={{\n    connectToServerBus: true,\n    debug: false,\n    port: 4206, // default\n  }}\n/>","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Without the Vite plugin running, the "},{"type":"inlineCode","value":"EventClient"},{"type":"text","value":" still works for same-page communication between your application code and the devtools panel. The server bus is only needed for features that bridge the browser and the dev server."}]},{"type":"heading","depth":2,"id":"debugging","children":[{"type":"text","value":"Debugging"}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"debug: true"},{"type":"text","value":" in the "},{"type":"inlineCode","value":"EventClient"},{"type":"text","value":" constructor or in "},{"type":"inlineCode","value":"eventBusConfig"},{"type":"text","value":" to enable verbose console logging. Debug logs are prefixed with "},{"type":"inlineCode","value":"[tanstack-devtools:{pluginId}]"},{"type":"text","value":" for plugin events and "},{"type":"inlineCode","value":"[tanstack-devtools:client-bus]"},{"type":"text","value":" for the client bus."}]},{"type":"code","value":"const myEventClient = new MyEventClient()\n// In the constructor: super({ pluginId: 'my-plugin', debug: true })","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Example output:"}]},{"type":"code","value":"🌴 [tanstack-devtools:client-bus] Initializing client event bus\n🌴 [tanstack-devtools:my-plugin] Registered event to bus my-plugin:state-update\n🌴 [tanstack-devtools:my-plugin] Emitting event my-plugin:state-update"},{"type":"paragraph","children":[{"type":"text","value":"This is helpful when diagnosing issues with event delivery, connection timing, or verifying that your event map is wired up correctly."}]}],"headings":[{"id":"eventclient-basics","text":"EventClient Basics","level":2},{"id":"event-maps-and-type-safety","text":"Event Maps and Type Safety","level":2},{"id":"emitting-events","text":"Emitting Events","level":2},{"id":"listening-to-events","text":"Listening to Events","level":2},{"id":"on-eventsuffix-callback","text":"on(eventSuffix, callback)","level":3},{"id":"onall-callback","text":"onAll(callback)","level":3},{"id":"onallpluginevents-callback","text":"onAllPluginEvents(callback)","level":3},{"id":"connection-lifecycle","text":"Connection Lifecycle","level":2},{"id":"the-enabled-option","text":"The enabled Option","level":3},{"id":"server-event-bus","text":"Server Event Bus","level":2},{"id":"debugging","text":"Debugging","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe event system is how plugins communicate with the devtools UI and with the application. It is built on `EventClient`, a type-safe event emitter/listener from `@tanstack/devtools-event-client`. It is completely framework-agnostic.\n\n## EventClient Basics\n\nCreate a typed `EventClient` by extending the base class with your event map:\n\n```ts\nimport { EventClient } from '@tanstack/devtools-event-client'\n\ntype MyEvents = {\n  'state-update': { count: number }\n  'action': { type: string }\n}\n\nclass MyEventClient extends EventClient<MyEvents> {\n  constructor() {\n    super({ pluginId: 'my-plugin' })\n  }\n}\n\nexport const myEventClient = new MyEventClient()\n```\n\nThe constructor accepts the following options:\n\n| Option             | Type      | Default | Description                                          |\n| ------------------ | --------- | ------- | ---------------------------------------------------- |\n| `pluginId`         | `string`  | —       | Required. Identifies this plugin in the event system. |\n| `debug`            | `boolean` | `false` | Enable debug logging to the console.                 |\n| `enabled`          | `boolean` | `true`  | Whether the client connects to the bus at all.       |\n| `reconnectEveryMs` | `number`  | `300`   | Interval (ms) between connection retry attempts.     |\n\n## Event Maps and Type Safety\n\nThe generic `EventMap` type maps event names to payload types. Keys are event suffixes only — the `pluginId` is prepended automatically by `EventClient` when emitting and listening:\n\n```ts\ntype MyEvents = {\n  'state-update': { count: number }\n  'action': { type: string }\n}\n```\n\nTypeScript enforces correct event names and payload shapes at compile time. You get autocomplete on event names and type errors if the payload does not match the declared shape.\n\n## Emitting Events\n\nCall `eventClient.emit(eventSuffix, payload)` to dispatch an event. You pass only the **suffix** (the part after the colon). The `pluginId` is prepended automatically:\n\n```ts\n// If pluginId is 'my-plugin' and event map has 'state-update'\nmyEventClient.emit('state-update', { count: 42 })\n// Dispatches event named 'my-plugin:state-update'\n```\n\nIf the client is not yet connected to the bus, the event is queued and flushed once the connection succeeds (see [Connection Lifecycle](#connection-lifecycle) below).\n\n## Listening to Events\n\nThere are three methods for subscribing to events. Each returns a cleanup function you call to unsubscribe.\n\n### `on(eventSuffix, callback)`\n\nListen to a specific event from this plugin. Like `emit`, you pass only the suffix:\n\n```ts\nconst cleanup = myEventClient.on('state-update', (event) => {\n  console.log(event.payload.count) // typed as { count: number }\n})\n\n// Later: stop listening\ncleanup()\n```\n\nThe callback receives the full event object:\n\n```ts\n{\n  type: 'my-plugin:state-update', // fully qualified event name\n  payload: { count: number },     // typed payload\n  pluginId: 'my-plugin'           // originating plugin\n}\n```\n\n### `onAll(callback)`\n\nListen to **all** events from **all** plugins. Useful for logging, debugging, or building cross-plugin features:\n\n```ts\nconst cleanup = myEventClient.onAll((event) => {\n  console.log(event.type, event.payload)\n})\n```\n\n### `onAllPluginEvents(callback)`\n\nListen to all events from **this** plugin only (filtered by `pluginId`):\n\n```ts\nconst cleanup = myEventClient.onAllPluginEvents((event) => {\n  // Only fires for events where event.pluginId === 'my-plugin'\n  console.log(event.type, event.payload)\n})\n```\n\n## Connection Lifecycle\n\nThe `EventClient` manages its connection to the event bus automatically:\n\n```mermaid\nstateDiagram-v2\n    [*] --> Queueing: First emit() call\n    Queueing --> Connecting: Dispatches tanstack-connect\n    Connecting --> Retrying: No response\n    Retrying --> Connecting: Every 300ms (up to 5×)\n    Connecting --> Connected: tanstack-connect-success\n    Connected --> Connected: Emit events directly\n    Queueing --> Connected: Flush queued events\n    Retrying --> Failed: 5 retries exhausted\n    Failed --> [*]: Subsequent emits dropped\n```\n\n1. **Queueing** — When you call `emit()` before the client is connected, events are queued in memory.\n2. **Connection** — On the first `emit()`, the client dispatches a `tanstack-connect` event and starts a retry loop.\n3. **Retries** — The client retries every `reconnectEveryMs` (default: 300ms) up to a maximum of 5 attempts.\n4. **Flush** — Once a `tanstack-connect-success` event is received, all queued events are flushed to the bus in order.\n5. **Failure** — If all 5 retries are exhausted without a successful connection, the client stops retrying. Subsequent `emit()` calls are silently dropped (they will not be queued).\n\n### The `enabled` Option\n\nWhen `enabled` is set to `false`, the EventClient is effectively inert — `emit()` is a no-op and `on()` returns a no-op cleanup function. This is useful for conditionally disabling devtools instrumentation (e.g., in production).\n\n## Server Event Bus\n\nWhen `connectToServerBus: true` is set in the component's `eventBusConfig` prop, the `ClientEventBus` connects to the `ServerEventBus` started by the Vite plugin (default port 4206). This enables server-side features like console piping and the plugin marketplace.\n\n```tsx\n<TanStackDevtools\n  eventBusConfig={{\n    connectToServerBus: true,\n    debug: false,\n    port: 4206, // default\n  }}\n/>\n```\n\nWithout the Vite plugin running, the `EventClient` still works for same-page communication between your application code and the devtools panel. The server bus is only needed for features that bridge the browser and the dev server.\n\n## Debugging\n\nSet `debug: true` in the `EventClient` constructor or in `eventBusConfig` to enable verbose console logging. Debug logs are prefixed with `[tanstack-devtools:{pluginId}]` for plugin events and `[tanstack-devtools:client-bus]` for the client bus.\n\n```ts\nconst myEventClient = new MyEventClient()\n// In the constructor: super({ pluginId: 'my-plugin', debug: true })\n```\n\nExample output:\n\n```\n🌴 [tanstack-devtools:client-bus] Initializing client event bus\n🌴 [tanstack-devtools:my-plugin] Registered event to bus my-plugin:state-update\n🌴 [tanstack-devtools:my-plugin] Emitting event my-plugin:state-update\n```\n\nThis is helpful when diagnosing issues with event delivery, connection timing, or verifying that your event map is wired up correctly.\n","originalRawMarkdown":"---\ntitle: Event System\nid: event-system\n---\n\nThe event system is how plugins communicate with the devtools UI and with the application. It is built on `EventClient`, a type-safe event emitter/listener from `@tanstack/devtools-event-client`. It is completely framework-agnostic.\n\n## EventClient Basics\n\nCreate a typed `EventClient` by extending the base class with your event map:\n\n```ts\nimport { EventClient } from '@tanstack/devtools-event-client'\n\ntype MyEvents = {\n  'state-update': { count: number }\n  'action': { type: string }\n}\n\nclass MyEventClient extends EventClient<MyEvents> {\n  constructor() {\n    super({ pluginId: 'my-plugin' })\n  }\n}\n\nexport const myEventClient = new MyEventClient()\n```\n\nThe constructor accepts the following options:\n\n| Option             | Type      | Default | Description                                          |\n| ------------------ | --------- | ------- | ---------------------------------------------------- |\n| `pluginId`         | `string`  | —       | Required. Identifies this plugin in the event system. |\n| `debug`            | `boolean` | `false` | Enable debug logging to the console.                 |\n| `enabled`          | `boolean` | `true`  | Whether the client connects to the bus at all.       |\n| `reconnectEveryMs` | `number`  | `300`   | Interval (ms) between connection retry attempts.     |\n\n## Event Maps and Type Safety\n\nThe generic `EventMap` type maps event names to payload types. Keys are event suffixes only — the `pluginId` is prepended automatically by `EventClient` when emitting and listening:\n\n```ts\ntype MyEvents = {\n  'state-update': { count: number }\n  'action': { type: string }\n}\n```\n\nTypeScript enforces correct event names and payload shapes at compile time. You get autocomplete on event names and type errors if the payload does not match the declared shape.\n\n## Emitting Events\n\nCall `eventClient.emit(eventSuffix, payload)` to dispatch an event. You pass only the **suffix** (the part after the colon). The `pluginId` is prepended automatically:\n\n```ts\n// If pluginId is 'my-plugin' and event map has 'state-update'\nmyEventClient.emit('state-update', { count: 42 })\n// Dispatches event named 'my-plugin:state-update'\n```\n\nIf the client is not yet connected to the bus, the event is queued and flushed once the connection succeeds (see [Connection Lifecycle](#connection-lifecycle) below).\n\n## Listening to Events\n\nThere are three methods for subscribing to events. Each returns a cleanup function you call to unsubscribe.\n\n### `on(eventSuffix, callback)`\n\nListen to a specific event from this plugin. Like `emit`, you pass only the suffix:\n\n```ts\nconst cleanup = myEventClient.on('state-update', (event) => {\n  console.log(event.payload.count) // typed as { count: number }\n})\n\n// Later: stop listening\ncleanup()\n```\n\nThe callback receives the full event object:\n\n```ts\n{\n  type: 'my-plugin:state-update', // fully qualified event name\n  payload: { count: number },     // typed payload\n  pluginId: 'my-plugin'           // originating plugin\n}\n```\n\n### `onAll(callback)`\n\nListen to **all** events from **all** plugins. Useful for logging, debugging, or building cross-plugin features:\n\n```ts\nconst cleanup = myEventClient.onAll((event) => {\n  console.log(event.type, event.payload)\n})\n```\n\n### `onAllPluginEvents(callback)`\n\nListen to all events from **this** plugin only (filtered by `pluginId`):\n\n```ts\nconst cleanup = myEventClient.onAllPluginEvents((event) => {\n  // Only fires for events where event.pluginId === 'my-plugin'\n  console.log(event.type, event.payload)\n})\n```\n\n## Connection Lifecycle\n\nThe `EventClient` manages its connection to the event bus automatically:\n\n```mermaid\nstateDiagram-v2\n    [*] --> Queueing: First emit() call\n    Queueing --> Connecting: Dispatches tanstack-connect\n    Connecting --> Retrying: No response\n    Retrying --> Connecting: Every 300ms (up to 5×)\n    Connecting --> Connected: tanstack-connect-success\n    Connected --> Connected: Emit events directly\n    Queueing --> Connected: Flush queued events\n    Retrying --> Failed: 5 retries exhausted\n    Failed --> [*]: Subsequent emits dropped\n```\n\n1. **Queueing** — When you call `emit()` before the client is connected, events are queued in memory.\n2. **Connection** — On the first `emit()`, the client dispatches a `tanstack-connect` event and starts a retry loop.\n3. **Retries** — The client retries every `reconnectEveryMs` (default: 300ms) up to a maximum of 5 attempts.\n4. **Flush** — Once a `tanstack-connect-success` event is received, all queued events are flushed to the bus in order.\n5. **Failure** — If all 5 retries are exhausted without a successful connection, the client stops retrying. Subsequent `emit()` calls are silently dropped (they will not be queued).\n\n### The `enabled` Option\n\nWhen `enabled` is set to `false`, the EventClient is effectively inert — `emit()` is a no-op and `on()` returns a no-op cleanup function. This is useful for conditionally disabling devtools instrumentation (e.g., in production).\n\n## Server Event Bus\n\nWhen `connectToServerBus: true` is set in the component's `eventBusConfig` prop, the `ClientEventBus` connects to the `ServerEventBus` started by the Vite plugin (default port 4206). This enables server-side features like console piping and the plugin marketplace.\n\n```tsx\n<TanStackDevtools\n  eventBusConfig={{\n    connectToServerBus: true,\n    debug: false,\n    port: 4206, // default\n  }}\n/>\n```\n\nWithout the Vite plugin running, the `EventClient` still works for same-page communication between your application code and the devtools panel. The server bus is only needed for features that bridge the browser and the dev server.\n\n## Debugging\n\nSet `debug: true` in the `EventClient` constructor or in `eventBusConfig` to enable verbose console logging. Debug logs are prefixed with `[tanstack-devtools:{pluginId}]` for plugin events and `[tanstack-devtools:client-bus]` for the client bus.\n\n```ts\nconst myEventClient = new MyEventClient()\n// In the constructor: super({ pluginId: 'my-plugin', debug: true })\n```\n\nExample output:\n\n```\n🌴 [tanstack-devtools:client-bus] Initializing client event bus\n🌴 [tanstack-devtools:my-plugin] Registered event to bus my-plugin:state-update\n🌴 [tanstack-devtools:my-plugin] Emitting event my-plugin:state-update\n```\n\nThis is helpful when diagnosing issues with event delivery, connection timing, or verifying that your event map is wired up correctly.\n"}
