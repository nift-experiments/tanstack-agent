{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The event system is how plugins communicate with the devtools UI and with the application. It is built on "},{"type":"inlineCode","value":"EventClient"},{"type":"text","value":", a type-safe event emitter/listener from "},{"type":"inlineCode","value":"@tanstack/devtools-event-client"},{"type":"text","value":". It is completely framework-agnostic."}]},{"type":"heading","depth":2,"id":"eventclient-basics","children":[{"type":"text","value":"EventClient Basics"}]},{"type":"paragraph","children":[{"type":"text","value":"Create a typed "},{"type":"inlineCode","value":"EventClient"},{"type":"text","value":" by extending the base class with your event map:"}]},{"type":"code","value":"import { EventClient } from '@tanstack/devtools-event-client'\n\ntype MyEvents = {\n  'state-update': { count: number }\n  'action': { type: string }\n}\n\nclass MyEventClient extends EventClient<MyEvents> {\n  constructor() {\n    super({ pluginId: 'my-plugin' })\n  }\n}\n\nexport const myEventClient = new MyEventClient()","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The constructor accepts the following options:"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"pluginId"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"—"}]},{"type":"tableCell","children":[{"type":"text","value":"Required. Identifies this plugin in the event system."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"debug"}]},{"type":"tableCell","children":[{"typ