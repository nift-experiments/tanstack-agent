s shell. Sets the initial state on first load; afterwards settings are persisted in local storage."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"eventBusConfig"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ClientEventBusConfig"}]},{"type":"tableCell","children":[{"type":"text","value":"Configuration for the TanStack Devtools client event bus."}]}]]},{"type":"heading","depth":2,"id":"plugin-type","children":[{"type":"text","value":"Plugin Type"}]},{"type":"paragraph","children":[{"type":"text","value":"Each plugin in the "},{"type":"inlineCode","value":"plugins"},{"type":"text","value":" array must conform to the "},{"type":"inlineCode","value":"TanStackDevtoolsAngularPlugin"},{"type":"text","value":" type:"}]},{"type":"code","value":"type TanStackDevtoolsAngularPlugin = {\n  id?: string\n  render: TanStackDevtoolsAngularPluginRender\n  name: string | Type<any>\n  inputs?: Record<string, any>\n  defaultOpen?: boolean\n}","lang":"ts"},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Field"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"},{"type":"text","value":" (optional)"}]},{"type":"tableCell","children":[{"type":"text","value":"Unique identifier for the plugin."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"render"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Type<any>"}]},{"type":"tableCell","children":[{"type":"text","value":"The Angular component class to render as the plugin panel content."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"name"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string | Type<any>"}]},{"type":"tableCell","children":[{"type":"text","value":"Display name for the tab title. Can be a plain string or an Angular component class for custom rendering."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"inputs"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Record<string, any>"},{"type":"text","value":" (optional)"}]},{"type":"tableCell","children":[{"type":"text","value":"Additional inputs passed to the plugin component via "},{"type":"inlineCode","value":"setInput()"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"defaultOpen"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"},{"type":"text","value":" (optional)"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether this plugin tab should be open by default."}]}]]},{"type":"heading","depth":2,"id":"key-differences-from-other-frameworks","children":[{"type":"text","value":"Key Differences from Other Frameworks"}]},{"type":"paragraph","children":[{"type":"text","value":"The Angular adapter uses "},{"type":"inlineCode","value":"component"},{"type":"text","value":" (an Angular component class reference) instead of "},{"type":"inlineCode","value":"render"},{"type":"text","value":" (a JSX element) in plugin definitions. Inputs are provided through the "},{"type":"inlineCode","value":"inputs"},{"type":"text","value":" field and bound to the component with "},{"type":"inlineCode","value":"setInput()"},{"type":"text","value":", rather than being embedded directly in a JSX expression or passed via "},{"type":"inlineCode","value":"v-bind"},{"type":"text","value":"."}]},{"type":"code","value":"import { Component } from '@angular/core'\nimport { TanStackDevtools } from '@tanstack/angular-devtools'\nimport { AngularQueryDevtoolsPanel } from '@tanstack/angular-query-devtools'\n\n@Component({\n  selector: 'app-root',\n  standalone: true,\n  imports: [TanStackDevtools],\n  template: `\n    <tanstack-devtools [plugins]=\"plugins\" />\n  `,\n})\nexport class App {\n  plugins = [\n    {\n      name: 'Angular Query',\n      render: AngularQueryDevtoolsPanel,\n      inputs: { style: 'height: 100%' },\n    },\n  ]\n}","lang":"typescript"},{"type":"heading","depth":2,"id":"exports","children":[{"type":"text","value":"Exports"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"@tanstack/angular-devtools"},{"type":"text","value":" package exports:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"TanStackDevtools"}]},{"type":"text","value":" -- The main Angular standalone component that renders the devtools panel."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"TanStackDevtoolsAngularPlugin"}]},{"type":"text","value":" (type) -- The type for plugin definitions."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"TanStackDevtoolsAngularInit"}]},{"type":"text","value":" (type) -- The inputs interface for the "},{"type":"inlineCode","value":"TanStackDevtoolsComponent"},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The package depends on "},{"type":"inlineCode","value":"@tanstack/devtools"},{"type":"text","value":" (the core package), which provides "},{"type":"inlineCode","value":"TanStackDevtoolsCore"},{"type":"text","value":", "},{"type":"inlineCode","value":"TanStackDevtoolsConfig"},{"type":"text","value":", "},{"type":"inlineCode","value":"ClientEventBusConfig"},{"type":"text","value":", and other core utilities."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"component-inputs","text":"Component Inputs","level":2},{"id":"plugin-type","text":"Plugin Type","level":2},{"id":"key-differences-from-other-frameworks","text":"Key Differences from Other Frameworks","level":2},{"id":"exports","text":"Exports","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe Angular adapter wraps `TanStackDevtoolsCore` in an Angular standalone component, using Angular's `createComponent` and `ApplicationRef.attachView` to dynamically render plugins into the correct DOM containers managed by the devtools shell.\n\n## Installation\n\n```sh\nnpm install @tanstack/angular-devtools\n```\n\n## Component Inputs\n\nThe `TanStackDevtools` (selector: `tanstack-devtools`) accepts the following signal-based inputs, defined by the `TanStackDevtoolsAngularInit` interface:\n\n| Input | Type | Description |\n| --- | --- | --- |\n| `plugins` | `TanStackDevtoolsAngularPlugin[]` | Array of plugins to render inside the devtools panel. |\n| `config` | `Partial<TanStackDevtoolsConfig>` | Configuration for the devtools shell. Sets the initial state on first load; afterwards settings are persisted in local storage. |\n| `eventBusConfig` | `ClientEventBusConfig` | Configuration for the TanStack Devtools client event bus. |\n\n## Plugin Type\n\nEach plugin in the `plugins` array must conform to the `TanStackDevtoolsAngularPlugin` type:\n\n```ts\ntype TanStackDevtoolsAngularPlugin = {\n  id?: string\n  render: TanStackDevtoolsAngularPluginRender\n  name: string | Type<any>\n  inputs?: Record<string, any>\n  defaultOpen?: boolean\n}\n```\n\n| Field         | Type | Description |\n|---------------| --- | --- |\n| `id`          | `string` (optional) | Unique identifier for the plugin. |\n| `render`      | `Type<any>` | The Angular component class to render as the plugin panel content. |\n| `name`        | `string \\| Type<any>` | Display name for the tab title. Can be a plain string or an Angular component class for custom rendering. |\n| `inputs`      | `Record<string, any>` (optional) | Additional inputs passed to the plugin component via `setInput()`. |\n| `defaultOpen` | `boolean` (optional) | Whether this plugin tab should be open by default. |\n\n## Key Differences from Other Frameworks\n\nThe Angular adapter uses `component` (an Angular component class reference) instead of `render` (a JSX element) in plugin definitions. Inputs are provided through the `inputs` field and bound to the component with `setInput()`, rather than being embedded directly in a JSX expression or passed via `v-bind`.\n\n```typescript\nimport { Component } from '@angular/core'\nimport { TanStackDevtools } from '@tanstack/angular-devtools'\nimport { AngularQueryDevtoolsPanel } from '@tanstack/angular-query-devtools'\n\n@Component({\n  selector: 'app-root',\n  standalone: true,\n  imports: [TanStackDevtools],\n  template: `\n    <tanstack-devtools [plugins]=\"plugins\" />\n  `,\n})\nexport class App {\n  plugins = [\n    {\n      name: 'Angular Query',\n      render: AngularQueryDevtoolsPanel,\n      inputs: { style: 'height: 100%' },\n    },\n  ]\n}\n```\n\n## Exports\n\nThe `@tanstack/angular-devtools` package exports:\n\n- **`TanStackDevtools`** -- The main Angular standalone component that renders the devtools panel.\n- **`TanStackDevtoolsAngularPlugin`** (type) -- The type for plugin definitions.\n- **`TanStackDevtoolsAngularInit`** (type) -- The inputs interface for the `TanStackDevtoolsComponent`.\n\nThe package depends on `@tanstack/devtools` (the core package), which provides `TanStackDevtoolsCore`, `TanStackDevtoolsConfig`, `ClientEventBusConfig`, and other core utilities.\n","originalRawMarkdown":"---\ntitle: TanStack Devtools Angular Adapter\nid: adapter\n---\n\nThe Angular adapter wraps `TanStackDevtoolsCore` in an Angular standalone component, using Angular's `createComponent` and `ApplicationRef.attachView` to dynamically render plugins into the correct DOM containers managed by the devtools shell.\n\n## Installation\n\n```sh\nnpm install @tanstack/angular-devtools\n```\n\n## Component Inputs\n\nThe `TanStackDevtools` (selector: `tanstack-devtools`) accepts the following signal-based inputs, defined by the `TanStackDevtoolsAngularInit` interface:\n\n| Input | Type | Description |\n| --- | --- | --- |\n| `plugins` | `TanStackDevtoolsAngularPlugin[]` | Array of plugins to render inside the devtools panel. |\n| `config` | `Partial<TanStackDevtoolsConfig>` | Configuration for the devtools shell. Sets the initial state on first load; afterwards settings are persisted in local storage. |\n| `eventBusConfig` | `ClientEventBusConfig` | Configuration for the TanStack Devtools client event bus. |\n\n## Plugin Type\n\nEach plugin in the `plugins` array must conform to the `TanStackDevtoolsAngularPlugin` type:\n\n```ts\ntype TanStackDevtoolsAngularPlugin = {\n  id?: string\n  render: TanStackDevtoolsAngularPluginRender\n  name: string | Type<any>\n  inputs?: Record<string, any>\n  defaultOpen?: boolean\n}\n```\n\n| Field         | Type | Description |\n|---------------| --- | --- |\n| `id`          | `string` (optional) | Unique identifier for the plugin. |\n| `render`      | `Type<any>` | The Angular component class to render as the plugin panel content. |\n| `name`        | `string \\| Type<any>` | Display name for the tab title. Can be a plain string or an Angular component class for custom rendering. |\n| `inputs`      | `Record<string, any>` (optional) | Additional inputs passed to the plugin component via `setInput()`. |\n| `defaultOpen` | `boolean` (optional) | Whether this plugin tab should be open by default. |\n\n## Key Differences from Other Frameworks\n\nThe Angular adapter uses `component` (an Angular component class reference) instead of `render` (a JSX element) in plugin definitions. Inputs are provided through the `inputs` field and bound to the component with `setInput()`, rather than being embedded directly in a JSX expression or passed via `v-bind`.\n\n```typescript\nimport { Component } from '@angular/core'\nimport { TanStackDevtools } from '@tanstack/angular-devtools'\nimport { AngularQueryDevtoolsPanel } from '@tanstack/angular-query-devtools'\n\n@Component({\n  selector: 'app-root',\n  standalone: true,\n  imports: [TanStackDevtools],\n  template: `\n    <tanstack-devtools [plugins]=\"plugins\" />\n  `,\n})\nexport class App {\n  plugins = [\n    {\n      name: 'Angular Query',\n      render: AngularQueryDevtoolsPanel,\n      inputs: { style: 'height: 100%' },\n    },\n  ]\n}\n```\n\n## Exports\n\nThe `@tanstack/angular-devtools` package exports:\n\n- **`TanStackDevtools`** -- The main Angular standalone component that renders the devtools panel.\n- **`TanStackDevtoolsAngularPlugin`** (type) -- The type for plugin definitions.\n- **`TanStackDevtoolsAngularInit`** (type) -- The inputs interface for the `TanStackDevtoolsComponent`.\n\nThe package depends on `@tanstack/devtools` (the core package), which provides `TanStackDevtoolsCore`, `TanStackDevtoolsConfig`, `ClientEventBusConfig`, and other core utilities.\n"}
