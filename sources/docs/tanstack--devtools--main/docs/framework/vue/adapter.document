{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The Vue adapter wraps "},{"type":"inlineCode","value":"TanStackDevtoolsCore"},{"type":"text","value":" in a Vue 3 component, using Vue's "},{"type":"inlineCode","value":"<Teleport>"},{"type":"text","value":" to render plugins and their tab titles into the correct DOM containers managed by the devtools shell."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"code","value":"npm install @tanstack/vue-devtools","lang":"sh"},{"type":"heading","depth":2,"id":"component-props","children":[{"type":"text","value":"Component Props"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"TanStackDevtools"},{"type":"text","value":" component accepts the following props, defined by the "},{"type":"inlineCode","value":"TanStackDevtoolsVueInit"},{"type":"text","value":" interface:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Prop"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"plugins"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TanStackDevtoolsVuePlugin[]"}]},{"type":"tableCell","children":[{"type":"text","value":"Array of plugins to render inside the devtools panel."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"config"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Partial<TanStackDevtoolsConfig>"}]},{"type":"tableCell","children":[{"type":"text","value":"Configuration for the devtools shell. Sets the initial state on first load; afterwards settings are persisted in local storage."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"eventBusConfig"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ClientEventBusConfig"}]},{"type":"tableCell","children":[{"type":"text","value":"Configuration for the TanStack Devtools client event bus."}]}]]},{"type":"heading","depth":2,"id":"plugin-type","children":[{"type":"text","value":"Plugin Type"}]},{"type":"paragraph","children":[{"type":"text","value":"Each plugin in the "},{"type":"inlineCode","value":"plugins"},{"type":"text","value":" array must conform to the "},{"type":"inlineCode","value":"TanStackDevtoolsVuePlugin"},{"type":"text","value":" type:"}]},{"type":"code","value":"type TanStackDevtoolsVuePlugin = {\n  id?: string\n  component: Component\n  name: string | Component\n  props?: Record<string, any>\n}","lang":"ts"},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Field"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"id"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"},{"type":"text","value":" (optional)"}]},{"type":"tableCell","children":[{"type":"text","value":"Unique identifier for the plugin."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"component"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Component"}]},{"type":"tableCell","children":[{"type":"text","value":"The Vue component to render as the plugin panel content."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"name"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string | Component"}]},{"type":"tableCell","children":[{"type":"text","value":"Display name for the tab title. Can be a plain string or a Vue component for custom rendering."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"props"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Record<string, any>"},{"type":"text","value":" (optional)"}]},{"type":"tableCell","children":[{"type":"text","value":"Additional props passed to the plugin component via "},{"type":"inlineCode","value":"v-bind"},{"type":"text","value":"."}]}]]},{"type":"heading","depth":2,"id":"key-difference-from-react","children":[{"type":"text","value":"Key Difference from React"}]},{"type":"paragraph","children":[{"type":"text","value":"The Vue adapter uses "},{"type":"inlineCode","value":"component"},{"type":"text","value":" (a Vue component reference) instead of "},{"type":"inlineCode","value":"render"},{"type":"text","value":" (a JSX element) in plugin definitions. Props are provided through the "},{"type":"inlineCode","value":"props"},{"type":"text","value":" field and bound to the component with "},{"type":"inlineCode","value":"v-bind"},{"type":"text","value":", rather than being embedded directly in a JSX expression."}]},{"type":"code","value":"<!-- Vue: pass component reference + props -->\n<script setup lang=\"ts\">\nimport { TanStackDevtools } from '@tanstack/vue-devtools'\nimport { VueQueryDevtoolsPanel } from '@tanstack/vue-query-devtools'\n\nconst plugins = [\n  {\n    name: 'Vue Query',\n    component: VueQueryDevtoolsPanel,\n    props: { style: 'height: 100%' },\n  },\n]\n</script>\n\n<template>\n  <TanStackDevtools :plugins=\"plugins\" />\n</template>","lang":"vue"},{"type":"heading","depth":2,"id":"exports","children":[{"type":"text","value":"Exports"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"@tanstack/vue-devtools"},{"type":"text","value":" package exports:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"TanStackDevtools"}]},{"type":"text","value":" -- The main Vue component that renders the devtools panel."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"TanStackDevtoolsVuePlugin"}]},{"type":"text","value":" (type) -- The type for plugin definitions."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"TanStackDevtoolsVueInit"}]},{"type":"text","value":" (type) -- The props interface for the "},{"type":"inlineCode","value":"TanStackDevtools"},{"type":"text","value":" component."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The package depends on "},{"type":"inlineCode","value":"@tanstack/devtools"},{"type":"text","value":" (the core package), which provides "},{"type":"inlineCode","value":"TanStackDevtoolsCore"},{"type":"text","value":", "},{"type":"inlineCode","value":"TanStackDevtoolsConfig"},{"type":"text","value":", "},{"type":"inlineCode","value":"ClientEventBusConfig"},{"type":"text","value":", and other core utilities."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"component-props","text":"Component Props","level":2},{"id":"plugin-type","text":"Plugin Type","level":2},{"id":"key-difference-from-react","text":"Key Difference from React","level":2},{"id":"exports","text":"Exports","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe Vue adapter wraps `TanStackDevtoolsCore` in a Vue 3 component, using Vue's `<Teleport>` to render plugins and their tab titles into the correct DOM containers managed by the devtools shell.\n\n## Installation\n\n```sh\nnpm install @tanstack/vue-devtools\n```\n\n## Component Props\n\nThe `TanStackDevtools` component accepts the following props, defined by the `TanStackDevtoolsVueInit` interface:\n\n| Prop | Type | Description |\n| --- | --- | --- |\n| `plugins` | `TanStackDevtoolsVuePlugin[]` | Array of plugins to render inside the devtools panel. |\n| `config` | `Partial<TanStackDevtoolsConfig>` | Configuration for the devtools shell. Sets the initial state on first load; afterwards settings are persisted in local storage. |\n| `eventBusConfig` | `ClientEventBusConfig` | Configuration for the TanStack Devtools client event bus. |\n\n## Plugin Type\n\nEach plugin in the `plugins` array must conform to the `TanStackDevtoolsVuePlugin` type:\n\n```ts\ntype TanStackDevtoolsVuePlugin = {\n  id?: string\n  component: Component\n  name: string | Component\n  props?: Record<string, any>\n}\n```\n\n| Field | Type | Description |\n| --- | --- | --- |\n| `id` | `string` (optional) | Unique identifier for the plugin. |\n| `component` | `Component` | The Vue component to render as the plugin panel content. |\n| `name` | `string \\| Component` | Display name for the tab title. Can be a plain string or a Vue component for custom rendering. |\n| `props` | `Record<string, any>` (optional) | Additional props passed to the plugin component via `v-bind`. |\n\n## Key Difference from React\n\nThe Vue adapter uses `component` (a Vue component reference) instead of `render` (a JSX element) in plugin definitions. Props are provided through the `props` field and bound to the component with `v-bind`, rather than being embedded directly in a JSX expression.\n\n```vue\n<!-- Vue: pass component reference + props -->\n<script setup lang=\"ts\">\nimport { TanStackDevtools } from '@tanstack/vue-devtools'\nimport { VueQueryDevtoolsPanel } from '@tanstack/vue-query-devtools'\n\nconst plugins = [\n  {\n    name: 'Vue Query',\n    component: VueQueryDevtoolsPanel,\n    props: { style: 'height: 100%' },\n  },\n]\n</script>\n\n<template>\n  <TanStackDevtools :plugins=\"plugins\" />\n</template>\n```\n\n## Exports\n\nThe `@tanstack/vue-devtools` package exports:\n\n- **`TanStackDevtools`** -- The main Vue component that renders the devtools panel.\n- **`TanStackDevtoolsVuePlugin`** (type) -- The type for plugin definitions.\n- **`TanStackDevtoolsVueInit`** (type) -- The props interface for the `TanStackDevtools` component.\n\nThe package depends on `@tanstack/devtools` (the core package), which provides `TanStackDevtoolsCore`, `TanStackDevtoolsConfig`, `ClientEventBusConfig`, and other core utilities.\n","originalRawMarkdown":"---\ntitle: TanStack Devtools Vue Adapter\nid: adapter\n---\n\nThe Vue adapter wraps `TanStackDevtoolsCore` in a Vue 3 component, using Vue's `<Teleport>` to render plugins and their tab titles into the correct DOM containers managed by the devtools shell.\n\n## Installation\n\n```sh\nnpm install @tanstack/vue-devtools\n```\n\n## Component Props\n\nThe `TanStackDevtools` component accepts the following props, defined by the `TanStackDevtoolsVueInit` interface:\n\n| Prop | Type | Description |\n| --- | --- | --- |\n| `plugins` | `TanStackDevtoolsVuePlugin[]` | Array of plugins to render inside the devtools panel. |\n| `config` | `Partial<TanStackDevtoolsConfig>` | Configuration for the devtools shell. Sets the initial state on first load; afterwards settings are persisted in local storage. |\n| `eventBusConfig` | `ClientEventBusConfig` | Configuration for the TanStack Devtools client event bus. |\n\n## Plugin Type\n\nEach plugin in the `plugins` array must conform to the `TanStackDevtoolsVuePlugin` type:\n\n```ts\ntype TanStackDevtoolsVuePlugin = {\n  id?: string\n  component: Component\n  name: string | Component\n  props?: Record<string, any>\n}\n```\n\n| Field | Type | Description |\n| --- | --- | --- |\n| `id` | `string` (optional) | Unique identifier for the plugin. |\n| `component` | `Component` | The Vue component to render as the plugin panel content. |\n| `name` | `string \\| Component` | Display name for the tab title. Can be a plain string or a Vue component for custom rendering. |\n| `props` | `Record<string, any>` (optional) | Additional props passed to the plugin component via `v-bind`. |\n\n## Key Difference from React\n\nThe Vue adapter uses `component` (a Vue component reference) instead of `render` (a JSX element) in plugin definitions. Props are provided through the `props` field and bound to the component with `v-bind`, rather than being embedded directly in a JSX expression.\n\n```vue\n<!-- Vue: pass component reference + props -->\n<script setup lang=\"ts\">\nimport { TanStackDevtools } from '@tanstack/vue-devtools'\nimport { VueQueryDevtoolsPanel } from '@tanstack/vue-query-devtools'\n\nconst plugins = [\n  {\n    name: 'Vue Query',\n    component: VueQueryDevtoolsPanel,\n    props: { style: 'height: 100%' },\n  },\n]\n</script>\n\n<template>\n  <TanStackDevtools :plugins=\"plugins\" />\n</template>\n```\n\n## Exports\n\nThe `@tanstack/vue-devtools` package exports:\n\n- **`TanStackDevtools`** -- The main Vue component that renders the devtools panel.\n- **`TanStackDevtoolsVuePlugin`** (type) -- The type for plugin definitions.\n- **`TanStackDevtoolsVueInit`** (type) -- The props interface for the `TanStackDevtools` component.\n\nThe package depends on `@tanstack/devtools` (the core package), which provides `TanStackDevtoolsCore`, `TanStackDevtoolsConfig`, `ClientEventBusConfig`, and other core utilities.\n"}
