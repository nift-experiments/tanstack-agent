{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The TanStack Devtools Accessibility (A11y) Plugin provides real-time accessibility auditing for your web applications, powered by "},{"type":"link","href":"https://github.com/dequelabs/axe-core","children":[{"type":"text","value":"axe-core"}]},{"type":"text","value":". It helps you identify and fix accessibility issues during development."}]},{"type":"heading","depth":2,"id":"features","children":[{"type":"text","value":"Features"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Full Page Scanning"}]},{"type":"text","value":" - Audit your entire page for accessibility violations"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Component-Level Scanning"}]},{"type":"text","value":" - Scope audits to specific components using React hooks"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Visual Overlays"}]},{"type":"text","value":" - Highlight problematic elements with severity-based colors"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Click-to-Navigate"}]},{"type":"text","value":" - Click on an issue to automatically scroll to and highlight the element"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Dark Mode Support"}]},{"type":"text","value":" - Automatically adapts to the devtools theme"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Devtools-Aware"}]},{"type":"text","value":" - Automatically excludes devtools panels from scanning"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Configurable Rule Sets"}]},{"type":"text","value":" - Support for WCAG 2.0/2.1/2.2 (A/AA/AAA), Section 508, and best practices"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Export Reports"}]},{"type":"text","value":" - Download results as JSON or CSV"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Persistent Settings"}]},{"type":"text","value":" - Configuration saved to localStorage"}]}]}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"code","value":"npm install @tanstack/devtools-a11y\n# or\npnpm add @tanstack/devtools-a11y\n# or\nyarn add @tanstack/devtools-a11y","lang":"bash"},{"type":"heading","depth":2,"id":"quick-start-react","children":[{"type":"text","value":"Quick Start (React)"}]},{"type":"code","value":"import { createRoot } from 'react-dom/client'\nimport { TanStackDevtools } from '@tanstack/react-devtools'\nimport { a11yDevtoolsPlugin } from '@tanstack/devtools-a11y/react'\n\ncreateRoot(document.getElementById('root')!).render(\n  <>\n    <App />\n    <TanStackDevtools plugins={[a11yDevtoolsPlugin()]} />\n  </>,\n)","lang":"tsx"},{"type":"heading","depth":2,"id":"quick-start-solid","children":[{"type":"text","value":"Quick Start (Solid)"}]},{"type":"code","value":"import { render } from 'solid-js/web'\nimport { TanStackDevtools } from '@tanstack/solid-devtools'\nimport { a11yDevtoolsPlugin } from '@tanstack/devtools-a11y/solid'\n\nrender(\n  () => (\n    <>\n      <App />\n      <TanStackDevtools plugins={[a11yDevtoolsPlugin()]} />\n    </>\n  ),\n  document.getElementById('root')!,\n)","lang":"tsx"},{"type":"heading","depth":2,"id":"quick-start-vue","children":[{"type":"text","value":"Quick Start (Vue)"}]},{"type":"code","value":"import { createA11yDevtoolsVuePlugin } from '@tanstack/devtools-a