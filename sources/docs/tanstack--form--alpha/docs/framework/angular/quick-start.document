NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack Form is a headless, type-safe form library. It owns form state and\nvalidation while leaving markup, styling, and component choice to you."}]},{"type":"paragraph","children":[{"type":"text","value":"Install the Angular adapter:"}]},{"type":"code","value":"npm install @tanstack/angular-form","lang":"bash"},{"type":"heading","depth":2,"id":"create-a-form","children":[{"type":"text","value":"Create a form"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"injectForm"},{"type":"text","value":" requires "},{"type":"inlineCode","value":"defaultValues"},{"type":"text","value":". Their shape becomes the form's inferred\nvalue type. Call it in an Angular injection context, such as a component field\ninitializer."}]},{"type":"code","value":"import { ChangeDetectionStrategy, Component } from '@angular/core'\nimport {\n  TanStackField,\n  injectForm,\n  injectSelector,\n} from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-profile-form',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [TanStackField],\n  template: `\n    <form (submit)=\"handleSubmit($event)\">\n      <ng-container\n        [tanstackField]=\"form\"\n        name=\"fullName\"\n        [validators]=\"fullNameValidators\"\n        #fullName=\"field\"\n      >\n        <label>\n          Full name\n          <input\n            [name]=\"fullName.api.name\"\n            [value]=\"fullName.api.value\"\n            (blur)=\"fullName.api.handleBlur()\"\n            (input)=\"fullName.api.handleChange($any($event).target.value)\"\n            [attr.aria-invalid]=\"fullName.api.meta.isInvalid\"\n          />\n          @for (error of fullName.api.errors; track error) {\n            <span role=\"alert\">{{ error.message }}</span>\n          }\n        </label>\n      </ng-container>\n\n      <ng-container\n        [tanstackField]=\"form\"\n        name=\"age\"\n        [validators]=\"ageValidators\"\n        #age=\"field\"\n      >\n        <label>\n          Age\n          <input\n            type=\"number\"\n            [name]=\"age.api.name\"\n            [value]=\"age.api.value\"\n            (blur)=\"age.api.handleBlur()\"\n            (input)=\"age.api.handleChange($any($event).target.valueAsNumber)\"\n            [attr.aria-invalid]=\"age.api.meta.isInvalid\"\n          />\n        </label>\n      </ng-container>\n\n      <button type=\"submit\" [disabled]=\"!canSubmit() || isSubmitting()\">\n        {{ isSubmitting() ? 'Saving…' : 'Save' }}\n      </button>\n    </form>\n  `,\n})\nexport class ProfileFormComponent {\n  fullNameValidators = [\n    {\n      triggers: ['change', 'blur'] as const,\n      run: ({ value }: { value: string }) =>\n        value.trim() ? undefined : 'Enter your full name',\n    },\n  ]\n\n  ageValidators = [\n    {\n      triggers: ['change'] as const,\n      run: ({ value }: { value: number }) =>\n        value >= 13 ? undefined : 'You must be at least 13',\n    },\n  ]\n\n  form = injectForm({\n    defaultValues: {\n      fullName: '',\n      age: 0,\n    },\n    onSubmit: async ({ value }) => {\n      console.log(value)\n    },\n  })\n\n  canSubmit = injectSelector(this.form, (state) => state.canSubmit)\n  isSubmitting = injectSelector(this.form, (state) => state.isSubmitting)\n\n  handleSubmit(event: SubmitEvent) {\n    event.preventDefault()\n    void this.form.handleSubmit()\n  }\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The important pieces are:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultValues"},{"type":"text","value":" define the complete initial value and drive type inference."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"TanStackField"},{"type":"text","value":" turns an element or "},{"type":"inlineCode","value":"ng-container"},{"type":"text","value":" with "},{"type":"inlineCode","value":"[tanstackField]"},{"type":"text","value":"\ninto a field directive. The exported "},{"type":"inlineCode","value":"field"},{"type":"text","value":" reference exposes "},{"type":"inlineCode","value":"api.value"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"api.meta"},{"type":"text","value":", and event handlers."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Validators are ordered objects with a "},{"type":"inlineCode","value":"run"},{"type":"text","value":" function and explicit\n"},{"type":"inlineCode","value":"triggers"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"injectSelector"},{"type":"text","value":" creates an Angular signal for selected form state without\nmaking unrelated fields rerender."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"form.handleSubmit()"},{"type":"text","value":" validates the form before calling "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"create-a-form","text":"Create a form","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Form is a headless, type-safe form library. It owns form state and\nvalidation while leaving markup, styling, and component choice to you.\n\nInstall the Angular adapter:\n\n```bash\nnpm install @tanstack/angular-form\n```\n\n## Create a form\n\n`injectForm` requires `defaultValues`. Their shape becomes the form's inferred\nvalue type. Call it in an Angular injection context, such as a component field\ninitializer.\n\n```ts\nimport { ChangeDetectionStrategy, Component } from '@angular/core'\nimport {\n  TanStackField,\n  injectForm,\n  injectSelector,\n} from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-profile-form',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [TanStackField],\n  template: `\n    <form (submit)=\"handleSubmit($event)\">\n      <ng-container\n        [tanstackField]=\"form\"\n        name=\"fullName\"\n        [validators]=\"fullNameValidators\"\n        #fullName=\"field\"\n      >\n        <label>\n          Full name\n          <input\n            [name]=\"fullName.api.name\"\n            [value]=\"fullName.api.value\"\n            (blur)=\"fullName.api.handleBlur()\"\n            (input)=\"fullName.api.handleChange($any($event).target.value)\"\n            [attr.aria-invalid]=\"fullName.api.meta.isInvalid\"\n          />\n          @for (error of fullName.api.errors; track error) {\n            <span role=\"alert\">{{ error.message }}</span>\n          }\n        </label>\n      </ng-container>\n\n      <ng-container\n        [tanstackField]=\"form\"\n        name=\"age\"\n        [validators]=\"ageValidators\"\n        #age=\"field\"\n      >\n        <label>\n          Age\n          <input\n            type=\"number\"\n            [name]=\"age.api.name\"\n            [value]=\"age.api.value\"\n            (blur)=\"age.api.handleBlur()\"\n            (input)=\"age.api.handleChange($any($event).target.valueAsNumber)\"\n            [attr.aria-invalid]=\"age.api.meta.isInvalid\"\n          />\n        </label>\n      </ng-container>\n\n      <button type=\"submit\" [disabled]=\"!canSubmit() || isSubmitting()\">\n        {{ isSubmitting() ? 'Saving…' : 'Save' }}\n      </button>\n    </form>\n  `,\n})\nexport class ProfileFormComponent {\n  fullNameValidators = [\n    {\n      triggers: ['change', 'blur'] as const,\n      run: ({ value }: { value: string }) =>\n        value.trim() ? undefined : 'Enter your full name',\n    },\n  ]\n\n  ageValidators = [\n    {\n      triggers: ['change'] as const,\n      run: ({ value }: { value: number }) =>\n        value >= 13 ? undefined : 'You must be at least 13',\n    },\n  ]\n\n  form = injectForm({\n    defaultValues: {\n      fullName: '',\n      age: 0,\n    },\n    onSubmit: async ({ value }) => {\n      console.log(value)\n    },\n  })\n\n  canSubmit = injectSelector(this.form, (state) => state.canSubmit)\n  isSubmitting = injectSelector(this.form, (state) => state.isSubmitting)\n\n  handleSubmit(event: SubmitEvent) {\n    event.preventDefault()\n    void this.form.handleSubmit()\n  }\n}\n```\n\nThe important pieces are:\n\n- `defaultValues` define the complete initial value and drive type inference.\n- `TanStackField` turns an element or `ng-container` with `[tanstackField]`\n  into a field directive. The exported `field` reference exposes `api.value`,\n  `api.meta`, and event handlers.\n- Validators are ordered objects with a `run` function and explicit\n  `triggers`.\n- `injectSelector` creates an Angular signal for selected form state without\n  making unrelated fields rerender.\n- `form.handleSubmit()` validates the form before calling `onSubmit`.\n","originalRawMarkdown":"---\nid: quick-start\ntitle: Quick Start\n---\n\nTanStack Form is a headless, type-safe form library. It owns form state and\nvalidation while leaving markup, styling, and component choice to you.\n\nInstall the Angular adapter:\n\n```bash\nnpm install @tanstack/angular-form\n```\n\n## Create a form\n\n`injectForm` requires `defaultValues`. Their shape becomes the form's inferred\nvalue type. Call it in an Angular injection context, such as a component field\ninitializer.\n\n```ts\nimport { ChangeDetectionStrategy, Component } from '@angular/core'\nimport {\n  TanStackField,\n  injectForm,\n  injectSelector,\n} from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-profile-form',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [TanStackField],\n  template: `\n    <form (submit)=\"handleSubmit($event)\">\n      <ng-container\n        [tanstackField]=\"form\"\n        name=\"fullName\"\n        [validators]=\"fullNameValidators\"\n        #fullName=\"field\"\n      >\n        <label>\n          Full name\n          <input\n            [name]=\"fullName.api.name\"\n            [value]=\"fullName.api.value\"\n            (blur)=\"fullName.api.handleBlur()\"\n            (input)=\"fullName.api.handleChange($any($event).target.value)\"\n            [attr.aria-invalid]=\"fullName.api.meta.isInvalid\"\n          />\n          @for (error of fullName.api.errors; track error) {\n            <span role=\"alert\">{{ error.message }}</span>\n          }\n        </label>\n      </ng-container>\n\n      <ng-container\n        [tanstackField]=\"form\"\n        name=\"age\"\n        [validators]=\"ageValidators\"\n        #age=\"field\"\n      >\n        <label>\n          Age\n          <input\n            type=\"number\"\n            [name]=\"age.api.name\"\n            [value]=\"age.api.value\"\n            (blur)=\"age.api.handleBlur()\"\n            (input)=\"age.api.handleChange($any($event).target.valueAsNumber)\"\n            [attr.aria-invalid]=\"age.api.meta.isInvalid\"\n          />\n        </label>\n      </ng-container>\n\n      <button type=\"submit\" [disabled]=\"!canSubmit() || isSubmitting()\">\n        {{ isSubmitting() ? 'Saving…' : 'Save' }}\n      </button>\n    </form>\n  `,\n})\nexport class ProfileFormComponent {\n  fullNameValidators = [\n    {\n      triggers: ['change', 'blur'] as const,\n      run: ({ value }: { value: string }) =>\n        value.trim() ? undefined : 'Enter your full name',\n    },\n  ]\n\n  ageValidators = [\n    {\n      triggers: ['change'] as const,\n      run: ({ value }: { value: number }) =>\n        value >= 13 ? undefined : 'You must be at least 13',\n    },\n  ]\n\n  form = injectForm({\n    defaultValues: {\n      fullName: '',\n      age: 0,\n    },\n    onSubmit: async ({ value }) => {\n      console.log(value)\n    },\n  })\n\n  canSubmit = injectSelector(this.form, (state) => state.canSubmit)\n  isSubmitting = injectSelector(this.form, (state) => state.isSubmitting)\n\n  handleSubmit(event: SubmitEvent) {\n    event.preventDefault()\n    void this.form.handleSubmit()\n  }\n}\n```\n\nThe important pieces are:\n\n- `defaultValues` define the complete initial value and drive type inference.\n- `TanStackField` turns an element or `ng-container` with `[tanstackField]`\n  into a field directive. The exported `field` reference exposes `api.value`,\n  `api.meta`, and event handlers.\n- Validators are ordered objects with a `run` function and explicit\n  `triggers`.\n- `injectSelector` creates an Angular signal for selected form state without\n  making unrelated fields rerender.\n- `form.handleSubmit()` validates the form before calling `onSubmit`.\n"}
