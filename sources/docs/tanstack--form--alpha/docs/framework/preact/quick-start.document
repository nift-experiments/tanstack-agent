{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack Form is a headless, type-safe form library. It owns form state and\nvalidation while leaving markup, styling, and component choice to you."}]},{"type":"paragraph","children":[{"type":"text","value":"Install the Preact adapter:"}]},{"type":"code","value":"npm install @tanstack/preact-form","lang":"bash"},{"type":"heading","depth":2,"id":"create-a-form","children":[{"type":"text","value":"Create a form"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"useForm"},{"type":"text","value":" requires "},{"type":"inlineCode","value":"defaultValues"},{"type":"text","value":". Their shape becomes the form's inferred\nvalue type."}]},{"type":"code","value":"import { useForm } from '@tanstack/preact-form'\n\nexport function ProfileForm() {\n  const form = useForm({\n    defaultValues: {\n      fullName: '',\n      age: 0,\n    },\n    onSubmit: async ({ value }) => {\n      console.log(value)\n    },\n  })\n\n  return (\n    <form\n      onSubmit={(event) => {\n        event.preventDefault()\n        void form.handleSubmit()\n      }}\n    >\n      <form.Field\n        name=\"fullName\"\n        validators={[\n          {\n            triggers: ['change', 'blur'],\n            run: ({ value }) =>\n              value.trim() ? undefined : 'Enter your full name',\n          },\n        ]}\n      >\n        {(field) => (\n          <label>\n            Full name\n            <input\n              name={field.name}\n              value={field.value}\n              onBlur={field.handleBlur}\n              onInput={(event) => field.handleChange(event.currentTarget.value)}\n              aria-invalid={field.meta.isInvalid}\n            />\n            {field.errors.map((error) => (\n              <span key={error.message} role=\"alert\">\n                {error.message}\n              </span>\n            ))}\n          </label>\n        )}\n      </form.Field>\n\n      <form.Field\n        name=\"age\"\n        validators={[\n          {\n            triggers: ['change'],\n            run: ({ value }) =>\n              value >= 13 ? undefined : 'You must be at least 13',\n          },\n        ]}\n      >\n        {(field) => (\n          <label>\n            Age\n            <input\n              name={field.name}\n              type=\"number\"\n              value={field.value}\n              onBlur={field.handleBlur}\n              onInput={(event) =>\n                field.handleChange(event.currentTarget.valueAsNumber)\n              }\n              aria-invalid={field.meta.isInvalid}\n            />\n          </label>\n        )}\n      </form.Field>\n\n      <form.Subscribe\n        selector={(state) => [state.canSubmit, state.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n            {isSubmitting ? 'Saving…' : 'Save'}\n          </button>\n        )}\n      </form.Subscribe>\n    </form>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The important pieces are:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultValues"},{"type":"text","value":" define the complete initial value and drive type inference."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"form.Field"},{"type":"text","value":" subscribes to one field. Its render prop exposes "},{"type":"inlineCode","value":"field.value"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"field.meta"},{"type":"text","value":", and event handlers."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Validators are ordered objects with a "},{"type":"inlineCode","value":"run"},{"type":"text","value":" function and explicit\n"},{"type":"inlineCode","value":"triggers"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"form.Subscribe"},{"type":"text","value":" rerenders only its own children when the selected form state\nchanges."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"form.handleSubmit()"},{"type":"text","value":" validates the form before calling "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"create-a-form","text":"Create a form","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Form is a headless, type-safe form library. It owns form state and\nvalidation while leaving markup, styling, and component choice to you.\n\nInstall the Preact adapter:\n\n```bash\nnpm install @tanstack/preact-form\n```\n\n## Create a form\n\n`useForm` requires `defaultValues`. Their shape becomes the form's inferred\nvalue type.\n\n```tsx\nimport { useForm } from '@tanstack/preact-form'\n\nexport function ProfileForm() {\n  const form = useForm({\n    defaultValues: {\n      fullName: '',\n      age: 0,\n    },\n    onSubmit: async ({ value }) => {\n      console.log(value)\n    },\n  })\n\n  return (\n    <form\n      onSubmit={(event) => {\n        event.preventDefault()\n        void form.handleSubmit()\n      }}\n    >\n      <form.Field\n        name=\"fullName\"\n        validators={[\n          {\n            triggers: ['change', 'blur'],\n            run: ({ value }) =>\n              value.trim() ? undefined : 'Enter your full name',\n          },\n        ]}\n      >\n        {(field) => (\n          <label>\n            Full name\n            <input\n              name={field.name}\n              value={field.value}\n              onBlur={field.handleBlur}\n              onInput={(event) => field.handleChange(event.currentTarget.value)}\n              aria-invalid={field.meta.isInvalid}\n            />\n            {field.errors.map((error) => (\n              <span key={error.message} role=\"alert\">\n                {error.message}\n              </span>\n            ))}\n          </label>\n        )}\n      </form.Field>\n\n      <form.Field\n        name=\"age\"\n        validators={[\n          {\n            triggers: ['change'],\n            run: ({ value }) =>\n              value >= 13 ? undefined : 'You must be at least 13',\n          },\n        ]}\n      >\n        {(field) => (\n          <label>\n            Age\n            <input\n              name={field.name}\n              type=\"number\"\n              value={field.value}\n              onBlur={field.handleBlur}\n              onInput={(event) =>\n                field.handleChange(event.currentTarget.valueAsNumber)\n              }\n              aria-invalid={field.meta.isInvalid}\n            />\n          </label>\n        )}\n      </form.Field>\n\n      <form.Subscribe\n        selector={(state) => [state.canSubmit, state.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n            {isSubmitting ? 'Saving…' : 'Save'}\n          </button>\n        )}\n      </form.Subscribe>\n    </form>\n  )\n}\n```\n\nThe important pieces are:\n\n- `defaultValues` define the complete initial value and drive type inference.\n- `form.Field` subscribes to one field. Its render prop exposes `field.value`,\n  `field.meta`, and event handlers.\n- Validators are ordered objects with a `run` function and explicit\n  `triggers`.\n- `form.Subscribe` rerenders only its own children when the selected form state\n  changes.\n- `form.handleSubmit()` validates the form before calling `onSubmit`.\n","originalRawMarkdown":"---\nid: quick-start\ntitle: Quick Start\n---\n\nTanStack Form is a headless, type-safe form library. It owns form state and\nvalidation while leaving markup, styling, and component choice to you.\n\nInstall the Preact adapter:\n\n```bash\nnpm install @tanstack/preact-form\n```\n\n## Create a form\n\n`useForm` requires `defaultValues`. Their shape becomes the form's inferred\nvalue type.\n\n```tsx\nimport { useForm } from '@tanstack/preact-form'\n\nexport function ProfileForm() {\n  const form = useForm({\n    defaultValues: {\n      fullName: '',\n      age: 0,\n    },\n    onSubmit: async ({ value }) => {\n      console.log(value)\n    },\n  })\n\n  return (\n    <form\n      onSubmit={(event) => {\n        event.preventDefault()\n        void form.handleSubmit()\n      }}\n    >\n      <form.Field\n        name=\"fullName\"\n        validators={[\n          {\n            triggers: ['change', 'blur'],\n            run: ({ value }) =>\n              value.trim() ? undefined : 'Enter your full name',\n          },\n        ]}\n      >\n        {(field) => (\n          <label>\n            Full name\n            <input\n              name={field.name}\n              value={field.value}\n              onBlur={field.handleBlur}\n              onInput={(event) => field.handleChange(event.currentTarget.value)}\n              aria-invalid={field.meta.isInvalid}\n            />\n            {field.errors.map((error) => (\n              <span key={error.message} role=\"alert\">\n                {error.message}\n              </span>\n            ))}\n          </label>\n        )}\n      </form.Field>\n\n      <form.Field\n        name=\"age\"\n        validators={[\n          {\n            triggers: ['change'],\n            run: ({ value }) =>\n              value >= 13 ? undefined : 'You must be at least 13',\n          },\n        ]}\n      >\n        {(field) => (\n          <label>\n            Age\n            <input\n              name={field.name}\n              type=\"number\"\n              value={field.value}\n              onBlur={field.handleBlur}\n              onInput={(event) =>\n                field.handleChange(event.currentTarget.valueAsNumber)\n              }\n              aria-invalid={field.meta.isInvalid}\n            />\n          </label>\n        )}\n      </form.Field>\n\n      <form.Subscribe\n        selector={(state) => [state.canSubmit, state.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n            {isSubmitting ? 'Saving…' : 'Save'}\n          </button>\n        )}\n      </form.Subscribe>\n    </form>\n  )\n}\n```\n\nThe important pieces are:\n\n- `defaultValues` define the complete initial value and drive type inference.\n- `form.Field` subscribes to one field. Its render prop exposes `field.value`,\n  `field.meta`, and event handlers.\n- Validators are ordered objects with a `run` function and explicit\n  `triggers`.\n- `form.Subscribe` rerenders only its own children when the selected form state\n  changes.\n- `form.handleSubmit()` validates the form before calling `onSubmit`.\n"}
