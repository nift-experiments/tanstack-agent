der: (__namedParameters) => Element;","lang":"ts"},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"namedparameters","children":[{"type":"text","value":"__namedParameters"}]},{"type":"heading","depth":6,"id":"children","children":[{"type":"text","value":"children?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ComponentChildren"}]},{"type":"heading","depth":6,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Element"}]},{"type":"heading","depth":3,"id":"usestorecontext","children":[{"type":"text","value":"useStoreContext"}]},{"type":"code","value":"useStoreContext: () => TValue;","lang":"ts"},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const { StoreProvider, useStoreContext } = createStoreContext<{\n  countAtom: Atom<number>\n  totalsStore: Store<{ count: number }>\n}>()\n\nfunction CountButton() {\n  const { countAtom, totalsStore } = useStoreContext()\n  const count = useSelector(countAtom)\n  const total = useSelector(totalsStore, (state) => state.count)\n\n  return (\n    <button\n      type=\"button\"\n      onClick={() =>\n        totalsStore.setState((state) => ({ ...state, count: state.count + 1 }))\n      }\n    >\n      {count} / {total}\n    </button>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"throws","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"useStoreContext()"},{"type":"text","value":" is called outside the matching "},{"type":"inlineCode","value":"StoreProvider"},{"type":"text","value":"."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"returns","text":"Returns","level":2},{"id":"storeprovider","text":"StoreProvider","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"namedparameters","text":"__namedParameters","level":5},{"id":"children","text":"children?","level":6},{"id":"value","text":"value","level":6},{"id":"returns-2","text":"Returns","level":4},{"id":"usestorecontext","text":"useStoreContext","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"example","text":"Example","level":2},{"id":"throws","text":"Throws","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createStoreContext<TValue>(): object;\n```\n\nDefined in: node\\_modules/.pnpm/@tanstack+preact-store@0.13.2\\_preact@10.29.8/node\\_modules/@tanstack/preact-store/dist/createStoreContext.d.ts:44\n\nCreates a typed Preact context for sharing a bundle of atoms and stores with\na subtree.\n\nThe returned `StoreProvider` only transports the provided object through\nPreact context. Consumers destructure the contextual atoms and stores, then\ncompose them with the existing hooks like [useSelector](useSelector.md) and\n[useAtom](useAtom.md).\n\nThe object shape is preserved exactly, so keyed atoms and stores remain fully\ntyped when read back with `useStoreContext()`.\n\n## Type Parameters\n\n### TValue\n\n`TValue` *extends* `object`\n\n## Returns\n\n`object`\n\n### StoreProvider\n\n```ts\nStoreProvider: (__namedParameters) => Element;\n```\n\n#### Parameters\n\n##### \\_\\_namedParameters\n\n###### children?\n\n`ComponentChildren`\n\n###### value\n\n`TValue`\n\n#### Returns\n\n`Element`\n\n### useStoreContext\n\n```ts\nuseStoreContext: () => TValue;\n```\n\n#### Returns\n\n`TValue`\n\n## Example\n\n```tsx\nconst { StoreProvider, useStoreContext } = createStoreContext<{\n  countAtom: Atom<number>\n  totalsStore: Store<{ count: number }>\n}>()\n\nfunction CountButton() {\n  const { countAtom, totalsStore } = useStoreContext()\n  const count = useSelector(countAtom)\n  const total = useSelector(totalsStore, (state) => state.count)\n\n  return (\n    <button\n      type=\"button\"\n      onClick={() =>\n        totalsStore.setState((state) => ({ ...state, count: state.count + 1 }))\n      }\n    >\n      {count} / {total}\n    </button>\n  )\n}\n```\n\n## Throws\n\nWhen `useStoreContext()` is called outside the matching `StoreProvider`.\n","originalRawMarkdown":"---\nid: createStoreContext\ntitle: createStoreContext\n---\n\n```ts\nfunction createStoreContext<TValue>(): object;\n```\n\nDefined in: node\\_modules/.pnpm/@tanstack+preact-store@0.13.2\\_preact@10.29.8/node\\_modules/@tanstack/preact-store/dist/createStoreContext.d.ts:44\n\nCreates a typed Preact context for sharing a bundle of atoms and stores with\na subtree.\n\nThe returned `StoreProvider` only transports the provided object through\nPreact context. Consumers destructure the contextual atoms and stores, then\ncompose them with the existing hooks like [useSelector](useSelector.md) and\n[useAtom](useAtom.md).\n\nThe object shape is preserved exactly, so keyed atoms and stores remain fully\ntyped when read back with `useStoreContext()`.\n\n## Type Parameters\n\n### TValue\n\n`TValue` *extends* `object`\n\n## Returns\n\n`object`\n\n### StoreProvider\n\n```ts\nStoreProvider: (__namedParameters) => Element;\n```\n\n#### Parameters\n\n##### \\_\\_namedParameters\n\n###### children?\n\n`ComponentChildren`\n\n###### value\n\n`TValue`\n\n#### Returns\n\n`Element`\n\n### useStoreContext\n\n```ts\nuseStoreContext: () => TValue;\n```\n\n#### Returns\n\n`TValue`\n\n## Example\n\n```tsx\nconst { StoreProvider, useStoreContext } = createStoreContext<{\n  countAtom: Atom<number>\n  totalsStore: Store<{ count: number }>\n}>()\n\nfunction CountButton() {\n  const { countAtom, totalsStore } = useStoreContext()\n  const count = useSelector(countAtom)\n  const total = useSelector(totalsStore, (state) => state.count)\n\n  return (\n    <button\n      type=\"button\"\n      onClick={() =>\n        totalsStore.setState((state) => ({ ...state, count: state.count + 1 }))\n      }\n    >\n      {count} / {total}\n    </button>\n  )\n}\n```\n\n## Throws\n\nWhen `useStoreContext()` is called outside the matching `StoreProvider`.\n"}
