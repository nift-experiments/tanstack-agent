e":"inlineCode","value":"value"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"},{"type":"text","value":"]"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const [count, setCount] = useAtom(countAtom)\n\nreturn (\n  <button type=\"button\" onClick={() => setCount((prev) => prev + 1)}>\n    {count}\n  </button>\n)","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"atom","text":"atom","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useAtom<TValue>(atom, options?): [TValue, (fn) => void & (value) => void];\n```\n\nDefined in: node\\_modules/.pnpm/@tanstack+preact-store@0.13.2\\_preact@10.29.8/node\\_modules/@tanstack/preact-store/dist/useAtom.d.ts:22\n\nReturns the current atom value together with a stable setter.\n\nUse this when a component needs to both read and update the same writable\natom.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Parameters\n\n### atom\n\n[`Atom`](../interfaces/Atom.md)\\<`TValue`\\>\n\n### options?\n\n[`UseSelectorOptions`](../interfaces/UseSelectorOptions.md)\\<`TValue`\\>\n\n## Returns\n\n\\[`TValue`, (`fn`) => `void` & (`value`) => `void`\\]\n\n## Example\n\n```tsx\nconst [count, setCount] = useAtom(countAtom)\n\nreturn (\n  <button type=\"button\" onClick={() => setCount((prev) => prev + 1)}>\n    {count}\n  </button>\n)\n```\n","originalRawMarkdown":"---\nid: useAtom\ntitle: useAtom\n---\n\n```ts\nfunction useAtom<TValue>(atom, options?): [TValue, (fn) => void & (value) => void];\n```\n\nDefined in: node\\_modules/.pnpm/@tanstack+preact-store@0.13.2\\_preact@10.29.8/node\\_modules/@tanstack/preact-store/dist/useAtom.d.ts:22\n\nReturns the current atom value together with a stable setter.\n\nUse this when a component needs to both read and update the same writable\natom.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Parameters\n\n### atom\n\n[`Atom`](../interfaces/Atom.md)\\<`TValue`\\>\n\n### options?\n\n[`UseSelectorOptions`](../interfaces/UseSelectorOptions.md)\\<`TValue`\\>\n\n## Returns\n\n\\[`TValue`, (`fn`) => `void` & (`value`) => `void`\\]\n\n## Example\n\n```tsx\nconst [count, setCount] = useAtom(countAtom)\n\nreturn (\n  <button type=\"button\" onClick={() => setCount((prev) => prev + 1)}>\n    {count}\n  </button>\n)\n```\n"}
