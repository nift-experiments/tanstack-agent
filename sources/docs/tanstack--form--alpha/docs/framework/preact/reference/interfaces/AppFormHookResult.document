ext","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Use the result with "},{"type":"inlineCode","value":"PreactFormType"},{"type":"text","value":" when a child component needs the type\nof one known App Form, including its registered field and form components."}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const profileOptions = appFormOptions({\n  defaultValues: { name: '' },\n})\n\ntype ProfileForm = PreactFormType<typeof profileOptions>\n\nfunction NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <field.TextField label=\"Name\" />}\n    </form.Field>\n  )\n}","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"defineappfieldgroup","children":[{"type":"text","value":"defineAppFieldGroup"}]},{"type":"code","value":"defineAppFieldGroup: DefineFieldGroupFn<TComponents[\"fieldComponents\"]>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L177","children":[{"type":"text","value":"packages/preact-form/src/AppForm/createFormHookTypes.public.ts:177"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Defines a reusable field group whose fields expose the field components\nregistered with "},{"type":"inlineCode","value":"createFormHook"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const { defineAppFieldGroup } = createFormHook({\n  fieldComponents: {\n    TextField,\n  },\n  formComponents: {},\n})\n\nconst contactFields = defineAppFieldGroup(({ strict }) => ({\n  name: strict<string>(),\n  email: strict<string>(),\n}))\n\nfunction ContactFields({\n  fields,\n}: {\n  fields: typeof contactFields.fields\n}) {\n  return (\n    <fields.Field name=\"name\">\n      {(field) => <field.TextField label=\"Name\" />}\n    </fields.Field>\n  )\n}","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"useappform","children":[{"type":"text","value":"useAppForm"}]},{"type":"code","value":"useAppForm: UseAppFormHook<TComponents>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L202","children":[{"type":"text","value":"packages/preact-form/src/AppForm/createFormHookTypes.public.ts:202"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Preact form API extended with the field and form components\nregistered with "},{"type":"inlineCode","value":"createFormHook"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Form data, validators, and submission results are inferred from the passed\noptions."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"function ProfileForm() {\n  const form = useAppForm({\n    defaultValues: { name: '' },\n  })\n\n  return (\n    <form.AppForm>\n      <form.Field name=\"name\">\n        {(field) => <field.TextField label=\"Name\" />}\n      </form.Field>\n    </form.AppForm>\n  )\n}","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"useformcontext","children":[{"type":"text","value":"useFormContext"}]},{"type":"code","value":"useFormContext: () => PreactAppFormApi<any, any, TComponents>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L226","children":[{"type":"text","value":"packages/preact-form/src/AppForm/createFormHookTypes.public.ts:226"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Reads the current App Form API from the nearest "},{"type":"inlineCode","value":"form.AppForm"},{"type":"text","value":" provider."}]},{"type":"paragraph","children":[{"type":"text","value":"Use this hook inside form components registered with "},{"type":"inlineCode","value":"createFormHook"},{"type":"text","value":". It\nthrows when called outside a "},{"type":"inlineCode","value":"form.AppForm"},{"type":"text","value":" subtree."}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/PreactAppFormApi.md","children":[{"type":"inlineCode","value":"PreactAppFormApi"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"TComponents"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"function SubmitButton({ label }: { label: string }) {\n  const form = useFormContext()\n\n  return (\n    <form.Subscribe selector={(state) => state.isSubmitting}>\n      {(isSubmitting) => (\n        <button type=\"submit\" disabled={isSubmitting}>\n          {label}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tcomponents","text":"TComponents","level":3},{"id":"properties","text":"Properties","level":2},{"id":"appformoptions","text":"appFormOptions","level":3},{"id":"example","text":"Example","level":4},{"id":"defineappfieldgroup","text":"defineAppFieldGroup","level":3},{"id":"example-2","text":"Example","level":4},{"id":"useappform","text":"useAppForm","level":3},{"id":"example-3","text":"Example","level":4},{"id":"useformcontext","text":"useFormContext","level":3},{"id":"returns","text":"Returns","level":4},{"id":"example-4","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:118](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L118)\n\nApp Form hooks and helpers bound to the components registered with\n`createFormHook`.\n\n## Type Parameters\n\n### TComponents\n\n`TComponents` *extends* [`AnyPreactFormComponentMap`](../type-aliases/AnyPreactFormComponentMap.md)\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### appFormOptions\n\n```ts\nappFormOptions: FormOptionsApi<TComponents>;\n```\n\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:145](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L145)\n\nDefines reusable form options that retain the components registered with\n`createFormHook`.\n\nUse the result with `PreactFormType` when a child component needs the type\nof one known App Form, including its registered field and form components.\n\n#### Example\n\n```tsx\nconst profileOptions = appFormOptions({\n  defaultValues: { name: '' },\n})\n\ntype ProfileForm = PreactFormType<typeof profileOptions>\n\nfunction NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <field.TextField label=\"Name\" />}\n    </form.Field>\n  )\n}\n```\n\n***\n\n### defineAppFieldGroup\n\n```ts\ndefineAppFieldGroup: DefineFieldGroupFn<TComponents[\"fieldComponents\"]>;\n```\n\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:177](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L177)\n\nDefines a reusable field group whose fields expose the field components\nregistered with `createFormHook`.\n\n#### Example\n\n```tsx\nconst { defineAppFieldGroup } = createFormHook({\n  fieldComponents: {\n    TextField,\n  },\n  formComponents: {},\n})\n\nconst contactFields = defineAppFieldGroup(({ strict }) => ({\n  name: strict<string>(),\n  email: strict<string>(),\n}))\n\nfunction ContactFields({\n  fields,\n}: {\n  fields: typeof contactFields.fields\n}) {\n  return (\n    <fields.Field name=\"name\">\n      {(field) => <field.TextField label=\"Name\" />}\n    </fields.Field>\n  )\n}\n```\n\n***\n\n### useAppForm\n\n```ts\nuseAppForm: UseAppFormHook<TComponents>;\n```\n\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:202](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L202)\n\nCreates a Preact form API extended with the field and form components\nregistered with `createFormHook`.\n\nForm data, validators, and submission results are inferred from the passed\noptions.\n\n#### Example\n\n```tsx\nfunction ProfileForm() {\n  const form = useAppForm({\n    defaultValues: { name: '' },\n  })\n\n  return (\n    <form.AppForm>\n      <form.Field name=\"name\">\n        {(field) => <field.TextField label=\"Name\" />}\n      </form.Field>\n    </form.AppForm>\n  )\n}\n```\n\n***\n\n### useFormContext\n\n```ts\nuseFormContext: () => PreactAppFormApi<any, any, TComponents>;\n```\n\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:226](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L226)\n\nReads the current App Form API from the nearest `form.AppForm` provider.\n\nUse this hook inside form components registered with `createFormHook`. It\nthrows when called outside a `form.AppForm` subtree.\n\n#### Returns\n\n[`PreactAppFormApi`](../type-aliases/PreactAppFormApi.md)\\<`any`, `any`, `TComponents`\\>\n\n#### Example\n\n```tsx\nfunction SubmitButton({ label }: { label: string }) {\n  const form = useFormContext()\n\n  return (\n    <form.Subscribe selector={(state) => state.isSubmitting}>\n      {(isSubmitting) => (\n        <button type=\"submit\" disabled={isSubmitting}>\n          {label}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}\n```\n","originalRawMarkdown":"---\nid: AppFormHookResult\ntitle: AppFormHookResult\n---\n\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:118](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L118)\n\nApp Form hooks and helpers bound to the components registered with\n`createFormHook`.\n\n## Type Parameters\n\n### TComponents\n\n`TComponents` *extends* [`AnyPreactFormComponentMap`](../type-aliases/AnyPreactFormComponentMap.md)\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### appFormOptions\n\n```ts\nappFormOptions: FormOptionsApi<TComponents>;\n```\n\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:145](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L145)\n\nDefines reusable form options that retain the components registered with\n`createFormHook`.\n\nUse the result with `PreactFormType` when a child component needs the type\nof one known App Form, including its registered field and form components.\n\n#### Example\n\n```tsx\nconst profileOptions = appFormOptions({\n  defaultValues: { name: '' },\n})\n\ntype ProfileForm = PreactFormType<typeof profileOptions>\n\nfunction NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <field.TextField label=\"Name\" />}\n    </form.Field>\n  )\n}\n```\n\n***\n\n### defineAppFieldGroup\n\n```ts\ndefineAppFieldGroup: DefineFieldGroupFn<TComponents[\"fieldComponents\"]>;\n```\n\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:177](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L177)\n\nDefines a reusable field group whose fields expose the field components\nregistered with `createFormHook`.\n\n#### Example\n\n```tsx\nconst { defineAppFieldGroup } = createFormHook({\n  fieldComponents: {\n    TextField,\n  },\n  formComponents: {},\n})\n\nconst contactFields = defineAppFieldGroup(({ strict }) => ({\n  name: strict<string>(),\n  email: strict<string>(),\n}))\n\nfunction ContactFields({\n  fields,\n}: {\n  fields: typeof contactFields.fields\n}) {\n  return (\n    <fields.Field name=\"name\">\n      {(field) => <field.TextField label=\"Name\" />}\n    </fields.Field>\n  )\n}\n```\n\n***\n\n### useAppForm\n\n```ts\nuseAppForm: UseAppFormHook<TComponents>;\n```\n\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:202](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L202)\n\nCreates a Preact form API extended with the field and form components\nregistered with `createFormHook`.\n\nForm data, validators, and submission results are inferred from the passed\noptions.\n\n#### Example\n\n```tsx\nfunction ProfileForm() {\n  const form = useAppForm({\n    defaultValues: { name: '' },\n  })\n\n  return (\n    <form.AppForm>\n      <form.Field name=\"name\">\n        {(field) => <field.TextField label=\"Name\" />}\n      </form.Field>\n    </form.AppForm>\n  )\n}\n```\n\n***\n\n### useFormContext\n\n```ts\nuseFormContext: () => PreactAppFormApi<any, any, TComponents>;\n```\n\nDefined in: [packages/preact-form/src/AppForm/createFormHookTypes.public.ts:226](https://github.com/TanStack/form/blob/main/packages/preact-form/src/AppForm/createFormHookTypes.public.ts#L226)\n\nReads the current App Form API from the nearest `form.AppForm` provider.\n\nUse this hook inside form components registered with `createFormHook`. It\nthrows when called outside a `form.AppForm` subtree.\n\n#### Returns\n\n[`PreactAppFormApi`](../type-aliases/PreactAppFormApi.md)\\<`any`, `any`, `TComponents`\\>\n\n#### Example\n\n```tsx\nfunction SubmitButton({ label }: { label: string }) {\n  const form = useFormContext()\n\n  return (\n    <form.Subscribe selector={(state) => state.isSubmitting}>\n      {(isSubmitting) => (\n        <button type=\"submit\" disabled={isSubmitting}>\n          {label}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}\n```\n"}
