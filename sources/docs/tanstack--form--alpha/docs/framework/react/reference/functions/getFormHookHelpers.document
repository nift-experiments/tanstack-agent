{"document":{"type":"root","children":[{"type":"code","value":"function getFormHookHelpers(): FormHookHelpers;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L268","children":[{"type":"text","value":"packages/react-form/src/AppForm/getFormHookHelpers.public.ts:268"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates helpers that make React field components value-aware for\n"},{"type":"inlineCode","value":"createFormHook"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"fieldComponent"},{"type":"text","value":" injects the current App Form field API into a selected prop.\n"},{"type":"inlineCode","value":"fieldBrand"},{"type":"text","value":" only adds compile-time field-value compatibility and returns the\noriginal component at runtime."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/FormHookHelpers.md","children":[{"type":"inlineCode","value":"FormHookHelpers"}]}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { createFormHook, getFormHookHelpers } from '@tanstack/react-form'\nimport type { FieldWithValue } from '@tanstack/react-form'\n\nfunction TextInput({ field }: { field: FieldWithValue<string> }) {\n  return (\n    <input\n      value={field.value}\n      onChange={(event) => field.handleChange(event.target.value)}\n    />\n  )\n}\n\nconst { fieldComponent } = getFormHookHelpers()\nconst TextField = fieldComponent.strict(TextInput, 'field')\n\nexport const { useAppForm } = createFormHook({\n  fieldComponents: { TextField },\n  formComponents: {},\n})","lang":"tsx"}],"headings":[{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction getFormHookHelpers(): FormHookHelpers;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:268](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L268)\n\nCreates helpers that make React field components value-aware for\n`createFormHook`.\n\n`fieldComponent` injects the current App Form field API into a selected prop.\n`fieldBrand` only adds compile-time field-value compatibility and returns the\noriginal component at runtime.\n\n## Returns\n\n[`FormHookHelpers`](../interfaces/FormHookHelpers.md)\n\n## Example\n\n```tsx\nimport { createFormHook, getFormHookHelpers } from '@tanstack/react-form'\nimport type { FieldWithValue } from '@tanstack/react-form'\n\nfunction TextInput({ field }: { field: FieldWithValue<string> }) {\n  return (\n    <input\n      value={field.value}\n      onChange={(event) => field.handleChange(event.target.value)}\n    />\n  )\n}\n\nconst { fieldComponent } = getFormHookHelpers()\nconst TextField = fieldComponent.strict(TextInput, 'field')\n\nexport const { useAppForm } = createFormHook({\n  fieldComponents: { TextField },\n  formComponents: {},\n})\n```\n","originalRawMarkdown":"---\nid: getFormHookHelpers\ntitle: getFormHookHelpers\n---\n\n```ts\nfunction getFormHookHelpers(): FormHookHelpers;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:268](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L268)\n\nCreates helpers that make React field components value-aware for\n`createFormHook`.\n\n`fieldComponent` injects the current App Form field API into a selected prop.\n`fieldBrand` only adds compile-time field-value compatibility and returns the\noriginal component at runtime.\n\n## Returns\n\n[`FormHookHelpers`](../interfaces/FormHookHelpers.md)\n\n## Example\n\n```tsx\nimport { createFormHook, getFormHookHelpers } from '@tanstack/react-form'\nimport type { FieldWithValue } from '@tanstack/react-form'\n\nfunction TextInput({ field }: { field: FieldWithValue<string> }) {\n  return (\n    <input\n      value={field.value}\n      onChange={(event) => field.handleChange(event.target.value)}\n    />\n  )\n}\n\nconst { fieldComponent } = getFormHookHelpers()\nconst TextField = fieldComponent.strict(TextInput, 'field')\n\nexport const { useAppForm } = createFormHook({\n  fieldComponents: { TextField },\n  formComponents: {},\n})\n```\n"}
