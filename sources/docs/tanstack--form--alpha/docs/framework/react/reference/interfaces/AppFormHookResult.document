value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Use the result with "},{"type":"inlineCode","value":"ReactFormType"},{"type":"text","value":" when a child component needs the type\nof one known App Form, including its registered field and form components."}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const profileOptions = appFormOptions({\n  defaultValues: { name: '' },\n})\n\ntype ProfileForm = ReactFormType<typeof profileOptions>\n\nfunction NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <field.TextField label=\"Name\" />}\n    </form.Field>\n  )\n}","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"defineappfieldgroup","children":[{"type":"text","value":"defineAppFieldGroup"}]},{"type":"code","value":"defineAppFieldGroup: DefineFieldGroupFn<TComponents[\"fieldComponents\"]>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L194","children":[{"type":"text","value":"packages/react-form/src/AppForm/createFormHookTypes.public.ts:194"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Defines a field group whose fields expose the field components registered\nwith "},{"type":"inlineCode","value":"createFormHook"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const { defineAppFieldGroup } = createFormHook({\n  fieldComponents: {\n    TextField,\n  },\n  formComponents: {},\n})\n\nconst passwordFieldGroup = defineAppFieldGroup(({ strict }) => ({\n  password: strict<string>(),\n  confirmPassword: strict<string>(),\n}))\n\ninterface PasswordFieldsProps {\n  fields: typeof passwordFieldGroup.fields\n}\n\nfunction PasswordFields({ fields }: PasswordFieldsProps) {\n  return (\n    <>\n      <fields.Field name=\"password\">\n        {(field) => <field.TextField label=\"Password\" />}\n      </fields.Field>\n      <fields.Field name=\"confirmPassword\">\n        {(field) => (\n          <field.TextField label=\"Confirm password\" />\n        )}\n      </fields.Field>\n    </>\n  )\n}","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"useappform","children":[{"type":"text","value":"useAppForm"}]},{"type":"code","value":"useAppForm: UseAppFormHook<TComponents>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L219","children":[{"type":"text","value":"packages/react-form/src/AppForm/createFormHookTypes.public.ts:219"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a React form API extended with the field and form components\nregistered with "},{"type":"inlineCode","value":"createFormHook"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Form data, validators, and submission results are inferred from the passed\noptions."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"function ProfileForm() {\n  const form = useAppForm({\n    defaultValues: { name: '' },\n  })\n\n  return (\n    <form.AppForm>\n      <form.Field name=\"name\">\n        {(field) => <field.TextField label=\"Name\" />}\n      </form.Field>\n    </form.AppForm>\n  )\n}","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"useformcontext","children":[{"type":"text","value":"useFormContext"}]},{"type":"code","value":"useFormContext: () => ReactAppFormApi<any, any, TComponents>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L243","children":[{"type":"text","value":"packages/react-form/src/AppForm/createFormHookTypes.public.ts:243"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Reads the current App Form API from the nearest "},{"type":"inlineCode","value":"form.AppForm"},{"type":"text","value":" provider."}]},{"type":"paragraph","children":[{"type":"text","value":"Use this hook inside form components registered with "},{"type":"inlineCode","value":"createFormHook"},{"type":"text","value":". It\nthrows when called outside a "},{"type":"inlineCode","value":"form.AppForm"},{"type":"text","value":" subtree."}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/ReactAppFormApi.md","children":[{"type":"inlineCode","value":"ReactAppFormApi"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"TComponents"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"function SubmitButton({ label }: { label: string }) {\n  const form = useFormContext()\n\n  return (\n    <form.Subscribe selector={(state) => state.isSubmitting}>\n      {(isSubmitting) => (\n        <button type=\"submit\" disabled={isSubmitting}>\n          {label}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tcomponents","text":"TComponents","level":3},{"id":"properties","text":"Properties","level":2},{"id":"appformoptions","text":"appFormOptions","level":3},{"id":"example","text":"Example","level":4},{"id":"defineappfieldgroup","text":"defineAppFieldGroup","level":3},{"id":"example-2","text":"Example","level":4},{"id":"useappform","text":"useAppForm","level":3},{"id":"example-3","text":"Example","level":4},{"id":"useformcontext","text":"useFormContext","level":3},{"id":"returns","text":"Returns","level":4},{"id":"example-4","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:128](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L128)\n\nApp Form hooks and helpers bound to the components registered with\n`createFormHook`.\n\n## Type Parameters\n\n### TComponents\n\n`TComponents` *extends* [`AnyReactFormComponentMap`](../type-aliases/AnyReactFormComponentMap.md)\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### appFormOptions\n\n```ts\nappFormOptions: FormOptionsApi<TComponents>;\n```\n\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:155](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L155)\n\nDefines reusable form options that retain the components registered with\n`createFormHook`.\n\nUse the result with `ReactFormType` when a child component needs the type\nof one known App Form, including its registered field and form components.\n\n#### Example\n\n```tsx\nconst profileOptions = appFormOptions({\n  defaultValues: { name: '' },\n})\n\ntype ProfileForm = ReactFormType<typeof profileOptions>\n\nfunction NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <field.TextField label=\"Name\" />}\n    </form.Field>\n  )\n}\n```\n\n***\n\n### defineAppFieldGroup\n\n```ts\ndefineAppFieldGroup: DefineFieldGroupFn<TComponents[\"fieldComponents\"]>;\n```\n\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:194](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L194)\n\nDefines a field group whose fields expose the field components registered\nwith `createFormHook`.\n\n#### Example\n\n```tsx\nconst { defineAppFieldGroup } = createFormHook({\n  fieldComponents: {\n    TextField,\n  },\n  formComponents: {},\n})\n\nconst passwordFieldGroup = defineAppFieldGroup(({ strict }) => ({\n  password: strict<string>(),\n  confirmPassword: strict<string>(),\n}))\n\ninterface PasswordFieldsProps {\n  fields: typeof passwordFieldGroup.fields\n}\n\nfunction PasswordFields({ fields }: PasswordFieldsProps) {\n  return (\n    <>\n      <fields.Field name=\"password\">\n        {(field) => <field.TextField label=\"Password\" />}\n      </fields.Field>\n      <fields.Field name=\"confirmPassword\">\n        {(field) => (\n          <field.TextField label=\"Confirm password\" />\n        )}\n      </fields.Field>\n    </>\n  )\n}\n```\n\n***\n\n### useAppForm\n\n```ts\nuseAppForm: UseAppFormHook<TComponents>;\n```\n\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:219](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L219)\n\nCreates a React form API extended with the field and form components\nregistered with `createFormHook`.\n\nForm data, validators, and submission results are inferred from the passed\noptions.\n\n#### Example\n\n```tsx\nfunction ProfileForm() {\n  const form = useAppForm({\n    defaultValues: { name: '' },\n  })\n\n  return (\n    <form.AppForm>\n      <form.Field name=\"name\">\n        {(field) => <field.TextField label=\"Name\" />}\n      </form.Field>\n    </form.AppForm>\n  )\n}\n```\n\n***\n\n### useFormContext\n\n```ts\nuseFormContext: () => ReactAppFormApi<any, any, TComponents>;\n```\n\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:243](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L243)\n\nReads the current App Form API from the nearest `form.AppForm` provider.\n\nUse this hook inside form components registered with `createFormHook`. It\nthrows when called outside a `form.AppForm` subtree.\n\n#### Returns\n\n[`ReactAppFormApi`](../type-aliases/ReactAppFormApi.md)\\<`any`, `any`, `TComponents`\\>\n\n#### Example\n\n```tsx\nfunction SubmitButton({ label }: { label: string }) {\n  const form = useFormContext()\n\n  return (\n    <form.Subscribe selector={(state) => state.isSubmitting}>\n      {(isSubmitting) => (\n        <button type=\"submit\" disabled={isSubmitting}>\n          {label}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}\n```\n","originalRawMarkdown":"---\nid: AppFormHookResult\ntitle: AppFormHookResult\n---\n\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:128](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L128)\n\nApp Form hooks and helpers bound to the components registered with\n`createFormHook`.\n\n## Type Parameters\n\n### TComponents\n\n`TComponents` *extends* [`AnyReactFormComponentMap`](../type-aliases/AnyReactFormComponentMap.md)\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### appFormOptions\n\n```ts\nappFormOptions: FormOptionsApi<TComponents>;\n```\n\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:155](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L155)\n\nDefines reusable form options that retain the components registered with\n`createFormHook`.\n\nUse the result with `ReactFormType` when a child component needs the type\nof one known App Form, including its registered field and form components.\n\n#### Example\n\n```tsx\nconst profileOptions = appFormOptions({\n  defaultValues: { name: '' },\n})\n\ntype ProfileForm = ReactFormType<typeof profileOptions>\n\nfunction NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <field.TextField label=\"Name\" />}\n    </form.Field>\n  )\n}\n```\n\n***\n\n### defineAppFieldGroup\n\n```ts\ndefineAppFieldGroup: DefineFieldGroupFn<TComponents[\"fieldComponents\"]>;\n```\n\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:194](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L194)\n\nDefines a field group whose fields expose the field components registered\nwith `createFormHook`.\n\n#### Example\n\n```tsx\nconst { defineAppFieldGroup } = createFormHook({\n  fieldComponents: {\n    TextField,\n  },\n  formComponents: {},\n})\n\nconst passwordFieldGroup = defineAppFieldGroup(({ strict }) => ({\n  password: strict<string>(),\n  confirmPassword: strict<string>(),\n}))\n\ninterface PasswordFieldsProps {\n  fields: typeof passwordFieldGroup.fields\n}\n\nfunction PasswordFields({ fields }: PasswordFieldsProps) {\n  return (\n    <>\n      <fields.Field name=\"password\">\n        {(field) => <field.TextField label=\"Password\" />}\n      </fields.Field>\n      <fields.Field name=\"confirmPassword\">\n        {(field) => (\n          <field.TextField label=\"Confirm password\" />\n        )}\n      </fields.Field>\n    </>\n  )\n}\n```\n\n***\n\n### useAppForm\n\n```ts\nuseAppForm: UseAppFormHook<TComponents>;\n```\n\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:219](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L219)\n\nCreates a React form API extended with the field and form components\nregistered with `createFormHook`.\n\nForm data, validators, and submission results are inferred from the passed\noptions.\n\n#### Example\n\n```tsx\nfunction ProfileForm() {\n  const form = useAppForm({\n    defaultValues: { name: '' },\n  })\n\n  return (\n    <form.AppForm>\n      <form.Field name=\"name\">\n        {(field) => <field.TextField label=\"Name\" />}\n      </form.Field>\n    </form.AppForm>\n  )\n}\n```\n\n***\n\n### useFormContext\n\n```ts\nuseFormContext: () => ReactAppFormApi<any, any, TComponents>;\n```\n\nDefined in: [packages/react-form/src/AppForm/createFormHookTypes.public.ts:243](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/createFormHookTypes.public.ts#L243)\n\nReads the current App Form API from the nearest `form.AppForm` provider.\n\nUse this hook inside form components registered with `createFormHook`. It\nthrows when called outside a `form.AppForm` subtree.\n\n#### Returns\n\n[`ReactAppFormApi`](../type-aliases/ReactAppFormApi.md)\\<`any`, `any`, `TComponents`\\>\n\n#### Example\n\n```tsx\nfunction SubmitButton({ label }: { label: string }) {\n  const form = useFormContext()\n\n  return (\n    <form.Subscribe selector={(state) => state.isSubmitting}>\n      {(isSubmitting) => (\n        <button type=\"submit\" disabled={isSubmitting}>\n          {label}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}\n```\n"}
