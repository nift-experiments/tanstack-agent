"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"<"},{"type":"inlineCode","value":"TComponent"},{"type":"text","value":">("},{"type":"inlineCode","value":"Component"},{"type":"text","value":") => "},{"type":"inlineCode","value":"LooseBrandedFieldComponent"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TComponent"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { getFormHookHelpers } from '@tanstack/react-form'\n\nfunction FieldDescription() {\n  return <span>Changes are saved automatically.</span>\n}\n\nconst { fieldBrand } = getFormHookHelpers()\nconst Description = fieldBrand.loose<unknown>()(FieldDescription)","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"strict","children":[{"type":"text","value":"strict"}]},{"type":"code","value":"strict: <TValue>() => <TComponent>(Component) => StrictBrandedFieldComponent<TComponent, TValue>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L184","children":[{"type":"text","value":"packages/react-form/src/AppForm/getFormHookHelpers.public.ts:184"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Brands a component for fields whose value type exactly matches "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The returned value is the original component at runtime. Unlike\n"},{"type":"inlineCode","value":"fieldComponent.strict"},{"type":"text","value":", this helper does not inject a field API prop."}]},{"type":"heading","depth":4,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tvalue-2","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"paragraph","children":[{"type":"text","value":"The exact field value type that exposes the component."}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"<"},{"type":"inlineCode","value":"TComponent"},{"type":"text","value":">("},{"type":"inlineCode","value":"Component"},{"type":"text","value":") => "},{"type":"inlineCode","value":"StrictBrandedFieldComponent"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TComponent"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { getFormHookHelpers } from '@tanstack/react-form'\n\nfunction Adornment() {\n  return <span>Required</span>\n}\n\nconst { fieldBrand } = getFormHookHelpers()\nconst StringAdornment = fieldBrand.strict<string>()(Adornment)","lang":"tsx"}],"headings":[{"id":"properties","text":"Properties","level":2},{"id":"loose","text":"loose","level":3},{"id":"type-parameters","text":"Type Parameters","level":4},{"id":"tvalue","text":"TValue","level":5},{"id":"returns","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"strict","text":"strict","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":4},{"id":"tvalue-2","text":"TValue","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:162](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L162)\n\nAdds field-value compatibility metadata to components without wrapping them\nor changing their runtime props.\n\n## Properties\n\n### loose\n\n```ts\nloose: <TValue>() => <TComponent>(Component) => LooseBrandedFieldComponent<TComponent, TValue>;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:210](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L210)\n\nBrands a component for fields whose value type is assignable to\n`TValue`.\n\nThe returned value is the original component at runtime. Unlike\n`fieldComponent.loose`, this helper does not inject a field API prop.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue`\n\nThe field value type accepted by the component.\n\n#### Returns\n\n\\<`TComponent`\\>(`Component`) => `LooseBrandedFieldComponent`\\<`TComponent`, `TValue`\\>\n\n#### Example\n\n```tsx\nimport { getFormHookHelpers } from '@tanstack/react-form'\n\nfunction FieldDescription() {\n  return <span>Changes are saved automatically.</span>\n}\n\nconst { fieldBrand } = getFormHookHelpers()\nconst Description = fieldBrand.loose<unknown>()(FieldDescription)\n```\n\n***\n\n### strict\n\n```ts\nstrict: <TValue>() => <TComponent>(Component) => StrictBrandedFieldComponent<TComponent, TValue>;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:184](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L184)\n\nBrands a component for fields whose value type exactly matches `TValue`.\n\nThe returned value is the original component at runtime. Unlike\n`fieldComponent.strict`, this helper does not inject a field API prop.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue`\n\nThe exact field value type that exposes the component.\n\n#### Returns\n\n\\<`TComponent`\\>(`Component`) => `StrictBrandedFieldComponent`\\<`TComponent`, `TValue`\\>\n\n#### Example\n\n```tsx\nimport { getFormHookHelpers } from '@tanstack/react-form'\n\nfunction Adornment() {\n  return <span>Required</span>\n}\n\nconst { fieldBrand } = getFormHookHelpers()\nconst StringAdornment = fieldBrand.strict<string>()(Adornment)\n```\n","originalRawMarkdown":"---\nid: FieldBrandHelper\ntitle: FieldBrandHelper\n---\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:162](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L162)\n\nAdds field-value compatibility metadata to components without wrapping them\nor changing their runtime props.\n\n## Properties\n\n### loose\n\n```ts\nloose: <TValue>() => <TComponent>(Component) => LooseBrandedFieldComponent<TComponent, TValue>;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:210](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L210)\n\nBrands a component for fields whose value type is assignable to\n`TValue`.\n\nThe returned value is the original component at runtime. Unlike\n`fieldComponent.loose`, this helper does not inject a field API prop.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue`\n\nThe field value type accepted by the component.\n\n#### Returns\n\n\\<`TComponent`\\>(`Component`) => `LooseBrandedFieldComponent`\\<`TComponent`, `TValue`\\>\n\n#### Example\n\n```tsx\nimport { getFormHookHelpers } from '@tanstack/react-form'\n\nfunction FieldDescription() {\n  return <span>Changes are saved automatically.</span>\n}\n\nconst { fieldBrand } = getFormHookHelpers()\nconst Description = fieldBrand.loose<unknown>()(FieldDescription)\n```\n\n***\n\n### strict\n\n```ts\nstrict: <TValue>() => <TComponent>(Component) => StrictBrandedFieldComponent<TComponent, TValue>;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:184](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L184)\n\nBrands a component for fields whose value type exactly matches `TValue`.\n\nThe returned value is the original component at runtime. Unlike\n`fieldComponent.strict`, this helper does not inject a field API prop.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue`\n\nThe exact field value type that exposes the component.\n\n#### Returns\n\n\\<`TComponent`\\>(`Component`) => `StrictBrandedFieldComponent`\\<`TComponent`, `TValue`\\>\n\n#### Example\n\n```tsx\nimport { getFormHookHelpers } from '@tanstack/react-form'\n\nfunction Adornment() {\n  return <span>Required</span>\n}\n\nconst { fieldBrand } = getFormHookHelpers()\nconst StringAdornment = fieldBrand.strict<string>()(Adornment)\n```\n"}
