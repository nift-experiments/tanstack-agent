ropKey"}]},{"type":"paragraph","children":[{"type":"text","value":"The prop that accepts the current field API."}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"LooseInjectedFieldComponent"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TComponent"},{"type":"text","value":", "},{"type":"inlineCode","value":"TProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFieldPropKey"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { getFormHookHelpers } from '@tanstack/react-form'\nimport type { AnyFieldApi } from '@tanstack/react-form'\n\nfunction FieldErrors({ field }: { field: AnyFieldApi }) {\n  return <span>{field.errors.map((error) => error.message).join(', ')}</span>\n}\n\nconst { fieldComponent } = getFormHookHelpers()\nconst Errors = fieldComponent.loose(FieldErrors, 'field')","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"strict","children":[{"type":"text","value":"strict"}]},{"type":"code","value":"strict: <TComponent, TProps, TFieldPropKey>(Component, fieldPropKey) => StrictInjectedFieldComponent<TComponent, TProps, TFieldPropKey>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L110","children":[{"type":"text","value":"packages/react-form/src/AppForm/getFormHookHelpers.public.ts:110"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Wraps a component for fields whose value type exactly matches the value\ntype of its field API prop."}]},{"type":"paragraph","children":[{"type":"text","value":"The returned component omits "},{"type":"inlineCode","value":"fieldPropKey"},{"type":"text","value":" from its public props and reads\nthat field API from the nearest App Form field context. It must be rendered\nbeneath an App Form "},{"type":"inlineCode","value":"Field"},{"type":"text","value":" or field-group "},{"type":"inlineCode","value":"Field"},{"type":"text","value":" component."}]},{"type":"heading","depth":4,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tcomponent-2","children":[{"type":"text","value":"TComponent"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TComponent"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyFieldComponent"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":5,"id":"tprops-2","children":[{"type":"text","value":"TProps"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TProps"},{"type":"text","value":" = "},{"type":"inlineCode","value":"PropsOf"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TComponent"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":5,"id":"tfieldpropkey-2","children":[{"type":"text","value":"TFieldPropKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFieldPropKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"string"},{"type":"text","value":" | "},{"type":"inlineCode","value":"number"},{"type":"text","value":" | "},{"type":"inlineCode","value":"symbol"},{"type":"text","value":" = "},{"type":"inlineCode","value":"FieldValuePropKeys"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TProps"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"component-2","children":[{"type":"text","value":"Component"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TComponent"}]},{"type":"paragraph","children":[{"type":"text","value":"The component whose field API prop should be injected."}]},{"type":"heading","depth":5,"id":"fieldpropkey-2","children":[{"type":"text","value":"fieldPropKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFieldPropKey"}]},{"type":"paragraph","children":[{"type":"text","value":"The prop that accepts the current field API."}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"StrictInjectedFieldComponent"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TComponent"},{"type":"text","value":", "},{"type":"inlineCode","value":"TProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFieldPropKey"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { getFormHookHelpers } from '@tanstack/react-form'\nimport type { FieldWithValue } from '@tanstack/react-form'\n\nfunction TextInput({\n  field,\n  label,\n}: {\n  field: FieldWithValue<string>\n  label: string\n}) {\n  return (\n    <label>\n      {label}\n      <input\n        value={field.value}\n        onChange={(event) => field.handleChange(event.target.value)}\n      />\n    </label>\n  )\n}\n\nconst { fieldComponent } = getFormHookHelpers()\nconst TextField = fieldComponent.strict(TextInput, 'field')","lang":"tsx"}],"headings":[{"id":"properties","text":"Properties","level":2},{"id":"loose","text":"loose","level":3},{"id":"type-parameters","text":"Type Parameters","level":4},{"id":"tcomponent","text":"TComponent","level":5},{"id":"tprops","text":"TProps","level":5},{"id":"tfieldpropkey","text":"TFieldPropKey","level":5},{"id":"parameters","text":"Parameters","level":4},{"id":"component","text":"Component","level":5},{"id":"fieldpropkey","text":"fieldPropKey","level":5},{"id":"returns","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"strict","text":"strict","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":4},{"id":"tcomponent-2","text":"TComponent","level":5},{"id":"tprops-2","text":"TProps","level":5},{"id":"tfieldpropkey-2","text":"TFieldPropKey","level":5},{"id":"parameters-2","text":"Parameters","level":4},{"id":"component-2","text":"Component","level":5},{"id":"fieldpropkey-2","text":"fieldPropKey","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:68](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L68)\n\nWraps components that accept a field API prop so App Form can supply that\nprop from field context.\n\n## Properties\n\n### loose\n\n```ts\nloose: <TComponent, TProps, TFieldPropKey>(Component, fieldPropKey) => LooseInjectedFieldComponent<TComponent, TProps, TFieldPropKey>;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:147](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L147)\n\nWraps a component for fields whose value type is assignable to the value\ntype accepted by its field API prop.\n\nThe returned component omits `fieldPropKey` from its public props and reads\nthat field API from the nearest App Form field context. Use this mode for a\ncomponent that intentionally supports a broader range of field values.\n\n#### Type Parameters\n\n##### TComponent\n\n`TComponent` *extends* `AnyFieldComponent`\n\nLibrary-managed. Do not specify explicitly.\n\n##### TProps\n\n`TProps` = `PropsOf`\\<`TComponent`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n##### TFieldPropKey\n\n`TFieldPropKey` *extends* `string` \\| `number` \\| `symbol` = `FieldValuePropKeys`\\<`TProps`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n#### Parameters\n\n##### Component\n\n`TComponent`\n\nThe component whose field API prop should be injected.\n\n##### fieldPropKey\n\n`TFieldPropKey`\n\nThe prop that accepts the current field API.\n\n#### Returns\n\n`LooseInjectedFieldComponent`\\<`TComponent`, `TProps`, `TFieldPropKey`\\>\n\n#### Example\n\n```tsx\nimport { getFormHookHelpers } from '@tanstack/react-form'\nimport type { AnyFieldApi } from '@tanstack/react-form'\n\nfunction FieldErrors({ field }: { field: AnyFieldApi }) {\n  return <span>{field.errors.map((error) => error.message).join(', ')}</span>\n}\n\nconst { fieldComponent } = getFormHookHelpers()\nconst Errors = fieldComponent.loose(FieldErrors, 'field')\n```\n\n***\n\n### strict\n\n```ts\nstrict: <TComponent, TProps, TFieldPropKey>(Component, fieldPropKey) => StrictInjectedFieldComponent<TComponent, TProps, TFieldPropKey>;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:110](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L110)\n\nWraps a component for fields whose value type exactly matches the value\ntype of its field API prop.\n\nThe returned component omits `fieldPropKey` from its public props and reads\nthat field API from the nearest App Form field context. It must be rendered\nbeneath an App Form `Field` or field-group `Field` component.\n\n#### Type Parameters\n\n##### TComponent\n\n`TComponent` *extends* `AnyFieldComponent`\n\nLibrary-managed. Do not specify explicitly.\n\n##### TProps\n\n`TProps` = `PropsOf`\\<`TComponent`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n##### TFieldPropKey\n\n`TFieldPropKey` *extends* `string` \\| `number` \\| `symbol` = `FieldValuePropKeys`\\<`TProps`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n#### Parameters\n\n##### Component\n\n`TComponent`\n\nThe component whose field API prop should be injected.\n\n##### fieldPropKey\n\n`TFieldPropKey`\n\nThe prop that accepts the current field API.\n\n#### Returns\n\n`StrictInjectedFieldComponent`\\<`TComponent`, `TProps`, `TFieldPropKey`\\>\n\n#### Example\n\n```tsx\nimport { getFormHookHelpers } from '@tanstack/react-form'\nimport type { FieldWithValue } from '@tanstack/react-form'\n\nfunction TextInput({\n  field,\n  label,\n}: {\n  field: FieldWithValue<string>\n  label: string\n}) {\n  return (\n    <label>\n      {label}\n      <input\n        value={field.value}\n        onChange={(event) => field.handleChange(event.target.value)}\n      />\n    </label>\n  )\n}\n\nconst { fieldComponent } = getFormHookHelpers()\nconst TextField = fieldComponent.strict(TextInput, 'field')\n```\n","originalRawMarkdown":"---\nid: FieldComponentHelper\ntitle: FieldComponentHelper\n---\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:68](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L68)\n\nWraps components that accept a field API prop so App Form can supply that\nprop from field context.\n\n## Properties\n\n### loose\n\n```ts\nloose: <TComponent, TProps, TFieldPropKey>(Component, fieldPropKey) => LooseInjectedFieldComponent<TComponent, TProps, TFieldPropKey>;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:147](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L147)\n\nWraps a component for fields whose value type is assignable to the value\ntype accepted by its field API prop.\n\nThe returned component omits `fieldPropKey` from its public props and reads\nthat field API from the nearest App Form field context. Use this mode for a\ncomponent that intentionally supports a broader range of field values.\n\n#### Type Parameters\n\n##### TComponent\n\n`TComponent` *extends* `AnyFieldComponent`\n\nLibrary-managed. Do not specify explicitly.\n\n##### TProps\n\n`TProps` = `PropsOf`\\<`TComponent`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n##### TFieldPropKey\n\n`TFieldPropKey` *extends* `string` \\| `number` \\| `symbol` = `FieldValuePropKeys`\\<`TProps`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n#### Parameters\n\n##### Component\n\n`TComponent`\n\nThe component whose field API prop should be injected.\n\n##### fieldPropKey\n\n`TFieldPropKey`\n\nThe prop that accepts the current field API.\n\n#### Returns\n\n`LooseInjectedFieldComponent`\\<`TComponent`, `TProps`, `TFieldPropKey`\\>\n\n#### Example\n\n```tsx\nimport { getFormHookHelpers } from '@tanstack/react-form'\nimport type { AnyFieldApi } from '@tanstack/react-form'\n\nfunction FieldErrors({ field }: { field: AnyFieldApi }) {\n  return <span>{field.errors.map((error) => error.message).join(', ')}</span>\n}\n\nconst { fieldComponent } = getFormHookHelpers()\nconst Errors = fieldComponent.loose(FieldErrors, 'field')\n```\n\n***\n\n### strict\n\n```ts\nstrict: <TComponent, TProps, TFieldPropKey>(Component, fieldPropKey) => StrictInjectedFieldComponent<TComponent, TProps, TFieldPropKey>;\n```\n\nDefined in: [packages/react-form/src/AppForm/getFormHookHelpers.public.ts:110](https://github.com/TanStack/form/blob/main/packages/react-form/src/AppForm/getFormHookHelpers.public.ts#L110)\n\nWraps a component for fields whose value type exactly matches the value\ntype of its field API prop.\n\nThe returned component omits `fieldPropKey` from its public props and reads\nthat field API from the nearest App Form field context. It must be rendered\nbeneath an App Form `Field` or field-group `Field` component.\n\n#### Type Parameters\n\n##### TComponent\n\n`TComponent` *extends* `AnyFieldComponent`\n\nLibrary-managed. Do not specify explicitly.\n\n##### TProps\n\n`TProps` = `PropsOf`\\<`TComponent`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n##### TFieldPropKey\n\n`TFieldPropKey` *extends* `string` \\| `number` \\| `symbol` = `FieldValuePropKeys`\\<`TProps`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n#### Parameters\n\n##### Component\n\n`TComponent`\n\nThe component whose field API prop should be injected.\n\n##### fieldPropKey\n\n`TFieldPropKey`\n\nThe prop that accepts the current field API.\n\n#### Returns\n\n`StrictInjectedFieldComponent`\\<`TComponent`, `TProps`, `TFieldPropKey`\\>\n\n#### Example\n\n```tsx\nimport { getFormHookHelpers } from '@tanstack/react-form'\nimport type { FieldWithValue } from '@tanstack/react-form'\n\nfunction TextInput({\n  field,\n  label,\n}: {\n  field: FieldWithValue<string>\n  label: string\n}) {\n  return (\n    <label>\n      {label}\n      <input\n        value={field.value}\n        onChange={(event) => field.handleChange(event.target.value)}\n      />\n    </label>\n  )\n}\n\nconst { fieldComponent } = getFormHookHelpers()\nconst TextField = fieldComponent.strict(TextInput, 'field')\n```\n"}
