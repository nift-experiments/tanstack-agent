},{"type":"paragraph","children":[{"type":"inlineCode","value":"TProps"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":3,"id":"tfieldspropname","children":[{"type":"text","value":"TFieldsPropName"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFieldsPropName"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"FieldGroupFieldsPropName"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFieldGroup"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"component","children":[{"type":"text","value":"Component"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"props"},{"type":"text","value":") => "},{"type":"inlineCode","value":"ReactNode"}]},{"type":"heading","depth":3,"id":"fieldspropname","children":[{"type":"text","value":"fieldsPropName"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFieldsPropName"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":">("},{"type":"inlineCode","value":"props"},{"type":"text","value":") => "},{"type":"inlineCode","value":"ReactNode"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const passwordFieldGroup = defineFieldGroup(({ strict }) => ({\n  password: strict<string>(),\n  confirmPassword: strict<string>(),\n}))\n\ninterface PasswordFieldsProps {\n  fields: typeof passwordFieldGroup.fields\n}\n\nfunction PasswordFields({ fields }: PasswordFieldsProps) {\n  // ...\n}\n\nconst PasswordSection = passwordFieldGroup.bindComponent(\n  PasswordFields,\n  'fields',\n)\n\nfunction AccountForm() {\n  const form = useForm({\n    defaultValues: {\n      account: {\n        password: '',\n        confirmPassword: '',\n      },\n    },\n  })\n\n  return (\n    <PasswordSection\n      form={form}\n      fields={{\n        password: 'account.password',\n        confirmPassword: 'account.confirmPassword',\n      }}\n    />\n  )\n}","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfieldgroup","text":"TFieldGroup","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":2},{"id":"tprops","text":"TProps","level":3},{"id":"tfieldspropname","text":"TFieldsPropName","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"component","text":"Component","level":3},{"id":"fieldspropname","text":"fieldsPropName","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype FieldGroupWithFieldsFn<TFieldGroup> = <TProps, TFieldsPropName>(Component, fieldsPropName) => <TFormData>(props) => ReactNode;\n```\n\nDefined in: [packages/react-form/src/FieldGroup/withFields.public.ts:100](https://github.com/TanStack/form/blob/main/packages/react-form/src/FieldGroup/withFields.public.ts#L100)\n\nWraps a component that accepts a field-group API and returns a component\nthat accepts a form and, when needed, virtual-to-concrete field bindings.\n\nIf every virtual field name is already a compatible path in the form, the\nreturned component binds those paths automatically when the bindings prop is\nomitted. A complete bindings map can still reroute them. Otherwise, the\nbindings prop is required.\n\n## Type Parameters\n\n### TFieldGroup\n\n`TFieldGroup` *extends* [`ReactFieldGroup`](ReactFieldGroup.md)\\<`any`, `any`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TProps\n\n`TProps` *extends* `object`\n\n### TFieldsPropName\n\n`TFieldsPropName` *extends* `FieldGroupFieldsPropName`\\<`TProps`, `TFieldGroup`\\>\n\n## Parameters\n\n### Component\n\n(`props`) => `ReactNode`\n\n### fieldsPropName\n\n`TFieldsPropName`\n\n## Returns\n\n\\<`TFormData`\\>(`props`) => `ReactNode`\n\n## Example\n\n```tsx\nconst passwordFieldGroup = defineFieldGroup(({ strict }) => ({\n  password: strict<string>(),\n  confirmPassword: strict<string>(),\n}))\n\ninterface PasswordFieldsProps {\n  fields: typeof passwordFieldGroup.fields\n}\n\nfunction PasswordFields({ fields }: PasswordFieldsProps) {\n  // ...\n}\n\nconst PasswordSection = passwordFieldGroup.bindComponent(\n  PasswordFields,\n  'fields',\n)\n\nfunction AccountForm() {\n  const form = useForm({\n    defaultValues: {\n      account: {\n        password: '',\n        confirmPassword: '',\n      },\n    },\n  })\n\n  return (\n    <PasswordSection\n      form={form}\n      fields={{\n        password: 'account.password',\n        confirmPassword: 'account.confirmPassword',\n      }}\n    />\n  )\n}\n```\n","originalRawMarkdown":"---\nid: FieldGroupWithFieldsFn\ntitle: FieldGroupWithFieldsFn\n---\n\n```ts\ntype FieldGroupWithFieldsFn<TFieldGroup> = <TProps, TFieldsPropName>(Component, fieldsPropName) => <TFormData>(props) => ReactNode;\n```\n\nDefined in: [packages/react-form/src/FieldGroup/withFields.public.ts:100](https://github.com/TanStack/form/blob/main/packages/react-form/src/FieldGroup/withFields.public.ts#L100)\n\nWraps a component that accepts a field-group API and returns a component\nthat accepts a form and, when needed, virtual-to-concrete field bindings.\n\nIf every virtual field name is already a compatible path in the form, the\nreturned component binds those paths automatically when the bindings prop is\nomitted. A complete bindings map can still reroute them. Otherwise, the\nbindings prop is required.\n\n## Type Parameters\n\n### TFieldGroup\n\n`TFieldGroup` *extends* [`ReactFieldGroup`](ReactFieldGroup.md)\\<`any`, `any`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TProps\n\n`TProps` *extends* `object`\n\n### TFieldsPropName\n\n`TFieldsPropName` *extends* `FieldGroupFieldsPropName`\\<`TProps`, `TFieldGroup`\\>\n\n## Parameters\n\n### Component\n\n(`props`) => `ReactNode`\n\n### fieldsPropName\n\n`TFieldsPropName`\n\n## Returns\n\n\\<`TFormData`\\>(`props`) => `ReactNode`\n\n## Example\n\n```tsx\nconst passwordFieldGroup = defineFieldGroup(({ strict }) => ({\n  password: strict<string>(),\n  confirmPassword: strict<string>(),\n}))\n\ninterface PasswordFieldsProps {\n  fields: typeof passwordFieldGroup.fields\n}\n\nfunction PasswordFields({ fields }: PasswordFieldsProps) {\n  // ...\n}\n\nconst PasswordSection = passwordFieldGroup.bindComponent(\n  PasswordFields,\n  'fields',\n)\n\nfunction AccountForm() {\n  const form = useForm({\n    defaultValues: {\n      account: {\n        password: '',\n        confirmPassword: '',\n      },\n    },\n  })\n\n  return (\n    <PasswordSection\n      form={form}\n      fields={{\n        password: 'account.password',\n        confirmPassword: 'account.confirmPassword',\n      }}\n    />\n  )\n}\n```\n"}
