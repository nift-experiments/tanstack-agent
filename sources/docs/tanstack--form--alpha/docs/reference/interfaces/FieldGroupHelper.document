:"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/StrictFieldGroupFieldSlot.md","children":[{"type":"inlineCode","value":"StrictFieldGroupFieldSlot"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A field slot that uses strict value-type matching."}]},{"type":"heading","depth":4,"id":"call-signature-4","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"<TValue>(): StrictFieldGroupFieldSlot<TValue>;","lang":"ts"},{"type":"heading","depth":5,"id":"type-parameters-4","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":6,"id":"tvalue-4","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"paragraph","children":[{"type":"text","value":"The value type the concrete form field must match\nexactly."}]},{"type":"heading","depth":5,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/StrictFieldGroupFieldSlot.md","children":[{"type":"inlineCode","value":"StrictFieldGroupFieldSlot"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A field slot that uses strict value-type matching."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const passwordFieldGroup = defineFieldGroup(({ strict }) => ({\n  password: strict<string>(),\n  confirmPassword: strict<string>(),\n}))","lang":"tsx"}],"headings":[{"id":"example","text":"Example","level":2},{"id":"properties","text":"Properties","level":2},{"id":"loose","text":"loose","level":3},{"id":"call-signature","text":"Call Signature","level":4},{"id":"type-parameters","text":"Type Parameters","level":5},{"id":"tvalue","text":"TValue","level":6},{"id":"parameters","text":"Parameters","level":5},{"id":"value","text":"value","level":6},{"id":"returns","text":"Returns","level":5},{"id":"call-signature-2","text":"Call Signature","level":4},{"id":"type-parameters-2","text":"Type Parameters","level":5},{"id":"tvalue-2","text":"TValue","level":6},{"id":"returns-2","text":"Returns","level":5},{"id":"example-2","text":"Example","level":4},{"id":"strict","text":"strict","level":3},{"id":"call-signature-3","text":"Call Signature","level":4},{"id":"type-parameters-3","text":"Type Parameters","level":5},{"id":"tvalue-3","text":"TValue","level":6},{"id":"parameters-2","text":"Parameters","level":5},{"id":"value-2","text":"value","level":6},{"id":"returns-3","text":"Returns","level":5},{"id":"call-signature-4","text":"Call Signature","level":4},{"id":"type-parameters-4","text":"Type Parameters","level":5},{"id":"tvalue-4","text":"TValue","level":6},{"id":"returns-4","text":"Returns","level":5},{"id":"example-3","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [FieldGroup/fieldGroupTypes.public.ts:259](https://github.com/TanStack/form/blob/main/packages/form-core/src/FieldGroup/fieldGroupTypes.public.ts#L259)\n\nDeclares the virtual fields in a reusable field group and how their value\ntypes may bind to concrete form fields.\n\n## Example\n\n```ts\nconst profileFields = defineFieldGroup(({ strict, loose }) => ({\n  name: strict(''),\n  status: loose<string>(),\n}))\n```\n\n## Properties\n\n### loose\n\n```ts\nloose: {\n<TValue>  (value): LooseFieldGroupFieldSlot<TValue>;\n<TValue>  (): LooseFieldGroupFieldSlot<TValue>;\n};\n```\n\nDefined in: [FieldGroup/fieldGroupTypes.public.ts:298](https://github.com/TanStack/form/blob/main/packages/form-core/src/FieldGroup/fieldGroupTypes.public.ts#L298)\n\nDeclares a virtual field that can bind to form fields whose value type is\nassignable to the declared type.\n\n#### Call Signature\n\n```ts\n<TValue>(value): LooseFieldGroupFieldSlot<TValue>;\n```\n\n##### Type Parameters\n\n###### TValue\n\n`TValue`\n\nInferred from the representative value.\n\n##### Parameters\n\n###### value\n\n`TValue`\n\nA representative value used only for type inference.\n\n##### Returns\n\n[`LooseFieldGroupFieldSlot`](../type-aliases/LooseFieldGroupFieldSlot.md)\\<`TValue`\\>\n\nA field slot that uses assignable value-type matching.\n\n#### Call Signature\n\n```ts\n<TValue>(): LooseFieldGroupFieldSlot<TValue>;\n```\n\n##### Type Parameters\n\n###### TValue\n\n`TValue`\n\nThe value type that compatible concrete field values\nmust be assignable to.\n\n##### Returns\n\n[`LooseFieldGroupFieldSlot`](../type-aliases/LooseFieldGroupFieldSlot.md)\\<`TValue`\\>\n\nA field slot that uses assignable value-type matching.\n\n#### Example\n\n```tsx\nconst passwordFieldGroup = defineFieldGroup(({ loose }) => ({\n  password: loose<string>(),\n  confirmPassword: loose<string>(),\n}))\n```\n\n***\n\n### strict\n\n```ts\nstrict: {\n<TValue>  (value): StrictFieldGroupFieldSlot<TValue>;\n<TValue>  (): StrictFieldGroupFieldSlot<TValue>;\n};\n```\n\nDefined in: [FieldGroup/fieldGroupTypes.public.ts:272](https://github.com/TanStack/form/blob/main/packages/form-core/src/FieldGroup/fieldGroupTypes.public.ts#L272)\n\nDeclares a virtual field whose value type must exactly match the value type\nof the concrete form field it binds to.\n\n#### Call Signature\n\n```ts\n<TValue>(value): StrictFieldGroupFieldSlot<TValue>;\n```\n\n##### Type Parameters\n\n###### TValue\n\n`TValue`\n\nInferred from the representative value.\n\n##### Parameters\n\n###### value\n\n`TValue`\n\nA representative value used only for type inference.\n\n##### Returns\n\n[`StrictFieldGroupFieldSlot`](../type-aliases/StrictFieldGroupFieldSlot.md)\\<`TValue`\\>\n\nA field slot that uses strict value-type matching.\n\n#### Call Signature\n\n```ts\n<TValue>(): StrictFieldGroupFieldSlot<TValue>;\n```\n\n##### Type Parameters\n\n###### TValue\n\n`TValue`\n\nThe value type the concrete form field must match\nexactly.\n\n##### Returns\n\n[`StrictFieldGroupFieldSlot`](../type-aliases/StrictFieldGroupFieldSlot.md)\\<`TValue`\\>\n\nA field slot that uses strict value-type matching.\n\n#### Example\n\n```tsx\nconst passwordFieldGroup = defineFieldGroup(({ strict }) => ({\n  password: strict<string>(),\n  confirmPassword: strict<string>(),\n}))\n```\n","originalRawMarkdown":"---\nid: FieldGroupHelper\ntitle: FieldGroupHelper\n---\n\nDefined in: [FieldGroup/fieldGroupTypes.public.ts:259](https://github.com/TanStack/form/blob/main/packages/form-core/src/FieldGroup/fieldGroupTypes.public.ts#L259)\n\nDeclares the virtual fields in a reusable field group and how their value\ntypes may bind to concrete form fields.\n\n## Example\n\n```ts\nconst profileFields = defineFieldGroup(({ strict, loose }) => ({\n  name: strict(''),\n  status: loose<string>(),\n}))\n```\n\n## Properties\n\n### loose\n\n```ts\nloose: {\n<TValue>  (value): LooseFieldGroupFieldSlot<TValue>;\n<TValue>  (): LooseFieldGroupFieldSlot<TValue>;\n};\n```\n\nDefined in: [FieldGroup/fieldGroupTypes.public.ts:298](https://github.com/TanStack/form/blob/main/packages/form-core/src/FieldGroup/fieldGroupTypes.public.ts#L298)\n\nDeclares a virtual field that can bind to form fields whose value type is\nassignable to the declared type.\n\n#### Call Signature\n\n```ts\n<TValue>(value): LooseFieldGroupFieldSlot<TValue>;\n```\n\n##### Type Parameters\n\n###### TValue\n\n`TValue`\n\nInferred from the representative value.\n\n##### Parameters\n\n###### value\n\n`TValue`\n\nA representative value used only for type inference.\n\n##### Returns\n\n[`LooseFieldGroupFieldSlot`](../type-aliases/LooseFieldGroupFieldSlot.md)\\<`TValue`\\>\n\nA field slot that uses assignable value-type matching.\n\n#### Call Signature\n\n```ts\n<TValue>(): LooseFieldGroupFieldSlot<TValue>;\n```\n\n##### Type Parameters\n\n###### TValue\n\n`TValue`\n\nThe value type that compatible concrete field values\nmust be assignable to.\n\n##### Returns\n\n[`LooseFieldGroupFieldSlot`](../type-aliases/LooseFieldGroupFieldSlot.md)\\<`TValue`\\>\n\nA field slot that uses assignable value-type matching.\n\n#### Example\n\n```tsx\nconst passwordFieldGroup = defineFieldGroup(({ loose }) => ({\n  password: loose<string>(),\n  confirmPassword: loose<string>(),\n}))\n```\n\n***\n\n### strict\n\n```ts\nstrict: {\n<TValue>  (value): StrictFieldGroupFieldSlot<TValue>;\n<TValue>  (): StrictFieldGroupFieldSlot<TValue>;\n};\n```\n\nDefined in: [FieldGroup/fieldGroupTypes.public.ts:272](https://github.com/TanStack/form/blob/main/packages/form-core/src/FieldGroup/fieldGroupTypes.public.ts#L272)\n\nDeclares a virtual field whose value type must exactly match the value type\nof the concrete form field it binds to.\n\n#### Call Signature\n\n```ts\n<TValue>(value): StrictFieldGroupFieldSlot<TValue>;\n```\n\n##### Type Parameters\n\n###### TValue\n\n`TValue`\n\nInferred from the representative value.\n\n##### Parameters\n\n###### value\n\n`TValue`\n\nA representative value used only for type inference.\n\n##### Returns\n\n[`StrictFieldGroupFieldSlot`](../type-aliases/StrictFieldGroupFieldSlot.md)\\<`TValue`\\>\n\nA field slot that uses strict value-type matching.\n\n#### Call Signature\n\n```ts\n<TValue>(): StrictFieldGroupFieldSlot<TValue>;\n```\n\n##### Type Parameters\n\n###### TValue\n\n`TValue`\n\nThe value type the concrete form field must match\nexactly.\n\n##### Returns\n\n[`StrictFieldGroupFieldSlot`](../type-aliases/StrictFieldGroupFieldSlot.md)\\<`TValue`\\>\n\nA field slot that uses strict value-type matching.\n\n#### Example\n\n```tsx\nconst passwordFieldGroup = defineFieldGroup(({ strict }) => ({\n  password: strict<string>(),\n  confirmPassword: strict<string>(),\n}))\n```\n"}
