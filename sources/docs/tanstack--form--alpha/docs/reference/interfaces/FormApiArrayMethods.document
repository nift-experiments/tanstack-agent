ange indices or a runtime value that is not\nan array produce a warning and leave the value unchanged."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation."}]},{"type":"heading","depth":4,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// items: ['first', 'second', 'third']\nformApi.moveFieldValue('items', 0, 2)\n// items: ['second', 'third', 'first']","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"pushfieldvalue","children":[{"type":"text","value":"pushFieldValue"}]},{"type":"code","value":"pushFieldValue: PushFieldValueFn<TFormData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L375","children":[{"type":"text","value":"FormApi/FormApiArrayMethods.types.public.ts:375"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Appends an element to an array field."}]},{"type":"paragraph","children":[{"type":"text","value":"A runtime value that is not an array produces a warning and is left\nunchanged. By default, the update marks the array field as touched and\ndirty, notifies change listeners, and runs change validation."}]},{"type":"heading","depth":4,"id":"example-5","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// items: ['first', 'second']\nformApi.pushFieldValue('items', 'new item')\n// items: ['first', 'second', 'new item']","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"removefieldvalue","children":[{"type":"text","value":"removeFieldValue"}]},{"type":"code","value":"removeFieldValue: RemoveFieldValueFn<TFormData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L429","children":[{"type":"text","value":"FormApi/FormApiArrayMethods.types.public.ts:429"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Removes an element from an array field."}]},{"type":"paragraph","children":[{"type":"text","value":"The index must be between "},{"type":"inlineCode","value":"0"},{"type":"text","value":" and "},{"type":"inlineCode","value":"array.length - 1"},{"type":"text","value":". An out-of-range index\nor a runtime value that is not an array produces a warning and leaves the\nvalue unchanged."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation."}]},{"type":"heading","depth":4,"id":"example-6","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// items: ['first', 'second', 'third']\nformApi.removeFieldValue('items', 1)\n// items: ['first', 'third']","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"replacefieldvalue","children":[{"type":"text","value":"replaceFieldValue"}]},{"type":"code","value":"replaceFieldValue: ReplaceFieldValueFn<TFormData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L448","children":[{"type":"text","value":"FormApi/FormApiArrayMethods.types.public.ts:448"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Replaces the element at an index in an array field."}]},{"type":"paragraph","children":[{"type":"text","value":"The index must be between "},{"type":"inlineCode","value":"0"},{"type":"text","value":" and "},{"type":"inlineCode","value":"array.length - 1"},{"type":"text","value":". An out-of-range index\nor a runtime value that is not an array produces a warning and leaves the\nvalue unchanged."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation."}]},{"type":"heading","depth":4,"id":"example-7","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// items: ['first', 'second', 'third']\nformApi.replaceFieldValue('items', 1, 'new item')\n// items: ['first', 'new item', 'third']","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"swapfieldvalues","children":[{"type":"text","value":"swapFieldValues"}]},{"type":"code","value":"swapFieldValues: SwapFieldValuesFn<TFormData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L340","children":[{"type":"text","value":"FormApi/FormApiArrayMethods.types.public.ts:340"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Swaps two elements in an array field."}]},{"type":"paragraph","children":[{"type":"text","value":"Both indices must be between "},{"type":"inlineCode","value":"0"},{"type":"text","value":" and "},{"type":"inlineCode","value":"array.length - 1"},{"type":"text","value":". Passing equal\nindices does nothing. Out-of-range indices or a runtime value that is not\nan array produce a warning and leave the value unchanged."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation."}]},{"type":"heading","depth":4,"id":"example-8","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// items: ['first', 'second', 'third']\nformApi.swapFieldValues('items', 0, 2)\n// items: ['third', 'second', 'first']","lang":"ts"}],"headings":[{"id":"extended-by","text":"Extended by","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"clearfieldvalues","text":"clearFieldValues","level":3},{"id":"example","text":"Example","level":4},{"id":"filterfieldvalues","text":"filterFieldValues","level":3},{"id":"example-2","text":"Example","level":4},{"id":"insertfieldvalue","text":"insertFieldValue","level":3},{"id":"example-3","text":"Example","level":4},{"id":"movefieldvalue","text":"moveFieldValue","level":3},{"id":"example-4","text":"Example","level":4},{"id":"pushfieldvalue","text":"pushFieldValue","level":3},{"id":"example-5","text":"Example","level":4},{"id":"removefieldvalue","text":"removeFieldValue","level":3},{"id":"example-6","text":"Example","level":4},{"id":"replacefieldvalue","text":"replaceFieldValue","level":3},{"id":"example-7","text":"Example","level":4},{"id":"swapfieldvalues","text":"swapFieldValues","level":3},{"id":"example-8","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:322](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L322)\n\nMethods for adding, removing, moving, and filtering array field elements.\n\n## Extended by\n\n- [`FormApi`](FormApi.md)\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### clearFieldValues\n\n```ts\nclearFieldValues: ClearFieldValuesFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:410](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L410)\n\nRemoves every element from an array field.\n\nA runtime value that is not an array produces a warning and is left\nunchanged. By default, the update marks the array field as touched and\ndirty, notifies change listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second']\nformApi.clearFieldValues('items')\n// items: []\n```\n\n***\n\n### filterFieldValues\n\n```ts\nfilterFieldValues: FilterFieldValuesFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:465](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L465)\n\nKeeps the elements that satisfy a predicate.\n\n`options.thisArg` sets the predicate's `this` value. A runtime value that is\nnot an array produces a warning and is left unchanged. By default, the\nupdate marks the array field as touched and dirty, notifies change\nlisteners, and runs change validation.\n\n#### Example\n\n```ts\n// items: [1, 2, 3, 4]\nformApi.filterFieldValues('items', (item) => item % 2 === 0)\n// items: [2, 4]\n```\n\n***\n\n### insertFieldValue\n\n```ts\ninsertFieldValue: InsertFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:394](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L394)\n\nInserts an element at an index in an array field.\n\nThe index must be between `0` and `array.length`; passing `array.length`\nappends the element. An out-of-range index or a runtime value that is not\nan array produces a warning and leaves the value unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second']\nformApi.insertFieldValue('items', 1, 'new item')\n// items: ['first', 'new item', 'second']\n```\n\n***\n\n### moveFieldValue\n\n```ts\nmoveFieldValue: MoveFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:359](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L359)\n\nMoves an element to another index in an array field.\n\nBoth indices must be between `0` and `array.length - 1`. Passing equal\nindices does nothing. Out-of-range indices or a runtime value that is not\nan array produce a warning and leave the value unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.moveFieldValue('items', 0, 2)\n// items: ['second', 'third', 'first']\n```\n\n***\n\n### pushFieldValue\n\n```ts\npushFieldValue: PushFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:375](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L375)\n\nAppends an element to an array field.\n\nA runtime value that is not an array produces a warning and is left\nunchanged. By default, the update marks the array field as touched and\ndirty, notifies change listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second']\nformApi.pushFieldValue('items', 'new item')\n// items: ['first', 'second', 'new item']\n```\n\n***\n\n### removeFieldValue\n\n```ts\nremoveFieldValue: RemoveFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:429](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L429)\n\nRemoves an element from an array field.\n\nThe index must be between `0` and `array.length - 1`. An out-of-range index\nor a runtime value that is not an array produces a warning and leaves the\nvalue unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.removeFieldValue('items', 1)\n// items: ['first', 'third']\n```\n\n***\n\n### replaceFieldValue\n\n```ts\nreplaceFieldValue: ReplaceFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:448](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L448)\n\nReplaces the element at an index in an array field.\n\nThe index must be between `0` and `array.length - 1`. An out-of-range index\nor a runtime value that is not an array produces a warning and leaves the\nvalue unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.replaceFieldValue('items', 1, 'new item')\n// items: ['first', 'new item', 'third']\n```\n\n***\n\n### swapFieldValues\n\n```ts\nswapFieldValues: SwapFieldValuesFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:340](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L340)\n\nSwaps two elements in an array field.\n\nBoth indices must be between `0` and `array.length - 1`. Passing equal\nindices does nothing. Out-of-range indices or a runtime value that is not\nan array produce a warning and leave the value unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.swapFieldValues('items', 0, 2)\n// items: ['third', 'second', 'first']\n```\n","originalRawMarkdown":"---\nid: FormApiArrayMethods\ntitle: FormApiArrayMethods\n---\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:322](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L322)\n\nMethods for adding, removing, moving, and filtering array field elements.\n\n## Extended by\n\n- [`FormApi`](FormApi.md)\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### clearFieldValues\n\n```ts\nclearFieldValues: ClearFieldValuesFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:410](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L410)\n\nRemoves every element from an array field.\n\nA runtime value that is not an array produces a warning and is left\nunchanged. By default, the update marks the array field as touched and\ndirty, notifies change listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second']\nformApi.clearFieldValues('items')\n// items: []\n```\n\n***\n\n### filterFieldValues\n\n```ts\nfilterFieldValues: FilterFieldValuesFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:465](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L465)\n\nKeeps the elements that satisfy a predicate.\n\n`options.thisArg` sets the predicate's `this` value. A runtime value that is\nnot an array produces a warning and is left unchanged. By default, the\nupdate marks the array field as touched and dirty, notifies change\nlisteners, and runs change validation.\n\n#### Example\n\n```ts\n// items: [1, 2, 3, 4]\nformApi.filterFieldValues('items', (item) => item % 2 === 0)\n// items: [2, 4]\n```\n\n***\n\n### insertFieldValue\n\n```ts\ninsertFieldValue: InsertFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:394](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L394)\n\nInserts an element at an index in an array field.\n\nThe index must be between `0` and `array.length`; passing `array.length`\nappends the element. An out-of-range index or a runtime value that is not\nan array produces a warning and leaves the value unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second']\nformApi.insertFieldValue('items', 1, 'new item')\n// items: ['first', 'new item', 'second']\n```\n\n***\n\n### moveFieldValue\n\n```ts\nmoveFieldValue: MoveFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:359](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L359)\n\nMoves an element to another index in an array field.\n\nBoth indices must be between `0` and `array.length - 1`. Passing equal\nindices does nothing. Out-of-range indices or a runtime value that is not\nan array produce a warning and leave the value unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.moveFieldValue('items', 0, 2)\n// items: ['second', 'third', 'first']\n```\n\n***\n\n### pushFieldValue\n\n```ts\npushFieldValue: PushFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:375](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L375)\n\nAppends an element to an array field.\n\nA runtime value that is not an array produces a warning and is left\nunchanged. By default, the update marks the array field as touched and\ndirty, notifies change listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second']\nformApi.pushFieldValue('items', 'new item')\n// items: ['first', 'second', 'new item']\n```\n\n***\n\n### removeFieldValue\n\n```ts\nremoveFieldValue: RemoveFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:429](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L429)\n\nRemoves an element from an array field.\n\nThe index must be between `0` and `array.length - 1`. An out-of-range index\nor a runtime value that is not an array produces a warning and leaves the\nvalue unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.removeFieldValue('items', 1)\n// items: ['first', 'third']\n```\n\n***\n\n### replaceFieldValue\n\n```ts\nreplaceFieldValue: ReplaceFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:448](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L448)\n\nReplaces the element at an index in an array field.\n\nThe index must be between `0` and `array.length - 1`. An out-of-range index\nor a runtime value that is not an array produces a warning and leaves the\nvalue unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.replaceFieldValue('items', 1, 'new item')\n// items: ['first', 'new item', 'third']\n```\n\n***\n\n### swapFieldValues\n\n```ts\nswapFieldValues: SwapFieldValuesFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:340](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L340)\n\nSwaps two elements in an array field.\n\nBoth indices must be between `0` and `array.length - 1`. Passing equal\nindices does nothing. Out-of-range indices or a runtime value that is not\nan array produce a warning and leave the value unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n#### Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.swapFieldValues('items', 0, 2)\n// items: ['third', 'second', 'first']\n```\n"}
