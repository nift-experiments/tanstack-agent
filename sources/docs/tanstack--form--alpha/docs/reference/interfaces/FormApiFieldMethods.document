text","value":" for the path."}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const name = formApi.getFieldValue('profile.name')","lang":"ts"},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"The current value at the path, or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" when the path cannot\nbe resolved at runtime."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"resetfield","children":[{"type":"text","value":"resetField"}]},{"type":"code","value":"resetField: ResetFieldFn<TFormData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L131","children":[{"type":"text","value":"FormApi/FormApiFieldMethods.types.public.ts:131"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Restores a field path from "},{"type":"inlineCode","value":"defaultValues"},{"type":"text","value":" and resets state for its field\nsubtree."}]},{"type":"paragraph","children":[{"type":"text","value":"Existing "},{"type":"inlineCode","value":"FieldApi"},{"type":"text","value":" instances at or below the path remain mounted.\nForm-wide dirty history remains unchanged; use "},{"type":"inlineCode","value":"formApi.reset()"},{"type":"text","value":" to clear\nit."}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"formApi.setFieldValue('profile.name', 'Grace')\nformApi.resetField('profile.name')\n// `profile.name` is restored from `defaultValues`.","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setfieldvalue","children":[{"type":"text","value":"setFieldValue"}]},{"type":"code","value":"setFieldValue: SetFieldValueFn<TFormData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L99","children":[{"type":"text","value":"FormApi/FormApiFieldMethods.types.public.ts:99"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Updates the current value at a field path."}]},{"type":"paragraph","children":[{"type":"text","value":"The next value may be supplied directly or calculated from the current\nvalue. By default, the update marks the field as touched and dirty,\nnotifies change listeners, and runs change validation."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"formApi.setFieldValue('profile.name', 'Ada')\nformApi.setFieldValue('visitCount', (count) => count + 1)","lang":"ts"}],"headings":[{"id":"extended-by","text":"Extended by","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"getfieldvalue","text":"getFieldValue","level":3},{"id":"example","text":"Example","level":4},{"id":"returns","text":"Returns","level":4},{"id":"resetfield","text":"resetField","level":3},{"id":"example-2","text":"Example","level":4},{"id":"setfieldvalue","text":"setFieldValue","level":3},{"id":"example-3","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [FormApi/FormApiFieldMethods.types.public.ts:85](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L85)\n\nType-safe methods for reading, updating, and resetting individual field\nvalues.\n\n## Extended by\n\n- [`FormApi`](FormApi.md)\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### getFieldValue\n\n```ts\ngetFieldValue: GetFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiFieldMethods.types.public.ts:114](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L114)\n\nReads the current value at a field path.\n\nThis is a read-only operation and does not create a `FieldApi` for the path.\n\n#### Example\n\n```ts\nconst name = formApi.getFieldValue('profile.name')\n```\n\n#### Returns\n\nThe current value at the path, or `undefined` when the path cannot\nbe resolved at runtime.\n\n***\n\n### resetField\n\n```ts\nresetField: ResetFieldFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiFieldMethods.types.public.ts:131](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L131)\n\nRestores a field path from `defaultValues` and resets state for its field\nsubtree.\n\nExisting `FieldApi` instances at or below the path remain mounted.\nForm-wide dirty history remains unchanged; use `formApi.reset()` to clear\nit.\n\n#### Example\n\n```ts\nformApi.setFieldValue('profile.name', 'Grace')\nformApi.resetField('profile.name')\n// `profile.name` is restored from `defaultValues`.\n```\n\n***\n\n### setFieldValue\n\n```ts\nsetFieldValue: SetFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiFieldMethods.types.public.ts:99](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L99)\n\nUpdates the current value at a field path.\n\nThe next value may be supplied directly or calculated from the current\nvalue. By default, the update marks the field as touched and dirty,\nnotifies change listeners, and runs change validation.\n\n#### Example\n\n```ts\nformApi.setFieldValue('profile.name', 'Ada')\nformApi.setFieldValue('visitCount', (count) => count + 1)\n```\n","originalRawMarkdown":"---\nid: FormApiFieldMethods\ntitle: FormApiFieldMethods\n---\n\nDefined in: [FormApi/FormApiFieldMethods.types.public.ts:85](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L85)\n\nType-safe methods for reading, updating, and resetting individual field\nvalues.\n\n## Extended by\n\n- [`FormApi`](FormApi.md)\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### getFieldValue\n\n```ts\ngetFieldValue: GetFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiFieldMethods.types.public.ts:114](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L114)\n\nReads the current value at a field path.\n\nThis is a read-only operation and does not create a `FieldApi` for the path.\n\n#### Example\n\n```ts\nconst name = formApi.getFieldValue('profile.name')\n```\n\n#### Returns\n\nThe current value at the path, or `undefined` when the path cannot\nbe resolved at runtime.\n\n***\n\n### resetField\n\n```ts\nresetField: ResetFieldFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiFieldMethods.types.public.ts:131](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L131)\n\nRestores a field path from `defaultValues` and resets state for its field\nsubtree.\n\nExisting `FieldApi` instances at or below the path remain mounted.\nForm-wide dirty history remains unchanged; use `formApi.reset()` to clear\nit.\n\n#### Example\n\n```ts\nformApi.setFieldValue('profile.name', 'Grace')\nformApi.resetField('profile.name')\n// `profile.name` is restored from `defaultValues`.\n```\n\n***\n\n### setFieldValue\n\n```ts\nsetFieldValue: SetFieldValueFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApiFieldMethods.types.public.ts:99](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiFieldMethods.types.public.ts#L99)\n\nUpdates the current value at a field path.\n\nThe next value may be supplied directly or calculated from the current\nvalue. By default, the update marks the field as touched and dirty,\nnotifies change listeners, and runs change validation.\n\n#### Example\n\n```ts\nformApi.setFieldValue('profile.name', 'Ada')\nformApi.setFieldValue('visitCount', (count) => count + 1)\n```\n"}
