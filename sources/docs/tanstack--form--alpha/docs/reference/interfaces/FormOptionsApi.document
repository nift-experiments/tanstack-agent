heading","depth":2,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tformdata","children":[{"type":"text","value":"TFormData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFormData"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":3,"id":"tformvalidators","children":[{"type":"text","value":"TFormValidators"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFormValidators"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/FormValidators.md","children":[{"type":"inlineCode","value":"FormValidators"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":3,"id":"tsubmitreturn","children":[{"type":"text","value":"TSubmitReturn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSubmitReturn"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"FormOptions.md","children":[{"type":"inlineCode","value":"FormOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFormValidators"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSubmitReturn"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"tex