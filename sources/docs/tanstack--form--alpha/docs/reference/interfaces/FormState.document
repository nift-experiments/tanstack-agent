","children":[{"type":"text","value":"Equivalent to "},{"type":"inlineCode","value":"!isPristine"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"isDefaultValue"},{"type":"text","value":" to check whether current values match their defaults."}]}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isinvalid","children":[{"type":"text","value":"isInvalid"}]},{"type":"code","value":"isInvalid: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L488","children":[{"type":"text","value":"FormApi/FormApi.public.ts:488"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether validation state contains at least one form- or field-level error."}]},{"type":"paragraph","children":[{"type":"text","value":"This is the exact inverse of "},{"type":"inlineCode","value":"isValid"},{"type":"text","value":". Field "},{"type":"inlineCode","value":"errorVisibility"},{"type":"text","value":" does not\naffect it."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Equivalent to "},{"type":"inlineCode","value":"!isValid"},{"type":"text","value":"."}]}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"ispristine","children":[{"type":"text","value":"isPristine"}]},{"type":"code","value":"isPristine: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L456","children":[{"type":"text","value":"FormApi/FormApi.public.ts:456"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether state has not been marked dirty."}]},{"type":"paragraph","children":[{"type":"text","value":"This records whether a dirty-marking update has occurred, not whether\ncurrent values match their defaults. Once "},{"type":"inlineCode","value":"false"},{"type":"text","value":", it remains "},{"type":"inlineCode","value":"false"},{"type":"text","value":" even\nif values return to their defaults. "},{"type":"inlineCode","value":"formApi.reset()"},{"type":"text","value":" restores it."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Equivalent to "},{"type":"inlineCode","value":"!isDirty"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"isDefaultValue"},{"type":"text","value":" to check whether current values match their defaults."}]}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"issubmitsuccessful","children":[{"type":"text","value":"isSubmitSuccessful"}]},{"type":"code","value":"isSubmitSuccessful: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L513","children":[{"type":"text","value":"FormApi/FormApi.public.ts:513"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether the latest completed submission finished without validation errors\nor an "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":" failure."}]},{"type":"paragraph","children":[{"type":"text","value":"It starts as "},{"type":"inlineCode","value":"false"},{"type":"text","value":", updates when an attempt finishes, and is cleared by\n"},{"type":"inlineCode","value":"formApi.reset()"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"issubmitting","children":[{"type":"text","value":"isSubmitting"}]},{"type":"code","value":"isSubmitting: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L505","children":[{"type":"text","value":"FormApi/FormApi.public.ts:505"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether a submission attempt is in progress."}]},{"type":"paragraph","children":[{"type":"text","value":"This includes submission validation and the time spent awaiting "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":"\nor "},{"type":"inlineCode","value":"onSubmitInvalid"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"istouched","children":[{"type":"text","value":"isTouched"}]},{"type":"code","value":"isTouched: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L434","children":[{"type":"text","value":"FormApi/FormApi.public.ts:434"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether at least one field is currently touched."}]},{"type":"paragraph","children":[{"type":"text","value":"Field changes mark fields as touched by default, and submission marks all\nregistered fields as touched. Resets clear the touched state."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isvalid","children":[{"type":"text","value":"isValid"}]},{"type":"code","value":"isValid: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L479","children":[{"type":"text","value":"FormApi/FormApi.public.ts:479"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether validation state contains no form- or field-level errors."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Equivalent to "},{"type":"inlineCode","value":"!isInvalid"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A field error hidden by "},{"type":"inlineCode","value":"errorVisibility"},{"type":"text","value":" still makes this "},{"type":"inlineCode","value":"false"},{"type":"text","value":"."}]}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isvalidating","children":[{"type":"text","value":"isValidating"}]},{"type":"code","value":"isValidating: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L520","children":[{"type":"text","value":"FormApi/FormApi.public.ts:520"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether any form-, group-, or field-level validation is pending."}]},{"type":"paragraph","children":[{"type":"text","value":"It remains "},{"type":"inlineCode","value":"true"},{"type":"text","value":" until all concurrent validation work finishes or is\ncanceled. Pending validation does not by itself make "},{"type":"inlineCode","value":"canSubmit"},{"type":"text","value":" "},{"type":"inlineCode","value":"false"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"submissionattempts","children":[{"type":"text","value":"submissionAttempts"}]},{"type":"code","value":"submissionAttempts: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L527","children":[{"type":"text","value":"FormApi/FormApi.public.ts:527"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Number of submission attempts started since the last reset."}]},{"type":"paragraph","children":[{"type":"text","value":"An attempt is counted before validation begins, whether it succeeds or\nfails. "},{"type":"inlineCode","value":"formApi.reset()"},{"type":"text","value":" returns the count to "},{"type":"inlineCode","value":"0"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"values","children":[{"type":"text","value":"values"}]},{"type":"code","value":"values: TFormData;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L427","children":[{"type":"text","value":"FormApi/FormApi.public.ts:427"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Current values after field edits, resets, or default-value updates."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"tformerrortypes","text":"TFormErrorTypes","level":3},{"id":"properties","text":"Properties","level":2},{"id":"cansubmit","text":"canSubmit","level":3},{"id":"errors","text":"errors","level":3},{"id":"isdefaultvalue","text":"isDefaultValue","level":3},{"id":"isdirty","text":"isDirty","level":3},{"id":"isinvalid","text":"isInvalid","level":3},{"id":"ispristine","text":"isPristine","level":3},{"id":"issubmitsuccessful","text":"isSubmitSuccessful","level":3},{"id":"issubmitting","text":"isSubmitting","level":3},{"id":"istouched","text":"isTouched","level":3},{"id":"isvalid","text":"isValid","level":3},{"id":"isvalidating","text":"isValidating","level":3},{"id":"submissionattempts","text":"submissionAttempts","level":3},{"id":"values","text":"values","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [FormApi/FormApi.public.ts:420](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L420)\n\nA snapshot of current values, validation status, and submission metadata.\n\nRead the latest snapshot from `formApi.state` or subscribe to\n`formApi.atom`.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormErrorTypes\n\n`TFormErrorTypes` *extends* [`FormErrorTypes`](FormErrorTypes.md)\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### canSubmit\n\n```ts\ncanSubmit: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:498](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L498)\n\nWhether no submission is running and validation state has no known errors.\n\nThis is optimistic: validation does not need to have run, and pending\nvalidation alone does not make it `false`. `handleSubmit()` still runs\nsubmission validation.\n\n* Equivalent to `isValid && !isSubmitting`.\n\n***\n\n### errors\n\n```ts\nerrors: FormErrors<TFormErrorTypes>;\n```\n\nDefined in: [FormApi/FormApi.public.ts:472](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L472)\n\nForm-level errors from validators and `onSubmit`.\n\nErrors are flattened in validator order, with `onSubmit` errors last.\nErrors routed to fields are exposed through the corresponding field APIs\nand are not included here.\n\n***\n\n### isDefaultValue\n\n```ts\nisDefaultValue: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:464](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L464)\n\nWhether current values deeply match `formApi.defaultValues`.\n\nUnlike `isDirty` and `isPristine`, this compares current values with their\ndefaults rather than tracking whether edits have occurred. Reverting an\nedit can make it `true` while `isDirty` remains `true`.\n\n***\n\n### isDirty\n\n```ts\nisDirty: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:445](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L445)\n\nWhether a value update has marked state as dirty.\n\nThis records whether a dirty-marking update has occurred, not whether\ncurrent values match their defaults. Once `true`, it remains `true` even if\nvalues return to their defaults. `formApi.reset()` clears it.\n\n* Equivalent to `!isPristine`.\n* Use `isDefaultValue` to check whether current values match their defaults.\n\n***\n\n### isInvalid\n\n```ts\nisInvalid: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:488](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L488)\n\nWhether validation state contains at least one form- or field-level error.\n\nThis is the exact inverse of `isValid`. Field `errorVisibility` does not\naffect it.\n\n* Equivalent to `!isValid`.\n\n***\n\n### isPristine\n\n```ts\nisPristine: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:456](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L456)\n\nWhether state has not been marked dirty.\n\nThis records whether a dirty-marking update has occurred, not whether\ncurrent values match their defaults. Once `false`, it remains `false` even\nif values return to their defaults. `formApi.reset()` restores it.\n\n* Equivalent to `!isDirty`.\n* Use `isDefaultValue` to check whether current values match their defaults.\n\n***\n\n### isSubmitSuccessful\n\n```ts\nisSubmitSuccessful: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:513](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L513)\n\nWhether the latest completed submission finished without validation errors\nor an `onSubmit` failure.\n\nIt starts as `false`, updates when an attempt finishes, and is cleared by\n`formApi.reset()`.\n\n***\n\n### isSubmitting\n\n```ts\nisSubmitting: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:505](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L505)\n\nWhether a submission attempt is in progress.\n\nThis includes submission validation and the time spent awaiting `onSubmit`\nor `onSubmitInvalid`.\n\n***\n\n### isTouched\n\n```ts\nisTouched: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:434](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L434)\n\nWhether at least one field is currently touched.\n\nField changes mark fields as touched by default, and submission marks all\nregistered fields as touched. Resets clear the touched state.\n\n***\n\n### isValid\n\n```ts\nisValid: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:479](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L479)\n\nWhether validation state contains no form- or field-level errors.\n\n* Equivalent to `!isInvalid`.\n* A field error hidden by `errorVisibility` still makes this `false`.\n\n***\n\n### isValidating\n\n```ts\nisValidating: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:520](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L520)\n\nWhether any form-, group-, or field-level validation is pending.\n\nIt remains `true` until all concurrent validation work finishes or is\ncanceled. Pending validation does not by itself make `canSubmit` `false`.\n\n***\n\n### submissionAttempts\n\n```ts\nsubmissionAttempts: number;\n```\n\nDefined in: [FormApi/FormApi.public.ts:527](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L527)\n\nNumber of submission attempts started since the last reset.\n\nAn attempt is counted before validation begins, whether it succeeds or\nfails. `formApi.reset()` returns the count to `0`.\n\n***\n\n### values\n\n```ts\nvalues: TFormData;\n```\n\nDefined in: [FormApi/FormApi.public.ts:427](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L427)\n\nCurrent values after field edits, resets, or default-value updates.\n","originalRawMarkdown":"---\nid: FormState\ntitle: FormState\n---\n\nDefined in: [FormApi/FormApi.public.ts:420](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L420)\n\nA snapshot of current values, validation status, and submission metadata.\n\nRead the latest snapshot from `formApi.state` or subscribe to\n`formApi.atom`.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormErrorTypes\n\n`TFormErrorTypes` *extends* [`FormErrorTypes`](FormErrorTypes.md)\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### canSubmit\n\n```ts\ncanSubmit: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:498](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L498)\n\nWhether no submission is running and validation state has no known errors.\n\nThis is optimistic: validation does not need to have run, and pending\nvalidation alone does not make it `false`. `handleSubmit()` still runs\nsubmission validation.\n\n* Equivalent to `isValid && !isSubmitting`.\n\n***\n\n### errors\n\n```ts\nerrors: FormErrors<TFormErrorTypes>;\n```\n\nDefined in: [FormApi/FormApi.public.ts:472](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L472)\n\nForm-level errors from validators and `onSubmit`.\n\nErrors are flattened in validator order, with `onSubmit` errors last.\nErrors routed to fields are exposed through the corresponding field APIs\nand are not included here.\n\n***\n\n### isDefaultValue\n\n```ts\nisDefaultValue: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:464](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L464)\n\nWhether current values deeply match `formApi.defaultValues`.\n\nUnlike `isDirty` and `isPristine`, this compares current values with their\ndefaults rather than tracking whether edits have occurred. Reverting an\nedit can make it `true` while `isDirty` remains `true`.\n\n***\n\n### isDirty\n\n```ts\nisDirty: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:445](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L445)\n\nWhether a value update has marked state as dirty.\n\nThis records whether a dirty-marking update has occurred, not whether\ncurrent values match their defaults. Once `true`, it remains `true` even if\nvalues return to their defaults. `formApi.reset()` clears it.\n\n* Equivalent to `!isPristine`.\n* Use `isDefaultValue` to check whether current values match their defaults.\n\n***\n\n### isInvalid\n\n```ts\nisInvalid: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:488](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L488)\n\nWhether validation state contains at least one form- or field-level error.\n\nThis is the exact inverse of `isValid`. Field `errorVisibility` does not\naffect it.\n\n* Equivalent to `!isValid`.\n\n***\n\n### isPristine\n\n```ts\nisPristine: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:456](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L456)\n\nWhether state has not been marked dirty.\n\nThis records whether a dirty-marking update has occurred, not whether\ncurrent values match their defaults. Once `false`, it remains `false` even\nif values return to their defaults. `formApi.reset()` restores it.\n\n* Equivalent to `!isDirty`.\n* Use `isDefaultValue` to check whether current values match their defaults.\n\n***\n\n### isSubmitSuccessful\n\n```ts\nisSubmitSuccessful: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:513](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L513)\n\nWhether the latest completed submission finished without validation errors\nor an `onSubmit` failure.\n\nIt starts as `false`, updates when an attempt finishes, and is cleared by\n`formApi.reset()`.\n\n***\n\n### isSubmitting\n\n```ts\nisSubmitting: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:505](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L505)\n\nWhether a submission attempt is in progress.\n\nThis includes submission validation and the time spent awaiting `onSubmit`\nor `onSubmitInvalid`.\n\n***\n\n### isTouched\n\n```ts\nisTouched: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:434](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L434)\n\nWhether at least one field is currently touched.\n\nField changes mark fields as touched by default, and submission marks all\nregistered fields as touched. Resets clear the touched state.\n\n***\n\n### isValid\n\n```ts\nisValid: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:479](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L479)\n\nWhether validation state contains no form- or field-level errors.\n\n* Equivalent to `!isInvalid`.\n* A field error hidden by `errorVisibility` still makes this `false`.\n\n***\n\n### isValidating\n\n```ts\nisValidating: boolean;\n```\n\nDefined in: [FormApi/FormApi.public.ts:520](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L520)\n\nWhether any form-, group-, or field-level validation is pending.\n\nIt remains `true` until all concurrent validation work finishes or is\ncanceled. Pending validation does not by itself make `canSubmit` `false`.\n\n***\n\n### submissionAttempts\n\n```ts\nsubmissionAttempts: number;\n```\n\nDefined in: [FormApi/FormApi.public.ts:527](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L527)\n\nNumber of submission attempts started since the last reset.\n\nAn attempt is counted before validation begins, whether it succeeds or\nfails. `formApi.reset()` returns the count to `0`.\n\n***\n\n### values\n\n```ts\nvalues: TFormData;\n```\n\nDefined in: [FormApi/FormApi.public.ts:427](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L427)\n\nCurrent values after field edits, resets, or default-value updates.\n"}
