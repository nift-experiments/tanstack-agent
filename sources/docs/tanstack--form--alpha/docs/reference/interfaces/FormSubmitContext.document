icitly."}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"createvalidationerror","children":[{"type":"text","value":"createValidationError"}]},{"type":"code","value":"createValidationError: CreateValidationErrorFn<TFormData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L149","children":[{"type":"text","value":"FormApi/FormApi.public.ts:149"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a validation error that can be returned from "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Return the created error from "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":" to add its form- and field-level\nerrors to validation state."}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"{\n  // ...\n  onSubmit: async ({ value, createValidationError }) => {\n    const result = await saveUser(value)\n\n    if (result.status === 409) {\n      return createValidationError({\n        form: 'A user with this email already exists',\n        fields: {},\n      })\n    }\n  },\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"formapi","children":[{"type":"text","value":"formApi"}]},{"type":"code","value":"formApi: FormApi<TFormData, TFormErrorTypes>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L109","children":[{"type":"text","value":"FormApi/FormApi.public.ts:109"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The form API handling this submission."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"parseissues","children":[{"type":"text","value":"parseIssues"}]},{"type":"code","value":"parseIssues: ParseSubmitIssuesFn<TFormData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L170","children":[{"type":"text","value":"FormApi/FormApi.public.ts:170"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Parses Standard Schema issues into an error returnable from "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Issue paths are mapped to fields in the submitted value. Return the parsed\nerror from "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":" to add those errors to validation state."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"{\n  // ...\n  onSubmit: async ({ value, parseIssues }) => {\n    const result = zodSchema.safeParse(value)\n\n    if (!result.success) {\n      return parseIssues(result.error.issues)\n    }\n  },\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"schemaoutputs","children":[{"type":"text","value":"schemaOutputs"}]},{"type":"code","value":"schemaOutputs: TSchemaOutputs;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L125","children":[{"type":"text","value":"FormApi/FormApi.public.ts:125"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The submit outputs produced by the form's schema validators, ordered by\nvalidator index."}]},{"type":"heading","depth":4,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"{\n  // ...\n  onSubmit: async ({ schemaOutputs }) => {\n    const validatedUser = schemaOutputs[0]\n    await saveUser(validatedUser)\n  },\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"code","value":"value: TFormData;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L107","children":[{"type":"text","value":"FormApi/FormApi.public.ts:107"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The form values for this submission."}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"tschemaoutputs","text":"TSchemaOutputs","level":3},{"id":"tformerrortypes","text":"TFormErrorTypes","level":3},{"id":"properties","text":"Properties","level":2},{"id":"createvalidationerror","text":"createValidationError","level":3},{"id":"example-2","text":"Example","level":4},{"id":"formapi","text":"formApi","level":3},{"id":"parseissues","text":"parseIssues","level":3},{"id":"example-3","text":"Example","level":4},{"id":"schemaoutputs","text":"schemaOutputs","level":3},{"id":"example-4","text":"Example","level":4},{"id":"value","text":"value","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [FormApi/FormApi.public.ts:101](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L101)\n\nContext passed to `onSubmit` after submission validation succeeds.\n\n## Example\n\n```ts\n{\n  // ...\n  onSubmit: async ({ value, createValidationError }) => {\n    const result = await saveUser(value)\n\n    if (!result.ok) {\n      return createValidationError(result.error)\n    }\n  },\n}\n```\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n### TSchemaOutputs\n\n`TSchemaOutputs`\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormErrorTypes\n\n`TFormErrorTypes` *extends* [`FormErrorTypes`](FormErrorTypes.md)\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### createValidationError\n\n```ts\ncreateValidationError: CreateValidationErrorFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApi.public.ts:149](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L149)\n\nCreates a validation error that can be returned from `onSubmit`.\n\nReturn the created error from `onSubmit` to add its form- and field-level\nerrors to validation state.\n\n#### Example\n\n```ts\n{\n  // ...\n  onSubmit: async ({ value, createValidationError }) => {\n    const result = await saveUser(value)\n\n    if (result.status === 409) {\n      return createValidationError({\n        form: 'A user with this email already exists',\n        fields: {},\n      })\n    }\n  },\n}\n```\n\n***\n\n### formApi\n\n```ts\nformApi: FormApi<TFormData, TFormErrorTypes>;\n```\n\nDefined in: [FormApi/FormApi.public.ts:109](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L109)\n\nThe form API handling this submission.\n\n***\n\n### parseIssues\n\n```ts\nparseIssues: ParseSubmitIssuesFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApi.public.ts:170](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L170)\n\nParses Standard Schema issues into an error returnable from `onSubmit`.\n\nIssue paths are mapped to fields in the submitted value. Return the parsed\nerror from `onSubmit` to add those errors to validation state.\n\n#### Example\n\n```ts\n{\n  // ...\n  onSubmit: async ({ value, parseIssues }) => {\n    const result = zodSchema.safeParse(value)\n\n    if (!result.success) {\n      return parseIssues(result.error.issues)\n    }\n  },\n}\n```\n\n***\n\n### schemaOutputs\n\n```ts\nschemaOutputs: TSchemaOutputs;\n```\n\nDefined in: [FormApi/FormApi.public.ts:125](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L125)\n\nThe submit outputs produced by the form's schema validators, ordered by\nvalidator index.\n\n#### Example\n\n```ts\n{\n  // ...\n  onSubmit: async ({ schemaOutputs }) => {\n    const validatedUser = schemaOutputs[0]\n    await saveUser(validatedUser)\n  },\n}\n```\n\n***\n\n### value\n\n```ts\nvalue: TFormData;\n```\n\nDefined in: [FormApi/FormApi.public.ts:107](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L107)\n\nThe form values for this submission.\n","originalRawMarkdown":"---\nid: FormSubmitContext\ntitle: FormSubmitContext\n---\n\nDefined in: [FormApi/FormApi.public.ts:101](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L101)\n\nContext passed to `onSubmit` after submission validation succeeds.\n\n## Example\n\n```ts\n{\n  // ...\n  onSubmit: async ({ value, createValidationError }) => {\n    const result = await saveUser(value)\n\n    if (!result.ok) {\n      return createValidationError(result.error)\n    }\n  },\n}\n```\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n### TSchemaOutputs\n\n`TSchemaOutputs`\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormErrorTypes\n\n`TFormErrorTypes` *extends* [`FormErrorTypes`](FormErrorTypes.md)\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### createValidationError\n\n```ts\ncreateValidationError: CreateValidationErrorFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApi.public.ts:149](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L149)\n\nCreates a validation error that can be returned from `onSubmit`.\n\nReturn the created error from `onSubmit` to add its form- and field-level\nerrors to validation state.\n\n#### Example\n\n```ts\n{\n  // ...\n  onSubmit: async ({ value, createValidationError }) => {\n    const result = await saveUser(value)\n\n    if (result.status === 409) {\n      return createValidationError({\n        form: 'A user with this email already exists',\n        fields: {},\n      })\n    }\n  },\n}\n```\n\n***\n\n### formApi\n\n```ts\nformApi: FormApi<TFormData, TFormErrorTypes>;\n```\n\nDefined in: [FormApi/FormApi.public.ts:109](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L109)\n\nThe form API handling this submission.\n\n***\n\n### parseIssues\n\n```ts\nparseIssues: ParseSubmitIssuesFn<TFormData>;\n```\n\nDefined in: [FormApi/FormApi.public.ts:170](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L170)\n\nParses Standard Schema issues into an error returnable from `onSubmit`.\n\nIssue paths are mapped to fields in the submitted value. Return the parsed\nerror from `onSubmit` to add those errors to validation state.\n\n#### Example\n\n```ts\n{\n  // ...\n  onSubmit: async ({ value, parseIssues }) => {\n    const result = zodSchema.safeParse(value)\n\n    if (!result.success) {\n      return parseIssues(result.error.issues)\n    }\n  },\n}\n```\n\n***\n\n### schemaOutputs\n\n```ts\nschemaOutputs: TSchemaOutputs;\n```\n\nDefined in: [FormApi/FormApi.public.ts:125](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L125)\n\nThe submit outputs produced by the form's schema validators, ordered by\nvalidator index.\n\n#### Example\n\n```ts\n{\n  // ...\n  onSubmit: async ({ schemaOutputs }) => {\n    const validatedUser = schemaOutputs[0]\n    await saveUser(validatedUser)\n  },\n}\n```\n\n***\n\n### value\n\n```ts\nvalue: TFormData;\n```\n\nDefined in: [FormApi/FormApi.public.ts:107](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApi.public.ts#L107)\n\nThe form values for this submission.\n"}
