s.public.ts#L86","children":[{"type":"text","value":"listeners.public.ts:86"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The event to match before evaluating "},{"type":"inlineCode","value":"when"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"when","children":[{"type":"text","value":"when?"}]},{"type":"code","value":"optional when?: \n  | boolean\n| ListenerPredicateFn<TFormData, TValue>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/listeners.public.ts#L99","children":[{"type":"text","value":"listeners.public.ts:99"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether the listener is enabled when "},{"type":"inlineCode","value":"trigger"},{"type":"text","value":" occurs."}]},{"type":"paragraph","children":[{"type":"text","value":"A function receives the current listener context."}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"when: ({ formApi }) => formApi.state.isDirty,","lang":"ts"},{"type":"heading","depth":4,"id":"default","children":[{"type":"text","value":"Default"}]},{"type":"code","value":"true","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"ttriggers","text":"TTriggers","level":3},{"id":"tformdata","text":"TFormData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"properties","text":"Properties","level":2},{"id":"trigger","text":"trigger","level":3},{"id":"when","text":"when?","level":3},{"id":"example","text":"Example","level":4},{"id":"default","text":"Default","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [listeners.public.ts:80](https://github.com/TanStack/form/blob/main/packages/form-core/src/listeners.public.ts#L80)\n\nConfigures a listener trigger with an optional condition.\n\n## Type Parameters\n\n### TTriggers\n\n`TTriggers` *extends* [`FieldListenerTriggers`](../type-aliases/FieldListenerTriggers.md)\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n### TValue\n\n`TValue`\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### trigger\n\n```ts\ntrigger: TTriggers;\n```\n\nDefined in: [listeners.public.ts:86](https://github.com/TanStack/form/blob/main/packages/form-core/src/listeners.public.ts#L86)\n\nThe event to match before evaluating `when`.\n\n***\n\n### when?\n\n```ts\noptional when?: \n  | boolean\n| ListenerPredicateFn<TFormData, TValue>;\n```\n\nDefined in: [listeners.public.ts:99](https://github.com/TanStack/form/blob/main/packages/form-core/src/listeners.public.ts#L99)\n\nWhether the listener is enabled when `trigger` occurs.\n\nA function receives the current listener context.\n\n#### Example\n\n```ts\nwhen: ({ formApi }) => formApi.state.isDirty,\n```\n\n#### Default\n\n```ts\ntrue\n```\n","originalRawMarkdown":"---\nid: ListenerTriggerConfig\ntitle: ListenerTriggerConfig\n---\n\nDefined in: [listeners.public.ts:80](https://github.com/TanStack/form/blob/main/packages/form-core/src/listeners.public.ts#L80)\n\nConfigures a listener trigger with an optional condition.\n\n## Type Parameters\n\n### TTriggers\n\n`TTriggers` *extends* [`FieldListenerTriggers`](../type-aliases/FieldListenerTriggers.md)\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n### TValue\n\n`TValue`\n\nLibrary-managed. Do not specify explicitly.\n\n## Properties\n\n### trigger\n\n```ts\ntrigger: TTriggers;\n```\n\nDefined in: [listeners.public.ts:86](https://github.com/TanStack/form/blob/main/packages/form-core/src/listeners.public.ts#L86)\n\nThe event to match before evaluating `when`.\n\n***\n\n### when?\n\n```ts\noptional when?: \n  | boolean\n| ListenerPredicateFn<TFormData, TValue>;\n```\n\nDefined in: [listeners.public.ts:99](https://github.com/TanStack/form/blob/main/packages/form-core/src/listeners.public.ts#L99)\n\nWhether the listener is enabled when `trigger` occurs.\n\nA function receives the current listener context.\n\n#### Example\n\n```ts\nwhen: ({ formApi }) => formApi.state.isDirty,\n```\n\n#### Default\n\n```ts\ntrue\n```\n"}
