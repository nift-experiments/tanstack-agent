","value":"Parameters"}]},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"link","href":"ArrayFieldElement.md","children":[{"type":"inlineCode","value":"ArrayFieldElement"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFieldName"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The current element."}]},{"type":"heading","depth":3,"id":"index","children":[{"type":"text","value":"index"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"The element's index in the original array."}]},{"type":"heading","depth":3,"id":"array","children":[{"type":"text","value":"array"}]},{"type":"paragraph","children":[{"type":"link","href":"ArrayFieldValue.md","children":[{"type":"inlineCode","value":"ArrayFieldValue"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFieldName"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The array being filtered."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// items: [1, 2, 3, 4]\nformApi.filterFieldValues('items', (item) => item % 2 === 0)\n// items: [2, 4]","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"tfieldname","text":"TFieldName","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"value","text":"value","level":3},{"id":"index","text":"index","level":3},{"id":"array","text":"array","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype ArrayFieldPredicate<TFormData, TFieldName> = (value, index, array) => boolean;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:65](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L65)\n\nSelects which elements `filterFieldValues` keeps.\n\nReturn `true` to keep an element or `false` to remove it. The callback\nreceives the element's original index and the array before filtering.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n### TFieldName\n\n`TFieldName` *extends* [`ArrayFieldName`](ArrayFieldName.md)\\<`TFormData`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### value\n\n[`ArrayFieldElement`](ArrayFieldElement.md)\\<`TFormData`, `TFieldName`\\>\n\nThe current element.\n\n### index\n\n`number`\n\nThe element's index in the original array.\n\n### array\n\n[`ArrayFieldValue`](ArrayFieldValue.md)\\<`TFormData`, `TFieldName`\\>\n\nThe array being filtered.\n\n## Returns\n\n`boolean`\n\n## Example\n\n```ts\n// items: [1, 2, 3, 4]\nformApi.filterFieldValues('items', (item) => item % 2 === 0)\n// items: [2, 4]\n```\n","originalRawMarkdown":"---\nid: ArrayFieldPredicate\ntitle: ArrayFieldPredicate\n---\n\n```ts\ntype ArrayFieldPredicate<TFormData, TFieldName> = (value, index, array) => boolean;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:65](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L65)\n\nSelects which elements `filterFieldValues` keeps.\n\nReturn `true` to keep an element or `false` to remove it. The callback\nreceives the element's original index and the array before filtering.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n### TFieldName\n\n`TFieldName` *extends* [`ArrayFieldName`](ArrayFieldName.md)\\<`TFormData`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### value\n\n[`ArrayFieldElement`](ArrayFieldElement.md)\\<`TFormData`, `TFieldName`\\>\n\nThe current element.\n\n### index\n\n`number`\n\nThe element's index in the original array.\n\n### array\n\n[`ArrayFieldValue`](ArrayFieldValue.md)\\<`TFormData`, `TFieldName`\\>\n\nThe array being filtered.\n\n## Returns\n\n`boolean`\n\n## Example\n\n```ts\n// items: [1, 2, 3, 4]\nformApi.filterFieldValues('items', (item) => item % 2 === 0)\n// items: [2, 4]\n```\n"}
