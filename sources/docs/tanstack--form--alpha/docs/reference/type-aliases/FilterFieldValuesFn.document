:"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"arrayfieldname","children":[{"type":"text","value":"arrayFieldName"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFieldName"}]},{"type":"paragraph","children":[{"type":"text","value":"The array field path."}]},{"type":"heading","depth":3,"id":"predicate","children":[{"type":"text","value":"predicate"}]},{"type":"paragraph","children":[{"type":"link","href":"ArrayFieldPredicate.md","children":[{"type":"inlineCode","value":"ArrayFieldPredicate"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFieldName"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Called with each element, its original index, and the\narray. Return "},{"type":"inlineCode","value":"true"},{"type":"text","value":" to keep the element."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/FieldUpdateOptions.md","children":[{"type":"inlineCode","value":"FieldUpdateOptions"}]},{"type":"text","value":" & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"Controls metadata updates and validation. "},{"type":"inlineCode","value":"thisArg"},{"type":"text","value":" sets the\npredicate's "},{"type":"inlineCode","value":"this"},{"type":"text","value":" value."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// items: [1, 2, 3, 4]\nformApi.filterFieldValues('items', (item) => item % 2 === 0)\n// items: [2, 4]","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":2},{"id":"tfieldname","text":"TFieldName","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"arrayfieldname","text":"arrayFieldName","level":3},{"id":"predicate","text":"predicate","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype FilterFieldValuesFn<TFormData> = <TFieldName>(arrayFieldName, predicate, options?) => void;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:309](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L309)\n\nKeeps the elements that satisfy a predicate.\n\nA runtime value that is not an array produces a warning and is left\nunchanged. By default, the update marks the array field as touched and\ndirty, notifies change listeners, and runs change validation.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TFieldName\n\n`TFieldName` *extends* [`ArrayFieldName`](ArrayFieldName.md)\\<`TFormData`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### arrayFieldName\n\n`TFieldName`\n\nThe array field path.\n\n### predicate\n\n[`ArrayFieldPredicate`](ArrayFieldPredicate.md)\\<`TFormData`, `TFieldName`\\>\n\nCalled with each element, its original index, and the\narray. Return `true` to keep the element.\n\n### options?\n\n[`FieldUpdateOptions`](../interfaces/FieldUpdateOptions.md) & `object`\n\nControls metadata updates and validation. `thisArg` sets the\npredicate's `this` value.\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\n// items: [1, 2, 3, 4]\nformApi.filterFieldValues('items', (item) => item % 2 === 0)\n// items: [2, 4]\n```\n","originalRawMarkdown":"---\nid: FilterFieldValuesFn\ntitle: FilterFieldValuesFn\n---\n\n```ts\ntype FilterFieldValuesFn<TFormData> = <TFieldName>(arrayFieldName, predicate, options?) => void;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:309](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L309)\n\nKeeps the elements that satisfy a predicate.\n\nA runtime value that is not an array produces a warning and is left\nunchanged. By default, the update marks the array field as touched and\ndirty, notifies change listeners, and runs change validation.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TFieldName\n\n`TFieldName` *extends* [`ArrayFieldName`](ArrayFieldName.md)\\<`TFormData`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### arrayFieldName\n\n`TFieldName`\n\nThe array field path.\n\n### predicate\n\n[`ArrayFieldPredicate`](ArrayFieldPredicate.md)\\<`TFormData`, `TFieldName`\\>\n\nCalled with each element, its original index, and the\narray. Return `true` to keep the element.\n\n### options?\n\n[`FieldUpdateOptions`](../interfaces/FieldUpdateOptions.md) & `object`\n\nControls metadata updates and validation. `thisArg` sets the\npredicate's `this` value.\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\n// items: [1, 2, 3, 4]\nformApi.filterFieldValues('items', (item) => item % 2 === 0)\n// items: [2, 4]\n```\n"}
