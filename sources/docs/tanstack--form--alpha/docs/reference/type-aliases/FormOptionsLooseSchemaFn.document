pecify explicitly."}]},{"type":"heading","depth":2,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tschema","children":[{"type":"text","value":"TSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"StandardSchemaV1.md","children":[{"type":"inlineCode","value":"StandardSchemaV1"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":3,"id":"tformdata","children":[{"type":"text","value":"TFormData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFormData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"Editable.md","children":[{"type":"inlineCode","value":"Editable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"StandardSchemaInput"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":3,"id":"tformvalidators","children":[{"type":"text","value":"TFormValidators"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFormValidators"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"FormValidators.md","children":[{"type":"inlineCode","value":"FormValidators"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"NoInfer"},{"type":"text","value":"<"},{"type":"link","href":"InferUnion.md","children":[{"type":"inlineCode","value":"InferUnion"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":", "},{"type":"inlineCode","value":"StandardSchemaInput"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">>>>"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":3,"id":"tsubmitreturn","children":[{"type":"text","value":"TSubmitReturn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSubmitReturn"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"schema","children":[{"type":"text","value":"schema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"}]},{"type":"paragraph","children":[{"type":"text","value":"Supplies the final valid form shape without registering a\nvalidator."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"LooseSchemaFormOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"StandardSchemaInput"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFormValidators"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSubmitReturn"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The form options used to infer the editable form shape."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/FormOptions.md","children":[{"type":"inlineCode","value":"FormOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"InferUnion.md","children":[{"type":"inlineCode","value":"InferUnion"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":", "},{"type":"inlineCode","value":"StandardSchemaInput"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">>, "},{"type":"inlineCode","value":"TFormValidators"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSubmitReturn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TComponents"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The original options object, normalized to "},{"type":"inlineCode","value":"FormOptions"},{"type":"text","value":" with the\neditable states merged into the schema input."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const bookingSchema = z.object({ startDate: z.date() })\nconst bookingOptions = formOptions.looseSchema(bookingSchema, {\n  defaultValues: { startDate: null },\n  validators: [\n    { triggers: ['blur'], run: bookingSchema },\n    {\n      triggers: ['change'],\n      run: ({ value }) =>\n        value.startDate === null ? 'Choose a date' : undefined,\n    },\n  ],\n})","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tcomponents","text":"TComponents","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":2},{"id":"tschema","text":"TSchema","level":3},{"id":"tformdata","text":"TFormData","level":3},{"id":"tformvalidators","text":"TFormValidators","level":3},{"id":"tsubmitreturn","text":"TSubmitReturn","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"schema","text":"schema","level":3},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype FormOptionsLooseSchemaFn<TComponents> = <TSchema, TFormData, TFormValidators, TSubmitReturn>(schema, options) => FormOptions<InferUnion<TFormData, StandardSchemaInput<TSchema>>, TFormValidators, TSubmitReturn, TComponents>;\n```\n\nDefined in: [utils.public.ts:174](https://github.com/TanStack/form/blob/main/packages/form-core/src/utils.public.ts#L174)\n\nTypes loose schema form options using a separate schema as the source of the\nfinal valid form shape.\n\n`defaultValues` infer an editable form shape constrained by the schema input,\nso properties may be omitted or contain `null` or `undefined`. Callback\nvalidator `value` parameters use that editable shape merged with the schema\ninput.\n\nThe first argument is used only by TypeScript and is ignored at runtime.\nInclude the schema in `validators` as well when it should validate the form.\nParsed results are available in the corresponding `schemaOutputs` entries\nduring submission.\n\n## Type Parameters\n\n### TComponents\n\n`TComponents`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TSchema\n\n`TSchema` *extends* [`StandardSchemaV1`](StandardSchemaV1.md)\\<`any`, `any`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormData\n\n`TFormData` *extends* [`Editable`](Editable.md)\\<`StandardSchemaInput`\\<`TSchema`\\>\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormValidators\n\n`TFormValidators` *extends* [`FormValidators`](FormValidators.md)\\<`NoInfer`\\<[`InferUnion`](InferUnion.md)\\<`TFormData`, `StandardSchemaInput`\\<`TSchema`\\>\\>\\>\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TSubmitReturn\n\n`TSubmitReturn`\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### schema\n\n`TSchema`\n\nSupplies the final valid form shape without registering a\nvalidator.\n\n### options\n\n`LooseSchemaFormOptions`\\<`StandardSchemaInput`\\<`TSchema`\\>, `TFormData`, `TFormValidators`, `TSubmitReturn`\\>\n\nThe form options used to infer the editable form shape.\n\n## Returns\n\n[`FormOptions`](../interfaces/FormOptions.md)\\<[`InferUnion`](InferUnion.md)\\<`TFormData`, `StandardSchemaInput`\\<`TSchema`\\>\\>, `TFormValidators`, `TSubmitReturn`, `TComponents`\\>\n\nThe original options object, normalized to `FormOptions` with the\neditable states merged into the schema input.\n\n## Example\n\n```ts\nconst bookingSchema = z.object({ startDate: z.date() })\nconst bookingOptions = formOptions.looseSchema(bookingSchema, {\n  defaultValues: { startDate: null },\n  validators: [\n    { triggers: ['blur'], run: bookingSchema },\n    {\n      triggers: ['change'],\n      run: ({ value }) =>\n        value.startDate === null ? 'Choose a date' : undefined,\n    },\n  ],\n})\n```\n","originalRawMarkdown":"---\nid: FormOptionsLooseSchemaFn\ntitle: FormOptionsLooseSchemaFn\n---\n\n```ts\ntype FormOptionsLooseSchemaFn<TComponents> = <TSchema, TFormData, TFormValidators, TSubmitReturn>(schema, options) => FormOptions<InferUnion<TFormData, StandardSchemaInput<TSchema>>, TFormValidators, TSubmitReturn, TComponents>;\n```\n\nDefined in: [utils.public.ts:174](https://github.com/TanStack/form/blob/main/packages/form-core/src/utils.public.ts#L174)\n\nTypes loose schema form options using a separate schema as the source of the\nfinal valid form shape.\n\n`defaultValues` infer an editable form shape constrained by the schema input,\nso properties may be omitted or contain `null` or `undefined`. Callback\nvalidator `value` parameters use that editable shape merged with the schema\ninput.\n\nThe first argument is used only by TypeScript and is ignored at runtime.\nInclude the schema in `validators` as well when it should validate the form.\nParsed results are available in the corresponding `schemaOutputs` entries\nduring submission.\n\n## Type Parameters\n\n### TComponents\n\n`TComponents`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TSchema\n\n`TSchema` *extends* [`StandardSchemaV1`](StandardSchemaV1.md)\\<`any`, `any`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormData\n\n`TFormData` *extends* [`Editable`](Editable.md)\\<`StandardSchemaInput`\\<`TSchema`\\>\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormValidators\n\n`TFormValidators` *extends* [`FormValidators`](FormValidators.md)\\<`NoInfer`\\<[`InferUnion`](InferUnion.md)\\<`TFormData`, `StandardSchemaInput`\\<`TSchema`\\>\\>\\>\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TSubmitReturn\n\n`TSubmitReturn`\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### schema\n\n`TSchema`\n\nSupplies the final valid form shape without registering a\nvalidator.\n\n### options\n\n`LooseSchemaFormOptions`\\<`StandardSchemaInput`\\<`TSchema`\\>, `TFormData`, `TFormValidators`, `TSubmitReturn`\\>\n\nThe form options used to infer the editable form shape.\n\n## Returns\n\n[`FormOptions`](../interfaces/FormOptions.md)\\<[`InferUnion`](InferUnion.md)\\<`TFormData`, `StandardSchemaInput`\\<`TSchema`\\>\\>, `TFormValidators`, `TSubmitReturn`, `TComponents`\\>\n\nThe original options object, normalized to `FormOptions` with the\neditable states merged into the schema input.\n\n## Example\n\n```ts\nconst bookingSchema = z.object({ startDate: z.date() })\nconst bookingOptions = formOptions.looseSchema(bookingSchema, {\n  defaultValues: { startDate: null },\n  validators: [\n    { triggers: ['blur'], run: bookingSchema },\n    {\n      triggers: ['change'],\n      run: ({ value }) =>\n        value.startDate === null ? 'Choose a date' : undefined,\n    },\n  ],\n})\n```\n"}
