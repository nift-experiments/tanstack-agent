lue":"TSchema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"StandardSchemaV1.md","children":[{"type":"inlineCode","value":"StandardSchemaV1"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":3,"id":"tformvalidators","children":[{"type":"text","value":"TFormValidators"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFormValidators"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"FormValidators.md","children":[{"type":"inlineCode","value":"FormValidators"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"StandardSchemaInput"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":3,"id":"tsubmitreturn","children":[{"type":"text","value":"TSubmitReturn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSubmitReturn"}]},{"type":"paragraph","children":[{"type":"text","value":"Library-managed. Do not specify explicitly."}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"schema","children":[{"type":"text","value":"schema"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSchema"}]},{"type":"paragraph","children":[{"type":"text","value":"Supplies the form data type without registering a validator."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/FormOptions.md","children":[{"type":"inlineCode","value":"FormOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"StandardSchemaInput"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TFormValidators"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSubmitReturn"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The form options to type against the schema input."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/FormOptions.md","children":[{"type":"inlineCode","value":"FormOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"StandardSchemaInput"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSchema"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TFormValidators"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSubmitReturn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TComponents"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The original options object, normalized to "},{"type":"inlineCode","value":"FormOptions"},{"type":"text","value":" with the\nschema input as its form data type."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const profileSchema = z.object({ name: z.string().min(1) })\nconst profileOptions = formOptions.strictSchema(profileSchema, {\n  defaultValues: { name: '' },\n  validators: [\n    { triggers: ['change'], run: profileSchema },\n    {\n      triggers: ['change'],\n      run: ({ value }) =>\n        value.name.length === 0 ? 'Name is required' : undefined,\n    },\n  ],\n})","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tcomponents","text":"TComponents","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":2},{"id":"tschema","text":"TSchema","level":3},{"id":"tformvalidators","text":"TFormValidators","level":3},{"id":"tsubmitreturn","text":"TSubmitReturn","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"schema","text":"schema","level":3},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype FormOptionsStrictSchemaFn<TComponents> = <TSchema, TFormValidators, TSubmitReturn>(schema, options) => FormOptions<StandardSchemaInput<TSchema>, TFormValidators, TSubmitReturn, TComponents>;\n```\n\nDefined in: [utils.public.ts:114](https://github.com/TanStack/form/blob/main/packages/form-core/src/utils.public.ts#L114)\n\nTypes strict form options using a separate schema as the source of the form\ndata type.\n\nThe schema input fixes the form data type before the options are inferred,\nso `defaultValues` and each callback validator's `value` use the exact\nschema input type.\n\nThe first argument is used only by TypeScript and is ignored at runtime.\nInclude the schema in `validators` as well when it should validate the form.\nParsed results are available in the corresponding `schemaOutputs` entries\nduring submission.\n\n## Type Parameters\n\n### TComponents\n\n`TComponents`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TSchema\n\n`TSchema` *extends* [`StandardSchemaV1`](StandardSchemaV1.md)\\<`any`, `any`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormValidators\n\n`TFormValidators` *extends* [`FormValidators`](FormValidators.md)\\<`StandardSchemaInput`\\<`TSchema`\\>\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TSubmitReturn\n\n`TSubmitReturn`\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### schema\n\n`TSchema`\n\nSupplies the form data type without registering a validator.\n\n### options\n\n[`FormOptions`](../interfaces/FormOptions.md)\\<`StandardSchemaInput`\\<`TSchema`\\>, `TFormValidators`, `TSubmitReturn`, `unknown`\\>\n\nThe form options to type against the schema input.\n\n## Returns\n\n[`FormOptions`](../interfaces/FormOptions.md)\\<`StandardSchemaInput`\\<`TSchema`\\>, `TFormValidators`, `TSubmitReturn`, `TComponents`\\>\n\nThe original options object, normalized to `FormOptions` with the\nschema input as its form data type.\n\n## Example\n\n```ts\nconst profileSchema = z.object({ name: z.string().min(1) })\nconst profileOptions = formOptions.strictSchema(profileSchema, {\n  defaultValues: { name: '' },\n  validators: [\n    { triggers: ['change'], run: profileSchema },\n    {\n      triggers: ['change'],\n      run: ({ value }) =>\n        value.name.length === 0 ? 'Name is required' : undefined,\n    },\n  ],\n})\n```\n","originalRawMarkdown":"---\nid: FormOptionsStrictSchemaFn\ntitle: FormOptionsStrictSchemaFn\n---\n\n```ts\ntype FormOptionsStrictSchemaFn<TComponents> = <TSchema, TFormValidators, TSubmitReturn>(schema, options) => FormOptions<StandardSchemaInput<TSchema>, TFormValidators, TSubmitReturn, TComponents>;\n```\n\nDefined in: [utils.public.ts:114](https://github.com/TanStack/form/blob/main/packages/form-core/src/utils.public.ts#L114)\n\nTypes strict form options using a separate schema as the source of the form\ndata type.\n\nThe schema input fixes the form data type before the options are inferred,\nso `defaultValues` and each callback validator's `value` use the exact\nschema input type.\n\nThe first argument is used only by TypeScript and is ignored at runtime.\nInclude the schema in `validators` as well when it should validate the form.\nParsed results are available in the corresponding `schemaOutputs` entries\nduring submission.\n\n## Type Parameters\n\n### TComponents\n\n`TComponents`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TSchema\n\n`TSchema` *extends* [`StandardSchemaV1`](StandardSchemaV1.md)\\<`any`, `any`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TFormValidators\n\n`TFormValidators` *extends* [`FormValidators`](FormValidators.md)\\<`StandardSchemaInput`\\<`TSchema`\\>\\>\n\nLibrary-managed. Do not specify explicitly.\n\n### TSubmitReturn\n\n`TSubmitReturn`\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### schema\n\n`TSchema`\n\nSupplies the form data type without registering a validator.\n\n### options\n\n[`FormOptions`](../interfaces/FormOptions.md)\\<`StandardSchemaInput`\\<`TSchema`\\>, `TFormValidators`, `TSubmitReturn`, `unknown`\\>\n\nThe form options to type against the schema input.\n\n## Returns\n\n[`FormOptions`](../interfaces/FormOptions.md)\\<`StandardSchemaInput`\\<`TSchema`\\>, `TFormValidators`, `TSubmitReturn`, `TComponents`\\>\n\nThe original options object, normalized to `FormOptions` with the\nschema input as its form data type.\n\n## Example\n\n```ts\nconst profileSchema = z.object({ name: z.string().min(1) })\nconst profileOptions = formOptions.strictSchema(profileSchema, {\n  defaultValues: { name: '' },\n  validators: [\n    { triggers: ['change'], run: profileSchema },\n    {\n      triggers: ['change'],\n      run: ({ value }) =>\n        value.name.length === 0 ? 'Name is required' : undefined,\n    },\n  ],\n})\n```\n"}
