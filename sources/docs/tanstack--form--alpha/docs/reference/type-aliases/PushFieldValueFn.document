":"Parameters"}]},{"type":"heading","depth":3,"id":"arrayfieldname","children":[{"type":"text","value":"arrayFieldName"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFieldName"}]},{"type":"paragraph","children":[{"type":"text","value":"The array field path."}]},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"link","href":"ArrayFieldElement.md","children":[{"type":"inlineCode","value":"ArrayFieldElement"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFieldName"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The element to append."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/FieldUpdateOptions.md","children":[{"type":"inlineCode","value":"FieldUpdateOptions"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Controls metadata updates and whether validation runs."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// items: ['first', 'second']\nformApi.pushFieldValue('items', 'new item')\n// items: ['first', 'second', 'new item']","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":2},{"id":"tfieldname","text":"TFieldName","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"arrayfieldname","text":"arrayFieldName","level":3},{"id":"value","text":"value","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype PushFieldValueFn<TFormData> = <TFieldName>(arrayFieldName, value, options?) => void;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:158](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L158)\n\nAppends an element to an array field.\n\nA runtime value that is not an array produces a warning and is left\nunchanged. By default, the update marks the array field as touched and\ndirty, notifies change listeners, and runs change validation.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TFieldName\n\n`TFieldName` *extends* [`ArrayFieldName`](ArrayFieldName.md)\\<`TFormData`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### arrayFieldName\n\n`TFieldName`\n\nThe array field path.\n\n### value\n\n[`ArrayFieldElement`](ArrayFieldElement.md)\\<`TFormData`, `TFieldName`\\>\n\nThe element to append.\n\n### options?\n\n[`FieldUpdateOptions`](../interfaces/FieldUpdateOptions.md)\n\nControls metadata updates and whether validation runs.\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\n// items: ['first', 'second']\nformApi.pushFieldValue('items', 'new item')\n// items: ['first', 'second', 'new item']\n```\n","originalRawMarkdown":"---\nid: PushFieldValueFn\ntitle: PushFieldValueFn\n---\n\n```ts\ntype PushFieldValueFn<TFormData> = <TFieldName>(arrayFieldName, value, options?) => void;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:158](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L158)\n\nAppends an element to an array field.\n\nA runtime value that is not an array produces a warning and is left\nunchanged. By default, the update marks the array field as touched and\ndirty, notifies change listeners, and runs change validation.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TFieldName\n\n`TFieldName` *extends* [`ArrayFieldName`](ArrayFieldName.md)\\<`TFormData`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### arrayFieldName\n\n`TFieldName`\n\nThe array field path.\n\n### value\n\n[`ArrayFieldElement`](ArrayFieldElement.md)\\<`TFormData`, `TFieldName`\\>\n\nThe element to append.\n\n### options?\n\n[`FieldUpdateOptions`](../interfaces/FieldUpdateOptions.md)\n\nControls metadata updates and whether validation runs.\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\n// items: ['first', 'second']\nformApi.pushFieldValue('items', 'new item')\n// items: ['first', 'second', 'new item']\n```\n"}
