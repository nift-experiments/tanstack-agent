d. Do not specify explicitly."}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"arrayfieldname","children":[{"type":"text","value":"arrayFieldName"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFieldName"}]},{"type":"paragraph","children":[{"type":"text","value":"The array field path."}]},{"type":"heading","depth":3,"id":"index","children":[{"type":"text","value":"index"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"The index to replace, from "},{"type":"inlineCode","value":"0"},{"type":"text","value":" through "},{"type":"inlineCode","value":"array.length - 1"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"link","href":"ArrayFieldElement.md","children":[{"type":"inlineCode","value":"ArrayFieldElement"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFormData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TFieldName"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The new element."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/FieldUpdateOptions.md","children":[{"type":"inlineCode","value":"FieldUpdateOptions"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Controls metadata updates and whether validation runs."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// items: ['first', 'second', 'third']\nformApi.replaceFieldValue('items', 1, 'new item')\n// items: ['first', 'new item', 'third']","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":2},{"id":"tfieldname","text":"TFieldName","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"arrayfieldname","text":"arrayFieldName","level":3},{"id":"index","text":"index","level":3},{"id":"value","text":"value","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype ReplaceFieldValueFn<TFormData> = <TFieldName>(arrayFieldName, index, value, options?) => void;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:278](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L278)\n\nReplaces the element at an index in an array field.\n\nAn invalid index or a runtime value that is not an array produces a warning\nand leaves the value unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TFieldName\n\n`TFieldName` *extends* [`ArrayFieldName`](ArrayFieldName.md)\\<`TFormData`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### arrayFieldName\n\n`TFieldName`\n\nThe array field path.\n\n### index\n\n`number`\n\nThe index to replace, from `0` through `array.length - 1`.\n\n### value\n\n[`ArrayFieldElement`](ArrayFieldElement.md)\\<`TFormData`, `TFieldName`\\>\n\nThe new element.\n\n### options?\n\n[`FieldUpdateOptions`](../interfaces/FieldUpdateOptions.md)\n\nControls metadata updates and whether validation runs.\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.replaceFieldValue('items', 1, 'new item')\n// items: ['first', 'new item', 'third']\n```\n","originalRawMarkdown":"---\nid: ReplaceFieldValueFn\ntitle: ReplaceFieldValueFn\n---\n\n```ts\ntype ReplaceFieldValueFn<TFormData> = <TFieldName>(arrayFieldName, index, value, options?) => void;\n```\n\nDefined in: [FormApi/FormApiArrayMethods.types.public.ts:278](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi/FormApiArrayMethods.types.public.ts#L278)\n\nReplaces the element at an index in an array field.\n\nAn invalid index or a runtime value that is not an array produces a warning\nand leaves the value unchanged.\n\nBy default, the update marks the array field as touched and dirty, notifies\nchange listeners, and runs change validation.\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\nLibrary-managed. Do not specify explicitly.\n\n## Type Parameters\n\n### TFieldName\n\n`TFieldName` *extends* [`ArrayFieldName`](ArrayFieldName.md)\\<`TFormData`\\>\n\nLibrary-managed. Do not specify explicitly.\n\n## Parameters\n\n### arrayFieldName\n\n`TFieldName`\n\nThe array field path.\n\n### index\n\n`number`\n\nThe index to replace, from `0` through `array.length - 1`.\n\n### value\n\n[`ArrayFieldElement`](ArrayFieldElement.md)\\<`TFormData`, `TFieldName`\\>\n\nThe new element.\n\n### options?\n\n[`FieldUpdateOptions`](../interfaces/FieldUpdateOptions.md)\n\nControls metadata updates and whether validation runs.\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\n// items: ['first', 'second', 'third']\nformApi.replaceFieldValue('items', 1, 'new item')\n// items: ['first', 'new item', 'third']\n```\n"}
