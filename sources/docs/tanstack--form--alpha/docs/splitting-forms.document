{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"As a form grows, keeping every field in one component can make the code harder\nto navigate and maintain. You can move related fields into smaller components\nwhile keeping one form instance, but each new component boundary needs a type\nfor the form or field it receives."}]},{"type":"heading","depth":2,"id":"split-a-large-form-into-sections","children":[{"type":"text","value":"Split a large form into sections"}]},{"type":"paragraph","children":[{"type":"text","value":"First define the form's reusable options with "},{"type":"inlineCode","value":"formOptions"},{"type":"text","value":". In this example,\nthe same module also exports a named form type derived from those options. The\nparent can add page-specific options, such as "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":", when it creates the\nform, while extracted sections can import the same form type."}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"paragraph","children":[{"type":"text","value":"React's "},{"type":"inlineCode","value":"ReactFormType"},{"type":"text","value":" derives the form prop from the shared options. The\nresult keeps the field names and values available to "},{"type":"inlineCode","value":"form.Field"},{"type":"text","value":" in the\nextracted component."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { formOptions } from '@tanstack/react-form'\nimport type { ReactFormType } from '@tanstack/react-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = ReactFormType<typeof profileFormOptions>","lang":"ts","meta":"file=\"shared-form.ts\"","title":"shared-form.ts","file":"shared-form.ts"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"import type { ProfileForm } from './shared-form'\n\ninterface AddressFieldsProps {\n  form: ProfileForm\n}\n\nexport function AddressFields({ form }: AddressFieldsProps) {\n  return (\n    <>\n      <form.Field name=\"address.street\">\n        {(field) => (\n          <input\n            aria-label=\"Street\"\n            value={field.value}\n            onChange={(event) => field.handleChange(event.target.value)}\n          />\n        )}\n      </form.Field>\n      <form.Field name=\"address.city\">\n        {(field) => (\n          <input\n            aria-label=\"City\"\n            value={field.value}\n            onChange={(event) => field.handleChange(event.target.value)}\n          />\n        )}\n      </form.Field>\n    </>\n  )\n}","lang":"tsx","meta":"file=\"AddressFields.tsx\"","title":"AddressFields.tsx","file":"AddressFields.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-2","data-tab-index":"2"},"children":[{"type":"code","value":"import { useForm } from '@tanstack/react-form'\nimport { AddressFields } from './AddressFields'\nimport { profileFormOptions } from './shared-form'\n\nexport function ProfileForm() {\n  const form = useForm({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n\n  return <AddressFields form={form} />\n}","lang":"tsx","meta":"file=\"ProfileForm.tsx\"","title":"ProfileForm.tsx","file":"ProfileForm.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"shared-form.ts\"},{\"slug\":\"f