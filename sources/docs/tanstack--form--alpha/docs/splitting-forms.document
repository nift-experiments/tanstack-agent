 render prop."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import type { FieldWithValue } from '@tanstack/react-form'\n\ninterface TextFieldProps {\n  field: FieldWithValue<string>\n  label: string\n}\n\nexport function TextField({ field, label }: TextFieldProps) {\n  return (\n    <label>\n      <span>{label}</span>\n      <input\n        name={field.name}\n        value={field.value}\n        onBlur={field.handleBlur}\n        onChange={(event) => field.handleChange(event.target.value)}\n      />\n    </label>\n  )\n}","lang":"tsx","meta":"file=\"TextField.tsx\"","title":"TextField.tsx","file":"TextField.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"import { TextField } from './TextField'\nimport type { ProfileForm } from './shared-form'\n\nexport function NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <TextField field={field} label=\"Name\" />}\n    </form.Field>\n  )\n}","lang":"tsx","meta":"file=\"NameField.tsx\"","title":"NameField.tsx","file":"NameField.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"TextField.tsx\"},{\"slug\":\"file-1\",\"name\":\"NameField.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"TextField.tsx\",\"code\":\"import type { FieldWithValue } from '@tanstack/react-form'\\n\\ninterface TextFieldProps {\\n  field: FieldWithValue<string>\\n  label: string\\n}\\n\\nexport function TextField({ field, label }: TextFieldProps) {\\n  return (\\n    <label>\\n      <span>{label}</span>\\n      <input\\n        name={field.name}\\n        value={field.value}\\n        onBlur={field.handleBlur}\\n    