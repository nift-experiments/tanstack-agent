","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"lit"},"children":[{"type":"paragraph","children":[{"type":"text","value":"Type the Lit render helper's field parameter as "},{"type":"inlineCode","value":"FieldWithValue<string>"},{"type":"text","value":", then\ncall it from the controller's "},{"type":"inlineCode","value":"field"},{"type":"text","value":" render callback."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { html } from 'lit'\nimport type { FieldWithValue } from '@tanstack/lit-form'\n\nexport function textField(field: FieldWithValue<string>, label: string) {\n  return html`\n    <label>\n      <span>${label}</span>\n      <input\n        name=${field.name}\n        .value=${field.value}\n        @blur=${() => field.handleBlur()}\n        @input=${(event: InputEvent) =>\n          field.handleChange((event.currentTarget as HTMLInputElement).value)}\n      />\n    </label>\n  `\n}","lang":"ts","meta":"file=\"text-field.ts\"","title":"text-field.ts","file":"text-field.ts"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"import { textField } from './text-field'\nimport type { ProfileForm } from './shared-form'\n\nexport function nameField(form: ProfileForm) {\n  return form.field({ name: 'name' }, (field) => textField(field, 'Name'))\n}","lang":"ts","meta":"file=\"name-field.ts\"","title":"name-field.ts","file":"name-field.ts"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"text-field.ts\"},{\"slug\":\"file-1\",\"name\":\"name-field.ts\"}]}","data-files-meta":"{\"files\":[{\"title\":\"text-field.ts\",\"code\":\"import { html } from 'lit'\\nimport type { FieldWithValue } from '@tanstack/lit-form'\\n\\nexport function textField(field: FieldWithValue<string>, label: string) {\\n  return html`\\n    <label>\\n      <span>${label}</span>\\n      <input\\n        name=${field.name}\\n        .value=${field.value}\\n        @blur=${() => field.handleBlur()}\\n        @input=${(event: InputEvent) =>\\n          field.handleChange((event.currentTarget as HTMLInputElement).value)}\\n      />\\n    </label>\\n  `\\n}\",\"language\":\"ts\"},{\"title\":\"name-field.ts\",\"code\":\"import { textField } from './text-field'\\nimport type { ProfileForm } from './shared-form'\\n\\nexport function nameField(form: ProfileForm) {\\n  return form.field({ name: 'name' }, (field) => textField(field, 'Name'))\\n}\",\"language\":\"ts\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"svelte"},"children":[{"type":"paragraph","children":[{"type":"text","value":"Type the Svelte component's field prop as "},{"type":"inlineCode","value":"FieldWithValue<string>"},{"type":"text","value":", then pass it\nthe field from the "},{"type":"inlineCode","value":"form.Field"},{"type":"text","value":" snippet."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"<script lang=\"ts\">\n  import type { FieldWithValue } from '@tanstack/svelte-form'\n\n  interface Props {\n    field: FieldWithValue<string>\n    label: string\n  }\n\n  const { field, label }: Props = $props()\n</script>\n\n<label>\n  <span>{label}</span>\n  <input\n    name={field.name}\n    value={field.value}\n    onblur={field.handleBlur}\n    oninput={(event) => field.handleChange(event.currentTarget.value)}\n  />\n</label>","lang":"svelte","meta":"file=\"TextField.svelte\"","title":"TextField.svelte","fil