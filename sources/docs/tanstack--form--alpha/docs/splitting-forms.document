  </form.Subscribe>\n  )\n}","lang":"tsx","meta":"file=\"SubmitButton.tsx\"","title":"SubmitButton.tsx","file":"SubmitButton.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"FieldErrors.tsx\"},{\"slug\":\"file-1\",\"name\":\"SubmitButton.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"FieldErrors.tsx\",\"code\":\"import type { AnyFieldApi } from '@tanstack/preact-form'\\n\\nexport function FieldErrors({ field }: { field: AnyFieldApi }) {\\n  return (\\n    <small role=\\\"alert\\\" aria-live=\\\"polite\\\">\\n      {field.errors.map((error) => error.message).join(', ')}\\n    </small>\\n  )\\n}\",\"language\":\"tsx\"},{\"title\":\"SubmitButton.tsx\",\"code\":\"import type { AnyPreactFormApi } from '@tanstack/preact-form'\\n\\nexport function SubmitButton({ form }: { form: AnyPreactFormApi }) {\\n  return (\\n    <form.Subscribe\\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\\n    >\\n      {([canSubmit, isSubmitting]) => (\\n        <button type=\\\"submit\\\" disabled={!canSubmit || isSubmitting}>\\n          {isSubmitting ? 'Submitting...' : 'Submit'}\\n        </button>\\n      )}\\n    </form.Subscribe>\\n  )\\n}\",\"language\":\"tsx\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"vue"},"children":[{"type":"paragraph","children":[{"type":"text","value":"Vue provides "},{"type":"inlineCode","value":"AnyVueFormApi"},{"type":"text","value":" for form-level components. Pass the field from the\n"},{"type":"inlineCode","value":"form.Field"},{"type":"text","value":" slot to "},{"type":"inlineCode","value":"FieldErrors"},{"type":"text","value":", and pass the form instance to\n"},{"type":"inlineCode","value":"SubmitButton"},{"type":"text","value":"."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"<script setup lang=\"ts\">\nimport type { AnyFieldApi } from '@tanstack/vue-form'\n\ndefineProps<{ field: AnyFieldApi }>()\n</script>\n\n<template>\n  <small role=\"alert\" aria-live=\"polite\">\n    {{ field.errors.map((error) => error.message).join(', ') }}\n  </small>\n</template>","lang":"vue","meta":"file=\"FieldErrors.vue\"","title":"FieldErrors.vue","file":"FieldErrors.vue"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport type { AnyVueFormApi } from '@tanstack/vue-form'\n\nconst props = defineProps<{ form: AnyVueFormApi }>()\nconst form = computed(() => props.form)\n</script>\n\n<template>\n  <form.Subscribe\n    :selector=\"(state) => [state.canSubmit, state.isSubmitting] as const\"\n    v-slot=\"[canSubmit, isSubmitting]\"\n  >\n    <button type=\"submit\" :disabled=\"!canSubmit || isSubmitting\">\n      {{ isSubmitting ? 'Submitting...' : 'Submit' }}\n    </button>\n  </form.Subscribe>\n</template>","lang":"vue","meta":"file=\"SubmitButton.vue\"","title":"SubmitButton.vue","file":"SubmitButton.vue"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"FieldErrors.vue\"},{\"slug\":\"file-1\",\"name\":\"SubmitButton.vue\"}]}","data-files-meta":"{\"files\":[{\"title\":\"FieldErrors.vue\",\"code\":\"<script setup lang=\\\"ts\\\">\\nimport type { AnyFieldApi } from '@tanstack/vue-form'\\n\\ndefineProps<{ field: AnyFieldApi }>()\\n</script>\\n\\n<template>\\n  <small role=\\\"alert\\\" aria-live=\\\"polite\\\">\\n    {{ field.errors.map((error) => error.message).join(', ') }}\\n  </small>\\n</template>\",\"language\":\"vue\"},{\"title\":\"SubmitButton.vue\",\"code\":\"<script setup lang=\\\"ts\\\">\\nimport { computed } from 'vue'\\nimport type { AnyVueFormApi } from '@tanstack/vue-form'\\n\\nconst props = defineProps<{ form: AnyVueFormApi }>()\\nconst form = computed(() => props.form)\\n</script>\\n\\n<template>\\n  <form.Subscribe\\n    :selector=\\\"(state) => [state.canSubmit, state.isSubmitting] as const\\\"\\n    v-slot=\\\"[canSubmit, isSubmitting]\\\"\\n  >\\n    <button type=\\\"submit\\\" :disabled=\\\"!canSubmit || isSubmitting\\\">\\n      {{ isSubmitting ? 'Submitting...' : 'Submit' }}\\n    </button>\\n  </form.Subscribe>\\n</template>\",\"language\":\"vue\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"angular"},"children":[{"type":"paragraph","children":[{"type":"text","value":"For a field control that doesn't read the value, use "},{"type":"inlineCode","value":"injectField<unknown>()"},{"type":"text","value":"\nto receive the field and react to its metadata. Angular provides\n"},{"type":"inlineCode","value":"AnyAngularFormApi"},{"type":"text","value":" when a separate component only needs form methods."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { ChangeDetectionStrategy, Component } from '@angular/core'\nimport { injectField } from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-field-errors',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <small role=\"alert\" aria-live=\"polite\">\n      @for (error of field.api.errors; track error) {\n        {{ error.message }}\n      }\n    </small>\n  `,\n})\nexport class FieldErrorsComponent {\n  field = injectField<unknown>()\n}","lang":"ts","meta":"file=\"field-errors.component.ts\"","title":"field-errors.component.ts","file":"field-errors.component.ts"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"import { ChangeDetectionStrategy, Component, input } from '@angular/core'\nimport type { AnyAngularFormApi } from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-reset-button',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `<button type=\"button\" (click)=\"form().reset()\">Reset</button>`,\n})\nexport class ResetButtonComponent {\n  form = input.required<AnyAngularFormApi>()\n}","lang":"ts","meta":"file=\"reset-button.component.ts\"","title":"reset-button.component.ts","file":"reset-button.component.ts"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"field-errors.component.ts\"},{\"slug\":\"file-1\",\"name\":\"reset-button.component.ts\"}]}","data-files-meta":"{\"files\":[{\"title\":\"field-errors.component.ts\",\"code\":\"import { ChangeDetectionStrategy, Component } from '@angular/core'\\nimport { injectField } from '@tanstack/angular-form'\\n\\n@Component({\\n  selector: 'app-field-errors',\\n  standalone: true,\\n  changeDetection: ChangeDetectionStrategy.OnPush,\\n  template: `\\n    <small role=\\\"alert\\\" aria-live=\\\"polite\\\">\\n      @for (error of field.api.errors; track error) {\\n        {{ error.message }}\\n      }\\n    </small>\\n  `,\\n})\\nexport class FieldErrorsComponent {\\n  field = injectField<unknown>()\\n}\",\"language\":\"ts\"},{\"title\":\"reset-button.component.ts\",\"code\":\"import { ChangeDetectionStrategy, Component, input } from '@angular/core'\\nimport type { AnyAngularFormApi } from '@tanstack/angular-form'\\n\\n@Component({\\n  selector: 'app-reset-button',\\n  standalone: true,\\n  changeDetection: ChangeDetectionStrategy.OnPush,\\n  template: `<button type=\\\"button\\\" (click)=\\\"form().reset()\\\">Reset</button>`,\\n})\\nexport class ResetButtonComponent {\\n  form = input.required<AnyAngularFormApi>()\\n}\",\"language\":\"ts\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"paragraph","children":[{"type":"text","value":"Solid provides "},{"type":"inlineCode","value":"AnySolidFormApi"},{"type":"text","value":" for form-level components. Its field render\nprop remains an accessor, so "},{"type":"inlineCode","value":"FieldErrors"},{"type":"text","value":" accepts an\n"},{"type":"inlineCode","value":"Accessor<AnyFieldApi>"},{"type":"text","value":"."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import type { Accessor } from 'solid-js'\nimport type { AnyFieldApi } from '@tanstack/solid-form'\n\nexport function FieldErrors(props: { field: Accessor<AnyFieldApi> }) {\n  return (\n    <small role=\"alert\" aria-live=\"polite\">\n      {props\n        .field()\n        .errors.map((error) => error.message)\n        .join(', ')}\n    </small>\n  )\n}","lang":"tsx","meta":"file=\"FieldErrors.tsx\"","title":"FieldErrors.tsx","file":"FieldErrors.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"import type { AnySolidFormApi } from '@tanstack/solid-form'\n\nexport function SubmitButton(props: { form: AnySolidFormApi }) {\n  return (\n    <props.form.Subscribe\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n    >\n      {(state) => (\n        <button type=\"submit\" disabled={!state()[0] || state()[1]}>\n          {state()[1] ? 'Submitting...' : 'Submit'}\n        </button>\n      )}\n    </props.form.Subscribe>\n  )\n}","lang":"tsx","meta":"file=\"SubmitButton.tsx\"","title":"SubmitButton.tsx","file":"SubmitButton.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"FieldErrors.tsx\"},{\"slug\":\"file-1\",\"name\":\"SubmitButton.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"FieldErrors.tsx\",\"code\":\"import type { Accessor } from 'solid-js'\\nimport type { AnyFieldApi } from '@tanstack/solid-form'\\n\\nexport function FieldErrors(props: { field: Accessor<AnyFieldApi> }) {\\n  return (\\n    <small role=\\\"alert\\\" aria-live=\\\"polite\\\">\\n      {props\\n        .field()\\n        .errors.map((error) => error.message)\\n        .join(', ')}\\n    </small>\\n  )\\n}\",\"language\":\"tsx\"},{\"title\":\"SubmitButton.tsx\",\"code\":\"import type { AnySolidFormApi } from '@tanstack/solid-form'\\n\\nexport function SubmitButton(props: { form: AnySolidFormApi }) {\\n  return (\\n    <props.form.Subscribe\\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\\n    >\\n      {(state) => (\\n        <button type=\\\"submit\\\" disabled={!state()[0] || state()[1]}>\\n          {state()[1] ? 'Submitting...' : 'Submit'}\\n        </button>\\n      )}\\n    </props.form.Subscribe>\\n  )\\n}\",\"language\":\"tsx\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"lit"},"children":[{"type":"paragraph","children":[{"type":"text","value":"Lit doesn't expose an "},{"type":"inlineCode","value":"AnyLitFormApi"},{"type":"text","value":" controller type. Use "},{"type":"inlineCode","value":"AnyFieldApi"},{"type":"text","value":" for a\nfield render helper, or pass the controller's core "},{"type":"inlineCode","value":"form.api"},{"type":"text","value":" object to a\nhelper typed with "},{"type":"inlineCode","value":"AnyFormApi"},{"type":"text","value":"."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { html } from 'lit'\nimport type { AnyFieldApi } from '@tanstack/lit-form'\n\nexport function fieldErrors(field: AnyFieldApi) {\n  return html`\n    <small role=\"alert\" aria-live=\"polite\">\n      ${field.errors.map((error) => error.message).join(', ')}\n    </small>\n  `\n}","lang":"ts","meta":"file=\"field-errors.ts\"","title":"field-errors.ts","file":"field-errors.ts"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"import { html } from 'lit'\nimport type { AnyFormApi } from '@tanstack/lit-form'\n\nexport function resetButton(form: AnyFormApi) {\n  return html`\n    <button type=\"button\" @click=${() => form.reset()}>Reset</button>\n  `\n}","lang":"ts","meta":"file=\"reset-button.ts\"","title":"reset-button.ts","file":"reset-button.ts"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"field-errors.ts\"},{\"slug\":\"file-1\",\"name\":\"reset-button.ts\"}]}","data-files-meta":"{\"files\":[{\"title\":\"field-errors.ts\",\"code\":\"import { html } from 'lit'\\nimport type { AnyFieldApi } from '@tanstack/lit-form'\\n\\nexport function fieldErrors(field: AnyFieldApi) {\\n  return html`\\n    <small role=\\\"alert\\\" aria-live=\\\"polite\\\">\\n      ${field.errors.map((error) => error.message).join(', ')}\\n    </small>\\n  `\\n}\",\"language\":\"ts\"},{\"title\":\"reset-button.ts\",\"code\":\"import { html } from 'lit'\\nimport type { AnyFormApi } from '@tanstack/lit-form'\\n\\nexport function resetButton(form: AnyFormApi) {\\n  return html`\\n    <button type=\\\"button\\\" @click=${() => form.reset()}>Reset</button>\\n  `\\n}\",\"language\":\"ts\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"svelte"},"children":[{"type":"paragraph","children":[{"type":"text","value":"Svelte provides "},{"type":"inlineCode","value":"AnySvelteFormApi"},{"type":"text","value":" for form-level components. Pass the field\nfrom the "},{"type":"inlineCode","value":"form.Field"},{"type":"text","value":" snippet to "},{"type":"inlineCode","value":"FieldErrors"},{"type":"text","value":", and pass the form instance to\n"},{"type":"inlineCode","value":"SubmitButton"},{"type":"text","value":"."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"<script lang=\"ts\">\n  import type { AnyFieldApi } from '@tanstack/svelte-form'\n\n  const { field }: { field: AnyFieldApi } = $props()\n</script>\n\n<small role=\"alert\" aria-live=\"polite\">\n  {field.errors.map((error) => error.message).join(', ')}\n</small>","lang":"svelte","meta":"file=\"FieldErrors.svelte\"","title":"FieldErrors.svelte","file":"FieldErrors.svelte"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"<script lang=\"ts\">\n  import type { AnySvelteFormApi } from '@tanstack/svelte-form'\n\n  const { form }: { form: AnySvelteFormApi } = $props()\n</script>\n\n<form.Subscribe\n  selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n>\n  {#snippet children([canSubmit, isSubmitting])}\n    <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n      {isSubmitting ? 'Submitting...' : 'Submit'}\n    </button>\n  {/snippet}\n</form.Subscribe>","lang":"svelte","meta":"file=\"SubmitButton.svelte\"","title":"SubmitButton.svelte","file":"SubmitButton.svelte"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"FieldErrors.svelte\"},{\"slug\":\"file-1\",\"name\":\"SubmitButton.svelte\"}]}","data-files-meta":"{\"files\":[{\"title\":\"FieldErrors.svelte\",\"code\":\"<script lang=\\\"ts\\\">\\n  import type { AnyFieldApi } from '@tanstack/svelte-form'\\n\\n  const { field }: { field: AnyFieldApi } = $props()\\n</script>\\n\\n<small role=\\\"alert\\\" aria-live=\\\"polite\\\">\\n  {field.errors.map((error) => error.message).join(', ')}\\n</small>\",\"language\":\"svelte\"},{\"title\":\"SubmitButton.svelte\",\"code\":\"<script lang=\\\"ts\\\">\\n  import type { AnySvelteFormApi } from '@tanstack/svelte-form'\\n\\n  const { form }: { form: AnySvelteFormApi } = $props()\\n</script>\\n\\n<form.Subscribe\\n  selector={(state) => [state.canSubmit, state.isSubmitting] as const}\\n>\\n  {#snippet children([canSubmit, isSubmitting])}\\n    <button type=\\\"submit\\\" disabled={!canSubmit || isSubmitting}>\\n      {isSubmitting ? 'Submitting...' : 'Submit'}\\n    </button>\\n  {/snippet}\\n</form.Subscribe>\",\"language\":\"svelte\"}]}"}}]}],"properties":{"data-available-frameworks":"[\"react\",\"preact\",\"vue\",\"angular\",\"solid\",\"lit\",\"svelte\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[],\"preact\":[],\"vue\":[],\"angular\":[],\"solid\":[],\"lit\":[],\"svelte\":[]}}"}}],"headings":[{"id":"split-a-large-form-into-sections","text":"Split a large form into sections","level":2},{"id":"extract-a-field-component-by-value-type","text":"Extract a field component by value type","level":2},{"id":"accept-any-form-or-field","text":"Accept any form or field","level":2}]},"frameworks":["react","preact","vue","angular","solid","lit","svelte"],"downloadMarkdown":"As a form grows, keeping every field in one component can make the code harder\nto navigate and maintain. You can move related fields into smaller components\nwhile keeping one form instance, but each new component boundary needs a type\nfor the form or field it receives.\n\n## Split a large form into sections\n\nFirst define the form's reusable options with `formOptions`. In this example,\nthe same module also exports a named form type derived from those options. The\nparent can add page-specific options, such as `onSubmit`, when it creates the\nform, while extracted sections can import the same form type.\n\n<!-- ::start:framework -->\n\n# React\n\nReact's `ReactFormType` derives the form prop from the shared options. The\nresult keeps the field names and values available to `form.Field` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/react-form'\nimport type { ReactFormType } from '@tanstack/react-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = ReactFormType<typeof profileFormOptions>\n```\n\n```tsx file=\"AddressFields.tsx\"\nimport type { ProfileForm } from './shared-form'\n\ninterface AddressFieldsProps {\n  form: ProfileForm\n}\n\nexport function AddressFields({ form }: AddressFieldsProps) {\n  return (\n    <>\n      <form.Field name=\"address.street\">\n        {(field) => (\n          <input\n            aria-label=\"Street\"\n            value={field.value}\n            onChange={(event) => field.handleChange(event.target.value)}\n          />\n        )}\n      </form.Field>\n      <form.Field name=\"address.city\">\n        {(field) => (\n          <input\n            aria-label=\"City\"\n            value={field.value}\n            onChange={(event) => field.handleChange(event.target.value)}\n          />\n        )}\n      </form.Field>\n    </>\n  )\n}\n```\n\n```tsx file=\"ProfileForm.tsx\"\nimport { useForm } from '@tanstack/react-form'\nimport { AddressFields } from './AddressFields'\nimport { profileFormOptions } from './shared-form'\n\nexport function ProfileForm() {\n  const form = useForm({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n\n  return <AddressFields form={form} />\n}\n```\n\n<!-- ::end:tabs -->\n\n> [!NOTE] Sharing between forms\n> If the section should work with multiple forms instead of only one, use [field groups](./framework/react/guides/field-groups).\n\n# Preact\n\nPreact's `PreactFormType` derives the form prop from the shared options. The\nresult keeps the field names and values available to `form.Field` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/preact-form'\nimport type { PreactFormType } from '@tanstack/preact-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = PreactFormType<typeof profileFormOptions>\n```\n\n```tsx file=\"AddressFields.tsx\"\nimport type { ProfileForm } from './shared-form'\n\ninterface AddressFieldsProps {\n  form: ProfileForm\n}\n\nexport function AddressFields({ form }: AddressFieldsProps) {\n  return (\n    <>\n      <form.Field name=\"address.street\">\n        {(field) => (\n          <input\n            aria-label=\"Street\"\n            value={field.value}\n            onInput={(event) => field.handleChange(event.currentTarget.value)}\n          />\n        )}\n      </form.Field>\n      <form.Field name=\"address.city\">\n        {(field) => (\n          <input\n            aria-label=\"City\"\n            value={field.value}\n            onInput={(event) => field.handleChange(event.currentTarget.value)}\n          />\n        )}\n      </form.Field>\n    </>\n  )\n}\n```\n\n```tsx file=\"ProfileForm.tsx\"\nimport { useForm } from '@tanstack/preact-form'\nimport { AddressFields } from './AddressFields'\nimport { profileFormOptions } from './shared-form'\n\nexport function ProfileForm() {\n  const form = useForm({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n\n  return <AddressFields form={form} />\n}\n```\n\n<!-- ::end:tabs -->\n\n# Vue\n\nVue's `VueFormType` derives the form prop from the shared options. The result\nkeeps the field names and values available to `form.Field` in the extracted\ncomponent.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/vue-form'\nimport type { VueFormType } from '@tanstack/vue-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = VueFormType<typeof profileFormOptions>\n```\n\n```vue file=\"AddressFields.vue\"\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport type { ProfileForm } from './shared-form'\n\nconst props = defineProps<{\n  form: ProfileForm\n}>()\n\nconst form = computed(() => props.form)\n</script>\n\n<template>\n  <form.Field name=\"address.street\" v-slot=\"{ field }\">\n    <input\n      aria-label=\"Street\"\n      :value=\"field.value\"\n      @input=\"field.handleChange(($event.target as HTMLInputElement).value)\"\n    />\n  </form.Field>\n  <form.Field name=\"address.city\" v-slot=\"{ field }\">\n    <input\n      aria-label=\"City\"\n      :value=\"field.value\"\n      @input=\"field.handleChange(($event.target as HTMLInputElement).value)\"\n    />\n  </form.Field>\n</template>\n```\n\n```vue file=\"ProfileForm.vue\"\n<script setup lang=\"ts\">\nimport { useForm } from '@tanstack/vue-form'\nimport AddressFields from './AddressFields.vue'\nimport { profileFormOptions } from './shared-form'\n\nconst form = useForm({\n  ...profileFormOptions,\n  onSubmit: ({ value }) => console.log(value),\n})\n</script>\n\n<template>\n  <AddressFields :form=\"form\" />\n</template>\n```\n\n<!-- ::end:tabs -->\n\n# Angular\n\nAngular's `AngularFormType` derives the form input from the shared options. The\nresult keeps the field names and values available to `TanStackField` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/angular-form'\nimport type { AngularFormType } from '@tanstack/angular-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = AngularFormType<typeof profileFormOptions>\n```\n\n```ts file=\"address-fields.component.ts\"\nimport { ChangeDetectionStrategy, Component, input } from '@angular/core'\nimport { TanStackField } from '@tanstack/angular-form'\nimport type { ProfileForm } from './shared-form'\n\n@Component({\n  selector: 'app-address-fields',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [TanStackField],\n  template: `\n    <ng-container\n      [tanstackField]=\"form()\"\n      name=\"address.street\"\n      #street=\"field\"\n    >\n      <input\n        aria-label=\"Street\"\n        [value]=\"street.api.value\"\n        (input)=\"street.api.handleChange($any($event).target.value)\"\n      />\n    </ng-container>\n    <ng-container [tanstackField]=\"form()\" name=\"address.city\" #city=\"field\">\n      <input\n        aria-label=\"City\"\n        [value]=\"city.api.value\"\n        (input)=\"city.api.handleChange($any($event).target.value)\"\n      />\n    </ng-container>\n  `,\n})\nexport class AddressFieldsComponent {\n  form = input.required<ProfileForm>()\n}\n```\n\n```ts file=\"profile-form.component.ts\"\nimport { ChangeDetectionStrategy, Component } from '@angular/core'\nimport { injectForm } from '@tanstack/angular-form'\nimport { AddressFieldsComponent } from './address-fields.component'\nimport { profileFormOptions } from './shared-form'\n\n@Component({\n  selector: 'app-profile-form',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [AddressFieldsComponent],\n  template: `<app-address-fields [form]=\"form\" />`,\n})\nexport class ProfileFormComponent {\n  form = injectForm({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\nSolid's `SolidFormType` derives the form prop from the shared options. The\nresult keeps the field names and values available to `form.Field` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/solid-form'\nimport type { SolidFormType } from '@tanstack/solid-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = SolidFormType<typeof profileFormOptions>\n```\n\n```tsx file=\"AddressFields.tsx\"\nimport type { ProfileForm } from './shared-form'\n\ninterface AddressFieldsProps {\n  form: ProfileForm\n}\n\nexport function AddressFields(props: AddressFieldsProps) {\n  return (\n    <>\n      <props.form.Field name=\"address.street\">\n        {(field) => (\n          <input\n            aria-label=\"Street\"\n            value={field().value}\n            onInput={(event) => field().handleChange(event.currentTarget.value)}\n          />\n        )}\n      </props.form.Field>\n      <props.form.Field name=\"address.city\">\n        {(field) => (\n          <input\n            aria-label=\"City\"\n            value={field().value}\n            onInput={(event) => field().handleChange(event.currentTarget.value)}\n          />\n        )}\n      </props.form.Field>\n    </>\n  )\n}\n```\n\n```tsx file=\"ProfileForm.tsx\"\nimport { createForm } from '@tanstack/solid-form'\nimport { AddressFields } from './AddressFields'\nimport { profileFormOptions } from './shared-form'\n\nexport function ProfileForm() {\n  const form = createForm(() => ({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  }))\n\n  return <AddressFields form={form} />\n}\n```\n\n<!-- ::end:tabs -->\n\n# Lit\n\nLit’s `LitFormType` derives a controller type from the shared options. The\nresult keeps the field names and values available to the controller's `field`\nmethod in the extracted render function.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/lit-form'\nimport type { LitFormType } from '@tanstack/lit-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = LitFormType<typeof profileFormOptions>\n```\n\n```ts file=\"address-fields.ts\"\nimport { html } from 'lit'\nimport type { ProfileForm } from './shared-form'\n\nexport function addressFields(form: ProfileForm) {\n  return html`\n    ${form.field(\n      { name: 'address.street' },\n      (field) => html`\n        <input\n          aria-label=\"Street\"\n          .value=${field.value}\n          @input=${(event: InputEvent) =>\n            field.handleChange((event.currentTarget as HTMLInputElement).value)}\n        />\n      `,\n    )}\n    ${form.field(\n      { name: 'address.city' },\n      (field) => html`\n        <input\n          aria-label=\"City\"\n          .value=${field.value}\n          @input=${(event: InputEvent) =>\n            field.handleChange((event.currentTarget as HTMLInputElement).value)}\n        />\n      `,\n    )}\n  `\n}\n```\n\n```ts file=\"profile-form.ts\"\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { TanStackFormController } from '@tanstack/lit-form'\nimport { addressFields } from './address-fields'\nimport { profileFormOptions } from './shared-form'\n\n@customElement('profile-form')\nexport class ProfileForm extends LitElement {\n  private form = new TanStackFormController(this, {\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n\n  render() {\n    return html`${addressFields(this.form)}`\n  }\n}\n```\n\n<!-- ::end:tabs -->\n\n# Svelte\n\nSvelte's `SvelteFormType` derives the form prop from the shared options. The\nresult keeps the field names and values available to `form.Field` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/svelte-form'\nimport type { SvelteFormType } from '@tanstack/svelte-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = SvelteFormType<typeof profileFormOptions>\n```\n\n```svelte file=\"AddressFields.svelte\"\n<script lang=\"ts\">\n  import type { ProfileForm } from './shared-form.js'\n\n  const { form }: { form: ProfileForm } = $props()\n</script>\n\n<form.Field name=\"address.street\">\n  {#snippet children(field)}\n    <input\n      aria-label=\"Street\"\n      value={field.value}\n      oninput={(event) => field.handleChange(event.currentTarget.value)}\n    />\n  {/snippet}\n</form.Field>\n<form.Field name=\"address.city\">\n  {#snippet children(field)}\n    <input\n      aria-label=\"City\"\n      value={field.value}\n      oninput={(event) => field.handleChange(event.currentTarget.value)}\n    />\n  {/snippet}\n</form.Field>\n```\n\n```svelte file=\"ProfileForm.svelte\"\n<script lang=\"ts\">\n  import { createForm } from '@tanstack/svelte-form'\n  import AddressFields from './AddressFields.svelte'\n  import { profileFormOptions } from './shared-form.js'\n\n  const form = createForm(() => ({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  }))\n</script>\n\n<AddressFields {form} />\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n## Extract a field component by value type\n\nAfter splitting the form into sections, you may still have repeated controls\nfor values such as strings, numbers, or dates. These controls don't need to\nknow the form's complete data shape or the path of a particular field. They\nonly need the type of the value they read and update.\n\n`FieldWithValue<T>` describes a field by the value type a reusable component\nhandles. This preserves type checking when the component reads or updates the\nvalue without tying it to a particular field path or form shape.\n\n<!-- ::start:framework -->\n\n# React\n\nType the React component's field prop as `FieldWithValue<string>`, then pass it\nthe field from the `form.Field` render prop.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"TextField.tsx\"\nimport type { FieldWithValue } from '@tanstack/react-form'\n\ninterface TextFieldProps {\n  field: FieldWithValue<string>\n  label: string\n}\n\nexport function TextField({ field, label }: TextFieldProps) {\n  return (\n    <label>\n      <span>{label}</span>\n      <input\n        name={field.name}\n        value={field.value}\n        onBlur={field.handleBlur}\n        onChange={(event) => field.handleChange(event.target.value)}\n      />\n    </label>\n  )\n}\n```\n\n```tsx file=\"NameField.tsx\"\nimport { TextField } from './TextField'\nimport type { ProfileForm } from './shared-form'\n\nexport function NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <TextField field={field} label=\"Name\" />}\n    </form.Field>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Preact\n\nType the Preact component's field prop as `FieldWithValue<string>`, then pass it\nthe field from the `form.Field` render prop.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"TextField.tsx\"\nimport type { FieldWithValue } from '@tanstack/preact-form'\n\ninterface TextFieldProps {\n  field: FieldWithValue<string>\n  label: string\n}\n\nexport function TextField({ field, label }: TextFieldProps) {\n  return (\n    <label>\n      <span>{label}</span>\n      <input\n        name={field.name}\n        value={field.value}\n        onBlur={field.handleBlur}\n        onInput={(event) => field.handleChange(event.currentTarget.value)}\n      />\n    </label>\n  )\n}\n```\n\n```tsx file=\"NameField.tsx\"\nimport { TextField } from './TextField'\nimport type { ProfileForm } from './shared-form'\n\nexport function NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <TextField field={field} label=\"Name\" />}\n    </form.Field>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Vue\n\nType the Vue component's field prop as `FieldWithValue<string>`, then pass it\nthe field from the `form.Field` slot.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```vue file=\"TextField.vue\"\n<script setup lang=\"ts\">\nimport type { FieldWithValue } from '@tanstack/vue-form'\n\ndefineProps<{\n  field: FieldWithValue<string>\n  label: string\n}>()\n</script>\n\n<template>\n  <label>\n    <span>{{ label }}</span>\n    <input\n      :name=\"field.name\"\n      :value=\"field.value\"\n      @blur=\"field.handleBlur\"\n      @input=\"field.handleChange(($event.target as HTMLInputElement).value)\"\n    />\n  </label>\n</template>\n```\n\n```vue file=\"NameField.vue\"\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport TextField from './TextField.vue'\nimport type { ProfileForm } from './shared-form'\n\nconst props = defineProps<{ form: ProfileForm }>()\nconst form = computed(() => props.form)\n</script>\n\n<template>\n  <form.Field name=\"name\" v-slot=\"{ field }\">\n    <TextField :field=\"field\" label=\"Name\" />\n  </form.Field>\n</template>\n```\n\n<!-- ::end:tabs -->\n\n# Angular\n\nAngular field components can declare their value type through\n`injectField<string>()`. The `tanstack-app-field` directive provides the field\nto that component, so it doesn't need a form input of its own.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"text-field.component.ts\"\nimport { ChangeDetectionStrategy, Component, input } from '@angular/core'\nimport { injectField } from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-text-field',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <label>\n      <span>{{ label() }}</span>\n      <input\n        [name]=\"field.api.name\"\n        [value]=\"field.api.value\"\n        (blur)=\"field.api.handleBlur()\"\n        (input)=\"field.api.handleChange($any($event).target.value)\"\n      />\n    </label>\n  `,\n})\nexport class TextFieldComponent {\n  label = input.required<string>()\n  field = injectField<string>()\n}\n```\n\n```ts file=\"name-field.component.ts\"\nimport { ChangeDetectionStrategy, Component, input } from '@angular/core'\nimport { TanStackAppField, TanStackField } from '@tanstack/angular-form'\nimport { TextFieldComponent } from './text-field.component'\nimport type { ProfileForm } from './shared-form'\n\n@Component({\n  selector: 'app-name-field',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [TanStackAppField, TanStackField, TextFieldComponent],\n  template: `\n    <app-text-field\n      tanstack-app-field\n      [tanstackField]=\"form()\"\n      name=\"name\"\n      label=\"Name\"\n    />\n  `,\n})\nexport class NameFieldComponent {\n  form = input.required<ProfileForm>()\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\nSolid's field render prop is an accessor, so the component accepts an\n`Accessor<FieldWithValue<string>>`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"TextField.tsx\"\nimport type { Accessor } from 'solid-js'\nimport type { FieldWithValue } from '@tanstack/solid-form'\n\ninterface TextFieldProps {\n  field: Accessor<FieldWithValue<string>>\n  label: string\n}\n\nexport function TextField(props: TextFieldProps) {\n  return (\n    <label>\n      <span>{props.label}</span>\n      <input\n        name={props.field().name}\n        value={props.field().value}\n        onBlur={props.field().handleBlur}\n        onInput={(event) =>\n          props.field().handleChange(event.currentTarget.value)\n        }\n      />\n    </label>\n  )\n}\n```\n\n```tsx file=\"NameField.tsx\"\nimport { TextField } from './TextField'\nimport type { ProfileForm } from './shared-form'\n\nexport function NameField(props: { form: ProfileForm }) {\n  return (\n    <props.form.Field name=\"name\">\n      {(field) => <TextField field={field} label=\"Name\" />}\n    </props.form.Field>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Lit\n\nType the Lit render helper's field parameter as `FieldWithValue<string>`, then\ncall it from the controller's `field` render callback.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"text-field.ts\"\nimport { html } from 'lit'\nimport type { FieldWithValue } from '@tanstack/lit-form'\n\nexport function textField(field: FieldWithValue<string>, label: string) {\n  return html`\n    <label>\n      <span>${label}</span>\n      <input\n        name=${field.name}\n        .value=${field.value}\n        @blur=${() => field.handleBlur()}\n        @input=${(event: InputEvent) =>\n          field.handleChange((event.currentTarget as HTMLInputElement).value)}\n      />\n    </label>\n  `\n}\n```\n\n```ts file=\"name-field.ts\"\nimport { textField } from './text-field'\nimport type { ProfileForm } from './shared-form'\n\nexport function nameField(form: ProfileForm) {\n  return form.field({ name: 'name' }, (field) => textField(field, 'Name'))\n}\n```\n\n<!-- ::end:tabs -->\n\n# Svelte\n\nType the Svelte component's field prop as `FieldWithValue<string>`, then pass it\nthe field from the `form.Field` snippet.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```svelte file=\"TextField.svelte\"\n<script lang=\"ts\">\n  import type { FieldWithValue } from '@tanstack/svelte-form'\n\n  interface Props {\n    field: FieldWithValue<string>\n    label: string\n  }\n\n  const { field, label }: Props = $props()\n</script>\n\n<label>\n  <span>{label}</span>\n  <input\n    name={field.name}\n    value={field.value}\n    onblur={field.handleBlur}\n    oninput={(event) => field.handleChange(event.currentTarget.value)}\n  />\n</label>\n```\n\n```svelte file=\"NameField.svelte\"\n<script lang=\"ts\">\n  import TextField from './TextField.svelte'\n  import type { ProfileForm } from './shared-form.js'\n\n  const { form }: { form: ProfileForm } = $props()\n</script>\n\n<form.Field name=\"name\">\n  {#snippet children(field)}\n    <TextField {field} label=\"Name\" />\n  {/snippet}\n</form.Field>\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n## Accept any form or field\n\nSome extracted controls behave the same regardless of the form's data. An\nerror display only needs field metadata, while a submit or reset button may\nonly need form state and methods. Giving these controls the concrete\n`ProfileForm` type would couple them to details they don't use.\n\nUse `AnyFieldApi` when a control doesn't depend on the field's value type. For\nform-level controls, use the adapter's `Any*FormApi` type. These types\ndeliberately remove information about values and field paths, so use a concrete\ntype when a component reads either one.\n\n<!-- ::start:framework -->\n\n# React\n\nReact provides `AnyReactFormApi` for form-level components. Pass the field from\n`form.Field` to `FieldErrors`, and pass the form instance to `SubmitButton`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"FieldErrors.tsx\"\nimport type { AnyFieldApi } from '@tanstack/react-form'\n\nexport function FieldErrors({ field }: { field: AnyFieldApi }) {\n  return (\n    <small role=\"alert\" aria-live=\"polite\">\n      {field.errors.map((error) => error.message).join(', ')}\n    </small>\n  )\n}\n```\n\n```tsx file=\"SubmitButton.tsx\"\nimport type { AnyReactFormApi } from '@tanstack/react-form'\n\nexport function SubmitButton({ form }: { form: AnyReactFormApi }) {\n  return (\n    <form.Subscribe\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n    >\n      {([canSubmit, isSubmitting]) => (\n        <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n          {isSubmitting ? 'Submitting...' : 'Submit'}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Preact\n\nPreact provides `AnyPreactFormApi` for form-level components. Pass the field\nfrom `form.Field` to `FieldErrors`, and pass the form instance to\n`SubmitButton`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"FieldErrors.tsx\"\nimport type { AnyFieldApi } from '@tanstack/preact-form'\n\nexport function FieldErrors({ field }: { field: AnyFieldApi }) {\n  return (\n    <small role=\"alert\" aria-live=\"polite\">\n      {field.errors.map((error) => error.message).join(', ')}\n    </small>\n  )\n}\n```\n\n```tsx file=\"SubmitButton.tsx\"\nimport type { AnyPreactFormApi } from '@tanstack/preact-form'\n\nexport function SubmitButton({ form }: { form: AnyPreactFormApi }) {\n  return (\n    <form.Subscribe\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n    >\n      {([canSubmit, isSubmitting]) => (\n        <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n          {isSubmitting ? 'Submitting...' : 'Submit'}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Vue\n\nVue provides `AnyVueFormApi` for form-level components. Pass the field from the\n`form.Field` slot to `FieldErrors`, and pass the form instance to\n`SubmitButton`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```vue file=\"FieldErrors.vue\"\n<script setup lang=\"ts\">\nimport type { AnyFieldApi } from '@tanstack/vue-form'\n\ndefineProps<{ field: AnyFieldApi }>()\n</script>\n\n<template>\n  <small role=\"alert\" aria-live=\"polite\">\n    {{ field.errors.map((error) => error.message).join(', ') }}\n  </small>\n</template>\n```\n\n```vue file=\"SubmitButton.vue\"\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport type { AnyVueFormApi } from '@tanstack/vue-form'\n\nconst props = defineProps<{ form: AnyVueFormApi }>()\nconst form = computed(() => props.form)\n</script>\n\n<template>\n  <form.Subscribe\n    :selector=\"(state) => [state.canSubmit, state.isSubmitting] as const\"\n    v-slot=\"[canSubmit, isSubmitting]\"\n  >\n    <button type=\"submit\" :disabled=\"!canSubmit || isSubmitting\">\n      {{ isSubmitting ? 'Submitting...' : 'Submit' }}\n    </button>\n  </form.Subscribe>\n</template>\n```\n\n<!-- ::end:tabs -->\n\n# Angular\n\nFor a field control that doesn't read the value, use `injectField<unknown>()`\nto receive the field and react to its metadata. Angular provides\n`AnyAngularFormApi` when a separate component only needs form methods.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"field-errors.component.ts\"\nimport { ChangeDetectionStrategy, Component } from '@angular/core'\nimport { injectField } from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-field-errors',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <small role=\"alert\" aria-live=\"polite\">\n      @for (error of field.api.errors; track error) {\n        {{ error.message }}\n      }\n    </small>\n  `,\n})\nexport class FieldErrorsComponent {\n  field = injectField<unknown>()\n}\n```\n\n```ts file=\"reset-button.component.ts\"\nimport { ChangeDetectionStrategy, Component, input } from '@angular/core'\nimport type { AnyAngularFormApi } from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-reset-button',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `<button type=\"button\" (click)=\"form().reset()\">Reset</button>`,\n})\nexport class ResetButtonComponent {\n  form = input.required<AnyAngularFormApi>()\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\nSolid provides `AnySolidFormApi` for form-level components. Its field render\nprop remains an accessor, so `FieldErrors` accepts an\n`Accessor<AnyFieldApi>`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"FieldErrors.tsx\"\nimport type { Accessor } from 'solid-js'\nimport type { AnyFieldApi } from '@tanstack/solid-form'\n\nexport function FieldErrors(props: { field: Accessor<AnyFieldApi> }) {\n  return (\n    <small role=\"alert\" aria-live=\"polite\">\n      {props\n        .field()\n        .errors.map((error) => error.message)\n        .join(', ')}\n    </small>\n  )\n}\n```\n\n```tsx file=\"SubmitButton.tsx\"\nimport type { AnySolidFormApi } from '@tanstack/solid-form'\n\nexport function SubmitButton(props: { form: AnySolidFormApi }) {\n  return (\n    <props.form.Subscribe\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n    >\n      {(state) => (\n        <button type=\"submit\" disabled={!state()[0] || state()[1]}>\n          {state()[1] ? 'Submitting...' : 'Submit'}\n        </button>\n      )}\n    </props.form.Subscribe>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Lit\n\nLit doesn't expose an `AnyLitFormApi` controller type. Use `AnyFieldApi` for a\nfield render helper, or pass the controller's core `form.api` object to a\nhelper typed with `AnyFormApi`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"field-errors.ts\"\nimport { html } from 'lit'\nimport type { AnyFieldApi } from '@tanstack/lit-form'\n\nexport function fieldErrors(field: AnyFieldApi) {\n  return html`\n    <small role=\"alert\" aria-live=\"polite\">\n      ${field.errors.map((error) => error.message).join(', ')}\n    </small>\n  `\n}\n```\n\n```ts file=\"reset-button.ts\"\nimport { html } from 'lit'\nimport type { AnyFormApi } from '@tanstack/lit-form'\n\nexport function resetButton(form: AnyFormApi) {\n  return html`\n    <button type=\"button\" @click=${() => form.reset()}>Reset</button>\n  `\n}\n```\n\n<!-- ::end:tabs -->\n\n# Svelte\n\nSvelte provides `AnySvelteFormApi` for form-level components. Pass the field\nfrom the `form.Field` snippet to `FieldErrors`, and pass the form instance to\n`SubmitButton`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```svelte file=\"FieldErrors.svelte\"\n<script lang=\"ts\">\n  import type { AnyFieldApi } from '@tanstack/svelte-form'\n\n  const { field }: { field: AnyFieldApi } = $props()\n</script>\n\n<small role=\"alert\" aria-live=\"polite\">\n  {field.errors.map((error) => error.message).join(', ')}\n</small>\n```\n\n```svelte file=\"SubmitButton.svelte\"\n<script lang=\"ts\">\n  import type { AnySvelteFormApi } from '@tanstack/svelte-form'\n\n  const { form }: { form: AnySvelteFormApi } = $props()\n</script>\n\n<form.Subscribe\n  selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n>\n  {#snippet children([canSubmit, isSubmitting])}\n    <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n      {isSubmitting ? 'Submitting...' : 'Submit'}\n    </button>\n  {/snippet}\n</form.Subscribe>\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n","originalRawMarkdown":"As a form grows, keeping every field in one component can make the code harder\nto navigate and maintain. You can move related fields into smaller components\nwhile keeping one form instance, but each new component boundary needs a type\nfor the form or field it receives.\n\n## Split a large form into sections\n\nFirst define the form's reusable options with `formOptions`. In this example,\nthe same module also exports a named form type derived from those options. The\nparent can add page-specific options, such as `onSubmit`, when it creates the\nform, while extracted sections can import the same form type.\n\n<!-- ::start:framework -->\n\n# React\n\nReact's `ReactFormType` derives the form prop from the shared options. The\nresult keeps the field names and values available to `form.Field` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/react-form'\nimport type { ReactFormType } from '@tanstack/react-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = ReactFormType<typeof profileFormOptions>\n```\n\n```tsx file=\"AddressFields.tsx\"\nimport type { ProfileForm } from './shared-form'\n\ninterface AddressFieldsProps {\n  form: ProfileForm\n}\n\nexport function AddressFields({ form }: AddressFieldsProps) {\n  return (\n    <>\n      <form.Field name=\"address.street\">\n        {(field) => (\n          <input\n            aria-label=\"Street\"\n            value={field.value}\n            onChange={(event) => field.handleChange(event.target.value)}\n          />\n        )}\n      </form.Field>\n      <form.Field name=\"address.city\">\n        {(field) => (\n          <input\n            aria-label=\"City\"\n            value={field.value}\n            onChange={(event) => field.handleChange(event.target.value)}\n          />\n        )}\n      </form.Field>\n    </>\n  )\n}\n```\n\n```tsx file=\"ProfileForm.tsx\"\nimport { useForm } from '@tanstack/react-form'\nimport { AddressFields } from './AddressFields'\nimport { profileFormOptions } from './shared-form'\n\nexport function ProfileForm() {\n  const form = useForm({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n\n  return <AddressFields form={form} />\n}\n```\n\n<!-- ::end:tabs -->\n\n> [!NOTE] Sharing between forms\n> If the section should work with multiple forms instead of only one, use [field groups](./framework/react/guides/field-groups).\n\n# Preact\n\nPreact's `PreactFormType` derives the form prop from the shared options. The\nresult keeps the field names and values available to `form.Field` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/preact-form'\nimport type { PreactFormType } from '@tanstack/preact-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = PreactFormType<typeof profileFormOptions>\n```\n\n```tsx file=\"AddressFields.tsx\"\nimport type { ProfileForm } from './shared-form'\n\ninterface AddressFieldsProps {\n  form: ProfileForm\n}\n\nexport function AddressFields({ form }: AddressFieldsProps) {\n  return (\n    <>\n      <form.Field name=\"address.street\">\n        {(field) => (\n          <input\n            aria-label=\"Street\"\n            value={field.value}\n            onInput={(event) => field.handleChange(event.currentTarget.value)}\n          />\n        )}\n      </form.Field>\n      <form.Field name=\"address.city\">\n        {(field) => (\n          <input\n            aria-label=\"City\"\n            value={field.value}\n            onInput={(event) => field.handleChange(event.currentTarget.value)}\n          />\n        )}\n      </form.Field>\n    </>\n  )\n}\n```\n\n```tsx file=\"ProfileForm.tsx\"\nimport { useForm } from '@tanstack/preact-form'\nimport { AddressFields } from './AddressFields'\nimport { profileFormOptions } from './shared-form'\n\nexport function ProfileForm() {\n  const form = useForm({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n\n  return <AddressFields form={form} />\n}\n```\n\n<!-- ::end:tabs -->\n\n# Vue\n\nVue's `VueFormType` derives the form prop from the shared options. The result\nkeeps the field names and values available to `form.Field` in the extracted\ncomponent.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/vue-form'\nimport type { VueFormType } from '@tanstack/vue-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = VueFormType<typeof profileFormOptions>\n```\n\n```vue file=\"AddressFields.vue\"\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport type { ProfileForm } from './shared-form'\n\nconst props = defineProps<{\n  form: ProfileForm\n}>()\n\nconst form = computed(() => props.form)\n</script>\n\n<template>\n  <form.Field name=\"address.street\" v-slot=\"{ field }\">\n    <input\n      aria-label=\"Street\"\n      :value=\"field.value\"\n      @input=\"field.handleChange(($event.target as HTMLInputElement).value)\"\n    />\n  </form.Field>\n  <form.Field name=\"address.city\" v-slot=\"{ field }\">\n    <input\n      aria-label=\"City\"\n      :value=\"field.value\"\n      @input=\"field.handleChange(($event.target as HTMLInputElement).value)\"\n    />\n  </form.Field>\n</template>\n```\n\n```vue file=\"ProfileForm.vue\"\n<script setup lang=\"ts\">\nimport { useForm } from '@tanstack/vue-form'\nimport AddressFields from './AddressFields.vue'\nimport { profileFormOptions } from './shared-form'\n\nconst form = useForm({\n  ...profileFormOptions,\n  onSubmit: ({ value }) => console.log(value),\n})\n</script>\n\n<template>\n  <AddressFields :form=\"form\" />\n</template>\n```\n\n<!-- ::end:tabs -->\n\n# Angular\n\nAngular's `AngularFormType` derives the form input from the shared options. The\nresult keeps the field names and values available to `TanStackField` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/angular-form'\nimport type { AngularFormType } from '@tanstack/angular-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = AngularFormType<typeof profileFormOptions>\n```\n\n```ts file=\"address-fields.component.ts\"\nimport { ChangeDetectionStrategy, Component, input } from '@angular/core'\nimport { TanStackField } from '@tanstack/angular-form'\nimport type { ProfileForm } from './shared-form'\n\n@Component({\n  selector: 'app-address-fields',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [TanStackField],\n  template: `\n    <ng-container\n      [tanstackField]=\"form()\"\n      name=\"address.street\"\n      #street=\"field\"\n    >\n      <input\n        aria-label=\"Street\"\n        [value]=\"street.api.value\"\n        (input)=\"street.api.handleChange($any($event).target.value)\"\n      />\n    </ng-container>\n    <ng-container [tanstackField]=\"form()\" name=\"address.city\" #city=\"field\">\n      <input\n        aria-label=\"City\"\n        [value]=\"city.api.value\"\n        (input)=\"city.api.handleChange($any($event).target.value)\"\n      />\n    </ng-container>\n  `,\n})\nexport class AddressFieldsComponent {\n  form = input.required<ProfileForm>()\n}\n```\n\n```ts file=\"profile-form.component.ts\"\nimport { ChangeDetectionStrategy, Component } from '@angular/core'\nimport { injectForm } from '@tanstack/angular-form'\nimport { AddressFieldsComponent } from './address-fields.component'\nimport { profileFormOptions } from './shared-form'\n\n@Component({\n  selector: 'app-profile-form',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [AddressFieldsComponent],\n  template: `<app-address-fields [form]=\"form\" />`,\n})\nexport class ProfileFormComponent {\n  form = injectForm({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\nSolid's `SolidFormType` derives the form prop from the shared options. The\nresult keeps the field names and values available to `form.Field` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/solid-form'\nimport type { SolidFormType } from '@tanstack/solid-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = SolidFormType<typeof profileFormOptions>\n```\n\n```tsx file=\"AddressFields.tsx\"\nimport type { ProfileForm } from './shared-form'\n\ninterface AddressFieldsProps {\n  form: ProfileForm\n}\n\nexport function AddressFields(props: AddressFieldsProps) {\n  return (\n    <>\n      <props.form.Field name=\"address.street\">\n        {(field) => (\n          <input\n            aria-label=\"Street\"\n            value={field().value}\n            onInput={(event) => field().handleChange(event.currentTarget.value)}\n          />\n        )}\n      </props.form.Field>\n      <props.form.Field name=\"address.city\">\n        {(field) => (\n          <input\n            aria-label=\"City\"\n            value={field().value}\n            onInput={(event) => field().handleChange(event.currentTarget.value)}\n          />\n        )}\n      </props.form.Field>\n    </>\n  )\n}\n```\n\n```tsx file=\"ProfileForm.tsx\"\nimport { createForm } from '@tanstack/solid-form'\nimport { AddressFields } from './AddressFields'\nimport { profileFormOptions } from './shared-form'\n\nexport function ProfileForm() {\n  const form = createForm(() => ({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  }))\n\n  return <AddressFields form={form} />\n}\n```\n\n<!-- ::end:tabs -->\n\n# Lit\n\nLit’s `LitFormType` derives a controller type from the shared options. The\nresult keeps the field names and values available to the controller's `field`\nmethod in the extracted render function.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/lit-form'\nimport type { LitFormType } from '@tanstack/lit-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = LitFormType<typeof profileFormOptions>\n```\n\n```ts file=\"address-fields.ts\"\nimport { html } from 'lit'\nimport type { ProfileForm } from './shared-form'\n\nexport function addressFields(form: ProfileForm) {\n  return html`\n    ${form.field(\n      { name: 'address.street' },\n      (field) => html`\n        <input\n          aria-label=\"Street\"\n          .value=${field.value}\n          @input=${(event: InputEvent) =>\n            field.handleChange((event.currentTarget as HTMLInputElement).value)}\n        />\n      `,\n    )}\n    ${form.field(\n      { name: 'address.city' },\n      (field) => html`\n        <input\n          aria-label=\"City\"\n          .value=${field.value}\n          @input=${(event: InputEvent) =>\n            field.handleChange((event.currentTarget as HTMLInputElement).value)}\n        />\n      `,\n    )}\n  `\n}\n```\n\n```ts file=\"profile-form.ts\"\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { TanStackFormController } from '@tanstack/lit-form'\nimport { addressFields } from './address-fields'\nimport { profileFormOptions } from './shared-form'\n\n@customElement('profile-form')\nexport class ProfileForm extends LitElement {\n  private form = new TanStackFormController(this, {\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n\n  render() {\n    return html`${addressFields(this.form)}`\n  }\n}\n```\n\n<!-- ::end:tabs -->\n\n# Svelte\n\nSvelte's `SvelteFormType` derives the form prop from the shared options. The\nresult keeps the field names and values available to `form.Field` in the\nextracted component.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"shared-form.ts\"\nimport { formOptions } from '@tanstack/svelte-form'\nimport type { SvelteFormType } from '@tanstack/svelte-form'\n\nexport const profileFormOptions = formOptions({\n  defaultValues: {\n    name: '',\n    address: {\n      street: '',\n      city: '',\n    },\n  },\n})\n\nexport type ProfileForm = SvelteFormType<typeof profileFormOptions>\n```\n\n```svelte file=\"AddressFields.svelte\"\n<script lang=\"ts\">\n  import type { ProfileForm } from './shared-form.js'\n\n  const { form }: { form: ProfileForm } = $props()\n</script>\n\n<form.Field name=\"address.street\">\n  {#snippet children(field)}\n    <input\n      aria-label=\"Street\"\n      value={field.value}\n      oninput={(event) => field.handleChange(event.currentTarget.value)}\n    />\n  {/snippet}\n</form.Field>\n<form.Field name=\"address.city\">\n  {#snippet children(field)}\n    <input\n      aria-label=\"City\"\n      value={field.value}\n      oninput={(event) => field.handleChange(event.currentTarget.value)}\n    />\n  {/snippet}\n</form.Field>\n```\n\n```svelte file=\"ProfileForm.svelte\"\n<script lang=\"ts\">\n  import { createForm } from '@tanstack/svelte-form'\n  import AddressFields from './AddressFields.svelte'\n  import { profileFormOptions } from './shared-form.js'\n\n  const form = createForm(() => ({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  }))\n</script>\n\n<AddressFields {form} />\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n## Extract a field component by value type\n\nAfter splitting the form into sections, you may still have repeated controls\nfor values such as strings, numbers, or dates. These controls don't need to\nknow the form's complete data shape or the path of a particular field. They\nonly need the type of the value they read and update.\n\n`FieldWithValue<T>` describes a field by the value type a reusable component\nhandles. This preserves type checking when the component reads or updates the\nvalue without tying it to a particular field path or form shape.\n\n<!-- ::start:framework -->\n\n# React\n\nType the React component's field prop as `FieldWithValue<string>`, then pass it\nthe field from the `form.Field` render prop.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"TextField.tsx\"\nimport type { FieldWithValue } from '@tanstack/react-form'\n\ninterface TextFieldProps {\n  field: FieldWithValue<string>\n  label: string\n}\n\nexport function TextField({ field, label }: TextFieldProps) {\n  return (\n    <label>\n      <span>{label}</span>\n      <input\n        name={field.name}\n        value={field.value}\n        onBlur={field.handleBlur}\n        onChange={(event) => field.handleChange(event.target.value)}\n      />\n    </label>\n  )\n}\n```\n\n```tsx file=\"NameField.tsx\"\nimport { TextField } from './TextField'\nimport type { ProfileForm } from './shared-form'\n\nexport function NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <TextField field={field} label=\"Name\" />}\n    </form.Field>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Preact\n\nType the Preact component's field prop as `FieldWithValue<string>`, then pass it\nthe field from the `form.Field` render prop.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"TextField.tsx\"\nimport type { FieldWithValue } from '@tanstack/preact-form'\n\ninterface TextFieldProps {\n  field: FieldWithValue<string>\n  label: string\n}\n\nexport function TextField({ field, label }: TextFieldProps) {\n  return (\n    <label>\n      <span>{label}</span>\n      <input\n        name={field.name}\n        value={field.value}\n        onBlur={field.handleBlur}\n        onInput={(event) => field.handleChange(event.currentTarget.value)}\n      />\n    </label>\n  )\n}\n```\n\n```tsx file=\"NameField.tsx\"\nimport { TextField } from './TextField'\nimport type { ProfileForm } from './shared-form'\n\nexport function NameField({ form }: { form: ProfileForm }) {\n  return (\n    <form.Field name=\"name\">\n      {(field) => <TextField field={field} label=\"Name\" />}\n    </form.Field>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Vue\n\nType the Vue component's field prop as `FieldWithValue<string>`, then pass it\nthe field from the `form.Field` slot.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```vue file=\"TextField.vue\"\n<script setup lang=\"ts\">\nimport type { FieldWithValue } from '@tanstack/vue-form'\n\ndefineProps<{\n  field: FieldWithValue<string>\n  label: string\n}>()\n</script>\n\n<template>\n  <label>\n    <span>{{ label }}</span>\n    <input\n      :name=\"field.name\"\n      :value=\"field.value\"\n      @blur=\"field.handleBlur\"\n      @input=\"field.handleChange(($event.target as HTMLInputElement).value)\"\n    />\n  </label>\n</template>\n```\n\n```vue file=\"NameField.vue\"\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport TextField from './TextField.vue'\nimport type { ProfileForm } from './shared-form'\n\nconst props = defineProps<{ form: ProfileForm }>()\nconst form = computed(() => props.form)\n</script>\n\n<template>\n  <form.Field name=\"name\" v-slot=\"{ field }\">\n    <TextField :field=\"field\" label=\"Name\" />\n  </form.Field>\n</template>\n```\n\n<!-- ::end:tabs -->\n\n# Angular\n\nAngular field components can declare their value type through\n`injectField<string>()`. The `tanstack-app-field` directive provides the field\nto that component, so it doesn't need a form input of its own.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"text-field.component.ts\"\nimport { ChangeDetectionStrategy, Component, input } from '@angular/core'\nimport { injectField } from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-text-field',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <label>\n      <span>{{ label() }}</span>\n      <input\n        [name]=\"field.api.name\"\n        [value]=\"field.api.value\"\n        (blur)=\"field.api.handleBlur()\"\n        (input)=\"field.api.handleChange($any($event).target.value)\"\n      />\n    </label>\n  `,\n})\nexport class TextFieldComponent {\n  label = input.required<string>()\n  field = injectField<string>()\n}\n```\n\n```ts file=\"name-field.component.ts\"\nimport { ChangeDetectionStrategy, Component, input } from '@angular/core'\nimport { TanStackAppField, TanStackField } from '@tanstack/angular-form'\nimport { TextFieldComponent } from './text-field.component'\nimport type { ProfileForm } from './shared-form'\n\n@Component({\n  selector: 'app-name-field',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [TanStackAppField, TanStackField, TextFieldComponent],\n  template: `\n    <app-text-field\n      tanstack-app-field\n      [tanstackField]=\"form()\"\n      name=\"name\"\n      label=\"Name\"\n    />\n  `,\n})\nexport class NameFieldComponent {\n  form = input.required<ProfileForm>()\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\nSolid's field render prop is an accessor, so the component accepts an\n`Accessor<FieldWithValue<string>>`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"TextField.tsx\"\nimport type { Accessor } from 'solid-js'\nimport type { FieldWithValue } from '@tanstack/solid-form'\n\ninterface TextFieldProps {\n  field: Accessor<FieldWithValue<string>>\n  label: string\n}\n\nexport function TextField(props: TextFieldProps) {\n  return (\n    <label>\n      <span>{props.label}</span>\n      <input\n        name={props.field().name}\n        value={props.field().value}\n        onBlur={props.field().handleBlur}\n        onInput={(event) =>\n          props.field().handleChange(event.currentTarget.value)\n        }\n      />\n    </label>\n  )\n}\n```\n\n```tsx file=\"NameField.tsx\"\nimport { TextField } from './TextField'\nimport type { ProfileForm } from './shared-form'\n\nexport function NameField(props: { form: ProfileForm }) {\n  return (\n    <props.form.Field name=\"name\">\n      {(field) => <TextField field={field} label=\"Name\" />}\n    </props.form.Field>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Lit\n\nType the Lit render helper's field parameter as `FieldWithValue<string>`, then\ncall it from the controller's `field` render callback.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"text-field.ts\"\nimport { html } from 'lit'\nimport type { FieldWithValue } from '@tanstack/lit-form'\n\nexport function textField(field: FieldWithValue<string>, label: string) {\n  return html`\n    <label>\n      <span>${label}</span>\n      <input\n        name=${field.name}\n        .value=${field.value}\n        @blur=${() => field.handleBlur()}\n        @input=${(event: InputEvent) =>\n          field.handleChange((event.currentTarget as HTMLInputElement).value)}\n      />\n    </label>\n  `\n}\n```\n\n```ts file=\"name-field.ts\"\nimport { textField } from './text-field'\nimport type { ProfileForm } from './shared-form'\n\nexport function nameField(form: ProfileForm) {\n  return form.field({ name: 'name' }, (field) => textField(field, 'Name'))\n}\n```\n\n<!-- ::end:tabs -->\n\n# Svelte\n\nType the Svelte component's field prop as `FieldWithValue<string>`, then pass it\nthe field from the `form.Field` snippet.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```svelte file=\"TextField.svelte\"\n<script lang=\"ts\">\n  import type { FieldWithValue } from '@tanstack/svelte-form'\n\n  interface Props {\n    field: FieldWithValue<string>\n    label: string\n  }\n\n  const { field, label }: Props = $props()\n</script>\n\n<label>\n  <span>{label}</span>\n  <input\n    name={field.name}\n    value={field.value}\n    onblur={field.handleBlur}\n    oninput={(event) => field.handleChange(event.currentTarget.value)}\n  />\n</label>\n```\n\n```svelte file=\"NameField.svelte\"\n<script lang=\"ts\">\n  import TextField from './TextField.svelte'\n  import type { ProfileForm } from './shared-form.js'\n\n  const { form }: { form: ProfileForm } = $props()\n</script>\n\n<form.Field name=\"name\">\n  {#snippet children(field)}\n    <TextField {field} label=\"Name\" />\n  {/snippet}\n</form.Field>\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n## Accept any form or field\n\nSome extracted controls behave the same regardless of the form's data. An\nerror display only needs field metadata, while a submit or reset button may\nonly need form state and methods. Giving these controls the concrete\n`ProfileForm` type would couple them to details they don't use.\n\nUse `AnyFieldApi` when a control doesn't depend on the field's value type. For\nform-level controls, use the adapter's `Any*FormApi` type. These types\ndeliberately remove information about values and field paths, so use a concrete\ntype when a component reads either one.\n\n<!-- ::start:framework -->\n\n# React\n\nReact provides `AnyReactFormApi` for form-level components. Pass the field from\n`form.Field` to `FieldErrors`, and pass the form instance to `SubmitButton`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"FieldErrors.tsx\"\nimport type { AnyFieldApi } from '@tanstack/react-form'\n\nexport function FieldErrors({ field }: { field: AnyFieldApi }) {\n  return (\n    <small role=\"alert\" aria-live=\"polite\">\n      {field.errors.map((error) => error.message).join(', ')}\n    </small>\n  )\n}\n```\n\n```tsx file=\"SubmitButton.tsx\"\nimport type { AnyReactFormApi } from '@tanstack/react-form'\n\nexport function SubmitButton({ form }: { form: AnyReactFormApi }) {\n  return (\n    <form.Subscribe\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n    >\n      {([canSubmit, isSubmitting]) => (\n        <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n          {isSubmitting ? 'Submitting...' : 'Submit'}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Preact\n\nPreact provides `AnyPreactFormApi` for form-level components. Pass the field\nfrom `form.Field` to `FieldErrors`, and pass the form instance to\n`SubmitButton`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"FieldErrors.tsx\"\nimport type { AnyFieldApi } from '@tanstack/preact-form'\n\nexport function FieldErrors({ field }: { field: AnyFieldApi }) {\n  return (\n    <small role=\"alert\" aria-live=\"polite\">\n      {field.errors.map((error) => error.message).join(', ')}\n    </small>\n  )\n}\n```\n\n```tsx file=\"SubmitButton.tsx\"\nimport type { AnyPreactFormApi } from '@tanstack/preact-form'\n\nexport function SubmitButton({ form }: { form: AnyPreactFormApi }) {\n  return (\n    <form.Subscribe\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n    >\n      {([canSubmit, isSubmitting]) => (\n        <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n          {isSubmitting ? 'Submitting...' : 'Submit'}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Vue\n\nVue provides `AnyVueFormApi` for form-level components. Pass the field from the\n`form.Field` slot to `FieldErrors`, and pass the form instance to\n`SubmitButton`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```vue file=\"FieldErrors.vue\"\n<script setup lang=\"ts\">\nimport type { AnyFieldApi } from '@tanstack/vue-form'\n\ndefineProps<{ field: AnyFieldApi }>()\n</script>\n\n<template>\n  <small role=\"alert\" aria-live=\"polite\">\n    {{ field.errors.map((error) => error.message).join(', ') }}\n  </small>\n</template>\n```\n\n```vue file=\"SubmitButton.vue\"\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport type { AnyVueFormApi } from '@tanstack/vue-form'\n\nconst props = defineProps<{ form: AnyVueFormApi }>()\nconst form = computed(() => props.form)\n</script>\n\n<template>\n  <form.Subscribe\n    :selector=\"(state) => [state.canSubmit, state.isSubmitting] as const\"\n    v-slot=\"[canSubmit, isSubmitting]\"\n  >\n    <button type=\"submit\" :disabled=\"!canSubmit || isSubmitting\">\n      {{ isSubmitting ? 'Submitting...' : 'Submit' }}\n    </button>\n  </form.Subscribe>\n</template>\n```\n\n<!-- ::end:tabs -->\n\n# Angular\n\nFor a field control that doesn't read the value, use `injectField<unknown>()`\nto receive the field and react to its metadata. Angular provides\n`AnyAngularFormApi` when a separate component only needs form methods.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"field-errors.component.ts\"\nimport { ChangeDetectionStrategy, Component } from '@angular/core'\nimport { injectField } from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-field-errors',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `\n    <small role=\"alert\" aria-live=\"polite\">\n      @for (error of field.api.errors; track error) {\n        {{ error.message }}\n      }\n    </small>\n  `,\n})\nexport class FieldErrorsComponent {\n  field = injectField<unknown>()\n}\n```\n\n```ts file=\"reset-button.component.ts\"\nimport { ChangeDetectionStrategy, Component, input } from '@angular/core'\nimport type { AnyAngularFormApi } from '@tanstack/angular-form'\n\n@Component({\n  selector: 'app-reset-button',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  template: `<button type=\"button\" (click)=\"form().reset()\">Reset</button>`,\n})\nexport class ResetButtonComponent {\n  form = input.required<AnyAngularFormApi>()\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\nSolid provides `AnySolidFormApi` for form-level components. Its field render\nprop remains an accessor, so `FieldErrors` accepts an\n`Accessor<AnyFieldApi>`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx file=\"FieldErrors.tsx\"\nimport type { Accessor } from 'solid-js'\nimport type { AnyFieldApi } from '@tanstack/solid-form'\n\nexport function FieldErrors(props: { field: Accessor<AnyFieldApi> }) {\n  return (\n    <small role=\"alert\" aria-live=\"polite\">\n      {props\n        .field()\n        .errors.map((error) => error.message)\n        .join(', ')}\n    </small>\n  )\n}\n```\n\n```tsx file=\"SubmitButton.tsx\"\nimport type { AnySolidFormApi } from '@tanstack/solid-form'\n\nexport function SubmitButton(props: { form: AnySolidFormApi }) {\n  return (\n    <props.form.Subscribe\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n    >\n      {(state) => (\n        <button type=\"submit\" disabled={!state()[0] || state()[1]}>\n          {state()[1] ? 'Submitting...' : 'Submit'}\n        </button>\n      )}\n    </props.form.Subscribe>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Lit\n\nLit doesn't expose an `AnyLitFormApi` controller type. Use `AnyFieldApi` for a\nfield render helper, or pass the controller's core `form.api` object to a\nhelper typed with `AnyFormApi`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```ts file=\"field-errors.ts\"\nimport { html } from 'lit'\nimport type { AnyFieldApi } from '@tanstack/lit-form'\n\nexport function fieldErrors(field: AnyFieldApi) {\n  return html`\n    <small role=\"alert\" aria-live=\"polite\">\n      ${field.errors.map((error) => error.message).join(', ')}\n    </small>\n  `\n}\n```\n\n```ts file=\"reset-button.ts\"\nimport { html } from 'lit'\nimport type { AnyFormApi } from '@tanstack/lit-form'\n\nexport function resetButton(form: AnyFormApi) {\n  return html`\n    <button type=\"button\" @click=${() => form.reset()}>Reset</button>\n  `\n}\n```\n\n<!-- ::end:tabs -->\n\n# Svelte\n\nSvelte provides `AnySvelteFormApi` for form-level components. Pass the field\nfrom the `form.Field` snippet to `FieldErrors`, and pass the form instance to\n`SubmitButton`.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```svelte file=\"FieldErrors.svelte\"\n<script lang=\"ts\">\n  import type { AnyFieldApi } from '@tanstack/svelte-form'\n\n  const { field }: { field: AnyFieldApi } = $props()\n</script>\n\n<small role=\"alert\" aria-live=\"polite\">\n  {field.errors.map((error) => error.message).join(', ')}\n</small>\n```\n\n```svelte file=\"SubmitButton.svelte\"\n<script lang=\"ts\">\n  import type { AnySvelteFormApi } from '@tanstack/svelte-form'\n\n  const { form }: { form: AnySvelteFormApi } = $props()\n</script>\n\n<form.Subscribe\n  selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n>\n  {#snippet children([canSubmit, isSubmitting])}\n    <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n      {isSubmitting ? 'Submitting...' : 'Submit'}\n    </button>\n  {/snippet}\n</form.Subscribe>\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n"}
