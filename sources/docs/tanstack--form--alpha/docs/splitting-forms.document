],\"svelte\":[]}}"}},{"type":"heading","depth":2,"id":"accept-any-form-or-field","children":[{"type":"text","value":"Accept any form or field"}]},{"type":"paragraph","children":[{"type":"text","value":"Some extracted controls behave the same regardless of the form's data. An\nerror display only needs field metadata, while a submit or reset button may\nonly need form state and methods. Giving these controls the concrete\n"},{"type":"inlineCode","value":"ProfileForm"},{"type":"text","value":" type would couple them to details they don't use."}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"AnyFieldApi"},{"type":"text","value":" when a control doesn't depend on the field's value type. For\nform-level controls, use the adapter's "},{"type":"inlineCode","value":"Any*FormApi"},{"type":"text","value":" type. These types\ndeliberately remove information about values and field paths, so use a concrete\ntype when a component reads either one."}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"paragraph","children":[{"type":"text","value":"React provides "},{"type":"inlineCode","value":"AnyReactFormApi"},{"type":"text","value":" for form-level components. Pass the field from\n"},{"type":"inlineCode","value":"form.Field"},{"type":"text","value":" to "},{"type":"inlineCode","value":"FieldErrors"},{"type":"text","value":", and pass the form instance to "},{"type":"inlineCode","value":"SubmitButton"},{"type":"text","value":"."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import type { AnyFieldApi } from '@tanstack/react-form'\n\nexport function FieldErrors({ field }: { field: AnyFieldApi }) {\n  return (\n    <small role=\"alert\" aria-live=\"polite\">\n      {field.errors.map((error) => error.message).join(', ')}\n    </small>\n  )\n}","lang":"tsx","meta":"file=\"FieldErrors.tsx\"","title":"FieldErrors.tsx","file":"FieldErrors.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"import type { AnyReactFormApi } from '@tanstack/react-form'\n\nexport function SubmitButton({ form }: { form: AnyReactFormApi }) {\n  return (\n    <form.Subscribe\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\n    >\n      {([canSubmit, isSubmitting]) => (\n        <button type=\"submit\" disabled={!canSubmit || isSubmitting}>\n          {isSubmitting ? 'Submitting...' : 'Submit'}\n        </button>\n      )}\n    </form.Subscribe>\n  )\n}","lang":"tsx","meta":"file=\"SubmitButton.tsx\"","title":"SubmitButton.tsx","file":"SubmitButton.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"FieldErrors.tsx\"},{\"slug\":\"file-1\",\"name\":\"SubmitButton.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"FieldErrors.tsx\",\"code\":\"import type { AnyFieldApi } from '@tanstack/react-form'\\n\\nexport function FieldErrors({ field }: { field: AnyFieldApi }) {\\n  return (\\n    <small role=\\\"alert\\\" aria-live=\\\"polite\\\">\\n      {field.errors.map((error) => error.message).join(', ')}\\n    </small>\\n  )\\n}\",\"language\":\"tsx\"},{\"title\":\"SubmitButton.tsx\",\"code\":\"import type { AnyReactFormApi } from '@tanstack/react-form'\\n\\nexport function SubmitButton({ form }: { form: AnyReactFormApi }) {\\n  return (\\n    <form.Subscribe\\n      selector={(state) => [state.canSubmit, state.isSubmitting] as const}\\n    >\\n      {([canSubmit, isSubmitting]) => (\\n        <button type=\\\"submit\\\" disabled={!canSubmit || isSubmitting}>\\n    