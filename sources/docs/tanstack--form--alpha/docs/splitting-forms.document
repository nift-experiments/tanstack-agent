   </ng-container>\n  `,\n})\nexport class AddressFieldsComponent {\n  form = input.required<ProfileForm>()\n}","lang":"ts","meta":"file=\"address-fields.component.ts\"","title":"address-fields.component.ts","file":"address-fields.component.ts"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-2","data-tab-index":"2"},"children":[{"type":"code","value":"import { ChangeDetectionStrategy, Component } from '@angular/core'\nimport { injectForm } from '@tanstack/angular-form'\nimport { AddressFieldsComponent } from './address-fields.component'\nimport { profileFormOptions } from './shared-form'\n\n@Component({\n  selector: 'app-profile-form',\n  standalone: true,\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  imports: [AddressFieldsComponent],\n  template: `<app-address-fields [form]=\"form\" />`,\n})\nexport class ProfileFormComponent {\n  form = injectForm({\n    ...profileFormOptions,\n    onSubmit: ({ value }) => console.log(value),\n  })\n}","lang":"ts","meta":"file=\"profile-form.component.ts\"","title":"profile-form.component.ts","file":"profile-form.component.ts"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"shared-form.ts\"},{\"slug\":\"file-1\",\"name\":\"address-fields.component.ts\"},{\"slug\":\"file-2\",\"name\":\"profile-form.component.ts\"}]}","data-files-meta":"{\"files\":[{\"title\":\"shared-form.ts\",\"code\":\"import { formOptions } from '@tanstack/angular-form'\\nimport type { AngularFormType } from '@tanstack/angular-form'\\n\\nexport const profileFormOptions = formOptions({\\n  defaultValues: {\\n    name: '',\\n    address: {\\n      street: '',\\n      city: '',\\n    },\\n  },\\n})\\n\\nexport type ProfileForm = AngularFormType<typeof profileFormOptions>\",\"language\":\"ts\"},{\"title\":\"address-fields.component.ts\",\"code\":\"import { ChangeDetectionStrategy, Component, input } from '@angular/core'\\nimport { TanStackField } from '@t