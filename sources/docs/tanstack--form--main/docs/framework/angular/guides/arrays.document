id: arrays
title: Arrays
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack Form supports arrays as values in a form, including sub-object values inside of an array."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"paragraph","children":[{"type":"text","value":"To use an array, you can use "},{"type":"inlineCode","value":"field.api.state.value"},{"type":"text","value":" on an array value:"}]},{"type":"code","value":"@Component({\n  selector: 'app-root',\n  standalone: true,\n  imports: [TanStackField],\n  template: `\n    <ng-container\n      [tanstackField]=\"form\"\n      name=\"people\"\n      mode=\"array\"\n      #people=\"field\"\n    >\n      <div>\n        @for (_ of people.api.state.value; track $index) {\n          <!-- ... -->\n        }\n      </div>\n    </ng-container>\n  `,\n})\nexport class AppComponent {\n  form = injectForm({\n    defaultValues: {\n      people: [] as Array<{ name: string; age: number }>,\n    },\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"text","value":"This will generate the mapped JSX every time you run "},{"type":"inlineCode","value":"pushValue"},{"type":"text","value":" on "},{"type":"inlineCode","value":"field"},{"type":"text","value":":"}]},{"type":"code","value":"<button (click)=\"people.api.pushValue(defaultPerson)\" type=\"button\">\n  Add person\n</button>","lang":"angular-html"},{"type":"paragraph","children":[{"type":"text","value":"Finally, you can use a subfield like so:"}]},{"type":"code","value":"<ng-container\n  [tanstackField]=\"form\"\n  [name]=\"getPeopleName($index)\"\n  #person=\"field\"\n>\n  <div>\n    <label>\n      <div>Name for person {{ $index }}</div>\n      <input\n        [value]=\"person.api.state.value\"\n        (input)=\"person.api.handleChange($any($event).target.value)\"\n      />\n    </label>\n  </div>\n</ng-container>","lang":"angular-html"},{"type":"paragraph","children":[{"type":"text","value":"Where "},{"type":"inlineCode","value":"getPeopleName"},{"type":"text","value":" is a method on the class like so:"}]},{"type":"code","value":"export class AppComponent {\n  getPeopleName = (idx: number) => `people[${idx}].name` as const\n\n  // ...\n}","lang":"typescript"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"While it's unfortunate that you need to use a function to get the field name, it's a requirement for how our strict TypeScript types work."}]},{"type":"paragraph","children":[{"type":"text","value":"See, if we did the following:"}]},{"type":"code","value":"<ng-container\n  [tanstackField]=\"form\"\n  [name]=\"'people[' + $index + '].name'\"\n></ng-container>","lang":"angular-html"},{"type":"paragraph","children":[{"type":"text","value":"We'd be running into a TypeScript issue where "},{"type":"inlineCode","value":"\"one\" + \"two\""},{"type":"text","value":" is "},{"type":"inlineCode","value":"string"},{"type":"text","value":" rather than the required "},{"type":"inlineCode","value":"\"onetwo\""},{"type":"text","value":" type"}]},{"type":"paragraph","children":[{"type":"text","value":"Moreover, while Angular supports template literals in the template, they may not contain dynamic interpolation within them, such as our "},{"type":"inlineCode","value":"$index"},{"type":"text","value":" argument."}]},{"type":"paragraph","children":[{"type":"text","value":"It's possible that we've missed something! If you can think of a better fix for this problem, "},{"type":"link","href":"https://github.com/TanStack/form/discussions","children":[{"type":"text","value":"drop us a line on our GitHub discussions"}]},{"type":"text","value":"."}]}]},{"type":"heading","depth":2,"id":"full-example","children":[{"type":"text","value":"Full Example"}]},{"type":"code","value":"@Component({\n  selector: 'app-root',\n  standalone: true,\n  imports: [TanStackField],\n  template: `\n    <form (submit)=\"handleSubmit($event)\">\n      <div>\n        <ng-container\n          [tanstackField]=\"form\"\n          name=\"people\"\n          mode=\"array\"\n          #people=\"field\"\n        >\n          <div>\n            @for (_ of people.api.state.value; track $index) {\n              <ng-container\n                [tanstackField]=\"form\"\n                [name]=\"getPeopleName($index)\"\n                #person=\"field\"\n              >\n                <div>\n                  <label>\n                    <div>Name for person {{ $index }}</div>\n                    <input\n                      [value]=\"person.api.state.value\"\n                      (input)=\"\n                        person.api.handleChange($any($event).target.value)\n                      \"\n                    />\n                  </label>\n                </div>\n              </ng-container>\n            }\n          </div>\n          <button (click)=\"people.api.pushValue(defaultPerson)\" type=\"button\">\n            Add person\n          </button>\n        </ng-container>\n      </div>\n      <button type=\"submit\" [disabled]=\"!canSubmit()\">\n        {{ isSubmitting() ? '...' : 'Submit' }}\n      </button>\n    </form>\n  `,\n})\nexport class AppComponent {\n  defaultPerson = { name: '', age: 0 }\n\n  form = injectForm({\n    defaultValues: {\n      people: [] as Array<{ name: string; age: number }>,\n    },\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n\n  getPeopleName = (idx: number) => `people[${idx}].name` as const\n\n  canSubmit = injectStore(this.form, (state) => state.canSubmit)\n  isSubmitting = injectStore(this.form, (state) => state.isSubmitting)\n\n  handleSubmit(event: SubmitEvent) {\n    event.preventDefault()\n    event.stopPropagation()\n    this.form.handleSubmit()\n  }\n}","lang":"angular-ts"}],"headings":[{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"full-example","text":"Full Example","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Form supports arrays as values in a form, including sub-object values inside of an array.\n\n## Basic Usage\n\nTo use an array, you can use `field.api.state.value` on an array value:\n\n```angular-ts\n@Component({\n  selector: 'app-root',\n  standalone: true,\n  imports: [TanStackField],\n  template: `\n    <ng-container\n      [tanstackField]=\"form\"\n      name=\"people\"\n      mode=\"array\"\n      #people=\"field\"\n    >\n      <div>\n        @for (_ of people.api.state.value; track $index) {\n          <!-- ... -->\n        }\n      </div>\n    </ng-container>\n  `,\n})\nexport class AppComponent {\n  form = injectForm({\n    defaultValues: {\n      people: [] as Array<{ name: string; age: number }>,\n    },\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n}\n```\n\nThis will generate the mapped JSX every time you run `pushValue` on `field`:\n\n```angular-html\n<button (click)=\"people.api.pushValue(defaultPerson)\" type=\"button\">\n  Add person\n</button>\n```\n\nFinally, you can use a subfield like so:\n\n```angular-html\n<ng-container\n  [tanstackField]=\"form\"\n  [name]=\"getPeopleName($index)\"\n  #person=\"field\"\n>\n  <div>\n    <label>\n      <div>Name for person {{ $index }}</div>\n      <input\n        [value]=\"person.api.state.value\"\n        (input)=\"person.api.handleChange($any($event).target.value)\"\n      />\n    </label>\n  </div>\n</ng-container>\n```\n\nWhere `getPeopleName` is a method on the class like so:\n\n```typescript\nexport class AppComponent {\n  getPeopleName = (idx: number) => `people[${idx}].name` as const\n\n  // ...\n}\n```\n\n> While it's unfortunate that you need to use a function to get the field name, it's a requirement for how our strict TypeScript types work.\n>\n> See, if we did the following:\n>\n> ```angular-html\n> <ng-container\n>   [tanstackField]=\"form\"\n>   [name]=\"'people[' + $index + '].name'\"\n> ></ng-container>\n> ```\n>\n> We'd be running into a TypeScript issue where `\"one\" + \"two\"` is `string` rather than the required `\"onetwo\"` type\n>\n> Moreover, while Angular supports template literals in the template, they may not contain dynamic interpolation within them, such as our `$index` argument.\n\n> It's possible that we've missed something! If you can think of a better fix for this problem, [drop us a line on our GitHub discussions](https://github.com/TanStack/form/discussions).\n\n## Full Example\n\n```angular-ts\n@Component({\n  selector: 'app-root',\n  standalone: true,\n  imports: [TanStackField],\n  template: `\n    <form (submit)=\"handleSubmit($event)\">\n      <div>\n        <ng-container\n          [tanstackField]=\"form\"\n          name=\"people\"\n          mode=\"array\"\n          #people=\"field\"\n        >\n          <div>\n            @for (_ of people.api.state.value; track $index) {\n              <ng-container\n                [tanstackField]=\"form\"\n                [name]=\"getPeopleName($index)\"\n                #person=\"field\"\n              >\n                <div>\n                  <label>\n                    <div>Name for person {{ $index }}</div>\n                    <input\n                      [value]=\"person.api.state.value\"\n                      (input)=\"\n                        person.api.handleChange($any($event).target.value)\n                      \"\n                    />\n                  </label>\n                </div>\n              </ng-container>\n            }\n          </div>\n          <button (click)=\"people.api.pushValue(defaultPerson)\" type=\"button\">\n            Add person\n          </button>\n        </ng-container>\n      </div>\n      <button type=\"submit\" [disabled]=\"!canSubmit()\">\n        {{ isSubmitting() ? '...' : 'Submit' }}\n      </button>\n    </form>\n  `,\n})\nexport class AppComponent {\n  defaultPerson = { name: '', age: 0 }\n\n  form = injectForm({\n    defaultValues: {\n      people: [] as Array<{ name: string; age: number }>,\n    },\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n\n  getPeopleName = (idx: number) => `people[${idx}].name` as const\n\n  canSubmit = injectStore(this.form, (state) => state.canSubmit)\n  isSubmitting = injectStore(this.form, (state) => state.isSubmitting)\n\n  handleSubmit(event: SubmitEvent) {\n    event.preventDefault()\n    event.stopPropagation()\n    this.form.handleSubmit()\n  }\n}\n```\n","originalRawMarkdown":"---\nid: arrays\ntitle: Arrays\n---\n\nTanStack Form supports arrays as values in a form, including sub-object values inside of an array.\n\n## Basic Usage\n\nTo use an array, you can use `field.api.state.value` on an array value:\n\n```angular-ts\n@Component({\n  selector: 'app-root',\n  standalone: true,\n  imports: [TanStackField],\n  template: `\n    <ng-container\n      [tanstackField]=\"form\"\n      name=\"people\"\n      mode=\"array\"\n      #people=\"field\"\n    >\n      <div>\n        @for (_ of people.api.state.value; track $index) {\n          <!-- ... -->\n        }\n      </div>\n    </ng-container>\n  `,\n})\nexport class AppComponent {\n  form = injectForm({\n    defaultValues: {\n      people: [] as Array<{ name: string; age: number }>,\n    },\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n}\n```\n\nThis will generate the mapped JSX every time you run `pushValue` on `field`:\n\n```angular-html\n<button (click)=\"people.api.pushValue(defaultPerson)\" type=\"button\">\n  Add person\n</button>\n```\n\nFinally, you can use a subfield like so:\n\n```angular-html\n<ng-container\n  [tanstackField]=\"form\"\n  [name]=\"getPeopleName($index)\"\n  #person=\"field\"\n>\n  <div>\n    <label>\n      <div>Name for person {{ $index }}</div>\n      <input\n        [value]=\"person.api.state.value\"\n        (input)=\"person.api.handleChange($any($event).target.value)\"\n      />\n    </label>\n  </div>\n</ng-container>\n```\n\nWhere `getPeopleName` is a method on the class like so:\n\n```typescript\nexport class AppComponent {\n  getPeopleName = (idx: number) => `people[${idx}].name` as const\n\n  // ...\n}\n```\n\n> While it's unfortunate that you need to use a function to get the field name, it's a requirement for how our strict TypeScript types work.\n>\n> See, if we did the following:\n>\n> ```angular-html\n> <ng-container\n>   [tanstackField]=\"form\"\n>   [name]=\"'people[' + $index + '].name'\"\n> ></ng-container>\n> ```\n>\n> We'd be running into a TypeScript issue where `\"one\" + \"two\"` is `string` rather than the required `\"onetwo\"` type\n>\n> Moreover, while Angular supports template literals in the template, they may not contain dynamic interpolation within them, such as our `$index` argument.\n\n> It's possible that we've missed something! If you can think of a better fix for this problem, [drop us a line on our GitHub discussions](https://github.com/TanStack/form/discussions).\n\n## Full Example\n\n```angular-ts\n@Component({\n  selector: 'app-root',\n  standalone: true,\n  imports: [TanStackField],\n  template: `\n    <form (submit)=\"handleSubmit($event)\">\n      <div>\n        <ng-container\n          [tanstackField]=\"form\"\n          name=\"people\"\n          mode=\"array\"\n          #people=\"field\"\n        >\n          <div>\n            @for (_ of people.api.state.value; track $index) {\n              <ng-container\n                [tanstackField]=\"form\"\n                [name]=\"getPeopleName($index)\"\n                #person=\"field\"\n              >\n                <div>\n                  <label>\n                    <div>Name for person {{ $index }}</div>\n                    <input\n                      [value]=\"person.api.state.value\"\n                      (input)=\"\n                        person.api.handleChange($any($event).target.value)\n                      \"\n                    />\n                  </label>\n                </div>\n              </ng-container>\n            }\n          </div>\n          <button (click)=\"people.api.pushValue(defaultPerson)\" type=\"button\">\n            Add person\n          </button>\n        </ng-container>\n      </div>\n      <button type=\"submit\" [disabled]=\"!canSubmit()\">\n        {{ isSubmitting() ? '...' : 'Submit' }}\n      </button>\n    </form>\n  `,\n})\nexport class AppComponent {\n  defaultPerson = { name: '', age: 0 }\n\n  form = injectForm({\n    defaultValues: {\n      people: [] as Array<{ name: string; age: number }>,\n    },\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n\n  getPeopleName = (idx: number) => `people[${idx}].name` as const\n\n  canSubmit = injectStore(this.form, (state) => state.canSubmit)\n  isSubmitting = injectStore(this.form, (state) => state.isSubmitting)\n\n  handleSubmit(event: SubmitEvent) {\n    event.preventDefault()\n    event.stopPropagation()\n    this.form.handleSubmit()\n  }\n}\n```\n"}
