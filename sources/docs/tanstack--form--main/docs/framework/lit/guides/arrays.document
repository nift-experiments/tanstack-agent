NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack Form supports arrays as values in a form, including sub-object values inside of an array."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"paragraph","children":[{"type":"text","value":"To use an array, you can use "},{"type":"inlineCode","value":"field.state.value"},{"type":"text","value":" on an array value, as in:"}]},{"type":"code","value":"export class TestForm extends LitElement {\n  #form = new TanStackFormController(this, {\n    defaultValues: {\n      people: [] as Array<{ name: string; age: string }>,\n    },\n  })\n  render() {\n    return html`\n      <form\n        id=\"form\"\n        @submit=${(e: Event) => {\n          e.preventDefault()\n        }}\n      >\n        <h1>Please enter your details</h1>\n        ${this.#form.field(\n          {\n            name: `people`,\n          },\n          (peopleField) => {\n            return html`${repeat(\n              peopleField.state.value,\n              (_, index) => index,\n              (_, index) => {\n                return html` // ... `\n              },\n            )} `\n          },\n        )}\n      </form>\n    `\n  }\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"This will generate the mapped HTML every time you run pushValue on the field:"}]},{"type":"code","value":"<div class=\"container\">\n  <button type=\"button\" @click=\"${()\" =\"\">\n    { peopleField.pushValue({name: \"\",age: \"\"}) }}> Add Person\n  </button>\n</div>","lang":"html"},{"type":"paragraph","children":[{"type":"text","value":"Finally, you can use a subfield like so:"}]},{"type":"code","value":"return html`\n  ${this.#form.field(\n    {\n      name: `people[${index}].name`,\n    },\n    (field) => {\n      return html`\n        <input\n          type=\"text\"\n          placeholder=\"Name\"\n          .value=\"${field.state.value}\"\n          @input=\"${(e: Event) => {\n            const target = e.target as HTMLInputElement\n            field.handleChange(target.value)\n          }}\"\n        />\n      `\n    },\n  )}\n`","lang":"ts"},{"type":"heading","depth":2,"id":"full-example","children":[{"type":"text","value":"Full Example"}]},{"type":"code","value":"export class TestForm extends LitElement {\n  #form = new TanStackFormController(this, {\n    defaultValues: {\n      people: [] as Array<{ name: string }>,\n    },\n  });\n  render() {\n    return html`\n      <form\n        id=\"form\"\n        @submit=${(e: Event) => {\n          e.preventDefault();\n        }}\n      >\n        <h1>Please enter your details</h1>\n        ${this.#form.field(\n          {\n            name: `people`,\n          },\n          (peopleField) => {\n            return html`${repeat(\n                peopleField.state.value,\n                (_, index) => index,\n                (_, index) => {\n                  return html`\n                    ${this.#form.field(\n                      {\n                        name: `people[${index}].name`,\n                      },\n                      (field) => {\n                        return html` <div>\n                          <div class=\"container\">\n                            <label>Name</label>\n                            <input\n                              type=\"text\"\n                              placeholder=\"Name\"\n                              .value=\"${field.state.value}\"\n                              @input=\"${(e: Event) => {\n                                const target = e.target as HTMLInputElement;\n                                field.handleChange(target.value);\n                              }}\"\n                            />\n                          </div>\n                        </div>`;\n                      }\n                    )}\n                  `;\n                }\n              )}\n\n              <div class=\"container\">\n                <button\n                  type=\"button\"\n                  @click=${() => {\n                    peopleField.pushValue({\n                      name: \"\",\n                    });\n                  }}\n                >\n                  Add Person\n                </button>\n              </div> `;\n          }\n        )}\n\n        <div class=\"container\">\n          <button type=\"submit\" ?disabled=${this.#form.api.state.isSubmitting}>\n            ${this.#form.api.state.isSubmitting ? html` Submitting` : \"Submit\"}\n          </button>\n          <button\n            type=\"button\"\n            id=\"reset\"\n            @click=${() => {\n              this.#form.api.reset();\n            }}\n          >\n            Reset\n          </button>\n        </div>\n      </form>\n    `;\n  }\n\ndeclare global {\n  interface HTMLElementTagNameMap {\n    \"test-form\": TestForm;\n  }\n}","lang":"typescript"}],"headings":[{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"full-example","text":"Full Example","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Form supports arrays as values in a form, including sub-object values inside of an array.\n\n## Basic Usage\n\nTo use an array, you can use `field.state.value` on an array value, as in:\n\n```ts\nexport class TestForm extends LitElement {\n  #form = new TanStackFormController(this, {\n    defaultValues: {\n      people: [] as Array<{ name: string; age: string }>,\n    },\n  })\n  render() {\n    return html`\n      <form\n        id=\"form\"\n        @submit=${(e: Event) => {\n          e.preventDefault()\n        }}\n      >\n        <h1>Please enter your details</h1>\n        ${this.#form.field(\n          {\n            name: `people`,\n          },\n          (peopleField) => {\n            return html`${repeat(\n              peopleField.state.value,\n              (_, index) => index,\n              (_, index) => {\n                return html` // ... `\n              },\n            )} `\n          },\n        )}\n      </form>\n    `\n  }\n}\n```\n\nThis will generate the mapped HTML every time you run pushValue on the field:\n\n```html\n<div class=\"container\">\n  <button type=\"button\" @click=\"${()\" =\"\">\n    { peopleField.pushValue({name: \"\",age: \"\"}) }}> Add Person\n  </button>\n</div>\n```\n\nFinally, you can use a subfield like so:\n\n```ts\nreturn html`\n  ${this.#form.field(\n    {\n      name: `people[${index}].name`,\n    },\n    (field) => {\n      return html`\n        <input\n          type=\"text\"\n          placeholder=\"Name\"\n          .value=\"${field.state.value}\"\n          @input=\"${(e: Event) => {\n            const target = e.target as HTMLInputElement\n            field.handleChange(target.value)\n          }}\"\n        />\n      `\n    },\n  )}\n`\n```\n\n## Full Example\n\n```typescript\nexport class TestForm extends LitElement {\n  #form = new TanStackFormController(this, {\n    defaultValues: {\n      people: [] as Array<{ name: string }>,\n    },\n  });\n  render() {\n    return html`\n      <form\n        id=\"form\"\n        @submit=${(e: Event) => {\n          e.preventDefault();\n        }}\n      >\n        <h1>Please enter your details</h1>\n        ${this.#form.field(\n          {\n            name: `people`,\n          },\n          (peopleField) => {\n            return html`${repeat(\n                peopleField.state.value,\n                (_, index) => index,\n                (_, index) => {\n                  return html`\n                    ${this.#form.field(\n                      {\n                        name: `people[${index}].name`,\n                      },\n                      (field) => {\n                        return html` <div>\n                          <div class=\"container\">\n                            <label>Name</label>\n                            <input\n                              type=\"text\"\n                              placeholder=\"Name\"\n                              .value=\"${field.state.value}\"\n                              @input=\"${(e: Event) => {\n                                const target = e.target as HTMLInputElement;\n                                field.handleChange(target.value);\n                              }}\"\n                            />\n                          </div>\n                        </div>`;\n                      }\n                    )}\n                  `;\n                }\n              )}\n\n              <div class=\"container\">\n                <button\n                  type=\"button\"\n                  @click=${() => {\n                    peopleField.pushValue({\n                      name: \"\",\n                    });\n                  }}\n                >\n                  Add Person\n                </button>\n              </div> `;\n          }\n        )}\n\n        <div class=\"container\">\n          <button type=\"submit\" ?disabled=${this.#form.api.state.isSubmitting}>\n            ${this.#form.api.state.isSubmitting ? html` Submitting` : \"Submit\"}\n          </button>\n          <button\n            type=\"button\"\n            id=\"reset\"\n            @click=${() => {\n              this.#form.api.reset();\n            }}\n          >\n            Reset\n          </button>\n        </div>\n      </form>\n    `;\n  }\n\ndeclare global {\n  interface HTMLElementTagNameMap {\n    \"test-form\": TestForm;\n  }\n}\n```\n","originalRawMarkdown":"---\nid: arrays\ntitle: Arrays\n---\n\nTanStack Form supports arrays as values in a form, including sub-object values inside of an array.\n\n## Basic Usage\n\nTo use an array, you can use `field.state.value` on an array value, as in:\n\n```ts\nexport class TestForm extends LitElement {\n  #form = new TanStackFormController(this, {\n    defaultValues: {\n      people: [] as Array<{ name: string; age: string }>,\n    },\n  })\n  render() {\n    return html`\n      <form\n        id=\"form\"\n        @submit=${(e: Event) => {\n          e.preventDefault()\n        }}\n      >\n        <h1>Please enter your details</h1>\n        ${this.#form.field(\n          {\n            name: `people`,\n          },\n          (peopleField) => {\n            return html`${repeat(\n              peopleField.state.value,\n              (_, index) => index,\n              (_, index) => {\n                return html` // ... `\n              },\n            )} `\n          },\n        )}\n      </form>\n    `\n  }\n}\n```\n\nThis will generate the mapped HTML every time you run pushValue on the field:\n\n```html\n<div class=\"container\">\n  <button type=\"button\" @click=\"${()\" =\"\">\n    { peopleField.pushValue({name: \"\",age: \"\"}) }}> Add Person\n  </button>\n</div>\n```\n\nFinally, you can use a subfield like so:\n\n```ts\nreturn html`\n  ${this.#form.field(\n    {\n      name: `people[${index}].name`,\n    },\n    (field) => {\n      return html`\n        <input\n          type=\"text\"\n          placeholder=\"Name\"\n          .value=\"${field.state.value}\"\n          @input=\"${(e: Event) => {\n            const target = e.target as HTMLInputElement\n            field.handleChange(target.value)\n          }}\"\n        />\n      `\n    },\n  )}\n`\n```\n\n## Full Example\n\n```typescript\nexport class TestForm extends LitElement {\n  #form = new TanStackFormController(this, {\n    defaultValues: {\n      people: [] as Array<{ name: string }>,\n    },\n  });\n  render() {\n    return html`\n      <form\n        id=\"form\"\n        @submit=${(e: Event) => {\n          e.preventDefault();\n        }}\n      >\n        <h1>Please enter your details</h1>\n        ${this.#form.field(\n          {\n            name: `people`,\n          },\n          (peopleField) => {\n            return html`${repeat(\n                peopleField.state.value,\n                (_, index) => index,\n                (_, index) => {\n                  return html`\n                    ${this.#form.field(\n                      {\n                        name: `people[${index}].name`,\n                      },\n                      (field) => {\n                        return html` <div>\n                          <div class=\"container\">\n                            <label>Name</label>\n                            <input\n                              type=\"text\"\n                              placeholder=\"Name\"\n                              .value=\"${field.state.value}\"\n                              @input=\"${(e: Event) => {\n                                const target = e.target as HTMLInputElement;\n                                field.handleChange(target.value);\n                              }}\"\n                            />\n                          </div>\n                        </div>`;\n                      }\n                    )}\n                  `;\n                }\n              )}\n\n              <div class=\"container\">\n                <button\n                  type=\"button\"\n                  @click=${() => {\n                    peopleField.pushValue({\n                      name: \"\",\n                    });\n                  }}\n                >\n                  Add Person\n                </button>\n              </div> `;\n          }\n        )}\n\n        <div class=\"container\">\n          <button type=\"submit\" ?disabled=${this.#form.api.state.isSubmitting}>\n            ${this.#form.api.state.isSubmitting ? html` Submitting` : \"Submit\"}\n          </button>\n          <button\n            type=\"button\"\n            id=\"reset\"\n            @click=${() => {\n              this.#form.api.reset();\n            }}\n          >\n            Reset\n          </button>\n        </div>\n      </form>\n    `;\n  }\n\ndeclare global {\n  interface HTMLElementTagNameMap {\n    \"test-form\": TestForm;\n  }\n}\n```\n"}
