   jobTitle: '',\n  } as Employee,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"You may also create a form instance without using "},{"type":"inlineCode","value":"formOptions"},{"type":"text","value":" by using the standalone "},{"type":"inlineCode","value":"TanStackFormController"},{"type":"text","value":" API:"}]},{"type":"code","value":"#form = new TanStackFormController(this, {\n  ...formOpts,\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"field","children":[{"type":"text","value":"Field"}]},{"type":"paragraph","children":[{"type":"text","value":"A Field represents a single form input element, such as a text input or a checkbox. Fields are created using the "},{"type":"inlineCode","value":"field(FieldOptions, callback)"},{"type":"text","value":" provided by the form instance. The component accepts a "},{"type":"inlineCode","value":"FieldOptions"},{"type":"text","value":" object and a callback function that receives a "},{"type":"inlineCode","value":"FieldApi"},{"type":"text","value":" object. This object provides methods to get the current value of the field, handle input changes, and handle blur events."}]},{"type":"paragraph","children":[{"type":"text","value":"For Example:"}]},{"type":"code","value":" ${this.#form.field(\n    {\n      name: `firstName`,\n      validators: {\n        onChange: ({ value }) =>\n          value.length < 3 ? \"Not long enough\" : undefined,\n        },\n      },\n      (field: FieldApi<Employee, \"firstName\">) => {\n        return html` <div>\n          <label class=\"first-name-label\">First Name</label>\n          <input\n           id=\"firstName\"\n           type=\"text\"\n           class=\"first-name-input\"\n           placeholder=\"First Name\"\n           @blur=\"${() => field.handleBlur()}\"\n           .value=\"${field.state.value}\"\n           @input=\"${(event: InputEvent) => {\n           if (event.currentTarget) {\n            const newValue = (event.currentTarget as HTMLInputElement).value;\n            field.handleChange(newValue);\n           }\n          }}\"\n        />\n      </div>`;\n    },\n)}","lang":"ts"},{"type":"heading","depth":2,"id":"field-state","children":[{"type":"text","value":"Field State"}]},{"type":"paragraph","children":[{"type":"text","value":"Each field has its own state, which includes its current value, validation status, error messages, and other metadata. You can access a field's state using its "},{"type":"inlineCode","value":"field.state"},{"type":"text","value":" property."}]},{"type":"code","value":"const {\n  value,\n  meta: { errors, isValidating },\n} = field.state","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"There are four states in the metadata that can be useful to see how the user interacts with a field:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isTouched\""}]},{"type":"text","value":", after the user changes the field or blurs the field"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isDirty\""}]},{"type":"text","value":", after the field's value has been changed, even if it's been reverted to the default. Opposite of "},{"type":"inlineCode","value":"isPristine"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isPristine\""}]},{"type":"text","value":", until the user changes the field value. Opposite of "},{"type":"inlineCode","value":"isDirty"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isBlurred\""}]},{"type":"text","value":", after the field has been blurred"}]}]}]},{"type":"code","value":"const { isTouched, isDirty, isPristine, isBlurred } = field.state.meta","lang":"ts"},{"type":"paragraph","children":[{"type":"image","src":"https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states.png","alt":"Field states"}]},{"type":"heading","depth":2,"id":"understanding-isdirty-in-different-libraries","children":[{"type":"text","value":"Understanding 'isDirty' in Different Libraries"}]},{"type":"paragraph","children":[{"type":"text","value":"Non-Persistent "},{"type":"inlineCode","value":"dirty"},{"type":"text","value":" state"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Libraries"}]},{"type":"text","value":": React Hook Form (RHF), Formik, Final Form."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Behavior"}]},{"type":"text","value":": A field is 'dirty' if its value differs from the default. Reverting to the default value makes it 'clean' again."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Persistent "},{"type":"inlineCode","value":"dirty"},{"type":"text","value":" state"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Libraries"}]},{"type":"text","value":": Angular Form, Vue FormKit."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Behavior"}]},{"type":"text","value":": A field remains 'dirty' once changed, even if reverted to the default value."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"We have chosen the persistent 'dirty' state model. To also support a non-persistent 'dirty' state, we introduce an additional flag:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isDefaultValue\""}]},{"type":"text","value":", whether the field's current value is the default value"}]}]}]},{"type":"code","value":"const { isDefaultValue, isTouched } = field.state.meta\n\n// The following line will re-create the non-Persistent `dirty` functionality.\nconst nonPersistentIsDirty = !isDefaultValue","lang":"ts"},{"type":"paragraph","children":[{"type":"image","src":"https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states-extended.png","alt":"Field states extended"}]}],"headings":[{"id":"form-options","text":"Form Options","level":2},{"id":"form-instance","text":"Form Instance","level":2},{"id":"field","text":"Field","level":2},{"id":"field-state","text":"Field State","level":2},{"id":"understanding-isdirty-in-different-libraries","text":"Understanding 'isDirty' in Different Libraries","level":2}]},"frameworks":[],"downloadMarkdown":"\nThis page introduces the basic concepts and terminology used in the `@tanstack/lit-form` library. Familiarizing yourself with these concepts will help you better understand and work with the library and its usage with Lit.\n\n## Form Options\n\nYou can create options for your form so that it can be shared between multiple forms by using the `formOptions` function.\n\nFor Example:\n\n```tsx\nconst formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    employed: false,\n    jobTitle: '',\n  } as Employee,\n})\n```\n\n## Form Instance\n\nA Form Instance is an object that represents an individual form and provides methods and properties for working with the form. You create a form instance using the `TanStackFormController` interface provided by `@tanstack/lit-form`. The `TanStackFormController` is instantiated with the current form's (`this`) class and some default form options. It initializes the form state, handles form submission, and provides methods to manage form fields and their validation.\n\n```tsx\n#form = new TanStackFormController(this, {\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    employed: false,\n    jobTitle: '',\n  } as Employee,\n})\n```\n\nYou may also create a form instance without using `formOptions` by using the standalone `TanStackFormController` API:\n\n```tsx\n#form = new TanStackFormController(this, {\n  ...formOpts,\n})\n```\n\n## Field\n\nA Field represents a single form input element, such as a text input or a checkbox. Fields are created using the `field(FieldOptions, callback)` provided by the form instance. The component accepts a `FieldOptions` object and a callback function that receives a `FieldApi` object. This object provides methods to get the current value of the field, handle input changes, and handle blur events.\n\nFor Example:\n\n```ts\n ${this.#form.field(\n    {\n      name: `firstName`,\n      validators: {\n        onChange: ({ value }) =>\n          value.length < 3 ? \"Not long enough\" : undefined,\n        },\n      },\n      (field: FieldApi<Employee, \"firstName\">) => {\n        return html` <div>\n          <label class=\"first-name-label\">First Name</label>\n          <input\n           id=\"firstName\"\n           type=\"text\"\n           class=\"first-name-input\"\n           placeholder=\"First Name\"\n           @blur=\"${() => field.handleBlur()}\"\n           .value=\"${field.state.value}\"\n           @input=\"${(event: InputEvent) => {\n           if (event.currentTarget) {\n            const newValue = (event.currentTarget as HTMLInputElement).value;\n            field.handleChange(newValue);\n           }\n          }}\"\n        />\n      </div>`;\n    },\n)}\n```\n\n## Field State\n\nEach field has its own state, which includes its current value, validation status, error messages, and other metadata. You can access a field's state using its `field.state` property.\n\n```ts\nconst {\n  value,\n  meta: { errors, isValidating },\n} = field.state\n```\n\nThere are four states in the metadata that can be useful to see how the user interacts with a field:\n\n- _\"isTouched\"_, after the user changes the field or blurs the field\n- _\"isDirty\"_, after the field's value has been changed, even if it's been reverted to the default. Opposite of `isPristine`\n- _\"isPristine\"_, until the user changes the field value. Opposite of `isDirty`\n- _\"isBlurred\"_, after the field has been blurred\n\n```ts\nconst { isTouched, isDirty, isPristine, isBlurred } = field.state.meta\n```\n\n![Field states](https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states.png)\n\n## Understanding 'isDirty' in Different Libraries\n\nNon-Persistent `dirty` state\n\n- **Libraries**: React Hook Form (RHF), Formik, Final Form.\n- **Behavior**: A field is 'dirty' if its value differs from the default. Reverting to the default value makes it 'clean' again.\n\nPersistent `dirty` state\n\n- **Libraries**: Angular Form, Vue FormKit.\n- **Behavior**: A field remains 'dirty' once changed, even if reverted to the default value.\n\nWe have chosen the persistent 'dirty' state model. To also support a non-persistent 'dirty' state, we introduce an additional flag:\n\n- _\"isDefaultValue\"_, whether the field's current value is the default value\n\n```ts\nconst { isDefaultValue, isTouched } = field.state.meta\n\n// The following line will re-create the non-Persistent `dirty` functionality.\nconst nonPersistentIsDirty = !isDefaultValue\n```\n\n![Field states extended](https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states-extended.png)\n","originalRawMarkdown":"---\nid: basic-concepts\ntitle: Basic Concepts and Terminology\n---\n\nThis page introduces the basic concepts and terminology used in the `@tanstack/lit-form` library. Familiarizing yourself with these concepts will help you better understand and work with the library and its usage with Lit.\n\n## Form Options\n\nYou can create options for your form so that it can be shared between multiple forms by using the `formOptions` function.\n\nFor Example:\n\n```tsx\nconst formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    employed: false,\n    jobTitle: '',\n  } as Employee,\n})\n```\n\n## Form Instance\n\nA Form Instance is an object that represents an individual form and provides methods and properties for working with the form. You create a form instance using the `TanStackFormController` interface provided by `@tanstack/lit-form`. The `TanStackFormController` is instantiated with the current form's (`this`) class and some default form options. It initializes the form state, handles form submission, and provides methods to manage form fields and their validation.\n\n```tsx\n#form = new TanStackFormController(this, {\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    employed: false,\n    jobTitle: '',\n  } as Employee,\n})\n```\n\nYou may also create a form instance without using `formOptions` by using the standalone `TanStackFormController` API:\n\n```tsx\n#form = new TanStackFormController(this, {\n  ...formOpts,\n})\n```\n\n## Field\n\nA Field represents a single form input element, such as a text input or a checkbox. Fields are created using the `field(FieldOptions, callback)` provided by the form instance. The component accepts a `FieldOptions` object and a callback function that receives a `FieldApi` object. This object provides methods to get the current value of the field, handle input changes, and handle blur events.\n\nFor Example:\n\n```ts\n ${this.#form.field(\n    {\n      name: `firstName`,\n      validators: {\n        onChange: ({ value }) =>\n          value.length < 3 ? \"Not long enough\" : undefined,\n        },\n      },\n      (field: FieldApi<Employee, \"firstName\">) => {\n        return html` <div>\n          <label class=\"first-name-label\">First Name</label>\n          <input\n           id=\"firstName\"\n           type=\"text\"\n           class=\"first-name-input\"\n           placeholder=\"First Name\"\n           @blur=\"${() => field.handleBlur()}\"\n           .value=\"${field.state.value}\"\n           @input=\"${(event: InputEvent) => {\n           if (event.currentTarget) {\n            const newValue = (event.currentTarget as HTMLInputElement).value;\n            field.handleChange(newValue);\n           }\n          }}\"\n        />\n      </div>`;\n    },\n)}\n```\n\n## Field State\n\nEach field has its own state, which includes its current value, validation status, error messages, and other metadata. You can access a field's state using its `field.state` property.\n\n```ts\nconst {\n  value,\n  meta: { errors, isValidating },\n} = field.state\n```\n\nThere are four states in the metadata that can be useful to see how the user interacts with a field:\n\n- _\"isTouched\"_, after the user changes the field or blurs the field\n- _\"isDirty\"_, after the field's value has been changed, even if it's been reverted to the default. Opposite of `isPristine`\n- _\"isPristine\"_, until the user changes the field value. Opposite of `isDirty`\n- _\"isBlurred\"_, after the field has been blurred\n\n```ts\nconst { isTouched, isDirty, isPristine, isBlurred } = field.state.meta\n```\n\n![Field states](https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states.png)\n\n## Understanding 'isDirty' in Different Libraries\n\nNon-Persistent `dirty` state\n\n- **Libraries**: React Hook Form (RHF), Formik, Final Form.\n- **Behavior**: A field is 'dirty' if its value differs from the default. Reverting to the default value makes it 'clean' again.\n\nPersistent `dirty` state\n\n- **Libraries**: Angular Form, Vue FormKit.\n- **Behavior**: A field remains 'dirty' once changed, even if reverted to the default value.\n\nWe have chosen the persistent 'dirty' state model. To also support a non-persistent 'dirty' state, we introduce an additional flag:\n\n- _\"isDefaultValue\"_, whether the field's current value is the default value\n\n```ts\nconst { isDefaultValue, isTouched } = field.state.meta\n\n// The following line will re-create the non-Persistent `dirty` functionality.\nconst nonPersistentIsDirty = !isDefaultValue\n```\n\n![Field states extended](https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states-extended.png)\n"}
