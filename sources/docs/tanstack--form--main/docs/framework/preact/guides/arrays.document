NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack Form supports arrays as values in a form, including sub-object values inside of an array."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic Usage"}]},{"type":"paragraph","children":[{"type":"text","value":"To use an array, you can use "},{"type":"inlineCode","value":"field.state.value"},{"type":"text","value":" on an array value:"}]},{"type":"code","value":"function App() {\n  const form = useForm({\n    defaultValues: {\n      people: [],\n    },\n  })\n\n  return (\n    <form.Field name=\"people\" mode=\"array\">\n      {(field) => (\n        <div>\n          {field.state.value.map((_, i) => {\n            // ...\n          })}\n        </div>\n      )}\n    </form.Field>\n  )\n}","lang":"jsx"},{"type":"paragraph","children":[{"type":"text","value":"This will generate the mapped JSX every time you run "},{"type":"inlineCode","value":"pushValue"},{"type":"text","value":" on "},{"type":"inlineCode","value":"field"},{"type":"text","value":":"}]},{"type":"code","value":"<button onClick={() => field.pushValue({ name: '', age: 0 })} type=\"button\">\n  Add person\n</button>","lang":"jsx"},{"type":"paragraph","children":[{"type":"text","value":"Finally, you can use a subfield like so:"}]},{"type":"code","value":"<form.Field key={i} name={`people[${i}].name`}>\n  {(subField) => (\n    <input\n      value={subField.state.value}\n      onInput={(e) => subField.handleChange(e.target.value)}\n    />\n  )}\n</form.Field>","lang":"jsx"},{"type":"heading","depth":2,"id":"full-example","children":[{"type":"text","value":"Full Example"}]},{"type":"code","value":"function App() {\n  const form = useForm({\n    defaultValues: {\n      people: [],\n    },\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n\n  return (\n    <div>\n      <form\n        onSubmit={(e) => {\n          e.preventDefault()\n          e.stopPropagation()\n          form.handleSubmit()\n        }}\n      >\n        <form.Field name=\"people\" mode=\"array\">\n          {(field) => {\n            return (\n              <div>\n                {field.state.value.map((_, i) => {\n                  return (\n                    <form.Field key={i} name={`people[${i}].name`}>\n                      {(subField) => {\n                        return (\n                          <div>\n                            <label>\n                              <div>Name for person {i}</div>\n                              <input\n                                value={subField.state.value}\n                                onInput={(e) =>\n                                  subField.handleChange(e.target.value)\n                                }\n                              />\n                            </label>\n                          </div>\n                        )\n                      }}\n                    </form.Field>\n                  )\n                })}\n                <button\n                  onClick={() => field.pushValue({ name: '', age: 0 })}\n                  type=\"button\"\n                >\n                  Add person\n                </button>\n              </div>\n            )\n          }}\n        </form.Field>\n        <form.Subscribe\n          selector={(state) => [state.canSubmit, state.isSubmitting]}\n          children={([canSubmit, isSubmitting]) => (\n            <button type=\"submit\" disabled={!canSubmit}>\n              {isSubmitting ? '...' : 'Submit'}\n            </button>\n          )}\n        />\n      </form>\n    </div>\n  )\n}","lang":"jsx"}],"headings":[{"id":"basic-usage","text":"Basic Usage","level":2},{"id":"full-example","text":"Full Example","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Form supports arrays as values in a form, including sub-object values inside of an array.\n\n## Basic Usage\n\nTo use an array, you can use `field.state.value` on an array value:\n\n```jsx\nfunction App() {\n  const form = useForm({\n    defaultValues: {\n      people: [],\n    },\n  })\n\n  return (\n    <form.Field name=\"people\" mode=\"array\">\n      {(field) => (\n        <div>\n          {field.state.value.map((_, i) => {\n            // ...\n          })}\n        </div>\n      )}\n    </form.Field>\n  )\n}\n```\n\nThis will generate the mapped JSX every time you run `pushValue` on `field`:\n\n```jsx\n<button onClick={() => field.pushValue({ name: '', age: 0 })} type=\"button\">\n  Add person\n</button>\n```\n\nFinally, you can use a subfield like so:\n\n```jsx\n<form.Field key={i} name={`people[${i}].name`}>\n  {(subField) => (\n    <input\n      value={subField.state.value}\n      onInput={(e) => subField.handleChange(e.target.value)}\n    />\n  )}\n</form.Field>\n```\n\n## Full Example\n\n```jsx\nfunction App() {\n  const form = useForm({\n    defaultValues: {\n      people: [],\n    },\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n\n  return (\n    <div>\n      <form\n        onSubmit={(e) => {\n          e.preventDefault()\n          e.stopPropagation()\n          form.handleSubmit()\n        }}\n      >\n        <form.Field name=\"people\" mode=\"array\">\n          {(field) => {\n            return (\n              <div>\n                {field.state.value.map((_, i) => {\n                  return (\n                    <form.Field key={i} name={`people[${i}].name`}>\n                      {(subField) => {\n                        return (\n                          <div>\n                            <label>\n                              <div>Name for person {i}</div>\n                              <input\n                                value={subField.state.value}\n                                onInput={(e) =>\n                                  subField.handleChange(e.target.value)\n                                }\n                              />\n                            </label>\n                          </div>\n                        )\n                      }}\n                    </form.Field>\n                  )\n                })}\n                <button\n                  onClick={() => field.pushValue({ name: '', age: 0 })}\n                  type=\"button\"\n                >\n                  Add person\n                </button>\n              </div>\n            )\n          }}\n        </form.Field>\n        <form.Subscribe\n          selector={(state) => [state.canSubmit, state.isSubmitting]}\n          children={([canSubmit, isSubmitting]) => (\n            <button type=\"submit\" disabled={!canSubmit}>\n              {isSubmitting ? '...' : 'Submit'}\n            </button>\n          )}\n        />\n      </form>\n    </div>\n  )\n}\n```\n","originalRawMarkdown":"---\nid: arrays\ntitle: Arrays\n---\n\nTanStack Form supports arrays as values in a form, including sub-object values inside of an array.\n\n## Basic Usage\n\nTo use an array, you can use `field.state.value` on an array value:\n\n```jsx\nfunction App() {\n  const form = useForm({\n    defaultValues: {\n      people: [],\n    },\n  })\n\n  return (\n    <form.Field name=\"people\" mode=\"array\">\n      {(field) => (\n        <div>\n          {field.state.value.map((_, i) => {\n            // ...\n          })}\n        </div>\n      )}\n    </form.Field>\n  )\n}\n```\n\nThis will generate the mapped JSX every time you run `pushValue` on `field`:\n\n```jsx\n<button onClick={() => field.pushValue({ name: '', age: 0 })} type=\"button\">\n  Add person\n</button>\n```\n\nFinally, you can use a subfield like so:\n\n```jsx\n<form.Field key={i} name={`people[${i}].name`}>\n  {(subField) => (\n    <input\n      value={subField.state.value}\n      onInput={(e) => subField.handleChange(e.target.value)}\n    />\n  )}\n</form.Field>\n```\n\n## Full Example\n\n```jsx\nfunction App() {\n  const form = useForm({\n    defaultValues: {\n      people: [],\n    },\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n\n  return (\n    <div>\n      <form\n        onSubmit={(e) => {\n          e.preventDefault()\n          e.stopPropagation()\n          form.handleSubmit()\n        }}\n      >\n        <form.Field name=\"people\" mode=\"array\">\n          {(field) => {\n            return (\n              <div>\n                {field.state.value.map((_, i) => {\n                  return (\n                    <form.Field key={i} name={`people[${i}].name`}>\n                      {(subField) => {\n                        return (\n                          <div>\n                            <label>\n                              <div>Name for person {i}</div>\n                              <input\n                                value={subField.state.value}\n                                onInput={(e) =>\n                                  subField.handleChange(e.target.value)\n                                }\n                              />\n                            </label>\n                          </div>\n                        )\n                      }}\n                    </form.Field>\n                  )\n                })}\n                <button\n                  onClick={() => field.pushValue({ name: '', age: 0 })}\n                  type=\"button\"\n                >\n                  Add person\n                </button>\n              </div>\n            )\n          }}\n        </form.Field>\n        <form.Subscribe\n          selector={(state) => [state.canSubmit, state.isSubmitting]}\n          children={([canSubmit, isSubmitting]) => (\n            <button type=\"submit\" disabled={!canSubmit}>\n              {isSubmitting ? '...' : 'Submit'}\n            </button>\n          )}\n        />\n      </form>\n    </div>\n  )\n}\n```\n"}
