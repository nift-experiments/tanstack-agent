{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"In many cases, you want to change the validation rules depending on the state of the form or other conditions. The most popular\nexample of this is when you want to validate a field differently based on whether the user has submitted the form for the first time or not."}]},{"type":"paragraph","children":[{"type":"text","value":"We support this through our "},{"type":"inlineCode","value":"onDynamic"},{"type":"text","value":" validation function."}]},{"type":"code","value":"import { revalidateLogic, useForm } from '@tanstack/preact-form'\n\n// ...\n\nconst form = useForm({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n  },\n  // If this is omitted, `onDynamic` will not be called\n  validationLogic: revalidateLogic(),\n  validators: {\n    onDynamic: ({ value }) => {\n      if (!value.firstName) {\n        return { firstName: 'A first name is required' }\n      }\n      return undefined\n    },\n  },\n})","lang":"tsx"},{"type":"callout","kind":"important","title":"Important","children":[{"type":"paragraph","children":[{"type":"text","value":"By default, "},{"type":"inlineCode","value":"onDynamic"},{"type":"text","value":" is not called; therefore you must pass "},{"type":"inlineCode","value":"revalidateLogic()"},{"type":"text","value":" to the "},{"type":"inlineCode","value":"validationLogic"},{"type":"text","value":" option of "},{"type":"inlineCode","value":"useForm"},{"type":"text","value":"."}]}]},{"type":"heading","depth":2,"id":"revalidation-options","children":[{"type":"text","value":"Revalidation Options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"revalidateLogic"},{"type":"text","value":" allows you to specify when validation should be run and to change the validation rules dynamically based on the current submission state of the form."}]},{"type":"paragraph","children":[{"type":"text","value":"It takes two arguments:"}]},{"type":"list","ordered":false,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mode"},{"type":"text","value":": The mode of validation prior to the first form submission. This can be one of the following:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"change"},{"type":"text","value":": Validate on every change."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"blur"},{"type":"text","value":": Validate on blur."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"submit"},{"type":"text","value":": Validate on submit. ("},{"type":"strong","children":[{"type":"text","value":"default"}]},{"type":"text","value":")"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"modeAfterSubmission"},{"type":"text","value":": The mode of validation after the form has been submitted. This can be one of the following:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"change"},{"type":"text","value":": Validate on every change. ("},{"type":"strong","children":[{"type":"text","value":"default"}]},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"blur"},{"type":"text","value":": Validate on blur."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"submit"},{"type":"text","value":": Validate on submit."}]}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"You can, for example, use the following to revalidate on blur after the first submission:"}]},{"type":"code","value":"const form = useForm({\n  // ...\n  validationLogic: revalidateLogic({\n    mode: 'submit',\n    modeAfterSubmission: 'blur',\n  }),\n  // ...\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"accessing-errors","children":[{"type":"text","value":"Accessing Errors"}]},{"type":"paragraph","children":[{"type":"text","value":"Just as you might access errors from an "},{"type":"inlineCode","value":"onChange"},{"type":"text","value":" or "},{"type":"inlineCode","value":"onBlur"},{"type":"text","value":" validation, you can access errors from the "},{"type":"inlineCode","value":"onDynamic"},{"type":"text","value":" validation function using the "},{"type":"inlineCode","value":"form.state.errorMap"},{"type":"text","value":" object."}]},{"type":"code","value":"function App() {\n  const form = useForm({\n    // ...\n    validationLogic: revalidateLogic(),\n    validators: {\n      onDynamic: ({ value }) => {\n        if (!value.firstName) {\n          return { firstName: 'A first name is required' }\n        }\n        return undefined\n      },\n    },\n  })\n\n  return <p>{form.state.errorMap.onDynamic?.firstName}</p>\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"usage-with-other-validation-logic","children":[{"type":"text","value":"Usage with Other Validation Logic"}]},{"type":"paragraph","children":[{"type":"text","value":"You can use "},{"type":"inlineCode","value":"onDynamic"},{"type":"text","value":" validation alongside other validation logic, such as "},{"type":"inlineCode","value":"onChange"},{"type":"text","value":" or "},{"type":"inlineCode","value":"onBlur"},{"type":"text","value":"."}]},{"type":"code","value":"import { revalidateLogic, useForm } from '@tanstack/preact-form'\n\nfunction App() {\n  const form = useForm({\n    defaultValues: {\n      firstName: '',\n      lastName: '',\n    },\n    validationLogic: revalidateLogic(),\n    validators: {\n      onChange: ({ value }) => {\n        if (!value.firstName) {\n          return { firstName: 'A first name is required' }\n        }\n        return undefined\n      },\n      onDynamic: ({ value }) => {\n        if (!value.lastName) {\n          return { lastName: 'A last name is required' }\n        }\n        return undefined\n      },\n    },\n  })\n\n  return (\n    <div>\n      <p>{form.state.errorMap.onChange?.firstName}</p>\n      <p>{form.state.errorMap.onDynamic?.lastName}</p>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"usage-with-fields","children":[{"type":"text","value":"Usage with Fields"}]},{"type":"paragraph","children":[{"type":"text","value":"You can also use "},{"type":"inlineCode","value":"onDynamic"},{"type":"text","value":" validation with fields, just like you would with other validation logic."}]},{"type":"code","value":"function App() {\n  const form = useForm({\n    defaultValues: {\n      name: '',\n      age: 0,\n    },\n    validationLogic: revalidateLogic(),\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n\n  return (\n    <form\n      onSubmit={(e) => {\n        e.preventDefault()\n        e.stopPropagation()\n        form.handleSubmit()\n      }}\n    >\n      <form.Field\n        name={'age'}\n        validators={{\n          onDynamic: ({ value }) =>\n            value > 18 ? undefined : 'Age must be greater than 18',\n        }}\n        children={(field) => (\n          <div>\n            <input\n              type=\"number\"\n              onInput={(e) => field.handleChange(e.target.valueAsNumber)}\n              onBlur={field.handleBlur}\n              value={field.state.value}\n            />\n            <p style={{ color: 'red' }}>\n              {field.state.meta.errorMap.onDynamic}\n            </p>\n          </div>\n        )}\n      />\n      <button type=\"submit\">Submit</button>\n    </form>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"async-validation","children":[{"type":"text","value":"Async Validation"}]},{"type":"paragraph","children":[{"type":"text","value":"Async validation can also be used with "},{"type":"inlineCode","value":"onDynamicAsync"},{"type":"text","value":" just like with other validation logic. You can even debounce the async validation to avoid excessive calls."}]},{"type":"code","value":"const form = useForm({\n  defaultValues: {\n    username: '',\n  },\n  validationLogic: revalidateLogic(),\n  validators: {\n    onDynamicAsyncDebounceMs: 500, // Debounce the async validation by 500ms\n    onDynamicAsync: async ({ value }) => {\n      if (!value.username) {\n        return { username: 'Username is required' }\n      }\n      // Simulate an async validation\n      const isValid = await validateUsername(value.username)\n      return isValid ? undefined : { username: 'Username is already taken' }\n    },\n  },\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"standard-schema-validation","children":[{"type":"text","value":"Standard Schema Validation"}]},{"type":"paragraph","children":[{"type":"text","value":"You can also use standard schema validation libraries like Valibot or Zod with "},{"type":"inlineCode","value":"onDynamic"},{"type":"text","value":" validation. This allows you to define complex validation rules that can change dynamically based on the form state."}]},{"type":"code","value":"import { z } from 'zod'\n\nconst schema = z.object({\n  firstName: z.string().min(1, 'A first name is required'),\n  lastName: z.string().min(1, 'A last name is required'),\n})\n\nconst form = useForm({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n  },\n  validationLogic: revalidateLogic(),\n  validators: {\n    onDynamic: schema,\n  },\n})","lang":"tsx"}],"headings":[{"id":"revalidation-options","text":"Revalidation Options","level":2},{"id":"accessing-errors","text":"Accessing Errors","level":2},{"id":"usage-with-other-validation-logic","text":"Usage with Other Validation Logic","level":2},{"id":"usage-with-fields","text":"Usage with Fields","level":3},{"id":"async-validation","text":"Async Validation","level":3},{"id":"standard-schema-validation","text":"Standard Schema Validation","level":3}]},"frameworks":[],"downloadMarkdown":"\nIn many cases, you want to change the validation rules depending on the state of the form or other conditions. The most popular\nexample of this is when you want to validate a field differently based on whether the user has submitted the form for the first time or not.\n\nWe support this through our `onDynamic` validation function.\n\n```tsx\nimport { revalidateLogic, useForm } from '@tanstack/preact-form'\n\n// ...\n\nconst form = useForm({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n  },\n  // If this is omitted, `onDynamic` will not be called\n  validationLogic: revalidateLogic(),\n  validators: {\n    onDynamic: ({ value }) => {\n      if (!value.firstName) {\n        return { firstName: 'A first name is required' }\n      }\n      return undefined\n    },\n  },\n})\n```\n\n> [!IMPORTANT]\n> By default, `onDynamic` is not called; therefore you must pass `revalidateLogic()` to the `validationLogic` option of `useForm`.\n\n## Revalidation Options\n\n`revalidateLogic` allows you to specify when validation should be run and to change the validation rules dynamically based on the current submission state of the form.\n\nIt takes two arguments:\n\n- `mode`: The mode of validation prior to the first form submission. This can be one of the following:\n  - `change`: Validate on every change.\n  - `blur`: Validate on blur.\n  - `submit`: Validate on submit. (**default**)\n\n- `modeAfterSubmission`: The mode of validation after the form has been submitted. This can be one of the following:\n  - `change`: Validate on every change. (**default**)\n  - `blur`: Validate on blur.\n  - `submit`: Validate on submit.\n\nYou can, for example, use the following to revalidate on blur after the first submission:\n\n```tsx\nconst form = useForm({\n  // ...\n  validationLogic: revalidateLogic({\n    mode: 'submit',\n    modeAfterSubmission: 'blur',\n  }),\n  // ...\n})\n```\n\n## Accessing Errors\n\nJust as you might access errors from an `onChange` or `onBlur` validation, you can access errors from the `onDynamic` validation function using the `form.state.errorMap` object.\n\n```tsx\nfunction App() {\n  const form = useForm({\n    // ...\n    validationLogic: revalidateLogic(),\n    validators: {\n      onDynamic: ({ value }) => {\n        if (!value.firstName) {\n          return { firstName: 'A first name is required' }\n        }\n        return undefined\n      },\n    },\n  })\n\n  return <p>{form.state.errorMap.onDynamic?.firstName}</p>\n}\n```\n\n## Usage with Other Validation Logic\n\nYou can use `onDynamic` validation alongside other validation logic, such as `onChange` or `onBlur`.\n\n```tsx\nimport { revalidateLogic, useForm } from '@tanstack/preact-form'\n\nfunction App() {\n  const form = useForm({\n    defaultValues: {\n      firstName: '',\n      lastName: '',\n    },\n    validationLogic: revalidateLogic(),\n    validators: {\n      onChange: ({ value }) => {\n        if (!value.firstName) {\n          return { firstName: 'A first name is required' }\n        }\n        return undefined\n      },\n      onDynamic: ({ value }) => {\n        if (!value.lastName) {\n          return { lastName: 'A last name is required' }\n        }\n        return undefined\n      },\n    },\n  })\n\n  return (\n    <div>\n      <p>{form.state.errorMap.onChange?.firstName}</p>\n      <p>{form.state.errorMap.onDynamic?.lastName}</p>\n    </div>\n  )\n}\n```\n\n### Usage with Fields\n\nYou can also use `onDynamic` validation with fields, just like you would with other validation logic.\n\n```tsx\nfunction App() {\n  const form = useForm({\n    defaultValues: {\n      name: '',\n      age: 0,\n    },\n    validationLogic: revalidateLogic(),\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n\n  return (\n    <form\n      onSubmit={(e) => {\n        e.preventDefault()\n        e.stopPropagation()\n        form.handleSubmit()\n      }}\n    >\n      <form.Field\n        name={'age'}\n        validators={{\n          onDynamic: ({ value }) =>\n            value > 18 ? undefined : 'Age must be greater than 18',\n        }}\n        children={(field) => (\n          <div>\n            <input\n              type=\"number\"\n              onInput={(e) => field.handleChange(e.target.valueAsNumber)}\n              onBlur={field.handleBlur}\n              value={field.state.value}\n            />\n            <p style={{ color: 'red' }}>\n              {field.state.meta.errorMap.onDynamic}\n            </p>\n          </div>\n        )}\n      />\n      <button type=\"submit\">Submit</button>\n    </form>\n  )\n}\n```\n\n### Async Validation\n\nAsync validation can also be used with `onDynamicAsync` just like with other validation logic. You can even debounce the async validation to avoid excessive calls.\n\n```tsx\nconst form = useForm({\n  defaultValues: {\n    username: '',\n  },\n  validationLogic: revalidateLogic(),\n  validators: {\n    onDynamicAsyncDebounceMs: 500, // Debounce the async validation by 500ms\n    onDynamicAsync: async ({ value }) => {\n      if (!value.username) {\n        return { username: 'Username is required' }\n      }\n      // Simulate an async validation\n      const isValid = await validateUsername(value.username)\n      return isValid ? undefined : { username: 'Username is already taken' }\n    },\n  },\n})\n```\n\n### Standard Schema Validation\n\nYou can also use standard schema validation libraries like Valibot or Zod with `onDynamic` validation. This allows you to define complex validation rules that can change dynamically based on the form state.\n\n```tsx\nimport { z } from 'zod'\n\nconst schema = z.object({\n  firstName: z.string().min(1, 'A first name is required'),\n  lastName: z.string().min(1, 'A last name is required'),\n})\n\nconst form = useForm({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n  },\n  validationLogic: revalidateLogic(),\n  validators: {\n    onDynamic: schema,\n  },\n})\n```\n","originalRawMarkdown":"---\nid: dynamic-validation\ntitle: Dynamic Validation\n---\n\nIn many cases, you want to change the validation rules depending on the state of the form or other conditions. The most popular\nexample of this is when you want to validate a field differently based on whether the user has submitted the form for the first time or not.\n\nWe support this through our `onDynamic` validation function.\n\n```tsx\nimport { revalidateLogic, useForm } from '@tanstack/preact-form'\n\n// ...\n\nconst form = useForm({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n  },\n  // If this is omitted, `onDynamic` will not be called\n  validationLogic: revalidateLogic(),\n  validators: {\n    onDynamic: ({ value }) => {\n      if (!value.firstName) {\n        return { firstName: 'A first name is required' }\n      }\n      return undefined\n    },\n  },\n})\n```\n\n> [!IMPORTANT]\n> By default, `onDynamic` is not called; therefore you must pass `revalidateLogic()` to the `validationLogic` option of `useForm`.\n\n## Revalidation Options\n\n`revalidateLogic` allows you to specify when validation should be run and to change the validation rules dynamically based on the current submission state of the form.\n\nIt takes two arguments:\n\n- `mode`: The mode of validation prior to the first form submission. This can be one of the following:\n  - `change`: Validate on every change.\n  - `blur`: Validate on blur.\n  - `submit`: Validate on submit. (**default**)\n\n- `modeAfterSubmission`: The mode of validation after the form has been submitted. This can be one of the following:\n  - `change`: Validate on every change. (**default**)\n  - `blur`: Validate on blur.\n  - `submit`: Validate on submit.\n\nYou can, for example, use the following to revalidate on blur after the first submission:\n\n```tsx\nconst form = useForm({\n  // ...\n  validationLogic: revalidateLogic({\n    mode: 'submit',\n    modeAfterSubmission: 'blur',\n  }),\n  // ...\n})\n```\n\n## Accessing Errors\n\nJust as you might access errors from an `onChange` or `onBlur` validation, you can access errors from the `onDynamic` validation function using the `form.state.errorMap` object.\n\n```tsx\nfunction App() {\n  const form = useForm({\n    // ...\n    validationLogic: revalidateLogic(),\n    validators: {\n      onDynamic: ({ value }) => {\n        if (!value.firstName) {\n          return { firstName: 'A first name is required' }\n        }\n        return undefined\n      },\n    },\n  })\n\n  return <p>{form.state.errorMap.onDynamic?.firstName}</p>\n}\n```\n\n## Usage with Other Validation Logic\n\nYou can use `onDynamic` validation alongside other validation logic, such as `onChange` or `onBlur`.\n\n```tsx\nimport { revalidateLogic, useForm } from '@tanstack/preact-form'\n\nfunction App() {\n  const form = useForm({\n    defaultValues: {\n      firstName: '',\n      lastName: '',\n    },\n    validationLogic: revalidateLogic(),\n    validators: {\n      onChange: ({ value }) => {\n        if (!value.firstName) {\n          return { firstName: 'A first name is required' }\n        }\n        return undefined\n      },\n      onDynamic: ({ value }) => {\n        if (!value.lastName) {\n          return { lastName: 'A last name is required' }\n        }\n        return undefined\n      },\n    },\n  })\n\n  return (\n    <div>\n      <p>{form.state.errorMap.onChange?.firstName}</p>\n      <p>{form.state.errorMap.onDynamic?.lastName}</p>\n    </div>\n  )\n}\n```\n\n### Usage with Fields\n\nYou can also use `onDynamic` validation with fields, just like you would with other validation logic.\n\n```tsx\nfunction App() {\n  const form = useForm({\n    defaultValues: {\n      name: '',\n      age: 0,\n    },\n    validationLogic: revalidateLogic(),\n    onSubmit({ value }) {\n      alert(JSON.stringify(value))\n    },\n  })\n\n  return (\n    <form\n      onSubmit={(e) => {\n        e.preventDefault()\n        e.stopPropagation()\n        form.handleSubmit()\n      }}\n    >\n      <form.Field\n        name={'age'}\n        validators={{\n          onDynamic: ({ value }) =>\n            value > 18 ? undefined : 'Age must be greater than 18',\n        }}\n        children={(field) => (\n          <div>\n            <input\n              type=\"number\"\n              onInput={(e) => field.handleChange(e.target.valueAsNumber)}\n              onBlur={field.handleBlur}\n              value={field.state.value}\n            />\n            <p style={{ color: 'red' }}>\n              {field.state.meta.errorMap.onDynamic}\n            </p>\n          </div>\n        )}\n      />\n      <button type=\"submit\">Submit</button>\n    </form>\n  )\n}\n```\n\n### Async Validation\n\nAsync validation can also be used with `onDynamicAsync` just like with other validation logic. You can even debounce the async validation to avoid excessive calls.\n\n```tsx\nconst form = useForm({\n  defaultValues: {\n    username: '',\n  },\n  validationLogic: revalidateLogic(),\n  validators: {\n    onDynamicAsyncDebounceMs: 500, // Debounce the async validation by 500ms\n    onDynamicAsync: async ({ value }) => {\n      if (!value.username) {\n        return { username: 'Username is required' }\n      }\n      // Simulate an async validation\n      const isValid = await validateUsername(value.username)\n      return isValid ? undefined : { username: 'Username is already taken' }\n    },\n  },\n})\n```\n\n### Standard Schema Validation\n\nYou can also use standard schema validation libraries like Valibot or Zod with `onDynamic` validation. This allows you to define complex validation rules that can change dynamically based on the form state.\n\n```tsx\nimport { z } from 'zod'\n\nconst schema = z.object({\n  firstName: z.string().min(1, 'A first name is required'),\n  lastName: z.string().min(1, 'A last name is required'),\n})\n\nconst form = useForm({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n  },\n  validationLogic: revalidateLogic(),\n  validators: {\n    onDynamic: schema,\n  },\n})\n```\n"}
