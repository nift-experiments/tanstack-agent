id: ssr
title: React Meta-Framework Usage
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack Form is compatible with React out of the box, supporting "},{"type":"inlineCode","value":"SSR"},{"type":"text","value":" and being framework-agnostic. However, specific configurations are necessary, according to your chosen framework."}]},{"type":"paragraph","children":[{"type":"text","value":"Today we support the following meta-frameworks:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://tanstack.com/start/","children":[{"type":"text","value":"TanStack Start"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://nextjs.org/","children":[{"type":"text","value":"Next.js"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://remix.run","children":[{"type":"text","value":"Remix"}]}]}]}]},{"type":"heading","depth":2,"id":"using-tanstack-form-in-tanstack-start","children":[{"type":"text","value":"Using TanStack Form in TanStack Start"}]},{"type":"paragraph","children":[{"type":"text","value":"This section focuses on integrating TanStack Form with TanStack Start."}]},{"type":"paragraph","children":[{"type":"text","value":"For a complete client-driven mutation workflow with field errors, pending state, optimistic rollback, loader refresh, and redirect after saving, see the "},{"type":"link","href":"/start/latest/docs/framework/react/guide/tanstack-form","children":[{"type":"text","value":"TanStack Start form guide"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"tanstack-start-prerequisites","children":[{"type":"text","value":"TanStack Start Prerequisites"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Start a new "},{"type":"inlineCode","value":"TanStack Start"},{"type":"text","value":" project, following the steps in the "},{"type":"link","href":"https://tanstack.com/start/latest/docs/framework/react/getting-started","children":[{"type":"text","value":"TanStack Start Quickstart Guide"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/react-form-start"}]}]}]},{"type":"heading","depth":3,"id":"start-integration","children":[{"type":"text","value":"Start integration"}]},{"type":"paragraph","children":[{"type":"text","value":"Let's start by creating a "},{"type":"inlineCode","value":"formOption"},{"type":"text","value":" that we'll use to share the form's shape across the client and server."}]},{"type":"code","value":"// app/routes/index.tsx, but can be extracted to any other path\nimport { formOptions } from '@tanstack/react-form-start'\n\n// You can pass other form options here\nexport const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    age: 0,\n  },\n})","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Next, we can create "},{"type":"link","href":"https://tanstack.com/start/latest/docs/framework/react/server-functions","children":[{"type":"text","value":"a Start Server Function"}]},{"type":"text","value":" that will handle the form submission on the server."}]},{"type":"code","value":"// app/routes/index.tsx, but can be extracted to any other path\nimport {\n  createServerValidate,\n  ServerValidateError,\n} from '@tanstack/react-form-start'\n\nconst serverValidate = createServerValidate({\n  ...formOpts,\n  onServerValidate: ({ value }) => {\n    if (value.age < 12) {\n      return 'Server validation: You must be at least 12 to sign up'\n    }\n  },\n})\n\nexport const handleForm = createServerFn({\n  method: 'POST',\n})\n  .validator((data: unknown) => {\n    if (!(data instanceof FormData)) {\n      throw new Error('Invalid form data')\n    }\n    return data\n  })\n  .handler(async (ctx) => {\n    try {\n      const validatedData = await serverValidate(ctx.data)\n      console.log('validatedData', validatedData)\n      // Persist the form data to the database\n      // await sql`\n      //   INSERT INTO users (name, email, password)\n      //   VALUES (${validatedData.name}, ${validatedData.email}, ${validatedData.password})\n      // `\n    } catch (e) {\n      if (e instanceof ServerValidateError) {\n        // Log form errors or do any other logic here\n        return e.response\n      }\n\n      // Some other error occurred when parsing the form\n      console.error(e)\n      setResponseStatus(500)\n      return 'There was an internal error'\n    }\n\n    return 'Form has validated successfully'\n  })","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Then we need to establish a way to grab the form data from "},{"type":"inlineCode","value":"serverValidate"},{"type":"text","value":"'s "},{"type":"inlineCode","value":"response"},{"type":"text","value":" using another server action:"}]},{"type":"code","value":"// app/routes/index.tsx, but can be extracted to any other path\nimport { getFormData } from '@tanstack/react-form-start'\n\nexport const getFormDataFromServer = createServerFn({ method: 'GET' }).handler(\n  async () => {\n    return getFormData()\n  },\n)","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Finally, we'll use "},{"type":"inlineCode","value":"getFormDataFromServer"},{"type":"text","value":" in our loader to get the state from our server into our client and "},{"type":"inlineCode","value":"handleForm"},{"type":"text","value":" in our client-side form component."}]},{"type":"code","value":"// app/routes/index.tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport {\n  mergeForm,\n  useForm,\n  useSelector,\n  useTransform,\n} from '@tanstack/react-form-start'\n\nexport const Route = createFileRoute('/')({\n  component: Home,\n  loader: async () => ({\n    state: await getFormDataFromServer(),\n  }),\n})\n\nfunction Home() {\n  const { state } = Route.useLoaderData()\n  const form = useForm({\n    ...formOpts,\n    transform: useTransform((baseForm) => mergeForm(baseForm, state), [state]),\n  })\n\n  const formErrors = useSelector(form.store, (formState) => formState.errors)\n\n  return (\n    <form action={handleForm.url} method=\"post\" encType={'multipart/form-data'}>\n      {formErrors.map((error) => (\n        <p key={error as string}>{error}</p>\n      ))}\n\n      <form.Field\n        name=\"age\"\n        validators={{\n          onChange: ({ value }) =>\n            value < 8 ? 'Client validation: You must be at least 8' : undefined,\n        }}\n      >\n        {(field) => {\n          return (\n            <div>\n              <input\n                name={field.name}\n                type=\"number\"\n                value={field.state.value}\n                onChange={(e) => field.handleChange(e.target.valueAsNumber)}\n              />\n              {field.state.meta.errors.map((error) => (\n                <p key={error as string}>{error}</p>\n              ))}\n            </div>\n          )\n        }}\n      </form.Field>\n      <form.Subscribe\n        selector={(formState) => [formState.canSubmit, formState.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit}>\n            {isSubmitting ? '...' : 'Submit'}\n          </button>\n        )}\n      </form.Subscribe>\n    </form>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"using-tanstack-form-in-a-next-js-app-router","children":[{"type":"text","value":"Using TanStack Form in a Next.js App Router"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Before reading this section, it's suggested you understand how React Server Components and React Server Actions work. "},{"type":"link","href":"https://playfulprogramming.com/collections/react-beyond-the-render","children":[{"type":"text","value":"Check out this blog series for more information"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"This section focuses on integrating TanStack Form with "},{"type":"inlineCode","value":"Next.js"},{"type":"text","value":", particularly using the "},{"type":"inlineCode","value":"App Router"},{"type":"text","value":" and "},{"type":"inlineCode","value":"Server Actions"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"next-js-prerequisites","children":[{"type":"text","value":"Next.js Prerequisites"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Start a new "},{"type":"inlineCode","value":"Next.js"},{"type":"text","value":" project, following the steps in the "},{"type":"link","href":"https://nextjs.org/docs/getting-started/installation","children":[{"type":"text","value":"Next.js Documentation"}]},{"type":"text","value":". Ensure you select "},{"type":"inlineCode","value":"yes"},{"type":"text","value":" for "},{"type":"inlineCode","value":"Would you like to use App Router?"},{"type":"text","value":" during the setup to access all new features provided by Next.js."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/react-form"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Install any "},{"type":"link","href":"./validation#validation-through-schema-libraries","children":[{"type":"text","value":"form validator"}]},{"type":"text","value":" of your choice. [Optional]"}]}]}]},{"type":"heading","depth":2,"id":"app-router-integration","children":[{"type":"text","value":"App Router integration"}]},{"type":"paragraph","children":[{"type":"text","value":"Let's start by creating a "},{"type":"inlineCode","value":"formOption"},{"type":"text","value":" that we'll use to share the form's shape across the client and server."}]},{"type":"code","value":"// shared-code.ts\n// Notice the import path is different from the client\nimport { formOptions } from '@tanstack/react-form-nextjs'\n\n// You can pass other form options here\nexport const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    age: 0,\n  },\n})","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Next, we can create "},{"type":"link","href":"https://playfulprogramming.com/posts/what-are-react-server-components","children":[{"type":"text","value":"a React Server Action"}]},{"type":"text","value":" that will handle the form submission on the server."}]},{"type":"code","value":"// action.ts\n'use server'\n\n// Notice the import path is different from the client\nimport {\n  ServerValidateError,\n  createServerValidate,\n} from '@tanstack/react-form-nextjs'\nimport { formOpts } from './shared-code'\n\n// Create the server action that will infer the types of the form from `formOpts`\nconst serverValidate = createServerValidate({\n  ...formOpts,\n  onServerValidate: ({ value }) => {\n    if (value.age < 12) {\n      return 'Server validation: You must be at least 12 to sign up'\n    }\n  },\n})\n\nexport default async function someAction(prev: unknown, formData: FormData) {\n  try {\n    const validatedData = await serverValidate(formData)\n    console.log('validatedData', validatedData)\n    // Persist the form data to the database\n    // await sql`\n    //   INSERT INTO users (name, email, password)\n    //   VALUES (${validatedData.name}, ${validatedData.email}, ${validatedData.password})\n    // `\n  } catch (e) {\n    if (e instanceof ServerValidateError) {\n      return e.formState\n    }\n\n    // Some other error occurred while validating your form\n    throw e\n  }\n\n  // Your form has successfully validated!\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Finally, we'll use "},{"type":"inlineCode","value":"someAction"},{"type":"text","value":" in our client-side form component."}]},{"type":"code","value":"// client-component.tsx\n'use client'\n\nimport { useActionState } from 'react'\nimport {\n  initialFormState,\n  mergeForm,\n  useForm,\n  useSelector,\n  useTransform,\n} from '@tanstack/react-form-nextjs'\nimport someAction from './action'\nimport { formOpts } from './shared-code'\n\nexport const ClientComp = () => {\n  const [state, action] = useActionState(someAction, initialFormState)\n\n  const form = useForm({\n    ...formOpts,\n    transform: useTransform((baseForm) => mergeForm(baseForm, state!), [state]),\n  })\n\n  const formErrors = useSelector(form.store, (formState) => formState.errors)\n\n  return (\n    <form action={action as never} onSubmit={() => form.handleSubmit()}>\n      {formErrors.map((error) => (\n        <p key={error as string}>{error}</p>\n      ))}\n\n      <form.Field\n        name=\"age\"\n        validators={{\n          onChange: ({ value }) =>\n            value < 8 ? 'Client validation: You must be at least 8' : undefined,\n        }}\n      >\n        {(field) => {\n          return (\n            <div>\n              <input\n                name={field.name} // must explicitly set the name attribute for the POST request\n                type=\"number\"\n                value={field.state.value}\n                onChange={(e) => field.handleChange(e.target.valueAsNumber)}\n              />\n              {field.state.meta.errors.map((error) => (\n                <p key={error as string}>{error}</p>\n              ))}\n            </div>\n          )\n        }}\n      </form.Field>\n      <form.Subscribe\n        selector={(formState) => [formState.canSubmit, formState.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit}>\n            {isSubmitting ? '...' : 'Submit'}\n          </button>\n        )}\n      </form.Subscribe>\n    </form>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Here, we're using "},{"type":"link","href":"https://playfulprogramming.com/posts/what-is-use-action-state-and-form-status","children":[{"type":"text","value":"React's "},{"type":"inlineCode","value":"useActionState"},{"type":"text","value":" hook"}]},{"type":"text","value":" and TanStack Form's "},{"type":"inlineCode","value":"useTransform"},{"type":"text","value":" hook to merge state returned from the server action with the form state."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"If you get the following error in your Next.js application:"}]},{"type":"code","value":"x You're importing a component that needs `useState`. This React hook only works in a client component. To fix, mark the file (or its parent) with the `\"use client\"` directive.","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"This is because you're not importing server-side code from "},{"type":"inlineCode","value":"@tanstack/react-form-nextjs"},{"type":"text","value":". Ensure you're importing the correct module based on the environment."}]},{"type":"paragraph","children":[{"type":"link","href":"https://github.com/phryneas/rehackt","children":[{"type":"text","value":"This is a limitation of Next.js"}]},{"type":"text","value":". Other meta-frameworks will likely not have this same problem."}]}]},{"type":"heading","depth":2,"id":"using-tanstack-form-in-remix","children":[{"type":"text","value":"Using TanStack Form in Remix"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Before reading this section, it's suggested you understand how Remix actions work. "},{"type":"link","href":"https://remix.run/docs/en/main/discussion/data-flow#route-action","children":[{"type":"text","value":"Check out Remix's docs for more information"}]}]}]},{"type":"heading","depth":3,"id":"remix-prerequisites","children":[{"type":"text","value":"Remix Prerequisites"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Start a new "},{"type":"inlineCode","value":"Remix"},{"type":"text","value":" project, following the steps in the "},{"type":"link","href":"https://remix.run/docs/en/main/start/quickstart","children":[{"type":"text","value":"Remix Documentation"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/react-form"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Install any "},{"type":"link","href":"./validation#validation-through-schema-libraries","children":[{"type":"text","value":"form validator"}]},{"type":"text","value":" of your choice. [Optional]"}]}]}]},{"type":"heading","depth":2,"id":"remix-integration","children":[{"type":"text","value":"Remix integration"}]},{"type":"paragraph","children":[{"type":"text","value":"Let's start by creating a "},{"type":"inlineCode","value":"formOption"},{"type":"text","value":" that we'll use to share the form's shape across the client and server."}]},{"type":"code","value":"// routes/_index/route.tsx\nimport { formOptions } from '@tanstack/react-form-remix'\n\n// You can pass other form options here\nexport const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    age: 0,\n  },\n})","lang":"typescript"},{"type":"paragraph","children":[{"type":"text","value":"Next, we can create "},{"type":"link","href":"https://remix.run/docs/en/main/discussion/data-flow#route-action","children":[{"type":"text","value":"an action"}]},{"type":"text","value":" that will handle the form submission on the server."}]},{"type":"code","value":"// routes/_index/route.tsx\n\nimport {\n  ServerValidateError,\n  createServerValidate,\n  formOptions,\n} from '@tanstack/react-form-remix'\n\nimport type { ActionFunctionArgs } from '@remix-run/node'\n\n// export const formOpts = formOptions({\n\n// Create the server action that will infer the types of the form from `formOpts`\nconst serverValidate = createServerValidate({\n  ...formOpts,\n  onServerValidate: ({ value }) => {\n    if (value.age < 12) {\n      return 'Server validation: You must be at least 12 to sign up'\n    }\n  },\n})\n\nexport async function action({ request }: ActionFunctionArgs) {\n  const formData = await request.formData()\n  try {\n    const validatedData = await serverValidate(formData)\n    console.log('validatedData', validatedData)\n    // Persist the form data to the database\n    // await sql`\n    //   INSERT INTO users (name, email, password)\n    //   VALUES (${validatedData.name}, ${validatedData.email}, ${validatedData.password})\n    // `\n  } catch (e) {\n    if (e instanceof ServerValidateError) {\n      return e.formState\n    }\n\n    // Some other error occurred while validating your form\n    throw e\n  }\n\n  // Your form has successfully validated!\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Finally, the "},{"type":"inlineCode","value":"action"},{"type":"text","value":" will be called when the form submits."}]},{"type":"code","value":"// routes/_index/route.tsx\nimport {\n  Form,\n  mergeForm,\n  useActionData,\n  useForm,\n  useSelector,\n  useTransform,\n} from '@tanstack/react-form'\nimport {\n  ServerValidateError,\n  createServerValidate,\n  formOptions,\n  initialFormState,\n} from '@tanstack/react-form-remix'\n\nimport type { ActionFunctionArgs } from '@remix-run/node'\n\n// export const formOpts = formOptions({\n\n// const serverValidate = createServerValidate({\n\n// export async function action({request}: ActionFunctionArgs) {\n\nexport default function Index() {\n  const actionData = useActionData<typeof action>()\n\n  const form = useForm({\n    ...formOpts,\n    transform: useTransform(\n      (baseForm) => mergeForm(baseForm, actionData ?? initialFormState),\n      [actionData],\n    ),\n  })\n\n  const formErrors = useSelector(form.store, (formState) => formState.errors)\n\n  return (\n    <Form method=\"post\" onSubmit={() => form.handleSubmit()}>\n      {formErrors.map((error) => (\n        <p key={error as string}>{error}</p>\n      ))}\n\n      <form.Field\n        name=\"age\"\n        validators={{\n          onChange: ({ value }) =>\n            value < 8 ? 'Client validation: You must be at least 8' : undefined,\n        }}\n      >\n        {(field) => {\n          return (\n            <div>\n              <input\n                name=\"age\"\n                type=\"number\"\n                value={field.state.value}\n                onChange={(e) => field.handleChange(e.target.valueAsNumber)}\n              />\n              {field.state.meta.errors.map((error) => (\n                <p key={error as string}>{error}</p>\n              ))}\n            </div>\n          )\n        }}\n      </form.Field>\n      <form.Subscribe\n        selector={(formState) => [formState.canSubmit, formState.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit}>\n            {isSubmitting ? '...' : 'Submit'}\n          </button>\n        )}\n      </form.Subscribe>\n    </Form>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Here, we're using "},{"type":"link","href":"https://remix.run/docs/en/main/hooks/use-action-data","children":[{"type":"text","value":"Remix's "},{"type":"inlineCode","value":"useActionData"},{"type":"text","value":" hook"}]},{"type":"text","value":" and TanStack Form's "},{"type":"inlineCode","value":"useTransform"},{"type":"text","value":" hook to merge state returned from the server action with the form state."}]}],"headings":[{"id":"using-tanstack-form-in-tanstack-start","text":"Using TanStack Form in TanStack Start","level":2},{"id":"tanstack-start-prerequisites","text":"TanStack Start Prerequisites","level":3},{"id":"start-integration","text":"Start integration","level":3},{"id":"using-tanstack-form-in-a-next-js-app-router","text":"Using TanStack Form in a Next.js App Router","level":2},{"id":"next-js-prerequisites","text":"Next.js Prerequisites","level":3},{"id":"app-router-integration","text":"App Router integration","level":2},{"id":"using-tanstack-form-in-remix","text":"Using TanStack Form in Remix","level":2},{"id":"remix-prerequisites","text":"Remix Prerequisites","level":3},{"id":"remix-integration","text":"Remix integration","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Form is compatible with React out of the box, supporting `SSR` and being framework-agnostic. However, specific configurations are necessary, according to your chosen framework.\n\nToday we support the following meta-frameworks:\n\n- [TanStack Start](https://tanstack.com/start/)\n- [Next.js](https://nextjs.org/)\n- [Remix](https://remix.run)\n\n## Using TanStack Form in TanStack Start\n\nThis section focuses on integrating TanStack Form with TanStack Start.\n\nFor a complete client-driven mutation workflow with field errors, pending state, optimistic rollback, loader refresh, and redirect after saving, see the [TanStack Start form guide](/start/latest/docs/framework/react/guide/tanstack-form).\n\n### TanStack Start Prerequisites\n\n- Start a new `TanStack Start` project, following the steps in the [TanStack Start Quickstart Guide](https://tanstack.com/start/latest/docs/framework/react/getting-started)\n- Install `@tanstack/react-form-start`\n\n### Start integration\n\nLet's start by creating a `formOption` that we'll use to share the form's shape across the client and server.\n\n```typescript\n// app/routes/index.tsx, but can be extracted to any other path\nimport { formOptions } from '@tanstack/react-form-start'\n\n// You can pass other form options here\nexport const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    age: 0,\n  },\n})\n```\n\nNext, we can create [a Start Server Function](https://tanstack.com/start/latest/docs/framework/react/server-functions) that will handle the form submission on the server.\n\n```typescript\n// app/routes/index.tsx, but can be extracted to any other path\nimport {\n  createServerValidate,\n  ServerValidateError,\n} from '@tanstack/react-form-start'\n\nconst serverValidate = createServerValidate({\n  ...formOpts,\n  onServerValidate: ({ value }) => {\n    if (value.age < 12) {\n      return 'Server validation: You must be at least 12 to sign up'\n    }\n  },\n})\n\nexport const handleForm = createServerFn({\n  method: 'POST',\n})\n  .validator((data: unknown) => {\n    if (!(data instanceof FormData)) {\n      throw new Error('Invalid form data')\n    }\n    return data\n  })\n  .handler(async (ctx) => {\n    try {\n      const validatedData = await serverValidate(ctx.data)\n      console.log('validatedData', validatedData)\n      // Persist the form data to the database\n      // await sql`\n      //   INSERT INTO users (name, email, password)\n      //   VALUES (${validatedData.name}, ${validatedData.email}, ${validatedData.password})\n      // `\n    } catch (e) {\n      if (e instanceof ServerValidateError) {\n        // Log form errors or do any other logic here\n        return e.response\n      }\n\n      // Some other error occurred when parsing the form\n      console.error(e)\n      setResponseStatus(500)\n      return 'There was an internal error'\n    }\n\n    return 'Form has validated successfully'\n  })\n```\n\nThen we need to establish a way to grab the form data from `serverValidate`'s `response` using another server action:\n\n```typescript\n// app/routes/index.tsx, but can be extracted to any other path\nimport { getFormData } from '@tanstack/react-form-start'\n\nexport const getFormDataFromServer = createServerFn({ method: 'GET' }).handler(\n  async () => {\n    return getFormData()\n  },\n)\n```\n\nFinally, we'll use `getFormDataFromServer` in our loader to get the state from our server into our client and `handleForm` in our client-side form component.\n\n```tsx\n// app/routes/index.tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport {\n  mergeForm,\n  useForm,\n  useSelector,\n  useTransform,\n} from '@tanstack/react-form-start'\n\nexport const Route = createFileRoute('/')({\n  component: Home,\n  loader: async () => ({\n    state: await getFormDataFromServer(),\n  }),\n})\n\nfunction Home() {\n  const { state } = Route.useLoaderData()\n  const form = useForm({\n    ...formOpts,\n    transform: useTransform((baseForm) => mergeForm(baseForm, state), [state]),\n  })\n\n  const formErrors = useSelector(form.store, (formState) => formState.errors)\n\n  return (\n    <form action={handleForm.url} method=\"post\" encType={'multipart/form-data'}>\n      {formErrors.map((error) => (\n        <p key={error as string}>{error}</p>\n      ))}\n\n      <form.Field\n        name=\"age\"\n        validators={{\n          onChange: ({ value }) =>\n            value < 8 ? 'Client validation: You must be at least 8' : undefined,\n        }}\n      >\n        {(field) => {\n          return (\n            <div>\n              <input\n                name={field.name}\n                type=\"number\"\n                value={field.state.value}\n                onChange={(e) => field.handleChange(e.target.valueAsNumber)}\n              />\n              {field.state.meta.errors.map((error) => (\n                <p key={error as string}>{error}</p>\n              ))}\n            </div>\n          )\n        }}\n      </form.Field>\n      <form.Subscribe\n        selector={(formState) => [formState.canSubmit, formState.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit}>\n            {isSubmitting ? '...' : 'Submit'}\n          </button>\n        )}\n      </form.Subscribe>\n    </form>\n  )\n}\n```\n\n## Using TanStack Form in a Next.js App Router\n\n> Before reading this section, it's suggested you understand how React Server Components and React Server Actions work. [Check out this blog series for more information](https://playfulprogramming.com/collections/react-beyond-the-render)\n\nThis section focuses on integrating TanStack Form with `Next.js`, particularly using the `App Router` and `Server Actions`.\n\n### Next.js Prerequisites\n\n- Start a new `Next.js` project, following the steps in the [Next.js Documentation](https://nextjs.org/docs/getting-started/installation). Ensure you select `yes` for `Would you like to use App Router?` during the setup to access all new features provided by Next.js.\n- Install `@tanstack/react-form`\n- Install any [form validator](./validation#validation-through-schema-libraries) of your choice. [Optional]\n\n## App Router integration\n\nLet's start by creating a `formOption` that we'll use to share the form's shape across the client and server.\n\n```typescript\n// shared-code.ts\n// Notice the import path is different from the client\nimport { formOptions } from '@tanstack/react-form-nextjs'\n\n// You can pass other form options here\nexport const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    age: 0,\n  },\n})\n```\n\nNext, we can create [a React Server Action](https://playfulprogramming.com/posts/what-are-react-server-components) that will handle the form submission on the server.\n\n```typescript\n// action.ts\n'use server'\n\n// Notice the import path is different from the client\nimport {\n  ServerValidateError,\n  createServerValidate,\n} from '@tanstack/react-form-nextjs'\nimport { formOpts } from './shared-code'\n\n// Create the server action that will infer the types of the form from `formOpts`\nconst serverValidate = createServerValidate({\n  ...formOpts,\n  onServerValidate: ({ value }) => {\n    if (value.age < 12) {\n      return 'Server validation: You must be at least 12 to sign up'\n    }\n  },\n})\n\nexport default async function someAction(prev: unknown, formData: FormData) {\n  try {\n    const validatedData = await serverValidate(formData)\n    console.log('validatedData', validatedData)\n    // Persist the form data to the database\n    // await sql`\n    //   INSERT INTO users (name, email, password)\n    //   VALUES (${validatedData.name}, ${validatedData.email}, ${validatedData.password})\n    // `\n  } catch (e) {\n    if (e instanceof ServerValidateError) {\n      return e.formState\n    }\n\n    // Some other error occurred while validating your form\n    throw e\n  }\n\n  // Your form has successfully validated!\n}\n```\n\nFinally, we'll use `someAction` in our client-side form component.\n\n```tsx\n// client-component.tsx\n'use client'\n\nimport { useActionState } from 'react'\nimport {\n  initialFormState,\n  mergeForm,\n  useForm,\n  useSelector,\n  useTransform,\n} from '@tanstack/react-form-nextjs'\nimport someAction from './action'\nimport { formOpts } from './shared-code'\n\nexport const ClientComp = () => {\n  const [state, action] = useActionState(someAction, initialFormState)\n\n  const form = useForm({\n    ...formOpts,\n    transform: useTransform((baseForm) => mergeForm(baseForm, state!), [state]),\n  })\n\n  const formErrors = useSelector(form.store, (formState) => formState.errors)\n\n  return (\n    <form action={action as never} onSubmit={() => form.handleSubmit()}>\n      {formErrors.map((error) => (\n        <p key={error as string}>{error}</p>\n      ))}\n\n      <form.Field\n        name=\"age\"\n        validators={{\n          onChange: ({ value }) =>\n            value < 8 ? 'Client validation: You must be at least 8' : undefined,\n        }}\n      >\n        {(field) => {\n          return (\n            <div>\n              <input\n                name={field.name} // must explicitly set the name attribute for the POST request\n                type=\"number\"\n                value={field.state.value}\n                onChange={(e) => field.handleChange(e.target.valueAsNumber)}\n              />\n              {field.state.meta.errors.map((error) => (\n                <p key={error as string}>{error}</p>\n              ))}\n            </div>\n          )\n        }}\n      </form.Field>\n      <form.Subscribe\n        selector={(formState) => [formState.canSubmit, formState.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit}>\n            {isSubmitting ? '...' : 'Submit'}\n          </button>\n        )}\n      </form.Subscribe>\n    </form>\n  )\n}\n```\n\nHere, we're using [React's `useActionState` hook](https://playfulprogramming.com/posts/what-is-use-action-state-and-form-status) and TanStack Form's `useTransform` hook to merge state returned from the server action with the form state.\n\n> If you get the following error in your Next.js application:\n>\n> ```typescript\n> x You're importing a component that needs `useState`. This React hook only works in a client component. To fix, mark the file (or its parent) with the `\"use client\"` directive.\n> ```\n>\n> This is because you're not importing server-side code from `@tanstack/react-form-nextjs`. Ensure you're importing the correct module based on the environment.\n>\n> [This is a limitation of Next.js](https://github.com/phryneas/rehackt). Other meta-frameworks will likely not have this same problem.\n\n## Using TanStack Form in Remix\n\n> Before reading this section, it's suggested you understand how Remix actions work. [Check out Remix's docs for more information](https://remix.run/docs/en/main/discussion/data-flow#route-action)\n\n### Remix Prerequisites\n\n- Start a new `Remix` project, following the steps in the [Remix Documentation](https://remix.run/docs/en/main/start/quickstart).\n- Install `@tanstack/react-form`\n- Install any [form validator](./validation#validation-through-schema-libraries) of your choice. [Optional]\n\n## Remix integration\n\nLet's start by creating a `formOption` that we'll use to share the form's shape across the client and server.\n\n```typescript\n// routes/_index/route.tsx\nimport { formOptions } from '@tanstack/react-form-remix'\n\n// You can pass other form options here\nexport const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    age: 0,\n  },\n})\n```\n\nNext, we can create [an action](https://remix.run/docs/en/main/discussion/data-flow#route-action) that will handle the form submission on the server.\n\n```tsx\n// routes/_index/route.tsx\n\nimport {\n  ServerValidateError,\n  createServerValidate,\n  formOptions,\n} from '@tanstack/react-form-remix'\n\nimport type { ActionFunctionArgs } from '@remix-run/node'\n\n// export const formOpts = formOptions({\n\n// Create the server action that will infer the types of the form from `formOpts`\nconst serverValidate = createServerValidate({\n  ...formOpts,\n  onServerValidate: ({ value }) => {\n    if (value.age < 12) {\n      return 'Server validation: You must be at least 12 to sign up'\n    }\n  },\n})\n\nexport async function action({ request }: ActionFunctionArgs) {\n  const formData = await request.formData()\n  try {\n    const validatedData = await serverValidate(formData)\n    console.log('validatedData', validatedData)\n    // Persist the form data to the database\n    // await sql`\n    //   INSERT INTO users (name, email, password)\n    //   VALUES (${validatedData.name}, ${validatedData.email}, ${validatedData.password})\n    // `\n  } catch (e) {\n    if (e instanceof ServerValidateError) {\n      return e.formState\n    }\n\n    // Some other error occurred while validating your form\n    throw e\n  }\n\n  // Your form has successfully validated!\n}\n```\n\nFinally, the `action` will be called when the form submits.\n\n```tsx\n// routes/_index/route.tsx\nimport {\n  Form,\n  mergeForm,\n  useActionData,\n  useForm,\n  useSelector,\n  useTransform,\n} from '@tanstack/react-form'\nimport {\n  ServerValidateError,\n  createServerValidate,\n  formOptions,\n  initialFormState,\n} from '@tanstack/react-form-remix'\n\nimport type { ActionFunctionArgs } from '@remix-run/node'\n\n// export const formOpts = formOptions({\n\n// const serverValidate = createServerValidate({\n\n// export async function action({request}: ActionFunctionArgs) {\n\nexport default function Index() {\n  const actionData = useActionData<typeof action>()\n\n  const form = useForm({\n    ...formOpts,\n    transform: useTransform(\n      (baseForm) => mergeForm(baseForm, actionData ?? initialFormState),\n      [actionData],\n    ),\n  })\n\n  const formErrors = useSelector(form.store, (formState) => formState.errors)\n\n  return (\n    <Form method=\"post\" onSubmit={() => form.handleSubmit()}>\n      {formErrors.map((error) => (\n        <p key={error as string}>{error}</p>\n      ))}\n\n      <form.Field\n        name=\"age\"\n        validators={{\n          onChange: ({ value }) =>\n            value < 8 ? 'Client validation: You must be at least 8' : undefined,\n        }}\n      >\n        {(field) => {\n          return (\n            <div>\n              <input\n                name=\"age\"\n                type=\"number\"\n                value={field.state.value}\n                onChange={(e) => field.handleChange(e.target.valueAsNumber)}\n              />\n              {field.state.meta.errors.map((error) => (\n                <p key={error as string}>{error}</p>\n              ))}\n            </div>\n          )\n        }}\n      </form.Field>\n      <form.Subscribe\n        selector={(formState) => [formState.canSubmit, formState.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit}>\n            {isSubmitting ? '...' : 'Submit'}\n          </button>\n        )}\n      </form.Subscribe>\n    </Form>\n  )\n}\n```\n\nHere, we're using [Remix's `useActionData` hook](https://remix.run/docs/en/main/hooks/use-action-data) and TanStack Form's `useTransform` hook to merge state returned from the server action with the form state.\n","originalRawMarkdown":"---\nid: ssr\ntitle: React Meta-Framework Usage\n---\n\nTanStack Form is compatible with React out of the box, supporting `SSR` and being framework-agnostic. However, specific configurations are necessary, according to your chosen framework.\n\nToday we support the following meta-frameworks:\n\n- [TanStack Start](https://tanstack.com/start/)\n- [Next.js](https://nextjs.org/)\n- [Remix](https://remix.run)\n\n## Using TanStack Form in TanStack Start\n\nThis section focuses on integrating TanStack Form with TanStack Start.\n\nFor a complete client-driven mutation workflow with field errors, pending state, optimistic rollback, loader refresh, and redirect after saving, see the [TanStack Start form guide](/start/latest/docs/framework/react/guide/tanstack-form).\n\n### TanStack Start Prerequisites\n\n- Start a new `TanStack Start` project, following the steps in the [TanStack Start Quickstart Guide](https://tanstack.com/start/latest/docs/framework/react/getting-started)\n- Install `@tanstack/react-form-start`\n\n### Start integration\n\nLet's start by creating a `formOption` that we'll use to share the form's shape across the client and server.\n\n```typescript\n// app/routes/index.tsx, but can be extracted to any other path\nimport { formOptions } from '@tanstack/react-form-start'\n\n// You can pass other form options here\nexport const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    age: 0,\n  },\n})\n```\n\nNext, we can create [a Start Server Function](https://tanstack.com/start/latest/docs/framework/react/server-functions) that will handle the form submission on the server.\n\n```typescript\n// app/routes/index.tsx, but can be extracted to any other path\nimport {\n  createServerValidate,\n  ServerValidateError,\n} from '@tanstack/react-form-start'\n\nconst serverValidate = createServerValidate({\n  ...formOpts,\n  onServerValidate: ({ value }) => {\n    if (value.age < 12) {\n      return 'Server validation: You must be at least 12 to sign up'\n    }\n  },\n})\n\nexport const handleForm = createServerFn({\n  method: 'POST',\n})\n  .validator((data: unknown) => {\n    if (!(data instanceof FormData)) {\n      throw new Error('Invalid form data')\n    }\n    return data\n  })\n  .handler(async (ctx) => {\n    try {\n      const validatedData = await serverValidate(ctx.data)\n      console.log('validatedData', validatedData)\n      // Persist the form data to the database\n      // await sql`\n      //   INSERT INTO users (name, email, password)\n      //   VALUES (${validatedData.name}, ${validatedData.email}, ${validatedData.password})\n      // `\n    } catch (e) {\n      if (e instanceof ServerValidateError) {\n        // Log form errors or do any other logic here\n        return e.response\n      }\n\n      // Some other error occurred when parsing the form\n      console.error(e)\n      setResponseStatus(500)\n      return 'There was an internal error'\n    }\n\n    return 'Form has validated successfully'\n  })\n```\n\nThen we need to establish a way to grab the form data from `serverValidate`'s `response` using another server action:\n\n```typescript\n// app/routes/index.tsx, but can be extracted to any other path\nimport { getFormData } from '@tanstack/react-form-start'\n\nexport const getFormDataFromServer = createServerFn({ method: 'GET' }).handler(\n  async () => {\n    return getFormData()\n  },\n)\n```\n\nFinally, we'll use `getFormDataFromServer` in our loader to get the state from our server into our client and `handleForm` in our client-side form component.\n\n```tsx\n// app/routes/index.tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport {\n  mergeForm,\n  useForm,\n  useSelector,\n  useTransform,\n} from '@tanstack/react-form-start'\n\nexport const Route = createFileRoute('/')({\n  component: Home,\n  loader: async () => ({\n    state: await getFormDataFromServer(),\n  }),\n})\n\nfunction Home() {\n  const { state } = Route.useLoaderData()\n  const form = useForm({\n    ...formOpts,\n    transform: useTransform((baseForm) => mergeForm(baseForm, state), [state]),\n  })\n\n  const formErrors = useSelector(form.store, (formState) => formState.errors)\n\n  return (\n    <form action={handleForm.url} method=\"post\" encType={'multipart/form-data'}>\n      {formErrors.map((error) => (\n        <p key={error as string}>{error}</p>\n      ))}\n\n      <form.Field\n        name=\"age\"\n        validators={{\n          onChange: ({ value }) =>\n            value < 8 ? 'Client validation: You must be at least 8' : undefined,\n        }}\n      >\n        {(field) => {\n          return (\n            <div>\n              <input\n                name={field.name}\n                type=\"number\"\n                value={field.state.value}\n                onChange={(e) => field.handleChange(e.target.valueAsNumber)}\n              />\n              {field.state.meta.errors.map((error) => (\n                <p key={error as string}>{error}</p>\n              ))}\n            </div>\n          )\n        }}\n      </form.Field>\n      <form.Subscribe\n        selector={(formState) => [formState.canSubmit, formState.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit}>\n            {isSubmitting ? '...' : 'Submit'}\n          </button>\n        )}\n      </form.Subscribe>\n    </form>\n  )\n}\n```\n\n## Using TanStack Form in a Next.js App Router\n\n> Before reading this section, it's suggested you understand how React Server Components and React Server Actions work. [Check out this blog series for more information](https://playfulprogramming.com/collections/react-beyond-the-render)\n\nThis section focuses on integrating TanStack Form with `Next.js`, particularly using the `App Router` and `Server Actions`.\n\n### Next.js Prerequisites\n\n- Start a new `Next.js` project, following the steps in the [Next.js Documentation](https://nextjs.org/docs/getting-started/installation). Ensure you select `yes` for `Would you like to use App Router?` during the setup to access all new features provided by Next.js.\n- Install `@tanstack/react-form`\n- Install any [form validator](./validation#validation-through-schema-libraries) of your choice. [Optional]\n\n## App Router integration\n\nLet's start by creating a `formOption` that we'll use to share the form's shape across the client and server.\n\n```typescript\n// shared-code.ts\n// Notice the import path is different from the client\nimport { formOptions } from '@tanstack/react-form-nextjs'\n\n// You can pass other form options here\nexport const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    age: 0,\n  },\n})\n```\n\nNext, we can create [a React Server Action](https://playfulprogramming.com/posts/what-are-react-server-components) that will handle the form submission on the server.\n\n```typescript\n// action.ts\n'use server'\n\n// Notice the import path is different from the client\nimport {\n  ServerValidateError,\n  createServerValidate,\n} from '@tanstack/react-form-nextjs'\nimport { formOpts } from './shared-code'\n\n// Create the server action that will infer the types of the form from `formOpts`\nconst serverValidate = createServerValidate({\n  ...formOpts,\n  onServerValidate: ({ value }) => {\n    if (value.age < 12) {\n      return 'Server validation: You must be at least 12 to sign up'\n    }\n  },\n})\n\nexport default async function someAction(prev: unknown, formData: FormData) {\n  try {\n    const validatedData = await serverValidate(formData)\n    console.log('validatedData', validatedData)\n    // Persist the form data to the database\n    // await sql`\n    //   INSERT INTO users (name, email, password)\n    //   VALUES (${validatedData.name}, ${validatedData.email}, ${validatedData.password})\n    // `\n  } catch (e) {\n    if (e instanceof ServerValidateError) {\n      return e.formState\n    }\n\n    // Some other error occurred while validating your form\n    throw e\n  }\n\n  // Your form has successfully validated!\n}\n```\n\nFinally, we'll use `someAction` in our client-side form component.\n\n```tsx\n// client-component.tsx\n'use client'\n\nimport { useActionState } from 'react'\nimport {\n  initialFormState,\n  mergeForm,\n  useForm,\n  useSelector,\n  useTransform,\n} from '@tanstack/react-form-nextjs'\nimport someAction from './action'\nimport { formOpts } from './shared-code'\n\nexport const ClientComp = () => {\n  const [state, action] = useActionState(someAction, initialFormState)\n\n  const form = useForm({\n    ...formOpts,\n    transform: useTransform((baseForm) => mergeForm(baseForm, state!), [state]),\n  })\n\n  const formErrors = useSelector(form.store, (formState) => formState.errors)\n\n  return (\n    <form action={action as never} onSubmit={() => form.handleSubmit()}>\n      {formErrors.map((error) => (\n        <p key={error as string}>{error}</p>\n      ))}\n\n      <form.Field\n        name=\"age\"\n        validators={{\n          onChange: ({ value }) =>\n            value < 8 ? 'Client validation: You must be at least 8' : undefined,\n        }}\n      >\n        {(field) => {\n          return (\n            <div>\n              <input\n                name={field.name} // must explicitly set the name attribute for the POST request\n                type=\"number\"\n                value={field.state.value}\n                onChange={(e) => field.handleChange(e.target.valueAsNumber)}\n              />\n              {field.state.meta.errors.map((error) => (\n                <p key={error as string}>{error}</p>\n              ))}\n            </div>\n          )\n        }}\n      </form.Field>\n      <form.Subscribe\n        selector={(formState) => [formState.canSubmit, formState.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit}>\n            {isSubmitting ? '...' : 'Submit'}\n          </button>\n        )}\n      </form.Subscribe>\n    </form>\n  )\n}\n```\n\nHere, we're using [React's `useActionState` hook](https://playfulprogramming.com/posts/what-is-use-action-state-and-form-status) and TanStack Form's `useTransform` hook to merge state returned from the server action with the form state.\n\n> If you get the following error in your Next.js application:\n>\n> ```typescript\n> x You're importing a component that needs `useState`. This React hook only works in a client component. To fix, mark the file (or its parent) with the `\"use client\"` directive.\n> ```\n>\n> This is because you're not importing server-side code from `@tanstack/react-form-nextjs`. Ensure you're importing the correct module based on the environment.\n>\n> [This is a limitation of Next.js](https://github.com/phryneas/rehackt). Other meta-frameworks will likely not have this same problem.\n\n## Using TanStack Form in Remix\n\n> Before reading this section, it's suggested you understand how Remix actions work. [Check out Remix's docs for more information](https://remix.run/docs/en/main/discussion/data-flow#route-action)\n\n### Remix Prerequisites\n\n- Start a new `Remix` project, following the steps in the [Remix Documentation](https://remix.run/docs/en/main/start/quickstart).\n- Install `@tanstack/react-form`\n- Install any [form validator](./validation#validation-through-schema-libraries) of your choice. [Optional]\n\n## Remix integration\n\nLet's start by creating a `formOption` that we'll use to share the form's shape across the client and server.\n\n```typescript\n// routes/_index/route.tsx\nimport { formOptions } from '@tanstack/react-form-remix'\n\n// You can pass other form options here\nexport const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    age: 0,\n  },\n})\n```\n\nNext, we can create [an action](https://remix.run/docs/en/main/discussion/data-flow#route-action) that will handle the form submission on the server.\n\n```tsx\n// routes/_index/route.tsx\n\nimport {\n  ServerValidateError,\n  createServerValidate,\n  formOptions,\n} from '@tanstack/react-form-remix'\n\nimport type { ActionFunctionArgs } from '@remix-run/node'\n\n// export const formOpts = formOptions({\n\n// Create the server action that will infer the types of the form from `formOpts`\nconst serverValidate = createServerValidate({\n  ...formOpts,\n  onServerValidate: ({ value }) => {\n    if (value.age < 12) {\n      return 'Server validation: You must be at least 12 to sign up'\n    }\n  },\n})\n\nexport async function action({ request }: ActionFunctionArgs) {\n  const formData = await request.formData()\n  try {\n    const validatedData = await serverValidate(formData)\n    console.log('validatedData', validatedData)\n    // Persist the form data to the database\n    // await sql`\n    //   INSERT INTO users (name, email, password)\n    //   VALUES (${validatedData.name}, ${validatedData.email}, ${validatedData.password})\n    // `\n  } catch (e) {\n    if (e instanceof ServerValidateError) {\n      return e.formState\n    }\n\n    // Some other error occurred while validating your form\n    throw e\n  }\n\n  // Your form has successfully validated!\n}\n```\n\nFinally, the `action` will be called when the form submits.\n\n```tsx\n// routes/_index/route.tsx\nimport {\n  Form,\n  mergeForm,\n  useActionData,\n  useForm,\n  useSelector,\n  useTransform,\n} from '@tanstack/react-form'\nimport {\n  ServerValidateError,\n  createServerValidate,\n  formOptions,\n  initialFormState,\n} from '@tanstack/react-form-remix'\n\nimport type { ActionFunctionArgs } from '@remix-run/node'\n\n// export const formOpts = formOptions({\n\n// const serverValidate = createServerValidate({\n\n// export async function action({request}: ActionFunctionArgs) {\n\nexport default function Index() {\n  const actionData = useActionData<typeof action>()\n\n  const form = useForm({\n    ...formOpts,\n    transform: useTransform(\n      (baseForm) => mergeForm(baseForm, actionData ?? initialFormState),\n      [actionData],\n    ),\n  })\n\n  const formErrors = useSelector(form.store, (formState) => formState.errors)\n\n  return (\n    <Form method=\"post\" onSubmit={() => form.handleSubmit()}>\n      {formErrors.map((error) => (\n        <p key={error as string}>{error}</p>\n      ))}\n\n      <form.Field\n        name=\"age\"\n        validators={{\n          onChange: ({ value }) =>\n            value < 8 ? 'Client validation: You must be at least 8' : undefined,\n        }}\n      >\n        {(field) => {\n          return (\n            <div>\n              <input\n                name=\"age\"\n                type=\"number\"\n                value={field.state.value}\n                onChange={(e) => field.handleChange(e.target.valueAsNumber)}\n              />\n              {field.state.meta.errors.map((error) => (\n                <p key={error as string}>{error}</p>\n              ))}\n            </div>\n          )\n        }}\n      </form.Field>\n      <form.Subscribe\n        selector={(formState) => [formState.canSubmit, formState.isSubmitting]}\n      >\n        {([canSubmit, isSubmitting]) => (\n          <button type=\"submit\" disabled={!canSubmit}>\n            {isSubmitting ? '...' : 'Submit'}\n          </button>\n        )}\n      </form.Subscribe>\n    </Form>\n  )\n}\n```\n\nHere, we're using [Remix's `useActionData` hook](https://remix.run/docs/en/main/hooks/use-action-data) and TanStack Form's `useTransform` hook to merge state returned from the server action with the form state.\n"}
