NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"This page introduces the basic concepts and terminology used in the "},{"type":"inlineCode","value":"@tanstack/solid-form"},{"type":"text","value":" library. Familiarizing yourself with these concepts will help you better understand and work with the library."}]},{"type":"heading","depth":2,"id":"form-options","children":[{"type":"text","value":"Form Options"}]},{"type":"paragraph","children":[{"type":"text","value":"You can create options for your form so that it can be shared between multiple forms by using the "},{"type":"inlineCode","value":"formOptions"},{"type":"text","value":" function."}]},{"type":"paragraph","children":[{"type":"text","value":"Example:"}]},{"type":"code","value":"const formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    hobbies: [],\n  } as Person,\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"form-instance","children":[{"type":"text","value":"Form Instance"}]},{"type":"paragraph","children":[{"type":"text","value":"A Form Instance is an object that represents an individual form and provides methods and properties for working with the form. You create a form instance using the "},{"type":"inlineCode","value":"createForm"},{"type":"text","value":" hook provided by the form options. The hook accepts an object with an "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":" function, which is called when the form is submitted."}]},{"type":"code","value":"const form = createForm(() => ({\n  ...formOpts,\n  onSubmit: async ({ value }) => {\n    // Do something with form data\n    console.log(value)\n  },\n}))","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"You may also create a form instance without using "},{"type":"inlineCode","value":"formOptions"},{"type":"text","value":" by using the standalone "},{"type":"inlineCode","value":"createForm"},{"type":"text","value":" API:"}]},{"type":"code","value":"const form = createForm<Person>(() => ({\n  onSubmit: async ({ value }) => {\n    // Do something with form data\n    console.log(value)\n  },\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    hobbies: [],\n  },\n}))","lang":"tsx"},{"type":"heading","depth":2,"id":"field","children":[{"type":"text","value":"Field"}]},{"type":"paragraph","children":[{"type":"text","value":"A Field represents a single form input element, such as a text input or a checkbox. Fields are created using the "},{"type":"inlineCode","value":"form.Field"},{"type":"text","value":" component provided by the form instance. The component accepts a name prop, which should match a key in the form's default values. It also accepts a children prop, which is a render prop function that takes a field object as its argument."}]},{"type":"paragraph","children":[{"type":"text","value":"Example:"}]},{"type":"code","value":"<form.Field\n  name=\"firstName\"\n  children={(field) => (\n    <input\n      name={field().name}\n      value={field().state.value}\n      onBlur={field().handleBlur}\n      onInput={(e) => field().handleChange(e.target.value)}\n    />\n  )}\n/>","lang":"tsx"},{"type":"heading","depth":2,"id":"field-state","children":[{"type":"text","value":"Field State"}]},{"type":"paragraph","children":[{"type":"text","value":"Each field has its own state, which includes its current value, validation status, error messages, and other metadata. You can access a field's state using the "},{"type":"inlineCode","value":"field().state"},{"type":"text","value":" property."}]},{"type":"paragraph","children":[{"type":"text","value":"Example:"}]},{"type":"code","value":"const {\n  value,\n  meta: { errors, isValidating },\n} = field().state","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"There are four states in the metadata that can be useful to see how the user interacts with a field:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isTouched\""}]},{"type":"text","value":", after the user changes the field or blurs the field"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isDirty\""}]},{"type":"text","value":", after the field's value has been changed, even if it's been reverted to the default. Opposite of "},{"type":"inlineCode","value":"isPristine"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isPristine\""}]},{"type":"text","value":", until the user changes the field value. Opposite of "},{"type":"inlineCode","value":"isDirty"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isBlurred\""}]},{"type":"text","value":", after the field has been blurred"}]}]}]},{"type":"code","value":"const { isTouched, isDirty, isPristine, isBlurred } = field().state.meta","lang":"ts"},{"type":"paragraph","children":[{"type":"image","src":"https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states.png","alt":"Field states"}]},{"type":"heading","depth":2,"id":"understanding-isdirty-in-different-libraries","children":[{"type":"text","value":"Understanding 'isDirty' in Different Libraries"}]},{"type":"paragraph","children":[{"type":"text","value":"Non-Persistent "},{"type":"inlineCode","value":"dirty"},{"type":"text","value":" state"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Libraries"}]},{"type":"text","value":": React Hook Form (RHF), Formik, Final Form."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Behavior"}]},{"type":"text","value":": A field is 'dirty' if its value differs from the default. Reverting to the default value makes it 'clean' again."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Persistent "},{"type":"inlineCode","value":"dirty"},{"type":"text","value":" state"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Libraries"}]},{"type":"text","value":": Angular Form, Vue FormKit."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Behavior"}]},{"type":"text","value":": A field remains 'dirty' once changed, even if reverted to the default value."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"We have chosen the persistent 'dirty' state model. To also support a non-persistent 'dirty' state, we introduce an additional flag:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"\"isDefaultValue\""}]},{"type":"text","value":", whether the field's current value is the default value"}]}]}]},{"type":"code","value":"const { isDefaultValue, isTouched } = field().state.meta\n\n// The following line will re-create the non-Persistent `dirty` functionality.\nconst nonPersistentIsDirty = !isDefaultValue","lang":"ts"},{"type":"paragraph","children":[{"type":"image","src":"https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states-extended.png","alt":"Field states extended"}]},{"type":"heading","depth":2,"id":"field-api","children":[{"type":"text","value":"Field API"}]},{"type":"paragraph","children":[{"type":"text","value":"The Field API is an object passed to the render prop function when creating a field. It provides methods for working with the field's state."}]},{"type":"paragraph","children":[{"type":"text","value":"Example:"}]},{"type":"code","value":"<input\n  name={field().name}\n  value={field().state.value}\n  onBlur={field().handleBlur}\n  onInput={(e) => field().handleChange(e.target.value)}\n/>","lang":"tsx"},{"type":"heading","depth":2,"id":"validation","children":[{"type":"text","value":"Validation"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/solid-form"},{"type":"text","value":" provides both synchronous and asynchronous validation out of the box. Validation functions can be passed to the "},{"type":"inlineCode","value":"form.Field"},{"type":"text","value":" component using the "},{"type":"inlineCode","value":"validators"},{"type":"text","value":" prop."}]},{"type":"paragraph","children":[{"type":"text","value":"Example:"}]},{"type":"code","value":"<form.Field\n  name=\"firstName\"\n  validators={{\n    onChange: ({ value }) =>\n      !value\n        ? 'A first name is required'\n        : value.length < 3\n          ? 'First name must be at least 3 characters'\n          : undefined,\n    onChangeAsync: async ({ value }) => {\n      await new Promise((resolve) => setTimeout(resolve, 1000))\n      return value.includes('error') && 'No \"error\" allowed in first name'\n    },\n  }}\n  children={(field) => (\n    <>\n      <input\n        name={field().name}\n        value={field().state.value}\n        onBlur={field().handleBlur}\n        onInput={(e) => field().handleChange(e.target.value)}\n      />\n      <p>{field().state.meta.errors[0]}</p>\n    </>\n  )}\n/>","lang":"tsx"},{"type":"heading","depth":2,"id":"validation-with-standard-schema-libraries","children":[{"type":"text","value":"Validation with Standard Schema Libraries"}]},{"type":"paragraph","children":[{"type":"text","value":"In addition to hand-rolled validation options, we also support the "},{"type":"link","href":"https://github.com/standard-schema/standard-schema","children":[{"type":"text","value":"Standard Schema"}]},{"type":"text","value":" specification."}]},{"type":"paragraph","children":[{"type":"text","value":"You can define a schema using any of the libraries implementing the specification and pass it to a form or field validator."}]},{"type":"paragraph","children":[{"type":"text","value":"Supported libraries include:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://zod.dev/","children":[{"type":"text","value":"Zod"}]},{"type":"text","value":" (v3.24.0 or higher)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://valibot.dev/","children":[{"type":"text","value":"Valibot"}]},{"type":"text","value":" (v1.0.0 or higher)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://arktype.io/","children":[{"type":"text","value":"ArkType"}]},{"type":"text","value":" (v2.1.20 or higher)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://github.com/jquense/yup","children":[{"type":"text","value":"Yup"}]},{"type":"text","value":" (v1.7.0 or higher)"}]}]}]},{"type":"code","value":"import { z } from 'zod'\n\n// ...\n;<form.Field\n  name=\"firstName\"\n  validators={{\n    onChange: z.string().min(3, 'First name must be at least 3 characters'),\n    onChangeAsyncDebounceMs: 500,\n    onChangeAsync: z.string().refine(\n      async (value) => {\n        await new Promise((resolve) => setTimeout(resolve, 1000))\n        return !value.includes('error')\n      },\n      {\n        message: 'No \"error\" allowed in first name',\n      },\n    ),\n  }}\n  children={(field) => (\n    <>\n      <input\n        name={field().name}\n        value={field().state.value}\n        onBlur={field().handleBlur}\n        onInput={(e) => field().handleChange(e.target.value)}\n      />\n      <p>{field().state.meta.errors[0]}</p>\n    </>\n  )}\n/>","lang":"tsx"},{"type":"heading","depth":2,"id":"reactivity","children":[{"type":"text","value":"Reactivity"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/solid-form"},{"type":"text","value":" offers various ways to subscribe to form and field state changes, most notably the "},{"type":"inlineCode","value":"form.useSelector"},{"type":"text","value":" hook and the "},{"type":"inlineCode","value":"form.Subscribe"},{"type":"text","value":" component. These methods allow you to optimize your form's rendering performance by only updating components when necessary."}]},{"type":"paragraph","children":[{"type":"text","value":"Example:"}]},{"type":"code","value":"const firstName = form.useSelector((state) => state.values.firstName)\n//...\n<form.Subscribe\n  selector={(state) => ({\n    canSubmit: state.canSubmit,\n    isSubmitting: state.isSubmitting,\n  })}\n  children={(state) => (\n    <button type=\"submit\" disabled={!state().canSubmit}>\n      {state().isSubmitting ? '...' : 'Submit'}\n    </button>\n  )}\n/>","lang":"tsx"},{"type":"heading","depth":2,"id":"array-fields","children":[{"type":"text","value":"Array Fields"}]},{"type":"paragraph","children":[{"type":"text","value":"Array fields allow you to manage a list of values within a form, such as a list of hobbies. You can create an array field using the "},{"type":"inlineCode","value":"form.Field"},{"type":"text","value":" component with the "},{"type":"inlineCode","value":"mode=\"array\""},{"type":"text","value":" prop."}]},{"type":"paragraph","children":[{"type":"text","value":"When working with array fields, you can use the fields "},{"type":"inlineCode","value":"pushValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"removeValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"swapValues"},{"type":"text","value":" and "},{"type":"inlineCode","value":"moveValue"},{"type":"text","value":" methods to add, remove, swap, and move a value from one index to another within the array, respectively. Additional helper methods such as "},{"type":"inlineCode","value":"insertValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"replaceValue"},{"type":"text","value":", and "},{"type":"inlineCode","value":"clearValues"},{"type":"text","value":" are also available for inserting, replacing, and clearing array values."}]},{"type":"paragraph","children":[{"type":"text","value":"Example:"}]},{"type":"code","value":"<form.Field\n  name=\"hobbies\"\n  mode=\"array\"\n  children={(hobbiesField) => (\n    <div>\n      Hobbies\n      <div>\n        <Show\n          when={hobbiesField().state.value.length > 0}\n          fallback={'No hobbies found.'}\n        >\n          <Index each={hobbiesField().state.value}>\n            {(_, i) => (\n              <div>\n                <form.Field\n                  name={`hobbies[${i}].name`}\n                  children={(field) => (\n                    <div>\n                      <label for={field().name}>Name:</label>\n                      <input\n                        id={field().name}\n                        name={field().name}\n                        value={field().state.value}\n                        onBlur={field().handleBlur}\n                        onInput={(e) => field().handleChange(e.target.value)}\n                      />\n                      <button\n                        type=\"button\"\n                        onClick={() => hobbiesField().removeValue(i)}\n                      >\n                        X\n                      </button>\n                    </div>\n                  )}\n                />\n                <form.Field\n                  name={`hobbies[${i}].description`}\n                  children={(field) => {\n                    return (\n                      <div>\n                        <label for={field().name}>Description:</label>\n                        <input\n                          id={field().name}\n                          name={field().name}\n                          value={field().state.value}\n                          onBlur={field().handleBlur}\n                          onInput={(e) => field().handleChange(e.target.value)}\n                        />\n                      </div>\n                    )\n                  }}\n                />\n              </div>\n            )}\n          </Index>\n        </Show>\n      </div>\n      <button\n        type=\"button\"\n        onClick={() =>\n          hobbiesField().pushValue({\n            name: '',\n            description: '',\n            yearsOfExperience: 0,\n          })\n        }\n      >\n        Add hobby\n      </button>\n    </div>\n  )}\n/>","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"These are the basic concepts and terminology used in the "},{"type":"inlineCode","value":"@tanstack/solid-form"},{"type":"text","value":" library. Understanding these concepts will help you work more effectively with the library and create complex forms with ease."}]}],"headings":[{"id":"form-options","text":"Form Options","level":2},{"id":"form-instance","text":"Form Instance","level":2},{"id":"field","text":"Field","level":2},{"id":"field-state","text":"Field State","level":2},{"id":"understanding-isdirty-in-different-libraries","text":"Understanding 'isDirty' in Different Libraries","level":2},{"id":"field-api","text":"Field API","level":2},{"id":"validation","text":"Validation","level":2},{"id":"validation-with-standard-schema-libraries","text":"Validation with Standard Schema Libraries","level":2},{"id":"reactivity","text":"Reactivity","level":2},{"id":"array-fields","text":"Array Fields","level":2}]},"frameworks":[],"downloadMarkdown":"\nThis page introduces the basic concepts and terminology used in the `@tanstack/solid-form` library. Familiarizing yourself with these concepts will help you better understand and work with the library.\n\n## Form Options\n\nYou can create options for your form so that it can be shared between multiple forms by using the `formOptions` function.\n\nExample:\n\n```tsx\nconst formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    hobbies: [],\n  } as Person,\n})\n```\n\n## Form Instance\n\nA Form Instance is an object that represents an individual form and provides methods and properties for working with the form. You create a form instance using the `createForm` hook provided by the form options. The hook accepts an object with an `onSubmit` function, which is called when the form is submitted.\n\n```tsx\nconst form = createForm(() => ({\n  ...formOpts,\n  onSubmit: async ({ value }) => {\n    // Do something with form data\n    console.log(value)\n  },\n}))\n```\n\nYou may also create a form instance without using `formOptions` by using the standalone `createForm` API:\n\n```tsx\nconst form = createForm<Person>(() => ({\n  onSubmit: async ({ value }) => {\n    // Do something with form data\n    console.log(value)\n  },\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    hobbies: [],\n  },\n}))\n```\n\n## Field\n\nA Field represents a single form input element, such as a text input or a checkbox. Fields are created using the `form.Field` component provided by the form instance. The component accepts a name prop, which should match a key in the form's default values. It also accepts a children prop, which is a render prop function that takes a field object as its argument.\n\nExample:\n\n```tsx\n<form.Field\n  name=\"firstName\"\n  children={(field) => (\n    <input\n      name={field().name}\n      value={field().state.value}\n      onBlur={field().handleBlur}\n      onInput={(e) => field().handleChange(e.target.value)}\n    />\n  )}\n/>\n```\n\n## Field State\n\nEach field has its own state, which includes its current value, validation status, error messages, and other metadata. You can access a field's state using the `field().state` property.\n\nExample:\n\n```ts\nconst {\n  value,\n  meta: { errors, isValidating },\n} = field().state\n```\n\nThere are four states in the metadata that can be useful to see how the user interacts with a field:\n\n- _\"isTouched\"_, after the user changes the field or blurs the field\n- _\"isDirty\"_, after the field's value has been changed, even if it's been reverted to the default. Opposite of `isPristine`\n- _\"isPristine\"_, until the user changes the field value. Opposite of `isDirty`\n- _\"isBlurred\"_, after the field has been blurred\n\n```ts\nconst { isTouched, isDirty, isPristine, isBlurred } = field().state.meta\n```\n\n![Field states](https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states.png)\n\n## Understanding 'isDirty' in Different Libraries\n\nNon-Persistent `dirty` state\n\n- **Libraries**: React Hook Form (RHF), Formik, Final Form.\n- **Behavior**: A field is 'dirty' if its value differs from the default. Reverting to the default value makes it 'clean' again.\n\nPersistent `dirty` state\n\n- **Libraries**: Angular Form, Vue FormKit.\n- **Behavior**: A field remains 'dirty' once changed, even if reverted to the default value.\n\nWe have chosen the persistent 'dirty' state model. To also support a non-persistent 'dirty' state, we introduce an additional flag:\n\n- _\"isDefaultValue\"_, whether the field's current value is the default value\n\n```ts\nconst { isDefaultValue, isTouched } = field().state.meta\n\n// The following line will re-create the non-Persistent `dirty` functionality.\nconst nonPersistentIsDirty = !isDefaultValue\n```\n\n![Field states extended](https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states-extended.png)\n\n## Field API\n\nThe Field API is an object passed to the render prop function when creating a field. It provides methods for working with the field's state.\n\nExample:\n\n```tsx\n<input\n  name={field().name}\n  value={field().state.value}\n  onBlur={field().handleBlur}\n  onInput={(e) => field().handleChange(e.target.value)}\n/>\n```\n\n## Validation\n\n`@tanstack/solid-form` provides both synchronous and asynchronous validation out of the box. Validation functions can be passed to the `form.Field` component using the `validators` prop.\n\nExample:\n\n```tsx\n<form.Field\n  name=\"firstName\"\n  validators={{\n    onChange: ({ value }) =>\n      !value\n        ? 'A first name is required'\n        : value.length < 3\n          ? 'First name must be at least 3 characters'\n          : undefined,\n    onChangeAsync: async ({ value }) => {\n      await new Promise((resolve) => setTimeout(resolve, 1000))\n      return value.includes('error') && 'No \"error\" allowed in first name'\n    },\n  }}\n  children={(field) => (\n    <>\n      <input\n        name={field().name}\n        value={field().state.value}\n        onBlur={field().handleBlur}\n        onInput={(e) => field().handleChange(e.target.value)}\n      />\n      <p>{field().state.meta.errors[0]}</p>\n    </>\n  )}\n/>\n```\n\n## Validation with Standard Schema Libraries\n\nIn addition to hand-rolled validation options, we also support the [Standard Schema](https://github.com/standard-schema/standard-schema) specification.\n\nYou can define a schema using any of the libraries implementing the specification and pass it to a form or field validator.\n\nSupported libraries include:\n\n- [Zod](https://zod.dev/) (v3.24.0 or higher)\n- [Valibot](https://valibot.dev/) (v1.0.0 or higher)\n- [ArkType](https://arktype.io/) (v2.1.20 or higher)\n- [Yup](https://github.com/jquense/yup) (v1.7.0 or higher)\n\n```tsx\nimport { z } from 'zod'\n\n// ...\n;<form.Field\n  name=\"firstName\"\n  validators={{\n    onChange: z.string().min(3, 'First name must be at least 3 characters'),\n    onChangeAsyncDebounceMs: 500,\n    onChangeAsync: z.string().refine(\n      async (value) => {\n        await new Promise((resolve) => setTimeout(resolve, 1000))\n        return !value.includes('error')\n      },\n      {\n        message: 'No \"error\" allowed in first name',\n      },\n    ),\n  }}\n  children={(field) => (\n    <>\n      <input\n        name={field().name}\n        value={field().state.value}\n        onBlur={field().handleBlur}\n        onInput={(e) => field().handleChange(e.target.value)}\n      />\n      <p>{field().state.meta.errors[0]}</p>\n    </>\n  )}\n/>\n```\n\n## Reactivity\n\n`@tanstack/solid-form` offers various ways to subscribe to form and field state changes, most notably the `form.useSelector` hook and the `form.Subscribe` component. These methods allow you to optimize your form's rendering performance by only updating components when necessary.\n\nExample:\n\n```tsx\nconst firstName = form.useSelector((state) => state.values.firstName)\n//...\n<form.Subscribe\n  selector={(state) => ({\n    canSubmit: state.canSubmit,\n    isSubmitting: state.isSubmitting,\n  })}\n  children={(state) => (\n    <button type=\"submit\" disabled={!state().canSubmit}>\n      {state().isSubmitting ? '...' : 'Submit'}\n    </button>\n  )}\n/>\n```\n\n## Array Fields\n\nArray fields allow you to manage a list of values within a form, such as a list of hobbies. You can create an array field using the `form.Field` component with the `mode=\"array\"` prop.\n\nWhen working with array fields, you can use the fields `pushValue`, `removeValue`, `swapValues` and `moveValue` methods to add, remove, swap, and move a value from one index to another within the array, respectively. Additional helper methods such as `insertValue`, `replaceValue`, and `clearValues` are also available for inserting, replacing, and clearing array values.\n\nExample:\n\n```tsx\n<form.Field\n  name=\"hobbies\"\n  mode=\"array\"\n  children={(hobbiesField) => (\n    <div>\n      Hobbies\n      <div>\n        <Show\n          when={hobbiesField().state.value.length > 0}\n          fallback={'No hobbies found.'}\n        >\n          <Index each={hobbiesField().state.value}>\n            {(_, i) => (\n              <div>\n                <form.Field\n                  name={`hobbies[${i}].name`}\n                  children={(field) => (\n                    <div>\n                      <label for={field().name}>Name:</label>\n                      <input\n                        id={field().name}\n                        name={field().name}\n                        value={field().state.value}\n                        onBlur={field().handleBlur}\n                        onInput={(e) => field().handleChange(e.target.value)}\n                      />\n                      <button\n                        type=\"button\"\n                        onClick={() => hobbiesField().removeValue(i)}\n                      >\n                        X\n                      </button>\n                    </div>\n                  )}\n                />\n                <form.Field\n                  name={`hobbies[${i}].description`}\n                  children={(field) => {\n                    return (\n                      <div>\n                        <label for={field().name}>Description:</label>\n                        <input\n                          id={field().name}\n                          name={field().name}\n                          value={field().state.value}\n                          onBlur={field().handleBlur}\n                          onInput={(e) => field().handleChange(e.target.value)}\n                        />\n                      </div>\n                    )\n                  }}\n                />\n              </div>\n            )}\n          </Index>\n        </Show>\n      </div>\n      <button\n        type=\"button\"\n        onClick={() =>\n          hobbiesField().pushValue({\n            name: '',\n            description: '',\n            yearsOfExperience: 0,\n          })\n        }\n      >\n        Add hobby\n      </button>\n    </div>\n  )}\n/>\n```\n\nThese are the basic concepts and terminology used in the `@tanstack/solid-form` library. Understanding these concepts will help you work more effectively with the library and create complex forms with ease.\n","originalRawMarkdown":"---\nid: basic-concepts\ntitle: Basic Concepts and Terminology\n---\n\nThis page introduces the basic concepts and terminology used in the `@tanstack/solid-form` library. Familiarizing yourself with these concepts will help you better understand and work with the library.\n\n## Form Options\n\nYou can create options for your form so that it can be shared between multiple forms by using the `formOptions` function.\n\nExample:\n\n```tsx\nconst formOpts = formOptions({\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    hobbies: [],\n  } as Person,\n})\n```\n\n## Form Instance\n\nA Form Instance is an object that represents an individual form and provides methods and properties for working with the form. You create a form instance using the `createForm` hook provided by the form options. The hook accepts an object with an `onSubmit` function, which is called when the form is submitted.\n\n```tsx\nconst form = createForm(() => ({\n  ...formOpts,\n  onSubmit: async ({ value }) => {\n    // Do something with form data\n    console.log(value)\n  },\n}))\n```\n\nYou may also create a form instance without using `formOptions` by using the standalone `createForm` API:\n\n```tsx\nconst form = createForm<Person>(() => ({\n  onSubmit: async ({ value }) => {\n    // Do something with form data\n    console.log(value)\n  },\n  defaultValues: {\n    firstName: '',\n    lastName: '',\n    hobbies: [],\n  },\n}))\n```\n\n## Field\n\nA Field represents a single form input element, such as a text input or a checkbox. Fields are created using the `form.Field` component provided by the form instance. The component accepts a name prop, which should match a key in the form's default values. It also accepts a children prop, which is a render prop function that takes a field object as its argument.\n\nExample:\n\n```tsx\n<form.Field\n  name=\"firstName\"\n  children={(field) => (\n    <input\n      name={field().name}\n      value={field().state.value}\n      onBlur={field().handleBlur}\n      onInput={(e) => field().handleChange(e.target.value)}\n    />\n  )}\n/>\n```\n\n## Field State\n\nEach field has its own state, which includes its current value, validation status, error messages, and other metadata. You can access a field's state using the `field().state` property.\n\nExample:\n\n```ts\nconst {\n  value,\n  meta: { errors, isValidating },\n} = field().state\n```\n\nThere are four states in the metadata that can be useful to see how the user interacts with a field:\n\n- _\"isTouched\"_, after the user changes the field or blurs the field\n- _\"isDirty\"_, after the field's value has been changed, even if it's been reverted to the default. Opposite of `isPristine`\n- _\"isPristine\"_, until the user changes the field value. Opposite of `isDirty`\n- _\"isBlurred\"_, after the field has been blurred\n\n```ts\nconst { isTouched, isDirty, isPristine, isBlurred } = field().state.meta\n```\n\n![Field states](https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states.png)\n\n## Understanding 'isDirty' in Different Libraries\n\nNon-Persistent `dirty` state\n\n- **Libraries**: React Hook Form (RHF), Formik, Final Form.\n- **Behavior**: A field is 'dirty' if its value differs from the default. Reverting to the default value makes it 'clean' again.\n\nPersistent `dirty` state\n\n- **Libraries**: Angular Form, Vue FormKit.\n- **Behavior**: A field remains 'dirty' once changed, even if reverted to the default value.\n\nWe have chosen the persistent 'dirty' state model. To also support a non-persistent 'dirty' state, we introduce an additional flag:\n\n- _\"isDefaultValue\"_, whether the field's current value is the default value\n\n```ts\nconst { isDefaultValue, isTouched } = field().state.meta\n\n// The following line will re-create the non-Persistent `dirty` functionality.\nconst nonPersistentIsDirty = !isDefaultValue\n```\n\n![Field states extended](https://raw.githubusercontent.com/TanStack/form/main/docs/assets/field-states-extended.png)\n\n## Field API\n\nThe Field API is an object passed to the render prop function when creating a field. It provides methods for working with the field's state.\n\nExample:\n\n```tsx\n<input\n  name={field().name}\n  value={field().state.value}\n  onBlur={field().handleBlur}\n  onInput={(e) => field().handleChange(e.target.value)}\n/>\n```\n\n## Validation\n\n`@tanstack/solid-form` provides both synchronous and asynchronous validation out of the box. Validation functions can be passed to the `form.Field` component using the `validators` prop.\n\nExample:\n\n```tsx\n<form.Field\n  name=\"firstName\"\n  validators={{\n    onChange: ({ value }) =>\n      !value\n        ? 'A first name is required'\n        : value.length < 3\n          ? 'First name must be at least 3 characters'\n          : undefined,\n    onChangeAsync: async ({ value }) => {\n      await new Promise((resolve) => setTimeout(resolve, 1000))\n      return value.includes('error') && 'No \"error\" allowed in first name'\n    },\n  }}\n  children={(field) => (\n    <>\n      <input\n        name={field().name}\n        value={field().state.value}\n        onBlur={field().handleBlur}\n        onInput={(e) => field().handleChange(e.target.value)}\n      />\n      <p>{field().state.meta.errors[0]}</p>\n    </>\n  )}\n/>\n```\n\n## Validation with Standard Schema Libraries\n\nIn addition to hand-rolled validation options, we also support the [Standard Schema](https://github.com/standard-schema/standard-schema) specification.\n\nYou can define a schema using any of the libraries implementing the specification and pass it to a form or field validator.\n\nSupported libraries include:\n\n- [Zod](https://zod.dev/) (v3.24.0 or higher)\n- [Valibot](https://valibot.dev/) (v1.0.0 or higher)\n- [ArkType](https://arktype.io/) (v2.1.20 or higher)\n- [Yup](https://github.com/jquense/yup) (v1.7.0 or higher)\n\n```tsx\nimport { z } from 'zod'\n\n// ...\n;<form.Field\n  name=\"firstName\"\n  validators={{\n    onChange: z.string().min(3, 'First name must be at least 3 characters'),\n    onChangeAsyncDebounceMs: 500,\n    onChangeAsync: z.string().refine(\n      async (value) => {\n        await new Promise((resolve) => setTimeout(resolve, 1000))\n        return !value.includes('error')\n      },\n      {\n        message: 'No \"error\" allowed in first name',\n      },\n    ),\n  }}\n  children={(field) => (\n    <>\n      <input\n        name={field().name}\n        value={field().state.value}\n        onBlur={field().handleBlur}\n        onInput={(e) => field().handleChange(e.target.value)}\n      />\n      <p>{field().state.meta.errors[0]}</p>\n    </>\n  )}\n/>\n```\n\n## Reactivity\n\n`@tanstack/solid-form` offers various ways to subscribe to form and field state changes, most notably the `form.useSelector` hook and the `form.Subscribe` component. These methods allow you to optimize your form's rendering performance by only updating components when necessary.\n\nExample:\n\n```tsx\nconst firstName = form.useSelector((state) => state.values.firstName)\n//...\n<form.Subscribe\n  selector={(state) => ({\n    canSubmit: state.canSubmit,\n    isSubmitting: state.isSubmitting,\n  })}\n  children={(state) => (\n    <button type=\"submit\" disabled={!state().canSubmit}>\n      {state().isSubmitting ? '...' : 'Submit'}\n    </button>\n  )}\n/>\n```\n\n## Array Fields\n\nArray fields allow you to manage a list of values within a form, such as a list of hobbies. You can create an array field using the `form.Field` component with the `mode=\"array\"` prop.\n\nWhen working with array fields, you can use the fields `pushValue`, `removeValue`, `swapValues` and `moveValue` methods to add, remove, swap, and move a value from one index to another within the array, respectively. Additional helper methods such as `insertValue`, `replaceValue`, and `clearValues` are also available for inserting, replacing, and clearing array values.\n\nExample:\n\n```tsx\n<form.Field\n  name=\"hobbies\"\n  mode=\"array\"\n  children={(hobbiesField) => (\n    <div>\n      Hobbies\n      <div>\n        <Show\n          when={hobbiesField().state.value.length > 0}\n          fallback={'No hobbies found.'}\n        >\n          <Index each={hobbiesField().state.value}>\n            {(_, i) => (\n              <div>\n                <form.Field\n                  name={`hobbies[${i}].name`}\n                  children={(field) => (\n                    <div>\n                      <label for={field().name}>Name:</label>\n                      <input\n                        id={field().name}\n                        name={field().name}\n                        value={field().state.value}\n                        onBlur={field().handleBlur}\n                        onInput={(e) => field().handleChange(e.target.value)}\n                      />\n                      <button\n                        type=\"button\"\n                        onClick={() => hobbiesField().removeValue(i)}\n                      >\n                        X\n                      </button>\n                    </div>\n                  )}\n                />\n                <form.Field\n                  name={`hobbies[${i}].description`}\n                  children={(field) => {\n                    return (\n                      <div>\n                        <label for={field().name}>Description:</label>\n                        <input\n                          id={field().name}\n                          name={field().name}\n                          value={field().state.value}\n                          onBlur={field().handleBlur}\n                          onInput={(e) => field().handleChange(e.target.value)}\n                        />\n                      </div>\n                    )\n                  }}\n                />\n              </div>\n            )}\n          </Index>\n        </Show>\n      </div>\n      <button\n        type=\"button\"\n        onClick={() =>\n          hobbiesField().pushValue({\n            name: '',\n            description: '',\n            yearsOfExperience: 0,\n          })\n        }\n      >\n        Add hobby\n      </button>\n    </div>\n  )}\n/>\n```\n\nThese are the basic concepts and terminology used in the `@tanstack/solid-form` library. Understanding these concepts will help you work more effectively with the library and create complex forms with ease.\n"}
