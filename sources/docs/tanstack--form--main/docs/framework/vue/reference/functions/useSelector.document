type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"UseSelectorOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Readonly"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Ref"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">>"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"const count = useSelector(counterStore, (state) => state.count)\nconsole.log(count.value)","lang":"ts"},{"type":"code","value":"const value = useSelector(countAtom)","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tsource","text":"TSource","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"source","text":"source","level":3},{"id":"selector","text":"selector?","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useSelector<TSource, TSelected>(\n   source, \n   selector?, \noptions?): Readonly<Ref<TSelected>>;\n```\n\nDefined in: node\\_modules/.pnpm/@tanstack+vue-store@0.11.0\\_vue@3.5.34\\_typescript@5.9.3\\_/node\\_modules/@tanstack/vue-store/dist/useSelector.d.ts:33\n\nSelects a slice of state from an atom or store and subscribes the component\nto that selection.\n\nThis is the primary Vue read hook for TanStack Store. It returns a readonly\nref containing the selected value.\n\nOmit the selector to subscribe to the whole value.\n\n## Type Parameters\n\n### TSource\n\n`TSource`\n\n### TSelected\n\n`TSelected` = `NoInfer`\\<`TSource`\\>\n\n## Parameters\n\n### source\n\n`SelectionSource`\\<`TSource`\\>\n\n### selector?\n\n(`snapshot`) => `TSelected`\n\n### options?\n\n`UseSelectorOptions`\\<`TSelected`\\>\n\n## Returns\n\n`Readonly`\\<`Ref`\\<`TSelected`\\>\\>\n\n## Examples\n\n```ts\nconst count = useSelector(counterStore, (state) => state.count)\nconsole.log(count.value)\n```\n\n```ts\nconst value = useSelector(countAtom)\n```\n","originalRawMarkdown":"---\nid: useSelector\ntitle: useSelector\n---\n\n```ts\nfunction useSelector<TSource, TSelected>(\n   source, \n   selector?, \noptions?): Readonly<Ref<TSelected>>;\n```\n\nDefined in: node\\_modules/.pnpm/@tanstack+vue-store@0.11.0\\_vue@3.5.34\\_typescript@5.9.3\\_/node\\_modules/@tanstack/vue-store/dist/useSelector.d.ts:33\n\nSelects a slice of state from an atom or store and subscribes the component\nto that selection.\n\nThis is the primary Vue read hook for TanStack Store. It returns a readonly\nref containing the selected value.\n\nOmit the selector to subscribe to the whole value.\n\n## Type Parameters\n\n### TSource\n\n`TSource`\n\n### TSelected\n\n`TSelected` = `NoInfer`\\<`TSource`\\>\n\n## Parameters\n\n### source\n\n`SelectionSource`\\<`TSource`\\>\n\n### selector?\n\n(`snapshot`) => `TSelected`\n\n### options?\n\n`UseSelectorOptions`\\<`TSelected`\\>\n\n## Returns\n\n`Readonly`\\<`Ref`\\<`TSelected`\\>\\>\n\n## Examples\n\n```ts\nconst count = useSelector(counterStore, (state) => state.count)\nconsole.log(count.value)\n```\n\n```ts\nconst value = useSelector(countAtom)\n```\n"}
