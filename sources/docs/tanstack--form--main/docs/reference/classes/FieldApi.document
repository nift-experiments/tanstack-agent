8","text":"Parameters","level":4},{"id":"value-2","text":"value","level":5},{"id":"options-5","text":"options?","level":5},{"id":"returns-15","text":"Returns","level":4},{"id":"removevalue","text":"removeValue()","level":3},{"id":"parameters-9","text":"Parameters","level":4},{"id":"index-2","text":"index","level":5},{"id":"options-6","text":"options?","level":5},{"id":"returns-16","text":"Returns","level":4},{"id":"replacevalue","text":"replaceValue()","level":3},{"id":"parameters-10","text":"Parameters","level":4},{"id":"index-3","text":"index","level":5},{"id":"value-3","text":"value","level":5},{"id":"options-7","text":"options?","level":5},{"id":"returns-17","text":"Returns","level":4},{"id":"seterrormap","text":"setErrorMap()","level":3},{"id":"parameters-11","text":"Parameters","level":4},{"id":"errormap","text":"errorMap","level":5},{"id":"returns-18","text":"Returns","level":4},{"id":"setmeta","text":"setMeta()","level":3},{"id":"parameters-12","text":"Parameters","level":4},{"id":"updater-2","text":"updater","level":5},{"id":"returns-19","text":"Returns","level":4},{"id":"implementation-of-8","text":"Implementation of","level":4},{"id":"setvalue","text":"setValue()","level":3},{"id":"parameters-13","text":"Parameters","level":4},{"id":"updater-3","text":"updater","level":5},{"id":"options-8","text":"options?","level":5},{"id":"returns-20","text":"Returns","level":4},{"id":"implementation-of-9","text":"Implementation of","level":4},{"id":"swapvalues","text":"swapValues()","level":3},{"id":"parameters-14","text":"Parameters","level":4},{"id":"aindex-2","text":"aIndex","level":5},{"id":"bindex-2","text":"bIndex","level":5},{"id":"options-9","text":"options?","level":5},{"id":"returns-21","text":"Returns","level":4},{"id":"update","text":"update()","level":3},{"id":"parameters-15","text":"Parameters","level":4},{"id":"opts-2","text":"opts","level":5},{"id":"returns-22","text":"Returns","level":4},{"id":"validate","text":"validate()","level":3},{"id":"parameters