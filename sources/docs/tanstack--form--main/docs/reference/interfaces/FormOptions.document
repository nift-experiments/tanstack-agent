","children":[{"type":"text","value":"canSubmitWhenInvalid?"}]},{"type":"code","value":"optional canSubmitWhenInvalid: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L497","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:497"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If true, allows the form to be submitted in an invalid state i.e. canSubmit will remain true regardless of validation errors. Defaults to undefined."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"defaultstate","children":[{"type":"text","value":"defaultState?"}]},{"type":"code","value":"optional defaultState: Partial<FormState<TFormData, TOnMount, TOnChange, TOnChangeAsync, TOnBlur, TOnBlurAsync, TOnSubmit, TOnSubmitAsync, TOnDynamic, TOnDynamicAsync, TOnServer>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L471","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:471"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The default state for the form."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"defaultvalues","children":[{"type":"text","value":"defaultValues?"}]},{"type":"code","value":"optional defaultValues: TFormData;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L440","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:440"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Set initial values for your form."}]},{"type":"heading","depth":4,"id":"inherited-from","children":[{"type":"text","value":"Inherited from"}]},{"type":"paragraph","children":[{"type"