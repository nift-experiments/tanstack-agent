packages/form-core/src/FormApi.ts#L692","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:692"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A boolean indicating if the last submission was successful."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"issubmitted","children":[{"type":"text","value":"isSubmitted"}]},{"type":"code","value":"isSubmitted: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L680","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:680"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A boolean indicating if the "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":" function has completed successfully."}]},{"type":"paragraph","children":[{"type":"text","value":"Goes back to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" at each new submission attempt."}]},{"type":"paragraph","children":[{"type":"text","value":"Note: you can use isSubmitting to check if the form is currently submitting."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"issubmitting","children":[{"type":"text","value":"isSubmitting"}]},{"type":"code","value":"isSubmitting: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L672","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:672"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A boolean indicating if the form is currently in the process of being submitted after "},{"type":"inlineCode","value":"handleSubmit"},{"type":"text","value":" is called."}]},{"type":"paragraph","children":[{"type":"text","value":"Goes back to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" when submission completes for one of the following reasons:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the validation step returned errors."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":" function has completed."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Note: if you're running async operations in your "},{"type":"inlineCode","value":"onSubmit"},{"type":"text","value":" function make sure to await them to ensure "},{"type":"inlineCode","value":"isSubmitting"},{"type":"text","value":" is set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" only when the async operation completes."}]},{"type":"paragraph","children":[{"type":"text","value":"This is useful for displaying loading indicators or disabling form inputs during submission."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isvalidating","children":[{"type":"text","value":"isValidating"}]},{"type":"code","value":"isValidating: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L684","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:684"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A boolean indicating if the form or any of its fields are currently validating."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"submissionattempts","children":[{"type":"text","value":"submissionAttempts"}]},{"type":"code","value":"submissionAttempts: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L688","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:688"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A counter for tracking the number of submission attempts."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"validationmetamap","children":[{"type":"text","value":"validationMetaMap"}]},{"type":"code","value":"validationMetaMap: Record<ValidationErrorMapKeys, ValidationMeta | undefined>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L648","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:648"}]}]},{"type":"paragraph","children":[{"type":"text","value":"An internal mechanism used for keeping track of validation logic in a form."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"values","children":[{"type":"text","value":"values"}]},{"type":"code","value":"values: TFormData;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L629","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:629"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The current values of the form fields."}]}],"headings":[{"id":"extended-by","text":"Extended by","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"tonmount","text":"TOnMount","level":3},{"id":"tonchange","text":"TOnChange","level":3},{"id":"tonchangeasync","text":"TOnChangeAsync","level":3},{"id":"tonblur","text":"TOnBlur","level":3},{"id":"tonblurasync","text":"TOnBlurAsync","level":3},{"id":"tonsubmit","text":"TOnSubmit","level":3},{"id":"tonsubmitasync","text":"TOnSubmitAsync","level":3},{"id":"tondynamic","text":"TOnDynamic","level":3},{"id":"tondynamicasync","text":"TOnDynamicAsync","level":3},{"id":"tonserver","text":"TOnServer","level":3},{"id":"properties","text":"Properties","level":2},{"id":"force-re-eval","text":"_force_re_eval?","level":3},{"id":"errormap","text":"errorMap","level":3},{"id":"fieldmetabase","text":"fieldMetaBase","level":3},{"id":"formgroupstatebase","text":"formGroupStateBase","level":3},{"id":"issubmitsuccessful","text":"isSubmitSuccessful","level":3},{"id":"issubmitted","text":"isSubmitted","level":3},{"id":"issubmitting","text":"isSubmitting","level":3},{"id":"isvalidating","text":"isValidating","level":3},{"id":"submissionattempts","text":"submissionAttempts","level":3},{"id":"validationmetamap","text":"validationMetaMap","level":3},{"id":"values","text":"values","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype BaseFormState<TFormData, TOnMount, TOnChange, TOnChangeAsync, TOnBlur, TOnBlurAsync, TOnSubmit, TOnSubmitAsync, TOnDynamic, TOnDynamicAsync, TOnServer> = object;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:613](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L613)\n\nAn object representing the current state of the form.\n\n## Extended by\n\n- [`FormState`](../interfaces/FormState.md)\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\n### TOnMount\n\n`TOnMount` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnChange\n\n`TOnChange` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnChangeAsync\n\n`TOnChangeAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnBlur\n\n`TOnBlur` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnBlurAsync\n\n`TOnBlurAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnSubmit\n\n`TOnSubmit` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnSubmitAsync\n\n`TOnSubmitAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnDynamic\n\n`TOnDynamic` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnDynamicAsync\n\n`TOnDynamicAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnServer\n\n`TOnServer` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n## Properties\n\n### \\_force\\_re\\_eval?\n\n```ts\noptional _force_re_eval: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:696](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L696)\n\n@private, used to force a re-evaluation of the form state when options change\n\n***\n\n### errorMap\n\n```ts\nerrorMap: ValidationErrorMap<UnwrapFormValidateOrFn<TOnMount>, UnwrapFormValidateOrFn<TOnChange>, UnwrapFormAsyncValidateOrFn<TOnChangeAsync>, UnwrapFormValidateOrFn<TOnBlur>, UnwrapFormAsyncValidateOrFn<TOnBlurAsync>, UnwrapFormValidateOrFn<TOnSubmit>, UnwrapFormAsyncValidateOrFn<TOnSubmitAsync>, UnwrapFormValidateOrFn<TOnDynamic>, UnwrapFormAsyncValidateOrFn<TOnDynamicAsync>, UnwrapFormAsyncValidateOrFn<TOnServer>>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:633](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L633)\n\nThe error map for the form itself.\n\n***\n\n### fieldMetaBase\n\n```ts\nfieldMetaBase: Partial<Record<DeepKeys<TFormData>, AnyFieldLikeMetaBase>>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:652](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L652)\n\nA record of field metadata for each field in the form, not including the derived properties, like `errors` and such\n\n***\n\n### formGroupStateBase\n\n```ts\nformGroupStateBase: Partial<Record<string, FormGroupState>>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:659](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L659)\n\nA record of submission lifecycle state for each mounted `FormGroupApi`,\nkeyed by the group's fully-qualified field name. Stored on the form so\ngroup-level state can be read from `FormApi` without having to walk the\nmounted group instances.\n\n***\n\n### isSubmitSuccessful\n\n```ts\nisSubmitSuccessful: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:692](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L692)\n\nA boolean indicating if the last submission was successful.\n\n***\n\n### isSubmitted\n\n```ts\nisSubmitted: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:680](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L680)\n\nA boolean indicating if the `onSubmit` function has completed successfully.\n\nGoes back to `false` at each new submission attempt.\n\nNote: you can use isSubmitting to check if the form is currently submitting.\n\n***\n\n### isSubmitting\n\n```ts\nisSubmitting: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:672](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L672)\n\nA boolean indicating if the form is currently in the process of being submitted after `handleSubmit` is called.\n\nGoes back to `false` when submission completes for one of the following reasons:\n- the validation step returned errors.\n- the `onSubmit` function has completed.\n\nNote: if you're running async operations in your `onSubmit` function make sure to await them to ensure `isSubmitting` is set to `false` only when the async operation completes.\n\nThis is useful for displaying loading indicators or disabling form inputs during submission.\n\n***\n\n### isValidating\n\n```ts\nisValidating: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:684](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L684)\n\nA boolean indicating if the form or any of its fields are currently validating.\n\n***\n\n### submissionAttempts\n\n```ts\nsubmissionAttempts: number;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:688](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L688)\n\nA counter for tracking the number of submission attempts.\n\n***\n\n### validationMetaMap\n\n```ts\nvalidationMetaMap: Record<ValidationErrorMapKeys, ValidationMeta | undefined>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:648](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L648)\n\nAn internal mechanism used for keeping track of validation logic in a form.\n\n***\n\n### values\n\n```ts\nvalues: TFormData;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:629](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L629)\n\nThe current values of the form fields.\n","originalRawMarkdown":"---\nid: BaseFormState\ntitle: BaseFormState\n---\n\n```ts\ntype BaseFormState<TFormData, TOnMount, TOnChange, TOnChangeAsync, TOnBlur, TOnBlurAsync, TOnSubmit, TOnSubmitAsync, TOnDynamic, TOnDynamicAsync, TOnServer> = object;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:613](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L613)\n\nAn object representing the current state of the form.\n\n## Extended by\n\n- [`FormState`](../interfaces/FormState.md)\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\n### TOnMount\n\n`TOnMount` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnChange\n\n`TOnChange` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnChangeAsync\n\n`TOnChangeAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnBlur\n\n`TOnBlur` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnBlurAsync\n\n`TOnBlurAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnSubmit\n\n`TOnSubmit` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnSubmitAsync\n\n`TOnSubmitAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnDynamic\n\n`TOnDynamic` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnDynamicAsync\n\n`TOnDynamicAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnServer\n\n`TOnServer` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n## Properties\n\n### \\_force\\_re\\_eval?\n\n```ts\noptional _force_re_eval: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:696](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L696)\n\n@private, used to force a re-evaluation of the form state when options change\n\n***\n\n### errorMap\n\n```ts\nerrorMap: ValidationErrorMap<UnwrapFormValidateOrFn<TOnMount>, UnwrapFormValidateOrFn<TOnChange>, UnwrapFormAsyncValidateOrFn<TOnChangeAsync>, UnwrapFormValidateOrFn<TOnBlur>, UnwrapFormAsyncValidateOrFn<TOnBlurAsync>, UnwrapFormValidateOrFn<TOnSubmit>, UnwrapFormAsyncValidateOrFn<TOnSubmitAsync>, UnwrapFormValidateOrFn<TOnDynamic>, UnwrapFormAsyncValidateOrFn<TOnDynamicAsync>, UnwrapFormAsyncValidateOrFn<TOnServer>>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:633](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L633)\n\nThe error map for the form itself.\n\n***\n\n### fieldMetaBase\n\n```ts\nfieldMetaBase: Partial<Record<DeepKeys<TFormData>, AnyFieldLikeMetaBase>>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:652](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L652)\n\nA record of field metadata for each field in the form, not including the derived properties, like `errors` and such\n\n***\n\n### formGroupStateBase\n\n```ts\nformGroupStateBase: Partial<Record<string, FormGroupState>>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:659](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L659)\n\nA record of submission lifecycle state for each mounted `FormGroupApi`,\nkeyed by the group's fully-qualified field name. Stored on the form so\ngroup-level state can be read from `FormApi` without having to walk the\nmounted group instances.\n\n***\n\n### isSubmitSuccessful\n\n```ts\nisSubmitSuccessful: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:692](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L692)\n\nA boolean indicating if the last submission was successful.\n\n***\n\n### isSubmitted\n\n```ts\nisSubmitted: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:680](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L680)\n\nA boolean indicating if the `onSubmit` function has completed successfully.\n\nGoes back to `false` at each new submission attempt.\n\nNote: you can use isSubmitting to check if the form is currently submitting.\n\n***\n\n### isSubmitting\n\n```ts\nisSubmitting: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:672](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L672)\n\nA boolean indicating if the form is currently in the process of being submitted after `handleSubmit` is called.\n\nGoes back to `false` when submission completes for one of the following reasons:\n- the validation step returned errors.\n- the `onSubmit` function has completed.\n\nNote: if you're running async operations in your `onSubmit` function make sure to await them to ensure `isSubmitting` is set to `false` only when the async operation completes.\n\nThis is useful for displaying loading indicators or disabling form inputs during submission.\n\n***\n\n### isValidating\n\n```ts\nisValidating: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:684](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L684)\n\nA boolean indicating if the form or any of its fields are currently validating.\n\n***\n\n### submissionAttempts\n\n```ts\nsubmissionAttempts: number;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:688](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L688)\n\nA counter for tracking the number of submission attempts.\n\n***\n\n### validationMetaMap\n\n```ts\nvalidationMetaMap: Record<ValidationErrorMapKeys, ValidationMeta | undefined>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:648](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L648)\n\nAn internal mechanism used for keeping track of validation logic in a form.\n\n***\n\n### values\n\n```ts\nvalues: TFormData;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:629](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L629)\n\nThe current values of the form fields.\n"}
