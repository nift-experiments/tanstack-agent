text","value":"packages/form-core/src/FormApi.ts:762"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A boolean indicating if any of the form fields have been touched."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isvalid","children":[{"type":"text","value":"isValid"}]},{"type":"code","value":"isValid: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L782","children":[{"type":"text","value":"packages/form-core/src/FormApi.ts:782"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A boolean indicating if the form and all its fields are valid. Evaluates "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if there are no errors."}]}],"headings":[{"id":"extended-by","text":"Extended by","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tformdata","text":"TFormData","level":3},{"id":"tonmount","text":"TOnMount","level":3},{"id":"tonchange","text":"TOnChange","level":3},{"id":"tonchangeasync","text":"TOnChangeAsync","level":3},{"id":"tonblur","text":"TOnBlur","level":3},{"id":"tonblurasync","text":"TOnBlurAsync","level":3},{"id":"tonsubmit","text":"TOnSubmit","level":3},{"id":"tonsubmitasync","text":"TOnSubmitAsync","level":3},{"id":"tondynamic","text":"TOnDynamic","level":3},{"id":"tondynamicasync","text":"TOnDynamicAsync","level":3},{"id":"tonserver","text":"TOnServer","level":3},{"id":"properties","text":"Properties","level":2},{"id":"cansubmit","text":"canSubmit","level":3},{"id":"errors","text":"errors","level":3},{"id":"fieldmeta","text":"fieldMeta","level":3},{"id":"isblurred","text":"isBlurred","level":3},{"id":"isdefaultvalue","text":"isDefaultValue","level":3},{"id":"isdirty","text":"isDirty","level":3},{"id":"isfieldsvalid","text":"isFieldsValid","level":3},{"id":"isfieldsvalidating","text":"isFieldsValidating","level":3},{"id":"isformvalid","text":"isFormValid","level":3},{"id":"isformvalidating","text":"isFormValidating","level":3},{"id":"ispristine","text":"isPristine","level":3},{"id":"istouched","text":"isTouched","level":3},{"id":"isvalid","text":"isValid","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype DerivedFormState<TFormData, TOnMount, TOnChange, TOnChangeAsync, TOnBlur, TOnBlurAsync, TOnSubmit, TOnSubmitAsync, TOnDynamic, TOnDynamicAsync, TOnServer> = object;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:713](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L713)\n\n## Extended by\n\n- [`FormState`](../interfaces/FormState.md)\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\n### TOnMount\n\n`TOnMount` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnChange\n\n`TOnChange` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnChangeAsync\n\n`TOnChangeAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnBlur\n\n`TOnBlur` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnBlurAsync\n\n`TOnBlurAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnSubmit\n\n`TOnSubmit` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnSubmitAsync\n\n`TOnSubmitAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnDynamic\n\n`TOnDynamic` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnDynamicAsync\n\n`TOnDynamicAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnServer\n\n`TOnServer` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n## Properties\n\n### canSubmit\n\n```ts\ncanSubmit: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:786](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L786)\n\nA boolean indicating if the form can be submitted based on its current state.\n\n***\n\n### errors\n\n```ts\nerrors: NonNullable<\n  | UnwrapFormValidateOrFn<TOnMount>\n  | UnwrapFormValidateOrFn<TOnChange>\n  | UnwrapFormAsyncValidateOrFn<TOnChangeAsync>\n  | UnwrapFormValidateOrFn<TOnBlur>\n  | UnwrapFormAsyncValidateOrFn<TOnBlurAsync>\n  | UnwrapFormValidateOrFn<TOnSubmit>\n  | UnwrapFormAsyncValidateOrFn<TOnSubmitAsync>\n  | UnwrapFormValidateOrFn<TOnDynamic>\n  | UnwrapFormAsyncValidateOrFn<TOnDynamicAsync>\n  | UnwrapFormAsyncValidateOrFn<TOnServer>>[];\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:737](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L737)\n\nThe error array for the form itself.\n\n***\n\n### fieldMeta\n\n```ts\nfieldMeta: Partial<Record<DeepKeys<TFormData>, AnyFieldLikeMeta>>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:790](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L790)\n\nA record of field metadata for each field in the form.\n\n***\n\n### isBlurred\n\n```ts\nisBlurred: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:766](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L766)\n\nA boolean indicating if any of the form fields have been blurred.\n\n***\n\n### isDefaultValue\n\n```ts\nisDefaultValue: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:778](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L778)\n\nA boolean indicating if all of the form's fields are the same as default values.\n\n***\n\n### isDirty\n\n```ts\nisDirty: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:770](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L770)\n\nA boolean indicating if any of the form's fields' values have been modified by the user. Evaluates `true` if the user have modified at least one of the fields. Opposite of `isPristine`.\n\n***\n\n### isFieldsValid\n\n```ts\nisFieldsValid: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:758](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L758)\n\nA boolean indicating if all the form fields are valid. Evaluates `true` if there are no field errors.\n\n***\n\n### isFieldsValidating\n\n```ts\nisFieldsValidating: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:754](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L754)\n\nA boolean indicating if any of the form fields are currently validating.\n\n***\n\n### isFormValid\n\n```ts\nisFormValid: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:733](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L733)\n\nA boolean indicating if the form is valid.\n\n***\n\n### isFormValidating\n\n```ts\nisFormValidating: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:729](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L729)\n\nA boolean indicating if the form is currently validating.\n\n***\n\n### isPristine\n\n```ts\nisPristine: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:774](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L774)\n\nA boolean indicating if none of the form's fields' values have been modified by the user. Evaluates `true` if the user have not modified any of the fields. Opposite of `isDirty`.\n\n***\n\n### isTouched\n\n```ts\nisTouched: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:762](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L762)\n\nA boolean indicating if any of the form fields have been touched.\n\n***\n\n### isValid\n\n```ts\nisValid: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:782](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L782)\n\nA boolean indicating if the form and all its fields are valid. Evaluates `true` if there are no errors.\n","originalRawMarkdown":"---\nid: DerivedFormState\ntitle: DerivedFormState\n---\n\n```ts\ntype DerivedFormState<TFormData, TOnMount, TOnChange, TOnChangeAsync, TOnBlur, TOnBlurAsync, TOnSubmit, TOnSubmitAsync, TOnDynamic, TOnDynamicAsync, TOnServer> = object;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:713](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L713)\n\n## Extended by\n\n- [`FormState`](../interfaces/FormState.md)\n\n## Type Parameters\n\n### TFormData\n\n`TFormData`\n\n### TOnMount\n\n`TOnMount` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnChange\n\n`TOnChange` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnChangeAsync\n\n`TOnChangeAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnBlur\n\n`TOnBlur` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnBlurAsync\n\n`TOnBlurAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnSubmit\n\n`TOnSubmit` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnSubmitAsync\n\n`TOnSubmitAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnDynamic\n\n`TOnDynamic` *extends* `undefined` \\| `FormValidateOrFn`\\<`TFormData`\\>\n\n### TOnDynamicAsync\n\n`TOnDynamicAsync` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n### TOnServer\n\n`TOnServer` *extends* `undefined` \\| `FormAsyncValidateOrFn`\\<`TFormData`\\>\n\n## Properties\n\n### canSubmit\n\n```ts\ncanSubmit: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:786](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L786)\n\nA boolean indicating if the form can be submitted based on its current state.\n\n***\n\n### errors\n\n```ts\nerrors: NonNullable<\n  | UnwrapFormValidateOrFn<TOnMount>\n  | UnwrapFormValidateOrFn<TOnChange>\n  | UnwrapFormAsyncValidateOrFn<TOnChangeAsync>\n  | UnwrapFormValidateOrFn<TOnBlur>\n  | UnwrapFormAsyncValidateOrFn<TOnBlurAsync>\n  | UnwrapFormValidateOrFn<TOnSubmit>\n  | UnwrapFormAsyncValidateOrFn<TOnSubmitAsync>\n  | UnwrapFormValidateOrFn<TOnDynamic>\n  | UnwrapFormAsyncValidateOrFn<TOnDynamicAsync>\n  | UnwrapFormAsyncValidateOrFn<TOnServer>>[];\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:737](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L737)\n\nThe error array for the form itself.\n\n***\n\n### fieldMeta\n\n```ts\nfieldMeta: Partial<Record<DeepKeys<TFormData>, AnyFieldLikeMeta>>;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:790](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L790)\n\nA record of field metadata for each field in the form.\n\n***\n\n### isBlurred\n\n```ts\nisBlurred: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:766](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L766)\n\nA boolean indicating if any of the form fields have been blurred.\n\n***\n\n### isDefaultValue\n\n```ts\nisDefaultValue: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:778](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L778)\n\nA boolean indicating if all of the form's fields are the same as default values.\n\n***\n\n### isDirty\n\n```ts\nisDirty: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:770](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L770)\n\nA boolean indicating if any of the form's fields' values have been modified by the user. Evaluates `true` if the user have modified at least one of the fields. Opposite of `isPristine`.\n\n***\n\n### isFieldsValid\n\n```ts\nisFieldsValid: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:758](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L758)\n\nA boolean indicating if all the form fields are valid. Evaluates `true` if there are no field errors.\n\n***\n\n### isFieldsValidating\n\n```ts\nisFieldsValidating: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:754](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L754)\n\nA boolean indicating if any of the form fields are currently validating.\n\n***\n\n### isFormValid\n\n```ts\nisFormValid: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:733](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L733)\n\nA boolean indicating if the form is valid.\n\n***\n\n### isFormValidating\n\n```ts\nisFormValidating: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:729](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L729)\n\nA boolean indicating if the form is currently validating.\n\n***\n\n### isPristine\n\n```ts\nisPristine: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:774](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L774)\n\nA boolean indicating if none of the form's fields' values have been modified by the user. Evaluates `true` if the user have not modified any of the fields. Opposite of `isDirty`.\n\n***\n\n### isTouched\n\n```ts\nisTouched: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:762](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L762)\n\nA boolean indicating if any of the form fields have been touched.\n\n***\n\n### isValid\n\n```ts\nisValid: boolean;\n```\n\nDefined in: [packages/form-core/src/FormApi.ts:782](https://github.com/TanStack/form/blob/main/packages/form-core/src/FormApi.ts#L782)\n\nA boolean indicating if the form and all its fields are valid. Evaluates `true` if there are no errors.\n"}
