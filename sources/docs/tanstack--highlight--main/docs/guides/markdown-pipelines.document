nlineCode","value":"<code>"},{"type":"text","value":" child."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Reads the first "},{"type":"inlineCode","value":"language-*"},{"type":"text","value":" class from the code element."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Collects text from its descendants."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Replaces the node with highlighted HAST."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"It also reads fence titles, annotations, and line numbers from the code node's "},{"type":"inlineCode","value":"data.meta"},{"type":"text","value":", and preserves existing attributes, classes, and plugin data on both elements. An explicit "},{"type":"inlineCode","value":"lineNumbers"},{"type":"text","value":" option overrides the fence metadata, omit it to let each fence choose. A non-empty "},{"type":"inlineCode","value":"getTitle"},{"type":"text","value":" result overrides the metadata title."}]},{"type":"paragraph","children":[{"type":"text","value":"Already highlighted "},{"type":"inlineCode","value":"th-code"},{"type":"text","value":" blocks are skipped, making the transform idempotent."}]},{"type":"heading","depth":2,"id":"hast-helpers","children":[{"type":"text","value":"HAST helpers"}]},{"type":"code","value":"import {\n  codeFenceToHast,\n  parseCodeFenceMeta,\n  tokensToHast,\n} from '@tanstack/highlight/markdown'","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Use these when a custom parser already owns traversal but wants the same output contract."}]},{"type":"heading","depth":2,"id":"markdown-language-versus-markdown-adapter","children":[{"type":"text","value":"Markdown language versus Markdown adapter"}]},{"type":"paragraph","children":[{"type":"text","value":"They solve different problems:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"languages/markdown"},{"type":"text","value":" highlights Markdown source as a code sample and can delegate its internal fences."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"remark"},{"type":"text","value":" and "},{"type":"inlineCode","value":"rehype"},{"type":"text","value":" transform the code fences of a rendered Markdown document."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Most documentation sites need the adapter. Register the Markdown language only when they display Markdown source inside a code block."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"@octanejs/mdx"},{"type":"text","value":" users can wrap the Rehype adapter in its expected plugin tuple with "},{"type":"link","href":"octane#octane-mdx","children":[{"type":"inlineCode","value":"createOctaneMdxHighlight()"}]},{"type":"text","value":"."}]}],"headings":[{"id":"markdown-pipelines","text":"Markdown Pipelines","level":1},{"id":"tanstack-markdown","text":"TanStack Markdown","level":2},{"id":"direct-fence-rendering","text":"Direct fence rendering","level":2},{"id":"remark","text":"Remark","level":2},{"id":"rehype","text":"Rehype","level":2},{"id":"hast-helpers","text":"HAST helpers","level":2},{"id":"markdown-language-versus-markdown-adapter","text":"Markdown language versus Markdown adapter","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Markdown Pipelines\n\nTanStack Highlight provides helpers at three different Markdown boundaries. All accept an explicit highlighter so adapters do not import every language.\n\n## TanStack Markdown\n\nTanStack Markdown owns the surrounding `<pre><code>` elements. Use the dedicated adapter to return only Highlight's escaped inner token markup:\n\n```ts\nimport { createTanStackMarkdownHighlighter } from '@tanstack/highlight/markdown'\nimport { highlighter } from './highlight'\n\nexport const highlightMarkdownCode =\n  createTanStackMarkdownHighlighter(highlighter)\n```\n\nPass the same callback to the React or HTML renderer:\n\n```tsx\nimport { Markdown } from '@tanstack/markdown/react'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport function Article({ source }: { source: string }) {\n  return (\n    <Markdown highlighter={highlightMarkdownCode} codeLineNumbers>\n      {source}\n    </Markdown>\n  )\n}\n```\n\nThe adapter maps parsed highlighted lines to `th-line--highlighted`, preserves line-number wrappers, escapes source text, and degrades unknown languages to escaped plaintext. It does not import TanStack Markdown or any languages.\n\nGenerate theme CSS against Markdown's wrapper classes:\n\n```ts\nimport { createThemeCss } from '@tanstack/highlight/theme'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nexport const markdownHighlightCss = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: '.markdown-renderer',\n  darkSelector: '.dark .markdown-renderer',\n  codeBlockSelector: '.markdown-renderer pre.tm-code',\n  lineNumbersSelector: '.markdown-renderer .tm-code--line-numbers',\n})\n```\n\nWrap the rendered document in `.markdown-renderer`. Add application CSS for `.th-line--highlighted` if highlighted lines need a background.\n\n## Direct fence rendering\n\n```ts\nimport { renderCodeFence } from '@tanstack/highlight/markdown'\nimport { highlighter } from './highlight'\n\nconst rendered = renderCodeFence(\n  {\n    code: `const answer = 42\\n`,\n    lang: 'ts',\n    meta: 'title=\"answer.ts\" {1} lineNumbers',\n  },\n  highlighter,\n)\n```\n\nThe result includes:\n\n```ts\nrendered.copyText\nrendered.htmlMarkup\nrendered.lang\nrendered.title\nrendered.tokens\nrendered.decorations\nrendered.lineNumbers\n```\n\n`copyText` trims trailing whitespace from the block before highlighting.\n\n## Remark\n\nUse the Remark plugin before `remark-rehype`:\n\n```ts\nimport { remarkHighlightCodeBlocks } from '@tanstack/highlight/remark'\n\nconst highlightCode = remarkHighlightCodeBlocks({\n  highlighter,\n  lineNumbers: false,\n  getTitle(node) {\n    return node.data?.filename as string | undefined\n  },\n  getDecorations(node) {\n    return node.lang === 'diff'\n      ? [{ lines: 1, className: 'diff-context' }]\n      : undefined\n  },\n})\n```\n\nThe plugin replaces mdast `code` nodes with a `highlightedCode` extension node carrying `hName`, `hProperties`, and `hChildren`. `remark-rehype` therefore receives structured HAST without enabling raw HTML.\n\nFor pipelines that intentionally consume raw HTML, `remarkCodeNodeToHtml()` returns a raw mdast HTML node. Prefer the structured path by default.\n\n## Rehype\n\nUse the Rehype plugin when the tree already contains `<pre><code class=\"language-*\">`:\n\n```ts\nimport { rehypeHighlightCodeBlocks } from '@tanstack/highlight/rehype'\n\nconst highlightCode = rehypeHighlightCodeBlocks({\n  highlighter,\n  lineNumbers: true,\n})\n```\n\nThe plugin:\n\n1. Finds `<pre>` elements with a `<code>` child.\n2. Reads the first `language-*` class from the code element.\n3. Collects text from its descendants.\n4. Replaces the node with highlighted HAST.\n\nIt also reads fence titles, annotations, and line numbers from the code node's `data.meta`, and preserves existing attributes, classes, and plugin data on both elements. An explicit `lineNumbers` option overrides the fence metadata, omit it to let each fence choose. A non-empty `getTitle` result overrides the metadata title.\n\nAlready highlighted `th-code` blocks are skipped, making the transform idempotent.\n\n## HAST helpers\n\n```ts\nimport {\n  codeFenceToHast,\n  parseCodeFenceMeta,\n  tokensToHast,\n} from '@tanstack/highlight/markdown'\n```\n\nUse these when a custom parser already owns traversal but wants the same output contract.\n\n## Markdown language versus Markdown adapter\n\nThey solve different problems:\n\n- `languages/markdown` highlights Markdown source as a code sample and can delegate its internal fences.\n- `remark` and `rehype` transform the code fences of a rendered Markdown document.\n\nMost documentation sites need the adapter. Register the Markdown language only when they display Markdown source inside a code block.\n\n`@octanejs/mdx` users can wrap the Rehype adapter in its expected plugin tuple with [`createOctaneMdxHighlight()`](octane#octane-mdx).\n","originalRawMarkdown":"---\ntitle: Markdown Pipelines\n---\n\n# Markdown Pipelines\n\nTanStack Highlight provides helpers at three different Markdown boundaries. All accept an explicit highlighter so adapters do not import every language.\n\n## TanStack Markdown\n\nTanStack Markdown owns the surrounding `<pre><code>` elements. Use the dedicated adapter to return only Highlight's escaped inner token markup:\n\n```ts\nimport { createTanStackMarkdownHighlighter } from '@tanstack/highlight/markdown'\nimport { highlighter } from './highlight'\n\nexport const highlightMarkdownCode =\n  createTanStackMarkdownHighlighter(highlighter)\n```\n\nPass the same callback to the React or HTML renderer:\n\n```tsx\nimport { Markdown } from '@tanstack/markdown/react'\nimport { highlightMarkdownCode } from './markdown-highlighter'\n\nexport function Article({ source }: { source: string }) {\n  return (\n    <Markdown highlighter={highlightMarkdownCode} codeLineNumbers>\n      {source}\n    </Markdown>\n  )\n}\n```\n\nThe adapter maps parsed highlighted lines to `th-line--highlighted`, preserves line-number wrappers, escapes source text, and degrades unknown languages to escaped plaintext. It does not import TanStack Markdown or any languages.\n\nGenerate theme CSS against Markdown's wrapper classes:\n\n```ts\nimport { createThemeCss } from '@tanstack/highlight/theme'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nexport const markdownHighlightCss = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: '.markdown-renderer',\n  darkSelector: '.dark .markdown-renderer',\n  codeBlockSelector: '.markdown-renderer pre.tm-code',\n  lineNumbersSelector: '.markdown-renderer .tm-code--line-numbers',\n})\n```\n\nWrap the rendered document in `.markdown-renderer`. Add application CSS for `.th-line--highlighted` if highlighted lines need a background.\n\n## Direct fence rendering\n\n```ts\nimport { renderCodeFence } from '@tanstack/highlight/markdown'\nimport { highlighter } from './highlight'\n\nconst rendered = renderCodeFence(\n  {\n    code: `const answer = 42\\n`,\n    lang: 'ts',\n    meta: 'title=\"answer.ts\" {1} lineNumbers',\n  },\n  highlighter,\n)\n```\n\nThe result includes:\n\n```ts\nrendered.copyText\nrendered.htmlMarkup\nrendered.lang\nrendered.title\nrendered.tokens\nrendered.decorations\nrendered.lineNumbers\n```\n\n`copyText` trims trailing whitespace from the block before highlighting.\n\n## Remark\n\nUse the Remark plugin before `remark-rehype`:\n\n```ts\nimport { remarkHighlightCodeBlocks } from '@tanstack/highlight/remark'\n\nconst highlightCode = remarkHighlightCodeBlocks({\n  highlighter,\n  lineNumbers: false,\n  getTitle(node) {\n    return node.data?.filename as string | undefined\n  },\n  getDecorations(node) {\n    return node.lang === 'diff'\n      ? [{ lines: 1, className: 'diff-context' }]\n      : undefined\n  },\n})\n```\n\nThe plugin replaces mdast `code` nodes with a `highlightedCode` extension node carrying `hName`, `hProperties`, and `hChildren`. `remark-rehype` therefore receives structured HAST without enabling raw HTML.\n\nFor pipelines that intentionally consume raw HTML, `remarkCodeNodeToHtml()` returns a raw mdast HTML node. Prefer the structured path by default.\n\n## Rehype\n\nUse the Rehype plugin when the tree already contains `<pre><code class=\"language-*\">`:\n\n```ts\nimport { rehypeHighlightCodeBlocks } from '@tanstack/highlight/rehype'\n\nconst highlightCode = rehypeHighlightCodeBlocks({\n  highlighter,\n  lineNumbers: true,\n})\n```\n\nThe plugin:\n\n1. Finds `<pre>` elements with a `<code>` child.\n2. Reads the first `language-*` class from the code element.\n3. Collects text from its descendants.\n4. Replaces the node with highlighted HAST.\n\nIt also reads fence titles, annotations, and line numbers from the code node's `data.meta`, and preserves existing attributes, classes, and plugin data on both elements. An explicit `lineNumbers` option overrides the fence metadata, omit it to let each fence choose. A non-empty `getTitle` result overrides the metadata title.\n\nAlready highlighted `th-code` blocks are skipped, making the transform idempotent.\n\n## HAST helpers\n\n```ts\nimport {\n  codeFenceToHast,\n  parseCodeFenceMeta,\n  tokensToHast,\n} from '@tanstack/highlight/markdown'\n```\n\nUse these when a custom parser already owns traversal but wants the same output contract.\n\n## Markdown language versus Markdown adapter\n\nThey solve different problems:\n\n- `languages/markdown` highlights Markdown source as a code sample and can delegate its internal fences.\n- `remark` and `rehype` transform the code fences of a rendered Markdown document.\n\nMost documentation sites need the adapter. Register the Markdown language only when they display Markdown source inside a code block.\n\n`@octanejs/mdx` users can wrap the Rehype adapter in its expected plugin tuple with [`createOctaneMdxHighlight()`](octane#octane-mdx).\n"}
