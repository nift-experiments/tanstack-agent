{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"octane-integration","children":[{"type":"text","value":"Octane Integration"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/highlight/octane"},{"type":"text","value":" supports direct Octane components and "},{"type":"inlineCode","value":"@octanejs/mdx"},{"type":"text","value":". It has no Octane runtime dependency and does not register languages automatically."}]},{"type":"heading","depth":2,"id":"shared-highlighter","children":[{"type":"text","value":"Shared highlighter"}]},{"type":"paragraph","children":[{"type":"text","value":"Create the same selective highlighter used by the rest of the application:"}]},{"type":"code","value":"// src/highlight.ts\nimport { createHighlighter } from '@tanstack/highlight/core'\nimport { css } from '@tanstack/highlight/languages/css'\nimport { js } from '@tanstack/highlight/languages/js'\nimport { ts } from '@tanstack/highlight/languages/ts'\nimport { tsrx } from '@tanstack/highlight/languages/tsrx'\nimport { tsx } from '@tanstack/highlight/languages/tsx'\n\nexport const highlighter = createHighlighter({\n  languages: [css, js, ts, tsrx, tsx],\n})","lang":"ts"},{"type":"heading","depth":2,"id":"octane-mdx","children":[{"type":"text","value":"Octane MDX"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"createOctaneMdxHighlight()"},{"type":"text","value":" returns the synchronous rehype-plugin tuple expected by "},{"type":"inlineCode","value":"@octanejs/mdx"},{"type":"text","value":":"}]},{"type":"code","value":"// vite.config.ts\nimport { octaneMdx } from '@octanejs/mdx/vite'\nimport { createOctaneMdxHighlight } from '@tanstack/highlight/octane'\nimport { highlighter } from './src/highlight'\n\nexport default {\n  plugins: [\n    octaneMdx({\n      rehypePlugins: [\n        createOctaneMdxHighlight({ highlighter }),\n      ],\n    }),\n  ],\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The plugin replaces Markdown "},{"type":"inlineCode","value":"<pre><code class=\"language-*\">"},{"type":"text","value":" nodes with structured highlighted HAST. It emits no raw HTML and works in both "},{"type":"inlineCode","value":"compileMdx()"},{"type":"text","value":" and "},{"type":"inlineCode","value":"compileMdxSync()"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Add line numbers or application decorations through the same options as the Rehype adapter:"}]},{"type":"code","value":"const highlight = createOctaneMdxHighlight({\n  highlighter,\n  lineNumbers: true,\n  getTitle(node) {\n    return node.properties?.dataTitle as string | undefined\n  },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Because highlighting is synchronous and deterministic, separate Octane client and server compilations produce the same highlighted payload when they use the same package version, registry, and options. Theme changes remain CSS-only."}]},{"type":"heading","depth":2,"id":"direct-components","children":[{"type":"text","value":"Direct components"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"createHighlightedCodeBlockProps()"},{"type":"text","value":" prepares escaped markup and Octane's "},{"type":"inlineCode","value":"dangerouslySetInnerHTML"},{"type":"text","value":" object together:"}]},{"type":"code","value":"import {\n  createHighlightedCodeBlockProps,\n  type CreateHighlightedCodeBlockPropsOptions,\n} from '@tanstack/highlight/octane'\nimport { highlighter } from './highlight'\n\ntype CodeBlockProps = Omit<\n  CreateHighlightedCodeBlockPropsOptions,\n  'highlighter'\n>\n\nexport function CodeBlock(props: CodeBlockProps) @{\n  const block = createHighlightedCodeBlockProps({\n    ...props,\n    highlighter,\n  })\n\n  <figure class={block.className}>\n    @if (block.title) {\n      <figcaption>{block.title}</figcaption>\n    }\n    <div dangerouslySetInnerHTML={block.dangerouslySetInnerHTML} />\n  </figure>\n}","lang":"tsrx"},{"type":"paragraph","children":[{"type":"text","value":"The result also exposes "},{"type":"inlineCode","value":"copyText"},{"type":"text","value":", "},{"type":"inlineCode","value":"lang"},{"type":"text","value":", "},{"type":"inlineCode","value":"title"},{"type":"text","value":", and "},{"type":"inlineCode","value":"tokens"},{"type":"text","value":" for application-owned controls. Do not add arbitrary unescaped HTML to "},{"type":"inlineCode","value":"dangerouslySetInnerHTML.__html"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"bundle-behavior","children":[{"type":"text","value":"Bundle behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"The Octane entry imports renderer and Rehype helpers, but no language, theme, "},{"type":"inlineCode","value":"octane"},{"type":"text","value":", or "},{"type":"inlineCode","value":"@octanejs/mdx"},{"type":"text","value":" code. Direct language subpaths remain the bundle-size control."}]}],"headings":[{"id":"octane-integration","text":"Octane Integration","level":1},{"id":"shared-highlighter","text":"Shared highlighter","level":2},{"id":"octane-mdx","text":"Octane MDX","level":2},{"id":"direct-components","text":"Direct components","level":2},{"id":"bundle-behavior","text":"Bundle behavior","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Octane Integration\n\n`@tanstack/highlight/octane` supports direct Octane components and `@octanejs/mdx`. It has no Octane runtime dependency and does not register languages automatically.\n\n## Shared highlighter\n\nCreate the same selective highlighter used by the rest of the application:\n\n```ts\n// src/highlight.ts\nimport { createHighlighter } from '@tanstack/highlight/core'\nimport { css } from '@tanstack/highlight/languages/css'\nimport { js } from '@tanstack/highlight/languages/js'\nimport { ts } from '@tanstack/highlight/languages/ts'\nimport { tsrx } from '@tanstack/highlight/languages/tsrx'\nimport { tsx } from '@tanstack/highlight/languages/tsx'\n\nexport const highlighter = createHighlighter({\n  languages: [css, js, ts, tsrx, tsx],\n})\n```\n\n## Octane MDX\n\n`createOctaneMdxHighlight()` returns the synchronous rehype-plugin tuple expected by `@octanejs/mdx`:\n\n```ts\n// vite.config.ts\nimport { octaneMdx } from '@octanejs/mdx/vite'\nimport { createOctaneMdxHighlight } from '@tanstack/highlight/octane'\nimport { highlighter } from './src/highlight'\n\nexport default {\n  plugins: [\n    octaneMdx({\n      rehypePlugins: [\n        createOctaneMdxHighlight({ highlighter }),\n      ],\n    }),\n  ],\n}\n```\n\nThe plugin replaces Markdown `<pre><code class=\"language-*\">` nodes with structured highlighted HAST. It emits no raw HTML and works in both `compileMdx()` and `compileMdxSync()`.\n\nAdd line numbers or application decorations through the same options as the Rehype adapter:\n\n```ts\nconst highlight = createOctaneMdxHighlight({\n  highlighter,\n  lineNumbers: true,\n  getTitle(node) {\n    return node.properties?.dataTitle as string | undefined\n  },\n})\n```\n\nBecause highlighting is synchronous and deterministic, separate Octane client and server compilations produce the same highlighted payload when they use the same package version, registry, and options. Theme changes remain CSS-only.\n\n## Direct components\n\n`createHighlightedCodeBlockProps()` prepares escaped markup and Octane's `dangerouslySetInnerHTML` object together:\n\n```tsrx\nimport {\n  createHighlightedCodeBlockProps,\n  type CreateHighlightedCodeBlockPropsOptions,\n} from '@tanstack/highlight/octane'\nimport { highlighter } from './highlight'\n\ntype CodeBlockProps = Omit<\n  CreateHighlightedCodeBlockPropsOptions,\n  'highlighter'\n>\n\nexport function CodeBlock(props: CodeBlockProps) @{\n  const block = createHighlightedCodeBlockProps({\n    ...props,\n    highlighter,\n  })\n\n  <figure class={block.className}>\n    @if (block.title) {\n      <figcaption>{block.title}</figcaption>\n    }\n    <div dangerouslySetInnerHTML={block.dangerouslySetInnerHTML} />\n  </figure>\n}\n```\n\nThe result also exposes `copyText`, `lang`, `title`, and `tokens` for application-owned controls. Do not add arbitrary unescaped HTML to `dangerouslySetInnerHTML.__html`.\n\n## Bundle behavior\n\nThe Octane entry imports renderer and Rehype helpers, but no language, theme, `octane`, or `@octanejs/mdx` code. Direct language subpaths remain the bundle-size control.\n","originalRawMarkdown":"---\ntitle: Octane Integration\n---\n\n# Octane Integration\n\n`@tanstack/highlight/octane` supports direct Octane components and `@octanejs/mdx`. It has no Octane runtime dependency and does not register languages automatically.\n\n## Shared highlighter\n\nCreate the same selective highlighter used by the rest of the application:\n\n```ts\n// src/highlight.ts\nimport { createHighlighter } from '@tanstack/highlight/core'\nimport { css } from '@tanstack/highlight/languages/css'\nimport { js } from '@tanstack/highlight/languages/js'\nimport { ts } from '@tanstack/highlight/languages/ts'\nimport { tsrx } from '@tanstack/highlight/languages/tsrx'\nimport { tsx } from '@tanstack/highlight/languages/tsx'\n\nexport const highlighter = createHighlighter({\n  languages: [css, js, ts, tsrx, tsx],\n})\n```\n\n## Octane MDX\n\n`createOctaneMdxHighlight()` returns the synchronous rehype-plugin tuple expected by `@octanejs/mdx`:\n\n```ts\n// vite.config.ts\nimport { octaneMdx } from '@octanejs/mdx/vite'\nimport { createOctaneMdxHighlight } from '@tanstack/highlight/octane'\nimport { highlighter } from './src/highlight'\n\nexport default {\n  plugins: [\n    octaneMdx({\n      rehypePlugins: [\n        createOctaneMdxHighlight({ highlighter }),\n      ],\n    }),\n  ],\n}\n```\n\nThe plugin replaces Markdown `<pre><code class=\"language-*\">` nodes with structured highlighted HAST. It emits no raw HTML and works in both `compileMdx()` and `compileMdxSync()`.\n\nAdd line numbers or application decorations through the same options as the Rehype adapter:\n\n```ts\nconst highlight = createOctaneMdxHighlight({\n  highlighter,\n  lineNumbers: true,\n  getTitle(node) {\n    return node.properties?.dataTitle as string | undefined\n  },\n})\n```\n\nBecause highlighting is synchronous and deterministic, separate Octane client and server compilations produce the same highlighted payload when they use the same package version, registry, and options. Theme changes remain CSS-only.\n\n## Direct components\n\n`createHighlightedCodeBlockProps()` prepares escaped markup and Octane's `dangerouslySetInnerHTML` object together:\n\n```tsrx\nimport {\n  createHighlightedCodeBlockProps,\n  type CreateHighlightedCodeBlockPropsOptions,\n} from '@tanstack/highlight/octane'\nimport { highlighter } from './highlight'\n\ntype CodeBlockProps = Omit<\n  CreateHighlightedCodeBlockPropsOptions,\n  'highlighter'\n>\n\nexport function CodeBlock(props: CodeBlockProps) @{\n  const block = createHighlightedCodeBlockProps({\n    ...props,\n    highlighter,\n  })\n\n  <figure class={block.className}>\n    @if (block.title) {\n      <figcaption>{block.title}</figcaption>\n    }\n    <div dangerouslySetInnerHTML={block.dangerouslySetInnerHTML} />\n  </figure>\n}\n```\n\nThe result also exposes `copyText`, `lang`, `title`, and `tokens` for application-owned controls. Do not add arbitrary unescaped HTML to `dangerouslySetInnerHTML.__html`.\n\n## Bundle behavior\n\nThe Octane entry imports renderer and Rehype helpers, but no language, theme, `octane`, or `@octanejs/mdx` code. Direct language subpaths remain the bundle-size control.\n"}
