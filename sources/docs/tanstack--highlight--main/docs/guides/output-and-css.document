Tokens()"},{"type":"text","value":" to convert tokens and decorations into render nodes:"}]},{"type":"code","value":"import { renderTokens } from '@tanstack/highlight/core'\n\nconst nodes = renderTokens(tokens, {\n  lineNumbers: true,\n  decorations,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"renderNodesToHtml(nodes)"},{"type":"text","value":" converts those nodes to escaped inline markup. "},{"type":"inlineCode","value":"tokensToHast()"},{"type":"text","value":" from the Markdown entry converts tokens to a complete HAST "},{"type":"inlineCode","value":"<pre><code>"},{"type":"text","value":" tree."}]},{"type":"paragraph","children":[{"type":"text","value":"For TanStack Markdown, use "},{"type":"inlineCode","value":"createTanStackMarkdownHighlighter()"},{"type":"text","value":" from the Markdown entry. It packages this inner-markup pipeline without emitting a second "},{"type":"inlineCode","value":"<pre><code>"},{"type":"text","value":" wrapper."}]},{"type":"heading","depth":2,"id":"escaping-and-trust","children":[{"type":"text","value":"Escaping and trust"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Code text is HTML-escaped."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Language names and decoration values are attribute-escaped."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Decoration data keys are normalized before becoming "},{"type":"inlineCode","value":"data-*"},{"type":"text","value":" names."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Plaintext output contains no token spans."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"This protects the generated code block. It does not sanitize unrelated raw HTML in a Markdown document."}]},{"type":"heading","depth":2,"id":"custom-css","children":[{"type":"text","value":"Custom CSS"}]},{"type":"paragraph","children":[{"type":"text","value":"You can skip "},{"type":"inlineCode","value":"createThemeCss()"},{"type":"text","value":" and target classes directly:"}]},{"type":"code","value":".th-code {\n  overflow-x: auto;\n  background: #fff;\n  color: #24292f;\n}\n\n.th-keyword { color: #cf222e; font-weight: 600; }\n.th-string { color: #0a3069; }\n.th-comment { color: #6e7781; font-style: italic; }","lang":"css"},{"type":"paragraph","children":[{"type":"text","value":"Theme objects cover colors only. Font style, contrast policy, spacing, line highlighting, and copy controls remain application CSS and UI concerns."}]}],"headings":[{"id":"output-and-css","text":"Output and CSS","level":1},{"id":"highlight-result","text":"Highlight result","level":2},{"id":"html-contract","text":"HTML contract","level":2},{"id":"semantic-token-classes","text":"Semantic token classes","level":2},{"id":"rendering-without-html","text":"Rendering without HTML","level":2},{"id":"escaping-and-trust","text":"Escaping and trust","level":2},{"id":"custom-css","text":"Custom CSS","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Output and CSS\n\nTanStack Highlight separates tokenization from presentation. Languages emit semantic classes; CSS decides colors and font styles.\n\n## Highlight result\n\n```ts\nconst result = highlighter.highlight(code, { lang: 'tsx' })\n```\n\n```ts\ntype HighlightResult = {\n  code: string\n  lang: string\n  tokens: Array<HighlightToken>\n  html: string\n}\n```\n\n`code` is the original input. Concatenating every `token.value` reconstructs it exactly.\n\n## HTML contract\n\nWithout line wrappers:\n\n```html\n<pre class=\"th-code th-code--tsx\" data-language=\"tsx\">\n  <code>\n    <span class=\"th-token th-keyword\">const</span>\n    ...\n  </code>\n</pre>\n```\n\nWith line numbers or line decorations:\n\n```html\n<pre class=\"th-code th-code--tsx th-code--line-numbers\" data-language=\"tsx\">\n  <code>\n    <span class=\"th-line\" data-line=\"1\">...</span>\n  </code>\n</pre>\n```\n\nLine wrappers are omitted unless they are needed, reducing the normal output size.\n\n## Semantic token classes\n\n| Class | Typical use |\n| --- | --- |\n| `th-attr` | Markup attributes |\n| `th-code-inline` | Inline Markdown or unparsed fenced code |\n| `th-command` | Shell and Docker commands |\n| `th-comment` | Comments |\n| `th-deleted` | Deleted diff lines |\n| `th-function` | Function declarations and calls |\n| `th-heading` | Markdown headings and TOML tables |\n| `th-inserted` | Inserted diff lines |\n| `th-keyword` | Language keywords and directives |\n| `th-link` | Markdown links |\n| `th-literal` | Booleans, nulls, regex literals |\n| `th-meta` | Diff/fence/protocol metadata |\n| `th-number` | Numeric values |\n| `th-operator` | Template boundaries and diagram arrows |\n| `th-property` | Object properties, headers, config keys |\n| `th-selector` | CSS selectors |\n| `th-string` | Strings and protected scalar bodies |\n| `th-tag` | Markup tags |\n| `th-type` | Type names and annotations |\n| `th-variable` | Shell, CSS, and config variables |\n\nEvery token span also receives `th-token`.\n\n## Rendering without HTML\n\nUse `tokenize()` for another renderer:\n\n```ts\nconst { tokens } = highlighter.tokenize(code, { lang: 'ts' })\n```\n\nUse `renderTokens()` to convert tokens and decorations into render nodes:\n\n```ts\nimport { renderTokens } from '@tanstack/highlight/core'\n\nconst nodes = renderTokens(tokens, {\n  lineNumbers: true,\n  decorations,\n})\n```\n\n`renderNodesToHtml(nodes)` converts those nodes to escaped inline markup. `tokensToHast()` from the Markdown entry converts tokens to a complete HAST `<pre><code>` tree.\n\nFor TanStack Markdown, use `createTanStackMarkdownHighlighter()` from the Markdown entry. It packages this inner-markup pipeline without emitting a second `<pre><code>` wrapper.\n\n## Escaping and trust\n\n- Code text is HTML-escaped.\n- Language names and decoration values are attribute-escaped.\n- Decoration data keys are normalized before becoming `data-*` names.\n- Plaintext output contains no token spans.\n\nThis protects the generated code block. It does not sanitize unrelated raw HTML in a Markdown document.\n\n## Custom CSS\n\nYou can skip `createThemeCss()` and target classes directly:\n\n```css\n.th-code {\n  overflow-x: auto;\n  background: #fff;\n  color: #24292f;\n}\n\n.th-keyword { color: #cf222e; font-weight: 600; }\n.th-string { color: #0a3069; }\n.th-comment { color: #6e7781; font-style: italic; }\n```\n\nTheme objects cover colors only. Font style, contrast policy, spacing, line highlighting, and copy controls remain application CSS and UI concerns.\n","originalRawMarkdown":"---\ntitle: Output and CSS\n---\n\n# Output and CSS\n\nTanStack Highlight separates tokenization from presentation. Languages emit semantic classes; CSS decides colors and font styles.\n\n## Highlight result\n\n```ts\nconst result = highlighter.highlight(code, { lang: 'tsx' })\n```\n\n```ts\ntype HighlightResult = {\n  code: string\n  lang: string\n  tokens: Array<HighlightToken>\n  html: string\n}\n```\n\n`code` is the original input. Concatenating every `token.value` reconstructs it exactly.\n\n## HTML contract\n\nWithout line wrappers:\n\n```html\n<pre class=\"th-code th-code--tsx\" data-language=\"tsx\">\n  <code>\n    <span class=\"th-token th-keyword\">const</span>\n    ...\n  </code>\n</pre>\n```\n\nWith line numbers or line decorations:\n\n```html\n<pre class=\"th-code th-code--tsx th-code--line-numbers\" data-language=\"tsx\">\n  <code>\n    <span class=\"th-line\" data-line=\"1\">...</span>\n  </code>\n</pre>\n```\n\nLine wrappers are omitted unless they are needed, reducing the normal output size.\n\n## Semantic token classes\n\n| Class | Typical use |\n| --- | --- |\n| `th-attr` | Markup attributes |\n| `th-code-inline` | Inline Markdown or unparsed fenced code |\n| `th-command` | Shell and Docker commands |\n| `th-comment` | Comments |\n| `th-deleted` | Deleted diff lines |\n| `th-function` | Function declarations and calls |\n| `th-heading` | Markdown headings and TOML tables |\n| `th-inserted` | Inserted diff lines |\n| `th-keyword` | Language keywords and directives |\n| `th-link` | Markdown links |\n| `th-literal` | Booleans, nulls, regex literals |\n| `th-meta` | Diff/fence/protocol metadata |\n| `th-number` | Numeric values |\n| `th-operator` | Template boundaries and diagram arrows |\n| `th-property` | Object properties, headers, config keys |\n| `th-selector` | CSS selectors |\n| `th-string` | Strings and protected scalar bodies |\n| `th-tag` | Markup tags |\n| `th-type` | Type names and annotations |\n| `th-variable` | Shell, CSS, and config variables |\n\nEvery token span also receives `th-token`.\n\n## Rendering without HTML\n\nUse `tokenize()` for another renderer:\n\n```ts\nconst { tokens } = highlighter.tokenize(code, { lang: 'ts' })\n```\n\nUse `renderTokens()` to convert tokens and decorations into render nodes:\n\n```ts\nimport { renderTokens } from '@tanstack/highlight/core'\n\nconst nodes = renderTokens(tokens, {\n  lineNumbers: true,\n  decorations,\n})\n```\n\n`renderNodesToHtml(nodes)` converts those nodes to escaped inline markup. `tokensToHast()` from the Markdown entry converts tokens to a complete HAST `<pre><code>` tree.\n\nFor TanStack Markdown, use `createTanStackMarkdownHighlighter()` from the Markdown entry. It packages this inner-markup pipeline without emitting a second `<pre><code>` wrapper.\n\n## Escaping and trust\n\n- Code text is HTML-escaped.\n- Language names and decoration values are attribute-escaped.\n- Decoration data keys are normalized before becoming `data-*` names.\n- Plaintext output contains no token spans.\n\nThis protects the generated code block. It does not sanitize unrelated raw HTML in a Markdown document.\n\n## Custom CSS\n\nYou can skip `createThemeCss()` and target classes directly:\n\n```css\n.th-code {\n  overflow-x: auto;\n  background: #fff;\n  color: #24292f;\n}\n\n.th-keyword { color: #cf222e; font-weight: 600; }\n.th-string { color: #0a3069; }\n.th-comment { color: #6e7781; font-style: italic; }\n```\n\nTheme objects cover colors only. Font style, contrast policy, spacing, line highlighting, and copy controls remain application CSS and UI concerns.\n"}
