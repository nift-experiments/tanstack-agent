ll","children":[{"type":"text","value":"Typical use"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-attr"}]},{"type":"tableCell","children":[{"type":"text","value":"Markup attributes"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-code-inline"}]},{"type":"tableCell","children":[{"type":"text","value":"Inline Markdown or unparsed fenced code"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-command"}]},{"type":"tableCell","children":[{"type":"text","value":"Shell and Docker commands"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-comment"}]},{"type":"tableCell","children":[{"type":"text","value":"Comments"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-deleted"}]},{"type":"tableCell","children":[{"type":"text","value":"Deleted diff lines"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-function"}]},{"type":"tableCell","children":[{"type":"text","value":"Function declarations and calls"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-heading"}]},{"type":"tableCell","children":[{"type":"text","value":"Markdown headings and TOML tables"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-inserted"}]},{"type":"tableCell","children":[{"type":"text","value":"Inserted diff lines"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-keyword"}]},{"type":"tableCell","children":[{"type":"text","value":"Language keywords and directives"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-link"}]},{"type":"tableCell","children":[{"type":"text","value":"Markdown links"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-literal"}]},{"type":"tableCell","children":[{"type":"text","value":"Booleans, nulls, regex literals"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"th-meta"}]},{"type":"tableCell","children":[{"type":"text","value