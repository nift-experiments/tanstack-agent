{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"themes","children":[{"type":"text","value":"Themes"}]},{"type":"paragraph","children":[{"type":"text","value":"Themes are isolated color objects converted into CSS variables. They never change tokenization or duplicate highlighted markup."}]},{"type":"heading","depth":2,"id":"light-and-dark","children":[{"type":"text","value":"Light and dark"}]},{"type":"code","value":"import { createThemeCss } from '@tanstack/highlight/theme'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nconst css = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: ':root',\n  darkSelector: '.dark',\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The default selectors are "},{"type":"inlineCode","value":":root"},{"type":"text","value":" for light and "},{"type":"inlineCode","value":".dark"},{"type":"text","value":" for dark."}]},{"type":"heading","depth":2,"id":"one-theme","children":[{"type":"text","value":"One theme"}]},{"type":"code","value":"import { draculaTheme } from '@tanstack/highlight/themes/dracula'\n\nconst css = createThemeCss({\n  dark: draculaTheme,\n  darkSelector: ':root',\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"At least one of "},{"type":"inlineCode","value":"light"},{"type":"text","value":" or "},{"type":"inlineCode","value":"dark"},{"type":"text","value":" is required in pair mode."}]},{"type":"heading","depth":2,"id":"multiple-named-themes","children":[{"type":"text","value":"Multiple named themes"}]},{"type":"code","value":"const css = createThemeCss({\n  themes: [\n    { selector: '[data-code-theme=\"github\"]', theme: githubLightTheme },\n    { selector: '[data-code-theme=\"dracula\"]', theme: draculaTheme },\n  ],\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"themes"},{"type":"text","value":" mode is mutually exclusive with "},{"type":"inlineCode","value":"light"},{"type":"text","value":" and "},{"type":"inlineCode","value":"dark"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"try-the-shipped-themes","children":[{"type":"text","value":"Try the shipped themes"}]},{"type":"paragraph","children":[{"type":"text","value":"The highlighted markup stays the same while the selected theme changes only its CSS variables."}]},{"type":"component","name":"live-example","tagName":"md-live-example","attributes":{"id":"highlight-themes-1"},"properties":{"data-example-group":"highlight-themes","data-collapsed-indexes":"[]","data-workspace":"{\"version\":1,\"entry\":\"/src/main.ts\",\"environment\":\"client\",\"files\":{\"/src/main.ts\":\"import { createHighlighter } from '@tanstack/highlight/core'\\nimport { ts } from '@tanstack/highlight/languages/ts'\\nimport { createThemeCss } from '@tanstack/highlight/theme'\\nimport { draculaTheme } from '@tanstack/highlight/themes/dracula'\\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\\n\\nconst highlighter = createHighlighter({ languages: [ts] })\\nconst result = highlighter.highlight(\\n  [\\n    'type Theme = \\\"light\\\" | \\\"dark\\\"',\\n    '',\\n    'export function selectTheme(theme: Theme) {',\\n    '  document.documentElement.dataset.theme = theme',\\n    '}',\\n  ].join('\\\\n'),\\n  { lang: 'ts' },\\n)\\n\\nconst themeCss = createThemeCss({\\n  themes: [\\n    { selector: '[data-code-theme=\\\"github-light\\\"]', theme: githubLightTheme },\\n    { selector: '[data-code-theme=\\\"github-dark\\\"]', theme: githubDarkTheme },\\n    { selector: '[data-code-theme=\\\"dracula\\\"]', theme: draculaTheme },\\n  ],\\n})\\n\\nexport default function render(output: HTMLElement) {\\n  const style = document.createElement('style')\\n  style.textContent = `${themeCss}\\nbody { margin: 0; padding: 24px; font-family: ui-sans-serif, system-ui; }\\n.demo { overflow: hidden; border: 1px solid color-mix(in srgb, currentColor 16%, transparent); border-radius: 12px; background: var(--th-background); color: var(--th-token); }\\n.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent); }\\n.toolbar label { font-size: 13px; font-weight: 600; }\\n.toolbar select { padding: 6px 28px 6px 8px; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); border-radius: 7px; background: var(--th-background); color: var(--th-token); }\\npre.th-code { margin: 0; }\\ncode { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 14px; line-height: 1.6; }`\\n\\n  document.head.append(style)\\n  output.innerHTML = `<section class=\\\"demo\\\" data-code-theme=\\\"github-light\\\">\\n  <div class=\\\"toolbar\\\">\\n    <label for=\\\"theme\\\">Code theme</label>\\n    <select id=\\\"theme\\\">\\n      <option value=\\\"github-light\\\">GitHub Light</option>\\n      <option value=\\\"github-dark\\\">GitHub Dark</option>\\n      <option value=\\\"dracula\\\">Dracula</option>\\n    </select>\\n  </div>\\n  ${result.html}\\n</section>`\\n\\n  const demo = output.querySelector('.demo')\\n  const select = output.querySelector('#theme')\\n\\n  if (demo instanceof HTMLElement && select instanceof HTMLSelectElement) {\\n    select.addEventListener('change', () => {\\n      demo.dataset.codeTheme = select.value\\n    })\\n  }\\n}\"}}"},"children":[{"type":"code","value":"import { createHighlighter } from '@tanstack/highlight/core'\nimport { ts } from '@tanstack/highlight/languages/ts'\nimport { createThemeCss } from '@tanstack/highlight/theme'\nimport { draculaTheme } from '@tanstack/highlight/themes/dracula'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nconst highlighter = createHighlighter({ languages: [ts] })\nconst result = highlighter.highlight(\n  [\n    'type Theme = \"light\" | \"dark\"',\n    '',\n    'export function selectTheme(theme: Theme) {',\n    '  document.documentElement.dataset.theme = theme',\n    '}',\n  ].join('\\n'),\n  { lang: 'ts' },\n)\n\nconst themeCss = createThemeCss({\n  themes: [\n    { selector: '[data-code-theme=\"github-light\"]', theme: githubLightTheme },\n    { selector: '[data-code-theme=\"github-dark\"]', theme: githubDarkTheme },\n    { selector: '[data-code-theme=\"dracula\"]', theme: draculaTheme },\n  ],\n})\n\nexport default function render(output: HTMLElement) {\n  const style = document.createElement('style')\n  style.textContent = `${themeCss}\nbody { margin: 0; padding: 24px; font-family: ui-sans-serif, system-ui; }\n.demo { overflow: hidden; border: 1px solid color-mix(in srgb, currentColor 16%, transparent); border-radius: 12px; background: var(--th-background); color: var(--th-token); }\n.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent); }\n.toolbar label { font-size: 13px; font-weight: 600; }\n.toolbar select { padding: 6px 28px 6px 8px; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); border-radius: 7px; background: var(--th-background); color: var(--th-token); }\npre.th-code { margin: 0; }\ncode { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 14px; line-height: 1.6; }`\n\n  document.head.append(style)\n  output.innerHTML = `<section class=\"demo\" data-code-theme=\"github-light\">\n  <div class=\"toolbar\">\n    <label for=\"theme\">Code theme</label>\n    <select id=\"theme\">\n      <option value=\"github-light\">GitHub Light</option>\n      <option value=\"github-dark\">GitHub Dark</option>\n      <option value=\"dracula\">Dracula</option>\n    </select>\n  </div>\n  ${result.html}\n</section>`\n\n  const demo = output.querySelector('.demo')\n  const select = output.querySelector('#theme')\n\n  if (demo instanceof HTMLElement && select instanceof HTMLSelectElement) {\n    select.addEventListener('change', () => {\n      demo.dataset.codeTheme = select.value\n    })\n  }\n}","lang":"ts","meta":"group=highlight-themes file=/src/main.ts entry env=client","title":"/src/main.ts","file":"/src/main.ts"}]},{"type":"heading","depth":2,"id":"variables-only","children":[{"type":"text","value":"Variables only"}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"includeBaseStyles: false"},{"type":"text","value":" when the application already owns the token selectors:"}]},{"type":"code","value":"const variables = createThemeCss({\n  light: githubLightTheme,\n  includeBaseStyles: false,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"You can also call "},{"type":"inlineCode","value":"createThemeRule(selector, theme)"},{"type":"text","value":" and "},{"type":"inlineCode","value":"createThemeBaseCss()"},{"type":"text","value":" separately."}]},{"type":"heading","depth":2,"id":"renderer-owned-wrappers","children":[{"type":"text","value":"Renderer-owned wrappers"}]},{"type":"paragraph","children":[{"type":"text","value":"When another renderer owns the outer code block, point the base rules at its classes:"}]},{"type":"code","value":"const css = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: '.markdown-renderer',\n  darkSelector: '.dark .markdown-renderer',\n  codeBlockSelector: '.markdown-renderer pre.tm-code',\n  lineNumbersSelector: '.markdown-renderer .tm-code--line-numbers',\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The defaults remain "},{"type":"inlineCode","value":"pre.th-code"},{"type":"text","value":" and "},{"type":"inlineCode","value":".th-code--line-numbers"},{"type":"text","value":". Token classes stay "},{"type":"inlineCode","value":"th-*"},{"type":"text","value":" because Highlight owns the inner token markup."}]},{"type":"heading","depth":2,"id":"shipped-theme-matrix","children":[{"type":"text","value":"Shipped theme matrix"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Theme"}]},{"type":"tableCell","children":[{"type":"text","value":"Export"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Import"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Aurora X"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"auroraXTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/aurora-x"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Dracula"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"draculaTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/dracula"}]}],[{"type":"tableCell","children":[{"type":"text","value":"GitHub Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"githubDarkTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/github-dark"}]}],[{"type":"tableCell","children":[{"type":"text","value":"GitHub Light"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"githubLightTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Light"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/github-light"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Gruvbox Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"gruvboxDarkTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/gruvbox-dark"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Gruvbox Light"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"gruvboxLightTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Light"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/gruvbox-light"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Monokai"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"monokaiTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/monokai"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Nord"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"nordTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/nord"}]}],[{"type":"tableCell","children":[{"type":"text","value":"One Dark Pro"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"oneDarkProTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/one-dark-pro"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Solarized Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"solarizedDarkTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Dark"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/solarized-dark"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Solarized Light"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"solarizedLightTheme"}]},{"type":"tableCell","children":[{"type":"text","value":"Light"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"themes/solarized-light"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Prefix each import with "},{"type":"inlineCode","value":"@tanstack/highlight/"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"create-a-theme","children":[{"type":"text","value":"Create a theme"}]},{"type":"code","value":"import type { HighlightTheme } from '@tanstack/highlight/theme'\n\nexport const docsTheme = {\n  name: 'Docs Light',\n  type: 'light',\n  background: '#ffffff',\n  foreground: '#24292f',\n  tokens: {\n    token: '#24292f',\n    attr: '#953800',\n    'code-inline': '#0550ae',\n    command: '#8250df',\n    comment: '#6e7781',\n    deleted: '#cf222e',\n    function: '#8250df',\n    heading: '#0550ae',\n    inserted: '#116329',\n    keyword: '#cf222e',\n    link: '#0969da',\n    literal: '#0550ae',\n    meta: '#6e7781',\n    number: '#0550ae',\n    operator: '#cf222e',\n    property: '#953800',\n    selector: '#116329',\n    string: '#0a3069',\n    tag: '#116329',\n    type: '#953800',\n    variable: '#953800',\n  },\n} satisfies HighlightTheme","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The complete token record is intentional: missing semantic colors should be a type error rather than an implicit theme mismatch."}]},{"type":"paragraph","children":[{"type":"text","value":"Theme objects do not include font weight, italics, contrast validation, or typography. Add those rules in CSS."}]}],"headings":[{"id":"themes","text":"Themes","level":1},{"id":"light-and-dark","text":"Light and dark","level":2},{"id":"one-theme","text":"One theme","level":2},{"id":"multiple-named-themes","text":"Multiple named themes","level":2},{"id":"try-the-shipped-themes","text":"Try the shipped themes","level":2},{"id":"variables-only","text":"Variables only","level":2},{"id":"renderer-owned-wrappers","text":"Renderer-owned wrappers","level":2},{"id":"shipped-theme-matrix","text":"Shipped theme matrix","level":2},{"id":"create-a-theme","text":"Create a theme","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Themes\n\nThemes are isolated color objects converted into CSS variables. They never change tokenization or duplicate highlighted markup.\n\n## Light and dark\n\n```ts\nimport { createThemeCss } from '@tanstack/highlight/theme'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nconst css = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: ':root',\n  darkSelector: '.dark',\n})\n```\n\nThe default selectors are `:root` for light and `.dark` for dark.\n\n## One theme\n\n```ts\nimport { draculaTheme } from '@tanstack/highlight/themes/dracula'\n\nconst css = createThemeCss({\n  dark: draculaTheme,\n  darkSelector: ':root',\n})\n```\n\nAt least one of `light` or `dark` is required in pair mode.\n\n## Multiple named themes\n\n```ts\nconst css = createThemeCss({\n  themes: [\n    { selector: '[data-code-theme=\"github\"]', theme: githubLightTheme },\n    { selector: '[data-code-theme=\"dracula\"]', theme: draculaTheme },\n  ],\n})\n```\n\n`themes` mode is mutually exclusive with `light` and `dark`.\n\n## Try the shipped themes\n\nThe highlighted markup stays the same while the selected theme changes only its CSS variables.\n\n```ts group=highlight-themes file=/src/main.ts entry env=client\nimport { createHighlighter } from '@tanstack/highlight/core'\nimport { ts } from '@tanstack/highlight/languages/ts'\nimport { createThemeCss } from '@tanstack/highlight/theme'\nimport { draculaTheme } from '@tanstack/highlight/themes/dracula'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nconst highlighter = createHighlighter({ languages: [ts] })\nconst result = highlighter.highlight(\n  [\n    'type Theme = \"light\" | \"dark\"',\n    '',\n    'export function selectTheme(theme: Theme) {',\n    '  document.documentElement.dataset.theme = theme',\n    '}',\n  ].join('\\n'),\n  { lang: 'ts' },\n)\n\nconst themeCss = createThemeCss({\n  themes: [\n    { selector: '[data-code-theme=\"github-light\"]', theme: githubLightTheme },\n    { selector: '[data-code-theme=\"github-dark\"]', theme: githubDarkTheme },\n    { selector: '[data-code-theme=\"dracula\"]', theme: draculaTheme },\n  ],\n})\n\nexport default function render(output: HTMLElement) {\n  const style = document.createElement('style')\n  style.textContent = `${themeCss}\nbody { margin: 0; padding: 24px; font-family: ui-sans-serif, system-ui; }\n.demo { overflow: hidden; border: 1px solid color-mix(in srgb, currentColor 16%, transparent); border-radius: 12px; background: var(--th-background); color: var(--th-token); }\n.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent); }\n.toolbar label { font-size: 13px; font-weight: 600; }\n.toolbar select { padding: 6px 28px 6px 8px; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); border-radius: 7px; background: var(--th-background); color: var(--th-token); }\npre.th-code { margin: 0; }\ncode { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 14px; line-height: 1.6; }`\n\n  document.head.append(style)\n  output.innerHTML = `<section class=\"demo\" data-code-theme=\"github-light\">\n  <div class=\"toolbar\">\n    <label for=\"theme\">Code theme</label>\n    <select id=\"theme\">\n      <option value=\"github-light\">GitHub Light</option>\n      <option value=\"github-dark\">GitHub Dark</option>\n      <option value=\"dracula\">Dracula</option>\n    </select>\n  </div>\n  ${result.html}\n</section>`\n\n  const demo = output.querySelector('.demo')\n  const select = output.querySelector('#theme')\n\n  if (demo instanceof HTMLElement && select instanceof HTMLSelectElement) {\n    select.addEventListener('change', () => {\n      demo.dataset.codeTheme = select.value\n    })\n  }\n}\n```\n\n## Variables only\n\nSet `includeBaseStyles: false` when the application already owns the token selectors:\n\n```ts\nconst variables = createThemeCss({\n  light: githubLightTheme,\n  includeBaseStyles: false,\n})\n```\n\nYou can also call `createThemeRule(selector, theme)` and `createThemeBaseCss()` separately.\n\n## Renderer-owned wrappers\n\nWhen another renderer owns the outer code block, point the base rules at its classes:\n\n```ts\nconst css = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: '.markdown-renderer',\n  darkSelector: '.dark .markdown-renderer',\n  codeBlockSelector: '.markdown-renderer pre.tm-code',\n  lineNumbersSelector: '.markdown-renderer .tm-code--line-numbers',\n})\n```\n\nThe defaults remain `pre.th-code` and `.th-code--line-numbers`. Token classes stay `th-*` because Highlight owns the inner token markup.\n\n## Shipped theme matrix\n\n| Theme | Export | Type | Import |\n| --- | --- | --- | --- |\n| Aurora X | `auroraXTheme` | Dark | `themes/aurora-x` |\n| Dracula | `draculaTheme` | Dark | `themes/dracula` |\n| GitHub Dark | `githubDarkTheme` | Dark | `themes/github-dark` |\n| GitHub Light | `githubLightTheme` | Light | `themes/github-light` |\n| Gruvbox Dark | `gruvboxDarkTheme` | Dark | `themes/gruvbox-dark` |\n| Gruvbox Light | `gruvboxLightTheme` | Light | `themes/gruvbox-light` |\n| Monokai | `monokaiTheme` | Dark | `themes/monokai` |\n| Nord | `nordTheme` | Dark | `themes/nord` |\n| One Dark Pro | `oneDarkProTheme` | Dark | `themes/one-dark-pro` |\n| Solarized Dark | `solarizedDarkTheme` | Dark | `themes/solarized-dark` |\n| Solarized Light | `solarizedLightTheme` | Light | `themes/solarized-light` |\n\nPrefix each import with `@tanstack/highlight/`.\n\n## Create a theme\n\n```ts\nimport type { HighlightTheme } from '@tanstack/highlight/theme'\n\nexport const docsTheme = {\n  name: 'Docs Light',\n  type: 'light',\n  background: '#ffffff',\n  foreground: '#24292f',\n  tokens: {\n    token: '#24292f',\n    attr: '#953800',\n    'code-inline': '#0550ae',\n    command: '#8250df',\n    comment: '#6e7781',\n    deleted: '#cf222e',\n    function: '#8250df',\n    heading: '#0550ae',\n    inserted: '#116329',\n    keyword: '#cf222e',\n    link: '#0969da',\n    literal: '#0550ae',\n    meta: '#6e7781',\n    number: '#0550ae',\n    operator: '#cf222e',\n    property: '#953800',\n    selector: '#116329',\n    string: '#0a3069',\n    tag: '#116329',\n    type: '#953800',\n    variable: '#953800',\n  },\n} satisfies HighlightTheme\n```\n\nThe complete token record is intentional: missing semantic colors should be a type error rather than an implicit theme mismatch.\n\nTheme objects do not include font weight, italics, contrast validation, or typography. Add those rules in CSS.\n","originalRawMarkdown":"---\ntitle: Themes\n---\n\n# Themes\n\nThemes are isolated color objects converted into CSS variables. They never change tokenization or duplicate highlighted markup.\n\n## Light and dark\n\n```ts\nimport { createThemeCss } from '@tanstack/highlight/theme'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nconst css = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: ':root',\n  darkSelector: '.dark',\n})\n```\n\nThe default selectors are `:root` for light and `.dark` for dark.\n\n## One theme\n\n```ts\nimport { draculaTheme } from '@tanstack/highlight/themes/dracula'\n\nconst css = createThemeCss({\n  dark: draculaTheme,\n  darkSelector: ':root',\n})\n```\n\nAt least one of `light` or `dark` is required in pair mode.\n\n## Multiple named themes\n\n```ts\nconst css = createThemeCss({\n  themes: [\n    { selector: '[data-code-theme=\"github\"]', theme: githubLightTheme },\n    { selector: '[data-code-theme=\"dracula\"]', theme: draculaTheme },\n  ],\n})\n```\n\n`themes` mode is mutually exclusive with `light` and `dark`.\n\n## Try the shipped themes\n\nThe highlighted markup stays the same while the selected theme changes only its CSS variables.\n\n```ts group=highlight-themes file=/src/main.ts entry env=client\nimport { createHighlighter } from '@tanstack/highlight/core'\nimport { ts } from '@tanstack/highlight/languages/ts'\nimport { createThemeCss } from '@tanstack/highlight/theme'\nimport { draculaTheme } from '@tanstack/highlight/themes/dracula'\nimport { githubDarkTheme } from '@tanstack/highlight/themes/github-dark'\nimport { githubLightTheme } from '@tanstack/highlight/themes/github-light'\n\nconst highlighter = createHighlighter({ languages: [ts] })\nconst result = highlighter.highlight(\n  [\n    'type Theme = \"light\" | \"dark\"',\n    '',\n    'export function selectTheme(theme: Theme) {',\n    '  document.documentElement.dataset.theme = theme',\n    '}',\n  ].join('\\n'),\n  { lang: 'ts' },\n)\n\nconst themeCss = createThemeCss({\n  themes: [\n    { selector: '[data-code-theme=\"github-light\"]', theme: githubLightTheme },\n    { selector: '[data-code-theme=\"github-dark\"]', theme: githubDarkTheme },\n    { selector: '[data-code-theme=\"dracula\"]', theme: draculaTheme },\n  ],\n})\n\nexport default function render(output: HTMLElement) {\n  const style = document.createElement('style')\n  style.textContent = `${themeCss}\nbody { margin: 0; padding: 24px; font-family: ui-sans-serif, system-ui; }\n.demo { overflow: hidden; border: 1px solid color-mix(in srgb, currentColor 16%, transparent); border-radius: 12px; background: var(--th-background); color: var(--th-token); }\n.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent); }\n.toolbar label { font-size: 13px; font-weight: 600; }\n.toolbar select { padding: 6px 28px 6px 8px; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); border-radius: 7px; background: var(--th-background); color: var(--th-token); }\npre.th-code { margin: 0; }\ncode { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 14px; line-height: 1.6; }`\n\n  document.head.append(style)\n  output.innerHTML = `<section class=\"demo\" data-code-theme=\"github-light\">\n  <div class=\"toolbar\">\n    <label for=\"theme\">Code theme</label>\n    <select id=\"theme\">\n      <option value=\"github-light\">GitHub Light</option>\n      <option value=\"github-dark\">GitHub Dark</option>\n      <option value=\"dracula\">Dracula</option>\n    </select>\n  </div>\n  ${result.html}\n</section>`\n\n  const demo = output.querySelector('.demo')\n  const select = output.querySelector('#theme')\n\n  if (demo instanceof HTMLElement && select instanceof HTMLSelectElement) {\n    select.addEventListener('change', () => {\n      demo.dataset.codeTheme = select.value\n    })\n  }\n}\n```\n\n## Variables only\n\nSet `includeBaseStyles: false` when the application already owns the token selectors:\n\n```ts\nconst variables = createThemeCss({\n  light: githubLightTheme,\n  includeBaseStyles: false,\n})\n```\n\nYou can also call `createThemeRule(selector, theme)` and `createThemeBaseCss()` separately.\n\n## Renderer-owned wrappers\n\nWhen another renderer owns the outer code block, point the base rules at its classes:\n\n```ts\nconst css = createThemeCss({\n  light: githubLightTheme,\n  dark: githubDarkTheme,\n  lightSelector: '.markdown-renderer',\n  darkSelector: '.dark .markdown-renderer',\n  codeBlockSelector: '.markdown-renderer pre.tm-code',\n  lineNumbersSelector: '.markdown-renderer .tm-code--line-numbers',\n})\n```\n\nThe defaults remain `pre.th-code` and `.th-code--line-numbers`. Token classes stay `th-*` because Highlight owns the inner token markup.\n\n## Shipped theme matrix\n\n| Theme | Export | Type | Import |\n| --- | --- | --- | --- |\n| Aurora X | `auroraXTheme` | Dark | `themes/aurora-x` |\n| Dracula | `draculaTheme` | Dark | `themes/dracula` |\n| GitHub Dark | `githubDarkTheme` | Dark | `themes/github-dark` |\n| GitHub Light | `githubLightTheme` | Light | `themes/github-light` |\n| Gruvbox Dark | `gruvboxDarkTheme` | Dark | `themes/gruvbox-dark` |\n| Gruvbox Light | `gruvboxLightTheme` | Light | `themes/gruvbox-light` |\n| Monokai | `monokaiTheme` | Dark | `themes/monokai` |\n| Nord | `nordTheme` | Dark | `themes/nord` |\n| One Dark Pro | `oneDarkProTheme` | Dark | `themes/one-dark-pro` |\n| Solarized Dark | `solarizedDarkTheme` | Dark | `themes/solarized-dark` |\n| Solarized Light | `solarizedLightTheme` | Light | `themes/solarized-light` |\n\nPrefix each import with `@tanstack/highlight/`.\n\n## Create a theme\n\n```ts\nimport type { HighlightTheme } from '@tanstack/highlight/theme'\n\nexport const docsTheme = {\n  name: 'Docs Light',\n  type: 'light',\n  background: '#ffffff',\n  foreground: '#24292f',\n  tokens: {\n    token: '#24292f',\n    attr: '#953800',\n    'code-inline': '#0550ae',\n    command: '#8250df',\n    comment: '#6e7781',\n    deleted: '#cf222e',\n    function: '#8250df',\n    heading: '#0550ae',\n    inserted: '#116329',\n    keyword: '#cf222e',\n    link: '#0969da',\n    literal: '#0550ae',\n    meta: '#6e7781',\n    number: '#0550ae',\n    operator: '#cf222e',\n    property: '#953800',\n    selector: '#116329',\n    string: '#0a3069',\n    tag: '#116329',\n    type: '#953800',\n    variable: '#953800',\n  },\n} satisfies HighlightTheme\n```\n\nThe complete token record is intentional: missing semantic colors should be a type error rather than an implicit theme mismatch.\n\nTheme objects do not include font weight, italics, contrast validation, or typography. Add those rules in CSS.\n"}
