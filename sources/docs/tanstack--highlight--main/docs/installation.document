{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"paragraph","children":[{"type":"text","value":"Install the package with your package manager:"}]},{"type":"code","value":"pnpm add @tanstack/highlight","lang":"sh"},{"type":"code","value":"npm install @tanstack/highlight","lang":"sh"},{"type":"code","value":"yarn add @tanstack/highlight","lang":"sh"},{"type":"code","value":"bun add @tanstack/highlight","lang":"sh"},{"type":"heading","depth":2,"id":"requirements","children":[{"type":"text","value":"Requirements"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Node.js 18 or newer for server-side rendering and build tooling"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"An ESM-capable runtime or bundler"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"No framework peer dependency"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The package is ESM-only and has no runtime dependencies."}]},{"type":"heading","depth":2,"id":"entry-points","children":[{"type":"text","value":"Entry points"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Import"}]},{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]},{"type":"tableCell","children":[{"type":"text","value":"Pulls all languages?"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight"}]},{"type":"tableCell","children":[{"type":"text","value":"Preconfigured API and core re-exports"}]},{"type":"tableCell","children":[{"type":"text","value":"Bound helpers do; core-only imports can tree-shake"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/core"}]},{"type":"tableCell","children":[{"type":"text","value":"Registry and renderer primitives"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/languages/<name>"}]},{"type":"tableCell","children":[{"type":"text","value":"One language definition"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/languages"}]},{"type":"tableCell","children":[{"type":"text","value":"Aggregate language exports"}]},{"type":"tableCell","children":[{"type":"text","value":"Relies on tree shaking"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/theme"}]},{"type":"tableCell","children":[{"type":"text","value":"Theme CSS helpers"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/themes/<name>"}]},{"type":"tableCell","children":[{"type":"text","value":"One theme object"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/markdown"}]},{"type":"tableCell","children":[{"type":"text","value":"Fence metadata and HAST helpers"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/remark"}]},{"type":"tableCell","children":[{"type":"text","value":"Remark adapter"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/rehype"}]},{"type":"tableCell","children":[{"type":"text","value":"Rehype adapter"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/react"}]},{"type":"tableCell","children":[{"type":"text","value":"React-oriented data helper"}]},{"type":"tableCell","children":[{"type":"text","value":"No React dependency"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/highlight/octane"}]},{"type":"tableCell","children":[{"type":"text","value":"Octane component and MDX helpers"}]},{"type":"tableCell","children":[{"type":"text","value":"No Octane dependency"}]}]]},{"type":"heading","depth":2,"id":"recommended-import-style","children":[{"type":"text","value":"Recommended import style"}]},{"type":"paragraph","children":[{"type":"text","value":"Documentation sites should normally use the selective core:"}]},{"type":"code","value":"import { createHighlighter } from '@tanstack/highlight/core'\nimport { css } from '@tanstack/highlight/languages/css'\nimport { tsx } from '@tanstack/highlight/languages/tsx'\n\nexport const highlighter = createHighlighter({\n  languages: [css, tsx],\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The root entry is useful for prototypes, server-only scripts, or sites where the roughly 18 KB gzip all-language build is acceptable:"}]},{"type":"code","value":"import { highlight } from '@tanstack/highlight'","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Importing only core helpers such as "},{"type":"inlineCode","value":"createHighlighter"},{"type":"text","value":" or "},{"type":"inlineCode","value":"escapeHtml"},{"type":"text","value":" from the root lets a compatible bundler remove the built-in language registry. Direct "},{"type":"inlineCode","value":"/core"},{"type":"text","value":" and "},{"type":"inlineCode","value":"/languages/<name>"},{"type":"text","value":" imports keep that separation explicit."}]},{"type":"heading","depth":2,"id":"typescript","children":[{"type":"text","value":"TypeScript"}]},{"type":"paragraph","children":[{"type":"text","value":"Declarations ship with every public entry. No "},{"type":"inlineCode","value":"@types"},{"type":"text","value":" package is required."}]},{"type":"heading","depth":2,"id":"content-security-policy","children":[{"type":"text","value":"Content Security Policy"}]},{"type":"paragraph","children":[{"type":"text","value":"The renderer does not inject scripts or inline color styles. Theme CSS can be generated at build time and placed in your normal stylesheet. Code text and decoration attribute values are escaped before rendering."}]}],"headings":[{"id":"installation","text":"Installation","level":1},{"id":"requirements","text":"Requirements","level":2},{"id":"entry-points","text":"Entry points","level":2},{"id":"recommended-import-style","text":"Recommended import style","level":2},{"id":"typescript","text":"TypeScript","level":2},{"id":"content-security-policy","text":"Content Security Policy","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Installation\n\nInstall the package with your package manager:\n\n```sh\npnpm add @tanstack/highlight\n```\n\n```sh\nnpm install @tanstack/highlight\n```\n\n```sh\nyarn add @tanstack/highlight\n```\n\n```sh\nbun add @tanstack/highlight\n```\n\n## Requirements\n\n- Node.js 18 or newer for server-side rendering and build tooling\n- An ESM-capable runtime or bundler\n- No framework peer dependency\n\nThe package is ESM-only and has no runtime dependencies.\n\n## Entry points\n\n| Import | Purpose | Pulls all languages? |\n| --- | --- | --- |\n| `@tanstack/highlight` | Preconfigured API and core re-exports | Bound helpers do; core-only imports can tree-shake |\n| `@tanstack/highlight/core` | Registry and renderer primitives | No |\n| `@tanstack/highlight/languages/<name>` | One language definition | No |\n| `@tanstack/highlight/languages` | Aggregate language exports | Relies on tree shaking |\n| `@tanstack/highlight/theme` | Theme CSS helpers | No |\n| `@tanstack/highlight/themes/<name>` | One theme object | No |\n| `@tanstack/highlight/markdown` | Fence metadata and HAST helpers | No |\n| `@tanstack/highlight/remark` | Remark adapter | No |\n| `@tanstack/highlight/rehype` | Rehype adapter | No |\n| `@tanstack/highlight/react` | React-oriented data helper | No React dependency |\n| `@tanstack/highlight/octane` | Octane component and MDX helpers | No Octane dependency |\n\n## Recommended import style\n\nDocumentation sites should normally use the selective core:\n\n```ts\nimport { createHighlighter } from '@tanstack/highlight/core'\nimport { css } from '@tanstack/highlight/languages/css'\nimport { tsx } from '@tanstack/highlight/languages/tsx'\n\nexport const highlighter = createHighlighter({\n  languages: [css, tsx],\n})\n```\n\nThe root entry is useful for prototypes, server-only scripts, or sites where the roughly 18 KB gzip all-language build is acceptable:\n\n```ts\nimport { highlight } from '@tanstack/highlight'\n```\n\nImporting only core helpers such as `createHighlighter` or `escapeHtml` from the root lets a compatible bundler remove the built-in language registry. Direct `/core` and `/languages/<name>` imports keep that separation explicit.\n\n## TypeScript\n\nDeclarations ship with every public entry. No `@types` package is required.\n\n## Content Security Policy\n\nThe renderer does not inject scripts or inline color styles. Theme CSS can be generated at build time and placed in your normal stylesheet. Code text and decoration attribute values are escaped before rendering.\n","originalRawMarkdown":"---\ntitle: Installation\n---\n\n# Installation\n\nInstall the package with your package manager:\n\n```sh\npnpm add @tanstack/highlight\n```\n\n```sh\nnpm install @tanstack/highlight\n```\n\n```sh\nyarn add @tanstack/highlight\n```\n\n```sh\nbun add @tanstack/highlight\n```\n\n## Requirements\n\n- Node.js 18 or newer for server-side rendering and build tooling\n- An ESM-capable runtime or bundler\n- No framework peer dependency\n\nThe package is ESM-only and has no runtime dependencies.\n\n## Entry points\n\n| Import | Purpose | Pulls all languages? |\n| --- | --- | --- |\n| `@tanstack/highlight` | Preconfigured API and core re-exports | Bound helpers do; core-only imports can tree-shake |\n| `@tanstack/highlight/core` | Registry and renderer primitives | No |\n| `@tanstack/highlight/languages/<name>` | One language definition | No |\n| `@tanstack/highlight/languages` | Aggregate language exports | Relies on tree shaking |\n| `@tanstack/highlight/theme` | Theme CSS helpers | No |\n| `@tanstack/highlight/themes/<name>` | One theme object | No |\n| `@tanstack/highlight/markdown` | Fence metadata and HAST helpers | No |\n| `@tanstack/highlight/remark` | Remark adapter | No |\n| `@tanstack/highlight/rehype` | Rehype adapter | No |\n| `@tanstack/highlight/react` | React-oriented data helper | No React dependency |\n| `@tanstack/highlight/octane` | Octane component and MDX helpers | No Octane dependency |\n\n## Recommended import style\n\nDocumentation sites should normally use the selective core:\n\n```ts\nimport { createHighlighter } from '@tanstack/highlight/core'\nimport { css } from '@tanstack/highlight/languages/css'\nimport { tsx } from '@tanstack/highlight/languages/tsx'\n\nexport const highlighter = createHighlighter({\n  languages: [css, tsx],\n})\n```\n\nThe root entry is useful for prototypes, server-only scripts, or sites where the roughly 18 KB gzip all-language build is acceptable:\n\n```ts\nimport { highlight } from '@tanstack/highlight'\n```\n\nImporting only core helpers such as `createHighlighter` or `escapeHtml` from the root lets a compatible bundler remove the built-in language registry. Direct `/core` and `/languages/<name>` imports keep that separation explicit.\n\n## TypeScript\n\nDeclarations ship with every public entry. No `@types` package is required.\n\n## Content Security Policy\n\nThe renderer does not inject scripts or inline color styles. Theme CSS can be generated at build time and placed in your normal stylesheet. Code text and decoration attribute values are escaped before rendering.\n"}
