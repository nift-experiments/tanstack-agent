uau backtick strings, shebang lines, paren-less calls, LuaJIT number suffixes"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Markdown"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"markdown"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"md"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional fenced-language delegation"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Mermaid"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"mermaid"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"Common diagram declarations and arrows"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Nginx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"nginx"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"Directives, variables, URLs, comments"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Perl"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"perl"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"pl"}]},{"type":"tableCell","children":[{"type":"text","value":"Sigil and special variables, quote-like operators with nested delimiters, regex vs division, heredocs, POD blocks"}]}],[{"type":"tableCell","children":[{"type":"text","value":"PHP"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"php"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"PHP tags, attributes, quoted strings, heredoc/nowdoc, optional HTML delegation"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Plaintext"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"plaintext"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"text"},{"type":"text","value":", "},{"type":"inlineCode","value":"txt"},{"