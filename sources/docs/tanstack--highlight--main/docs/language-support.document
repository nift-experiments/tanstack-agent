{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"language-support","children":[{"type":"text","value":"Language Support"}]},{"type":"paragraph","children":[{"type":"text","value":"Every language is an isolated definition imported from "},{"type":"inlineCode","value":"@tanstack/highlight/languages/<name>"},{"type":"text","value":". Aliases normalize only when their target definition is registered."}]},{"type":"heading","depth":2,"id":"language-matrix","children":[{"type":"text","value":"Language matrix"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Language"}]},{"type":"tableCell","children":[{"type":"text","value":"Export"}]},{"type":"tableCell","children":[{"type":"text","value":"Aliases"}]},{"type":"tableCell","children":[{"type":"text","value":"Context-aware behavior"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Apache"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"apache"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"Directives, tags, comments"}]}],[{"type":"tableCell","children":[{"type":"text","value":"CMake"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"cmake"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"Bracket strings/comments, nested variables, generator expressions"}]}],[{"type":"tableCell","children":[{"type":"text","value":"C++"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"cpp"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"c++"},{"type":"text","value":", "},{"type":"inlineCode","value":"cc"},{"type":"text","value":", "},{"type":"inlineCode","value":"cxx"},{"type":"text","value":", "},{"type":"inlineCode","value":"hpp"},{"type":"text","value":", "},{"type":"inlineCode","value":"hxx"}]},{"type":"tableCell","children":[{"type":"text","value":"Raw and prefixed strings, character literals, preprocessor directives, digit separators"}]}],[{"type":"tableCell","children":[{"type":"text","value":"C#"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"csharp"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"c#"},{"type":"text","value":", "},{"type":"inlineCode","value":"cs"}]},{"type":"tableCell","children":[{"type":"text","value":"Verbatim, interpolated, and raw strings with nested quotes, character literals, preprocessor directives, line-leading and parameter attributes, contextual and LINQ keywords"}]}],[{"type":"tableCell","children":[{"type":"text","value":"CSS"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"css"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"Strings and comments protect inner syntax"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Dart"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"dart"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"Interpolated strings with nested quotes and braces, triple-quoted and raw strings, nested block comments, annotations, named-argument labels, contextual keywords"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Diff"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"diff"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"patch"}]},{"type":"tableCell","children":[{"type":"text","value":"Metadata, inserted, and deleted lines"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Dockerfile"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"dockerfile"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"docker"}]},{"type":"tableCell","children":[{"type":"text","value":"Common directives, variables, commands"}]}],[{"type":"tableCell","children":[{"type":"text","value":"EJS"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ejs"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"HTML plus optional JavaScript delegation"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Env"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"env"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"dotenv"}]},{"type":"tableCell","children":[{"type":"text","value":"Properties, values, comments"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Go"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"go"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"golang"}]},{"type":"tableCell","children":[{"type":"text","value":"Raw strings, runes, comments, declarations"}]}],[{"type":"tableCell","children":[{"type":"text","value":"HTML"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"html"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"htm"},{"type":"text","value":", "},{"type":"inlineCode","value":"xml"},{"type":"text","value":", "},{"type":"inlineCode","value":"angular-html"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional JavaScript/TypeScript and CSS delegation"}]}],[{"type":"tableCell","children":[{"type":"text","value":"HTTP"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"http"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"Methods, headers, protocol, paths"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Java"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"java"}]},{"type":"tableCell","children":[{"type":"text","value":"-"}]},{"type":"tableCell","children":[{"type":"text","value":"Text blocks, character literals, annotations, contextual keywords, digit separators and hex floats"}]}],[{"type"