ases. "},{"type":"inlineCode","value":"normalizeLanguage"},{"type":"text","value":" returns a canonical name when registered and the configured fallback otherwise."}]},{"type":"heading","depth":3,"id":"highlightoptions","children":[{"type":"inlineCode","value":"HighlightOptions"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Field"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Meaning"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"lang"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"text","value":"Registered name or alias"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"lineNumbers"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Wrap each line and emit line-number hooks"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"decorations"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ReadonlyArray<HighlightDecoration>"}]},{"type":"tableCell","children":[{"type":"text","value":"Line or character-range annotations"}]}]]},{"type":"heading","depth":3,"id":"rendercodeblockoptions","children":[{"type":"inlineCode","value":"RenderCodeBlockOptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"HighlightOptions"},{"type":"text","value":" plus an optional "},{"type":"inlineCode","value":"title"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"highlighttokenresult","children":[{"type":"inlineCode","value":"HighlightTokenResult"}]},{"type":"code","value":"type HighlightTokenResult = {\n  code: string\n  lang: string\n  tokens: Array<HighlightToken>\n}","lang":"ts"},{"type":"heading","depth":3,"id":"highlightresult","children":[{"type":"inlineCode","value":"HighlightResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"HighlightTokenResult"},{"type":"text","value":" plus "},{"type":"inlineCode","value":"html"},{"type":"text","value":", a complete escaped "},{"type":"inlineCode","value":"<pre><code>"},{"type":"text","value":" string."}]},{"type":"heading","depth":3,"id":"renderedcodeblockdata","children":[{"type":"inlineCode","value":"RenderedCodeBlockData"}]},{"type":"code","value":"type RenderedCodeBlockData = {\n  copyText: string\n  htmlMarkup: string\n  lang: string\n  title?: string\n  tokens: Array<HighlightToken>\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"renderCodeBlockData"},{"type":"text","value":" trims trailing whitespace before creating every field."}]},{"type":"heading","depth":2,"id":"tokens","children":[{"type":"text","value":"Tokens"}]},{"type":"heading","depth":3,"id":"highlighttokenclass","children":[{"type":"inlineCode","value":"HighlightTokenClass"}]},{"type":"paragraph","children":[{"type":"text","value":"The semantic class union: "},{"type":"inlineCode","value":"attr"},{"type":"text","value":", "},{"type":"inlineCode","value":"code-inline"},{"type":"text","value":", "},{"type":"inlineCode","value":"command"},{"type":"text","value":", "},{"type":"inlineCode","value":"comment"},{"type":"text","value":", "},{"type":"inlineCode","value":"deleted"},{"type":"text","value":", "},{"type":"inlineCode","value":"function"},{"type":"text","value":", "},{"type":"inlineCode","value":"heading"},{"type":"text","value":", "},{"type":"inlineCode","value":"inserted"},{"type":"text","value":", "},{"type":"inlineCode","value":"keyword"},{"type":"text","value":", "},{"type":"inlineCode","value":"link"},{"type":"text","value":", "},{"type":"inlineCode","value":"literal"},{"type":"text","value":", "},{"type":"inlineCode","value":"meta"},{"type":"text","value":", "},{"type":"inlineCode","value":"number"},{"type":"text","value":", "},{"type":"inlineCode","value":"operator"},{"type":"text","value":", "},{"type":"inlineCode","value":"property"},{"type":"text","value":", "},{"type":"inlineCode","value":"selector"},{"type":"text","value":", "},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"tag"},{"type":"text","value":", "},{"type":"inlineCode","value":"type"},{"type":"text","value":", and "},{"type":"inlineCode","value":"variable"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"highlighttoken","children":[{"type":"inlineCode","value":"HighlightToken"}]},{"type":"code","value":"type HighlightToken = {\n  className?: HighlightTokenClass\n  value: string\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Untyped source segments omit "},{"type":"inlineCode","value":"className"},{"type":"text","value":". Concatenating every "},{"type":"inlineCode","value":"value"},{"type":"text","value":" always reconstructs the input exactly."}]},{"type":"heading","depth":2,"id":"decorations","children":[{"type":"text","value":"Decorations"}]},{"type":"heading","depth":3,"id":"highlightdecorationdata","children":[{"type":"inlineCode","value":"HighlightDecorationData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Record<string, boolean | number | string>"},{"type":"text","value":". Keys become escaped "},{"type":"inlineCode","value":"data-*"},{"type":"text","value":" attributes on rendered spans."}]},{"type":"heading","depth":3,"id":"highlightrangedecoration","children":[{"type":"inlineCode","value":"HighlightRangeDecoration"}]},{"type":"code","value":"type HighlightRangeDecoration = {\n  range: readonly [start: number, end: number]\n  className?: string\n  data?: HighlightDecorationData\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The range uses zero-based, end-exclusive UTF-16 offsets."}]},{"type":"heading","depth":3,"id":"highlightlinedecoration","children":[{"type":"inlineCode","value":"HighlightLineDecoration"}]},{"type":"code","value":"type HighlightLineDecoration = {\n  lines: number | readonly [start: number, end: number]\n  className?: string\n  data?: HighlightDecorationData\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Lines are one-based and an interval includes both ends."}]},{"type":"heading","depth":3,"id":"highlightdecoration","children":[{"type":"inlineCode","value":"HighlightDecoration"}]},{"type":"paragraph","children":[{"type":"text","value":"The union of "},{"type":"inlineCode","value":"HighlightLineDecoration"},{"type":"text","value":" and "},{"type":"inlineCode","value":"HighlightRangeDecoration"},{"type":"text","value":". A decoration cannot contain both "},{"type":"inlineCode","value":"lines"},{"type":"text","value":" and "},{"type":"inlineCode","value":"range"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"render-tree","children":[{"type":"text","value":"Render tree"}]},{"type":"heading","depth":3,"id":"highlighttextnode","children":[{"type":"inlineCode","value":"HighlightTextNode"}]},{"type":"code","value":"type HighlightTextNode = { type: 'text'; value: string }","lang":"ts"},{"type":"heading","depth":3,"id":"highlightelementnode","children":[{"type":"inlineCode","value":"HighlightElementNode"}]},{"type":"code","value":"type HighlightElementNode = {\n  type: 'element'\n  classNames: Array<string>\n  data?: Record<string, string>\n  children: Array<HighlightRenderNode>\n}","lang":"ts"},{"type":"heading","depth":3,"id":"highlightrendernode","children":[{"type":"inlineCode","value":"HighlightRenderNode"}]},{"type":"paragraph","children":[{"type":"text","value":"The union of "},{"type":"inlineCode","value":"HighlightTextNode"},{"type":"text","value":" and "},{"type":"inlineCode","value":"HighlightElementNode"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"rendertokens","children":[{"type":"inlineCode","value":"renderTokens"}]},{"type":"code","value":"function renderTokens(\n  tokens: ReadonlyArray<HighlightToken>,\n  options?: Pick<HighlightOptions, 'decorations' | 'lineNumbers'>,\n): Array<HighlightRenderNode>","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Converts flat tokens to the renderer-neutral tree. It adds "},{"type":"inlineCode","value":"th-*"},{"type":"text","value":" token spans, decoration spans, and "},{"type":"inlineCode","value":"th-line"},{"type":"text","value":" wrappers when line numbers or line decorations require them."}]},{"type":"heading","depth":3,"id":"rendernodestohtml","children":[{"type":"inlineCode","value":"renderNodesToHtml"}]},{"type":"code","value":"function renderNodesToHtml(nodes: ReadonlyArray<HighlightRenderNode>): string","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Serializes render nodes to escaped HTML."}]},{"type":"heading","depth":3,"id":"escapehtml","children":[{"type":"inlineCode","value":"escapeHtml"}]},{"type":"code","value":"function escapeHtml(value: string): string","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Escapes "},{"type":"inlineCode","value":"&"},{"type":"text","value":", "},{"type":"inlineCode","value":"<"},{"type":"text","value":", "},{"type":"inlineCode","value":">"},{"type":"text","value":", double quotes, and single quotes for HTML text output."}]}],"headings":[{"id":"core-api","text":"Core API","level":1},{"id":"language-registration","text":"Language registration","level":2},{"id":"languagedefinition","text":"LanguageDefinition","level":3},{"id":"tokenrange","text":"TokenRange","level":3},{"id":"tokenizercontext","text":"TokenizerContext","level":3},{"id":"definelanguage","text":"defineLanguage","level":3},{"id":"createhighlighter","text":"createHighlighter","level":3},{"id":"highlighter","text":"Highlighter","level":2},{"id":"highlighter-2","text":"Highlighter","level":3},{"id":"highlightoptions","text":"HighlightOptions","level":3},{"id":"rendercodeblockoptions","text":"RenderCodeBlockOptions","level":3},{"id":"highlighttokenresult","text":"HighlightTokenResult","level":3},{"id":"highlightresult","text":"HighlightResult","level":3},{"id":"renderedcodeblockdata","text":"RenderedCodeBlockData","level":3},{"id":"tokens","text":"Tokens","level":2},{"id":"highlighttokenclass","text":"HighlightTokenClass","level":3},{"id":"highlighttoken","text":"HighlightToken","level":3},{"id":"decorations","text":"Decorations","level":2},{"id":"highlightdecorationdata","text":"HighlightDecorationData","level":3},{"id":"highlightrangedecoration","text":"HighlightRangeDecoration","level":3},{"id":"highlightlinedecoration","text":"HighlightLineDecoration","level":3},{"id":"highlightdecoration","text":"HighlightDecoration","level":3},{"id":"render-tree","text":"Render tree","level":2},{"id":"highlighttextnode","text":"HighlightTextNode","level":3},{"id":"highlightelementnode","text":"HighlightElementNode","level":3},{"id":"highlightrendernode","text":"HighlightRenderNode","level":3},{"id":"rendertokens","text":"renderTokens","level":3},{"id":"rendernodestohtml","text":"renderNodesToHtml","level":3},{"id":"escapehtml","text":"escapeHtml","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Core API\n\n`@tanstack/highlight/core` contains the engine and renderers. It does not import a language or theme.\n\n## Language registration\n\n### `LanguageDefinition`\n\n```ts\ntype LanguageDefinition<Name extends string = string> = {\n  aliases?: ReadonlyArray<string>\n  name: Name\n  tokenize: (\n    code: string,\n    context: TokenizerContext,\n  ) => ReadonlyArray<TokenRange>\n}\n```\n\nA language registration. The tokenizer returns semantic ranges in the original source.\n\n### `TokenRange`\n\n```ts\ntype TokenRange = {\n  className: HighlightTokenClass\n  start: number\n  end: number\n}\n```\n\n`start` is inclusive and `end` is exclusive. Both are zero-based UTF-16 string offsets. The highlighter clamps integer offsets to the source bounds, sorts ranges, and skips overlaps. Non-integer offsets are ignored.\n\n### `TokenizerContext`\n\n```ts\ntype TokenizerContext = {\n  hasLanguage: (lang: string) => boolean\n  tokenize: (code: string, lang: string) => Array<TokenRange>\n}\n```\n\nPassed to language tokenizers for opt-in embedded-language delegation. Recursive calls are capped at 24 levels.\n\n### `defineLanguage`\n\n```ts\nfunction defineLanguage<const Name extends string>(\n  definition: LanguageDefinition<Name>,\n): LanguageDefinition<Name>\n```\n\nAn identity helper that preserves the literal language name and validates the definition with TypeScript.\n\n### `createHighlighter`\n\n```ts\nfunction createHighlighter(options: {\n  fallbackLanguage?: string\n  languages: ReadonlyArray<LanguageDefinition>\n}): Highlighter\n```\n\nBuilds an immutable highlighter interface from the supplied registrations. The default fallback name is `plaintext`. An unregistered language, including an unregistered fallback, is rendered as escaped plain text.\n\nDuplicate canonical names or aliases use the last registration encountered.\n\n## Highlighter\n\n### `Highlighter`\n\n```ts\ntype Highlighter = {\n  highlight(code: string, options?: HighlightOptions): HighlightResult\n  highlightToHtml(code: string, options?: HighlightOptions): string\n  listLanguages(): Array<string>\n  normalizeLanguage(lang?: string): string\n  renderCodeBlockData(options: RenderCodeBlockOptions & { code: string }): RenderedCodeBlockData\n  tokenize(code: string, options?: HighlightOptions): HighlightTokenResult\n}\n```\n\n`listLanguages` returns canonical names, not aliases. `normalizeLanguage` returns a canonical name when registered and the configured fallback otherwise.\n\n### `HighlightOptions`\n\n| Field | Type | Meaning |\n| --- | --- | --- |\n| `lang` | `string` | Registered name or alias |\n| `lineNumbers` | `boolean` | Wrap each line and emit line-number hooks |\n| `decorations` | `ReadonlyArray<HighlightDecoration>` | Line or character-range annotations |\n\n### `RenderCodeBlockOptions`\n\n`HighlightOptions` plus an optional `title`.\n\n### `HighlightTokenResult`\n\n```ts\ntype HighlightTokenResult = {\n  code: string\n  lang: string\n  tokens: Array<HighlightToken>\n}\n```\n\n### `HighlightResult`\n\n`HighlightTokenResult` plus `html`, a complete escaped `<pre><code>` string.\n\n### `RenderedCodeBlockData`\n\n```ts\ntype RenderedCodeBlockData = {\n  copyText: string\n  htmlMarkup: string\n  lang: string\n  title?: string\n  tokens: Array<HighlightToken>\n}\n```\n\n`renderCodeBlockData` trims trailing whitespace before creating every field.\n\n## Tokens\n\n### `HighlightTokenClass`\n\nThe semantic class union: `attr`, `code-inline`, `command`, `comment`, `deleted`, `function`, `heading`, `inserted`, `keyword`, `link`, `literal`, `meta`, `number`, `operator`, `property`, `selector`, `string`, `tag`, `type`, and `variable`.\n\n### `HighlightToken`\n\n```ts\ntype HighlightToken = {\n  className?: HighlightTokenClass\n  value: string\n}\n```\n\nUntyped source segments omit `className`. Concatenating every `value` always reconstructs the input exactly.\n\n## Decorations\n\n### `HighlightDecorationData`\n\n`Record<string, boolean | number | string>`. Keys become escaped `data-*` attributes on rendered spans.\n\n### `HighlightRangeDecoration`\n\n```ts\ntype HighlightRangeDecoration = {\n  range: readonly [start: number, end: number]\n  className?: string\n  data?: HighlightDecorationData\n}\n```\n\nThe range uses zero-based, end-exclusive UTF-16 offsets.\n\n### `HighlightLineDecoration`\n\n```ts\ntype HighlightLineDecoration = {\n  lines: number | readonly [start: number, end: number]\n  className?: string\n  data?: HighlightDecorationData\n}\n```\n\nLines are one-based and an interval includes both ends.\n\n### `HighlightDecoration`\n\nThe union of `HighlightLineDecoration` and `HighlightRangeDecoration`. A decoration cannot contain both `lines` and `range`.\n\n## Render tree\n\n### `HighlightTextNode`\n\n```ts\ntype HighlightTextNode = { type: 'text'; value: string }\n```\n\n### `HighlightElementNode`\n\n```ts\ntype HighlightElementNode = {\n  type: 'element'\n  classNames: Array<string>\n  data?: Record<string, string>\n  children: Array<HighlightRenderNode>\n}\n```\n\n### `HighlightRenderNode`\n\nThe union of `HighlightTextNode` and `HighlightElementNode`.\n\n### `renderTokens`\n\n```ts\nfunction renderTokens(\n  tokens: ReadonlyArray<HighlightToken>,\n  options?: Pick<HighlightOptions, 'decorations' | 'lineNumbers'>,\n): Array<HighlightRenderNode>\n```\n\nConverts flat tokens to the renderer-neutral tree. It adds `th-*` token spans, decoration spans, and `th-line` wrappers when line numbers or line decorations require them.\n\n### `renderNodesToHtml`\n\n```ts\nfunction renderNodesToHtml(nodes: ReadonlyArray<HighlightRenderNode>): string\n```\n\nSerializes render nodes to escaped HTML.\n\n### `escapeHtml`\n\n```ts\nfunction escapeHtml(value: string): string\n```\n\nEscapes `&`, `<`, `>`, double quotes, and single quotes for HTML text output.\n","originalRawMarkdown":"---\ntitle: Core API\n---\n\n# Core API\n\n`@tanstack/highlight/core` contains the engine and renderers. It does not import a language or theme.\n\n## Language registration\n\n### `LanguageDefinition`\n\n```ts\ntype LanguageDefinition<Name extends string = string> = {\n  aliases?: ReadonlyArray<string>\n  name: Name\n  tokenize: (\n    code: string,\n    context: TokenizerContext,\n  ) => ReadonlyArray<TokenRange>\n}\n```\n\nA language registration. The tokenizer returns semantic ranges in the original source.\n\n### `TokenRange`\n\n```ts\ntype TokenRange = {\n  className: HighlightTokenClass\n  start: number\n  end: number\n}\n```\n\n`start` is inclusive and `end` is exclusive. Both are zero-based UTF-16 string offsets. The highlighter clamps integer offsets to the source bounds, sorts ranges, and skips overlaps. Non-integer offsets are ignored.\n\n### `TokenizerContext`\n\n```ts\ntype TokenizerContext = {\n  hasLanguage: (lang: string) => boolean\n  tokenize: (code: string, lang: string) => Array<TokenRange>\n}\n```\n\nPassed to language tokenizers for opt-in embedded-language delegation. Recursive calls are capped at 24 levels.\n\n### `defineLanguage`\n\n```ts\nfunction defineLanguage<const Name extends string>(\n  definition: LanguageDefinition<Name>,\n): LanguageDefinition<Name>\n```\n\nAn identity helper that preserves the literal language name and validates the definition with TypeScript.\n\n### `createHighlighter`\n\n```ts\nfunction createHighlighter(options: {\n  fallbackLanguage?: string\n  languages: ReadonlyArray<LanguageDefinition>\n}): Highlighter\n```\n\nBuilds an immutable highlighter interface from the supplied registrations. The default fallback name is `plaintext`. An unregistered language, including an unregistered fallback, is rendered as escaped plain text.\n\nDuplicate canonical names or aliases use the last registration encountered.\n\n## Highlighter\n\n### `Highlighter`\n\n```ts\ntype Highlighter = {\n  highlight(code: string, options?: HighlightOptions): HighlightResult\n  highlightToHtml(code: string, options?: HighlightOptions): string\n  listLanguages(): Array<string>\n  normalizeLanguage(lang?: string): string\n  renderCodeBlockData(options: RenderCodeBlockOptions & { code: string }): RenderedCodeBlockData\n  tokenize(code: string, options?: HighlightOptions): HighlightTokenResult\n}\n```\n\n`listLanguages` returns canonical names, not aliases. `normalizeLanguage` returns a canonical name when registered and the configured fallback otherwise.\n\n### `HighlightOptions`\n\n| Field | Type | Meaning |\n| --- | --- | --- |\n| `lang` | `string` | Registered name or alias |\n| `lineNumbers` | `boolean` | Wrap each line and emit line-number hooks |\n| `decorations` | `ReadonlyArray<HighlightDecoration>` | Line or character-range annotations |\n\n### `RenderCodeBlockOptions`\n\n`HighlightOptions` plus an optional `title`.\n\n### `HighlightTokenResult`\n\n```ts\ntype HighlightTokenResult = {\n  code: string\n  lang: string\n  tokens: Array<HighlightToken>\n}\n```\n\n### `HighlightResult`\n\n`HighlightTokenResult` plus `html`, a complete escaped `<pre><code>` string.\n\n### `RenderedCodeBlockData`\n\n```ts\ntype RenderedCodeBlockData = {\n  copyText: string\n  htmlMarkup: string\n  lang: string\n  title?: string\n  tokens: Array<HighlightToken>\n}\n```\n\n`renderCodeBlockData` trims trailing whitespace before creating every field.\n\n## Tokens\n\n### `HighlightTokenClass`\n\nThe semantic class union: `attr`, `code-inline`, `command`, `comment`, `deleted`, `function`, `heading`, `inserted`, `keyword`, `link`, `literal`, `meta`, `number`, `operator`, `property`, `selector`, `string`, `tag`, `type`, and `variable`.\n\n### `HighlightToken`\n\n```ts\ntype HighlightToken = {\n  className?: HighlightTokenClass\n  value: string\n}\n```\n\nUntyped source segments omit `className`. Concatenating every `value` always reconstructs the input exactly.\n\n## Decorations\n\n### `HighlightDecorationData`\n\n`Record<string, boolean | number | string>`. Keys become escaped `data-*` attributes on rendered spans.\n\n### `HighlightRangeDecoration`\n\n```ts\ntype HighlightRangeDecoration = {\n  range: readonly [start: number, end: number]\n  className?: string\n  data?: HighlightDecorationData\n}\n```\n\nThe range uses zero-based, end-exclusive UTF-16 offsets.\n\n### `HighlightLineDecoration`\n\n```ts\ntype HighlightLineDecoration = {\n  lines: number | readonly [start: number, end: number]\n  className?: string\n  data?: HighlightDecorationData\n}\n```\n\nLines are one-based and an interval includes both ends.\n\n### `HighlightDecoration`\n\nThe union of `HighlightLineDecoration` and `HighlightRangeDecoration`. A decoration cannot contain both `lines` and `range`.\n\n## Render tree\n\n### `HighlightTextNode`\n\n```ts\ntype HighlightTextNode = { type: 'text'; value: string }\n```\n\n### `HighlightElementNode`\n\n```ts\ntype HighlightElementNode = {\n  type: 'element'\n  classNames: Array<string>\n  data?: Record<string, string>\n  children: Array<HighlightRenderNode>\n}\n```\n\n### `HighlightRenderNode`\n\nThe union of `HighlightTextNode` and `HighlightElementNode`.\n\n### `renderTokens`\n\n```ts\nfunction renderTokens(\n  tokens: ReadonlyArray<HighlightToken>,\n  options?: Pick<HighlightOptions, 'decorations' | 'lineNumbers'>,\n): Array<HighlightRenderNode>\n```\n\nConverts flat tokens to the renderer-neutral tree. It adds `th-*` token spans, decoration spans, and `th-line` wrappers when line numbers or line decorations require them.\n\n### `renderNodesToHtml`\n\n```ts\nfunction renderNodesToHtml(nodes: ReadonlyArray<HighlightRenderNode>): string\n```\n\nSerializes render nodes to escaped HTML.\n\n### `escapeHtml`\n\n```ts\nfunction escapeHtml(value: string): string\n```\n\nEscapes `&`, `<`, `>`, double quotes, and single quotes for HTML text output.\n"}
