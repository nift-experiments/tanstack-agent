"value":"highlighter.renderCodeBlockData"},{"type":"text","value":", preserves "},{"type":"inlineCode","value":"className"},{"type":"text","value":", and creates the raw-HTML payload accepted by Octane host elements. The result is deterministic across server rendering and hydration."}]},{"type":"heading","depth":2,"id":"mdx-plugin","children":[{"type":"text","value":"MDX plugin"}]},{"type":"heading","depth":3,"id":"octanemdxhighlightoptions","children":[{"type":"inlineCode","value":"OctaneMdxHighlightOptions"}]},{"type":"paragraph","children":[{"type":"text","value":"An alias of "},{"type":"link","href":"rehype#rehypehighlightoptions","children":[{"type":"inlineCode","value":"RehypeHighlightOptions"}]},{"type":"text","value":". It requires an explicit "},{"type":"inlineCode","value":"highlighter"},{"type":"text","value":" and accepts "},{"type":"inlineCode","value":"lineNumbers"},{"type":"text","value":", "},{"type":"inlineCode","value":"getDecorations"},{"type":"text","value":", and "},{"type":"inlineCode","value":"getTitle"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"octanemdxhighlightplugin","children":[{"type":"inlineCode","value":"OctaneMdxHighlightPlugin"}]},{"type":"code","value":"type OctaneMdxHighlightPlugin = [\n  plugin: typeof rehypeHighlightCodeBlocks,\n  options: OctaneMdxHighlightOptions,\n]","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"A mutable Unified plugin tuple accepted inside the "},{"type":"inlineCode","value":"rehypePlugins"},{"type":"text","value":" array exposed by "},{"type":"inlineCode","value":"@octanejs/mdx"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"createoctanemdxhighlight","children":[{"type":"inlineCode","value":"createOctaneMdxHighlight"}]},{"type":"code","value":"function createOctaneMdxHighlight(\n  options: OctaneMdxHighlightOptions,\n): OctaneMdxHighlightPlugin","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Returns "},{"type":"inlineCode","value":"[rehypeHighlightCodeBlocks, options]"},{"type":"text","value":". The underlying transformer is synchronous, emits structured HAST, and skips already highlighted "},{"type":"inlineCode","value":"th-code"},{"type":"text","value":" blocks."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../guides/octane","children":[{"type":"text","value":"Octane guide"}]},{"type":"text","value":" for Vite, MDX, and direct-component examples."}]}],"headings":[{"id":"octane-api","text":"Octane API","level":1},{"id":"component-data","text":"Component data","level":2},{"id":"createhighlightedcodeblockpropsoptions","text":"CreateHighlightedCodeBlockPropsOptions","level":3},{"id":"highlightedcodeblockprops","text":"HighlightedCodeBlockProps","level":3},{"id":"createhighlightedcodeblockprops","text":"createHighlightedCodeBlockProps","level":3},{"id":"mdx-plugin","text":"MDX plugin","level":2},{"id":"octanemdxhighlightoptions","text":"OctaneMdxHighlightOptions","level":3},{"id":"octanemdxhighlightplugin","text":"OctaneMdxHighlightPlugin","level":3},{"id":"createoctanemdxhighlight","text":"createOctaneMdxHighlight","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Octane API\n\n`@tanstack/highlight/octane` adapts highlighted block data to Octane components and adapts the Rehype transformer to `@octanejs/mdx` plugin configuration. It has no framework dependency.\n\n## Component data\n\n### `CreateHighlightedCodeBlockPropsOptions`\n\n```ts\ntype CreateHighlightedCodeBlockPropsOptions = {\n  className?: string\n  code: string\n  decorations?: ReadonlyArray<HighlightDecoration>\n  highlighter: Highlighter\n  lang?: string\n  lineNumbers?: boolean\n  title?: string\n}\n```\n\n### `HighlightedCodeBlockProps`\n\n```ts\ntype HighlightedCodeBlockProps = RenderedCodeBlockData & {\n  className?: string\n  dangerouslySetInnerHTML: { __html: string }\n}\n```\n\n`dangerouslySetInnerHTML.__html` and `htmlMarkup` contain the same escaped `<pre><code>` tree.\n\n### `createHighlightedCodeBlockProps`\n\n```ts\nfunction createHighlightedCodeBlockProps(\n  options: CreateHighlightedCodeBlockPropsOptions,\n): HighlightedCodeBlockProps\n```\n\nCalls `highlighter.renderCodeBlockData`, preserves `className`, and creates the raw-HTML payload accepted by Octane host elements. The result is deterministic across server rendering and hydration.\n\n## MDX plugin\n\n### `OctaneMdxHighlightOptions`\n\nAn alias of [`RehypeHighlightOptions`](rehype#rehypehighlightoptions). It requires an explicit `highlighter` and accepts `lineNumbers`, `getDecorations`, and `getTitle`.\n\n### `OctaneMdxHighlightPlugin`\n\n```ts\ntype OctaneMdxHighlightPlugin = [\n  plugin: typeof rehypeHighlightCodeBlocks,\n  options: OctaneMdxHighlightOptions,\n]\n```\n\nA mutable Unified plugin tuple accepted inside the `rehypePlugins` array exposed by `@octanejs/mdx`.\n\n### `createOctaneMdxHighlight`\n\n```ts\nfunction createOctaneMdxHighlight(\n  options: OctaneMdxHighlightOptions,\n): OctaneMdxHighlightPlugin\n```\n\nReturns `[rehypeHighlightCodeBlocks, options]`. The underlying transformer is synchronous, emits structured HAST, and skips already highlighted `th-code` blocks.\n\nSee the [Octane guide](../guides/octane) for Vite, MDX, and direct-component examples.\n","originalRawMarkdown":"---\ntitle: Octane API\n---\n\n# Octane API\n\n`@tanstack/highlight/octane` adapts highlighted block data to Octane components and adapts the Rehype transformer to `@octanejs/mdx` plugin configuration. It has no framework dependency.\n\n## Component data\n\n### `CreateHighlightedCodeBlockPropsOptions`\n\n```ts\ntype CreateHighlightedCodeBlockPropsOptions = {\n  className?: string\n  code: string\n  decorations?: ReadonlyArray<HighlightDecoration>\n  highlighter: Highlighter\n  lang?: string\n  lineNumbers?: boolean\n  title?: string\n}\n```\n\n### `HighlightedCodeBlockProps`\n\n```ts\ntype HighlightedCodeBlockProps = RenderedCodeBlockData & {\n  className?: string\n  dangerouslySetInnerHTML: { __html: string }\n}\n```\n\n`dangerouslySetInnerHTML.__html` and `htmlMarkup` contain the same escaped `<pre><code>` tree.\n\n### `createHighlightedCodeBlockProps`\n\n```ts\nfunction createHighlightedCodeBlockProps(\n  options: CreateHighlightedCodeBlockPropsOptions,\n): HighlightedCodeBlockProps\n```\n\nCalls `highlighter.renderCodeBlockData`, preserves `className`, and creates the raw-HTML payload accepted by Octane host elements. The result is deterministic across server rendering and hydration.\n\n## MDX plugin\n\n### `OctaneMdxHighlightOptions`\n\nAn alias of [`RehypeHighlightOptions`](rehype#rehypehighlightoptions). It requires an explicit `highlighter` and accepts `lineNumbers`, `getDecorations`, and `getTitle`.\n\n### `OctaneMdxHighlightPlugin`\n\n```ts\ntype OctaneMdxHighlightPlugin = [\n  plugin: typeof rehypeHighlightCodeBlocks,\n  options: OctaneMdxHighlightOptions,\n]\n```\n\nA mutable Unified plugin tuple accepted inside the `rehypePlugins` array exposed by `@octanejs/mdx`.\n\n### `createOctaneMdxHighlight`\n\n```ts\nfunction createOctaneMdxHighlight(\n  options: OctaneMdxHighlightOptions,\n): OctaneMdxHighlightPlugin\n```\n\nReturns `[rehypeHighlightCodeBlocks, options]`. The underlying transformer is synchronous, emits structured HAST, and skips already highlighted `th-code` blocks.\n\nSee the [Octane guide](../guides/octane) for Vite, MDX, and direct-component examples.\n"}
