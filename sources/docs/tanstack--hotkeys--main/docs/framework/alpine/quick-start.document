,{"type":"text","value":" as shown in the "},{"type":"link","href":"./guides/hotkeys.md#registering-multiple-hotkeys","children":[{"type":"text","value":"hotkeys guide"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"scoped-hotkeys","children":[{"type":"text","value":"Scoped hotkeys"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass an actual element as "},{"type":"inlineCode","value":"target"},{"type":"text","value":". A "},{"type":"inlineCode","value":"null"},{"type":"text","value":" target defers registration until the element exists. Make the element focusable with "},{"type":"inlineCode","value":"tabindex=\"0\""},{"type":"text","value":". See the "},{"type":"link","href":"./guides/hotkeys.md#target","children":[{"type":"text","value":"complete scoped example"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"conditional-hotkeys","children":[{"type":"text","value":"Conditional hotkeys"}]},{"type":"code","value":"this.scope.createHotkey('Mod+S', () => console.log(\"Save\"), () => ({ enabled: this.enabled }))","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Use Alpine reactive state for the enabled flag."}]},{"type":"heading","depth":3,"id":"multi-key-sequences","children":[{"type":"text","value":"Multi-key sequences"}]},{"type":"code","value":"this.scope.createHotkeySequence(['G', 'G'], () => window.scrollTo({ top: 0 }))","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Release G between presses. Automatic key repeats do not advance sequences."}]},{"type":"heading","depth":3,"id":"tracking-held-keys-and-displaying-hints","children":[{"type":"text","value":"Tracking held keys and displaying hints"}]},{"type":"code","value":"import Alpine from 'alpinejs'\nimport { createHotkeysScope } from '@tanstack/alpine-hotkeys'\n\nAlpine.data('keyStatus', () => {\n\tconst scope = createHotkeysScope()\n\treturn {\n\t\theld: scope.createHeldKeys(),\n\t\tcodes: scope.createHeldKeyCodes(),\n\t\tshift: scope.createKeyHold('Shift'),\n\t\thint: scope.createHotkeyHint('Mod+S'),\n\t\tdestroy() { scope.destroy() },\n\t}\n})","lang":"ts"},{"type":"code","value":"<div x-data=\"keyStatus\">\n\t<p x-text=\"held.value.join(' + ') || 'No keys held'\"></p>\n\t<template x-for=\"key in held.value\" :key=\"key\">\n\t\t<p x-text=\"key + ': ' + codes.value[key]\"></p>\n\t</template>\n\t<button type=\"button\" x-show=\"shift.value\">Delete permanently</button>\n\t<kbd x-show=\"hint.value\">Save</kbd>\n</div>","lang":"html"},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"formatForDisplay(binding)"},{"type":"text","value":" for platform-specific labels. Keep the original binding in state; a display label is not a registration string."}]},{"type":"heading","depth":2,"id":"shared-defaults","children":[{"type":"text","value":"Shared defaults"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass defaults to "},{"type":"inlineCode","value":"createHotkeysScope"},{"type":"text","value":". The scope accepts "},{"type":"inlineCode","value":"hotkey"},{"type":"text","value":", "},{"type":"inlineCode","value":"hotkeySequence"},{"type":"text","value":", "},{"type":"inlineCode","value":"hotkeyRecorder"},{"type":"text","value":", and "},{"type":"inlineCode","value":"hotkeySequenceRecorder"},{"type":"text","value":" options. Pass a getter to follow Alpine state. Each component owns and destroys its scope. Call-specific options override scope defaults, and per-definition options override common options. Omitted options use the core defaults."}]},{"type":"code","value":"import Alpine from 'alpinejs'\nimport { createHotkeysScope } from '@tanstack/alpine-hotkeys'\n\nAlpine.data('scopedEditor', () => {\n  const scope = createHotkeysScope({\n    hotkey: { requireReset: true },\n    hotkeySequence: { timeout: 1500 },\n    hotkeyRecorder: { ignoreInputs: false },\n    hotkeySequenceRecorder: { idleTimeoutMs: 2000 },\n  })\n  return {\n    init() {\n      scope.createHotkey('Mod+S', () => console.log('Saved'))\n      scope.createHotkey('ArrowRight', () => console.log('Next'), { requireReset: false })\n    },\n    destroy() { scope.destroy() },\n  }\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"For changing defaults, create the scope in "},{"type":"inlineCode","value":"init()"},{"type":"text","value":" with "},{"type":"inlineCode","value":"createHotkeysScope(() => ({ hotkey: { enabled: this.enabled } }))"},{"type":"text","value":". Creating the getter in "},{"type":"inlineCode","value":"init()"},{"type":"text","value":" makes "},{"type":"inlineCode","value":"this"},{"type":"text","value":" refer to Alpine's reactive component instance. Share a defaults object or getter between components when they need the same policy; give each component its own scope for cleanup. The "},{"type":"inlineCode","value":"$hotkeys"},{"type":"text","value":" magic uses core defaults, so use an explicit scope when supplying shared defaults."}]},{"type":"heading","depth":2,"id":"optional-alpine-magic","children":[{"type":"text","value":"Optional Alpine magic"}]},{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"hotkeysPlugin"},{"type":"text","value":" before "},{"type":"inlineCode","value":"Alpine.start()"},{"type":"text","value":" to get an element-owned "},{"type":"inlineCode","value":"$hotkeys"},{"type":"text","value":" scope:"}]},{"type":"code","value":"import Alpine from 'alpinejs'\nimport { hotkeysPlugin } from '@tanstack/alpine-hotkeys'\n\nAlpine.plugin(hotkeysPlugin)\nAlpine.start()","lang":"ts"},{"type":"code","value":"<div x-data=\"{ count: 0 }\" x-init=\"$hotkeys.createHotkey('Mod+S', () => count++)\">\n\t<span x-text=\"count\"></span>\n</div>","lang":"html"},{"type":"paragraph","children":[{"type":"text","value":"The plugin destroys that scope when Alpine destroys the owning element. Choose an explicit scope or the magic for a registration; using both registers it twice."}]},{"type":"heading","depth":2,"id":"examples-and-next-steps","children":[{"type":"text","value":"Examples and next steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/hotkeys","children":[{"type":"text","value":"Hotkeys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/sequences","children":[{"type":"text","value":"Sequences"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/hotkey-recording","children":[{"type":"text","value":"Hotkey recording"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/sequence-recording","children":[{"type":"text","value":"Sequence recording"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/key-state-tracking","children":[{"type":"text","value":"Key state tracking"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/formatting-display","children":[{"type":"text","value":"Formatting and display"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./examples/kitchen-sink","children":[{"type":"text","value":"Kitchen sink"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./reference/index","children":[{"type":"text","value":"API reference"}]}]}]}]}],"headings":[{"id":"your-first-hotkey","text":"Your first hotkey","level":2},{"id":"registration-and-cleanup","text":"Registration and cleanup","level":2},{"id":"common-patterns","text":"Common patterns","level":2},{"id":"multiple-hotkeys","text":"Multiple hotkeys","level":3},{"id":"scoped-hotkeys","text":"Scoped hotkeys","level":3},{"id":"conditional-hotkeys","text":"Conditional hotkeys","level":3},{"id":"multi-key-sequences","text":"Multi-key sequences","level":3},{"id":"tracking-held-keys-and-displaying-hints","text":"Tracking held keys and displaying hints","level":3},{"id":"shared-defaults","text":"Shared defaults","level":2},{"id":"optional-alpine-magic","text":"Optional Alpine magic","level":2},{"id":"examples-and-next-steps","text":"Examples and next steps","level":2}]},"frameworks":[],"downloadMarkdown":"\nInstall `@tanstack/alpine-hotkeys` with the [installation instructions](../../installation). This guide builds a save shortcut and shows the component lifecycle used by the other APIs.\n\n## Your first hotkey\n\n\n```ts\nimport Alpine from 'alpinejs'\nimport { createHotkeysScope, formatForDisplay } from '@tanstack/alpine-hotkeys'\n\nclass Editor {\n\tcount = 0\n\tenabled = true\n\tscope = createHotkeysScope()\n\tlabel = formatForDisplay('Mod+S')\n\n\tinit() {\n\t\tthis.scope.createHotkey('Mod+S', () => this.count++,\n\t\t\t() => ({ enabled: this.enabled }))\n\t}\n\n\tdestroy() {\n\t\tthis.scope.destroy()\n\t}\n}\n\nAlpine.data('editor', () => new Editor())\nAlpine.start()\n```\n\n```html\n<div x-data=\"editor\">\n\t<button type=\"button\" @click=\"enabled = !enabled\">Toggle shortcut</button>\n\t<p>Press <kbd x-text=\"label\"></kbd>. Saved <span x-text=\"count\"></span> times.</p>\n</div>\n```\n\nThe Alpine adapter runs in the browser. In an application with server rendering, load it only on the client. Load the module after the markup is available. Call `Alpine.start()` once in your application entry point.\n\nPress Command+S on macOS or Control+S on Windows and Linux. The count increases and the browser save dialog is prevented. The toggle disables execution while preserving the registration.\n\n`Mod` resolves to the primary platform modifier. Use `Mod+[KeyS]` instead when the shortcut must follow the physical S position.\n\n## Registration and cleanup\n\nCreate one scope for each Alpine component. Register shortcuts in `init()` so getters and callbacks read the reactive component instance. Call `scope.destroy()` from the component's `destroy()` method. Destruction releases registrations, effects, Store subscriptions, and active recorders. Do not reuse a destroyed scope.\n\nPass getters for bindings and options that can change. A value such as `{ enabled: this.enabled }` captures the value at registration time; `() => ({ enabled: this.enabled })` follows Alpine state. State readers return an object with a reactive `.value` getter. Read it in a template or an Alpine effect instead of destructuring it once.\n\n## Common patterns\n\n### Multiple hotkeys\n\n\n```ts\nthis.scope.createHotkey('Mod+S', () => console.log('Save'))\nthis.scope.createHotkey('Mod+Z', () => console.log('Undo'))\nthis.scope.createHotkey('Mod+Shift+Z', () => console.log('Redo'))\n```\n\nEach registration is independent. For a dynamic list, use `createHotkeys` as shown in the [hotkeys guide](./guides/hotkeys.md#registering-multiple-hotkeys).\n\n### Scoped hotkeys\n\nPass an actual element as `target`. A `null` target defers registration until the element exists. Make the element focusable with `tabindex=\"0\"`. See the [complete scoped example](./guides/hotkeys.md#target).\n\n### Conditional hotkeys\n\n\n```ts\nthis.scope.createHotkey('Mod+S', () => console.log(\"Save\"), () => ({ enabled: this.enabled }))\n```\n\nUse Alpine reactive state for the enabled flag.\n\n### Multi-key sequences\n\n\n```ts\nthis.scope.createHotkeySequence(['G', 'G'], () => window.scrollTo({ top: 0 }))\n```\n\nRelease G between presses. Automatic key repeats do not advance sequences.\n\n### Tracking held keys and displaying hints\n\n\n```ts\nimport Alpine from 'alpinejs'\nimport { createHotkeysScope } from '@tanstack/alpine-hotkeys'\n\nAlpine.data('keyStatus', () => {\n\tconst scope = createHotkeysScope()\n\treturn {\n\t\theld: scope.createHeldKeys(),\n\t\tcodes: scope.createHeldKeyCodes(),\n\t\tshift: scope.createKeyHold('Shift'),\n\t\thint: scope.createHotkeyHint('Mod+S'),\n\t\tdestroy() { scope.destroy() },\n\t}\n})\n```\n\n```html\n<div x-data=\"keyStatus\">\n\t<p x-text=\"held.value.join(' + ') || 'No keys held'\"></p>\n\t<template x-for=\"key in held.value\" :key=\"key\">\n\t\t<p x-text=\"key + ': ' + codes.value[key]\"></p>\n\t</template>\n\t<button type=\"button\" x-show=\"shift.value\">Delete permanently</button>\n\t<kbd x-show=\"hint.value\">Save</kbd>\n</div>\n```\n\nUse `formatForDisplay(binding)` for platform-specific labels. Keep the original binding in state; a display label is not a registration string.\n\n## Shared defaults\n\nPass defaults to `createHotkeysScope`. The scope accepts `hotkey`, `hotkeySequence`, `hotkeyRecorder`, and `hotkeySequenceRecorder` options. Pass a getter to follow Alpine state. Each component owns and destroys its scope. Call-specific options override scope defaults, and per-definition options override common options. Omitted options use the core defaults.\n\n```ts\nimport Alpine from 'alpinejs'\nimport { createHotkeysScope } from '@tanstack/alpine-hotkeys'\n\nAlpine.data('scopedEditor', () => {\n  const scope = createHotkeysScope({\n    hotkey: { requireReset: true },\n    hotkeySequence: { timeout: 1500 },\n    hotkeyRecorder: { ignoreInputs: false },\n    hotkeySequenceRecorder: { idleTimeoutMs: 2000 },\n  })\n  return {\n    init() {\n      scope.createHotkey('Mod+S', () => console.log('Saved'))\n      scope.createHotkey('ArrowRight', () => console.log('Next'), { requireReset: false })\n    },\n    destroy() { scope.destroy() },\n  }\n})\n```\n\nFor changing defaults, create the scope in `init()` with `createHotkeysScope(() => ({ hotkey: { enabled: this.enabled } }))`. Creating the getter in `init()` makes `this` refer to Alpine's reactive component instance. Share a defaults object or getter between components when they need the same policy; give each component its own scope for cleanup. The `$hotkeys` magic uses core defaults, so use an explicit scope when supplying shared defaults.\n\n## Optional Alpine magic\n\nInstall `hotkeysPlugin` before `Alpine.start()` to get an element-owned `$hotkeys` scope:\n\n```ts\nimport Alpine from 'alpinejs'\nimport { hotkeysPlugin } from '@tanstack/alpine-hotkeys'\n\nAlpine.plugin(hotkeysPlugin)\nAlpine.start()\n```\n\n```html\n<div x-data=\"{ count: 0 }\" x-init=\"$hotkeys.createHotkey('Mod+S', () => count++)\">\n\t<span x-text=\"count\"></span>\n</div>\n```\n\nThe plugin destroys that scope when Alpine destroys the owning element. Choose an explicit scope or the magic for a registration; using both registers it twice.\n\n## Examples and next steps\n\n- [Hotkeys](./guides/hotkeys)\n- [Sequences](./guides/sequences)\n- [Hotkey recording](./guides/hotkey-recording)\n- [Sequence recording](./guides/sequence-recording)\n- [Key state tracking](./guides/key-state-tracking)\n- [Formatting and display](./guides/formatting-display)\n- [Kitchen sink](./examples/kitchen-sink)\n- [API reference](./reference/index)\n","originalRawMarkdown":"---\ntitle: Quick Start\nid: quick-start\n---\n\nInstall `@tanstack/alpine-hotkeys` with the [installation instructions](../../installation). This guide builds a save shortcut and shows the component lifecycle used by the other APIs.\n\n## Your first hotkey\n\n\n```ts\nimport Alpine from 'alpinejs'\nimport { createHotkeysScope, formatForDisplay } from '@tanstack/alpine-hotkeys'\n\nclass Editor {\n\tcount = 0\n\tenabled = true\n\tscope = createHotkeysScope()\n\tlabel = formatForDisplay('Mod+S')\n\n\tinit() {\n\t\tthis.scope.createHotkey('Mod+S', () => this.count++,\n\t\t\t() => ({ enabled: this.enabled }))\n\t}\n\n\tdestroy() {\n\t\tthis.scope.destroy()\n\t}\n}\n\nAlpine.data('editor', () => new Editor())\nAlpine.start()\n```\n\n```html\n<div x-data=\"editor\">\n\t<button type=\"button\" @click=\"enabled = !enabled\">Toggle shortcut</button>\n\t<p>Press <kbd x-text=\"label\"></kbd>. Saved <span x-text=\"count\"></span> times.</p>\n</div>\n```\n\nThe Alpine adapter runs in the browser. In an application with server rendering, load it only on the client. Load the module after the markup is available. Call `Alpine.start()` once in your application entry point.\n\nPress Command+S on macOS or Control+S on Windows and Linux. The count increases and the browser save dialog is prevented. The toggle disables execution while preserving the registration.\n\n`Mod` resolves to the primary platform modifier. Use `Mod+[KeyS]` instead when the shortcut must follow the physical S position.\n\n## Registration and cleanup\n\nCreate one scope for each Alpine component. Register shortcuts in `init()` so getters and callbacks read the reactive component instance. Call `scope.destroy()` from the component's `destroy()` method. Destruction releases registrations, effects, Store subscriptions, and active recorders. Do not reuse a destroyed scope.\n\nPass getters for bindings and options that can change. A value such as `{ enabled: this.enabled }` captures the value at registration time; `() => ({ enabled: this.enabled })` follows Alpine state. State readers return an object with a reactive `.value` getter. Read it in a template or an Alpine effect instead of destructuring it once.\n\n## Common patterns\n\n### Multiple hotkeys\n\n\n```ts\nthis.scope.createHotkey('Mod+S', () => console.log('Save'))\nthis.scope.createHotkey('Mod+Z', () => console.log('Undo'))\nthis.scope.createHotkey('Mod+Shift+Z', () => console.log('Redo'))\n```\n\nEach registration is independent. For a dynamic list, use `createHotkeys` as shown in the [hotkeys guide](./guides/hotkeys.md#registering-multiple-hotkeys).\n\n### Scoped hotkeys\n\nPass an actual element as `target`. A `null` target defers registration until the element exists. Make the element focusable with `tabindex=\"0\"`. See the [complete scoped example](./guides/hotkeys.md#target).\n\n### Conditional hotkeys\n\n\n```ts\nthis.scope.createHotkey('Mod+S', () => console.log(\"Save\"), () => ({ enabled: this.enabled }))\n```\n\nUse Alpine reactive state for the enabled flag.\n\n### Multi-key sequences\n\n\n```ts\nthis.scope.createHotkeySequence(['G', 'G'], () => window.scrollTo({ top: 0 }))\n```\n\nRelease G between presses. Automatic key repeats do not advance sequences.\n\n### Tracking held keys and displaying hints\n\n\n```ts\nimport Alpine from 'alpinejs'\nimport { createHotkeysScope } from '@tanstack/alpine-hotkeys'\n\nAlpine.data('keyStatus', () => {\n\tconst scope = createHotkeysScope()\n\treturn {\n\t\theld: scope.createHeldKeys(),\n\t\tcodes: scope.createHeldKeyCodes(),\n\t\tshift: scope.createKeyHold('Shift'),\n\t\thint: scope.createHotkeyHint('Mod+S'),\n\t\tdestroy() { scope.destroy() },\n\t}\n})\n```\n\n```html\n<div x-data=\"keyStatus\">\n\t<p x-text=\"held.value.join(' + ') || 'No keys held'\"></p>\n\t<template x-for=\"key in held.value\" :key=\"key\">\n\t\t<p x-text=\"key + ': ' + codes.value[key]\"></p>\n\t</template>\n\t<button type=\"button\" x-show=\"shift.value\">Delete permanently</button>\n\t<kbd x-show=\"hint.value\">Save</kbd>\n</div>\n```\n\nUse `formatForDisplay(binding)` for platform-specific labels. Keep the original binding in state; a display label is not a registration string.\n\n## Shared defaults\n\nPass defaults to `createHotkeysScope`. The scope accepts `hotkey`, `hotkeySequence`, `hotkeyRecorder`, and `hotkeySequenceRecorder` options. Pass a getter to follow Alpine state. Each component owns and destroys its scope. Call-specific options override scope defaults, and per-definition options override common options. Omitted options use the core defaults.\n\n```ts\nimport Alpine from 'alpinejs'\nimport { createHotkeysScope } from '@tanstack/alpine-hotkeys'\n\nAlpine.data('scopedEditor', () => {\n  const scope = createHotkeysScope({\n    hotkey: { requireReset: true },\n    hotkeySequence: { timeout: 1500 },\n    hotkeyRecorder: { ignoreInputs: false },\n    hotkeySequenceRecorder: { idleTimeoutMs: 2000 },\n  })\n  return {\n    init() {\n      scope.createHotkey('Mod+S', () => console.log('Saved'))\n      scope.createHotkey('ArrowRight', () => console.log('Next'), { requireReset: false })\n    },\n    destroy() { scope.destroy() },\n  }\n})\n```\n\nFor changing defaults, create the scope in `init()` with `createHotkeysScope(() => ({ hotkey: { enabled: this.enabled } }))`. Creating the getter in `init()` makes `this` refer to Alpine's reactive component instance. Share a defaults object or getter between components when they need the same policy; give each component its own scope for cleanup. The `$hotkeys` magic uses core defaults, so use an explicit scope when supplying shared defaults.\n\n## Optional Alpine magic\n\nInstall `hotkeysPlugin` before `Alpine.start()` to get an element-owned `$hotkeys` scope:\n\n```ts\nimport Alpine from 'alpinejs'\nimport { hotkeysPlugin } from '@tanstack/alpine-hotkeys'\n\nAlpine.plugin(hotkeysPlugin)\nAlpine.start()\n```\n\n```html\n<div x-data=\"{ count: 0 }\" x-init=\"$hotkeys.createHotkey('Mod+S', () => count++)\">\n\t<span x-text=\"count\"></span>\n</div>\n```\n\nThe plugin destroys that scope when Alpine destroys the owning element. Choose an explicit scope or the magic for a registration; using both registers it twice.\n\n## Examples and next steps\n\n- [Hotkeys](./guides/hotkeys)\n- [Sequences](./guides/sequences)\n- [Hotkey recording](./guides/hotkey-recording)\n- [Sequence recording](./guides/sequence-recording)\n- [Key state tracking](./guides/key-state-tracking)\n- [Formatting and display](./guides/formatting-display)\n- [Kitchen sink](./examples/kitchen-sink)\n- [API reference](./reference/index)\n"}
