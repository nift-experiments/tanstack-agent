":"On a class-based helper, it may be useful to force a recomputation of that\nhelpers value. This is akin to "},{"type":"inlineCode","value":"rerender"},{"type":"text","value":" on a component."}]},{"type":"paragraph","children":[{"type":"text","value":"In most cases, "},{"type":"inlineCode","value":"recompute"},{"type":"text","value":" is not needed because accessing tracked\nproperties in "},{"type":"inlineCode","value":"compute"},{"type":"text","value":" will automatically re-run the helper when\nthose properties change. Use "},{"type":"inlineCode","value":"recompute"},{"type":"text","value":" only when you need to\ntrigger a recomputation imperatively, for example in response to an\nexternal event:"}]},{"type":"code","value":"import Helper from '@ember/component/helper';\n\nexport default class CurrentTimeHelper extends Helper {\n  interval = null;\n\n  compute() {\n    return new Date().toLocaleTimeString();\n  }\n\n  constructor() {\n    super(...arguments);\n    this.interval = setInterval(() => this.recompute(), 1000);\n  }\n\n  willDestroy() {\n    super.willDestroy();\n    clearInterval(this.interval);\n  }\n}","lang":"app","meta":"/helpers/current-time.js"},{"type":"heading","depth":4,"id":"returns-28","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"method-15","children":[{"type":"text","value":"Method"}]},{"type":"paragraph","children":[{"type":"text","value":"recompute"}]},{"type":"heading","depth":4,"id":"since-4","children":[{"type":"text","value":"Since"}]},{"type":"paragraph","children":[{"type":"text","value":"1.13.0"}]},{"type":"heading","depth":4,"id":"inherited-from-39","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"Helper.recompute","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"removeobserver","children":[{"type":"text","value":"removeObserver()"}]},{"type":"heading","depth":4,"id":"