d be prepared to handle that."}]},{"type":"paragraph","children":[{"type":"text","value":"There are two common invocation patterns for "},{"type":"inlineCode","value":".addObserver()"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Passing two arguments:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the name of the property to observe (as a string)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the function to invoke (an actual function)"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Passing three arguments:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the name of the property to observe (as a string)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the target object (will be used to look up and invoke a\nfunction on)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the name of the function to invoke on the target object\n(as a string)."}]}]}]}]}]},{"type":"code","value":"import Component from '@ember/component';\n\nexport default Component.extend({\n  init() {\n    this._super(...arguments);\n\n    // the following are equivalent:\n\n    // using three arguments\n    this.addObserver('foo', this, 'fooDidChange');\n\n    // using two arguments\n    this.addObserver('foo', (...args) => {\n      this.fooDidChange(...args);\n    });\n  },\n\n  fooDidChange() {\n    // your custom logic code\n  }\n});","lang":"app","meta":"/components/my-component.js"},{"type":"heading","depth":3,"id":"observer-methods","children":[{"type":"text","value":"Observer Methods"}]},{"type":"paragraph","children":[{"type":"text","value":"Observer methods have the following signature:"}]},{"type":"code","value":"import Component from '@ember/component';\n\nexport default Component.extend({\n  init() {\n    this._super(...arguments);\n    this.addObserver('foo', this, 'fooDidChange');\n  },\n\n  fooDidChange(sender, key, value, rev) {\n    // your code\n  }\n});","lang":"app","meta":"/components/my-component.js"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"sender"},{"type":"text","value":" is the object that changed. The "},{"type":"inlineCode","value":"key"},{"type":"text","value":" is the property that\nchanges. The "},{"type":"inlineCode","value":"value"},{"type":"text","value":" property is currently reserved and unused. The "},{"type":"inlineCode","value":"rev"},{"type":"text","value":"\nis the last property revision of the object when it changed, which you can\nuse to detect if the key value has really changed or not."}]},{"type":"paragraph","children":[{"type":"text","value":"Usually you will not need the value or revision parameters at\nthe end. In this case, it is common to write observer methods that take\nonly a sender and key value as parameters or, if you aren't interested in\nany of these values, to write an observer that has no parameters at all."}]},{"type":"paragraph","children":[{"type":"text","value":"While observers are still supported, there are "},{"type":"link","href":"https://github.com/emberjs/rfcs/pull/1115","children":[{"type":"text","value":"plans to deprecate them"}]},{"type":"text","value":"\nSee the "},{"type":"link","href":"https://github.com/ember-learn/deprecation-app/pull/1407","children":[{"type":"text","value":"in-progress deprecation guide"}]},{"type":"text","value":"\nfor guidance on how to avoid using observers."}]},{"type":"heading","depth":5,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":6,"id":"target","children":[{"type":"text","value":"Target"}]},{"