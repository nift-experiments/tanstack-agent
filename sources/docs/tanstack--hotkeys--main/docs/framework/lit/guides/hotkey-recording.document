title: Hotkey Recording Guide
id: hotkey-recording
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack Hotkeys provides the "},{"type":"inlineCode","value":"HotkeyRecorderController"},{"type":"text","value":" for building keyboard shortcut customization UIs. This lets users record their own shortcuts by pressing the desired key combination, similar to how system preferences or IDE shortcut editors work."}]},{"type":"paragraph","children":[{"type":"text","value":"Recorders default to physical codes: recording a shortcut stores a string such as "},{"type":"inlineCode","value":"Mod+[KeyS]"},{"type":"text","value":". Pass it directly to your hotkey registration and use "},{"type":"inlineCode","value":"formatForDisplay"},{"type":"text","value":" for the label. Set "},{"type":"inlineCode","value":"recordBy: 'key'"},{"type":"text","value":" when you intentionally want the produced character instead."}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Hotkeys automatically suppresses registered hotkey and sequence callbacks while any recorder is active. You do not need to set "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" from "},{"type":"inlineCode","value":"isRecording"},{"type":"text","value":". Registrations remain available for conflict detection, and recorded keys stay suppressed through repeats and key release."}]},{"type":"heading","depth":2,"id":"reactive-options","children":[{"type":"text","value":"Reactive options"}]},{"type":"paragraph","children":[{"type":"text","value":"Recorder options support "},{"type":"link","href":"./hotkeys.md#property-getters","children":[{"type":"text","value":"property getters and functions returning options"}]},{"type":"text","value":". Updated callbacks, validation, and recording settings apply during an active session without restarting it. Recorder controls read current options directly. Explicit "},{"type":"inlineCode","value":"setOptions"},{"type":"text","value":" values override constructor options for the supplied keys; other getters stay live."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic usage"}]},{"type":"code","value":"import { LitElement, html, nothing } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { HotkeyRecorderController, formatForDisplay } from '@tanstack/lit-hotkeys'\n\n@customElement('shortcut-recorder')\nclass ShortcutRecorder extends LitElement {\n  private recorder = new HotkeyRecorderController(this, {\n    onRecord: (hotkey) => {\n      console.log('Recorded:', hotkey) // e.g., \"Mod+Shift+[KeyS]\"\n    },\n  })\n\n  render() {\n    const { isRecording, recordedHotkey } = this.recorder\n    return html`\n      <div>\n        <button\n          @click=${() =>\n            isRecording\n              ? this.recorder.stopRecording()\n              : this.recorder.startRecording()}\n        >\n          ${isRecording\n            ? 'Press a key combination...'\n            : recordedHotkey\n              ? formatForDisplay(recordedHotkey)\n              : 'Click to record'}\n        </button>\n        ${isRecording\n          ? html`<button @click=${() => this.recorder.cancelRecording()}>\n              Cancel\n            </button>`\n          : nothing}\n      </div>\n    `\n  }\n}","lang":"ts"},{"type":"heading","depth":2,"id":"controller-api","children":[{"type":"text","value":"Controller API"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"HotkeyRecorderController"},{"type":"text","value":" exposes the following reactive getters and methods:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Member"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"isRecording"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"},{"type":"text","value":" (getter)"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether the recorder is currently listening for key presses"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"recordedHotkey"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Hotkey | null"},{"type":"text","value":" (getter)"}]},{"type":"tableCell","children":[{"type":"text","value":"The last recorded hotkey string, or "},{"type":"inlineCode","value":"null"},{"type":"text","value":" if nothing recorded"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"startRecording()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Start listening for key presses"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stopRecording()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Stop listening and reset recorder state without calling "},{"type":"inlineCode","value":"onRecord"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"cancelRecording()"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Stop listening and discard any recorded hotkey"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"setOptions(opts)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"(Partial<HotkeyRecorderOptions>) => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Update callbacks at runtime"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"The controller registers itself with the host in its constructor, subscribes to the underlying "},{"type":"inlineCode","value":"HotkeyRecorder"},{"type":"text","value":" store on "},{"type":"inlineCode","value":"hostConnected"},{"type":"text","value":", and cleans up on "},{"type":"inlineCode","value":"hostDisconnected"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"heading","depth":3,"id":"recordby","children":[{"type":"inlineCode","value":"recordBy"}]},{"type":"paragraph","children":[{"type":"text","value":"Recorders default to "},{"type":"inlineCode","value":"recordBy: 'code'"},{"type":"text","value":". Option+S producing "},{"type":"inlineCode","value":"ß"},{"type":"text","value":" on macOS records "},{"type":"inlineCode","value":"Alt+[KeyS]"},{"type":"text","value":"; Option+2 producing "},{"type":"inlineCode","value":"™"},{"type":"text","value":" records "},{"type":"inlineCode","value":"Alt+[Digit2]"},{"type":"text","value":". The stored brackets preserve physical identity through state, serialization, and registration; "},{"type":"inlineCode","value":"formatForDisplay"},{"type":"text","value":" produces a readable label. There is no code-to-letter conversion. Existing authored strings such as "},{"type":"inlineCode","value":"Mod+S"},{"type":"text","value":" remain logical bindings."}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"recordBy: 'key'"},{"type":"text","value":" to intentionally record the produced logical character. A code-mode event with no usable code is rejected rather than silently switching modes. IME composition is ignored. AltGraph character entry is rejected in code mode; key mode preserves the produced character without synthetic Control/Alt while retaining Shift. Recording events, repeats, and their releases do not trigger registered hotkeys or sequences."}]},{"type":"paragraph","children":[{"type":"text","value":"Pass options as the second argument to the constructor:"}]},{"type":"code","value":"new HotkeyRecorderController(this, {\n  recordBy: 'code', // default; choose 'key' for logical characters\n  onRecord: (hotkey) => { /* called when a hotkey is recorded */ },\n  onCancel: () => { /* called when recording is cancelled */ },\n  onClear: () => { /* called when the recorded hotkey is cleared */ },\n})","lang":"ts"},{"type":"heading","depth":3,"id":"onrecord","children":[{"type":"inlineCode","value":"onRecord"}]},{"type":"paragraph","children":[{"type":"text","value":"Called when the user presses a valid key combination (a modifier + a non-modifier key, or a single non-modifier key). Receives the recorded "},{"type":"inlineCode","value":"Hotkey"},{"type":"text","value":" string."}]},{"type":"heading","depth":3,"id":"oncancel","children":[{"type":"inlineCode","value":"onCancel"}]},{"type":"paragraph","children":[{"type":"text","value":"Called when recording is cancelled (either by pressing Escape or calling "},{"type":"inlineCode","value":"cancelRecording()"},{"type":"text","value":")."}]},{"type":"heading","depth":3,"id":"onclear","children":[{"type":"inlineCode","value":"onClear"}]},{"type":"paragraph","children":[{"type":"text","value":"Called when the recorded hotkey is cleared (by pressing Backspace or Delete during recording)."}]},{"type":"heading","depth":2,"id":"recording-behavior","children":[{"type":"text","value":"Recording behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"The recorder has specific behavior for different keys:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Key"}]},{"type":"tableCell","children":[{"type":"text","value":"Behavior"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Modifier only (Shift, Ctrl, etc.)"}]},{"type":"tableCell","children":[{"type":"text","value":"Waits for a non-modifier key; modifier-only presses don't complete a recording"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Modifier + key (e.g., Ctrl+S)"}]},{"type":"tableCell","children":[{"type":"text","value":"Records the full combination"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Single key (e.g., Escape, F1)"}]},{"type":"tableCell","children":[{"type":"text","value":"Records the single key"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Escape"}]},{"type":"tableCell","children":[{"type":"text","value":"Cancels the recording"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Backspace / Delete"}]},{"type":"tableCell","children":[{"type":"text","value":"Clears the currently recorded hotkey"}]}]]},{"type":"heading","depth":3,"id":"ignoreinputs","children":[{"type":"inlineCode","value":"ignoreInputs"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"HotkeyRecorderOptions"},{"type":"text","value":" supports an "},{"type":"inlineCode","value":"ignoreInputs"},{"type":"text","value":" option (defaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":"). When "},{"type":"inlineCode","value":"true"},{"type":"text","value":", the recorder doesn't intercept normal typing in text inputs, textareas, selects, or contentEditable elements. Keystrokes pass through to the input as usual. Pressing Escape still cancels recording even when focused on an input. Set "},{"type":"inlineCode","value":"ignoreInputs: false"},{"type":"text","value":" if you want the recorder to capture keys from within input elements."}]},{"type":"code","value":"new HotkeyRecorderController(this, {\n  ignoreInputs: false, // record even from inside inputs\n  onRecord: (hotkey) => console.log(hotkey),\n})","lang":"ts"},{"type":"heading","depth":3,"id":"mod-auto-conversion","children":[{"type":"text","value":"Mod auto-conversion"}]},{"type":"paragraph","children":[{"type":"text","value":"Recorded hotkeys automatically use the portable "},{"type":"inlineCode","value":"Mod"},{"type":"text","value":" format. If a user on macOS presses Command+S, the recorded hotkey is "},{"type":"inlineCode","value":"Mod+[KeyS]"},{"type":"text","value":" rather than "},{"type":"inlineCode","value":"Meta+[KeyS]"},{"type":"text","value":", so the shortcut keeps working when it syncs to a machine on another OS."}]},{"type":"heading","depth":2,"id":"validation-and-conflicts","children":[{"type":"text","value":"Validation and conflicts"}]},{"type":"paragraph","children":[{"type":"text","value":"Both recorder APIs accept "},{"type":"inlineCode","value":"detectConflicts"},{"type":"text","value":", "},{"type":"inlineCode","value":"validate"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onReject"},{"type":"text","value":". For a single-hotkey recorder, these options can be supplied alongside "},{"type":"inlineCode","value":"onRecord"},{"type":"text","value":":"}]},{"type":"code","value":"const options = {\n  detectConflicts: {\n    // Use registration IDs to exclude the binding being edited:\n    excludeIds: [registrationId],\n    target: document,\n    eventType: 'keydown',\n  },\n  validate: (_hotkey, { parsedHotkey }) =>\n    parsedHotkey.modifiers.length > 0 || 'Include a modifier.',\n  onReject: ({ reason, message, conflicts }) => {\n    // Show feedback; recording stays active.\n    console.log(reason, message, conflicts)\n  },\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"validate"},{"type":"text","value":" returns true to accept, or false/a message to reject. "},{"type":"inlineCode","value":"onReject"},{"type":"text","value":" receives "},{"type":"inlineCode","value":"reason"},{"type":"text","value":" ("},{"type":"inlineCode","value":"missing-code"},{"type":"text","value":", "},{"type":"inlineCode","value":"alt-graph"},{"type":"text","value":", "},{"type":"inlineCode","value":"invalid"},{"type":"text","value":", "},{"type":"inlineCode","value":"validation"},{"type":"text","value":", or "},{"type":"inlineCode","value":"conflict"},{"type":"text","value":"), a message, the candidate when available, and conflicting registration views for conflict rejections. Validation runs before commit; rejection never falls back to another key identity."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"detectConflicts: true"},{"type":"text","value":" checks enabled live registrations with the intended event type (default keydown) and overlapping targets (default document). Document/nested scopes can conflict; disjoint widgets can reuse a binding. The options object also supports "},{"type":"inlineCode","value":"scope: 'all'"},{"type":"text","value":", "},{"type":"inlineCode","value":"includeDisabled"},{"type":"text","value":", and an "},{"type":"inlineCode","value":"exclude(registration)"},{"type":"text","value":" predicate. Both single bindings and sequence prefixes are checked. Source events detect physical/logical overlap on the recorded layout. This is a conservative collision check, not a promise that two callbacks will execute: propagation, input filtering, match priority, external listeners, unmounted routes, and other layouts can affect actual dispatch."}]},{"type":"paragraph","children":[{"type":"text","value":"For checks outside recording, use "},{"type":"inlineCode","value":"findHotkeyConflicts(bindingOrSequence, options)"},{"type":"text","value":". Without source "},{"type":"inlineCode","value":"events"},{"type":"text","value":", it compares binding identity and sequence prefixes; it does not guess equivalence between a logical character and a physical position."}]},{"type":"heading","depth":2,"id":"building-a-shortcut-settings-ui","children":[{"type":"text","value":"Building a shortcut settings UI"}]},{"type":"paragraph","children":[{"type":"text","value":"Here's a more complete example of a shortcut customization panel:"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { customElement, state } from 'lit/decorators.js'\nimport {\n  HotkeyRecorderController,\n  HotkeyController,\n  formatForDisplay,\n} from '@tanstack/lit-hotkeys'\nimport type { Hotkey } from '@tanstack/lit-hotkeys'\n\ninterface ShortcutMap {\n  save: Hotkey\n  undo: Hotkey\n  search: Hotkey\n}\n\n@customElement('shortcut-settings')\nclass ShortcutSettings extends LitElement {\n  @state() private shortcuts: ShortcutMap = {\n    save: 'Mod+S',\n    undo: 'Mod+Z',\n    search: 'Mod+K',\n  }\n\n  @state() private editingAction: keyof ShortcutMap | null = null\n\n  private recorder = new HotkeyRecorderController(this, {\n    onRecord: (hotkey) => {\n      if (this.editingAction) {\n        this.shortcuts = { ...this.shortcuts, [this.editingAction]: hotkey }\n        this.editingAction = null\n      }\n    },\n    onCancel: () => {\n      this.editingAction = null\n    },\n  })\n\n  private saveCtrl?: HotkeyController\n  private undoCtrl?: HotkeyController\n  private searchCtrl?: HotkeyController\n\n  connectedCallback() {\n    super.connectedCallback()\n    this._registerHotkeys()\n  }\n\n  updated() {\n    this._unregisterHotkeys()\n    this._registerHotkeys()\n  }\n\n  private _registerHotkeys() {\n    this.saveCtrl = new HotkeyController(this, this.shortcuts.save, () => save())\n    this.undoCtrl = new HotkeyController(this, this.shortcuts.undo, () => undo())\n    this.searchCtrl = new HotkeyController(this, this.shortcuts.search, () => openSearch())\n  }\n\n  private _unregisterHotkeys() {\n    this.saveCtrl?.hostDisconnected()\n    this.undoCtrl?.hostDisconnected()\n    this.searchCtrl?.hostDisconnected()\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback()\n    this._unregisterHotkeys()\n  }\n\n  render() {\n    return html`\n      <div>\n        <h2>Keyboard Shortcuts</h2>\n        ${(Object.entries(this.shortcuts) as Array<[keyof ShortcutMap, Hotkey]>).map(\n          ([action, hotkey]) => html`\n            <div>\n              <span>${action}</span>\n              <button\n                @click=${() => {\n                  this.editingAction = action\n                  this.recorder.startRecording()\n                }}\n              >\n                ${this.editingAction === action && this.recorder.isRecording\n                  ? 'Press keys...'\n                  : formatForDisplay(hotkey)}\n              </button>\n            </div>\n          `,\n        )}\n      </div>\n    `\n  }\n}","lang":"ts"},{"type":"heading","depth":2,"id":"under-the-hood","children":[{"type":"text","value":"Under the hood"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"HotkeyRecorderController"},{"type":"text","value":" creates a "},{"type":"inlineCode","value":"HotkeyRecorder"},{"type":"text","value":" class instance and subscribes to its reactive state via the recorder's TanStack Store. The class manages its own keyboard event listeners and state, and the controller handles cleanup on disconnect."}]}],"headings":[{"id":"reactive-options","text":"Reactive options","level":2},{"id":"basic-usage","text":"Basic usage","level":2},{"id":"controller-api","text":"Controller API","level":2},{"id":"options","text":"Options","level":2},{"id":"recordby","text":"recordBy","level":3},{"id":"onrecord","text":"onRecord","level":3},{"id":"oncancel","text":"onCancel","level":3},{"id":"onclear","text":"onClear","level":3},{"id":"recording-behavior","text":"Recording behavior","level":2},{"id":"ignoreinputs","text":"ignoreInputs","level":3},{"id":"mod-auto-conversion","text":"Mod auto-conversion","level":3},{"id":"validation-and-conflicts","text":"Validation and conflicts","level":2},{"id":"building-a-shortcut-settings-ui","text":"Building a shortcut settings UI","level":2},{"id":"under-the-hood","text":"Under the hood","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Hotkeys provides the `HotkeyRecorderController` for building keyboard shortcut customization UIs. This lets users record their own shortcuts by pressing the desired key combination, similar to how system preferences or IDE shortcut editors work.\n\nRecorders default to physical codes: recording a shortcut stores a string such as `Mod+[KeyS]`. Pass it directly to your hotkey registration and use `formatForDisplay` for the label. Set `recordBy: 'key'` when you intentionally want the produced character instead.\n\nTanStack Hotkeys automatically suppresses registered hotkey and sequence callbacks while any recorder is active. You do not need to set `enabled` from `isRecording`. Registrations remain available for conflict detection, and recorded keys stay suppressed through repeats and key release.\n\n## Reactive options\n\nRecorder options support [property getters and functions returning options](./hotkeys.md#property-getters). Updated callbacks, validation, and recording settings apply during an active session without restarting it. Recorder controls read current options directly. Explicit `setOptions` values override constructor options for the supplied keys; other getters stay live.\n\n## Basic usage\n\n```ts\nimport { LitElement, html, nothing } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { HotkeyRecorderController, formatForDisplay } from '@tanstack/lit-hotkeys'\n\n@customElement('shortcut-recorder')\nclass ShortcutRecorder extends LitElement {\n  private recorder = new HotkeyRecorderController(this, {\n    onRecord: (hotkey) => {\n      console.log('Recorded:', hotkey) // e.g., \"Mod+Shift+[KeyS]\"\n    },\n  })\n\n  render() {\n    const { isRecording, recordedHotkey } = this.recorder\n    return html`\n      <div>\n        <button\n          @click=${() =>\n            isRecording\n              ? this.recorder.stopRecording()\n              : this.recorder.startRecording()}\n        >\n          ${isRecording\n            ? 'Press a key combination...'\n            : recordedHotkey\n              ? formatForDisplay(recordedHotkey)\n              : 'Click to record'}\n        </button>\n        ${isRecording\n          ? html`<button @click=${() => this.recorder.cancelRecording()}>\n              Cancel\n            </button>`\n          : nothing}\n      </div>\n    `\n  }\n}\n```\n\n## Controller API\n\n`HotkeyRecorderController` exposes the following reactive getters and methods:\n\n| Member | Type | Description |\n|--------|------|-------------|\n| `isRecording` | `boolean` (getter) | Whether the recorder is currently listening for key presses |\n| `recordedHotkey` | `Hotkey \\| null` (getter) | The last recorded hotkey string, or `null` if nothing recorded |\n| `startRecording()` | `() => void` | Start listening for key presses |\n| `stopRecording()` | `() => void` | Stop listening and reset recorder state without calling `onRecord` |\n| `cancelRecording()` | `() => void` | Stop listening and discard any recorded hotkey |\n| `setOptions(opts)` | `(Partial<HotkeyRecorderOptions>) => void` | Update callbacks at runtime |\n\nThe controller registers itself with the host in its constructor, subscribes to the underlying `HotkeyRecorder` store on `hostConnected`, and cleans up on `hostDisconnected`.\n\n## Options\n\n### `recordBy`\n\nRecorders default to `recordBy: 'code'`. Option+S producing `ß` on macOS records `Alt+[KeyS]`; Option+2 producing `™` records `Alt+[Digit2]`. The stored brackets preserve physical identity through state, serialization, and registration; `formatForDisplay` produces a readable label. There is no code-to-letter conversion. Existing authored strings such as `Mod+S` remain logical bindings.\n\nSet `recordBy: 'key'` to intentionally record the produced logical character. A code-mode event with no usable code is rejected rather than silently switching modes. IME composition is ignored. AltGraph character entry is rejected in code mode; key mode preserves the produced character without synthetic Control/Alt while retaining Shift. Recording events, repeats, and their releases do not trigger registered hotkeys or sequences.\n\nPass options as the second argument to the constructor:\n\n```ts\nnew HotkeyRecorderController(this, {\n  recordBy: 'code', // default; choose 'key' for logical characters\n  onRecord: (hotkey) => { /* called when a hotkey is recorded */ },\n  onCancel: () => { /* called when recording is cancelled */ },\n  onClear: () => { /* called when the recorded hotkey is cleared */ },\n})\n```\n\n### `onRecord`\n\nCalled when the user presses a valid key combination (a modifier + a non-modifier key, or a single non-modifier key). Receives the recorded `Hotkey` string.\n\n### `onCancel`\n\nCalled when recording is cancelled (either by pressing Escape or calling `cancelRecording()`).\n\n### `onClear`\n\nCalled when the recorded hotkey is cleared (by pressing Backspace or Delete during recording).\n\n## Recording behavior\n\nThe recorder has specific behavior for different keys:\n\n| Key | Behavior |\n|-----|----------|\n| Modifier only (Shift, Ctrl, etc.) | Waits for a non-modifier key; modifier-only presses don't complete a recording |\n| Modifier + key (e.g., Ctrl+S) | Records the full combination |\n| Single key (e.g., Escape, F1) | Records the single key |\n| Escape | Cancels the recording |\n| Backspace / Delete | Clears the currently recorded hotkey |\n\n### `ignoreInputs`\n\nThe `HotkeyRecorderOptions` supports an `ignoreInputs` option (defaults to `true`). When `true`, the recorder doesn't intercept normal typing in text inputs, textareas, selects, or contentEditable elements. Keystrokes pass through to the input as usual. Pressing Escape still cancels recording even when focused on an input. Set `ignoreInputs: false` if you want the recorder to capture keys from within input elements.\n\n```ts\nnew HotkeyRecorderController(this, {\n  ignoreInputs: false, // record even from inside inputs\n  onRecord: (hotkey) => console.log(hotkey),\n})\n```\n\n### Mod auto-conversion\n\nRecorded hotkeys automatically use the portable `Mod` format. If a user on macOS presses Command+S, the recorded hotkey is `Mod+[KeyS]` rather than `Meta+[KeyS]`, so the shortcut keeps working when it syncs to a machine on another OS.\n\n## Validation and conflicts\n\nBoth recorder APIs accept `detectConflicts`, `validate`, and `onReject`. For a single-hotkey recorder, these options can be supplied alongside `onRecord`:\n\n```ts\nconst options = {\n  detectConflicts: {\n    // Use registration IDs to exclude the binding being edited:\n    excludeIds: [registrationId],\n    target: document,\n    eventType: 'keydown',\n  },\n  validate: (_hotkey, { parsedHotkey }) =>\n    parsedHotkey.modifiers.length > 0 || 'Include a modifier.',\n  onReject: ({ reason, message, conflicts }) => {\n    // Show feedback; recording stays active.\n    console.log(reason, message, conflicts)\n  },\n}\n```\n\n`validate` returns true to accept, or false/a message to reject. `onReject` receives `reason` (`missing-code`, `alt-graph`, `invalid`, `validation`, or `conflict`), a message, the candidate when available, and conflicting registration views for conflict rejections. Validation runs before commit; rejection never falls back to another key identity.\n\n`detectConflicts: true` checks enabled live registrations with the intended event type (default keydown) and overlapping targets (default document). Document/nested scopes can conflict; disjoint widgets can reuse a binding. The options object also supports `scope: 'all'`, `includeDisabled`, and an `exclude(registration)` predicate. Both single bindings and sequence prefixes are checked. Source events detect physical/logical overlap on the recorded layout. This is a conservative collision check, not a promise that two callbacks will execute: propagation, input filtering, match priority, external listeners, unmounted routes, and other layouts can affect actual dispatch.\n\nFor checks outside recording, use `findHotkeyConflicts(bindingOrSequence, options)`. Without source `events`, it compares binding identity and sequence prefixes; it does not guess equivalence between a logical character and a physical position.\n\n## Building a shortcut settings UI\n\nHere's a more complete example of a shortcut customization panel:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement, state } from 'lit/decorators.js'\nimport {\n  HotkeyRecorderController,\n  HotkeyController,\n  formatForDisplay,\n} from '@tanstack/lit-hotkeys'\nimport type { Hotkey } from '@tanstack/lit-hotkeys'\n\ninterface ShortcutMap {\n  save: Hotkey\n  undo: Hotkey\n  search: Hotkey\n}\n\n@customElement('shortcut-settings')\nclass ShortcutSettings extends LitElement {\n  @state() private shortcuts: ShortcutMap = {\n    save: 'Mod+S',\n    undo: 'Mod+Z',\n    search: 'Mod+K',\n  }\n\n  @state() private editingAction: keyof ShortcutMap | null = null\n\n  private recorder = new HotkeyRecorderController(this, {\n    onRecord: (hotkey) => {\n      if (this.editingAction) {\n        this.shortcuts = { ...this.shortcuts, [this.editingAction]: hotkey }\n        this.editingAction = null\n      }\n    },\n    onCancel: () => {\n      this.editingAction = null\n    },\n  })\n\n  private saveCtrl?: HotkeyController\n  private undoCtrl?: HotkeyController\n  private searchCtrl?: HotkeyController\n\n  connectedCallback() {\n    super.connectedCallback()\n    this._registerHotkeys()\n  }\n\n  updated() {\n    this._unregisterHotkeys()\n    this._registerHotkeys()\n  }\n\n  private _registerHotkeys() {\n    this.saveCtrl = new HotkeyController(this, this.shortcuts.save, () => save())\n    this.undoCtrl = new HotkeyController(this, this.shortcuts.undo, () => undo())\n    this.searchCtrl = new HotkeyController(this, this.shortcuts.search, () => openSearch())\n  }\n\n  private _unregisterHotkeys() {\n    this.saveCtrl?.hostDisconnected()\n    this.undoCtrl?.hostDisconnected()\n    this.searchCtrl?.hostDisconnected()\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback()\n    this._unregisterHotkeys()\n  }\n\n  render() {\n    return html`\n      <div>\n        <h2>Keyboard Shortcuts</h2>\n        ${(Object.entries(this.shortcuts) as Array<[keyof ShortcutMap, Hotkey]>).map(\n          ([action, hotkey]) => html`\n            <div>\n              <span>${action}</span>\n              <button\n                @click=${() => {\n                  this.editingAction = action\n                  this.recorder.startRecording()\n                }}\n              >\n                ${this.editingAction === action && this.recorder.isRecording\n                  ? 'Press keys...'\n                  : formatForDisplay(hotkey)}\n              </button>\n            </div>\n          `,\n        )}\n      </div>\n    `\n  }\n}\n```\n\n## Under the hood\n\nThe `HotkeyRecorderController` creates a `HotkeyRecorder` class instance and subscribes to its reactive state via the recorder's TanStack Store. The class manages its own keyboard event listeners and state, and the controller handles cleanup on disconnect.\n","originalRawMarkdown":"---\ntitle: Hotkey Recording Guide\nid: hotkey-recording\n---\n\nTanStack Hotkeys provides the `HotkeyRecorderController` for building keyboard shortcut customization UIs. This lets users record their own shortcuts by pressing the desired key combination, similar to how system preferences or IDE shortcut editors work.\n\nRecorders default to physical codes: recording a shortcut stores a string such as `Mod+[KeyS]`. Pass it directly to your hotkey registration and use `formatForDisplay` for the label. Set `recordBy: 'key'` when you intentionally want the produced character instead.\n\nTanStack Hotkeys automatically suppresses registered hotkey and sequence callbacks while any recorder is active. You do not need to set `enabled` from `isRecording`. Registrations remain available for conflict detection, and recorded keys stay suppressed through repeats and key release.\n\n## Reactive options\n\nRecorder options support [property getters and functions returning options](./hotkeys.md#property-getters). Updated callbacks, validation, and recording settings apply during an active session without restarting it. Recorder controls read current options directly. Explicit `setOptions` values override constructor options for the supplied keys; other getters stay live.\n\n## Basic usage\n\n```ts\nimport { LitElement, html, nothing } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { HotkeyRecorderController, formatForDisplay } from '@tanstack/lit-hotkeys'\n\n@customElement('shortcut-recorder')\nclass ShortcutRecorder extends LitElement {\n  private recorder = new HotkeyRecorderController(this, {\n    onRecord: (hotkey) => {\n      console.log('Recorded:', hotkey) // e.g., \"Mod+Shift+[KeyS]\"\n    },\n  })\n\n  render() {\n    const { isRecording, recordedHotkey } = this.recorder\n    return html`\n      <div>\n        <button\n          @click=${() =>\n            isRecording\n              ? this.recorder.stopRecording()\n              : this.recorder.startRecording()}\n        >\n          ${isRecording\n            ? 'Press a key combination...'\n            : recordedHotkey\n              ? formatForDisplay(recordedHotkey)\n              : 'Click to record'}\n        </button>\n        ${isRecording\n          ? html`<button @click=${() => this.recorder.cancelRecording()}>\n              Cancel\n            </button>`\n          : nothing}\n      </div>\n    `\n  }\n}\n```\n\n## Controller API\n\n`HotkeyRecorderController` exposes the following reactive getters and methods:\n\n| Member | Type | Description |\n|--------|------|-------------|\n| `isRecording` | `boolean` (getter) | Whether the recorder is currently listening for key presses |\n| `recordedHotkey` | `Hotkey \\| null` (getter) | The last recorded hotkey string, or `null` if nothing recorded |\n| `startRecording()` | `() => void` | Start listening for key presses |\n| `stopRecording()` | `() => void` | Stop listening and reset recorder state without calling `onRecord` |\n| `cancelRecording()` | `() => void` | Stop listening and discard any recorded hotkey |\n| `setOptions(opts)` | `(Partial<HotkeyRecorderOptions>) => void` | Update callbacks at runtime |\n\nThe controller registers itself with the host in its constructor, subscribes to the underlying `HotkeyRecorder` store on `hostConnected`, and cleans up on `hostDisconnected`.\n\n## Options\n\n### `recordBy`\n\nRecorders default to `recordBy: 'code'`. Option+S producing `ß` on macOS records `Alt+[KeyS]`; Option+2 producing `™` records `Alt+[Digit2]`. The stored brackets preserve physical identity through state, serialization, and registration; `formatForDisplay` produces a readable label. There is no code-to-letter conversion. Existing authored strings such as `Mod+S` remain logical bindings.\n\nSet `recordBy: 'key'` to intentionally record the produced logical character. A code-mode event with no usable code is rejected rather than silently switching modes. IME composition is ignored. AltGraph character entry is rejected in code mode; key mode preserves the produced character without synthetic Control/Alt while retaining Shift. Recording events, repeats, and their releases do not trigger registered hotkeys or sequences.\n\nPass options as the second argument to the constructor:\n\n```ts\nnew HotkeyRecorderController(this, {\n  recordBy: 'code', // default; choose 'key' for logical characters\n  onRecord: (hotkey) => { /* called when a hotkey is recorded */ },\n  onCancel: () => { /* called when recording is cancelled */ },\n  onClear: () => { /* called when the recorded hotkey is cleared */ },\n})\n```\n\n### `onRecord`\n\nCalled when the user presses a valid key combination (a modifier + a non-modifier key, or a single non-modifier key). Receives the recorded `Hotkey` string.\n\n### `onCancel`\n\nCalled when recording is cancelled (either by pressing Escape or calling `cancelRecording()`).\n\n### `onClear`\n\nCalled when the recorded hotkey is cleared (by pressing Backspace or Delete during recording).\n\n## Recording behavior\n\nThe recorder has specific behavior for different keys:\n\n| Key | Behavior |\n|-----|----------|\n| Modifier only (Shift, Ctrl, etc.) | Waits for a non-modifier key; modifier-only presses don't complete a recording |\n| Modifier + key (e.g., Ctrl+S) | Records the full combination |\n| Single key (e.g., Escape, F1) | Records the single key |\n| Escape | Cancels the recording |\n| Backspace / Delete | Clears the currently recorded hotkey |\n\n### `ignoreInputs`\n\nThe `HotkeyRecorderOptions` supports an `ignoreInputs` option (defaults to `true`). When `true`, the recorder doesn't intercept normal typing in text inputs, textareas, selects, or contentEditable elements. Keystrokes pass through to the input as usual. Pressing Escape still cancels recording even when focused on an input. Set `ignoreInputs: false` if you want the recorder to capture keys from within input elements.\n\n```ts\nnew HotkeyRecorderController(this, {\n  ignoreInputs: false, // record even from inside inputs\n  onRecord: (hotkey) => console.log(hotkey),\n})\n```\n\n### Mod auto-conversion\n\nRecorded hotkeys automatically use the portable `Mod` format. If a user on macOS presses Command+S, the recorded hotkey is `Mod+[KeyS]` rather than `Meta+[KeyS]`, so the shortcut keeps working when it syncs to a machine on another OS.\n\n## Validation and conflicts\n\nBoth recorder APIs accept `detectConflicts`, `validate`, and `onReject`. For a single-hotkey recorder, these options can be supplied alongside `onRecord`:\n\n```ts\nconst options = {\n  detectConflicts: {\n    // Use registration IDs to exclude the binding being edited:\n    excludeIds: [registrationId],\n    target: document,\n    eventType: 'keydown',\n  },\n  validate: (_hotkey, { parsedHotkey }) =>\n    parsedHotkey.modifiers.length > 0 || 'Include a modifier.',\n  onReject: ({ reason, message, conflicts }) => {\n    // Show feedback; recording stays active.\n    console.log(reason, message, conflicts)\n  },\n}\n```\n\n`validate` returns true to accept, or false/a message to reject. `onReject` receives `reason` (`missing-code`, `alt-graph`, `invalid`, `validation`, or `conflict`), a message, the candidate when available, and conflicting registration views for conflict rejections. Validation runs before commit; rejection never falls back to another key identity.\n\n`detectConflicts: true` checks enabled live registrations with the intended event type (default keydown) and overlapping targets (default document). Document/nested scopes can conflict; disjoint widgets can reuse a binding. The options object also supports `scope: 'all'`, `includeDisabled`, and an `exclude(registration)` predicate. Both single bindings and sequence prefixes are checked. Source events detect physical/logical overlap on the recorded layout. This is a conservative collision check, not a promise that two callbacks will execute: propagation, input filtering, match priority, external listeners, unmounted routes, and other layouts can affect actual dispatch.\n\nFor checks outside recording, use `findHotkeyConflicts(bindingOrSequence, options)`. Without source `events`, it compares binding identity and sequence prefixes; it does not guess equivalence between a logical character and a physical position.\n\n## Building a shortcut settings UI\n\nHere's a more complete example of a shortcut customization panel:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement, state } from 'lit/decorators.js'\nimport {\n  HotkeyRecorderController,\n  HotkeyController,\n  formatForDisplay,\n} from '@tanstack/lit-hotkeys'\nimport type { Hotkey } from '@tanstack/lit-hotkeys'\n\ninterface ShortcutMap {\n  save: Hotkey\n  undo: Hotkey\n  search: Hotkey\n}\n\n@customElement('shortcut-settings')\nclass ShortcutSettings extends LitElement {\n  @state() private shortcuts: ShortcutMap = {\n    save: 'Mod+S',\n    undo: 'Mod+Z',\n    search: 'Mod+K',\n  }\n\n  @state() private editingAction: keyof ShortcutMap | null = null\n\n  private recorder = new HotkeyRecorderController(this, {\n    onRecord: (hotkey) => {\n      if (this.editingAction) {\n        this.shortcuts = { ...this.shortcuts, [this.editingAction]: hotkey }\n        this.editingAction = null\n      }\n    },\n    onCancel: () => {\n      this.editingAction = null\n    },\n  })\n\n  private saveCtrl?: HotkeyController\n  private undoCtrl?: HotkeyController\n  private searchCtrl?: HotkeyController\n\n  connectedCallback() {\n    super.connectedCallback()\n    this._registerHotkeys()\n  }\n\n  updated() {\n    this._unregisterHotkeys()\n    this._registerHotkeys()\n  }\n\n  private _registerHotkeys() {\n    this.saveCtrl = new HotkeyController(this, this.shortcuts.save, () => save())\n    this.undoCtrl = new HotkeyController(this, this.shortcuts.undo, () => undo())\n    this.searchCtrl = new HotkeyController(this, this.shortcuts.search, () => openSearch())\n  }\n\n  private _unregisterHotkeys() {\n    this.saveCtrl?.hostDisconnected()\n    this.undoCtrl?.hostDisconnected()\n    this.searchCtrl?.hostDisconnected()\n  }\n\n  disconnectedCallback() {\n    super.disconnectedCallback()\n    this._unregisterHotkeys()\n  }\n\n  render() {\n    return html`\n      <div>\n        <h2>Keyboard Shortcuts</h2>\n        ${(Object.entries(this.shortcuts) as Array<[keyof ShortcutMap, Hotkey]>).map(\n          ([action, hotkey]) => html`\n            <div>\n              <span>${action}</span>\n              <button\n                @click=${() => {\n                  this.editingAction = action\n                  this.recorder.startRecording()\n                }}\n              >\n                ${this.editingAction === action && this.recorder.isRecording\n                  ? 'Press keys...'\n                  : formatForDisplay(hotkey)}\n              </button>\n            </div>\n          `,\n        )}\n      </div>\n    `\n  }\n}\n```\n\n## Under the hood\n\nThe `HotkeyRecorderController` creates a `HotkeyRecorder` class instance and subscribes to its reactive state via the recorder's TanStack Store. The class manages its own keyboard event listeners and state, and the controller handles cleanup on disconnect.\n"}
