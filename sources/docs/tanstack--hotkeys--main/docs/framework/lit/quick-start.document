{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"paragraph","children":[{"type":"text","value":"Don't have TanStack Hotkeys installed yet? See the "},{"type":"link","href":"../../installation","children":[{"type":"text","value":"Installation"}]},{"type":"text","value":" page for instructions."}]},{"type":"heading","depth":2,"id":"your-first-hotkey","children":[{"type":"text","value":"Your first hotkey"}]},{"type":"paragraph","children":[{"type":"text","value":"The Lit adapter offers two ways to register hotkeys: decorators for declarative method-level binding, and controllers for imperative, reactive state management."}]},{"type":"heading","depth":3,"id":"using-the-hotkey-decorator","children":[{"type":"text","value":"Using the "},{"type":"inlineCode","value":"@hotkey"},{"type":"text","value":" decorator"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"@hotkey"},{"type":"text","value":" decorator is the simplest way to bind a keyboard shortcut to a class method:"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkey } from '@tanstack/lit-hotkeys'\n\n@customElement('my-editor')\nclass MyEditor extends LitElement {\n  @hotkey('Mod+S')\n  save() {\n    saveDocument()\n  }\n\n  render() {\n    return html`<div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>`\n  }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"using-hotkeycontroller","children":[{"type":"text","value":"Using "},{"type":"inlineCode","value":"HotkeyController"}]},{"type":"paragraph","children":[{"type":"text","value":"For more control, use the "},{"type":"inlineCode","value":"HotkeyController"},{"type":"text","value":" directly:"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { HotkeyController } from '@tanstack/lit-hotkeys'\n\n@customElement('my-editor')\nclass MyEditor extends LitElement {\n  private saveHotkey = new HotkeyController(\n    this,\n    'Mod+S',\n    () => this.save(),\n  )\n\n  constructor() {\n    super()\n    this.addController(this.saveHotkey)\n  }\n\n  private save() {\n    saveDocument()\n  }\n\n  render() {\n    return html`<div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>`\n  }\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"Mod"},{"type":"text","value":" modifier automatically resolves to "},{"type":"inlineCode","value":"Meta"},{"type":"text","value":" (Command) on macOS and "},{"type":"inlineCode","value":"Control"},{"type":"text","value":" on Windows/Linux, so your shortcuts work across platforms without extra logic."}]},{"type":"heading","depth":2,"id":"common-patterns","children":[{"type":"text","value":"Common patterns"}]},{"type":"heading","depth":3,"id":"multiple-hotkeys","children":[{"type":"text","value":"Multiple hotkeys"}]},{"type":"paragraph","children":[{"type":"text","value":"Register as many hotkeys as you need with the "},{"type":"inlineCode","value":"@hotkey"},{"type":"text","value":" decorator:"}]},{"type":"code","value":"@customElement('my-editor')\nclass MyEditor extends LitElement {\n  @hotkey('Mod+S')\n  save() { saveDocument() }\n\n  @hotkey('Mod+Z')\n  undo() { undoAction() }\n\n  @hotkey('Mod+Shift+Z')\n  redo() { redoAction() }\n\n  @hotkey('Mod+F')\n  search() { openSearch() }\n\n  @hotkey('Escape')\n  dismiss() { closeDialog() }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"scoped-hotkeys","children":[{"type":"text","value":"Scoped hotkeys"}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"target"},{"type":"text","value":" option to attach hotkeys to specific elements instead of the entire document. When the target comes from a ref, create the registration after the element has rendered:"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { createRef, ref } from 'lit/directives/ref.js'\nimport { HotkeyController } from '@tanstack/lit-hotkeys'\n\n@customElement('my-panel')\nclass MyPanel extends LitElement {\n  private panelRef = createRef<HTMLDivElement>()\n  private escapeHotkey?: HotkeyController\n\n  firstUpdated() {\n    if (!this.panelRef.value) return\n\n    this.escapeHotkey = new HotkeyController(\n      this,\n      'Escape',\n      () => this.closePanel(),\n      { target: this.panelRef.value },\n    )\n    this.addController(this.escapeHotkey)\n  }\n\n  private closePanel() {\n    this.dispatchEvent(new CustomEvent('close'))\n  }\n\n  render() {\n    return html`\n      <div ${ref(this.panelRef)} tabindex=\"0\">\n        <p>Press Escape while focused here to close</p>\n      </div>\n    `\n  }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"conditional-hotkeys","children":[{"type":"text","value":"Conditional hotkeys"}]},{"type":"paragraph","children":[{"type":"text","value":"Enable or disable hotkeys based on application state via the "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" option:"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkey } from '@tanstack/lit-hotkeys'\n\n@customElement('my-modal')\nclass MyModal extends LitElement {\n  @hotkey('Escape', { enabled: true })\n  close() {\n    this.dispatchEvent(new CustomEvent('close'))\n  }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"multi-key-sequences","children":[{"type":"text","value":"Multi-key sequences"}]},{"type":"paragraph","children":[{"type":"text","value":"Register Vim-style key sequences with the "},{"type":"inlineCode","value":"@hotkeySequence"},{"type":"text","value":" decorator or "},{"type":"inlineCode","value":"HotkeySequenceController"},{"type":"text","value":":"}]},{"type":"code","value":"import { LitElement } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkeySequence } from '@tanstack/lit-hotkeys'\n\n@customElement('vim-editor')\nclass VimEditor extends LitElement {\n  @hotkeySequence(['G', 'G'])\n  scrollToTop() {\n    window.scrollTo({ top: 0 })\n  }\n\n  @hotkeySequence(['G', 'Shift+G'])\n  scrollToBottom() {\n    window.scrollTo({ top: document.body.scrollHeight })\n  }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"tracking-held-keys","children":[{"type":"text","value":"Tracking held keys"}]},{"type":"paragraph","children":[{"type":"text","value":"Display modifier key state for power-user UIs using "},{"type":"inlineCode","value":"KeyHoldController"},{"type":"text","value":" and "},{"type":"inlineCode","value":"HeldKeysController"},{"type":"text","value":":"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { KeyHoldController, HeldKeysController } from '@tanstack/lit-hotkeys'\n\n@customElement('status-bar')\nclass StatusBar extends LitElement {\n  private shiftHold = new KeyHoldController(this, 'Shift')\n  private heldKeys = new HeldKeysController(this)\n\n  render() {\n    return html`\n      <div class=\"status-bar\">\n        ${this.shiftHold.value\n          ? html`<span>Shift mode active</span>`\n          : null}\n        ${this.heldKeys.value.length > 0\n          ? html`<span>Keys: ${this.heldKeys.value.join('+')}</span>`\n          : null}\n      </div>\n    `\n  }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"recording-hotkeys","children":[{"type":"text","value":"Recording hotkeys"}]},{"type":"paragraph","children":[{"type":"text","value":"Build shortcut customization UIs with "},{"type":"inlineCode","value":"HotkeyRecorderController"},{"type":"text","value":":"}]},{"type":"code","value":"import { LitElement, html, nothing } from 'lit'\nimport { customElement, state } from 'lit/decorators.js'\nimport {\n  HotkeyRecorderController,\n  formatForDisplay,\n  type Hotkey,\n} from '@tanstack/lit-hotkeys'\n\n@customElement('shortcut-settings')\nclass ShortcutSettings extends LitElement {\n  private recorder = new HotkeyRecorderController(this, {\n    onRecord: (hotkey) => {\n      this.shortcut = hotkey\n    },\n    onCancel: () => {\n      console.log('Recording cancelled')\n    },\n  })\n\n  @state() private shortcut: Hotkey | null = null\n\n  render() {\n    return html`\n      <button @click=${() => this.recorder.startRecording()}>\n        ${this.recorder.isRecording ? 'Recording...' : 'Edit Shortcut'}\n      </button>\n      ${this.shortcut\n        ? html`<kbd>${formatForDisplay(this.shortcut)}</kbd>`\n        : nothing}\n    `\n  }\n}","lang":"ts"},{"type":"heading","depth":3,"id":"displaying-hotkeys-in-the-ui","children":[{"type":"text","value":"Displaying hotkeys in the UI"}]},{"type":"paragraph","children":[{"type":"text","value":"Format hotkeys for platform-aware display:"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkey, formatForDisplay } from '@tanstack/lit-hotkeys'\n\n@customElement('save-button')\nclass SaveButton extends LitElement {\n  @hotkey('Mod+S')\n  save() { saveDocument() }\n\n  render() {\n    return html`\n      <button>\n        Save <kbd>${formatForDisplay('Mod+S')}</kbd>\n        <!-- Mac: \"⌘S\"  |  Windows: \"Ctrl+S\" -->\n      </button>\n    `\n  }\n}","lang":"ts"},{"type":"heading","depth":2,"id":"decorators-vs-controllers","children":[{"type":"text","value":"Decorators vs controllers"}]},{"type":"paragraph","children":[{"type":"text","value":"The Lit adapter gives you two complementary approaches:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[]},{"type":"tableCell","children":[{"type":"text","value":"Decorators ("},{"type":"inlineCode","value":"@hotkey"},{"type":"text","value":", "},{"type":"inlineCode","value":"@hotkeySequence"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"text","value":"Controllers ("},{"type":"inlineCode","value":"HotkeyController"},{"type":"text","value":", etc.)"}]}],"rows":[[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Best for"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Declarative method binding"}]},{"type":"tableCell","children":[{"type":"text","value":"Reactive state, dynamic hotkeys"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Registration"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Automatic on connect/disconnect"}]},{"type":"tableCell","children":[{"type":"text","value":"Automatic via "},{"type":"inlineCode","value":"hostConnected"},{"type":"text","value":"/"},{"type":"inlineCode","value":"hostDisconnected"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"State access"}]}]},{"type":"tableCell","children":[{"type":"text","value":"No (fire-and-forget callbacks)"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes ("},{"type":"inlineCode","value":"isRecording"},{"type":"text","value":", "},{"type":"inlineCode","value":"value"},{"type":"text","value":", etc.)"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Dynamic hotkeys"}]}]},{"type":"tableCell","children":[{"type":"text","value":"No (static at decoration time)"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes (can re-register programmatically)"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Use decorators when you simply want a method to fire on a key combo. Use controllers when you need reactive state (held keys, recording) or dynamic hotkey registration."}]},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/hotkeys","children":[{"type":"text","value":"Hotkeys Guide"}]},{"type":"text","value":" - Deep dive into "},{"type":"inlineCode","value":"@hotkey"},{"type":"text","value":" decorator and "},{"type":"inlineCode","value":"HotkeyController"},{"type":"text","value":" options"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/sequences","children":[{"type":"text","value":"Sequences Guide"}]},{"type":"text","value":" - Multi-key sequence handling"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/hotkey-recording","children":[{"type":"text","value":"Hotkey Recording Guide"}]},{"type":"text","value":" - Building shortcut customization UIs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/sequence-recording","children":[{"type":"text","value":"Sequence Recording Guide"}]},{"type":"text","value":" - Capture multi-step shortcuts"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/key-state-tracking","children":[{"type":"text","value":"Key State Tracking Guide"}]},{"type":"text","value":" - Real-time key state monitoring"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/formatting-display","children":[{"type":"text","value":"Formatting & Display Guide"}]},{"type":"text","value":" - Platform-aware hotkey formatting"}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"your-first-hotkey","text":"Your first hotkey","level":2},{"id":"using-the-hotkey-decorator","text":"Using the @hotkey decorator","level":3},{"id":"using-hotkeycontroller","text":"Using HotkeyController","level":3},{"id":"common-patterns","text":"Common patterns","level":2},{"id":"multiple-hotkeys","text":"Multiple hotkeys","level":3},{"id":"scoped-hotkeys","text":"Scoped hotkeys","level":3},{"id":"conditional-hotkeys","text":"Conditional hotkeys","level":3},{"id":"multi-key-sequences","text":"Multi-key sequences","level":3},{"id":"tracking-held-keys","text":"Tracking held keys","level":3},{"id":"recording-hotkeys","text":"Recording hotkeys","level":3},{"id":"displaying-hotkeys-in-the-ui","text":"Displaying hotkeys in the UI","level":3},{"id":"decorators-vs-controllers","text":"Decorators vs controllers","level":2},{"id":"next-steps","text":"Next steps","level":2}]},"frameworks":[],"downloadMarkdown":"\n## Installation\n\nDon't have TanStack Hotkeys installed yet? See the [Installation](../../installation) page for instructions.\n\n## Your first hotkey\n\nThe Lit adapter offers two ways to register hotkeys: decorators for declarative method-level binding, and controllers for imperative, reactive state management.\n\n### Using the `@hotkey` decorator\n\nThe `@hotkey` decorator is the simplest way to bind a keyboard shortcut to a class method:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkey } from '@tanstack/lit-hotkeys'\n\n@customElement('my-editor')\nclass MyEditor extends LitElement {\n  @hotkey('Mod+S')\n  save() {\n    saveDocument()\n  }\n\n  render() {\n    return html`<div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>`\n  }\n}\n```\n\n### Using `HotkeyController`\n\nFor more control, use the `HotkeyController` directly:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { HotkeyController } from '@tanstack/lit-hotkeys'\n\n@customElement('my-editor')\nclass MyEditor extends LitElement {\n  private saveHotkey = new HotkeyController(\n    this,\n    'Mod+S',\n    () => this.save(),\n  )\n\n  constructor() {\n    super()\n    this.addController(this.saveHotkey)\n  }\n\n  private save() {\n    saveDocument()\n  }\n\n  render() {\n    return html`<div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>`\n  }\n}\n```\n\nThe `Mod` modifier automatically resolves to `Meta` (Command) on macOS and `Control` on Windows/Linux, so your shortcuts work across platforms without extra logic.\n\n## Common patterns\n\n### Multiple hotkeys\n\nRegister as many hotkeys as you need with the `@hotkey` decorator:\n\n```ts\n@customElement('my-editor')\nclass MyEditor extends LitElement {\n  @hotkey('Mod+S')\n  save() { saveDocument() }\n\n  @hotkey('Mod+Z')\n  undo() { undoAction() }\n\n  @hotkey('Mod+Shift+Z')\n  redo() { redoAction() }\n\n  @hotkey('Mod+F')\n  search() { openSearch() }\n\n  @hotkey('Escape')\n  dismiss() { closeDialog() }\n}\n```\n\n### Scoped hotkeys\n\nUse the `target` option to attach hotkeys to specific elements instead of the entire document. When the target comes from a ref, create the registration after the element has rendered:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { createRef, ref } from 'lit/directives/ref.js'\nimport { HotkeyController } from '@tanstack/lit-hotkeys'\n\n@customElement('my-panel')\nclass MyPanel extends LitElement {\n  private panelRef = createRef<HTMLDivElement>()\n  private escapeHotkey?: HotkeyController\n\n  firstUpdated() {\n    if (!this.panelRef.value) return\n\n    this.escapeHotkey = new HotkeyController(\n      this,\n      'Escape',\n      () => this.closePanel(),\n      { target: this.panelRef.value },\n    )\n    this.addController(this.escapeHotkey)\n  }\n\n  private closePanel() {\n    this.dispatchEvent(new CustomEvent('close'))\n  }\n\n  render() {\n    return html`\n      <div ${ref(this.panelRef)} tabindex=\"0\">\n        <p>Press Escape while focused here to close</p>\n      </div>\n    `\n  }\n}\n```\n\n### Conditional hotkeys\n\nEnable or disable hotkeys based on application state via the `enabled` option:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkey } from '@tanstack/lit-hotkeys'\n\n@customElement('my-modal')\nclass MyModal extends LitElement {\n  @hotkey('Escape', { enabled: true })\n  close() {\n    this.dispatchEvent(new CustomEvent('close'))\n  }\n}\n```\n\n### Multi-key sequences\n\nRegister Vim-style key sequences with the `@hotkeySequence` decorator or `HotkeySequenceController`:\n\n```ts\nimport { LitElement } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkeySequence } from '@tanstack/lit-hotkeys'\n\n@customElement('vim-editor')\nclass VimEditor extends LitElement {\n  @hotkeySequence(['G', 'G'])\n  scrollToTop() {\n    window.scrollTo({ top: 0 })\n  }\n\n  @hotkeySequence(['G', 'Shift+G'])\n  scrollToBottom() {\n    window.scrollTo({ top: document.body.scrollHeight })\n  }\n}\n```\n\n### Tracking held keys\n\nDisplay modifier key state for power-user UIs using `KeyHoldController` and `HeldKeysController`:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { KeyHoldController, HeldKeysController } from '@tanstack/lit-hotkeys'\n\n@customElement('status-bar')\nclass StatusBar extends LitElement {\n  private shiftHold = new KeyHoldController(this, 'Shift')\n  private heldKeys = new HeldKeysController(this)\n\n  render() {\n    return html`\n      <div class=\"status-bar\">\n        ${this.shiftHold.value\n          ? html`<span>Shift mode active</span>`\n          : null}\n        ${this.heldKeys.value.length > 0\n          ? html`<span>Keys: ${this.heldKeys.value.join('+')}</span>`\n          : null}\n      </div>\n    `\n  }\n}\n```\n\n### Recording hotkeys\n\nBuild shortcut customization UIs with `HotkeyRecorderController`:\n\n```ts\nimport { LitElement, html, nothing } from 'lit'\nimport { customElement, state } from 'lit/decorators.js'\nimport {\n  HotkeyRecorderController,\n  formatForDisplay,\n  type Hotkey,\n} from '@tanstack/lit-hotkeys'\n\n@customElement('shortcut-settings')\nclass ShortcutSettings extends LitElement {\n  private recorder = new HotkeyRecorderController(this, {\n    onRecord: (hotkey) => {\n      this.shortcut = hotkey\n    },\n    onCancel: () => {\n      console.log('Recording cancelled')\n    },\n  })\n\n  @state() private shortcut: Hotkey | null = null\n\n  render() {\n    return html`\n      <button @click=${() => this.recorder.startRecording()}>\n        ${this.recorder.isRecording ? 'Recording...' : 'Edit Shortcut'}\n      </button>\n      ${this.shortcut\n        ? html`<kbd>${formatForDisplay(this.shortcut)}</kbd>`\n        : nothing}\n    `\n  }\n}\n```\n\n### Displaying hotkeys in the UI\n\nFormat hotkeys for platform-aware display:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkey, formatForDisplay } from '@tanstack/lit-hotkeys'\n\n@customElement('save-button')\nclass SaveButton extends LitElement {\n  @hotkey('Mod+S')\n  save() { saveDocument() }\n\n  render() {\n    return html`\n      <button>\n        Save <kbd>${formatForDisplay('Mod+S')}</kbd>\n        <!-- Mac: \"⌘S\"  |  Windows: \"Ctrl+S\" -->\n      </button>\n    `\n  }\n}\n```\n\n## Decorators vs controllers\n\nThe Lit adapter gives you two complementary approaches:\n\n| | Decorators (`@hotkey`, `@hotkeySequence`) | Controllers (`HotkeyController`, etc.) |\n|---|---|---|\n| **Best for** | Declarative method binding | Reactive state, dynamic hotkeys |\n| **Registration** | Automatic on connect/disconnect | Automatic via `hostConnected`/`hostDisconnected` |\n| **State access** | No (fire-and-forget callbacks) | Yes (`isRecording`, `value`, etc.) |\n| **Dynamic hotkeys** | No (static at decoration time) | Yes (can re-register programmatically) |\n\nUse decorators when you simply want a method to fire on a key combo. Use controllers when you need reactive state (held keys, recording) or dynamic hotkey registration.\n\n## Next steps\n\n- [Hotkeys Guide](./guides/hotkeys) - Deep dive into `@hotkey` decorator and `HotkeyController` options\n- [Sequences Guide](./guides/sequences) - Multi-key sequence handling\n- [Hotkey Recording Guide](./guides/hotkey-recording) - Building shortcut customization UIs\n- [Sequence Recording Guide](./guides/sequence-recording) - Capture multi-step shortcuts\n- [Key State Tracking Guide](./guides/key-state-tracking) - Real-time key state monitoring\n- [Formatting & Display Guide](./guides/formatting-display) - Platform-aware hotkey formatting\n","originalRawMarkdown":"---\ntitle: Quick Start\nid: quick-start\n---\n\n## Installation\n\nDon't have TanStack Hotkeys installed yet? See the [Installation](../../installation) page for instructions.\n\n## Your first hotkey\n\nThe Lit adapter offers two ways to register hotkeys: decorators for declarative method-level binding, and controllers for imperative, reactive state management.\n\n### Using the `@hotkey` decorator\n\nThe `@hotkey` decorator is the simplest way to bind a keyboard shortcut to a class method:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkey } from '@tanstack/lit-hotkeys'\n\n@customElement('my-editor')\nclass MyEditor extends LitElement {\n  @hotkey('Mod+S')\n  save() {\n    saveDocument()\n  }\n\n  render() {\n    return html`<div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>`\n  }\n}\n```\n\n### Using `HotkeyController`\n\nFor more control, use the `HotkeyController` directly:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { HotkeyController } from '@tanstack/lit-hotkeys'\n\n@customElement('my-editor')\nclass MyEditor extends LitElement {\n  private saveHotkey = new HotkeyController(\n    this,\n    'Mod+S',\n    () => this.save(),\n  )\n\n  constructor() {\n    super()\n    this.addController(this.saveHotkey)\n  }\n\n  private save() {\n    saveDocument()\n  }\n\n  render() {\n    return html`<div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>`\n  }\n}\n```\n\nThe `Mod` modifier automatically resolves to `Meta` (Command) on macOS and `Control` on Windows/Linux, so your shortcuts work across platforms without extra logic.\n\n## Common patterns\n\n### Multiple hotkeys\n\nRegister as many hotkeys as you need with the `@hotkey` decorator:\n\n```ts\n@customElement('my-editor')\nclass MyEditor extends LitElement {\n  @hotkey('Mod+S')\n  save() { saveDocument() }\n\n  @hotkey('Mod+Z')\n  undo() { undoAction() }\n\n  @hotkey('Mod+Shift+Z')\n  redo() { redoAction() }\n\n  @hotkey('Mod+F')\n  search() { openSearch() }\n\n  @hotkey('Escape')\n  dismiss() { closeDialog() }\n}\n```\n\n### Scoped hotkeys\n\nUse the `target` option to attach hotkeys to specific elements instead of the entire document. When the target comes from a ref, create the registration after the element has rendered:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { createRef, ref } from 'lit/directives/ref.js'\nimport { HotkeyController } from '@tanstack/lit-hotkeys'\n\n@customElement('my-panel')\nclass MyPanel extends LitElement {\n  private panelRef = createRef<HTMLDivElement>()\n  private escapeHotkey?: HotkeyController\n\n  firstUpdated() {\n    if (!this.panelRef.value) return\n\n    this.escapeHotkey = new HotkeyController(\n      this,\n      'Escape',\n      () => this.closePanel(),\n      { target: this.panelRef.value },\n    )\n    this.addController(this.escapeHotkey)\n  }\n\n  private closePanel() {\n    this.dispatchEvent(new CustomEvent('close'))\n  }\n\n  render() {\n    return html`\n      <div ${ref(this.panelRef)} tabindex=\"0\">\n        <p>Press Escape while focused here to close</p>\n      </div>\n    `\n  }\n}\n```\n\n### Conditional hotkeys\n\nEnable or disable hotkeys based on application state via the `enabled` option:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkey } from '@tanstack/lit-hotkeys'\n\n@customElement('my-modal')\nclass MyModal extends LitElement {\n  @hotkey('Escape', { enabled: true })\n  close() {\n    this.dispatchEvent(new CustomEvent('close'))\n  }\n}\n```\n\n### Multi-key sequences\n\nRegister Vim-style key sequences with the `@hotkeySequence` decorator or `HotkeySequenceController`:\n\n```ts\nimport { LitElement } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkeySequence } from '@tanstack/lit-hotkeys'\n\n@customElement('vim-editor')\nclass VimEditor extends LitElement {\n  @hotkeySequence(['G', 'G'])\n  scrollToTop() {\n    window.scrollTo({ top: 0 })\n  }\n\n  @hotkeySequence(['G', 'Shift+G'])\n  scrollToBottom() {\n    window.scrollTo({ top: document.body.scrollHeight })\n  }\n}\n```\n\n### Tracking held keys\n\nDisplay modifier key state for power-user UIs using `KeyHoldController` and `HeldKeysController`:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { KeyHoldController, HeldKeysController } from '@tanstack/lit-hotkeys'\n\n@customElement('status-bar')\nclass StatusBar extends LitElement {\n  private shiftHold = new KeyHoldController(this, 'Shift')\n  private heldKeys = new HeldKeysController(this)\n\n  render() {\n    return html`\n      <div class=\"status-bar\">\n        ${this.shiftHold.value\n          ? html`<span>Shift mode active</span>`\n          : null}\n        ${this.heldKeys.value.length > 0\n          ? html`<span>Keys: ${this.heldKeys.value.join('+')}</span>`\n          : null}\n      </div>\n    `\n  }\n}\n```\n\n### Recording hotkeys\n\nBuild shortcut customization UIs with `HotkeyRecorderController`:\n\n```ts\nimport { LitElement, html, nothing } from 'lit'\nimport { customElement, state } from 'lit/decorators.js'\nimport {\n  HotkeyRecorderController,\n  formatForDisplay,\n  type Hotkey,\n} from '@tanstack/lit-hotkeys'\n\n@customElement('shortcut-settings')\nclass ShortcutSettings extends LitElement {\n  private recorder = new HotkeyRecorderController(this, {\n    onRecord: (hotkey) => {\n      this.shortcut = hotkey\n    },\n    onCancel: () => {\n      console.log('Recording cancelled')\n    },\n  })\n\n  @state() private shortcut: Hotkey | null = null\n\n  render() {\n    return html`\n      <button @click=${() => this.recorder.startRecording()}>\n        ${this.recorder.isRecording ? 'Recording...' : 'Edit Shortcut'}\n      </button>\n      ${this.shortcut\n        ? html`<kbd>${formatForDisplay(this.shortcut)}</kbd>`\n        : nothing}\n    `\n  }\n}\n```\n\n### Displaying hotkeys in the UI\n\nFormat hotkeys for platform-aware display:\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement } from 'lit/decorators.js'\nimport { hotkey, formatForDisplay } from '@tanstack/lit-hotkeys'\n\n@customElement('save-button')\nclass SaveButton extends LitElement {\n  @hotkey('Mod+S')\n  save() { saveDocument() }\n\n  render() {\n    return html`\n      <button>\n        Save <kbd>${formatForDisplay('Mod+S')}</kbd>\n        <!-- Mac: \"⌘S\"  |  Windows: \"Ctrl+S\" -->\n      </button>\n    `\n  }\n}\n```\n\n## Decorators vs controllers\n\nThe Lit adapter gives you two complementary approaches:\n\n| | Decorators (`@hotkey`, `@hotkeySequence`) | Controllers (`HotkeyController`, etc.) |\n|---|---|---|\n| **Best for** | Declarative method binding | Reactive state, dynamic hotkeys |\n| **Registration** | Automatic on connect/disconnect | Automatic via `hostConnected`/`hostDisconnected` |\n| **State access** | No (fire-and-forget callbacks) | Yes (`isRecording`, `value`, etc.) |\n| **Dynamic hotkeys** | No (static at decoration time) | Yes (can re-register programmatically) |\n\nUse decorators when you simply want a method to fire on a key combo. Use controllers when you need reactive state (held keys, recording) or dynamic hotkey registration.\n\n## Next steps\n\n- [Hotkeys Guide](./guides/hotkeys) - Deep dive into `@hotkey` decorator and `HotkeyController` options\n- [Sequences Guide](./guides/sequences) - Multi-key sequence handling\n- [Hotkey Recording Guide](./guides/hotkey-recording) - Building shortcut customization UIs\n- [Sequence Recording Guide](./guides/sequence-recording) - Capture multi-step shortcuts\n- [Key State Tracking Guide](./guides/key-state-tracking) - Real-time key state monitoring\n- [Formatting & Display Guide](./guides/formatting-display) - Platform-aware hotkey formatting\n"}
