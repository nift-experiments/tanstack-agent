ue":"Constructor"}]},{"type":"code","value":"new KeyHoldController(_host, _key): KeyHoldController;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L58","children":[{"type":"text","value":"controllers/key-hold.ts:58"}]}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"host","children":[{"type":"text","value":"_host"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveControllerHost"}]},{"type":"heading","depth":5,"id":"key","children":[{"type":"text","value":"_key"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"IndividualKey"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"KeyHoldController"}]},{"type":"heading","depth":2,"id":"accessors","children":[{"type":"text","value":"Accessors"}]},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"heading","depth":4,"id":"get-signature","children":[{"type":"text","value":"Get Signature"}]},{"type":"code","value":"get value(): boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L50","children":[{"type":"text","value":"controllers/key-hold.ts:50"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether the tracked key is currently held down."}]},{"type":"heading","depth":5,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"hostconnected","children":[{"type":"text","value":"hostConnected()"}]},{"type":"code","value":"hostConnected(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L65","children":[{"type":"text","value":"controllers/key-hold.ts:65"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called when the host is connected to the component tree. For custom\nelement hosts, this corresponds to the "},{"type":"inlineCode","value":"connectedCallback()"},{"type":"text","value":" lifecycle,\nwhich is only called when the component is connected to the document."}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"implementation-of","children":[{"type":"text","value":"Implementation of"}]},{"type":"code","value":"ReactiveController.hostConnected","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"hostdisconnected","children":[{"type":"text","value":"hostDisconnected()"}]},{"type":"code","value":"hostDisconnected(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L83","children":[{"type":"text","value":"controllers/key-hold.ts:83"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called when the host is disconnected from the component tree. For custom\nelement hosts, this corresponds to the "},{"type":"inlineCode","value":"disconnectedCallback()"},{"type":"text","value":" lifecycle,\nwhich is called the host or an ancestor component is disconnected from the\ndocument."}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"implementation-of-2","children":[{"type":"text","value":"Implementation of"}]},{"type":"code","value":"ReactiveController.hostDisconnected","lang":"ts"}],"headings":[{"id":"examples","text":"Examples","level":2},{"id":"implements","text":"Implements","level":2},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"host","text":"_host","level":5},{"id":"key","text":"_key","level":5},{"id":"returns","text":"Returns","level":4},{"id":"accessors","text":"Accessors","level":2},{"id":"value","text":"value","level":3},{"id":"get-signature","text":"Get Signature","level":4},{"id":"returns-2","text":"Returns","level":5},{"id":"methods","text":"Methods","level":2},{"id":"hostconnected","text":"hostConnected()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"implementation-of","text":"Implementation of","level":4},{"id":"hostdisconnected","text":"hostDisconnected()","level":3},{"id":"returns-4","text":"Returns","level":4},{"id":"implementation-of-2","text":"Implementation of","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [controllers/key-hold.ts:43](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L43)\n\nA Lit ReactiveController that tracks whether a specific key is currently held.\n\nSubscribes to the global KeyStateTracker and triggers host updates\nwhen the held state of the specified key changes.\n\n## Examples\n\n```ts\nclass MyElement extends LitElement {\n  private shiftHold = new KeyHoldController(this, 'Shift')\n\n  render() {\n    return html`\n      <div style=\"opacity: ${this.shiftHold.value ? 1 : 0.5}\">\n        ${this.shiftHold.value ? 'Shift is pressed!' : 'Press Shift'}\n      </div>\n    `\n  }\n}\n```\n\n```ts\nclass ModifierIndicators extends LitElement {\n  private ctrl = new KeyHoldController(this, 'Control')\n  private shift = new KeyHoldController(this, 'Shift')\n  private alt = new KeyHoldController(this, 'Alt')\n\n  render() {\n    return html`\n      <span style=\"opacity: ${this.ctrl.value ? 1 : 0.3}\">Ctrl</span>\n      <span style=\"opacity: ${this.shift.value ? 1 : 0.3}\">Shift</span>\n      <span style=\"opacity: ${this.alt.value ? 1 : 0.3}\">Alt</span>\n    `\n  }\n}\n```\n\n## Implements\n\n- `ReactiveController`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew KeyHoldController(_host, _key): KeyHoldController;\n```\n\nDefined in: [controllers/key-hold.ts:58](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L58)\n\n#### Parameters\n\n##### \\_host\n\n`ReactiveControllerHost`\n\n##### \\_key\n\n`IndividualKey`\n\n#### Returns\n\n`KeyHoldController`\n\n## Accessors\n\n### value\n\n#### Get Signature\n\n```ts\nget value(): boolean;\n```\n\nDefined in: [controllers/key-hold.ts:50](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L50)\n\nWhether the tracked key is currently held down.\n\n##### Returns\n\n`boolean`\n\n## Methods\n\n### hostConnected()\n\n```ts\nhostConnected(): void;\n```\n\nDefined in: [controllers/key-hold.ts:65](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L65)\n\nCalled when the host is connected to the component tree. For custom\nelement hosts, this corresponds to the `connectedCallback()` lifecycle,\nwhich is only called when the component is connected to the document.\n\n#### Returns\n\n`void`\n\n#### Implementation of\n\n```ts\nReactiveController.hostConnected\n```\n\n***\n\n### hostDisconnected()\n\n```ts\nhostDisconnected(): void;\n```\n\nDefined in: [controllers/key-hold.ts:83](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L83)\n\nCalled when the host is disconnected from the component tree. For custom\nelement hosts, this corresponds to the `disconnectedCallback()` lifecycle,\nwhich is called the host or an ancestor component is disconnected from the\ndocument.\n\n#### Returns\n\n`void`\n\n#### Implementation of\n\n```ts\nReactiveController.hostDisconnected\n```\n","originalRawMarkdown":"---\nid: KeyHoldController\ntitle: KeyHoldController\n---\n\nDefined in: [controllers/key-hold.ts:43](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L43)\n\nA Lit ReactiveController that tracks whether a specific key is currently held.\n\nSubscribes to the global KeyStateTracker and triggers host updates\nwhen the held state of the specified key changes.\n\n## Examples\n\n```ts\nclass MyElement extends LitElement {\n  private shiftHold = new KeyHoldController(this, 'Shift')\n\n  render() {\n    return html`\n      <div style=\"opacity: ${this.shiftHold.value ? 1 : 0.5}\">\n        ${this.shiftHold.value ? 'Shift is pressed!' : 'Press Shift'}\n      </div>\n    `\n  }\n}\n```\n\n```ts\nclass ModifierIndicators extends LitElement {\n  private ctrl = new KeyHoldController(this, 'Control')\n  private shift = new KeyHoldController(this, 'Shift')\n  private alt = new KeyHoldController(this, 'Alt')\n\n  render() {\n    return html`\n      <span style=\"opacity: ${this.ctrl.value ? 1 : 0.3}\">Ctrl</span>\n      <span style=\"opacity: ${this.shift.value ? 1 : 0.3}\">Shift</span>\n      <span style=\"opacity: ${this.alt.value ? 1 : 0.3}\">Alt</span>\n    `\n  }\n}\n```\n\n## Implements\n\n- `ReactiveController`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew KeyHoldController(_host, _key): KeyHoldController;\n```\n\nDefined in: [controllers/key-hold.ts:58](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L58)\n\n#### Parameters\n\n##### \\_host\n\n`ReactiveControllerHost`\n\n##### \\_key\n\n`IndividualKey`\n\n#### Returns\n\n`KeyHoldController`\n\n## Accessors\n\n### value\n\n#### Get Signature\n\n```ts\nget value(): boolean;\n```\n\nDefined in: [controllers/key-hold.ts:50](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L50)\n\nWhether the tracked key is currently held down.\n\n##### Returns\n\n`boolean`\n\n## Methods\n\n### hostConnected()\n\n```ts\nhostConnected(): void;\n```\n\nDefined in: [controllers/key-hold.ts:65](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L65)\n\nCalled when the host is connected to the component tree. For custom\nelement hosts, this corresponds to the `connectedCallback()` lifecycle,\nwhich is only called when the component is connected to the document.\n\n#### Returns\n\n`void`\n\n#### Implementation of\n\n```ts\nReactiveController.hostConnected\n```\n\n***\n\n### hostDisconnected()\n\n```ts\nhostDisconnected(): void;\n```\n\nDefined in: [controllers/key-hold.ts:83](https://github.com/TanStack/hotkeys/blob/main/packages/lit-hotkeys/src/controllers/key-hold.ts#L83)\n\nCalled when the host is disconnected from the component tree. For custom\nelement hosts, this corresponds to the `disconnectedCallback()` lifecycle,\nwhich is called the host or an ancestor component is disconnected from the\ndocument.\n\n#### Returns\n\n`void`\n\n#### Implementation of\n\n```ts\nReactiveController.hostDisconnected\n```\n"}
