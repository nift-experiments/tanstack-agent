title: Hotkey Recording Guide
id: hotkey-recording
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack Hotkeys includes the "},{"type":"inlineCode","value":"useHotkeyRecorder"},{"type":"text","value":" hook for building keyboard shortcut customization UIs. Users record their own shortcuts by pressing the desired key combination, the same way system preferences or IDE shortcut editors work."}]},{"type":"paragraph","children":[{"type":"text","value":"Recorders default to physical codes: recording a shortcut stores a string such as "},{"type":"inlineCode","value":"Mod+[KeyS]"},{"type":"text","value":". Pass it directly to your hotkey registration and use "},{"type":"inlineCode","value":"formatForDisplay"},{"type":"text","value":" for the label. Set "},{"type":"inlineCode","value":"recordBy: 'key'"},{"type":"text","value":" when you intentionally want the produced character instead."}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Hotkeys automatically suppresses registered hotkey and sequence callbacks while any recorder is active. You do not need to set "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" from "},{"type":"inlineCode","value":"isRecording"},{"type":"text","value":". Registrations remain available for conflict detection, and recorded keys stay suppressed through repeats and key release."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic usage"}]},{"type":"code","value":"import { useHotkeyRecorder, formatForDisplay } from '@tanstack/preact-hotkeys'\n\nfunction ShortcutRecorder() {\n  const { isRecording, recordedHotkey, startRecording, stopRecording, cancelRecording } =\n    useHotkeyRecorder({\n      onRecord: (hotkey) => {\n        console.log('Recorded:', hotkey) // e.g., \"Mod+Shift+[KeyS]\"\n      },\n    })\n\n  return (\n    <div>\n      <button onClick={isRecording ? stopRecording : startRecording}>\n        {isRecording\n          ? 'Press a key combination...'\n          : recordedHotkey\n            ? formatForDisplay(recordedHotkey)\n            : 'Click to record'}\n      </button>\n      {isRecording && (\n        <button onClick={cancelRecording}>Cancel</button>\n      )}\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"return-value","children":[{"type":"text","value":"Return value"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"useHotkeyRecorder"},{"type":"text","value":" hook returns an object with:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"isRecording"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether the recorder is currently listening for key presses"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"recordedHotkey"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Hotkey | null"}]},{"type":"tableCell","children":[{"type":"text","value":"The last recorded hotkey string, or "},{"type":"inlineCode","value":"null"},{"type":"text","value":" if nothing recorded"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"startRecording"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Start listening for key presses"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"stopRecording"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Stop listening and reset recorder state without calling "},{"type":"inlineCode","value":"onRecord"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"cancelRecording"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"() => void"}]},{"type":"tableCell","children":[{"type":"text","value":"Stop listening and discard any recorded hotkey"}]}]]},{"type":"heading","depth":2,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"heading","depth":3,"id":"recordby","children":[{"type":"inlineCode","value":"recordBy"}]},{"type":"paragraph","children":[{"type":"text","value":"Recorders default to "},{"type":"inlineCode","value":"recordBy: 'code'"},{"type":"text","value":". Option+S producing "},{"type":"inlineCode","value":"ß"},{"type":"text","value":" on macOS records "},{"type":"inlineCode","value":"Alt+[KeyS]"},{"type":"text","value":"; Option+2 producing "},{"type":"inlineCode","value":"™"},{"type":"text","value":" records "},{"type":"inlineCode","value":"Alt+[Digit2]"},{"type":"text","value":". The stored brackets preserve physical identity through state, serialization, and registration; "},{"type":"inlineCode","value":"formatForDisplay"},{"type":"text","value":" produces a readable label. There is no code-to-letter conversion. Existing authored strings such as "},{"type":"inlineCode","value":"Mod+S"},{"type":"text","value":" remain logical bindings."}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"recordBy: 'key'"},{"type":"text","value":" to intentionally record the produced logical character. A code-mode event with no usable code is rejected rather than silently switching modes. IME composition is ignored. AltGraph character entry is rejected in code mode; key mode preserves the produced character without synthetic Control/Alt while retaining Shift. Recording events, repeats, and their releases do not trigger registered hotkeys or sequences."}]},{"type":"code","value":"useHotkeyRecorder({\n  recordBy: 'code', // default; choose 'key' for logical characters\n  onRecord: (hotkey) => { /* called when a hotkey is recorded */ },\n  onCancel: () => { /* called when recording is cancelled */ },\n  onClear: () => { /* called when the recorded hotkey is cleared */ },\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"onrecord","children":[{"type":"inlineCode","value":"onRecord"}]},{"type":"paragraph","children":[{"type":"text","value":"Called when the user presses a valid key combination (a modifier + a non-modifier key, or a single non-modifier key). Receives the recorded "},{"type":"inlineCode","value":"Hotkey"},{"type":"text","value":" string."}]},{"type":"heading","depth":3,"id":"oncancel","children":[{"type":"inlineCode","value":"onCancel"}]},{"type":"paragraph","children":[{"type":"text","value":"Called when recording is cancelled (either by pressing Escape or calling "},{"type":"inlineCode","value":"cancelRecording()"},{"type":"text","value":")."}]},{"type":"heading","depth":3,"id":"onclear","children":[{"type":"inlineCode","value":"onClear"}]},{"type":"paragraph","children":[{"type":"text","value":"Called when the recorded hotkey is cleared (by pressing Backspace or Delete during recording)."}]},{"type":"heading","depth":3,"id":"global-defaults-via-provider","children":[{"type":"text","value":"Global defaults via provider"}]},{"type":"paragraph","children":[{"type":"text","value":"You can set default options for all "},{"type":"inlineCode","value":"useHotkeyRecorder"},{"type":"text","value":" calls by wrapping your component tree with "},{"type":"inlineCode","value":"HotkeysProvider"},{"type":"text","value":". Per-hook options override the provider defaults."}]},{"type":"code","value":"import { HotkeysProvider } from '@tanstack/preact-hotkeys'\n\n<HotkeysProvider\n  defaultOptions={{\n    hotkeyRecorder: {\n      onCancel: () => console.log('Recording cancelled'),\n    },\n  }}\n>\n  <App />\n</HotkeysProvider>","lang":"tsx"},{"type":"heading","depth":2,"id":"recording-behavior","children":[{"type":"text","value":"Recording behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"The recorder has specific behavior for different keys:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Key"}]},{"type":"tableCell","children":[{"type":"text","value":"Behavior"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Modifier only (Shift, Ctrl, etc.)"}]},{"type":"tableCell","children":[{"type":"text","value":"Waits for a non-modifier key; modifier-only presses don't complete a recording"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Modifier + key (e.g., Ctrl+S)"}]},{"type":"tableCell","children":[{"type":"text","value":"Records the full combination"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Single key (e.g., Escape, F1)"}]},{"type":"tableCell","children":[{"type":"text","value":"Records the single key"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Escape"}]},{"type":"tableCell","children":[{"type":"text","value":"Cancels the recording"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Backspace / Delete"}]},{"type":"tableCell","children":[{"type":"text","value":"Clears the currently recorded hotkey"}]}]]},{"type":"heading","depth":3,"id":"ignoreinputs","children":[{"type":"inlineCode","value":"ignoreInputs"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"HotkeyRecorderOptions"},{"type":"text","value":" supports an "},{"type":"inlineCode","value":"ignoreInputs"},{"type":"text","value":" option (defaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":"). When "},{"type":"inlineCode","value":"true"},{"type":"text","value":", the recorder doesn't intercept normal typing in text inputs, textareas, selects, or contentEditable elements. Keystrokes pass through to the input as usual. Pressing Escape still cancels recording even when focused on an input. Set "},{"type":"inlineCode","value":"ignoreInputs: false"},{"type":"text","value":" if you want the recorder to capture keys from within input elements."}]},{"type":"code","value":"useHotkeyRecorder({\n  ignoreInputs: false, // record even from inside inputs\n  onRecord: (hotkey) => console.log(hotkey),\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"mod-auto-conversion","children":[{"type":"text","value":"Mod auto-conversion"}]},{"type":"paragraph","children":[{"type":"text","value":"Recorded hotkeys automatically use the portable "},{"type":"inlineCode","value":"Mod"},{"type":"text","value":" format. If a user on macOS presses Command+S, the recorded hotkey is "},{"type":"inlineCode","value":"Mod+[KeyS]"},{"type":"text","value":" rather than "},{"type":"inlineCode","value":"Meta+[KeyS]"},{"type":"text","value":", so the shortcut keeps working when it syncs to a machine on another OS."}]},{"type":"heading","depth":2,"id":"validation-and-conflicts","children":[{"type":"text","value":"Validation and conflicts"}]},{"type":"paragraph","children":[{"type":"text","value":"Both recorder APIs accept "},{"type":"inlineCode","value":"detectConflicts"},{"type":"text","value":", "},{"type":"inlineCode","value":"validate"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onReject"},{"type":"text","value":". For a single-hotkey recorder, these options can be supplied alongside "},{"type":"inlineCode","value":"onRecord"},{"type":"text","value":":"}]},{"type":"code","value":"const options = {\n  detectConflicts: {\n    // Use registration IDs to exclude the binding being edited:\n    excludeIds: [registrationId],\n    target: document,\n    eventType: 'keydown',\n  },\n  validate: (_hotkey, { parsedHotkey }) =>\n    parsedHotkey.modifiers.length > 0 || 'Include a modifier.',\n  onReject: ({ reason, message, conflicts }) => {\n    // Show feedback; recording stays active.\n    console.log(reason, message, conflicts)\n  },\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"validate"},{"type":"text","value":" returns true to accept, or false/a message to reject. "},{"type":"inlineCode","value":"onReject"},{"type":"text","value":" receives "},{"type":"inlineCode","value":"reason"},{"type":"text","value":" ("},{"type":"inlineCode","value":"missing-code"},{"type":"text","value":", "},{"type":"inlineCode","value":"alt-graph"},{"type":"text","value":", "},{"type":"inlineCode","value":"invalid"},{"type":"text","value":", "},{"type":"inlineCode","value":"validation"},{"type":"text","value":", or "},{"type":"inlineCode","value":"conflict"},{"type":"text","value":"), a message, the candidate when available, and conflicting registration views for conflict rejections. Validation runs before commit; rejection never falls back to another key identity."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"detectConflicts: true"},{"type":"text","value":" checks enabled live registrations with the intended event type (default keydown) and overlapping targets (default document). Document/nested scopes can conflict; disjoint widgets can reuse a binding. The options object also supports "},{"type":"inlineCode","value":"scope: 'all'"},{"type":"text","value":", "},{"type":"inlineCode","value":"includeDisabled"},{"type":"text","value":", and an "},{"type":"inlineCode","value":"exclude(registration)"},{"type":"text","value":" predicate. Both single bindings and sequence prefixes are checked. Source events detect physical/logical overlap on the recorded layout. This is a conservative collision check, not a promise that two callbacks will execute: propagation, input filtering, match priority, external listeners, unmounted routes, and other layouts can affect actual dispatch."}]},{"type":"paragraph","children":[{"type":"text","value":"For checks outside recording, use "},{"type":"inlineCode","value":"findHotkeyConflicts(bindingOrSequence, options)"},{"type":"text","value":". Without source "},{"type":"inlineCode","value":"events"},{"type":"text","value":", it compares binding identity and sequence prefixes; it does not guess equivalence between a logical character and a physical position."}]},{"type":"heading","depth":2,"id":"building-a-shortcut-settings-ui","children":[{"type":"text","value":"Building a shortcut settings UI"}]},{"type":"paragraph","children":[{"type":"text","value":"Here's a more complete example of a shortcut customization panel:"}]},{"type":"code","value":"import { useState } from 'preact/hooks'\nimport {\n  useHotkey,\n  useHotkeyRecorder,\n  formatForDisplay,\n} from '@tanstack/preact-hotkeys'\nimport type { Hotkey } from '@tanstack/preact-hotkeys'\n\nfunction ShortcutSettings() {\n  const [shortcuts, setShortcuts] = useState<Record<string, Hotkey>>({\n    save: 'Mod+S',\n    undo: 'Mod+Z',\n    search: 'Mod+K',\n  })\n\n  const [editingAction, setEditingAction] = useState<string | null>(null)\n\n  const recorder = useHotkeyRecorder({\n    onRecord: (hotkey) => {\n      if (editingAction) {\n        setShortcuts((prev) => ({ ...prev, [editingAction]: hotkey }))\n        setEditingAction(null)\n      }\n    },\n    onCancel: () => setEditingAction(null),\n  })\n\n  // Register the actual hotkeys with their current bindings\n  useHotkey(shortcuts.save, () => save())\n  useHotkey(shortcuts.undo, () => undo())\n  useHotkey(shortcuts.search, () => openSearch())\n\n  return (\n    <div>\n      <h2>Keyboard Shortcuts</h2>\n      {Object.entries(shortcuts).map(([action, hotkey]) => (\n        <div key={action}>\n          <span>{action}</span>\n          <button\n            onClick={() => {\n              setEditingAction(action)\n              recorder.startRecording()\n            }}\n          >\n            {editingAction === action && recorder.isRecording\n              ? 'Press keys...'\n              : formatForDisplay(hotkey)}\n          </button>\n        </div>\n      ))}\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"under-the-hood","children":[{"type":"text","value":"Under the hood"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"useHotkeyRecorder"},{"type":"text","value":" hook creates a "},{"type":"inlineCode","value":"HotkeyRecorder"},{"type":"text","value":" class instance and subscribes to its reactive state via "},{"type":"inlineCode","value":"@tanstack/preact-store"},{"type":"text","value":". The class manages its own keyboard event listeners and state, and the hook handles cleanup on unmount."}]}],"headings":[{"id":"basic-usage","text":"Basic usage","level":2},{"id":"return-value","text":"Return value","level":2},{"id":"options","text":"Options","level":2},{"id":"recordby","text":"recordBy","level":3},{"id":"onrecord","text":"onRecord","level":3},{"id":"oncancel","text":"onCancel","level":3},{"id":"onclear","text":"onClear","level":3},{"id":"global-defaults-via-provider","text":"Global defaults via provider","level":3},{"id":"recording-behavior","text":"Recording behavior","level":2},{"id":"ignoreinputs","text":"ignoreInputs","level":3},{"id":"mod-auto-conversion","text":"Mod auto-conversion","level":3},{"id":"validation-and-conflicts","text":"Validation and conflicts","level":2},{"id":"building-a-shortcut-settings-ui","text":"Building a shortcut settings UI","level":2},{"id":"under-the-hood","text":"Under the hood","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Hotkeys includes the `useHotkeyRecorder` hook for building keyboard shortcut customization UIs. Users record their own shortcuts by pressing the desired key combination, the same way system preferences or IDE shortcut editors work.\n\nRecorders default to physical codes: recording a shortcut stores a string such as `Mod+[KeyS]`. Pass it directly to your hotkey registration and use `formatForDisplay` for the label. Set `recordBy: 'key'` when you intentionally want the produced character instead.\n\nTanStack Hotkeys automatically suppresses registered hotkey and sequence callbacks while any recorder is active. You do not need to set `enabled` from `isRecording`. Registrations remain available for conflict detection, and recorded keys stay suppressed through repeats and key release.\n\n## Basic usage\n\n```tsx\nimport { useHotkeyRecorder, formatForDisplay } from '@tanstack/preact-hotkeys'\n\nfunction ShortcutRecorder() {\n  const { isRecording, recordedHotkey, startRecording, stopRecording, cancelRecording } =\n    useHotkeyRecorder({\n      onRecord: (hotkey) => {\n        console.log('Recorded:', hotkey) // e.g., \"Mod+Shift+[KeyS]\"\n      },\n    })\n\n  return (\n    <div>\n      <button onClick={isRecording ? stopRecording : startRecording}>\n        {isRecording\n          ? 'Press a key combination...'\n          : recordedHotkey\n            ? formatForDisplay(recordedHotkey)\n            : 'Click to record'}\n      </button>\n      {isRecording && (\n        <button onClick={cancelRecording}>Cancel</button>\n      )}\n    </div>\n  )\n}\n```\n\n## Return value\n\nThe `useHotkeyRecorder` hook returns an object with:\n\n| Property | Type | Description |\n|----------|------|-------------|\n| `isRecording` | `boolean` | Whether the recorder is currently listening for key presses |\n| `recordedHotkey` | `Hotkey \\| null` | The last recorded hotkey string, or `null` if nothing recorded |\n| `startRecording` | `() => void` | Start listening for key presses |\n| `stopRecording` | `() => void` | Stop listening and reset recorder state without calling `onRecord` |\n| `cancelRecording` | `() => void` | Stop listening and discard any recorded hotkey |\n\n## Options\n\n### `recordBy`\n\nRecorders default to `recordBy: 'code'`. Option+S producing `ß` on macOS records `Alt+[KeyS]`; Option+2 producing `™` records `Alt+[Digit2]`. The stored brackets preserve physical identity through state, serialization, and registration; `formatForDisplay` produces a readable label. There is no code-to-letter conversion. Existing authored strings such as `Mod+S` remain logical bindings.\n\nSet `recordBy: 'key'` to intentionally record the produced logical character. A code-mode event with no usable code is rejected rather than silently switching modes. IME composition is ignored. AltGraph character entry is rejected in code mode; key mode preserves the produced character without synthetic Control/Alt while retaining Shift. Recording events, repeats, and their releases do not trigger registered hotkeys or sequences.\n\n```tsx\nuseHotkeyRecorder({\n  recordBy: 'code', // default; choose 'key' for logical characters\n  onRecord: (hotkey) => { /* called when a hotkey is recorded */ },\n  onCancel: () => { /* called when recording is cancelled */ },\n  onClear: () => { /* called when the recorded hotkey is cleared */ },\n})\n```\n\n### `onRecord`\n\nCalled when the user presses a valid key combination (a modifier + a non-modifier key, or a single non-modifier key). Receives the recorded `Hotkey` string.\n\n### `onCancel`\n\nCalled when recording is cancelled (either by pressing Escape or calling `cancelRecording()`).\n\n### `onClear`\n\nCalled when the recorded hotkey is cleared (by pressing Backspace or Delete during recording).\n\n### Global defaults via provider\n\nYou can set default options for all `useHotkeyRecorder` calls by wrapping your component tree with `HotkeysProvider`. Per-hook options override the provider defaults.\n\n```tsx\nimport { HotkeysProvider } from '@tanstack/preact-hotkeys'\n\n<HotkeysProvider\n  defaultOptions={{\n    hotkeyRecorder: {\n      onCancel: () => console.log('Recording cancelled'),\n    },\n  }}\n>\n  <App />\n</HotkeysProvider>\n```\n\n## Recording behavior\n\nThe recorder has specific behavior for different keys:\n\n| Key | Behavior |\n|-----|----------|\n| Modifier only (Shift, Ctrl, etc.) | Waits for a non-modifier key; modifier-only presses don't complete a recording |\n| Modifier + key (e.g., Ctrl+S) | Records the full combination |\n| Single key (e.g., Escape, F1) | Records the single key |\n| Escape | Cancels the recording |\n| Backspace / Delete | Clears the currently recorded hotkey |\n\n### `ignoreInputs`\n\nThe `HotkeyRecorderOptions` supports an `ignoreInputs` option (defaults to `true`). When `true`, the recorder doesn't intercept normal typing in text inputs, textareas, selects, or contentEditable elements. Keystrokes pass through to the input as usual. Pressing Escape still cancels recording even when focused on an input. Set `ignoreInputs: false` if you want the recorder to capture keys from within input elements.\n\n```tsx\nuseHotkeyRecorder({\n  ignoreInputs: false, // record even from inside inputs\n  onRecord: (hotkey) => console.log(hotkey),\n})\n```\n\n### Mod auto-conversion\n\nRecorded hotkeys automatically use the portable `Mod` format. If a user on macOS presses Command+S, the recorded hotkey is `Mod+[KeyS]` rather than `Meta+[KeyS]`, so the shortcut keeps working when it syncs to a machine on another OS.\n\n## Validation and conflicts\n\nBoth recorder APIs accept `detectConflicts`, `validate`, and `onReject`. For a single-hotkey recorder, these options can be supplied alongside `onRecord`:\n\n```ts\nconst options = {\n  detectConflicts: {\n    // Use registration IDs to exclude the binding being edited:\n    excludeIds: [registrationId],\n    target: document,\n    eventType: 'keydown',\n  },\n  validate: (_hotkey, { parsedHotkey }) =>\n    parsedHotkey.modifiers.length > 0 || 'Include a modifier.',\n  onReject: ({ reason, message, conflicts }) => {\n    // Show feedback; recording stays active.\n    console.log(reason, message, conflicts)\n  },\n}\n```\n\n`validate` returns true to accept, or false/a message to reject. `onReject` receives `reason` (`missing-code`, `alt-graph`, `invalid`, `validation`, or `conflict`), a message, the candidate when available, and conflicting registration views for conflict rejections. Validation runs before commit; rejection never falls back to another key identity.\n\n`detectConflicts: true` checks enabled live registrations with the intended event type (default keydown) and overlapping targets (default document). Document/nested scopes can conflict; disjoint widgets can reuse a binding. The options object also supports `scope: 'all'`, `includeDisabled`, and an `exclude(registration)` predicate. Both single bindings and sequence prefixes are checked. Source events detect physical/logical overlap on the recorded layout. This is a conservative collision check, not a promise that two callbacks will execute: propagation, input filtering, match priority, external listeners, unmounted routes, and other layouts can affect actual dispatch.\n\nFor checks outside recording, use `findHotkeyConflicts(bindingOrSequence, options)`. Without source `events`, it compares binding identity and sequence prefixes; it does not guess equivalence between a logical character and a physical position.\n\n## Building a shortcut settings UI\n\nHere's a more complete example of a shortcut customization panel:\n\n```tsx\nimport { useState } from 'preact/hooks'\nimport {\n  useHotkey,\n  useHotkeyRecorder,\n  formatForDisplay,\n} from '@tanstack/preact-hotkeys'\nimport type { Hotkey } from '@tanstack/preact-hotkeys'\n\nfunction ShortcutSettings() {\n  const [shortcuts, setShortcuts] = useState<Record<string, Hotkey>>({\n    save: 'Mod+S',\n    undo: 'Mod+Z',\n    search: 'Mod+K',\n  })\n\n  const [editingAction, setEditingAction] = useState<string | null>(null)\n\n  const recorder = useHotkeyRecorder({\n    onRecord: (hotkey) => {\n      if (editingAction) {\n        setShortcuts((prev) => ({ ...prev, [editingAction]: hotkey }))\n        setEditingAction(null)\n      }\n    },\n    onCancel: () => setEditingAction(null),\n  })\n\n  // Register the actual hotkeys with their current bindings\n  useHotkey(shortcuts.save, () => save())\n  useHotkey(shortcuts.undo, () => undo())\n  useHotkey(shortcuts.search, () => openSearch())\n\n  return (\n    <div>\n      <h2>Keyboard Shortcuts</h2>\n      {Object.entries(shortcuts).map(([action, hotkey]) => (\n        <div key={action}>\n          <span>{action}</span>\n          <button\n            onClick={() => {\n              setEditingAction(action)\n              recorder.startRecording()\n            }}\n          >\n            {editingAction === action && recorder.isRecording\n              ? 'Press keys...'\n              : formatForDisplay(hotkey)}\n          </button>\n        </div>\n      ))}\n    </div>\n  )\n}\n```\n\n## Under the hood\n\nThe `useHotkeyRecorder` hook creates a `HotkeyRecorder` class instance and subscribes to its reactive state via `@tanstack/preact-store`. The class manages its own keyboard event listeners and state, and the hook handles cleanup on unmount.\n","originalRawMarkdown":"---\ntitle: Hotkey Recording Guide\nid: hotkey-recording\n---\n\nTanStack Hotkeys includes the `useHotkeyRecorder` hook for building keyboard shortcut customization UIs. Users record their own shortcuts by pressing the desired key combination, the same way system preferences or IDE shortcut editors work.\n\nRecorders default to physical codes: recording a shortcut stores a string such as `Mod+[KeyS]`. Pass it directly to your hotkey registration and use `formatForDisplay` for the label. Set `recordBy: 'key'` when you intentionally want the produced character instead.\n\nTanStack Hotkeys automatically suppresses registered hotkey and sequence callbacks while any recorder is active. You do not need to set `enabled` from `isRecording`. Registrations remain available for conflict detection, and recorded keys stay suppressed through repeats and key release.\n\n## Basic usage\n\n```tsx\nimport { useHotkeyRecorder, formatForDisplay } from '@tanstack/preact-hotkeys'\n\nfunction ShortcutRecorder() {\n  const { isRecording, recordedHotkey, startRecording, stopRecording, cancelRecording } =\n    useHotkeyRecorder({\n      onRecord: (hotkey) => {\n        console.log('Recorded:', hotkey) // e.g., \"Mod+Shift+[KeyS]\"\n      },\n    })\n\n  return (\n    <div>\n      <button onClick={isRecording ? stopRecording : startRecording}>\n        {isRecording\n          ? 'Press a key combination...'\n          : recordedHotkey\n            ? formatForDisplay(recordedHotkey)\n            : 'Click to record'}\n      </button>\n      {isRecording && (\n        <button onClick={cancelRecording}>Cancel</button>\n      )}\n    </div>\n  )\n}\n```\n\n## Return value\n\nThe `useHotkeyRecorder` hook returns an object with:\n\n| Property | Type | Description |\n|----------|------|-------------|\n| `isRecording` | `boolean` | Whether the recorder is currently listening for key presses |\n| `recordedHotkey` | `Hotkey \\| null` | The last recorded hotkey string, or `null` if nothing recorded |\n| `startRecording` | `() => void` | Start listening for key presses |\n| `stopRecording` | `() => void` | Stop listening and reset recorder state without calling `onRecord` |\n| `cancelRecording` | `() => void` | Stop listening and discard any recorded hotkey |\n\n## Options\n\n### `recordBy`\n\nRecorders default to `recordBy: 'code'`. Option+S producing `ß` on macOS records `Alt+[KeyS]`; Option+2 producing `™` records `Alt+[Digit2]`. The stored brackets preserve physical identity through state, serialization, and registration; `formatForDisplay` produces a readable label. There is no code-to-letter conversion. Existing authored strings such as `Mod+S` remain logical bindings.\n\nSet `recordBy: 'key'` to intentionally record the produced logical character. A code-mode event with no usable code is rejected rather than silently switching modes. IME composition is ignored. AltGraph character entry is rejected in code mode; key mode preserves the produced character without synthetic Control/Alt while retaining Shift. Recording events, repeats, and their releases do not trigger registered hotkeys or sequences.\n\n```tsx\nuseHotkeyRecorder({\n  recordBy: 'code', // default; choose 'key' for logical characters\n  onRecord: (hotkey) => { /* called when a hotkey is recorded */ },\n  onCancel: () => { /* called when recording is cancelled */ },\n  onClear: () => { /* called when the recorded hotkey is cleared */ },\n})\n```\n\n### `onRecord`\n\nCalled when the user presses a valid key combination (a modifier + a non-modifier key, or a single non-modifier key). Receives the recorded `Hotkey` string.\n\n### `onCancel`\n\nCalled when recording is cancelled (either by pressing Escape or calling `cancelRecording()`).\n\n### `onClear`\n\nCalled when the recorded hotkey is cleared (by pressing Backspace or Delete during recording).\n\n### Global defaults via provider\n\nYou can set default options for all `useHotkeyRecorder` calls by wrapping your component tree with `HotkeysProvider`. Per-hook options override the provider defaults.\n\n```tsx\nimport { HotkeysProvider } from '@tanstack/preact-hotkeys'\n\n<HotkeysProvider\n  defaultOptions={{\n    hotkeyRecorder: {\n      onCancel: () => console.log('Recording cancelled'),\n    },\n  }}\n>\n  <App />\n</HotkeysProvider>\n```\n\n## Recording behavior\n\nThe recorder has specific behavior for different keys:\n\n| Key | Behavior |\n|-----|----------|\n| Modifier only (Shift, Ctrl, etc.) | Waits for a non-modifier key; modifier-only presses don't complete a recording |\n| Modifier + key (e.g., Ctrl+S) | Records the full combination |\n| Single key (e.g., Escape, F1) | Records the single key |\n| Escape | Cancels the recording |\n| Backspace / Delete | Clears the currently recorded hotkey |\n\n### `ignoreInputs`\n\nThe `HotkeyRecorderOptions` supports an `ignoreInputs` option (defaults to `true`). When `true`, the recorder doesn't intercept normal typing in text inputs, textareas, selects, or contentEditable elements. Keystrokes pass through to the input as usual. Pressing Escape still cancels recording even when focused on an input. Set `ignoreInputs: false` if you want the recorder to capture keys from within input elements.\n\n```tsx\nuseHotkeyRecorder({\n  ignoreInputs: false, // record even from inside inputs\n  onRecord: (hotkey) => console.log(hotkey),\n})\n```\n\n### Mod auto-conversion\n\nRecorded hotkeys automatically use the portable `Mod` format. If a user on macOS presses Command+S, the recorded hotkey is `Mod+[KeyS]` rather than `Meta+[KeyS]`, so the shortcut keeps working when it syncs to a machine on another OS.\n\n## Validation and conflicts\n\nBoth recorder APIs accept `detectConflicts`, `validate`, and `onReject`. For a single-hotkey recorder, these options can be supplied alongside `onRecord`:\n\n```ts\nconst options = {\n  detectConflicts: {\n    // Use registration IDs to exclude the binding being edited:\n    excludeIds: [registrationId],\n    target: document,\n    eventType: 'keydown',\n  },\n  validate: (_hotkey, { parsedHotkey }) =>\n    parsedHotkey.modifiers.length > 0 || 'Include a modifier.',\n  onReject: ({ reason, message, conflicts }) => {\n    // Show feedback; recording stays active.\n    console.log(reason, message, conflicts)\n  },\n}\n```\n\n`validate` returns true to accept, or false/a message to reject. `onReject` receives `reason` (`missing-code`, `alt-graph`, `invalid`, `validation`, or `conflict`), a message, the candidate when available, and conflicting registration views for conflict rejections. Validation runs before commit; rejection never falls back to another key identity.\n\n`detectConflicts: true` checks enabled live registrations with the intended event type (default keydown) and overlapping targets (default document). Document/nested scopes can conflict; disjoint widgets can reuse a binding. The options object also supports `scope: 'all'`, `includeDisabled`, and an `exclude(registration)` predicate. Both single bindings and sequence prefixes are checked. Source events detect physical/logical overlap on the recorded layout. This is a conservative collision check, not a promise that two callbacks will execute: propagation, input filtering, match priority, external listeners, unmounted routes, and other layouts can affect actual dispatch.\n\nFor checks outside recording, use `findHotkeyConflicts(bindingOrSequence, options)`. Without source `events`, it compares binding identity and sequence prefixes; it does not guess equivalence between a logical character and a physical position.\n\n## Building a shortcut settings UI\n\nHere's a more complete example of a shortcut customization panel:\n\n```tsx\nimport { useState } from 'preact/hooks'\nimport {\n  useHotkey,\n  useHotkeyRecorder,\n  formatForDisplay,\n} from '@tanstack/preact-hotkeys'\nimport type { Hotkey } from '@tanstack/preact-hotkeys'\n\nfunction ShortcutSettings() {\n  const [shortcuts, setShortcuts] = useState<Record<string, Hotkey>>({\n    save: 'Mod+S',\n    undo: 'Mod+Z',\n    search: 'Mod+K',\n  })\n\n  const [editingAction, setEditingAction] = useState<string | null>(null)\n\n  const recorder = useHotkeyRecorder({\n    onRecord: (hotkey) => {\n      if (editingAction) {\n        setShortcuts((prev) => ({ ...prev, [editingAction]: hotkey }))\n        setEditingAction(null)\n      }\n    },\n    onCancel: () => setEditingAction(null),\n  })\n\n  // Register the actual hotkeys with their current bindings\n  useHotkey(shortcuts.save, () => save())\n  useHotkey(shortcuts.undo, () => undo())\n  useHotkey(shortcuts.search, () => openSearch())\n\n  return (\n    <div>\n      <h2>Keyboard Shortcuts</h2>\n      {Object.entries(shortcuts).map(([action, hotkey]) => (\n        <div key={action}>\n          <span>{action}</span>\n          <button\n            onClick={() => {\n              setEditingAction(action)\n              recorder.startRecording()\n            }}\n          >\n            {editingAction === action && recorder.isRecording\n              ? 'Press keys...'\n              : formatForDisplay(hotkey)}\n          </button>\n        </div>\n      ))}\n    </div>\n  )\n}\n```\n\n## Under the hood\n\nThe `useHotkeyRecorder` hook creates a `HotkeyRecorder` class instance and subscribes to its reactive state via `@tanstack/preact-store`. The class manages its own keyboard event listeners and state, and the hook handles cleanup on unmount.\n"}
