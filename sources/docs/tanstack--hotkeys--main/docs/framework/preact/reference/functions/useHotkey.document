:"text","value":" = "},{"type":"inlineCode","value":"{}"}]},{"type":"paragraph","children":[{"type":"text","value":"Options for the hotkey behavior. "},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":" keeps the registration (visible in devtools)\nand only suppresses firing; the hook updates the existing handle instead of unregistering."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"function SaveButton() {\n  const [count, setCount] = useState(0)\n\n  // Callback always has access to latest count value\n  useHotkey('Mod+S', (event, { hotkey }) => {\n    console.log(`Save triggered, count is ${count}`)\n    handleSave()\n  })\n\n  return <button onClick={() => setCount(c => c + 1)}>Count: {count}</button>\n}","lang":"tsx"},{"type":"code","value":"function Modal({ isOpen, onClose }) {\n  // enabled option is synced on every render\n  useHotkey('Escape', () => {\n    onClose()\n  }, { enabled: isOpen })\n\n  if (!isOpen) return null\n  return <div className=\"modal\">...</div>\n}","lang":"tsx"},{"type":"code","value":"function Editor() {\n  const editorRef = useRef<HTMLDivElement>(null)\n\n  // Scoped to a specific element\n  useHotkey('Mod+S', () => {\n    save()\n  }, { target: editorRef })\n\n  return <div ref={editorRef}>...</div>\n}","lang":"tsx"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"hotkey","text":"hotkey","level":3},{"id":"callback","text":"callback","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useHotkey(\n   hotkey, \n   callback, \n   options?): void;\n```\n\nDefined in: [useHotkey.ts:86](https://github.com/TanStack/hotkeys/blob/main/packages/preact-hotkeys/src/useHotkey.ts#L86)\n\nPreact hook for registering a keyboard hotkey.\n\nUses the singleton HotkeyManager for efficient event handling.\nThe callback receives both the keyboard event and a context object\ncontaining the hotkey string and parsed hotkey.\n\nThis hook syncs the callback and options on every render to avoid\nstale closures. This means\ncallbacks that reference Preact state will always have access to\nthe latest values.\n\n## Parameters\n\n### hotkey\n\n`RegisterableHotkey`\n\nThe hotkey string (e.g., 'Mod+S', 'Escape') or RawHotkey object (supports `mod` for cross-platform)\n\n### callback\n\n`HotkeyCallback`\n\nThe function to call when the hotkey is pressed\n\n### options?\n\n[`UseHotkeyOptions`](../interfaces/UseHotkeyOptions.md) = `{}`\n\nOptions for the hotkey behavior. `enabled: false` keeps the registration (visible in devtools)\n  and only suppresses firing; the hook updates the existing handle instead of unregistering.\n\n## Returns\n\n`void`\n\n## Examples\n\n```tsx\nfunction SaveButton() {\n  const [count, setCount] = useState(0)\n\n  // Callback always has access to latest count value\n  useHotkey('Mod+S', (event, { hotkey }) => {\n    console.log(`Save triggered, count is ${count}`)\n    handleSave()\n  })\n\n  return <button onClick={() => setCount(c => c + 1)}>Count: {count}</button>\n}\n```\n\n```tsx\nfunction Modal({ isOpen, onClose }) {\n  // enabled option is synced on every render\n  useHotkey('Escape', () => {\n    onClose()\n  }, { enabled: isOpen })\n\n  if (!isOpen) return null\n  return <div className=\"modal\">...</div>\n}\n```\n\n```tsx\nfunction Editor() {\n  const editorRef = useRef<HTMLDivElement>(null)\n\n  // Scoped to a specific element\n  useHotkey('Mod+S', () => {\n    save()\n  }, { target: editorRef })\n\n  return <div ref={editorRef}>...</div>\n}\n```\n","originalRawMarkdown":"---\nid: useHotkey\ntitle: useHotkey\n---\n\n```ts\nfunction useHotkey(\n   hotkey, \n   callback, \n   options?): void;\n```\n\nDefined in: [useHotkey.ts:86](https://github.com/TanStack/hotkeys/blob/main/packages/preact-hotkeys/src/useHotkey.ts#L86)\n\nPreact hook for registering a keyboard hotkey.\n\nUses the singleton HotkeyManager for efficient event handling.\nThe callback receives both the keyboard event and a context object\ncontaining the hotkey string and parsed hotkey.\n\nThis hook syncs the callback and options on every render to avoid\nstale closures. This means\ncallbacks that reference Preact state will always have access to\nthe latest values.\n\n## Parameters\n\n### hotkey\n\n`RegisterableHotkey`\n\nThe hotkey string (e.g., 'Mod+S', 'Escape') or RawHotkey object (supports `mod` for cross-platform)\n\n### callback\n\n`HotkeyCallback`\n\nThe function to call when the hotkey is pressed\n\n### options?\n\n[`UseHotkeyOptions`](../interfaces/UseHotkeyOptions.md) = `{}`\n\nOptions for the hotkey behavior. `enabled: false` keeps the registration (visible in devtools)\n  and only suppresses firing; the hook updates the existing handle instead of unregistering.\n\n## Returns\n\n`void`\n\n## Examples\n\n```tsx\nfunction SaveButton() {\n  const [count, setCount] = useState(0)\n\n  // Callback always has access to latest count value\n  useHotkey('Mod+S', (event, { hotkey }) => {\n    console.log(`Save triggered, count is ${count}`)\n    handleSave()\n  })\n\n  return <button onClick={() => setCount(c => c + 1)}>Count: {count}</button>\n}\n```\n\n```tsx\nfunction Modal({ isOpen, onClose }) {\n  // enabled option is synced on every render\n  useHotkey('Escape', () => {\n    onClose()\n  }, { enabled: isOpen })\n\n  if (!isOpen) return null\n  return <div className=\"modal\">...</div>\n}\n```\n\n```tsx\nfunction Editor() {\n  const editorRef = useRef<HTMLDivElement>(null)\n\n  // Scoped to a specific element\n  useHotkey('Mod+S', () => {\n    save()\n  }, { target: editorRef })\n\n  return <div ref={editorRef}>...</div>\n}\n```\n"}
