\n  return <div>Editor with keyboard shortcuts</div>\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"scoped-hotkeys-with-refs","children":[{"type":"text","value":"Scoped hotkeys with refs"}]},{"type":"paragraph","children":[{"type":"text","value":"Attach hotkeys to specific elements instead of the entire document:"}]},{"type":"code","value":"import { useRef } from 'react'\nimport { useHotkey } from '@tanstack/react-hotkeys'\n\nfunction Panel() {\n  const panelRef = useRef<HTMLDivElement>(null)\n\n  // This hotkey only fires when the panel (or its children) has focus\n  useHotkey('Escape', () => closePanel(), { target: panelRef })\n\n  return (\n    <div ref={panelRef} tabIndex={0}>\n      <p>Press Escape while focused here to close</p>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"conditional-hotkeys","children":[{"type":"text","value":"Conditional hotkeys"}]},{"type":"paragraph","children":[{"type":"text","value":"Enable or disable hotkeys based on application state:"}]},{"type":"code","value":"function Modal({ isOpen, onClose }: { isOpen: boolean; onClose: () => void }) {\n  useHotkey('Escape', () => onClose(), { enabled: isOpen })\n\n  if (!isOpen) return null\n\n  return (\n    <div className=\"modal\">\n      <p>Press Escape to close</p>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"multi-key-sequences","children":[{"type":"text","value":"Multi-key sequences"}]},{"type":"paragraph","children":[{"type":"text","value":"Register Vim-style key sequences with "},{"type":"inlineCode","value":"useHotkeySequence"},{"type":"text","value":":"}]},{"type":"code","value":"import { useHotkeySequence } from '@tanstack/react-hotkeys'\n\nfunction VimStyleApp() {\n  useHotkeySequence(['G', 'G'], () => scrollToTop())\n  useHotkeySequence(['G', 'Shift+G'], () => scrollToBottom())\n\n  return <div>Use gg to go to top, gG to go to bottom</div>\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"tracking-held-keys","children":[{"type"