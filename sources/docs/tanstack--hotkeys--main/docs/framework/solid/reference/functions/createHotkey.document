./interfaces/CreateHotkeyOptions.md","children":[{"type":"inlineCode","value":"CreateHotkeyOptions"}]},{"type":"text","value":"\n| (() => "},{"type":"link","href":"../interfaces/CreateHotkeyOptions.md","children":[{"type":"inlineCode","value":"CreateHotkeyOptions"}]},{"type":"text","value":")"}]},{"type":"paragraph","children":[{"type":"text","value":"Options for the hotkey behavior"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"function SaveButton() {\n  const [count, setCount] = createSignal(0)\n\n  // Callback always has access to latest count value\n  createHotkey('Mod+S', (event, { hotkey }) => {\n    console.log(`Save triggered, count is ${count()}`)\n    handleSave()\n  })\n\n  return <button onClick={() => setCount(c => c + 1)}>Count: {count()}</button>\n}","lang":"tsx"},{"type":"code","value":"function Modal(props) {\n  // enabled option is reactive\n  createHotkey('Escape', () => {\n    props.onClose()\n  }, () => ({ enabled: props.isOpen }))\n\n  return <Show when={props.isOpen}>\n    <div class=\"modal\">...</div>\n  </Show>\n}","lang":"tsx"},{"type":"code","value":"function Editor() {\n  const [editorRef, setEditorRef] = createSignal<HTMLDivElement | null>(null)\n\n  // Scoped to a specific element - use accessor so hotkey waits for ref\n  createHotkey('Mod+S', save, () => ({ target: editorRef() }))\n\n  return <div ref={setEditorRef}>...</div>\n}","lang":"tsx"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"hotkey","text":"hotkey","level":3},{"id":"callback","text":"callback","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createHotkey(\n   hotkey, \n   callback, \n   options?): void;\n```\n\nDefined in: [createHotkey.ts:82](https://github.com/TanStack/hotkeys/blob/main/packages/solid-hotkeys/src/createHotkey.ts#L82)\n\nSolidJS primitive for registering a keyboard hotkey.\n\nUses the singleton HotkeyManager for efficient event handling.\nThe callback receives both the keyboard event and a context object\ncontaining the hotkey string and parsed hotkey.\n\nThis primitive automatically tracks reactive dependencies and updates\nthe registration when options or the callback change.\n\n## Parameters\n\n### hotkey\n\n`RegisterableHotkey` \\| (() => `RegisterableHotkey`)\n\nThe hotkey string (e.g., 'Mod+S', 'Escape') or RawHotkey object (supports `mod` for cross-platform)\n\n### callback\n\n`HotkeyCallback`\n\nThe function to call when the hotkey is pressed\n\n### options?\n\n  \\| [`CreateHotkeyOptions`](../interfaces/CreateHotkeyOptions.md)\n  \\| (() => [`CreateHotkeyOptions`](../interfaces/CreateHotkeyOptions.md))\n\nOptions for the hotkey behavior\n\n## Returns\n\n`void`\n\n## Examples\n\n```tsx\nfunction SaveButton() {\n  const [count, setCount] = createSignal(0)\n\n  // Callback always has access to latest count value\n  createHotkey('Mod+S', (event, { hotkey }) => {\n    console.log(`Save triggered, count is ${count()}`)\n    handleSave()\n  })\n\n  return <button onClick={() => setCount(c => c + 1)}>Count: {count()}</button>\n}\n```\n\n```tsx\nfunction Modal(props) {\n  // enabled option is reactive\n  createHotkey('Escape', () => {\n    props.onClose()\n  }, () => ({ enabled: props.isOpen }))\n\n  return <Show when={props.isOpen}>\n    <div class=\"modal\">...</div>\n  </Show>\n}\n```\n\n```tsx\nfunction Editor() {\n  const [editorRef, setEditorRef] = createSignal<HTMLDivElement | null>(null)\n\n  // Scoped to a specific element - use accessor so hotkey waits for ref\n  createHotkey('Mod+S', save, () => ({ target: editorRef() }))\n\n  return <div ref={setEditorRef}>...</div>\n}\n```\n","originalRawMarkdown":"---\nid: createHotkey\ntitle: createHotkey\n---\n\n```ts\nfunction createHotkey(\n   hotkey, \n   callback, \n   options?): void;\n```\n\nDefined in: [createHotkey.ts:82](https://github.com/TanStack/hotkeys/blob/main/packages/solid-hotkeys/src/createHotkey.ts#L82)\n\nSolidJS primitive for registering a keyboard hotkey.\n\nUses the singleton HotkeyManager for efficient event handling.\nThe callback receives both the keyboard event and a context object\ncontaining the hotkey string and parsed hotkey.\n\nThis primitive automatically tracks reactive dependencies and updates\nthe registration when options or the callback change.\n\n## Parameters\n\n### hotkey\n\n`RegisterableHotkey` \\| (() => `RegisterableHotkey`)\n\nThe hotkey string (e.g., 'Mod+S', 'Escape') or RawHotkey object (supports `mod` for cross-platform)\n\n### callback\n\n`HotkeyCallback`\n\nThe function to call when the hotkey is pressed\n\n### options?\n\n  \\| [`CreateHotkeyOptions`](../interfaces/CreateHotkeyOptions.md)\n  \\| (() => [`CreateHotkeyOptions`](../interfaces/CreateHotkeyOptions.md))\n\nOptions for the hotkey behavior\n\n## Returns\n\n`void`\n\n## Examples\n\n```tsx\nfunction SaveButton() {\n  const [count, setCount] = createSignal(0)\n\n  // Callback always has access to latest count value\n  createHotkey('Mod+S', (event, { hotkey }) => {\n    console.log(`Save triggered, count is ${count()}`)\n    handleSave()\n  })\n\n  return <button onClick={() => setCount(c => c + 1)}>Count: {count()}</button>\n}\n```\n\n```tsx\nfunction Modal(props) {\n  // enabled option is reactive\n  createHotkey('Escape', () => {\n    props.onClose()\n  }, () => ({ enabled: props.isOpen }))\n\n  return <Show when={props.isOpen}>\n    <div class=\"modal\">...</div>\n  </Show>\n}\n```\n\n```tsx\nfunction Editor() {\n  const [editorRef, setEditorRef] = createSignal<HTMLDivElement | null>(null)\n\n  // Scoped to a specific element - use accessor so hotkey waits for ref\n  createHotkey('Mod+S', save, () => ({ target: editorRef() }))\n\n  return <div ref={setEditorRef}>...</div>\n}\n```\n"}
