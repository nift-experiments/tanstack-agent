:"Hotkey Recording Guide"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/sequence-recording","children":[{"type":"text","value":"Sequence Recording Guide"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/key-state-tracking","children":[{"type":"text","value":"Key State Tracking Guide"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/formatting-display","children":[{"type":"text","value":"Formatting & Display Guide"}]}]}]}]},{"type":"heading","depth":2,"id":"devtools","children":[{"type":"text","value":"Devtools"}]},{"type":"paragraph","children":[{"type":"text","value":"Install the optional devtools packages to inspect registrations, held keys, and trigger counts:"}]},{"type":"code","value":"npm install @tanstack/svelte-devtools @tanstack/svelte-hotkeys-devtools","lang":"sh"},{"type":"paragraph","children":[{"type":"text","value":"Follow the "},{"type":"link","href":"../../devtools","children":[{"type":"text","value":"devtools setup guide"}]},{"type":"text","value":" to add the dock to your application."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"your-first-hotkey","text":"Your first hotkey","level":2},{"id":"common-patterns","text":"Common patterns","level":2},{"id":"multiple-global-hotkeys","text":"Multiple global hotkeys","level":3},{"id":"scoped-hotkeys-with-attachments","text":"Scoped hotkeys with attachments","level":3},{"id":"reactive-options","text":"Reactive options","level":3},{"id":"scoped-sequences","text":"Scoped sequences","level":3},{"id":"tracking-held-keys","text":"Tracking held keys","level":3},{"id":"recording-shortcuts","text":"Recording shortcuts","level":3},{"id":"displaying-hotkeys-in-the-ui","text":"Displaying hotkeys in the UI","level":3},{"id":"default-options","text":"Default options","level":2},{"id":"next-steps","text":"Next steps","level":2},{"id":"devtools","text":"Devtools","level":2}]},"frameworks":[],"downloadMarkdown":"\n## Installation\n\nDon't have TanStack Hotkeys installed yet? See the [Installation](../../installation) page for instructions.\n\n## Your first hotkey\n\nUse `createHotkey` for global shortcuts and attachments for element-scoped shortcuts.\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkey } from '@tanstack/svelte-hotkeys'\n\n  createHotkey('Mod+S', () => {\n    saveDocument()\n  })\n</script>\n\n<div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>\n```\n\nThe `Mod` modifier automatically resolves to `Meta` (Command) on macOS and `Control` on Windows/Linux, so your shortcuts work across platforms without extra logic.\n\n## Common patterns\n\n### Multiple global hotkeys\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkey } from '@tanstack/svelte-hotkeys'\n\n  createHotkey('Mod+S', () => save())\n  createHotkey('Mod+Z', () => undo())\n  createHotkey('Mod+Shift+Z', () => redo())\n  createHotkey('Mod+F', () => openSearch())\n  createHotkey('Escape', () => closeDialog())\n</script>\n```\n\n### Scoped hotkeys with attachments\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkeyAttachment } from '@tanstack/svelte-hotkeys'\n\n  const closePanel = createHotkeyAttachment('Escape', () => {\n    close()\n  })\n</script>\n\n<div tabindex=\"0\" {@attach closePanel}>\n  <p>Press Escape while focused here to close</p>\n</div>\n```\n\n### Reactive options\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkey } from '@tanstack/svelte-hotkeys'\n\n  let isOpen = $state(true)\n\n  createHotkey(\n    'Escape',\n    () => {\n      isOpen = false\n    },\n    () => ({ enabled: isOpen }),\n  )\n</script>\n```\n\n### Scoped sequences\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkeySequenceAttachment } from '@tanstack/svelte-hotkeys'\n\n  const vimKeys = createHotkeySequenceAttachment(['G', 'G'], () => {\n    scrollToTop()\n  })\n</script>\n\n<div tabindex=\"0\" {@attach vimKeys}>\n  Focus here, then press g then g\n</div>\n```\n\n### Tracking held keys\n\n```svelte\n<script lang=\"ts\">\n  import { getHeldKeys, getIsKeyHeld } from '@tanstack/svelte-hotkeys'\n\n  const heldKeys = getHeldKeys()\n  const isShiftHeld = getIsKeyHeld('Shift')\n</script>\n\n<div class=\"status-bar\">\n  {#if isShiftHeld.held}<span>Shift mode active</span>{/if}\n  {#if heldKeys.keys.length > 0}\n    <span>Keys: {heldKeys.keys.join('+')}</span>\n  {/if}\n</div>\n```\n\n### Recording shortcuts\n\n```svelte\n<script lang=\"ts\">\n  import {\n    createHotkeyRecorder,\n    formatForDisplay,\n  } from '@tanstack/svelte-hotkeys'\n\n  const recorder = createHotkeyRecorder({\n    onRecord: (hotkey) => {\n      console.log('Recorded:', hotkey)\n    },\n  })\n</script>\n\n<button onclick={recorder.startRecording}>\n  {recorder.recordedHotkey\n    ? formatForDisplay(recorder.recordedHotkey)\n    : 'Click to record'}\n</button>\n```\n\n### Displaying hotkeys in the UI\n\n```svelte\n<script lang=\"ts\">\n  import { formatForDisplay, createHotkey } from '@tanstack/svelte-hotkeys'\n\n  createHotkey('Mod+S', () => save())\n</script>\n\n<button>\n  Save <kbd>{formatForDisplay('Mod+S')}</kbd>\n</button>\n```\n\n## Default options\n\nUse `setHotkeysContext` when you want defaults for a subtree. This is an advanced API and usually belongs near the root of the part of the app that owns the hotkeys.\n\n```svelte\n<script lang=\"ts\">\n  import { setHotkeysContext } from '@tanstack/svelte-hotkeys'\n\n  setHotkeysContext({\n    hotkey: { preventDefault: true },\n    hotkeySequence: { timeout: 1500 },\n  })\n</script>\n```\n\n## Next steps\n\n- [Hotkeys Guide](./guides/hotkeys)\n- [Sequences Guide](./guides/sequences)\n- [Hotkey Recording Guide](./guides/hotkey-recording)\n- [Sequence Recording Guide](./guides/sequence-recording)\n- [Key State Tracking Guide](./guides/key-state-tracking)\n- [Formatting & Display Guide](./guides/formatting-display)\n\n## Devtools\n\nInstall the optional devtools packages to inspect registrations, held keys, and trigger counts:\n\n```sh\nnpm install @tanstack/svelte-devtools @tanstack/svelte-hotkeys-devtools\n```\n\nFollow the [devtools setup guide](../../devtools) to add the dock to your application.\n","originalRawMarkdown":"---\ntitle: Quick Start\nid: quick-start\n---\n\n## Installation\n\nDon't have TanStack Hotkeys installed yet? See the [Installation](../../installation) page for instructions.\n\n## Your first hotkey\n\nUse `createHotkey` for global shortcuts and attachments for element-scoped shortcuts.\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkey } from '@tanstack/svelte-hotkeys'\n\n  createHotkey('Mod+S', () => {\n    saveDocument()\n  })\n</script>\n\n<div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>\n```\n\nThe `Mod` modifier automatically resolves to `Meta` (Command) on macOS and `Control` on Windows/Linux, so your shortcuts work across platforms without extra logic.\n\n## Common patterns\n\n### Multiple global hotkeys\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkey } from '@tanstack/svelte-hotkeys'\n\n  createHotkey('Mod+S', () => save())\n  createHotkey('Mod+Z', () => undo())\n  createHotkey('Mod+Shift+Z', () => redo())\n  createHotkey('Mod+F', () => openSearch())\n  createHotkey('Escape', () => closeDialog())\n</script>\n```\n\n### Scoped hotkeys with attachments\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkeyAttachment } from '@tanstack/svelte-hotkeys'\n\n  const closePanel = createHotkeyAttachment('Escape', () => {\n    close()\n  })\n</script>\n\n<div tabindex=\"0\" {@attach closePanel}>\n  <p>Press Escape while focused here to close</p>\n</div>\n```\n\n### Reactive options\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkey } from '@tanstack/svelte-hotkeys'\n\n  let isOpen = $state(true)\n\n  createHotkey(\n    'Escape',\n    () => {\n      isOpen = false\n    },\n    () => ({ enabled: isOpen }),\n  )\n</script>\n```\n\n### Scoped sequences\n\n```svelte\n<script lang=\"ts\">\n  import { createHotkeySequenceAttachment } from '@tanstack/svelte-hotkeys'\n\n  const vimKeys = createHotkeySequenceAttachment(['G', 'G'], () => {\n    scrollToTop()\n  })\n</script>\n\n<div tabindex=\"0\" {@attach vimKeys}>\n  Focus here, then press g then g\n</div>\n```\n\n### Tracking held keys\n\n```svelte\n<script lang=\"ts\">\n  import { getHeldKeys, getIsKeyHeld } from '@tanstack/svelte-hotkeys'\n\n  const heldKeys = getHeldKeys()\n  const isShiftHeld = getIsKeyHeld('Shift')\n</script>\n\n<div class=\"status-bar\">\n  {#if isShiftHeld.held}<span>Shift mode active</span>{/if}\n  {#if heldKeys.keys.length > 0}\n    <span>Keys: {heldKeys.keys.join('+')}</span>\n  {/if}\n</div>\n```\n\n### Recording shortcuts\n\n```svelte\n<script lang=\"ts\">\n  import {\n    createHotkeyRecorder,\n    formatForDisplay,\n  } from '@tanstack/svelte-hotkeys'\n\n  const recorder = createHotkeyRecorder({\n    onRecord: (hotkey) => {\n      console.log('Recorded:', hotkey)\n    },\n  })\n</script>\n\n<button onclick={recorder.startRecording}>\n  {recorder.recordedHotkey\n    ? formatForDisplay(recorder.recordedHotkey)\n    : 'Click to record'}\n</button>\n```\n\n### Displaying hotkeys in the UI\n\n```svelte\n<script lang=\"ts\">\n  import { formatForDisplay, createHotkey } from '@tanstack/svelte-hotkeys'\n\n  createHotkey('Mod+S', () => save())\n</script>\n\n<button>\n  Save <kbd>{formatForDisplay('Mod+S')}</kbd>\n</button>\n```\n\n## Default options\n\nUse `setHotkeysContext` when you want defaults for a subtree. This is an advanced API and usually belongs near the root of the part of the app that owns the hotkeys.\n\n```svelte\n<script lang=\"ts\">\n  import { setHotkeysContext } from '@tanstack/svelte-hotkeys'\n\n  setHotkeysContext({\n    hotkey: { preventDefault: true },\n    hotkeySequence: { timeout: 1500 },\n  })\n</script>\n```\n\n## Next steps\n\n- [Hotkeys Guide](./guides/hotkeys)\n- [Sequences Guide](./guides/sequences)\n- [Hotkey Recording Guide](./guides/hotkey-recording)\n- [Sequence Recording Guide](./guides/sequence-recording)\n- [Key State Tracking Guide](./guides/key-state-tracking)\n- [Formatting & Display Guide](./guides/formatting-display)\n\n## Devtools\n\nInstall the optional devtools packages to inspect registrations, held keys, and trigger counts:\n\n```sh\nnpm install @tanstack/svelte-devtools @tanstack/svelte-hotkeys-devtools\n```\n\nFollow the [devtools setup guide](../../devtools) to add the dock to your application.\n"}
