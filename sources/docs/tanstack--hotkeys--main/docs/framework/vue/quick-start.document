</span>\n    <span v-if=\"heldKeys.length > 0\">Keys: {{ heldKeys.join('+') }}</span>\n  </div>\n</template>","lang":"vue"},{"type":"heading","depth":3,"id":"displaying-hotkeys-in-the-ui","children":[{"type":"text","value":"Displaying hotkeys in the UI"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { formatForDisplay, useHotkey } from '@tanstack/vue-hotkeys'\n\nuseHotkey('Mod+S', () => save())\n</script>\n\n<template>\n  <button>\n    Save <kbd>{{ formatForDisplay('Mod+S') }}</kbd>\n  </button>\n</template>","lang":"vue"},{"type":"heading","depth":2,"id":"default-options-provider","children":[{"type":"text","value":"Default options provider"}]},{"type":"paragraph","children":[{"type":"text","value":"Wrap part of your app with "},{"type":"inlineCode","value":"HotkeysProvider"},{"type":"text","value":" to set default options for all Vue composables in that subtree:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { HotkeysProvider } from '@tanstack/vue-hotkeys'\n</script>\n\n<template>\n  <HotkeysProvider\n    :default-options=\"{\n      hotkey: { preventDefault: true },\n      hotkeySequence: { timeout: 1500 },\n      hotkeyRecorder: { onCancel: () => console.log('Recording cancelled') },\n    }\"\n  >\n    <AppContent />\n  </HotkeysProvider>\n</template>","lang":"vue"},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/hotkeys","children":[{"type":"text","value":"Hotkeys Guide"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/sequences","children":[{"type":"text","value":"Sequences Guide"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/hotkey-recording","children":[{"type":"text","value":"Hotkey Recording Guide"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/sequence-recording","children":[{"type":"text","value":"Sequence Recording Guide"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/key-state-tracking","children":[{"type":"text","value":"Key State Tracking Guide"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./guides/formatting-display","children":[{"type":"text","value":"Formatting & Display Guide"}]}]}]}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"your-first-hotkey","text":"Your first hotkey","level":2},{"id":"common-patterns","text":"Common patterns","level":2},{"id":"multiple-hotkeys","text":"Multiple hotkeys","level":3},{"id":"scoped-hotkeys-with-template-refs","text":"Scoped hotkeys with template refs","level":3},{"id":"conditional-hotkeys","text":"Conditional hotkeys","level":3},{"id":"multi-key-sequences","text":"Multi-key sequences","level":3},{"id":"tracking-held-keys","text":"Tracking held keys","level":3},{"id":"displaying-hotkeys-in-the-ui","text":"Displaying hotkeys in the UI","level":3},{"id":"default-options-provider","text":"Default options provider","level":2},{"id":"next-steps","text":"Next steps","level":2}]},"frameworks":[],"downloadMarkdown":"\n## Installation\n\nDon't have TanStack Hotkeys installed yet? See the [Installation](../../installation) page for instructions.\n\n## Your first hotkey\n\nThe `useHotkey` composable is the primary way to register keyboard shortcuts in Vue:\n\n```vue\n<script setup lang=\"ts\">\nimport { useHotkey } from '@tanstack/vue-hotkeys'\n\nuseHotkey('Mod+S', () => {\n  saveDocument()\n})\n</script>\n\n<template>\n  <div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>\n</template>\n```\n\nThe `Mod` modifier automatically resolves to `Meta` (Command) on macOS and `Control` on Windows/Linux, so your shortcuts work across platforms without extra logic.\n\n## Common patterns\n\n### Multiple hotkeys\n\n```vue\n<script setup lang=\"ts\">\nimport { useHotkey } from '@tanstack/vue-hotkeys'\n\nuseHotkey('Mod+S', () => save())\nuseHotkey('Mod+Z', () => undo())\nuseHotkey('Mod+Shift+Z', () => redo())\nuseHotkey('Mod+F', () => openSearch())\nuseHotkey('Escape', () => closeDialog())\n</script>\n```\n\n### Scoped hotkeys with template refs\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useHotkey } from '@tanstack/vue-hotkeys'\n\nconst panelRef = ref<HTMLDivElement | null>(null)\n\nuseHotkey('Escape', () => closePanel(), { target: panelRef })\n</script>\n\n<template>\n  <div ref=\"panelRef\" tabindex=\"0\">\n    <p>Press Escape while focused here to close</p>\n  </div>\n</template>\n```\n\n### Conditional hotkeys\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useHotkey } from '@tanstack/vue-hotkeys'\n\nconst isOpen = ref(true)\n\nuseHotkey('Escape', () => {\n  isOpen.value = false\n}, { enabled: isOpen })\n</script>\n```\n\n### Multi-key sequences\n\n```vue\n<script setup lang=\"ts\">\nimport { useHotkeySequence } from '@tanstack/vue-hotkeys'\n\nuseHotkeySequence(['G', 'G'], () => scrollToTop())\nuseHotkeySequence(['G', 'Shift+G'], () => scrollToBottom())\n</script>\n```\n\nFor several sequences or a list that changes at runtime, prefer a single `useHotkeySequences([...])` call (see the [Sequences guide](./guides/sequences.md#many-sequences-at-once)).\n\n### Tracking held keys\n\n```vue\n<script setup lang=\"ts\">\nimport { useHeldKeys, useKeyHold } from '@tanstack/vue-hotkeys'\n\nconst heldKeys = useHeldKeys()\nconst isShiftHeld = useKeyHold('Shift')\n</script>\n\n<template>\n  <div class=\"status-bar\">\n    <span v-if=\"isShiftHeld\">Shift mode active</span>\n    <span v-if=\"heldKeys.length > 0\">Keys: {{ heldKeys.join('+') }}</span>\n  </div>\n</template>\n```\n\n### Displaying hotkeys in the UI\n\n```vue\n<script setup lang=\"ts\">\nimport { formatForDisplay, useHotkey } from '@tanstack/vue-hotkeys'\n\nuseHotkey('Mod+S', () => save())\n</script>\n\n<template>\n  <button>\n    Save <kbd>{{ formatForDisplay('Mod+S') }}</kbd>\n  </button>\n</template>\n```\n\n## Default options provider\n\nWrap part of your app with `HotkeysProvider` to set default options for all Vue composables in that subtree:\n\n```vue\n<script setup lang=\"ts\">\nimport { HotkeysProvider } from '@tanstack/vue-hotkeys'\n</script>\n\n<template>\n  <HotkeysProvider\n    :default-options=\"{\n      hotkey: { preventDefault: true },\n      hotkeySequence: { timeout: 1500 },\n      hotkeyRecorder: { onCancel: () => console.log('Recording cancelled') },\n    }\"\n  >\n    <AppContent />\n  </HotkeysProvider>\n</template>\n```\n\n## Next steps\n\n- [Hotkeys Guide](./guides/hotkeys)\n- [Sequences Guide](./guides/sequences)\n- [Hotkey Recording Guide](./guides/hotkey-recording)\n- [Sequence Recording Guide](./guides/sequence-recording)\n- [Key State Tracking Guide](./guides/key-state-tracking)\n- [Formatting & Display Guide](./guides/formatting-display)\n","originalRawMarkdown":"---\ntitle: Quick Start\nid: quick-start\n---\n\n## Installation\n\nDon't have TanStack Hotkeys installed yet? See the [Installation](../../installation) page for instructions.\n\n## Your first hotkey\n\nThe `useHotkey` composable is the primary way to register keyboard shortcuts in Vue:\n\n```vue\n<script setup lang=\"ts\">\nimport { useHotkey } from '@tanstack/vue-hotkeys'\n\nuseHotkey('Mod+S', () => {\n  saveDocument()\n})\n</script>\n\n<template>\n  <div>Press Cmd+S (Mac) or Ctrl+S (Windows) to save</div>\n</template>\n```\n\nThe `Mod` modifier automatically resolves to `Meta` (Command) on macOS and `Control` on Windows/Linux, so your shortcuts work across platforms without extra logic.\n\n## Common patterns\n\n### Multiple hotkeys\n\n```vue\n<script setup lang=\"ts\">\nimport { useHotkey } from '@tanstack/vue-hotkeys'\n\nuseHotkey('Mod+S', () => save())\nuseHotkey('Mod+Z', () => undo())\nuseHotkey('Mod+Shift+Z', () => redo())\nuseHotkey('Mod+F', () => openSearch())\nuseHotkey('Escape', () => closeDialog())\n</script>\n```\n\n### Scoped hotkeys with template refs\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useHotkey } from '@tanstack/vue-hotkeys'\n\nconst panelRef = ref<HTMLDivElement | null>(null)\n\nuseHotkey('Escape', () => closePanel(), { target: panelRef })\n</script>\n\n<template>\n  <div ref=\"panelRef\" tabindex=\"0\">\n    <p>Press Escape while focused here to close</p>\n  </div>\n</template>\n```\n\n### Conditional hotkeys\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useHotkey } from '@tanstack/vue-hotkeys'\n\nconst isOpen = ref(true)\n\nuseHotkey('Escape', () => {\n  isOpen.value = false\n}, { enabled: isOpen })\n</script>\n```\n\n### Multi-key sequences\n\n```vue\n<script setup lang=\"ts\">\nimport { useHotkeySequence } from '@tanstack/vue-hotkeys'\n\nuseHotkeySequence(['G', 'G'], () => scrollToTop())\nuseHotkeySequence(['G', 'Shift+G'], () => scrollToBottom())\n</script>\n```\n\nFor several sequences or a list that changes at runtime, prefer a single `useHotkeySequences([...])` call (see the [Sequences guide](./guides/sequences.md#many-sequences-at-once)).\n\n### Tracking held keys\n\n```vue\n<script setup lang=\"ts\">\nimport { useHeldKeys, useKeyHold } from '@tanstack/vue-hotkeys'\n\nconst heldKeys = useHeldKeys()\nconst isShiftHeld = useKeyHold('Shift')\n</script>\n\n<template>\n  <div class=\"status-bar\">\n    <span v-if=\"isShiftHeld\">Shift mode active</span>\n    <span v-if=\"heldKeys.length > 0\">Keys: {{ heldKeys.join('+') }}</span>\n  </div>\n</template>\n```\n\n### Displaying hotkeys in the UI\n\n```vue\n<script setup lang=\"ts\">\nimport { formatForDisplay, useHotkey } from '@tanstack/vue-hotkeys'\n\nuseHotkey('Mod+S', () => save())\n</script>\n\n<template>\n  <button>\n    Save <kbd>{{ formatForDisplay('Mod+S') }}</kbd>\n  </button>\n</template>\n```\n\n## Default options provider\n\nWrap part of your app with `HotkeysProvider` to set default options for all Vue composables in that subtree:\n\n```vue\n<script setup lang=\"ts\">\nimport { HotkeysProvider } from '@tanstack/vue-hotkeys'\n</script>\n\n<template>\n  <HotkeysProvider\n    :default-options=\"{\n      hotkey: { preventDefault: true },\n      hotkeySequence: { timeout: 1500 },\n      hotkeyRecorder: { onCancel: () => console.log('Recording cancelled') },\n    }\"\n  >\n    <AppContent />\n  </HotkeysProvider>\n</template>\n```\n\n## Next steps\n\n- [Hotkeys Guide](./guides/hotkeys)\n- [Sequences Guide](./guides/sequences)\n- [Hotkey Recording Guide](./guides/hotkey-recording)\n- [Sequence Recording Guide](./guides/sequence-recording)\n- [Key State Tracking Guide](./guides/key-state-tracking)\n- [Formatting & Display Guide](./guides/formatting-display)\n"}
