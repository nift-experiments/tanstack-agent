 manager.registrations.state.size)\n})\n\n// Access current registrations\nfor (const [id, reg] of manager.registrations.state) {\n  console.log(reg.hotkey, reg.options.enabled)\n}","lang":"ts"},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"destroy","children":[{"type":"text","value":"destroy()"}]},{"type":"code","value":"destroy(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-manager.ts#L796","children":[{"type":"text","value":"hotkey-manager.ts:796"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Destroys the manager and removes all listeners."}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getregistrationcount","children":[{"type":"text","value":"getRegistrationCount()"}]},{"type":"code","value":"getRegistrationCount(): number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-manager.ts#L761","children":[{"type":"text","value":"hotkey-manager.ts:761"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Gets the number of registered hotkeys."}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isregistered","children":[{"type":"text","value":"isRegistered()"}]},{"type":"code","value":"isRegistered(hotkey, target?): boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/