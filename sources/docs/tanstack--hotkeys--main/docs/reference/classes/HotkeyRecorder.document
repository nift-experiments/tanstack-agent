e":"text","value":"The TanStack Store instance containing the recorder state.\nUse this to subscribe to state changes or access current state."}]},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"cancel","children":[{"type":"text","value":"cancel()"}]},{"type":"code","value":"cancel(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L302","children":[{"type":"text","value":"hotkey-recorder.ts:302"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Cancel recording without saving."}]},{"type":"paragraph","children":[{"type":"text","value":"Removes the event listener, resets the recording state, and calls\nthe onCancel callback if provided."}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"destroy","children":[{"type":"text","value":"destroy()"}]},{"type":"code","value":"destroy(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L348","children":[{"type":"text","value":"hotkey-recorder.ts:348"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Clean up event listeners and reset state."}]},{"type":"paragraph","children":[{"type":"text","value":"Call this when you're done with the recorder to ensure\nall event listeners are properly removed."}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setoptions","children":[{"type":"text","value":"setOptions()"}]},{"type":"code","value":"setOptions(options): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L128","children":[{"type":"text","value":"hotkey-recorder.ts:128"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Updates the recorder options, including callbacks.\nThis allows framework adapters to sync callback changes without recreating the recorder."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"options-2","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/HotkeyRecorderOptions.md","children":[{"type":"inlineCode","value":"HotkeyRecorderOptions"}]},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"start","children":[{"type":"text","value":"start()"}]},{"type":"code","value":"start(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L139","children":[{"type":"text","value":"hotkey-recorder.ts:139"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Start recording a new hotkey."}]},{"type":"paragraph","children":[{"type":"text","value":"Sets up a keydown event listener that captures keyboard events\nand converts them to hotkey strings. Recording continues until\na valid hotkey is recorded, Escape is pressed, or stop/cancel is called."}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"stop","children":[{"type":"text","value":"stop()"}]},{"type":"code","value":"stop(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L281","children":[{"type":"text","value":"hotkey-recorder.ts:281"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Stop recording (same as cancel, but doesn't call onCancel)."}]},{"type":"paragraph","children":[{"type":"text","value":"Removes the event listener and resets the recording state."}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"options","text":"options","level":5},{"id":"returns","text":"Returns","level":4},{"id":"properties","text":"Properties","level":2},{"id":"store","text":"store","level":3},{"id":"methods","text":"Methods","level":2},{"id":"cancel","text":"cancel()","level":3},{"id":"returns-2","text":"Returns","level":4},{"id":"destroy","text":"destroy()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"setoptions","text":"setOptions()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"options-2","text":"options","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"start","text":"start()","level":3},{"id":"returns-5","text":"Returns","level":4},{"id":"stop","text":"stop()","level":3},{"id":"returns-6","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [hotkey-recorder.ts:94](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L94)\n\nFramework-agnostic class for recording keyboard shortcuts.\n\nThis class handles all the complexity of capturing keyboard events,\nconverting them to hotkey strings, and handling edge cases like\nEscape to cancel or Backspace/Delete to clear.\n\nState Management:\n- Uses TanStack Store for reactive state management\n- State can be accessed via `recorder.store.state` when using the class directly\n- When using framework adapters (React), use `useSelector` hooks for reactive state\n\n## Example\n\n```ts\nconst recorder = new HotkeyRecorder({\n  onRecord: (hotkey) => {\n    console.log('Recorded:', hotkey)\n  },\n  onCancel: () => {\n    console.log('Recording cancelled')\n  },\n})\n\n// Start recording\nrecorder.start()\n\n// Access state directly\nconsole.log(recorder.store.state.isRecording) // true\n\n// Subscribe to changes with TanStack Store\nconst unsubscribe = recorder.store.subscribe(() => {\n  console.log('Recording:', recorder.store.state.isRecording)\n})\n\n// Cleanup\nrecorder.destroy()\nunsubscribe()\n```\n\n## Constructors\n\n### Constructor\n\n```ts\nnew HotkeyRecorder(options): HotkeyRecorder;\n```\n\nDefined in: [hotkey-recorder.ts:119](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L119)\n\nOptions may be a getter to read current configuration during an active session.\n\n#### Parameters\n\n##### options\n\n  \\| [`HotkeyRecorderOptions`](../interfaces/HotkeyRecorderOptions.md)\n  \\| (() => [`HotkeyRecorderOptions`](../interfaces/HotkeyRecorderOptions.md))\n\n#### Returns\n\n`HotkeyRecorder`\n\n## Properties\n\n### store\n\n```ts\nreadonly store: Store<HotkeyRecorderState>;\n```\n\nDefined in: [hotkey-recorder.ts:99](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L99)\n\nThe TanStack Store instance containing the recorder state.\nUse this to subscribe to state changes or access current state.\n\n## Methods\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [hotkey-recorder.ts:302](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L302)\n\nCancel recording without saving.\n\nRemoves the event listener, resets the recording state, and calls\nthe onCancel callback if provided.\n\n#### Returns\n\n`void`\n\n***\n\n### destroy()\n\n```ts\ndestroy(): void;\n```\n\nDefined in: [hotkey-recorder.ts:348](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L348)\n\nClean up event listeners and reset state.\n\nCall this when you're done with the recorder to ensure\nall event listeners are properly removed.\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(options): void;\n```\n\nDefined in: [hotkey-recorder.ts:128](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L128)\n\nUpdates the recorder options, including callbacks.\nThis allows framework adapters to sync callback changes without recreating the recorder.\n\n#### Parameters\n\n##### options\n\n`Partial`\\<[`HotkeyRecorderOptions`](../interfaces/HotkeyRecorderOptions.md)\\>\n\n#### Returns\n\n`void`\n\n***\n\n### start()\n\n```ts\nstart(): void;\n```\n\nDefined in: [hotkey-recorder.ts:139](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L139)\n\nStart recording a new hotkey.\n\nSets up a keydown event listener that captures keyboard events\nand converts them to hotkey strings. Recording continues until\na valid hotkey is recorded, Escape is pressed, or stop/cancel is called.\n\n#### Returns\n\n`void`\n\n***\n\n### stop()\n\n```ts\nstop(): void;\n```\n\nDefined in: [hotkey-recorder.ts:281](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L281)\n\nStop recording (same as cancel, but doesn't call onCancel).\n\nRemoves the event listener and resets the recording state.\n\n#### Returns\n\n`void`\n","originalRawMarkdown":"---\nid: HotkeyRecorder\ntitle: HotkeyRecorder\n---\n\nDefined in: [hotkey-recorder.ts:94](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L94)\n\nFramework-agnostic class for recording keyboard shortcuts.\n\nThis class handles all the complexity of capturing keyboard events,\nconverting them to hotkey strings, and handling edge cases like\nEscape to cancel or Backspace/Delete to clear.\n\nState Management:\n- Uses TanStack Store for reactive state management\n- State can be accessed via `recorder.store.state` when using the class directly\n- When using framework adapters (React), use `useSelector` hooks for reactive state\n\n## Example\n\n```ts\nconst recorder = new HotkeyRecorder({\n  onRecord: (hotkey) => {\n    console.log('Recorded:', hotkey)\n  },\n  onCancel: () => {\n    console.log('Recording cancelled')\n  },\n})\n\n// Start recording\nrecorder.start()\n\n// Access state directly\nconsole.log(recorder.store.state.isRecording) // true\n\n// Subscribe to changes with TanStack Store\nconst unsubscribe = recorder.store.subscribe(() => {\n  console.log('Recording:', recorder.store.state.isRecording)\n})\n\n// Cleanup\nrecorder.destroy()\nunsubscribe()\n```\n\n## Constructors\n\n### Constructor\n\n```ts\nnew HotkeyRecorder(options): HotkeyRecorder;\n```\n\nDefined in: [hotkey-recorder.ts:119](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L119)\n\nOptions may be a getter to read current configuration during an active session.\n\n#### Parameters\n\n##### options\n\n  \\| [`HotkeyRecorderOptions`](../interfaces/HotkeyRecorderOptions.md)\n  \\| (() => [`HotkeyRecorderOptions`](../interfaces/HotkeyRecorderOptions.md))\n\n#### Returns\n\n`HotkeyRecorder`\n\n## Properties\n\n### store\n\n```ts\nreadonly store: Store<HotkeyRecorderState>;\n```\n\nDefined in: [hotkey-recorder.ts:99](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L99)\n\nThe TanStack Store instance containing the recorder state.\nUse this to subscribe to state changes or access current state.\n\n## Methods\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [hotkey-recorder.ts:302](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L302)\n\nCancel recording without saving.\n\nRemoves the event listener, resets the recording state, and calls\nthe onCancel callback if provided.\n\n#### Returns\n\n`void`\n\n***\n\n### destroy()\n\n```ts\ndestroy(): void;\n```\n\nDefined in: [hotkey-recorder.ts:348](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L348)\n\nClean up event listeners and reset state.\n\nCall this when you're done with the recorder to ensure\nall event listeners are properly removed.\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(options): void;\n```\n\nDefined in: [hotkey-recorder.ts:128](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L128)\n\nUpdates the recorder options, including callbacks.\nThis allows framework adapters to sync callback changes without recreating the recorder.\n\n#### Parameters\n\n##### options\n\n`Partial`\\<[`HotkeyRecorderOptions`](../interfaces/HotkeyRecorderOptions.md)\\>\n\n#### Returns\n\n`void`\n\n***\n\n### start()\n\n```ts\nstart(): void;\n```\n\nDefined in: [hotkey-recorder.ts:139](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L139)\n\nStart recording a new hotkey.\n\nSets up a keydown event listener that captures keyboard events\nand converts them to hotkey strings. Recording continues until\na valid hotkey is recorded, Escape is pressed, or stop/cancel is called.\n\n#### Returns\n\n`void`\n\n***\n\n### stop()\n\n```ts\nstop(): void;\n```\n\nDefined in: [hotkey-recorder.ts:281](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-recorder.ts#L281)\n\nStop recording (same as cancel, but doesn't call onCancel).\n\nRemoves the event listener and resets the recording state.\n\n#### Returns\n\n`void`\n"}
