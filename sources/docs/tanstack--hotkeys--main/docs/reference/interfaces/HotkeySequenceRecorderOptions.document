ding is cancelled (Escape pressed)"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onclear","children":[{"type":"text","value":"onClear?"}]},{"type":"code","value":"optional onClear?: () => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-sequence-recorder.ts#L53","children":[{"type":"text","value":"hotkey-sequence-recorder.ts:53"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional callback when the sequence is cleared (Backspace/Delete with no steps)"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onrecord","children":[{"type":"text","value":"onRecord"}]},{"type":"code","value":"onRecord: (sequence) => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/hotkey-sequence-recorder.ts#L49","children":[{"type":"text","value":"hotkey-sequence-recorder.ts:49"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Callback when a sequence is successfully recorded"}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"sequence","children":[{"type":"text","value":"sequence"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/HotkeySequence.md","children":[{"type":"inlineCode","value":"HotkeySequence"}]}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"in