ext","value":"Rejected candidates leave recording active."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"rejection","children":[{"type":"text","value":"rejection"}]},{"type":"paragraph","children":[{"type":"link","href":"RecorderRejection.md","children":[{"type":"inlineCode","value":"RecorderRejection"}]}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"platform","children":[{"type":"text","value":"platform?"}]},{"type":"code","value":"optional platform?: \"mac\" | \"windows\" | \"linux\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L19","children":[{"type":"text","value":"recorder-options.ts:19"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Platform used for Mod and AltGraph handling. Defaults to platform detection."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"recordby","children":[{"type":"text","value":"recordBy?"}]},{"type":"code","value":"optional recordBy?: RecorderKeyMode;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L17","children":[{"type":"text","value":"recorder-options.ts:17"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Physical code recording is the default. Choose key to record logical characters."}]}],"headings":[{"id":"extended-by","text":"Extended by","level":2},{"id":"properties","text":"Properties","level":2},{"id":"detectconflicts","text":"detectConflicts?","level":3},{"id":"onreject","text":"onReject?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"rejection","text":"rejection","level":5},{"id":"returns","text":"Returns","level":4},{"id":"platform","text":"platform?","level":3},{"id":"recordby","text":"recordBy?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [recorder-options.ts:15](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L15)\n\n## Extended by\n\n- [`HotkeyRecorderOptions`](HotkeyRecorderOptions.md)\n- [`HotkeySequenceRecorderOptions`](HotkeySequenceRecorderOptions.md)\n\n## Properties\n\n### detectConflicts?\n\n```ts\noptional detectConflicts?: boolean | HotkeyConflictOptions;\n```\n\nDefined in: [recorder-options.ts:21](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L21)\n\nOpt in to live-registry conflicts, including sequence prefixes. Default: false.\n\n***\n\n### onReject?\n\n```ts\noptional onReject?: (rejection) => void;\n```\n\nDefined in: [recorder-options.ts:23](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L23)\n\nRejected candidates leave recording active.\n\n#### Parameters\n\n##### rejection\n\n[`RecorderRejection`](RecorderRejection.md)\n\n#### Returns\n\n`void`\n\n***\n\n### platform?\n\n```ts\noptional platform?: \"mac\" | \"windows\" | \"linux\";\n```\n\nDefined in: [recorder-options.ts:19](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L19)\n\nPlatform used for Mod and AltGraph handling. Defaults to platform detection.\n\n***\n\n### recordBy?\n\n```ts\noptional recordBy?: RecorderKeyMode;\n```\n\nDefined in: [recorder-options.ts:17](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L17)\n\nPhysical code recording is the default. Choose key to record logical characters.\n","originalRawMarkdown":"---\nid: RecorderOptions\ntitle: RecorderOptions\n---\n\nDefined in: [recorder-options.ts:15](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L15)\n\n## Extended by\n\n- [`HotkeyRecorderOptions`](HotkeyRecorderOptions.md)\n- [`HotkeySequenceRecorderOptions`](HotkeySequenceRecorderOptions.md)\n\n## Properties\n\n### detectConflicts?\n\n```ts\noptional detectConflicts?: boolean | HotkeyConflictOptions;\n```\n\nDefined in: [recorder-options.ts:21](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L21)\n\nOpt in to live-registry conflicts, including sequence prefixes. Default: false.\n\n***\n\n### onReject?\n\n```ts\noptional onReject?: (rejection) => void;\n```\n\nDefined in: [recorder-options.ts:23](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L23)\n\nRejected candidates leave recording active.\n\n#### Parameters\n\n##### rejection\n\n[`RecorderRejection`](RecorderRejection.md)\n\n#### Returns\n\n`void`\n\n***\n\n### platform?\n\n```ts\noptional platform?: \"mac\" | \"windows\" | \"linux\";\n```\n\nDefined in: [recorder-options.ts:19](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L19)\n\nPlatform used for Mod and AltGraph handling. Defaults to platform detection.\n\n***\n\n### recordBy?\n\n```ts\noptional recordBy?: RecorderKeyMode;\n```\n\nDefined in: [recorder-options.ts:17](https://github.com/TanStack/hotkeys/blob/main/packages/hotkeys/src/recorder-options.ts#L17)\n\nPhysical code recording is the default. Choose key to record logical characters.\n"}
