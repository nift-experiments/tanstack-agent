{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"intent install"},{"type":"text","value":" confirms skill-source permissions on first use, then creates or updates an "},{"type":"inlineCode","value":"intent-skills"},{"type":"text","value":" guidance block in a project guidance file."}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"local-install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"\":[[\"@tanstack/intent@latest\",\"install\",\"[--maintainer]\",\"[--review]\",\"[--map]\",\"[--dry-run]\",\"[--print-prompt]\",\"[--global]\",\"[--global-only]\",\"[--no-notices]\"]]},\"mode\":\"local-install\"}"}},{"type":"paragraph","children":[{"type":"text","value":"Keep "},{"type":"inlineCode","value":"@tanstack/intent"},{"type":"text","value":" in devDependencies and commit the lockfile for CI. The command tabs above run "},{"type":"inlineCode","value":"@tanstack/intent@latest"},{"type":"text","value":", which can differ from your installed version. Generated guidance uses the detected package manager's runner; check the generated command to see whether it uses the installed CLI. To use the lockfile-pinned CLI locally, invoke the installed binary."}]},{"type":"heading","depth":2,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"heading","depth":3,"id":"permission-review","children":[{"type":"text","value":"Permission review"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"--review"},{"type":"text","value":": review current skill permissions interactively, then update guidance"}]}]}]},{"type":"heading","depth":3,"id":"guidance-output","children":[{"type":"text","value":"Guidance output"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"--map"},{"type":"t