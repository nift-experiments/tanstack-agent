xt","value":"Prints the scanner-reported path when "},{"type":"inlineCode","value":"--path"},{"type":"text","value":" is passed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Prints debug details to stderr when "},{"type":"inlineCode","value":"--debug"},{"type":"text","value":" is passed"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"A successful load proves that Intent resolved the selected skill under current policy and returned its content. It does not prove that the skill was relevant to the task, reached an agent's active context, or was followed correctly. See "},{"type":"link","href":"../concepts/trust-model#lifecycle-boundaries","children":[{"type":"text","value":"Lifecycle boundaries"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The package can be scoped or unscoped. The skill can include slash-separated sub-skill names."}]},{"type":"paragraph","children":[{"type":"text","value":"Examples:"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"local-install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"\":[[\"@tanstack/intent@latest\",\"load\",\"@tanstack/query#fetching\"],[\"@tanstack/intent@latest\",\"load\",\"@tanstack/query#core/fetching\"],[\"@tanstack/intent@latest\",\"load\",\"@tanstack/router-core#auth-and-guards\"],[\"@tanstack/intent@latest\",\"load\",\"some-lib#core\",\"--path\"]]},\"mode\":\"local-install\"}"}},{"type":"heading","depth":2,"id":"json-output","children":[{"type":"text","value":"JSON output"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"--json"},{"type":"text","value":" prints:"}]},{"type":"code","value":"{\n  \"package\": \"@tanstack/query\",\n  \"skill\": \"fetching\",\n  \"path\": \"node_modules/@tanstack/query/skills/fetching/SKILL.md\",\n  \"packageRoot\": \"node_modules/@tanstack/query\",\n  \"source\": \"local\",\n  \"version\": \"5.0.0\",\n  \"content\": \"---\\nname: fetching\\n---\\n\\n...\",\n  \"warnings\": []\n}","lang":"json"},{"type":"heading","depth":2,"id":"common-errors","children":[{"type":"text","value":"Common errors"}]},{"type":"heading","depth":3,"id":"invalid-skill-identity","children":[{"type":"text","value":"Invalid skill identity"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Missing separator: "},{"type":"inlineCode","value":"Invalid skill use \"@tanstack/query\": expected <package>#<skill>."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Empty package: "},{"type":"inlineCode","value":"Invalid skill use \"#core\": package is required."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Empty skill: "},{"type":"inlineCode","value":"Invalid skill use \"@tanstack/query#\": skill is required."}]}]}]},{"type":"heading","depth":3,"id":"resolution-failures","children":[{"type":"text","value":"Resolution failures"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Missing package: "},{"type":"inlineCode","value":"Cannot resolve skill use \"...\": package \"...\" was not found."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Missing skill: "},{"type":"inlineCode","value":"Cannot resolve skill use \"...\": skill \"...\" was not found in package \"...\"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Skill suggestion: "},{"type":"inlineCode","value":"Did you mean @tanstack/router-core#router-core/auth-and-guards?"}]}]}]},{"type":"heading","depth":3,"id":"policy-refusals","children":[{"type":"text","value":"Policy refusals"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Unlisted package: "},{"type":"inlineCode","value":"Cannot load skill use \"...\": package \"...\" is not listed in intent.skills."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Excluded package: "},{"type":"inlineCode","value":"Cannot load skill use \"...\": package \"...\" is excluded by Intent configuration."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Excluded skill: "},{"type":"inlineCode","value":"Cannot load skill use \"...\": skill \"...\" is excluded by Intent configuration."}]}]}]},{"type":"heading","depth":2,"id":"related","children":[{"type":"text","value":"Related"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./intent-list","children":[{"type":"text","value":"intent list"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./intent-install","children":[{"type":"text","value":"intent install"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../concepts/trust-model","children":[{"type":"text","value":"Trust model"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../concepts/configuration","children":[{"type":"text","value":"Configuration"}]}]}]}]}],"headings":[{"id":"options","text":"Options","level":2},{"id":"what-you-get","text":"What you get","level":2},{"id":"resolution","text":"Resolution","level":3},{"id":"selection","text":"Selection","level":3},{"id":"output","text":"Output","level":3},{"id":"json-output","text":"JSON output","level":2},{"id":"common-errors","text":"Common errors","level":2},{"id":"invalid-skill-identity","text":"Invalid skill identity","level":3},{"id":"resolution-failures","text":"Resolution failures","level":3},{"id":"policy-refusals","text":"Policy refusals","level":3},{"id":"related","text":"Related","level":2}]},"frameworks":[],"downloadMarkdown":"\n`intent load` loads a compact skill identity from the current install and prints the matching `SKILL.md` content.\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"local-install\" -->\n\n```text\n@tanstack/intent@latest load <package>#<skill> [--path] [--json] [--debug] [--global] [--global-only]\n```\n\n<!-- ::end:tabs -->\n\n## Options\n\n- `--path`: print the resolved skill path instead of the file content\n- `--json`: print structured JSON with metadata and content\n- `--debug`: print resolution debug details to stderr\n- `--global`: load from project packages first, then global packages\n- `--global-only`: load from global packages only\n\n## What you get\n\n### Resolution\n\n- Validates `<package>#<skill>` before scanning\n- Scans project-local packages by default\n- Includes global packages only when `--global` or `--global-only` is passed\n- Checks the target package name against `package.json#intent.skills` before resolution, then enforces its source kind after resolution\n- Refuses before scanning when the target package or skill matches `intent.exclude`\n\n### Selection\n\n- Prefers local packages when `--global` is used and the same package exists locally and globally\n- Accepts an unambiguous short skill name when a package-prefixed skill exists\n\n### Output\n\n- Prints raw `SKILL.md` content by default\n- Prints the scanner-reported path when `--path` is passed\n- Prints debug details to stderr when `--debug` is passed\n\nA successful load proves that Intent resolved the selected skill under current policy and returned its content. It does not prove that the skill was relevant to the task, reached an agent's active context, or was followed correctly. See [Lifecycle boundaries](../concepts/trust-model#lifecycle-boundaries).\n\nThe package can be scoped or unscoped. The skill can include slash-separated sub-skill names.\n\nExamples:\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"local-install\" -->\n\n@tanstack/intent@latest load @tanstack/query#fetching\n@tanstack/intent@latest load @tanstack/query#core/fetching\n@tanstack/intent@latest load @tanstack/router-core#auth-and-guards\n@tanstack/intent@latest load some-lib#core --path\n\n<!-- ::end:tabs -->\n\n## JSON output\n\n`--json` prints:\n\n```json\n{\n  \"package\": \"@tanstack/query\",\n  \"skill\": \"fetching\",\n  \"path\": \"node_modules/@tanstack/query/skills/fetching/SKILL.md\",\n  \"packageRoot\": \"node_modules/@tanstack/query\",\n  \"source\": \"local\",\n  \"version\": \"5.0.0\",\n  \"content\": \"---\\nname: fetching\\n---\\n\\n...\",\n  \"warnings\": []\n}\n```\n\n## Common errors\n\n### Invalid skill identity\n\n- Missing separator: `Invalid skill use \"@tanstack/query\": expected <package>#<skill>.`\n- Empty package: `Invalid skill use \"#core\": package is required.`\n- Empty skill: `Invalid skill use \"@tanstack/query#\": skill is required.`\n\n### Resolution failures\n\n- Missing package: `Cannot resolve skill use \"...\": package \"...\" was not found.`\n- Missing skill: `Cannot resolve skill use \"...\": skill \"...\" was not found in package \"...\".`\n- Skill suggestion: `Did you mean @tanstack/router-core#router-core/auth-and-guards?`\n\n### Policy refusals\n\n- Unlisted package: `Cannot load skill use \"...\": package \"...\" is not listed in intent.skills.`\n- Excluded package: `Cannot load skill use \"...\": package \"...\" is excluded by Intent configuration.`\n- Excluded skill: `Cannot load skill use \"...\": skill \"...\" is excluded by Intent configuration.`\n\n## Related\n\n- [intent list](./intent-list)\n- [intent install](./intent-install)\n- [Trust model](../concepts/trust-model)\n- [Configuration](../concepts/configuration)\n","originalRawMarkdown":"---\ntitle: intent load\nid: intent-load\n---\n\n`intent load` loads a compact skill identity from the current install and prints the matching `SKILL.md` content.\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"local-install\" -->\n\n```text\n@tanstack/intent@latest load <package>#<skill> [--path] [--json] [--debug] [--global] [--global-only]\n```\n\n<!-- ::end:tabs -->\n\n## Options\n\n- `--path`: print the resolved skill path instead of the file content\n- `--json`: print structured JSON with metadata and content\n- `--debug`: print resolution debug details to stderr\n- `--global`: load from project packages first, then global packages\n- `--global-only`: load from global packages only\n\n## What you get\n\n### Resolution\n\n- Validates `<package>#<skill>` before scanning\n- Scans project-local packages by default\n- Includes global packages only when `--global` or `--global-only` is passed\n- Checks the target package name against `package.json#intent.skills` before resolution, then enforces its source kind after resolution\n- Refuses before scanning when the target package or skill matches `intent.exclude`\n\n### Selection\n\n- Prefers local packages when `--global` is used and the same package exists locally and globally\n- Accepts an unambiguous short skill name when a package-prefixed skill exists\n\n### Output\n\n- Prints raw `SKILL.md` content by default\n- Prints the scanner-reported path when `--path` is passed\n- Prints debug details to stderr when `--debug` is passed\n\nA successful load proves that Intent resolved the selected skill under current policy and returned its content. It does not prove that the skill was relevant to the task, reached an agent's active context, or was followed correctly. See [Lifecycle boundaries](../concepts/trust-model#lifecycle-boundaries).\n\nThe package can be scoped or unscoped. The skill can include slash-separated sub-skill names.\n\nExamples:\n\n<!-- ::start:tabs variant=\"package-manager\" mode=\"local-install\" -->\n\n@tanstack/intent@latest load @tanstack/query#fetching\n@tanstack/intent@latest load @tanstack/query#core/fetching\n@tanstack/intent@latest load @tanstack/router-core#auth-and-guards\n@tanstack/intent@latest load some-lib#core --path\n\n<!-- ::end:tabs -->\n\n## JSON output\n\n`--json` prints:\n\n```json\n{\n  \"package\": \"@tanstack/query\",\n  \"skill\": \"fetching\",\n  \"path\": \"node_modules/@tanstack/query/skills/fetching/SKILL.md\",\n  \"packageRoot\": \"node_modules/@tanstack/query\",\n  \"source\": \"local\",\n  \"version\": \"5.0.0\",\n  \"content\": \"---\\nname: fetching\\n---\\n\\n...\",\n  \"warnings\": []\n}\n```\n\n## Common errors\n\n### Invalid skill identity\n\n- Missing separator: `Invalid skill use \"@tanstack/query\": expected <package>#<skill>.`\n- Empty package: `Invalid skill use \"#core\": package is required.`\n- Empty skill: `Invalid skill use \"@tanstack/query#\": skill is required.`\n\n### Resolution failures\n\n- Missing package: `Cannot resolve skill use \"...\": package \"...\" was not found.`\n- Missing skill: `Cannot resolve skill use \"...\": skill \"...\" was not found in package \"...\".`\n- Skill suggestion: `Did you mean @tanstack/router-core#router-core/auth-and-guards?`\n\n### Policy refusals\n\n- Unlisted package: `Cannot load skill use \"...\": package \"...\" is not listed in intent.skills.`\n- Excluded package: `Cannot load skill use \"...\": package \"...\" is excluded by Intent configuration.`\n- Excluded skill: `Cannot load skill use \"...\": skill \"...\" is excluded by Intent configuration.`\n\n## Related\n\n- [intent list](./intent-list)\n- [intent install](./intent-install)\n- [Trust model](../concepts/trust-model)\n- [Configuration](../concepts/configuration)\n"}
