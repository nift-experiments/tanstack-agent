"children":[{"type":"text","value":"Package publishing"}]},{"type":"tableCell","children":[{"type":"text","value":"Library release process"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"maintainer sync"},{"type":"text","value":" updates package and selected repository exports; "},{"type":"inlineCode","value":"setup"},{"type":"text","value":" optionally adds CI."}]}],[{"type":"tableCell","children":[{"type":"text","value":"Consumer setup"}]},{"type":"tableCell","children":[{"type":"text","value":"Developer using the published library"}]},{"type":"tableCell","children":[{"type":"text","value":"Consumer "},{"type":"inlineCode","value":"install"},{"type":"text","value":" configures permitted skill sources and skill-loading guidance; "},{"type":"inlineCode","value":"list"},{"type":"text","value":" and "},{"type":"inlineCode","value":"load"},{"type":"text","value":" use skills from installed dependencies."}]}]]},{"type":"callout","kind":"note","title":"Note","children":[{"type":"paragraph","children":[{"type":"text","value":"Maintainer installation and consumer installation write separate managed guidance blocks. Neither command publishes a package or installs a dependency."}]}]},{"type":"heading","depth":2,"id":"how-it-works","children":[{"type":"text","value":"How it works"}]},{"type":"heading","depth":3,"id":"discovery-and-installation","children":[{"type":"text","value":"Discovery and installation"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager","mode":"local-install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"\":[[\"@tanstack/intent@latest\",\"list\"]]},\"mode\":\"local-install\"}"}},{"type":"paragraph","children":[{"type":"text","value":"Scans the current project's installed dependencies for intent-enabled packages, including "},{"type":"inlineCode","value":"node_modules"},{"type":"text","value":", workspace dependencies, and Yarn PnP projects without "},{"type":"inlineCode"