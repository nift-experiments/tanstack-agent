{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/intent"},{"type":"text","value":" is a CLI for shipping and consuming Agent Skills as package artifacts."}]},{"type":"paragraph","children":[{"type":"text","value":"Skills are markdown documents that teach AI coding agents how to use your library correctly. Intent versions them with your releases and ships them inside npm packages. It discovers skills from project and workspace dependencies, then provides commands and guidance for loading them."}]},{"type":"heading","depth":2,"id":"what-intent-does","children":[{"type":"text","value":"What Intent does"}]},{"type":"paragraph","children":[{"type":"text","value":"Intent provides tooling for two workflows:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"For consumers:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Discover skills from your project and workspace dependencies"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Control which packages' skills are surfaced with an allowlist"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add lightweight skill loading guidance to your agent config"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add session catalogs and edit gates for supported agents"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use skills packaged with installed library versions"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"For maintainers (library teams):"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add a persistent skill-authoring and review procedure to repository 