{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"comparison","children":[{"type":"text","value":"Comparison"}]},{"type":"paragraph","children":[{"type":"text","value":"Markdown libraries optimize for different jobs. TanStack Markdown is designed for controlled blog and documentation content where bundle size, deterministic rendering, and HTML/framework parity matter more than complete syntax compatibility."}]},{"type":"heading","depth":2,"id":"decision-table","children":[{"type":"text","value":"Decision table"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Choose"}]},{"type":"tableCell","children":[{"type":"text","value":"Best fit"}]},{"type":"tableCell","children":[{"type":"text","value":"Main tradeoff"}]}],"rows":[[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"TanStack Markdown"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Blogs and docs with a known syntax profile, SSR, React or Octane, and strict bundle budgets"}]},{"type":"tableCell","children":[{"type":"text","value":"Deliberately incomplete CommonMark/GFM coverage and a small extension surface"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Marked"}]}]},{"type":"tableCell","children":[{"type":"text","value":"A compact general HTML renderer with broad familiar Markdown behavior"}]},{"type":"tableCell","children":[{"type":"text","value":"No built-in UI adapter over a docs-specific AST contract"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"markdown-it"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Mature plugins and configurable parsing rules"}]},{"type":"tableCell","children":[{"type":"text","value":"A substantially larger core for this measured use case"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"micromark"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Standards-oriented tokenization and extension building blocks"}]},{"type":"tableCell","children":[{"type":"text","value":"Lower-level API and more assembly for a complete docs renderer"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"commonmark.js"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Applications that prioritize CommonMark behavior and an inspectable syntax tree"}]},{"type":"tableCell","children":[{"type":"text","value":"Larger bundle and no built-in UI framework adapter"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"unified / remark / rehype"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Rich syntax-tree transformations and a broad content-processing ecosystem"}]},{"type":"tableCell","children":[{"type":"text","value":"More packages, configuration, and runtime surface"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"markdown-wasm"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Very fast HTML rendering where a WASM asset is acceptable"}]},{"type":"tableCell","children":[{"type":"text","value":"Different deployment model and no built-in UI framework adapter"}]}]]},{"type":"heading","depth":2,"id":"capability-matrix","children":[{"type":"text","value":"Capability matrix"}]},{"type":"table","align":[null,"center","center","center","center","center","center"],"header":[{"type":"tableCell","children":[{"type":"text","value":"Capability"}]},{"type":"tableCell","children":[{"type":"text","value":"TanStack Markdown"}]},{"type":"tableCell","children":[{"type":"text","value":"Marked"}]},{"type":"tableCell","children":[{"type":"text","value":"markdown-it"}]},{"type":"tableCell","children":[{"type":"text","value":"micromark"}]},{"type":"tableCell","children":[{"type":"text","value":"commonmark.js"}]},{"type":"tableCell","children":[{"type":"text","value":