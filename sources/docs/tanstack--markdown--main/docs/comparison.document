lue":"Pipeline choice"}]}],[{"type":"tableCell","children":[{"type":"text","value":"GFM tables, tasks, and strike"}]},{"type":"tableCell","children":[{"type":"text","value":"Focused built-ins"}]},{"type":"tableCell","children":[{"type":"text","value":"Built in"}]},{"type":"tableCell","children":[{"type":"text","value":"Built in/plugins"}]},{"type":"tableCell","children":[{"type":"text","value":"Extensions"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"Plugins"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Docs callouts, tabs, and code metadata"}]},{"type":"tableCell","children":[{"type":"text","value":"Opt-in built-ins"}]},{"type":"tableCell","children":[{"type":"text","value":"Plugins/custom"}]},{"type":"tableCell","children":[{"type":"text","value":"Plugins/custom"}]},{"type":"tableCell","children":[{"type":"text","value":"Custom"}]},{"type":"tableCell","children":[{"type":"text","value":"Custom"}]},{"type":"tableCell","children":[{"type":"text","value":"Plugins/custom"}]}],[{"type":"tableCell","children":[{"type":"text","value":"General plugin ecosystem"}]},{"type":"tableCell","children":[{"type":"text","value":"Focused hooks"}]},{"type":"tableCell","children":[{"type":"text","value":"Mature"}]},{"type":"tableCell","children":[{"type":"text","value":"Mature"}]},{"type":"tableCell","children":[{"type":"text","value":"Composable extensions"}]},{"type":"tableCell","children":[{"type":"text","value":"Small"}]},{"type":"tableCell","children":[{"type":"text","value":"Extensive"}]}],[{"type":"tableCell","children":[{"type":"text","value":"MDX or JSX evaluation"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"Separate MDX stack"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Full compatibility as a project goal"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"Broad compatibility"}]},{"type":"tableCell","children":[{"type":"text","value":"Broad compatibility"}]},{"type":"tableCell","children":[{"type":"text","value":"CommonMark"}]},{"type":"tableCell","children":[{"type":"text","value":"CommonMark"}]},{"type":"tableCell","children":[{"type":"text","value":"CommonMark plus plugins"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"“Configuration,” “plugin,” and “ecosystem” do not imply missing capability. They indicate that the behavior is not the default contract of the compared entry point."}]},{"type":"heading","depth":2,"id":"measured-browser-size","children":[{"type":"text","value":"Measured browser size"}]},{"type":"paragraph","children":[{"type":"text","value":"These repository benchmarks bundle representative browser entry points from pinned dependencies, minify them with esbuild, and compress them. They are reproducible with "},{"type":"inlineCode","value":"pnpm run size"},{"type":"text","value":"."}]},{"type":"table","align":[null,"right","right"],"header":[{"type":"tableCell","children":[{"type":"text","value":"Entry"}]},{"type":"tableCell","children":[{"type":"text","value":"Gzip"}]},{"type":"tableCell","children":[{"type":"text","value":"Brotli"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/markdown/parser"}]},{"type":"tableCell","children":[{"type":"text","value":"5.2 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"4.8 KB"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/markdown/html"}]},{"type":"tableCell","children":[{"type":"text","value":"7.0 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"6.5 KB"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/markdown/react"}]},{"type":"tableCell","children":[{"type":"text","value":"7.0 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"6.5 KB"}]}],[{"type":"tableCell","children":[{"type":"text","value":"React with streaming extension"}]},{"type":"tableCell","children":[{"type":"text","value":"7.2 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"6.6 KB"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/markdown/octane"}]},{"type":"tableCell","children":[{"type":"text","value":"7.0 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"6.4 KB"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Marked"}]},{"type":"tableCell","children":[{"type":"text","value":"12.5 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"11.5 KB"}]}],[{"type":"tableCell","children":[{"type":"text","value":"micromark"}]},{"type":"tableCell","children":[{"type":"text","value":"15.4 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"13.7 KB"}]}],[{"type":"tableCell","children":[{"type":"text","value":"markdown-wasm JS + WASM"}]},{"type":"tableCell","children":[{"type":"text","value":"31.3 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"26.4 KB"}]}],[{"type":"tableCell","children":[{"type":"text","value":"unified + remark + rehype"}]},{"type":"tableCell","children":[{"type":"text","value":"36.8 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"32.7 KB"}]}],[{"type":"tableCell","children":[{"type":"text","value":"commonmark.js"}]},{"type":"tableCell","children":[{"type":"text","value":"48.1 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"39.8 KB"}]}],[{"type":"tableCell","children":[{"type":"text","value":"markdown-it"}]},{"type":"tableCell","children":[{"type":"text","value":"52.7 KB"}]},{"type":"tableCell","children":[{"type":"text","value":"44.0 KB"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"The comparison does not represent equivalent feature sets. It shows the cost of each measured path for this repository’s rendering benchmark. See the generated "},{"type":"link","href":"https://github.com/TanStack/markdown/blob/main/reports/sizes.md","children":[{"type":"text","value":"size report"}]},{"type":"text","value":" for exact bytes and versions."}]},{"type":"heading","depth":2,"id":"compatibility-accounting","children":[{"type":"text","value":"Compatibility accounting"}]},{"type":"paragraph","children":[{"type":"text","value":"The generated "},{"type":"link","href":"https://github.com/TanStack/markdown/blob/main/reports/conformance.md","children":[{"type":"text","value":"compatibility report"}]},{"type":"text","value":" tracks matches against all 652 CommonMark 0.31.2 examples after serializer normalization. Every established match is protected individually by the regression suite. The count is accounting, not a conformance claim or a target to maximize. Selected official GFM examples separately cover tables, task lists, and strikethrough."}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"link","href":"https://github.com/commonmark/commonmark.js","children":[{"type":"text","value":"commonmark.js"}]},{"type":"text","value":", micromark, or a unified pipeline when exact specification behavior is a requirement. Use TanStack Markdown when your corpus fits the "},{"type":"link","href":"./core-concepts/syntax-profile.md","children":[{"type":"text","value":"documented profile"}]},{"type":"text","value":" and the smaller, controlled renderer is the better product tradeoff."}]},{"type":"heading","depth":2,"id":"performance","children":[{"type":"text","value":"Performance"}]},{"type":"paragraph","children":[{"type":"text","value":"Across the maintained fixtures, TanStack Markdown is competitive with the JavaScript renderers in the suite, but it is not the fastest result in every fixture. Pre-parsed AST rendering is its cheapest path. The defensible advantage is the combined size, output contract, and focused feature set. See "},{"type":"link","href":"./guides/performance.md","children":[{"type":"text","value":"Performance"}]},{"type":"text","value":" for methodology and current results."}]}],"headings":[{"id":"comparison","text":"Comparison","level":1},{"id":"decision-table","text":"Decision table","level":2},{"id":"capability-matrix","text":"Capability matrix","level":2},{"id":"measured-browser-size","text":"Measured browser size","level":2},{"id":"compatibility-accounting","text":"Compatibility accounting","level":2},{"id":"performance","text":"Performance","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Comparison\n\nMarkdown libraries optimize for different jobs. TanStack Markdown is designed for controlled blog and documentation content where bundle size, deterministic rendering, and HTML/framework parity matter more than complete syntax compatibility.\n\n## Decision table\n\n| Choose | Best fit | Main tradeoff |\n| --- | --- | --- |\n| **TanStack Markdown** | Blogs and docs with a known syntax profile, SSR, React or Octane, and strict bundle budgets | Deliberately incomplete CommonMark/GFM coverage and a small extension surface |\n| **Marked** | A compact general HTML renderer with broad familiar Markdown behavior | No built-in UI adapter over a docs-specific AST contract |\n| **markdown-it** | Mature plugins and configurable parsing rules | A substantially larger core for this measured use case |\n| **micromark** | Standards-oriented tokenization and extension building blocks | Lower-level API and more assembly for a complete docs renderer |\n| **commonmark.js** | Applications that prioritize CommonMark behavior and an inspectable syntax tree | Larger bundle and no built-in UI framework adapter |\n| **unified / remark / rehype** | Rich syntax-tree transformations and a broad content-processing ecosystem | More packages, configuration, and runtime surface |\n| **markdown-wasm** | Very fast HTML rendering where a WASM asset is acceptable | Different deployment model and no built-in UI framework adapter |\n\n## Capability matrix\n\n| Capability | TanStack Markdown | Marked | markdown-it | micromark | commonmark.js | unified stack |\n| --- | :---: | :---: | :---: | :---: | :---: | :---: |\n| HTML rendering | Built in | Built in | Built in | Built in | Built in | Via rehype |\n| React and Octane renderers from the same AST | Built in | No | No | No | No | Ecosystem |\n| Serializable public document AST | Built in | Token output | Token stream | No syntax tree | Built in | Built in |\n| Raw HTML disabled by default | Yes | No | Yes | Yes | No | Pipeline choice |\n| GFM tables, tasks, and strike | Focused built-ins | Built in | Built in/plugins | Extensions | No | Plugins |\n| Docs callouts, tabs, and code metadata | Opt-in built-ins | Plugins/custom | Plugins/custom | Custom | Custom | Plugins/custom |\n| General plugin ecosystem | Focused hooks | Mature | Mature | Composable extensions | Small | Extensive |\n| MDX or JSX evaluation | No | No | No | No | No | Separate MDX stack |\n| Full compatibility as a project goal | No | Broad compatibility | Broad compatibility | CommonMark | CommonMark | CommonMark plus plugins |\n\n“Configuration,” “plugin,” and “ecosystem” do not imply missing capability. They indicate that the behavior is not the default contract of the compared entry point.\n\n## Measured browser size\n\nThese repository benchmarks bundle representative browser entry points from pinned dependencies, minify them with esbuild, and compress them. They are reproducible with `pnpm run size`.\n\n| Entry | Gzip | Brotli |\n| --- | ---: | ---: |\n| `@tanstack/markdown/parser` | 5.2 KB | 4.8 KB |\n| `@tanstack/markdown/html` | 7.0 KB | 6.5 KB |\n| `@tanstack/markdown/react` | 7.0 KB | 6.5 KB |\n| React with streaming extension | 7.2 KB | 6.6 KB |\n| `@tanstack/markdown/octane` | 7.0 KB | 6.4 KB |\n| Marked | 12.5 KB | 11.5 KB |\n| micromark | 15.4 KB | 13.7 KB |\n| markdown-wasm JS + WASM | 31.3 KB | 26.4 KB |\n| unified + remark + rehype | 36.8 KB | 32.7 KB |\n| commonmark.js | 48.1 KB | 39.8 KB |\n| markdown-it | 52.7 KB | 44.0 KB |\n\nThe comparison does not represent equivalent feature sets. It shows the cost of each measured path for this repository’s rendering benchmark. See the generated [size report](https://github.com/TanStack/markdown/blob/main/reports/sizes.md) for exact bytes and versions.\n\n## Compatibility accounting\n\nThe generated [compatibility report](https://github.com/TanStack/markdown/blob/main/reports/conformance.md) tracks matches against all 652 CommonMark 0.31.2 examples after serializer normalization. Every established match is protected individually by the regression suite. The count is accounting, not a conformance claim or a target to maximize. Selected official GFM examples separately cover tables, task lists, and strikethrough.\n\nUse [commonmark.js](https://github.com/commonmark/commonmark.js), micromark, or a unified pipeline when exact specification behavior is a requirement. Use TanStack Markdown when your corpus fits the [documented profile](./core-concepts/syntax-profile.md) and the smaller, controlled renderer is the better product tradeoff.\n\n## Performance\n\nAcross the maintained fixtures, TanStack Markdown is competitive with the JavaScript renderers in the suite, but it is not the fastest result in every fixture. Pre-parsed AST rendering is its cheapest path. The defensible advantage is the combined size, output contract, and focused feature set. See [Performance](./guides/performance.md) for methodology and current results.\n","originalRawMarkdown":"---\ntitle: Comparison\n---\n\n# Comparison\n\nMarkdown libraries optimize for different jobs. TanStack Markdown is designed for controlled blog and documentation content where bundle size, deterministic rendering, and HTML/framework parity matter more than complete syntax compatibility.\n\n## Decision table\n\n| Choose | Best fit | Main tradeoff |\n| --- | --- | --- |\n| **TanStack Markdown** | Blogs and docs with a known syntax profile, SSR, React or Octane, and strict bundle budgets | Deliberately incomplete CommonMark/GFM coverage and a small extension surface |\n| **Marked** | A compact general HTML renderer with broad familiar Markdown behavior | No built-in UI adapter over a docs-specific AST contract |\n| **markdown-it** | Mature plugins and configurable parsing rules | A substantially larger core for this measured use case |\n| **micromark** | Standards-oriented tokenization and extension building blocks | Lower-level API and more assembly for a complete docs renderer |\n| **commonmark.js** | Applications that prioritize CommonMark behavior and an inspectable syntax tree | Larger bundle and no built-in UI framework adapter |\n| **unified / remark / rehype** | Rich syntax-tree transformations and a broad content-processing ecosystem | More packages, configuration, and runtime surface |\n| **markdown-wasm** | Very fast HTML rendering where a WASM asset is acceptable | Different deployment model and no built-in UI framework adapter |\n\n## Capability matrix\n\n| Capability | TanStack Markdown | Marked | markdown-it | micromark | commonmark.js | unified stack |\n| --- | :---: | :---: | :---: | :---: | :---: | :---: |\n| HTML rendering | Built in | Built in | Built in | Built in | Built in | Via rehype |\n| React and Octane renderers from the same AST | Built in | No | No | No | No | Ecosystem |\n| Serializable public document AST | Built in | Token output | Token stream | No syntax tree | Built in | Built in |\n| Raw HTML disabled by default | Yes | No | Yes | Yes | No | Pipeline choice |\n| GFM tables, tasks, and strike | Focused built-ins | Built in | Built in/plugins | Extensions | No | Plugins |\n| Docs callouts, tabs, and code metadata | Opt-in built-ins | Plugins/custom | Plugins/custom | Custom | Custom | Plugins/custom |\n| General plugin ecosystem | Focused hooks | Mature | Mature | Composable extensions | Small | Extensive |\n| MDX or JSX evaluation | No | No | No | No | No | Separate MDX stack |\n| Full compatibility as a project goal | No | Broad compatibility | Broad compatibility | CommonMark | CommonMark | CommonMark plus plugins |\n\n“Configuration,” “plugin,” and “ecosystem” do not imply missing capability. They indicate that the behavior is not the default contract of the compared entry point.\n\n## Measured browser size\n\nThese repository benchmarks bundle representative browser entry points from pinned dependencies, minify them with esbuild, and compress them. They are reproducible with `pnpm run size`.\n\n| Entry | Gzip | Brotli |\n| --- | ---: | ---: |\n| `@tanstack/markdown/parser` | 5.2 KB | 4.8 KB |\n| `@tanstack/markdown/html` | 7.0 KB | 6.5 KB |\n| `@tanstack/markdown/react` | 7.0 KB | 6.5 KB |\n| React with streaming extension | 7.2 KB | 6.6 KB |\n| `@tanstack/markdown/octane` | 7.0 KB | 6.4 KB |\n| Marked | 12.5 KB | 11.5 KB |\n| micromark | 15.4 KB | 13.7 KB |\n| markdown-wasm JS + WASM | 31.3 KB | 26.4 KB |\n| unified + remark + rehype | 36.8 KB | 32.7 KB |\n| commonmark.js | 48.1 KB | 39.8 KB |\n| markdown-it | 52.7 KB | 44.0 KB |\n\nThe comparison does not represent equivalent feature sets. It shows the cost of each measured path for this repository’s rendering benchmark. See the generated [size report](https://github.com/TanStack/markdown/blob/main/reports/sizes.md) for exact bytes and versions.\n\n## Compatibility accounting\n\nThe generated [compatibility report](https://github.com/TanStack/markdown/blob/main/reports/conformance.md) tracks matches against all 652 CommonMark 0.31.2 examples after serializer normalization. Every established match is protected individually by the regression suite. The count is accounting, not a conformance claim or a target to maximize. Selected official GFM examples separately cover tables, task lists, and strikethrough.\n\nUse [commonmark.js](https://github.com/commonmark/commonmark.js), micromark, or a unified pipeline when exact specification behavior is a requirement. Use TanStack Markdown when your corpus fits the [documented profile](./core-concepts/syntax-profile.md) and the smaller, controlled renderer is the better product tradeoff.\n\n## Performance\n\nAcross the maintained fixtures, TanStack Markdown is competitive with the JavaScript renderers in the suite, but it is not the fastest result in every fixture. Pre-parsed AST rendering is its cheapest path. The defensible advantage is the combined size, output contract, and focused feature set. See [Performance](./guides/performance.md) for methodology and current results.\n"}
