,"value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"Use fenced code blocks"}]}]]},{"type":"heading","depth":2,"id":"inline-syntax","children":[{"type":"text","value":"Inline syntax"}]},{"type":"table","align":[null,"center",null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Syntax"}]},{"type":"tableCell","children":[{"type":"text","value":"Support"}]},{"type":"tableCell","children":[{"type":"text","value":"Notes"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Emphasis and strong"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes"}]},{"type":"tableCell","children":[{"type":"text","value":"Natural prose patterns; not every pathological delimiter case"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Strikethrough"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes"}]},{"type":"tableCell","children":[{"type":"text","value":"GFM "},{"type":"inlineCode","value":"~~text~~"},{"type":"text","value":" and legacy TanStack "},{"type":"inlineCode","value":"~text~"},{"type":"text","value":"; numeric approximations stay literal"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Inline code"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes"}]},{"type":"tableCell","children":[{"type":"text","value":"Matching backtick runs; internal spaces and tabs are preserved"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Inline links and images"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes"}]},{"type":"tableCell","children":[{"type":"text","value":"Unsafe URL protocols are removed"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Reference links and images"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes"}]},{"type":"tableCell","children":[{"type":"text","value":"Full, collapsed, and shortcut forms; normalized reference labels"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Hard breaks"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes"}]},{"type":"tableCell","children":[{"type":"text","value":"Backslash before a newline"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Raw inline HTML"}]},{"type":"tableCell","children":[{"type":"text","value":"Opt-in"}]},{"type":"tableCell","children":[{"type":"text","value":"Requires "},{"type":"inlineCode","value":"allowHtml: true"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Autolink literals"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]},{"type":"tableCell","children":[{"type":"text","value":"Write an explicit link"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Entity decoding"}]},{"type":"tableCell","children":[{"type":"text","value":"Partial"}]},{"type":"tableCell","children":[{"type":"text","value":"HTML is escaped; full CommonMark entity behavior is not a goal"}]}]]},{"type":"heading","depth":2,"id":"docs-metadata","children":[{"type":"text","value":"Docs metadata"}]},{"type":"paragraph","children":[{"type":"text","value":"Code fences understand metadata used by technical documentation:"}]},{"type":"code","value":"```tsx file=\"app.tsx\" framework=\"react\" {2,4-6}\nexport function App() {\n  return <main>Hello</main>\n}\n```","lang":"md"},{"type":"paragraph","children":[{"type":"text","value":"The AST records "},{"type":"inlineCode","value":"lang"},{"type":"text","value":", "},{"type":"inlineCode","value":"meta"},{"type":"text","value":", "},{"type":"inlineCode","value":"title"},{"type":"text","value":", "},{"type":"inlineCode","value":"file"},{"type":"text","value":", "},{"type":"inlineCode","value":"framework"},{"type":"text","value":", and "},{"type":"inlineCode","value":"highlightLines"},{"type":"text","value":". Rendering the metadata does not add a syntax highlighter."}]},{"type":"heading","depth":2,"id":"optional-docs-syntax","children":[{"type":"text","value":"Optional docs syntax"}]},{"type":"paragraph","children":[{"type":"text","value":"The docs extension entry points add:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"GitHub-style callouts such as "},{"type":"inlineCode","value":"> [!TIP]"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"heading collection for table-of-contents data"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"comment-delimited component blocks"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"file, package-manager, bundler, and framework transforms"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../guides/docs-preset.md","children":[{"type":"text","value":"Docs Preset"}]},{"type":"text","value":" guide."}]},{"type":"heading","depth":2,"id":"deliberate-limits","children":[{"type":"text","value":"Deliberate limits"}]},{"type":"paragraph","children":[{"type":"text","value":"The following are not project goals:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"complete CommonMark or GFM conformance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"MDX, JSX parsing, or arbitrary code evaluation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"automatic URL linking"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"a complete HTML parser or sanitizer"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"every delimiter, indentation, entity, or reference-label interaction"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"syntax highlighting, themes, or language grammars"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"asynchronous plugin pipelines"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Unsupported input must still be deterministic, escaped by default, and bounded in runtime. New syntax requires evidence from real documentation, regression fixtures, renderer parity, and an accepted bundle cost."}]}],"headings":[{"id":"syntax-profile","text":"Syntax Profile","level":1},{"id":"block-syntax","text":"Block syntax","level":2},{"id":"inline-syntax","text":"Inline syntax","level":2},{"id":"docs-metadata","text":"Docs metadata","level":2},{"id":"optional-docs-syntax","text":"Optional docs syntax","level":2},{"id":"deliberate-limits","text":"Deliberate limits","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Syntax Profile\n\nTanStack Markdown implements a documented subset aimed at repository-authored blogs, guides, API documentation, changelogs, and release notes.\n\n## Block syntax\n\n| Syntax | Support | Notes |\n| --- | :---: | --- |\n| ATX headings | Yes | Levels 1-6 with stable duplicate-safe IDs |\n| Paragraphs | Yes | Soft line breaks remain text line breaks |\n| Fenced code blocks | Yes | Backtick and tilde fences, language and docs metadata |\n| Blockquotes | Yes | Nested parsing with a bounded depth |\n| Unordered lists | Yes | Tight, loose, nested, and task items |\n| Ordered lists | Yes | `.` and `)` markers, custom starts including zero, tight and loose items |\n| Tables | Yes | Header delimiter, alignment, and escaped pipes in cells |\n| Thematic breaks | Yes | Hyphen, asterisk, and underscore forms |\n| Frontmatter extraction | Yes | Leading `---` block, enabled by default |\n| Footnotes | Yes | Definition order follows first reference |\n| Raw HTML | Opt-in | Parsed and emitted only with `allowHtml: true` |\n| Setext headings | No | Use `#` headings |\n| Indented code blocks | No | Use fenced code blocks |\n\n## Inline syntax\n\n| Syntax | Support | Notes |\n| --- | :---: | --- |\n| Emphasis and strong | Yes | Natural prose patterns; not every pathological delimiter case |\n| Strikethrough | Yes | GFM `~~text~~` and legacy TanStack `~text~`; numeric approximations stay literal |\n| Inline code | Yes | Matching backtick runs; internal spaces and tabs are preserved |\n| Inline links and images | Yes | Unsafe URL protocols are removed |\n| Reference links and images | Yes | Full, collapsed, and shortcut forms; normalized reference labels |\n| Hard breaks | Yes | Backslash before a newline |\n| Raw inline HTML | Opt-in | Requires `allowHtml: true` |\n| Autolink literals | No | Write an explicit link |\n| Entity decoding | Partial | HTML is escaped; full CommonMark entity behavior is not a goal |\n\n## Docs metadata\n\nCode fences understand metadata used by technical documentation:\n\n````md\n```tsx file=\"app.tsx\" framework=\"react\" {2,4-6}\nexport function App() {\n  return <main>Hello</main>\n}\n```\n````\n\nThe AST records `lang`, `meta`, `title`, `file`, `framework`, and `highlightLines`. Rendering the metadata does not add a syntax highlighter.\n\n## Optional docs syntax\n\nThe docs extension entry points add:\n\n- GitHub-style callouts such as `> [!TIP]`\n- heading collection for table-of-contents data\n- comment-delimited component blocks\n- file, package-manager, bundler, and framework transforms\n\nSee the [Docs Preset](../guides/docs-preset.md) guide.\n\n## Deliberate limits\n\nThe following are not project goals:\n\n- complete CommonMark or GFM conformance\n- MDX, JSX parsing, or arbitrary code evaluation\n- automatic URL linking\n- a complete HTML parser or sanitizer\n- every delimiter, indentation, entity, or reference-label interaction\n- syntax highlighting, themes, or language grammars\n- asynchronous plugin pipelines\n\nUnsupported input must still be deterministic, escaped by default, and bounded in runtime. New syntax requires evidence from real documentation, regression fixtures, renderer parity, and an accepted bundle cost.\n","originalRawMarkdown":"---\ntitle: Syntax Profile\n---\n\n# Syntax Profile\n\nTanStack Markdown implements a documented subset aimed at repository-authored blogs, guides, API documentation, changelogs, and release notes.\n\n## Block syntax\n\n| Syntax | Support | Notes |\n| --- | :---: | --- |\n| ATX headings | Yes | Levels 1-6 with stable duplicate-safe IDs |\n| Paragraphs | Yes | Soft line breaks remain text line breaks |\n| Fenced code blocks | Yes | Backtick and tilde fences, language and docs metadata |\n| Blockquotes | Yes | Nested parsing with a bounded depth |\n| Unordered lists | Yes | Tight, loose, nested, and task items |\n| Ordered lists | Yes | `.` and `)` markers, custom starts including zero, tight and loose items |\n| Tables | Yes | Header delimiter, alignment, and escaped pipes in cells |\n| Thematic breaks | Yes | Hyphen, asterisk, and underscore forms |\n| Frontmatter extraction | Yes | Leading `---` block, enabled by default |\n| Footnotes | Yes | Definition order follows first reference |\n| Raw HTML | Opt-in | Parsed and emitted only with `allowHtml: true` |\n| Setext headings | No | Use `#` headings |\n| Indented code blocks | No | Use fenced code blocks |\n\n## Inline syntax\n\n| Syntax | Support | Notes |\n| --- | :---: | --- |\n| Emphasis and strong | Yes | Natural prose patterns; not every pathological delimiter case |\n| Strikethrough | Yes | GFM `~~text~~` and legacy TanStack `~text~`; numeric approximations stay literal |\n| Inline code | Yes | Matching backtick runs; internal spaces and tabs are preserved |\n| Inline links and images | Yes | Unsafe URL protocols are removed |\n| Reference links and images | Yes | Full, collapsed, and shortcut forms; normalized reference labels |\n| Hard breaks | Yes | Backslash before a newline |\n| Raw inline HTML | Opt-in | Requires `allowHtml: true` |\n| Autolink literals | No | Write an explicit link |\n| Entity decoding | Partial | HTML is escaped; full CommonMark entity behavior is not a goal |\n\n## Docs metadata\n\nCode fences understand metadata used by technical documentation:\n\n````md\n```tsx file=\"app.tsx\" framework=\"react\" {2,4-6}\nexport function App() {\n  return <main>Hello</main>\n}\n```\n````\n\nThe AST records `lang`, `meta`, `title`, `file`, `framework`, and `highlightLines`. Rendering the metadata does not add a syntax highlighter.\n\n## Optional docs syntax\n\nThe docs extension entry points add:\n\n- GitHub-style callouts such as `> [!TIP]`\n- heading collection for table-of-contents data\n- comment-delimited component blocks\n- file, package-manager, bundler, and framework transforms\n\nSee the [Docs Preset](../guides/docs-preset.md) guide.\n\n## Deliberate limits\n\nThe following are not project goals:\n\n- complete CommonMark or GFM conformance\n- MDX, JSX parsing, or arbitrary code evaluation\n- automatic URL linking\n- a complete HTML parser or sanitizer\n- every delimiter, indentation, entity, or reference-label interaction\n- syntax highlighting, themes, or language grammars\n- asynchronous plugin pipelines\n\nUnsupported input must still be deterministic, escaped by default, and bounded in runtime. New syntax requires evidence from real documentation, regression fixtures, renderer parity, and an accepted bundle cost.\n"}
