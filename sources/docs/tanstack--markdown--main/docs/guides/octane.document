{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"octane","children":[{"type":"text","value":"Octane"}]},{"type":"paragraph","children":[{"type":"text","value":"The Octane adapter renders Markdown source or a pre-parsed document directly to Octane element descriptors. It imports only the Octane runtime and does not produce an intermediate HTML string."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"code","value":"pnpm add @tanstack/markdown octane","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"The adapter requires "},{"type":"inlineCode","value":"octane@0.1.12"},{"type":"text","value":" or newer. Octane is an optional peer dependency and is not imported by any other package entry."}]},{"type":"heading","depth":2,"id":"component-usage","children":[{"type":"text","value":"Component usage"}]},{"type":"code","value":"import { Markdown } from '@tanstack/markdown/octane'\n\nexport function Article({ source }: { source: string }) @{\n  <article>\n    <Markdown>{source}</Markdown>\n  </article>\n}","lang":"tsrx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"Markdown"},{"type":"text","value":" returns an Octane fragment descriptor, so the surrounding semantic element remains under application control."}]},{"type":"heading","depth":2,"id":"replace-intrinsic-elements","children":[{"type":"text","value":"Replace intrinsic elements"}]},{"type":"paragraph","children":[{"type":"text","value":"Map an emitted tag name to an Octane component or another host tag:"}]},{"type":"code","value":"import { createElement, type ComponentBody } from 'octane'\nimport { Markdown } from '@tanstack/markdown/octane'\n\nconst ExternalLink: ComponentBody<any> = props =>\n  createElement('a', {\n    ...props,\n    rel: 'noreferrer',\n    target: '_blank',\n  })\n\nconst article = Markdown({\n  children: source,\n  components: { a: ExternalLink },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Mappings apply to intrinsic tags and custom element names emitted by docs extensions."}]},{"type":"heading","depth":2,"id":"static-ssr","children":[{"type":"text","value":"Static SSR"}]},{"type":"code","value":"import { renderToStaticMarkup } from 'octane/server'\nimport { Markdown } from '@tanstack/markdown/octane'\n\nconst { html, css } = renderToStaticMarkup(Markdown, {\n  children: source,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Core Octane SSR output is tested for structural parity with "},{"type":"inlineCode","value":"renderHtml()"},{"type":"text","value":", including tight and loose lists, tables, footnotes, docs extensions, and highlighted code."}]},{"type":"heading","depth":2,"id":"parse-once","children":[{"type":"text","value":"Parse once"}]},{"type":"code","value":"import { parseMarkdown } from '@tanstack/markdown/parser'\nimport { Markdown } from '@tanstack/markdown/octane'\n\nconst document = parseMarkdown(source)\nconst article = Markdown({ children: document })","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"renderMarkdownOctane"},{"type":"text","value":", "},{"type":"inlineCode","value":"renderBlockOctane"},{"type":"text","value":", and "},{"type":"inlineCode","value":"renderInlineOctane"},{"type":"text","value":" when composing descriptors outside the component API."}]},{"type":"heading","depth":2,"id":"trusted-boundaries","children":[{"type":"text","value":"Trusted boundaries"}]},{"type":"paragraph","children":[{"type":"text","value":"Raw HTML uses Octane's "},{"type":"inlineCode","value":"dangerouslySetInnerHTML"},{"type":"text","value":" contract when "},{"type":"inlineCode","value":"allowHtml"},{"type":"text","value":" is enabled. Highlighter output uses the same path inside "},{"type":"inlineCode","value":"<code>"},{"type":"text","value":". Keep both disabled for untrusted content unless the output is sanitized by the application."}]}],"headings":[{"id":"octane","text":"Octane","level":1},{"id":"installation","text":"Installation","level":2},{"id":"component-usage","text":"Component usage","level":2},{"id":"replace-intrinsic-elements","text":"Replace intrinsic elements","level":2},{"id":"static-ssr","text":"Static SSR","level":2},{"id":"parse-once","text":"Parse once","level":2},{"id":"trusted-boundaries","text":"Trusted boundaries","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Octane\n\nThe Octane adapter renders Markdown source or a pre-parsed document directly to Octane element descriptors. It imports only the Octane runtime and does not produce an intermediate HTML string.\n\n## Installation\n\n```bash\npnpm add @tanstack/markdown octane\n```\n\nThe adapter requires `octane@0.1.12` or newer. Octane is an optional peer dependency and is not imported by any other package entry.\n\n## Component usage\n\n```tsrx\nimport { Markdown } from '@tanstack/markdown/octane'\n\nexport function Article({ source }: { source: string }) @{\n  <article>\n    <Markdown>{source}</Markdown>\n  </article>\n}\n```\n\n`Markdown` returns an Octane fragment descriptor, so the surrounding semantic element remains under application control.\n\n## Replace intrinsic elements\n\nMap an emitted tag name to an Octane component or another host tag:\n\n```ts\nimport { createElement, type ComponentBody } from 'octane'\nimport { Markdown } from '@tanstack/markdown/octane'\n\nconst ExternalLink: ComponentBody<any> = props =>\n  createElement('a', {\n    ...props,\n    rel: 'noreferrer',\n    target: '_blank',\n  })\n\nconst article = Markdown({\n  children: source,\n  components: { a: ExternalLink },\n})\n```\n\nMappings apply to intrinsic tags and custom element names emitted by docs extensions.\n\n## Static SSR\n\n```ts\nimport { renderToStaticMarkup } from 'octane/server'\nimport { Markdown } from '@tanstack/markdown/octane'\n\nconst { html, css } = renderToStaticMarkup(Markdown, {\n  children: source,\n})\n```\n\nCore Octane SSR output is tested for structural parity with `renderHtml()`, including tight and loose lists, tables, footnotes, docs extensions, and highlighted code.\n\n## Parse once\n\n```ts\nimport { parseMarkdown } from '@tanstack/markdown/parser'\nimport { Markdown } from '@tanstack/markdown/octane'\n\nconst document = parseMarkdown(source)\nconst article = Markdown({ children: document })\n```\n\nUse `renderMarkdownOctane`, `renderBlockOctane`, and `renderInlineOctane` when composing descriptors outside the component API.\n\n## Trusted boundaries\n\nRaw HTML uses Octane's `dangerouslySetInnerHTML` contract when `allowHtml` is enabled. Highlighter output uses the same path inside `<code>`. Keep both disabled for untrusted content unless the output is sanitized by the application.\n","originalRawMarkdown":"---\ntitle: Octane\n---\n\n# Octane\n\nThe Octane adapter renders Markdown source or a pre-parsed document directly to Octane element descriptors. It imports only the Octane runtime and does not produce an intermediate HTML string.\n\n## Installation\n\n```bash\npnpm add @tanstack/markdown octane\n```\n\nThe adapter requires `octane@0.1.12` or newer. Octane is an optional peer dependency and is not imported by any other package entry.\n\n## Component usage\n\n```tsrx\nimport { Markdown } from '@tanstack/markdown/octane'\n\nexport function Article({ source }: { source: string }) @{\n  <article>\n    <Markdown>{source}</Markdown>\n  </article>\n}\n```\n\n`Markdown` returns an Octane fragment descriptor, so the surrounding semantic element remains under application control.\n\n## Replace intrinsic elements\n\nMap an emitted tag name to an Octane component or another host tag:\n\n```ts\nimport { createElement, type ComponentBody } from 'octane'\nimport { Markdown } from '@tanstack/markdown/octane'\n\nconst ExternalLink: ComponentBody<any> = props =>\n  createElement('a', {\n    ...props,\n    rel: 'noreferrer',\n    target: '_blank',\n  })\n\nconst article = Markdown({\n  children: source,\n  components: { a: ExternalLink },\n})\n```\n\nMappings apply to intrinsic tags and custom element names emitted by docs extensions.\n\n## Static SSR\n\n```ts\nimport { renderToStaticMarkup } from 'octane/server'\nimport { Markdown } from '@tanstack/markdown/octane'\n\nconst { html, css } = renderToStaticMarkup(Markdown, {\n  children: source,\n})\n```\n\nCore Octane SSR output is tested for structural parity with `renderHtml()`, including tight and loose lists, tables, footnotes, docs extensions, and highlighted code.\n\n## Parse once\n\n```ts\nimport { parseMarkdown } from '@tanstack/markdown/parser'\nimport { Markdown } from '@tanstack/markdown/octane'\n\nconst document = parseMarkdown(source)\nconst article = Markdown({ children: document })\n```\n\nUse `renderMarkdownOctane`, `renderBlockOctane`, and `renderInlineOctane` when composing descriptors outside the component API.\n\n## Trusted boundaries\n\nRaw HTML uses Octane's `dangerouslySetInnerHTML` contract when `allowHtml` is enabled. Highlighter output uses the same path inside `<code>`. Keep both disabled for untrusted content unless the output is sanitized by the application.\n"}
