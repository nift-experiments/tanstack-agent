stack/markdown/html'\n\nconst document = parseMarkdown(source)\nconst cached = JSON.stringify(document)\nconst html = renderHtml(document)","lang":"ts"},{"type":"code","value":"import { Markdown } from '@tanstack/markdown/react'\n\n<Markdown>{document}</Markdown>","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The same document can render through Octane:"}]},{"type":"code","value":"import { Markdown as OctaneMarkdown } from '@tanstack/markdown/octane'\n\nconst article = OctaneMarkdown({ children: document })","lang":"ts"},{"type":"heading","depth":2,"id":"add-heading-anchors","children":[{"type":"text","value":"Add heading anchors"}]},{"type":"paragraph","children":[{"type":"text","value":"Headings receive stable, duplicate-safe IDs by default. Anchor links are opt-in:"}]},{"type":"code","value":"const html = renderHtml(source, {\n  headingAnchors: {\n    content: '#',\n    className: 'heading-anchor',\n  },\n})","lang":"ts"},{"type":"heading","depth":2,"id":"add-docs-extensions","children":[{"type":"text","value":"Add docs extensions"}]},{"type":"code","value":"import { parseMarkdown } from '@tanstack/markdown/parser'\nimport { renderHtml } from '@tanstack/markdown/html'\nimport { docsMarkdownExtensions } from '@tanstack/markdown/extensions/docs'\n\nconst options = {\n  extensions: docsMarkdownExtensions(),\n}\n\nconst document = parseMarkdown(source, options)\nconst html = renderHtml(document, options)","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The preset adds callouts, heading collection, and TanStack-style comment components without changing the core entry points. See the "},{"type":"link","href":"./guides/docs-preset.md","children":[{"type":"text","value":"Docs Preset"}]},{"type":"text","value":" guide."}]},{"type":"heading","depth":2,"id":"highlight-code","children":[{"type":"text","value":"Highlight code"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Markdown owns each "},{"type":"inlineCode","value":"<pre><code>"},{"type":"text","value":" tree and accepts trusted inner token markup through its "},{"type":"inlineCode","value":"highlighter"},{"type":"text","value":" callback. TanStack Highlight provides "},{"type":"inlineCode","value":"createTanStackMarkdownHighlighter()"},{"type":"text","value":" for this boundary; do not pass a high-level method that returns another code-block wrapper."}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"./guides/syntax-highlighting.md","children":[{"type":"text","value":"Syntax Highlighting"}]},{"type":"text","value":" for the complete React and HTML setup, explicit language registration, light and dark themes, line numbers, and security boundary."}]},{"type":"heading","depth":2,"id":"next-steps","children":[{"type":"text","value":"Next steps"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Confirm your content fits the "},{"type":"link","href":"./core-concepts/syntax-profile.md","children":[{"type":"text","value":"Syntax Profile"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Review the "},{"type":"link","href":"./core-concepts/security.md","children":[{"type":"text","value":"Security"}]},{"type":"text","value":" boundary before enabling HTML or highlighting."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"link","href":"./reference/index.md","children":[{"type":"text","value":"API Reference"}]},{"type":"text","value":" for complete options and signatures."}]}]}]}],"headings":[{"id":"quick-start","text":"Quick Start","level":1},{"id":"render-html","text":"Render HTML","level":2},{"id":"render-react","text":"Render React","level":2},{"id":"render-octane","text":"Render Octane","level":2},{"id":"parse-once","text":"Parse once","level":2},{"id":"add-heading-anchors","text":"Add heading anchors","level":2},{"id":"add-docs-extensions","text":"Add docs extensions","level":2},{"id":"highlight-code","text":"Highlight code","level":2},{"id":"next-steps","text":"Next steps","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Quick Start\n\n## Render HTML\n\n```ts group=quick-start-html env=client file=/src/main.ts entry\nimport { renderHtml } from '@tanstack/markdown/html'\n\nconst source = `# Release notes\n\n- Small browser bundle\n- HTML, React, and Octane renderers\n- Safe defaults`\n\nconst html = renderHtml(source)\n\nexport default function render(output: HTMLElement) {\n  output.innerHTML = `<article>${html}</article>`\n}\n```\n\n`renderHtml` accepts Markdown source or an existing `MarkdownDocument`.\n\n## Render React\n\n```tsx group=quick-start-react env=react file=/src/main.tsx entry\nimport { Markdown } from '@tanstack/markdown/react'\n\nconst source = `# Release notes\n\n- Small browser bundle\n- HTML, React, and Octane renderers\n- Safe defaults`\n\nexport default function Article() {\n  return (\n    <article>\n      <Markdown>{source}</Markdown>\n    </article>\n  )\n}\n\n```\n\nReplace intrinsic elements through `components`:\n\n```tsx\nimport { Markdown } from '@tanstack/markdown/react'\nimport { Link } from './Link'\n\n<Markdown components={{ a: Link }}>{source}</Markdown>\n```\n\n## Render Octane\n\n```tsrx\nimport { Markdown } from '@tanstack/markdown/octane'\n\nexport function Article({ source }: { source: string }) @{\n  <article>\n    <Markdown>{source}</Markdown>\n  </article>\n}\n```\n\nReplace host elements with Octane components through the same `components` option.\n\n## Parse once\n\nFor build-time content or repeated rendering, parse once and reuse the AST:\n\n```ts\nimport { parseMarkdown } from '@tanstack/markdown/parser'\nimport { renderHtml } from '@tanstack/markdown/html'\n\nconst document = parseMarkdown(source)\nconst cached = JSON.stringify(document)\nconst html = renderHtml(document)\n```\n\n```tsx\nimport { Markdown } from '@tanstack/markdown/react'\n\n<Markdown>{document}</Markdown>\n```\n\nThe same document can render through Octane:\n\n```ts\nimport { Markdown as OctaneMarkdown } from '@tanstack/markdown/octane'\n\nconst article = OctaneMarkdown({ children: document })\n```\n\n## Add heading anchors\n\nHeadings receive stable, duplicate-safe IDs by default. Anchor links are opt-in:\n\n```ts\nconst html = renderHtml(source, {\n  headingAnchors: {\n    content: '#',\n    className: 'heading-anchor',\n  },\n})\n```\n\n## Add docs extensions\n\n```ts\nimport { parseMarkdown } from '@tanstack/markdown/parser'\nimport { renderHtml } from '@tanstack/markdown/html'\nimport { docsMarkdownExtensions } from '@tanstack/markdown/extensions/docs'\n\nconst options = {\n  extensions: docsMarkdownExtensions(),\n}\n\nconst document = parseMarkdown(source, options)\nconst html = renderHtml(document, options)\n```\n\nThe preset adds callouts, heading collection, and TanStack-style comment components without changing the core entry points. See the [Docs Preset](./guides/docs-preset.md) guide.\n\n## Highlight code\n\nTanStack Markdown owns each `<pre><code>` tree and accepts trusted inner token markup through its `highlighter` callback. TanStack Highlight provides `createTanStackMarkdownHighlighter()` for this boundary; do not pass a high-level method that returns another code-block wrapper.\n\nSee [Syntax Highlighting](./guides/syntax-highlighting.md) for the complete React and HTML setup, explicit language registration, light and dark themes, line numbers, and security boundary.\n\n## Next steps\n\n- Confirm your content fits the [Syntax Profile](./core-concepts/syntax-profile.md).\n- Review the [Security](./core-concepts/security.md) boundary before enabling HTML or highlighting.\n- Use the [API Reference](./reference/index.md) for complete options and signatures.\n","originalRawMarkdown":"---\ntitle: Quick Start\n---\n\n# Quick Start\n\n## Render HTML\n\n```ts group=quick-start-html env=client file=/src/main.ts entry\nimport { renderHtml } from '@tanstack/markdown/html'\n\nconst source = `# Release notes\n\n- Small browser bundle\n- HTML, React, and Octane renderers\n- Safe defaults`\n\nconst html = renderHtml(source)\n\nexport default function render(output: HTMLElement) {\n  output.innerHTML = `<article>${html}</article>`\n}\n```\n\n`renderHtml` accepts Markdown source or an existing `MarkdownDocument`.\n\n## Render React\n\n```tsx group=quick-start-react env=react file=/src/main.tsx entry\nimport { Markdown } from '@tanstack/markdown/react'\n\nconst source = `# Release notes\n\n- Small browser bundle\n- HTML, React, and Octane renderers\n- Safe defaults`\n\nexport default function Article() {\n  return (\n    <article>\n      <Markdown>{source}</Markdown>\n    </article>\n  )\n}\n\n```\n\nReplace intrinsic elements through `components`:\n\n```tsx\nimport { Markdown } from '@tanstack/markdown/react'\nimport { Link } from './Link'\n\n<Markdown components={{ a: Link }}>{source}</Markdown>\n```\n\n## Render Octane\n\n```tsrx\nimport { Markdown } from '@tanstack/markdown/octane'\n\nexport function Article({ source }: { source: string }) @{\n  <article>\n    <Markdown>{source}</Markdown>\n  </article>\n}\n```\n\nReplace host elements with Octane components through the same `components` option.\n\n## Parse once\n\nFor build-time content or repeated rendering, parse once and reuse the AST:\n\n```ts\nimport { parseMarkdown } from '@tanstack/markdown/parser'\nimport { renderHtml } from '@tanstack/markdown/html'\n\nconst document = parseMarkdown(source)\nconst cached = JSON.stringify(document)\nconst html = renderHtml(document)\n```\n\n```tsx\nimport { Markdown } from '@tanstack/markdown/react'\n\n<Markdown>{document}</Markdown>\n```\n\nThe same document can render through Octane:\n\n```ts\nimport { Markdown as OctaneMarkdown } from '@tanstack/markdown/octane'\n\nconst article = OctaneMarkdown({ children: document })\n```\n\n## Add heading anchors\n\nHeadings receive stable, duplicate-safe IDs by default. Anchor links are opt-in:\n\n```ts\nconst html = renderHtml(source, {\n  headingAnchors: {\n    content: '#',\n    className: 'heading-anchor',\n  },\n})\n```\n\n## Add docs extensions\n\n```ts\nimport { parseMarkdown } from '@tanstack/markdown/parser'\nimport { renderHtml } from '@tanstack/markdown/html'\nimport { docsMarkdownExtensions } from '@tanstack/markdown/extensions/docs'\n\nconst options = {\n  extensions: docsMarkdownExtensions(),\n}\n\nconst document = parseMarkdown(source, options)\nconst html = renderHtml(document, options)\n```\n\nThe preset adds callouts, heading collection, and TanStack-style comment components without changing the core entry points. See the [Docs Preset](./guides/docs-preset.md) guide.\n\n## Highlight code\n\nTanStack Markdown owns each `<pre><code>` tree and accepts trusted inner token markup through its `highlighter` callback. TanStack Highlight provides `createTanStackMarkdownHighlighter()` for this boundary; do not pass a high-level method that returns another code-block wrapper.\n\nSee [Syntax Highlighting](./guides/syntax-highlighting.md) for the complete React and HTML setup, explicit language registration, light and dark themes, line numbers, and security boundary.\n\n## Next steps\n\n- Confirm your content fits the [Syntax Profile](./core-concepts/syntax-profile.md).\n- Review the [Security](./core-concepts/security.md) boundary before enabling HTML or highlighting.\n- Use the [API Reference](./reference/index.md) for complete options and signatures.\n"}
