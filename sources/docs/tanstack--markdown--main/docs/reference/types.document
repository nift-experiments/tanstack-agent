rong text."}]},{"type":"heading","depth":3,"id":"emphasisnode","children":[{"type":"inlineCode","value":"EmphasisNode"}]},{"type":"paragraph","children":[{"type":"text","value":"Contains inline "},{"type":"inlineCode","value":"children"},{"type":"text","value":" rendered as emphasized text."}]},{"type":"heading","depth":3,"id":"strikenode","children":[{"type":"inlineCode","value":"StrikeNode"}]},{"type":"paragraph","children":[{"type":"text","value":"Contains inline "},{"type":"inlineCode","value":"children"},{"type":"text","value":" rendered as deleted text."}]},{"type":"heading","depth":3,"id":"footnotereferencenode","children":[{"type":"inlineCode","value":"FootnoteReferenceNode"}]},{"type":"paragraph","children":[{"type":"text","value":"Contains normalized footnote "},{"type":"inlineCode","value":"id"},{"type":"text","value":", display "},{"type":"inlineCode","value":"number"},{"type":"text","value":", and optional "},{"type":"inlineCode","value":"referenceIndex"},{"type":"text","value":" for repeated references."}]},{"type":"heading","depth":3,"id":"linknode","children":[{"type":"inlineCode","value":"LinkNode"}]},{"type":"paragraph","children":[{"type":"text","value":"Contains policy-processed "},{"type":"inlineCode","value":"href"},{"type":"text","value":", optional "},{"type":"inlineCode","value":"title"},{"type":"text","value":", and inline "},{"type":"inlineCode","value":"children"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"imagenode","children":[{"type":"inlineCode","value":"ImageNode"}]},{"type":"paragraph","children":[{"type":"text","value":"Contains policy-processed "},{"type":"inlineCode","value":"src"},{"type":"text","value":", text "},{"type":"inlineCode","value":"alt"},{"type":"text","value":", and optional "},{"type":"inlineCode","value":"title"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"breaknode","children":[{"type":"inlineCode","value":"BreakNode"}]},{"type":"paragraph","children":[{"type":"text","valu