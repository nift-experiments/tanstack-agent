ull,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Utility"}]},{"type":"tableCell","children":[{"type":"text","value":"Instance API"}]},{"type":"tableCell","children":[{"type":"text","value":"State and value helpers"}]}],"rows":[[{"type":"tableCell","children":[{"type":"link","href":"./guides/batching.md","children":[{"type":"text","value":"batching"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createBatcher"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/debouncing.md","children":[{"type":"text","value":"debouncing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createDebouncer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createDebouncedState"},{"type":"text","value":", "},{"type":"inlineCode","value":"createDebouncedValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/queuing.md","children":[{"type":"text","value":"queuing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createQueuer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createQueuedState"},{"type":"text","value":", "},{"type":"inlineCode","value":"createQueuedValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/rate-limiting.md","children":[{"type":"text","value":"rate limiting"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createRateLimiter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createRateLimitedState"},{"type":"text","value":", "},{"type":"inlineCode","value":"createRateLimitedValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/throttling.md","children":[{"type":"text","value":"throttling"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createThrottler"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createThrottledState"},{"type":"text","value":", "},{"type":"inlineCode","value":"createThrottledValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-batching.md","children":[{"type":"text","value":"async batching"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncBatcher"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-debouncing.md","children":[{"type":"text","value":"async debouncing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncDebouncer"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-queuing.md","children":[{"type":"text","value":"async queuing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncQueuer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncQueuedState"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-rate-limiting.md","children":[{"type":"text","value":"async rate limiting"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncRateLimiter"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-throttling.md","children":[{"type":"text","value":"async throttling"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncThrottler"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}]]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"This counter coalesces rapid clicks into one update after 500 ms. Flush applies the latest pending count immediately."}]},{"type":"code","value":"import Alpine from 'alpinejs'\nimport { createPacerScope } from '@tanstack/alpine-pacer'\nimport type { AlpineDebouncer } from '@tanstack/alpine-pacer'\n\nAlpine.data('counter', () => {\n  const scope = createPacerScope()\n  return {\n    count: 0,\n    debouncedCount: 0,\n    debouncer: null as AlpineDebouncer<\n      (value: number) => void,\n      { isPending: boolean }\n    > | null,\n    init() {\n      this.debouncer = scope.createDebouncer(\n        (value: number) => {\n          this.debouncedCount = value\n        },\n        { wait: 500 },\n        (state) => ({ isPending: state.isPending }),\n      )\n    },\n    increment() {\n      this.debouncer!.maybeExecute(++this.count)\n    },\n    destroy() {\n      scope.destroy()\n    },\n  }\n})\nAlpine.start()","lang":"ts"},{"type":"code","value":"<div x-data=\"counter\">\n  <button @click=\"increment\">Increment</button>\n  <p>\n    Count: <span x-text=\"count\"></span>. Debounced:\n    <span x-text=\"debouncedCount\"></span>.\n  </p>\n  <p>Pending: <span x-text=\"debouncer.state.isPending\"></span></p>\n  <button @click=\"debouncer.flush()\">Flush</button>\n</div>","lang":"html"},{"type":"heading","depth":2,"id":"child-subscriptions","children":[{"type":"text","value":"Child subscriptions"}]},{"type":"paragraph","children":[{"type":"text","value":"Call "},{"type":"inlineCode","value":"utility.subscribe(childScope, selector)"},{"type":"text","value":" for a child Alpine component. It returns a reactive getter without changing the utility owner's selection. Destroy the child scope in the component's "},{"type":"inlineCode","value":"destroy"},{"type":"text","value":" hook."}]},{"type":"code","value":"const selected = debouncer.subscribe(childScope, (state) => ({\n  isPending: state.isPending,\n}))\n// Read selected().isPending in the child's template or reactive getter.","lang":"ts"},{"type":"heading","depth":2,"id":"reactive-options","children":[{"type":"text","value":"Reactive options"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass a plain options object, property getters, or an options factory. The adapter evaluates top-level getters, while function-valued core options remain callbacks. Options update the existing utility; pending work, counters, and the store retain their identity."}]},{"type":"paragraph","children":[{"type":"text","value":"Options retain the core partial-merge behavior. Omitting a key preserves the previous setting; explicitly passing "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" clears it. "},{"type":"inlineCode","value":"key"},{"type":"text","value":", "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":", and "},{"type":"inlineCode","value":"initialItems"},{"type":"text","value":" initialize the utility once and do not recreate it on later updates."}]},{"type":"heading","depth":2,"id":"default-options","children":[{"type":"text","value":"Default options"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass defaults to "},{"type":"inlineCode","value":"createPacerScope"},{"type":"text","value":", either as an object or a factory. All utilities created through that scope inherit them. Use utility keys such as "},{"type":"inlineCode","value":"debouncer"},{"type":"text","value":" and "},{"type":"inlineCode","value":"asyncQueuer"},{"type":"text","value":"; local options take precedence."}]},{"type":"heading","depth":2,"id":"cleanup","children":[{"type":"text","value":"Cleanup"}]},{"type":"paragraph","children":[{"type":"text","value":"Debouncers, throttlers, and batchers cancel pending timers by default. Queuers stop processing. Async variants also abort active work. Synchronous rate limiters need no timer cleanup."}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" to replace the default cleanup, for example to call "},{"type":"inlineCode","value":"flush()"},{"type":"text","value":" before leaving a page. The callback receives the adapter instance and its selected state. If you replace cleanup for an async utility, call its cancellation or abort methods when needed."}]},{"type":"heading","depth":2,"id":"event-handlers-and-value-helpers","children":[{"type":"text","value":"Event handlers and value helpers"}]},{"type":"paragraph","children":[{"type":"text","value":"Use an instance method as the event handler: "},{"type":"inlineCode","value":"maybeExecute"},{"type":"text","value":" for debouncing, throttling, and rate limiting, or "},{"type":"inlineCode","value":"addItem"},{"type":"text","value":" for batching. The instance also provides control methods and state subscriptions."}]},{"type":"paragraph","children":[{"type":"text","value":"State helpers return "},{"type":"inlineCode","value":"[value, setValue, utility]"},{"type":"text","value":"; value helpers return "},{"type":"inlineCode","value":"[value, utility]"},{"type":"text","value":". Read values by calling their accessors. Setters accept a new value or a functional update. Synchronous queue state helpers return "},{"type":"inlineCode","value":"[itemsAccessor, addItem, utility]"},{"type":"text","value":". Async queue state helpers return "},{"type":"inlineCode","value":"[itemsAccessor, utility]"},{"type":"text","value":"; call "},{"type":"inlineCode","value":"utility.addItem()"},{"type":"text","value":" to enqueue an item. Queued value helpers return the last processed value, rather than the list of pending items."}]},{"type":"heading","depth":2,"id":"async-utilities","children":[{"type":"text","value":"Async utilities"}]},{"type":"paragraph","children":[{"type":"text","value":"The five async utilities preserve typed results and core error behavior. Use "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" for outcomes, and "},{"type":"inlineCode","value":"asyncRetryerOptions"},{"type":"text","value":" for retry configuration. "},{"type":"inlineCode","value":"abort()"},{"type":"text","value":" is cooperative: your operation must observe the supplied abort signal. See the individual async guides for scheduling and concurrency details."}]},{"type":"heading","depth":2,"id":"devtools","children":[{"type":"text","value":"Devtools"}]},{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/devtools"},{"type":"text","value":" and "},{"type":"inlineCode","value":"@tanstack/pacer-devtools"},{"type":"text","value":". Mount "},{"type":"inlineCode","value":"TanStackDevtoolsCore"},{"type":"text","value":" with "},{"type":"inlineCode","value":"plugins: [pacerDevtoolsPlugin()]"},{"type":"text","value":" once in your application and unmount it during cleanup. Give each utility a "},{"type":"inlineCode","value":"key"},{"type":"text","value":" to make it appear in the Pacer panel."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../../devtools.md#lit-alpine-ember-and-octane-setup","children":[{"type":"text","value":"devtools setup guide"}]},{"type":"text","value":" for this framework's mount and cleanup code."}]},{"type":"heading","depth":2,"id":"api-reference","children":[{"type":"text","value":"API reference"}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./reference/index.md","children":[{"type":"text","value":"generated reference"}]},{"type":"text","value":" for signatures, options, and return types."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"lifecycle-and-state","text":"Lifecycle and state","level":2},{"id":"api-overview","text":"API overview","level":2},{"id":"example","text":"Example","level":2},{"id":"child-subscriptions","text":"Child subscriptions","level":2},{"id":"reactive-options","text":"Reactive options","level":2},{"id":"default-options","text":"Default options","level":2},{"id":"cleanup","text":"Cleanup","level":2},{"id":"event-handlers-and-value-helpers","text":"Event handlers and value helpers","level":2},{"id":"async-utilities","text":"Async utilities","level":2},{"id":"devtools","text":"Devtools","level":2},{"id":"api-reference","text":"API reference","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe `alpine-pacer` adapter connects Pacer scheduling utilities to Alpine state and lifecycle management. It re-exports the core package, including utility classes, stateless functions, option types, and async retrying.\n\n## Installation\n\n```sh\npnpm add @tanstack/alpine-pacer\n```\n\nThe package is ESM-only and requires Node.js 20 or newer when running in Node.js.\n\n## Lifecycle and state\n\nCreate a `createPacerScope()` for each component and call `scope.destroy()` from Alpine's `destroy` hook. Scope methods own option effects, state subscriptions, and utility cleanup. Alternatively, install `pacerPlugin` to use the automatically owned `$pacer` magic. Read selected state through `utility.state`.\n\nBy default, the selected state is `{}`. Pass a selector to subscribe only to the fields your UI reads. The underlying `store` remains available for additional subscriptions.\n\n## API overview\n\n| Utility | Instance API | State and value helpers |\n| ------------------------------------------------------ | ------------------------ | ------------------------------------------------------------------------------- |\n| [batching](./guides/batching.md) | `createBatcher` | None |\n| [debouncing](./guides/debouncing.md) | `createDebouncer` | `createDebouncedState`, `createDebouncedValue` |\n| [queuing](./guides/queuing.md) | `createQueuer` | `createQueuedState`, `createQueuedValue` |\n| [rate limiting](./guides/rate-limiting.md) | `createRateLimiter` | `createRateLimitedState`, `createRateLimitedValue` |\n| [throttling](./guides/throttling.md) | `createThrottler` | `createThrottledState`, `createThrottledValue` |\n| [async batching](./guides/async-batching.md) | `createAsyncBatcher` | None |\n| [async debouncing](./guides/async-debouncing.md) | `createAsyncDebouncer` | None |\n| [async queuing](./guides/async-queuing.md) | `createAsyncQueuer` | `createAsyncQueuedState` |\n| [async rate limiting](./guides/async-rate-limiting.md) | `createAsyncRateLimiter` | None |\n| [async throttling](./guides/async-throttling.md) | `createAsyncThrottler` | None |\n\n## Example\n\nThis counter coalesces rapid clicks into one update after 500 ms. Flush applies the latest pending count immediately.\n\n```ts\nimport Alpine from 'alpinejs'\nimport { createPacerScope } from '@tanstack/alpine-pacer'\nimport type { AlpineDebouncer } from '@tanstack/alpine-pacer'\n\nAlpine.data('counter', () => {\n  const scope = createPacerScope()\n  return {\n    count: 0,\n    debouncedCount: 0,\n    debouncer: null as AlpineDebouncer<\n      (value: number) => void,\n      { isPending: boolean }\n    > | null,\n    init() {\n      this.debouncer = scope.createDebouncer(\n        (value: number) => {\n          this.debouncedCount = value\n        },\n        { wait: 500 },\n        (state) => ({ isPending: state.isPending }),\n      )\n    },\n    increment() {\n      this.debouncer!.maybeExecute(++this.count)\n    },\n    destroy() {\n      scope.destroy()\n    },\n  }\n})\nAlpine.start()\n```\n\n```html\n<div x-data=\"counter\">\n  <button @click=\"increment\">Increment</button>\n  <p>\n    Count: <span x-text=\"count\"></span>. Debounced:\n    <span x-text=\"debouncedCount\"></span>.\n  </p>\n  <p>Pending: <span x-text=\"debouncer.state.isPending\"></span></p>\n  <button @click=\"debouncer.flush()\">Flush</button>\n</div>\n```\n\n## Child subscriptions\n\nCall `utility.subscribe(childScope, selector)` for a child Alpine component. It returns a reactive getter without changing the utility owner's selection. Destroy the child scope in the component's `destroy` hook.\n\n```ts\nconst selected = debouncer.subscribe(childScope, (state) => ({\n  isPending: state.isPending,\n}))\n// Read selected().isPending in the child's template or reactive getter.\n```\n\n## Reactive options\n\nPass a plain options object, property getters, or an options factory. The adapter evaluates top-level getters, while function-valued core options remain callbacks. Options update the existing utility; pending work, counters, and the store retain their identity.\n\nOptions retain the core partial-merge behavior. Omitting a key preserves the previous setting; explicitly passing `undefined` clears it. `key`, `initialState`, and `initialItems` initialize the utility once and do not recreate it on later updates.\n\n## Default options\n\nPass defaults to `createPacerScope`, either as an object or a factory. All utilities created through that scope inherit them. Use utility keys such as `debouncer` and `asyncQueuer`; local options take precedence.\n\n## Cleanup\n\nDebouncers, throttlers, and batchers cancel pending timers by default. Queuers stop processing. Async variants also abort active work. Synchronous rate limiters need no timer cleanup.\n\nSet `onUnmount` to replace the default cleanup, for example to call `flush()` before leaving a page. The callback receives the adapter instance and its selected state. If you replace cleanup for an async utility, call its cancellation or abort methods when needed.\n\n## Event handlers and value helpers\n\nUse an instance method as the event handler: `maybeExecute` for debouncing, throttling, and rate limiting, or `addItem` for batching. The instance also provides control methods and state subscriptions.\n\nState helpers return `[value, setValue, utility]`; value helpers return `[value, utility]`. Read values by calling their accessors. Setters accept a new value or a functional update. Synchronous queue state helpers return `[itemsAccessor, addItem, utility]`. Async queue state helpers return `[itemsAccessor, utility]`; call `utility.addItem()` to enqueue an item. Queued value helpers return the last processed value, rather than the list of pending items.\n\n## Async utilities\n\nThe five async utilities preserve typed results and core error behavior. Use `onSuccess`, `onError`, and `onSettled` for outcomes, and `asyncRetryerOptions` for retry configuration. `abort()` is cooperative: your operation must observe the supplied abort signal. See the individual async guides for scheduling and concurrency details.\n\n## Devtools\n\nInstall `@tanstack/devtools` and `@tanstack/pacer-devtools`. Mount `TanStackDevtoolsCore` with `plugins: [pacerDevtoolsPlugin()]` once in your application and unmount it during cleanup. Give each utility a `key` to make it appear in the Pacer panel.\n\nSee the [devtools setup guide](../../devtools.md#lit-alpine-ember-and-octane-setup) for this framework's mount and cleanup code.\n\n## API reference\n\nSee the [generated reference](./reference/index.md) for signatures, options, and return types.\n","originalRawMarkdown":"---\ntitle: Alpine Adapter\nid: adapter\n---\n\nThe `alpine-pacer` adapter connects Pacer scheduling utilities to Alpine state and lifecycle management. It re-exports the core package, including utility classes, stateless functions, option types, and async retrying.\n\n## Installation\n\n```sh\npnpm add @tanstack/alpine-pacer\n```\n\nThe package is ESM-only and requires Node.js 20 or newer when running in Node.js.\n\n## Lifecycle and state\n\nCreate a `createPacerScope()` for each component and call `scope.destroy()` from Alpine's `destroy` hook. Scope methods own option effects, state subscriptions, and utility cleanup. Alternatively, install `pacerPlugin` to use the automatically owned `$pacer` magic. Read selected state through `utility.state`.\n\nBy default, the selected state is `{}`. Pass a selector to subscribe only to the fields your UI reads. The underlying `store` remains available for additional subscriptions.\n\n## API overview\n\n| Utility | Instance API | State and value helpers |\n| ------------------------------------------------------ | ------------------------ | ------------------------------------------------------------------------------- |\n| [batching](./guides/batching.md) | `createBatcher` | None |\n| [debouncing](./guides/debouncing.md) | `createDebouncer` | `createDebouncedState`, `createDebouncedValue` |\n| [queuing](./guides/queuing.md) | `createQueuer` | `createQueuedState`, `createQueuedValue` |\n| [rate limiting](./guides/rate-limiting.md) | `createRateLimiter` | `createRateLimitedState`, `createRateLimitedValue` |\n| [throttling](./guides/throttling.md) | `createThrottler` | `createThrottledState`, `createThrottledValue` |\n| [async batching](./guides/async-batching.md) | `createAsyncBatcher` | None |\n| [async debouncing](./guides/async-debouncing.md) | `createAsyncDebouncer` | None |\n| [async queuing](./guides/async-queuing.md) | `createAsyncQueuer` | `createAsyncQueuedState` |\n| [async rate limiting](./guides/async-rate-limiting.md) | `createAsyncRateLimiter` | None |\n| [async throttling](./guides/async-throttling.md) | `createAsyncThrottler` | None |\n\n## Example\n\nThis counter coalesces rapid clicks into one update after 500 ms. Flush applies the latest pending count immediately.\n\n```ts\nimport Alpine from 'alpinejs'\nimport { createPacerScope } from '@tanstack/alpine-pacer'\nimport type { AlpineDebouncer } from '@tanstack/alpine-pacer'\n\nAlpine.data('counter', () => {\n  const scope = createPacerScope()\n  return {\n    count: 0,\n    debouncedCount: 0,\n    debouncer: null as AlpineDebouncer<\n      (value: number) => void,\n      { isPending: boolean }\n    > | null,\n    init() {\n      this.debouncer = scope.createDebouncer(\n        (value: number) => {\n          this.debouncedCount = value\n        },\n        { wait: 500 },\n        (state) => ({ isPending: state.isPending }),\n      )\n    },\n    increment() {\n      this.debouncer!.maybeExecute(++this.count)\n    },\n    destroy() {\n      scope.destroy()\n    },\n  }\n})\nAlpine.start()\n```\n\n```html\n<div x-data=\"counter\">\n  <button @click=\"increment\">Increment</button>\n  <p>\n    Count: <span x-text=\"count\"></span>. Debounced:\n    <span x-text=\"debouncedCount\"></span>.\n  </p>\n  <p>Pending: <span x-text=\"debouncer.state.isPending\"></span></p>\n  <button @click=\"debouncer.flush()\">Flush</button>\n</div>\n```\n\n## Child subscriptions\n\nCall `utility.subscribe(childScope, selector)` for a child Alpine component. It returns a reactive getter without changing the utility owner's selection. Destroy the child scope in the component's `destroy` hook.\n\n```ts\nconst selected = debouncer.subscribe(childScope, (state) => ({\n  isPending: state.isPending,\n}))\n// Read selected().isPending in the child's template or reactive getter.\n```\n\n## Reactive options\n\nPass a plain options object, property getters, or an options factory. The adapter evaluates top-level getters, while function-valued core options remain callbacks. Options update the existing utility; pending work, counters, and the store retain their identity.\n\nOptions retain the core partial-merge behavior. Omitting a key preserves the previous setting; explicitly passing `undefined` clears it. `key`, `initialState`, and `initialItems` initialize the utility once and do not recreate it on later updates.\n\n## Default options\n\nPass defaults to `createPacerScope`, either as an object or a factory. All utilities created through that scope inherit them. Use utility keys such as `debouncer` and `asyncQueuer`; local options take precedence.\n\n## Cleanup\n\nDebouncers, throttlers, and batchers cancel pending timers by default. Queuers stop processing. Async variants also abort active work. Synchronous rate limiters need no timer cleanup.\n\nSet `onUnmount` to replace the default cleanup, for example to call `flush()` before leaving a page. The callback receives the adapter instance and its selected state. If you replace cleanup for an async utility, call its cancellation or abort methods when needed.\n\n## Event handlers and value helpers\n\nUse an instance method as the event handler: `maybeExecute` for debouncing, throttling, and rate limiting, or `addItem` for batching. The instance also provides control methods and state subscriptions.\n\nState helpers return `[value, setValue, utility]`; value helpers return `[value, utility]`. Read values by calling their accessors. Setters accept a new value or a functional update. Synchronous queue state helpers return `[itemsAccessor, addItem, utility]`. Async queue state helpers return `[itemsAccessor, utility]`; call `utility.addItem()` to enqueue an item. Queued value helpers return the last processed value, rather than the list of pending items.\n\n## Async utilities\n\nThe five async utilities preserve typed results and core error behavior. Use `onSuccess`, `onError`, and `onSettled` for outcomes, and `asyncRetryerOptions` for retry configuration. `abort()` is cooperative: your operation must observe the supplied abort signal. See the individual async guides for scheduling and concurrency details.\n\n## Devtools\n\nInstall `@tanstack/devtools` and `@tanstack/pacer-devtools`. Mount `TanStackDevtoolsCore` with `plugins: [pacerDevtoolsPlugin()]` once in your application and unmount it during cleanup. Give each utility a `key` to make it appear in the Pacer panel.\n\nSee the [devtools setup guide](../../devtools.md#lit-alpine-ember-and-octane-setup) for this framework's mount and cleanup code.\n\n## API reference\n\nSee the [generated reference](./reference/index.md) for signatures, options, and return types.\n"}
