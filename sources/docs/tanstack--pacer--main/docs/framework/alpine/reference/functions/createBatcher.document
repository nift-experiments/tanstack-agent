"inlineCode","value":"isPending"},{"type":"text","value":": Whether the batcher is waiting for the timeout to trigger batch processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"items"},{"type":"text","value":": Array of items currently queued for batch processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"size"},{"type":"text","value":": Number of items currently in the batch queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current processing status - 'idle' when not processing, 'pending' when waiting for timeout"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"totalItemsProcessed"},{"type":"text","value":": Total number of items that have been processed across all batches"}]}]}]},{"type":"heading","depth":2,"id":"options-and-ownership","children":[{"type":"text","value":"Options and ownership"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nDestroying the owning scope calls cancel().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"scope","children":[{"type":"text","value":"scope"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/PacerScope.md","children":[{"type":"inlineCode","value":"PacerScope"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Owner of option updates, subscriptions, and cleanup."}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"items"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"}]},{"type":"paragraph","children":[{"type":"text","value":"Function executed by the utility."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AlpinePacerOptions.md","children":[{"type":"inlineCode","value":"AlpinePacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/AlpineBatcherOptions.md","children":[{"type":"inlineCode","value":"AlpineBatcherOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">> = "},{"type":"inlineCode","value":"{}"}]},{"type":"paragraph","children":[{"type":"text","value":"Core options or a reactive factory, plus an optional onUnmount callback."}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"text","value":"Selects state that updates the owner. Omit to leave selected state empty."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/AlpineBatcher.md","children":[{"type":"inlineCode","value":"AlpineBatcher"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The retained utility instance with selected state and child subscriptions."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { createBatcher } from '@tanstack/alpine-pacer'\n\nconst utility = createBatcher(\n  scope, (items: Array<string>) => { console.log(items) },\n  { maxSize: 5, wait: 1000 },\n  (state) => ({ size: state.size }),\n)\nutility.addItem('item')\n// Selected state: utility.state.size","lang":"ts"}],"headings":[{"id":"state-and-subscriptions","text":"State and subscriptions","level":2},{"id":"options-and-ownership","text":"Options and ownership","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"scope","text":"scope","level":3},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createBatcher<TValue, TSelected>(\n   scope,\n   fn,\n   options?,\nselector?): AlpineBatcher<TValue, TSelected>;\n```\n\nDefined in: [batcher/createBatcher.ts:83](https://github.com/TanStack/pacer/blob/main/packages/alpine-pacer/src/batcher/createBatcher.ts#L83)\n\nCreates and retains the Batcher for its Alpine owner.\n\nCollects items and processes them together when maxSize, wait, or getShouldExecute triggers a batch. Use addItem to accumulate work and flush to process a partial batch.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nUse utility.subscribe(childScope, selector) for a child subscription. It returns a getter\nand cleans up with the child without canceling the parent utility.\n\nAvailable state fields:\n\n- `executionCount`: Number of batch executions that have been completed\n- `isEmpty`: Whether the batcher has no items to process (items array is empty)\n- `isPending`: Whether the batcher is waiting for the timeout to trigger batch processing\n- `items`: Array of items currently queued for batch processing\n- `size`: Number of items currently in the batch queue\n- `status`: Current processing status - 'idle' when not processing, 'pending' when waiting for timeout\n- `totalItemsProcessed`: Total number of items that have been processed across all batches\n\n## Options and ownership\n\nPass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nDestroying the owning scope calls cancel().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### scope\n\n[`PacerScope`](../interfaces/PacerScope.md)\n\nOwner of option updates, subscriptions, and cleanup.\n\n### fn\n\n(`items`) => `void`\n\nFunction executed by the utility.\n\n### options?\n\n[`AlpinePacerOptions`](../type-aliases/AlpinePacerOptions.md)\\<[`AlpineBatcherOptions`](../interfaces/AlpineBatcherOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\nCore options or a reactive factory, plus an optional onUnmount callback.\n\n### selector?\n\n(`state`) => `TSelected`\n\nSelects state that updates the owner. Omit to leave selected state empty.\n\n## Returns\n\n[`AlpineBatcher`](../interfaces/AlpineBatcher.md)\\<`TValue`, `TSelected`\\>\n\nThe retained utility instance with selected state and child subscriptions.\n\n## Example\n\n```ts\nimport { createBatcher } from '@tanstack/alpine-pacer'\n\nconst utility = createBatcher(\n  scope, (items: Array<string>) => { console.log(items) },\n  { maxSize: 5, wait: 1000 },\n  (state) => ({ size: state.size }),\n)\nutility.addItem('item')\n// Selected state: utility.state.size\n```\n","originalRawMarkdown":"---\nid: createBatcher\ntitle: createBatcher\n---\n\n```ts\nfunction createBatcher<TValue, TSelected>(\n   scope,\n   fn,\n   options?,\nselector?): AlpineBatcher<TValue, TSelected>;\n```\n\nDefined in: [batcher/createBatcher.ts:83](https://github.com/TanStack/pacer/blob/main/packages/alpine-pacer/src/batcher/createBatcher.ts#L83)\n\nCreates and retains the Batcher for its Alpine owner.\n\nCollects items and processes them together when maxSize, wait, or getShouldExecute triggers a batch. Use addItem to accumulate work and flush to process a partial batch.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nUse utility.subscribe(childScope, selector) for a child subscription. It returns a getter\nand cleans up with the child without canceling the parent utility.\n\nAvailable state fields:\n\n- `executionCount`: Number of batch executions that have been completed\n- `isEmpty`: Whether the batcher has no items to process (items array is empty)\n- `isPending`: Whether the batcher is waiting for the timeout to trigger batch processing\n- `items`: Array of items currently queued for batch processing\n- `size`: Number of items currently in the batch queue\n- `status`: Current processing status - 'idle' when not processing, 'pending' when waiting for timeout\n- `totalItemsProcessed`: Total number of items that have been processed across all batches\n\n## Options and ownership\n\nPass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nDestroying the owning scope calls cancel().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### scope\n\n[`PacerScope`](../interfaces/PacerScope.md)\n\nOwner of option updates, subscriptions, and cleanup.\n\n### fn\n\n(`items`) => `void`\n\nFunction executed by the utility.\n\n### options?\n\n[`AlpinePacerOptions`](../type-aliases/AlpinePacerOptions.md)\\<[`AlpineBatcherOptions`](../interfaces/AlpineBatcherOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\nCore options or a reactive factory, plus an optional onUnmount callback.\n\n### selector?\n\n(`state`) => `TSelected`\n\nSelects state that updates the owner. Omit to leave selected state empty.\n\n## Returns\n\n[`AlpineBatcher`](../interfaces/AlpineBatcher.md)\\<`TValue`, `TSelected`\\>\n\nThe retained utility instance with selected state and child subscriptions.\n\n## Example\n\n```ts\nimport { createBatcher } from '@tanstack/alpine-pacer'\n\nconst utility = createBatcher(\n  scope, (items: Array<string>) => { console.log(items) },\n  { maxSize: 5, wait: 1000 },\n  (state) => ({ size: state.size }),\n)\nutility.addItem('item')\n// Selected state: utility.state.size\n```\n"}
