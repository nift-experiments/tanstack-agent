{"document":{"type":"root","children":[{"type":"code","value":"function injectAsyncBatcher<TValue, TSelected>(\n   fn,\n   options?,\nselector?): AngularAsyncBatcher<TValue, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/async-batcher/injectAsyncBatcher.ts#L103","children":[{"type":"text","value":"async-batcher/injectAsyncBatcher.ts:103"}]}]},{"type":"paragraph","children":[{"type":"text","value":"An Angular function that creates and manages an AsyncBatcher instance."}]},{"type":"paragraph","children":[{"type":"text","value":"This is a lower-level function that provides direct access to the AsyncBatcher's functionality.\nThis allows you to integrate it with any state management solution you prefer."}]},{"type":"paragraph","children":[{"type":"text","value":"The AsyncBatcher collects items and processes them in batches asynchronously with support for\npromise-based processing, error handling, retry capabilities, and abort support."}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The function uses TanStack Store for state management and wraps it with Angular signals.\nThe "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger signal updates,\noptimizing performance by preventing unnecessary updates when irrelevant state changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes."}]},{"type":"heading","depth":2,"id":"cleanup-on-destroy","children":[{"type":"text","value":"Cleanup on Destroy"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the function cancels any pending batch and aborts in-flight work when the component is destroyed.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this. For example, to flush pending work instead:"}]},{"type":"code","value":"const batcher = injectAsyncBatcher(fn, {\n  maxSize: 10,\n  onUnmount: (b) => b.flush()\n});","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"When using onUnmount with flush, guard your callbacks since the component may already be destroyed."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"items"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AngularPacerOptions.md","children":[{"type":"inlineCode","value":"AngularPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/AngularAsyncBatcherOptions.md","children":[{"type":"inlineCode","value":"AngularAsyncBatcherOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">> = "},{"type":"inlineCode","value":"{}"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/AngularAsyncBatcher.md","children":[{"type":"inlineCode","value":"AngularAsyncBatcher"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst batcher = injectAsyncBatcher(\n  async (items: Array<Data>) => {\n    const response = await fetch('/api/batch', {\n      method: 'POST',\n      body: JSON.stringify(items)\n    });\n    return response.json();\n  },\n  { maxSize: 10, wait: 2000 }\n);\n\n// Add items\nbatcher.addItem(data1);\nbatcher.addItem(data2);\n\n// Access the selected state\nconst { items, isExecuting } = batcher.state();","lang":"ts"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"cleanup-on-destroy","text":"Cleanup on Destroy","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction injectAsyncBatcher<TValue, TSelected>(\n   fn,\n   options?,\nselector?): AngularAsyncBatcher<TValue, TSelected>;\n```\n\nDefined in: [async-batcher/injectAsyncBatcher.ts:103](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/async-batcher/injectAsyncBatcher.ts#L103)\n\nAn Angular function that creates and manages an AsyncBatcher instance.\n\nThis is a lower-level function that provides direct access to the AsyncBatcher's functionality.\nThis allows you to integrate it with any state management solution you prefer.\n\nThe AsyncBatcher collects items and processes them in batches asynchronously with support for\npromise-based processing, error handling, retry capabilities, and abort support.\n\n## State Management and Selector\n\nThe function uses TanStack Store for state management and wraps it with Angular signals.\nThe `selector` parameter allows you to specify which state changes will trigger signal updates,\noptimizing performance by preventing unnecessary updates when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n## Cleanup on Destroy\n\nBy default, the function cancels any pending batch and aborts in-flight work when the component is destroyed.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```ts\nconst batcher = injectAsyncBatcher(fn, {\n  maxSize: 10,\n  onUnmount: (b) => b.flush()\n});\n```\n\nWhen using onUnmount with flush, guard your callbacks since the component may already be destroyed.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n### options?\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<[`AngularAsyncBatcherOptions`](../interfaces/AngularAsyncBatcherOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`AngularAsyncBatcher`](../interfaces/AngularAsyncBatcher.md)\\<`TValue`, `TSelected`\\>\n\n## Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst batcher = injectAsyncBatcher(\n  async (items: Array<Data>) => {\n    const response = await fetch('/api/batch', {\n      method: 'POST',\n      body: JSON.stringify(items)\n    });\n    return response.json();\n  },\n  { maxSize: 10, wait: 2000 }\n);\n\n// Add items\nbatcher.addItem(data1);\nbatcher.addItem(data2);\n\n// Access the selected state\nconst { items, isExecuting } = batcher.state();\n```\n","originalRawMarkdown":"---\nid: injectAsyncBatcher\ntitle: injectAsyncBatcher\n---\n\n```ts\nfunction injectAsyncBatcher<TValue, TSelected>(\n   fn,\n   options?,\nselector?): AngularAsyncBatcher<TValue, TSelected>;\n```\n\nDefined in: [async-batcher/injectAsyncBatcher.ts:103](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/async-batcher/injectAsyncBatcher.ts#L103)\n\nAn Angular function that creates and manages an AsyncBatcher instance.\n\nThis is a lower-level function that provides direct access to the AsyncBatcher's functionality.\nThis allows you to integrate it with any state management solution you prefer.\n\nThe AsyncBatcher collects items and processes them in batches asynchronously with support for\npromise-based processing, error handling, retry capabilities, and abort support.\n\n## State Management and Selector\n\nThe function uses TanStack Store for state management and wraps it with Angular signals.\nThe `selector` parameter allows you to specify which state changes will trigger signal updates,\noptimizing performance by preventing unnecessary updates when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n## Cleanup on Destroy\n\nBy default, the function cancels any pending batch and aborts in-flight work when the component is destroyed.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```ts\nconst batcher = injectAsyncBatcher(fn, {\n  maxSize: 10,\n  onUnmount: (b) => b.flush()\n});\n```\n\nWhen using onUnmount with flush, guard your callbacks since the component may already be destroyed.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n### options?\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<[`AngularAsyncBatcherOptions`](../interfaces/AngularAsyncBatcherOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`AngularAsyncBatcher`](../interfaces/AngularAsyncBatcher.md)\\<`TValue`, `TSelected`\\>\n\n## Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst batcher = injectAsyncBatcher(\n  async (items: Array<Data>) => {\n    const response = await fetch('/api/batch', {\n      method: 'POST',\n      body: JSON.stringify(items)\n    });\n    return response.json();\n  },\n  { maxSize: 10, wait: 2000 }\n);\n\n// Add items\nbatcher.addItem(data1);\nbatcher.addItem(data2);\n\n// Access the selected state\nconst { items, isExecuting } = batcher.state();\n```\n"}
