:"cleanup-on-destroy","children":[{"type":"text","value":"Cleanup on Destroy"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the function aborts in-flight work when the component is destroyed.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyAsyncFunction"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AngularPacerOptions.md","children":[{"type":"inlineCode","value":"AngularPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/AngularAsyncRateLimiterOptions.md","children":[{"type":"inlineCode","value":"AngularAsyncRateLimiterOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/AngularAsyncRateLimiter.md","children":[{"type":"inlineCode","value":"AngularAsyncRateLimiter"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst rateLimiter = injectAsyncRateLimiter(\n  async (id: string) => {\n    const response = await fetch(`/api/data/${id}`);\n    return response.json();\n  },\n  { limit: 5, window: 60000, windowType: 'sliding' }\n);\n\n// In an event handler\nconst handleRequest = async (id: string) => {\n  const result = await rateLimiter.maybeExecute(id);\n  console.log('Result:', result);\n};","lang":"ts"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"cleanup-on-destroy","text":"Cleanup on Destroy","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction injectAsyncRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): AngularAsyncRateLimiter<TFn, TSelected>;\n```\n\nDefined in: [async-rate-limiter/injectAsyncRateLimiter.ts:90](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/async-rate-limiter/injectAsyncRateLimiter.ts#L90)\n\nAn Angular function that creates and manages an AsyncRateLimiter instance.\n\nThis is a lower-level function that provides direct access to the AsyncRateLimiter's functionality.\nThis allows you to integrate it with any state management solution you prefer.\n\nThis function provides async rate limiting functionality with promise support, error handling,\nretry capabilities, and abort support.\n\n## State Management and Selector\n\nThe function uses TanStack Store for state management and wraps it with Angular signals.\nThe `selector` parameter allows you to specify which state changes will trigger signal updates,\noptimizing performance by preventing unnecessary updates when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n## Cleanup on Destroy\n\nBy default, the function aborts in-flight work when the component is destroyed.\nUse the `onUnmount` option to customize this.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<[`AngularAsyncRateLimiterOptions`](../interfaces/AngularAsyncRateLimiterOptions.md)\\<`TFn`, `TSelected`\\>\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`AngularAsyncRateLimiter`](../interfaces/AngularAsyncRateLimiter.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst rateLimiter = injectAsyncRateLimiter(\n  async (id: string) => {\n    const response = await fetch(`/api/data/${id}`);\n    return response.json();\n  },\n  { limit: 5, window: 60000, windowType: 'sliding' }\n);\n\n// In an event handler\nconst handleRequest = async (id: string) => {\n  const result = await rateLimiter.maybeExecute(id);\n  console.log('Result:', result);\n};\n```\n","originalRawMarkdown":"---\nid: injectAsyncRateLimiter\ntitle: injectAsyncRateLimiter\n---\n\n```ts\nfunction injectAsyncRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): AngularAsyncRateLimiter<TFn, TSelected>;\n```\n\nDefined in: [async-rate-limiter/injectAsyncRateLimiter.ts:90](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/async-rate-limiter/injectAsyncRateLimiter.ts#L90)\n\nAn Angular function that creates and manages an AsyncRateLimiter instance.\n\nThis is a lower-level function that provides direct access to the AsyncRateLimiter's functionality.\nThis allows you to integrate it with any state management solution you prefer.\n\nThis function provides async rate limiting functionality with promise support, error handling,\nretry capabilities, and abort support.\n\n## State Management and Selector\n\nThe function uses TanStack Store for state management and wraps it with Angular signals.\nThe `selector` parameter allows you to specify which state changes will trigger signal updates,\noptimizing performance by preventing unnecessary updates when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n## Cleanup on Destroy\n\nBy default, the function aborts in-flight work when the component is destroyed.\nUse the `onUnmount` option to customize this.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<[`AngularAsyncRateLimiterOptions`](../interfaces/AngularAsyncRateLimiterOptions.md)\\<`TFn`, `TSelected`\\>\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`AngularAsyncRateLimiter`](../interfaces/AngularAsyncRateLimiter.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst rateLimiter = injectAsyncRateLimiter(\n  async (id: string) => {\n    const response = await fetch(`/api/data/${id}`);\n    return response.json();\n  },\n  { limit: 5, window: 60000, windowType: 'sliding' }\n);\n\n// In an event handler\nconst handleRequest = async (id: string) => {\n  const result = await rateLimiter.maybeExecute(id);\n  console.log('Result:', result);\n};\n```\n"}
