"type":"heading","depth":3,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Signal"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"initialoptions","children":[{"type":"text","value":"initialOptions"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AngularPacerOptions.md","children":[{"type":"inlineCode","value":"AngularPacerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"DebouncerOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Setter"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>>"}]},{"type":"heading","depth":4,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/DebouncedSignal.md","children":[{"type":"inlineCode","value":"DebouncedSignal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst searchQuery = signal('')\nconst debounced = injectDebouncedValue(searchQuery, {\n  wait: 500, // Wait 500ms after last change\n})\n\n// Opt-in to reactive updates when pending state changes (optimized for loading indicators)\nconst debouncedWithPending = injectDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Debounced value will update 500ms after searchQuery stops changing\neffect(() => {\n  fetchSearchResults(debounced())\n})\n\n// Access selected debouncer state via signals (only if you provided a selector)\neffect(() => {\n  console.log('Is pending:', debouncedWithPending.state().isPending)\n})\n\n// Control the debouncer\ndebounced.cancel() // Cancel any pending updates","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function injectDebouncedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector?): DebouncedSignal<TValue, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/debouncer/injectDebouncedValue.ts#L83","children":[{"type":"text","value":"debouncer/injectDebouncedValue.ts:83"}]}]},{"type":"paragraph","children":[{"type":"text","value":"An Angular function that creates a debounced value that updates only after a specified delay.\nUnlike injectDebouncedSignal, this function automatically tracks changes to the input signal\nand updates the debounced value accordingly."}]},{"type":"paragraph","children":[{"type":"text","value":"The debounced value will only update after the specified wait time has elapsed since\nthe last change to the input value. If the i