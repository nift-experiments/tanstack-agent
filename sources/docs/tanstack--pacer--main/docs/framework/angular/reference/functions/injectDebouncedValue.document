ia the underlying debouncer instance.\nThe "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which debouncer state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes. Only when you provide a selector will\nthe reactive system track the selected state values."}]},{"type":"paragraph","children":[{"type":"text","value":"Available debouncer state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"canLeadingExecute"},{"type":"text","value":": Whether the debouncer can execute on the leading edge"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Number of function executions that have been completed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the debouncer is waiting for the timeout to trigger execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status ('disabled' | 'idle' | 'pending')"}]}]}]},{"type":"heading","depth":3,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tvalue-3","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"tselected-3","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":3,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"value-3","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Signal"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"initialvalue-2","children":[{"type":"text","value":"initialValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"initialoptions-3","children":[{"type":"text","value":"initialOptions"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"inlineCode","value":"DebouncerOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Setter"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>"}]},{"type":"heading","depth":4,"id":"selector-3","children":[{"type":"text","value":"selector"}]},{"type":"paragraph","children":[{"type":"text","value":"(("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":") | "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":3,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/DebouncedSignal.md","children":[{"type":"inlineCode","value":"DebouncedSignal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst searchQuery = signal('')\nconst debounced = injectDebouncedValue(searchQuery, {\n  wait: 500, // Wait 500ms after last change\n})\n\n// Opt-in to reactive updates when pending state changes (optimized for loading indicators)\nconst debouncedWithPending = injectDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Debounced value will update 500ms after searchQuery stops changing\neffect(() => {\n  fetchSearchResults(debounced())\n})\n\n// Access selected debouncer state via signals (only if you provided a selector)\neffect(() => {\n  console.log('Is pending:', debouncedWithPending.state().isPending)\n})\n\n// Control the debouncer\ndebounced.cancel() // Cancel any pending updates","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tvalue","text":"TValue","level":4},{"id":"tselected","text":"TSelected","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"value","text":"value","level":4},{"id":"initialoptions","text":"initialOptions","level":4},{"id":"selector","text":"selector?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"state-management-and-selector-2","text":"State Management and Selector","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tvalue-2","text":"TValue","level":4},{"id":"tselected-2","text":"TSelected","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"value-2","text":"value","level":4},{"id":"initialvalue","text":"initialValue","level":4},{"id":"initialoptions-2","text":"initialOptions","level":4},{"id":"selector-2","text":"selector?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example-2","text":"Example","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"state-management-and-selector-3","text":"State Management and Selector","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tvalue-3","text":"TValue","level":4},{"id":"tselected-3","text":"TSelected","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"value-3","text":"value","level":4},{"id":"initialvalue-2","text":"initialValue","level":4},{"id":"initialoptions-3","text":"initialOptions","level":4},{"id":"selector-3","text":"selector","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"example-3","text":"Example","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction injectDebouncedValue<TValue, TSelected>(\n   value,\n   initialOptions,\nselector?): DebouncedSignal<TValue, TSelected>;\n```\n\nDefined in: [debouncer/injectDebouncedValue.ts:78](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/debouncer/injectDebouncedValue.ts#L78)\n\nAn Angular function that creates a debounced value that updates only after a specified delay.\nUnlike injectDebouncedSignal, this function automatically tracks changes to the input signal\nand updates the debounced value accordingly.\n\nThe debounced value will only update after the specified wait time has elapsed since\nthe last change to the input value. If the input value changes again before the wait\ntime expires, the timer resets and starts waiting again.\n\nThis is useful for deriving debounced values from signals that change frequently,\nlike search queries or form inputs, where you want to limit how often downstream effects\nor calculations occur.\n\nThe function returns a tuple containing:\n- A Signal that provides the current debounced value\n- The debouncer instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying debouncer instance.\nThe `selector` parameter allows you to specify which debouncer state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes. Only when you provide a selector will\nthe reactive system track the selected state values.\n\nAvailable debouncer state properties:\n- `canLeadingExecute`: Whether the debouncer can execute on the leading edge\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the debouncer is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialOptions\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<`DebouncerOptions`\\<`Setter`\\<`TValue`\\>\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`DebouncedSignal`](../interfaces/DebouncedSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst searchQuery = signal('')\nconst debounced = injectDebouncedValue(searchQuery, {\n  wait: 500, // Wait 500ms after last change\n})\n\n// Opt-in to reactive updates when pending state changes (optimized for loading indicators)\nconst debouncedWithPending = injectDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Debounced value will update 500ms after searchQuery stops changing\neffect(() => {\n  fetchSearchResults(debounced())\n})\n\n// Access selected debouncer state via signals (only if you provided a selector)\neffect(() => {\n  console.log('Is pending:', debouncedWithPending.state().isPending)\n})\n\n// Control the debouncer\ndebounced.cancel() // Cancel any pending updates\n```\n\n## Call Signature\n\n```ts\nfunction injectDebouncedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector?): DebouncedSignal<TValue, TSelected>;\n```\n\nDefined in: [debouncer/injectDebouncedValue.ts:83](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/debouncer/injectDebouncedValue.ts#L83)\n\nAn Angular function that creates a debounced value that updates only after a specified delay.\nUnlike injectDebouncedSignal, this function automatically tracks changes to the input signal\nand updates the debounced value accordingly.\n\nThe debounced value will only update after the specified wait time has elapsed since\nthe last change to the input value. If the input value changes again before the wait\ntime expires, the timer resets and starts waiting again.\n\nThis is useful for deriving debounced values from signals that change frequently,\nlike search queries or form inputs, where you want to limit how often downstream effects\nor calculations occur.\n\nThe function returns a tuple containing:\n- A Signal that provides the current debounced value\n- The debouncer instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying debouncer instance.\nThe `selector` parameter allows you to specify which debouncer state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes. Only when you provide a selector will\nthe reactive system track the selected state values.\n\nAvailable debouncer state properties:\n- `canLeadingExecute`: Whether the debouncer can execute on the leading edge\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the debouncer is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### initialOptions\n\n`DebouncerOptions`\\<`Setter`\\<`TValue`\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`DebouncedSignal`](../interfaces/DebouncedSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst searchQuery = signal('')\nconst debounced = injectDebouncedValue(searchQuery, {\n  wait: 500, // Wait 500ms after last change\n})\n\n// Opt-in to reactive updates when pending state changes (optimized for loading indicators)\nconst debouncedWithPending = injectDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Debounced value will update 500ms after searchQuery stops changing\neffect(() => {\n  fetchSearchResults(debounced())\n})\n\n// Access selected debouncer state via signals (only if you provided a selector)\neffect(() => {\n  console.log('Is pending:', debouncedWithPending.state().isPending)\n})\n\n// Control the debouncer\ndebounced.cancel() // Cancel any pending updates\n```\n\n## Call Signature\n\n```ts\nfunction injectDebou