TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Pick"},{"type":"text","value":"<"},{"type":"inlineCode","value":"QueuerState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"items\""},{"type":"text","value":"> = "},{"type":"inlineCode","value":"Pick"},{"type":"text","value":"<"},{"type":"inlineCode","value":"QueuerState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"items\""},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"item"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AngularPacerOptions.md","children":[{"type":"inlineCode","value":"AngularPacerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"QueuerOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">> = "},{"type":"inlineCode","value":"{}"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/QueuedSignal.md","children":[{"type":"inlineCode","value":"QueuedSignal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - track items\nconst queued = injectQueuedSignal(\n  (item) => console.log('Processing:', item),\n  { started: true, wait: 1000 }\n);\n\n// Add items\nqueued.addItem('task1');\n\n// Access items\nconsole.log(queued()); // ['task1']\n\n// Control the queue\nqueued.queuer.start();\nqueued.queuer.stop();","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction injectQueuedSignal<TValue, TSelected>(\n   fn,\n   options?,\nselector?): QueuedSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedSignal.ts:44](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedSignal.ts#L44)\n\nAn Angular function that creates a queuer with managed state, combining Angular's signals with queuing functionality.\nThis function provides both the current queue state and queue control methods.\n\nThe queue state is automatically updated whenever items are added, removed, or reordered in the queue.\nAll queue operations are reflected in the state array returned by the function.\n\nThe function returns a callable object:\n- `queued()`: Get the current queue items as an array\n- `queued.addItem(...)`: Add an item to the queue\n- `queued.queue`: The queuer instance with additional control methods\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n## Parameters\n\n### fn\n\n(`item`) => `void`\n\n### options?\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<`QueuerOptions`\\<`TValue`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`QueuedSignal`](../interfaces/QueuedSignal.md)\\<`TValue`, `TSelected`\\>\n\n## Example\n\n```ts\n// Default behavior - track items\nconst queued = injectQueuedSignal(\n  (item) => console.log('Processing:', item),\n  { started: true, wait: 1000 }\n);\n\n// Add items\nqueued.addItem('task1');\n\n// Access items\nconsole.log(queued()); // ['task1']\n\n// Control the queue\nqueued.queuer.start();\nqueued.queuer.stop();\n```\n","originalRawMarkdown":"---\nid: injectQueuedSignal\ntitle: injectQueuedSignal\n---\n\n```ts\nfunction injectQueuedSignal<TValue, TSelected>(\n   fn,\n   options?,\nselector?): QueuedSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedSignal.ts:44](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedSignal.ts#L44)\n\nAn Angular function that creates a queuer with managed state, combining Angular's signals with queuing functionality.\nThis function provides both the current queue state and queue control methods.\n\nThe queue state is automatically updated whenever items are added, removed, or reordered in the queue.\nAll queue operations are reflected in the state array returned by the function.\n\nThe function returns a callable object:\n- `queued()`: Get the current queue items as an array\n- `queued.addItem(...)`: Add an item to the queue\n- `queued.queue`: The queuer instance with additional control methods\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n## Parameters\n\n### fn\n\n(`item`) => `void`\n\n### options?\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<`QueuerOptions`\\<`TValue`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`QueuedSignal`](../interfaces/QueuedSignal.md)\\<`TValue`, `TSelected`\\>\n\n## Example\n\n```ts\n// Default behavior - track items\nconst queued = injectQueuedSignal(\n  (item) => console.log('Processing:', item),\n  { started: true, wait: 1000 }\n);\n\n// Add items\nqueued.addItem('task1');\n\n// Access items\nconsole.log(queued()); // ['task1']\n\n// Control the queue\nqueued.queuer.start();\nqueued.queuer.stop();\n```\n"}
