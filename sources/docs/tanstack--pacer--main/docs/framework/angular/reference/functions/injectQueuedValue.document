he queue.\nPending items are available through "},{"type":"inlineCode","value":"queued.queuer.state().items"},{"type":"text","value":" with the default selector."}]},{"type":"paragraph","children":[{"type":"text","value":"Pass an options object as the third argument to supply an object or function as the initial\nvalue. When those options are undefined or a factory, pass a fourth selector argument\n(undefined is allowed) to distinguish the initial-value form from options plus a selector."}]},{"type":"heading","depth":3,"id":"type-parameters-4","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tvalue-4","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"tselected-4","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Pick"},{"type":"text","value":"<"},{"type":"inlineCode","value":"QueuerState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"items\""},{"type":"text","value":"> = "},{"type":"inlineCode","value":"Pick"},{"type":"text","value":"<"},{"type":"inlineCode","value":"QueuerState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"items\""},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"value-4","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Signal"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"initialvalue-3","children":[{"type":"text","value":"initialValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"options-4","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"text","value":"| "},{"type":"link","href":"../type-aliases/AngularPacerOptions.md","children":[{"type":"inlineCode","value":"AngularPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/AngularQueuerOptions.md","children":[{"type":"inlineCode","value":"AngularQueuerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">>\n| "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":4,"id":"selector-4","children":[{"type":"text","value":"selector"}]},{"type":"paragraph","children":[{"type":"text","value":"(("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":") | "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":3,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueuedValueSignal.md","children":[{"type":"inlineCode","value":"QueuedValueSignal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const initialValue = signal('initial')\nconst queued = injectQueuedValue(initialValue, {\n  wait: 500,\n  started: true,\n})\n\n// Add changes to the queue\nqueued.addItem('new value')","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tvalue","text":"TValue","level":4},{"id":"tselected","text":"TSelected","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"value","text":"value","level":4},{"id":"options","text":"options?","level":4},{"id":"selector","text":"selector?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tvalue-2","text":"TValue","level":4},{"id":"tselected-2","text":"TSelected","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"value-2","text":"value","level":4},{"id":"initialvalue","text":"initialValue","level":4},{"id":"options-2","text":"options?","level":4},{"id":"selector-2","text":"selector?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example-2","text":"Example","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tvalue-3","text":"TValue","level":4},{"id":"tselected-3","text":"TSelected","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"value-3","text":"value","level":4},{"id":"initialvalue-2","text":"initialValue","level":4},{"id":"options-3","text":"options","level":4},{"id":"selector-3","text":"selector?","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"example-3","text":"Example","level":3},{"id":"call-signature-4","text":"Call Signature","level":2},{"id":"type-parameters-4","text":"Type Parameters","level":3},{"id":"tvalue-4","text":"TValue","level":4},{"id":"tselected-4","text":"TSelected","level":4},{"id":"parameters-4","text":"Parameters","level":3},{"id":"value-4","text":"value","level":4},{"id":"initialvalue-3","text":"initialValue","level":4},{"id":"options-4","text":"options","level":4},{"id":"selector-4","text":"selector","level":4},{"id":"returns-4","text":"Returns","level":3},{"id":"example-4","text":"Example","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction injectQueuedValue<TValue, TSelected>(\n   value,\n   options?,\nselector?): QueuedValueSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedValue.ts:48](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedValue.ts#L48)\n\nAn Angular function that creates a queued value that processes state changes in order with an optional delay.\nThis function uses injectQueuedSignal internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe returned signal provides the most recently processed value. Before the queue processes\nan item, it provides the explicit initial value or the source's initial value.\nSource reads are deferred until the signal is read or Angular runs its effect, so required\ninputs can be bound before their values are read.\n\nUse `queued.addItem(...)` to add a value and `queued.queuer` to control the queue.\nPending items are available through `queued.queuer.state().items` with the default selector.\n\nPass an options object as the third argument to supply an object or function as the initial\nvalue. When those options are undefined or a factory, pass a fourth selector argument\n(undefined is allowed) to distinguish the initial-value form from options plus a selector.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### options?\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<[`AngularQueuerOptions`](../interfaces/AngularQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`QueuedValueSignal`](../type-aliases/QueuedValueSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\nconst initialValue = signal('initial')\nconst queued = injectQueuedValue(initialValue, {\n  wait: 500,\n  started: true,\n})\n\n// Add changes to the queue\nqueued.addItem('new value')\n```\n\n## Call Signature\n\n```ts\nfunction injectQueuedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   options?,\nselector?): QueuedValueSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedValue.ts:59](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedValue.ts#L59)\n\nAn Angular function that creates a queued value that processes state changes in order with an optional delay.\nThis function uses injectQueuedSignal internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe returned signal provides the most recently processed value. Before the queue processes\nan item, it provides the explicit initial value or the source's initial value.\nSource reads are deferred until the signal is read or Angular runs its effect, so required\ninputs can be bound before their values are read.\n\nUse `queued.addItem(...)` to add a value and `queued.queuer` to control the queue.\nPending items are available through `queued.queuer.state().items` with the default selector.\n\nPass an options object as the third argument to supply an object or function as the initial\nvalue. When those options are undefined or a factory, pass a fourth selector argument\n(undefined is allowed) to distinguish the initial-value form from options plus a selector.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`Extract`\\<`TValue`, `PrimitiveInitialValue`\\>\n\n#### options?\n\n[`AngularQueuerOptions`](../interfaces/AngularQueuerOptions.md)\\<`TValue`, `TSelected`\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`QueuedValueSignal`](../type-aliases/QueuedValueSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\nconst initialValue = signal('initial')\nconst queued = injectQueuedValue(initialValue, {\n  wait: 500,\n  started: true,\n})\n\n// Add changes to the queue\nqueued.addItem('new value')\n```\n\n## Call Signature\n\n```ts\nfunction injectQueuedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   options,\nselector?): QueuedValueSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedValue.ts:71](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedValue.ts#L71)\n\nAn Angular function that creates a queued value that processes state changes in order with an optional delay.\nThis function uses injectQueuedSignal internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe returned signal provides the most recently processed value. Before the queue processes\nan item, it provides the explicit initial value or the source's initial value.\nSource reads are deferred until the signal is read or Angular runs its effect, so required\ninputs can be bound before their values are read.\n\nUse `queued.addItem(...)` to add a value and `queued.queuer` to control the queue.\nPending items are available through `queued.queuer.state().items` with the default selector.\n\nPass an options object as the third argument to supply an object or function as the initial\nvalue. When those options are undefined or a factory, pass a fourth selector argument\n(undefined is allowed) to distinguish the initial-value form from options plus a selector.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### options\n\n[`AngularQueuerOptions`](../interfaces/AngularQueuerOptions.md)\\<`TValue`, `TSelected`\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`QueuedValueSignal`](../type-aliases/QueuedValueSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\nconst initialValue = signal('initial')\nconst queued = injectQueuedValue(initialValue, {\n  wait: 500,\n  started: true,\n})\n\n// Add changes to the queue\nqueued.addItem('new value')\n```\n\n## Call Signature\n\n```ts\nfunction injectQueuedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   options,\nselector): QueuedValueSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedValue.ts:83](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedValue.ts#L83)\n\nAn Angular function that creates a queued value that processes state changes in order with an optional delay.\nThis function uses injectQueuedSignal internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe returned signal provides the most recently processed value. Before the queue processes\nan item, it provides the explicit initial value or the source's initial value.\nSource reads are deferred until the signal is read or Angular runs its effect, so required\ninputs can be bound before their values are read.\n\nUse `queued.addItem(...)` to add a value and `queued.queuer` to control the queue.\nPending items are available through `queued.queuer.state().items` with the default selector.\n\nPass an options object as the third argument to supply an object or function as the initial\nvalue. When those options are undefined or a factory, pass a fourth selector argument\n(undefined is allowed) to distinguish the initial-value form from options plus a selector.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### options\n\n  \\| [`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<[`AngularQueuerOptions`](../interfaces/AngularQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\>\n  \\| `undefined`\n\n#### selector\n\n((`state`) => `TSelected`) \\| `undefined`\n\n### Returns\n\n[`QueuedValueSignal`](../type-aliases/QueuedValueSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\nconst initialValue = signal('initial')\nconst queued = injectQueuedValue(initialValue, {\n  wait: 500,\n  started: true,\n})\n\n// Add changes to the queue\nqueued.addItem('new value')\n```\n","originalRawMarkdown":"---\nid: injectQueuedValue\ntitle: injectQueuedValue\n---\n\n## Call Signature\n\n```ts\nfunction injectQueuedValue<TValue, TSelected>(\n   value,\n   options?,\nselector?): QueuedValueSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedValue.ts:48](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedValue.ts#L48)\n\nAn Angular function that creates a queued value that processes state changes in order with an optional delay.\nThis function uses injectQueuedSignal internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe returned signal provides the most recently processed value. Before the queue processes\nan item, it provides the explicit initial value or the source's initial value.\nSource reads are deferred until the signal is read or Angular runs its effect, so required\ninputs can be bound before their values are read.\n\nUse `queued.addItem(...)` to add a value and `queued.queuer` to control the queue.\nPending items are available through `queued.queuer.state().items` with the default selector.\n\nPass an options object as the third argument to supply an object or function as the initial\nvalue. When those options are undefined or a factory, pass a fourth selector argument\n(undefined is allowed) to distinguish the initial-value form from options plus a selector.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### options?\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<[`AngularQueuerOptions`](../interfaces/AngularQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`QueuedValueSignal`](../type-aliases/QueuedValueSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\nconst initialValue = signal('initial')\nconst queued = injectQueuedValue(initialValue, {\n  wait: 500,\n  started: true,\n})\n\n// Add changes to the queue\nqueued.addItem('new value')\n```\n\n## Call Signature\n\n```ts\nfunction injectQueuedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   options?,\nselector?): QueuedValueSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedValue.ts:59](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedValue.ts#L59)\n\nAn Angular function that creates a queued value that processes state changes in order with an optional delay.\nThis function uses injectQueuedSignal internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe returned signal provides the most recently processed value. Before the queue processes\nan item, it provides the explicit initial value or the source's initial value.\nSource reads are deferred until the signal is read or Angular runs its effect, so required\ninputs can be bound before their values are read.\n\nUse `queued.addItem(...)` to add a value and `queued.queuer` to control the queue.\nPending items are available through `queued.queuer.state().items` with the default selector.\n\nPass an options object as the third argument to supply an object or function as the initial\nvalue. When those options are undefined or a factory, pass a fourth selector argument\n(undefined is allowed) to distinguish the initial-value form from options plus a selector.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`Extract`\\<`TValue`, `PrimitiveInitialValue`\\>\n\n#### options?\n\n[`AngularQueuerOptions`](../interfaces/AngularQueuerOptions.md)\\<`TValue`, `TSelected`\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`QueuedValueSignal`](../type-aliases/QueuedValueSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\nconst initialValue = signal('initial')\nconst queued = injectQueuedValue(initialValue, {\n  wait: 500,\n  started: true,\n})\n\n// Add changes to the queue\nqueued.addItem('new value')\n```\n\n## Call Signature\n\n```ts\nfunction injectQueuedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   options,\nselector?): QueuedValueSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedValue.ts:71](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedValue.ts#L71)\n\nAn Angular function that creates a queued value that processes state changes in order with an optional delay.\nThis function uses injectQueuedSignal internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe returned signal provides the most recently processed value. Before the queue processes\nan item, it provides the explicit initial value or the source's initial value.\nSource reads are deferred until the signal is read or Angular runs its effect, so required\ninputs can be bound before their values are read.\n\nUse `queued.addItem(...)` to add a value and `queued.queuer` to control the queue.\nPending items are available through `queued.queuer.state().items` with the default selector.\n\nPass an options object as the third argument to supply an object or function as the initial\nvalue. When those options are undefined or a factory, pass a fourth selector argument\n(undefined is allowed) to distinguish the initial-value form from options plus a selector.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### options\n\n[`AngularQueuerOptions`](../interfaces/AngularQueuerOptions.md)\\<`TValue`, `TSelected`\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`QueuedValueSignal`](../type-aliases/QueuedValueSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\nconst initialValue = signal('initial')\nconst queued = injectQueuedValue(initialValue, {\n  wait: 500,\n  started: true,\n})\n\n// Add changes to the queue\nqueued.addItem('new value')\n```\n\n## Call Signature\n\n```ts\nfunction injectQueuedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   options,\nselector): QueuedValueSignal<TValue, TSelected>;\n```\n\nDefined in: [queuer/injectQueuedValue.ts:83](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/queuer/injectQueuedValue.ts#L83)\n\nAn Angular function that creates a queued value that processes state changes in order with an optional delay.\nThis function uses injectQueuedSignal internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe returned signal provides the most recently processed value. Before the queue processes\nan item, it provides the explicit initial value or the source's initial value.\nSource reads are deferred until the signal is read or Angular runs its effect, so required\ninputs can be bound before their values are read.\n\nUse `queued.addItem(...)` to add a value and `queued.queuer` to control the queue.\nPending items are available through `queued.queuer.state().items` with the default selector.\n\nPass an options object as the third argument to supply an object or function as the initial\nvalue. When those options are undefined or a factory, pass a fourth selector argument\n(undefined is allowed) to distinguish the initial-value form from options plus a selector.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### options\n\n  \\| [`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<[`AngularQueuerOptions`](../interfaces/AngularQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\>\n  \\| `undefined`\n\n#### selector\n\n((`state`) => `TSelected`) \\| `undefined`\n\n### Returns\n\n[`QueuedValueSignal`](../type-aliases/QueuedValueSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\nconst initialValue = signal('initial')\nconst queued = injectQueuedValue(initialValue, {\n  wait: 500,\n  started: true,\n})\n\n// Add changes to the queue\nqueued.addItem('new value')\n```\n"}
