"value":"(("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":") | "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":3,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/RateLimitedSignal.md","children":[{"type":"inlineCode","value":"RateLimitedSignal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst value = signal(0)\nconst rateLimited = injectRateLimitedValue(value, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\n// rateLimited() will update at most 5 times per 60 seconds\neffect(() => {\n  updateUI(rateLimited())\n})","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tvalue","text":"TValue","level":4},{"id":"tselected","text":"TSelected","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"value","text":"value","level":4},{"id":"initialoptions","text":"initialOptions","level":4},{"id":"selector","text":"selector?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"state-management-and-selector-2","text":"State Management and Selector","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tvalue-2","text":"TValue","level":4},{"id":"tselected-2","text":"TSelected","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"value-2","text":"value","level":4},{"id":"initialvalue","text":"initialValue","level":4},{"id":"initialoptions-2","text":"initialOptions","level":4},{"id":"selector-2","text":"selector?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example-2","text":"Example","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"state-management-and-selector-3","text":"State Management and Selector","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tvalue-3","text":"TValue","level":4},{"id":"tselected-3","text":"TSelected","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"value-3","text":"value","level":4},{"id":"initialvalue-2","text":"initialValue","level":4},{"id":"initialoptions-3","text":"initialOptions","level":4},{"id":"selector-3","text":"selector","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"example-3","text":"Example","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction injectRateLimitedValue<TValue, TSelected>(\n   value,\n   initialOptions,\nselector?): RateLimitedSignal<TValue, TSelected>;\n```\n\nDefined in: [rate-limiter/injectRateLimitedValue.ts:51](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/rate-limiter/injectRateLimitedValue.ts#L51)\n\nAn Angular function that creates a rate-limited value that updates at most a certain number of times within a time window.\nUnlike injectRateLimitedSignal, this function automatically tracks changes to the input signal\nand updates the rate-limited value accordingly.\n\nThe rate-limited value will update according to the configured rate limit, blocking updates\nonce the limit is reached until the window resets.\n\nThe function returns a rate-limited signal object containing:\n- A Signal that provides the current rate-limited value\n- The rate limiter instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying rate limiter instance.\nThe `selector` parameter allows you to specify which rate limiter state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialOptions\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<`RateLimiterOptions`\\<`Setter`\\<`TValue`\\>\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`RateLimitedSignal`](../interfaces/RateLimitedSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst value = signal(0)\nconst rateLimited = injectRateLimitedValue(value, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\n// rateLimited() will update at most 5 times per 60 seconds\neffect(() => {\n  updateUI(rateLimited())\n})\n```\n\n## Call Signature\n\n```ts\nfunction injectRateLimitedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector?): RateLimitedSignal<TValue, TSelected>;\n```\n\nDefined in: [rate-limiter/injectRateLimitedValue.ts:56](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/rate-limiter/injectRateLimitedValue.ts#L56)\n\nAn Angular function that creates a rate-limited value that updates at most a certain number of times within a time window.\nUnlike injectRateLimitedSignal, this function automatically tracks changes to the input signal\nand updates the rate-limited value accordingly.\n\nThe rate-limited value will update according to the configured rate limit, blocking updates\nonce the limit is reached until the window resets.\n\nThe function returns a rate-limited signal object containing:\n- A Signal that provides the current rate-limited value\n- The rate limiter instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying rate limiter instance.\nThe `selector` parameter allows you to specify which rate limiter state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### initialOptions\n\n`RateLimiterOptions`\\<`Setter`\\<`TValue`\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`RateLimitedSignal`](../interfaces/RateLimitedSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst value = signal(0)\nconst rateLimited = injectRateLimitedValue(value, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\n// rateLimited() will update at most 5 times per 60 seconds\neffect(() => {\n  updateUI(rateLimited())\n})\n```\n\n## Call Signature\n\n```ts\nfunction injectRateLimitedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector): RateLimitedSignal<TValue, TSelected>;\n```\n\nDefined in: [rate-limiter/injectRateLimitedValue.ts:62](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/rate-limiter/injectRateLimitedValue.ts#L62)\n\nAn Angular function that creates a rate-limited value that updates at most a certain number of times within a time window.\nUnlike injectRateLimitedSignal, this function automatically tracks changes to the input signal\nand updates the rate-limited value accordingly.\n\nThe rate-limited value will update according to the configured rate limit, blocking updates\nonce the limit is reached until the window resets.\n\nThe function returns a rate-limited signal object containing:\n- A Signal that provides the current rate-limited value\n- The rate limiter instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying rate limiter instance.\nThe `selector` parameter allows you to specify which rate limiter state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### initialOptions\n\n() => `RateLimiterOptions`\\<`Setter`\\<`TValue`\\>\\>\n\n#### selector\n\n((`state`) => `TSelected`) \\| `undefined`\n\n### Returns\n\n[`RateLimitedSignal`](../interfaces/RateLimitedSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst value = signal(0)\nconst rateLimited = injectRateLimitedValue(value, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\n// rateLimited() will update at most 5 times per 60 seconds\neffect(() => {\n  updateUI(rateLimited())\n})\n```\n","originalRawMarkdown":"---\nid: injectRateLimitedValue\ntitle: injectRateLimitedValue\n---\n\n## Call Signature\n\n```ts\nfunction injectRateLimitedValue<TValue, TSelected>(\n   value,\n   initialOptions,\nselector?): RateLimitedSignal<TValue, TSelected>;\n```\n\nDefined in: [rate-limiter/injectRateLimitedValue.ts:51](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/rate-limiter/injectRateLimitedValue.ts#L51)\n\nAn Angular function that creates a rate-limited value that updates at most a certain number of times within a time window.\nUnlike injectRateLimitedSignal, this function automatically tracks changes to the input signal\nand updates the rate-limited value accordingly.\n\nThe rate-limited value will update according to the configured rate limit, blocking updates\nonce the limit is reached until the window resets.\n\nThe function returns a rate-limited signal object containing:\n- A Signal that provides the current rate-limited value\n- The rate limiter instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying rate limiter instance.\nThe `selector` parameter allows you to specify which rate limiter state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialOptions\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<`RateLimiterOptions`\\<`Setter`\\<`TValue`\\>\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`RateLimitedSignal`](../interfaces/RateLimitedSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst value = signal(0)\nconst rateLimited = injectRateLimitedValue(value, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\n// rateLimited() will update at most 5 times per 60 seconds\neffect(() => {\n  updateUI(rateLimited())\n})\n```\n\n## Call Signature\n\n```ts\nfunction injectRateLimitedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector?): RateLimitedSignal<TValue, TSelected>;\n```\n\nDefined in: [rate-limiter/injectRateLimitedValue.ts:56](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/rate-limiter/injectRateLimitedValue.ts#L56)\n\nAn Angular function that creates a rate-limited value that updates at most a certain number of times within a time window.\nUnlike injectRateLimitedSignal, this function automatically tracks changes to the input signal\nand updates the rate-limited value accordingly.\n\nThe rate-limited value will update according to the configured rate limit, blocking updates\nonce the limit is reached until the window resets.\n\nThe function returns a rate-limited signal object containing:\n- A Signal that provides the current rate-limited value\n- The rate limiter instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying rate limiter instance.\nThe `selector` parameter allows you to specify which rate limiter state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### initialOptions\n\n`RateLimiterOptions`\\<`Setter`\\<`TValue`\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`RateLimitedSignal`](../interfaces/RateLimitedSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst value = signal(0)\nconst rateLimited = injectRateLimitedValue(value, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\n// rateLimited() will update at most 5 times per 60 seconds\neffect(() => {\n  updateUI(rateLimited())\n})\n```\n\n## Call Signature\n\n```ts\nfunction injectRateLimitedValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector): RateLimitedSignal<TValue, TSelected>;\n```\n\nDefined in: [rate-limiter/injectRateLimitedValue.ts:62](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/rate-limiter/injectRateLimitedValue.ts#L62)\n\nAn Angular function that creates a rate-limited value that updates at most a certain number of times within a time window.\nUnlike injectRateLimitedSignal, this function automatically tracks changes to the input signal\nand updates the rate-limited value accordingly.\n\nThe rate-limited value will update according to the configured rate limit, blocking updates\nonce the limit is reached until the window resets.\n\nThe function returns a rate-limited signal object containing:\n- A Signal that provides the current rate-limited value\n- The rate limiter instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying rate limiter instance.\nThe `selector` parameter allows you to specify which rate limiter state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### initialOptions\n\n() => `RateLimiterOptions`\\<`Setter`\\<`TValue`\\>\\>\n\n#### selector\n\n((`state`) => `TSelected`) \\| `undefined`\n\n### Returns\n\n[`RateLimitedSignal`](../interfaces/RateLimitedSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst value = signal(0)\nconst rateLimited = injectRateLimitedValue(value, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\n// rateLimited() will update at most 5 times per 60 seconds\neffect(() => {\n  updateUI(rateLimited())\n})\n```\n"}
