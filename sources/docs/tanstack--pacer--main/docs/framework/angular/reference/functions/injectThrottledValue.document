ction uses TanStack Store for reactive state management via the underlying throttler instance.\nThe "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which throttler state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes."}]},{"type":"paragraph","children":[{"type":"text","value":"Available throttler state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Number of function executions that have been completed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the throttler is waiting for the timeout to trigger execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastExecutionTime"},{"type":"text","value":": Timestamp of the last execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"nextExecutionTime"},{"type":"text","value":": Timestamp of the next allowed execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status ('disabled' | 'idle' | 'pending')"}]}]}]},{"type":"heading","depth":3,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Signal"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"initialoptions","children":[{"type":"text","value":"initialOptions"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AngularPacerOptions.md","children":[{"type":"inlineCode","value":"AngularPacerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"ThrottlerOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Setter"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>>"}]},{"type":"heading","depth":4,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ThrottledSignal.md","children":[{"type":"inlineCode","value":"ThrottledSignal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst scrollY = signal(0)\nconst throttledScrollY = injectThrottledValue(scrollY, {\n  wait: 100, // Update at most once per 100ms\n})\n\n// Opt-in to reactive updates when pending state changes\nconst throttledScrollYWithState = injectThrottledValue(\n  scrollY,\n  { wait: 100 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Read the throttled signal value\neffect(() => {\n  updateUI(throttledScrollY())\n})\n\n// Access throttler state via the returned object's state() signal\nconsole.log('Is pending:', throttledScrollYWithState.state().isPending)\n\n// Control the throttler\nthrottledScrollY.cancel() // Cancel any pending updates","lang":"ts"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function injectThrottledValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector?): ThrottledSignal<TValue, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/throttler/injectThrottledValue.ts#L79","children":[{"type":"text","value":"throttler/injectThrottledValue.ts:79"}]}]},{"type":"paragraph","children":[{"type":"text","value":"An Angular function that creates a throttled value that updates at most once within a specified time window.\nUnlike injectThrottledSignal, this function automatically tracks changes to the input signal\nand updates the throttled value accordingly."}]},{"type":"paragraph","children":[{"type":"text","value":"The throttled value will update at most once within the specified wait time, regardless of\nhow frequently the input value changes."}]},{"type":"paragraph","children":[{"type":"text","value":"This 