rmance by preventing unnecessary subscriptions when irrelevant state changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes."}]},{"type":"paragraph","children":[{"type":"text","value":"Available throttler state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Number of function executions that have been completed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the throttler is waiting for the timeout to trigger execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastExecutionTime"},{"type":"text","value":": Timestamp of the last execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"nextExecutionTime"},{"type":"text","value":": Timestamp of the next allowed execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status ('disabled' | 'idle' | 'pending')"}]}]}]},{"type":"heading","depth":3,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tvalue-3","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"tselected-3","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":3,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"value-3","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Signal"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"initialvalue-2","children":[{"type":"text","value":"initialValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"initialoptions-3","children":[{"type":"text","value":"initialOptions"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"inlineCode","value":"ThrottlerOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Setter"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>"}]},{"type":"heading","depth":4,"id":"selector-3","children":[{"type":"text","value":"selector"}]},{"type":"paragraph","children":[{"type":"text","value":"(("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":") | "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":3,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ThrottledSignal.md","children":[{"type":"inlineCode","value":"ThrottledSignal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst scrollY = signal(0)\nconst throttledScrollY = injectThrottledValue(scrollY, {\n  wait: 100, // Update at most once per 100ms\n})\n\n// Opt-in to reactive updates when pending state changes\nconst throttledScrollYWithState = injectThrottledValue(\n  scrollY,\n  { wait: 100 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Read the throttled signal value\neffect(() => {\n  updateUI(throttledScrollY())\n})\n\n// Access throttler state via the returned object's state() signal\nconsole.log('Is pending:', throttledScrollYWithState.state().isPending)\n\n// Control the throttler\nthrottledScrollY.cancel() // Cancel any pending updates","lang":"ts"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tvalue","text":"TValue","level":4},{"id":"tselected","text":"TSelected","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"value","text":"value","level":4},{"id":"initialoptions","text":"initialOptions","level":4},{"id":"selector","text":"selector?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"state-management-and-selector-2","text":"State Management and Selector","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tvalue-2","text":"TValue","level":4},{"id":"tselected-2","text":"TSelected","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"value-2","text":"value","level":4},{"id":"initialvalue","text":"initialValue","level":4},{"id":"initialoptions-2","text":"initialOptions","level":4},{"id":"selector-2","text":"selector?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example-2","text":"Example","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"state-management-and-selector-3","text":"State Management and Selector","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tvalue-3","text":"TValue","level":4},{"id":"tselected-3","text":"TSelected","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"value-3","text":"value","level":4},{"id":"initialvalue-2","text":"initialValue","level":4},{"id":"initialoptions-3","text":"initialOptions","level":4},{"id":"selector-3","text":"selector","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"example-3","text":"Example","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Call Signature\n\n```ts\nfunction injectThrottledValue<TValue, TSelected>(\n   value,\n   initialOptions,\nselector?): ThrottledSignal<TValue, TSelected>;\n```\n\nDefined in: [throttler/injectThrottledValue.ts:74](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/throttler/injectThrottledValue.ts#L74)\n\nAn Angular function that creates a throttled value that updates at most once within a specified time window.\nUnlike injectThrottledSignal, this function automatically tracks changes to the input signal\nand updates the throttled value accordingly.\n\nThe throttled value will update at most once within the specified wait time, regardless of\nhow frequently the input value changes.\n\nThis is useful for deriving throttled values from signals that change frequently,\nlike scroll positions or mouse coordinates, where you want to limit how often downstream effects\nor calculations occur.\n\nThe function returns a throttled signal object containing:\n- A Signal that provides the current throttled value\n- The throttler instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying throttler instance.\nThe `selector` parameter allows you to specify which throttler state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\nAvailable throttler state properties:\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last execution\n- `nextExecutionTime`: Timestamp of the next allowed execution\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialOptions\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<`ThrottlerOptions`\\<`Setter`\\<`TValue`\\>\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`ThrottledSignal`](../interfaces/ThrottledSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst scrollY = signal(0)\nconst throttledScrollY = injectThrottledValue(scrollY, {\n  wait: 100, // Update at most once per 100ms\n})\n\n// Opt-in to reactive updates when pending state changes\nconst throttledScrollYWithState = injectThrottledValue(\n  scrollY,\n  { wait: 100 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Read the throttled signal value\neffect(() => {\n  updateUI(throttledScrollY())\n})\n\n// Access throttler state via the returned object's state() signal\nconsole.log('Is pending:', throttledScrollYWithState.state().isPending)\n\n// Control the throttler\nthrottledScrollY.cancel() // Cancel any pending updates\n```\n\n## Call Signature\n\n```ts\nfunction injectThrottledValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector?): ThrottledSignal<TValue, TSelected>;\n```\n\nDefined in: [throttler/injectThrottledValue.ts:79](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/throttler/injectThrottledValue.ts#L79)\n\nAn Angular function that creates a throttled value that updates at most once within a specified time window.\nUnlike injectThrottledSignal, this function automatically tracks changes to the input signal\nand updates the throttled value accordingly.\n\nThe throttled value will update at most once within the specified wait time, regardless of\nhow frequently the input value changes.\n\nThis is useful for deriving throttled values from signals that change frequently,\nlike scroll positions or mouse coordinates, where you want to limit how often downstream effects\nor calculations occur.\n\nThe function returns a throttled signal object containing:\n- A Signal that provides the current throttled value\n- The throttler instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying throttler instance.\nThe `selector` parameter allows you to specify which throttler state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\nAvailable throttler state properties:\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last execution\n- `nextExecutionTime`: Timestamp of the next allowed execution\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### initialOptions\n\n`ThrottlerOptions`\\<`Setter`\\<`TValue`\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`ThrottledSignal`](../interfaces/ThrottledSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst scrollY = signal(0)\nconst throttledScrollY = injectThrottledValue(scrollY, {\n  wait: 100, // Update at most once per 100ms\n})\n\n// Opt-in to reactive updates when pending state changes\nconst throttledScrollYWithState = injectThrottledValue(\n  scrollY,\n  { wait: 100 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Read the throttled signal value\neffect(() => {\n  updateUI(throttledScrollY())\n})\n\n// Access throttler state via the returned object's state() signal\nconsole.log('Is pending:', throttledScrollYWithState.state().isPending)\n\n// Control the throttler\nthrottledScrollY.cancel() // Cancel any pending updates\n```\n\n## Call Signature\n\n```ts\nfunction injectThrottledValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector): ThrottledSignal<TValue, TSelected>;\n```\n\nDefined in: [throttler/injectThrottledValue.ts:85](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/throttler/injectThrottledValue.ts#L85)\n\nAn Angular function that creates a throttled value that updates at most once within a specified time window.\nUnlike injectThrottledSignal, this function automatically tracks changes to the input signal\nand updates the throttled value accordingly.\n\nThe throttled value will update at most once within the specified wait time, regardless of\nhow frequently the input value changes.\n\nThis is useful for deriving throttled values from signals that change frequently,\nlike scroll positions or mouse coordinates, where you want to limit how often downstream effects\nor calculations occur.\n\nThe function returns a throttled signal object containing:\n- A Signal that provides the current throttled value\n- The throttler instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying throttler instance.\nThe `selector` parameter allows you to specify which throttler state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\nAvailable throttler state properties:\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last execution\n- `nextExecutionTime`: Timestamp of the next allowed execution\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialValue\n\n`TValue`\n\n#### initialOptions\n\n() => `ThrottlerOptions`\\<`Setter`\\<`TValue`\\>\\>\n\n#### selector\n\n((`state`) => `TSelected`) \\| `undefined`\n\n### Returns\n\n[`ThrottledSignal`](../interfaces/ThrottledSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst scrollY = signal(0)\nconst throttledScrollY = injectThrottledValue(scrollY, {\n  wait: 100, // Update at most once per 100ms\n})\n\n// Opt-in to reactive updates when pending state changes\nconst throttledScrollYWithState = injectThrottledValue(\n  scrollY,\n  { wait: 100 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Read the throttled signal value\neffect(() => {\n  updateUI(throttledScrollY())\n})\n\n// Access throttler state via the returned object's state() signal\nconsole.log('Is pending:', throttledScrollYWithState.state().isPending)\n\n// Control the throttler\nthrottledScrollY.cancel() // Cancel any pending updates\n```\n","originalRawMarkdown":"---\nid: injectThrottledValue\ntitle: injectThrottledValue\n---\n\n## Call Signature\n\n```ts\nfunction injectThrottledValue<TValue, TSelected>(\n   value,\n   initialOptions,\nselector?): ThrottledSignal<TValue, TSelected>;\n```\n\nDefined in: [throttler/injectThrottledValue.ts:74](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/throttler/injectThrottledValue.ts#L74)\n\nAn Angular function that creates a throttled value that updates at most once within a specified time window.\nUnlike injectThrottledSignal, this function automatically tracks changes to the input signal\nand updates the throttled value accordingly.\n\nThe throttled value will update at most once within the specified wait time, regardless of\nhow frequently the input value changes.\n\nThis is useful for deriving throttled values from signals that change frequently,\nlike scroll positions or mouse coordinates, where you want to limit how often downstream effects\nor calculations occur.\n\nThe function returns a throttled signal object containing:\n- A Signal that provides the current throttled value\n- The throttler instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying throttler instance.\nThe `selector` parameter allows you to specify which throttler state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\nAvailable throttler state properties:\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last execution\n- `nextExecutionTime`: Timestamp of the next allowed execution\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n### Type Parameters\n\n#### TValue\n\n`TValue`\n\n#### TSelected\n\n`TSelected` = \\{\n\\}\n\n### Parameters\n\n#### value\n\n`Signal`\\<`TValue`\\>\n\n#### initialOptions\n\n[`AngularPacerOptions`](../type-aliases/AngularPacerOptions.md)\\<`ThrottlerOptions`\\<`Setter`\\<`TValue`\\>\\>\\>\n\n#### selector?\n\n(`state`) => `TSelected`\n\n### Returns\n\n[`ThrottledSignal`](../interfaces/ThrottledSignal.md)\\<`TValue`, `TSelected`\\>\n\n### Example\n\n```ts\n// Default behavior - no reactive state subscriptions\nconst scrollY = signal(0)\nconst throttledScrollY = injectThrottledValue(scrollY, {\n  wait: 100, // Update at most once per 100ms\n})\n\n// Opt-in to reactive updates when pending state changes\nconst throttledScrollYWithState = injectThrottledValue(\n  scrollY,\n  { wait: 100 },\n  (state) => ({ isPending: state.isPending }),\n)\n\n// Read the throttled signal value\neffect(() => {\n  updateUI(throttledScrollY())\n})\n\n// Access throttler state via the returned object's state() signal\nconsole.log('Is pending:', throttledScrollYWithState.state().isPending)\n\n// Control the throttler\nthrottledScrollY.cancel() // Cancel any pending updates\n```\n\n## Call Signature\n\n```ts\nfunction injectThrottledValue<TValue, TSelected>(\n   value,\n   initialValue,\n   initialOptions,\nselector?): ThrottledSignal<TValue, TSelected>;\n```\n\nDefined in: [throttler/injectThrottledValue.ts:79](https://github.com/TanStack/pacer/blob/main/packages/angular-pacer/src/throttler/injectThrottledValue.ts#L79)\n\nAn Angular function that creates a throttled value that updates at most once within a specified time window.\nUnlike injectThrottledSignal, this function automatically tracks changes to the input signal\nand updates the throttled value accordingly.\n\nThe throttled value will update at most once within the specified wait time, regardless of\nhow frequently the input value changes.\n\nThis is useful for deriving throttled values from signals that change frequently,\nlike scroll positions or mouse coordinates, where you want to limit how often downstream effects\nor calculations occur.\n\nThe function returns a throttled signal object containing:\n- A Signal that provides the current throttled value\n- The throttler instance with control methods\n\n## State Management and Selector\n\nThe function uses TanStack Store for reactive state management via the underlying throttler instance.\nThe `selector` parameter allows you to specify which throttler state changes will trigger signal updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary updates and gives you\nfull control over when your component tracks state changes.\n\nAvailable throttler state properties:\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to