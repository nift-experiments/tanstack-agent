at have been started"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"failedItems"},{"type":"text","value":": Array of items that failed during batch processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isEmpty"},{"type":"text","value":": Whether the batcher has no items to process (items array is empty)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isExecuting"},{"type":"text","value":": Whether a batch is currently being processed asynchronously"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the batcher is waiting for the timeout to trigger batch processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"items"},{"type":"text","value":": Array of items currently queued for batch processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent batch execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of batch executions that have completed (either successfully or with errors)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"size"},{"type":"text","value":": Number of items currently in the batch queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current processing status - 'idle' when not processing, 'pending' when waiting for timeout, 'executing' when processing, 'populated' when items are present, but no wait is configured"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of batch executions that have completed successfully"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"totalItemsFailed"},{"type":"text","value":": Total number of items that have failed processing across all batches"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"totalItemsProcessed"},{"type":"text","value":": Total number of items that have been processed across all batches"}]}]}]},{"type":"heading","depth":2,"id":"options-and-ownership","children":[{"type":"text","value":"Options and ownership"}]},{"type":"paragraph","children":[{"type":"text","value":"Tracked named arguments update options after rendering. createPacerScope supplies shared\ndefaults through contextual helpers. Local named options override those defaults.\nRemoving the helper invocation calls cancel() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { on } from '@ember/modifier'\nimport { fn } from '@ember/helper'\nimport { useAsyncBatcher } from '@tanstack/ember-pacer'\nimport type { AsyncBatcherState } from '@tanstack/ember-pacer'\n\nconst select = (state: AsyncBatcherState<string>) => ({ size: state.size })\n\n<template>\n  {{#let (useAsyncBatcher @process select maxSize=5 wait=1000) as |utility|}}\n    <button {{on \"click\" (fn utility.addItem \"item\")}}>Schedule</button>\n    <span>{{utility.state.size}}</span>\n  {{/let}}\n</template>","lang":"gts"},{"type":"heading","depth":2,"id":"extends","children":[{"type":"text","value":"Extends"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","valu