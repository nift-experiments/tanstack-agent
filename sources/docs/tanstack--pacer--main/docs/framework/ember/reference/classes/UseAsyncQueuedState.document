,{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":"]"}]},{"type":"paragraph","children":[{"type":"text","value":"The positional arguments to the helper"}]},{"type":"heading","depth":5,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/EmberAsyncQueuerOptions.md","children":[{"type":"inlineCode","value":"EmberAsyncQueuerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/EmberAsyncQueuer.md","children":[{"type":"inlineCode","value":"EmberAsyncQueuer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"method","children":[{"type":"text","value":"Method"}]},{"type":"paragraph","children":[{"type":"text","value":"compute"}]},{"type":"heading","depth":4,"id":"since","children":[{"type":"text","value":"Since"}]},{"type":"paragraph","children":[{"type":"text","value":"1.13.0"}]},{"type":"heading","depth":4,"id":"overrides","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"Helper.compute","lang":"ts"}],"headings":[{"id":"return-value","text":"Return value","level":2},{"id":"state-and-ownership","text":"State and ownership","level":2},{"id":"example","text":"Example","level":2},{"id":"see","text":"See","level":2},{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"owner","text":"owner?","level":5},{"id":"returns","text":"Returns","level":4},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"methods","text":"Methods","level":2},{"id":"compute","text":"compute()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"positional","text":"positional","level":5},{"id":"options","text":"options","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"method","text":"Method","level":4},{"id":"since","text":"Since","level":4},{"id":"overrides","text":"Overrides","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ember-pacer/src/async-queuer/useAsyncQueuedState.ts:52](https://github.com/TanStack/pacer/blob/main/packages/ember-pacer/src/async-queuer/useAsyncQueuedState.ts#L52)\n\nExposes pending queue items together with the queue that processes them.\n\nRetains accepted items until processing. Ordering, capacity, wait, and started options follow the underlying queue.\n\n## Return value\n\nYields the queue instance. Read pending items from queue.state.items and enqueue with queue.addItem().\n\n## State and ownership\n\nItems are selected by default. A custom selector must retain items and may add other state fields. The returned collection contains pending items; async active items are separate.\n\nInvoke in a Glimmer template. Positional arguments provide the callback or value and optional selector. Named arguments provide options. Removing the invocation runs cleanup.\nTracked named arguments refresh options after rendering. Local options override provider defaults without replacing the utility or its pending work.\nonUnmount replaces default cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action.\n\n## Example\n\n```gts\nimport { on } from '@ember/modifier'\nimport { fn } from '@ember/helper'\nimport { useAsyncQueuedState } from '@tanstack/ember-pacer'\n\n// Inside a component template:\n<template>\n{{#let (useAsyncQueuedState @process wait=500) as |queue|}}\n  <button {{on \"click\" (fn queue.addItem 1)}}>Add</button>\n  <output>{{queue.state.items.length}}</output>\n{{/let}}\n</template>\n```\n\n## See\n\nuseAsyncQueuer\n\n## Extends\n\n- `default`\\<\\{\n  `Args`: \\{\n     `Named`: [`EmberAsyncQueuerOptions`](../interfaces/EmberAsyncQueuerOptions.md)\\<`TValue`, `TSelected`\\>;\n     `Positional`:   \\| \\[(`item`) => `Promise`\\<`any`\\>\\]\n        \\| \\[(`item`) => `Promise`\\<`any`\\>, (`state`) => `TSelected`\\];\n  \\};\n  `Return`: [`EmberAsyncQueuer`](../interfaces/EmberAsyncQueuer.md)\\<`TValue`, `TSelected`\\>;\n\\}\\>\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` *extends* `Pick`\\<`AsyncQueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`AsyncQueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n## Constructors\n\n### Constructor\n\n```ts\nnew UseAsyncQueuedState<TValue, TSelected>(owner?): UseAsyncQueuedState;\n```\n\nDefined in: node\\_modules/.pnpm/ember-source@7.3.0\\_@glimmer+component@2.1.1\\_supports-color@7.2.0\\_\\_supports-color@7.2.0/node\\_modules/ember-source/types/stable/@ember/object/index.d.ts:28\n\n#### Parameters\n\n##### owner?\n\n`Owner`\n\n#### Returns\n\n`UseAsyncQueuedState`\n\n#### Inherited from\n\n```ts\nHelper<{\n  Args: {\n    Positional:\n      | [fn: (item: TValue) => Promise<any>]\n      | [\n          fn: (item: TValue) => Promise<any>,\n          selector: (state: AsyncQueuerState<TValue>) => TSelected,\n        ]\n    Named: EmberAsyncQueuerOptions<TValue, TSelected>\n  }\n  Return: EmberAsyncQueuer<TValue, TSelected>\n}>.constructor\n```\n\n## Methods\n\n### compute()\n\n```ts\ncompute(positional, options): EmberAsyncQueuer<TValue, TSelected>;\n```\n\nDefined in: [packages/ember-pacer/src/async-queuer/useAsyncQueuedState.ts:78](https://github.com/TanStack/pacer/blob/main/packages/ember-pacer/src/async-queuer/useAsyncQueuedState.ts#L78)\n\nOverride this function when writing a class-based helper.\n\n#### Parameters\n\n##### positional\n\n\\[(`item`) => `Promise`\\<`any`\\>, (`state`) => `TSelected`\\]\n\nThe positional arguments to the helper\n\n##### options\n\n[`EmberAsyncQueuerOptions`](../interfaces/EmberAsyncQueuerOptions.md)\\<`TValue`, `TSelected`\\>\n\n#### Returns\n\n[`EmberAsyncQueuer`](../interfaces/EmberAsyncQueuer.md)\\<`TValue`, `TSelected`\\>\n\n#### Method\n\ncompute\n\n#### Since\n\n1.13.0\n\n#### Overrides\n\n```ts\nHelper.compute\n```\n","originalRawMarkdown":"---\nid: UseAsyncQueuedState\ntitle: UseAsyncQueuedState\n---\n\nDefined in: [packages/ember-pacer/src/async-queuer/useAsyncQueuedState.ts:52](https://github.com/TanStack/pacer/blob/main/packages/ember-pacer/src/async-queuer/useAsyncQueuedState.ts#L52)\n\nExposes pending queue items together with the queue that processes them.\n\nRetains accepted items until processing. Ordering, capacity, wait, and started options follow the underlying queue.\n\n## Return value\n\nYields the queue instance. Read pending items from queue.state.items and enqueue with queue.addItem().\n\n## State and ownership\n\nItems are selected by default. A custom selector must retain items and may add other state fields. The returned collection contains pending items; async active items are separate.\n\nInvoke in a Glimmer template. Positional arguments provide the callback or value and optional selector. Named arguments provide options. Removing the invocation runs cleanup.\nTracked named arguments refresh options after rendering. Local options override provider defaults without replacing the utility or its pending work.\nonUnmount replaces default cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action.\n\n## Example\n\n```gts\nimport { on } from '@ember/modifier'\nimport { fn } from '@ember/helper'\nimport { useAsyncQueuedState } from '@tanstack/ember-pacer'\n\n// Inside a component template:\n<template>\n{{#let (useAsyncQueuedState @process wait=500) as |queue|}}\n  <button {{on \"click\" (fn queue.addItem 1)}}>Add</button>\n  <output>{{queue.state.items.length}}</output>\n{{/let}}\n</template>\n```\n\n## See\n\nuseAsyncQueuer\n\n## Extends\n\n- `default`\\<\\{\n  `Args`: \\{\n     `Named`: [`EmberAsyncQueuerOptions`](../interfaces/EmberAsyncQueuerOptions.md)\\<`TValue`, `TSelected`\\>;\n     `Positional`:   \\| \\[(`item`) => `Promise`\\<`any`\\>\\]\n        \\| \\[(`item`) => `Promise`\\<`any`\\>, (`state`) => `TSelected`\\];\n  \\};\n  `Return`: [`EmberAsyncQueuer`](../interfaces/EmberAsyncQueuer.md)\\<`TValue`, `TSelected`\\>;\n\\}\\>\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` *extends* `Pick`\\<`AsyncQueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`AsyncQueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n## Constructors\n\n### Constructor\n\n```ts\nnew UseAsyncQueuedState<TValue, TSelected>(owner?): UseAsyncQueuedState;\n```\n\nDefined in: node\\_modules/.pnpm/ember-source@7.3.0\\_@glimmer+component@2.1.1\\_supports-color@7.2.0\\_\\_supports-color@7.2.0/node\\_modules/ember-source/types/stable/@ember/object/index.d.ts:28\n\n#### Parameters\n\n##### owner?\n\n`Owner`\n\n#### Returns\n\n`UseAsyncQueuedState`\n\n#### Inherited from\n\n```ts\nHelper<{\n  Args: {\n    Positional:\n      | [fn: (item: TValue) => Promise<any>]\n      | [\n          fn: (item: TValue) => Promise<any>,\n          selector: (state: AsyncQueuerState<TValue>) => TSelected,\n        ]\n    Named: EmberAsyncQueuerOptions<TValue, TSelected>\n  }\n  Return: EmberAsyncQueuer<TValue, TSelected>\n}>.constructor\n```\n\n## Methods\n\n### compute()\n\n```ts\ncompute(positional, options): EmberAsyncQueuer<TValue, TSelected>;\n```\n\nDefined in: [packages/ember-pacer/src/async-queuer/useAsyncQueuedState.ts:78](https://github.com/TanStack/pacer/blob/main/packages/ember-pacer/src/async-queuer/useAsyncQueuedState.ts#L78)\n\nOverride thi