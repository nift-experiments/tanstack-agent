"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent task execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"pendingTick"},{"type":"text","value":": Whether the queuer has a pending timeout for processing the next item"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"rejectionCount"},{"type":"text","value":": Number of items that have been rejected from being added to the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of task executions that have completed (either successfully or with errors)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"size"},{"type":"text","value":": Number of items currently in the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current processing status - 'idle' when not processing, 'running' when active, 'stopped' when paused"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of task executions that have completed successfully"}]}]}]},{"type":"heading","depth":2,"id":"options-and-ownership","children":[{"type":"text","value":"Options and ownership"}]},{"type":"paragraph","children":[{"type":"text","value":"Tracked named arguments update options after rendering. createPacerScope supplies shared\ndefaults through contextual helpers. Local named options override those defaults.\nRemoving the helper invocation calls stop() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { on } from '@ember/modifier'\nimport { fn } from '@ember/helper'\nimport { useAsyncQueuer } from '@tanstack/ember-pacer'\nimport type { AsyncQueuerState } from '@tanstack/ember-pacer'\n\nconst select = (state: AsyncQueuerState<string>) => ({ size: state.size })\n\n<template>\n  {{#let (useAsyncQueuer @process select wait=100) as |utility|}}\n    <button {{on \"click\" (fn utility.addItem \"item\")}}>Schedule</button>\n    <span>{{utility.state.size}}</span>\n  {{/let}}\n</template>","lang":"gts"},{"type":"heading","depth":2,"id":"extends","children":[{"type":"text","value":"Extends"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"default"},{"type":"text","value":"<{\n"},{"type":"inlineCode","value":"Args"},{"type":"text","value":": {\n"},{"type":"inlineCode","value":"Named"},{"type":"text","value":": "},{"type":"link","href":"../interfaces/EmberAsyncQueuerOptions.md","children":[{"type":"inlineCode","value":"EmberAsyncQueuerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">;\n"},{"type":"inlineCode","value":"Positional"},{"type":"text","value":":   | [("},{"type":"inlineCode","value":"item"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">]\n| [("},{"type":"inlineCode","value":"item"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">, ("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":"];\n};\n"},