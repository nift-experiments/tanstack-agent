ed function is currently executing asynchronously"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the throttler is waiting for the timeout to trigger execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastExecutionTime"},{"type":"text","value":": Timestamp of the last function execution in milliseconds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent successful function execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"maybeExecuteCount"},{"type":"text","value":": Number of times maybeExecute has been called (for reduction calculations)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"nextExecutionTime"},{"type":"text","value":": Timestamp when the next execution can occur in milliseconds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of function executions that have completed (either successfully or with errors)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status - 'idle' when not active, 'pending' when waiting, 'executing' when running, 'settled' when completed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of function executions that have completed successfully"}]}]}]},{"type":"heading","depth":2,"id":"options-and-ownership","children":[{"type":"text","value":"Options and ownership"}]},{"type":"paragraph","children":[{"type":"text","value":"Tracked named arguments update options after rendering. createPacerScope supplies shared\ndefaults through contextual helpers. Local named options override those defaults.\nRemoving the helper invocation calls cancel() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { on } from '@ember/modifier'\nimport { fn } from '@ember/helper'\nimport { useAsyncThrottler } from '@tanstack/ember-pacer'\nimport type { AsyncThrottlerState } from '@tanstack/ember-pacer'\n\nconst select = (state: AsyncThrottlerState<(value: string) => Promise<void>>) => ({ isPending: state.isPending })\n\n<template>\n  {{#let (useAsyncThrottler @process select wait=500) as |utility|}}\n    <button {{on \"click\" (fn utility.maybeExecute \"item\")}}>Schedule</button>\n    <span>{{utility.state.isPending}}</span>\n  {{/let}}\n</template>","lang":"gts"},{"type":"heading","depth":2,"id":"extends","children":[{"type":"text","value":"Extends"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"default"},{"type":"text","value":"<{\n"},{"type":"inlineCode","value":"Args"},{"type":"text","value":": {\n"},{"type":"inlineCode","value":"Named"},{"type":"text","value":": "},{"type":"link","href":"../interfaces/EmberAsyncThrottlerOptions.md","children":[{"type":"inlineCode","value":"EmberAsyncThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">;\n"},{"type":"inlineCode","value":"Positional"},{