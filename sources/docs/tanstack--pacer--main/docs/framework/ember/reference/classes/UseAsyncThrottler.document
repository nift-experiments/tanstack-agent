r","children":[{"type":"text","value":"owner?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Owner"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"UseAsyncThrottler"}]},{"type":"heading","depth":4,"id":"inherited-from","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"Helper<{\n  Args: {\n    Positional:\n      | [fn: TFn]\n      | [fn: TFn, selector: (state: AsyncThrottlerState<TFn>) => TSelected]\n    Named: EmberAsyncThrottlerOptions<TFn, TSelected>\n  }\n  Return: EmberAsyncThrottler<TFn, TSelected>\n}>.constructor","lang":"ts"},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"compute","children":[{"type":"text","value":"compute()"}]},{"type":"code","value":"compute(positional, options): EmberAsyncThrottler<TFn, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts#L118","children":[{"type":"text","value":"packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts:118"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Override this function when writing a class-based helper."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"positional","children":[{"type":"text","value":"positional"}]},{"type":"paragraph","children":[{"type":"text","value":"["},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", ("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":"]"}]},{"type":"paragraph","children":[{"type":"text","value":"The positional arguments to the helper"}]},{"type":"heading","depth":5,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/EmberAsyncThrottlerOptions.md","children":[{"type":"inlineCode","value":"EmberAsyncThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/EmberAsyncThrottler.md","children":[{"type":"inlineCode","value":"EmberAsyncThrottler"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"method","children":[{"type":"text","value":"Method"}]},{"type":"paragraph","children":[{"type":"text","value":"compute"}]},{"type":"heading","depth":4,"id":"since","children":[{"type":"text","value":"Since"}]},{"type":"paragraph","children":[{"type":"text","value":"1.13.0"}]},{"type":"heading","depth":4,"id":"overrides","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"Helper.compute","lang":"ts"}],"headings":[{"id":"state-and-subscriptions","text":"State and subscriptions","level":2},{"id":"options-and-ownership","text":"Options and ownership","level":2},{"id":"example","text":"Example","level":2},{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"owner","text":"owner?","level":5},{"id":"returns","text":"Returns","level":4},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"methods","text":"Methods","level":2},{"id":"compute","text":"compute()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"positional","text":"positional","level":5},{"id":"options","text":"options","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"method","text":"Method","level":4},{"id":"since","text":"Since","level":4},{"id":"overrides","text":"Overrides","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts:98](https://github.com/TanStack/pacer/blob/main/packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts#L98)\n\nCreates and retains the AsyncThrottler for its Ember owner.\n\nLimits execution to at most one call per wait interval. Leading and trailing options control immediate and deferred execution; the trailing call uses the latest arguments.\n\nThe callback may return a Promise. Core result, error, retry, and abort behavior is preserved.\nUse onSuccess, onError, and onSettled for execution outcomes.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nThe selector is the second positional argument. Read utility.state from the template.\nThe contextual utility.Subscribe helper selects state for a child template.\n\nAvailable state fields:\n\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether the throttled function is currently executing asynchronously\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last function execution in milliseconds\n- `lastResult`: The result from the most recent successful function execution\n- `maybeExecuteCount`: Number of times maybeExecute has been called (for reduction calculations)\n- `nextExecutionTime`: Timestamp when the next execution can occur in milliseconds\n- `settleCount`: Number of function executions that have completed (either successfully or with errors)\n- `status`: Current execution status - 'idle' when not active, 'pending' when waiting, 'executing' when running, 'settled' when completed\n- `successCount`: Number of function executions that have completed successfully\n\n## Options and ownership\n\nTracked named arguments update options after rendering. createPacerScope supplies shared\ndefaults through contextual helpers. Local named options override those defaults.\nRemoving the helper invocation calls cancel() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\n\n## Example\n\n```gts\nimport { on } from '@ember/modifier'\nimport { fn } from '@ember/helper'\nimport { useAsyncThrottler } from '@tanstack/ember-pacer'\nimport type { AsyncThrottlerState } from '@tanstack/ember-pacer'\n\nconst select = (state: AsyncThrottlerState<(value: string) => Promise<void>>) => ({ isPending: state.isPending })\n\n<template>\n  {{#let (useAsyncThrottler @process select wait=500) as |utility|}}\n    <button {{on \"click\" (fn utility.maybeExecute \"item\")}}>Schedule</button>\n    <span>{{utility.state.isPending}}</span>\n  {{/let}}\n</template>\n```\n\n## Extends\n\n- `default`\\<\\{\n  `Args`: \\{\n     `Named`: [`EmberAsyncThrottlerOptions`](../interfaces/EmberAsyncThrottlerOptions.md)\\<`TFn`, `TSelected`\\>;\n     `Positional`: \\[`TFn`\\] \\| \\[`TFn`, (`state`) => `TSelected`\\];\n  \\};\n  `Return`: [`EmberAsyncThrottler`](../interfaces/EmberAsyncThrottler.md)\\<`TFn`, `TSelected`\\>;\n\\}\\>\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Constructors\n\n### Constructor\n\n```ts\nnew UseAsyncThrottler<TFn, TSelected>(owner?): UseAsyncThrottler;\n```\n\nDefined in: node\\_modules/.pnpm/ember-source@7.3.0\\_@glimmer+component@2.1.1\\_supports-color@7.2.0\\_\\_supports-color@7.2.0/node\\_modules/ember-source/types/stable/@ember/object/index.d.ts:28\n\n#### Parameters\n\n##### owner?\n\n`Owner`\n\n#### Returns\n\n`UseAsyncThrottler`\n\n#### Inherited from\n\n```ts\nHelper<{\n  Args: {\n    Positional:\n      | [fn: TFn]\n      | [fn: TFn, selector: (state: AsyncThrottlerState<TFn>) => TSelected]\n    Named: EmberAsyncThrottlerOptions<TFn, TSelected>\n  }\n  Return: EmberAsyncThrottler<TFn, TSelected>\n}>.constructor\n```\n\n## Methods\n\n### compute()\n\n```ts\ncompute(positional, options): EmberAsyncThrottler<TFn, TSelected>;\n```\n\nDefined in: [packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts:118](https://github.com/TanStack/pacer/blob/main/packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts#L118)\n\nOverride this function when writing a class-based helper.\n\n#### Parameters\n\n##### positional\n\n\\[`TFn`, (`state`) => `TSelected`\\]\n\nThe positional arguments to the helper\n\n##### options\n\n[`EmberAsyncThrottlerOptions`](../interfaces/EmberAsyncThrottlerOptions.md)\\<`TFn`, `TSelected`\\>\n\n#### Returns\n\n[`EmberAsyncThrottler`](../interfaces/EmberAsyncThrottler.md)\\<`TFn`, `TSelected`\\>\n\n#### Method\n\ncompute\n\n#### Since\n\n1.13.0\n\n#### Overrides\n\n```ts\nHelper.compute\n```\n","originalRawMarkdown":"---\nid: UseAsyncThrottler\ntitle: UseAsyncThrottler\n---\n\nDefined in: [packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts:98](https://github.com/TanStack/pacer/blob/main/packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts#L98)\n\nCreates and retains the AsyncThrottler for its Ember owner.\n\nLimits execution to at most one call per wait interval. Leading and trailing options control immediate and deferred execution; the trailing call uses the latest arguments.\n\nThe callback may return a Promise. Core result, error, retry, and abort behavior is preserved.\nUse onSuccess, onError, and onSettled for execution outcomes.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nThe selector is the second positional argument. Read utility.state from the template.\nThe contextual utility.Subscribe helper selects state for a child template.\n\nAvailable state fields:\n\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether the throttled function is currently executing asynchronously\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last function execution in milliseconds\n- `lastResult`: The result from the most recent successful function execution\n- `maybeExecuteCount`: Number of times maybeExecute has been called (for reduction calculations)\n- `nextExecutionTime`: Timestamp when the next execution can occur in milliseconds\n- `settleCount`: Number of function executions that have completed (either successfully or with errors)\n- `status`: Current execution status - 'idle' when not active, 'pending' when waiting, 'executing' when running, 'settled' when completed\n- `successCount`: Number of function executions that have completed successfully\n\n## Options and ownership\n\nTracked named arguments update options after rendering. createPacerScope supplies shared\ndefaults through contextual helpers. Local named options override those defaults.\nRemoving the helper invocation calls cancel() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\n\n## Example\n\n```gts\nimport { on } from '@ember/modifier'\nimport { fn } from '@ember/helper'\nimport { useAsyncThrottler } from '@tanstack/ember-pacer'\nimport type { AsyncThrottlerState } from '@tanstack/ember-pacer'\n\nconst select = (state: AsyncThrottlerState<(value: string) => Promise<void>>) => ({ isPending: state.isPending })\n\n<template>\n  {{#let (useAsyncThrottler @process select wait=500) as |utility|}}\n    <button {{on \"click\" (fn utility.maybeExecute \"item\")}}>Schedule</button>\n    <span>{{utility.state.isPending}}</span>\n  {{/let}}\n</template>\n```\n\n## Extends\n\n- `default`\\<\\{\n  `Args`: \\{\n     `Named`: [`EmberAsyncThrottlerOptions`](../interfaces/EmberAsyncThrottlerOptions.md)\\<`TFn`, `TSelected`\\>;\n     `Positional`: \\[`TFn`\\] \\| \\[`TFn`, (`state`) => `TSelected`\\];\n  \\};\n  `Return`: [`EmberAsyncThrottler`](../interfaces/EmberAsyncThrottler.md)\\<`TFn`, `TSelected`\\>;\n\\}\\>\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Constructors\n\n### Constructor\n\n```ts\nnew UseAsyncThrottler<TFn, TSelected>(owner?): UseAsyncThrottler;\n```\n\nDefined in: node\\_modules/.pnpm/ember-source@7.3.0\\_@glimmer+component@2.1.1\\_supports-color@7.2.0\\_\\_supports-color@7.2.0/node\\_modules/ember-source/types/stable/@ember/object/index.d.ts:28\n\n#### Parameters\n\n##### owner?\n\n`Owner`\n\n#### Returns\n\n`UseAsyncThrottler`\n\n#### Inherited from\n\n```ts\nHelper<{\n  Args: {\n    Positional:\n      | [fn: TFn]\n      | [fn: TFn, selector: (state: AsyncThrottlerState<TFn>) => TSelected]\n    Named: EmberAsyncThrottlerOptions<TFn, TSelected>\n  }\n  Return: EmberAsyncThrottler<TFn, TSelected>\n}>.constructor\n```\n\n## Methods\n\n### compute()\n\n```ts\ncompute(positional, options): EmberAsyncThrottler<TFn, TSelected>;\n```\n\nDefined in: [packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts:118](https://github.com/TanStack/pacer/blob/main/packages/ember-pacer/src/async-throttler/useAsyncThrottler.ts#L118)\n\nOverride this function when writing a class-based helper.\n\n#### Parameters\n\n##### positional\n\n\\[`TFn`, (`state`) => `TSelected`\\]\n\nThe positional arguments to the helper\n\n##### options\n\n[`EmberAsyncThrottlerOptions`](../interfaces/EmberAsyncThrottlerOptions.md)\\<`TFn`, `TSelected`\\>\n\n#### Returns\n\n[`EmberAsyncThrottler`](../interfaces/EmberAsyncThrottler.md)\\<`TFn`, `TSelected`\\>\n\n#### Method\n\ncompute\n\n#### Since\n\n1.13.0\n\n#### Overrides\n\n```ts\nHelper.compute\n```\n"}
