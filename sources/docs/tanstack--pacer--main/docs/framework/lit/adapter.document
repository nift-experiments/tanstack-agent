leCell","children":[{"type":"text","value":"Utility"}]},{"type":"tableCell","children":[{"type":"text","value":"Instance API"}]},{"type":"tableCell","children":[{"type":"text","value":"State and value helpers"}]}],"rows":[[{"type":"tableCell","children":[{"type":"link","href":"./guides/batching.md","children":[{"type":"text","value":"batching"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createBatcher"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/debouncing.md","children":[{"type":"text","value":"debouncing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createDebouncer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createDebouncedState"},{"type":"text","value":", "},{"type":"inlineCode","value":"createDebouncedValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/queuing.md","children":[{"type":"text","value":"queuing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createQueuer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createQueuedState"},{"type":"text","value":", "},{"type":"inlineCode","value":"createQueuedValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/rate-limiting.md","children":[{"type":"text","value":"rate limiting"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createRateLimiter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createRateLimitedState"},{"type":"text","value":", "},{"type":"inlineCode","value":"createRateLimitedValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/throttling.md","children":[{"type":"text","value":"throttling"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createThrottler"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createThrottledState"},{"type":"text","value":", "},{"type":"inlineCode","value":"createThrottledValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-batching.md","children":[{"type":"text","value":"async batching"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncBatcher"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-debouncing.md","children":[{"type":"text","value":"async debouncing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncDebouncer"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-queuing.md","children":[{"type":"text","value":"async queuing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncQueuer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncQueuedState"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-rate-limiting.md","children":[{"type":"text","value":"async rate limiting"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncRateLimiter"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-throttling.md","children":[{"type":"text","value":"async throttling"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncThrottler"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}]]},{"type":"heading","depth":2,"id":"typescript-configuration","children":[{"type":"text","value":"TypeScript configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"\"useDefineForClassFields\": false"},{"type":"text","value":" when declaring Lit reactive properties with class field initializers, as in these examples. This lets Lit install its reactive property accessors."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"This counter coalesces rapid clicks into one update after 500 ms. Flush applies the latest pending count immediately."}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { createDebouncer } from '@tanstack/lit-pacer'\n\nclass Counter extends LitElement {\n  static properties = {\n    count: { state: true },\n    debouncedCount: { state: true },\n  }\n  count = 0\n  debouncedCount = 0\n  debouncer = createDebouncer(\n    this,\n    (value: number) => {\n      this.debouncedCount = value\n    },\n    { wait: 500 },\n    (state) => ({ isPending: state.isPending }),\n  )\n  increment = () => this.debouncer.maybeExecute(++this.count)\n\n  override render() {\n    return html`\n      <button @click=${this.increment}>Increment</button>\n      <p>Count: ${this.count}. Debounced: ${this.debouncedCount}.</p>\n      <p>Pending: ${this.debouncer.state.isPending}</p>\n      <button @click=${() => this.debouncer.flush()}>Flush</button>\n    `\n  }\n}\ncustomElements.define('pacer-counter', Counter)","lang":"ts"},{"type":"heading","depth":2,"id":"child-subscriptions","children":[{"type":"text","value":"Child subscriptions"}]},{"type":"paragraph","children":[{"type":"text","value":"Call "},{"type":"inlineCode","value":"utility.subscribe(childHost, selector)"},{"type":"text","value":" during the child host's construction. It returns a getter for selected state and requests a child update only when that selection changes. Disconnecting releases the subscription; reconnecting restores it."}]},{"type":"code","value":"const selected = debouncer.subscribe(childHost, (state) => ({\n  isPending: state.isPending,\n}))\n// Read selected().isPending in the child host's render method.","lang":"ts"},{"type":"heading","depth":2,"id":"reactive-options","children":[{"type":"text","value":"Reactive options"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass a plain options object, property getters, or an options factory. The adapter evaluates top-level getters, while function-valued core options remain callbacks. Options update the existing utility; pending work, counters, and the store retain their identity."}]},{"type":"paragraph","children":[{"type":"text","value":"Options retain the core partial-merge behavior. Omitting a key preserves the previous setting; explicitly passing "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" clears it. "},{"type":"inlineCode","value":"key"},{"type":"text","value":", "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":", and "},{"type":"inlineCode","value":"initialItems"},{"type":"text","value":" initialize the utility once and do not recreate it on later updates."}]},{"type":"heading","depth":2,"id":"default-options","children":[{"type":"text","value":"Default options"}]},{"type":"paragraph","children":[{"type":"text","value":"Call "},{"type":"inlineCode","value":"providePacerOptions(host, defaults)"},{"type":"text","value":" during construction. Defaults apply to utilities on that host and descendant elements, including across shadow roots. The nearest provider wins. Use a factory or getters to read reactive host properties; provider updates notify descendant hosts. Local utility options take precedence."}]},{"type":"heading","depth":2,"id":"cleanup","children":[{"type":"text","value":"Cleanup"}]},{"type":"paragraph","children":[{"type":"text","value":"Debouncers, throttlers, and batchers cancel pending timers by default. Queuers stop processing. Async variants also abort active work. Synchronous rate limiters need no timer cleanup."}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" to replace the default cleanup, for example to call "},{"type":"inlineCode","value":"flush()"},{"type":"text","value":" before leaving a page. The callback receives the adapter instance and its selected state. If you replace cleanup for an async utility, call its cancellation or abort methods when needed."}]},{"type":"heading","depth":2,"id":"event-handlers-and-value-helpers","children":[{"type":"text","value":"Event handlers and value helpers"}]},{"type":"paragraph","children":[{"type":"text","value":"Use an instance method as the event handler: "},{"type":"inlineCode","value":"maybeExecute"},{"type":"text","value":" for debouncing, throttling, and rate limiting, or "},{"type":"inlineCode","value":"addItem"},{"type":"text","value":" for batching. The instance also provides control methods and state subscriptions."}]},{"type":"paragraph","children":[{"type":"text","value":"State helpers return "},{"type":"inlineCode","value":"[value, setValue, utility]"},{"type":"text","value":"; value helpers return "},{"type":"inlineCode","value":"[value, utility]"},{"type":"text","value":". Read values by calling their accessors. Setters accept a new value or a functional update. Synchronous queue state helpers return "},{"type":"inlineCode","value":"[itemsAccessor, addItem, utility]"},{"type":"text","value":". Async queue state helpers return "},{"type":"inlineCode","value":"[itemsAccessor, utility]"},{"type":"text","value":"; call "},{"type":"inlineCode","value":"utility.addItem()"},{"type":"text","value":" to enqueue an item. Queued value helpers return the last processed value, rather than the list of pending items."}]},{"type":"heading","depth":2,"id":"async-utilities","children":[{"type":"text","value":"Async utilities"}]},{"type":"paragraph","children":[{"type":"text","value":"The five async utilities preserve typed results and core error behavior. Use "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" for outcomes, and "},{"type":"inlineCode","value":"asyncRetryerOptions"},{"type":"text","value":" for retry configuration. "},{"type":"inlineCode","value":"abort()"},{"type":"text","value":" is cooperative: your operation must observe the supplied abort signal. See the individual async guides for scheduling and concurrency details."}]},{"type":"heading","depth":2,"id":"devtools","children":[{"type":"text","value":"Devtools"}]},{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/devtools"},{"type":"text","value":" and "},{"type":"inlineCode","value":"@tanstack/pacer-devtools"},{"type":"text","value":". Mount "},{"type":"inlineCode","value":"TanStackDevtoolsCore"},{"type":"text","value":" with "},{"type":"inlineCode","value":"plugins: [pacerDevtoolsPlugin()]"},{"type":"text","value":" once in your application and unmount it during cleanup. Give each utility a "},{"type":"inlineCode","value":"key"},{"type":"text","value":" to make it appear in the Pacer panel."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../../devtools.md#lit-alpine-ember-and-octane-setup","children":[{"type":"text","value":"devtools setup guide"}]},{"type":"text","value":" for this framework's mount and cleanup code."}]},{"type":"heading","depth":2,"id":"api-reference","children":[{"type":"text","value":"API reference"}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./reference/index.md","children":[{"type":"text","value":"generated reference"}]},{"type":"text","value":" for signatures, options, and return types."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"lifecycle-and-state","text":"Lifecycle and state","level":2},{"id":"api-overview","text":"API overview","level":2},{"id":"typescript-configuration","text":"TypeScript configuration","level":2},{"id":"example","text":"Example","level":2},{"id":"child-subscriptions","text":"Child subscriptions","level":2},{"id":"reactive-options","text":"Reactive options","level":2},{"id":"default-options","text":"Default options","level":2},{"id":"cleanup","text":"Cleanup","level":2},{"id":"event-handlers-and-value-helpers","text":"Event handlers and value helpers","level":2},{"id":"async-utilities","text":"Async utilities","level":2},{"id":"devtools","text":"Devtools","level":2},{"id":"api-reference","text":"API reference","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe `lit-pacer` adapter connects Pacer scheduling utilities to Lit state and lifecycle management. It re-exports the core package, including utility classes, stateless functions, option types, and async retrying.\n\n## Installation\n\n```sh\npnpm add @tanstack/lit-pacer\n```\n\nThe package is ESM-only and requires Node.js 20 or newer when running in Node.js.\n\n## Lifecycle and state\n\nPass the owning `ReactiveControllerHost` as the first argument. The factory registers its controller automatically. Host updates refresh options, store updates request a render, and disconnecting cleans up pending work. Reconnecting subscribes again to the same utility. `DebouncerController` and the other controller classes expose the utility through `.pacer` and selected state through `.state`.\n\nBy default, the selected state is `{}`. Pass a selector to subscribe only to the fields your UI reads. The underlying `store` remains available for additional subscriptions.\n\n## API overview\n\n| Utility | Instance API | State and value helpers |\n| ------------------------------------------------------ | ------------------------ | ------------------------------------------------------------------------------- |\n| [batching](./guides/batching.md) | `createBatcher` | None |\n| [debouncing](./guides/debouncing.md) | `createDebouncer` | `createDebouncedState`, `createDebouncedValue` |\n| [queuing](./guides/queuing.md) | `createQueuer` | `createQueuedState`, `createQueuedValue` |\n| [rate limiting](./guides/rate-limiting.md) | `createRateLimiter` | `createRateLimitedState`, `createRateLimitedValue` |\n| [throttling](./guides/throttling.md) | `createThrottler` | `createThrottledState`, `createThrottledValue` |\n| [async batching](./guides/async-batching.md) | `createAsyncBatcher` | None |\n| [async debouncing](./guides/async-debouncing.md) | `createAsyncDebouncer` | None |\n| [async queuing](./guides/async-queuing.md) | `createAsyncQueuer` | `createAsyncQueuedState` |\n| [async rate limiting](./guides/async-rate-limiting.md) | `createAsyncRateLimiter` | None |\n| [async throttling](./guides/async-throttling.md) | `createAsyncThrottler` | None |\n\n## TypeScript configuration\n\nSet `\"useDefineForClassFields\": false` when declaring Lit reactive properties with class field initializers, as in these examples. This lets Lit install its reactive property accessors.\n\n## Example\n\nThis counter coalesces rapid clicks into one update after 500 ms. Flush applies the latest pending count immediately.\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createDebouncer } from '@tanstack/lit-pacer'\n\nclass Counter extends LitElement {\n  static properties = {\n    count: { state: true },\n    debouncedCount: { state: true },\n  }\n  count = 0\n  debouncedCount = 0\n  debouncer = createDebouncer(\n    this,\n    (value: number) => {\n      this.debouncedCount = value\n    },\n    { wait: 500 },\n    (state) => ({ isPending: state.isPending }),\n  )\n  increment = () => this.debouncer.maybeExecute(++this.count)\n\n  override render() {\n    return html`\n      <button @click=${this.increment}>Increment</button>\n      <p>Count: ${this.count}. Debounced: ${this.debouncedCount}.</p>\n      <p>Pending: ${this.debouncer.state.isPending}</p>\n      <button @click=${() => this.debouncer.flush()}>Flush</button>\n    `\n  }\n}\ncustomElements.define('pacer-counter', Counter)\n```\n\n## Child subscriptions\n\nCall `utility.subscribe(childHost, selector)` during the child host's construction. It returns a getter for selected state and requests a child update only when that selection changes. Disconnecting releases the subscription; reconnecting restores it.\n\n```ts\nconst selected = debouncer.subscribe(childHost, (state) => ({\n  isPending: state.isPending,\n}))\n// Read selected().isPending in the child host's render method.\n```\n\n## Reactive options\n\nPass a plain options object, property getters, or an options factory. The adapter evaluates top-level getters, while function-valued core options remain callbacks. Options update the existing utility; pending work, counters, and the store retain their identity.\n\nOptions retain the core partial-merge behavior. Omitting a key preserves the previous setting; explicitly passing `undefined` clears it. `key`, `initialState`, and `initialItems` initialize the utility once and do not recreate it on later updates.\n\n## Default options\n\nCall `providePacerOptions(host, defaults)` during construction. Defaults apply to utilities on that host and descendant elements, including across shadow roots. The nearest provider wins. Use a factory or getters to read reactive host properties; provider updates notify descendant hosts. Local utility options take precedence.\n\n## Cleanup\n\nDebouncers, throttlers, and batchers cancel pending timers by default. Queuers stop processing. Async variants also abort active work. Synchronous rate limiters need no timer cleanup.\n\nSet `onUnmount` to replace the default cleanup, for example to call `flush()` before leaving a page. The callback receives the adapter instance and its selected state. If you replace cleanup for an async utility, call its cancellation or abort methods when needed.\n\n## Event handlers and value helpers\n\nUse an instance method as the event handler: `maybeExecute` for debouncing, throttling, and rate limiting, or `addItem` for batching. The instance also provides control methods and state subscriptions.\n\nState helpers return `[value, setValue, utility]`; value helpers return `[value, utility]`. Read values by calling their accessors. Setters accept a new value or a functional update. Synchronous queue state helpers return `[itemsAccessor, addItem, utility]`. Async queue state helpers return `[itemsAccessor, utility]`; call `utility.addItem()` to enqueue an item. Queued value helpers return the last processed value, rather than the list of pending items.\n\n## Async utilities\n\nThe five async utilities preserve typed results and core error behavior. Use `onSuccess`, `onError`, and `onSettled` for outcomes, and `asyncRetryerOptions` for retry configuration. `abort()` is cooperative: your operation must observe the supplied abort signal. See the individual async guides for scheduling and concurrency details.\n\n## Devtools\n\nInstall `@tanstack/devtools` and `@tanstack/pacer-devtools`. Mount `TanStackDevtoolsCore` with `plugins: [pacerDevtoolsPlugin()]` once in your application and unmount it during cleanup. Give each utility a `key` to make it appear in the Pacer panel.\n\nSee the [devtools setup guide](../../devtools.md#lit-alpine-ember-and-octane-setup) for this framework's mount and cleanup code.\n\n## API reference\n\nSee the [generated reference](./reference/index.md) for signatures, options, and return types.\n","originalRawMarkdown":"---\ntitle: Lit Adapter\nid: adapter\n---\n\nThe `lit-pacer` adapter connects Pacer scheduling utilities to Lit state and lifecycle management. It re-exports the core package, including utility classes, stateless functions, option types, and async retrying.\n\n## Installation\n\n```sh\npnpm add @tanstack/lit-pacer\n```\n\nThe package is ESM-only and requires Node.js 20 or newer when running in Node.js.\n\n## Lifecycle and state\n\nPass the owning `ReactiveControllerHost` as the first argument. The factory registers its controller automatically. Host updates refresh options, store updates request a render, and disconnecting cleans up pending work. Reconnecting subscribes again to the same utility. `DebouncerController` and the other controller classes expose the utility through `.pacer` and selected state through `.state`.\n\nBy default, the selected state is `{}`. Pass a selector to subscribe only to the fields your UI reads. The underlying `store` remains available for additional subscriptions.\n\n## API overview\n\n| Utility | Instance API | State and value helpers |\n| ------------------------------------------------------ | ------------------------ | ------------------------------------------------------------------------------- |\n| [batching](./guides/batching.md) | `createBatcher` | None |\n| [debouncing](./guides/debouncing.md) | `createDebouncer` | `createDebouncedState`, `createDebouncedValue` |\n| [queuing](./guides/queuing.md) | `createQueuer` | `createQueuedState`, `createQueuedValue` |\n| [rate limiting](./guides/rate-limiting.md) | `createRateLimiter` | `createRateLimitedState`, `createRateLimitedValue` |\n| [throttling](./guides/throttling.md) | `createThrottler` | `createThrottledState`, `createThrottledValue` |\n| [async batching](./guides/async-batching.md) | `createAsyncBatcher` | None |\n| [async debouncing](./guides/async-debouncing.md) | `createAsyncDebouncer` | None |\n| [async queuing](./guides/async-queuing.md) | `createAsyncQueuer` | `createAsyncQueuedState` |\n| [async rate limiting](./guides/async-rate-limiting.md) | `createAsyncRateLimiter` | None |\n| [async throttling](./guides/async-throttling.md) | `createAsyncThrottler` | None |\n\n## TypeScript configuration\n\nSet `\"useDefineForClassFields\": false` when declaring Lit reactive properties with class field initializers, as in these examples. This lets Lit install its reactive property accessors.\n\n## Example\n\nThis counter coalesces rapid clicks into one update after 500 ms. Flush applies the latest pending count immediately.\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createDebouncer } from '@tanstack/lit-pacer'\n\nclass Counter extends LitElement {\n  static properties = {\n    count: { state: true },\n    debouncedCount: { state: true },\n  }\n  count = 0\n  debouncedCount = 0\n  debouncer = createDebouncer(\n    this,\n    (value: number) => {\n      this.debouncedCount = value\n    },\n    { wait: 500 },\n    (state) => ({ isPending: state.isPending }),\n  )\n  increment = () => this.debouncer.maybeExecute(++this.count)\n\n  override render() {\n    return html`\n      <button @click=${this.increment}>Increment</button>\n      <p>Count: ${this.count}. Debounced: ${this.debouncedCount}.</p>\n      <p>Pending: ${this.debouncer.state.isPending}</p>\n      <button @click=${() => this.debouncer.flush()}>Flush</button>\n    `\n  }\n}\ncustomElements.define('pacer-counter', Counter)\n```\n\n## Child subscriptions\n\nCall `utility.subscribe(childHost, selector)` during the child host's construction. It returns a getter for selected state and requests a child update only when that selection changes. Disconnecting releases the subscription; reconnecting restores it.\n\n```ts\nconst selected = debouncer.subscribe(childHost, (state) => ({\n  isPending: state.isPending,\n}))\n// Read selected().isPending in the child host's render method.\n```\n\n## Reactive options\n\nPass a plain options object, property getters, or an options factory. The adapter evaluates top-level getters, while function-valued core options remain callbacks. Options update the existing utility; pending work, counters, and the store retain their identity.\n\nOptions retain the core partial-merge behavior. Omitting a key preserves the previous setting; explicitly passing `undefined` clears it. `key`, `initialState`, and `initialItems` initialize the utility once and do not recreate it on later updates.\n\n## Default options\n\nCall `providePacerOptions(host, defaults)` during construction. Defaults apply to utilities on that host and descendant elements, including across shadow roots. The nearest provider wins. Use a factory or getters to read reactive host properties; provider updates notify descendant hosts. Local utility options take precedence.\n\n## Cleanup\n\nDebouncers, throttlers, and batchers cancel pending timers by default. Queuers stop processing. Async variants also abort active work. Synchronous rate limiters need no timer cleanup.\n\nSet `onUnmount` to replace the default cleanup, for example to call `flush()` before leaving a page. The callback receives the adapter instance and its selected state. If you replace cleanup for an async utility, call its cancellation or abort methods when needed.\n\n## Event handlers and value helpers\n\nUse an instance method as the event handler: `maybeExecute` for debouncing, throttling, and rate limiting, or `addItem` for batching. The instance also provides control methods and state subscriptions.\n\nState helpers return `[value, setValue, utility]`; value helpers return `[value, utility]`. Read values by calling their accessors. Setters accept a new value or a functional update. Synchronous queue state helpers return `[itemsAccessor, addItem, utility]`. Async queue state helpers return `[itemsAccessor, utility]`; call `utility.addItem()` to enqueue an item. Queued value helpers return the last processed value, rather than the list of pending items.\n\n## Async utilities\n\nThe five async utilities preserve typed results and core error behavior. Use `onSuccess`, `onError`, and `onSettled` for outcomes, and `asyncRetryerOptions` for retry configuration. `abort()` is cooperative: your operation must observe the supplied abort signal. See the individual async guides for scheduling and concurrency details.\n\n## Devtools\n\nInstall `@tanstack/devtools` and `@tanstack/pacer-devtools`. Mount `TanStackDevtoolsCore` with `plugins: [pacerDevtoolsPlugin()]` once in your application and unmount it during cleanup. Give each utility a `key` to make it appear in the Pacer panel.\n\nSee the [devtools setup guide](../../devtools.md#lit-alpine-ember-and-octane-setup) for this framework's mount and cleanup code.\n\n## API reference\n\nSee the [generated reference](./reference/index.md) for signatures, options, and return types.\n"}
