provider defaults without replacing the utility or its pending work.\nonUnmount replaces default cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"host","children":[{"type":"text","value":"host"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveControllerHost"}]},{"type":"heading","depth":3,"id":"source","children":[{"type":"text","value":"source"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ValueSource"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/LitPacerOptions.md","children":[{"type":"inlineCode","value":"LitPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/LitDebouncerOptions.md","children":[{"type":"inlineCode","value":"LitDebouncerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"SetValue"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"["},{"type":"inlineCode","value":"CellValue"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"link","href":"../interfaces/LitDebouncer.md","children":[{"type":"inlineCode","value":"LitDebouncer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"SetValue"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">]"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { createDebouncedValue } from '@tanstack/lit-pacer'\n\n// In a LitElement constructor:\n// query is a reactive property on this host.\nconst [value, utility] = createDebouncedValue(this, () => this.query, { wait: 500 })\n// Bind value and use utility for controls. Read value() for the committed value.","lang":"ts"},{"type":"heading","depth":2,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"text","value":"createDebouncer"}]}],"headings":[{"id":"return-value","text":"Return value","level":2},{"id":"state-and-ownership","text":"State and ownership","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"host","text":"host","level":3},{"id":"source","text":"source","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2},{"id":"see","text":"See","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createDebouncedValue<TValue, TSelected>(\n   host,\n   source,\n   options,\n   selector?): [CellValue<TValue>, LitDebouncer<SetValue<TValue>, TSelected>];\n```\n\nDefined in: [debouncer/createDebouncedValue.ts:37](https://github.com/TanStack/pacer/blob/main/packages/lit-pacer/src/debouncer/createDebouncedValue.ts#L37)\n\nDerives a debounced value from its current source.\n\nWith the default trailing behavior, each call restarts the wait timer and only the latest pending update executes. Leading and trailing options control the edges.\n\n## Return value\n\nReturns [value, utility]. The value is an accessor; call value() from render(). Pass a getter that reads reactive source state. The initial value is available immediately. Source changes schedule updates on the existing utility.\n\n## State and ownership\n\nThe value updates independently of the utility selector. The default utility selection is {}. Pass a selector to subscribe to fields such as executionCount, isPending, or status where the underlying utility exposes them.\n\nPass the owning ReactiveControllerHost first. Host updates refresh options. Disconnecting runs cleanup; reconnecting restores subscriptions to the same utility.\nOptions accept an object with top-level getters or an options factory. Function-valued core options remain callbacks. Local options override provider defaults without replacing the utility or its pending work.\nonUnmount replaces default cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\n### source\n\n`ValueSource`\\<`TValue`\\>\n\n### options\n\n[`LitPacerOptions`](../type-aliases/LitPacerOptions.md)\\<[`LitDebouncerOptions`](../interfaces/LitDebouncerOptions.md)\\<`SetValue`\\<`TValue`\\>, `TSelected`\\>\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n\\[`CellValue`\\<`TValue`\\>, [`LitDebouncer`](../interfaces/LitDebouncer.md)\\<`SetValue`\\<`TValue`\\>, `TSelected`\\>\\]\n\n## Example\n\n```ts\nimport { createDebouncedValue } from '@tanstack/lit-pacer'\n\n// In a LitElement constructor:\n// query is a reactive property on this host.\nconst [value, utility] = createDebouncedValue(this, () => this.query, { wait: 500 })\n// Bind value and use utility for controls. Read value() for the committed value.\n```\n\n## See\n\ncreateDebouncer\n","originalRawMarkdown":"---\nid: createDebouncedValue\ntitle: createDebouncedValue\n---\n\n```ts\nfunction createDebouncedValue<TValue, TSelected>(\n   host,\n   source,\n   options,\n   selector?): [CellValue<TValue>, LitDebouncer<SetValue<TValue>, TSelected>];\n```\n\nDefined in: [debouncer/createDebouncedValue.ts:37](https://github.com/TanStack/pacer/blob/main/packages/lit-pacer/src/debouncer/createDebouncedValue.ts#L37)\n\nDerives a debounced value from its current source.\n\nWith the default trailing behavior, each call restarts the wait timer and only the latest pending update executes. Leading and trailing options control the edges.\n\n## Return value\n\nReturns [value, utility]. The value is an accessor; call value() from render(). Pass a getter that reads reactive source state. The initial value is available immediately. Source changes schedule updates on the existing utility.\n\n## State and ownership\n\nThe value updates independently of the utility selector. The default utility selection is {}. Pass a selector to subscribe to fields such as executionCount, isPending, or status where the underlying utility exposes them.\n\nPass the owning ReactiveControllerHost first. Host updates refresh options. Disconnecting runs cleanup; reconnecting restores subscriptions to the same utility.\nOptions accept an object with top-level getters or an options factory. Function-valued core options remain callbacks. Local options override provider defaults without replacing the utility or its pending work.\nonUnmount replaces default cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\n### source\n\n`ValueSource`\\<`TValue`\\>\n\n### options\n\n[`LitPacerOptions`](../type-aliases/LitPacerOptions.md)\\<[`LitDebouncerOptions`](../interfaces/LitDebouncerOptions.md)\\<`SetValue`\\<`TValue`\\>, `TSelected`\\>\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n\\[`CellValue`\\<`TValue`\\>, [`LitDebouncer`](../interfaces/LitDebouncer.md)\\<`SetValue`\\<`TValue`\\>, `TSelected`\\>\\]\n\n## Example\n\n```ts\nimport { createDebouncedValue } from '@tanstack/lit-pacer'\n\n// In a LitElement constructor:\n// query is a reactive property on this host.\nconst [value, utility] = createDebouncedValue(this, () => this.query, { wait: 500 })\n// Bind value and use utility for controls. Read value() for the committed value.\n```\n\n## See\n\ncreateDebouncer\n"}
