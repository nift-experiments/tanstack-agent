type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastExecutionTime"},{"type":"text","value":": Timestamp of the last function execution in milliseconds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"maybeExecuteCount"},{"type":"text","value":": Number of times maybeExecute has been called (for reduction calculations)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"nextExecutionTime"},{"type":"text","value":": Timestamp when the next execution can occur in milliseconds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status - 'idle' when not active, 'pending' when waiting for timeout"}]}]}]},{"type":"heading","depth":2,"id":"options-and-ownership","children":[{"type":"text","value":"Options and ownership"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nDisconnecting the host calls cancel().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\nReconnecting the host refreshes options and restores subscriptions to the same instance."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyFunction"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"host","children":[{"type":"text","value":"host"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveControllerHost"}]},{"type":"paragraph","children":[{"type":"text","value":"Owner of option updates, subscriptions, and cleanup."}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"paragraph","children":[{"type":"text","value":"Function executed by the utility."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/LitPacerOptions.md","children":[{"type":"inlineCode","value":"LitPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/LitThrottlerOptions.md","children":[{"type":"inlineCode","value":"LitThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Core options or a reactive factory, plus an optional onUnmount callback."}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"text","value":"Selects state that updates the owner. Omit to leave selected state empty."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/LitThrottler.md","children":[{"type":"inlineCode","value":"LitThrottler"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The retained utility instance with selected state and child subscriptions."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { createThrottler } from '@tanstack/lit-pacer'\n\nconst utility = createThrottler(\n  this, (value: string) => { console.log(value) },\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\nutility.maybeExecute('item')\n// Selected state: utility.state.isPending","lang":"ts"}],"headings":[{"id":"state-and-subscriptions","text":"State and subscriptions","level":2},{"id":"options-and-ownership","text":"Options and ownership","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"host","text":"host","level":3},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createThrottler<TFn, TSelected>(\n   host,\n   fn,\n   options,\nselector?): LitThrottler<TFn, TSelected>;\n```\n\nDefined in: [throttler/createThrottler.ts:87](https://github.com/TanStack/pacer/blob/main/packages/lit-pacer/src/throttler/createThrottler.ts#L87)\n\nCreates and retains the Throttler for its Lit owner.\n\nLimits execution to at most one call per wait interval. Leading and trailing options control immediate and deferred execution; the trailing call uses the latest arguments.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nUse utility.subscribe(childHost, selector) for a child subscription. It returns a getter\nand cleans up with the child without canceling the parent utility.\n\nAvailable state fields:\n\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last function execution in milliseconds\n- `maybeExecuteCount`: Number of times maybeExecute has been called (for reduction calculations)\n- `nextExecutionTime`: Timestamp when the next execution can occur in milliseconds\n- `status`: Current execution status - 'idle' when not active, 'pending' when waiting for timeout\n\n## Options and ownership\n\nPass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nDisconnecting the host calls cancel().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\nReconnecting the host refreshes options and restores subscriptions to the same instance.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nOwner of option updates, subscriptions, and cleanup.\n\n### fn\n\n`TFn`\n\nFunction executed by the utility.\n\n### options\n\n[`LitPacerOptions`](../type-aliases/LitPacerOptions.md)\\<[`LitThrottlerOptions`](../interfaces/LitThrottlerOptions.md)\\<`TFn`, `TSelected`\\>\\>\n\nCore options or a reactive factory, plus an optional onUnmount callback.\n\n### selector?\n\n(`state`) => `TSelected`\n\nSelects state that updates the owner. Omit to leave selected state empty.\n\n## Returns\n\n[`LitThrottler`](../interfaces/LitThrottler.md)\\<`TFn`, `TSelected`\\>\n\nThe retained utility instance with selected state and child subscriptions.\n\n## Example\n\n```ts\nimport { createThrottler } from '@tanstack/lit-pacer'\n\nconst utility = createThrottler(\n  this, (value: string) => { console.log(value) },\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\nutility.maybeExecute('item')\n// Selected state: utility.state.isPending\n```\n","originalRawMarkdown":"---\nid: createThrottler\ntitle: createThrottler\n---\n\n```ts\nfunction createThrottler<TFn, TSelected>(\n   host,\n   fn,\n   options,\nselector?): LitThrottler<TFn, TSelected>;\n```\n\nDefined in: [throttler/createThrottler.ts:87](https://github.com/TanStack/pacer/blob/main/packages/lit-pacer/src/throttler/createThrottler.ts#L87)\n\nCreates and retains the Throttler for its Lit owner.\n\nLimits execution to at most one call per wait interval. Leading and trailing options control immediate and deferred execution; the trailing call uses the latest arguments.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nUse utility.subscribe(childHost, selector) for a child subscription. It returns a getter\nand cleans up with the child without canceling the parent utility.\n\nAvailable state fields:\n\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last function execution in milliseconds\n- `maybeExecuteCount`: Number of times maybeExecute has been called (for reduction calculations)\n- `nextExecutionTime`: Timestamp when the next execution can occur in milliseconds\n- `status`: Current execution status - 'idle' when not active, 'pending' when waiting for timeout\n\n## Options and ownership\n\nPass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nDisconnecting the host calls cancel().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\nReconnecting the host refreshes options and restores subscriptions to the same instance.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nOwner of option updates, subscriptions, and cleanup.\n\n### fn\n\n`TFn`\n\nFunction executed by the utility.\n\n### options\n\n[`LitPacerOptions`](../type-aliases/LitPacerOptions.md)\\<[`LitThrottlerOptions`](../interfaces/LitThrottlerOptions.md)\\<`TFn`, `TSelected`\\>\\>\n\nCore options or a reactive factory, plus an optional onUnmount callback.\n\n### selector?\n\n(`state`) => `TSelected`\n\nSelects state that updates the owner. Omit to leave selected state empty.\n\n## Returns\n\n[`LitThrottler`](../interfaces/LitThrottler.md)\\<`TFn`, `TSelected`\\>\n\nThe retained utility instance with selected state and child subscriptions.\n\n## Example\n\n```ts\nimport { createThrottler } from '@tanstack/lit-pacer'\n\nconst utility = createThrottler(\n  this, (value: string) => { console.log(value) },\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\nutility.maybeExecute('item')\n// Selected state: utility.state.isPending\n```\n"}
