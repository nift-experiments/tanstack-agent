n":[{"type":"link","href":"./guides/async-batching.md","children":[{"type":"text","value":"async batching"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncBatcher"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncBatchedCallback"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-debouncing.md","children":[{"type":"text","value":"async debouncing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncDebouncer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncDebouncedCallback"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-queuing.md","children":[{"type":"text","value":"async queuing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncQueuer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncQueuedState"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-rate-limiting.md","children":[{"type":"text","value":"async rate limiting"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncRateLimiter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncRateLimitedCallback"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-throttling.md","children":[{"type":"text","value":"async throttling"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncThrottler"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"useAsyncThrottledCallback"}]}]]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"This counter coalesces rapid clicks into one update after 500 ms. Flush applies the latest pending count immediately."}]},{"type":"code","value":"import { useState } from 'octane'\nimport { useDebouncer } from '@tanstack/octane-pacer'\n\nexport function Counter() {\n  const [count, setCount] = useState(0)\n  const [debouncedCount, setDebouncedCount] = useState(0)\n  const debouncer = useDebouncer(setDebouncedCount, { wait: 500 }, (state) => ({\n    isPending: state.isPending,\n  }))\n  function increment() {\n    const next = count + 1\n    setCount(next)\n    debouncer.maybeExecute(next)\n  }\n  return (\n    <div>\n      <button onClick={increment}>Increment</button>\n      <p>\n        Count: {count}. Debounced: {debouncedCount}.\n      </p>\n      <p>Pending: {String(debouncer.state.isPending)}</p>\n      <button onClick={() => debouncer.flush()}>Flush</button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"child-subscriptions","children":[{"type":"text","value":"Child subscriptions"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"utility.Subscribe"},{"type":"text","value":" with an ordinary JSX render callback. The child subscribes to its selection without changing the utility owner's selection, and unmounting releases it."}]},{"type":"code","value":"<debouncer.Subscribe selector={(state) => ({ isPending: state.isPending })}>\n  {({ isPending }) => <span>Pending: {String(isPending)}</span>}\n</debouncer.Subscribe>","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Use the JSX callback syntax shown here with Octane 0.1.36. Native "},{"type":"inlineCode","value":"@{...}"},{"type":"text","value":" template blocks are not supported as this component's render callback."}]},{"type":"heading","depth":2,"id":"reactive-options","children":[{"type":"text","value":"Reactive options"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass a plain options object, property getters, or an options factory. The adapter evaluates top-level getters, while function-valued core options remain callbacks. Options update the existing utility; pending work, counters, and the store retain their identity."}]},{"type":"paragraph","children":[{"type":"text","value":"Options retain the core partial-merge behavior. Omitting a key preserves the previous setting; explicitly passing "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" clears it. "},{"type":"inlineCode","value":"key"},{"type":"text","value":", "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":", and "},{"type":"inlineCode","value":"initialItems"},{"type":"text","value":" initialize the utility once and do not recreate it on later updates."}]},{"type":"heading","depth":2,"id":"default-options","children":[{"type":"text","value":"Default options"}]},{"type":"paragraph","children":[{"type":"text","value":"Wrap descendants in "},{"type":"inlineCode","value":"PacerProvider"},{"type":"text","value":" with "},{"type":"inlineCode","value":"defaultOptions"},{"type":"text","value":". Group defaults by utility, such as "},{"type":"inlineCode","value":"{ debouncer: { leading: true } }"},{"type":"text","value":". Local options take precedence and provider changes apply after commit."}]},{"type":"heading","depth":2,"id":"cleanup","children":[{"type":"text","value":"Cleanup"}]},{"type":"paragraph","children":[{"type":"text","value":"Debouncers, throttlers, and batchers cancel pending timers by default. Queuers stop processing. Async variants also abort active work. Synchronous rate limiters need no timer cleanup."}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" to replace the default cleanup, for example to call "},{"type":"inlineCode","value":"flush()"},{"type":"text","value":" before leaving a page. The callback receives the adapter instance and its selected state. If you replace cleanup for an async utility, call its cancellation or abort methods when needed."}]},{"type":"heading","depth":2,"id":"callback-and-value-helpers","children":[{"type":"text","value":"Callback and value helpers"}]},{"type":"paragraph","children":[{"type":"text","value":"Callback helpers return only the scheduled function. Use an instance API when you need "},{"type":"inlineCode","value":"flush"},{"type":"text","value":", "},{"type":"inlineCode","value":"cancel"},{"type":"text","value":", queue controls, or state subscriptions."}]},{"type":"paragraph","children":[{"type":"text","value":"State helpers return "},{"type":"inlineCode","value":"[value, setValue, utility]"},{"type":"text","value":"; value helpers return "},{"type":"inlineCode","value":"[value, utility]"},{"type":"text","value":". Setters accept a new value or a functional update. Synchronous queue state helpers return "},{"type":"inlineCode","value":"[items, addItem, utility]"},{"type":"text","value":". Async queue state helpers return "},{"type":"inlineCode","value":"[items, utility]"},{"type":"text","value":"; call "},{"type":"inlineCode","value":"utility.addItem()"},{"type":"text","value":" to enqueue an item."}]},{"type":"heading","depth":2,"id":"async-utilities","children":[{"type":"text","value":"Async utilities"}]},{"type":"paragraph","children":[{"type":"text","value":"The five async utilities preserve typed results and core error behavior. Use "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" for outcomes, and "},{"type":"inlineCode","value":"asyncRetryerOptions"},{"type":"text","value":" for retry configuration. "},{"type":"inlineCode","value":"abort()"},{"type":"text","value":" is cooperative: your operation must observe the supplied abort signal. See the individual async guides for scheduling and concurrency details."}]},{"type":"heading","depth":2,"id":"devtools","children":[{"type":"text","value":"Devtools"}]},{"type":"paragraph","children":[{"type":"text","value":"Install "},{"type":"inlineCode","value":"@tanstack/devtools"},{"type":"text","value":" and "},{"type":"inlineCode","value":"@tanstack/pacer-devtools"},{"type":"text","value":". Mount "},{"type":"inlineCode","value":"TanStackDevtoolsCore"},{"type":"text","value":" with "},{"type":"inlineCode","value":"plugins: [pacerDevtoolsPlugin()]"},{"type":"text","value":" once in your application and unmount it during cleanup. Give each utility a "},{"type":"inlineCode","value":"key"},{"type":"text","value":" to make it appear in the Pacer panel."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../../devtools.md#lit-alpine-ember-and-octane-setup","children":[{"type":"text","value":"devtools setup guide"}]},{"type":"text","value":" for this framework's mount and cleanup code."}]},{"type":"heading","depth":2,"id":"api-reference","children":[{"type":"text","value":"API reference"}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./reference/index.md","children":[{"type":"text","value":"generated reference"}]},{"type":"text","value":" for signatures, options, and return types."}]}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"lifecycle-and-state","text":"Lifecycle and state","level":2},{"id":"api-overview","text":"API overview","level":2},{"id":"example","text":"Example","level":2},{"id":"child-subscriptions","text":"Child subscriptions","level":2},{"id":"reactive-options","text":"Reactive options","level":2},{"id":"default-options","text":"Default options","level":2},{"id":"cleanup","text":"Cleanup","level":2},{"id":"callback-and-value-helpers","text":"Callback and value helpers","level":2},{"id":"async-utilities","text":"Async utilities","level":2},{"id":"devtools","text":"Devtools","level":2},{"id":"api-reference","text":"API reference","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe `octane-pacer` adapter connects Pacer scheduling utilities to Octane state and lifecycle management. It re-exports the core package, including utility classes, stateless functions, option types, and async retrying.\n\n## Installation\n\n```sh\npnpm add @tanstack/octane-pacer\n```\n\nOctane requires Node.js 22.22.2 or newer and Octane 0.1.36.\n\n## Lifecycle and state\n\nCall hooks at the top level of a compiled Octane component. The compiler assigns each call its own hook slot. The hook retains its utility across renders and commits the current callback and options in a layout effect. Selected state triggers rendering, and unmounting cleans up the utility. Use Octane 0.1.36; this package does not support the 0.2 line yet.\n\nBy default, the selected state is `{}`. Pass a selector to subscribe only to the fields your UI reads. The underlying `store` remains available for additional subscriptions.\n\n## API overview\n\n| Utility                                                | Instance API          | Convenience APIs                                                       |\n| ------------------------------------------------------ | --------------------- | ---------------------------------------------------------------------- |\n| [batching](./guides/batching.md)                       | `useBatcher`          | `useBatchedCallback`                                                   |\n| [debouncing](./guides/debouncing.md)                   | `useDebouncer`        | `useDebouncedCallback`, `useDebouncedState`, `useDebouncedValue`       |\n| [queuing](./guides/queuing.md)                         | `useQueuer`           | `useQueuedState`, `useQueuedValue`                                     |\n| [rate limiting](./guides/rate-limiting.md)             | `useRateLimiter`      | `useRateLimitedCallback`, `useRateLimitedState`, `useRateLimitedValue` |\n| [throttling](./guides/throttling.md)                   | `useThrottler`        | `useThrottledCallback`, `useThrottledState`, `useThrottledValue`       |\n| [async batching](./guides/async-batching.md)           | `useAsyncBatcher`     | `useAsyncBatchedCallback`                                              |\n| [async debouncing](./guides/async-debouncing.md)       | `useAsyncDebouncer`   | `useAsyncDebouncedCallback`                                            |\n| [async queuing](./guides/async-queuing.md)             | `useAsyncQueuer`      | `useAsyncQueuedState`                                                  |\n| [async rate limiting](./guides/async-rate-limiting.md) | `useAsyncRateLimiter` | `useAsyncRateLimitedCallback`                                          |\n| [async throttling](./guides/async-throttling.md)       | `useAsyncThrottler`   | `useAsyncThrottledCallback`                                            |\n\n## Example\n\nThis counter coalesces rapid clicks into one update after 500 ms. Flush applies the latest pending count immediately.\n\n```tsx\nimport { useState } from 'octane'\nimport { useDebouncer } from '@tanstack/octane-pacer'\n\nexport function Counter() {\n  const [count, setCount] = useState(0)\n  const [debouncedCount, setDebouncedCount] = useState(0)\n  const debouncer = useDebouncer(setDebouncedCount, { wait: 500 }, (state) => ({\n    isPending: state.isPending,\n  }))\n  function increment() {\n    const next = count + 1\n    setCount(next)\n    debouncer.maybeExecute(next)\n  }\n  return (\n    <div>\n      <button onClick={increment}>Increment</button>\n      <p>\n        Count: {count}. Debounced: {debouncedCount}.\n      </p>\n      <p>Pending: {String(debouncer.state.isPending)}</p>\n      <button onClick={() => debouncer.flush()}>Flush</button>\n    </div>\n  )\n}\n```\n\n## Child subscriptions\n\nUse `utility.Subscribe` with an ordinary JSX render callback. The child subscribes to its selection without changing the utility owner's selection, and unmounting releases it.\n\n```tsx\n<debouncer.Subscribe selector={(state) => ({ isPending: state.isPending })}>\n  {({ isPending }) => <span>Pending: {String(isPending)}</span>}\n</debouncer.Subscribe>\n```\n\nUse the JSX callback syntax shown here with Octane 0.1.36. Native `@{...}` template blocks are not supported as this component's render callback.\n\n## Reactive options\n\nPass a plain options object, property getters, or an options factory. The adapter evaluates top-level getters, while function-valued core options remain callbacks. Options update the existing utility; pending work, counters, and the store retain their identity.\n\nOptions retain the core partial-merge behavior. Omitting a key preserves the previous setting; explicitly passing `undefined` clears it. `key`, `initialState`, and `initialItems` initialize the utility once and do not recreate it on later updates.\n\n## Default options\n\nWrap descendants in `PacerProvider` with `defaultOptions`. Group defaults by utility, such as `{ debouncer: { leading: true } }`. Local options take precedence and provider changes apply after commit.\n\n## Cleanup\n\nDebouncers, throttlers, and batchers cancel pending timers by default. Queuers stop processing. Async variants also abort active work. Synchronous rate limiters need no timer cleanup.\n\nSet `onUnmount` to replace the default cleanup, for example to call `flush()` before leaving a page. The callback receives the adapter instance and its selected state. If you replace cleanup for an async utility, call its cancellation or abort methods when needed.\n\n## Callback and value helpers\n\nCallback helpers return only the scheduled function. Use an instance API when you need `flush`, `cancel`, queue controls, or state subscriptions.\n\nState helpers return `[value, setValue, utility]`; value helpers return `[value, utility]`. Setters accept a new value or a functional update. Synchronous queue state helpers return `[items, addItem, utility]`. Async queue state helpers return `[items, utility]`; call `utility.addItem()` to enqueue an item.\n\n## Async utilities\n\nThe five async utilities preserve typed results and core error behavior. Use `onSuccess`, `onError`, and `onSettled` for outcomes, and `asyncRetryerOptions` for retry configuration. `abort()` is cooperative: your operation must observe the supplied abort signal. See the individual async guides for scheduling and concurrency details.\n\n## Devtools\n\nInstall `@tanstack/devtools` and `@tanstack/pacer-devtools`. Mount `TanStackDevtoolsCore` with `plugins: [pacerDevtoolsPlugin()]` once in your application and unmount it during cleanup. Give each utility a `key` to make it appear in the Pacer panel.\n\nSee the [devtools setup guide](../../devtools.md#lit-alpine-ember-and-octane-setup) for this framework's mount and cleanup code.\n\n## API reference\n\nSee the [generated reference](./reference/index.md) for signatures, options, and return types.\n","originalRawMarkdown":"---\ntitle: Octane Adapter\nid: adapter\n---\n\nThe `octane-pacer` adapter connects Pacer scheduling utilities to Octane state and lifecycle management. It re-exports the core package, including utility classes, stateless functions, option types, and async retrying.\n\n## Installation\n\n```sh\npnpm add @tanstack/octane-pacer\n```\n\nOctane requires Node.js 22.22.2 or newer and Octane 0.1.36.\n\n## Lifecycle and state\n\nCall hooks at the top level of a compiled Octane component. The compiler assigns each call its own hook slot. The hook retains its utility across renders and commits the current callback and options in a layout effect. Selected state triggers rendering, and unmounting cleans up the utility. Use Octane 0.1.36; this package does not support the 0.2 line yet.\n\nBy default, the selected state is `{}`. Pass a selector to subscribe only to the fields your UI reads. The underlying `store` remains available for additional subscriptions.\n\n## API overview\n\n| Utility                                                | Instance API          | Convenience APIs                                                       |\n| ------------------------------------------------------ | --------------------- | ---------------------------------------------------------------------- |\n| [batching](./guides/batching.md)                       | `useBatcher`          | `useBatchedCallback`                                                   |\n| [debouncing](./guides/debouncing.md)                   | `useDebouncer`        | `useDebouncedCallback`, `useDebouncedState`, `useDebouncedValue`       |\n| [queuing](./guides/queuing.md)                         | `useQueuer`           | `useQueuedState`, `useQueuedValue`                                     |\n| [rate limiting](./guides/rate-limiting.md)             | `useRateLimiter`      | `useRateLimitedCallback`, `useRateLimitedState`, `useRateLimitedValue` |\n| [throttling](./guides/throttling.md)                   | `useThrottler`        | `useThrottledCallback`, `useThrottledState`, `useThrottledValue`       |\n| [async batching](./guides/async-batching.md)           | `useAsyncBatcher`     | `useAsyncBatchedCallback`                                              |\n| [async debouncing](./guides/async-debouncing.md)       | `useAsyncDebouncer`   | `useAsyncDebouncedCallback`                                            |\n| [async queuing](./guides/async-queuing.md)             | `useAsyncQueuer`      | `useAsyncQueuedState`                                                  |\n| [async rate limiting](./guides/async-rate-limiting.md) | `useAsyncRateLimiter` | `useAsyncRateLimitedCallback`                                          |\n| [async throttling](./guides/async-throttling.md)       | `useAsyncThrottler`   | `useAsyncThrottledCallback`                                            |\n\n## Example\n\nThis counter coalesces rapid clicks into one update after 500 ms. Flush applies the latest pending count immediately.\n\n```tsx\nimport { useState } from 'octane'\nimport { useDebouncer } from '@tanstack/octane-pacer'\n\nexport function Counter() {\n  const [count, setCount] = useState(0)\n  const [debouncedCount, setDebouncedCount] = useState(0)\n  const debouncer = useDebouncer(setDebouncedCount, { wait: 500 }, (state) => ({\n    isPending: state.isPending,\n  }))\n  function increment() {\n    const next = count + 1\n    setCount(next)\n    debouncer.maybeExecute(next)\n  }\n  return (\n    <div>\n      <button onClick={increment}>Increment</button>\n      <p>\n        Count: {count}. Debounced: {debouncedCount}.\n      </p>\n      <p>Pending: {String(debouncer.state.isPending)}</p>\n      <button onClick={() => debouncer.flush()}>Flush</button>\n    </div>\n  )\n}\n```\n\n## Child subscriptions\n\nUse `utility.Subscribe` with an ordinary JSX render callback. The child subscribes to its selection without changing the utility owner's selection, and unmounting releases it.\n\n```tsx\n<debouncer.Subscribe selector={(state) => ({ isPending: state.isPending })}>\n  {({ isPending }) => <span>Pending: {String(isPending)}</span>}\n</debouncer.Subscribe>\n```\n\nUse the JSX callback syntax shown here with Octane 0.1.36. Native `@{...}` template blocks are not supported as this component's render callback.\n\n## Reactive options\n\nPass a plain options object, property getters, or an options factory. The adapter evaluates top-level getters, while function-valued core options remain callbacks. Options update the existing utility; pending work, counters, and the store retain their identity.\n\nOptions retain the core partial-merge behavior. Omitting a key preserves the previous setting; explicitly passing `undefined` clears it. `key`, `initialState`, and `initialItems` initialize the utility once and do not recreate it on later updates.\n\n## Default options\n\nWrap descendants in `PacerProvider` with `defaultOptions`. Group defaults by utility, such as `{ debouncer: { leading: true } }`. Local options take precedence and provider changes apply after commit.\n\n## Cleanup\n\nDebouncers, throttlers, and batchers cancel pending timers by default. Queuers stop processing. Async variants also abort active work. Synchronous rate limiters need no timer cleanup.\n\nSet `onUnmount` to replace the default cleanup, for example to call `flush()` before leaving a page. The callback receives the adapter instance and its selected state. If you replace cleanup for an async utility, call its cancellation or abort methods when needed.\n\n## Callback and value helpers\n\nCallback helpers return only the scheduled function. Use an instance API when you need `flush`, `cancel`, queue controls, or state subscriptions.\n\nState helpers return `[value, setValue, utility]`; value helpers return `[value, utility]`. Setters accept a new value or a functional update. Synchronous queue state helpers return `[items, addItem, utility]`. Async queue state helpers return `[items, utility]`; call `utility.addItem()` to enqueue an item.\n\n## Async utilities\n\nThe five async utilities preserve typed results and core error behavior. Use `onSuccess`, `onError`, and `onSettled` for outcomes, and `asyncRetryerOptions` for retry configuration. `abort()` is cooperative: your operation must observe the supplied abort signal. See the individual async guides for scheduling and concurrency details.\n\n## Devtools\n\nInstall `@tanstack/devtools` and `@tanstack/pacer-devtools`. Mount `TanStackDevtoolsCore` with `plugins: [pacerDevtoolsPlugin()]` once in your application and unmount it during cleanup. Give each utility a `key` to make it appear in the Pacer panel.\n\nSee the [devtools setup guide](../../devtools.md#lit-alpine-ember-and-octane-setup) for this framework's mount and cleanup code.\n\n## API reference\n\nSee the [generated reference](./reference/index.md) for signatures, options, and return types.\n"}
