e":"itemTimestamps"},{"type":"text","value":": Timestamps when items were added to the queue for expiration tracking"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent task execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"pendingTick"},{"type":"text","value":": Whether the queuer has a pending timeout for processing the next item"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"rejectionCount"},{"type":"text","value":": Number of items that have been rejected from being added to the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of task executions that have completed (either successfully or with errors)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"size"},{"type":"text","value":": Number of items currently in the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current processing status - 'idle' when not processing, 'running' when active, 'stopped' when paused"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of task executions that have completed successfully"}]}]}]},{"type":"heading","depth":2,"id":"options-and-ownership","children":[{"type":"text","value":"Options and ownership"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nUnmounting the component calls stop() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"item"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Function executed by the utility."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/OctanePacerOptions.md","children":[{"type":"inlineCode","value":"OctanePacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/OctaneAsyncQueuerOptions.md","children":[{"type":"inlineCode","value":"OctaneAsyncQueuerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Core options or a reactive factory, plus an optional onUnmount callback."}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"text","value":"Selects state that updates the owner. Omit to leave selected state empty."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/OctaneAsyncQueuer.md","children":[{"type":"inlineCode","value":"OctaneAsyncQueuer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The retained utility instance with selected state and child subscriptions."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { useAsyncQueuer } from '@tanstack/octane-pacer'\n\nconst utility = useAsyncQueuer(\n  async (value: string) => { console.log(value) },\n  { wait: 100 },\n  (state) => ({ size: state.size }),\n)\nutility.addItem('item')\n// Selected state: utility.state.size","lang":"ts"}],"headings":[{"id":"state-and-subscriptions","text":"State and subscriptions","level":2},{"id":"options-and-ownership","text":"Options and ownership","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useAsyncQueuer<TValue, TSelected>(\n   fn,\n   options?,\nselector?): OctaneAsyncQueuer<TValue, TSelected>;\n```\n\nDefined in: [async-queuer/useAsyncQueuer.ts:103](https://github.com/TanStack/pacer/blob/main/packages/octane-pacer/src/async-queuer/useAsyncQueuer.ts#L103)\n\nCreates and retains the AsyncQueuer for its Octane owner.\n\nRetains items until they are processed. Use addItem to enqueue work and start, stop, execute, clear, or flush to control processing. Selected state exposes pending items, capacity, and completed work.\n\nThe callback may return a Promise. Core result, error, retry, and abort behavior is preserved.\nUse onSuccess, onError, and onSettled for execution outcomes.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nRead selected state through utility.state. Use utility.Subscribe with a render callback\nto select state in a child without subscribing the owner.\n\nAvailable state fields:\n\n- `activeItems`: Items currently being processed by the queuer\n- `addItemCount`: Number of times addItem has been called (for reduction calculations)\n- `errorCount`: Number of task executions that have resulted in errors\n- `executionCount`: Number of times execute has been called\n- `expirationCount`: Number of items that have been removed from the queue due to expiration\n- `isEmpty`: Whether the queuer has no items to process (items array is empty)\n- `isExecuting`: Whether the queuer is currently executing\n- `isFull`: Whether the queuer has reached its maximum capacity\n- `isIdle`: Whether the queuer is not currently processing any items\n- `isRunning`: Whether the queuer is active and will process items automatically\n- `items`: Array of items currently waiting to be processed\n- `itemTimestamps`: Timestamps when items were added to the queue for expiration tracking\n- `lastResult`: The result from the most recent task execution\n- `pendingTick`: Whether the queuer has a pending timeout for processing the next item\n- `rejectionCount`: Number of items that have been rejected from being added to the queue\n- `settleCount`: Number of task executions that have completed (either successfully or with errors)\n- `size`: Number of items currently in the queue\n- `status`: Current processing status - 'idle' when not processing, 'running' when active, 'stopped' when paused\n- `successCount`: Number of task executions that have completed successfully\n\n## Options and ownership\n\nPass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nUnmounting the component calls stop() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`item`) => `Promise`\\<`any`\\>\n\nFunction executed by the utility.\n\n### options?\n\n[`OctanePacerOptions`](../type-aliases/OctanePacerOptions.md)\\<[`OctaneAsyncQueuerOptions`](../interfaces/OctaneAsyncQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\>\n\nCore options or a reactive factory, plus an optional onUnmount callback.\n\n### selector?\n\n(`state`) => `TSelected`\n\nSelects state that updates the owner. Omit to leave selected state empty.\n\n## Returns\n\n[`OctaneAsyncQueuer`](../interfaces/OctaneAsyncQueuer.md)\\<`TValue`, `TSelected`\\>\n\nThe retained utility instance with selected state and child subscriptions.\n\n## Example\n\n```ts\nimport { useAsyncQueuer } from '@tanstack/octane-pacer'\n\nconst utility = useAsyncQueuer(\n  async (value: string) => { console.log(value) },\n  { wait: 100 },\n  (state) => ({ size: state.size }),\n)\nutility.addItem('item')\n// Selected state: utility.state.size\n```\n","originalRawMarkdown":"---\nid: useAsyncQueuer\ntitle: useAsyncQueuer\n---\n\n```ts\nfunction useAsyncQueuer<TValue, TSelected>(\n   fn,\n   options?,\nselector?): OctaneAsyncQueuer<TValue, TSelected>;\n```\n\nDefined in: [async-queuer/useAsyncQueuer.ts:103](https://github.com/TanStack/pacer/blob/main/packages/octane-pacer/src/async-queuer/useAsyncQueuer.ts#L103)\n\nCreates and retains the AsyncQueuer for its Octane owner.\n\nRetains items until they are processed. Use addItem to enqueue work and start, stop, execute, clear, or flush to control processing. Selected state exposes pending items, capacity, and completed work.\n\nThe callback may return a Promise. Core result, error, retry, and abort behavior is preserved.\nUse onSuccess, onError, and onSettled for execution outcomes.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nRead selected state through utility.state. Use utility.Subscribe with a render callback\nto select state in a child without subscribing the owner.\n\nAvailable state fields:\n\n- `activeItems`: Items currently being processed by the queuer\n- `addItemCount`: Number of times addItem has been called (for reduction calculations)\n- `errorCount`: Number of task executions that have resulted in errors\n- `executionCount`: Number of times execute has been called\n- `expirationCount`: Number of items that have been removed from the queue due to expiration\n- `isEmpty`: Whether the queuer has no items to process (items array is empty)\n- `isExecuting`: Whether the queuer is currently executing\n- `isFull`: Whether the queuer has reached its maximum capacity\n- `isIdle`: Whether the queuer is not currently processing any items\n- `isRunning`: Whether the queuer is active and will process items automatically\n- `items`: Array of items currently waiting to be processed\n- `itemTimestamps`: Timestamps when items were added to the queue for expiration tracking\n- `lastResult`: The result from the most recent task execution\n- `pendingTick`: Whether the queuer has a pending timeout for processing the next item\n- `rejectionCount`: Number of items that have been rejected from being added to the queue\n- `settleCount`: Number of task executions that have completed (either successfully or with errors)\n- `size`: Number of items currently in the queue\n- `status`: Current processing status - 'idle' when not processing, 'running' when active, 'stopped' when paused\n- `successCount`: Number of task executions that have completed successfully\n\n## Options and ownership\n\nPass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nUnmounting the component calls stop() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`item`) => `Promise`\\<`any`\\>\n\nFunction executed by the utility.\n\n### options?\n\n[`OctanePacerOptions`](../type-aliases/OctanePacerOptions.md)\\<[`OctaneAsyncQueuerOptions`](../interfaces/OctaneAsyncQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\>\n\nCore options or a reactive factory, plus an optional onUnmount callback.\n\n### selector?\n\n(`state`) => `TSelected`\n\nSelects state that updates the owner. Omit to leave selected state empty.\n\n## Returns\n\n[`OctaneAsyncQueuer`](../interfaces/OctaneAsyncQueuer.md)\\<`TValue`, `TSelected`\\>\n\nThe retained utility instance with selected state and child subscriptions.\n\n## Example\n\n```ts\nimport { useAsyncQueuer } from '@tanstack/octane-pacer'\n\nconst utility = useAsyncQueuer(\n  async (value: string) => { console.log(value) },\n  { wait: 100 },\n  (state) => ({ size: state.size }),\n)\nutility.addItem('item')\n// Selected state: utility.state.size\n```\n"}
