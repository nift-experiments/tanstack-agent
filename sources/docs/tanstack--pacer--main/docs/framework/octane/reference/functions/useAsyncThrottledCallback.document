efault cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyAsyncFunction"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/OctanePacerOptions.md","children":[{"type":"inlineCode","value":"OctanePacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/OctaneAsyncThrottlerOptions.md","children":[{"type":"inlineCode","value":"OctaneAsyncThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", {\n}>>"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Attempts to execute the throttled function. The execution behavior depends on the throttler options:"}]},{"type":"list","ordered":false,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If enough time has passed since the last execution (>= wait period):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With leading=true: Executes immediately"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With leading=false: Waits for the next trailing execution"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If within the wait period:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With trailing=true: Schedules execution for end of wait period"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With trailing=false: Drops the execution"}]}]}]}]}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"text","value":"..."},{"type":"inlineCode","value":"Parameters"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Awaited"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReturnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">> | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const throttled = new AsyncThrottler(fn, { wait: 1000 });\n\n// First call executes immediately\nawait throttled.maybeExecute('a', 'b');\n\n// Call during wait period - gets throttled\nawait throttled.maybeExecute('c', 'd');","lang":"ts"},{"type":"heading","depth":2,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { useAsyncThrottledCallback } from '@tanstack/octane-pacer'\n\n// During component rendering:\nconst schedule = useAsyncThrottledCallback(async (value: number) => { console.log(value) }, { wait: 500 })\nvoid schedule(1)","lang":"ts"},{"type":"heading","depth":2,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"text","value":"useAsyncThrottler"}]}],"headings":[{"id":"return-value","text":"Return value","level":2},{"id":"state-and-ownership","text":"State and ownership","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"parameters-2","text":"Parameters","level":3},{"id":"args","text":"args","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example","text":"Example","level":3},{"id":"example-2","text":"Example","level":2},{"id":"see","text":"See","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useAsyncThrottledCallback<TFn>(fn, options): (...args) => Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-throttler/useAsyncThrottledCallback.ts:37](https://github.com/TanStack/pacer/blob/main/packages/octane-pacer/src/async-throttler/useAsyncThrottledCallback.ts#L37)\n\nReturns a stable throttled callback owned by the Octane lifecycle.\n\nLimits execution to the configured wait interval. Leading and trailing execution are enabled by default, and the latest blocked update is retained for the trailing edge.\n\n## Return value\n\nReturns the bound maybeExecute method with the wrapped function's parameter types. The returned Promise preserves the core result and error contract. A replaced trailing call resolves with the previous lastResult; it does not wait for the newer call.\n\n## State and ownership\n\nUse useAsyncThrottler when you need selected state or control methods. This callback does not expose the utility, its store, or a child subscription.\n\nCall during component rendering. The hook retains its utility across renders and runs cleanup when the component unmounts.\nOptions accept an object with top-level getters or an options factory. Function-valued core options remain callbacks. Local options override provider defaults without replacing the utility or its pending work.\nonUnmount replaces default cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`OctanePacerOptions`](../type-aliases/OctanePacerOptions.md)\\<[`OctaneAsyncThrottlerOptions`](../interfaces/OctaneAsyncThrottlerOptions.md)\\<`TFn`, \\{\n\\}\\>\\>\n\n## Returns\n\n```ts\n(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nAttempts to execute the throttled function. The execution behavior depends on the throttler options:\n\n- If enough time has passed since the last execution (>= wait period):\n  - With leading=true: Executes immediately\n  - With leading=false: Waits for the next trailing execution\n\n- If within the wait period:\n  - With trailing=true: Schedules execution for end of wait period\n  - With trailing=false: Drops the execution\n\n### Parameters\n\n#### args\n\n...`Parameters`\\<`TFn`\\>\n\n### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\n### Example\n\n```ts\nconst throttled = new AsyncThrottler(fn, { wait: 1000 });\n\n// First call executes immediately\nawait throttled.maybeExecute('a', 'b');\n\n// Call during wait period - gets throttled\nawait throttled.maybeExecute('c', 'd');\n```\n\n## Example\n\n```ts\nimport { useAsyncThrottledCallback } from '@tanstack/octane-pacer'\n\n// During component rendering:\nconst schedule = useAsyncThrottledCallback(async (value: number) => { console.log(value) }, { wait: 500 })\nvoid schedule(1)\n```\n\n## See\n\nuseAsyncThrottler\n","originalRawMarkdown":"---\nid: useAsyncThrottledCallback\ntitle: useAsyncThrottledCallback\n---\n\n```ts\nfunction useAsyncThrottledCallback<TFn>(fn, options): (...args) => Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-throttler/useAsyncThrottledCallback.ts:37](https://github.com/TanStack/pacer/blob/main/packages/octane-pacer/src/async-throttler/useAsyncThrottledCallback.ts#L37)\n\nReturns a stable throttled callback owned by the Octane lifecycle.\n\nLimits execution to the configured wait interval. Leading and trailing execution are enabled by default, and the latest blocked update is retained for the trailing edge.\n\n## Return value\n\nReturns the bound maybeExecute method with the wrapped function's parameter types. The returned Promise preserves the core result and error contract. A replaced trailing call resolves with the previous lastResult; it does not wait for the newer call.\n\n## State and ownership\n\nUse useAsyncThrottler when you need selected state or control methods. This callback does not expose the utility, its store, or a child subscription.\n\nCall during component rendering. The hook retains its utility across renders and runs cleanup when the component unmounts.\nOptions accept an object with top-level getters or an options factory. Function-valued core options remain callbacks. Local options override provider defaults without replacing the utility or its pending work.\nonUnmount replaces default cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`OctanePacerOptions`](../type-aliases/OctanePacerOptions.md)\\<[`OctaneAsyncThrottlerOptions`](../interfaces/OctaneAsyncThrottlerOptions.md)\\<`TFn`, \\{\n\\}\\>\\>\n\n## Returns\n\n```ts\n(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nAttempts to execute the throttled function. The execution behavior depends on the throttler options:\n\n- If enough time has passed since the last execution (>= wait period):\n  - With leading=true: Executes immediately\n  - With leading=false: Waits for the next trailing execution\n\n- If within the wait period:\n  - With trailing=true: Schedules execution for end of wait period\n  - With trailing=false: Drops the execution\n\n### Parameters\n\n#### args\n\n...`Parameters`\\<`TFn`\\>\n\n### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\n### Example\n\n```ts\nconst throttled = new AsyncThrottler(fn, { wait: 1000 });\n\n// First call executes immediately\nawait throttled.maybeExecute('a', 'b');\n\n// Call during wait period - gets throttled\nawait throttled.maybeExecute('c', 'd');\n```\n\n## Example\n\n```ts\nimport { useAsyncThrottledCallback } from '@tanstack/octane-pacer'\n\n// During component rendering:\nconst schedule = useAsyncThrottledCallback(async (value: number) => { console.log(value) }, { wait: 500 })\nvoid schedule(1)\n```\n\n## See\n\nuseAsyncThrottler\n"}
