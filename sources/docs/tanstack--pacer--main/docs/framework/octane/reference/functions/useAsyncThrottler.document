":"paragraph","children":[{"type":"inlineCode","value":"isExecuting"},{"type":"text","value":": Whether the throttled function is currently executing asynchronously"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the throttler is waiting for the timeout to trigger execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastExecutionTime"},{"type":"text","value":": Timestamp of the last function execution in milliseconds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent successful function execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"maybeExecuteCount"},{"type":"text","value":": Number of times maybeExecute has been called (for reduction calculations)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"nextExecutionTime"},{"type":"text","value":": Timestamp when the next execution can occur in milliseconds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of function executions that have completed (either successfully or with errors)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status - 'idle' when not active, 'pending' when waiting, 'executing' when running, 'settled' when completed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of function executions that have completed successfully"}]}]}]},{"type":"heading","depth":2,"id":"options-and-ownership","children":[{"type":"text","value":"Options and ownership"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nUnmounting the component calls cancel() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyAsyncFunction"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"paragraph","children":[{"type":"text","value":"Function executed by the utility."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/OctanePacerOptions.md","children":[{"type":"inlineCode","value":"OctanePacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/OctaneAsyncThrottlerOptions.md","children":[{"type":"inlineCode","value":"OctaneAsyncThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Core options or a reactive factory, plus an optional onUnmount callback."}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"text","value":"Selects state that updates the owner. Omit to leave selected state empty."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/OctaneAsyncThrottler.md","children":[{"type":"inlineCode","value":"OctaneAsyncThrottler"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The retained utility instance with selected state and child subscriptions."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { useAsyncThrottler } from '@tanstack/octane-pacer'\n\nconst utility = useAsyncThrottler(\n  async (value: string) => { console.log(value) },\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\nutility.maybeExecute('item')\n// Selected state: utility.state.isPending","lang":"ts"}],"headings":[{"id":"state-and-subscriptions","text":"State and subscriptions","level":2},{"id":"options-and-ownership","text":"Options and ownership","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useAsyncThrottler<TFn, TSelected>(\n   fn,\n   options,\nselector?): OctaneAsyncThrottler<TFn, TSelected>;\n```\n\nDefined in: [async-throttler/useAsyncThrottler.ts:96](https://github.com/TanStack/pacer/blob/main/packages/octane-pacer/src/async-throttler/useAsyncThrottler.ts#L96)\n\nCreates and retains the AsyncThrottler for its Octane owner.\n\nLimits execution to at most one call per wait interval. Leading and trailing options control immediate and deferred execution; the trailing call uses the latest arguments.\n\nThe callback may return a Promise. Core result, error, retry, and abort behavior is preserved.\nUse onSuccess, onError, and onSettled for execution outcomes.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nRead selected state through utility.state. Use utility.Subscribe with a render callback\nto select state in a child without subscribing the owner.\n\nAvailable state fields:\n\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether the throttled function is currently executing asynchronously\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last function execution in milliseconds\n- `lastResult`: The result from the most recent successful function execution\n- `maybeExecuteCount`: Number of times maybeExecute has been called (for reduction calculations)\n- `nextExecutionTime`: Timestamp when the next execution can occur in milliseconds\n- `settleCount`: Number of function executions that have completed (either successfully or with errors)\n- `status`: Current execution status - 'idle' when not active, 'pending' when waiting, 'executing' when running, 'settled' when completed\n- `successCount`: Number of function executions that have completed successfully\n\n## Options and ownership\n\nPass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nUnmounting the component calls cancel() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\nFunction executed by the utility.\n\n### options\n\n[`OctanePacerOptions`](../type-aliases/OctanePacerOptions.md)\\<[`OctaneAsyncThrottlerOptions`](../interfaces/OctaneAsyncThrottlerOptions.md)\\<`TFn`, `TSelected`\\>\\>\n\nCore options or a reactive factory, plus an optional onUnmount callback.\n\n### selector?\n\n(`state`) => `TSelected`\n\nSelects state that updates the owner. Omit to leave selected state empty.\n\n## Returns\n\n[`OctaneAsyncThrottler`](../interfaces/OctaneAsyncThrottler.md)\\<`TFn`, `TSelected`\\>\n\nThe retained utility instance with selected state and child subscriptions.\n\n## Example\n\n```ts\nimport { useAsyncThrottler } from '@tanstack/octane-pacer'\n\nconst utility = useAsyncThrottler(\n  async (value: string) => { console.log(value) },\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\nutility.maybeExecute('item')\n// Selected state: utility.state.isPending\n```\n","originalRawMarkdown":"---\nid: useAsyncThrottler\ntitle: useAsyncThrottler\n---\n\n```ts\nfunction useAsyncThrottler<TFn, TSelected>(\n   fn,\n   options,\nselector?): OctaneAsyncThrottler<TFn, TSelected>;\n```\n\nDefined in: [async-throttler/useAsyncThrottler.ts:96](https://github.com/TanStack/pacer/blob/main/packages/octane-pacer/src/async-throttler/useAsyncThrottler.ts#L96)\n\nCreates and retains the AsyncThrottler for its Octane owner.\n\nLimits execution to at most one call per wait interval. Leading and trailing options control immediate and deferred execution; the trailing call uses the latest arguments.\n\nThe callback may return a Promise. Core result, error, retry, and abort behavior is preserved.\nUse onSuccess, onError, and onSettled for execution outcomes.\n\n## State and subscriptions\n\nPass a selector to track only the state consumed by the owner. The default selection is {},\nso utility state changes do not update the owner unless it opts in. Selection uses shallow\ncomparison. The raw store remains available for additional subscriptions.\nRead selected state through utility.state. Use utility.Subscribe with a render callback\nto select state in a child without subscribing the owner.\n\nAvailable state fields:\n\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether the throttled function is currently executing asynchronously\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last function execution in milliseconds\n- `lastResult`: The result from the most recent successful function execution\n- `maybeExecuteCount`: Number of times maybeExecute has been called (for reduction calculations)\n- `nextExecutionTime`: Timestamp when the next execution can occur in milliseconds\n- `settleCount`: Number of function executions that have completed (either successfully or with errors)\n- `status`: Current execution status - 'idle' when not active, 'pending' when waiting, 'executing' when running, 'settled' when completed\n- `successCount`: Number of function executions that have completed successfully\n\n## Options and ownership\n\nPass an options object with property getters or a factory. Top-level properties are read\nreactively; function-valued core options remain callbacks. Local options override provider\ndefaults. Updates retain the utility, its store, counters, and pending work.\nUnmounting the component calls cancel() and abort().\nonUnmount replaces default cleanup and receives the same adapter instance. A custom callback\nmust perform all required cleanup. Use flush() where supported to finish pending work.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\nFunction executed by the utility.\n\n### options\n\n[`OctanePacerOptions`](../type-aliases/OctanePacerOptions.md)\\<[`OctaneAsyncThrottlerOptions`](../interfaces/OctaneAsyncThrottlerOptions.md)\\<`TFn`, `TSelected`\\>\\>\n\nCore options or a reactive factory, plus an optional onUnmount callback.\n\n### selector?\n\n(`state`) => `TSelected`\n\nSelects state that updates the owner. Omit to leave selected state empty.\n\n## Returns\n\n[`OctaneAsyncThrottler`](../interfaces/OctaneAsyncThrottler.md)\\<`TFn`, `TSelected`\\>\n\nThe retained utility instance with selected state and child subscriptions.\n\n## Example\n\n```ts\nimport { useAsyncThrottler } from '@tanstack/octane-pacer'\n\nconst utility = useAsyncThrottler(\n  async (value: string) => { console.log(value) },\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending }),\n)\nutility.maybeExecute('item')\n// Selected state: utility.state.isPending\n```\n"}
