value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyFunction"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/OctanePacerOptions.md","children":[{"type":"inlineCode","value":"OctanePacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/OctaneRateLimiterOptions.md","children":[{"type":"inlineCode","value":"OctaneRateLimiterOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", {\n}>>"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"(...args): boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Attempts to execute the rate-limited function if within the configured limits.\nWill reject execution if the number of calls in the current window exceeds the limit."}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"text","value":"..."},{"type":"inlineCode","value":"Parameters"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const rateLimiter = new RateLimiter(fn, { limit: 5, window: 1000 });\n\n// First 5 calls will return true\nrateLimiter.maybeExecute('arg1', 'arg2'); // true\n\n// Additional calls within the window will return false\nrateLimiter.maybeExecute('arg1', 'arg2'); // false","lang":"ts"},{"type":"heading","depth":2,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { useRateLimitedCallback } from '@tanstack/octane-pacer'\n\n// During component rendering:\nconst schedule = useRateLimitedCallback((value: number) => { console.log(value) }, { limit: 3, window: 1000 })\nschedule(1)","lang":"ts"},{"type":"heading","depth":2,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"text","value":"useRateLimiter"}]}],"headings":[{"id":"return-value","text":"Return value","level":2},{"id":"state-and-ownership","text":"State and ownership","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"parameters-2","text":"Parameters","level":3},{"id":"args","text":"args","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example","text":"Example","level":3},{"id":"example-2","text":"Example","level":2},{"id":"see","text":"See","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useRateLimitedCallback<TFn>(fn, options): (...args) => boolean;\n```\n\nDefined in: [rate-limiter/useRateLimitedCallback.ts:37](https://github.com/TanStack/pacer/blob/main/packages/octane-pacer/src/rate-limiter/useRateLimitedCallback.ts#L37)\n\nReturns a stable rate-limited callback owned by the Octane lifecycle.\n\nAccepts updates while the configured limit has capacity in its fixed or sliding window. Rejected updates are discarded instead of delayed.\n\n## Return value\n\nReturns the bound maybeExecute method with the wrapped function's parameter types. It returns an accepted-or-rejected boolean.\n\n## State and ownership\n\nUse useRateLimiter when you need selected state or control methods. This callback does not expose the utility, its store, or a child subscription.\n\nCall during component rendering. The hook retains its utility across renders and runs cleanup when the component unmounts.\nOptions accept an object with top-level getters or an options factory. Function-valued core options remain callbacks. Local options override provider defaults without replacing the utility or its pending work.\nonUnmount replaces default cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyFunction`\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`OctanePacerOptions`](../type-aliases/OctanePacerOptions.md)\\<[`OctaneRateLimiterOptions`](../interfaces/OctaneRateLimiterOptions.md)\\<`TFn`, \\{\n\\}\\>\\>\n\n## Returns\n\n```ts\n(...args): boolean;\n```\n\nAttempts to execute the rate-limited function if within the configured limits.\nWill reject execution if the number of calls in the current window exceeds the limit.\n\n### Parameters\n\n#### args\n\n...`Parameters`\\<`TFn`\\>\n\n### Returns\n\n`boolean`\n\n### Example\n\n```ts\nconst rateLimiter = new RateLimiter(fn, { limit: 5, window: 1000 });\n\n// First 5 calls will return true\nrateLimiter.maybeExecute('arg1', 'arg2'); // true\n\n// Additional calls within the window will return false\nrateLimiter.maybeExecute('arg1', 'arg2'); // false\n```\n\n## Example\n\n```ts\nimport { useRateLimitedCallback } from '@tanstack/octane-pacer'\n\n// During component rendering:\nconst schedule = useRateLimitedCallback((value: number) => { console.log(value) }, { limit: 3, window: 1000 })\nschedule(1)\n```\n\n## See\n\nuseRateLimiter\n","originalRawMarkdown":"---\nid: useRateLimitedCallback\ntitle: useRateLimitedCallback\n---\n\n```ts\nfunction useRateLimitedCallback<TFn>(fn, options): (...args) => boolean;\n```\n\nDefined in: [rate-limiter/useRateLimitedCallback.ts:37](https://github.com/TanStack/pacer/blob/main/packages/octane-pacer/src/rate-limiter/useRateLimitedCallback.ts#L37)\n\nReturns a stable rate-limited callback owned by the Octane lifecycle.\n\nAccepts updates while the configured limit has capacity in its fixed or sliding window. Rejected updates are discarded instead of delayed.\n\n## Return value\n\nReturns the bound maybeExecute method with the wrapped function's parameter types. It returns an accepted-or-rejected boolean.\n\n## State and ownership\n\nUse useRateLimiter when you need selected state or control methods. This callback does not expose the utility, its store, or a child subscription.\n\nCall during component rendering. The hook retains its utility across renders and runs cleanup when the component unmounts.\nOptions accept an object with top-level getters or an options factory. Function-valued core options remain callbacks. Local options override provider defaults without replacing the utility or its pending work.\nonUnmount replaces default cleanup and receives the utility instance. A custom callback must perform every needed cancel, stop, or abort action.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyFunction`\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`OctanePacerOptions`](../type-aliases/OctanePacerOptions.md)\\<[`OctaneRateLimiterOptions`](../interfaces/OctaneRateLimiterOptions.md)\\<`TFn`, \\{\n\\}\\>\\>\n\n## Returns\n\n```ts\n(...args): boolean;\n```\n\nAttempts to execute the rate-limited function if within the configured limits.\nWill reject execution if the number of calls in the current window exceeds the limit.\n\n### Parameters\n\n#### args\n\n...`Parameters`\\<`TFn`\\>\n\n### Returns\n\n`boolean`\n\n### Example\n\n```ts\nconst rateLimiter = new RateLimiter(fn, { limit: 5, window: 1000 });\n\n// First 5 calls will return true\nrateLimiter.maybeExecute('arg1', 'arg2'); // true\n\n// Additional calls within the window will return false\nrateLimiter.maybeExecute('arg1', 'arg2'); // false\n```\n\n## Example\n\n```ts\nimport { useRateLimitedCallback } from '@tanstack/octane-pacer'\n\n// During component rendering:\nconst schedule = useRateLimitedCallback((value: number) => { console.log(value) }, { limit: 3, window: 1000 })\nschedule(1)\n```\n\n## See\n\nuseRateLimiter\n"}
