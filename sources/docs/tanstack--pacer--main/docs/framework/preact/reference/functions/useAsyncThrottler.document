{"document":{"type":"root","children":[{"type":"code","value":"function useAsyncThrottler<TFn, TSelected>(\n   fn,\n   options,\nselector?): PreactAsyncThrottler<TFn, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/preact-pacer/src/async-throttler/useAsyncThrottler.ts#L225","children":[{"type":"text","value":"async-throttler/useAsyncThrottler.ts:225"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A low-level Preact hook that creates an "},{"type":"inlineCode","value":"AsyncThrottler"},{"type":"text","value":" instance to limit how often an async function can execute."}]},{"type":"paragraph","children":[{"type":"text","value":"This hook is designed to be flexible and state-management agnostic - it simply returns a throttler instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc)."}]},{"type":"paragraph","children":[{"type":"text","value":"Async throttling ensures an async function executes at most once within a specified time window,\nregardless of how many times it is called. This is useful for rate-limiting expensive API calls,\ndatabase operations, or other async tasks."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike the non-async Throttler, this async version supports returning values from the throttled function,\nmaking it ideal for API calls and other async operations where you want the result of the "},{"type":"inlineCode","value":"maybeExecute"},{"type":"text","value":" call\ninstead of setting the result on a state variable from within the throttled function."}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is provided, it will be called with the error and throttler instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together - the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncThrottler instance"}]}]}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"1. Using "},{"type":"inlineCode","value":"throttler.Subscribe"},{"type":"text","value":" HOC (Recommended for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"errorCount"},{"type":"text","value":": Number of function executions that have resulted in errors"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isExecuting"},{"type":"text","value":": Whether the throttled function is currently executing asynchronously"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the throttler is waiting for the timeout to trigger execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastExecutionTime"},{"type":"text","value":": Timestamp of the last function execution in milliseconds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent successful function execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"nextExecutionTime"},{"type":"text","value":": Timestamp when the next execution can occur in milliseconds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of function executions that have completed (success or error)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status ('disabled' | 'idle' | 'pending' | 'executing' | 'settled')"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of function executions that have completed successfully"}]}]}]},{"type":"heading","depth":2,"id":"unmount-behavior","children":[{"type":"text","value":"Unmount behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the hook cancels any pending execution and aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from "},{"type":"inlineCode","value":"getAbortSignal()"},{"type":"text","value":" is passed to them.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this. For example, to flush pending work instead:"}]},{"type":"code","value":"const throttler = useAsyncThrottler(fn, {\n  wait: 1000,\n  onUnmount: (t) => t.flush()\n});","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Note: For async utils, "},{"type":"inlineCode","value":"flush()"},{"type":"text","value":" returns a Promise and runs fire-and-forget in the cleanup.\nIf your throttled function updates Preact state, those updates may run after the component has\nunmounted, which can cause \"setState on unmounted component\" warnings. Guard your callbacks\naccordingly when using onUnmount with flush."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyAsyncFunction"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/PreactAsyncThrottlerOptions.md","children":[{"type":"inlineCode","value":"PreactAsyncThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/PreactAsyncThrottler.md","children":[{"type":"inlineCode","value":"PreactAsyncThrottler"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data; // Return value is preserved\n  },\n  { wait: 1000 }\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<asyncThrottler.Subscribe selector={(state) => ({ isPending: state.isPending })}>\n  {({ isPending }) => (\n    <div>{isPending ? 'Processing...' : 'Ready'}</div>\n  )}\n</asyncThrottler.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { wait: 1000 },\n  (state) => ({\n    isExecuting: state.isExecuting,\n    isPending: state.isPending,\n    status: state.status\n  })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { wait: 1000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount,\n    settleCount: state.settleCount\n  })\n);\n\n// Opt-in to re-render when error state changes (optimized for error handling)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  {\n    wait: 1000,\n    onError: (error) => console.error('API call failed:', error)\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    status: state.status\n  })\n);\n\n// Opt-in to re-render when timing information changes (optimized for timing displays)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { wait: 1000 },\n  (state) => ({\n    lastExecutionTime: state.lastExecutionTime,\n    nextExecutionTime: state.nextExecutionTime\n  })\n);\n\n// With state management and return value\nconst [data, setData] = useState(null);\nconst { maybeExecute, state } = useAsyncThrottler(\n  async (query) => {\n    const result = await searchAPI(query);\n    setData(result);\n    return result; // Return value can be used by the caller\n  },\n  {\n    wait: 2000,\n    leading: true,   // Execute immediately on first call\n    trailing: false  // Skip trailing edge updates\n  }\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult } = state;","lang":"tsx"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"unmount-behavior","text":"Unmount behavior","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useAsyncThrottler<TFn, TSelected>(\n   fn,\n   options,\nselector?): PreactAsyncThrottler<TFn, TSelected>;\n```\n\nDefined in: [async-throttler/useAsyncThrottler.ts:225](https://github.com/TanStack/pacer/blob/main/packages/preact-pacer/src/async-throttler/useAsyncThrottler.ts#L225)\n\nA low-level Preact hook that creates an `AsyncThrottler` instance to limit how often an async function can execute.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a throttler instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc).\n\nAsync throttling ensures an async function executes at most once within a specified time window,\nregardless of how many times it is called. This is useful for rate-limiting expensive API calls,\ndatabase operations, or other async tasks.\n\nUnlike the non-async Throttler, this async version supports returning values from the throttled function,\nmaking it ideal for API calls and other async operations where you want the result of the `maybeExecute` call\ninstead of setting the result on a state variable from within the throttled function.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and throttler instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncThrottler instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `throttler.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether the throttled function is currently executing asynchronously\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last function execution in milliseconds\n- `lastResult`: The result from the most recent successful function execution\n- `nextExecutionTime`: Timestamp when the next execution can occur in milliseconds\n- `settleCount`: Number of function executions that have completed (success or error)\n- `status`: Current execution status ('disabled' | 'idle' | 'pending' | 'executing' | 'settled')\n- `successCount`: Number of function executions that have completed successfully\n\n## Unmount behavior\n\nBy default, the hook cancels any pending execution and aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst throttler = useAsyncThrottler(fn, {\n  wait: 1000,\n  onUnmount: (t) => t.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your throttled function updates Preact state, those updates may run after the component has\nunmounted, which can cause \"setState on unmounted component\" warnings. Guard your callbacks\naccordingly when using onUnmount with flush.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`PreactAsyncThrottlerOptions`](../interfaces/PreactAsyncThrottlerOptions.md)\\<`TFn`, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`PreactAsyncThrottler`](../interfaces/PreactAsyncThrottler.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data; // Return value is preserved\n  },\n  { wait: 1000 }\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<asyncThrottler.Subscribe selector={(state) => ({ isPending: state.isPending })}>\n  {({ isPending }) => (\n    <div>{isPending ? 'Processing...' : 'Ready'}</div>\n  )}\n</asyncThrottler.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { wait: 1000 },\n  (state) => ({\n    isExecuting: state.isExecuting,\n    isPending: state.isPending,\n    status: state.status\n  })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { wait: 1000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount,\n    settleCount: state.settleCount\n  })\n);\n\n// Opt-in to re-render when error state changes (optimized for error handling)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  {\n    wait: 1000,\n    onError: (error) => console.error('API call failed:', error)\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    status: state.status\n  })\n);\n\n// Opt-in to re-render when timing information changes (optimized for timing displays)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { wait: 1000 },\n  (state) => ({\n    lastExecutionTime: state.lastExecutionTime,\n    nextExecutionTime: state.nextExecutionTime\n  })\n);\n\n// With state management and return value\nconst [data, setData] = useState(null);\nconst { maybeExecute, state } = useAsyncThrottler(\n  async (query) => {\n    const result = await searchAPI(query);\n    setData(result);\n    return result; // Return value can be used by the caller\n  },\n  {\n    wait: 2000,\n    leading: true,   // Execute immediately on first call\n    trailing: false  // Skip trailing edge updates\n  }\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult } = state;\n```\n","originalRawMarkdown":"---\nid: useAsyncThrottler\ntitle: useAsyncThrottler\n---\n\n```ts\nfunction useAsyncThrottler<TFn, TSelected>(\n   fn,\n   options,\nselector?): PreactAsyncThrottler<TFn, TSelected>;\n```\n\nDefined in: [async-throttler/useAsyncThrottler.ts:225](https://github.com/TanStack/pacer/blob/main/packages/preact-pacer/src/async-throttler/useAsyncThrottler.ts#L225)\n\nA low-level Preact hook that creates an `AsyncThrottler` instance to limit how often an async function can execute.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a throttler instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc).\n\nAsync throttling ensures an async function executes at most once within a specified time window,\nregardless of how many times it is called. This is useful for rate-limiting expensive API calls,\ndatabase operations, or other async tasks.\n\nUnlike the non-async Throttler, this async version supports returning values from the throttled function,\nmaking it ideal for API calls and other async operations where you want the result of the `maybeExecute` call\ninstead of setting the result on a state variable from within the throttled function.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and throttler instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncThrottler instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `throttler.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether the throttled function is currently executing asynchronously\n- `isPending`: Whether the throttler is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Timestamp of the last function execution in milliseconds\n- `lastResult`: The result from the most recent successful function execution\n- `nextExecutionTime`: Timestamp when the next execution can occur in milliseconds\n- `settleCount`: Number of function executions that have completed (success or error)\n- `status`: Current execution status ('disabled' | 'idle' | 'pending' | 'executing' | 'settled')\n- `successCount`: Number of function executions that have completed successfully\n\n## Unmount behavior\n\nBy default, the hook cancels any pending execution and aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst throttler = useAsyncThrottler(fn, {\n  wait: 1000,\n  onUnmount: (t) => t.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your throttled function updates Preact state, those updates may run after the component has\nunmounted, which can cause \"setState on unmounted component\" warnings. Guard your callbacks\naccordingly when using onUnmount with flush.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`PreactAsyncThrottlerOptions`](../interfaces/PreactAsyncThrottlerOptions.md)\\<`TFn`, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`PreactAsyncThrottler`](../interfaces/PreactAsyncThrottler.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data; // Return value is preserved\n  },\n  { wait: 1000 }\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<asyncThrottler.Subscribe selector={(state) => ({ isPending: state.isPending })}>\n  {({ isPending }) => (\n    <div>{isPending ? 'Processing...' : 'Ready'}</div>\n  )}\n</asyncThrottler.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { wait: 1000 },\n  (state) => ({\n    isExecuting: state.isExecuting,\n    isPending: state.isPending,\n    status: state.status\n  })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { wait: 1000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount,\n    settleCount: state.settleCount\n  })\n);\n\n// Opt-in to re-render when error state changes (optimized for error handling)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  {\n    wait: 1000,\n    onError: (error) => console.error('API call failed:', error)\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    status: state.status\n  })\n);\n\n// Opt-in to re-render when timing information changes (optimized for timing displays)\nconst asyncThrottler = useAsyncThrottler(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { wait: 1000 },\n  (state) => ({\n    lastExecutionTime: state.lastExecutionTime,\n    nextExecutionTime: state.nextExecutionTime\n  })\n);\n\n// With state management and return value\nconst [data, setData] = useState(null);\nconst { maybeExecute, state } = useAsyncThrottler(\n  async (query) => {\n    const result = await searchAPI(query);\n    setData(result);\n    return result; // Return value can be used by the caller\n  },\n  {\n    wait: 2000,\n    leading: true,   // Execute immediately on first call\n    trailing: false  // Skip trailing edge updates\n  }\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult } = state;\n```\n"}
