{"document":{"type":"root","children":[{"type":"code","value":"function useDebouncedValue<TValue, TSelected>(\n   value,\n   options,\n   selector?): [TValue, PreactDebouncer<Dispatch<StateUpdater<TValue>>, TSelected>];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/preact-pacer/src/debouncer/useDebouncedValue.ts#L88","children":[{"type":"text","value":"debouncer/useDebouncedValue.ts:88"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A Preact hook that creates a debounced value that updates only after a specified delay.\nUnlike useDebouncedState, this hook automatically tracks changes to the input value\nand updates the debounced value accordingly."}]},{"type":"paragraph","children":[{"type":"text","value":"The debounced value will only update after the specified wait time has elapsed since\nthe last change to the input value. If the input value changes again before the wait\ntime expires, the timer resets and starts waiting again."}]},{"type":"paragraph","children":[{"type":"text","value":"This is useful for deriving debounced values from props or state that change frequently,\nlike search queries or form inputs, where you want to limit how often downstream effects\nor calculations occur."}]},{"type":"paragraph","children":[{"type":"text","value":"The hook returns the current debounced value and the underlying debouncer instance.\nThe debouncer instance can be used to access additional functionality like cancellation\nand execution counts."}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management via the underlying debouncer instance.\nThe "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which debouncer state changes will trigger a re-render,\noptimizing performance by preventing unnecessary re-renders when irrelevant state changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary re-renders and gives you\nfull control over when your component updates. Only when you provide a selector will the\ncomponent re-render when the selected state values change."}]},{"type":"paragraph","children":[{"type":"text","value":"Available debouncer state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"canLeadingExecute"},{"type":"text","value":": Whether the debouncer can execute on the leading edge"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Number of function executions that have been completed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the debouncer is waiting for the timeout to trigger execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status ('disabled' | 'idle' | 'pending')"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = "},{"type":"inlineCode","value":"DebouncerState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Dispatch"},{"type":"text","value":"<"},{"type":"inlineCode","value":"StateUpdater"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>>"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/PreactDebouncerOptions.md","children":[{"type":"inlineCode","value":"PreactDebouncerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"Dispatch"},{"type":"text","value":"<"},{"type":"inlineCode","value":"StateUpdater"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>, "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"["},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"link","href":"../interfaces/PreactDebouncer.md","children":[{"type":"inlineCode","value":"PreactDebouncer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"Dispatch"},{"type":"text","value":"<"},{"type":"inlineCode","value":"StateUpdater"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>, "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">]"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst [searchQuery, setSearchQuery] = useState('');\nconst [debouncedQuery, debouncer] = useDebouncedValue(searchQuery, {\n  wait: 500 // Wait 500ms after last change\n});\n\n// Opt-in to re-render when pending state changes (optimized for loading indicators)\nconst [debouncedQuery, debouncer] = useDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending })\n);\n\n// Opt-in to re-render when execution count changes (optimized for tracking executions)\nconst [debouncedQuery, debouncer] = useDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ executionCount: state.executionCount })\n);\n\n// Opt-in to re-render when debouncing status changes (optimized for status display)\nconst [debouncedQuery, debouncer] = useDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({\n    status: state.status,\n    canLeadingExecute: state.canLeadingExecute\n  })\n);\n\n// debouncedQuery will update 500ms after searchQuery stops changing\nuseEffect(() => {\n  fetchSearchResults(debouncedQuery);\n}, [debouncedQuery]);\n\n// Handle input changes\nconst handleChange = (e) => {\n  setSearchQuery(e.target.value);\n};\n\n// Access the selected debouncer state (will be empty object {} unless selector provided)\nconst { isPending, executionCount } = debouncer.state;","lang":"tsx"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"value","text":"value","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useDebouncedValue<TValue, TSelected>(\n   value,\n   options,\n   selector?): [TValue, PreactDebouncer<Dispatch<StateUpdater<TValue>>, TSelected>];\n```\n\nDefined in: [debouncer/useDebouncedValue.ts:88](https://github.com/TanStack/pacer/blob/main/packages/preact-pacer/src/debouncer/useDebouncedValue.ts#L88)\n\nA Preact hook that creates a debounced value that updates only after a specified delay.\nUnlike useDebouncedState, this hook automatically tracks changes to the input value\nand updates the debounced value accordingly.\n\nThe debounced value will only update after the specified wait time has elapsed since\nthe last change to the input value. If the input value changes again before the wait\ntime expires, the timer resets and starts waiting again.\n\nThis is useful for deriving debounced values from props or state that change frequently,\nlike search queries or form inputs, where you want to limit how often downstream effects\nor calculations occur.\n\nThe hook returns the current debounced value and the underlying debouncer instance.\nThe debouncer instance can be used to access additional functionality like cancellation\nand execution counts.\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management via the underlying debouncer instance.\nThe `selector` parameter allows you to specify which debouncer state changes will trigger a re-render,\noptimizing performance by preventing unnecessary re-renders when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary re-renders and gives you\nfull control over when your component updates. Only when you provide a selector will the\ncomponent re-render when the selected state values change.\n\nAvailable debouncer state properties:\n- `canLeadingExecute`: Whether the debouncer can execute on the leading edge\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the debouncer is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = `DebouncerState`\\<`Dispatch`\\<`StateUpdater`\\<`TValue`\\>\\>\\>\n\n## Parameters\n\n### value\n\n`TValue`\n\n### options\n\n[`PreactDebouncerOptions`](../interfaces/PreactDebouncerOptions.md)\\<`Dispatch`\\<`StateUpdater`\\<`TValue`\\>\\>, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n\\[`TValue`, [`PreactDebouncer`](../interfaces/PreactDebouncer.md)\\<`Dispatch`\\<`StateUpdater`\\<`TValue`\\>\\>, `TSelected`\\>\\]\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst [searchQuery, setSearchQuery] = useState('');\nconst [debouncedQuery, debouncer] = useDebouncedValue(searchQuery, {\n  wait: 500 // Wait 500ms after last change\n});\n\n// Opt-in to re-render when pending state changes (optimized for loading indicators)\nconst [debouncedQuery, debouncer] = useDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending })\n);\n\n// Opt-in to re-render when execution count changes (optimized for tracking executions)\nconst [debouncedQuery, debouncer] = useDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ executionCount: state.executionCount })\n);\n\n// Opt-in to re-render when debouncing status changes (optimized for status display)\nconst [debouncedQuery, debouncer] = useDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({\n    status: state.status,\n    canLeadingExecute: state.canLeadingExecute\n  })\n);\n\n// debouncedQuery will update 500ms after searchQuery stops changing\nuseEffect(() => {\n  fetchSearchResults(debouncedQuery);\n}, [debouncedQuery]);\n\n// Handle input changes\nconst handleChange = (e) => {\n  setSearchQuery(e.target.value);\n};\n\n// Access the selected debouncer state (will be empty object {} unless selector provided)\nconst { isPending, executionCount } = debouncer.state;\n```\n","originalRawMarkdown":"---\nid: useDebouncedValue\ntitle: useDebouncedValue\n---\n\n```ts\nfunction useDebouncedValue<TValue, TSelected>(\n   value,\n   options,\n   selector?): [TValue, PreactDebouncer<Dispatch<StateUpdater<TValue>>, TSelected>];\n```\n\nDefined in: [debouncer/useDebouncedValue.ts:88](https://github.com/TanStack/pacer/blob/main/packages/preact-pacer/src/debouncer/useDebouncedValue.ts#L88)\n\nA Preact hook that creates a debounced value that updates only after a specified delay.\nUnlike useDebouncedState, this hook automatically tracks changes to the input value\nand updates the debounced value accordingly.\n\nThe debounced value will only update after the specified wait time has elapsed since\nthe last change to the input value. If the input value changes again before the wait\ntime expires, the timer resets and starts waiting again.\n\nThis is useful for deriving debounced values from props or state that change frequently,\nlike search queries or form inputs, where you want to limit how often downstream effects\nor calculations occur.\n\nThe hook returns the current debounced value and the underlying debouncer instance.\nThe debouncer instance can be used to access additional functionality like cancellation\nand execution counts.\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management via the underlying debouncer instance.\nThe `selector` parameter allows you to specify which debouncer state changes will trigger a re-render,\noptimizing performance by preventing unnecessary re-renders when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary re-renders and gives you\nfull control over when your component updates. Only when you provide a selector will the\ncomponent re-render when the selected state values change.\n\nAvailable debouncer state properties:\n- `canLeadingExecute`: Whether the debouncer can execute on the leading edge\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the debouncer is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = `DebouncerState`\\<`Dispatch`\\<`StateUpdater`\\<`TValue`\\>\\>\\>\n\n## Parameters\n\n### value\n\n`TValue`\n\n### options\n\n[`PreactDebouncerOptions`](../interfaces/PreactDebouncerOptions.md)\\<`Dispatch`\\<`StateUpdater`\\<`TValue`\\>\\>, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n\\[`TValue`, [`PreactDebouncer`](../interfaces/PreactDebouncer.md)\\<`Dispatch`\\<`StateUpdater`\\<`TValue`\\>\\>, `TSelected`\\>\\]\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst [searchQuery, setSearchQuery] = useState('');\nconst [debouncedQuery, debouncer] = useDebouncedValue(searchQuery, {\n  wait: 500 // Wait 500ms after last change\n});\n\n// Opt-in to re-render when pending state changes (optimized for loading indicators)\nconst [debouncedQuery, debouncer] = useDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ isPending: state.isPending })\n);\n\n// Opt-in to re-render when execution count changes (optimized for tracking executions)\nconst [debouncedQuery, debouncer] = useDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({ executionCount: state.executionCount })\n);\n\n// Opt-in to re-render when debouncing status changes (optimized for status display)\nconst [debouncedQuery, debouncer] = useDebouncedValue(\n  searchQuery,\n  { wait: 500 },\n  (state) => ({\n    status: state.status,\n    canLeadingExecute: state.canLeadingExecute\n  })\n);\n\n// debouncedQuery will update 500ms after searchQuery stops changing\nuseEffect(() => {\n  fetchSearchResults(debouncedQuery);\n}, [debouncedQuery]);\n\n// Handle input changes\nconst handleChange = (e) => {\n  setSearchQuery(e.target.value);\n};\n\n// Access the selected debouncer state (will be empty object {} unless selector provided)\nconst { isPending, executionCount } = debouncer.state;\n```\n"}
