ype":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary re-renders and gives you\nfull control over when your component updates. Only when you provide a selector will the\ncomponent re-render when the selected state values change."}]},{"type":"paragraph","children":[{"type":"text","value":"Available queuer state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Number of items that have been processed by the queuer"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"expirationCount"},{"type":"text","value":": Number of items that have been removed due to expiration"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isEmpty"},{"type":"text","value":": Whether the queuer has no items to process"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isFull"},{"type":"text","value":": Whether the queuer has reached its maximum capacity"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isIdle"},{"type":"text","value":": Whether the queuer is not currently processing any items"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isRunning"},{"type":"text","value":": Whether the queuer is active and will process items automatically"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"items"},{"type":"text","value":": Array of items currently waiting to be processed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"itemTimestamps"},{"type":"text","value":": Timestamps when items were added for expiration tracking"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"pendingTick"},{"type":"text","value":": Whether the queuer has a pending timeout for processing the next item"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"rejectionCount"},{"type":"text","value":": Number of items that have been rejected from being added"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"size"},{"type":"text","value":": Number of items currently in the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current processing status ('idle' | 'running' | 'stopped')"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Pick"},{"type":"text","value":"<"},{"type":"inlineCode","value":"QueuerState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"items\""},{"type":"text","value":"> = "},{"type":"inlineCode","value":"Pick"},{"type":"text","value":"<"},{"type":"inlineCode","value":"QueuerState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"items\""},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"initialvalue","children":[{"type":"text","value":"initialValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/PreactQueuerOptions.md","children":[{"type":"inlineCode","value":"PreactQueuerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":"> = "},{"type":"inlineCode","value":"{}"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"["},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"link","href":"../interfaces/PreactQueuer.md","children":[{"type":"inlineCode","value":"PreactQueuer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">]"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst [value, queuer] = useQueuedValue(initialValue, {\n  wait: 500, // Wait 500ms between processing each change\n  started: true // Start processing immediately\n});\n\n// Opt-in to re-render when queue processing state changes (optimized for loading indicators)\nconst [value, queuer] = useQueuedValue(\n  initialValue,\n  { wait: 500, started: true },\n  (state) => ({\n    isRunning: state.isRunning,\n    isIdle: state.isIdle,\n    status: state.status,\n    pendingTick: state.pendingTick\n  })\n);\n\n// Opt-in to re-render when queue contents change (optimized for displaying queue status)\nconst [value, queuer] = useQueuedValue(\n  initialValue,\n  { wait: 500, started: true },\n  (state) => ({\n    size: state.size,\n    isEmpty: state.isEmpty,\n    isFull: state.isFull\n  })\n);\n\n// Opt-in to re-render when execution metrics change (optimized for stats display)\nconst [value, queuer] = useQueuedValue(\n  initialValue,\n  { wait: 500, started: true },\n  (state) => ({\n    executionCount: state.executionCount,\n    expirationCount: state.expirationCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Add changes to the queue\nconst handleChange = (newValue) => {\n  queuer.addItem(newValue);\n};\n\n// Control the queue\nconst pauseProcessing = () => {\n  queuer.stop();\n};\n\nconst resumeProcessing = () => {\n  queuer.start();\n};\n\n// Access the selected queuer state (will be empty object {} unless selector provided)\nconst { size, isRunning, executionCount } = queuer.state;","lang":"tsx"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"initialvalue","text":"initialValue","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useQueuedValue<TValue, TSelected>(\n   initialValue,\n   options?,\n   selector?): [TValue, PreactQueuer<TValue, TSelected>];\n```\n\nDefined in: [queuer/useQueuedValue.ts:103](https://github.com/TanStack/pacer/blob/main/packages/preact-pacer/src/queuer/useQueuedValue.ts#L103)\n\nA Preact hook that creates a queued value that processes state changes in order with an optional delay.\nThis hook uses useQueuer internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe hook returns a tuple containing:\n- The current queued value\n- The queuer instance with control methods\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management via the underlying queuer instance.\nThe `selector` parameter allows you to specify which queuer state changes will trigger a re-render,\noptimizing performance by preventing unnecessary re-renders when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary re-renders and gives you\nfull control over when your component updates. Only when you provide a selector will the\ncomponent re-render when the selected state values change.\n\nAvailable queuer state properties:\n- `executionCount`: Number of items that have been processed by the queuer\n- `expirationCount`: Number of items that have been removed due to expiration\n- `isEmpty`: Whether the queuer has no items to process\n- `isFull`: Whether the queuer has reached its maximum capacity\n- `isIdle`: Whether the queuer is not currently processing any items\n- `isRunning`: Whether the queuer is active and will process items automatically\n- `items`: Array of items currently waiting to be processed\n- `itemTimestamps`: Timestamps when items were added for expiration tracking\n- `pendingTick`: Whether the queuer has a pending timeout for processing the next item\n- `rejectionCount`: Number of items that have been rejected from being added\n- `size`: Number of items currently in the queue\n- `status`: Current processing status ('idle' | 'running' | 'stopped')\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n## Parameters\n\n### initialValue\n\n`TValue`\n\n### options?\n\n[`PreactQueuerOptions`](../interfaces/PreactQueuerOptions.md)\\<`TValue`, `TSelected`\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n\\[`TValue`, [`PreactQueuer`](../interfaces/PreactQueuer.md)\\<`TValue`, `TSelected`\\>\\]\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst [value, queuer] = useQueuedValue(initialValue, {\n  wait: 500, // Wait 500ms between processing each change\n  started: true // Start processing immediately\n});\n\n// Opt-in to re-render when queue processing state changes (optimized for loading indicators)\nconst [value, queuer] = useQueuedValue(\n  initialValue,\n  { wait: 500, started: true },\n  (state) => ({\n    isRunning: state.isRunning,\n    isIdle: state.isIdle,\n    status: state.status,\n    pendingTick: state.pendingTick\n  })\n);\n\n// Opt-in to re-render when queue contents change (optimized for displaying queue status)\nconst [value, queuer] = useQueuedValue(\n  initialValue,\n  { wait: 500, started: true },\n  (state) => ({\n    size: state.size,\n    isEmpty: state.isEmpty,\n    isFull: state.isFull\n  })\n);\n\n// Opt-in to re-render when execution metrics change (optimized for stats display)\nconst [value, queuer] = useQueuedValue(\n  initialValue,\n  { wait: 500, started: true },\n  (state) => ({\n    executionCount: state.executionCount,\n    expirationCount: state.expirationCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Add changes to the queue\nconst handleChange = (newValue) => {\n  queuer.addItem(newValue);\n};\n\n// Control the queue\nconst pauseProcessing = () => {\n  queuer.stop();\n};\n\nconst resumeProcessing = () => {\n  queuer.start();\n};\n\n// Access the selected queuer state (will be empty object {} unless selector provided)\nconst { size, isRunning, executionCount } = queuer.state;\n```\n","originalRawMarkdown":"---\nid: useQueuedValue\ntitle: useQueuedValue\n---\n\n```ts\nfunction useQueuedValue<TValue, TSelected>(\n   initialValue,\n   options?,\n   selector?): [TValue, PreactQueuer<TValue, TSelected>];\n```\n\nDefined in: [queuer/useQueuedValue.ts:103](https://github.com/TanStack/pacer/blob/main/packages/preact-pacer/src/queuer/useQueuedValue.ts#L103)\n\nA Preact hook that creates a queued value that processes state changes in order with an optional delay.\nThis hook uses useQueuer internally to manage a queue of state changes and apply them sequentially.\n\nThe queued value will process changes in the order they are received, with optional delays between\nprocessing each change. This is useful for handling state updates that need to be processed\nin a specific order, like animations or sequential UI updates.\n\nThe hook returns a tuple containing:\n- The current queued value\n- The queuer instance with control methods\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management via the underlying queuer instance.\nThe `selector` parameter allows you to specify which queuer state changes will trigger a re-render,\noptimizing performance by preventing unnecessary re-renders when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary re-renders and gives you\nfull control over when your component updates. Only when you provide a selector will the\ncomponent re-render when the selected state values change.\n\nAvailable queuer state properties:\n- `executionCount`: Number of items that have been processed by the queuer\n- `expirationCount`: Number of items that have been removed due to expiration\n- `isEmpty`: Whether the queuer has no items to process\n- `isFull`: Whether the queuer has reached its maximum capacity\n- `isIdle`: Whether the queuer is not currently processing any items\n- `isRunning`: Whether the queuer is active and will process items automatically\n- `items`: Array of items currently waiting to be processed\n- `itemTimestamps`: Timestamps when items were added for expiration tracking\n- `pendingTick`: Whether the queuer has a pending timeout for processing the next item\n- `rejectionCount`: Number of items that have been rejected from being added\n- `size`: Number of items currently in the queue\n- `status`: Current processing status ('idle' | 'running' | 'stopped')\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` *extends* `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\> = `Pick`\\<`QueuerState`\\<`TValue`\\>, `\"items\"`\\>\n\n## Parameters\n\n### initialValue\n\n`TValue`\n\n### options?\n\n[`PreactQueuerOptions`](../interfaces/PreactQueuerOptions.md)\\<`TValue`, `TSelected`\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n\\[`TValue`, [`PreactQueuer`](../interfaces/PreactQueuer.md)\\<`TValue`, `TSelected`\\>\\]\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst [value, queuer] = useQueuedValue(initialValue, {\n  wait: 500, // Wait 500ms between processing each change\n  started: true // Start processing immediately\n});\n\n// Opt-in to re-render when queue processing state changes (optimized for loading indicators)\nconst [value, queuer] = useQueuedValue(\n  initialValue,\n  { wait: 500, started: true },\n  (state) => ({\n    isRunning: state.isRunning,\n    isIdle: state.isIdle,\n    status: state.status,\n    pendingTick: state.pendingTick\n  })\n);\n\n// Opt-in to re-render when queue contents change (optimized for displaying queue status)\nconst [value, queuer] = useQueuedValue(\n  initialValue,\n  { wait: 500, started: true },\n  (state) => ({\n    size: state.size,\n    isEmpty: state.isEmpty,\n    isFull: state.isFull\n  })\n);\n\n// Opt-in to re-render when execution metrics change (optimized for stats display)\nconst [value, queuer] = useQueuedValue(\n  initialValue,\n  { wait: 500, started: true },\n  (state) => ({\n    executionCount: state.executionCount,\n    expirationCount: state.expirationCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Add changes to the queue\nconst handleChange = (newValue) => {\n  queuer.addItem(newValue);\n};\n\n// Control the queue\nconst pauseProcessing = () => {\n  queuer.stop();\n};\n\nconst resumeProcessing = () => {\n  queuer.start();\n};\n\n// Access the selected queuer state (will be empty object {} unless selector provided)\nconst { size, isRunning, executionCount } = queuer.state;\n```\n"}
