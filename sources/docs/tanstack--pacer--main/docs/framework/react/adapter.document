{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"In a React application, use the React Adapter. Its hooks wrap the core Pacer utilities with lifecycle cleanup and reactive state. The adapter also re-exports everything from the core package, so you can import the plain classes and functions from the same place."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"code","value":"npm install @tanstack/react-pacer","lang":"sh"},{"type":"heading","depth":2,"id":"react-hooks","children":[{"type":"text","value":"React hooks"}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"./reference/index.md","children":[{"type":"text","value":"React Functions Reference"}]},{"type":"text","value":" for the full list of hooks in the React Adapter."}]},{"type":"heading","depth":2,"id":"basic-usage","children":[{"type":"text","value":"Basic usage"}]},{"type":"paragraph","children":[{"type":"text","value":"Import a React-specific hook from the React Adapter."}]},{"type":"code","value":"import { useDebouncedValue } from '@tanstack/react-pacer'\n\nconst [instantValue, instantValueRef] = useState(0)\nconst [debouncedValue, debouncer] = useDebouncedValue(instantValue, {\n  wait: 1000,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Or import a core Pacer class/function that is re-exported from the React Adapter."}]},{"type":"code","value":"import { debounce, Debouncer } from '@tanstack/react-pacer' // no need to install the core package separately","lang":"tsx"},{"type":"heading","depth":2,"id":"option-helpers","children":[{"type":"text","value":"Option helpers"}]},{"type":"paragraph","children":[{"type":"text","value":"Option helpers define shared options with full type checking, so you can declare them once and reuse them across hooks."}]},{"type":"heading","depth":3,"id":"debouncer-options","children":[{"type":"text","value":"Debouncer options"}]},{"type":"code","value":"import { useDebouncer } from '@tanstack/react-pacer'\nimport { debouncerOptions } from '@tanstack/pacer'\n\nconst commonDebouncerOptions = debouncerOptions({\n  wait: 1000,\n  leading: false,\n  trailing: true,\n})\n\nconst debouncer = useDebouncer(\n  (query: string) => fetchSearchResults(query),\n  { ...commonDebouncerOptions, key: 'searchDebouncer' }\n)","lang":"tsx"},{"type":"heading","depth":3,"id":"async-queuer-options","children":[{"type":"text","value":"Async queuer options"}]},{"type":"code","value":"import { useAsyncQueuer } from '@tanstack/react-pacer'\nimport { asyncQueuerOptions } from '@tanstack/pacer'\n\nconst commonAsyncQueuerOptions = asyncQueuerOptions({\n  concurrency: 3,\n  addItemsTo: 'back',\n})\n\nconst queuer = useAsyncQueuer(\n  async (item: string) => processItem(item),\n  { ...commonAsyncQueuerOptions, key: 'itemQueuer' }\n)","lang":"tsx"},{"type":"heading","depth":3,"id":"rate-limiter-options","children":[{"type":"text","value":"Rate limiter options"}]},{"type":"code","value":"import { useRateLimiter } from '@tanstack/react-pacer'\nimport { rateLimiterOptions } from '@tanstack/pacer'\n\nconst commonRateLimiterOptions = rateLimiterOptions({\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\nconst rateLimiter = useRateLimiter(\n  (data: string) => sendApiRequest(data),\n  { ...commonRateLimiterOptions, key: 'apiRateLimiter' }\n)","lang":"tsx"},{"type":"heading","depth":2,"id":"provider","children":[{"type":"text","value":"Provider"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"PacerProvider"},{"type":"text","value":" component sets default options for every Pacer utility instance in its component tree."}]},{"type":"code","value":"import { PacerProvider } from '@tanstack/react-pacer'\n\n// Set default options for react-pacer instances\n<PacerProvider\n  defaultOptions={{\n    debouncer: { wait: 1000 },\n    asyncQueuer: { concurrency: 3 },\n    rateLimiter: { limit: 5, window: 60000 },\n  }}\n>\n  <App />\n</PacerProvider>","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Hooks inside the provider use these defaults. Options passed to an individual hook override them."}]},{"type":"heading","depth":2,"id":"subscribing-to-state","children":[{"type":"text","value":"Subscribing to state"}]},{"type":"paragraph","children":[{"type":"text","value":"The React adapter supports subscribing to state changes in two ways:"}]},{"type":"heading","depth":3,"id":"using-the-subscribe-component","children":[{"type":"text","value":"Using the Subscribe component"}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component to read state deep in the component tree without passing a selector to the hook."}]},{"type":"code","value":"import { useRateLimiter } from '@tanstack/react-pacer'\n\nfunction ApiComponent() {\n  const rateLimiter = useRateLimiter(\n    (data: string) => {\n      return fetch('/api/endpoint', {\n        method: 'POST',\n        body: JSON.stringify({ data }),\n      })\n    },\n    { limit: 5, window: 60000 }\n  )\n\n  return (\n    <div>\n      <button onClick={() => rateLimiter.maybeExecute('some data')}>\n        Submit\n      </button>\n      \n      <rateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount })}>\n        {({ rejectionCount }) => (\n          <div>Rejections: {rejectionCount}</div>\n        )}\n      </rateLimiter.Subscribe>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"using-the-selector-parameter","children":[{"type":"text","value":"Using the selector parameter"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter controls which state changes trigger reactive updates. State you do not select never causes an update."}]},{"type":"paragraph","children":[{"type":"text","value":"Without a selector, "},{"type":"inlineCode","value":"hook.state"},{"type":"text","value":" is an empty object ("},{"type":"inlineCode","value":"{}"},{"type":"text","value":"). Pass a selector function to opt in to state tracking."}]},{"type":"code","value":"import { useDebouncer } from '@tanstack/react-pacer'\n\nfunction SearchComponent() {\n  // Default behavior - no reactive state subscriptions\n  const untrackedDebouncer = useDebouncer(\n    (query: string) => fetchSearchResults(query),\n    { wait: 500 }\n  )\n  console.log(untrackedDebouncer.state) // {}\n\n  // Opt-in to track isPending changes\n  const debouncer = useDebouncer(\n    (query: string) => fetchSearchResults(query),\n    { wait: 500 },\n    (state) => ({ isPending: state.isPending })\n  )\n  console.log(debouncer.state.isPending) // Reactive value\n\n  return (\n    <input\n      onChange={(e) => debouncer.maybeExecute(e.target.value)}\n      placeholder=\"Search...\"\n    />\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"For more details on state management and available state properties, see the individual guide pages for each utility (e.g., "},{"type":"link","href":"./guides/rate-limiting.md","children":[{"type":"text","value":"Rate Limiting Guide"}]},{"type":"text","value":", "},{"type":"link","href":"./guides/debouncing.md","children":[{"type":"text","value":"Debouncing Guide"}]},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"heading","depth":3,"id":"debouncer-example","children":[{"type":"text","value":"Debouncer example"}]},{"type":"code","value":"import { useDebouncer } from '@tanstack/react-pacer'\n\nfunction SearchComponent() {\n  const debouncer = useDebouncer(\n    (query: string) => {\n      console.log('Searching for:', query)\n      // Perform search\n    },\n    { wait: 500 }\n  )\n\n  return (\n    <input\n      onChange={(e) => debouncer.maybeExecute(e.target.value)}\n      placeholder=\"Search...\"\n    />\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"async-queuer-example","children":[{"type":"text","value":"Async queuer example"}]},{"type":"code","value":"import { useAsyncQueuer } from '@tanstack/react-pacer'\n\nfunction UploadComponent() {\n  const queuer = useAsyncQueuer(\n    async (file: File) => {\n      await uploadFile(file)\n    },\n    { concurrency: 3 }\n  )\n\n  const handleFileSelect = (files: FileList) => {\n    Array.from(files).forEach((file) => {\n      queuer.addItem(file)\n    })\n  }\n\n  return (\n    <input\n      type=\"file\"\n      multiple\n      onChange={(e) => {\n        if (e.target.files) {\n          handleFileSelect(e.target.files)\n        }\n      }}\n    />\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"rate-limiter-example","children":[{"type":"text","value":"Rate limiter example"}]},{"type":"code","value":"import { useRateLimiter } from '@tanstack/react-pacer'\n\nfunction ApiComponent() {\n  const rateLimiter = useRateLimiter(\n    (data: string) => {\n      return fetch('/api/endpoint', {\n        method: 'POST',\n        body: JSON.stringify({ data }),\n      })\n    },\n    {\n      limit: 5,\n      window: 60000,\n      windowType: 'sliding',\n      onReject: () => {\n        alert('Rate limit reached. Please try again later.')\n      },\n    }\n  )\n\n  const handleSubmit = () => {\n    const remaining = rateLimiter.getRemainingInWindow()\n    if (remaining > 0) {\n      rateLimiter.maybeExecute('some data')\n    }\n  }\n\n  return <button onClick={handleSubmit}>Submit</button>\n}","lang":"tsx"}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"react-hooks","text":"React hooks","level":2},{"id":"basic-usage","text":"Basic usage","level":2},{"id":"option-helpers","text":"Option helpers","level":2},{"id":"debouncer-options","text":"Debouncer options","level":3},{"id":"async-queuer-options","text":"Async queuer options","level":3},{"id":"rate-limiter-options","text":"Rate limiter options","level":3},{"id":"provider","text":"Provider","level":2},{"id":"subscribing-to-state","text":"Subscribing to state","level":2},{"id":"using-the-subscribe-component","text":"Using the Subscribe component","level":3},{"id":"using-the-selector-parameter","text":"Using the selector parameter","level":3},{"id":"examples","text":"Examples","level":2},{"id":"debouncer-example","text":"Debouncer example","level":3},{"id":"async-queuer-example","text":"Async queuer example","level":3},{"id":"rate-limiter-example","text":"Rate limiter example","level":3}]},"frameworks":[],"downloadMarkdown":"\nIn a React application, use the React Adapter. Its hooks wrap the core Pacer utilities with lifecycle cleanup and reactive state. The adapter also re-exports everything from the core package, so you can import the plain classes and functions from the same place.\n\n## Installation\n\n```sh\nnpm install @tanstack/react-pacer\n```\n\n## React hooks\n\nSee the [React Functions Reference](./reference/index.md) for the full list of hooks in the React Adapter.\n\n## Basic usage\n\nImport a React-specific hook from the React Adapter.\n\n```tsx\nimport { useDebouncedValue } from '@tanstack/react-pacer'\n\nconst [instantValue, instantValueRef] = useState(0)\nconst [debouncedValue, debouncer] = useDebouncedValue(instantValue, {\n  wait: 1000,\n})\n```\n\nOr import a core Pacer class/function that is re-exported from the React Adapter.\n\n```tsx\nimport { debounce, Debouncer } from '@tanstack/react-pacer' // no need to install the core package separately\n```\n\n## Option helpers\n\nOption helpers define shared options with full type checking, so you can declare them once and reuse them across hooks.\n\n### Debouncer options\n\n```tsx\nimport { useDebouncer } from '@tanstack/react-pacer'\nimport { debouncerOptions } from '@tanstack/pacer'\n\nconst commonDebouncerOptions = debouncerOptions({\n  wait: 1000,\n  leading: false,\n  trailing: true,\n})\n\nconst debouncer = useDebouncer(\n  (query: string) => fetchSearchResults(query),\n  { ...commonDebouncerOptions, key: 'searchDebouncer' }\n)\n```\n\n### Async queuer options\n\n```tsx\nimport { useAsyncQueuer } from '@tanstack/react-pacer'\nimport { asyncQueuerOptions } from '@tanstack/pacer'\n\nconst commonAsyncQueuerOptions = asyncQueuerOptions({\n  concurrency: 3,\n  addItemsTo: 'back',\n})\n\nconst queuer = useAsyncQueuer(\n  async (item: string) => processItem(item),\n  { ...commonAsyncQueuerOptions, key: 'itemQueuer' }\n)\n```\n\n### Rate limiter options\n\n```tsx\nimport { useRateLimiter } from '@tanstack/react-pacer'\nimport { rateLimiterOptions } from '@tanstack/pacer'\n\nconst commonRateLimiterOptions = rateLimiterOptions({\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\nconst rateLimiter = useRateLimiter(\n  (data: string) => sendApiRequest(data),\n  { ...commonRateLimiterOptions, key: 'apiRateLimiter' }\n)\n```\n\n## Provider\n\nThe `PacerProvider` component sets default options for every Pacer utility instance in its component tree.\n\n```tsx\nimport { PacerProvider } from '@tanstack/react-pacer'\n\n// Set default options for react-pacer instances\n<PacerProvider\n  defaultOptions={{\n    debouncer: { wait: 1000 },\n    asyncQueuer: { concurrency: 3 },\n    rateLimiter: { limit: 5, window: 60000 },\n  }}\n>\n  <App />\n</PacerProvider>\n```\n\nHooks inside the provider use these defaults. Options passed to an individual hook override them.\n\n## Subscribing to state\n\nThe React adapter supports subscribing to state changes in two ways:\n\n### Using the Subscribe component\n\nUse the `Subscribe` component to read state deep in the component tree without passing a selector to the hook.\n\n```tsx\nimport { useRateLimiter } from '@tanstack/react-pacer'\n\nfunction ApiComponent() {\n  const rateLimiter = useRateLimiter(\n    (data: string) => {\n      return fetch('/api/endpoint', {\n        method: 'POST',\n        body: JSON.stringify({ data }),\n      })\n    },\n    { limit: 5, window: 60000 }\n  )\n\n  return (\n    <div>\n      <button onClick={() => rateLimiter.maybeExecute('some data')}>\n        Submit\n      </button>\n      \n      <rateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount })}>\n        {({ rejectionCount }) => (\n          <div>Rejections: {rejectionCount}</div>\n        )}\n      </rateLimiter.Subscribe>\n    </div>\n  )\n}\n```\n\n### Using the selector parameter\n\nThe `selector` parameter controls which state changes trigger reactive updates. State you do not select never causes an update.\n\nWithout a selector, `hook.state` is an empty object (`{}`). Pass a selector function to opt in to state tracking.\n\n```tsx\nimport { useDebouncer } from '@tanstack/react-pacer'\n\nfunction SearchComponent() {\n  // Default behavior - no reactive state subscriptions\n  const untrackedDebouncer = useDebouncer(\n    (query: string) => fetchSearchResults(query),\n    { wait: 500 }\n  )\n  console.log(untrackedDebouncer.state) // {}\n\n  // Opt-in to track isPending changes\n  const debouncer = useDebouncer(\n    (query: string) => fetchSearchResults(query),\n    { wait: 500 },\n    (state) => ({ isPending: state.isPending })\n  )\n  console.log(debouncer.state.isPending) // Reactive value\n\n  return (\n    <input\n      onChange={(e) => debouncer.maybeExecute(e.target.value)}\n      placeholder=\"Search...\"\n    />\n  )\n}\n```\n\nFor more details on state management and available state properties, see the individual guide pages for each utility (e.g., [Rate Limiting Guide](./guides/rate-limiting.md), [Debouncing Guide](./guides/debouncing.md)).\n\n## Examples\n\n### Debouncer example\n\n```tsx\nimport { useDebouncer } from '@tanstack/react-pacer'\n\nfunction SearchComponent() {\n  const debouncer = useDebouncer(\n    (query: string) => {\n      console.log('Searching for:', query)\n      // Perform search\n    },\n    { wait: 500 }\n  )\n\n  return (\n    <input\n      onChange={(e) => debouncer.maybeExecute(e.target.value)}\n      placeholder=\"Search...\"\n    />\n  )\n}\n```\n\n### Async queuer example\n\n```tsx\nimport { useAsyncQueuer } from '@tanstack/react-pacer'\n\nfunction UploadComponent() {\n  const queuer = useAsyncQueuer(\n    async (file: File) => {\n      await uploadFile(file)\n    },\n    { concurrency: 3 }\n  )\n\n  const handleFileSelect = (files: FileList) => {\n    Array.from(files).forEach((file) => {\n      queuer.addItem(file)\n    })\n  }\n\n  return (\n    <input\n      type=\"file\"\n      multiple\n      onChange={(e) => {\n        if (e.target.files) {\n          handleFileSelect(e.target.files)\n        }\n      }}\n    />\n  )\n}\n```\n\n### Rate limiter example\n\n```tsx\nimport { useRateLimiter } from '@tanstack/react-pacer'\n\nfunction ApiComponent() {\n  const rateLimiter = useRateLimiter(\n    (data: string) => {\n      return fetch('/api/endpoint', {\n        method: 'POST',\n        body: JSON.stringify({ data }),\n      })\n    },\n    {\n      limit: 5,\n      window: 60000,\n      windowType: 'sliding',\n      onReject: () => {\n        alert('Rate limit reached. Please try again later.')\n      },\n    }\n  )\n\n  const handleSubmit = () => {\n    const remaining = rateLimiter.getRemainingInWindow()\n    if (remaining > 0) {\n      rateLimiter.maybeExecute('some data')\n    }\n  }\n\n  return <button onClick={handleSubmit}>Submit</button>\n}\n```\n","originalRawMarkdown":"---\ntitle: TanStack Pacer React Adapter\nid: adapter\n---\n\nIn a React application, use the React Adapter. Its hooks wrap the core Pacer utilities with lifecycle cleanup and reactive state. The adapter also re-exports everything from the core package, so you can import the plain classes and functions from the same place.\n\n## Installation\n\n```sh\nnpm install @tanstack/react-pacer\n```\n\n## React hooks\n\nSee the [React Functions Reference](./reference/index.md) for the full list of hooks in the React Adapter.\n\n## Basic usage\n\nImport a React-specific hook from the React Adapter.\n\n```tsx\nimport { useDebouncedValue } from '@tanstack/react-pacer'\n\nconst [instantValue, instantValueRef] = useState(0)\nconst [debouncedValue, debouncer] = useDebouncedValue(instantValue, {\n  wait: 1000,\n})\n```\n\nOr import a core Pacer class/function that is re-exported from the React Adapter.\n\n```tsx\nimport { debounce, Debouncer } from '@tanstack/react-pacer' // no need to install the core package separately\n```\n\n## Option helpers\n\nOption helpers define shared options with full type checking, so you can declare them once and reuse them across hooks.\n\n### Debouncer options\n\n```tsx\nimport { useDebouncer } from '@tanstack/react-pacer'\nimport { debouncerOptions } from '@tanstack/pacer'\n\nconst commonDebouncerOptions = debouncerOptions({\n  wait: 1000,\n  leading: false,\n  trailing: true,\n})\n\nconst debouncer = useDebouncer(\n  (query: string) => fetchSearchResults(query),\n  { ...commonDebouncerOptions, key: 'searchDebouncer' }\n)\n```\n\n### Async queuer options\n\n```tsx\nimport { useAsyncQueuer } from '@tanstack/react-pacer'\nimport { asyncQueuerOptions } from '@tanstack/pacer'\n\nconst commonAsyncQueuerOptions = asyncQueuerOptions({\n  concurrency: 3,\n  addItemsTo: 'back',\n})\n\nconst queuer = useAsyncQueuer(\n  async (item: string) => processItem(item),\n  { ...commonAsyncQueuerOptions, key: 'itemQueuer' }\n)\n```\n\n### Rate limiter options\n\n```tsx\nimport { useRateLimiter } from '@tanstack/react-pacer'\nimport { rateLimiterOptions } from '@tanstack/pacer'\n\nconst commonRateLimiterOptions = rateLimiterOptions({\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n})\n\nconst rateLimiter = useRateLimiter(\n  (data: string) => sendApiRequest(data),\n  { ...commonRateLimiterOptions, key: 'apiRateLimiter' }\n)\n```\n\n## Provider\n\nThe `PacerProvider` component sets default options for every Pacer utility instance in its component tree.\n\n```tsx\nimport { PacerProvider } from '@tanstack/react-pacer'\n\n// Set default options for react-pacer instances\n<PacerProvider\n  defaultOptions={{\n    debouncer: { wait: 1000 },\n    asyncQueuer: { concurrency: 3 },\n    rateLimiter: { limit: 5, window: 60000 },\n  }}\n>\n  <App />\n</PacerProvider>\n```\n\nHooks inside the provider use these defaults. Options passed to an individual hook override them.\n\n## Subscribing to state\n\nThe React adapter supports subscribing to state changes in two ways:\n\n### Using the Subscribe component\n\nUse the `Subscribe` component to read state deep in the component tree without passing a selector to the hook.\n\n```tsx\nimport { useRateLimiter } from '@tanstack/react-pacer'\n\nfunction ApiComponent() {\n  const rateLimiter = useRateLimiter(\n    (data: string) => {\n      return fetch('/api/endpoint', {\n        method: 'POST',\n        body: JSON.stringify({ data }),\n      })\n    },\n    { limit: 5, window: 60000 }\n  )\n\n  return (\n    <div>\n      <button onClick={() => rateLimiter.maybeExecute('some data')}>\n        Submit\n      </button>\n      \n      <rateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount })}>\n        {({ rejectionCount }) => (\n          <div>Rejections: {rejectionCount}</div>\n        )}\n      </rateLimiter.Subscribe>\n    </div>\n  )\n}\n```\n\n### Using the selector parameter\n\nThe `selector` parameter controls which state changes trigger reactive updates. State you do not select never causes an update.\n\nWithout a selector, `hook.state` is an empty object (`{}`). Pass a selector function to opt in to state tracking.\n\n```tsx\nimport { useDebouncer } from '@tanstack/react-pacer'\n\nfunction SearchComponent() {\n  // Default behavior - no reactive state subscriptions\n  const untrackedDebouncer = useDebouncer(\n    (query: string) => fetchSearchResults(query),\n    { wait: 500 }\n  )\n  console.log(untrackedDebouncer.state) // {}\n\n  // Opt-in to track isPending changes\n  const debouncer = useDebouncer(\n    (query: string) => fetchSearchResults(query),\n    { wait: 500 },\n    (state) => ({ isPending: state.isPending })\n  )\n  console.log(debouncer.state.isPending) // Reactive value\n\n  return (\n    <input\n      onChange={(e) => debouncer.maybeExecute(e.target.value)}\n      placeholder=\"Search...\"\n    />\n  )\n}\n```\n\nFor more details on state management and available state properties, see the individual guide pages for each utility (e.g., [Rate Limiting Guide](./guides/rate-limiting.md), [Debouncing Guide](./guides/debouncing.md)).\n\n## Examples\n\n### Debouncer example\n\n```tsx\nimport { useDebouncer } from '@tanstack/react-pacer'\n\nfunction SearchComponent() {\n  const debouncer = useDebouncer(\n    (query: string) => {\n      console.log('Searching for:', query)\n      // Perform search\n    },\n    { wait: 500 }\n  )\n\n  return (\n    <input\n      onChange={(e) => debouncer.maybeExecute(e.target.value)}\n      placeholder=\"Search...\"\n    />\n  )\n}\n```\n\n### Async queuer example\n\n```tsx\nimport { useAsyncQueuer } from '@tanstack/react-pacer'\n\nfunction UploadComponent() {\n  const queuer = useAsyncQueuer(\n    async (file: File) => {\n      await uploadFile(file)\n    },\n    { concurrency: 3 }\n  )\n\n  const handleFileSelect = (files: FileList) => {\n    Array.from(files).forEach((file) => {\n      queuer.addItem(file)\n    })\n  }\n\n  return (\n    <input\n      type=\"file\"\n      multiple\n      onChange={(e) => {\n        if (e.target.files) {\n          handleFileSelect(e.target.files)\n        }\n      }}\n    />\n  )\n}\n```\n\n### Rate limiter example\n\n```tsx\nimport { useRateLimiter } from '@tanstack/react-pacer'\n\nfunction ApiComponent() {\n  const rateLimiter = useRateLimiter(\n    (data: string) => {\n      return fetch('/api/endpoint', {\n        method: 'POST',\n        body: JSON.stringify({ data }),\n      })\n    },\n    {\n      limit: 5,\n      window: 60000,\n      windowType: 'sliding',\n      onReject: () => {\n        alert('Rate limit reached. Please try again later.')\n      },\n    }\n  )\n\n  const handleSubmit = () => {\n    const remaining = rateLimiter.getRemainingInWindow()\n    if (remaining > 0) {\n      rateLimiter.maybeExecute('some data')\n    }\n  }\n\n  return <button onClick={handleSubmit}>Submit</button>\n}\n```\n"}
