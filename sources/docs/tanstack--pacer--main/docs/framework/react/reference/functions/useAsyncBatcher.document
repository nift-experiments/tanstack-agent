"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Event callbacks for monitoring batch operations"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Error handling for failed batch operations"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Automatic or manual batch processing"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The batcher collects items and processes them in batches based on:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Maximum batch size (number of items per batch)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Time-based batching (process after X milliseconds)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Custom batch processing logic via getShouldExecute"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is provided, it will be called with the error and batcher instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together - the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncBatcher instance"}]}]}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"1. Using "},{"type":"inlineCode","value":"batcher.Subscribe"},{"type":"text","value":" HOC (Recommended for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"errorCount"},{"type":"text","value":": Number of batch executions that have resulted in errors"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"failedItems"},{"type":"text","value":": Array of items that failed during batch processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isEmpty"},{"type":"text","value":": Whether the batcher has no items to process"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isExecuting"},{"type":"text","value":": Whether a batch is currently being processed asynchronously"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the batcher is waiting for the timeout to trigger batch processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"items"},{"type":"text","value":": Array of items currently queued for batch processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent batch execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of batch executions that have completed (success or error)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"size"},{"type":"text","value":": Number of items currently in the batch queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current processing status ('idle' | 'pending' | 'executing' | 'populated')"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of batch executions that have completed successfully"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"totalItemsProcessed"},{"type":"text","value":": Total number of items processed across all batches"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"totalItemsFailed"},{"type":"text","value":": Total number of items that have failed processing"}]}]}]},{"type":"heading","depth":2,"id":"unmount-behavior","children":[{"type":"text","value":"Unmount behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the hook cancels any pending batch and aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from "},{"type":"inlineCode","value":"getAbortSignal()"},{"type":"text","value":" is passed to them.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this. For example, to flush pending work instead:"}]},{"type":"code","value":"const batcher = useAsyncBatcher(fn, {\n  maxSize: 10,\n  wait: 2000,\n  onUnmount: (b) => b.flush()\n});","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Note: For async utils, "},{"type":"inlineCode","value":"flush()"},{"type":"text","value":" returns a Promise and runs fire-and-forget in the cleanup.\nIf your batch function updates React state, those updates may run after the component has\nunmounted, which can cause \"setState on unmounted component\" warnings. Guard your callbacks\naccordingly when using onUnmount with flush."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"items"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ReactAsyncBatcherOptions.md","children":[{"type":"inlineCode","value":"ReactAsyncBatcherOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":"> = "},{"type":"inlineCode","value":"{}"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ReactAsyncBatcher.md","children":[{"type":"inlineCode","value":"ReactAsyncBatcher"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Basic async batcher for API requests - no reactive state subscriptions\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 }\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<asyncBatcher.Subscribe selector={(state) => ({ size: state.size, isExecuting: state.isExecuting })}>\n  {({ size, isExecuting }) => (\n    <div>Batch: {size} items, {isExecuting ? 'Processing' : 'Ready'}</div>\n  )}\n</asyncBatcher.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({\n    isExecuting: state.isExecuting,\n    isPending: state.isPending,\n    status: state.status\n  })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount,\n    totalItemsProcessed: state.totalItemsProcessed\n  })\n);\n\n// Opt-in to re-render when error state changes (optimized for error handling)\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  {\n    maxSize: 10,\n    wait: 2000,\n    onError: (error) => console.error('Batch processing failed:', error)\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    failedItems: state.failedItems,\n    totalItemsFailed: state.totalItemsFailed\n  })\n);\n\n// Complete example with all callbacks\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  {\n    maxSize: 10,\n    wait: 2000,\n    onSuccess: (result) => {\n      console.log('Batch processed successfully:', result);\n    },\n    onError: (error) => {\n      console.error('Batch processing failed:', error);\n    }\n  }\n);\n\n// Add items to batch\nasyncBatcher.addItem(newItem);\n\n// Manually execute batch\nconst result = await asyncBatcher.execute();\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult, size } = asyncBatcher.state;","lang":"tsx"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"unmount-behavior","text":"Unmount behavior","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useAsyncBatcher<TValue, TSelected>(\n   fn,\n   options?,\nselector?): ReactAsyncBatcher<TValue, TSelected>;\n```\n\nDefined in: [async-batcher/useAsyncBatcher.ts:234](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-batcher/useAsyncBatcher.ts#L234)\n\nA React hook that creates an `AsyncBatcher` instance for managing asynchronous batches of items.\n\nThis is the async version of the useBatcher hook. Unlike the sync version, this async batcher:\n- Handles promises and returns results from batch executions\n- Provides error handling with configurable error behavior\n- Tracks success, error, and settle counts separately\n- Has state tracking for when batches are executing\n- Returns the result of the batch function execution\n\nFeatures:\n- Configurable batch size and wait time\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n- Error handling for failed batch operations\n- Automatic or manual batch processing\n\nThe batcher collects items and processes them in batches based on:\n- Maximum batch size (number of items per batch)\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and batcher instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncBatcher instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `batcher.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `errorCount`: Number of batch executions that have resulted in errors\n- `failedItems`: Array of items that failed during batch processing\n- `isEmpty`: Whether the batcher has no items to process\n- `isExecuting`: Whether a batch is currently being processed asynchronously\n- `isPending`: Whether the batcher is waiting for the timeout to trigger batch processing\n- `items`: Array of items currently queued for batch processing\n- `lastResult`: The result from the most recent batch execution\n- `settleCount`: Number of batch executions that have completed (success or error)\n- `size`: Number of items currently in the batch queue\n- `status`: Current processing status ('idle' | 'pending' | 'executing' | 'populated')\n- `successCount`: Number of batch executions that have completed successfully\n- `totalItemsProcessed`: Total number of items processed across all batches\n- `totalItemsFailed`: Total number of items that have failed processing\n\n## Unmount behavior\n\nBy default, the hook cancels any pending batch and aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst batcher = useAsyncBatcher(fn, {\n  maxSize: 10,\n  wait: 2000,\n  onUnmount: (b) => b.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your batch function updates React state, those updates may run after the component has\nunmounted, which can cause \"setState on unmounted component\" warnings. Guard your callbacks\naccordingly when using onUnmount with flush.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n### options?\n\n[`ReactAsyncBatcherOptions`](../interfaces/ReactAsyncBatcherOptions.md)\\<`TValue`, `TSelected`\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`ReactAsyncBatcher`](../interfaces/ReactAsyncBatcher.md)\\<`TValue`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Basic async batcher for API requests - no reactive state subscriptions\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 }\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<asyncBatcher.Subscribe selector={(state) => ({ size: state.size, isExecuting: state.isExecuting })}>\n  {({ size, isExecuting }) => (\n    <div>Batch: {size} items, {isExecuting ? 'Processing' : 'Ready'}</div>\n  )}\n</asyncBatcher.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({\n    isExecuting: state.isExecuting,\n    isPending: state.isPending,\n    status: state.status\n  })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount,\n    totalItemsProcessed: state.totalItemsProcessed\n  })\n);\n\n// Opt-in to re-render when error state changes (optimized for error handling)\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  {\n    maxSize: 10,\n    wait: 2000,\n    onError: (error) => console.error('Batch processing failed:', error)\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    failedItems: state.failedItems,\n    totalItemsFailed: state.totalItemsFailed\n  })\n);\n\n// Complete example with all callbacks\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  {\n    maxSize: 10,\n    wait: 2000,\n    onSuccess: (result) => {\n      console.log('Batch processed successfully:', result);\n    },\n    onError: (error) => {\n      console.error('Batch processing failed:', error);\n    }\n  }\n);\n\n// Add items to batch\nasyncBatcher.addItem(newItem);\n\n// Manually execute batch\nconst result = await asyncBatcher.execute();\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult, size } = asyncBatcher.state;\n```\n","originalRawMarkdown":"---\nid: useAsyncBatcher\ntitle: useAsyncBatcher\n---\n\n```ts\nfunction useAsyncBatcher<TValue, TSelected>(\n   fn,\n   options?,\nselector?): ReactAsyncBatcher<TValue, TSelected>;\n```\n\nDefined in: [async-batcher/useAsyncBatcher.ts:234](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-batcher/useAsyncBatcher.ts#L234)\n\nA React hook that creates an `AsyncBatcher` instance for managing asynchronous batches of items.\n\nThis is the async version of the useBatcher hook. Unlike the sync version, this async batcher:\n- Handles promises and returns results from batch executions\n- Provides error handling with configurable error behavior\n- Tracks success, error, and settle counts separately\n- Has state tracking for when batches are executing\n- Returns the result of the batch function execution\n\nFeatures:\n- Configurable batch size and wait time\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n- Error handling for failed batch operations\n- Automatic or manual batch processing\n\nThe batcher collects items and processes them in batches based on:\n- Maximum batch size (number of items per batch)\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and batcher instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncBatcher instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `batcher.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `errorCount`: Number of batch executions that have resulted in errors\n- `failedItems`: Array of items that failed during batch processing\n- `isEmpty`: Whether the batcher has no items to process\n- `isExecuting`: Whether a batch is currently being processed asynchronously\n- `isPending`: Whether the batcher is waiting for the timeout to trigger batch processing\n- `items`: Array of items currently queued for batch processing\n- `lastResult`: The result from the most recent batch execution\n- `settleCount`: Number of batch executions that have completed (success or error)\n- `size`: Number of items currently in the batch queue\n- `status`: Current processing status ('idle' | 'pending' | 'executing' | 'populated')\n- `successCount`: Number of batch executions that have completed successfully\n- `totalItemsProcessed`: Total number of items processed across all batches\n- `totalItemsFailed`: Total number of items that have failed processing\n\n## Unmount behavior\n\nBy default, the hook cancels any pending batch and aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst batcher = useAsyncBatcher(fn, {\n  maxSize: 10,\n  wait: 2000,\n  onUnmount: (b) => b.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your batch function updates React state, those updates may run after the component has\nunmounted, which can cause \"setState on unmounted component\" warnings. Guard your callbacks\naccordingly when using onUnmount with flush.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n### options?\n\n[`ReactAsyncBatcherOptions`](../interfaces/ReactAsyncBatcherOptions.md)\\<`TValue`, `TSelected`\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`ReactAsyncBatcher`](../interfaces/ReactAsyncBatcher.md)\\<`TValue`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Basic async batcher for API requests - no reactive state subscriptions\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 }\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<asyncBatcher.Subscribe selector={(state) => ({ size: state.size, isExecuting: state.isExecuting })}>\n  {({ size, isExecuting }) => (\n    <div>Batch: {size} items, {isExecuting ? 'Processing' : 'Ready'}</div>\n  )}\n</asyncBatcher.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({\n    isExecuting: state.isExecuting,\n    isPending: state.isPending,\n    status: state.status\n  })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount,\n    totalItemsProcessed: state.totalItemsProcessed\n  })\n);\n\n// Opt-in to re-render when error state changes (optimized for error handling)\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  {\n    maxSize: 10,\n    wait: 2000,\n    onError: (error) => console.error('Batch processing failed:', error)\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    failedItems: state.failedItems,\n    totalItemsFailed: state.totalItemsFailed\n  })\n);\n\n// Complete example with all callbacks\nconst asyncBatcher = useAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  {\n    maxSize: 10,\n    wait: 2000,\n    onSuccess: (result) => {\n      console.log('Batch processed successfully:', result);\n    },\n    onError: (error) => {\n      console.error('Batch processing failed:', error);\n    }\n  }\n);\n\n// Add items to batch\nasyncBatcher.addItem(newItem);\n\n// Manually execute batch\nconst result = await asyncBatcher.execute();\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult, size } = asyncBatcher.state;\n```\n"}
