{"document":{"type":"root","children":[{"type":"code","value":"function useAsyncDebouncer<TFn, TSelected>(\n   fn,\n   options,\nselector?): ReactAsyncDebouncer<TFn, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-debouncer/useAsyncDebouncer.ts#L214","children":[{"type":"text","value":"async-debouncer/useAsyncDebouncer.ts:214"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A low-level React hook that creates an "},{"type":"inlineCode","value":"AsyncDebouncer"},{"type":"text","value":" instance to delay execution of an async function."}]},{"type":"paragraph","children":[{"type":"text","value":"This hook is designed to be flexible and state-management agnostic - it simply returns a debouncer instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc)."}]},{"type":"paragraph","children":[{"type":"text","value":"Async debouncing ensures that an async function only executes after a specified delay has passed since its last invocation.\nEach new invocation resets the delay timer. This is useful for handling frequent events like window resizing\nor input changes where you only want to execute the handler after the events have stopped occurring."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike throttling which allows execution at regular intervals, debouncing prevents any execution until\nthe function stops being called for the specified delay period."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike the non-async Debouncer, this async version supports returning values from the debounced function,\nmaking it ideal for API calls and other async operations where you want the result of the "},{"type":"inlineCode","value":"maybeExecute"},{"type":"text","value":" call\ninstead of setting the result on a state variable from within the debounced function."}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is provided, it will be called with the error and debouncer instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together - the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncDebouncer instance"}]}]}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"1. Using "},{"type":"inlineCode","value":"debouncer.Subscribe"},{"type":"text","value":" HOC (Recommended for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"canLeadingExecute"},{"type":"text","value":": Whether the debouncer can execute on the leading edge"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"errorCount"},{"type":"text","value":": Number of function executions that have resulted in errors"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isExecuting"},{"type":"text","value":": Whether the debounced function is currently executing asynchronously"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the debouncer is waiting for the timeout to trigger execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent successful function execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of function executions that have completed (success or error)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status ('disabled' | 'idle' | 'pending' | 'executing' | 'settled')"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of function executions that have completed successfully"}]}]}]},{"type":"heading","depth":2,"id":"unmount-behavior","children":[{"type":"text","value":"Unmount behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the hook cancels any pending execution and aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from "},{"type":"inlineCode","value":"getAbortSignal()"},{"type":"text","value":" is passed to them.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this. For example, to flush pending work instead:"}]},{"type":"code","value":"const debouncer = useAsyncDebouncer(fn, {\n  wait: 500,\n  onUnmount: (d) => d.flush()\n});","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Note: For async utils, "},{"type":"inlineCode","value":"flush()"},{"type":"text","value":" returns a Promise and runs fire-and-forget in the cleanup.\nIf your debounced function updates React state, those updates may run after the component has\nunmounted, which can cause \"setState on unmounted component\" warnings. Guard your callbacks\naccordingly when using onUnmount with flush."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyAsyncFunction"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ReactAsyncDebouncerOptions.md","children":[{"type":"inlineCode","value":"ReactAsyncDebouncerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ReactAsyncDebouncer.md","children":[{"type":"inlineCode","value":"ReactAsyncDebouncer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  { wait: 500 }\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<searchDebouncer.Subscribe selector={(state) => ({ isExecuting: state.isExecuting, isPending: state.isPending })}>\n  {({ isExecuting, isPending }) => (\n    <div>{isExecuting || isPending ? 'Loading...' : 'Ready'}</div>\n  )}\n</searchDebouncer.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  { wait: 500 },\n  (state) => ({\n    isExecuting: state.isExecuting,\n    isPending: state.isPending\n  })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  { wait: 500 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount\n  })\n);\n\n// Opt-in to re-render when error state changes (optimized for error handling)\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  {\n    wait: 500,\n    onError: (error) => console.error('Search failed:', error)\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    status: state.status\n  })\n);\n\n// With state management\nconst [results, setResults] = useState([]);\nconst { maybeExecute, state } = useAsyncDebouncer(\n  async (searchTerm) => {\n    const data = await searchAPI(searchTerm);\n    setResults(data);\n  },\n  {\n    wait: 300,\n    leading: true,   // Execute immediately on first call\n    trailing: false, // Skip trailing edge updates\n    onError: (error) => {\n      console.error('API call failed:', error);\n    }\n  }\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult } = state;","lang":"tsx"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"unmount-behavior","text":"Unmount behavior","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useAsyncDebouncer<TFn, TSelected>(\n   fn,\n   options,\nselector?): ReactAsyncDebouncer<TFn, TSelected>;\n```\n\nDefined in: [async-debouncer/useAsyncDebouncer.ts:214](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-debouncer/useAsyncDebouncer.ts#L214)\n\nA low-level React hook that creates an `AsyncDebouncer` instance to delay execution of an async function.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a debouncer instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc).\n\nAsync debouncing ensures that an async function only executes after a specified delay has passed since its last invocation.\nEach new invocation resets the delay timer. This is useful for handling frequent events like window resizing\nor input changes where you only want to execute the handler after the events have stopped occurring.\n\nUnlike throttling which allows execution at regular intervals, debouncing prevents any execution until\nthe function stops being called for the specified delay period.\n\nUnlike the non-async Debouncer, this async version supports returning values from the debounced function,\nmaking it ideal for API calls and other async operations where you want the result of the `maybeExecute` call\ninstead of setting the result on a state variable from within the debounced function.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and debouncer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncDebouncer instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `debouncer.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `canLeadingExecute`: Whether the debouncer can execute on the leading edge\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether the debounced function is currently executing asynchronously\n- `isPending`: Whether the debouncer is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastResult`: The result from the most recent successful function execution\n- `settleCount`: Number of function executions that have completed (success or error)\n- `status`: Current execution status ('disabled' | 'idle' | 'pending' | 'executing' | 'settled')\n- `successCount`: Number of function executions that have completed successfully\n\n## Unmount behavior\n\nBy default, the hook cancels any pending execution and aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst debouncer = useAsyncDebouncer(fn, {\n  wait: 500,\n  onUnmount: (d) => d.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your debounced function updates React state, those updates may run after the component has\nunmounted, which can cause \"setState on unmounted component\" warnings. Guard your callbacks\naccordingly when using onUnmount with flush.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`ReactAsyncDebouncerOptions`](../interfaces/ReactAsyncDebouncerOptions.md)\\<`TFn`, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`ReactAsyncDebouncer`](../interfaces/ReactAsyncDebouncer.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  { wait: 500 }\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<searchDebouncer.Subscribe selector={(state) => ({ isExecuting: state.isExecuting, isPending: state.isPending })}>\n  {({ isExecuting, isPending }) => (\n    <div>{isExecuting || isPending ? 'Loading...' : 'Ready'}</div>\n  )}\n</searchDebouncer.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  { wait: 500 },\n  (state) => ({\n    isExecuting: state.isExecuting,\n    isPending: state.isPending\n  })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  { wait: 500 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount\n  })\n);\n\n// Opt-in to re-render when error state changes (optimized for error handling)\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  {\n    wait: 500,\n    onError: (error) => console.error('Search failed:', error)\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    status: state.status\n  })\n);\n\n// With state management\nconst [results, setResults] = useState([]);\nconst { maybeExecute, state } = useAsyncDebouncer(\n  async (searchTerm) => {\n    const data = await searchAPI(searchTerm);\n    setResults(data);\n  },\n  {\n    wait: 300,\n    leading: true,   // Execute immediately on first call\n    trailing: false, // Skip trailing edge updates\n    onError: (error) => {\n      console.error('API call failed:', error);\n    }\n  }\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult } = state;\n```\n","originalRawMarkdown":"---\nid: useAsyncDebouncer\ntitle: useAsyncDebouncer\n---\n\n```ts\nfunction useAsyncDebouncer<TFn, TSelected>(\n   fn,\n   options,\nselector?): ReactAsyncDebouncer<TFn, TSelected>;\n```\n\nDefined in: [async-debouncer/useAsyncDebouncer.ts:214](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-debouncer/useAsyncDebouncer.ts#L214)\n\nA low-level React hook that creates an `AsyncDebouncer` instance to delay execution of an async function.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a debouncer instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc).\n\nAsync debouncing ensures that an async function only executes after a specified delay has passed since its last invocation.\nEach new invocation resets the delay timer. This is useful for handling frequent events like window resizing\nor input changes where you only want to execute the handler after the events have stopped occurring.\n\nUnlike throttling which allows execution at regular intervals, debouncing prevents any execution until\nthe function stops being called for the specified delay period.\n\nUnlike the non-async Debouncer, this async version supports returning values from the debounced function,\nmaking it ideal for API calls and other async operations where you want the result of the `maybeExecute` call\ninstead of setting the result on a state variable from within the debounced function.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and debouncer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncDebouncer instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `debouncer.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `canLeadingExecute`: Whether the debouncer can execute on the leading edge\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether the debounced function is currently executing asynchronously\n- `isPending`: Whether the debouncer is waiting for the timeout to trigger execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastResult`: The result from the most recent successful function execution\n- `settleCount`: Number of function executions that have completed (success or error)\n- `status`: Current execution status ('disabled' | 'idle' | 'pending' | 'executing' | 'settled')\n- `successCount`: Number of function executions that have completed successfully\n\n## Unmount behavior\n\nBy default, the hook cancels any pending execution and aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst debouncer = useAsyncDebouncer(fn, {\n  wait: 500,\n  onUnmount: (d) => d.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your debounced function updates React state, those updates may run after the component has\nunmounted, which can cause \"setState on unmounted component\" warnings. Guard your callbacks\naccordingly when using onUnmount with flush.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`ReactAsyncDebouncerOptions`](../interfaces/ReactAsyncDebouncerOptions.md)\\<`TFn`, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`ReactAsyncDebouncer`](../interfaces/ReactAsyncDebouncer.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  { wait: 500 }\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<searchDebouncer.Subscribe selector={(state) => ({ isExecuting: state.isExecuting, isPending: state.isPending })}>\n  {({ isExecuting, isPending }) => (\n    <div>{isExecuting || isPending ? 'Loading...' : 'Ready'}</div>\n  )}\n</searchDebouncer.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  { wait: 500 },\n  (state) => ({\n    isExecuting: state.isExecuting,\n    isPending: state.isPending\n  })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  { wait: 500 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount\n  })\n);\n\n// Opt-in to re-render when error state changes (optimized for error handling)\nconst searchDebouncer = useAsyncDebouncer(\n  async (query: string) => {\n    const results = await api.search(query);\n    return results;\n  },\n  {\n    wait: 500,\n    onError: (error) => console.error('Search failed:', error)\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    status: state.status\n  })\n);\n\n// With state management\nconst [results, setResults] = useState([]);\nconst { maybeExecute, state } = useAsyncDebouncer(\n  async (searchTerm) => {\n    const data = await searchAPI(searchTerm);\n    setResults(data);\n  },\n  {\n    wait: 300,\n    leading: true,   // Execute immediately on first call\n    trailing: false, // Skip trailing edge updates\n    onError: (error) => {\n      console.error('API call failed:', error);\n    }\n  }\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult } = state;\n```\n"}
