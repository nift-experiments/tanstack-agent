{"document":{"type":"root","children":[{"type":"code","value":"function useAsyncRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): ReactAsyncRateLimiter<TFn, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L231","children":[{"type":"text","value":"async-rate-limiter/useAsyncRateLimiter.ts:231"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A low-level React hook that creates an "},{"type":"inlineCode","value":"AsyncRateLimiter"},{"type":"text","value":" instance to limit how many times an async function can execute within a time window."}]},{"type":"paragraph","children":[{"type":"text","value":"This hook is designed to be flexible and state-management agnostic - it simply returns a rate limiter instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc)."}]},{"type":"paragraph","children":[{"type":"text","value":"Rate limiting allows an async function to execute up to a specified limit within a time window,\nthen blocks subsequent calls until the window passes. This is useful for respecting API rate limits,\nmanaging resource constraints, or controlling bursts of async operations."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike the non-async RateLimiter, this async version supports returning values from the rate-limited function,\nmaking it ideal for API calls and other async operations where you want the result of the "},{"type":"inlineCode","value":"maybeExecute"},{"type":"text","value":" call\ninstead of setting the result on a state variable from within the rate-limited function."}]},{"type":"paragraph","children":[{"type":"text","value":"The rate limiter supports two types of windows:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"'fixed': A strict window that resets after the window period. All executions within the window count\ntowards the limit, and the window resets completely after the period."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"'sliding': A rolling window that allows executions as old ones expire. This provides a more\nconsistent rate of execution over time."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is provided, it will be called with the error and rate limiter instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together - the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncRateLimiter instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Rate limit rejections (when limit is exceeded) are handled separately from execution errors via the "},{"type":"inlineCode","value":"onReject"},{"type":"text","value":" handler"}]}]}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"1. Using "},{"type":"inlineCode","value":"rateLimiter.Subscribe"},{"type":"text","value":" HOC (Recommended for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"errorCount"},{"type":"text","value":": Number of function executions that have resulted in errors"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionTimes"},{"type":"text","value":": Array of timestamps when executions occurred for rate limiting calculations"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isExecuting"},{"type":"text","value":": Whether the rate-limited function is currently executing asynchronously"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent successful function execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"rejectionCount"},{"type":"text","value":": Number of function executions that have been rejected due to rate limiting"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of function executions that have completed (success or error)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of function executions that have completed successfully"}]}]}]},{"type":"heading","depth":2,"id":"unmount-behavior","children":[{"type":"text","value":"Unmount behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the hook aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from "},{"type":"inlineCode","value":"getAbortSignal()"},{"type":"text","value":" is passed to them.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyAsyncFunction"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ReactAsyncRateLimiterOptions.md","children":[{"type":"inlineCode","value":"ReactAsyncRateLimiterOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ReactAsyncRateLimiter.md","children":[{"type":"inlineCode","value":"ReactAsyncRateLimiter"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data; // Return value is preserved\n  },\n  { limit: 5, window: 1000 } // 5 calls per second\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<asyncRateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount, isExecuting: state.isExecuting })}>\n  {({ rejectionCount, isExecuting }) => (\n    <div>Rejected: {rejectionCount}, {isExecuting ? 'Executing' : 'Idle'}</div>\n  )}\n</asyncRateLimiter.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ isExecuting: state.isExecuting })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount\n  })\n);\n\n// Opt-in to re-render when error/rejection state changes (optimized for error handling)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  {\n    limit: 5,\n    window: 1000,\n    onError: (error) => console.error('API call failed:', error),\n    onReject: (rateLimiter) => console.log('Rate limit exceeded')\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to re-render when execution metrics change (optimized for stats display)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    successCount: state.successCount,\n    errorCount: state.errorCount,\n    settleCount: state.settleCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to re-render when execution times change (optimized for window calculations)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ executionTimes: state.executionTimes })\n);\n\n// With state management and return value\nconst [data, setData] = useState(null);\nconst { maybeExecute, state } = useAsyncRateLimiter(\n  async (query) => {\n    const result = await searchAPI(query);\n    setData(result);\n    return result; // Return value can be used by the caller\n  },\n  {\n    limit: 10,\n    window: 60000, // 10 calls per minute\n    onReject: (rateLimiter) => {\n      console.log(`Rate limit exceeded. Try again in ${rateLimiter.getMsUntilNextWindow()}ms`);\n    },\n    onError: (error) => {\n      console.error('API call failed:', error);\n    }\n  }\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult, rejectionCount } = state;","lang":"tsx"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"unmount-behavior","text":"Unmount behavior","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useAsyncRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): ReactAsyncRateLimiter<TFn, TSelected>;\n```\n\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:231](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L231)\n\nA low-level React hook that creates an `AsyncRateLimiter` instance to limit how many times an async function can execute within a time window.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a rate limiter instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc).\n\nRate limiting allows an async function to execute up to a specified limit within a time window,\nthen blocks subsequent calls until the window passes. This is useful for respecting API rate limits,\nmanaging resource constraints, or controlling bursts of async operations.\n\nUnlike the non-async RateLimiter, this async version supports returning values from the rate-limited function,\nmaking it ideal for API calls and other async operations where you want the result of the `maybeExecute` call\ninstead of setting the result on a state variable from within the rate-limited function.\n\nThe rate limiter supports two types of windows:\n- 'fixed': A strict window that resets after the window period. All executions within the window count\n  towards the limit, and the window resets completely after the period.\n- 'sliding': A rolling window that allows executions as old ones expire. This provides a more\n  consistent rate of execution over time.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and rate limiter instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncRateLimiter instance\n- Rate limit rejections (when limit is exceeded) are handled separately from execution errors via the `onReject` handler\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `rateLimiter.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `errorCount`: Number of function executions that have resulted in errors\n- `executionTimes`: Array of timestamps when executions occurred for rate limiting calculations\n- `isExecuting`: Whether the rate-limited function is currently executing asynchronously\n- `lastResult`: The result from the most recent successful function execution\n- `rejectionCount`: Number of function executions that have been rejected due to rate limiting\n- `settleCount`: Number of function executions that have completed (success or error)\n- `successCount`: Number of function executions that have completed successfully\n\n## Unmount behavior\n\nBy default, the hook aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`ReactAsyncRateLimiterOptions`](../interfaces/ReactAsyncRateLimiterOptions.md)\\<`TFn`, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`ReactAsyncRateLimiter`](../interfaces/ReactAsyncRateLimiter.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data; // Return value is preserved\n  },\n  { limit: 5, window: 1000 } // 5 calls per second\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<asyncRateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount, isExecuting: state.isExecuting })}>\n  {({ rejectionCount, isExecuting }) => (\n    <div>Rejected: {rejectionCount}, {isExecuting ? 'Executing' : 'Idle'}</div>\n  )}\n</asyncRateLimiter.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ isExecuting: state.isExecuting })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount\n  })\n);\n\n// Opt-in to re-render when error/rejection state changes (optimized for error handling)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  {\n    limit: 5,\n    window: 1000,\n    onError: (error) => console.error('API call failed:', error),\n    onReject: (rateLimiter) => console.log('Rate limit exceeded')\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to re-render when execution metrics change (optimized for stats display)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    successCount: state.successCount,\n    errorCount: state.errorCount,\n    settleCount: state.settleCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to re-render when execution times change (optimized for window calculations)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ executionTimes: state.executionTimes })\n);\n\n// With state management and return value\nconst [data, setData] = useState(null);\nconst { maybeExecute, state } = useAsyncRateLimiter(\n  async (query) => {\n    const result = await searchAPI(query);\n    setData(result);\n    return result; // Return value can be used by the caller\n  },\n  {\n    limit: 10,\n    window: 60000, // 10 calls per minute\n    onReject: (rateLimiter) => {\n      console.log(`Rate limit exceeded. Try again in ${rateLimiter.getMsUntilNextWindow()}ms`);\n    },\n    onError: (error) => {\n      console.error('API call failed:', error);\n    }\n  }\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult, rejectionCount } = state;\n```\n","originalRawMarkdown":"---\nid: useAsyncRateLimiter\ntitle: useAsyncRateLimiter\n---\n\n```ts\nfunction useAsyncRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): ReactAsyncRateLimiter<TFn, TSelected>;\n```\n\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:231](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L231)\n\nA low-level React hook that creates an `AsyncRateLimiter` instance to limit how many times an async function can execute within a time window.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a rate limiter instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc).\n\nRate limiting allows an async function to execute up to a specified limit within a time window,\nthen blocks subsequent calls until the window passes. This is useful for respecting API rate limits,\nmanaging resource constraints, or controlling bursts of async operations.\n\nUnlike the non-async RateLimiter, this async version supports returning values from the rate-limited function,\nmaking it ideal for API calls and other async operations where you want the result of the `maybeExecute` call\ninstead of setting the result on a state variable from within the rate-limited function.\n\nThe rate limiter supports two types of windows:\n- 'fixed': A strict window that resets after the window period. All executions within the window count\n  towards the limit, and the window resets completely after the period.\n- 'sliding': A rolling window that allows executions as old ones expire. This provides a more\n  consistent rate of execution over time.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and rate limiter instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncRateLimiter instance\n- Rate limit rejections (when limit is exceeded) are handled separately from execution errors via the `onReject` handler\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `rateLimiter.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `errorCount`: Number of function executions that have resulted in errors\n- `executionTimes`: Array of timestamps when executions occurred for rate limiting calculations\n- `isExecuting`: Whether the rate-limited function is currently executing asynchronously\n- `lastResult`: The result from the most recent successful function execution\n- `rejectionCount`: Number of function executions that have been rejected due to rate limiting\n- `settleCount`: Number of function executions that have completed (success or error)\n- `successCount`: Number of function executions that have completed successfully\n\n## Unmount behavior\n\nBy default, the hook aborts any in-flight execution when the component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`ReactAsyncRateLimiterOptions`](../interfaces/ReactAsyncRateLimiterOptions.md)\\<`TFn`, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`ReactAsyncRateLimiter`](../interfaces/ReactAsyncRateLimiter.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data; // Return value is preserved\n  },\n  { limit: 5, window: 1000 } // 5 calls per second\n);\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<asyncRateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount, isExecuting: state.isExecuting })}>\n  {({ rejectionCount, isExecuting }) => (\n    <div>Rejected: {rejectionCount}, {isExecuting ? 'Executing' : 'Idle'}</div>\n  )}\n</asyncRateLimiter.Subscribe>\n\n// Opt-in to re-render when execution state changes at hook level (optimized for loading indicators)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ isExecuting: state.isExecuting })\n);\n\n// Opt-in to re-render when results are available (optimized for data display)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount\n  })\n);\n\n// Opt-in to re-render when error/rejection state changes (optimized for error handling)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  {\n    limit: 5,\n    window: 1000,\n    onError: (error) => console.error('API call failed:', error),\n    onReject: (rateLimiter) => console.log('Rate limit exceeded')\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to re-render when execution metrics change (optimized for stats display)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    successCount: state.successCount,\n    errorCount: state.errorCount,\n    settleCount: state.settleCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to re-render when execution times change (optimized for window calculations)\nconst asyncRateLimiter = useAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ executionTimes: state.executionTimes })\n);\n\n// With state management and return value\nconst [data, setData] = useState(null);\nconst { maybeExecute, state } = useAsyncRateLimiter(\n  async (query) => {\n    const result = await searchAPI(query);\n    setData(result);\n    return result; // Return value can be used by the caller\n  },\n  {\n    limit: 10,\n    window: 60000, // 10 calls per minute\n    onReject: (rateLimiter) => {\n      console.log(`Rate limit exceeded. Try again in ${rateLimiter.getMsUntilNextWindow()}ms`);\n    },\n    onError: (error) => {\n      console.error('API call failed:', error);\n    }\n  }\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult, rejectionCount } = state;\n```\n"}
