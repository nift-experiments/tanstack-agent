alue":"For smoother execution patterns:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use throttling when you want consistent spacing between executions (e.g. UI updates)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use debouncing when you want to collapse rapid-fire events (e.g. search input)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use rate limiting only when you need to enforce hard limits (e.g. API rate limits)"}]}]}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"1. Using "},{"type":"inlineCode","value":"rateLimiter.Subscribe"},{"type":"text","value":" HOC (Recommended for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Number of function executions that have been completed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionTimes"},{"type":"text","value":": Array of timestamps when executions occurred for rate limiting calculations"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"rejectionCount"},{"type":"text","value":": Number of function executions that have been rejected due to rate limiting"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The hook returns an object containing:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"maybeExecute: The rate-limited function that respects the configured limits"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"getExecutionCount: Returns the number of successful executions"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"getRejectionCount: Returns the number of rejected executions due to rate limiting"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"getRemainingInWindow: Returns how many more executions are allowed in the current window"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"reset: Resets the execution counts and window timing"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyFunction"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ReactRateLimiterOptions.md","children":[{"type":"inlineCode","value":"ReactRateLimiterOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ReactRateLimiter.md","children":[{"type":"inlineCode","value":"ReactRateLimiter"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst rateLimiter = useRateLimiter(apiCall, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n});\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<rateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount })}>\n  {({ rejectionCount }) => (\n    <div>Rejected: {rejectionCount} requests</div>\n  )}\n</rateLimiter.Subscribe>\n\n// Opt-in to re-render when execution count changes at hook level (optimized for tracking successful executions)\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({ executionCount: state.executionCount })\n);\n\n// Opt-in to re-render when rejection count changes (optimized for tracking rate limit violations)\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({ rejectionCount: state.rejectionCount })\n);\n\n// Opt-in to re-render when execution times change (optimized for window calculations)\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({ executionTimes: state.executionTimes })\n);\n\n// Multiple state properties - re-render when any of these change\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({\n    executionCount: state.executionCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Monitor rate limit status\nconst handleClick = () => {\n  const remaining = rateLimiter.getRemainingInWindow();\n  if (remaining > 0) {\n    rateLimiter.maybeExecute(data);\n  } else {\n    showRateLimitWarning();\n  }\n};\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { executionCount, rejectionCount } = rateLimiter.state;","lang":"tsx"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): ReactRateLimiter<TFn, TSelected>;\n```\n\nDefined in: [rate-limiter/useRateLimiter.ts:190](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/rate-limiter/useRateLimiter.ts#L190)\n\nA low-level React hook that creates a `RateLimiter` instance to enforce rate limits on function execution.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a rate limiter instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc).\n\nRate limiting is a simple \"hard limit\" approach that allows executions until a maximum count is reached within\na time window, then blocks all subsequent calls until the window resets. Unlike throttling or debouncing,\nit does not attempt to space out or collapse executions intelligently.\n\nThe rate limiter supports two types of windows:\n- 'fixed': A strict window that resets after the window period. All executions within the window count\n  towards the limit, and the window resets completely after the period.\n- 'sliding': A rolling window that allows executions as old ones expire. This provides a more\n  consistent rate of execution over time.\n\nFor smoother execution patterns:\n- Use throttling when you want consistent spacing between executions (e.g. UI updates)\n- Use debouncing when you want to collapse rapid-fire events (e.g. search input)\n- Use rate limiting only when you need to enforce hard limits (e.g. API rate limits)\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `rateLimiter.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `executionCount`: Number of function executions that have been completed\n- `executionTimes`: Array of timestamps when executions occurred for rate limiting calculations\n- `rejectionCount`: Number of function executions that have been rejected due to rate limiting\n\nThe hook returns an object containing:\n- maybeExecute: The rate-limited function that respects the configured limits\n- getExecutionCount: Returns the number of successful executions\n- getRejectionCount: Returns the number of rejected executions due to rate limiting\n- getRemainingInWindow: Returns how many more executions are allowed in the current window\n- reset: Resets the execution counts and window timing\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`ReactRateLimiterOptions`](../interfaces/ReactRateLimiterOptions.md)\\<`TFn`, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`ReactRateLimiter`](../interfaces/ReactRateLimiter.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst rateLimiter = useRateLimiter(apiCall, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n});\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<rateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount })}>\n  {({ rejectionCount }) => (\n    <div>Rejected: {rejectionCount} requests</div>\n  )}\n</rateLimiter.Subscribe>\n\n// Opt-in to re-render when execution count changes at hook level (optimized for tracking successful executions)\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({ executionCount: state.executionCount })\n);\n\n// Opt-in to re-render when rejection count changes (optimized for tracking rate limit violations)\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({ rejectionCount: state.rejectionCount })\n);\n\n// Opt-in to re-render when execution times change (optimized for window calculations)\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({ executionTimes: state.executionTimes })\n);\n\n// Multiple state properties - re-render when any of these change\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({\n    executionCount: state.executionCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Monitor rate limit status\nconst handleClick = () => {\n  const remaining = rateLimiter.getRemainingInWindow();\n  if (remaining > 0) {\n    rateLimiter.maybeExecute(data);\n  } else {\n    showRateLimitWarning();\n  }\n};\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { executionCount, rejectionCount } = rateLimiter.state;\n```\n","originalRawMarkdown":"---\nid: useRateLimiter\ntitle: useRateLimiter\n---\n\n```ts\nfunction useRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): ReactRateLimiter<TFn, TSelected>;\n```\n\nDefined in: [rate-limiter/useRateLimiter.ts:190](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/rate-limiter/useRateLimiter.ts#L190)\n\nA low-level React hook that creates a `RateLimiter` instance to enforce rate limits on function execution.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a rate limiter instance that\nyou can integrate with any state management solution (useState, Redux, Zustand, Jotai, etc).\n\nRate limiting is a simple \"hard limit\" approach that allows executions until a maximum count is reached within\na time window, then blocks all subsequent calls until the window resets. Unlike throttling or debouncing,\nit does not attempt to space out or collapse executions intelligently.\n\nThe rate limiter supports two types of windows:\n- 'fixed': A strict window that resets after the window period. All executions within the window count\n  towards the limit, and the window resets completely after the period.\n- 'sliding': A rolling window that allows executions as old ones expire. This provides a more\n  consistent rate of execution over time.\n\nFor smoother execution patterns:\n- Use throttling when you want consistent spacing between executions (e.g. UI updates)\n- Use debouncing when you want to collapse rapid-fire events (e.g. search input)\n- Use rate limiting only when you need to enforce hard limits (e.g. API rate limits)\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `rateLimiter.Subscribe` HOC (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` HOC to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger a re-render\nat the hook level, optimizing performance by preventing unnecessary re-renders when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` HOC. This prevents unnecessary\nre-renders and gives you full control over when your component updates.\n\nAvailable state properties:\n- `executionCount`: Number of function executions that have been completed\n- `executionTimes`: Array of timestamps when executions occurred for rate limiting calculations\n- `rejectionCount`: Number of function executions that have been rejected due to rate limiting\n\nThe hook returns an object containing:\n- maybeExecute: The rate-limited function that respects the configured limits\n- getExecutionCount: Returns the number of successful executions\n- getRejectionCount: Returns the number of rejected executions due to rate limiting\n- getRemainingInWindow: Returns how many more executions are allowed in the current window\n- reset: Resets the execution counts and window timing\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`ReactRateLimiterOptions`](../interfaces/ReactRateLimiterOptions.md)\\<`TFn`, `TSelected`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`ReactRateLimiter`](../interfaces/ReactRateLimiter.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst rateLimiter = useRateLimiter(apiCall, {\n  limit: 5,\n  window: 60000,\n  windowType: 'sliding',\n});\n\n// Subscribe to state changes deep in component tree using Subscribe HOC\n<rateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount })}>\n  {({ rejectionCount }) => (\n    <div>Rejected: {rejectionCount} requests</div>\n  )}\n</rateLimiter.Subscribe>\n\n// Opt-in to re-render when execution count changes at hook level (optimized for tracking successful executions)\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({ executionCount: state.executionCount })\n);\n\n// Opt-in to re-render when rejection count changes (optimized for tracking rate limit violations)\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({ rejectionCount: state.rejectionCount })\n);\n\n// Opt-in to re-render when execution times change (optimized for window calculations)\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({ executionTimes: state.executionTimes })\n);\n\n// Multiple state properties - re-render when any of these change\nconst rateLimiter = useRateLimiter(\n  apiCall,\n  {\n    limit: 5,\n    window: 60000,\n    windowType: 'sliding',\n  },\n  (state) => ({\n    executionCount: state.executionCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Monitor rate limit status\nconst handleClick = () => {\n  const remaining = rateLimiter.getRemainingInWindow();\n  if (remaining > 0) {\n    rateLimiter.maybeExecute(data);\n  } else {\n    showRateLimitWarning();\n  }\n};\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { executionCount, rejectionCount } = rateLimiter.state;\n```\n"}
