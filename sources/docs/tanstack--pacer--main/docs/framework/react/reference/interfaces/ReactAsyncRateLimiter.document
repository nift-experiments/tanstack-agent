"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Reactive state that will be updated and re-rendered when the rate limiter state changes"}]},{"type":"paragraph","children":[{"type":"text","value":"Use this instead of "},{"type":"inlineCode","value":"rateLimiter.store.state"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"store","children":[{"type":"strike","children":[{"type":"text","value":"store"}]}]},{"type":"code","value":"readonly store: Store<Readonly<AsyncRateLimiterState<TFn>>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L56","children":[{"type":"text","value":"async-rate-limiter/useAsyncRateLimiter.ts:56"}]}]},{"type":"heading","depth":4,"id":"deprecated","children":[{"type":"text","value":"Deprecated"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"rateLimiter.state"},{"type":"text","value":" instead of "},{"type":"inlineCode","value":"rateLimiter.store.state"},{"type":"text","value":" if you want to read reactive state.\nThe state on the store object is not reactive, as it has not been wrapped in a "},{"type":"inlineCode","value":"useSelector"},{"type":"text","value":" hook internally.\nAlthough, you can make the state reactive by using the "},{"type":"inlineCode","value":"useSelector"},{"type":"text","value":" in your own usage."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"subscribe","children":[{"type":"text","value":"Subscribe"}]},{"type":"code","value":"Subscribe: <TSelected>(props) => ReactNode | Promise<ReactNode>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L41","children":[{"type":"text","value":"async-rate-limiter/useAsyncRateLimiter.ts:41"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A React HOC (Higher Order Component) that allows you to subscribe to the rate limiter state."}]},{"type":"paragraph","children":[{"type":"text","value":"This is useful for opting into state re-renders for specific parts of the rate limiter state\ndeep in your component tree without needing to pass a selector to the hook."}]},{"type":"heading","depth":4,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tselected-2","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"props","children":[{"type":"text","value":"props"}]},{"type":"heading","depth":6,"id":"children","children":[{"type":"text","value":"children"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactNode"},{"type":"text","value":" | (("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"ReactNode"},{"type":"text","value":")"}]},{"type":"heading","depth":6,"id":"selector","children":[{"type":"text","value":"selector"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactNode"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReactNode"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<rateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount, isExecuting: state.isExecuting })}>\n  {({ rejectionCount, isExecuting }) => (\n    <div>Rejected: {rejectionCount}, {isExecuting ? 'Executing' : 'Idle'}</div>\n  )}\n</rateLimiter.Subscribe>","lang":"ts"}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"properties","text":"Properties","level":2},{"id":"state","text":"state","level":3},{"id":"store","text":"store","level":3},{"id":"deprecated","text":"Deprecated","level":4},{"id":"subscribe","text":"Subscribe","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":4},{"id":"tselected-2","text":"TSelected","level":5},{"id":"parameters","text":"Parameters","level":4},{"id":"props","text":"props","level":5},{"id":"children","text":"children","level":6},{"id":"selector","text":"selector","level":6},{"id":"returns","text":"Returns","level":4},{"id":"example","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:24](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L24)\n\n## Extends\n\n- `Omit`\\<`AsyncRateLimiter`\\<`TFn`\\>, `\"store\"`\\>\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Properties\n\n### state\n\n```ts\nreadonly state: Readonly<TSelected>;\n```\n\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:50](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L50)\n\nReactive state that will be updated and re-rendered when the rate limiter state changes\n\nUse this instead of `rateLimiter.store.state`\n\n***\n\n### ~~store~~\n\n```ts\nreadonly store: Store<Readonly<AsyncRateLimiterState<TFn>>>;\n```\n\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:56](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L56)\n\n#### Deprecated\n\nUse `rateLimiter.state` instead of `rateLimiter.store.state` if you want to read reactive state.\nThe state on the store object is not reactive, as it has not been wrapped in a `useSelector` hook internally.\nAlthough, you can make the state reactive by using the `useSelector` in your own usage.\n\n***\n\n### Subscribe\n\n```ts\nSubscribe: <TSelected>(props) => ReactNode | Promise<ReactNode>;\n```\n\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:41](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L41)\n\nA React HOC (Higher Order Component) that allows you to subscribe to the rate limiter state.\n\nThis is useful for opting into state re-renders for specific parts of the rate limiter state\ndeep in your component tree without needing to pass a selector to the hook.\n\n#### Type Parameters\n\n##### TSelected\n\n`TSelected`\n\n#### Parameters\n\n##### props\n\n###### children\n\n`ReactNode` \\| ((`state`) => `ReactNode`)\n\n###### selector\n\n(`state`) => `TSelected`\n\n#### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n#### Example\n\n```ts\n<rateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount, isExecuting: state.isExecuting })}>\n  {({ rejectionCount, isExecuting }) => (\n    <div>Rejected: {rejectionCount}, {isExecuting ? 'Executing' : 'Idle'}</div>\n  )}\n</rateLimiter.Subscribe>\n```\n","originalRawMarkdown":"---\nid: ReactAsyncRateLimiter\ntitle: ReactAsyncRateLimiter\n---\n\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:24](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L24)\n\n## Extends\n\n- `Omit`\\<`AsyncRateLimiter`\\<`TFn`\\>, `\"store\"`\\>\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Properties\n\n### state\n\n```ts\nreadonly state: Readonly<TSelected>;\n```\n\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:50](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L50)\n\nReactive state that will be updated and re-rendered when the rate limiter state changes\n\nUse this instead of `rateLimiter.store.state`\n\n***\n\n### ~~store~~\n\n```ts\nreadonly store: Store<Readonly<AsyncRateLimiterState<TFn>>>;\n```\n\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:56](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L56)\n\n#### Deprecated\n\nUse `rateLimiter.state` instead of `rateLimiter.store.state` if you want to read reactive state.\nThe state on the store object is not reactive, as it has not been wrapped in a `useSelector` hook internally.\nAlthough, you can make the state reactive by using the `useSelector` in your own usage.\n\n***\n\n### Subscribe\n\n```ts\nSubscribe: <TSelected>(props) => ReactNode | Promise<ReactNode>;\n```\n\nDefined in: [async-rate-limiter/useAsyncRateLimiter.ts:41](https://github.com/TanStack/pacer/blob/main/packages/react-pacer/src/async-rate-limiter/useAsyncRateLimiter.ts#L41)\n\nA React HOC (Higher Order Component) that allows you to subscribe to the rate limiter state.\n\nThis is useful for opting into state re-renders for specific parts of the rate limiter state\ndeep in your component tree without needing to pass a selector to the hook.\n\n#### Type Parameters\n\n##### TSelected\n\n`TSelected`\n\n#### Parameters\n\n##### props\n\n###### children\n\n`ReactNode` \\| ((`state`) => `ReactNode`)\n\n###### selector\n\n(`state`) => `TSelected`\n\n#### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n#### Example\n\n```ts\n<rateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount, isExecuting: state.isExecuting })}>\n  {({ rejectionCount, isExecuting }) => (\n    <div>Rejected: {rejectionCount}, {isExecuting ? 'Executing' : 'Idle'}</div>\n  )}\n</rateLimiter.Subscribe>\n```\n"}
