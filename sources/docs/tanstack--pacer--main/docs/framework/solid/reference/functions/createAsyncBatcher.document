te"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Event callbacks for monitoring batch operations"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Error handling for failed batch operations"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Automatic or manual batch processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"All stateful properties (items, counts, etc.) are exposed as Solid signals for reactivity"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The batcher collects items and processes them in batches based on:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Maximum batch size (number of items per batch)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Time-based batching (process after X milliseconds)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Custom batch processing logic via getShouldExecute"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is provided, it will be called with the error and batcher instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together; the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncBatcher instance"}]}]}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"1. Using "},{"type":"inlineCode","value":"batcher.Subscribe"},{"type":"text","value":" component (Recommended for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"errorCount"},{"type":"text","value":": Number of failed batch executions"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Total number of batch execution attempts (successful + failed)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isExecuting"},{"type":"text","value":": Whether a batch execution is currently in progress"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"items"},{"type":"text","value":": Array of items currently queued for batching"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent successful batch execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of batch executions that have completed (successful or failed)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of successful batch executions"}]}]}]},{"type":"heading","depth":2,"id":"unmount-behavior","children":[{"type":"text","value":"Unmount behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the primitive cancels any pending batch and aborts any in-flight execution when the owning component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from "},{"type":"inlineCode","value":"getAbortSignal()"},{"type":"text","value":" is passed to them.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this. For example, to flush pending work instead:"}]},{"type":"code","value":"const batcher = createAsyncBatcher(fn, {\n  maxSize: 10,\n  wait: 2000,\n  onUnmount: (b) => b.flush()\n});","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Note: For async utils, "},{"type":"inlineCode","value":"flush()"},{"type":"text","value":" returns a Promise and runs fire-and-forget in the cleanup.\nIf your batch function updates Solid signals, those updates may run after the component has\nunmounted, which can cause unexpected reactive updates. Guard your callbacks accordingly when\nusing onUnmount with flush."}]},{"type":"paragraph","children":[{"type":"text","value":"Example usage:"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst asyncBatcher = createAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  {\n    maxSize: 10,\n    wait: 2000,\n    onSuccess: (result) => {\n      console.log('Batch processed successfully:', result);\n    },\n    onError: (error) => {\n      console.error('Batch processing failed:', error);\n    }\n  }\n);\n\n// Opt-in to track items or isExecuting changes (optimized for UI updates)\nconst asyncBatcher = createAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({ items: state.items, isExecuting: state.isExecuting })\n);\n\n// Opt-in to track error state changes (optimized for error handling)\nconst asyncBatcher = createAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({ errorCount: state.errorCount })\n);\n\n// Add items to batch\nasyncBatcher.addItem(newItem);\n\n// Manually execute batch\nconst result = await asyncBatcher.execute();\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, isExecuting } = asyncBatcher.state();","lang":"tsx"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"items"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/SolidPacerOptions.md","children":[{"type":"inlineCode","value":"SolidPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/SolidAsyncBatcherOptions.md","children":[{"type":"inlineCode","value":"SolidAsyncBatcherOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">> = "},{"type":"inlineCode","value":"{}"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/SolidAsyncBatcher.md","children":[{"type":"inlineCode","value":"SolidAsyncBatcher"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"unmount-behavior","text":"Unmount behavior","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createAsyncBatcher<TValue, TSelected>(\n   fn,\n   options?,\nselector?): SolidAsyncBatcher<TValue, TSelected>;\n```\n\nDefined in: [async-batcher/createAsyncBatcher.ts:195](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/async-batcher/createAsyncBatcher.ts#L195)\n\nCreates a Solid-compatible AsyncBatcher instance for managing asynchronous batches of items, exposing Solid signals for all stateful properties.\n\nThis is the async version of the createBatcher hook. Unlike the sync version, this async batcher:\n- Handles promises and returns results from batch executions\n- Provides error handling with configurable error behavior\n- Tracks success, error, and settle counts separately\n- Has state tracking for when batches are executing\n- Returns the result of the batch function execution\n\nFeatures:\n- Configurable batch size and wait time\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n- Error handling for failed batch operations\n- Automatic or manual batch processing\n- All stateful properties (items, counts, etc.) are exposed as Solid signals for reactivity\n\nThe batcher collects items and processes them in batches based on:\n- Maximum batch size (number of items per batch)\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and batcher instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together; the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncBatcher instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `batcher.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nAvailable state properties:\n- `errorCount`: Number of failed batch executions\n- `executionCount`: Total number of batch execution attempts (successful + failed)\n- `isExecuting`: Whether a batch execution is currently in progress\n- `items`: Array of items currently queued for batching\n- `lastResult`: The result from the most recent successful batch execution\n- `settleCount`: Number of batch executions that have completed (successful or failed)\n- `successCount`: Number of successful batch executions\n\n## Unmount behavior\n\nBy default, the primitive cancels any pending batch and aborts any in-flight execution when the owning component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst batcher = createAsyncBatcher(fn, {\n  maxSize: 10,\n  wait: 2000,\n  onUnmount: (b) => b.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your batch function updates Solid signals, those updates may run after the component has\nunmounted, which can cause unexpected reactive updates. Guard your callbacks accordingly when\nusing onUnmount with flush.\n\nExample usage:\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncBatcher = createAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  {\n    maxSize: 10,\n    wait: 2000,\n    onSuccess: (result) => {\n      console.log('Batch processed successfully:', result);\n    },\n    onError: (error) => {\n      console.error('Batch processing failed:', error);\n    }\n  }\n);\n\n// Opt-in to track items or isExecuting changes (optimized for UI updates)\nconst asyncBatcher = createAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({ items: state.items, isExecuting: state.isExecuting })\n);\n\n// Opt-in to track error state changes (optimized for error handling)\nconst asyncBatcher = createAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({ errorCount: state.errorCount })\n);\n\n// Add items to batch\nasyncBatcher.addItem(newItem);\n\n// Manually execute batch\nconst result = await asyncBatcher.execute();\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, isExecuting } = asyncBatcher.state();\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n### options?\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidAsyncBatcherOptions`](../interfaces/SolidAsyncBatcherOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidAsyncBatcher`](../interfaces/SolidAsyncBatcher.md)\\<`TValue`, `TSelected`\\>\n","originalRawMarkdown":"---\nid: createAsyncBatcher\ntitle: createAsyncBatcher\n---\n\n```ts\nfunction createAsyncBatcher<TValue, TSelected>(\n   fn,\n   options?,\nselector?): SolidAsyncBatcher<TValue, TSelected>;\n```\n\nDefined in: [async-batcher/createAsyncBatcher.ts:195](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/async-batcher/createAsyncBatcher.ts#L195)\n\nCreates a Solid-compatible AsyncBatcher instance for managing asynchronous batches of items, exposing Solid signals for all stateful properties.\n\nThis is the async version of the createBatcher hook. Unlike the sync version, this async batcher:\n- Handles promises and returns results from batch executions\n- Provides error handling with configurable error behavior\n- Tracks success, error, and settle counts separately\n- Has state tracking for when batches are executing\n- Returns the result of the batch function execution\n\nFeatures:\n- Configurable batch size and wait time\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n- Error handling for failed batch operations\n- Automatic or manual batch processing\n- All stateful properties (items, counts, etc.) are exposed as Solid signals for reactivity\n\nThe batcher collects items and processes them in batches based on:\n- Maximum batch size (number of items per batch)\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and batcher instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together; the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncBatcher instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `batcher.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nAvailable state properties:\n- `errorCount`: Number of failed batch executions\n- `executionCount`: Total number of batch execution attempts (successful + failed)\n- `isExecuting`: Whether a batch execution is currently in progress\n- `items`: Array of items currently queued for batching\n- `lastResult`: The result from the most recent successful batch execution\n- `settleCount`: Number of batch executions that have completed (successful or failed)\n- `successCount`: Number of successful batch executions\n\n## Unmount behavior\n\nBy default, the primitive cancels any pending batch and aborts any in-flight execution when the owning component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst batcher = createAsyncBatcher(fn, {\n  maxSize: 10,\n  wait: 2000,\n  onUnmount: (b) => b.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your batch function updates Solid signals, those updates may run after the component has\nunmounted, which can cause unexpected reactive updates. Guard your callbacks accordingly when\nusing onUnmount with flush.\n\nExample usage:\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncBatcher = createAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  {\n    maxSize: 10,\n    wait: 2000,\n    onSuccess: (result) => {\n      console.log('Batch processed successfully:', result);\n    },\n    onError: (error) => {\n      console.error('Batch processing failed:', error);\n    }\n  }\n);\n\n// Opt-in to track items or isExecuting changes (optimized for UI updates)\nconst asyncBatcher = createAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({ items: state.items, isExecuting: state.isExecuting })\n);\n\n// Opt-in to track error state changes (optimized for error handling)\nconst asyncBatcher = createAsyncBatcher(\n  async (items) => {\n    const results = await Promise.all(items.map(item => processItem(item)));\n    return results;\n  },\n  { maxSize: 10, wait: 2000 },\n  (state) => ({ errorCount: state.errorCount })\n);\n\n// Add items to batch\nasyncBatcher.addItem(newItem);\n\n// Manually execute batch\nconst result = await asyncBatcher.execute();\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, isExecuting } = asyncBatcher.state();\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n### options?\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidAsyncBatcherOptions`](../interfaces/SolidAsyncBatcherOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidAsyncBatcher`](../interfaces/SolidAsyncBatcher.md)\\<`TValue`, `TSelected`\\>\n"}
