ded for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"activeItems"},{"type":"text","value":": Array of items currently being processed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"errorCount"},{"type":"text","value":": Number of items that failed processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isRunning"},{"type":"text","value":": Whether the queuer is currently running (not stopped)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"items"},{"type":"text","value":": Array of items waiting to be processed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"rejectionCount"},{"type":"text","value":": Number of items that were rejected (expired or failed validation)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of items that have completed processing (successful or failed)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"successCount"},{"type":"text","value":": Number of items that were processed successfully"}]}]}]},{"type":"heading","depth":2,"id":"unmount-behavior","children":[{"type":"text","value":"Unmount behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the primitive stops the queuer and aborts any in-flight task executions when the owning component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from "},{"type":"inlineCode","value":"getAbortSignal()"},{"type":"text","value":" is passed to them.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this. For example, to flush pending items instead:"}]},{"type":"code","value":"const queuer = createAsyncQueuer(fn, {\n  concurrency: 2,\n  started: false,\n  onUnmount: (q) => q.flush()\n});","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Note: For async utils, "},{"type":"inlineCode","value":"flush()"},{"type":"text","value":" returns a Promise and runs fire-and-forget in the cleanup.\nIf your task function updates Solid signals, those updates may run after the component has\nunmounted, which can cause unexpected reactive updates. Guard your callbacks accordingly when\nusing onUnmount with flush."}]},{"type":"paragraph","children":[{"type":"text","value":"Example usage:"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst asyncQueuer = createAsyncQueuer(async (item) => {\n  // process item\n  return await fetchData(item);\n}, {\n  initialItems: [],\n  concurrency: 2,\n  maxSize: 100,\n  started: false,\n  onSuccess: (result) => {\n    console.log('Item processed:', result);\n  },\n  onError: (error) => {\n    console.error('Processing failed:', error);\n  }\n});\n\n// Opt-in to track queue state changes (optimized for UI updates)\nconst asyncQueuer = createAsyncQueuer(\n  async (item) => await fetchData(item),\n  { concurrency: 2, started: true },\n  (state) => ({\n    items: state.items,\n    activeItems: state.activeItems,\n    isRunning: state.isRunning\n  })\n);\n\n// Opt-in to track processing metrics changes (optimized for tracking progress)\nconst asyncQueuer = createAsyncQueuer(\n  async (item) => await fetchData(item),\n  { concurrency: 2, started: true },\n  (state) => ({\n    successCount: state.successCount,\n    errorCount: state.errorCount,\n    settleCount: state.settleCount\n  })\n);\n\n// Add items to queue\nasyncQueuer.addItem(newItem);\n\n// Start processing\nasyncQueuer.start();\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, activeItems } = asyncQueuer.state();","lang":"tsx"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"value"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/SolidPacerOptions.md","children":[{"type":"inlineCode","value":"SolidPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/SolidAsyncQueuerOptions.md","children":[{"type":"inlineCode","value":"SolidAsyncQueuerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">> = "},{"type":"inlineCode","value":"{}"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/SolidAsyncQueuer.md","children":[{"type":"inlineCode","value":"SolidAsyncQueuer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"unmount-behavior","text":"Unmount behavior","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createAsyncQueuer<TValue, TSelected>(\n   fn,\n   options?,\nselector?): SolidAsyncQueuer<TValue, TSelected>;\n```\n\nDefined in: [async-queuer/createAsyncQueuer.ts:189](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/async-queuer/createAsyncQueuer.ts#L189)\n\nCreates a Solid-compatible AsyncQueuer instance for managing an asynchronous queue of items, exposing Solid signals for all stateful properties.\n\nFeatures:\n- Priority queueing via `getPriority` or item `priority` property\n- Configurable concurrency limit\n- FIFO (First In First Out) or LIFO (Last In First Out) queue behavior\n- Pause/resume processing\n- Task cancellation\n- Item expiration\n- Lifecycle callbacks for success, error, settled, items change, etc.\n- All stateful properties (active items, pending items, counts, etc.) are exposed as Solid signals for reactivity\n\nTasks are processed concurrently up to the configured concurrency limit. When a task completes,\nthe next pending task is processed if the concurrency limit allows.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and queuer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together; the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncQueuer instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `queuer.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nAvailable state properties:\n- `activeItems`: Array of items currently being processed\n- `errorCount`: Number of items that failed processing\n- `isRunning`: Whether the queuer is currently running (not stopped)\n- `items`: Array of items waiting to be processed\n- `rejectionCount`: Number of items that were rejected (expired or failed validation)\n- `settleCount`: Number of items that have completed processing (successful or failed)\n- `successCount`: Number of items that were processed successfully\n\n## Unmount behavior\n\nBy default, the primitive stops the queuer and aborts any in-flight task executions when the owning component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending items instead:\n\n```tsx\nconst queuer = createAsyncQueuer(fn, {\n  concurrency: 2,\n  started: false,\n  onUnmount: (q) => q.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your task function updates Solid signals, those updates may run after the component has\nunmounted, which can cause unexpected reactive updates. Guard your callbacks accordingly when\nusing onUnmount with flush.\n\nExample usage:\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncQueuer = createAsyncQueuer(async (item) => {\n  // process item\n  return await fetchData(item);\n}, {\n  initialItems: [],\n  concurrency: 2,\n  maxSize: 100,\n  started: false,\n  onSuccess: (result) => {\n    console.log('Item processed:', result);\n  },\n  onError: (error) => {\n    console.error('Processing failed:', error);\n  }\n});\n\n// Opt-in to track queue state changes (optimized for UI updates)\nconst asyncQueuer = createAsyncQueuer(\n  async (item) => await fetchData(item),\n  { concurrency: 2, started: true },\n  (state) => ({\n    items: state.items,\n    activeItems: state.activeItems,\n    isRunning: state.isRunning\n  })\n);\n\n// Opt-in to track processing metrics changes (optimized for tracking progress)\nconst asyncQueuer = createAsyncQueuer(\n  async (item) => await fetchData(item),\n  { concurrency: 2, started: true },\n  (state) => ({\n    successCount: state.successCount,\n    errorCount: state.errorCount,\n    settleCount: state.settleCount\n  })\n);\n\n// Add items to queue\nasyncQueuer.addItem(newItem);\n\n// Start processing\nasyncQueuer.start();\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, activeItems } = asyncQueuer.state();\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`value`) => `Promise`\\<`any`\\>\n\n### options?\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidAsyncQueuerOptions`](../interfaces/SolidAsyncQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidAsyncQueuer`](../interfaces/SolidAsyncQueuer.md)\\<`TValue`, `TSelected`\\>\n","originalRawMarkdown":"---\nid: createAsyncQueuer\ntitle: createAsyncQueuer\n---\n\n```ts\nfunction createAsyncQueuer<TValue, TSelected>(\n   fn,\n   options?,\nselector?): SolidAsyncQueuer<TValue, TSelected>;\n```\n\nDefined in: [async-queuer/createAsyncQueuer.ts:189](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/async-queuer/createAsyncQueuer.ts#L189)\n\nCreates a Solid-compatible AsyncQueuer instance for managing an asynchronous queue of items, exposing Solid signals for all stateful properties.\n\nFeatures:\n- Priority queueing via `getPriority` or item `priority` property\n- Configurable concurrency limit\n- FIFO (First In First Out) or LIFO (Last In First Out) queue behavior\n- Pause/resume processing\n- Task cancellation\n- Item expiration\n- Lifecycle callbacks for success, error, settled, items change, etc.\n- All stateful properties (active items, pending items, counts, etc.) are exposed as Solid signals for reactivity\n\nTasks are processed concurrently up to the configured concurrency limit. When a task completes,\nthe next pending task is processed if the concurrency limit allows.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and queuer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together; the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncQueuer instance\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `queuer.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nAvailable state properties:\n- `activeItems`: Array of items currently being processed\n- `errorCount`: Number of items that failed processing\n- `isRunning`: Whether the queuer is currently running (not stopped)\n- `items`: Array of items waiting to be processed\n- `rejectionCount`: Number of items that were rejected (expired or failed validation)\n- `settleCount`: Number of items that have completed processing (successful or failed)\n- `successCount`: Number of items that were processed successfully\n\n## Unmount behavior\n\nBy default, the primitive stops the queuer and aborts any in-flight task executions when the owning component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this. For example, to flush pending items instead:\n\n```tsx\nconst queuer = createAsyncQueuer(fn, {\n  concurrency: 2,\n  started: false,\n  onUnmount: (q) => q.flush()\n});\n```\n\nNote: For async utils, `flush()` returns a Promise and runs fire-and-forget in the cleanup.\nIf your task function updates Solid signals, those updates may run after the component has\nunmounted, which can cause unexpected reactive updates. Guard your callbacks accordingly when\nusing onUnmount with flush.\n\nExample usage:\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncQueuer = createAsyncQueuer(async (item) => {\n  // process item\n  return await fetchData(item);\n}, {\n  initialItems: [],\n  concurrency: 2,\n  maxSize: 100,\n  started: false,\n  onSuccess: (result) => {\n    console.log('Item processed:', result);\n  },\n  onError: (error) => {\n    console.error('Processing failed:', error);\n  }\n});\n\n// Opt-in to track queue state changes (optimized for UI updates)\nconst asyncQueuer = createAsyncQueuer(\n  async (item) => await fetchData(item),\n  { concurrency: 2, started: true },\n  (state) => ({\n    items: state.items,\n    activeItems: state.activeItems,\n    isRunning: state.isRunning\n  })\n);\n\n// Opt-in to track processing metrics changes (optimized for tracking progress)\nconst asyncQueuer = createAsyncQueuer(\n  async (item) => await fetchData(item),\n  { concurrency: 2, started: true },\n  (state) => ({\n    successCount: state.successCount,\n    errorCount: state.errorCount,\n    settleCount: state.settleCount\n  })\n);\n\n// Add items to queue\nasyncQueuer.addItem(newItem);\n\n// Start processing\nasyncQueuer.start();\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, activeItems } = asyncQueuer.state();\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`value`) => `Promise`\\<`any`\\>\n\n### options?\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidAsyncQueuerOptions`](../interfaces/SolidAsyncQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidAsyncQueuer`](../interfaces/SolidAsyncQueuer.md)\\<`TValue`, `TSelected`\\>\n"}
