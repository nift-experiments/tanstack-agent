{"document":{"type":"root","children":[{"type":"code","value":"function createAsyncRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): SolidAsyncRateLimiter<TFn, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/async-rate-limiter/createAsyncRateLimiter.ts#L228","children":[{"type":"text","value":"async-rate-limiter/createAsyncRateLimiter.ts:228"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A low-level Solid hook that creates an "},{"type":"inlineCode","value":"AsyncRateLimiter"},{"type":"text","value":" instance to limit how many times an async function can execute within a time window."}]},{"type":"paragraph","children":[{"type":"text","value":"This hook is designed to be flexible and state-management agnostic - it simply returns a rate limiter instance that\nyou can integrate with any state management solution (createSignal, etc)."}]},{"type":"paragraph","children":[{"type":"text","value":"Rate limiting is a simple approach that allows a function to execute up to a limit within a time window,\nthen blocks all subsequent calls until the window passes. This can lead to \"bursty\" behavior where\nall executions happen immediately, followed by a complete block."}]},{"type":"paragraph","children":[{"type":"text","value":"The rate limiter supports two types of windows:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"'fixed': A strict window that resets after the window period. All executions within the window count\ntowards the limit, and the window resets completely after the period."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"'sliding': A rolling window that allows executions as old ones expire. This provides a more\nconsistent rate of execution over time."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike the non-async RateLimiter, this async version supports returning values from the rate-limited function,\nmaking it ideal for API calls and other async operations where you want the result of the "},{"type":"inlineCode","value":"maybeExecute"},{"type":"text","value":" call\ninstead of setting the result on a state variable from within the rate-limited function."}]},{"type":"paragraph","children":[{"type":"text","value":"For smoother execution patterns, consider using:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Throttling: Ensures consistent spacing between executions (e.g. max once per 200ms)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Debouncing: Waits for a pause in calls before executing (e.g. after 500ms of no calls)"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Rate limiting is best used for hard API limits or resource constraints. For UI updates or\nsmoothing out frequent events, throttling or debouncing usually provide better user experience."}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is provided, it will be called with the error and rate limiter instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together - the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncRateLimiter instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Rate limit rejections (when limit is exceeded) are handled separately from execution errors via the "},{"type":"inlineCode","value":"onReject"},{"type":"text","value":" handler"}]}]}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"1. Using "},{"type":"inlineCode","value":"rateLimiter.Subscribe"},{"type":"text","value":" component (Recommended for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes."}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"getRemainingInWindow()"},{"type":"text","value":" and "},{"type":"inlineCode","value":"getMsUntilNextWindow()"},{"type":"text","value":" for current window capacity and timing."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionTimes"},{"type":"text","value":": Timestamps of executions tracked for the current window"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isExceeded"},{"type":"text","value":": Whether the rate limit has been reached"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"settleCount"},{"type":"text","value":": Number of function executions that have completed (success or error)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"errorCount"},{"type":"text","value":": Number of function executions that have resulted in errors"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isExecuting"},{"type":"text","value":": Whether an async function execution is currently in progress"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastResult"},{"type":"text","value":": The result from the most recent successful execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"rejectionCount"},{"type":"text","value":": Number of function calls that were rejected due to rate limiting"}]}]}]},{"type":"heading","depth":2,"id":"unmount-behavior","children":[{"type":"text","value":"Unmount behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the primitive aborts any in-flight execution when the owning component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from "},{"type":"inlineCode","value":"getAbortSignal()"},{"type":"text","value":" is passed to them.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"AnyAsyncFunction"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/SolidPacerOptions.md","children":[{"type":"inlineCode","value":"SolidPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/SolidAsyncRateLimiterOptions.md","children":[{"type":"inlineCode","value":"SolidAsyncRateLimiterOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/SolidAsyncRateLimiter.md","children":[{"type":"inlineCode","value":"SolidAsyncRateLimiter"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data; // Return value is preserved\n  },\n  { limit: 5, window: 1000 } // 5 calls per second\n);\n\n// Subscribe to state changes deep in component tree using Subscribe component\n<asyncRateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount, isExecuting: state.isExecuting })}>\n  {(state) => (\n    <div>Rejected: {state().rejectionCount}, {state().isExecuting ? 'Executing' : 'Idle'}</div>\n  )}\n</asyncRateLimiter.Subscribe>\n\n// Opt-in to track execution state changes at hook level (optimized for loading indicators)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ isExecuting: state.isExecuting })\n);\n\n// Opt-in to track results when available (optimized for data display)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount\n  })\n);\n\n// Opt-in to track error/rejection state changes (optimized for error handling)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  {\n    limit: 5,\n    window: 1000,\n    onError: (error) => console.error('API call failed:', error),\n    onReject: (rateLimiter) => console.log('Rate limit exceeded')\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to track execution metrics changes (optimized for stats display)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    successCount: state.successCount,\n    errorCount: state.errorCount,\n    settleCount: state.settleCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to track execution times changes (optimized for window calculations)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ executionTimes: state.executionTimes })\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult, rejectionCount } = asyncRateLimiter.state();","lang":"tsx"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"unmount-behavior","text":"Unmount behavior","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createAsyncRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): SolidAsyncRateLimiter<TFn, TSelected>;\n```\n\nDefined in: [async-rate-limiter/createAsyncRateLimiter.ts:228](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/async-rate-limiter/createAsyncRateLimiter.ts#L228)\n\nA low-level Solid hook that creates an `AsyncRateLimiter` instance to limit how many times an async function can execute within a time window.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a rate limiter instance that\nyou can integrate with any state management solution (createSignal, etc).\n\nRate limiting is a simple approach that allows a function to execute up to a limit within a time window,\nthen blocks all subsequent calls until the window passes. This can lead to \"bursty\" behavior where\nall executions happen immediately, followed by a complete block.\n\nThe rate limiter supports two types of windows:\n- 'fixed': A strict window that resets after the window period. All executions within the window count\n  towards the limit, and the window resets completely after the period.\n- 'sliding': A rolling window that allows executions as old ones expire. This provides a more\n  consistent rate of execution over time.\n\nUnlike the non-async RateLimiter, this async version supports returning values from the rate-limited function,\nmaking it ideal for API calls and other async operations where you want the result of the `maybeExecute` call\ninstead of setting the result on a state variable from within the rate-limited function.\n\nFor smoother execution patterns, consider using:\n- Throttling: Ensures consistent spacing between executions (e.g. max once per 200ms)\n- Debouncing: Waits for a pause in calls before executing (e.g. after 500ms of no calls)\n\nRate limiting is best used for hard API limits or resource constraints. For UI updates or\nsmoothing out frequent events, throttling or debouncing usually provide better user experience.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and rate limiter instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncRateLimiter instance\n- Rate limit rejections (when limit is exceeded) are handled separately from execution errors via the `onReject` handler\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `rateLimiter.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nUse `getRemainingInWindow()` and `getMsUntilNextWindow()` for current window capacity and timing.\n\nAvailable state properties:\n- `executionTimes`: Timestamps of executions tracked for the current window\n- `isExceeded`: Whether the rate limit has been reached\n- `settleCount`: Number of function executions that have completed (success or error)\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether an async function execution is currently in progress\n- `lastResult`: The result from the most recent successful execution\n- `rejectionCount`: Number of function calls that were rejected due to rate limiting\n\n## Unmount behavior\n\nBy default, the primitive aborts any in-flight execution when the owning component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidAsyncRateLimiterOptions`](../interfaces/SolidAsyncRateLimiterOptions.md)\\<`TFn`, `TSelected`\\>\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidAsyncRateLimiter`](../interfaces/SolidAsyncRateLimiter.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data; // Return value is preserved\n  },\n  { limit: 5, window: 1000 } // 5 calls per second\n);\n\n// Subscribe to state changes deep in component tree using Subscribe component\n<asyncRateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount, isExecuting: state.isExecuting })}>\n  {(state) => (\n    <div>Rejected: {state().rejectionCount}, {state().isExecuting ? 'Executing' : 'Idle'}</div>\n  )}\n</asyncRateLimiter.Subscribe>\n\n// Opt-in to track execution state changes at hook level (optimized for loading indicators)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ isExecuting: state.isExecuting })\n);\n\n// Opt-in to track results when available (optimized for data display)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount\n  })\n);\n\n// Opt-in to track error/rejection state changes (optimized for error handling)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  {\n    limit: 5,\n    window: 1000,\n    onError: (error) => console.error('API call failed:', error),\n    onReject: (rateLimiter) => console.log('Rate limit exceeded')\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to track execution metrics changes (optimized for stats display)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    successCount: state.successCount,\n    errorCount: state.errorCount,\n    settleCount: state.settleCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to track execution times changes (optimized for window calculations)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ executionTimes: state.executionTimes })\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult, rejectionCount } = asyncRateLimiter.state();\n```\n","originalRawMarkdown":"---\nid: createAsyncRateLimiter\ntitle: createAsyncRateLimiter\n---\n\n```ts\nfunction createAsyncRateLimiter<TFn, TSelected>(\n   fn,\n   options,\nselector?): SolidAsyncRateLimiter<TFn, TSelected>;\n```\n\nDefined in: [async-rate-limiter/createAsyncRateLimiter.ts:228](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/async-rate-limiter/createAsyncRateLimiter.ts#L228)\n\nA low-level Solid hook that creates an `AsyncRateLimiter` instance to limit how many times an async function can execute within a time window.\n\nThis hook is designed to be flexible and state-management agnostic - it simply returns a rate limiter instance that\nyou can integrate with any state management solution (createSignal, etc).\n\nRate limiting is a simple approach that allows a function to execute up to a limit within a time window,\nthen blocks all subsequent calls until the window passes. This can lead to \"bursty\" behavior where\nall executions happen immediately, followed by a complete block.\n\nThe rate limiter supports two types of windows:\n- 'fixed': A strict window that resets after the window period. All executions within the window count\n  towards the limit, and the window resets completely after the period.\n- 'sliding': A rolling window that allows executions as old ones expire. This provides a more\n  consistent rate of execution over time.\n\nUnlike the non-async RateLimiter, this async version supports returning values from the rate-limited function,\nmaking it ideal for API calls and other async operations where you want the result of the `maybeExecute` call\ninstead of setting the result on a state variable from within the rate-limited function.\n\nFor smoother execution patterns, consider using:\n- Throttling: Ensures consistent spacing between executions (e.g. max once per 200ms)\n- Debouncing: Waits for a pause in calls before executing (e.g. after 500ms of no calls)\n\nRate limiting is best used for hard API limits or resource constraints. For UI updates or\nsmoothing out frequent events, throttling or debouncing usually provide better user experience.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and rate limiter instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncRateLimiter instance\n- Rate limit rejections (when limit is exceeded) are handled separately from execution errors via the `onReject` handler\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `rateLimiter.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nUse `getRemainingInWindow()` and `getMsUntilNextWindow()` for current window capacity and timing.\n\nAvailable state properties:\n- `executionTimes`: Timestamps of executions tracked for the current window\n- `isExceeded`: Whether the rate limit has been reached\n- `settleCount`: Number of function executions that have completed (success or error)\n- `errorCount`: Number of function executions that have resulted in errors\n- `isExecuting`: Whether an async function execution is currently in progress\n- `lastResult`: The result from the most recent successful execution\n- `rejectionCount`: Number of function calls that were rejected due to rate limiting\n\n## Unmount behavior\n\nBy default, the primitive aborts any in-flight execution when the owning component unmounts.\nAbort only cancels underlying operations (e.g. fetch) when the abort signal from `getAbortSignal()` is passed to them.\nUse the `onUnmount` option to customize this.\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* `AnyAsyncFunction`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### options\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidAsyncRateLimiterOptions`](../interfaces/SolidAsyncRateLimiterOptions.md)\\<`TFn`, `TSelected`\\>\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidAsyncRateLimiter`](../interfaces/SolidAsyncRateLimiter.md)\\<`TFn`, `TSelected`\\>\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data; // Return value is preserved\n  },\n  { limit: 5, window: 1000 } // 5 calls per second\n);\n\n// Subscribe to state changes deep in component tree using Subscribe component\n<asyncRateLimiter.Subscribe selector={(state) => ({ rejectionCount: state.rejectionCount, isExecuting: state.isExecuting })}>\n  {(state) => (\n    <div>Rejected: {state().rejectionCount}, {state().isExecuting ? 'Executing' : 'Idle'}</div>\n  )}\n</asyncRateLimiter.Subscribe>\n\n// Opt-in to track execution state changes at hook level (optimized for loading indicators)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ isExecuting: state.isExecuting })\n);\n\n// Opt-in to track results when available (optimized for data display)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    lastResult: state.lastResult,\n    successCount: state.successCount\n  })\n);\n\n// Opt-in to track error/rejection state changes (optimized for error handling)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  {\n    limit: 5,\n    window: 1000,\n    onError: (error) => console.error('API call failed:', error),\n    onReject: (rateLimiter) => console.log('Rate limit exceeded')\n  },\n  (state) => ({\n    errorCount: state.errorCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to track execution metrics changes (optimized for stats display)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({\n    successCount: state.successCount,\n    errorCount: state.errorCount,\n    settleCount: state.settleCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Opt-in to track execution times changes (optimized for window calculations)\nconst asyncRateLimiter = createAsyncRateLimiter(\n  async (id: string) => {\n    const data = await api.fetchData(id);\n    return data;\n  },\n  { limit: 5, window: 1000 },\n  (state) => ({ executionTimes: state.executionTimes })\n);\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { isExecuting, lastResult, rejectionCount } = asyncRateLimiter.state();\n```\n"}
