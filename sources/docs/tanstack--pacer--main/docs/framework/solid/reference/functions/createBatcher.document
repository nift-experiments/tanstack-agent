m","children":[{"type":"paragraph","children":[{"type":"text","value":"Custom batch processing logic via getShouldExecute"}]}]}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"1. Using "},{"type":"inlineCode","value":"batcher.Subscribe"},{"type":"text","value":" component (Recommended for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Number of batch executions that have been completed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"items"},{"type":"text","value":": Array of items currently queued for batching"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"totalItemsProcessed"},{"type":"text","value":": Total number of individual items that have been processed across all batches"}]}]}]},{"type":"heading","depth":2,"id":"unmount-behavior","children":[{"type":"text","value":"Unmount behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the primitive cancels any pending batch when the owning component unmounts.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this. For example, to flush pending work instead:"}]},{"type":"code","value":"const batcher = createBatcher(fn, {\n  maxSize: 10,\n  wait: 2000,\n  onUnmount: (b) => b.flush()\n});","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Example usage:"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst batcher = createBatcher(\n  (items) => {\n    // Process batch of items\n    console.log('Processing batch:', items);\n  },\n  {\n    maxSize: 5,\n    wait: 2000,\n    onExecute: (batcher) => console.log('Batch executed'),\n    getShouldExecute: (items) => items.length >= 3\n  }\n);\n\n// Opt-in to track items or isPending changes (optimized for UI updates)\nconst batcher = createBatcher(\n  (items) => console.log('Processing batch:', items),\n  { maxSize: 5, wait: 2000 },\n  (state) => ({ items: state.items, isPending: state.isPending })\n);\n\n// Opt-in to track execution metrics changes (optimized for tracking progress)\nconst batcher = createBatcher(\n  (items) => console.log('Processing batch:', items),\n  { maxSize: 5, wait: 2000 },\n  (state) => ({\n    executionCount: state.executionCount,\n    totalItemsProcessed: state.totalItemsProcessed\n  })\n);\n\n// Add items to batch\nbatcher.addItem('task1');\nbatcher.addItem('task2');\n\n// Control the batcher\nbatcher.cancel(); // Cancel the pending timer; queued items are retained\nbatcher.flush();  // Process queued items immediately\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, isPending } = batcher.state();","lang":"tsx"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"items"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/SolidPacerOptions.md","children":[{"type":"inlineCode","value":"SolidPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/SolidBatcherOptions.md","children":[{"type":"inlineCode","value":"SolidBatcherOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">> = "},{"type":"inlineCode","value":"{}"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/SolidBatcher.md","children":[{"type":"inlineCode","value":"SolidBatcher"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"unmount-behavior","text":"Unmount behavior","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createBatcher<TValue, TSelected>(\n   fn,\n   options?,\nselector?): SolidBatcher<TValue, TSelected>;\n```\n\nDefined in: [batcher/createBatcher.ts:159](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/batcher/createBatcher.ts#L159)\n\nCreates a Solid-compatible Batcher instance for managing batches of items, exposing Solid signals for all stateful properties.\n\nFeatures:\n- Batch processing of items using the provided `fn` function\n- Configurable batch size and wait time\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n- All stateful properties (items, counts, etc.) are exposed as Solid signals for reactivity\n\nThe batcher collects items and processes them in batches based on:\n- Maximum batch size\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `batcher.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nAvailable state properties:\n- `executionCount`: Number of batch executions that have been completed\n- `items`: Array of items currently queued for batching\n- `totalItemsProcessed`: Total number of individual items that have been processed across all batches\n\n## Unmount behavior\n\nBy default, the primitive cancels any pending batch when the owning component unmounts.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst batcher = createBatcher(fn, {\n  maxSize: 10,\n  wait: 2000,\n  onUnmount: (b) => b.flush()\n});\n```\n\nExample usage:\n```tsx\n// Default behavior - no reactive state subscriptions\nconst batcher = createBatcher(\n  (items) => {\n    // Process batch of items\n    console.log('Processing batch:', items);\n  },\n  {\n    maxSize: 5,\n    wait: 2000,\n    onExecute: (batcher) => console.log('Batch executed'),\n    getShouldExecute: (items) => items.length >= 3\n  }\n);\n\n// Opt-in to track items or isPending changes (optimized for UI updates)\nconst batcher = createBatcher(\n  (items) => console.log('Processing batch:', items),\n  { maxSize: 5, wait: 2000 },\n  (state) => ({ items: state.items, isPending: state.isPending })\n);\n\n// Opt-in to track execution metrics changes (optimized for tracking progress)\nconst batcher = createBatcher(\n  (items) => console.log('Processing batch:', items),\n  { maxSize: 5, wait: 2000 },\n  (state) => ({\n    executionCount: state.executionCount,\n    totalItemsProcessed: state.totalItemsProcessed\n  })\n);\n\n// Add items to batch\nbatcher.addItem('task1');\nbatcher.addItem('task2');\n\n// Control the batcher\nbatcher.cancel(); // Cancel the pending timer; queued items are retained\nbatcher.flush();  // Process queued items immediately\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, isPending } = batcher.state();\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`items`) => `void`\n\n### options?\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidBatcherOptions`](../interfaces/SolidBatcherOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidBatcher`](../interfaces/SolidBatcher.md)\\<`TValue`, `TSelected`\\>\n","originalRawMarkdown":"---\nid: createBatcher\ntitle: createBatcher\n---\n\n```ts\nfunction createBatcher<TValue, TSelected>(\n   fn,\n   options?,\nselector?): SolidBatcher<TValue, TSelected>;\n```\n\nDefined in: [batcher/createBatcher.ts:159](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/batcher/createBatcher.ts#L159)\n\nCreates a Solid-compatible Batcher instance for managing batches of items, exposing Solid signals for all stateful properties.\n\nFeatures:\n- Batch processing of items using the provided `fn` function\n- Configurable batch size and wait time\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n- All stateful properties (items, counts, etc.) are exposed as Solid signals for reactivity\n\nThe batcher collects items and processes them in batches based on:\n- Maximum batch size\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `batcher.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nAvailable state properties:\n- `executionCount`: Number of batch executions that have been completed\n- `items`: Array of items currently queued for batching\n- `totalItemsProcessed`: Total number of individual items that have been processed across all batches\n\n## Unmount behavior\n\nBy default, the primitive cancels any pending batch when the owning component unmounts.\nUse the `onUnmount` option to customize this. For example, to flush pending work instead:\n\n```tsx\nconst batcher = createBatcher(fn, {\n  maxSize: 10,\n  wait: 2000,\n  onUnmount: (b) => b.flush()\n});\n```\n\nExample usage:\n```tsx\n// Default behavior - no reactive state subscriptions\nconst batcher = createBatcher(\n  (items) => {\n    // Process batch of items\n    console.log('Processing batch:', items);\n  },\n  {\n    maxSize: 5,\n    wait: 2000,\n    onExecute: (batcher) => console.log('Batch executed'),\n    getShouldExecute: (items) => items.length >= 3\n  }\n);\n\n// Opt-in to track items or isPending changes (optimized for UI updates)\nconst batcher = createBatcher(\n  (items) => console.log('Processing batch:', items),\n  { maxSize: 5, wait: 2000 },\n  (state) => ({ items: state.items, isPending: state.isPending })\n);\n\n// Opt-in to track execution metrics changes (optimized for tracking progress)\nconst batcher = createBatcher(\n  (items) => console.log('Processing batch:', items),\n  { maxSize: 5, wait: 2000 },\n  (state) => ({\n    executionCount: state.executionCount,\n    totalItemsProcessed: state.totalItemsProcessed\n  })\n);\n\n// Add items to batch\nbatcher.addItem('task1');\nbatcher.addItem('task2');\n\n// Control the batcher\nbatcher.cancel(); // Cancel the pending timer; queued items are retained\nbatcher.flush();  // Process queued items immediately\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, isPending } = batcher.state();\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`items`) => `void`\n\n### options?\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidBatcherOptions`](../interfaces/SolidBatcherOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidBatcher`](../interfaces/SolidBatcher.md)\\<`TValue`, `TSelected`\\>\n"}
