pe":"paragraph","children":[{"type":"text","value":"All stateful properties (items, counts, etc.) are exposed as Solid signals for reactivity"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The queue processes items synchronously in order, with optional delays between each item. When started, it will process one item per tick, with an optional wait time between ticks. You can pause and resume processing with "},{"type":"inlineCode","value":"stop()"},{"type":"text","value":" and "},{"type":"inlineCode","value":"start()"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the queue uses FIFO behavior, but you can configure LIFO or double-ended queueing by specifying the position when adding or removing items."}]},{"type":"heading","depth":2,"id":"state-management-and-selector","children":[{"type":"text","value":"State Management and Selector"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"1. Using "},{"type":"inlineCode","value":"queuer.Subscribe"},{"type":"text","value":" component (Recommended for component tree subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"2. Using the "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter (For hook-level subscriptions)"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function or using the "},{"type":"inlineCode","value":"Subscribe"},{"type":"text","value":" component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes."}]},{"type":"paragraph","children":[{"type":"text","value":"Available state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Number of items that have been processed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isRunning"},{"type":"text","value":": Whether the queuer is currently running (not stopped)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"items"},{"type":"text","value":": Array of items currently queued for processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"rejectionCount"},{"type":"text","value":": Number of items that were rejected (expired or failed validation)"}]}]}]},{"type":"heading","depth":2,"id":"unmount-behavior","children":[{"type":"text","value":"Unmount behavior"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the primitive stops the queuer when the owning component unmounts.\nUse the "},{"type":"inlineCode","value":"onUnmount"},{"type":"text","value":" option to customize this. For example, to flush pending items instead:"}]},{"type":"code","value":"const queue = createQueuer(fn, {\n  started: true,\n  wait: 1000,\n  onUnmount: (q) => q.flush()\n});","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Example usage:"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst queue = createQueuer(\n  (item) => {\n    // process item synchronously\n    console.log('Processing', item);\n  },\n  {\n    started: true, // Start processing immediately\n    wait: 1000,    // Process one item every second\n    getPriority: (item) => item.priority // Process higher priority items first\n  }\n);\n\n// Opt-in to track items or isRunning changes (optimized for UI updates)\nconst queue = createQueuer(\n  (item) => console.log('Processing', item),\n  { started: true, wait: 1000 },\n  (state) => ({ items: state.items, isRunning: state.isRunning })\n);\n\n// Opt-in to track execution metrics changes (optimized for tracking progress)\nconst queue = createQueuer(\n  (item) => console.log('Processing', item),\n  { started: true, wait: 1000 },\n  (state) => ({\n    executionCount: state.executionCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Add items to process - they'll be handled automatically\nqueue.addItem('task1');\nqueue.addItem('task2');\n\n// Control the scheduler\nqueue.stop();  // Pause processing\nqueue.start(); // Resume processing\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, isRunning } = queue.state();","lang":"tsx"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"item"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/SolidPacerOptions.md","children":[{"type":"inlineCode","value":"SolidPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/SolidQueuerOptions.md","children":[{"type":"inlineCode","value":"SolidQueuerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">> = "},{"type":"inlineCode","value":"{}"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/SolidQueuer.md","children":[{"type":"inlineCode","value":"SolidQueuer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"unmount-behavior","text":"Unmount behavior","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options?","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createQueuer<TValue, TSelected>(\n   fn,\n   options?,\nselector?): SolidQueuer<TValue, TSelected>;\n```\n\nDefined in: [queuer/createQueuer.ts:161](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/queuer/createQueuer.ts#L161)\n\nCreates a Solid-compatible Queuer instance for managing a synchronous queue of items, exposing Solid signals for all stateful properties.\n\nFeatures:\n- Synchronous processing of items using the provided `fn` function\n- FIFO (First In First Out) or LIFO (Last In First Out) queue behavior\n- Priority queueing via `getPriority` or item `priority` property\n- Item expiration and removal of stale items\n- Configurable wait time between processing items\n- Pause/resume processing\n- Callbacks for queue state changes, execution, rejection, and expiration\n- All stateful properties (items, counts, etc.) are exposed as Solid signals for reactivity\n\nThe queue processes items synchronously in order, with optional delays between each item. When started, it will process one item per tick, with an optional wait time between ticks. You can pause and resume processing with `stop()` and `start()`.\n\nBy default, the queue uses FIFO behavior, but you can configure LIFO or double-ended queueing by specifying the position when adding or removing items.\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `queuer.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nAvailable state properties:\n- `executionCount`: Number of items that have been processed\n- `isRunning`: Whether the queuer is currently running (not stopped)\n- `items`: Array of items currently queued for processing\n- `rejectionCount`: Number of items that were rejected (expired or failed validation)\n\n## Unmount behavior\n\nBy default, the primitive stops the queuer when the owning component unmounts.\nUse the `onUnmount` option to customize this. For example, to flush pending items instead:\n\n```tsx\nconst queue = createQueuer(fn, {\n  started: true,\n  wait: 1000,\n  onUnmount: (q) => q.flush()\n});\n```\n\nExample usage:\n```tsx\n// Default behavior - no reactive state subscriptions\nconst queue = createQueuer(\n  (item) => {\n    // process item synchronously\n    console.log('Processing', item);\n  },\n  {\n    started: true, // Start processing immediately\n    wait: 1000,    // Process one item every second\n    getPriority: (item) => item.priority // Process higher priority items first\n  }\n);\n\n// Opt-in to track items or isRunning changes (optimized for UI updates)\nconst queue = createQueuer(\n  (item) => console.log('Processing', item),\n  { started: true, wait: 1000 },\n  (state) => ({ items: state.items, isRunning: state.isRunning })\n);\n\n// Opt-in to track execution metrics changes (optimized for tracking progress)\nconst queue = createQueuer(\n  (item) => console.log('Processing', item),\n  { started: true, wait: 1000 },\n  (state) => ({\n    executionCount: state.executionCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Add items to process - they'll be handled automatically\nqueue.addItem('task1');\nqueue.addItem('task2');\n\n// Control the scheduler\nqueue.stop();  // Pause processing\nqueue.start(); // Resume processing\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, isRunning } = queue.state();\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`item`) => `void`\n\n### options?\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidQueuerOptions`](../interfaces/SolidQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidQueuer`](../interfaces/SolidQueuer.md)\\<`TValue`, `TSelected`\\>\n","originalRawMarkdown":"---\nid: createQueuer\ntitle: createQueuer\n---\n\n```ts\nfunction createQueuer<TValue, TSelected>(\n   fn,\n   options?,\nselector?): SolidQueuer<TValue, TSelected>;\n```\n\nDefined in: [queuer/createQueuer.ts:161](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/queuer/createQueuer.ts#L161)\n\nCreates a Solid-compatible Queuer instance for managing a synchronous queue of items, exposing Solid signals for all stateful properties.\n\nFeatures:\n- Synchronous processing of items using the provided `fn` function\n- FIFO (First In First Out) or LIFO (Last In First Out) queue behavior\n- Priority queueing via `getPriority` or item `priority` property\n- Item expiration and removal of stale items\n- Configurable wait time between processing items\n- Pause/resume processing\n- Callbacks for queue state changes, execution, rejection, and expiration\n- All stateful properties (items, counts, etc.) are exposed as Solid signals for reactivity\n\nThe queue processes items synchronously in order, with optional delays between each item. When started, it will process one item per tick, with an optional wait time between ticks. You can pause and resume processing with `stop()` and `start()`.\n\nBy default, the queue uses FIFO behavior, but you can configure LIFO or double-ended queueing by specifying the position when adding or removing items.\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management. You can subscribe to state changes\nin two ways:\n\n**1. Using `queuer.Subscribe` component (Recommended for component tree subscriptions)**\n\nUse the `Subscribe` component to subscribe to state changes deep in your component tree without\nneeding to pass a selector to the hook. This is ideal when you want to subscribe to state\nin child components.\n\n**2. Using the `selector` parameter (For hook-level subscriptions)**\n\nThe `selector` parameter allows you to specify which state changes will trigger reactive updates\nat the hook level, optimizing performance by preventing unnecessary updates when irrelevant\nstate changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function or using the `Subscribe` component. This prevents unnecessary\nupdates and gives you full control over when your component tracks state changes.\n\nAvailable state properties:\n- `executionCount`: Number of items that have been processed\n- `isRunning`: Whether the queuer is currently running (not stopped)\n- `items`: Array of items currently queued for processing\n- `rejectionCount`: Number of items that were rejected (expired or failed validation)\n\n## Unmount behavior\n\nBy default, the primitive stops the queuer when the owning component unmounts.\nUse the `onUnmount` option to customize this. For example, to flush pending items instead:\n\n```tsx\nconst queue = createQueuer(fn, {\n  started: true,\n  wait: 1000,\n  onUnmount: (q) => q.flush()\n});\n```\n\nExample usage:\n```tsx\n// Default behavior - no reactive state subscriptions\nconst queue = createQueuer(\n  (item) => {\n    // process item synchronously\n    console.log('Processing', item);\n  },\n  {\n    started: true, // Start processing immediately\n    wait: 1000,    // Process one item every second\n    getPriority: (item) => item.priority // Process higher priority items first\n  }\n);\n\n// Opt-in to track items or isRunning changes (optimized for UI updates)\nconst queue = createQueuer(\n  (item) => console.log('Processing', item),\n  { started: true, wait: 1000 },\n  (state) => ({ items: state.items, isRunning: state.isRunning })\n);\n\n// Opt-in to track execution metrics changes (optimized for tracking progress)\nconst queue = createQueuer(\n  (item) => console.log('Processing', item),\n  { started: true, wait: 1000 },\n  (state) => ({\n    executionCount: state.executionCount,\n    rejectionCount: state.rejectionCount\n  })\n);\n\n// Add items to process - they'll be handled automatically\nqueue.addItem('task1');\nqueue.addItem('task2');\n\n// Control the scheduler\nqueue.stop();  // Pause processing\nqueue.start(); // Resume processing\n\n// Access the selected state (will be empty object {} unless selector provided)\nconst { items, isRunning } = queue.state();\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### fn\n\n(`item`) => `void`\n\n### options?\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidQueuerOptions`](../interfaces/SolidQueuerOptions.md)\\<`TValue`, `TSelected`\\>\\> = `{}`\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`SolidQueuer`](../interfaces/SolidQueuer.md)\\<`TValue`, `TSelected`\\>\n"}
