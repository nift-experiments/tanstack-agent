":"paragraph","children":[{"type":"text","value":"The hook uses TanStack Store for reactive state management via the underlying throttler instance.\nThe "},{"type":"inlineCode","value":"selector"},{"type":"text","value":" parameter allows you to specify which throttler state changes will trigger reactive updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"By default, there will be no reactive state subscriptions"}]},{"type":"text","value":" and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary reactive updates and gives you\nfull control over when your component subscribes to state changes. Only when you provide a selector will\nthe reactive system track the selected state values."}]},{"type":"paragraph","children":[{"type":"text","value":"Available throttler state properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"executionCount"},{"type":"text","value":": Number of function executions that have been completed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":": Whether the throttler is waiting for the timeout to trigger trailing execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastArgs"},{"type":"text","value":": The arguments from the most recent call to maybeExecute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lastExecutionTime"},{"type":"text","value":": Unix timestamp of the last execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"nextExecutionTime"},{"type":"text","value":": Unix timestamp of the next allowed execution"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":": Current execution status ('disabled' | 'idle' | 'pending')"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = {\n}"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"initialoptions","children":[{"type":"text","value":"initialOptions"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/SolidPacerOptions.md","children":[{"type":"inlineCode","value":"SolidPacerOptions"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/SolidThrottlerOptions.md","children":[{"type":"inlineCode","value":"SolidThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"Setter"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"["},{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"link","href":"../interfaces/SolidThrottler.md","children":[{"type":"inlineCode","value":"SolidThrottler"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"Setter"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">]"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Default behavior - no reactive state subscriptions\nconst [throttledValue, throttler] = createThrottledValue(rawValue, { wait: 1000 });\n\n// Opt-in to reactive updates when pending state changes (optimized for loading indicators)\nconst [throttledValue, throttler] = createThrottledValue(\n  rawValue,\n  { wait: 1000 },\n  (state) => ({ isPending: state.isPending })\n);\n\n// Use the throttled value\nconsole.log(throttledValue()); // Access the current throttled value\n\n// Access throttler state via signals\nconsole.log('Is pending:', throttler.state().isPending);\n\n// Control the throttler\nthrottler.cancel(); // Cancel any pending updates","lang":"tsx"}],"headings":[{"id":"state-management-and-selector","text":"State Management and Selector","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"value","text":"value","level":3},{"id":"initialoptions","text":"initialOptions","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createThrottledValue<TValue, TSelected>(\n   value,\n   initialOptions,\n   selector?): [Accessor<TValue>, SolidThrottler<Setter<TValue>, TSelected>];\n```\n\nDefined in: [throttler/createThrottledValue.ts:65](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/throttler/createThrottledValue.ts#L65)\n\nA high-level Solid hook that creates a throttled version of a value that updates at most once within a specified time window.\nThis hook uses Solid's createSignal internally to manage the throttled state.\n\nThrottling ensures the value updates occur at a controlled rate regardless of how frequently the input value changes.\nThis is useful for rate-limiting expensive updates or API calls that depend on rapidly changing values.\n\nThe hook returns a tuple containing:\n- An accessor function that provides the throttled value\n- The throttler instance with control methods\n\nThe throttled value will update according to the leading/trailing edge behavior specified in the options.\n\nFor more direct control over throttling behavior without Solid state management,\nconsider using the lower-level createThrottler hook instead.\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management via the underlying throttler instance.\nThe `selector` parameter allows you to specify which throttler state changes will trigger reactive updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary reactive updates and gives you\nfull control over when your component subscribes to state changes. Only when you provide a selector will\nthe reactive system track the selected state values.\n\nAvailable throttler state properties:\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the throttler is waiting for the timeout to trigger trailing execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Unix timestamp of the last execution\n- `nextExecutionTime`: Unix timestamp of the next allowed execution\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### value\n\n`Accessor`\\<`TValue`\\>\n\n### initialOptions\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidThrottlerOptions`](../interfaces/SolidThrottlerOptions.md)\\<`Setter`\\<`TValue`\\>, `TSelected`\\>\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n\\[`Accessor`\\<`TValue`\\>, [`SolidThrottler`](../interfaces/SolidThrottler.md)\\<`Setter`\\<`TValue`\\>, `TSelected`\\>\\]\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst [throttledValue, throttler] = createThrottledValue(rawValue, { wait: 1000 });\n\n// Opt-in to reactive updates when pending state changes (optimized for loading indicators)\nconst [throttledValue, throttler] = createThrottledValue(\n  rawValue,\n  { wait: 1000 },\n  (state) => ({ isPending: state.isPending })\n);\n\n// Use the throttled value\nconsole.log(throttledValue()); // Access the current throttled value\n\n// Access throttler state via signals\nconsole.log('Is pending:', throttler.state().isPending);\n\n// Control the throttler\nthrottler.cancel(); // Cancel any pending updates\n```\n","originalRawMarkdown":"---\nid: createThrottledValue\ntitle: createThrottledValue\n---\n\n```ts\nfunction createThrottledValue<TValue, TSelected>(\n   value,\n   initialOptions,\n   selector?): [Accessor<TValue>, SolidThrottler<Setter<TValue>, TSelected>];\n```\n\nDefined in: [throttler/createThrottledValue.ts:65](https://github.com/TanStack/pacer/blob/main/packages/solid-pacer/src/throttler/createThrottledValue.ts#L65)\n\nA high-level Solid hook that creates a throttled version of a value that updates at most once within a specified time window.\nThis hook uses Solid's createSignal internally to manage the throttled state.\n\nThrottling ensures the value updates occur at a controlled rate regardless of how frequently the input value changes.\nThis is useful for rate-limiting expensive updates or API calls that depend on rapidly changing values.\n\nThe hook returns a tuple containing:\n- An accessor function that provides the throttled value\n- The throttler instance with control methods\n\nThe throttled value will update according to the leading/trailing edge behavior specified in the options.\n\nFor more direct control over throttling behavior without Solid state management,\nconsider using the lower-level createThrottler hook instead.\n\n## State Management and Selector\n\nThe hook uses TanStack Store for reactive state management via the underlying throttler instance.\nThe `selector` parameter allows you to specify which throttler state changes will trigger reactive updates,\noptimizing performance by preventing unnecessary subscriptions when irrelevant state changes occur.\n\n**By default, there will be no reactive state subscriptions** and you must opt-in to state\ntracking by providing a selector function. This prevents unnecessary reactive updates and gives you\nfull control over when your component subscribes to state changes. Only when you provide a selector will\nthe reactive system track the selected state values.\n\nAvailable throttler state properties:\n- `executionCount`: Number of function executions that have been completed\n- `isPending`: Whether the throttler is waiting for the timeout to trigger trailing execution\n- `lastArgs`: The arguments from the most recent call to maybeExecute\n- `lastExecutionTime`: Unix timestamp of the last execution\n- `nextExecutionTime`: Unix timestamp of the next allowed execution\n- `status`: Current execution status ('disabled' | 'idle' | 'pending')\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n### TSelected\n\n`TSelected` = \\{\n\\}\n\n## Parameters\n\n### value\n\n`Accessor`\\<`TValue`\\>\n\n### initialOptions\n\n[`SolidPacerOptions`](../type-aliases/SolidPacerOptions.md)\\<[`SolidThrottlerOptions`](../interfaces/SolidThrottlerOptions.md)\\<`Setter`\\<`TValue`\\>, `TSelected`\\>\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n\\[`Accessor`\\<`TValue`\\>, [`SolidThrottler`](../interfaces/SolidThrottler.md)\\<`Setter`\\<`TValue`\\>, `TSelected`\\>\\]\n\n## Example\n\n```tsx\n// Default behavior - no reactive state subscriptions\nconst [throttledValue, throttler] = createThrottledValue(rawValue, { wait: 1000 });\n\n// Opt-in to reactive updates when pending state changes (optimized for loading indicators)\nconst [throttledValue, throttler] = createThrottledValue(\n  rawValue,\n  { wait: 1000 },\n  (state) => ({ isPending: state.isPending })\n);\n\n// Use the throttled value\nconsole.log(throttledValue()); // Access the current throttled value\n\n// Access throttler state via signals\nconsole.log('Is pending:', throttler.state().isPending);\n\n// Control the throttler\nthrottler.cancel(); // Cancel any pending updates\n```\n"}
