{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"svelte-pacer"},{"type":"text","value":" adapter connects Pacer scheduling utilities to Svelte state and lifecycle management. It re-exports the core package, including utility classes, stateless functions, option types, and async retrying."}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"code","value":"pnpm add @tanstack/svelte-pacer","lang":"sh"},{"type":"paragraph","children":[{"type":"text","value":"The package is ESM-only and requires Node.js 20 or newer when running in Node.js."}]},{"type":"heading","depth":2,"id":"lifecycle-and-state","children":[{"type":"text","value":"Lifecycle and state"}]},{"type":"paragraph","children":[{"type":"text","value":"Call factories during component initialization. Options update in a pre-render effect. Read selected state through "},{"type":"inlineCode","value":"utility.state"},{"type":"text","value":" without destructuring it outside a reactive expression. Component destruction releases subscriptions and cleans up the utility."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the selected state is "},{"type":"inlineCode","value":"{}"},{"type":"text","value":". Pass a selector to subscribe only to the fields your UI reads. The underlying "},{"type":"inlineCode","value":"store"},{"type":"text","value":" remains available for additional subscriptions."}]},{"type":"heading","depth":2,"id":"api-overview","children":[{"type":"text","value":"API overview"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Utility"}]},{"type":"tableCell","children":[{"type":"text","value":"Instance API"}]},{"type":"tableCell","children":[{"type":"text","value":"State and value helpers"}]}],"rows":[[{"type":"tableCell","children":[{"type":"link","href":"./guides/batching.md","children":[{"type":"text","value":"batching"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createBatcher"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/debouncing.md","children":[{"type":"text","value":"debouncing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createDebouncer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createDebouncedSignal"},{"type":"text","value":", "},{"type":"inlineCode","value":"createDebouncedValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/queuing.md","children":[{"type":"text","value":"queuing"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createQueuer"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createQueuedSignal"},{"type":"text","value":", "},{"type":"inlineCode","value":"createQueuedValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/rate-limiting.md","children":[{"type":"text","value":"rate limiting"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createRateLimiter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createRateLimitedSignal"},{"type":"text","value":", "},{"type":"inlineCode","value":"createRateLimitedValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/throttling.md","children":[{"type":"text","value":"throttling"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createThrottler"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createThrottledSignal"},{"type":"text","value":", "},{"type":"inlineCode","value":"createThrottledValue"}]}],[{"type":"tableCell","children":[{"type":"link","href":"./guides/async-batching.md","children":[{"type":"text","value":"async batching"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"createAsyncBatcher"}]},{"type":"tableCell","children":[{"type":"