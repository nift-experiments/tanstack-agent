{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Throttling limits how often work runs while calls continue. Choose your framework to see examples for continuous events, rate-controlled values, and lifecycle cleanup."}]},{"type":"heading","depth":2,"id":"choose-your-framework","children":[{"type":"text","value":"Choose your framework"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../framework/vanilla/guides/throttling.md","children":[{"type":"text","value":"Vanilla"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../framework/react/guides/throttling.md","children":[{"type":"text","value":"React"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../framework/preact/guides/throttling.md","children":[{"type":"text","value":"Preact"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../framework/solid/guides/throttling.md","children":[{"type":"text","value":"Solid"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../framework/angular/guides/throttling.md","children":[{"type":"text","value":"Angular"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../framework/vue/guides/throttling.md","children":[{"type":"text","value":"Vue"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../framework/svelte/guides/throttling.md","children":[{"type":"text","value":"Svelte"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../framework/lit/guides/throttling.md","children":[{"type":"text","value":"Lit"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../framework/alpine/guides/throttling.md","children":[{"type":"text"