alue":"abort(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L494","children":[{"type":"text","value":"async-batcher.ts:494"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Aborts all ongoing executions with the internal abort controllers.\nDoes NOT cancel any pending execution that have not started yet.\nDoes NOT clear out the items."}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"additem","children":[{"type":"text","value":"addItem()"}]},{"type":"code","value":"addItem(item): Promise<any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L346","children":[{"type":"text","value":"async-batcher.ts:346"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Adds an item to the async batcher\nIf the batch size is reached, timeout occurs, or shouldProcess returns true, the batch will be processed"}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"item","children":[{"type":"text","value":"item"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The result from the batch function, or undefined if an error occurred and was handled by onError"}]},{"type":"heading","depth":4,"id":"throws","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"The error from the batch function if no onError handler is configured or throwOnError is true"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"cancel","children":[{"type":"text","value":"cancel()"}]},{"type":"code","value":"cancel(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L507","children":[{"type":"text","value":"async-batcher.ts:507"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Cancels any pending execution that have not started yet.\nDoes NOT abort any execution already in progress.\nDoes NOT clear out the items."}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"clear","children":[{"type":"text","value":"clear()"}]},{"type":"code","value":"clear(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L455","children":[{"type":"text","value":"async-batcher.ts:455"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Removes all items from the async batcher"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"flush","children":[{"type":"text","value":"flush()"}]},{"type":"code","value":"flush(): Promise<any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L429","children":[{"type":"text","value":"async-batcher.ts:429"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Processes the current batch of items immediately"}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getabortsignal","children":[{"type":"text","value":"getAbortSignal()"}]},{"type":"code","value":"getAbortSignal(executionCount?): AbortSignal | null;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L483","children":[{"type":"text","value":"async-batcher.ts:483"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns the AbortSignal for a specific execution.\nIf no executionCount is provided, returns the signal for the most recent execution.\nReturns null if no execution is found or not currently executing."}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"executioncount","children":[{"type":"text","value":"executionCount?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"Optional specific execution to get signal for"}]},{"type":"heading","depth":4,"id":"returns-8","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"AbortSignal"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const batcher = new AsyncBatcher(\n  async (items: string[]) => {\n    const signal = batcher.getAbortSignal()\n    if (signal) {\n      const response = await fetch('/api/batch', {\n        method: 'POST',\n        body: JSON.stringify(items),\n        signal\n      })\n      return response.json()\n    }\n  },\n  { maxSize: 10, wait: 100 }\n)","lang":"typescript"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"peekallitems","children":[{"type":"text","value":"peekAllItems()"}]},{"type":"code","value":"peekAllItems(): TValue[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L437","children":[{"type":"text","value":"async-batcher.ts:437"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns a copy of all items in the async batcher"}]},{"type":"heading","depth":4,"id":"returns-9","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":"[]"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"peekfaileditems","children":[{"type":"text","value":"peekFailedItems()"}]},{"type":"code","value":"peekFailedItems(): TValue[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L441","children":[{"type":"text","value":"async-batcher.ts:441"}]}]},{"type":"heading","depth":4,"id":"returns-10","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":"[]"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"reset","children":[{"type":"text","value":"reset()"}]},{"type":"code","value":"reset(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L517","children":[{"type":"text","value":"async-batcher.ts:517"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Resets the async batcher state to its default values"}]},{"type":"heading","depth":4,"id":"returns-11","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setoptions","children":[{"type":"text","value":"setOptions()"}]},{"type":"code","value":"setOptions(newOptions): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L305","children":[{"type":"text","value":"async-batcher.ts:305"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Updates the async batcher options"}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"newoptions","children":[{"type":"text","value":"newOptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/AsyncBatcherOptions.md","children":[{"type":"inlineCode","value":"AsyncBatcherOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>"}]},{"type":"heading","depth":4,"id":"returns-12","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"fn","text":"fn","level":5},{"id":"initialoptions","text":"initialOptions","level":5},{"id":"returns","text":"Returns","level":4},{"id":"properties","text":"Properties","level":2},{"id":"asyncretryers","text":"asyncRetryers","level":3},{"id":"fn-2","text":"fn","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"items","text":"items","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"key","text":"key","level":3},{"id":"options","text":"options","level":3},{"id":"store","text":"store","level":3},{"id":"methods","text":"Methods","level":2},{"id":"abort","text":"abort()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"additem","text":"addItem()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"item","text":"item","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"throws","text":"Throws","level":4},{"id":"cancel","text":"cancel()","level":3},{"id":"returns-5","text":"Returns","level":4},{"id":"clear","text":"clear()","level":3},{"id":"returns-6","text":"Returns","level":4},{"id":"flush","text":"flush()","level":3},{"id":"returns-7","text":"Returns","level":4},{"id":"getabortsignal","text":"getAbortSignal()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"executioncount","text":"executionCount?","level":5},{"id":"returns-8","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"peekallitems","text":"peekAllItems()","level":3},{"id":"returns-9","text":"Returns","level":4},{"id":"peekfaileditems","text":"peekFailedItems()","level":3},{"id":"returns-10","text":"Returns","level":4},{"id":"reset","text":"reset()","level":3},{"id":"returns-11","text":"Returns","level":4},{"id":"setoptions","text":"setOptions()","level":3},{"id":"parameters-5","text":"Parameters","level":4},{"id":"newoptions","text":"newOptions","level":5},{"id":"returns-12","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [async-batcher.ts:265](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L265)\n\nA class that collects items and processes them in batches asynchronously.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync Batcher:\n- Returns promises that can be awaited for batch results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight batch executions\n- Cancel support to prevent pending batches from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n\nThe sync Batcher is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Batching?\nBatching is a technique for grouping multiple operations together to be processed as a single unit.\n\nThe AsyncBatcher provides a flexible way to implement async batching with configurable:\n- Maximum batch size (number of items per batch)\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n- Error handling for failed batch operations\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error, the batch of items that failed, and batcher instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the AsyncBatcher instance\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async batcher\n- Use `onSuccess` callback to react to successful batch execution and implement custom logic\n- Use `onError` callback to react to batch execution errors and implement custom error handling\n- Use `onSettled` callback to react to batch execution completion (success or error) and implement custom logic\n- Use `onExecute` callback to react to batch execution and implement custom logic\n- Use `onItemsChange` callback to react to items being added or removed from the batcher\n- The state includes total items processed, success/error counts, and execution status\n- State can be accessed via `asyncBatcher.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `asyncBatcher.state`\n\n## Example\n\n```ts\nconst batcher = new AsyncBatcher<number>(\n  async (items) => {\n    const result = await processItems(items);\n    console.log('Processing batch:', items);\n    return result;\n  },\n  {\n    maxSize: 5,\n    wait: 2000,\n    onSuccess: (result) => console.log('Batch succeeded:', result),\n    onError: (error) => console.error('Batch failed:', error)\n  }\n);\n\nbatcher.addItem(1);\nbatcher.addItem(2);\n// After 2 seconds or when 5 items are added, whichever comes first,\n// the batch will be processed and the result will be available\n// batcher.execute() // manually trigger a batch\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew AsyncBatcher<TValue>(fn, initialOptions): AsyncBatcher<TValue>;\n```\n\nDefined in: [async-batcher.ts:277](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L277)\n\n#### Parameters\n\n##### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n##### initialOptions\n\n[`AsyncBatcherOptions`](../interfaces/AsyncBatcherOptions.md)\\<`TValue`\\>\n\n#### Returns\n\n`AsyncBatcher`\\<`TValue`\\>\n\n## Properties\n\n### asyncRetryers\n\n```ts\nasyncRetryers: Map<number, AsyncRetryer<(items) => Promise<any>>>;\n```\n\nDefined in: [async-batcher.ts:271](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L271)\n\n***\n\n### fn\n\n```ts\nfn: (items) => Promise<any>;\n```\n\nDefined in: [async-batcher.ts:278](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L278)\n\n#### Parameters\n\n##### items\n\n`TValue`[]\n\n#### Returns\n\n`Promise`\\<`any`\\>\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [async-batcher.ts:269](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L269)\n\n***\n\n### options\n\n```ts\noptions: AsyncBatcherOptionsWithOptionalCallbacks<TValue>;\n```\n\nDefined in: [async-batcher.ts:270](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L270)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<AsyncBatcherState<TValue>>>;\n```\n\nDefined in: [async-batcher.ts:266](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L266)\n\n## Methods\n\n### abort()\n\n```ts\nabort(): void;\n```\n\nDefined in: [async-batcher.ts:494](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L494)\n\nAborts all ongoing executions with the internal abort controllers.\nDoes NOT cancel any pending execution that have not started yet.\nDoes NOT clear out the items.\n\n#### Returns\n\n`void`\n\n***\n\n### addItem()\n\n```ts\naddItem(item): Promise<any>;\n```\n\nDefined in: [async-batcher.ts:346](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L346)\n\nAdds an item to the async batcher\nIf the batch size is reached, timeout occurs, or shouldProcess returns true, the batch will be processed\n\n#### Parameters\n\n##### item\n\n`TValue`\n\n#### Returns\n\n`Promise`\\<`any`\\>\n\nThe result from the batch function, or undefined if an error occurred and was handled by onError\n\n#### Throws\n\nThe error from the batch function if no onError handler is configured or throwOnError is true\n\n***\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [async-batcher.ts:507](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L507)\n\nCancels any pending execution that have not started yet.\nDoes NOT abort any execution already in progress.\nDoes NOT clear out the items.\n\n#### Returns\n\n`void`\n\n***\n\n### clear()\n\n```ts\nclear(): void;\n```\n\nDefined in: [async-batcher.ts:455](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L455)\n\nRemoves all items from the async batcher\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): Promise<any>;\n```\n\nDefined in: [async-batcher.ts:429](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L429)\n\nProcesses the current batch of items immediately\n\n#### Returns\n\n`Promise`\\<`any`\\>\n\n***\n\n### getAbortSignal()\n\n```ts\ngetAbortSignal(executionCount?): AbortSignal | null;\n```\n\nDefined in: [async-batcher.ts:483](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L483)\n\nReturns the AbortSignal for a specific execution.\nIf no executionCount is provided, returns the signal for the most recent execution.\nReturns null if no execution is found or not currently executing.\n\n#### Parameters\n\n##### executionCount?\n\n`number`\n\nOptional specific execution to get signal for\n\n#### Returns\n\n`AbortSignal` \\| `null`\n\n#### Example\n\n```typescript\nconst batcher = new AsyncBatcher(\n  async (items: string[]) => {\n    const signal = batcher.getAbortSignal()\n    if (signal) {\n      const response = await fetch('/api/batch', {\n        method: 'POST',\n        body: JSON.stringify(items),\n        signal\n      })\n      return response.json()\n    }\n  },\n  { maxSize: 10, wait: 100 }\n)\n```\n\n***\n\n### peekAllItems()\n\n```ts\npeekAllItems(): TValue[];\n```\n\nDefined in: [async-batcher.ts:437](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L437)\n\nReturns a copy of all items in the async batcher\n\n#### Returns\n\n`TValue`[]\n\n***\n\n### peekFailedItems()\n\n```ts\npeekFailedItems(): TValue[];\n```\n\nDefined in: [async-batcher.ts:441](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L441)\n\n#### Returns\n\n`TValue`[]\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [async-batcher.ts:517](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L517)\n\nResets the async batcher state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [async-batcher.ts:305](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L305)\n\nUpdates the async batcher options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`AsyncBatcherOptions`](../interfaces/AsyncBatcherOptions.md)\\<`TValue`\\>\\>\n\n#### Returns\n\n`void`\n","originalRawMarkdown":"---\nid: AsyncBatcher\ntitle: AsyncBatcher\n---\n\nDefined in: [async-batcher.ts:265](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L265)\n\nA class that collects items and processes them in batches asynchronously.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync Batcher:\n- Returns promises that can be awaited for batch results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight batch executions\n- Cancel support to prevent pending batches from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n\nThe sync Batcher is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Batching?\nBatching is a technique for grouping multiple operations together to be processed as a single unit.\n\nThe AsyncBatcher provides a flexible way to implement async batching with configurable:\n- Maximum batch size (number of items per batch)\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n- Error handling for failed batch operations\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error, the batch of items that failed, and batcher instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the AsyncBatcher instance\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async batcher\n- Use `onSuccess` callback to react to successful batch execution and implement custom logic\n- Use `onError` callback to react to batch execution errors and implement custom error handling\n- Use `onSettled` callback to react to batch execution completion (success or error) and implement custom logic\n- Use `onExecute` callback to react to batch execution and implement custom logic\n- Use `onItemsChange` callback to react to items being added or removed from the batcher\n- The state includes total items processed, success/error counts, and execution status\n- State can be accessed via `asyncBatcher.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `asyncBatcher.state`\n\n## Example\n\n```ts\nconst batcher = new AsyncBatcher<number>(\n  async (items) => {\n    const result = await processItems(items);\n    console.log('Processing batch:', items);\n    return result;\n  },\n  {\n    maxSize: 5,\n    wait: 2000,\n    onSuccess: (result) => console.log('Batch succeeded:', result),\n    onError: (error) => console.error('Batch failed:', error)\n  }\n);\n\nbatcher.addItem(1);\nbatcher.addItem(2);\n// After 2 seconds or when 5 items are added, whichever comes first,\n// the batch will be processed and the result will be available\n// batcher.execute() // manually trigger a batch\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew AsyncBatcher<TValue>(fn, initialOptions): AsyncBatcher<TValue>;\n```\n\nDefined in: [async-batcher.ts:277](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L277)\n\n#### Parameters\n\n##### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n##### initialOptions\n\n[`AsyncBatcherOptions`](../interfaces/AsyncBatcherOptions.md)\\<`TValue`\\>\n\n#### Returns\n\n`AsyncBatcher`\\<`TValue`\\>\n\n## Properties\n\n### asyncRetryers\n\n```ts\nasyncRetryers: Map<number, AsyncRetryer<(items) => Promise<any>>>;\n```\n\nDefined in: [async-batcher.ts:271](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L271)\n\n***\n\n### fn\n\n```ts\nfn: (items) => Promise<any>;\n```\n\nDefined in: [async-batcher.ts:278](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L278)\n\n#### Parameters\n\n##### items\n\n`TValue`[]\n\n#### Returns\n\n`Promise`\\<`any`\\>\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [async-batcher.ts:269](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L269)\n\n***\n\n### options\n\n```ts\noptions: AsyncBatcherOptionsWithOptionalCallbacks<TValue>;\n```\n\nDefined in: [async-batcher.ts:270](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L270)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<AsyncBatcherState<TValue>>>;\n```\n\nDefined in: [async-batcher.ts:266](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L266)\n\n## Methods\n\n### abort()\n\n```ts\nabort(): void;\n```\n\nDefined in: [async-batcher.ts:494](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L494)\n\nAborts all ongoing executions with the internal abort controllers.\nDoes NOT cancel any pending execution that have not started yet.\nDoes NOT clear out the items.\n\n#### Returns\n\n`void`\n\n***\n\n### addItem()\n\n```ts\naddItem(item): Promise<any>;\n```\n\nDefined in: [async-batcher.ts:346](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L346)\n\nAdds an item to the async batcher\nIf the batch size is reached, timeout occurs, or shouldProcess returns true, the batch will be processed\n\n#### Parameters\n\n##### item\n\n`TValue`\n\n#### Returns\n\n`Promise`\\<`any`\\>\n\nThe result from the batch function, or undefined if an error occurred and was handled by onError\n\n#### Throws\n\nThe error from the batch function if no onError handler is configured or throwOnError is true\n\n***\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [async-batcher.ts:507](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L507)\n\nCancels any pending execution that have not started yet.\nDoes NOT abort any execution already in progress.\nDoes NOT clear out the items.\n\n#### Returns\n\n`void`\n\n***\n\n### clear()\n\n```ts\nclear(): void;\n```\n\nDefined in: [async-batcher.ts:455](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L455)\n\nRemoves all items from the async batcher\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): Promise<any>;\n```\n\nDefined in: [async-batcher.ts:429](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L429)\n\nProcesses the current batch of items immediately\n\n#### Returns\n\n`Promise`\\<`any`\\>\n\n***\n\n### getAbortSignal()\n\n```ts\ngetAbortSignal(executionCount?): AbortSignal | null;\n```\n\nDefined in: [async-batcher.ts:483](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L483)\n\nReturns the AbortSignal for a specific execution.\nIf no executionCount is provided, returns the signal for the most recent execution.\nReturns null if no execution is found or not currently executing.\n\n#### Parameters\n\n##### executionCount?\n\n`number`\n\nOptional specific execution to get signal for\n\n#### Returns\n\n`AbortSignal` \\| `null`\n\n#### Example\n\n```typescript\nconst batcher = new AsyncBatcher(\n  async (items: string[]) => {\n    const signal = batcher.getAbortSignal()\n    if (signal) {\n      const response = await fetch('/api/batch', {\n        method: 'POST',\n        body: JSON.stringify(items),\n        signal\n      })\n      return response.json()\n    }\n  },\n  { maxSize: 10, wait: 100 }\n)\n```\n\n***\n\n### peekAllItems()\n\n```ts\npeekAllItems(): TValue[];\n```\n\nDefined in: [async-batcher.ts:437](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L437)\n\nReturns a copy of all items in the async batcher\n\n#### Returns\n\n`TValue`[]\n\n***\n\n### peekFailedItems()\n\n```ts\npeekFailedItems(): TValue[];\n```\n\nDefined in: [async-batcher.ts:441](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L441)\n\n#### Returns\n\n`TValue`[]\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [async-batcher.ts:517](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L517)\n\nResets the async batcher state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [async-batcher.ts:305](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L305)\n\nUpdates the async batcher options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`AsyncBatcherOptions`](../interfaces/AsyncBatcherOptions.md)\\<`TValue`\\>\\>\n\n#### Returns\n\n`void`\n"}
