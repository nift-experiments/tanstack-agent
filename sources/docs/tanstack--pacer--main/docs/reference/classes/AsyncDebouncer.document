n/packages/pacer/src/async-debouncer.ts#L230","children":[{"type":"text","value":"async-debouncer.ts:230"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"key","children":[{"type":"text","value":"key"}]},{"type":"code","value":"key: string | undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L222","children":[{"type":"text","value":"async-debouncer.ts:222"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"code","value":"options: AsyncDebouncerOptions<TFn>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L223","children":[{"type":"text","value":"async-debouncer.ts:223"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"store","children":[{"type":"text","value":"store"}]},{"type":"code","value":"readonly store: Store<Readonly<AsyncDebouncerState<TFn>>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L219","children":[{"type":"text","value":"async-debouncer.ts:219"}]}]},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"abort","children":[{"type":"text","value":"abort()"}]},{"type":"code","value":"abort(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L470","children":[{"type":"text","value":"async-debouncer.ts:470"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Aborts all ongoing executions with the internal abort controllers.\nDoes NOT cancel any pending execution that have not started yet."}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"cancel","children":[{"type":"text","value":"cancel()"}]},{"type":"code","value":"cancel(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L482","children":[{"type":"text","value":"async-debouncer.ts:482"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Cancels any pending execution that have not started yet.\nDoes NOT abort any execution already in progress."}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"flush","children":[{"type":"text","value":"flush()"}]},{"type":"code","value":"flush(): Promise<Awaited<ReturnType<TFn>> | undefined>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L405","children":[{"type":"text","value":"async-debouncer.ts:405"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Processes the current pending execution immediately"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Awaited"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReturnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">> | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getabortsignal","children":[{"type":"text","value":"getAbortSignal()"}]},{"type":"code","value":"getAbortSignal(maybeExecuteCount?): AbortSignal | null;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L460","children":[{"type":"text","value":"async-debouncer.ts:460"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns the AbortSignal for a specific execution.\nIf no maybeExecuteCount is provided, returns the signal for the most recent execution.\nReturns null if no execution is found or not currently executing."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"maybeexecutecount","children":[{"type":"text","value":"maybeExecuteCount?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"Optional specific execution to get signal for"}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"AbortSignal"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const debouncer = new AsyncDebouncer(\n  async (searchTerm: string) => {\n    const signal = debouncer.getAbortSignal()\n    if (signal) {\n      const response = await fetch(`/api/search?q=${searchTerm}`, { signal })\n      return response.json()\n    }\n  },\n  { wait: 300 }\n)","lang":"typescript"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"maybeexecute","children":[{"type":"text","value":"maybeExecute()"}]},{"type":"code","value":"maybeExecute(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L317","children":[{"type":"text","value":"async-debouncer.ts:317"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Attempts to execute the debounced function.\nIf a call is already in progress, it will be queued."}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If the debounced function throws and no "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is configured,\nthe error will be thrown from this method."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is configured, errors will be caught and passed to the handler,\nand this method will return undefined."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using "},{"type":"inlineCode","value":"getErrorCount()"},{"type":"text","value":" and "},{"type":"inlineCode","value":"getIsExecuting()"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"text","value":"..."},{"type":"inlineCode","value":"Parameters"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Awaited"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReturnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">> | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise that resolves with the function's return value, or undefined if an error occurred and was handled by onError"}]},{"type":"heading","depth":4,"id":"throws","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"The error from the debounced function if no onError handler is configured"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"reset","children":[{"type":"text","value":"reset()"}]},{"type":"code","value":"reset(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L490","children":[{"type":"text","value":"async-debouncer.ts:490"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Resets the debouncer state to its default values"}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setoptions","children":[{"type":"text","value":"setOptions()"}]},{"type":"code","value":"setOptions(newOptions): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L257","children":[{"type":"text","value":"async-debouncer.ts:257"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Updates the async debouncer options"}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"newoptions","children":[{"type":"text","value":"newOptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/AsyncDebouncerOptions.md","children":[{"type":"inlineCode","value":"AsyncDebouncerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">>"}]},{"type":"heading","depth":4,"id":"returns-8","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"fn","text":"fn","level":5},{"id":"initialoptions","text":"initialOptions","level":5},{"id":"returns","text":"Returns","level":4},{"id":"properties","text":"Properties","level":2},{"id":"asyncretryers","text":"asyncRetryers","level":3},{"id":"fn-2","text":"fn","level":3},{"id":"key","text":"key","level":3},{"id":"options","text":"options","level":3},{"id":"store","text":"store","level":3},{"id":"methods","text":"Methods","level":2},{"id":"abort","text":"abort()","level":3},{"id":"returns-2","text":"Returns","level":4},{"id":"cancel","text":"cancel()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"flush","text":"flush()","level":3},{"id":"returns-4","text":"Returns","level":4},{"id":"getabortsignal","text":"getAbortSignal()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"maybeexecutecount","text":"maybeExecuteCount?","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"maybeexecute","text":"maybeExecute()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"args","text":"args","level":5},{"id":"returns-6","text":"Returns","level":4},{"id":"throws","text":"Throws","level":4},{"id":"reset","text":"reset()","level":3},{"id":"returns-7","text":"Returns","level":4},{"id":"setoptions","text":"setOptions()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"newoptions","text":"newOptions","level":5},{"id":"returns-8","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [async-debouncer.ts:218](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L218)\n\nA class that creates an async debounced function.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync Debouncer:\n- Returns promises that can be awaited for debounced function results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight executions\n- Cancel support to prevent pending executions from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n\nThe sync Debouncer is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Debouncing?\nDebouncing ensures that a function is only executed after a specified delay has passed since its last invocation.\nEach new invocation resets the delay timer. This is useful for handling frequent events like window resizing\nor input changes where you only want to execute the handler after the events have stopped occurring.\n\nUnlike throttling which allows execution at regular intervals, debouncing prevents any execution until\nthe function stops being called for the specified delay period.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and debouncer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying store\n\nState Management:\n- The debouncer uses a reactive store for state management\n- Use `initialState` to provide initial state values when creating the async debouncer\n- The state includes canLeadingExecute, error count, execution status, and success/settle counts\n- State can be accessed via the `store` property and its `state` getter\n- The store is reactive and will notify subscribers of state changes\n\n## Example\n\n```ts\nconst asyncDebouncer = new AsyncDebouncer(async (value: string) => {\n  const results = await searchAPI(value);\n  return results; // Return value is preserved\n}, {\n  wait: 500,\n  onError: (error) => {\n    console.error('Search failed:', error);\n  }\n});\n\n// Called on each keystroke but only executes after 500ms of no typing\n// Returns the API response directly\nconst results = await asyncDebouncer.maybeExecute(inputElement.value);\n```\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyAsyncFunction`](../type-aliases/AnyAsyncFunction.md)\n\n## Constructors\n\n### Constructor\n\n```ts\nnew AsyncDebouncer<TFn>(fn, initialOptions): AsyncDebouncer<TFn>;\n```\n\nDefined in: [async-debouncer.ts:229](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L229)\n\n#### Parameters\n\n##### fn\n\n`TFn`\n\n##### initialOptions\n\n[`AsyncDebouncerOptions`](../interfaces/AsyncDebouncerOptions.md)\\<`TFn`\\>\n\n#### Returns\n\n`AsyncDebouncer`\\<`TFn`\\>\n\n## Properties\n\n### asyncRetryers\n\n```ts\nasyncRetryers: Map<number, AsyncRetryer<TFn>>;\n```\n\nDefined in: [async-debouncer.ts:224](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L224)\n\n***\n\n### fn\n\n```ts\nfn: TFn;\n```\n\nDefined in: [async-debouncer.ts:230](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L230)\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [async-debouncer.ts:222](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L222)\n\n***\n\n### options\n\n```ts\noptions: AsyncDebouncerOptions<TFn>;\n```\n\nDefined in: [async-debouncer.ts:223](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L223)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<AsyncDebouncerState<TFn>>>;\n```\n\nDefined in: [async-debouncer.ts:219](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L219)\n\n## Methods\n\n### abort()\n\n```ts\nabort(): void;\n```\n\nDefined in: [async-debouncer.ts:470](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L470)\n\nAborts all ongoing executions with the internal abort controllers.\nDoes NOT cancel any pending execution that have not started yet.\n\n#### Returns\n\n`void`\n\n***\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [async-debouncer.ts:482](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L482)\n\nCancels any pending execution that have not started yet.\nDoes NOT abort any execution already in progress.\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-debouncer.ts:405](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L405)\n\nProcesses the current pending execution immediately\n\n#### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\n***\n\n### getAbortSignal()\n\n```ts\ngetAbortSignal(maybeExecuteCount?): AbortSignal | null;\n```\n\nDefined in: [async-debouncer.ts:460](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L460)\n\nReturns the AbortSignal for a specific execution.\nIf no maybeExecuteCount is provided, returns the signal for the most recent execution.\nReturns null if no execution is found or not currently executing.\n\n#### Parameters\n\n##### maybeExecuteCount?\n\n`number`\n\nOptional specific execution to get signal for\n\n#### Returns\n\n`AbortSignal` \\| `null`\n\n#### Example\n\n```typescript\nconst debouncer = new AsyncDebouncer(\n  async (searchTerm: string) => {\n    const signal = debouncer.getAbortSignal()\n    if (signal) {\n      const response = await fetch(`/api/search?q=${searchTerm}`, { signal })\n      return response.json()\n    }\n  },\n  { wait: 300 }\n)\n```\n\n***\n\n### maybeExecute()\n\n```ts\nmaybeExecute(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-debouncer.ts:317](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L317)\n\nAttempts to execute the debounced function.\nIf a call is already in progress, it will be queued.\n\nError Handling:\n- If the debounced function throws and no `onError` handler is configured,\n  the error will be thrown from this method.\n- If an `onError` handler is configured, errors will be caught and passed to the handler,\n  and this method will return undefined.\n- The error state can be checked using `getErrorCount()` and `getIsExecuting()`.\n\n#### Parameters\n\n##### args\n\n...`Parameters`\\<`TFn`\\>\n\n#### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\nA promise that resolves with the function's return value, or undefined if an error occurred and was handled by onError\n\n#### Throws\n\nThe error from the debounced function if no onError handler is configured\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [async-debouncer.ts:490](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L490)\n\nResets the debouncer state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [async-debouncer.ts:257](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L257)\n\nUpdates the async debouncer options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`AsyncDebouncerOptions`](../interfaces/AsyncDebouncerOptions.md)\\<`TFn`\\>\\>\n\n#### Returns\n\n`void`\n","originalRawMarkdown":"---\nid: AsyncDebouncer\ntitle: AsyncDebouncer\n---\n\nDefined in: [async-debouncer.ts:218](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L218)\n\nA class that creates an async debounced function.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync Debouncer:\n- Returns promises that can be awaited for debounced function results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight executions\n- Cancel support to prevent pending executions from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n\nThe sync Debouncer is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Debouncing?\nDebouncing ensures that a function is only executed after a specified delay has passed since its last invocation.\nEach new invocation resets the delay timer. This is useful for handling frequent events like window resizing\nor input changes where you only want to execute the handler after the events have stopped occurring.\n\nUnlike throttling which allows execution at regular intervals, debouncing prevents any execution until\nthe function stops being called for the specified delay period.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and debouncer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying store\n\nState Management:\n- The debouncer uses a reactive store for state management\n- Use `initialState` to provide initial state values when creating the async debouncer\n- The state includes canLeadingExecute, error count, execution status, and success/settle counts\n- State can be accessed via the `store` property and its `state` getter\n- The store is reactive and will notify subscribers of state changes\n\n## Example\n\n```ts\nconst asyncDebouncer = new AsyncDebouncer(async (value: string) => {\n  const results = await searchAPI(value);\n  return results; // Return value is preserved\n}, {\n  wait: 500,\n  onError: (error) => {\n    console.error('Search failed:', error);\n  }\n});\n\n// Called on each keystroke but only executes after 500ms of no typing\n// Returns the API response directly\nconst results = await asyncDebouncer.maybeExecute(inputElement.value);\n```\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyAsyncFunction`](../type-aliases/AnyAsyncFunction.md)\n\n## Constructors\n\n### Constructor\n\n```ts\nnew AsyncDebouncer<TFn>(fn, initialOptions): AsyncDebouncer<TFn>;\n```\n\nDefined in: [async-debouncer.ts:229](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L229)\n\n#### Parameters\n\n##### fn\n\n`TFn`\n\n##### initialOptions\n\n[`AsyncDebouncerOptions`](../interfaces/AsyncDebouncerOptions.md)\\<`TFn`\\>\n\n#### Returns\n\n`AsyncDebouncer`\\<`TFn`\\>\n\n## Properties\n\n### asyncRetryers\n\n```ts\nasyncRetryers: Map<number, AsyncRetryer<TFn>>;\n```\n\nDefined in: [async-debouncer.ts:224](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L224)\n\n***\n\n### fn\n\n```ts\nfn: TFn;\n```\n\nDefined in: [async-debouncer.ts:230](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L230)\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [async-debouncer.ts:222](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L222)\n\n***\n\n### options\n\n```ts\noptions: AsyncDebouncerOptions<TFn>;\n```\n\nDefined in: [async-debouncer.ts:223](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L223)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<AsyncDebouncerState<TFn>>>;\n```\n\nDefined in: [async-debouncer.ts:219](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L219)\n\n## Methods\n\n### abort()\n\n```ts\nabort(): void;\n```\n\nDefined in: [async-debouncer.ts:470](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L470)\n\nAborts all ongoing executions with the internal abort controllers.\nDoes NOT cancel any pending execution that have not started yet.\n\n#### Returns\n\n`void`\n\n***\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [async-debouncer.ts:482](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L482)\n\nCancels any pending execution that have not started yet.\nDoes NOT abort any execution already in progress.\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-debouncer.ts:405](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L405)\n\nProcesses the current pending execution immediately\n\n#### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\n***\n\n### getAbortSignal()\n\n```ts\ngetAbortSignal(maybeExecuteCount?): AbortSignal | null;\n```\n\nDefined in: [async-debouncer.ts:460](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L460)\n\nReturns the AbortSignal for a specific execution.\nIf no maybeExecuteCount is provided, returns the signal for the most recent execution.\nReturns null if no execution is found or not currently executing.\n\n#### Parameters\n\n##### maybeExecuteCount?\n\n`number`\n\nOptional specific execution to get signal for\n\n#### Returns\n\n`AbortSignal` \\| `null`\n\n#### Example\n\n```typescript\nconst debouncer = new AsyncDebouncer(\n  async (searchTerm: string) => {\n    const signal = debouncer.getAbortSignal()\n    if (signal) {\n      const response = await fetch(`/api/search?q=${searchTerm}`, { signal })\n      return response.json()\n    }\n  },\n  { wait: 300 }\n)\n```\n\n***\n\n### maybeExecute()\n\n```ts\nmaybeExecute(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-debouncer.ts:317](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L317)\n\nAttempts to execute the debounced function.\nIf a call is already in progress, it will be queued.\n\nError Handling:\n- If the debounced function throws and no `onError` handler is configured,\n  the error will be thrown from this method.\n- If an `onError` handler is configured, errors will be caught and passed to the handler,\n  and this method will return undefined.\n- The error state can be checked using `getErrorCount()` and `getIsExecuting()`.\n\n#### Parameters\n\n##### args\n\n...`Parameters`\\<`TFn`\\>\n\n#### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\nA promise that resolves with the function's return value, or undefined if an error occurred and was handled by onError\n\n#### Throws\n\nThe error from the debounced function if no onError handler is configured\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [async-debouncer.ts:490](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L490)\n\nResets the debouncer state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [async-debouncer.ts:257](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L257)\n\nUpdates the async debouncer options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`AsyncDebouncerOptions`](../interfaces/AsyncDebouncerOptions.md)\\<`TFn`\\>\\>\n\n#### Returns\n\n`void`\n"}
