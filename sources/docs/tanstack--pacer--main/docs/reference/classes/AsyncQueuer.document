NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-queuer.ts#L315","children":[{"type":"text","value":"async-queuer.ts:315"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A flexible asynchronous queue for processing tasks with configurable concurrency, priority, and expiration."}]},{"type":"paragraph","children":[{"type":"text","value":"Async vs Sync Versions:\nThe async version provides advanced features over the sync Queuer:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Returns promises that can be awaited for task results"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Built-in retry support via AsyncRetryer integration for each queued task"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Abort support to cancel in-flight task executions"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Comprehensive error handling with onError callbacks and throwOnError control"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Detailed execution tracking (success/error/settle counts)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Concurrent execution support (process multiple items simultaneously)"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The sync Queuer is lighter weight and simpler when you don't need async features,\nreturn values, or execution control."}]},{"type":"paragraph","children":[{"type":"text","value":"What is Queuing?\nQueuing is a technique for managing and processing items sequentially or with controlled concurrency.\nTasks are processed up to the configured concurrency limit. When a task completes,\nthe next pending task is processed if the concurrency limit allows."}]},{"type":"paragraph","children":[{"type":"text","value":"Key Features:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Priority queue support via the getPriority option"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Configurable concurrency limit"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Callbacks for task success, error, completion, and queue state changes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"FIFO (First In First Out) or LIFO (Last In First Out) queue behavior"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Pause and resume processing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Item expiration to remove stale items from the queue"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is provided, it will be called with the error and queuer instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together; the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the AsyncQueuer instance"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"State Management:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Uses TanStack Store for reactive state management"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" to provide initial state values when creating the async queuer"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" callback to react to successful task execution and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" callback to react to task execution errors and implement custom error handling"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callback to react to task execution completion (success or error) and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onItemsChange"},{"type":"text","value":" callback to react to items being added or removed from the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onExpire"},{"type":"text","value":" callback to react to items expiring and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onReject"},{"type":"text","value":" callback to react to items being rejected when the queue is full"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state includes error count, expiration count, rejection count, running status, and success/settle counts"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"State can be accessed via "},{"type":"inlineCode","value":"asyncQueuer.store.state"},{"type":"text","value":" when using the class directly"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When using framework adapters (React/Solid), state is accessed from "},{"type":"inlineCode","value":"asyncQueuer.state"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Example usage:"}]},{"type":"code","value":"const asyncQueuer = new AsyncQueuer<string>(async (item) => {\n  // process item\n  return item.toUpperCase();\n}, {\n  concurrency: 2,\n  onSuccess: (result) => {\n    console.log(result);\n  }\n});\n\nasyncQueuer.addItem('hello');\nasyncQueuer.start();","lang":"ts"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,"id":"constructor","children":[{"type":"text","value":"Constructor"}]},{"type":"code","value":"new AsyncQueuer<TValue>(fn, initialOptions?): AsyncQueuer<TValue>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-queuer.ts#L327","children":[{