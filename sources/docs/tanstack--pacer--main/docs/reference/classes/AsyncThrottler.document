only one execution within a specified time window.\nUnlike debouncing which resets the delay timer on each call, throttling ensures the function executes at a\nregular interval regardless of how often it's called."}]},{"type":"paragraph","children":[{"type":"text","value":"This is useful for rate-limiting API calls, handling scroll/resize events, or any scenario where you want to\nensure a maximum execution frequency."}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is provided, it will be called with the error and throttler instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together - the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncThrottler instance"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"State Management:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Uses TanStack Store for reactive state management"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" to provide initial state values when creating the async throttler"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" callback to react to successful function execution and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" callback to react to function execution errors and implement custom error handling"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callback to react to function execution completion (success or error) and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state includes error count, execution status, last execution time, and success/settle counts"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"State can be accessed via "},{"type":"inlineCode","value":"asyncThrottler.store.state"},{"type":"text","value":" when using the class directly"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When using framework adapters (React/Solid), state is accessed from "},{"type":"inlineCode","value":"asyncThrottler.state"}]}]}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const throttler = new AsyncThrottler(async (value: string) => {\n  const result = await saveToAPI(value);\n  return result; // Return value is preserved\n}, {\n  wait: 1000,\n  onError: (error) => {\n    console.error('API call failed:', error);\n  }\n});\n\n// Will only execute once per second no matter how often called\n// Returns the API response directly\nconst result = await throttler.maybeExecute(inputElement.value);","lang":"ts"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/AnyAsyncFunction.md","children":[{"type":"inlineCode","value":"AnyAsyncFunction"}]}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,"id":"constructor","children":[{"type":"text","value":"Constructor"}]},{"type":"code","value":"new AsyncThrottler<TFn>(fn, initialOptions): AsyncThrottler<TFn>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L241","children":[{"type":"text","value":"async-throttler.ts:241"}]}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":5,"id":"initialoptions","children":[{"type":"text","value":"initialOptions"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/AsyncThrottlerOptions.md","children":[{"type":"inlineCode","value":"AsyncThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"AsyncThrottler"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"asyncretryers","children":[{"type":"text","value":"asyncRetryers"}]},{"type":"code","value":"asyncRetryers: Map<number, AsyncRetryer<TFn>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L236","children":[{"type":"text","value":"async-throttler.ts:236"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"fn-2","children":[{"type":"text","value":"fn"}]},{"type":"code","value":"fn: TFn;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L242","children":[{"type":"text","value":"async-throttler.ts:242"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"key","children":[{"type":"text","value":"key"}]},{"type":"code","value":"key: string | undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L234","children":[{"type":"text","value":"async-throttler.ts:234"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"code","value":"options: AsyncThrottlerOptions<TFn>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L235","children":[{"type":"text","value":"async-throttler.ts:235"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"store","children":[{"type":"text","value":"store"}]},{"type":"code","value":"readonly store: Store<Readonly<AsyncThrottlerState<TFn>>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L231","children":[{"type":"text","value":"async-throttler.ts:231"}]}]},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"abort","children":[{"type":"text","value":"abort()"}]},{"type":"code","value":"abort(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L534","children":[{"type":"text","value":"async-throttler.ts:534"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Aborts all ongoing executions with the internal abort controllers.\nDoes NOT cancel any pending execution that have not started yet."}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"cancel","children":[{"type":"text","value":"cancel()"}]},{"type":"code","value":"cancel(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L544","children":[{"type":"text","value":"async-throttler.ts:544"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Cancels any pending execution that have not started yet.\nDoes NOT abort any execution already in progress."}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"flush","children":[{"type":"text","value":"flush()"}]},{"type":"code","value":"flush(): Promise<Awaited<ReturnType<TFn>> | undefined>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L463","children":[{"type":"text","value":"async-throttler.ts:463"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Processes the current pending execution immediately"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Awaited"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReturnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">> | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getabortsignal","children":[{"type":"text","value":"getAbortSignal()"}]},{"type":"code","value":"getAbortSignal(maybeExecuteCount?): AbortSignal | null;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L524","children":[{"type":"text","value":"async-throttler.ts:524"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns the AbortSignal for a specific execution.\nIf no maybeExecuteCount is provided, returns the signal for the most recent execution.\nReturns null if no execution is found or not currently executing."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"maybeexecutecount","children":[{"type":"text","value":"maybeExecuteCount?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"Optional specific execution to get signal for"}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"AbortSignal"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const throttler = new AsyncThrottler(\n  async (data: string) => {\n    const signal = throttler.getAbortSignal()\n    if (signal) {\n      const response = await fetch('/api/save', {\n        method: 'POST',\n        body: data,\n        signal\n      })\n      return response.json()\n    }\n  },\n  { wait: 1000 }\n)","lang":"typescript"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"maybeexecute","children":[{"type":"text","value":"maybeExecute()"}]},{"type":"code","value":"maybeExecute(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L337","children":[{"type":"text","value":"async-throttler.ts:337"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Attempts to execute the throttled function. The execution behavior depends on the throttler options:"}]},{"type":"list","ordered":false,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If enough time has passed since the last execution (>= wait period):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With leading=true: Executes immediately"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With leading=false: Waits for the next trailing execution"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If within the wait period:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With trailing=true: Schedules execution for end of wait period"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With trailing=false: Drops the execution"}]}]}]}]}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"text","value":"..."},{"type":"inlineCode","value":"Parameters"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Awaited"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReturnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">> | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const throttled = new AsyncThrottler(fn, { wait: 1000 });\n\n// First call executes immediately\nawait throttled.maybeExecute('a', 'b');\n\n// Call during wait period - gets throttled\nawait throttled.maybeExecute('c', 'd');","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"reset","children":[{"type":"text","value":"reset()"}]},{"type":"code","value":"reset(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L558","children":[{"type":"text","value":"async-throttler.ts:558"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Resets the debouncer state to its default values"}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setoptions","children":[{"type":"text","value":"setOptions()"}]},{"type":"code","value":"setOptions(newOptions): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L269","children":[{"type":"text","value":"async-throttler.ts:269"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Updates the async throttler options"}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"newoptions","children":[{"type":"text","value":"newOptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/AsyncThrottlerOptions.md","children":[{"type":"inlineCode","value":"AsyncThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">>"}]},{"type":"heading","depth":4,"id":"returns-8","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"fn","text":"fn","level":5},{"id":"initialoptions","text":"initialOptions","level":5},{"id":"returns","text":"Returns","level":4},{"id":"properties","text":"Properties","level":2},{"id":"asyncretryers","text":"asyncRetryers","level":3},{"id":"fn-2","text":"fn","level":3},{"id":"key","text":"key","level":3},{"id":"options","text":"options","level":3},{"id":"store","text":"store","level":3},{"id":"methods","text":"Methods","level":2},{"id":"abort","text":"abort()","level":3},{"id":"returns-2","text":"Returns","level":4},{"id":"cancel","text":"cancel()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"flush","text":"flush()","level":3},{"id":"returns-4","text":"Returns","level":4},{"id":"getabortsignal","text":"getAbortSignal()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"maybeexecutecount","text":"maybeExecuteCount?","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"maybeexecute","text":"maybeExecute()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"args","text":"args","level":5},{"id":"returns-6","text":"Returns","level":4},{"id":"example-3","text":"Example","level":4},{"id":"reset","text":"reset()","level":3},{"id":"returns-7","text":"Returns","level":4},{"id":"setoptions","text":"setOptions()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"newoptions","text":"newOptions","level":5},{"id":"returns-8","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [async-throttler.ts:230](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L230)\n\nA class that creates an async throttled function.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync Throttler:\n- Returns promises that can be awaited for throttled function results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight executions\n- Cancel support to prevent pending executions from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n- Waits for ongoing executions to complete before scheduling the next one\n\nThe sync Throttler is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Throttling?\nThrottling limits how often a function can be executed, allowing only one execution within a specified time window.\nUnlike debouncing which resets the delay timer on each call, throttling ensures the function executes at a\nregular interval regardless of how often it's called.\n\nThis is useful for rate-limiting API calls, handling scroll/resize events, or any scenario where you want to\nensure a maximum execution frequency.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and throttler instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncThrottler instance\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async throttler\n- Use `onSuccess` callback to react to successful function execution and implement custom logic\n- Use `onError` callback to react to function execution errors and implement custom error handling\n- Use `onSettled` callback to react to function execution completion (success or error) and implement custom logic\n- The state includes error count, execution status, last execution time, and success/settle counts\n- State can be accessed via `asyncThrottler.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `asyncThrottler.state`\n\n## Example\n\n```ts\nconst throttler = new AsyncThrottler(async (value: string) => {\n  const result = await saveToAPI(value);\n  return result; // Return value is preserved\n}, {\n  wait: 1000,\n  onError: (error) => {\n    console.error('API call failed:', error);\n  }\n});\n\n// Will only execute once per second no matter how often called\n// Returns the API response directly\nconst result = await throttler.maybeExecute(inputElement.value);\n```\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyAsyncFunction`](../type-aliases/AnyAsyncFunction.md)\n\n## Constructors\n\n### Constructor\n\n```ts\nnew AsyncThrottler<TFn>(fn, initialOptions): AsyncThrottler<TFn>;\n```\n\nDefined in: [async-throttler.ts:241](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L241)\n\n#### Parameters\n\n##### fn\n\n`TFn`\n\n##### initialOptions\n\n[`AsyncThrottlerOptions`](../interfaces/AsyncThrottlerOptions.md)\\<`TFn`\\>\n\n#### Returns\n\n`AsyncThrottler`\\<`TFn`\\>\n\n## Properties\n\n### asyncRetryers\n\n```ts\nasyncRetryers: Map<number, AsyncRetryer<TFn>>;\n```\n\nDefined in: [async-throttler.ts:236](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L236)\n\n***\n\n### fn\n\n```ts\nfn: TFn;\n```\n\nDefined in: [async-throttler.ts:242](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L242)\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [async-throttler.ts:234](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L234)\n\n***\n\n### options\n\n```ts\noptions: AsyncThrottlerOptions<TFn>;\n```\n\nDefined in: [async-throttler.ts:235](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L235)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<AsyncThrottlerState<TFn>>>;\n```\n\nDefined in: [async-throttler.ts:231](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L231)\n\n## Methods\n\n### abort()\n\n```ts\nabort(): void;\n```\n\nDefined in: [async-throttler.ts:534](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L534)\n\nAborts all ongoing executions with the internal abort controllers.\nDoes NOT cancel any pending execution that have not started yet.\n\n#### Returns\n\n`void`\n\n***\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [async-throttler.ts:544](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L544)\n\nCancels any pending execution that have not started yet.\nDoes NOT abort any execution already in progress.\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-throttler.ts:463](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L463)\n\nProcesses the current pending execution immediately\n\n#### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\n***\n\n### getAbortSignal()\n\n```ts\ngetAbortSignal(maybeExecuteCount?): AbortSignal | null;\n```\n\nDefined in: [async-throttler.ts:524](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L524)\n\nReturns the AbortSignal for a specific execution.\nIf no maybeExecuteCount is provided, returns the signal for the most recent execution.\nReturns null if no execution is found or not currently executing.\n\n#### Parameters\n\n##### maybeExecuteCount?\n\n`number`\n\nOptional specific execution to get signal for\n\n#### Returns\n\n`AbortSignal` \\| `null`\n\n#### Example\n\n```typescript\nconst throttler = new AsyncThrottler(\n  async (data: string) => {\n    const signal = throttler.getAbortSignal()\n    if (signal) {\n      const response = await fetch('/api/save', {\n        method: 'POST',\n        body: data,\n        signal\n      })\n      return response.json()\n    }\n  },\n  { wait: 1000 }\n)\n```\n\n***\n\n### maybeExecute()\n\n```ts\nmaybeExecute(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-throttler.ts:337](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L337)\n\nAttempts to execute the throttled function. The execution behavior depends on the throttler options:\n\n- If enough time has passed since the last execution (>= wait period):\n  - With leading=true: Executes immediately\n  - With leading=false: Waits for the next trailing execution\n\n- If within the wait period:\n  - With trailing=true: Schedules execution for end of wait period\n  - With trailing=false: Drops the execution\n\n#### Parameters\n\n##### args\n\n...`Parameters`\\<`TFn`\\>\n\n#### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\n#### Example\n\n```ts\nconst throttled = new AsyncThrottler(fn, { wait: 1000 });\n\n// First call executes immediately\nawait throttled.maybeExecute('a', 'b');\n\n// Call during wait period - gets throttled\nawait throttled.maybeExecute('c', 'd');\n```\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [async-throttler.ts:558](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L558)\n\nResets the debouncer state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [async-throttler.ts:269](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L269)\n\nUpdates the async throttler options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`AsyncThrottlerOptions`](../interfaces/AsyncThrottlerOptions.md)\\<`TFn`\\>\\>\n\n#### Returns\n\n`void`\n","originalRawMarkdown":"---\nid: AsyncThrottler\ntitle: AsyncThrottler\n---\n\nDefined in: [async-throttler.ts:230](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L230)\n\nA class that creates an async throttled function.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync Throttler:\n- Returns promises that can be awaited for throttled function results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight executions\n- Cancel support to prevent pending executions from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n- Waits for ongoing executions to complete before scheduling the next one\n\nThe sync Throttler is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Throttling?\nThrottling limits how often a function can be executed, allowing only one execution within a specified time window.\nUnlike debouncing which resets the delay timer on each call, throttling ensures the function executes at a\nregular interval regardless of how often it's called.\n\nThis is useful for rate-limiting API calls, handling scroll/resize events, or any scenario where you want to\nensure a maximum execution frequency.\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and throttler instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncThrottler instance\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async throttler\n- Use `onSuccess` callback to react to successful function execution and implement custom logic\n- Use `onError` callback to react to function execution errors and implement custom error handling\n- Use `onSettled` callback to react to function execution completion (success or error) and implement custom logic\n- The state includes error count, execution status, last execution time, and success/settle counts\n- State can be accessed via `asyncThrottler.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `asyncThrottler.state`\n\n## Example\n\n```ts\nconst throttler = new AsyncThrottler(async (value: string) => {\n  const result = await saveToAPI(value);\n  return result; // Return value is preserved\n}, {\n  wait: 1000,\n  onError: (error) => {\n    console.error('API call failed:', error);\n  }\n});\n\n// Will only execute once per second no matter how often called\n// Returns the API response directly\nconst result = await throttler.maybeExecute(inputElement.value);\n```\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyAsyncFunction`](../type-aliases/AnyAsyncFunction.md)\n\n## Constructors\n\n### Constructor\n\n```ts\nnew AsyncThrottler<TFn>(fn, initialOptions): AsyncThrottler<TFn>;\n```\n\nDefined in: [async-throttler.ts:241](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L241)\n\n#### Parameters\n\n##### fn\n\n`TFn`\n\n##### initialOptions\n\n[`AsyncThrottlerOptions`](../interfaces/AsyncThrottlerOptions.md)\\<`TFn`\\>\n\n#### Returns\n\n`AsyncThrottler`\\<`TFn`\\>\n\n## Properties\n\n### asyncRetryers\n\n```ts\nasyncRetryers: Map<number, AsyncRetryer<TFn>>;\n```\n\nDefined in: [async-throttler.ts:236](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L236)\n\n***\n\n### fn\n\n```ts\nfn: TFn;\n```\n\nDefined in: [async-throttler.ts:242](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L242)\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [async-throttler.ts:234](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L234)\n\n***\n\n### options\n\n```ts\noptions: AsyncThrottlerOptions<TFn>;\n```\n\nDefined in: [async-throttler.ts:235](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L235)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<AsyncThrottlerState<TFn>>>;\n```\n\nDefined in: [async-throttler.ts:231](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L231)\n\n## Methods\n\n### abort()\n\n```ts\nabort(): void;\n```\n\nDefined in: [async-throttler.ts:534](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L534)\n\nAborts all ongoing executions with the internal abort controllers.\nDoes NOT cancel any pending execution that have not started yet.\n\n#### Returns\n\n`void`\n\n***\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [async-throttler.ts:544](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L544)\n\nCancels any pending execution that have not started yet.\nDoes NOT abort any execution already in progress.\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-throttler.ts:463](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L463)\n\nProcesses the current pending execution immediately\n\n#### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\n***\n\n### getAbortSignal()\n\n```ts\ngetAbortSignal(maybeExecuteCount?): AbortSignal | null;\n```\n\nDefined in: [async-throttler.ts:524](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L524)\n\nReturns the AbortSignal for a specific execution.\nIf no maybeExecuteCount is provided, returns the signal for the most recent execution.\nReturns null if no execution is found or not currently executing.\n\n#### Parameters\n\n##### maybeExecuteCount?\n\n`number`\n\nOptional specific execution to get signal for\n\n#### Returns\n\n`AbortSignal` \\| `null`\n\n#### Example\n\n```typescript\nconst throttler = new AsyncThrottler(\n  async (data: string) => {\n    const signal = throttler.getAbortSignal()\n    if (signal) {\n      const response = await fetch('/api/save', {\n        method: 'POST',\n        body: data,\n        signal\n      })\n      return response.json()\n    }\n  },\n  { wait: 1000 }\n)\n```\n\n***\n\n### maybeExecute()\n\n```ts\nmaybeExecute(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-throttler.ts:337](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L337)\n\nAttempts to execute the throttled function. The execution behavior depends on the throttler options:\n\n- If enough time has passed since the last execution (>= wait period):\n  - With leading=true: Executes immediately\n  - With leading=false: Waits for the next trailing execution\n\n- If within the wait period:\n  - With trailing=true: Schedules execution for end of wait period\n  - With trailing=false: Drops the execution\n\n#### Parameters\n\n##### args\n\n...`Parameters`\\<`TFn`\\>\n\n#### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\n#### Example\n\n```ts\nconst throttled = new AsyncThrottler(fn, { wait: 1000 });\n\n// First call executes immediately\nawait throttled.maybeExecute('a', 'b');\n\n// Call during wait period - gets throttled\nawait throttled.maybeExecute('c', 'd');\n```\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [async-throttler.ts:558](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L558)\n\nResets the debouncer state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [async-throttler.ts:269](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-throttler.ts#L269)\n\nUpdates the async throttler options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`AsyncThrottlerOptions`](../interfaces/AsyncThrottlerOptions.md)\\<`TFn`\\>\\>\n\n#### Returns\n\n`void`\n"}
