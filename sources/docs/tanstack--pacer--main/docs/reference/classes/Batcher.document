id"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"flush","children":[{"type":"text","value":"flush()"}]},{"type":"code","value":"flush(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L259","children":[{"type":"text","value":"batcher.ts:259"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Processes the current batch of items immediately"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"peekallitems","children":[{"type":"text","value":"peekAllItems()"}]},{"type":"code","value":"peekAllItems(): TValue[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L267","children":[{"type":"text","value":"batcher.ts:267"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns a copy of all items in the batcher"}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":"[]"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"reset","children":[{"type":"text","value":"reset()"}]},{"type":"code","value":"reset(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L297","children":[{"type":"text","value":"batcher.ts:297"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Resets the batcher state to its default values"}]},{"type":"heading","depth":4,"id":"returns-8","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setoptions","children":[{"type":"text","value":"setOptions()"}]},{"type":"code","value":"setOptions(newOptions): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L180","children":[{"type":"text","value":"batcher.ts:180"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Updates the batcher options"}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"newoptions","children":[{"type":"text","value":"newOptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/BatcherOptions.md","children":[{"type":"inlineCode","value":"BatcherOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>"}]},{"type":"heading","depth":4,"id":"returns-9","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"fn","text":"fn","level":5},{"id":"initialoptions","text":"initialOptions","level":5},{"id":"returns","text":"Returns","level":4},{"id":"properties","text":"Properties","level":2},{"id":"fn-2","text":"fn","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"items","text":"items","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"key","text":"key","level":3},{"id":"options","text":"options","level":3},{"id":"store","text":"store","level":3},{"id":"methods","text":"Methods","level":2},{"id":"additem","text":"addItem()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"item","text":"item","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"cancel","text":"cancel()","level":3},{"id":"returns-4","text":"Returns","level":4},{"id":"clear","text":"clear()","level":3},{"id":"returns-5","text":"Returns","level":4},{"id":"flush","text":"flush()","level":3},{"id":"returns-6","text":"Returns","level":4},{"id":"peekallitems","text":"peekAllItems()","level":3},{"id":"returns-7","text":"Returns","level":4},{"id":"reset","text":"reset()","level":3},{"id":"returns-8","text":"Returns","level":4},{"id":"setoptions","text":"setOptions()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"newoptions","text":"newOptions","level":5},{"id":"returns-9","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [batcher.ts:145](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L145)\n\nA class that collects items and processes them in batches.\n\nBatching is a technique for grouping multiple operations together to be processed as a single unit.\nThis synchronous version is lighter weight and often all you need - upgrade to AsyncBatcher when you need promises, retry support, abort/cancel capabilities, or advanced error handling.\n\nThe Batcher provides a flexible way to implement batching with configurable:\n- Maximum batch size (number of items per batch)\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the batcher\n- Use `onExecute` callback to react to batch execution and implement custom logic\n- Use `onItemsChange` callback to react to items being added or removed from the batcher\n- The state includes batch execution count, total items processed, items, and running status\n- State can be accessed via `batcher.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `batcher.state`\n\n## Example\n\n```ts\nconst batcher = new Batcher<number>(\n  (items) => console.log('Processing batch:', items),\n  {\n    maxSize: 5,\n    wait: 2000,\n    onExecute: (batch, batcher) => console.log('Batch executed:', batch)\n  }\n);\n\nbatcher.addItem(1);\nbatcher.addItem(2);\n// After 2 seconds or when 5 items are added, whichever comes first,\n// the batch will be processed\n// batcher.flush() // manually trigger a batch\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew Batcher<TValue>(fn, initialOptions): Batcher<TValue>;\n```\n\nDefined in: [batcher.ts:153](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L153)\n\n#### Parameters\n\n##### fn\n\n(`items`) => `void`\n\n##### initialOptions\n\n[`BatcherOptions`](../interfaces/BatcherOptions.md)\\<`TValue`\\>\n\n#### Returns\n\n`Batcher`\\<`TValue`\\>\n\n## Properties\n\n### fn\n\n```ts\nfn: (items) => void;\n```\n\nDefined in: [batcher.ts:154](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L154)\n\n#### Parameters\n\n##### items\n\n`TValue`[]\n\n#### Returns\n\n`void`\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [batcher.ts:149](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L149)\n\n***\n\n### options\n\n```ts\noptions: BatcherOptionsWithOptionalCallbacks<TValue>;\n```\n\nDefined in: [batcher.ts:150](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L150)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<BatcherState<TValue>>>;\n```\n\nDefined in: [batcher.ts:146](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L146)\n\n## Methods\n\n### addItem()\n\n```ts\naddItem(item): void;\n```\n\nDefined in: [batcher.ts:211](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L211)\n\nAdds an item to the batcher\nIf the batch size is reached, timeout occurs, or shouldProcess returns true, the batch will be processed\n\n#### Parameters\n\n##### item\n\n`TValue`\n\n#### Returns\n\n`void`\n\n***\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [batcher.ts:289](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L289)\n\nCancels any pending execution that was scheduled.\nDoes NOT clear out the items.\n\n#### Returns\n\n`void`\n\n***\n\n### clear()\n\n```ts\nclear(): void;\n```\n\nDefined in: [batcher.ts:281](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L281)\n\nRemoves all items from the batcher\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): void;\n```\n\nDefined in: [batcher.ts:259](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L259)\n\nProcesses the current batch of items immediately\n\n#### Returns\n\n`void`\n\n***\n\n### peekAllItems()\n\n```ts\npeekAllItems(): TValue[];\n```\n\nDefined in: [batcher.ts:267](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L267)\n\nReturns a copy of all items in the batcher\n\n#### Returns\n\n`TValue`[]\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [batcher.ts:297](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L297)\n\nResets the batcher state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [batcher.ts:180](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L180)\n\nUpdates the batcher options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`BatcherOptions`](../interfaces/BatcherOptions.md)\\<`TValue`\\>\\>\n\n#### Returns\n\n`void`\n","originalRawMarkdown":"---\nid: Batcher\ntitle: Batcher\n---\n\nDefined in: [batcher.ts:145](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L145)\n\nA class that collects items and processes them in batches.\n\nBatching is a technique for grouping multiple operations together to be processed as a single unit.\nThis synchronous version is lighter weight and often all you need - upgrade to AsyncBatcher when you need promises, retry support, abort/cancel capabilities, or advanced error handling.\n\nThe Batcher provides a flexible way to implement batching with configurable:\n- Maximum batch size (number of items per batch)\n- Time-based batching (process after X milliseconds)\n- Custom batch processing logic via getShouldExecute\n- Event callbacks for monitoring batch operations\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the batcher\n- Use `onExecute` callback to react to batch execution and implement custom logic\n- Use `onItemsChange` callback to react to items being added or removed from the batcher\n- The state includes batch execution count, total items processed, items, and running status\n- State can be accessed via `batcher.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `batcher.state`\n\n## Example\n\n```ts\nconst batcher = new Batcher<number>(\n  (items) => console.log('Processing batch:', items),\n  {\n    maxSize: 5,\n    wait: 2000,\n    onExecute: (batch, batcher) => console.log('Batch executed:', batch)\n  }\n);\n\nbatcher.addItem(1);\nbatcher.addItem(2);\n// After 2 seconds or when 5 items are added, whichever comes first,\n// the batch will be processed\n// batcher.flush() // manually trigger a batch\n```\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew Batcher<TValue>(fn, initialOptions): Batcher<TValue>;\n```\n\nDefined in: [batcher.ts:153](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L153)\n\n#### Parameters\n\n##### fn\n\n(`items`) => `void`\n\n##### initialOptions\n\n[`BatcherOptions`](../interfaces/BatcherOptions.md)\\<`TValue`\\>\n\n#### Returns\n\n`Batcher`\\<`TValue`\\>\n\n## Properties\n\n### fn\n\n```ts\nfn: (items) => void;\n```\n\nDefined in: [batcher.ts:154](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L154)\n\n#### Parameters\n\n##### items\n\n`TValue`[]\n\n#### Returns\n\n`void`\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [batcher.ts:149](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L149)\n\n***\n\n### options\n\n```ts\noptions: BatcherOptionsWithOptionalCallbacks<TValue>;\n```\n\nDefined in: [batcher.ts:150](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L150)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<BatcherState<TValue>>>;\n```\n\nDefined in: [batcher.ts:146](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L146)\n\n## Methods\n\n### addItem()\n\n```ts\naddItem(item): void;\n```\n\nDefined in: [batcher.ts:211](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L211)\n\nAdds an item to the batcher\nIf the batch size is reached, timeout occurs, or shouldProcess returns true, the batch will be processed\n\n#### Parameters\n\n##### item\n\n`TValue`\n\n#### Returns\n\n`void`\n\n***\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [batcher.ts:289](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L289)\n\nCancels any pending execution that was scheduled.\nDoes NOT clear out the items.\n\n#### Returns\n\n`void`\n\n***\n\n### clear()\n\n```ts\nclear(): void;\n```\n\nDefined in: [batcher.ts:281](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L281)\n\nRemoves all items from the batcher\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): void;\n```\n\nDefined in: [batcher.ts:259](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L259)\n\nProcesses the current batch of items immediately\n\n#### Returns\n\n`void`\n\n***\n\n### peekAllItems()\n\n```ts\npeekAllItems(): TValue[];\n```\n\nDefined in: [batcher.ts:267](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L267)\n\nReturns a copy of all items in the batcher\n\n#### Returns\n\n`TValue`[]\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [batcher.ts:297](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L297)\n\nResets the batcher state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [batcher.ts:180](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/batcher.ts#L180)\n\nUpdates the batcher options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`BatcherOptions`](../interfaces/BatcherOptions.md)\\<`TValue`\\>\\>\n\n#### Returns\n\n`void`\n"}
