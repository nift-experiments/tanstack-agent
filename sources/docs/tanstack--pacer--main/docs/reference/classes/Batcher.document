n":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onExecute"},{"type":"text","value":" callback to react to batch execution and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onItemsChange"},{"type":"text","value":" callback to react to items being added or removed from the batcher"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state includes batch execution count, total items processed, items, and running status"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"State can be accessed via "},{"type":"inlineCode","value":"batcher.store.state"},{"type":"text","value":" when using the class directly"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When using framework adapters (React/Solid), state is accessed from "},{"type":"inlineCode","value":"batcher.state"}]}]}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const batcher = new Batcher<number>(\n  (items) => console.log('Processing batch:', items),\n  {\n    maxSize: 5,\n    wait: 2000,\n    onExecute: (batch, batcher) => console.log('Batch executed:', batch)\n  }\n);\n\nbatcher.addItem(1);\nbatcher.addItem(2);\n// After 2 seconds or when 5 items are added, whichever comes first,\n// the batch will be processed\n// batcher.flush() // manually trigger a batch","lang":"ts"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,