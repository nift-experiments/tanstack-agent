ingExecute, execution count, and isPending status"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"State can be accessed via "},{"type":"inlineCode","value":"debouncer.store.state"},{"type":"text","value":" when using the class directly"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When using framework adapters (React/Solid), state is accessed from "},{"type":"inlineCode","value":"debouncer.state"}]}]}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const debouncer = new Debouncer((value: string) => {\n  saveToDatabase(value);\n}, { wait: 500 });\n\n// Will only save after 500ms of no new input\ninputElement.addEventListener('input', () => {\n  debouncer.maybeExecute(inputElement.value);\n});","lang":"ts"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/AnyFunction.md","children":[{"type":"inlineCode","value":"AnyFunction"}]}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,"id":"constructor","children":[{"type":"text","value":"Constructor"}]},{"type":"code","value":"new Debouncer<TFn>(fn, initialOptions): Debouncer<TFn>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L150","children":[{"type":"text","value":"debouncer.ts:150"}]}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"