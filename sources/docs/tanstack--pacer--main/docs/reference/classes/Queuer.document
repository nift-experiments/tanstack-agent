{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/queuer.ts#L269","children":[{"type":"text","value":"queuer.ts:269"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A flexible queue that processes items with configurable wait times, expiration, and priority."}]},{"type":"paragraph","children":[{"type":"text","value":"This synchronous version is lighter weight and often all you need - upgrade to AsyncQueuer when you need promises, retry support, abort capabilities, concurrent execution, or advanced error handling."}]},{"type":"paragraph","children":[{"type":"text","value":"Features:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Automatic or manual processing of items"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"FIFO (First In First Out), LIFO (Last In First Out), or double-ended queue behavior"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Priority-based ordering when getPriority is provided"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Item expiration and removal of stale items"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Callbacks for queue state changes, execution, rejection, and expiration"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Running behavior:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"start()"},{"type":"text","value":": Begins automatically processing items in the queue (defaults to isRunning)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"stop()"},{"type":"text","value":": Pauses processing but maintains queue state"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"wait"},{"type":"text","value":": Configurable delay between processing items"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onItemsChange"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onExecute"},{"type":"text","value":": Callbacks for monitoring queue state"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Manual processing is also supported when automatic processing is disabled:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"execute()"},{"type":"text","value":": Processes the next item using the provided function"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"getNextItem()"},{"type":"text","value":": Removes and returns the next item without processing"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Queue behavior defaults to FIFO:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"addItem(item)"},{"type":"text","value":": Adds to the back of the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Items processed from the front of the queue"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Priority queue:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Provide a "},{"type":"inlineCode","value":"getPriority"},{"type":"text","value":" function; higher values are processed first"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Stack (LIFO):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"addItem(item, 'back')"},{"type":"text","value":": Adds to the back"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"getNextItem('back')"},{"type":"text","value":": Removes from the back"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Double-ended queue:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"addItem(item, position)"},{"type":"text","value":": Adds to specified position ('front'/'back')"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"getNextItem(position)"},{"type":"text","value":": Removes from specified position"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Item expiration:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"expirationDuration"},{"type":"text","value":": Maximum time items can stay in the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"getIsExpired"},{"type":"text","value":": Function to override default expiration"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onExpire"},{"type":"text","value":": Callback for expired items"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"State Management:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Uses TanStack Store for reactive state management"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" to provide initial state values when creating the queuer"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onExecute"},{"type":"text","value":" callback to react to item execution and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onItemsChange"},{"type":"text","value":" callback to react to items being added or removed from the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onExpire"},{"type":"text","value":" callback to react to items expiring and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onReject"},{"type":"text","value":" callback to react to items being rejected when the queue is full"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state includes execution count, expiration count, rejection count, and isRunning status"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"State can be accessed via "},{"type":"inlineCode","value":"queuer.store.state"},{"type":"text","value":" when using the class directly"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When using framework adapters (React/Solid), state is accessed from "},{"type":"inlineCode","value":"queuer.state"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Example usage:"}]},{"type":"code","value":"// Auto-processing queue with wait time\nconst autoQueue = new Queuer<number>((n) => console.log(n), {\n  started: true, // Begin processing immediately\n  wait: 1000, // Wait 1s between items\n  onExecute: (item, queuer) => console.log(`Processed ${item}`)\n});\nautoQueue.addItem(1); // Will process after 1s\nautoQueue.addItem(2); // Will process 1s after first item\n\n// Manual processing queue\nconst manualQueue = new Queuer<number>((n) 