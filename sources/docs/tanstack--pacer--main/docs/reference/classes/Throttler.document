ype":"thematicBreak"},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"code","value":"options: ThrottlerOptions<TFn>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L155","children":[{"type":"text","value":"throttler.ts:155"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"store","children":[{"type":"text","value":"store"}]},{"type":"code","value":"readonly store: Store<Readonly<ThrottlerState<TFn>>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L151","children":[{"type":"text","value":"throttler.ts:151"}]}]},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"cancel","children":[{"type":"text","value":"cancel()"}]},{"type":"code","value":"cancel(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L322","children":[{"type":"text","value":"throttler.ts:322"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Cancels any pending trailing execution and clears internal state."}]},{"type":"paragraph","children":[{"type":"text","value":"If a trailing execution is scheduled (due to throttling with trailing=true),\nthis will prevent that execution from occurring. The internal timeout and\nstored arguments will be cleared."}]},{"type":"paragraph","children":[{"type":"text","value":"Has no effect if there is no pending execution."}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"flush","children":[{"type":"text","value":"flush()"}]},{"type":"code","value":"flush(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L300","children":[{"type":"text","value":"throttler.ts:300"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Processes the current pending execution immediately"}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"maybeexecute","children":[{"type":"text","value":"maybeExecute()"}]},{"type":"code","value":"maybeExecute(...args): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L241","children":[{"type":"text","value":"throttler.ts:241"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Attempts to execute the throttled function. The execution behavior depends on the throttler options:"}]},{"type":"list","ordered":false,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If enough time has passed since the last execution (>= wait period):"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With leading=true: Executes immediately"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With leading=false: Waits for the next trailing execution"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If within the wait period:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With trailing=true: Schedules execution for end of wait period"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"With trailing=false: Drops the execution"}]}]}]}]}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"text","value":"..."},{"type":"inlineCode","value":"Parameters"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const throttled = new Throttler(fn, { wait: 1000 });\n\n// First call executes immediately\nthrottled.maybeExecute('a', 'b');\n\n// Call during wait period - gets throttled\nthrottled.maybeExecute('c', 'd');","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"reset","children":[{"type":"text","value":"reset()"}]},{"type":"code","value":"reset(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L333","children":[{"type":"text","value":"throttler.ts:333"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Resets the throttler state to its default values"}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setoptions","children":[{"type":"text","value":"setOptions()"}]},{"type":"code","value":"setOptions(newOptions): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L183","children":[{"type":"text","value":"throttler.ts:183"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Updates the throttler options"}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"newoptions","children":[{"type":"text","value":"newOptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/ThrottlerOptions.md","children":[{"type":"inlineCode","value":"ThrottlerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">>"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"fn","text":"fn","level":5},{"id":"initialoptions","text":"initialOptions","level":5},{"id":"returns","text":"Returns","level":4},{"id":"properties","text":"Properties","level":2},{"id":"fn-2","text":"fn","level":3},{"id":"key","text":"key","level":3},{"id":"options","text":"options","level":3},{"id":"store","text":"store","level":3},{"id":"methods","text":"Methods","level":2},{"id":"cancel","text":"cancel()","level":3},{"id":"returns-2","text":"Returns","level":4},{"id":"flush","text":"flush()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"maybeexecute","text":"maybeExecute()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"args","text":"args","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"reset","text":"reset()","level":3},{"id":"returns-5","text":"Returns","level":4},{"id":"setoptions","text":"setOptions()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"newoptions","text":"newOptions","level":5},{"id":"returns-6","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [throttler.ts:150](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L150)\n\nA class that creates a throttled function.\n\nThrottling ensures a function is called at most once within a specified time window.\nUnlike debouncing which waits for a pause in calls, throttling guarantees consistent\nexecution timing regardless of call frequency.\nThis synchronous version is lighter weight and often all you need - upgrade to AsyncThrottler when you need promises, retry support, abort/cancel capabilities, or advanced error handling.\n\nSupports both leading and trailing edge execution:\n- Leading: Execute immediately on first call (default: true)\n- Trailing: Execute after wait period if called during throttle (default: true)\n\nFor collapsing rapid-fire events where you only care about the last call, consider using Debouncer.\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the throttler\n- Use `onExecute` callback to react to function execution and implement custom logic\n- The state includes execution count, last execution time, pending status, and more\n- State can be accessed via `throttler.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `throttler.state`\n\n## Example\n\n```ts\nconst throttler = new Throttler(\n  (id: string) => api.getData(id),\n  { wait: 1000 } // Execute at most once per second\n);\n\n// First call executes immediately\nthrottler.maybeExecute('123');\n\n// Subsequent calls within 1000ms are throttled\nthrottler.maybeExecute('123'); // Throttled\n```\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyFunction`](../type-aliases/AnyFunction.md)\n\n## Constructors\n\n### Constructor\n\n```ts\nnew Throttler<TFn>(fn, initialOptions): Throttler<TFn>;\n```\n\nDefined in: [throttler.ts:158](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L158)\n\n#### Parameters\n\n##### fn\n\n`TFn`\n\n##### initialOptions\n\n[`ThrottlerOptions`](../interfaces/ThrottlerOptions.md)\\<`TFn`\\>\n\n#### Returns\n\n`Throttler`\\<`TFn`\\>\n\n## Properties\n\n### fn\n\n```ts\nfn: TFn;\n```\n\nDefined in: [throttler.ts:159](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L159)\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [throttler.ts:154](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L154)\n\n***\n\n### options\n\n```ts\noptions: ThrottlerOptions<TFn>;\n```\n\nDefined in: [throttler.ts:155](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L155)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<ThrottlerState<TFn>>>;\n```\n\nDefined in: [throttler.ts:151](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L151)\n\n## Methods\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [throttler.ts:322](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L322)\n\nCancels any pending trailing execution and clears internal state.\n\nIf a trailing execution is scheduled (due to throttling with trailing=true),\nthis will prevent that execution from occurring. The internal timeout and\nstored arguments will be cleared.\n\nHas no effect if there is no pending execution.\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): void;\n```\n\nDefined in: [throttler.ts:300](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L300)\n\nProcesses the current pending execution immediately\n\n#### Returns\n\n`void`\n\n***\n\n### maybeExecute()\n\n```ts\nmaybeExecute(...args): void;\n```\n\nDefined in: [throttler.ts:241](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L241)\n\nAttempts to execute the throttled function. The execution behavior depends on the throttler options:\n\n- If enough time has passed since the last execution (>= wait period):\n  - With leading=true: Executes immediately\n  - With leading=false: Waits for the next trailing execution\n\n- If within the wait period:\n  - With trailing=true: Schedules execution for end of wait period\n  - With trailing=false: Drops the execution\n\n#### Parameters\n\n##### args\n\n...`Parameters`\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nconst throttled = new Throttler(fn, { wait: 1000 });\n\n// First call executes immediately\nthrottled.maybeExecute('a', 'b');\n\n// Call during wait period - gets throttled\nthrottled.maybeExecute('c', 'd');\n```\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [throttler.ts:333](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L333)\n\nResets the throttler state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [throttler.ts:183](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L183)\n\nUpdates the throttler options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`ThrottlerOptions`](../interfaces/ThrottlerOptions.md)\\<`TFn`\\>\\>\n\n#### Returns\n\n`void`\n","originalRawMarkdown":"---\nid: Throttler\ntitle: Throttler\n---\n\nDefined in: [throttler.ts:150](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L150)\n\nA class that creates a throttled function.\n\nThrottling ensures a function is called at most once within a specified time window.\nUnlike debouncing which waits for a pause in calls, throttling guarantees consistent\nexecution timing regardless of call frequency.\nThis synchronous version is lighter weight and often all you need - upgrade to AsyncThrottler when you need promises, retry support, abort/cancel capabilities, or advanced error handling.\n\nSupports both leading and trailing edge execution:\n- Leading: Execute immediately on first call (default: true)\n- Trailing: Execute after wait period if called during throttle (default: true)\n\nFor collapsing rapid-fire events where you only care about the last call, consider using Debouncer.\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the throttler\n- Use `onExecute` callback to react to function execution and implement custom logic\n- The state includes execution count, last execution time, pending status, and more\n- State can be accessed via `throttler.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `throttler.state`\n\n## Example\n\n```ts\nconst throttler = new Throttler(\n  (id: string) => api.getData(id),\n  { wait: 1000 } // Execute at most once per second\n);\n\n// First call executes immediately\nthrottler.maybeExecute('123');\n\n// Subsequent calls within 1000ms are throttled\nthrottler.maybeExecute('123'); // Throttled\n```\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyFunction`](../type-aliases/AnyFunction.md)\n\n## Constructors\n\n### Constructor\n\n```ts\nnew Throttler<TFn>(fn, initialOptions): Throttler<TFn>;\n```\n\nDefined in: [throttler.ts:158](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L158)\n\n#### Parameters\n\n##### fn\n\n`TFn`\n\n##### initialOptions\n\n[`ThrottlerOptions`](../interfaces/ThrottlerOptions.md)\\<`TFn`\\>\n\n#### Returns\n\n`Throttler`\\<`TFn`\\>\n\n## Properties\n\n### fn\n\n```ts\nfn: TFn;\n```\n\nDefined in: [throttler.ts:159](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L159)\n\n***\n\n### key\n\n```ts\nkey: string | undefined;\n```\n\nDefined in: [throttler.ts:154](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L154)\n\n***\n\n### options\n\n```ts\noptions: ThrottlerOptions<TFn>;\n```\n\nDefined in: [throttler.ts:155](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L155)\n\n***\n\n### store\n\n```ts\nreadonly store: Store<Readonly<ThrottlerState<TFn>>>;\n```\n\nDefined in: [throttler.ts:151](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L151)\n\n## Methods\n\n### cancel()\n\n```ts\ncancel(): void;\n```\n\nDefined in: [throttler.ts:322](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L322)\n\nCancels any pending trailing execution and clears internal state.\n\nIf a trailing execution is scheduled (due to throttling with trailing=true),\nthis will prevent that execution from occurring. The internal timeout and\nstored arguments will be cleared.\n\nHas no effect if there is no pending execution.\n\n#### Returns\n\n`void`\n\n***\n\n### flush()\n\n```ts\nflush(): void;\n```\n\nDefined in: [throttler.ts:300](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L300)\n\nProcesses the current pending execution immediately\n\n#### Returns\n\n`void`\n\n***\n\n### maybeExecute()\n\n```ts\nmaybeExecute(...args): void;\n```\n\nDefined in: [throttler.ts:241](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L241)\n\nAttempts to execute the throttled function. The execution behavior depends on the throttler options:\n\n- If enough time has passed since the last execution (>= wait period):\n  - With leading=true: Executes immediately\n  - With leading=false: Waits for the next trailing execution\n\n- If within the wait period:\n  - With trailing=true: Schedules execution for end of wait period\n  - With trailing=false: Drops the execution\n\n#### Parameters\n\n##### args\n\n...`Parameters`\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nconst throttled = new Throttler(fn, { wait: 1000 });\n\n// First call executes immediately\nthrottled.maybeExecute('a', 'b');\n\n// Call during wait period - gets throttled\nthrottled.maybeExecute('c', 'd');\n```\n\n***\n\n### reset()\n\n```ts\nreset(): void;\n```\n\nDefined in: [throttler.ts:333](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L333)\n\nResets the throttler state to its default values\n\n#### Returns\n\n`void`\n\n***\n\n### setOptions()\n\n```ts\nsetOptions(newOptions): void;\n```\n\nDefined in: [throttler.ts:183](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/throttler.ts#L183)\n\nUpdates the throttler options\n\n#### Parameters\n\n##### newOptions\n\n`Partial`\\<[`ThrottlerOptions`](../interfaces/ThrottlerOptions.md)\\<`TFn`\\>\\>\n\n#### Returns\n\n`void`\n"}
