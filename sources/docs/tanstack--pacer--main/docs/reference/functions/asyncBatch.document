en":[{"type":"text","value":"Both onError and throwOnError can be used together - the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncBatcher instance"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"State Management:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Uses TanStack Store for reactive state management"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" to provide initial state values when creating the async batcher"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" callback to react to successful batch execution and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" callback to react to batch execution errors and implement custom error handling"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callback to react to batch execution completion (success or error) and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onItemsChange"},{"type":"text","value":" callback to react to items being added or removed from the batcher"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state includes total items processed, success/error counts, and execution status"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"State can be accessed via the underlying AsyncBatcher instance's "},{"type":"inlineCode","value":"store.state"},{"type":"text","value":" property"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When using framework adapters (React/Solid), state is accessed from the hook's state property"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"items"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/AsyncBatcherOptions.md","children":[{"type":"inlineCode","value":"AsyncBatcherOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"(item): Promise<any>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Adds an item to the async batcher\nIf the batch size is reached, timeout occurs, or shouldProcess returns true, the batch will be processed"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"item","children":[{"type":"text","value":"item"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The result from the batch function, or undefined if an error occurred and was handled by onError"}]},{"type":"heading","depth":3,"id":"throws","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"The error from the batch function if no onError handler is configured or throwOnError is true"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const batchItems = asyncBatch<number>(\n  async (items) => {\n    const result = await processApiCall(items);\n    console.log('Processing:', items);\n    return result;\n  },\n  {\n    maxSize: 3,\n    wait: 1000,\n    onSuccess: (result) => console.log('Batch succeeded:', result),\n    onError: (error) => console.error('Batch failed:', error)\n  }\n);\n\nbatchItems(1);\nbatchItems(2);\nbatchItems(3); // Triggers batch processing","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"parameters-2","text":"Parameters","level":3},{"id":"item","text":"item","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"throws","text":"Throws","level":3},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction asyncBatch<TValue>(fn, options): (item) => Promise<any>;\n```\n\nDefined in: [async-batcher.ts:588](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L588)\n\nCreates an async batcher that processes items in batches.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync batch function:\n- Returns promises that can be awaited for batch results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight batch executions\n- Cancel support to prevent pending batches from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n\nThe sync batch function is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Batching?\nBatching is a technique for grouping multiple operations together to be processed as a single unit.\n\nConfiguration Options:\n- `maxSize`: Maximum number of items per batch (default: Infinity)\n- `wait`: Time to wait before processing batch (default: Infinity)\n- `getShouldExecute`: Custom logic to trigger batch processing\n- `asyncRetryerOptions`: Configure retry behavior for batch executions\n- `started`: Whether to start processing immediately (default: true)\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error, the batch of items that failed, and batcher instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncBatcher instance\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async batcher\n- Use `onSuccess` callback to react to successful batch execution and implement custom logic\n- Use `onError` callback to react to batch execution errors and implement custom error handling\n- Use `onSettled` callback to react to batch execution completion (success or error) and implement custom logic\n- Use `onItemsChange` callback to react to items being added or removed from the batcher\n- The state includes total items processed, success/error counts, and execution status\n- State can be accessed via the underlying AsyncBatcher instance's `store.state` property\n- When using framework adapters (React/Solid), state is accessed from the hook's state property\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Parameters\n\n### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n### options\n\n[`AsyncBatcherOptions`](../interfaces/AsyncBatcherOptions.md)\\<`TValue`\\>\n\n## Returns\n\n```ts\n(item): Promise<any>;\n```\n\nAdds an item to the async batcher\nIf the batch size is reached, timeout occurs, or shouldProcess returns true, the batch will be processed\n\n### Parameters\n\n#### item\n\n`TValue`\n\n### Returns\n\n`Promise`\\<`any`\\>\n\nThe result from the batch function, or undefined if an error occurred and was handled by onError\n\n### Throws\n\nThe error from the batch function if no onError handler is configured or throwOnError is true\n\n## Example\n\n```ts\nconst batchItems = asyncBatch<number>(\n  async (items) => {\n    const result = await processApiCall(items);\n    console.log('Processing:', items);\n    return result;\n  },\n  {\n    maxSize: 3,\n    wait: 1000,\n    onSuccess: (result) => console.log('Batch succeeded:', result),\n    onError: (error) => console.error('Batch failed:', error)\n  }\n);\n\nbatchItems(1);\nbatchItems(2);\nbatchItems(3); // Triggers batch processing\n```\n","originalRawMarkdown":"---\nid: asyncBatch\ntitle: asyncBatch\n---\n\n```ts\nfunction asyncBatch<TValue>(fn, options): (item) => Promise<any>;\n```\n\nDefined in: [async-batcher.ts:588](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-batcher.ts#L588)\n\nCreates an async batcher that processes items in batches.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync batch function:\n- Returns promises that can be awaited for batch results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight batch executions\n- Cancel support to prevent pending batches from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n\nThe sync batch function is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Batching?\nBatching is a technique for grouping multiple operations together to be processed as a single unit.\n\nConfiguration Options:\n- `maxSize`: Maximum number of items per batch (default: Infinity)\n- `wait`: Time to wait before processing batch (default: Infinity)\n- `getShouldExecute`: Custom logic to trigger batch processing\n- `asyncRetryerOptions`: Configure retry behavior for batch executions\n- `started`: Whether to start processing immediately (default: true)\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error, the batch of items that failed, and batcher instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncBatcher instance\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async batcher\n- Use `onSuccess` callback to react to successful batch execution and implement custom logic\n- Use `onError` callback to react to batch execution errors and implement custom error handling\n- Use `onSettled` callback to react to batch execution completion (success or error) and implement custom logic\n- Use `onItemsChange` callback to react to items being added or removed from the batcher\n- The state includes total items processed, success/error counts, and execution status\n- State can be accessed via the underlying AsyncBatcher instance's `store.state` property\n- When using framework adapters (React/Solid), state is accessed from the hook's state property\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Parameters\n\n### fn\n\n(`items`) => `Promise`\\<`any`\\>\n\n### options\n\n[`AsyncBatcherOptions`](../interfaces/AsyncBatcherOptions.md)\\<`TValue`\\>\n\n## Returns\n\n```ts\n(item): Promise<any>;\n```\n\nAdds an item to the async batcher\nIf the batch size is reached, timeout occurs, or shouldProcess returns true, the batch will be processed\n\n### Parameters\n\n#### item\n\n`TValue`\n\n### Returns\n\n`Promise`\\<`any`\\>\n\nThe result from the batch function, or undefined if an error occurred and was handled by onError\n\n### Throws\n\nThe error from the batch function if no onError handler is configured or throwOnError is true\n\n## Example\n\n```ts\nconst batchItems = asyncBatch<number>(\n  async (items) => {\n    const result = await processApiCall(items);\n    console.log('Processing:', items);\n    return result;\n  },\n  {\n    maxSize: 3,\n    wait: 1000,\n    onSuccess: (result) => console.log('Batch succeeded:', result),\n    onError: (error) => console.error('Batch failed:', error)\n  }\n);\n\nbatchItems(1);\nbatchItems(2);\nbatchItems(3); // Triggers batch processing\n```\n"}
