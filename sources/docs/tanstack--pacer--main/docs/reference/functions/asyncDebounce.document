e":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncDebouncer instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together - the handler will be called before any error is thrown"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"State Management:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Uses TanStack Store for reactive state management"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" to provide initial state values when creating the async debouncer"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" callback to react to successful function execution and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" callback to react to function execution errors and implement custom error handling"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callback to react to function execution completion (success or error) and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state includes canLeadingExecute, error count, execution status, and success/settle counts"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"State can be accessed via "},{"type":"inlineCode","value":"asyncDebouncer.store.state"},{"type":"text","value":" when using the class directly"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When using framework adapters (React/Solid), state is accessed from "},{"type":"inlineCode","value":"asyncDebouncer.state"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfn","children":[{"type":"text","value":"TFn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/AnyAsyncFunction.md","children":[{"type":"inlineCode","value":"AnyAsyncFunction"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFn"}]},{"type":"heading","depth":3,"id":"initialoptions","children":[{"type":"text","value":"initialOptions"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/AsyncDebouncerOptions.md","children":[{"type":"inlineCode","value":"AsyncDebouncerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Attempts to execute the debounced function.\nIf a call is already in progress, it will be queued."}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If the debounced function throws and no "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is configured,\nthe error will be thrown from this method."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is configured, errors will be caught and passed to the handler,\nand this method will return undefined."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using "},{"type":"inlineCode","value":"getErrorCount()"},{"type":"text","value":" and "},{"type":"inlineCode","value":"getIsExecuting()"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"text","value":"..."},{"type":"inlineCode","value":"Parameters"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Awaited"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReturnType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">> | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise that resolves with the function's return value, or undefined if an error occurred and was handled by onError"}]},{"type":"heading","depth":3,"id":"throws","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"The error from the debounced function if no onError handler is configured"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const debounced = asyncDebounce(async (value: string) => {\n  const result = await saveToAPI(value);\n  return result; // Return value is preserved\n}, {\n  wait: 1000,\n  onError: (error) => {\n    console.error('API call failed:', error);\n  },\n  throwOnError: true // Will both log the error and throw it\n});\n\n// Will only execute once, 1 second after the last call\n// Returns the API response directly\nconst result = await debounced(\"third\");","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"initialoptions","text":"initialOptions","level":3},{"id":"returns","text":"Returns","level":2},{"id":"parameters-2","text":"Parameters","level":3},{"id":"args","text":"args","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"throws","text":"Throws","level":3},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction asyncDebounce<TFn>(fn, initialOptions): (...args) => Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-debouncer.ts:560](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L560)\n\nCreates an async debounced function that delays execution until after a specified wait time.\nThe debounced function will only execute once the wait period has elapsed without any new calls.\nIf called again during the wait period, the timer resets and a new wait period begins.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync debounce function:\n- Returns promises that can be awaited for debounced function results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight executions\n- Cancel support to prevent pending executions from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n\nThe sync debounce function is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Debouncing?\nDebouncing ensures that a function is only executed after a specified delay has passed since its last invocation.\nEach new invocation resets the delay timer. This is useful for handling frequent events like window resizing\nor input changes where you only want to execute the handler after the events have stopped occurring.\n\nConfiguration Options:\n- `wait`: Delay in milliseconds to wait after the last call (required)\n- `leading`: Execute on the leading edge of the timeout (default: false)\n- `trailing`: Execute on the trailing edge of the timeout (default: true)\n- `enabled`: Whether the debouncer is enabled (default: true)\n- `asyncRetryerOptions`: Configure retry behavior for executions\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and debouncer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- The error state can be checked using the underlying AsyncDebouncer instance\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async debouncer\n- Use `onSuccess` callback to react to successful function execution and implement custom logic\n- Use `onError` callback to react to function execution errors and implement custom error handling\n- Use `onSettled` callback to react to function execution completion (success or error) and implement custom logic\n- The state includes canLeadingExecute, error count, execution status, and success/settle counts\n- State can be accessed via `asyncDebouncer.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `asyncDebouncer.state`\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyAsyncFunction`](../type-aliases/AnyAsyncFunction.md)\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### initialOptions\n\n[`AsyncDebouncerOptions`](../interfaces/AsyncDebouncerOptions.md)\\<`TFn`\\>\n\n## Returns\n\n```ts\n(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nAttempts to execute the debounced function.\nIf a call is already in progress, it will be queued.\n\nError Handling:\n- If the debounced function throws and no `onError` handler is configured,\n  the error will be thrown from this method.\n- If an `onError` handler is configured, errors will be caught and passed to the handler,\n  and this method will return undefined.\n- The error state can be checked using `getErrorCount()` and `getIsExecuting()`.\n\n### Parameters\n\n#### args\n\n...`Parameters`\\<`TFn`\\>\n\n### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\nA promise that resolves with the function's return value, or undefined if an error occurred and was handled by onError\n\n### Throws\n\nThe error from the debounced function if no onError handler is configured\n\n## Example\n\n```ts\nconst debounced = asyncDebounce(async (value: string) => {\n  const result = await saveToAPI(value);\n  return result; // Return value is preserved\n}, {\n  wait: 1000,\n  onError: (error) => {\n    console.error('API call failed:', error);\n  },\n  throwOnError: true // Will both log the error and throw it\n});\n\n// Will only execute once, 1 second after the last call\n// Returns the API response directly\nconst result = await debounced(\"third\");\n```\n","originalRawMarkdown":"---\nid: asyncDebounce\ntitle: asyncDebounce\n---\n\n```ts\nfunction asyncDebounce<TFn>(fn, initialOptions): (...args) => Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nDefined in: [async-debouncer.ts:560](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L560)\n\nCreates an async debounced function that delays execution until after a specified wait time.\nThe debounced function will only execute once the wait period has elapsed without any new calls.\nIf called again during the wait period, the timer resets and a new wait period begins.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync debounce function:\n- Returns promises that can be awaited for debounced function results\n- Built-in retry support via AsyncRetryer integration\n- Abort support to cancel in-flight executions\n- Cancel support to prevent pending executions from starting\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n\nThe sync debounce function is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Debouncing?\nDebouncing ensures that a function is only executed after a specified delay has passed since its last invocation.\nEach new invocation resets the delay timer. This is useful for handling frequent events like window resizing\nor input changes where you only want to execute the handler after the events have stopped occurring.\n\nConfiguration Options:\n- `wait`: Delay in milliseconds to wait after the last call (required)\n- `leading`: Execute on the leading edge of the timeout (default: false)\n- `trailing`: Execute on the trailing edge of the timeout (default: true)\n- `enabled`: Whether the debouncer is enabled (default: true)\n- `asyncRetryerOptions`: Configure retry behavior for executions\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and debouncer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- The error state can be checked using the underlying AsyncDebouncer instance\n- Both onError and throwOnError can be used together - the handler will be called before any error is thrown\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async debouncer\n- Use `onSuccess` callback to react to successful function execution and implement custom logic\n- Use `onError` callback to react to function execution errors and implement custom error handling\n- Use `onSettled` callback to react to function execution completion (success or error) and implement custom logic\n- The state includes canLeadingExecute, error count, execution status, and success/settle counts\n- State can be accessed via `asyncDebouncer.store.state` when using the class directly\n- When using framework adapters (React/Solid), state is accessed from `asyncDebouncer.state`\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyAsyncFunction`](../type-aliases/AnyAsyncFunction.md)\n\n## Parameters\n\n### fn\n\n`TFn`\n\n### initialOptions\n\n[`AsyncDebouncerOptions`](../interfaces/AsyncDebouncerOptions.md)\\<`TFn`\\>\n\n## Returns\n\n```ts\n(...args): Promise<Awaited<ReturnType<TFn>> | undefined>;\n```\n\nAttempts to execute the debounced function.\nIf a call is already in progress, it will be queued.\n\nError Handling:\n- If the debounced function throws and no `onError` handler is configured,\n  the error will be thrown from this method.\n- If an `onError` handler is configured, errors will be caught and passed to the handler,\n  and this method will return undefined.\n- The error state can be checked using `getErrorCount()` and `getIsExecuting()`.\n\n### Parameters\n\n#### args\n\n...`Parameters`\\<`TFn`\\>\n\n### Returns\n\n`Promise`\\<`Awaited`\\<`ReturnType`\\<`TFn`\\>\\> \\| `undefined`\\>\n\nA promise that resolves with the function's return value, or undefined if an error occurred and was handled by onError\n\n### Throws\n\nThe error from the debounced function if no onError handler is configured\n\n## Example\n\n```ts\nconst debounced = asyncDebounce(async (value: string) => {\n  const result = await saveToAPI(value);\n  return result; // Return value is preserved\n}, {\n  wait: 1000,\n  onError: (error) => {\n    console.error('API call failed:', error);\n  },\n  throwOnError: true // Will both log the error and throw it\n});\n\n// Will only execute once, 1 second after the last call\n// Returns the API response directly\nconst result = await debounced(\"third\");\n```\n"}
