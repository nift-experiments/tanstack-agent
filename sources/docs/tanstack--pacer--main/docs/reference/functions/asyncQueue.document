ildren":[{"type":"inlineCode","value":"asyncRetryerOptions"},{"type":"text","value":": Configure retry behavior for task executions"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Error Handling:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If an "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" handler is provided, it will be called with the error and queuer instance"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is true (default when no onError handler is provided), the error will be thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is false (default when onError handler is provided), the error will be swallowed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Both onError and throwOnError can be used together; the handler will be called before any error is thrown"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error state can be checked using the underlying AsyncQueuer instance"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"State Management:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Uses TanStack Store for reactive state management"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" to provide initial state values when creating the async queuer"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" callback to react to successful task execution and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" callback to react to task execution errors and implement custom error handling"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callback to react to task execution completion (success or error) and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onItemsChange"},{"type":"text","value":" callback to react to items being added or removed from the queue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onExpire"},{"type":"text","value":" callback to react to items expiring and implement custom logic"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onReject"},{"type":"text","value":" callback to react to items being rejected when the queue is full"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state includes error count, expiration count, rejection count, running status, and success/settle counts"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"State can be accessed via the underlying AsyncQueuer instance's "},{"type":"inlineCode","value":"store.state"},{"type":"text","value":" property"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When using framework adapters (React/Solid), state is accessed from the hook's state property"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"value"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"initialoptions","children":[{"type":"text","value":"initialOptions"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/AsyncQueuerOptions.md","children":[{"type":"inlineCode","value":"AsyncQueuerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"(\n   item,\n   position?,\n   runOnItemsChange?): boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Adds an item to the queue. If the queue is full, the item is rejected and onReject is called.\nItems can be inserted based on priority or at the front/back depending on configuration.\n"},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" cannot be queued (it is the internal \"no item\" sentinel) and is always rejected."}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"item","children":[{"type":"text","value":"item"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":4,"id":"position","children":[{"type":"text","value":"position?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueuePosition.md","children":[{"type":"inlineCode","value":"QueuePosition"}]},{"type":"text","value":" = "},{"type":"inlineCode","value":"..."}]},{"type":"heading","depth":4,"id":"runonitemschange","children":[{"type":"text","value":"runOnItemsChange?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"},{"type":"text","value":" = "},{"type":"inlineCode","value":"true"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"queuer.addItem({ value: 'task', priority: 10 });\nqueuer.addItem('task2', 'front');","lang":"ts"},{"type":"heading","depth":2,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const enqueue = asyncQueue<string>(async (item) => {\n  return item.toUpperCase();\n}, {\n  concurrency: 2,\n  wait: 100,\n  onSuccess: (result) => console.log('Processed:', result)\n});\n\nenqueue('hello');","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"fn","text":"fn","level":3},{"id":"initialoptions","text":"initialOptions","level":3},{"id":"returns","text":"Returns","level":2},{"id":"parameters-2","text":"Parameters","level":3},{"id":"item","text":"item","level":4},{"id":"position","text":"position?","level":4},{"id":"runonitemschange","text":"runOnItemsChange?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example","text":"Example","level":3},{"id":"example-2","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction asyncQueue<TValue>(fn, initialOptions): (item, position, runOnItemsChange) => boolean;\n```\n\nDefined in: [async-queuer.ts:982](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-queuer.ts#L982)\n\nCreates a new AsyncQueuer instance and returns a bound addItem function for adding tasks.\nThe queuer is started automatically and ready to process items.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync queue function:\n- Returns promises that can be awaited for task results\n- Built-in retry support via AsyncRetryer integration for each queued task\n- Abort support to cancel in-flight task executions\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n- Concurrent execution support (process multiple items simultaneously)\n\nThe sync queue function is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Queuing?\nQueuing is a technique for managing and processing items sequentially or with controlled concurrency.\nTasks are processed up to the configured concurrency limit. When a task completes,\nthe next pending task is processed if the concurrency limit allows.\n\nConfiguration Options:\n- `concurrency`: Maximum number of concurrent tasks (default: 1)\n- `wait`: Time to wait between processing items (default: 0)\n- `maxSize`: Maximum number of items allowed in the queue (default: Infinity)\n- `getPriority`: Function to determine item priority\n- `addItemsTo`: Default position to add items ('back' or 'front', default: 'back')\n- `getItemsFrom`: Default position to get items ('front' or 'back', default: 'front')\n- `expirationDuration`: Maximum time items can stay in queue\n- `started`: Whether to start processing immediately (default: true)\n- `asyncRetryerOptions`: Configure retry behavior for task executions\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and queuer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together; the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncQueuer instance\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async queuer\n- Use `onSuccess` callback to react to successful task execution and implement custom logic\n- Use `onError` callback to react to task execution errors and implement custom error handling\n- Use `onSettled` callback to react to task execution completion (success or error) and implement custom logic\n- Use `onItemsChange` callback to react to items being added or removed from the queue\n- Use `onExpire` callback to react to items expiring and implement custom logic\n- Use `onReject` callback to react to items being rejected when the queue is full\n- The state includes error count, expiration count, rejection count, running status, and success/settle counts\n- State can be accessed via the underlying AsyncQueuer instance's `store.state` property\n- When using framework adapters (React/Solid), state is accessed from the hook's state property\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Parameters\n\n### fn\n\n(`value`) => `Promise`\\<`any`\\>\n\n### initialOptions\n\n[`AsyncQueuerOptions`](../interfaces/AsyncQueuerOptions.md)\\<`TValue`\\>\n\n## Returns\n\n```ts\n(\n   item,\n   position?,\n   runOnItemsChange?): boolean;\n```\n\nAdds an item to the queue. If the queue is full, the item is rejected and onReject is called.\nItems can be inserted based on priority or at the front/back depending on configuration.\n`undefined` cannot be queued (it is the internal \"no item\" sentinel) and is always rejected.\n\n### Parameters\n\n#### item\n\n`TValue`\n\n#### position?\n\n[`QueuePosition`](../type-aliases/QueuePosition.md) = `...`\n\n#### runOnItemsChange?\n\n`boolean` = `true`\n\n### Returns\n\n`boolean`\n\n### Example\n\n```ts\nqueuer.addItem({ value: 'task', priority: 10 });\nqueuer.addItem('task2', 'front');\n```\n\n## Example\n\n```ts\nconst enqueue = asyncQueue<string>(async (item) => {\n  return item.toUpperCase();\n}, {\n  concurrency: 2,\n  wait: 100,\n  onSuccess: (result) => console.log('Processed:', result)\n});\n\nenqueue('hello');\n```\n","originalRawMarkdown":"---\nid: asyncQueue\ntitle: asyncQueue\n---\n\n```ts\nfunction asyncQueue<TValue>(fn, initialOptions): (item, position, runOnItemsChange) => boolean;\n```\n\nDefined in: [async-queuer.ts:982](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-queuer.ts#L982)\n\nCreates a new AsyncQueuer instance and returns a bound addItem function for adding tasks.\nThe queuer is started automatically and ready to process items.\n\nAsync vs Sync Versions:\nThe async version provides advanced features over the sync queue function:\n- Returns promises that can be awaited for task results\n- Built-in retry support via AsyncRetryer integration for each queued task\n- Abort support to cancel in-flight task executions\n- Comprehensive error handling with onError callbacks and throwOnError control\n- Detailed execution tracking (success/error/settle counts)\n- Concurrent execution support (process multiple items simultaneously)\n\nThe sync queue function is lighter weight and simpler when you don't need async features,\nreturn values, or execution control.\n\nWhat is Queuing?\nQueuing is a technique for managing and processing items sequentially or with controlled concurrency.\nTasks are processed up to the configured concurrency limit. When a task completes,\nthe next pending task is processed if the concurrency limit allows.\n\nConfiguration Options:\n- `concurrency`: Maximum number of concurrent tasks (default: 1)\n- `wait`: Time to wait between processing items (default: 0)\n- `maxSize`: Maximum number of items allowed in the queue (default: Infinity)\n- `getPriority`: Function to determine item priority\n- `addItemsTo`: Default position to add items ('back' or 'front', default: 'back')\n- `getItemsFrom`: Default position to get items ('front' or 'back', default: 'front')\n- `expirationDuration`: Maximum time items can stay in queue\n- `started`: Whether to start processing immediately (default: true)\n- `asyncRetryerOptions`: Configure retry behavior for task executions\n\nError Handling:\n- If an `onError` handler is provided, it will be called with the error and queuer instance\n- If `throwOnError` is true (default when no onError handler is provided), the error will be thrown\n- If `throwOnError` is false (default when onError handler is provided), the error will be swallowed\n- Both onError and throwOnError can be used together; the handler will be called before any error is thrown\n- The error state can be checked using the underlying AsyncQueuer instance\n\nState Management:\n- Uses TanStack Store for reactive state management\n- Use `initialState` to provide initial state values when creating the async queuer\n- Use `onSuccess` callback to react to successful task execution and implement custom logic\n- Use `onError` callback to react to task execution errors and implement custom error handling\n- Use `onSettled` callback to react to task execution completion (success or error) and implement custom logic\n- Use `onItemsChange` callback to react to items being added or removed from the queue\n- Use `onExpire` callback to react to items expiring and implement custom logic\n- Use `onReject` callback to react to items being rejected when the queue is full\n- The state includes error count, expiration count, rejection count, running status, and success/settle counts\n- State can be accessed via the underlying AsyncQueuer instance's `store.state` property\n- When using framework adapters (React/Solid), state is accessed from the hook's state property\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Parameters\n\n### fn\n\n(`value`) => `Promise`\\<`any`\\>\n\n### initialOptions\n\n[`AsyncQueuerOptions`](../interfaces/AsyncQueuerOptions.md)\\<`TValue`\\>\n\n## Returns\n\n```ts\n(\n   item,\n   position?,\n   runOnItemsChange?): boolean;\n```\n\nAdds an item to the queue. If the queue is full, the item is rejected and onReject is called.\nItems can be inserted based on priority or at the front/back depending on configuration.\n`undefined` cannot be queued (it is the internal \"no item\" sentinel) and is always rejected.\n\n### Parameters\n\n#### item\n\n`TValue`\n\n#### position?\n\n[`QueuePosition`](../type-aliases/QueuePosition.md) = `...`\n\n#### runOnItemsChange?\n\n`boolean` = `true`\n\n### Returns\n\n`boolean`\n\n### Example\n\n```ts\nqueuer.addItem({ value: 'task', priority: 10 });\nqueuer.addItem('task2', 'front');\n```\n\n## Example\n\n```ts\nconst enqueue = asyncQueue<string>(async (item) => {\n  return item.toUpperCase();\n}, {\n  concurrency: 2,\n  wait: 100,\n  onSuccess: (result) => console.log('Processed:', result)\n});\n\nenqueue('hello');\n```\n"}
