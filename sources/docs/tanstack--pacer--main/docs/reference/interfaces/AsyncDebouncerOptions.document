-debouncer.ts:81"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether the debouncer is enabled. When disabled, maybeExecute will not trigger any executions.\nCan be a boolean or a function that returns a boolean.\nDefaults to true."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"initialstate","children":[{"type":"text","value":"initialState?"}]},{"type":"code","value":"optional initialState?: Partial<AsyncDebouncerState<TFn>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L85","children":[{"type":"text","value":"async-debouncer.ts:85"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Initial state for the async debouncer"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"key","children":[{"type":"text","value":"key?"}]},{"type":"code","value":"optional key?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L90","children":[{"type":"text","value":"async-debouncer.ts:90"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional key to identify this async debouncer instance.\nIf provided, the async debouncer will be identified by this key in the devtools and PacerProvider if applicable."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"leading","children":[{"type":"text","value":"leading?"}]},{"type":"code","value":"optional leading?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L95","children":[{"type":"text","value":"async-debouncer.ts:95"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether to execute on the leading edge of the timeout.\nDefaults to false."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onerror","children":[{"type":"text","value":"onError?"}]},{"type":"code","value":"optional onError?: (error, args, debouncer) => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-debouncer.ts#L101","children":[{"type":"text","value":"async-debouncer.ts:101"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional error handler for when the debounced function throws.\nIf provided, the handler will be called with the error and debouncer instance.\nThis can be used alongside throwOnError - the handler will be called before any error is thrown."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"error","children":[{"type":"text","value":"error"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":5,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Parameters"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"debouncer","children":[{"type":"text","value":"debouncer"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/AsyncDebouncer.md","children":[{"type":"inlineCode","value":"AsyncDebouncer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onsettled","children":[{"type":"text","value":"onSettled?"}]},{"type":"code","value":"optional onSettled?: (args, debouncer) => void;","lang":"ts"},{"