neCode","value":"Parameters"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"ratelimiter-4","children":[{"type":"text","value":"rateLimiter"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/AsyncRateLimiter.md","children":[{"type":"inlineCode","value":"AsyncRateLimiter"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"throwonerror","children":[{"type":"text","value":"throwOnError?"}]},{"type":"code","value":"optional throwOnError?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L130","children":[{"type":"text","value":"async-rate-limiter.ts:130"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether to throw errors when they occur.\nDefaults to true if no onError handler is provided, false if an onError handler is provided.\nCan be explicitly set to override these defaults."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"window","children":[{"type":"text","value":"window"}]},{"type":"code","value":"window: number | ((rateLimiter) => number);","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L135","children":[{"type":"text","value":"async-rate-limiter.ts:135"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Time window in milliseconds within which the limit applies.\nCan be a number or a function that returns a number."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"windowtype","children":[{"type":"text","value":"windowType?"}]},{"type":"code","value":"optional windowType?: \"fixed\" | \"sliding\";","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L142","children":[{"type":"text","value":"async-rate-limiter.ts:142"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Type of window to use for rate limiting"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"'fixed': Uses a fixed window that resets after the window period"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"'sliding': Uses a sliding window that allows executions as old ones expire\nDefaults to 'fixed'"}]}]}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"properties","text":"Properties","level":2},{"id":"asyncretryeroptions","text":"asyncRetryerOptions?","level":3},{"id":"enabled","text":"enabled?","level":3},{"id":"initialstate","text":"initialState?","level":3},{"id":"key","text":"key?","level":3},{"id":"limit","text":"limit","level":3},{"id":"onerror","text":"onError?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"error","text":"error","level":5},{"id":"args","text":"args","level":5},{"id":"ratelimiter","text":"rateLimiter","level":5},{"id":"returns","text":"Returns","level":4},{"id":"onreject","text":"onReject?","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"args-2","text":"args","level":5},{"id":"ratelimiter-2","text":"rateLimiter","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"onsettled","text":"onSettled?","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"args-3","text":"args","level":5},{"id":"ratelimiter-3","text":"rateLimiter","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"onsuccess","text":"onSuccess?","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"result","text":"result","level":5},{"id":"args-4","text":"args","level":5},{"id":"ratelimiter-4","text":"rateLimiter","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"throwonerror","text":"throwOnError?","level":3},{"id":"window","text":"window","level":3},{"id":"windowtype","text":"windowType?","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [async-rate-limiter.ts:71](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L71)\n\nOptions for configuring an async rate-limited function\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyAsyncFunction`](../type-aliases/AnyAsyncFunction.md)\n\n## Properties\n\n### asyncRetryerOptions?\n\n```ts\noptional asyncRetryerOptions?: AsyncRetryerOptions<TFn>;\n```\n\nDefined in: [async-rate-limiter.ts:75](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L75)\n\nOptions for configuring the underlying async retryer\n\n***\n\n### enabled?\n\n```ts\noptional enabled?: boolean | ((rateLimiter) => boolean);\n```\n\nDefined in: [async-rate-limiter.ts:81](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L81)\n\nWhether the rate limiter is enabled. When disabled, maybeExecute will not trigger any executions.\nCan be a boolean or a function that returns a boolean.\nDefaults to true.\n\n***\n\n### initialState?\n\n```ts\noptional initialState?: Partial<AsyncRateLimiterState<TFn>>;\n```\n\nDefined in: [async-rate-limiter.ts:85](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L85)\n\nInitial state for the rate limiter\n\n***\n\n### key?\n\n```ts\noptional key?: string;\n```\n\nDefined in: [async-rate-limiter.ts:90](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L90)\n\nOptional key to identify this async rate limiter instance.\nIf provided, the async rate limiter will be identified by this key in the devtools and PacerProvider if applicable.\n\n***\n\n### limit\n\n```ts\nlimit: number | ((rateLimiter) => number);\n```\n\nDefined in: [async-rate-limiter.ts:95](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L95)\n\nMaximum number of executions allowed within the time window.\nCan be a number or a function that returns a number.\n\n***\n\n### onError?\n\n```ts\noptional onError?: (error, args, rateLimiter) => void;\n```\n\nDefined in: [async-rate-limiter.ts:101](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L101)\n\nOptional error handler for when the rate-limited function throws.\nIf provided, the handler will be called with the error and rate limiter instance.\nThis can be used alongside throwOnError - the handler will be called before any error is thrown.\n\n#### Parameters\n\n##### error\n\n`Error`\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### rateLimiter\n\n[`AsyncRateLimiter`](../classes/AsyncRateLimiter.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### onReject?\n\n```ts\noptional onReject?: (args, rateLimiter) => void;\n```\n\nDefined in: [async-rate-limiter.ts:109](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L109)\n\nOptional callback function that is called when an execution is rejected due to rate limiting\n\n#### Parameters\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### rateLimiter\n\n[`AsyncRateLimiter`](../classes/AsyncRateLimiter.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### onSettled?\n\n```ts\noptional onSettled?: (args, rateLimiter) => void;\n```\n\nDefined in: [async-rate-limiter.ts:113](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L113)\n\nOptional function to call when the rate-limited function is executed\n\n#### Parameters\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### rateLimiter\n\n[`AsyncRateLimiter`](../classes/AsyncRateLimiter.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### onSuccess?\n\n```ts\noptional onSuccess?: (result, args, rateLimiter) => void;\n```\n\nDefined in: [async-rate-limiter.ts:120](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L120)\n\nOptional function to call when the rate-limited function is executed\n\n#### Parameters\n\n##### result\n\n`Awaited`\\<`ReturnType`\\<`TFn`\\>\\>\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### rateLimiter\n\n[`AsyncRateLimiter`](../classes/AsyncRateLimiter.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### throwOnError?\n\n```ts\noptional throwOnError?: boolean;\n```\n\nDefined in: [async-rate-limiter.ts:130](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L130)\n\nWhether to throw errors when they occur.\nDefaults to true if no onError handler is provided, false if an onError handler is provided.\nCan be explicitly set to override these defaults.\n\n***\n\n### window\n\n```ts\nwindow: number | ((rateLimiter) => number);\n```\n\nDefined in: [async-rate-limiter.ts:135](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L135)\n\nTime window in milliseconds within which the limit applies.\nCan be a number or a function that returns a number.\n\n***\n\n### windowType?\n\n```ts\noptional windowType?: \"fixed\" | \"sliding\";\n```\n\nDefined in: [async-rate-limiter.ts:142](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L142)\n\nType of window to use for rate limiting\n- 'fixed': Uses a fixed window that resets after the window period\n- 'sliding': Uses a sliding window that allows executions as old ones expire\nDefaults to 'fixed'\n","originalRawMarkdown":"---\nid: AsyncRateLimiterOptions\ntitle: AsyncRateLimiterOptions\n---\n\nDefined in: [async-rate-limiter.ts:71](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L71)\n\nOptions for configuring an async rate-limited function\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyAsyncFunction`](../type-aliases/AnyAsyncFunction.md)\n\n## Properties\n\n### asyncRetryerOptions?\n\n```ts\noptional asyncRetryerOptions?: AsyncRetryerOptions<TFn>;\n```\n\nDefined in: [async-rate-limiter.ts:75](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L75)\n\nOptions for configuring the underlying async retryer\n\n***\n\n### enabled?\n\n```ts\noptional enabled?: boolean | ((rateLimiter) => boolean);\n```\n\nDefined in: [async-rate-limiter.ts:81](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L81)\n\nWhether the rate limiter is enabled. When disabled, maybeExecute will not trigger any executions.\nCan be a boolean or a function that returns a boolean.\nDefaults to true.\n\n***\n\n### initialState?\n\n```ts\noptional initialState?: Partial<AsyncRateLimiterState<TFn>>;\n```\n\nDefined in: [async-rate-limiter.ts:85](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L85)\n\nInitial state for the rate limiter\n\n***\n\n### key?\n\n```ts\noptional key?: string;\n```\n\nDefined in: [async-rate-limiter.ts:90](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L90)\n\nOptional key to identify this async rate limiter instance.\nIf provided, the async rate limiter will be identified by this key in the devtools and PacerProvider if applicable.\n\n***\n\n### limit\n\n```ts\nlimit: number | ((rateLimiter) => number);\n```\n\nDefined in: [async-rate-limiter.ts:95](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L95)\n\nMaximum number of executions allowed within the time window.\nCan be a number or a function that returns a number.\n\n***\n\n### onError?\n\n```ts\noptional onError?: (error, args, rateLimiter) => void;\n```\n\nDefined in: [async-rate-limiter.ts:101](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L101)\n\nOptional error handler for when the rate-limited function throws.\nIf provided, the handler will be called with the error and rate limiter instance.\nThis can be used alongside throwOnError - the handler will be called before any error is thrown.\n\n#### Parameters\n\n##### error\n\n`Error`\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### rateLimiter\n\n[`AsyncRateLimiter`](../classes/AsyncRateLimiter.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### onReject?\n\n```ts\noptional onReject?: (args, rateLimiter) => void;\n```\n\nDefined in: [async-rate-limiter.ts:109](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L109)\n\nOptional callback function that is called when an execution is rejected due to rate limiting\n\n#### Parameters\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### rateLimiter\n\n[`AsyncRateLimiter`](../classes/AsyncRateLimiter.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### onSettled?\n\n```ts\noptional onSettled?: (args, rateLimiter) => void;\n```\n\nDefined in: [async-rate-limiter.ts:113](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L113)\n\nOptional function to call when the rate-limited function is executed\n\n#### Parameters\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### rateLimiter\n\n[`AsyncRateLimiter`](../classes/AsyncRateLimiter.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### onSuccess?\n\n```ts\noptional onSuccess?: (result, args, rateLimiter) => void;\n```\n\nDefined in: [async-rate-limiter.ts:120](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L120)\n\nOptional function to call when the rate-limited function is executed\n\n#### Parameters\n\n##### result\n\n`Awaited`\\<`ReturnType`\\<`TFn`\\>\\>\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### rateLimiter\n\n[`AsyncRateLimiter`](../classes/AsyncRateLimiter.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### throwOnError?\n\n```ts\noptional throwOnError?: boolean;\n```\n\nDefined in: [async-rate-limiter.ts:130](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L130)\n\nWhether to throw errors when they occur.\nDefaults to true if no onError handler is provided, false if an onError handler is provided.\nCan be explicitly set to override these defaults.\n\n***\n\n### window\n\n```ts\nwindow: number | ((rateLimiter) => number);\n```\n\nDefined in: [async-rate-limiter.ts:135](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L135)\n\nTime window in milliseconds within which the limit applies.\nCan be a number or a function that returns a number.\n\n***\n\n### windowType?\n\n```ts\noptional windowType?: \"fixed\" | \"sliding\";\n```\n\nDefined in: [async-rate-limiter.ts:142](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/async-rate-limiter.ts#L142)\n\nType of window to use for rate limiting\n- 'fixed': Uses a fixed window that resets after the window period\n- 'sliding': Uses a sliding window that allows executions as old ones expire\nDefaults to 'fixed'\n"}
