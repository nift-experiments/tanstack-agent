cer.ts#L59","children":[{"type":"text","value":"debouncer.ts:59"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Initial state for the debouncer"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"key","children":[{"type":"text","value":"key?"}]},{"type":"code","value":"optional key?: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L64","children":[{"type":"text","value":"debouncer.ts:64"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A key to identify the debouncer.\nIf provided, the debouncer will be identified by this key in the devtools and PacerProvider if applicable."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"leading","children":[{"type":"text","value":"leading?"}]},{"type":"code","value":"optional leading?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L70","children":[{"type":"text","value":"debouncer.ts:70"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether to execute on the leading edge of the timeout.\nThe first call will execute immediately and the rest will wait the delay.\nDefaults to false."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onexecute","children":[{"type":"text","value":"onExecute?"}]},{"type":"code","value":"optional onExecute?: (args, debouncer) => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L74","children":[{"type":"text","value":"debouncer.ts:74"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Callback function that is called after the function is executed"}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Parameters"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"debouncer","children":[{"type":"text","value":"debouncer"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/Debouncer.md","children":[{"type":"inlineCode","value":"Debouncer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFn"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"trailing","children":[{"type":"text","value":"trailing?"}]},{"type":"code","value":"optional trailing?: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L79","children":[{"type":"text","value":"debouncer.ts:79"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Whether to execute on the trailing edge of the timeout.\nDefaults to true."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"wait","children":[{"type":"text","value":"wait"}]},{"type":"code","value":"wait: number | ((debouncer) => number);","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L85","children":[{"type":"text","value":"debouncer.ts:85"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Delay in milliseconds before executing the function.\nCan be a number or a function that returns a number.\nDefaults to 0ms"}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfn","text":"TFn","level":3},{"id":"properties","text":"Properties","level":2},{"id":"enabled","text":"enabled?","level":3},{"id":"initialstate","text":"initialState?","level":3},{"id":"key","text":"key?","level":3},{"id":"leading","text":"leading?","level":3},{"id":"onexecute","text":"onExecute?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"args","text":"args","level":5},{"id":"debouncer","text":"debouncer","level":5},{"id":"returns","text":"Returns","level":4},{"id":"trailing","text":"trailing?","level":3},{"id":"wait","text":"wait","level":3}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [debouncer.ts:49](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L49)\n\nOptions for configuring a debounced function\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyFunction`](../type-aliases/AnyFunction.md)\n\n## Properties\n\n### enabled?\n\n```ts\noptional enabled?: boolean | ((debouncer) => boolean);\n```\n\nDefined in: [debouncer.ts:55](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L55)\n\nWhether the debouncer is enabled. When disabled, maybeExecute will not trigger any executions.\nCan be a boolean or a function that returns a boolean.\nDefaults to true.\n\n***\n\n### initialState?\n\n```ts\noptional initialState?: Partial<DebouncerState<TFn>>;\n```\n\nDefined in: [debouncer.ts:59](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L59)\n\nInitial state for the debouncer\n\n***\n\n### key?\n\n```ts\noptional key?: string;\n```\n\nDefined in: [debouncer.ts:64](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L64)\n\nA key to identify the debouncer.\nIf provided, the debouncer will be identified by this key in the devtools and PacerProvider if applicable.\n\n***\n\n### leading?\n\n```ts\noptional leading?: boolean;\n```\n\nDefined in: [debouncer.ts:70](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L70)\n\nWhether to execute on the leading edge of the timeout.\nThe first call will execute immediately and the rest will wait the delay.\nDefaults to false.\n\n***\n\n### onExecute?\n\n```ts\noptional onExecute?: (args, debouncer) => void;\n```\n\nDefined in: [debouncer.ts:74](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L74)\n\nCallback function that is called after the function is executed\n\n#### Parameters\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### debouncer\n\n[`Debouncer`](../classes/Debouncer.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### trailing?\n\n```ts\noptional trailing?: boolean;\n```\n\nDefined in: [debouncer.ts:79](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L79)\n\nWhether to execute on the trailing edge of the timeout.\nDefaults to true.\n\n***\n\n### wait\n\n```ts\nwait: number | ((debouncer) => number);\n```\n\nDefined in: [debouncer.ts:85](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L85)\n\nDelay in milliseconds before executing the function.\nCan be a number or a function that returns a number.\nDefaults to 0ms\n","originalRawMarkdown":"---\nid: DebouncerOptions\ntitle: DebouncerOptions\n---\n\nDefined in: [debouncer.ts:49](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L49)\n\nOptions for configuring a debounced function\n\n## Type Parameters\n\n### TFn\n\n`TFn` *extends* [`AnyFunction`](../type-aliases/AnyFunction.md)\n\n## Properties\n\n### enabled?\n\n```ts\noptional enabled?: boolean | ((debouncer) => boolean);\n```\n\nDefined in: [debouncer.ts:55](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L55)\n\nWhether the debouncer is enabled. When disabled, maybeExecute will not trigger any executions.\nCan be a boolean or a function that returns a boolean.\nDefaults to true.\n\n***\n\n### initialState?\n\n```ts\noptional initialState?: Partial<DebouncerState<TFn>>;\n```\n\nDefined in: [debouncer.ts:59](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L59)\n\nInitial state for the debouncer\n\n***\n\n### key?\n\n```ts\noptional key?: string;\n```\n\nDefined in: [debouncer.ts:64](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L64)\n\nA key to identify the debouncer.\nIf provided, the debouncer will be identified by this key in the devtools and PacerProvider if applicable.\n\n***\n\n### leading?\n\n```ts\noptional leading?: boolean;\n```\n\nDefined in: [debouncer.ts:70](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L70)\n\nWhether to execute on the leading edge of the timeout.\nThe first call will execute immediately and the rest will wait the delay.\nDefaults to false.\n\n***\n\n### onExecute?\n\n```ts\noptional onExecute?: (args, debouncer) => void;\n```\n\nDefined in: [debouncer.ts:74](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L74)\n\nCallback function that is called after the function is executed\n\n#### Parameters\n\n##### args\n\n`Parameters`\\<`TFn`\\>\n\n##### debouncer\n\n[`Debouncer`](../classes/Debouncer.md)\\<`TFn`\\>\n\n#### Returns\n\n`void`\n\n***\n\n### trailing?\n\n```ts\noptional trailing?: boolean;\n```\n\nDefined in: [debouncer.ts:79](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L79)\n\nWhether to execute on the trailing edge of the timeout.\nDefaults to true.\n\n***\n\n### wait\n\n```ts\nwait: number | ((debouncer) => number);\n```\n\nDefined in: [debouncer.ts:85](https://github.com/TanStack/pacer/blob/main/packages/pacer/src/debouncer.ts#L85)\n\nDelay in milliseconds before executing the function.\nCan be a number or a function that returns a number.\nDefaults to 0ms\n"}
