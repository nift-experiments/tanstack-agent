---
id: mutations
title: Mutations
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Unlike queries, mutations are typically used to create/update/delete data or perform server side-effects. For this purpose, TanStack Query exports a "},{"type":"inlineCode","value":"injectMutation"},{"type":"text","value":" function."}]},{"type":"paragraph","children":[{"type":"text","value":"Here's an example of a mutation that adds a new todo to the server:"}]},{"type":"code","value":"@Component({\n  template: `\n    <div>\n      @if (createTodoMutation.isPending()) {\n        <span>Adding todo...</span>\n      } @else if (createTodoMutation.isError()) {\n        <div>An error occurred: {{ createTodoMutation.error()?.message }}</div>\n      } @else if (createTodoMutation.isSuccess()) {\n        <div>Todo added!</div>\n      }\n      <button (click)=\"createTodoMutation.mutate(1)\">Create Todo</button>\n    </div>\n  `,\n})\nexport class TodosComponent {\n  readonly todoService = inject(TodoService)\n  readonly createTodoMutation = injectMutation(() => ({\n    mutationFn: (todoId: number) =>\n      lastValueFrom(this.todoService.create(todoId)),\n  }))\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"text","value":"A mutation can only be in one of the following states at any given moment:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isIdle"},{"type":"text","value":" or "},{"type":"inlineCode","value":"status === 'idle'"},{"type":"text","value":" - The mutation is currently idle or in a fresh/reset state"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending"},{"type":"text","value":" or "},{"type":"inlineCode","value":"status === 'pending'"},{"type":"text","value":" - The mutation is currently running"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isError"},{"type":"text","value":" or "},{"type":"inlineCode","value":"status === 'error'"},{"type":"text","value":" - The mutation encountered an error"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":" or "},{"type":"inlineCode","value":"status === 'success'"},{"type":"text","value":" - The mutation was successful and mutation data is available"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Beyond those primary states, more information is available depending on the state of the mutation:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"error"},{"type":"text","value":" - If the mutation is in an "},{"type":"inlineCode","value":"error"},{"type":"text","value":" state, the error is available via the "},{"type":"inlineCode","value":"error"},{"type":"text","value":" property."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"data"},{"type":"text","value":" - If the mutation is in a "},{"type":"inlineCode","value":"success"},{"type":"text","value":" state, the data is available via the "},{"type":"inlineCode","value":"data"},{"type":"text","value":" property."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"In the example above, you also saw that you can pass variables to your mutations function by calling the "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" function with a "},{"type":"strong","children":[{"type":"text","value":"single variable or object"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Even with just variables, mutations aren't all that special, but when used with the "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" option, the "},{"type":"link","href":"../reference/classes/QueryClient.md#invalidatequeries","children":[{"type":"text","value":"Query Client's "},{"type":"inlineCode","value":"invalidateQueries"},{"type":"text","value":" method"}]},{"type":"text","value":" and the "},{"type":"link","href":"../reference/classes/QueryClient.md#setquerydata","children":[{"type":"text","value":"Query Client's "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" method"}]},{"type":"text","value":", mutations become a very powerful tool."}]},{"type":"heading","depth":2,"id":"resetting-mutation-state","children":[{"type":"text","value":"Resetting Mutation State"}]},{"type":"paragraph","children":[{"type":"text","value":"It's sometimes the case that you need to clear the "},{"type":"inlineCode","value":"error"},{"type":"text","value":" or "},{"type":"inlineCode","value":"data"},{"type":"text","value":" of a mutation request. To do this, you can use the "},{"type":"inlineCode","value":"reset"},{"type":"text","value":" function to handle this:"}]},{"type":"code","value":"@Component({\n  selector: 'todo-item',\n  imports: [ReactiveFormsModule],\n  template: `\n    <form [formGroup]=\"todoForm\" (ngSubmit)=\"onCreateTodo()\">\n      @if (createTodoMutation.error()) {\n        <h5 (click)=\"createTodoMutation.reset()\">\n          {{ createTodoMutation.error() }}\n        </h5>\n      }\n      <input type=\"text\" formControlName=\"title\" />\n      <br />\n      <button type=\"submit\">Create Todo</button>\n    </form>\n  `,\n})\nexport class TodosComponent {\n  readonly createTodoMutation = injectMutation(() => ({\n    mutationFn: createTodo,\n  }))\n\n  readonly fb = inject(NonNullableFormBuilder)\n\n  todoForm = this.fb.group({\n    title: this.fb.control('', {\n      validators: [Validators.required],\n    }),\n  })\n\n  title = toSignal(this.todoForm.controls.title.valueChanges, {\n    initialValue: '',\n  })\n\n  onCreateTodo = () => {\n    this.createTodoMutation.mutate(this.title())\n  }\n}","lang":"angular-ts"},{"type":"heading","depth":2,"id":"mutation-side-effects","children":[{"type":"text","value":"Mutation Side Effects"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"injectMutation"},{"type":"text","value":" comes with some helper options that allow quick and easy side-effects at any stage during the mutation lifecycle. These come in handy for both "},{"type":"link","href":"./invalidations-from-mutations.md","children":[{"type":"text","value":"invalidating and refetching queries after mutations"}]},{"type":"text","value":" and even "},{"type":"link","href":"./optimistic-updates.md","children":[{"type":"text","value":"optimistic updates"}]}]},{"type":"code","value":"addTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  onMutate: (variables, context) => {\n    // A mutation is about to happen!\n\n    // Optionally return a result containing data to use when for example rolling back\n    return { id: 1 }\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // An error happened!\n    console.log(`rolling back optimistic update with id ${onMutateResult.id}`)\n  },\n  onSuccess: (data, variables, onMutateResult, context) => {\n    // Boom baby!\n  },\n  onSettled: (data, error, variables, onMutateResult, context) => {\n    // Error or success... doesn't matter!\n  },\n}))","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"When returning a promise in any of the callback functions it will first be awaited before the next callback is called:"}]},{"type":"code","value":"addTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  onSuccess: async () => {\n    console.log(\"I'm first!\")\n  },\n  onSettled: async () => {\n    console.log(\"I'm second!\")\n  },\n}))","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"You might find that you want to "},{"type":"strong","children":[{"type":"text","value":"trigger additional callbacks"}]},{"type":"text","value":" beyond the ones defined on "},{"type":"inlineCode","value":"injectMutation"},{"type":"text","value":" when calling "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":". This can be used to trigger component-specific side effects. To do that, you can provide any of the same callback options to the "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" function after your mutation variable. Supported options include: "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" and "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":". Please keep in mind that those additional callbacks won't run if your component gets destroyed "},{"type":"emphasis","children":[{"type":"text","value":"before"}]},{"type":"text","value":" the mutation finishes."}]},{"type":"code","value":"addTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  onSuccess: (data, variables, onMutateResult, context) => {\n    // I will fire first\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // I will fire first\n  },\n  onSettled: (data, error, variables, onMutateResult, context) => {\n    // I will fire first\n  },\n}))\n\naddTodoMutation.mutate(todo, {\n  onSuccess: (data, variables, onMutateResult, context) => {\n    // I will fire second!\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // I will fire second!\n  },\n  onSettled: (data, error, variables, onMutateResult, context) => {\n    // I will fire second!\n  },\n})","lang":"ts"},{"type":"heading","depth":3,"id":"consecutive-mutations","children":[{"type":"text","value":"Consecutive mutations"}]},{"type":"paragraph","children":[{"type":"text","value":"There is a slight difference in handling "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" and "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callbacks when it comes to consecutive mutations. When passed to the "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" function, they will be fired up only "},{"type":"emphasis","children":[{"type":"text","value":"once"}]},{"type":"text","value":" and only if the component is still active. This is due to the fact that mutation observer is removed and resubscribed every time when the "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" function is called. On the contrary, "},{"type":"inlineCode","value":"injectMutation"},{"type":"text","value":" handlers execute for each "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" call."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Be aware that most likely, "},{"type":"inlineCode","value":"mutationFn"},{"type":"text","value":" passed to "},{"type":"inlineCode","value":"injectMutation"},{"type":"text","value":" is asynchronous. In that case, the order in which mutations are fulfilled may differ from the order of "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" function calls."}]}]},{"type":"code","value":"export class Example {\n  readonly addTodoMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: (data, variables, onMutateResult, context) => {\n      // Will be called 3 times\n    },\n  }))\n\n  doMutations() {\n    ;['Todo 1', 'Todo 2', 'Todo 3'].forEach((todo) => {\n      this.addTodoMutation.mutate(todo, {\n        onSuccess: (data, variables, onMutateResult, context) => {\n          // Will execute only once, for the last mutation (Todo 3),\n          // regardless which mutation resolves first\n        },\n      })\n    })\n  }\n}","lang":"ts"},{"type":"heading","depth":2,"id":"promises","children":[{"type":"text","value":"Promises"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" instead of "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" to get a promise which will resolve on success or throw on an error. This can for example be used to compose side effects."}]},{"type":"code","value":"addTodoMutation = injectMutation(() => ({ mutationFn: addTodo }))\n\ntry {\n  const todo = await addTodoMutation.mutateAsync(todo)\n  console.log(todo)\n} catch (error) {\n  console.error(error)\n} finally {\n  console.log('done')\n}","lang":"ts"},{"type":"heading","depth":2,"id":"retry","children":[{"type":"text","value":"Retry"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, TanStack Query will not retry a mutation on error, but it is possible with the "},{"type":"inlineCode","value":"retry"},{"type":"text","value":" option:"}]},{"type":"code","value":"addTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  retry: 3,\n}))","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"If mutations fail because the device is offline, they will be retried in the same order when the device reconnects."}]},{"type":"heading","depth":2,"id":"persist-mutations","children":[{"type":"text","value":"Persist mutations"}]},{"type":"paragraph","children":[{"type":"text","value":"Mutations can be persisted to storage if needed and resumed at a later point. This can be done with the hydration functions:"}]},{"type":"code","value":"const queryClient = new QueryClient()\n\n// Define the \"addTodo\" mutation\nqueryClient.setMutationDefaults(['addTodo'], {\n  mutationFn: addTodo,\n  onMutate: async (variables, context) => {\n    // Cancel current queries for the todos list\n    await context.client.cancelQueries({ queryKey: ['todos'] })\n\n    // Create optimistic todo\n    const optimisticTodo = { id: uuid(), title: variables.title }\n\n    // Add optimistic todo to todos list\n    context.client.setQueryData(['todos'], (old) => [...old, optimisticTodo])\n\n    // Return result with the optimistic todo\n    return { optimisticTodo }\n  },\n  onSuccess: (result, variables, onMutateResult, context) => {\n    // Replace optimistic todo in the todos list with the result\n    context.client.setQueryData(['todos'], (old) =>\n      old.map((todo) =>\n        todo.id === onMutateResult.optimisticTodo.id ? result : todo,\n      ),\n    )\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // Remove optimistic todo from the todos list\n    context.client.setQueryData(['todos'], (old) =>\n      old.filter((todo) => todo.id !== onMutateResult.optimisticTodo.id),\n    )\n  },\n  retry: 3,\n})\n\nclass someComponent {\n  // Start mutation in some component:\n  readonly addTodoMutation = injectMutation(() => ({\n    mutationKey: ['addTodo'],\n  }))\n\n  someMethod() {\n    addTodoMutation.mutate({ title: 'title' })\n  }\n}\n\n// If the mutation has been paused because the device is for example offline,\n// Then the paused mutation can be dehydrated when the application quits:\nconst state = dehydrate(queryClient)\n\n// The mutation can then be hydrated again when the application is started:\nhydrate(queryClient, state)\n\n// Resume the paused mutations:\nqueryClient.resumePausedMutations()","lang":"ts"},{"type":"heading","depth":3,"id":"persisting-offline-mutations","children":[{"type":"text","value":"Persisting Offline mutations"}]},{"type":"paragraph","children":[{"type":"text","value":"If you persist offline mutations with the "},{"type":"link","href":"../plugins/persistQueryClient.md","children":[{"type":"text","value":"persistQueryClient plugin"}]},{"type":"text","value":", mutations cannot be resumed when the page is reloaded unless you provide a default mutation function."}]},{"type":"paragraph","children":[{"type":"text","value":"This is a technical limitation. When persisting to an external storage, only the state of mutations is persisted, as functions cannot be serialized. After hydration, the component that triggers the mutation might not be initialized, so calling "},{"type":"inlineCode","value":"resumePausedMutations"},{"type":"text","value":" might yield an error: "},{"type":"inlineCode","value":"No mutationFn found"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"We also have an extensive "},{"type":"link","href":"../examples/offline","children":[{"type":"text","value":"offline example"}]},{"type":"text","value":" that covers both queries and mutations."}]},{"type":"heading","depth":2,"id":"mutation-scopes","children":[{"type":"text","value":"Mutation Scopes"}]},{"type":"paragraph","children":[{"type":"text","value":"Per default, all mutations run in parallel - even if you invoke "},{"type":"inlineCode","value":".mutate()"},{"type":"text","value":" of the same mutation multiple times. Mutations can be given a "},{"type":"inlineCode","value":"scope"},{"type":"text","value":" with an "},{"type":"inlineCode","value":"id"},{"type":"text","value":" to avoid that. All mutations with the same "},{"type":"inlineCode","value":"scope.id"},{"type":"text","value":" will run in serial, which means when they are triggered, they will start in "},{"type":"inlineCode","value":"isPaused: true"},{"type":"text","value":" state if there is already a mutation for that scope in progress. They will be put into a queue and will automatically resume once their time in the queue has come."}]},{"type":"code","value":"const mutation = injectMutation({\n  mutationFn: addTodo,\n  scope: {\n    id: 'todo',\n  },\n})","lang":"tsx"}],"headings":[{"id":"resetting-mutation-state","text":"Resetting Mutation State","level":2},{"id":"mutation-side-effects","text":"Mutation Side Effects","level":2},{"id":"consecutive-mutations","text":"Consecutive mutations","level":3},{"id":"promises","text":"Promises","level":2},{"id":"retry","text":"Retry","level":2},{"id":"persist-mutations","text":"Persist mutations","level":2},{"id":"persisting-offline-mutations","text":"Persisting Offline mutations","level":3},{"id":"mutation-scopes","text":"Mutation Scopes","level":2}]},"frameworks":[],"downloadMarkdown":"\nUnlike queries, mutations are typically used to create/update/delete data or perform server side-effects. For this purpose, TanStack Query exports a `injectMutation` function.\n\nHere's an example of a mutation that adds a new todo to the server:\n\n\n\n```angular-ts\n@Component({\n  template: `\n    <div>\n      @if (createTodoMutation.isPending()) {\n        <span>Adding todo...</span>\n      } @else if (createTodoMutation.isError()) {\n        <div>An error occurred: {{ createTodoMutation.error()?.message }}</div>\n      } @else if (createTodoMutation.isSuccess()) {\n        <div>Todo added!</div>\n      }\n      <button (click)=\"createTodoMutation.mutate(1)\">Create Todo</button>\n    </div>\n  `,\n})\nexport class TodosComponent {\n  readonly todoService = inject(TodoService)\n  readonly createTodoMutation = injectMutation(() => ({\n    mutationFn: (todoId: number) =>\n      lastValueFrom(this.todoService.create(todoId)),\n  }))\n}\n```\n\n\n\nA mutation can only be in one of the following states at any given moment:\n\n- `isIdle` or `status === 'idle'` - The mutation is currently idle or in a fresh/reset state\n- `isPending` or `status === 'pending'` - The mutation is currently running\n- `isError` or `status === 'error'` - The mutation encountered an error\n- `isSuccess` or `status === 'success'` - The mutation was successful and mutation data is available\n\nBeyond those primary states, more information is available depending on the state of the mutation:\n\n- `error` - If the mutation is in an `error` state, the error is available via the `error` property.\n- `data` - If the mutation is in a `success` state, the data is available via the `data` property.\n\nIn the example above, you also saw that you can pass variables to your mutations function by calling the `mutate` function with a **single variable or object**.\n\nEven with just variables, mutations aren't all that special, but when used with the `onSuccess` option, the [Query Client's `invalidateQueries` method](../reference/classes/QueryClient.md#invalidatequeries) and the [Query Client's `setQueryData` method](../reference/classes/QueryClient.md#setquerydata), mutations become a very powerful tool.\n\n\n\n\n\n\n## Resetting Mutation State\n\nIt's sometimes the case that you need to clear the `error` or `data` of a mutation request. To do this, you can use the `reset` function to handle this:\n\n\n\n```angular-ts\n@Component({\n  selector: 'todo-item',\n  imports: [ReactiveFormsModule],\n  template: `\n    <form [formGroup]=\"todoForm\" (ngSubmit)=\"onCreateTodo()\">\n      @if (createTodoMutation.error()) {\n        <h5 (click)=\"createTodoMutation.reset()\">\n          {{ createTodoMutation.error() }}\n        </h5>\n      }\n      <input type=\"text\" formControlName=\"title\" />\n      <br />\n      <button type=\"submit\">Create Todo</button>\n    </form>\n  `,\n})\nexport class TodosComponent {\n  readonly createTodoMutation = injectMutation(() => ({\n    mutationFn: createTodo,\n  }))\n\n  readonly fb = inject(NonNullableFormBuilder)\n\n  todoForm = this.fb.group({\n    title: this.fb.control('', {\n      validators: [Validators.required],\n    }),\n  })\n\n  title = toSignal(this.todoForm.controls.title.valueChanges, {\n    initialValue: '',\n  })\n\n  onCreateTodo = () => {\n    this.createTodoMutation.mutate(this.title())\n  }\n}\n```\n\n\n\n## Mutation Side Effects\n\n`injectMutation` comes with some helper options that allow quick and easy side-effects at any stage during the mutation lifecycle. These come in handy for both [invalidating and refetching queries after mutations](./invalidations-from-mutations.md) and even [optimistic updates](./optimistic-updates.md)\n\n\n\n```ts\naddTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  onMutate: (variables, context) => {\n    // A mutation is about to happen!\n\n    // Optionally return a result containing data to use when for example rolling back\n    return { id: 1 }\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // An error happened!\n    console.log(`rolling back optimistic update with id ${onMutateResult.id}`)\n  },\n  onSuccess: (data, variables, onMutateResult, context) => {\n    // Boom baby!\n  },\n  onSettled: (data, error, variables, onMutateResult, context) => {\n    // Error or success... doesn't matter!\n  },\n}))\n```\n\n\n\nWhen returning a promise in any of the callback functions it will first be awaited before the next callback is called:\n\n\n\n```ts\naddTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  onSuccess: async () => {\n    console.log(\"I'm first!\")\n  },\n  onSettled: async () => {\n    console.log(\"I'm second!\")\n  },\n}))\n```\n\n\n\nYou might find that you want to **trigger additional callbacks** beyond the ones defined on `injectMutation` when calling `mutate`. This can be used to trigger component-specific side effects. To do that, you can provide any of the same callback options to the `mutate` function after your mutation variable. Supported options include: `onSuccess`, `onError` and `onSettled`. Please keep in mind that those additional callbacks won't run if your component gets destroyed _before_ the mutation finishes.\n\n\n\n```ts\naddTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  onSuccess: (data, variables, onMutateResult, context) => {\n    // I will fire first\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // I will fire first\n  },\n  onSettled: (data, error, variables, onMutateResult, context) => {\n    // I will fire first\n  },\n}))\n\naddTodoMutation.mutate(todo, {\n  onSuccess: (data, variables, onMutateResult, context) => {\n    // I will fire second!\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // I will fire second!\n  },\n  onSettled: (data, error, variables, onMutateResult, context) => {\n    // I will fire second!\n  },\n})\n```\n\n\n\n### Consecutive mutations\n\nThere is a slight difference in handling `onSuccess`, `onError` and `onSettled` callbacks when it comes to consecutive mutations. When passed to the `mutate` function, they will be fired up only _once_ and only if the component is still active. This is due to the fact that mutation observer is removed and resubscribed every time when the `mutate` function is called. On the contrary, `injectMutation` handlers execute for each `mutate` call.\n\n> Be aware that most likely, `mutationFn` passed to `injectMutation` is asynchronous. In that case, the order in which mutations are fulfilled may differ from the order of `mutate` function calls.\n\n\n\n```ts\nexport class Example {\n  readonly addTodoMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: (data, variables, onMutateResult, context) => {\n      // Will be called 3 times\n    },\n  }))\n\n  doMutations() {\n    ;['Todo 1', 'Todo 2', 'Todo 3'].forEach((todo) => {\n      this.addTodoMutation.mutate(todo, {\n        onSuccess: (data, variables, onMutateResult, context) => {\n          // Will execute only once, for the last mutation (Todo 3),\n          // regardless which mutation resolves first\n        },\n      })\n    })\n  }\n}\n```\n\n\n\n## Promises\n\nUse `mutateAsync` instead of `mutate` to get a promise which will resolve on success or throw on an error. This can for example be used to compose side effects.\n\n\n\n```ts\naddTodoMutation = injectMutation(() => ({ mutationFn: addTodo }))\n\ntry {\n  const todo = await addTodoMutation.mutateAsync(todo)\n  console.log(todo)\n} catch (error) {\n  console.error(error)\n} finally {\n  console.log('done')\n}\n```\n\n\n\n## Retry\n\nBy default, TanStack Query will not retry a mutation on error, but it is possible with the `retry` option:\n\n\n\n```ts\naddTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  retry: 3,\n}))\n```\n\n\n\nIf mutations fail because the device is offline, they will be retried in the same order when the device reconnects.\n\n## Persist mutations\n\nMutations can be persisted to storage if needed and resumed at a later point. This can be done with the hydration functions:\n\n\n\n```ts\nconst queryClient = new QueryClient()\n\n// Define the \"addTodo\" mutation\nqueryClient.setMutationDefaults(['addTodo'], {\n  mutationFn: addTodo,\n  onMutate: async (variables, context) => {\n    // Cancel current queries for the todos list\n    await context.client.cancelQueries({ queryKey: ['todos'] })\n\n    // Create optimistic todo\n    const optimisticTodo = { id: uuid(), title: variables.title }\n\n    // Add optimistic todo to todos list\n    context.client.setQueryData(['todos'], (old) => [...old, optimisticTodo])\n\n    // Return result with the optimistic todo\n    return { optimisticTodo }\n  },\n  onSuccess: (result, variables, onMutateResult, context) => {\n    // Replace optimistic todo in the todos list with the result\n    context.client.setQueryData(['todos'], (old) =>\n      old.map((todo) =>\n        todo.id === onMutateResult.optimisticTodo.id ? result : todo,\n      ),\n    )\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // Remove optimistic todo from the todos list\n    context.client.setQueryData(['todos'], (old) =>\n      old.filter((todo) => todo.id !== onMutateResult.optimisticTodo.id),\n    )\n  },\n  retry: 3,\n})\n\nclass someComponent {\n  // Start mutation in some component:\n  readonly addTodoMutation = injectMutation(() => ({\n    mutationKey: ['addTodo'],\n  }))\n\n  someMethod() {\n    addTodoMutation.mutate({ title: 'title' })\n  }\n}\n\n// If the mutation has been paused because the device is for example offline,\n// Then the paused mutation can be dehydrated when the application quits:\nconst state = dehydrate(queryClient)\n\n// The mutation can then be hydrated again when the application is started:\nhydrate(queryClient, state)\n\n// Resume the paused mutations:\nqueryClient.resumePausedMutations()\n```\n\n\n\n\n### Persisting Offline mutations\n\nIf you persist offline mutations with the [persistQueryClient plugin](../plugins/persistQueryClient.md), mutations cannot be resumed when the page is reloaded unless you provide a default mutation function.\n\n\n\nThis is a technical limitation. When persisting to an external storage, only the state of mutations is persisted, as functions cannot be serialized. After hydration, the component that triggers the mutation might not be initialized, so calling `resumePausedMutations` might yield an error: `No mutationFn found`.\n\n\n\n\n\nWe also have an extensive [offline example](../examples/offline) that covers both queries and mutations.\n\n\n\n## Mutation Scopes\n\nPer default, all mutations run in parallel - even if you invoke `.mutate()` of the same mutation multiple times. Mutations can be given a `scope` with an `id` to avoid that. All mutations with the same `scope.id` will run in serial, which means when they are triggered, they will start in `isPaused: true` state if there is already a mutation for that scope in progress. They will be put into a queue and will automatically resume once their time in the queue has come.\n\n\n\n```tsx\nconst mutation = injectMutation({\n  mutationFn: addTodo,\n  scope: {\n    id: 'todo',\n  },\n})\n```\n\n\n\n\n","originalRawMarkdown":"---\nid: mutations\ntitle: Mutations\nref: docs/framework/react/guides/mutations.md\nreplace:\n  {\n    'useMutation': 'injectMutation',\n    'hook': 'function',\n    'still mounted': 'still active',\n    'unmounts': 'gets destroyed',\n    'mounted': 'initialized',\n  }\n---\n\n[//]: # 'Example'\n\n```angular-ts\n@Component({\n  template: `\n    <div>\n      @if (createTodoMutation.isPending()) {\n        <span>Adding todo...</span>\n      } @else if (createTodoMutation.isError()) {\n        <div>An error occurred: {{ createTodoMutation.error()?.message }}</div>\n      } @else if (createTodoMutation.isSuccess()) {\n        <div>Todo added!</div>\n      }\n      <button (click)=\"createTodoMutation.mutate(1)\">Create Todo</button>\n    </div>\n  `,\n})\nexport class TodosComponent {\n  readonly todoService = inject(TodoService)\n  readonly createTodoMutation = injectMutation(() => ({\n    mutationFn: (todoId: number) =>\n      lastValueFrom(this.todoService.create(todoId)),\n  }))\n}\n```\n\n[//]: # 'Example'\n[//]: # 'Info1'\n[//]: # 'Info1'\n[//]: # 'Example2'\n[//]: # 'Example2'\n[//]: # 'Example3'\n\n```angular-ts\n@Component({\n  selector: 'todo-item',\n  imports: [ReactiveFormsModule],\n  template: `\n    <form [formGroup]=\"todoForm\" (ngSubmit)=\"onCreateTodo()\">\n      @if (createTodoMutation.error()) {\n        <h5 (click)=\"createTodoMutation.reset()\">\n          {{ createTodoMutation.error() }}\n        </h5>\n      }\n      <input type=\"text\" formControlName=\"title\" />\n      <br />\n      <button type=\"submit\">Create Todo</button>\n    </form>\n  `,\n})\nexport class TodosComponent {\n  readonly createTodoMutation = injectMutation(() => ({\n    mutationFn: createTodo,\n  }))\n\n  readonly fb = inject(NonNullableFormBuilder)\n\n  todoForm = this.fb.group({\n    title: this.fb.control('', {\n      validators: [Validators.required],\n    }),\n  })\n\n  title = toSignal(this.todoForm.controls.title.valueChanges, {\n    initialValue: '',\n  })\n\n  onCreateTodo = () => {\n    this.createTodoMutation.mutate(this.title())\n  }\n}\n```\n\n[//]: # 'Example3'\n[//]: # 'Example4'\n\n```ts\naddTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  onMutate: (variables, context) => {\n    // A mutation is about to happen!\n\n    // Optionally return a result containing data to use when for example rolling back\n    return { id: 1 }\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // An error happened!\n    console.log(`rolling back optimistic update with id ${onMutateResult.id}`)\n  },\n  onSuccess: (data, variables, onMutateResult, context) => {\n    // Boom baby!\n  },\n  onSettled: (data, error, variables, onMutateResult, context) => {\n    // Error or success... doesn't matter!\n  },\n}))\n```\n\n[//]: # 'Example4'\n[//]: # 'Example5'\n\n```ts\naddTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  onSuccess: async () => {\n    console.log(\"I'm first!\")\n  },\n  onSettled: async () => {\n    console.log(\"I'm second!\")\n  },\n}))\n```\n\n[//]: # 'Example5'\n[//]: # 'Example6'\n\n```ts\naddTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  onSuccess: (data, variables, onMutateResult, context) => {\n    // I will fire first\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // I will fire first\n  },\n  onSettled: (data, error, variables, onMutateResult, context) => {\n    // I will fire first\n  },\n}))\n\naddTodoMutation.mutate(todo, {\n  onSuccess: (data, variables, onMutateResult, context) => {\n    // I will fire second!\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // I will fire second!\n  },\n  onSettled: (data, error, variables, onMutateResult, context) => {\n    // I will fire second!\n  },\n})\n```\n\n[//]: # 'Example6'\n[//]: # 'Example7'\n\n```ts\nexport class Example {\n  readonly addTodoMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: (data, variables, onMutateResult, context) => {\n      // Will be called 3 times\n    },\n  }))\n\n  doMutations() {\n    ;['Todo 1', 'Todo 2', 'Todo 3'].forEach((todo) => {\n      this.addTodoMutation.mutate(todo, {\n        onSuccess: (data, variables, onMutateResult, context) => {\n          // Will execute only once, for the last mutation (Todo 3),\n          // regardless which mutation resolves first\n        },\n      })\n    })\n  }\n}\n```\n\n[//]: # 'Example7'\n[//]: # 'Example8'\n\n```ts\naddTodoMutation = injectMutation(() => ({ mutationFn: addTodo }))\n\ntry {\n  const todo = await addTodoMutation.mutateAsync(todo)\n  console.log(todo)\n} catch (error) {\n  console.error(error)\n} finally {\n  console.log('done')\n}\n```\n\n[//]: # 'Example8'\n[//]: # 'Example9'\n\n```ts\naddTodoMutation = injectMutation(() => ({\n  mutationFn: addTodo,\n  retry: 3,\n}))\n```\n\n[//]: # 'Example9'\n[//]: # 'Example10'\n\n```ts\nconst queryClient = new QueryClient()\n\n// Define the \"addTodo\" mutation\nqueryClient.setMutationDefaults(['addTodo'], {\n  mutationFn: addTodo,\n  onMutate: async (variables, context) => {\n    // Cancel current queries for the todos list\n    await context.client.cancelQueries({ queryKey: ['todos'] })\n\n    // Create optimistic todo\n    const optimisticTodo = { id: uuid(), title: variables.title }\n\n    // Add optimistic todo to todos list\n    context.client.setQueryData(['todos'], (old) => [...old, optimisticTodo])\n\n    // Return result with the optimistic todo\n    return { optimisticTodo }\n  },\n  onSuccess: (result, variables, onMutateResult, context) => {\n    // Replace optimistic todo in the todos list with the result\n    context.client.setQueryData(['todos'], (old) =>\n      old.map((todo) =>\n        todo.id === onMutateResult.optimisticTodo.id ? result : todo,\n      ),\n    )\n  },\n  onError: (error, variables, onMutateResult, context) => {\n    // Remove optimistic todo from the todos list\n    context.client.setQueryData(['todos'], (old) =>\n      old.filter((todo) => todo.id !== onMutateResult.optimisticTodo.id),\n    )\n  },\n  retry: 3,\n})\n\nclass someComponent {\n  // Start mutation in some component:\n  readonly addTodoMutation = injectMutation(() => ({\n    mutationKey: ['addTodo'],\n  }))\n\n  someMethod() {\n    addTodoMutation.mutate({ title: 'title' })\n  }\n}\n\n// If the mutation has been paused because the device is for example offline,\n// Then the paused mutation can be dehydrated when the application quits:\nconst state = dehydrate(queryClient)\n\n// The mutation can then be hydrated again when the application is started:\nhydrate(queryClient, state)\n\n// Resume the paused mutations:\nqueryClient.resumePausedMutations()\n```\n\n[//]: # 'Example10'\n[//]: # 'Example11'\n[//]: # 'Example11'\n[//]: # 'Materials'\n[//]: # 'Materials'\n"}
