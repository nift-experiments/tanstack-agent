---
id: paginated-queries
title: Paginated / Lagged Queries
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Rendering paginated data is a very common UI pattern and in TanStack Query, it \"just works\" by including the page information in the query key:"}]},{"type":"code","value":"const projectsQuery = injectQuery(() => ({\n  queryKey: ['projects', page()],\n  queryFn: fetchProjects,\n}))","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"However, if you run this simple example, you might notice something strange:"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"The UI jumps in and out of the "},{"type":"inlineCode","value":"success"},{"type":"text","value":" and "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" states because each new page is treated like a brand new query."}]}]},{"type":"paragraph","children":[{"type":"text","value":"This experience is not optimal and unfortunately is how many tools today insist on working. But not TanStack Query! As you may have guessed, TanStack Query comes with an awesome feature called "},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" that allows us to get around this."}]},{"type":"heading","depth":2,"id":"better-paginated-queries-with-placeholderdata","children":[{"type":"text","value":"Better Paginated Queries with "},{"type":"inlineCode","value":"placeholderData"}]},{"type":"paragraph","children":[{"type":"text","value":"Consider the following example where we would ideally want to increment a pageIndex (or cursor) for a query. If we were to use "},{"type":"inlineCode","value":"injectQuery"},{"type":"text","value":", "},{"type":"strong","children":[{"type":"text","value":"it would still technically work fine"}]},{"type":"text","value":", but the UI would jump in and out of the "},{"type":"inlineCode","value":"success"},{"type":"text","value":" and "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" states as different queries are created and destroyed for each page or cursor. By setting "},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" to "},{"type":"inlineCode","value":"(previousData) => previousData"},{"type":"text","value":" or "},{"type":"inlineCode","value":"keepPreviousData"},{"type":"text","value":" function exported from TanStack Query, we get a few new things:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"The data from the last successful fetch is available while new data is being requested, even though the query key has changed"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When the new data arrives, the previous "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is seamlessly swapped to show the new data."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isPlaceholderData"},{"type":"text","value":" is made available to know what data the query is currently providing you"}]}]}]},{"type":"code","value":"@Component({\n  selector: 'pagination-example',\n  template: `\n    <div>\n      <p>\n        In this example, each page of data remains visible as the next page is\n        fetched. The buttons and capability to proceed to the next page are also\n        suppressed until the next page cursor is known. Each page is cached as a\n        normal query too, so when going to previous pages, you'll see them\n        instantaneously while they are also re-fetched invisibly in the\n        background.\n      </p>\n      @if (projectsQuery.status() === 'pending') {\n        <div>Loading...</div>\n      } @else if (projectsQuery.status() === 'error') {\n        <div>Error: {{ projectsQuery.error().message }}</div>\n      } @else {\n        <!-- 'data' will either resolve to the latest page's data -->\n        <!-- or if fetching a new page, the last successful page's data -->\n        <div>\n          @for (project of projectsQuery.data().projects; track project.id) {\n            <p>{{ project.name }}</p>\n          }\n        </div>\n      }\n\n      <div>Current Page: {{ page() + 1 }}</div>\n      <button (click)=\"previousPage()\" [disabled]=\"page() === 0\">\n        Previous Page\n      </button>\n      <button\n        (click)=\"nextPage()\"\n        [disabled]=\"\n          projectsQuery.isPlaceholderData() || !projectsQuery.data()?.hasMore\n        \"\n      >\n        Next Page\n      </button>\n      <!-- Since the last page's data potentially sticks around between page requests, -->\n      <!-- we can use 'isFetching' to show a background loading -->\n      <!-- indicator since our status === 'pending' state won't be triggered -->\n      @if (projectsQuery.isFetching()) {\n        <span> Loading...</span>\n      }\n    </div>\n  `,\n})\nexport class PaginationExampleComponent {\n  page = signal(0)\n  readonly #queryClient = inject(QueryClient)\n\n  readonly projectsQuery = injectQuery(() => ({\n    queryKey: ['projects', this.page()],\n    queryFn: () => lastValueFrom(fetchProjects(this.page())),\n    placeholderData: keepPreviousData,\n    staleTime: 5000,\n  }))\n\n  constructor() {\n    effect(() => {\n      // Prefetch the next page!\n      if (\n        !this.projectsQuery.isPlaceholderData() &&\n        this.projectsQuery.data()?.hasMore\n      ) {\n        void this.#queryClient\n          .query({\n            queryKey: ['projects', this.page() + 1],\n            queryFn: () => lastValueFrom(fetchProjects(this.page() + 1)),\n          })\n          .catch(noop)\n      }\n    })\n  }\n\n  previousPage() {\n    this.page.update((old) => Math.max(old - 1, 0))\n  }\n\n  nextPage() {\n    this.page.update((old) =>\n      this.projectsQuery.data()?.hasMore ? old + 1 : old,\n    )\n  }\n}","lang":"angular-ts"},{"type":"heading","depth":2,"id":"lagging-infinite-query-results-with-placeholderdata","children":[{"type":"text","value":"Lagging Infinite Query results with "},{"type":"inlineCode","value":"placeholderData"}]},{"type":"paragraph","children":[{"type":"text","value":"While not as common, the "},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" option also works flawlessly with the "},{"type":"inlineCode","value":"injectInfiniteQuery"},{"type":"text","value":" function, so you can seamlessly allow your users to continue to see cached data while infinite query keys change over time."}]}],"headings":[{"id":"better-paginated-queries-with-placeholderdata","text":"Better Paginated Queries with placeholderData","level":2},{"id":"lagging-infinite-query-results-with-placeholderdata","text":"Lagging Infinite Query results with placeholderData","level":2}]},"frameworks":[],"downloadMarkdown":"\nRendering paginated data is a very common UI pattern and in TanStack Query, it \"just works\" by including the page information in the query key:\n\n\n\n```ts\nconst projectsQuery = injectQuery(() => ({\n  queryKey: ['projects', page()],\n  queryFn: fetchProjects,\n}))\n```\n\n\n\nHowever, if you run this simple example, you might notice something strange:\n\n**The UI jumps in and out of the `success` and `pending` states because each new page is treated like a brand new query.**\n\nThis experience is not optimal and unfortunately is how many tools today insist on working. But not TanStack Query! As you may have guessed, TanStack Query comes with an awesome feature called `placeholderData` that allows us to get around this.\n\n## Better Paginated Queries with `placeholderData`\n\nConsider the following example where we would ideally want to increment a pageIndex (or cursor) for a query. If we were to use `injectQuery`, **it would still technically work fine**, but the UI would jump in and out of the `success` and `pending` states as different queries are created and destroyed for each page or cursor. By setting `placeholderData` to `(previousData) => previousData` or `keepPreviousData` function exported from TanStack Query, we get a few new things:\n\n- **The data from the last successful fetch is available while new data is being requested, even though the query key has changed**.\n- When the new data arrives, the previous `data` is seamlessly swapped to show the new data.\n- `isPlaceholderData` is made available to know what data the query is currently providing you\n\n\n\n```angular-ts\n@Component({\n  selector: 'pagination-example',\n  template: `\n    <div>\n      <p>\n        In this example, each page of data remains visible as the next page is\n        fetched. The buttons and capability to proceed to the next page are also\n        suppressed until the next page cursor is known. Each page is cached as a\n        normal query too, so when going to previous pages, you'll see them\n        instantaneously while they are also re-fetched invisibly in the\n        background.\n      </p>\n      @if (projectsQuery.status() === 'pending') {\n        <div>Loading...</div>\n      } @else if (projectsQuery.status() === 'error') {\n        <div>Error: {{ projectsQuery.error().message }}</div>\n      } @else {\n        <!-- 'data' will either resolve to the latest page's data -->\n        <!-- or if fetching a new page, the last successful page's data -->\n        <div>\n          @for (project of projectsQuery.data().projects; track project.id) {\n            <p>{{ project.name }}</p>\n          }\n        </div>\n      }\n\n      <div>Current Page: {{ page() + 1 }}</div>\n      <button (click)=\"previousPage()\" [disabled]=\"page() === 0\">\n        Previous Page\n      </button>\n      <button\n        (click)=\"nextPage()\"\n        [disabled]=\"\n          projectsQuery.isPlaceholderData() || !projectsQuery.data()?.hasMore\n        \"\n      >\n        Next Page\n      </button>\n      <!-- Since the last page's data potentially sticks around between page requests, -->\n      <!-- we can use 'isFetching' to show a background loading -->\n      <!-- indicator since our status === 'pending' state won't be triggered -->\n      @if (projectsQuery.isFetching()) {\n        <span> Loading...</span>\n      }\n    </div>\n  `,\n})\nexport class PaginationExampleComponent {\n  page = signal(0)\n  readonly #queryClient = inject(QueryClient)\n\n  readonly projectsQuery = injectQuery(() => ({\n    queryKey: ['projects', this.page()],\n    queryFn: () => lastValueFrom(fetchProjects(this.page())),\n    placeholderData: keepPreviousData,\n    staleTime: 5000,\n  }))\n\n  constructor() {\n    effect(() => {\n      // Prefetch the next page!\n      if (\n        !this.projectsQuery.isPlaceholderData() &&\n        this.projectsQuery.data()?.hasMore\n      ) {\n        void this.#queryClient\n          .query({\n            queryKey: ['projects', this.page() + 1],\n            queryFn: () => lastValueFrom(fetchProjects(this.page() + 1)),\n          })\n          .catch(noop)\n      }\n    })\n  }\n\n  previousPage() {\n    this.page.update((old) => Math.max(old - 1, 0))\n  }\n\n  nextPage() {\n    this.page.update((old) =>\n      this.projectsQuery.data()?.hasMore ? old + 1 : old,\n    )\n  }\n}\n```\n\n\n\n## Lagging Infinite Query results with `placeholderData`\n\nWhile not as common, the `placeholderData` option also works flawlessly with the `injectInfiniteQuery` function, so you can seamlessly allow your users to continue to see cached data while infinite query keys change over time.\n","originalRawMarkdown":"---\nid: paginated-queries\ntitle: Paginated / Lagged Queries\nref: docs/framework/react/guides/paginated-queries.md\nreplace:\n  {\n    'useQuery': 'injectQuery',\n    'useInfiniteQuery': 'injectInfiniteQuery',\n    'hook': 'function',\n  }\n---\n\n[//]: # 'Example'\n\n```ts\nconst projectsQuery = injectQuery(() => ({\n  queryKey: ['projects', page()],\n  queryFn: fetchProjects,\n}))\n```\n\n[//]: # 'Example'\n[//]: # 'Example2'\n\n```angular-ts\n@Component({\n  selector: 'pagination-example',\n  template: `\n    <div>\n      <p>\n        In this example, each page of data remains visible as the next page is\n        fetched. The buttons and capability to proceed to the next page are also\n        suppressed until the next page cursor is known. Each page is cached as a\n        normal query too, so when going to previous pages, you'll see them\n        instantaneously while they are also re-fetched invisibly in the\n        background.\n      </p>\n      @if (projectsQuery.status() === 'pending') {\n        <div>Loading...</div>\n      } @else if (projectsQuery.status() === 'error') {\n        <div>Error: {{ projectsQuery.error().message }}</div>\n      } @else {\n        <!-- 'data' will either resolve to the latest page's data -->\n        <!-- or if fetching a new page, the last successful page's data -->\n        <div>\n          @for (project of projectsQuery.data().projects; track project.id) {\n            <p>{{ project.name }}</p>\n          }\n        </div>\n      }\n\n      <div>Current Page: {{ page() + 1 }}</div>\n      <button (click)=\"previousPage()\" [disabled]=\"page() === 0\">\n        Previous Page\n      </button>\n      <button\n        (click)=\"nextPage()\"\n        [disabled]=\"\n          projectsQuery.isPlaceholderData() || !projectsQuery.data()?.hasMore\n        \"\n      >\n        Next Page\n      </button>\n      <!-- Since the last page's data potentially sticks around between page requests, -->\n      <!-- we can use 'isFetching' to show a background loading -->\n      <!-- indicator since our status === 'pending' state won't be triggered -->\n      @if (projectsQuery.isFetching()) {\n        <span> Loading...</span>\n      }\n    </div>\n  `,\n})\nexport class PaginationExampleComponent {\n  page = signal(0)\n  readonly #queryClient = inject(QueryClient)\n\n  readonly projectsQuery = injectQuery(() => ({\n    queryKey: ['projects', this.page()],\n    queryFn: () => lastValueFrom(fetchProjects(this.page())),\n    placeholderData: keepPreviousData,\n    staleTime: 5000,\n  }))\n\n  constructor() {\n    effect(() => {\n      // Prefetch the next page!\n      if (\n        !this.projectsQuery.isPlaceholderData() &&\n        this.projectsQuery.data()?.hasMore\n      ) {\n        void this.#queryClient\n          .query({\n            queryKey: ['projects', this.page() + 1],\n            queryFn: () => lastValueFrom(fetchProjects(this.page() + 1)),\n          })\n          .catch(noop)\n      }\n    })\n  }\n\n  previousPage() {\n    this.page.update((old) => Math.max(old - 1, 0))\n  }\n\n  nextPage() {\n    this.page.update((old) =>\n      this.projectsQuery.data()?.hasMore ? old + 1 : old,\n    )\n  }\n}\n```\n\n[//]: # 'Example2'\n"}
