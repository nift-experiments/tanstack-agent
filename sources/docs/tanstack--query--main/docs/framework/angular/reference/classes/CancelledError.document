tObject"},{"type":"text","value":", which when accessed returns\na string representing the location in the code at which\n"},{"type":"inlineCode","value":"Error.captureStackTrace()"},{"type":"text","value":" was called."}]},{"type":"code","value":"const myObject = {};\nError.captureStackTrace(myObject);\nmyObject.stack;  // Similar to `new Error().stack`","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"The first line of the trace will be prefixed with\n"},{"type":"inlineCode","value":"${myObject.name}: ${myObject.message}"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The optional "},{"type":"inlineCode","value":"constructorOpt"},{"type":"text","value":" argument accepts a function. If given, all frames\nabove "},{"type":"inlineCode","value":"constructorOpt"},{"type":"text","value":", including "},{"type":"inlineCode","value":"constructorOpt"},{"type":"text","value":", will be omitted from the\ngenerated stack trace."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"constructorOpt"},{"type":"text","value":" argument is useful for hiding implementation\ndetails of error generation from the user. For instance:"}]},{"type":"code","value":"function a() {\n  b();\n}\n\nfunction b() {\n  c();\n}\n\nfunction c() {\n  // Create an error without stack trace to avoid calculating the stack trace twice.\n  const { stackTraceLimit } = Error;\n  Error.stackTraceLimit = 0;\n  const error = new Error();\n  Error.stackTraceLimit = stackTraceLimit;\n\n  // Capture the stack trace above function b\n  Error.captureStackTrace(error, b); // Neither function c, nor b is included in the stack trace\n  throw error;\n}\n\na();","lang":"js"},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"targetobject","children":[{"type":"text","value":"targetObject"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":5,"id":"constructoropt","children":[{"type":"text","value":"constructorOpt?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Function"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"inherited-from-6","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"Error.captureStackTrace","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"preparestacktrace","children":[{"type":"text","value":"prepareStackTrace()"}]},{"type":"code","value":"static prepareStackTrace(err: Error, stackTraces: CallSite[]): any;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: node_modules/.pnpm/@types+node@22.19.15/node_modules/@types/node/globals.d.ts:56"}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"err","children":[{"type":"text","value":"err"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":5,"id":"stacktraces","children":[{"type":"text","value":"stackTraces"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"CallSite"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"any"}]},{"type":"heading","depth":4,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"text","value":"https://v8.dev/docs/stack-trace-api#customizing-stack-traces"}]},{"type":"heading","depth":4,"id":"inherited-from-7","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"Error.prepareStackTrace","lang":"ts"}],"headings":[{"id":"example","text":"Example","level":2},{"id":"extends","text":"Extends","level":2},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"options","text":"options?","level":5},{"id":"returns","text":"Returns","level":4},{"id":"overrides","text":"Overrides","level":4},{"id":"properties","text":"Properties","level":2},{"id":"cause","text":"cause?","level":3},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"message","text":"message","level":3},{"id":"inherited-from-2","text":"Inherited from","level":4},{"id":"name","text":"name","level":3},{"id":"inherited-from-3","text":"Inherited from","level":4},{"id":"revert","text":"revert?","level":3},{"id":"silent","text":"silent?","level":3},{"id":"stack","text":"stack?","level":3},{"id":"inherited-from-4","text":"Inherited from","level":4},{"id":"stacktracelimit","text":"stackTraceLimit","level":3},{"id":"inherited-from-5","text":"Inherited from","level":4},{"id":"methods","text":"Methods","level":2},{"id":"capturestacktrace","text":"captureStackTrace()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"targetobject","text":"targetObject","level":5},{"id":"constructoropt","text":"constructorOpt?","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"inherited-from-6","text":"Inherited from","level":4},{"id":"preparestacktrace","text":"prepareStackTrace()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"err","text":"err","level":5},{"id":"stacktraces","text":"stackTraces","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"see","text":"See","level":4},{"id":"inherited-from-7","text":"Inherited from","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/retryer.ts:120](https://github.com/TanStack/query/blob/main/packages/query-core/src/retryer.ts#L120)\n\nThe error thrown by a `Retryer` (and surfaced to `query.promise`/`mutation`) when a fetch is cancelled, e.g. via\n`query.cancel()`. `revert`, if `true`, tells the caller to restore the state the query was in before the fetch\nstarted instead of surfacing the error. `silent`, if `true`, tells the caller to suppress this error and instead\nresolve with the promise of the fetch that triggered the cancellation.\n\n## Example\n\n```ts\nquery.cancel()\n\ntry {\n  await query.promise\n} catch (error) {\n  if (error instanceof CancelledError) {\n    // the fetch was cancelled, e.g. via `query.cancel()`\n  }\n}\n```\n\n## Extends\n\n- `Error`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew CancelledError(options?: CancelOptions): CancelledError;\n```\n\nDefined in: [packages/query-core/src/retryer.ts:123](https://github.com/TanStack/query/blob/main/packages/query-core/src/retryer.ts#L123)\n\n#### Parameters\n\n##### options?\n\n[`CancelOptions`](../interfaces/CancelOptions.md)\n\n#### Returns\n\n`CancelledError`\n\n#### Overrides\n\n```ts\nError.constructor\n```\n\n## Properties\n\n### cause?\n\n```ts\noptional cause?: unknown;\n```\n\nDefined in: node\\_modules/.pnpm/typescript@6.0.3/node\\_modules/typescript/lib/lib.es2022.error.d.ts:24\n\n#### Inherited from\n\n```ts\nError.cause\n```\n\n***\n\n### message\n\n```ts\nmessage: string;\n```\n\nDefined in: node\\_modules/.pnpm/typescript@6.0.3/node\\_modules/typescript/lib/lib.es5.d.ts:1075\n\n#### Inherited from\n\n```ts\nError.message\n```\n\n***\n\n### name\n\n```ts\nname: string;\n```\n\nDefined in: node\\_modules/.pnpm/typescript@6.0.3/node\\_modules/typescript/lib/lib.es5.d.ts:1074\n\n#### Inherited from\n\n```ts\nError.name\n```\n\n***\n\n### revert?\n\n```ts\noptional revert?: boolean;\n```\n\nDefined in: [packages/query-core/src/retryer.ts:121](https://github.com/TanStack/query/blob/main/packages/query-core/src/retryer.ts#L121)\n\n***\n\n### silent?\n\n```ts\noptional silent?: boolean;\n```\n\nDefined in: [packages/query-core/src/retryer.ts:122](https://github.com/TanStack/query/blob/main/packages/query-core/src/retryer.ts#L122)\n\n***\n\n### stack?\n\n```ts\noptional stack?: string;\n```\n\nDefined in: node\\_modules/.pnpm/typescript@6.0.3/node\\_modules/typescript/lib/lib.es5.d.ts:1076\n\n#### Inherited from\n\n```ts\nError.stack\n```\n\n***\n\n### stackTraceLimit\n\n```ts\nstatic stackTraceLimit: number;\n```\n\nDefined in: node\\_modules/.pnpm/@types+node@22.19.15/node\\_modules/@types/node/globals.d.ts:68\n\nThe `Error.stackTraceLimit` property specifies the number of stack frames\ncollected by a stack trace (whether generated by `new Error().stack` or\n`Error.captureStackTrace(obj)`).\n\nThe default value is `10` but may be set to any valid JavaScript number. Changes\nwill affect any stack trace captured _after_ the value has been changed.\n\nIf set to a non-number value, or set to a negative number, stack traces will\nnot capture any frames.\n\n#### Inherited from\n\n```ts\nError.stackTraceLimit\n```\n\n## Methods\n\n### captureStackTrace()\n\n```ts\nstatic captureStackTrace(targetObject: object, constructorOpt?: Function): void;\n```\n\nDefined in: node\\_modules/.pnpm/@types+node@22.19.15/node\\_modules/@types/node/globals.d.ts:52\n\nCreates a `.stack` property on `targetObject`, which when accessed returns\na string representing the location in the code at which\n`Error.captureStackTrace()` was called.\n\n```js\nconst myObject = {};\nError.captureStackTrace(myObject);\nmyObject.stack;  // Similar to `new Error().stack`\n```\n\nThe first line of the trace will be prefixed with\n`${myObject.name}: ${myObject.message}`.\n\nThe optional `constructorOpt` argument accepts a function. If given, all frames\nabove `constructorOpt`, including `constructorOpt`, will be omitted from the\ngenerated stack trace.\n\nThe `constructorOpt` argument is useful for hiding implementation\ndetails of error generation from the user. For instance:\n\n```js\nfunction a() {\n  b();\n}\n\nfunction b() {\n  c();\n}\n\nfunction c() {\n  // Create an error without stack trace to avoid calculating the stack trace twice.\n  const { stackTraceLimit } = Error;\n  Error.stackTraceLimit = 0;\n  const error = new Error();\n  Error.stackTraceLimit = stackTraceLimit;\n\n  // Capture the stack trace above function b\n  Error.captureStackTrace(error, b); // Neither function c, nor b is included in the stack trace\n  throw error;\n}\n\na();\n```\n\n#### Parameters\n\n##### targetObject\n\n`object`\n\n##### constructorOpt?\n\n`Function`\n\n#### Returns\n\n`void`\n\n#### Inherited from\n\n```ts\nError.captureStackTrace\n```\n\n***\n\n### prepareStackTrace()\n\n```ts\nstatic prepareStackTrace(err: Error, stackTraces: CallSite[]): any;\n```\n\nDefined in: node\\_modules/.pnpm/@types+node@22.19.15/node\\_modules/@types/node/globals.d.ts:56\n\n#### Parameters\n\n##### err\n\n`Error`\n\n##### stackTraces\n\n`CallSite`[]\n\n#### Returns\n\n`any`\n\n#### See\n\nhttps://v8.dev/docs/stack-trace-api#customizing-stack-traces\n\n#### Inherited from\n\n```ts\nError.prepareStackTrace\n```\n","originalRawMarkdown":"---\nid: CancelledError\ntitle: CancelledError\n---\n\nDefined in: [packages/query-core/src/retryer.ts:120](https://github.com/TanStack/query/blob/main/packages/query-core/src/retryer.ts#L120)\n\nThe error thrown by a `Retryer` (and surfaced to `query.promise`/`mutation`) when a fetch is cancelled, e.g. via\n`query.cancel()`. `revert`, if `true`, tells the caller to restore the state the query was in before the fetch\nstarted instead of surfacing the error. `silent`, if `true`, tells the caller to suppress this error and instead\nresolve with the promise of the fetch that triggered the cancellation.\n\n## Example\n\n```ts\nquery.cancel()\n\ntry {\n  await query.promise\n} catch (error) {\n  if (error instanceof CancelledError) {\n    // the fetch was cancelled, e.g. via `query.cancel()`\n  }\n}\n```\n\n## Extends\n\n- `Error`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew CancelledError(options?: CancelOptions): CancelledError;\n```\n\nDefined in: [packages/query-core/src/retryer.ts:123](https://github.com/TanStack/query/blob/main/packages/query-core/src/retryer.ts#L123)\n\n#### Parameters\n\n##### options?\n\n[`CancelOptions`](../interfaces/CancelOptions.md)\n\n#### Returns\n\n`CancelledError`\n\n#### Overrides\n\n```ts\nError.constructor\n```\n\n## Properties\n\n### cause?\n\n```ts\noptional cause?: unknown;\n```\n\nDefined in: node\\_modules/.pnpm/typescript@6.0.3/node\\_modules/typescript/lib/lib.es2022.error.d.ts:24\n\n#### Inherited from\n\n```ts\nError.cause\n```\n\n***\n\n### message\n\n```ts\nmessage: string;\n```\n\nDefined in: node\\_modules/.pnpm/typescript@6.0.3/node\\_modules/typescript/lib/lib.es5.d.ts:1075\n\n#### Inherited from\n\n```ts\nError.message\n```\n\n***\n\n### name\n\n```ts\nname: string;\n```\n\nDefined in: node\\_modules/.pnpm/typescript@6.0.3/node\\_modules/typescript/lib/lib.es5.d.ts:1074\n\n#### Inherited from\n\n```ts\nError.name\n```\n\n***\n\n### revert?\n\n```ts\noptional revert?: boolean;\n```\n\nDefined in: [packages/query-core/src/retryer.ts:121](https://github.com/TanStack/query/blob/main/packages/query-core/src/retryer.ts#L121)\n\n***\n\n### silent?\n\n```ts\noptional silent?: boolean;\n```\n\nDefined in: [packages/query-core/src/retryer.ts:122](https://github.com/TanStack/query/blob/main/packages/query-core/src/retryer.ts#L122)\n\n***\n\n### stack?\n\n```ts\noptional stack?: string;\n```\n\nDefined in: node\\_modules/.pnpm/typescript@6.0.3/node\\_modules/typescript/lib/lib.es5.d.ts:1076\n\n#### Inherited from\n\n```ts\nError.stack\n```\n\n***\n\n### stackTraceLimit\n\n```ts\nstatic stackTraceLimit: number;\n```\n\nDefined in: node\\_modules/.pnpm/@types+node@22.19.15/node\\_modules/@types/node/globals.d.ts:68\n\nThe `Error.stackTraceLimit` property specifies the number of stack frames\ncollected by a stack trace (whether generated by `new Error().stack` or\n`Error.captureStackTrace(obj)`).\n\nThe default value is `10` but may be set to any valid JavaScript number. Changes\nwill affect any stack trace captured _after_ the value has been changed.\n\nIf set to a non-number value, or set to a negative number, stack traces will\nnot capture any frames.\n\n#### Inherited from\n\n```ts\nError.stackTraceLimit\n```\n\n## Methods\n\n### captureStackTrace()\n\n```ts\nstatic captureStackTrace(targetObject: object, constructorOpt?: Function): void;\n```\n\nDefined in: node\\_modules/.pnpm/@types+node@22.19.15/node\\_modules/@types/node/globals.d.ts:52\n\nCreates a `.stack` property on `targetObject`, which when accessed returns\na string representing the location in the code at which\n`Error.captureStackTrace()` was called.\n\n```js\nconst myObject = {};\nError.captureStackTrace(myObject);\nmyObject.stack;  // Similar to `new Error().stack`\n```\n\nThe first line of the trace will be prefixed with\n`${myObject.name}: ${myObject.message}`.\n\nThe optional `constructorOpt` argument accepts a function. If given, all frames\nabove `constructorOpt`, including `constructorOpt`, will be omitted from the\ngenerated stack trace.\n\nThe `constructorOpt` argument is useful for hiding implementation\ndetails of error generation from the user. For instance:\n\n```js\nfunction a() {\n  b();\n}\n\nfunction b() {\n  c();\n}\n\nfunction c() {\n  // Create an error without stack trace to avoid calculating the stack trace twice.\n  const { stackTraceLimit } = Error;\n  Error.stackTraceLimit = 0;\n  const error = new Error();\n  Error.stackTraceLimit = stackTraceLimit;\n\n  // Capture the stack trace above function b\n  Error.captureStackTrace(error, b); // Neither function c, nor b is included in the stack trace\n  throw error;\n}\n\na();\n```\n\n#### Parameters\n\n##### targetObject\n\n`object`\n\n##### constructorOpt?\n\n`Function`\n\n#### Returns\n\n`void`\n\n#### Inherited from\n\n```ts\nError.captureStackTrace\n```\n\n***\n\n### prepareStackTrace()\n\n```ts\nstatic prepareStackTrace(err: Error, stackTraces: CallSite[]): any;\n```\n\nDefined in: node\\_modules/.pnpm/@types+node@22.19.15/node\\_modules/@types/node/globals.d.ts:56\n\n#### Parameters\n\n##### err\n\n`Error`\n\n##### stackTraces\n\n`CallSite`[]\n\n#### Returns\n\n`any`\n\n#### See\n\nhttps://v8.dev/docs/stack-trace-api#customizing-stack-traces\n\n#### Inherited from\n\n```ts\nError.prepareStackTrace\n```\n"}
