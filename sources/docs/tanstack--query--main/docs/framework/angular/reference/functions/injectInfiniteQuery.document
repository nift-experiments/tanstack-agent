addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":". "},{"type":"inlineCode","value":"data().pages"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"data().pageParams"},{"type":"text","value":" are also added, as long as a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" doesn't change "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" away from its default\n"},{"type":"inlineCode","value":"InfiniteData<TQueryFnData>"},{"type":"text","value":" shape."}]},{"type":"heading","depth":3,"id":"remarks","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"Keep in mind that imperative fetch calls, such as "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like "},{"type":"inlineCode","value":"hasNextPage() && !isFetching()"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"infiniteQueryOptions.md","children":[{"type":"text","value":"infiniteQueryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"injectInfiniteQuery"},{"type":"text","value":" and imperative APIs\nlike "},{"type":"inlineCode","value":"queryClient.fetchInfiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"@Component({\n  selector: 'projects',\n  template: `\n    <!-- `projectsQuery.data()` is never `undefined`, thanks to `initialData` — even if a\n    refetch fails, so the list stays visible alongside the error. -->\n    <ul>\n      @for (page of projectsQuery.data().pages; track $index) {\n        @for (project of page.projects; track project.id) {\n          <li>{{ project.name }}</li>\n        }\n      }\n    </ul>\n  `,\n})\nexport class Projects {\n  readonly projectsQuery = injectInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n    initialData: { pages: [], pageParams: [] },\n  }))\n}","lang":"angular-ts"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function injectInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(injectInfiniteQueryFn: () => UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, options?: InjectInfiniteQueryOptions): CreateInfiniteQueryResult<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/inject-infinite-query.ts#L237","children":[{"type":"text","value":"packages/angular-query-experimental/src/inject-infinite-query.ts:237"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Injects an infinite query: a declarative dependency on an asynchronous source of data that is tied to a\nunique key. Infinite queries can additively \"load more\" data onto an existing set of data, or\n\"infinite scroll\"."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-2","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"terror-2","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-2","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"tquerykey-2","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"tpageparam-2","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"injectinfinitequeryfn-2","children":[{"type":"text","value":"injectInfiniteQueryFn"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A function returning the "},{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"text","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":" to use\n— everything you can pass to "},{"type":"inlineCode","value":"injectInfiniteQuery"},{"type":"text","value":". Similar to "},{"type":"inlineCode","value":"computed"},{"type":"text","value":" from Angular, this function runs\nin the reactive context, so signals read inside it drive the query."}]},{"type":"heading","depth":4,"id":"options-2","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/InjectInfiniteQueryOptions.md","children":[{"type":"inlineCode","value":"InjectInfiniteQueryOptions"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Additional configuration."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/CreateInfiniteQueryResult.md","children":[{"type":"inlineCode","value":"CreateInfiniteQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same signals as "},{"type":"inlineCode","value":"injectQuery"},{"type":"text","value":", with the addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":". "},{"type":"inlineCode","value":"data().pages"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"data().pageParams"},{"type":"text","value":" are also added, as long as a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" doesn't change "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" away from its default\n"},{"type":"inlineCode","value":"InfiniteData<TQueryFnData>"},{"type":"text","value":" shape."}]},{"type":"heading","depth":3,"id":"remarks-2","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"Keep in mind that imperative fetch calls, such as "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like "},{"type":"inlineCode","value":"hasNextPage() && !isFetching()"},{"type":"text","value":". This is the only overload that accepts\n"},{"type":"inlineCode","value":"queryFn: skipToken"},{"type":"text","value":", shown below."}]},{"type":"heading","depth":3,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"infiniteQueryOptions.md","children":[{"type":"text","value":"infiniteQueryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"injectInfiniteQuery"},{"type":"text","value":" and imperative APIs\nlike "},{"type":"inlineCode","value":"queryClient.fetchInfiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Fetching the next page from a button click:"}]},{"type":"code","value":"@Component({\n  selector: 'projects-list',\n  template: `\n    <ul>\n      @for (page of projectsQuery.data()?.pages; track $index) {\n        @for (project of page.projects; track project.id) {\n          <li>{{ project.name }}</li>\n        }\n      }\n    </ul>\n    <button\n      [disabled]=\"!projectsQuery.hasNextPage() || projectsQuery.isFetching()\"\n      (click)=\"projectsQuery.fetchNextPage()\"\n    >\n      Load More\n    </button>\n  `,\n})\nexport class ProjectsList {\n  readonly projectsQuery = injectInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"text","value":"Fetching the next page automatically as the user scrolls, using an "},{"type":"inlineCode","value":"IntersectionObserver"},{"type":"text","value":" on a sentinel\nelement after the list:"}]},{"type":"code","value":"@Component({\n  selector: 'projects-list',\n  template: `\n    <ul>\n      @for (page of projectsQuery.data()?.pages; track $index) {\n        @for (project of page.projects; track project.id) {\n          <li>{{ project.name }}</li>\n        }\n      }\n    </ul>\n    <div #sentinel>{{ projectsQuery.isFetchingNextPage() ? 'Loading more...' : '' }}</div>\n  `,\n})\nexport class ProjectsList {\n  readonly sentinel = viewChild<ElementRef<HTMLElement>>('sentinel')\n\n  readonly projectsQuery = injectInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  constructor() {\n    effect((onCleanup) => {\n      const sentinel = this.sentinel()?.nativeElement\n      if (\n        sentinel == null ||\n        !this.projectsQuery.hasNextPage() ||\n        this.projectsQuery.isFetching()\n      ) {\n        return\n      }\n\n      const observer = new IntersectionObserver(([entry]) => {\n        if (entry?.isIntersecting) this.projectsQuery.fetchNextPage()\n      })\n      observer.observe(sentinel)\n\n      onCleanup(() => observer.disconnect())\n    })\n  }\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"text","value":"A query that's disabled, type safe, until "},{"type":"inlineCode","value":"postId"},{"type":"text","value":" is set — pass "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" as "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" instead of\nsetting "},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":":"}]},{"type":"code","value":"@Component({\n  selector: 'comments',\n  template: `\n    @if (postId() == null) {\n      Select a post\n    } @else if (commentsQuery.isPending()) {\n      Loading...\n    } @else if (commentsQuery.isError()) {\n      <span>Error: {{ commentsQuery.error()?.message }}</span>\n    } @else {\n      <ul>\n        @for (page of commentsQuery.data().pages; track $index) {\n          @for (comment of page.comments; track comment.id) {\n            <li>{{ comment.text }}</li>\n          }\n        }\n      </ul>\n    }\n  `,\n})\nexport class Comments {\n  readonly postId = signal<string | undefined>(undefined)\n\n  readonly commentsQuery = injectInfiniteQuery(() => ({\n    queryKey: ['post', this.postId(), 'comments'],\n    queryFn:\n      this.postId() != null\n        ? ({ pageParam }) => fetchComments(this.postId()!, pageParam)\n        : skipToken,\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n}","lang":"angular-ts"},{"type":"html","value":"<a id=\"call-signature-3\"></a>"},{"