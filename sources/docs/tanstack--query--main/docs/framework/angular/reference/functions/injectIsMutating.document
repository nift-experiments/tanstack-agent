nlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"status?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"error\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"pending\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"success\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"idle\""}]},{"type":"tableCell","children":[{"type":"text","value":"Filter by mutation status"}]}]]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/InjectIsMutatingOptions.md","children":[{"type":"inlineCode","value":"InjectIsMutatingOptions"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Additional configuration"}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-injector\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"injector?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Injector"}]},{"type":"tableCell","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"Injector"},{"type":"text","value":" in which to create the isMutating signal. If this is not provided, the current injection context will be used instead (via "},{"type":"inlineCode","value":"inject"},{"type":"text","value":")."}]}]]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Signal"},{"type":"text","value":"<"},{"type":"inlineCode","value":"number"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"Signal"},{"type":"text","value":" with the number of mutations that your application currently has "},{"type":"inlineCode","value":"pending"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"@Component({\n  selector: 'posts-mutating-indicator',\n  template: `\n    @if (isMutatingPosts()) {\n      <span>Saving posts...</span>\n    }\n  `,\n})\nexport class PostsMutatingIndicator {\n  // How many mutations matching the posts prefix are in progress?\n  readonly isMutatingPosts = injectIsMutating({ mutationKey: ['posts'] })\n}","lang":"angular-ts"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"filters","text":"filters?","level":3},{"id":"filters-properties","text":"filters properties","level":4},{"id":"options","text":"options?","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction injectIsMutating(filters?: MutationFilters<unknown, Error, unknown, unknown>, options?: InjectIsMutatingOptions): Signal<number>;\n```\n\nDefined in: [packages/angular-query-experimental/src/inject-is-mutating.ts:47](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/inject-is-mutating.ts#L47)\n\nInjects a signal that tracks the number of mutations that your application currently has `pending`\n(useful for app-wide loading indicators).\n\n## Parameters\n\n### filters?\n\n[`MutationFilters`](../interfaces/MutationFilters.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\nThe [MutationFilters](../interfaces/MutationFilters.md) to narrow down the matched mutations.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | Match mutation key exactly |\n| <a id=\"filters-property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | Include mutations matching this mutation key |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`mutation`: [`Mutation`](../classes/Mutation.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>) => `boolean` | Include mutations matching this predicate function |\n| <a id=\"filters-property-status\"></a> `status?` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` \\| `\"idle\"` | Filter by mutation status |\n\n### options?\n\n[`InjectIsMutatingOptions`](../interfaces/InjectIsMutatingOptions.md)\n\nAdditional configuration\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-injector\"></a> `injector?` | `Injector` | The `Injector` in which to create the isMutating signal. If this is not provided, the current injection context will be used instead (via `inject`). |\n\n## Returns\n\n`Signal`\\<`number`\\>\n\nA `Signal` with the number of mutations that your application currently has `pending`.\n\n## Example\n\n```angular-ts\n@Component({\n  selector: 'posts-mutating-indicator',\n  template: `\n    @if (isMutatingPosts()) {\n      <span>Saving posts...</span>\n    }\n  `,\n})\nexport class PostsMutatingIndicator {\n  // How many mutations matching the posts prefix are in progress?\n  readonly isMutatingPosts = injectIsMutating({ mutationKey: ['posts'] })\n}\n```\n","originalRawMarkdown":"---\nid: injectIsMutating\ntitle: injectIsMutating\n---\n\n```ts\nfunction injectIsMutating(filters?: MutationFilters<unknown, Error, unknown, unknown>, options?: InjectIsMutatingOptions): Signal<number>;\n```\n\nDefined in: [packages/angular-query-experimental/src/inject-is-mutating.ts:47](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/inject-is-mutating.ts#L47)\n\nInjects a signal that tracks the number of mutations that your application currently has `pending`\n(useful for app-wide loading indicators).\n\n## Parameters\n\n### filters?\n\n[`MutationFilters`](../interfaces/MutationFilters.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\nThe [MutationFilters](../interfaces/MutationFilters.md) to narrow down the matched mutations.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | Match mutation key exactly |\n| <a id=\"filters-property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | Include mutations matching this mutation key |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`mutation`: [`Mutation`](../classes/Mutation.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>) => `boolean` | Include mutations matching this predicate function |\n| <a id=\"filters-property-status\"></a> `status?` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` \\| `\"idle\"` | Filter by mutation status |\n\n### options?\n\n[`InjectIsMutatingOptions`](../interfaces/InjectIsMutatingOptions.md)\n\nAdditional configuration\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-injector\"></a> `injector?` | `Injector` | The `Injector` in which to create the isMutating signal. If this is not provided, the current injection context will be used instead (via `inject`). |\n\n## Returns\n\n`Signal`\\<`number`\\>\n\nA `Signal` with the number of mutations that your application currently has `pending`.\n\n## Example\n\n```angular-ts\n@Component({\n  selector: 'posts-mutating-indicator',\n  template: `\n    @if (isMutatingPosts()) {\n      <span>Saving posts...</span>\n    }\n  `,\n})\nexport class PostsMutatingIndicator {\n  // How many mutations matching the posts prefix are in progress?\n  readonly isMutatingPosts = injectIsMutating({ mutationKey: ['posts'] })\n}\n```\n"}
