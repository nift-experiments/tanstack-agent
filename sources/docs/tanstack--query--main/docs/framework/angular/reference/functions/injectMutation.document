{"document":{"type":"root","children":[{"type":"code","value":"function injectMutation<TData, TError, TVariables, TOnMutateResult>(injectMutationFn: () => CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, options?: InjectMutationOptions): CreateMutationResult<TData, TError, TVariables, TOnMutateResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/inject-mutation.ts#L172","children":[{"type":"text","value":"packages/angular-query-experimental/src/inject-mutation.ts:172"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n"},{"type":"inlineCode","value":"injectMutation"},{"type":"text","value":" is the function for that. Unlike queries, mutations are not run automatically."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":3,"id":"tvariables","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" = "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"tonmutateresult","children":[{"type":"text","value":"TOnMutateResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"injectmutationfn","children":[{"type":"text","value":"injectMutationFn"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"link","href":"../interfaces/CreateMutationOptions.md","children":[{"type":"inlineCode","value":"CreateMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that returns mutation options. Similar to "},{"type":"inlineCode","value":"computed"},{"type":"text","value":" from Angular,\nthis function runs in the reactive context, so signals read inside it drive the mutation's options."}]},{"type":"html","value":"<a id=\"injectMutationFn-properties\"></a>"},{"type":"heading","depth":4,"id":"injectmutationfn-properties","children":[{"type":"inlineCode","value":"injectMutationFn"},{"type":"text","value":" properties"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default value"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-gctime\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"gcTime?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The time in milliseconds that an unused/inactive mutation remains in memory before it is garbage collected. Defaults to "},{"type":"inlineCode","value":"5 * 60 * 1000"},{"type":"text","value":" (5 minutes), or "},{"type":"inlineCode","value":"Infinity"},{"type":"text","value":" during SSR."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-meta\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"meta?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Additional payload to be stored on the mutation cache entry. Use it to pass information that can be read wherever the "},{"type":"inlineCode","value":"mutation"},{"type":"text","value":" is available, such as the "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" and "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" callbacks of the "},{"type":"inlineCode","value":"MutationCache"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-mutationfn\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"mutationFn?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The function that performs the asynchronous task this mutation runs. Required, unless a default mutation function has been set for the matching "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":" via "},{"type":"inlineCode","value":"queryClient.setMutationDefaults"},{"type":"text","value":". Receives the "},{"type":"inlineCode","value":"variables"},{"type":"text","value":" passed to "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":", and a "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"text","value":"MutationFunctionContext"}]},{"type":"text","value":" holding the "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":", the "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":" and "},{"type":"inlineCode","value":"meta"},{"type":"text","value":". Must return a promise that resolves the mutation's data."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-mutationkey\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"mutationKey?"}]},{"type":"tableCell","children":[{"type":"text","value":"readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The key to use for this mutation. Optional, but required to inherit defaults registered with "},{"type":"inlineCode","value":"queryClient.setMutationDefaults"},{"type":"text","value":", and to match this mutation with "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":" or "},{"type":"inlineCode","value":"queryClient.isMutating"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-networkmode\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"networkMode?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"online\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"always\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"offlineFirst\""}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'online'"}]},{"type":"tableCell","children":[{"type":"text","value":"Controls whether a mutation is allowed to run based on the current network connectivity. "},{"type":"strong","children":[{"type":"text","value":"See"}]},{"type":"text","value":" "},{"type":"link","href":"https://tanstack.com/query/latest/docs/framework/react/guides/network-mode","children":[{"type":"text","value":"Network Mode"}]},{"type":"text","value":" for more information."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-onerror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onError?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":": "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function fires when the mutation encounters an error, and is passed the error. If a promise is returned, it is awaited before "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" runs."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-onmutate\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onMutate?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function fires before the mutation function runs, and receives the same variables. Useful for optimistic updates applied in the hope that the mutation succeeds. The value it returns is passed to "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" and "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" as "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":", which is where an optimistic update is usually rolled back. If a promise is returned, it is awaited before the mutation function runs."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-onsettled\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onSettled?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"data"},{"type":"text","value":": "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"},{"type":"text","value":", "},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":": "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function fires when the mutation either succeeds or errors, and is passed either the data or the error. If a promise is returned, it is awaited before the mutation settles."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-onsuccess\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onSuccess?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"data"},{"type":"text","value":": "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":": "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function fires when the mutation succeeds, and is passed the mutation's result. If a promise is returned, it is awaited before "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" runs."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-retry\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"retry?"}]},{"type":"tableCell","children":[{"type":"text","value":"| "},{"type":"inlineCode","value":"number"},{"type":"text","value":" | "},{"type":"inlineCode","value":"false"},{"type":"text","value":" | "},{"type":"inlineCode","value":"true"},{"type":"text","value":" | (("},{"type":"inlineCode","value":"failureCount"},{"type":"text","value":": "},{"type":"inlineCode","value":"number"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":") => "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"false"},{"type":"text","value":", failed mutations will not retry by default. If "},{"type":"inlineCode","value":"true"},{"type":"text","value":", failed mutations will retry infinitely. If set to an integer number, e.g. 3, failed mutations will retry until the failed mutation count meets that number. If set to a function "},{"type":"inlineCode","value":"(failureCount, error) => boolean"},{"type":"text","value":" failed mutations will retry until the function returns false."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-retrydelay\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"retryDelay?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"},{"type":"text","value":" | (("},{"type":"inlineCode","value":"failureCount"},{"type":"text","value":": "},{"type":"inlineCode","value":"number"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":") => "},{"type":"inlineCode","value":"number"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function receives a "},{"type":"inlineCode","value":"retryAttempt"},{"type":"text","value":" integer and the actual Error and returns the delay to apply before the next attempt in milliseconds. Defaults to a function that applies exponential backoff, capped at 30 seconds."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-scope\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"scope?"}]},{"type":"tableCell","children":[{"type":"link","href":"../type-aliases/MutationScope.md","children":[{"type":"inlineCode","value":"MutationScope"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Controls whether this mutation runs alongside others or waits its turn. Mutations sharing the same "},{"type":"inlineCode","value":"scope.id"},{"type":"text","value":" run serially, in the order they were started. Without a scope, a mutation runs as soon as it is triggered."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectMutationFn-property-throwonerror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"throwOnError?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"},{"type":"text","value":" | (("},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":") => "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"false"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether errors should be thrown instead of setting the "},{"type":"inlineCode","value":"error"},{"type":"text","value":" property. If set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", all errors will be thrown to the nearest error boundary. If set to a function, it will be passed the error and should return a boolean indicating whether to throw the error ("},{"type":"inlineCode","value":"true"},{"type":"text","value":") or return it as state ("},{"type":"inlineCode","value":"false"},{"type":"text","value":")."}]}]]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/InjectMutationOptions.md","children":[{"type":"inlineCode","value":"InjectMutationOptions"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Additional configuration"}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-injector\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"injector?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Injector"}]},{"type":"tableCell","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"Injector"},{"type":"text","value":" in which to create the mutation. If this is not provided, the current injection context will be used instead (via "},{"type":"inlineCode","value":"inject"},{"type":"text","value":")."}]}]]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/CreateMutationResult.md","children":[{"type":"inlineCode","value":"CreateMutationResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The mutation result. Value fields are exposed as a "},{"type":"inlineCode","value":"Signal"},{"type":"text","value":" — read "},{"type":"inlineCode","value":"data"},{"type":"text","value":"/"},{"type":"inlineCode","value":"error"},{"type":"text","value":" by calling them\n(e.g. "},{"type":"inlineCode","value":"mutation.data()"},{"type":"text","value":") — while function fields ("},{"type":"inlineCode","value":"mutate"},{"type":"text","value":", "},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":", "},{"type":"inlineCode","value":"reset"},{"type":"text","value":") are called directly,\nunchanged. "},{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isError"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isPending"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isIdle"},{"type":"text","value":" are type-guard methods you can call to narrow whether\n"},{"type":"inlineCode","value":"data"},{"type":"text","value":" is defined."}]},{"type":"heading","depth":2,"id":"remarks","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"mutate"},{"type":"text","value":"/"},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" also accept per-call "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onError"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callbacks as a\nsecond argument, useful for triggering call-site side effects (e.g. navigation) without coupling them to\nthe shared mutation definition. Callbacks defined in "},{"type":"inlineCode","value":"injectMutationFn"},{"type":"text","value":" fire for every mutation; per-call\ncallbacks fire only for the latest call you've made — "},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" gives you a promise per call instead,\nso you can await "},{"type":"inlineCode","value":"Promise.all"},{"type":"text","value":"/"},{"type":"inlineCode","value":"Promise.allSettled"},{"type":"text","value":" over several calls and see each one's outcome."}]},{"type":"heading","depth":2,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"mutationOptions.md","children":[{"type":"text","value":"mutationOptions"}]},{"type":"text","value":" to share these options across multiple "},{"type":"inlineCode","value":"injectMutation"},{"type":"text","value":" call sites, or to look\nthe mutation up elsewhere via its "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":" (e.g. with "},{"type":"inlineCode","value":"injectMutationState"},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"@Component({\n  selector: 'todos',\n  template: `\n    @if (addMutation.isPending()) {\n      <span>Adding todo...</span>\n    } @else if (addMutation.isError()) {\n      <div>An error occurred: {{ addMutation.error()?.message }}</div>\n    }\n    <button (click)=\"addMutation.mutate('Item')\">Add</button>\n  `,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => this.#queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"text","value":"Optimistic update via "},{"type":"inlineCode","value":"onMutate"},{"type":"text","value":", rolling back on "},{"type":"inlineCode","value":"onError"},{"type":"text","value":":"}]},{"type":"code","value":"@Component({\n  selector: 'todos',\n  template: `<button (click)=\"addMutation.mutate('Item')\">Add</button>`,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onMutate: async (newTodo) => {\n      await this.#queryClient.cancelQueries({ queryKey: ['todos'] })\n      const previousTodos = this.#queryClient.getQueryData<Array<string>>(['todos'])\n\n      this.#queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n        ...(old ?? []),\n        newTodo,\n      ])\n\n      // Passed to `onError` as `onMutateResult` if the mutation fails.\n      return { previousTodos }\n    },\n    onError: (_err, _newTodo, onMutateResult) => {\n      this.#queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n    },\n    onSettled: () => {\n      this.#queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"text","value":"Callbacks passed per call to "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" only fire for the last call — "},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" gives you a promise per\ncall instead, so you can wait for all of them when they succeed:"}]},{"type":"code","value":"@Component({\n  selector: 'todos',\n  template: `\n    <button (click)=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n  `,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => this.#queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async handleAddAll(todos: Array<string>) {\n    try {\n      await Promise.all(todos.map((todo) => this.addMutation.mutateAsync(todo)))\n    } catch (error) {\n      console.error('Failed to add todos:', error)\n    }\n  }\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"text","value":"If some of the mutations above can fail independently of the others, and you want to know which ones did —\nrather than losing that information the moment the first one rejects — swap "},{"type":"inlineCode","value":"Promise.all"},{"type":"text","value":" for\n"},{"type":"inlineCode","value":"Promise.allSettled"},{"type":"text","value":":"}]},{"type":"code","value":"@Component({\n  selector: 'todos',\n  template: `\n    <button (click)=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n  `,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => this.#queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async handleAddAll(todos: Array<string>) {\n    const addResults = await Promise.allSettled(\n      todos.map((todo) => this.addMutation.mutateAsync(todo)),\n    )\n\n    addResults.forEach((addResult, index) => {\n      if (addResult.status === 'rejected') {\n        console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n      }\n    })\n  }\n}","lang":"angular-ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tvariables","text":"TVariables","level":3},{"id":"tonmutateresult","text":"TOnMutateResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"injectmutationfn","text":"injectMutationFn","level":3},{"id":"injectmutationfn-properties","text":"injectMutationFn properties","level":4},{"id":"options","text":"options?","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"returns","text":"Returns","level":2},{"id":"remarks","text":"Remarks","level":2},{"id":"see","text":"See","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction injectMutation<TData, TError, TVariables, TOnMutateResult>(injectMutationFn: () => CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, options?: InjectMutationOptions): CreateMutationResult<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/angular-query-experimental/src/inject-mutation.ts:172](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/inject-mutation.ts#L172)\n\nUnlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n`injectMutation` is the function for that. Unlike queries, mutations are not run automatically.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Parameters\n\n### injectMutationFn\n\n() => [`CreateMutationOptions`](../interfaces/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nA function that returns mutation options. Similar to `computed` from Angular,\nthis function runs in the reactive context, so signals read inside it drive the mutation's options.\n\n<a id=\"injectMutationFn-properties\"></a>\n\n#### `injectMutationFn` properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"injectMutationFn-property-gctime\"></a> `gcTime?` | `number` | `undefined` | The time in milliseconds that an unused/inactive mutation remains in memory before it is garbage collected. Defaults to `5 * 60 * 1000` (5 minutes), or `Infinity` during SSR. |\n| <a id=\"injectMutationFn-property-meta\"></a> `meta?` | `Record`\\<`string`, `unknown`\\> | `undefined` | Additional payload to be stored on the mutation cache entry. Use it to pass information that can be read wherever the `mutation` is available, such as the `onError` and `onSuccess` callbacks of the `MutationCache`. |\n| <a id=\"injectMutationFn-property-mutationfn\"></a> `mutationFn?` | (`variables`: `TVariables`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `Promise`\\<`TData`\\> | `undefined` | The function that performs the asynchronous task this mutation runs. Required, unless a default mutation function has been set for the matching `mutationKey` via `queryClient.setMutationDefaults`. Receives the `variables` passed to `mutate`, and a [MutationFunctionContext](../type-aliases/MutationFunctionContext.md) holding the `QueryClient`, the `mutationKey` and `meta`. Must return a promise that resolves the mutation's data. |\n| <a id=\"injectMutationFn-property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | `undefined` | The key to use for this mutation. Optional, but required to inherit defaults registered with `queryClient.setMutationDefaults`, and to match this mutation with `useMutationState` or `queryClient.isMutating`. |\n| <a id=\"injectMutationFn-property-networkmode\"></a> `networkMode?` | `\"online\"` \\| `\"always\"` \\| `\"offlineFirst\"` | `'online'` | Controls whether a mutation is allowed to run based on the current network connectivity. **See** [Network Mode](https://tanstack.com/query/latest/docs/framework/react/guides/network-mode) for more information. |\n| <a id=\"injectMutationFn-property-onerror\"></a> `onError?` | (`error`: `TError`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult` \\| `undefined`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation encounters an error, and is passed the error. If a promise is returned, it is awaited before `onSettled` runs. |\n| <a id=\"injectMutationFn-property-onmutate\"></a> `onMutate?` | (`variables`: `TVariables`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `TOnMutateResult` \\| `Promise`\\<`TOnMutateResult`\\> | `undefined` | This function fires before the mutation function runs, and receives the same variables. Useful for optimistic updates applied in the hope that the mutation succeeds. The value it returns is passed to `onSuccess`, `onError` and `onSettled` as `onMutateResult`, which is where an optimistic update is usually rolled back. If a promise is returned, it is awaited before the mutation function runs. |\n| <a id=\"injectMutationFn-property-onsettled\"></a> `onSettled?` | (`data`: `TData` \\| `undefined`, `error`: `TError` \\| `null`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult` \\| `undefined`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation either succeeds or errors, and is passed either the data or the error. If a promise is returned, it is awaited before the mutation settles. |\n| <a id=\"injectMutationFn-property-onsuccess\"></a> `onSuccess?` | (`data`: `TData`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation succeeds, and is passed the mutation's result. If a promise is returned, it is awaited before `onSettled` runs. |\n| <a id=\"injectMutationFn-property-retry\"></a> `retry?` | \\| `number` \\| `false` \\| `true` \\| ((`failureCount`: `number`, `error`: `TError`) => `boolean`) | `0` | If `false`, failed mutations will not retry by default. If `true`, failed mutations will retry infinitely. If set to an integer number, e.g. 3, failed mutations will retry until the failed mutation count meets that number. If set to a function `(failureCount, error) => boolean` failed mutations will retry until the function returns false. |\n| <a id=\"injectMutationFn-property-retrydelay\"></a> `retryDelay?` | `number` \\| ((`failureCount`: `number`, `error`: `TError`) => `number`) | `undefined` | This function receives a `retryAttempt` integer and the actual Error and returns the delay to apply before the next attempt in milliseconds. Defaults to a function that applies exponential backoff, capped at 30 seconds. |\n| <a id=\"injectMutationFn-property-scope\"></a> `scope?` | [`MutationScope`](../type-aliases/MutationScope.md) | `undefined` | Controls whether this mutation runs alongside others or waits its turn. Mutations sharing the same `scope.id` run serially, in the order they were started. Without a scope, a mutation runs as soon as it is triggered. |\n| <a id=\"injectMutationFn-property-throwonerror\"></a> `throwOnError?` | `boolean` \\| ((`error`: `TError`) => `boolean`) | `false` | Whether errors should be thrown instead of setting the `error` property. If set to `true`, all errors will be thrown to the nearest error boundary. If set to a function, it will be passed the error and should return a boolean indicating whether to throw the error (`true`) or return it as state (`false`). |\n\n### options?\n\n[`InjectMutationOptions`](../interfaces/InjectMutationOptions.md)\n\nAdditional configuration\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-injector\"></a> `injector?` | `Injector` | The `Injector` in which to create the mutation. If this is not provided, the current injection context will be used instead (via `inject`). |\n\n## Returns\n\n[`CreateMutationResult`](../type-aliases/CreateMutationResult.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nThe mutation result. Value fields are exposed as a `Signal` — read `data`/`error` by calling them\n(e.g. `mutation.data()`) — while function fields (`mutate`, `mutateAsync`, `reset`) are called directly,\nunchanged. `isSuccess`/`isError`/`isPending`/`isIdle` are type-guard methods you can call to narrow whether\n`data` is defined.\n\n## Remarks\n\n`mutate`/`mutateAsync` also accept per-call `onSuccess`/`onError`/`onSettled` callbacks as a\nsecond argument, useful for triggering call-site side effects (e.g. navigation) without coupling them to\nthe shared mutation definition. Callbacks defined in `injectMutationFn` fire for every mutation; per-call\ncallbacks fire only for the latest call you've made — `mutateAsync` gives you a promise per call instead,\nso you can await `Promise.all`/`Promise.allSettled` over several calls and see each one's outcome.\n\n## See\n\n[mutationOptions](mutationOptions.md) to share these options across multiple `injectMutation` call sites, or to look\nthe mutation up elsewhere via its `mutationKey` (e.g. with `injectMutationState`).\n\n## Examples\n\n```angular-ts\n@Component({\n  selector: 'todos',\n  template: `\n    @if (addMutation.isPending()) {\n      <span>Adding todo...</span>\n    } @else if (addMutation.isError()) {\n      <div>An error occurred: {{ addMutation.error()?.message }}</div>\n    }\n    <button (click)=\"addMutation.mutate('Item')\">Add</button>\n  `,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => this.#queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n}\n```\n\nOptimistic update via `onMutate`, rolling back on `onError`:\n```angular-ts\n@Component({\n  selector: 'todos',\n  template: `<button (click)=\"addMutation.mutate('Item')\">Add</button>`,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onMutate: async (newTodo) => {\n      await this.#queryClient.cancelQueries({ queryKey: ['todos'] })\n      const previousTodos = this.#queryClient.getQueryData<Array<string>>(['todos'])\n\n      this.#queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n        ...(old ?? []),\n        newTodo,\n      ])\n\n      // Passed to `onError` as `onMutateResult` if the mutation fails.\n      return { previousTodos }\n    },\n    onError: (_err, _newTodo, onMutateResult) => {\n      this.#queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n    },\n    onSettled: () => {\n      this.#queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n}\n```\n\nCallbacks passed per call to `mutate` only fire for the last call — `mutateAsync` gives you a promise per\ncall instead, so you can wait for all of them when they succeed:\n```angular-ts\n@Component({\n  selector: 'todos',\n  template: `\n    <button (click)=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n  `,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => this.#queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async handleAddAll(todos: Array<string>) {\n    try {\n      await Promise.all(todos.map((todo) => this.addMutation.mutateAsync(todo)))\n    } catch (error) {\n      console.error('Failed to add todos:', error)\n    }\n  }\n}\n```\n\nIf some of the mutations above can fail independently of the others, and you want to know which ones did —\nrather than losing that information the moment the first one rejects — swap `Promise.all` for\n`Promise.allSettled`:\n```angular-ts\n@Component({\n  selector: 'todos',\n  template: `\n    <button (click)=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n  `,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => this.#queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async handleAddAll(todos: Array<string>) {\n    const addResults = await Promise.allSettled(\n      todos.map((todo) => this.addMutation.mutateAsync(todo)),\n    )\n\n    addResults.forEach((addResult, index) => {\n      if (addResult.status === 'rejected') {\n        console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n      }\n    })\n  }\n}\n```\n","originalRawMarkdown":"---\nid: injectMutation\ntitle: injectMutation\n---\n\n```ts\nfunction injectMutation<TData, TError, TVariables, TOnMutateResult>(injectMutationFn: () => CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, options?: InjectMutationOptions): CreateMutationResult<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/angular-query-experimental/src/inject-mutation.ts:172](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/inject-mutation.ts#L172)\n\nUnlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n`injectMutation` is the function for that. Unlike queries, mutations are not run automatically.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Parameters\n\n### injectMutationFn\n\n() => [`CreateMutationOptions`](../interfaces/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nA function that returns mutation options. Similar to `computed` from Angular,\nthis function runs in the reactive context, so signals read inside it drive the mutation's options.\n\n<a id=\"injectMutationFn-properties\"></a>\n\n#### `injectMutationFn` properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"injectMutationFn-property-gctime\"></a> `gcTime?` | `number` | `undefined` | The time in milliseconds that an unused/inactive mutation remains in memory before it is garbage collected. Defaults to `5 * 60 * 1000` (5 minutes), or `Infinity` during SSR. |\n| <a id=\"injectMutationFn-property-meta\"></a> `meta?` | `Record`\\<`string`, `unknown`\\> | `undefined` | Additional payload to be stored on the mutation cache entry. Use it to pass information that can be read wherever the `mutation` is available, such as the `onError` and `onSuccess` callbacks of the `MutationCache`. |\n| <a id=\"injectMutationFn-property-mutationfn\"></a> `mutationFn?` | (`variables`: `TVariables`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `Promise`\\<`TData`\\> | `undefined` | The function that performs the asynchronous task this mutation runs. Required, unless a default mutation function has been set for the matching `mutationKey` via `queryClient.setMutationDefaults`. Receives the `variables` passed to `mutate`, and a [MutationFunctionContext](../type-aliases/MutationFunctionContext.md) holding the `QueryClient`, the `mutationKey` and `meta`. Must return a promise that resolves the mutation's data. |\n| <a id=\"injectMutationFn-property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | `undefined` | The key to use for this mutation. Optional, but required to inherit defaults registered with `queryClient.setMutationDefaults`, and to match this mutation with `useMutationState` or `queryClient.isMutating`. |\n| <a id=\"injectMutationFn-property-networkmode\"></a> `networkMode?` | `\"online\"` \\| `\"always\"` \\| `\"offlineFirst\"` | `'online'` | Controls whether a mutation is allowed to run based on the current network connectivity. **See** [Network Mode](https://tanstack.com/query/latest/docs/framework/react/guides/network-mode) for more information. |\n| <a id=\"injectMutationFn-property-onerror\"></a> `onError?` | (`error`: `TError`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult` \\| `undefined`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation encounters an error, and is passed the error. If a promise is returned, it is awaited before `onSettled` runs. |\n| <a id=\"injectMutationFn-property-onmutate\"></a> `onMutate?` | (`variables`: `TVariables`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `TOnMutateResult` \\| `Promise`\\<`TOnMutateResult`\\> | `undefined` | This function fires before the mutation function runs, and receives the same variables. Useful for optimistic updates applied in the hope that the mutation succeeds. The value it returns is passed to `onSuccess`, `onError` and `onSettled` as `onMutateResult`, which is where an optimistic update is usually rolled back. If a promise is returned, it is awaited before the mutation function runs. |\n| <a id=\"injectMutationFn-property-onsettled\"></a> `onSettled?` | (`data`: `TData` \\| `undefined`, `error`: `TError` \\| `null`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult` \\| `undefined`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation either succeeds or errors, and is passed either the data or the error. If a promise is returned, it is awaited before the mutation settles. |\n| <a id=\"injectMutationFn-property-onsuccess\"></a> `onSuccess?` | (`data`: `TData`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation succeeds, and is passed the mutation's result. If a promise is returned, it is awaited before `onSettled` runs. |\n| <a id=\"injectMutationFn-property-retry\"></a> `retry?` | \\| `number` \\| `false` \\| `true` \\| ((`failureCount`: `number`, `error`: `TError`) => `boolean`) | `0` | If `false`, failed mutations will not retry by default. If `true`, failed mutations will retry infinitely. If set to an integer number, e.g. 3, failed mutations will retry until the failed mutation count meets that number. If set to a function `(failureCount, error) => boolean` failed mutations will retry until the function returns false. |\n| <a id=\"injectMutationFn-property-retrydelay\"></a> `retryDelay?` | `number` \\| ((`failureCount`: `number`, `error`: `TError`) => `number`) | `undefined` | This function receives a `retryAttempt` integer and the actual Error and returns the delay to apply before the next attempt in milliseconds. Defaults to a function that applies exponential backoff, capped at 30 seconds. |\n| <a id=\"injectMutationFn-property-scope\"></a> `scope?` | [`MutationScope`](../type-aliases/MutationScope.md) | `undefined` | Controls whether this mutation runs alongside others or waits its turn. Mutations sharing the same `scope.id` run serially, in the order they were started. Without a scope, a mutation runs as soon as it is triggered. |\n| <a id=\"injectMutationFn-property-throwonerror\"></a> `throwOnError?` | `boolean` \\| ((`error`: `TError`) => `boolean`) | `false` | Whether errors should be thrown instead of setting the `error` property. If set to `true`, all errors will be thrown to the nearest error boundary. If set to a function, it will be passed the error and should return a boolean indicating whether to throw the error (`true`) or return it as state (`false`). |\n\n### options?\n\n[`InjectMutationOptions`](../interfaces/InjectMutationOptions.md)\n\nAdditional configuration\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-injector\"></a> `injector?` | `Injector` | The `Injector` in which to create the mutation. If this is not provided, the current injection context will be used instead (via `inject`). |\n\n## Returns\n\n[`CreateMutationResult`](../type-aliases/CreateMutationResult.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nThe mutation result. Value fields are exposed as a `Signal` — read `data`/`error` by calling them\n(e.g. `mutation.data()`) — while function fields (`mutate`, `mutateAsync`, `reset`) are called directly,\nunchanged. `isSuccess`/`isError`/`isPending`/`isIdle` are type-guard methods you can call to narrow whether\n`data` is defined.\n\n## Remarks\n\n`mutate`/`mutateAsync` also accept per-call `onSuccess`/`onError`/`onSettled` callbacks as a\nsecond argument, useful for triggering call-site side effects (e.g. navigation) without coupling them to\nthe shared mutation definition. Callbacks defined in `injectMutationFn` fire for every mutation; per-call\ncallbacks fire only for the latest call you've made — `mutateAsync` gives you a promise per call instead,\nso you can await `Promise.all`/`Promise.allSettled` over several calls and see each one's outcome.\n\n## See\n\n[mutationOptions](mutationOptions.md) to share these options across multiple `injectMutation` call sites, or to look\nthe mutation up elsewhere via its `mutationKey` (e.g. with `injectMutationState`).\n\n## Examples\n\n```angular-ts\n@Component({\n  selector: 'todos',\n  template: `\n    @if (addMutation.isPending()) {\n      <span>Adding todo...</span>\n    } @else if (addMutation.isError()) {\n      <div>An error occurred: {{ addMutation.error()?.message }}</div>\n    }\n    <button (click)=\"addMutation.mutate('Item')\">Add</button>\n  `,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => this.#queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n}\n```\n\nOptimistic update via `onMutate`, rolling back on `onError`:\n```angular-ts\n@Component({\n  selector: 'todos',\n  template: `<button (click)=\"addMutation.mutate('Item')\">Add</button>`,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onMutate: async (newTodo) => {\n      await this.#queryClient.cancelQueries({ queryKey: ['todos'] })\n      const previousTodos = this.#queryClient.getQueryData<Array<string>>(['todos'])\n\n      this.#queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n        ...(old ?? []),\n        newTodo,\n      ])\n\n      // Passed to `onError` as `onMutateResult` if the mutation fails.\n      return { previousTodos }\n    },\n    onError: (_err, _newTodo, onMutateResult) => {\n      this.#queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n    },\n    onSettled: () => {\n      this.#queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n}\n```\n\nCallbacks passed per call to `mutate` only fire for the last call — `mutateAsync` gives you a promise per\ncall instead, so you can wait for all of them when they succeed:\n```angular-ts\n@Component({\n  selector: 'todos',\n  template: `\n    <button (click)=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n  `,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => this.#queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async handleAddAll(todos: Array<string>) {\n    try {\n      await Promise.all(todos.map((todo) => this.addMutation.mutateAsync(todo)))\n    } catch (error) {\n      console.error('Failed to add todos:', error)\n    }\n  }\n}\n```\n\nIf some of the mutations above can fail independently of the others, and you want to know which ones did —\nrather than losing that information the moment the first one rejects — swap `Promise.all` for\n`Promise.allSettled`:\n```angular-ts\n@Component({\n  selector: 'todos',\n  template: `\n    <button (click)=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n  `,\n})\nexport class Todos {\n  readonly #queryClient = inject(QueryClient)\n\n  readonly addMutation = injectMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => this.#queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async handleAddAll(todos: Array<string>) {\n    const addResults = await Promise.allSettled(\n      todos.map((todo) => this.addMutation.mutateAsync(todo)),\n    )\n\n    addResults.forEach((addResult, index) => {\n      if (addResult.status === 'rejected') {\n        console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n      }\n    })\n  }\n}\n```\n"}
