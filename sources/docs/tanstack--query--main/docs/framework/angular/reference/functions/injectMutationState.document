pe":"text","value":"injectMutationStateFn?"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"inlineCode","value":"MutationStateOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A function returning the "},{"type":"inlineCode","value":"filters"},{"type":"text","value":" to narrow down matched mutations, and an\noptional "},{"type":"inlineCode","value":"select"},{"type":"text","value":" to transform the mutation state. Similar to "},{"type":"inlineCode","value":"computed"},{"type":"text","value":" from Angular, this function runs\nin the reactive context, so signals read inside it re-narrow the matched mutations."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/InjectMutationStateOptions.md","children":[{"type":"inlineCode","value":"InjectMutationStateOptions"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Additional configuration"}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-injector\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"injector?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Injector"}]},{"type":"tableCell","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"Injector"},{"type":"text","value":" in which to create the mutation state signal. If this is not provided, the current injection context will be used instead (via "},{"type":"inlineCode","value":"inject"},{"type":"text","value":")."}]}]]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Signal"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":"[]>"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"Signal"},{"type":"text","value":" with an Array of whatever "},{"type":"inlineCode","value":"select"},{"type":"text","value":" returns for each matching mutation."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Get all variables of all running mutations:"}]},{"type":"code","value":"@Component({\n  selector: 'pending-posts',\n  template: `{{ pendingVariables().length }} posts saving...`,\n})\nexport class PendingPosts {\n  readonly pendingVariables = injectMutationState(() => ({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  }))\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"text","value":"Get all data for specific mutations via the "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":":"}]},{"type":"code","value":"const mutationKey = ['posts']\n\n@Component({\n  selector: 'posts',\n  template: `\n    <button (click)=\"createPost()\">\n      Create post ({{ savedPosts().length }} saved so far)\n    </button>\n  `,\n})\nexport class Posts {\n  // Some mutation that we want to get the state for\n  readonly createPostMutation = injectMutation(() => ({\n    mutationKey,\n    mutationFn: createPosts,\n  }))\n\n  readonly savedPosts = injectMutationState(() => ({\n    // this mutation key needs to match the mutation key of the given mutation (see above)\n    filters: { mutationKey, status: 'success' },\n    select: (mutation) => mutation.state.data,\n  }))\n\n  createPost() {\n    this.createPostMutation.mutate(['New Post'])\n  }\n}","lang":"angular-ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tresult","text":"TResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"injectmutationstatefn","text":"injectMutationStateFn?","level":3},{"id":"options","text":"options?","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction injectMutationState<TResult>(injectMutationStateFn?: () => MutationStateOptions<TResult>, options?: InjectMutationStateOptions): Signal<TResult[]>;\n```\n\nDefined in: [packages/angular-query-experimental/src/inject-mutation-state.ts:114](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/inject-mutation-state.ts#L114)\n\nInjects a signal that gives you access to all mutations in the `MutationCache`. You can pass `filters`\n([MutationFilters](../interfaces/MutationFilters.md)) to narrow down your mutations, and `select` to transform the mutation state.\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n## Parameters\n\n### injectMutationStateFn?\n\n() => `MutationStateOptions`\\<`TResult`\\>\n\nA function returning the `filters` to narrow down matched mutations, and an\noptional `select` to transform the mutation state. Similar to `computed` from Angular, this function runs\nin the reactive context, so signals read inside it re-narrow the matched mutations.\n\n### options?\n\n[`InjectMutationStateOptions`](../interfaces/InjectMutationStateOptions.md)\n\nAdditional configuration\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-injector\"></a> `injector?` | `Injector` | The `Injector` in which to create the mutation state signal. If this is not provided, the current injection context will be used instead (via `inject`). |\n\n## Returns\n\n`Signal`\\<`TResult`[]\\>\n\nA `Signal` with an Array of whatever `select` returns for each matching mutation.\n\n## Examples\n\nGet all variables of all running mutations:\n```angular-ts\n@Component({\n  selector: 'pending-posts',\n  template: `{{ pendingVariables().length }} posts saving...`,\n})\nexport class PendingPosts {\n  readonly pendingVariables = injectMutationState(() => ({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  }))\n}\n```\n\nGet all data for specific mutations via the `mutationKey`:\n```angular-ts\nconst mutationKey = ['posts']\n\n@Component({\n  selector: 'posts',\n  template: `\n    <button (click)=\"createPost()\">\n      Create post ({{ savedPosts().length }} saved so far)\n    </button>\n  `,\n})\nexport class Posts {\n  // Some mutation that we want to get the state for\n  readonly createPostMutation = injectMutation(() => ({\n    mutationKey,\n    mutationFn: createPosts,\n  }))\n\n  readonly savedPosts = injectMutationState(() => ({\n    // this mutation key needs to match the mutation key of the given mutation (see above)\n    filters: { mutationKey, status: 'success' },\n    select: (mutation) => mutation.state.data,\n  }))\n\n  createPost() {\n    this.createPostMutation.mutate(['New Post'])\n  }\n}\n```\n","originalRawMarkdown":"---\nid: injectMutationState\ntitle: injectMutationState\n---\n\n```ts\nfunction injectMutationState<TResult>(injectMutationStateFn?: () => MutationStateOptions<TResult>, options?: InjectMutationStateOptions): Signal<TResult[]>;\n```\n\nDefined in: [packages/angular-query-experimental/src/inject-mutation-state.ts:114](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/inject-mutation-state.ts#L114)\n\nInjects a signal that gives you access to all mutations in the `MutationCache`. You can pass `filters`\n([MutationFilters](../interfaces/MutationFilters.md)) to narrow down your mutations, and `select` to transform the mutation state.\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n## Parameters\n\n### injectMutationStateFn?\n\n() => `MutationStateOptions`\\<`TResult`\\>\n\nA function returning the `filters` to narrow down matched mutations, and an\noptional `select` to transform the mutation state. Similar to `computed` from Angular, this function runs\nin the reactive context, so signals read inside it re-narrow the matched mutations.\n\n### options?\n\n[`InjectMutationStateOptions`](../interfaces/InjectMutationStateOptions.md)\n\nAdditional configuration\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-injector\"></a> `injector?` | `Injector` | The `Injector` in which to create the mutation state signal. If this is not provided, the current injection context will be used instead (via `inject`). |\n\n## Returns\n\n`Signal`\\<`TResult`[]\\>\n\nA `Signal` with an Array of whatever `select` returns for each matching mutation.\n\n## Examples\n\nGet all variables of all running mutations:\n```angular-ts\n@Component({\n  selector: 'pending-posts',\n  template: `{{ pendingVariables().length }} posts saving...`,\n})\nexport class PendingPosts {\n  readonly pendingVariables = injectMutationState(() => ({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  }))\n}\n```\n\nGet all data for specific mutations via the `mutationKey`:\n```angular-ts\nconst mutationKey = ['posts']\n\n@Component({\n  selector: 'posts',\n  template: `\n    <button (click)=\"createPost()\">\n      Create post ({{ savedPosts().length }} saved so far)\n    </button>\n  `,\n})\nexport class Posts {\n  // Some mutation that we want to get the state for\n  readonly createPostMutation = injectMutation(() => ({\n    mutationKey,\n    mutationFn: createPosts,\n  }))\n\n  readonly savedPosts = injectMutationState(() => ({\n    // this mutation key needs to match the mutation key of the given mutation (see above)\n    filters: { mutationKey, status: 'success' },\n    select: (mutation) => mutation.state.data,\n  }))\n\n  createPost() {\n    this.createPostMutation.mutate(['New Post'])\n  }\n}\n```\n"}
