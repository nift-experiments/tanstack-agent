ll","children":[{"type":"inlineHtml","value":"<a id=\"injectQueryFn-property-gctime\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"gcTime?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The time in milliseconds that unused/inactive cache data remains in memory. When a query's cache becomes unused or inactive, that cache data will be garbage collected after this duration. When different garbage collection times are specified, the longest one will be used. Setting it to "},{"type":"inlineCode","value":"Infinity"},{"type":"text","value":" will disable garbage collection. Defaults to "},{"type":"inlineCode","value":"5 * 60 * 1000"},{"type":"text","value":" (5 minutes), or "},{"type":"inlineCode","value":"Infinity"},{"type":"text","value":" during SSR. Note: the maximum allowed time is about 24 days, imposed by "},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":"'s 32-bit signed integer delay — see "},{"type":"inlineCode","value":"timeoutManager.setTimeoutProvider"},{"type":"text","value":" for a workaround."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"injectQueryFn-property-initialdata\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"initialData?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" | (() => "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"If set, this value will be used as the initial data for the query cache (as long as the query hasn't been created or cached yet