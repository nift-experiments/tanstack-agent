pe":"paragraph","children":[{"type":"text","value":"Additional configuration"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/CreateQueryResult.md","children":[{"type":"inlineCode","value":"CreateQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The query result. "},{"type":"inlineCode","value":"status()"},{"type":"text","value":" is "},{"type":"inlineCode","value":"'pending'"},{"type":"text","value":" if there is no cached data to display, "},{"type":"inlineCode","value":"'error'"},{"type":"text","value":" if\nthe last fetch attempt failed, or "},{"type":"inlineCode","value":"'success'"},{"type":"text","value":" if the query has data to display. "},{"type":"inlineCode","value":"isPending"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":"/\n"},{"type":"inlineCode","value":"isError"},{"type":"text","value":" are type-guard methods for convenience."}]},{"type":"heading","depth":3,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"https://tanstack.com/query/latest/docs/framework/angular/guides/queries"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"queryOptions.md","children":[{"type":"text","value":"queryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"injectQuery"},{"type":"text","value":" and imperative APIs like\n"},{"type":"inlineCode","value":"queryClient.fetchQuery"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"@Component({\n  selector: 'posts',\n  template: `\n    @if (postsQuery.isPending()) {\n      Loading...\n    } @else if (postsQuery.isError()) {\n      <span>Error: {{ postsQuery.error()?.message }}</span>\n    } @else {\n      <ul>\n        @for (post of postsQuery.data(); track post.id) {\n          <li>{{ post.title }}</li>\n        }\n      </ul>\n    }\n  `,\n})\nexport class Posts {\n  readonly postsQuery = injectQuery(() => ({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  }))\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"text","value":"Similar to "},{"type":"inlineCode","value":"computed"},{"type":"text","value":" from Angular, the function passed to "},{"type":"inlineCode","value":"injectQuery"},{"type":"text","value":" runs in the reactive context. In\nthe example below, the query is automatically enabled and executed when the filter signal changes to a\ntruthy value. When the filter signal changes back to a falsy value, the query is disabled."}]},{"type":"code","value":"@Component({\n  selector: 'posts',\n  template: `\n    <input [ngModel]=\"filter()\" (ngModelChange)=\"filter.set($event)\" />\n    @if (postsQuery.isPending()) {\n      Loading...\n    } @else if (postsQuery.isError()) {\n      <span>Error: {{ postsQuery.error()?.message }}</span>\n    } @else {\n      <ul>\n        @for (post of postsQuery.data(); track post.id) {\n          <li>{{ post.title }}</li>\n        }\n      </ul>\n    }\n  `,\n})\nexport class Posts {\n  readonly filter = signal('')\n\n  readonly postsQuery = injectQuery(() => ({\n    queryKey: ['posts', this.filter()],\n    queryFn: () => fetchPosts(this.filter()),\n    // Signals can be combined with expressions\n    enabled: !!this.filter(),\n  }))\n}","lang":"angular-ts"},{"type":"html","value":"<a id=\"call-signature-3\"></a>"},{"type":"heading","depth":2,"id":"call-signature-3","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function injectQuery<TQueryFnData, TError, TData, TQueryKey>(injectQueryFn: () => CreateQueryOptions<TQueryFnData, TError, TData, TQueryKey>, options?: InjectQueryOptions): CreateQueryResult<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/inject-query.ts#L182","children":[{"type":"text","value":"packages/angular-query-experimental/src/inject-query.ts:182"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This overload accepts the general "},{"type":"link","href":"../interfaces/CreateQueryOptions.md","children":[{"type":"text","value":"CreateQueryOptions"}]},{"type":"text","value":" shape rather than the "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":"-aware\noverloads above, so whether "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is defined can't be inferred from the call site — useful when wrapping\n"},{"type":"inlineCode","value":"injectQuery"},{"type":"text","value":" in your own helper function that forwards caller-provided options."}]},{"type":"heading","depth":3,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-3","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"terror-3","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-3","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading"