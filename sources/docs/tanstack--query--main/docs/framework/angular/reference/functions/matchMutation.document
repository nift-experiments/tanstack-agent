type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"exact?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Match mutation key exactly"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-mutationkey\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"mutationKey?"}]},{"type":"tableCell","children":[{"type":"text","value":"readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"tableCell","children":[{"type":"text","value":"Include mutations matching this mutation key"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-predicate\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"predicate?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"mutation"},{"type":"text","value":": "},{"type":"link","href":"../classes/Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">) => "},{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Include mutations matching this predicate function"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-status\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"status?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"error\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"pending\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"success\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"idle\""}]},{"type":"tableCell","children":[{"type":"text","value":"Filter by mutation status"}]}]]},{"type":"heading","depth":3,"id":"mutation","children":[{"type":"text","value":"mutation"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The mutation to check."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"true"},{"type":"text","value":" if the mutation matches every specified filter."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const mutationCache = queryClient.getMutationCache()\n\nconst matchingMutations = mutationCache\n  .getAll()\n  .filter((mutation) => matchMutation({ mutationKey: ['addPost'] }, mutation))","lang":"ts"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"filters","text":"filters","level":3},{"id":"filters-properties","text":"filters properties","level":4},{"id":"mutation","text":"mutation","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction matchMutation(filters: MutationFilters, mutation: Mutation<any, any>): boolean;\n```\n\nDefined in: [packages/query-core/src/utils.ts:269](https://github.com/TanStack/query/blob/main/packages/query-core/src/utils.ts#L269)\n\nChecks whether a mutation matches the given [MutationFilters](../interfaces/MutationFilters.md).\nEvery filter that is specified must match; filters that are left unspecified are ignored.\nIf a `mutationKey` filter is provided but the mutation has no `mutationKey` of its own, it does not match.\n\n## Parameters\n\n### filters\n\n[`MutationFilters`](../interfaces/MutationFilters.md)\n\nThe filters to check the mutation against.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | Match mutation key exactly |\n| <a id=\"filters-property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | Include mutations matching this mutation key |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`mutation`: [`Mutation`](../classes/Mutation.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>) => `boolean` | Include mutations matching this predicate function |\n| <a id=\"filters-property-status\"></a> `status?` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` \\| `\"idle\"` | Filter by mutation status |\n\n### mutation\n\n[`Mutation`](../classes/Mutation.md)\\<`any`, `any`\\>\n\nThe mutation to check.\n\n## Returns\n\n`boolean`\n\n`true` if the mutation matches every specified filter.\n\n## Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst matchingMutations = mutationCache\n  .getAll()\n  .filter((mutation) => matchMutation({ mutationKey: ['addPost'] }, mutation))\n```\n","originalRawMarkdown":"---\nid: matchMutation\ntitle: matchMutation\n---\n\n```ts\nfunction matchMutation(filters: MutationFilters, mutation: Mutation<any, any>): boolean;\n```\n\nDefined in: [packages/query-core/src/utils.ts:269](https://github.com/TanStack/query/blob/main/packages/query-core/src/utils.ts#L269)\n\nChecks whether a mutation matches the given [MutationFilters](../interfaces/MutationFilters.md).\nEvery filter that is specified must match; filters that are left unspecified are ignored.\nIf a `mutationKey` filter is provided but the mutation has no `mutationKey` of its own, it does not match.\n\n## Parameters\n\n### filters\n\n[`MutationFilters`](../interfaces/MutationFilters.md)\n\nThe filters to check the mutation against.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | Match mutation key exactly |\n| <a id=\"filters-property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | Include mutations matching this mutation key |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`mutation`: [`Mutation`](../classes/Mutation.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>) => `boolean` | Include mutations matching this predicate function |\n| <a id=\"filters-property-status\"></a> `status?` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` \\| `\"idle\"` | Filter by mutation status |\n\n### mutation\n\n[`Mutation`](../classes/Mutation.md)\\<`any`, `any`\\>\n\nThe mutation to check.\n\n## Returns\n\n`boolean`\n\n`true` if the mutation matches every specified filter.\n\n## Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst matchingMutations = mutationCache\n  .getAll()\n  .filter((mutation) => matchMutation({ mutationKey: ['addPost'] }, mutation))\n```\n"}
