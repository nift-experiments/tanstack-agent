:"../type-aliases/DefaultError.md","children":[{"type":"inlineCode","value":"DefaultError"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of errors your "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" may throw."}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-iserror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isError"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"this"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/CreateBaseQueryResult.md","children":[{"type":"inlineCode","value":"CreateBaseQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">) => "},{"type":"inlineCode","value":"this is CreateBaseQueryResult<TData, TError, CreateStatusBasedQueryResult<\"error\", TData, TError>>"}]},{"type":"tableCell","children":[{"type":"text","value":"Returns "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query is in the "},{"type":"inlineCode","value":"error"},{"type":"text","value":" state, narrowing the result to that state."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-ispending\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isPending"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"this"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/CreateBaseQueryResult.md","children":[{"type":"inlineCode","value":"CreateBaseQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">) => "},{"type":"inlineCode","value":"this is CreateBaseQueryResult<TData, TError, CreateStatusBasedQueryResult<\"pending\", TData, TError>>"}]},{"type":"tableCell","children":[{"type":"text","value":"Returns "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query is in the "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" state, narrowing the result to that state."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-issuccess\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isSuccess"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"this"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/CreateBaseQueryResult.md","children":[{"type":"inlineCode","value":"CreateBaseQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">) => "},{"type":"inlineCode","value":"this is CreateBaseQueryResult<TData, TError, CreateStatusBasedQueryResult<\"success\", TData, TError>>"}]},{"type":"tableCell","children":[{"type":"text","value":"Returns "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query is in the "},{"type":"inlineCode","value":"success"},{"type":"text","value":" state, narrowing the result to that state."}]}]]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/angular-query-experimental/src/types.ts:80](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/types.ts#L80)\n\nThe `isSuccess`/`isError`/`isPending` methods on a query result. Unlike `react-query`'s derived booleans,\nthese are type-guard methods you call — `if (query.isSuccess())` — so that `query.data` narrows away\n`undefined` inside the branch, the same way `status` narrowing works on the plain object `react-query`\nreturns.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type `data` ends up as after `select` runs.\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-iserror\"></a> `isError` | (`this`: [`CreateBaseQueryResult`](../type-aliases/CreateBaseQueryResult.md)\\<`TData`, `TError`\\>) => `this is CreateBaseQueryResult<TData, TError, CreateStatusBasedQueryResult<\"error\", TData, TError>>` | Returns `true` if the query is in the `error` state, narrowing the result to that state. |\n| <a id=\"property-ispending\"></a> `isPending` | (`this`: [`CreateBaseQueryResult`](../type-aliases/CreateBaseQueryResult.md)\\<`TData`, `TError`\\>) => `this is CreateBaseQueryResult<TData, TError, CreateStatusBasedQueryResult<\"pending\", TData, TError>>` | Returns `true` if the query is in the `pending` state, narrowing the result to that state. |\n| <a id=\"property-issuccess\"></a> `isSuccess` | (`this`: [`CreateBaseQueryResult`](../type-aliases/CreateBaseQueryResult.md)\\<`TData`, `TError`\\>) => `this is CreateBaseQueryResult<TData, TError, CreateStatusBasedQueryResult<\"success\", TData, TError>>` | Returns `true` if the query is in the `success` state, narrowing the result to that state. |\n","originalRawMarkdown":"---\nid: BaseQueryNarrowing\ntitle: BaseQueryNarrowing\n---\n\nDefined in: [packages/angular-query-experimental/src/types.ts:80](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/types.ts#L80)\n\nThe `isSuccess`/`isError`/`isPending` methods on a query result. Unlike `react-query`'s derived booleans,\nthese are type-guard methods you call — `if (query.isSuccess())` — so that `query.data` narrows away\n`undefined` inside the branch, the same way `status` narrowing works on the plain object `react-query`\nreturns.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type `data` ends up as after `select` runs.\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-iserror\"></a> `isError` | (`this`: [`CreateBaseQueryResult`](../type-aliases/CreateBaseQueryResult.md)\\<`TData`, `TError`\\>) => `this is CreateBaseQueryResult<TData, TError, CreateStatusBasedQueryResult<\"error\", TData, TError>>` | Returns `true` if the query is in the `error` state, narrowing the result to that state. |\n| <a id=\"property-ispending\"></a> `isPending` | (`this`: [`CreateBaseQueryResult`](../type-aliases/CreateBaseQueryResult.md)\\<`TData`, `TError`\\>) => `this is CreateBaseQueryResult<TData, TError, CreateStatusBasedQueryResult<\"pending\", TData, TError>>` | Returns `true` if the query is in the `pending` state, narrowing the result to that state. |\n| <a id=\"property-issuccess\"></a> `isSuccess` | (`this`: [`CreateBaseQueryResult`](../type-aliases/CreateBaseQueryResult.md)\\<`TData`, `TError`\\>) => `this is CreateBaseQueryResult<TData, TError, CreateStatusBasedQueryResult<\"success\", TData, TError>>` | Returns `true` if the query is in the `success` state, narrowing the result to that state. |\n"}
