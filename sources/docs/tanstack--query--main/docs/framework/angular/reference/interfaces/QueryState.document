."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-errorupdatedat\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"errorUpdatedAt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The timestamp for when the query most recently returned the "},{"type":"inlineCode","value":"status"},{"type":"text","value":" as "},{"type":"inlineCode","value":"\"error\""},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-fetchfailurecount\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"fetchFailureCount"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The failure count for the current fetch. - Incremented every time the fetch fails. - Reset to "},{"type":"inlineCode","value":"0"},{"type":"text","value":" when the fetch succeeds."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-fetchfailurereason\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"fetchFailureReason"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"tableCell","children":[{"type":"text","value":"The reason the current fetch failed, as reported by the retryer. - Reset to "},{"type":"inlineCode","value":"null"},{"type":"text","value":" when the fetch succeeds."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-fetchmeta\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"fetchMeta"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"FetchMeta"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"tableCell","children":[{"type":"text","value":"Metadata passed to the currently in-flight (or most recent) fetch, e.g. the "},{"type":"inlineCode","value":"fetchMore"},{"type":"text","value":" direction for infinite queries."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-fetchstatus\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"fetchStatus"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"fetching\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"paused\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"idle\""}]},{"type":"tableCell","children":[{"type":"text","value":"The fetch status of the query. - "},{"type":"inlineCode","value":"fetching"},{"type":"text","value":": the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" is currently executing. - "},{"type":"inlineCode","value":"paused"},{"type":"text","value":": a fetch wanted to run but has been paused (see network mode). - "},{"type":"inlineCode","value":"idle"},{"type":"text","value":": the query is not fetching."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-isinvalidated\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isInvalidated"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether the query has been marked as invalidated via "},{"type":"inlineCode","value":"invalidate()"},{"type":"text","value":". - Reset to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" whenever the query resolves successfully."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-status\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"status"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"error\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"pending\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"success\""}]},{"type":"tableCell","children":[{"type":"text","value":"The status of the query. - "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" if there's no cached data and no attempt was finished yet. - "},{"type":"inlineCode","value":"error"},{"type":"text","value":" if the last attempt resulted in an error. - "},{"type":"inlineCode","value":"success"},{"type":"text","value":" if the query has data."}]}]]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/query.ts:52](https://github.com/TanStack/query/blob/main/packages/query-core/src/query.ts#L52)\n\nThe raw state stored on a `Query` instance. This is the underlying state\nthat observer results (e.g. `QueryObserverResult`) are derived from.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-data\"></a> `data` | `TData` \\| `undefined` | The last successfully resolved data for the query. |\n| <a id=\"property-dataupdatecount\"></a> `dataUpdateCount` | `number` | The number of times the query has successfully resolved. |\n| <a id=\"property-dataupdatedat\"></a> `dataUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"success\"`. |\n| <a id=\"property-error\"></a> `error` | `TError` \\| `null` | The error object for the query, if the last attempt resulted in an error. - Defaults to `null`. |\n| <a id=\"property-errorupdatecount\"></a> `errorUpdateCount` | `number` | The sum of all errors, incremented every time the query resolves with an error. |\n| <a id=\"property-errorupdatedat\"></a> `errorUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"error\"`. |\n| <a id=\"property-fetchfailurecount\"></a> `fetchFailureCount` | `number` | The failure count for the current fetch. - Incremented every time the fetch fails. - Reset to `0` when the fetch succeeds. |\n| <a id=\"property-fetchfailurereason\"></a> `fetchFailureReason` | `TError` \\| `null` | The reason the current fetch failed, as reported by the retryer. - Reset to `null` when the fetch succeeds. |\n| <a id=\"property-fetchmeta\"></a> `fetchMeta` | `FetchMeta` \\| `null` | Metadata passed to the currently in-flight (or most recent) fetch, e.g. the `fetchMore` direction for infinite queries. |\n| <a id=\"property-fetchstatus\"></a> `fetchStatus` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | The fetch status of the query. - `fetching`: the `queryFn` is currently executing. - `paused`: a fetch wanted to run but has been paused (see network mode). - `idle`: the query is not fetching. |\n| <a id=\"property-isinvalidated\"></a> `isInvalidated` | `boolean` | Whether the query has been marked as invalidated via `invalidate()`. - Reset to `false` whenever the query resolves successfully. |\n| <a id=\"property-status\"></a> `status` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` | The status of the query. - `pending` if there's no cached data and no attempt was finished yet. - `error` if the last attempt resulted in an error. - `success` if the query has data. |\n","originalRawMarkdown":"---\nid: QueryState\ntitle: QueryState\n---\n\nDefined in: [packages/query-core/src/query.ts:52](https://github.com/TanStack/query/blob/main/packages/query-core/src/query.ts#L52)\n\nThe raw state stored on a `Query` instance. This is the underlying state\nthat observer results (e.g. `QueryObserverResult`) are derived from.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-data\"></a> `data` | `TData` \\| `undefined` | The last successfully resolved data for the query. |\n| <a id=\"property-dataupdatecount\"></a> `dataUpdateCount` | `number` | The number of times the query has successfully resolved. |\n| <a id=\"property-dataupdatedat\"></a> `dataUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"success\"`. |\n| <a id=\"property-error\"></a> `error` | `TError` \\| `null` | The error object for the query, if the last attempt resulted in an error. - Defaults to `null`. |\n| <a id=\"property-errorupdatecount\"></a> `errorUpdateCount` | `number` | The sum of all errors, incremented every time the query resolves with an error. |\n| <a id=\"property-errorupdatedat\"></a> `errorUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"error\"`. |\n| <a id=\"property-fetchfailurecount\"></a> `fetchFailureCount` | `number` | The failure count for the current fetch. - Incremented every time the fetch fails. - Reset to `0` when the fetch succeeds. |\n| <a id=\"property-fetchfailurereason\"></a> `fetchFailureReason` | `TError` \\| `null` | The reason the current fetch failed, as reported by the retryer. - Reset to `null` when the fetch succeeds. |\n| <a id=\"property-fetchmeta\"></a> `fetchMeta` | `FetchMeta` \\| `null` | Metadata passed to the currently in-flight (or most recent) fetch, e.g. the `fetchMore` direction for infinite queries. |\n| <a id=\"property-fetchstatus\"></a> `fetchStatus` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | The fetch status of the query. - `fetching`: the `queryFn` is currently executing. - `paused`: a fetch wanted to run but has been paused (see network mode). - `idle`: the query is not fetching. |\n| <a id=\"property-isinvalidated\"></a> `isInvalidated` | `boolean` | Whether the query has been marked as invalidated via `invalidate()`. - Reset to `false` whenever the query resolves successfully. |\n| <a id=\"property-status\"></a> `status` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` | The status of the query. - `pending` if there's no cached data and no attempt was finished yet. - `error` if the last attempt resulted in an error. - `success` if the query has data. |\n"}
