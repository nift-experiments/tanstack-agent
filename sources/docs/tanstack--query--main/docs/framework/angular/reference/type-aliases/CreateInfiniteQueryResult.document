pe":"text","value":" runs."}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"link","href":"DefaultError.md","children":[{"type":"inlineCode","value":"DefaultError"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of errors your "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" may throw."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype CreateInfiniteQueryResult<TData, TError> = BaseQueryNarrowing<TData, TError> & MapToSignals<InfiniteQueryObserverResult<TData, TError>>;\n```\n\nDefined in: [packages/angular-query-experimental/src/types.ts:192](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/types.ts#L192)\n\nThe result of `injectInfiniteQuery` when `initialData` isn't set — `data` may be `undefined` while the\nquery is `pending`. Same shape as [InfiniteQueryObserverResult](InfiniteQueryObserverResult.md) from `@tanstack/query-core`, but\nvalue fields are exposed as a `Signal` while function fields (like `fetchNextPage`) are called directly,\nunchanged.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type `data` ends up as after `select` runs.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n","originalRawMarkdown":"---\nid: CreateInfiniteQueryResult\ntitle: CreateInfiniteQueryResult\n---\n\n```ts\ntype CreateInfiniteQueryResult<TData, TError> = BaseQueryNarrowing<TData, TError> & MapToSignals<InfiniteQueryObserverResult<TData, TError>>;\n```\n\nDefined in: [packages/angular-query-experimental/src/types.ts:192](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/types.ts#L192)\n\nThe result of `injectInfiniteQuery` when `initialData` isn't set — `data` may be `undefined` while the\nquery is `pending`. Same shape as [InfiniteQueryObserverResult](InfiniteQueryObserverResult.md) from `@tanstack/query-core`, but\nvalue fields are exposed as a `Signal` while function fields (like `fetchNextPage`) are called directly,\nunchanged.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type `data` ends up as after `select` runs.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n"}
