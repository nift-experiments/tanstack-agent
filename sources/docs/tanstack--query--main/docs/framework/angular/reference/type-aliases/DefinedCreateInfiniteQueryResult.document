Code","value":"TError"},{"type":"text","value":" = "},{"type":"link","href":"DefaultError.md","children":[{"type":"inlineCode","value":"DefaultError"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of errors your "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" may throw."}]},{"type":"heading","depth":3,"id":"tdefinedinfinitequeryobserver","children":[{"type":"text","value":"TDefinedInfiniteQueryObserver"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TDefinedInfiniteQueryObserver"},{"type":"text","value":" = "},{"type":"link","href":"DefinedInfiniteQueryObserverResult.md","children":[{"type":"inlineCode","value":"DefinedInfiniteQueryObserverResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tdefinedinfinitequeryobserver","text":"TDefinedInfiniteQueryObserver","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype DefinedCreateInfiniteQueryResult<TData, TError, TDefinedInfiniteQueryObserver> = MapToSignals<TDefinedInfiniteQueryObserver>;\n```\n\nDefined in: [packages/angular-query-experimental/src/types.ts:205](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/types.ts#L205)\n\nThe result of `injectInfiniteQuery` when `initialData` is set — `data` is never `undefined`. Same shape as\n[DefinedInfiniteQueryObserverResult](DefinedInfiniteQueryObserverResult.md) from `@tanstack/query-core`, but value fields are exposed as a\n`Signal` while function fields are called directly, unchanged.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type `data` ends up as after `select` runs.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n### TDefinedInfiniteQueryObserver\n\n`TDefinedInfiniteQueryObserver` = [`DefinedInfiniteQueryObserverResult`](DefinedInfiniteQueryObserverResult.md)\\<`TData`, `TError`\\>\n","originalRawMarkdown":"---\nid: DefinedCreateInfiniteQueryResult\ntitle: DefinedCreateInfiniteQueryResult\n---\n\n```ts\ntype DefinedCreateInfiniteQueryResult<TData, TError, TDefinedInfiniteQueryObserver> = MapToSignals<TDefinedInfiniteQueryObserver>;\n```\n\nDefined in: [packages/angular-query-experimental/src/types.ts:205](https://github.com/TanStack/query/blob/main/packages/angular-query-experimental/src/types.ts#L205)\n\nThe result of `injectInfiniteQuery` when `initialData` is set — `data` is never `undefined`. Same shape as\n[DefinedInfiniteQueryObserverResult](DefinedInfiniteQueryObserverResult.md) from `@tanstack/query-core`, but value fields are exposed as a\n`Signal` while function fields are called directly, unchanged.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type `data` ends up as after `select` runs.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n### TDefinedInfiniteQueryObserver\n\n`TDefinedInfiniteQueryObserver` = [`DefinedInfiniteQueryObserverResult`](DefinedInfiniteQueryObserverResult.md)\\<`TData`, `TError`\\>\n"}
