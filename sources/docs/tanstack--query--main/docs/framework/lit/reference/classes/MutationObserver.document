{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationObserver.ts#L37","children":[{"type":"text","value":"packages/query-core/src/mutationObserver.ts:37"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Observes a single mutation and derives a "},{"type":"inlineCode","value":"MutationObserverResult"},{"type":"text","value":" from it.\nA framework hook like "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":" creates one "},{"type":"inlineCode","value":"MutationObserver"},{"type":"text","value":" per hook\ncall, keeps it stable across re-renders, calls "},{"type":"inlineCode","value":"setOptions"},{"type":"text","value":" when the options\npassed to the hook change, subscribes to it to re-render on updates, and\nreads "},{"type":"inlineCode","value":"getCurrentResult()"},{"type":"text","value":" for the value to return. Calling "},{"type":"inlineCode","value":"mutate()"},{"type":"text","value":"\nbuilds a new underlying "},{"type":"inlineCode","value":"Mutation"},{"type":"text","value":" in the "},{"type":"inlineCode","value":"MutationCache"},{"type":"text","value":" and executes it."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const observer = new MutationObserver(queryClient, {\n  mutationFn: (variables: { title: string }) => addPost(variables),\n})","lang":"ts"},{"type":"heading","depth":2,"id":"extends","children":[{"type":"text","value":"Extends"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Subscribable"},{"type":"text","value":"<"},{"type":"inlineCode","value":"MutationObserverListener"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">>"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"link","href":"../type-aliases/DefaultError.md","children":[{"type":"inlineCode","value":"DefaultError"}]}]},{"type":"heading","depth":3,"id":"tvariables","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" = "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"tonmutateresult","children":[{"type":"text","value":"TOnMutateResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,"id":"constructor","children":[{"type":"text","value":"Constructor"}]},{"type":"code","value":"new MutationObserver<TData, TError, TVariables, TOnMutateResult>(client: QueryClient, options: MutationObserverOptions<TData, TError, TVariables, TOnMutateResult>): MutationObserver<TData, TError, TVariables, TOnMutateResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationObserver.ts#L57","children":[{"typ