"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"config","text":"config?","level":5},{"id":"returns","text":"Returns","level":4},{"id":"methods","text":"Methods","level":2},{"id":"cancelqueries","text":"cancelQueries()","level":3},{"id":"type-parameters","text":"Type Parameters","level":4},{"id":"ttaggedquerykey","text":"TTaggedQueryKey","level":5},{"id":"parameters-2","text":"Parameters","level":4},{"id":"filters","text":"filters?","level":5},{"id":"canceloptions","text":"cancelOptions?","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"clear","text":"clear()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"example-3","text":"Example","level":4},{"id":"defaultmutationoptions","text":"defaultMutationOptions()","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":4},{"id":"t","text":"T","level":5},{"id":"parameters-3","text":"Parameters","level":4},{"id":"options","text":"options?","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"defaultqueryoptions","text":"defaultQueryOptions()","level":3},{"id":"type-parameters-3","text":"Type Parameters","level":4},{"id":"tqueryfndata","text":"TQueryFnData","level":5},{"id":"terror","text":"TError","level":5},{"id":"tdata","text":"TData","level":5},{"id":"tquerydata","text":"TQueryData","level":5},{"id":"tquerykey","text":"TQueryKey","level":5},{"id":"tpageparam","text":"TPageParam","level":5},{"id":"parameters-4","text":"Parameters","level":4},{"id":"options-2","text":"options","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"ensureinfinitequerydata","text":"ensureInfiniteQueryData()","level":3},{"id":"type-parameters-4","text":"Type Pa