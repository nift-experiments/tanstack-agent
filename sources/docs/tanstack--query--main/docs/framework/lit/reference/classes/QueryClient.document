ineCode","value":"TQueryFnData"}]},{"type":"heading","depth":5,"id":"tquerykey-8","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"parameters-19","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"options-10","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/FetchQueryOptions.md","children":[{"type":"inlineCode","value":"FetchQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The query options, including the "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" and the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" used if the\nquery needs to fetch."}]},{"type":"heading","depth":4,"id":"returns-24","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise that resolves once the fetch settles. It never rejects."}]},{"type":"heading","depth":4,"id":"deprecated-6","children":[{"type":"text","value":"Deprecated"}]},{"type":"paragraph","children":[{"type":"text","value":"Use queryClient.query(options) instead. You can swallow errors with "},{"type":"inlineCode","value":".catch(noop)"},{"type":"text","value":". This method will be removed in the next major version."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"query","children":[{"type":"text","value":"query()"}]},{"type":"code","value":"query<TQueryFnData, TError, TData, TQueryData, TQueryKey, TPageParam>(options: QueryExecuteOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey, TPageParam>): Promise<TData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queryClient.ts#L595","children":[{"type":"text","value":"packages/query-core/src/queryClient.ts:595"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Asynchronous method to fetch and cache a query, resolving with the data or throwing with\nthe error."}]},{"type":"paragraph","children":[{"type":"text","value":"If the query already exists in the cache and its data is not stale (per the given\n"},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":"), the cached data is returned without fetching. Otherwise, the query is fetched\nand the promise resolves once the fetch settles. If a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function is provided, it is\napplied to the data in both cases (cached or freshly fetched) before it is returned."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike a reactive observer, retries are disabled by default here ("},{"type":"inlineCode","value":"retry: false"},{"type":"text","value":") unless\nexplicitly configured, since there is no component to catch a thrown error and retry through\nre-render."}]},{"type":"paragraph","children":[{"type":"text","value":"The accepted options are "},{"type":"inlineCode","value":"QueryObserverOptions"},{"type":"text","value":" minus the fields that only make sense for a\nreactive observer — "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":", "},{"type":"inlineCode","value":"refetchInterval"},{"type":"text","value":", "},{"type":"inlineCode","value":"refetchIntervalInBackground"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"refetchOnWindowFocus"},{"type":"text","value":", "},{"type":"inlineCode","value":"refetchOnReconnect"},{"type":"text","value":", "},{"type":"inlineCode","value":"refetchOnMount"},{"type":"text","value":", "},{"type":"inlineCode","value":"retryOnMount"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"notifyOnChangeProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":", "},{"type":"inlineCode","value":"suspense"},{"type":"text","value":", and "},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" are not part of this\nmethod's options."}]},{"type":"paragraph","children":[{"type":"text","value":"This method replaces the deprecated "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":", and — combined with\n"},{"type":"inlineCode","value":"{ staleTime: 'static' }"},{"type":"text","value":" — the deprecated "},{"type":"inlineCode","value":"ensureQueryData"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"type-parameters-17","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tqueryfndata-12","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":5,"id":"terror-10","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":5,"id":"tdata-9","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":5,"id":"tquerydata-2","children":[{"type":"text","value":"TQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":5,"id":"tquerykey-9","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":5,"id":"tpageparam-7","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"never"}]},{"type":"heading","depth":4,"id":"parameters-20","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"options-11","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/QueryExecuteOptions.md","children":[{"type":"inlineCode","value":"QueryExecuteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The query options, including the "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" and the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" used if the\nquery needs to fetch."}]},{"type":"heading","depth":4,"id":"returns-25","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise that resolves to the data, or to the result of "},{"type":"inlineCode","value":"select"},{"type":"text","value":" if provided. It\nrejects with the error from the fetch or from "},{"type":"inlineCode","value":"select"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"example-15","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"try {\n  const data = await queryClient.query({ queryKey, queryFn, staleTime: 10000 })\n} catch (error) {\n  console.log(error)\n}","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"refetchqueries","children":[{"type":"text","value":"refetchQueries()"}]},{"type":"code","value":"refetchQueries<TTaggedQueryKey>(filters?: RefetchQueryFilters<TTaggedQueryKey>, options?: RefetchOptions): Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queryClient.ts#L535","children":[{"type":"text","value":"packages/query-core/src/queryClient.ts:535"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Refetches queries matching the given filters, regardless of whether they are stale. Without\nfilters, every query in the cache is refetched. Queries that are disabled, or static (only\nhave observers with a static "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":"), are never refetched."}]},{"type":"paragraph","children":[{"type":"text","value":"By default ("},{"type":"inlineCode","value":"cancelRefetch: true"},{"type":"text","value":"), a currently running fetch is cancelled before the new\none starts. The returned promise resolves once all matching queries have settled; it does\nnot reject on individual query failures unless "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is set."}]},{"type":"heading","depth":4,"id":"type-parameters-18","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"ttaggedquerykey-5","children":[{"type":"text","value":"TTaggedQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"parameters-21","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"filters-6","children":[{"type":"text","value":"filters?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/RefetchQueryFilters.md","children":[{"type":"inlineCode","value":"RefetchQueryFilters"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The filters that select which queries to refetch. Without filters, every query\nin the cache is included."}]},{"type":"heading","depth":5,"id":"options-12","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/RefetchOptions.md","children":[{"type":"inlineCode","value":"RefetchOptions"}]},{"type":"text","value":" = "},{"type":"inlineCode","value":"{}"}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"cancelRefetch"},{"type":"text","value":" to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" to keep a running fetch instead of cancelling\nit, and "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" to reject when a refetch fails."}]},{"type":"heading","depth":4,"id":"returns-26","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise that resolves once every matched query has settled."}]},{"type":"heading","depth":4,"id":"example-16","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// refetch all active queries partially matching a query key:\nawait queryClient.refetchQueries({ queryKey: ['posts'], type: 'active' })","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"removequeries","children":[{"type":"text","value":"removeQueries()"}]},{"type":"code","value":"removeQueries<TTaggedQueryKey>(filters?: QueryFilters<TTaggedQueryKey>): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queryClient.ts#L397","children":[{"type":"text","value":"packages/query-core/src/queryClient.ts:397"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Removes queries from the cache that match the given filters. Unlike\n"},{"type":"link","href":"#invalidatequeries","children":[{"type":"text","value":"QueryClient#invalidateQueries"}]},{"type":"text","value":" or "},{"type":"link","href":"#refetchqueries","children":[{"type":"text","value":"QueryClient#refetchQueries"}]},{"type":"text","value":", this removes\nmatching queries from the cache instead of refetching them. Without filters, every query in\nthe cache is removed."}]},{"type":"heading","depth":4,"id":"type-parameters-19","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"ttaggedquerykey-6","children":[{"type":"text","value":"TTaggedQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"parameters-22","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"filters-7","children":[{"type":"text","value":"filters?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/QueryFilters.md","children":[{"type":"inlineCode","value":"QueryFilters"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The filters that select which queries to remove. Without filters, every query\nis removed."}]},{"type":"heading","depth":4,"id":"returns-27","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-17","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"queryClient.removeQueries({ queryKey: ['posts'], exact: true })","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"resetqueries","children":[{"type":"text","value":"resetQueries()"}]},{"type":"code","value":"resetQueries<TTaggedQueryKey>(filters?: QueryFilters<TTaggedQueryKey>, options?: ResetOptions): Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queryClient.ts#L422","children":[{"type":"text","value":"packages/query-core/src/queryClient.ts:422"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Resets queries matching the given filters back to their initial state (e.g. any\n"},{"type":"inlineCode","value":"initialData"},{"type":"text","value":"), notifying subscribers rather than removing them. Active queries among the\nmatched set are then refetched, and the returned promise resolves once that refetch settles."}]},{"type":"heading","depth":4,"id":"type-parameters-20","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"ttaggedquerykey-7","children":[{"type":"text","value":"TTaggedQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"parameters-23","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"filters-8","children":[{"type":"text","value":"filters?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/QueryFilters.md","children":[{"type":"inlineCode","value":"QueryFilters"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The filters that select which queries to reset. Without filters, every query\nis reset."}]},{"type":"heading","depth":5,"id":"options-13","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/ResetOptions.md","children":[{"type":"inlineCode","value":"ResetOptions"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Passed to the refetch of the active matched queries, e.g. "},{"type":"inlineCode","value":"cancelRefetch"},{"type":"text","value":" and\n"},{"type":"inli