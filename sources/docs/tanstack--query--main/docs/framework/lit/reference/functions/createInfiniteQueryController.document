,"children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"tquerykey","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":3,"id":"tpageparam","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"host","children":[{"type":"text","value":"host"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveControllerHost"}]},{"type":"paragraph","children":[{"type":"text","value":"The Lit reactive controller host that owns the infinite query\nsubscription."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Accessor.md","children":[{"type":"inlineCode","value":"Accessor"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateInfiniteQueryOptions.md","children":[{"type":"inlineCode","value":"CreateInfiniteQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Infinite query observer options, or a getter that returns\noptions."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/InfiniteQueryObserverOptions.md#properties","children":[{"type":"inlineCode","value":"InfiniteQueryObserverOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/InfiniteQueryResultAccessor.md","children":[{"type":"inlineCode","value":"InfiniteQueryResultAccessor"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor for the latest infinite query result with page helper\nmethods."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { createInfiniteQueryController } from '@tanstack/lit-query'\n\nclass ProjectsView extends LitElement {\n  private readonly projects = createInfiniteQueryController(this, {\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextCursor,\n  })\n\n  render() {\n    const query = this.projects()\n\n    return html`\n      <button ?disabled=${!query.hasNextPage} @click=${() => this.projects.fetchNextPage()}>\n        Load more\n      </button>\n    `\n  }\n}","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tqueryfndata","text":"TQueryFnData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tquerykey","text":"TQueryKey","level":3},{"id":"tpageparam","text":"TPageParam","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"host","text":"host","level":3},{"id":"options","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createInfiniteQueryController<TQueryFnData, TError, TData, TQueryKey, TPageParam>(\n   host: ReactiveControllerHost,\n   options: Accessor<CreateInfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>,\nqueryClient?: QueryClient): InfiniteQueryResultAccessor<TData, TError>;\n```\n\nDefined in: [packages/lit-query/src/createInfiniteQueryController.ts:401](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createInfiniteQueryController.ts#L401)\n\nCreates a Lit reactive controller that subscribes the host to an infinite\nquery.\n\nThe returned accessor is callable and also exposes `current`, `refetch`,\n`fetchNextPage`, `fetchPreviousPage`, and `destroy`. When `options` is a\nfunction, it is re-read during host updates so query keys and options can\nfollow reactive host state.\n\nIf `queryClient` is omitted, the controller resolves the client from the\nnearest connected `QueryClientProvider`.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### TPageParam\n\n`TPageParam` = `unknown`\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nThe Lit reactive controller host that owns the infinite query\nsubscription.\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateInfiniteQueryOptions`](../type-aliases/CreateInfiniteQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nInfinite query observer options, or a getter that returns\noptions.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`InfiniteQueryObserverOptions`](../interfaces/InfiniteQueryObserverOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nOptional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context.\n\n## Returns\n\n[`InfiniteQueryResultAccessor`](../type-aliases/InfiniteQueryResultAccessor.md)\\<`TData`, `TError`\\>\n\nAn accessor for the latest infinite query result with page helper\nmethods.\n\n## Example\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createInfiniteQueryController } from '@tanstack/lit-query'\n\nclass ProjectsView extends LitElement {\n  private readonly projects = createInfiniteQueryController(this, {\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextCursor,\n  })\n\n  render() {\n    const query = this.projects()\n\n    return html`\n      <button ?disabled=${!query.hasNextPage} @click=${() => this.projects.fetchNextPage()}>\n        Load more\n      </button>\n    `\n  }\n}\n```\n","originalRawMarkdown":"---\nid: createInfiniteQueryController\ntitle: createInfiniteQueryController\n---\n\n```ts\nfunction createInfiniteQueryController<TQueryFnData, TError, TData, TQueryKey, TPageParam>(\n   host: ReactiveControllerHost,\n   options: Accessor<CreateInfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>,\nqueryClient?: QueryClient): InfiniteQueryResultAccessor<TData, TError>;\n```\n\nDefined in: [packages/lit-query/src/createInfiniteQueryController.ts:401](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createInfiniteQueryController.ts#L401)\n\nCreates a Lit reactive controller that subscribes the host to an infinite\nquery.\n\nThe returned accessor is callable and also exposes `current`, `refetch`,\n`fetchNextPage`, `fetchPreviousPage`, and `destroy`. When `options` is a\nfunction, it is re-read during host updates so query keys and options can\nfollow reactive host state.\n\nIf `queryClient` is omitted, the controller resolves the client from the\nnearest connected `QueryClientProvider`.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### TPageParam\n\n`TPageParam` = `unknown`\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nThe Lit reactive controller host that owns the infinite query\nsubscription.\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateInfiniteQueryOptions`](../type-aliases/CreateInfiniteQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nInfinite query observer options, or a getter that returns\noptions.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`InfiniteQueryObserverOptions`](../interfaces/InfiniteQueryObserverOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nOptional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context.\n\n## Returns\n\n[`InfiniteQueryResultAccessor`](../type-aliases/InfiniteQueryResultAccessor.md)\\<`TData`, `TError`\\>\n\nAn accessor for the latest infinite query result with page helper\nmethods.\n\n## Example\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createInfiniteQueryController } from '@tanstack/lit-query'\n\nclass ProjectsView extends LitElement {\n  private readonly projects = createInfiniteQueryController(this, {\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextCursor,\n  })\n\n  render() {\n    const query = this.projects()\n\n    return html`\n      <button ?disabled=${!query.hasNextPage} @click=${() => this.projects.fetchNextPage()}>\n        Load more\n      </button>\n    `\n  }\n}\n```\n"}
