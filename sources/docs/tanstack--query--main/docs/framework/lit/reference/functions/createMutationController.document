pe":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":3,"id":"tvariables","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" = "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"tonmutateresult","children":[{"type":"text","value":"TOnMutateResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"host","children":[{"type":"text","value":"host"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveControllerHost"}]},{"type":"paragraph","children":[{"type":"text","value":"The Lit reactive controller host that owns the mutation\nsubscription."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Accessor.md","children":[{"type":"inlineCode","value":"Accessor"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateMutationOptions.md","children":[{"type":"inlineCode","value":"CreateMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Mutation observer options, or a getter that returns options."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/MutationObserverOptions.md#properties","children":[{"type":"inlineCode","value":"MutationObserverOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/MutationResultAccessor.md","children":[{"type":"inlineCode","value":"MutationResultAccessor"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor for the latest mutation result with mutation helper\nmethods."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { createMutationController } from '@tanstack/lit-query'\n\nclass AddTodoForm extends LitElement {\n  private readonly addTodo = createMutationController(this, {\n    mutationFn: (title: string) =>\n      fetch('/api/todos', { method: 'POST', body: JSON.stringify({ title }) }),\n  })\n\n  render() {\n    const mutation = this.addTodo()\n\n    return html`\n      <button ?disabled=${mutation.isPending} @click=${() => this.addTodo.mutate('Ship docs')}>\n        Add todo\n      </button>\n    `\n  }\n}","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tvariables","text":"TVariables","level":3},{"id":"tonmutateresult","text":"TOnMutateResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"host","text":"host","level":3},{"id":"options","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createMutationController<TData, TError, TVariables, TOnMutateResult>(\n   host: ReactiveControllerHost,\n   options: Accessor<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>>,\nqueryClient?: QueryClient): MutationResultAccessor<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/lit-query/src/createMutationController.ts:325](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createMutationController.ts#L325)\n\nCreates a Lit reactive controller that subscribes the host to a mutation.\n\nThe returned accessor is callable and also exposes `current`, `mutate`,\n`mutateAsync`, `reset`, and `destroy`. When `options` is a function, it is\nre-read during host updates so mutation options can follow reactive host\nstate.\n\nIf `queryClient` is omitted, the controller resolves the client from the\nnearest connected `QueryClientProvider`.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nThe Lit reactive controller host that owns the mutation\nsubscription.\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\\>\n\nMutation observer options, or a getter that returns options.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationObserverOptions`](../interfaces/MutationObserverOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nOptional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context.\n\n## Returns\n\n[`MutationResultAccessor`](../type-aliases/MutationResultAccessor.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nAn accessor for the latest mutation result with mutation helper\nmethods.\n\n## Example\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createMutationController } from '@tanstack/lit-query'\n\nclass AddTodoForm extends LitElement {\n  private readonly addTodo = createMutationController(this, {\n    mutationFn: (title: string) =>\n      fetch('/api/todos', { method: 'POST', body: JSON.stringify({ title }) }),\n  })\n\n  render() {\n    const mutation = this.addTodo()\n\n    return html`\n      <button ?disabled=${mutation.isPending} @click=${() => this.addTodo.mutate('Ship docs')}>\n        Add todo\n      </button>\n    `\n  }\n}\n```\n","originalRawMarkdown":"---\nid: createMutationController\ntitle: createMutationController\n---\n\n```ts\nfunction createMutationController<TData, TError, TVariables, TOnMutateResult>(\n   host: ReactiveControllerHost,\n   options: Accessor<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>>,\nqueryClient?: QueryClient): MutationResultAccessor<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/lit-query/src/createMutationController.ts:325](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createMutationController.ts#L325)\n\nCreates a Lit reactive controller that subscribes the host to a mutation.\n\nThe returned accessor is callable and also exposes `current`, `mutate`,\n`mutateAsync`, `reset`, and `destroy`. When `options` is a function, it is\nre-read during host updates so mutation options can follow reactive host\nstate.\n\nIf `queryClient` is omitted, the controller resolves the client from the\nnearest connected `QueryClientProvider`.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nThe Lit reactive controller host that owns the mutation\nsubscription.\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\\>\n\nMutation observer options, or a getter that returns options.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationObserverOptions`](../interfaces/MutationObserverOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nOptional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context.\n\n## Returns\n\n[`MutationResultAccessor`](../type-aliases/MutationResultAccessor.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nAn accessor for the latest mutation result with mutation helper\nmethods.\n\n## Example\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createMutationController } from '@tanstack/lit-query'\n\nclass AddTodoForm extends LitElement {\n  private readonly addTodo = createMutationController(this, {\n    mutationFn: (title: string) =>\n      fetch('/api/todos', { method: 'POST', body: JSON.stringify({ title }) }),\n  })\n\n  render() {\n    const mutation = this.addTodo()\n\n    return html`\n      <button ?disabled=${mutation.isPending} @click=${() => this.addTodo.mutate('Ship docs')}>\n        Add todo\n      </button>\n    `\n  }\n}\n```\n"}
