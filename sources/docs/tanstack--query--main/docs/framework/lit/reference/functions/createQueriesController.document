"any"},{"type":"text","value":"[]"}]},{"type":"heading","depth":3,"id":"tcombinedresult","children":[{"type":"text","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCombinedResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"CreateQueriesResults"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryOptions"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"host","children":[{"type":"text","value":"host"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveControllerHost"}]},{"type":"paragraph","children":[{"type":"text","value":"The Lit reactive controller host that owns the queries\nsubscription."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Accessor.md","children":[{"type":"inlineCode","value":"Accessor"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateQueriesControllerOptions.md","children":[{"type":"inlineCode","value":"CreateQueriesControllerOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryOptions"},{"type":"text","value":", "},{"type":"inlineCode","value":"TCombinedResult"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Queries controller options, or a getter that returns options."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../type-aliases/CreateQueriesControllerOptions.md#properties","children":[{"type":"inlineCode","value":"CreateQueriesControllerOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueriesResultAccessor.md","children":[{"type":"inlineCode","value":"QueriesResultAccessor"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TCombinedResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor for the latest query results, or the value returned by\n"},{"type":"inlineCode","value":"combine"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { createQueriesController } from '@tanstack/lit-query'\n\nclass DashboardView extends LitElement {\n  private readonly dashboard = createQueriesController(this, {\n    queries: [\n      { queryKey: ['stats'], queryFn: fetchStats },\n      { queryKey: ['projects'], queryFn: fetchProjects },\n    ],\n    combine: ([stats, projects]) => ({\n      stats: stats.data,\n      projects: projects.data ?? [],\n      isPending: stats.isPending || projects.isPending,\n    }),\n  })\n\n  render() {\n    const dashboard = this.dashboard()\n    return html`<p>Projects: ${dashboard.projects.length}</p>`\n  }\n}","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tqueryoptions","text":"TQueryOptions","level":3},{"id":"tcombinedresult","text":"TCombinedResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"host","text":"host","level":3},{"id":"options","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createQueriesController<TQueryOptions, TCombinedResult>(\n   host: ReactiveControllerHost,\n   options: Accessor<CreateQueriesControllerOptions<TQueryOptions, TCombinedResult>>,\nqueryClient?: QueryClient): QueriesResultAccessor<TCombinedResult>;\n```\n\nDefined in: [packages/lit-query/src/createQueriesController.ts:711](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createQueriesController.ts#L711)\n\nCreates a Lit reactive controller that subscribes the host to multiple\nqueries.\n\nThe returned accessor is callable and also exposes `current` and `destroy`.\nWhen `options` or `options.queries` is a function, it is re-read during host\nupdates so the query list can follow reactive host state.\n\nIf `queryClient` is omitted, the controller resolves the client from the\nnearest connected `QueryClientProvider`.\n\n## Type Parameters\n\n### TQueryOptions\n\n`TQueryOptions` *extends* `any`[]\n\n### TCombinedResult\n\n`TCombinedResult` = `CreateQueriesResults`\\<`TQueryOptions`\\>\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nThe Lit reactive controller host that owns the queries\nsubscription.\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateQueriesControllerOptions`](../type-aliases/CreateQueriesControllerOptions.md)\\<`TQueryOptions`, `TCombinedResult`\\>\\>\n\nQueries controller options, or a getter that returns options.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`CreateQueriesControllerOptions`](../type-aliases/CreateQueriesControllerOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nOptional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context.\n\n## Returns\n\n[`QueriesResultAccessor`](../type-aliases/QueriesResultAccessor.md)\\<`TCombinedResult`\\>\n\nAn accessor for the latest query results, or the value returned by\n`combine`.\n\n## Example\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createQueriesController } from '@tanstack/lit-query'\n\nclass DashboardView extends LitElement {\n  private readonly dashboard = createQueriesController(this, {\n    queries: [\n      { queryKey: ['stats'], queryFn: fetchStats },\n      { queryKey: ['projects'], queryFn: fetchProjects },\n    ],\n    combine: ([stats, projects]) => ({\n      stats: stats.data,\n      projects: projects.data ?? [],\n      isPending: stats.isPending || projects.isPending,\n    }),\n  })\n\n  render() {\n    const dashboard = this.dashboard()\n    return html`<p>Projects: ${dashboard.projects.length}</p>`\n  }\n}\n```\n","originalRawMarkdown":"---\nid: createQueriesController\ntitle: createQueriesController\n---\n\n```ts\nfunction createQueriesController<TQueryOptions, TCombinedResult>(\n   host: ReactiveControllerHost,\n   options: Accessor<CreateQueriesControllerOptions<TQueryOptions, TCombinedResult>>,\nqueryClient?: QueryClient): QueriesResultAccessor<TCombinedResult>;\n```\n\nDefined in: [packages/lit-query/src/createQueriesController.ts:711](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createQueriesController.ts#L711)\n\nCreates a Lit reactive controller that subscribes the host to multiple\nqueries.\n\nThe returned accessor is callable and also exposes `current` and `destroy`.\nWhen `options` or `options.queries` is a function, it is re-read during host\nupdates so the query list can follow reactive host state.\n\nIf `queryClient` is omitted, the controller resolves the client from the\nnearest connected `QueryClientProvider`.\n\n## Type Parameters\n\n### TQueryOptions\n\n`TQueryOptions` *extends* `any`[]\n\n### TCombinedResult\n\n`TCombinedResult` = `CreateQueriesResults`\\<`TQueryOptions`\\>\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nThe Lit reactive controller host that owns the queries\nsubscription.\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateQueriesControllerOptions`](../type-aliases/CreateQueriesControllerOptions.md)\\<`TQueryOptions`, `TCombinedResult`\\>\\>\n\nQueries controller options, or a getter that returns options.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`CreateQueriesControllerOptions`](../type-aliases/CreateQueriesControllerOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nOptional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context.\n\n## Returns\n\n[`QueriesResultAccessor`](../type-aliases/QueriesResultAccessor.md)\\<`TCombinedResult`\\>\n\nAn accessor for the latest query results, or the value returned by\n`combine`.\n\n## Example\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createQueriesController } from '@tanstack/lit-query'\n\nclass DashboardView extends LitElement {\n  private readonly dashboard = createQueriesController(this, {\n    queries: [\n      { queryKey: ['stats'], queryFn: fetchStats },\n      { queryKey: ['projects'], queryFn: fetchProjects },\n    ],\n    combine: ([stats, projects]) => ({\n      stats: stats.data,\n      projects: projects.data ?? [],\n      isPending: stats.isPending || projects.isPending,\n    }),\n  })\n\n  render() {\n    const dashboard = this.dashboard()\n    return html`<p>Projects: ${dashboard.projects.length}</p>`\n  }\n}\n```\n"}
