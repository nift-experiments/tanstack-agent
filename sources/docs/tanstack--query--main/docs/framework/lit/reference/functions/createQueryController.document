,{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":3,"id":"tquerydata","children":[{"type":"text","value":"TQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":3,"id":"tquerykey","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"host","children":[{"type":"text","value":"host"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveControllerHost"}]},{"type":"paragraph","children":[{"type":"text","value":"The Lit reactive controller host that owns the query\nsubscription."}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Accessor.md","children":[{"type":"inlineCode","value":"Accessor"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateQueryOptions.md","children":[{"type":"inlineCode","value":"CreateQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"Query observer options, or a getter that returns options."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/QueryObserverOptions.md#properties","children":[{"type":"inlineCode","value":"QueryObserverOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryResultAccessor.md","children":[{"type":"inlineCode","value":"QueryResultAccessor"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor for the latest query result with query helper methods."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { createQueryController } from '@tanstack/lit-query'\n\nclass TodosView extends LitElement {\n  private readonly todos = createQueryController(this, {\n    queryKey: ['todos'],\n    queryFn: async () => fetch('/api/todos').then((r) => r.json()),\n  })\n\n  render() {\n    const query = this.todos()\n\n    if (query.isPending) return html`Loading...`\n    if (query.isError) return html`Error`\n\n    return html`<ul>${query.data.map((todo) => html`<li>${todo.title}</li>`)}</ul>`\n  }\n}","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tqueryfndata","text":"TQueryFnData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tquerydata","text":"TQueryData","level":3},{"id":"tquerykey","text":"TQueryKey","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"host","text":"host","level":3},{"id":"options","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createQueryController<TQueryFnData, TError, TData, TQueryData, TQueryKey>(\n   host: ReactiveControllerHost,\n   options: Accessor<CreateQueryOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>>,\nqueryClient?: QueryClient): QueryResultAccessor<TData, TError>;\n```\n\nDefined in: [packages/lit-query/src/createQueryController.ts:348](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createQueryController.ts#L348)\n\nCreates a Lit reactive controller that subscribes the host to a single query.\n\nThe returned accessor is callable and also exposes `current`, `refetch`,\n`suspense`, and `destroy`. When `options` is a function, it is re-read during\nhost updates so query keys and options can follow reactive host state.\n\nIf `queryClient` is omitted, the controller resolves the client from the\nnearest connected `QueryClientProvider`.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TData\n\n`TData` = `TQueryFnData`\n\n### TQueryData\n\n`TQueryData` = `TQueryFnData`\n\n### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nThe Lit reactive controller host that owns the query\nsubscription.\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateQueryOptions`](../type-aliases/CreateQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryData`, `TQueryKey`\\>\\>\n\nQuery observer options, or a getter that returns options.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`QueryObserverOptions`](../interfaces/QueryObserverOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nOptional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context.\n\n## Returns\n\n[`QueryResultAccessor`](../type-aliases/QueryResultAccessor.md)\\<`TData`, `TError`\\>\n\nAn accessor for the latest query result with query helper methods.\n\n## Example\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createQueryController } from '@tanstack/lit-query'\n\nclass TodosView extends LitElement {\n  private readonly todos = createQueryController(this, {\n    queryKey: ['todos'],\n    queryFn: async () => fetch('/api/todos').then((r) => r.json()),\n  })\n\n  render() {\n    const query = this.todos()\n\n    if (query.isPending) return html`Loading...`\n    if (query.isError) return html`Error`\n\n    return html`<ul>${query.data.map((todo) => html`<li>${todo.title}</li>`)}</ul>`\n  }\n}\n```\n","originalRawMarkdown":"---\nid: createQueryController\ntitle: createQueryController\n---\n\n```ts\nfunction createQueryController<TQueryFnData, TError, TData, TQueryData, TQueryKey>(\n   host: ReactiveControllerHost,\n   options: Accessor<CreateQueryOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>>,\nqueryClient?: QueryClient): QueryResultAccessor<TData, TError>;\n```\n\nDefined in: [packages/lit-query/src/createQueryController.ts:348](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createQueryController.ts#L348)\n\nCreates a Lit reactive controller that subscribes the host to a single query.\n\nThe returned accessor is callable and also exposes `current`, `refetch`,\n`suspense`, and `destroy`. When `options` is a function, it is re-read during\nhost updates so query keys and options can follow reactive host state.\n\nIf `queryClient` is omitted, the controller resolves the client from the\nnearest connected `QueryClientProvider`.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TData\n\n`TData` = `TQueryFnData`\n\n### TQueryData\n\n`TQueryData` = `TQueryFnData`\n\n### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n## Parameters\n\n### host\n\n`ReactiveControllerHost`\n\nThe Lit reactive controller host that owns the query\nsubscription.\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateQueryOptions`](../type-aliases/CreateQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryData`, `TQueryKey`\\>\\>\n\nQuery observer options, or a getter that returns options.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`QueryObserverOptions`](../interfaces/QueryObserverOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nOptional explicit query client. Provide this for\ncontrollers that should not resolve a client from Lit context.\n\n## Returns\n\n[`QueryResultAccessor`](../type-aliases/QueryResultAccessor.md)\\<`TData`, `TError`\\>\n\nAn accessor for the latest query result with query helper methods.\n\n## Example\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { createQueryController } from '@tanstack/lit-query'\n\nclass TodosView extends LitElement {\n  private readonly todos = createQueryController(this, {\n    queryKey: ['todos'],\n    queryFn: async () => fetch('/api/todos').then((r) => r.json()),\n  })\n\n  render() {\n    const query = this.todos()\n\n    if (query.isPending) return html`Loading...`\n    if (query.isError) return html`Error`\n\n    return html`<ul>${query.data.map((todo) => html`<li>${todo.title}</li>`)}</ul>`\n  }\n}\n```\n"}
