","value":"TData"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"}]},{"type":"heading","depth":3,"id":"tvariables","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"}]},{"type":"heading","depth":3,"id":"tonmutateresult","children":[{"type":"text","value":"TOnMutateResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOnMutateResult"}]}],"headings":[{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"destroy","text":"destroy","level":3},{"id":"returns","text":"Returns","level":4},{"id":"mutate","text":"mutate","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"args","text":"args","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"mutateasync","text":"mutateAsync","level":3},{"id":"reset","text":"reset","level":3},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tvariables","text":"TVariables","level":3},{"id":"tonmutateresult","text":"TOnMutateResult","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype MutationResultAccessor<TData, TError, TVariables, TOnMutateResult> = ValueAccessor<MutationObserverResult<TData, TError, TVariables, TOnMutateResult>> & object;\n```\n\nDefined in: [packages/lit-query/src/createMutationController.ts:34](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createMutationController.ts#L34)\n\nAccessor returned by `createMutationController`.\n\nCall the accessor or read its `current` property to get the latest mutation\nresult. The attached methods delegate to the active mutation observer.\n\n## Type Declaration\n\n### destroy\n\n```ts\ndestroy: () => void;\n```\n\nRemoves the controller from its Lit host and unsubscribes observers.\n\n#### Returns\n\n`void`\n\n### mutate\n\n```ts\nmutate: (...args: Parameters<MutateFunction<TData, TError, TVariables, TOnMutateResult>>) => void;\n```\n\nStarts the mutation and swallows the returned promise.\n\nThrows synchronously if no `QueryClient` can be resolved.\n\n#### Parameters\n\n##### args\n\n...`Parameters`\\<[`MutateFunction`](MutateFunction.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\\>\n\n#### Returns\n\n`void`\n\n### mutateAsync\n\n```ts\nmutateAsync: MutationObserverResult<TData, TError, TVariables, TOnMutateResult>[\"mutate\"];\n```\n\nStarts the mutation and returns the observer promise.\n\nRejects if no `QueryClient` can be resolved.\n\n### reset\n\n```ts\nreset: MutationObserverResult<TData, TError, TVariables, TOnMutateResult>[\"reset\"];\n```\n\nResets the mutation observer to its idle state.\n\n## Type Parameters\n\n### TData\n\n`TData`\n\n### TError\n\n`TError`\n\n### TVariables\n\n`TVariables`\n\n### TOnMutateResult\n\n`TOnMutateResult`\n","originalRawMarkdown":"---\nid: MutationResultAccessor\ntitle: MutationResultAccessor\n---\n\n```ts\ntype MutationResultAccessor<TData, TError, TVariables, TOnMutateResult> = ValueAccessor<MutationObserverResult<TData, TError, TVariables, TOnMutateResult>> & object;\n```\n\nDefined in: [packages/lit-query/src/createMutationController.ts:34](https://github.com/TanStack/query/blob/main/packages/lit-query/src/createMutationController.ts#L34)\n\nAccessor returned by `createMutationController`.\n\nCall the accessor or read its `current` property to get the latest mutation\nresult. The attached methods delegate to the active mutation observer.\n\n## Type Declaration\n\n### destroy\n\n```ts\ndestroy: () => void;\n```\n\nRemoves the controller from its Lit host and unsubscribes observers.\n\n#### Returns\n\n`void`\n\n### mutate\n\n```ts\nmutate: (...args: Parameters<MutateFunction<TData, TError, TVariables, TOnMutateResult>>) => void;\n```\n\nStarts the mutation and swallows the returned promise.\n\nThrows synchronously if no `QueryClient` can be resolved.\n\n#### Parameters\n\n##### args\n\n...`Parameters`\\<[`MutateFunction`](MutateFunction.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\\>\n\n#### Returns\n\n`void`\n\n### mutateAsync\n\n```ts\nmutateAsync: MutationObserverResult<TData, TError, TVariables, TOnMutateResult>[\"mutate\"];\n```\n\nStarts the mutation and returns the observer promise.\n\nRejects if no `QueryClient` can be resolved.\n\n### reset\n\n```ts\nreset: MutationObserverResult<TData, TError, TVariables, TOnMutateResult>[\"reset\"];\n```\n\nResets the mutation observer to its idle state.\n\n## Type Parameters\n\n### TData\n\n`TData`\n\n### TError\n\n`TError`\n\n### TVariables\n\n`TVariables`\n\n### TOnMutateResult\n\n`TOnMutateResult`\n"}
