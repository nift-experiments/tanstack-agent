lineCode","value":"never"},{"type":"text","value":">\n| "},{"type":"inlineCode","value":"number"},{"type":"text","value":" & "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"never"},{"type":"text","value":", "},{"type":"inlineCode","value":"never"},{"type":"text","value":">\n| "},{"type":"inlineCode","value":"symbol"},{"type":"text","value":" & "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"never"},{"type":"text","value":", "},{"type":"inlineCode","value":"never"},{"type":"text","value":"> : keyof "},{"type":"inlineCode","value":"TObject"}]},{"type":"heading","depth":3,"id":"tstrictly","children":[{"type":"text","value":"TStrictly"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TStrictly"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"\"strictly\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"safely\""},{"type":"text","value":" = "},{"type":"inlineCode","value":"\"strictly\""}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tobject","text":"TObject","level":3},{"id":"tkey","text":"TKey","level":3},{"id":"tstrictly","text":"TStrictly","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype OmitKeyof<TObject, TKey, TStrictly> = Omit<TObject, TKey>;\n```\n\nDefined in: [packages/query-core/src/types.ts:30](https://github.com/TanStack/query/blob/main/packages/query-core/src/types.ts#L30)\n\nLike `Omit`, but by default (`'strictly'`) `TKey` must be a key of `TObject`, so omitting a key\nthat doesn't exist is a type error. Pass `'safely'` to allow other keys too.\n\n## Type Parameters\n\n### TObject\n\n`TObject`\n\n### TKey\n\n`TKey` *extends* `TStrictly` *extends* `\"safely\"` ?\n  \\| keyof `TObject`\n  \\| `string` & `Record`\\<`never`, `never`\\>\n  \\| `number` & `Record`\\<`never`, `never`\\>\n  \\| `symbol` & `Record`\\<`never`, `never`\\> : keyof `TObject`\n\n### TStrictly\n\n`TStrictly` *extends* `\"strictly\"` \\| `\"safely\"` = `\"strictly\"`\n","originalRawMarkdown":"---\nid: OmitKeyof\ntitle: OmitKeyof\n---\n\n```ts\ntype OmitKeyof<TObject, TKey, TStrictly> = Omit<TObject, TKey>;\n```\n\nDefined in: [packages/query-core/src/types.ts:30](https://github.com/TanStack/query/blob/main/packages/query-core/src/types.ts#L30)\n\nLike `Omit`, but by default (`'strictly'`) `TKey` must be a key of `TObject`, so omitting a key\nthat doesn't exist is a type error. Pass `'safely'` to allow other keys too.\n\n## Type Parameters\n\n### TObject\n\n`TObject`\n\n### TKey\n\n`TKey` *extends* `TStrictly` *extends* `\"safely\"` ?\n  \\| keyof `TObject`\n  \\| `string` & `Record`\\<`never`, `never`\\>\n  \\| `number` & `Record`\\<`never`, `never`\\>\n  \\| `symbol` & `Record`\\<`never`, `never`\\> : keyof `TObject`\n\n### TStrictly\n\n`TStrictly` *extends* `\"strictly\"` \\| `\"safely\"` = `\"strictly\"`\n"}
