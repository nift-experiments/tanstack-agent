{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Rendering lists that can additively \"load more\" data onto an existing set of data or \"infinite scroll\" is also a very common UI pattern. TanStack Query supports a useful version of "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" called "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" for querying these types of lists."}]},{"type":"paragraph","children":[{"type":"text","value":"When using "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":", you'll notice a few things are different:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"data"},{"type":"text","value":" is now an object containing infinite query data:"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"data.pages"},{"type":"text","value":" array containing the fetched pages"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"data.pageParams"},{"type":"text","value":" array containing the page params used to fetch the pages"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":" and "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":" functions are now available ("},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":" is required)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"initialPageParam"},{"type":"text","value":" option is now available (and required) to specify the initial page param"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":" and "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":" options are available for both determining if there is more data to load and the information to fetch it. This information is supplied as an additional parameter in the query function"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":" boolean is now available and is "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":" returns a value other than "},{"type":"inlineCode","value":"null"},{"type":"text","value":" or "},{"type":"inlineCode","value":"undefined"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":" boolean is now available and is "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":" returns a value other than "},{"type":"inlineCode","value":"null"},{"type":"text","value":" or "},{"type":"inlineCode","value":"undefined"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":" and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":" booleans are now available to distinguish between a background refresh state and a loading more state"}]}]}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Note: Options "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" or "},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" need to conform to the same structure of an object with "},{"type":"inlineCode","value":"data.pages"},{"type":"text","value":" and "},{"type":"inlineCode","value":"data.pageParams"},{"type":"text","value":" properties."}]}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"Let's assume we have an API that returns pages of "},{"type":"inlineCode","value":"projects"},{"type":"text","value":" 3 at a time based on a "},{"type":"inlineCode","value":"cursor"},{"type":"text","value":" index along with a cursor that can be used to fetch the next group of projects:"}]},{"type":"code","value":"fetch('/api/projects?cursor=0')\n// { data: [...], nextCursor: 3}\nfetch('/api/projects?cursor=3')\n// { data: [...], nextCursor: 6}\nfetch('/api/projects?cursor=6')\n// { data: [...], nextCursor: 9}\nfetch('/api/projects?cursor=9')\n// { data: [...] }","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"With this information, we can create a \"Load More\" UI by:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Waiting for "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" to request the first group of data by default"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Returning the information for the next query in "},{"type":"inlineCode","value":"getNextPageParam"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Calling "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":" function"}]}]}]},{"type":"code","value":"import { useInfiniteQuery } from '@tanstack/preact-query'\n\nfunction Projects() {\n  const fetchProjects = async ({ pageParam }) => {\n    const res = await fetch('/api/projects?cursor=' + pageParam)\n    return res.json()\n  }\n\n  const {\n    data,\n    error,\n    fetchNextPage,\n    hasNextPage,\n    isFetching,\n    isFetchingNextPage,\n    status,\n  } = useInfiniteQuery({\n    queryKey: ['projects'],\n    queryFn: fetchProjects,\n    initialPageParam: 0,\n    getNextPageParam: (lastPage, pages) => lastPage.nextCursor,\n  })\n\n  return status === 'pending' ? (\n    <p>Loading...</p>\n  ) : status === 'error' ? (\n    <p>Error: {error.message}</p>\n  ) : (\n    <>\n      {data.pages.map((group, i) => (\n        <div key={i}>\n          {group.data.map((project) => (\n            <p key={project.id}>{project.name}</p>\n          ))}\n        </div>\n      ))}\n      <div>\n        <button\n          onClick={() => fetchNextPage()}\n          disabled={!hasNextPage || isFetching}\n        >\n          {isFetchingNextPage\n            ? 'Loading more...'\n            : hasNextPage\n              ? 'Load More'\n              : 'Nothing more to load'}\n        </button>\n      </div>\n      <div>{isFetching && !isFetchingNextPage ? 'Fetching...' : null}</div>\n    </>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"It's essential to understand that calling "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":" while an ongoing fetch is in progress runs the risk of overwriting data refreshes happening in the background. This situation becomes particularly critical when rendering a list and triggering "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":" simultaneously."}]},{"type":"paragraph","children":[{"type":"text","value":"Remember, there can only be a single ongoing fetch for an InfiniteQuery. A single cache entry is shared for all pages, attempting to fetch twice simultaneously might lead to data overwrites."}]},{"type":"paragraph","children":[{"type":"text","value":"If you intend to enable simultaneous fetching, you can utilize the "},{"type":"inlineCode","value":"{ cancelRefetch: false }"},{"type":"text","value":" option (default: true) within "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"To ensure a seamless querying process without conflicts, it's highly recommended to verify that the query is not in an "},{"type":"inlineCode","value":"isFetching"},{"type":"text","value":" state, especially if the user won't directly control that call."}]},{"type":"code","value":"<List onEndReached={() => hasNextPage && !isFetching && fetchNextPage()} />","lang":"jsx"},{"type":"heading","depth":2,"id":"what-happens-when-an-infinite-query-needs-to-be-refetched","children":[{"type":"text","value":"What happens when an infinite query needs to be refetched?"}]},{"type":"paragraph","children":[{"type":"text","value":"When an infinite query becomes "},{"type":"inlineCode","value":"stale"},{"type":"text","value":" and needs to be refetched, each group is fetched "},{"type":"inlineCode","value":"sequentially"},{"type":"text","value":", starting from the first one. This ensures that even if the underlying data is mutated, we're not using stale cursors and potentially getting duplicates or skipping records. If an infinite query's results are ever removed from the queryCache, the pagination restarts at the initial state with only the initial group being requested."}]},{"type":"heading","depth":2,"id":"what-if-i-want-to-implement-a-bi-directional-infinite-list","children":[{"type":"text","value":"What if I want to implement a bi-directional infinite list?"}]},{"type":"paragraph","children":[{"type":"text","value":"Bi-directional lists can be implemented by using the "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":" and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":" properties and functions."}]},{"type":"code","value":"useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: fetchProjects,\n  initialPageParam: 0,\n  getNextPageParam: (lastPage, pages) => lastPage.nextCursor,\n  getPreviousPageParam: (firstPage, pages) => firstPage.prevCursor,\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"what-if-i-want-to-show-the-pages-in-reversed-order","children":[{"type":"text","value":"What if I want to show the pages in reversed order?"}]},{"type":"paragraph","children":[{"type":"text","value":"Sometimes you may want to show the pages in reversed order. If this is case, you can use the "},{"type":"inlineCode","value":"select"},{"type":"text","value":" option:"}]},{"type":"code","value":"useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: fetchProjects,\n  select: (data) => ({\n    pages: [...data.pages].reverse(),\n    pageParams: [...data.pageParams].reverse(),\n  }),\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"what-if-i-want-to-manually-update-the-infinite-query","children":[{"type":"text","value":"What if I want to manually update the infinite query?"}]},{"type":"heading","depth":3,"id":"manually-removing-first-page","children":[{"type":"text","value":"Manually removing first page:"}]},{"type":"code","value":"queryClient.setQueryData(['projects'], (data) => ({\n  pages: data.pages.slice(1),\n  pageParams: data.pageParams.slice(1),\n}))","lang":"tsx"},{"type":"heading","depth":3,"id":"manually-removing-a-single-value-from-an-individual-page","children":[{"type":"text","value":"Manually removing a single value from an individual page:"}]},{"type":"code","value":"const newPagesArray =\n  oldPagesArray?.pages.map((page) =>\n    page.filter((val) => val.id !== updatedId),\n  ) ?? []\n\nqueryClient.setQueryData(['projects'], (data) => ({\n  pages: newPagesArray,\n  pageParams: data.pageParams,\n}))","lang":"tsx"},{"type":"heading","depth":3,"id":"keep-only-the-first-page","children":[{"type":"text","value":"Keep only the first page:"}]},{"type":"code","value":"queryClient.setQueryData(['projects'], (data) => ({\n  pages: data.pages.slice(0, 1),\n  pageParams: data.pageParams.slice(0, 1),\n}))","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Make sure to always keep the same data structure of pages and pageParams!"}]},{"type":"heading","depth":2,"id":"what-if-i-want-to-limit-the-number-of-pages","children":[{"type":"text","value":"What if I want to limit the number of pages?"}]},{"type":"paragraph","children":[{"type":"text","value":"In some use cases you may want to limit the number of pages stored in the query data to improve the performance and UX:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"when the user can load a large number of pages (memory usage)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"when you have to refetch an infinite query that contains dozens of pages (network usage: all the pages are sequentially fetched)"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The solution is to use a \"Limited Infinite Query\". This is made possible by using the "},{"type":"inlineCode","value":"maxPages"},{"type":"text","value":" option in conjunction with "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":" and "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":" to allow fetching pages when needed in both directions."}]},{"type":"paragraph","children":[{"type":"text","value":"In the following example only 3 pages are kept in the query data pages array. If a refetch is needed, only 3 pages will be refetched sequentially."}]},{"type":"code","value":"useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: fetchProjects,\n  initialPageParam: 0,\n  getNextPageParam: (lastPage, pages) => lastPage.nextCursor,\n  getPreviousPageParam: (firstPage, pages) => firstPage.prevCursor,\n  maxPages: 3,\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"what-if-my-api-doesn-t-return-a-cursor","children":[{"type":"text","value":"What if my API doesn't return a cursor?"}]},{"type":"paragraph","children":[{"type":"text","value":"If your API doesn't return a cursor, you can use the "},{"type":"inlineCode","value":"pageParam"},{"type":"text","value":" as a cursor. Because "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":" and "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":" also get the "},{"type":"inlineCode","value":"pageParam"},{"type":"text","value":"of the current page, you can use it to calculate the next / previous page param."}]},{"type":"code","value":"return useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: fetchProjects,\n  initialPageParam: 0,\n  getNextPageParam: (lastPage, allPages, lastPageParam) => {\n    if (lastPage.length === 0) {\n      return undefined\n    }\n    return lastPageParam + 1\n  },\n  getPreviousPageParam: (firstPage, allPages, firstPageParam) => {\n    if (firstPageParam <= 1) {\n      return undefined\n    }\n    return firstPageParam - 1\n  },\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"further-reading","children":[{"type":"text","value":"Further reading"}]},{"type":"paragraph","children":[{"type":"text","value":"To get a better understanding of how Infinite Queries work under the hood, see the article "},{"type":"link","href":"https://tkdodo.eu/blog/how-infinite-queries-work","children":[{"type":"text","value":"How Infinite Queries work"}]},{"type":"text","value":"."}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"what-happens-when-an-infinite-query-needs-to-be-refetched","text":"What happens when an infinite query needs to be refetched?","level":2},{"id":"what-if-i-want-to-implement-a-bi-directional-infinite-list","text":"What if I want to implement a bi-directional infinite list?","level":2},{"id":"what-if-i-want-to-show-the-pages-in-reversed-order","text":"What if I want to show the pages in reversed order?","level":2},{"id":"what-if-i-want-to-manually-update-the-infinite-query","text":"What if I want to manually update the infinite query?","level":2},{"id":"manually-removing-first-page","text":"Manually removing first page:","level":3},{"id":"manually-removing-a-single-value-from-an-individual-page","text":"Manually removing a single value from an individual page:","level":3},{"id":"keep-only-the-first-page","text":"Keep only the first page:","level":3},{"id":"what-if-i-want-to-limit-the-number-of-pages","text":"What if I want to limit the number of pages?","level":2},{"id":"what-if-my-api-doesn-t-return-a-cursor","text":"What if my API doesn't return a cursor?","level":2},{"id":"further-reading","text":"Further reading","level":2}]},"frameworks":[],"downloadMarkdown":"\nRendering lists that can additively \"load more\" data onto an existing set of data or \"infinite scroll\" is also a very common UI pattern. TanStack Query supports a useful version of `useQuery` called `useInfiniteQuery` for querying these types of lists.\n\nWhen using `useInfiniteQuery`, you'll notice a few things are different:\n\n- `data` is now an object containing infinite query data:\n- `data.pages` array containing the fetched pages\n- `data.pageParams` array containing the page params used to fetch the pages\n- The `fetchNextPage` and `fetchPreviousPage` functions are now available (`fetchNextPage` is required)\n- The `initialPageParam` option is now available (and required) to specify the initial page param\n- The `getNextPageParam` and `getPreviousPageParam` options are available for both determining if there is more data to load and the information to fetch it. This information is supplied as an additional parameter in the query function\n- A `hasNextPage` boolean is now available and is `true` if `getNextPageParam` returns a value other than `null` or `undefined`\n- A `hasPreviousPage` boolean is now available and is `true` if `getPreviousPageParam` returns a value other than `null` or `undefined`\n- The `isFetchingNextPage` and `isFetchingPreviousPage` booleans are now available to distinguish between a background refresh state and a loading more state\n\n> Note: Options `initialData` or `placeholderData` need to conform to the same structure of an object with `data.pages` and `data.pageParams` properties.\n\n## Example\n\nLet's assume we have an API that returns pages of `projects` 3 at a time based on a `cursor` index along with a cursor that can be used to fetch the next group of projects:\n\n```tsx\nfetch('/api/projects?cursor=0')\n// { data: [...], nextCursor: 3}\nfetch('/api/projects?cursor=3')\n// { data: [...], nextCursor: 6}\nfetch('/api/projects?cursor=6')\n// { data: [...], nextCursor: 9}\nfetch('/api/projects?cursor=9')\n// { data: [...] }\n```\n\nWith this information, we can create a \"Load More\" UI by:\n\n- Waiting for `useInfiniteQuery` to request the first group of data by default\n- Returning the information for the next query in `getNextPageParam`\n- Calling `fetchNextPage` function\n\n\n\n```tsx\nimport { useInfiniteQuery } from '@tanstack/preact-query'\n\nfunction Projects() {\n  const fetchProjects = async ({ pageParam }) => {\n    const res = await fetch('/api/projects?cursor=' + pageParam)\n    return res.json()\n  }\n\n  const {\n    data,\n    error,\n    fetchNextPage,\n    hasNextPage,\n    isFetching,\n    isFetchingNextPage,\n    status,\n  } = useInfiniteQuery({\n    queryKey: ['projects'],\n    queryFn: fetchProjects,\n    initialPageParam: 0,\n    getNextPageParam: (lastPage, pages) => lastPage.nextCursor,\n  })\n\n  return status === 'pending' ? (\n    <p>Loading...</p>\n  ) : status === 'error' ? (\n    <p>Error: {error.message}</p>\n  ) : (\n    <>\n      {data.pages.map((group, i) => (\n        <div key={i}>\n          {group.data.map((project) => (\n            <p key={project.id}>{project.name}</p>\n          ))}\n        </div>\n      ))}\n      <div>\n        <button\n          onClick={() => fetchNextPage()}\n          disabled={!hasNextPage || isFetching}\n        >\n          {isFetchingNextPage\n            ? 'Loading more...'\n            : hasNextPage\n              ? 'Load More'\n              : 'Nothing more to load'}\n        </button>\n      </div>\n      <div>{isFetching && !isFetchingNextPage ? 'Fetching...' : null}</div>\n    </>\n  )\n}\n```\n\n\n\nIt's essential to understand that calling `fetchNextPage` while an ongoing fetch is in progress runs the risk of overwriting data refreshes happening in the background. This situation becomes particularly critical when rendering a list and triggering `fetchNextPage` simultaneously.\n\nRemember, there can only be a single ongoing fetch for an InfiniteQuery. A single cache entry is shared for all pages, attempting to fetch twice simultaneously might lead to data overwrites.\n\nIf you intend to enable simultaneous fetching, you can utilize the `{ cancelRefetch: false }` option (default: true) within `fetchNextPage`.\n\nTo ensure a seamless querying process without conflicts, it's highly recommended to verify that the query is not in an `isFetching` state, especially if the user won't directly control that call.\n\n\n\n```jsx\n<List onEndReached={() => hasNextPage && !isFetching && fetchNextPage()} />\n```\n\n\n\n## What happens when an infinite query needs to be refetched?\n\nWhen an infinite query becomes `stale` and needs to be refetched, each group is fetched `sequentially`, starting from the first one. This ensures that even if the underlying data is mutated, we're not using stale cursors and potentially getting duplicates or skipping records. If an infinite query's results are ever removed from the queryCache, the pagination restarts at the initial state with only the initial group being requested.\n\n## What if I want to implement a bi-directional infinite list?\n\nBi-directional lists can be implemented by using the `getPreviousPageParam`, `fetchPreviousPage`, `hasPreviousPage` and `isFetchingPreviousPage` properties and functions.\n\n\n\n```tsx\nuseInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: fetchProjects,\n  initialPageParam: 0,\n  getNextPageParam: (lastPage, pages) => lastPage.nextCursor,\n  getPreviousPageParam: (firstPage, pages) => firstPage.prevCursor,\n})\n```\n\n\n\n## What if I want to show the pages in reversed order?\n\nSometimes you may want to show the pages in reversed order. If this is case, you can use the `select` option:\n\n\n\n```tsx\nuseInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: fetchProjects,\n  select: (data) => ({\n    pages: [...data.pages].reverse(),\n    pageParams: [...data.pageParams].reverse(),\n  }),\n})\n```\n\n\n\n## What if I want to manually update the infinite query?\n\n### Manually removing first page:\n\n\n\n```tsx\nqueryClient.setQueryData(['projects'], (data) => ({\n  pages: data.pages.slice(1),\n  pageParams: data.pageParams.slice(1),\n}))\n```\n\n\n\n### Manually removing a single value from an individual page:\n\n\n\n```tsx\nconst newPagesArray =\n  oldPagesArray?.pages.map((page) =>\n    page.filter((val) => val.id !== updatedId),\n  ) ?? []\n\nqueryClient.setQueryData(['projects'], (data) => ({\n  pages: newPagesArray,\n  pageParams: data.pageParams,\n}))\n```\n\n\n\n### Keep only the first page:\n\n\n\n```tsx\nqueryClient.setQueryData(['projects'], (data) => ({\n  pages: data.pages.slice(0, 1),\n  pageParams: data.pageParams.slice(0, 1),\n}))\n```\n\n\n\nMake sure to always keep the same data structure of pages and pageParams!\n\n## What if I want to limit the number of pages?\n\nIn some use cases you may want to limit the number of pages stored in the query data to improve the performance and UX:\n\n- when the user can load a large number of pages (memory usage)\n- when you have to refetch an infinite query that contains dozens of pages (network usage: all the pages are sequentially fetched)\n\nThe solution is to use a \"Limited Infinite Query\". This is made possible by using the `maxPages` option in conjunction with `getNextPageParam` and `getPreviousPageParam` to allow fetching pages when needed in both directions.\n\nIn the following example only 3 pages are kept in the query data pages array. If a refetch is needed, only 3 pages will be refetched sequentially.\n\n\n\n```tsx\nuseInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: fetchProjects,\n  initialPageParam: 0,\n  getNextPageParam: (lastPage, pages) => lastPage.nextCursor,\n  getPreviousPageParam: (firstPage, pages) => firstPage.prevCursor,\n  maxPages: 3,\n})\n```\n\n\n\n## What if my API doesn't return a cursor?\n\nIf your API doesn't return a cursor, you can use the `pageParam` as a cursor. Because `getNextPageParam` and `getPreviousPageParam` also get the `pageParam`of the current page, you can use it to calculate the next / previous page param.\n\n\n\n```tsx\nreturn useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: fetchProjects,\n  initialPageParam: 0,\n  getNextPageParam: (lastPage, allPages, lastPageParam) => {\n    if (lastPage.length === 0) {\n      return undefined\n    }\n    return lastPageParam + 1\n  },\n  getPreviousPageParam: (firstPage, allPages, firstPageParam) => {\n    if (firstPageParam <= 1) {\n      return undefined\n    }\n    return firstPageParam - 1\n  },\n})\n```\n\n\n\n\n## Further reading\n\nTo get a better understanding of how Infinite Queries work under the hood, see the article [How Infinite Queries work](https://tkdodo.eu/blog/how-infinite-queries-work).\n\n\n","originalRawMarkdown":"---\nid: infinite-queries\ntitle: Infinite Queries\nref: docs/framework/react/guides/infinite-queries.md\nreplace: { 'react-query': 'preact-query', 'React': 'Preact' }\n---\n\n[//]: # 'Example'\n\n```tsx\nimport { useInfiniteQuery } from '@tanstack/preact-query'\n\nfunction Projects() {\n  const fetchProjects = async ({ pageParam }) => {\n    const res = await fetch('/api/projects?cursor=' + pageParam)\n    return res.json()\n  }\n\n  const {\n    data,\n    error,\n    fetchNextPage,\n    hasNextPage,\n    isFetching,\n    isFetchingNextPage,\n    status,\n  } = useInfiniteQuery({\n    queryKey: ['projects'],\n    queryFn: fetchProjects,\n    initialPageParam: 0,\n    getNextPageParam: (lastPage, pages) => lastPage.nextCursor,\n  })\n\n  return status === 'pending' ? (\n    <p>Loading...</p>\n  ) : status === 'error' ? (\n    <p>Error: {error.message}</p>\n  ) : (\n    <>\n      {data.pages.map((group, i) => (\n        <div key={i}>\n          {group.data.map((project) => (\n            <p key={project.id}>{project.name}</p>\n          ))}\n        </div>\n      ))}\n      <div>\n        <button\n          onClick={() => fetchNextPage()}\n          disabled={!hasNextPage || isFetching}\n        >\n          {isFetchingNextPage\n            ? 'Loading more...'\n            : hasNextPage\n              ? 'Load More'\n              : 'Nothing more to load'}\n        </button>\n      </div>\n      <div>{isFetching && !isFetchingNextPage ? 'Fetching...' : null}</div>\n    </>\n  )\n}\n```\n\n[//]: # 'Example'\n"}
