bleCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"props-property-children\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"children?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"ComponentChildren"}]},{"type":"tableCell","children":[{"type":"text","value":"The components that get access to the provided "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"props-property-client\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"client"}]},{"type":"tableCell","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Required"}]},{"type":"text","value":" The "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":" instance to provide."}]}]]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"VNode"}]},{"type":"paragraph","children":[{"type":"text","value":"The provided "},{"type":"inlineCode","value":"children"},{"type":"text","value":", wrapped so they can read the "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":" via "},{"type":"inlineCode","value":"useQueryClient"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { QueryClient, QueryClientProvider } from '@tanstack/preact-query'\n\nconst queryClient = new QueryClient()\n\nfunction App() {\n  return <QueryClientProvider client={queryClient}>...</QueryClientProvider>\n}","lang":"tsx"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"props","text":"props","level":3},{"id":"props-properties","text":"props properties","level":4},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction QueryClientProvider(props: QueryClientProviderProps): VNode;\n```\n\nDefined in: [packages/preact-query/src/QueryClientProvider.tsx:69](https://github.com/TanStack/query/blob/main/packages/preact-query/src/QueryClientProvider.tsx#L69)\n\nUse the `QueryClientProvider` component to connect and provide a `QueryClient` to your application. Also\ncalls `client.mount()`/`client.unmount()` as this component mounts/unmounts, which subscribes the client to\nfocus/online events (resuming any paused mutations and refetching as needed when the app regains focus or\ncomes back online).\n\n## Parameters\n\n### props\n\n[`QueryClientProviderProps`](../type-aliases/QueryClientProviderProps.md)\n\nThe `client` to provide, and the `children` that get access to it.\n\n<a id=\"props-properties\"></a>\n\n#### `props` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"props-property-children\"></a> `children?` | `ComponentChildren` | The components that get access to the provided `QueryClient`. |\n| <a id=\"props-property-client\"></a> `client` | [`QueryClient`](../classes/QueryClient.md) | **Required** The `QueryClient` instance to provide. |\n\n## Returns\n\n`VNode`\n\nThe provided `children`, wrapped so they can read the `QueryClient` via `useQueryClient`.\n\n## Example\n\n```tsx\nimport { QueryClient, QueryClientProvider } from '@tanstack/preact-query'\n\nconst queryClient = new QueryClient()\n\nfunction App() {\n  return <QueryClientProvider client={queryClient}>...</QueryClientProvider>\n}\n```\n","originalRawMarkdown":"---\nid: QueryClientProvider\ntitle: QueryClientProvider\n---\n\n```ts\nfunction QueryClientProvider(props: QueryClientProviderProps): VNode;\n```\n\nDefined in: [packages/preact-query/src/QueryClientProvider.tsx:69](https://github.com/TanStack/query/blob/main/packages/preact-query/src/QueryClientProvider.tsx#L69)\n\nUse the `QueryClientProvider` component to connect and provide a `QueryClient` to your application. Also\ncalls `client.mount()`/`client.unmount()` as this component mounts/unmounts, which subscribes the client to\nfocus/online events (resuming any paused mutations and refetching as needed when the app regains focus or\ncomes back online).\n\n## Parameters\n\n### props\n\n[`QueryClientProviderProps`](../type-aliases/QueryClientProviderProps.md)\n\nThe `client` to provide, and the `children` that get access to it.\n\n<a id=\"props-properties\"></a>\n\n#### `props` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"props-property-children\"></a> `children?` | `ComponentChildren` | The components that get access to the provided `QueryClient`. |\n| <a id=\"props-property-client\"></a> `client` | [`QueryClient`](../classes/QueryClient.md) | **Required** The `QueryClient` instance to provide. |\n\n## Returns\n\n`VNode`\n\nThe provided `children`, wrapped so they can read the `QueryClient` via `useQueryClient`.\n\n## Example\n\n```tsx\nimport { QueryClient, QueryClientProvider } from '@tanstack/preact-query'\n\nconst queryClient = new QueryClient()\n\nfunction App() {\n  return <QueryClientProvider client={queryClient}>...</QueryClientProvider>\n}\n```\n"}
