 `undefined`, thanks to `initialData` — even if a refetch fails,\n  // so the list stays visible alongside the error.\n  const { data, isError, error } = useQuery(postsOptions)\n\n  return (\n    <div>\n      {isError ? <span>Error: {error.message}</span> : null}\n      <ul>\n        {data.map((post) => <li key={post.id}>{post.title}</li>)}\n      </ul>\n    </div>\n  )\n}","lang":"tsx"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UnusedSkipTokenOptions<TQueryFnData, TError, TData, TQueryKey>): UnusedSkipTokenOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/preact-query/src/queryOptions.ts#L177","children":[{"type":"text","value":"packages/preact-query/src/queryOptions.ts:177"}]}]},{"type":"paragraph","children":[{"type":"text","value":"You can generally pass everything to "},{"type":"inlineCode","value":"queryOptions"},{"type":"text","value":" that you can also pass to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":". These options can\nbe shared across hooks and imperative APIs such as "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":". "},{"type":"inlineCode","value":"options.queryKey"},{"type":"text","value":" is required and\nis the query key to generate options for."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-2","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type"