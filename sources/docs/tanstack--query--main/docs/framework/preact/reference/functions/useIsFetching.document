"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-exact\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"exact?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Match query key exactly"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-fetchstatus\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"fetchStatus?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"fetching\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"paused\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"idle\""}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Include queries matching their fetchStatus"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-predicate\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"predicate?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"query"},{"type":"text","value":": "},{"type":"link","href":"../classes/Query.md","children":[{"type":"inlineCode","value":"Query"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Include queries matching this predicate function"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-querykey\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"queryKey?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" | "},{"type":"inlineCode","value":"TuplePrefixes"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Include queries matching this query key"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-stale\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"stale?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Include or exclude stale queries"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-type\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"type?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"QueryTypeFilter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'all'"}]},{"type":"tableCell","children":[{"type":"text","value":"Filter to active queries, inactive queries or all queries"}]}]]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will\nbe used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"Will be the "},{"type":"inlineCode","value":"number"},{"type":"text","value":" of the queries that your application is currently loading or fetching in the\nbackground."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { useIsFetching } from '@tanstack/preact-query'\n\nfunction PostsFetchingIndicator() {\n  // How many queries matching the posts prefix are fetching?\n  const isFetchingPosts = useIsFetching({ queryKey: ['posts'] })\n\n  return isFetchingPosts ? <span>Refreshing posts...</span> : null\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"A global loading indicator for any query fetching in the background, not just the ones on screen:"}]},{"type":"code","value":"import { useIsFetching } from '@tanstack/preact-query'\n\nfunction GlobalLoadingIndicator() {\n  const isFetching = useIsFetching()\n\n  return isFetching ? (\n    <div>Queries are fetching in the background...</div>\n  ) : null\n}","lang":"tsx"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"filters","text":"filters?","level":3},{"id":"filters-properties","text":"filters properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useIsFetching(filters?: QueryFilters<readonly unknown[]>, queryClient?: QueryClient): number;\n```\n\nDefined in: [packages/preact-query/src/useIsFetching.ts:41](https://github.com/TanStack/query/blob/main/packages/preact-query/src/useIsFetching.ts#L41)\n\nThe `useIsFetching` hook returns the `number` of the queries that your application is loading or fetching in\nthe background (useful for app-wide loading indicators).\n\n## Parameters\n\n### filters?\n\n[`QueryFilters`](../interfaces/QueryFilters.md)\\<readonly `unknown`[]\\>\n\nThe [QueryFilters](../interfaces/QueryFilters.md) to narrow down the matched queries.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | `undefined` | Match query key exactly |\n| <a id=\"filters-property-fetchstatus\"></a> `fetchStatus?` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | `undefined` | Include queries matching their fetchStatus |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`query`: [`Query`](../classes/Query.md)) => `boolean` | `undefined` | Include queries matching this predicate function |\n| <a id=\"filters-property-querykey\"></a> `queryKey?` | `TQueryKey` \\| `TuplePrefixes`\\<`TQueryKey`\\> | `undefined` | Include queries matching this query key |\n| <a id=\"filters-property-stale\"></a> `stale?` | `boolean` | `undefined` | Include or exclude stale queries |\n| <a id=\"filters-property-type\"></a> `type?` | `QueryTypeFilter` | `'all'` | Filter to active queries, inactive queries or all queries |\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`number`\n\nWill be the `number` of the queries that your application is currently loading or fetching in the\nbackground.\n\n## Examples\n\n```tsx\nimport { useIsFetching } from '@tanstack/preact-query'\n\nfunction PostsFetchingIndicator() {\n  // How many queries matching the posts prefix are fetching?\n  const isFetchingPosts = useIsFetching({ queryKey: ['posts'] })\n\n  return isFetchingPosts ? <span>Refreshing posts...</span> : null\n}\n```\n\nA global loading indicator for any query fetching in the background, not just the ones on screen:\n```tsx\nimport { useIsFetching } from '@tanstack/preact-query'\n\nfunction GlobalLoadingIndicator() {\n  const isFetching = useIsFetching()\n\n  return isFetching ? (\n    <div>Queries are fetching in the background...</div>\n  ) : null\n}\n```\n","originalRawMarkdown":"---\nid: useIsFetching\ntitle: useIsFetching\n---\n\n```ts\nfunction useIsFetching(filters?: QueryFilters<readonly unknown[]>, queryClient?: QueryClient): number;\n```\n\nDefined in: [packages/preact-query/src/useIsFetching.ts:41](https://github.com/TanStack/query/blob/main/packages/preact-query/src/useIsFetching.ts#L41)\n\nThe `useIsFetching` hook returns the `number` of the queries that your application is loading or fetching in\nthe background (useful for app-wide loading indicators).\n\n## Parameters\n\n### filters?\n\n[`QueryFilters`](../interfaces/QueryFilters.md)\\<readonly `unknown`[]\\>\n\nThe [QueryFilters](../interfaces/QueryFilters.md) to narrow down the matched queries.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | `undefined` | Match query key exactly |\n| <a id=\"filters-property-fetchstatus\"></a> `fetchStatus?` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | `undefined` | Include queries matching their fetchStatus |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`query`: [`Query`](../classes/Query.md)) => `boolean` | `undefined` | Include queries matching this predicate function |\n| <a id=\"filters-property-querykey\"></a> `queryKey?` | `TQueryKey` \\| `TuplePrefixes`\\<`TQueryKey`\\> | `undefined` | Include queries matching this query key |\n| <a id=\"filters-property-stale\"></a> `stale?` | `boolean` | `undefined` | Include or exclude stale queries |\n| <a id=\"filters-property-type\"></a> `type?` | `QueryTypeFilter` | `'all'` | Filter to active queries, inactive queries or all queries |\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`number`\n\nWill be the `number` of the queries that your application is currently loading or fetching in the\nbackground.\n\n## Examples\n\n```tsx\nimport { useIsFetching } from '@tanstack/preact-query'\n\nfunction PostsFetchingIndicator() {\n  // How many queries matching the posts prefix are fetching?\n  const isFetchingPosts = useIsFetching({ queryKey: ['posts'] })\n\n  return isFetchingPosts ? <span>Refreshing posts...</span> : null\n}\n```\n\nA global loading indicator for any query fetching in the background, not just the ones on screen:\n```tsx\nimport { useIsFetching } from '@tanstack/preact-query'\n\nfunction GlobalLoadingIndicator() {\n  const isFetching = useIsFetching()\n\n  return isFetching ? (\n    <div>Queries are fetching in the background...</div>\n  ) : null\n}\n```\n"}
