"value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../classes/Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":"> = "},{"type":"inlineCode","value":"MutationTypeFromResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MutationStateOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TMutation"},{"type":"text","value":"> = "},{"type":"inlineCode","value":"{}"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"filters"},{"type":"text","value":" to narrow down matched mutations, and an optional "},{"type":"inlineCode","value":"select"},{"type":"text","value":" to transform the\nmutation state."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will\nbe used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TResult"},{"type":"text","value":"[]"}]},{"type":"paragraph","children":[{"type":"text","value":"Will be an Array of whatever "},{"type":"inlineCode","value":"select"},{"type":"text","value":" returns for each matching mutation."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Get all variables of all running mutations:"}]},{"type":"code","value":"import { useMutationState } from '@tanstack/preact-query'\n\nfunction PendingPosts() {\n  const pendingVariables = useMutationState({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  })\n\n  return <>{pendingVariables.length} posts saving...</>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Get all data for specific mutations via the "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":":"}]},{"type":"code","value":"import { useMutation, useMutationState } from '@tanstack/preact-query'\n\nconst mutationKey = ['posts']\n\nfunction Posts() {\n  // Some mutation that we want to get the state for\n  const mutation = useMutation({\n    mutationKey,\n    mutationFn: createPosts,\n  })\n\n  const savedPosts = useMutationState({\n    // this mutation key needs to match the mutation key of the given mutation (see above)\n    filters: { mutationKey, status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n\n  return (\n    <button onClick={() => mutation.mutate(['New Post'])}>\n      Create post ({savedPosts.length} saved so far)\n    </button>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Access the latest successful mutation data via the "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":". Each invocation of "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" adds a new\nentry to the mutation cache for "},{"type":"inlineCode","value":"gcTime"},{"type":"text","value":" milliseconds — with the "},{"type":"inlineCode","value":"status: 'success'"},{"type":"text","value":" filter below, check the\nlast item that "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":" returns to get the latest successful invocation:"}]},{"type":"code","value":"import { useMutationState } from '@tanstack/preact-query'\n\nfunction LatestPost() {\n  const savedPosts = useMutationState({\n    filters: { mutationKey: ['posts'], status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n\n  const latestSavedPost = savedPosts[savedPosts.length - 1]\n\n  return <>{latestSavedPost ? 'Saved' : 'Nothing saved yet'}</>\n}","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tresult","text":"TResult","level":3},{"id":"tmutation","text":"TMutation","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options?","level":3},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useMutationState<TResult, TMutation>(options?: MutationStateOptions<TResult, TMutation>, queryClient?: QueryClient): TResult[];\n```\n\nDefined in: [packages/preact-query/src/useMutationState.ts:158](https://github.com/TanStack/query/blob/main/packages/preact-query/src/useMutationState.ts#L158)\n\n`useMutationState` is a hook that gives you access to all mutations in the `MutationCache`. You can pass\n`filters` ([MutationFilters](../interfaces/MutationFilters.md)) to narrow down your mutations, and `select` to transform the mutation\nstate.\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n### TMutation\n\n`TMutation` *extends* [`Mutation`](../classes/Mutation.md)\\<`any`, `any`, `any`, `any`\\> = `MutationTypeFromResult`\\<`TResult`\\>\n\n## Parameters\n\n### options?\n\n`MutationStateOptions`\\<`TResult`, `TMutation`\\> = `{}`\n\nThe `filters` to narrow down matched mutations, and an optional `select` to transform the\nmutation state.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`TResult`[]\n\nWill be an Array of whatever `select` returns for each matching mutation.\n\n## Examples\n\nGet all variables of all running mutations:\n```tsx\nimport { useMutationState } from '@tanstack/preact-query'\n\nfunction PendingPosts() {\n  const pendingVariables = useMutationState({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  })\n\n  return <>{pendingVariables.length} posts saving...</>\n}\n```\n\nGet all data for specific mutations via the `mutationKey`:\n```tsx\nimport { useMutation, useMutationState } from '@tanstack/preact-query'\n\nconst mutationKey = ['posts']\n\nfunction Posts() {\n  // Some mutation that we want to get the state for\n  const mutation = useMutation({\n    mutationKey,\n    mutationFn: createPosts,\n  })\n\n  const savedPosts = useMutationState({\n    // this mutation key needs to match the mutation key of the given mutation (see above)\n    filters: { mutationKey, status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n\n  return (\n    <button onClick={() => mutation.mutate(['New Post'])}>\n      Create post ({savedPosts.length} saved so far)\n    </button>\n  )\n}\n```\n\nAccess the latest successful mutation data via the `mutationKey`. Each invocation of `mutate` adds a new\nentry to the mutation cache for `gcTime` milliseconds — with the `status: 'success'` filter below, check the\nlast item that `useMutationState` returns to get the latest successful invocation:\n```tsx\nimport { useMutationState } from '@tanstack/preact-query'\n\nfunction LatestPost() {\n  const savedPosts = useMutationState({\n    filters: { mutationKey: ['posts'], status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n\n  const latestSavedPost = savedPosts[savedPosts.length - 1]\n\n  return <>{latestSavedPost ? 'Saved' : 'Nothing saved yet'}</>\n}\n```\n","originalRawMarkdown":"---\nid: useMutationState\ntitle: useMutationState\n---\n\n```ts\nfunction useMutationState<TResult, TMutation>(options?: MutationStateOptions<TResult, TMutation>, queryClient?: QueryClient): TResult[];\n```\n\nDefined in: [packages/preact-query/src/useMutationState.ts:158](https://github.com/TanStack/query/blob/main/packages/preact-query/src/useMutationState.ts#L158)\n\n`useMutationState` is a hook that gives you access to all mutations in the `MutationCache`. You can pass\n`filters` ([MutationFilters](../interfaces/MutationFilters.md)) to narrow down your mutations, and `select` to transform the mutation\nstate.\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n### TMutation\n\n`TMutation` *extends* [`Mutation`](../classes/Mutation.md)\\<`any`, `any`, `any`, `any`\\> = `MutationTypeFromResult`\\<`TResult`\\>\n\n## Parameters\n\n### options?\n\n`MutationStateOptions`\\<`TResult`, `TMutation`\\> = `{}`\n\nThe `filters` to narrow down matched mutations, and an optional `select` to transform the\nmutation state.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`TResult`[]\n\nWill be an Array of whatever `select` returns for each matching mutation.\n\n## Examples\n\nGet all variables of all running mutations:\n```tsx\nimport { useMutationState } from '@tanstack/preact-query'\n\nfunction PendingPosts() {\n  const pendingVariables = useMutationState({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  })\n\n  return <>{pendingVariables.length} posts saving...</>\n}\n```\n\nGet all data for specific mutations via the `mutationKey`:\n```tsx\nimport { useMutation, useMutationState } from '@tanstack/preact-query'\n\nconst mutationKey = ['posts']\n\nfunction Posts() {\n  // Some mutation that we want to get the state for\n  const mutation = useMutation({\n    mutationKey,\n    mutationFn: createPosts,\n  })\n\n  const savedPosts = useMutationState({\n    // this mutation key needs to match the mutation key of the given mutation (see above)\n    filters: { mutationKey, status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n\n  return (\n    <button onClick={() => mutation.mutate(['New Post'])}>\n      Create post ({savedPosts.length} saved so far)\n    </button>\n  )\n}\n```\n\nAccess the latest successful mutation data via the `mutationKey`. Each invocation of `mutate` adds a new\nentry to the mutation cache for `gcTime` milliseconds — with the `status: 'success'` filter below, check the\nlast item that `useMutationState` returns to get the latest successful invocation:\n```tsx\nimport { useMutationState } from '@tanstack/preact-query'\n\nfunction LatestPost() {\n  const savedPosts = useMutationState({\n    filters: { mutationKey: ['posts'], status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n\n  const latestSavedPost = savedPosts[savedPosts.length - 1]\n\n  return <>{latestSavedPost ? 'Saved' : 'Nothing saved yet'}</>\n}\n```\n"}
