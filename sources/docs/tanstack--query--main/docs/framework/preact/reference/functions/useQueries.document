{"document":{"type":"root","children":[{"type":"code","value":"function useQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/preact-query/src/useQueries.ts#L304","children":[{"type":"text","value":"packages/preact-query/src/useQueries.ts:304"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":" hook can be used to fetch a variable number of queries."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"queries"},{"type":"text","value":" key accepts an array with query option objects mostly identical to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" — see the\n"},{"type":"inlineCode","value":"queries"},{"type":"text","value":" parameter below for the differences. A custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":" is supplied once, as "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":"' own\ntop-level second argument, rather than per query."}]},{"type":"paragraph","children":[{"type":"text","value":"Having the same query key more than once in the array of query objects may cause some data to be shared\nbetween queries. To avoid this, consider de-duplicating the queries and map the results back to the desired\nstructure."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" option can be used to combine the results of the queries into a single value. The result will\nbe structurally shared to be as referentially stable as possible."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"t","children":[{"type":"text","value":"T"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"any"},{"type":"text","value":"[]"}]},{"type":"heading","depth":3,"id":"tcombinedresult","children":[{"type":"text","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCombinedResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">, "},{"type":"inlineCode","value":"GetUseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">, "},{"type":"inlineCode","value":"GetUseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">, "},{"type":"inlineCode","value":"GetUseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ... "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : ["},{"type":"inlineCode","value":"...{ [K in (...)]: (...) }[]"},{"type":"text","value":"] : [...{ [K in string | number | symbol]: GetUseQueryResult<Tails[K]> }[]] : { [K in string | number | symbol]