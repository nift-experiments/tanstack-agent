TQueryFnData"},{"type":"text","value":">)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The function that the query will use to request data. Required, unless a default query function has been set via "},{"type":"inlineCode","value":"queryClient.setQueryDefaults"},{"type":"text","value":" or "},{"type":"inlineCode","value":"queryClient.setDefaultOptions"},{"type":"text","value":". Receives a "},{"type":"link","href":"../type-aliases/QueryFunctionContext.md","children":[{"type":"text","value":"QueryFunctionContext"}]},{"type":"text","value":". Must return a promise that will either resolve data or throw an error. The data cannot be "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-queryhash\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"queryHash?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"string"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The hashed form of "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":", computed with "},{"type":"inlineCode","value":"queryKeyHashFn"},{"type":"text","value":" (or the default hashing function otherwise). Used as the actual cache key internally."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-querykey\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"queryKey"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" & "},{"type":"inlineCode","value":"object"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The query key to use 