}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../interfaces/UseQueryOptions.md","children":[{"type":"text","value":"UseQueryOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"queryclient-3","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will\nbe used."}]},{"type":"heading","depth":3,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseQueryResult.md","children":[{"type":"inlineCode","value":"UseQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The current query result. "},{"type":"inlineCode","value":"status"},{"type":"text","value":" is "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" if there is no cached data to display, "},{"type":"inlineCode","value":"error"},{"type":"text","value":" if\nthe last fetch attempt failed, or "},{"type":"inlineCode","value":"success"},{"type":"text","value":" if the query has data to display. "},{"type":"inlineCode","value":"isPending"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isError"},{"type":"text","value":"\nare derived booleans for convenience."}]},{"type":"heading","depth":3,"id":"see-3","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"queryOptions.md","children":[{"type":"text","value":"queryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" and imperative APIs like "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"examples-2","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { useQuery } from '@tanstack/preact-query'\n\nfunction Posts() {\n  const { status, data, error, isFetching } = useQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  })\n\n  if (status === 'pending') return 'Loading...'\n  if (status === 'error') return <span>Error: {error.message}</span>\n\n  return (\n    <div>\n      <ul>\n        {data.map((post) => (\n          <li key={post.id}>{post.title}</li>\n        ))}\n      </ul>\n      <div>{isFetching ? 'Background Updating...' : ' '}</div>\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"select"},{"type":"text","value":" derives whatever "},{"type":"inlineCode","value":"data"},{"type":"text","value":" a component needs from the cached value, without changing what's\nactually stored in the cache — the cache still holds the full "},{"type":"inlineCode","value":"Post[]"},{"type":"text","value":", but "},{"type":"inlineCode","value":"data"},{"type":"text","value":" here is a "},{"type":"inlineCode","value":"number"},{"type":"text","value":":"}]},{"type":"code","value":"import { useQuery } from '@tanstack/preact-query'\n\nfunction PostCount() {\n  const { data, isPending, isError, error } = useQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    select: (posts) => posts.length,\n  })\n\n  if (isPending) return 'Loading...'\n  if (isError) return <span>Error: {error.message}</span>\n\n  return <span>{data} posts</span>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"A dependent query, only enabled once "},{"type":"inlineCode","value":"postId"},{"type":"text","value":" is set — use "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", not "},{"type":"inlineCode","value":"isPending"},{"type":"text","value":", so the\nloading state doesn't show while the query is disabled:"}]},{"type":"code","value":"import { useQuery } from '@tanstack/preact-query'\n\nfunction Post({ postId }: { postId: number | undefined }) {\n  const { data, isLoading, isError, error } = useQuery({\n    queryKey: ['post', postId],\n    queryFn: () => fetchPost(postId!),\n    enabled: postId != null,\n  })\n\n  if (postId == null) return 'Select a post'\n  if (isLoading) return 'Loading...'\n  if (isError) return <span>Error: {error.message}</span>\n\n  return <h1>{data?.title}</h1>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The same dependent query, type safe: "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" disables the query without needing the\nnon-null assertion above, since "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" is only ever called when "},{"type":"inlineCode","value":"postId"},{"type":"text","value":" is defined.\n"},{"type":"inlineCode","value":"refetch"},{"type":"text","value":" doesn't work while "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" is "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" — use "},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":" instead if you\nneed to trigger the query manually:"}]},{"type":"code","value":"import { skipToken, useQuery } from '@tanstack/preact-query'\n\nfunction Post({ postId }: { postId: number | undefined }) {\n  const { data, isLoading, isError, error } = useQuery({\n    queryKey: ['post', postId],\n    queryFn: postId != null ? () => fetchPost(postId) : skipToken,\n  })\n\n  if (postId == null) return 'Select a post'\n  if (isLoading) return 'Loading...'\n  if (isError) return <span>Error: {error.message}</span>\n\n  return <h1>{data?.title}</h1>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Seeding a detail query from an already-cached list, to skip the loading state. "},{"type":"inlineCode","value":"initialDataUpdatedAt"},{"type":"text","value":" carries\nover the list's own fetch time, so that if you set a "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":", it's measured from when the list was\nfetched rather than from now:"}]},{"type":"code","value":"import { useQuery, useQueryClient } from '@tanstack/preact-query'\n\nfunction Post({ postId }: { postId: number }) {\n  const queryClient = useQueryClient()\n\n  const { data, isError, error } = useQuery({\n    queryKey: ['post', postId],\n    queryFn: () => fetchPost(postId),\n    initialData: () =>\n      queryClient\n        .getQueryData<Array<Post>>(['posts'])\n        ?.find((post) => post.id === postId),\n    initialDataUpdatedAt: () =>\n      queryClient.getQueryState(['posts'])?.dataUpdatedAt,\n  })\n\n  if (isError) return <span>Error: {error.message}</span>\n\n  return <h1>{data?.title}</h1>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Paginated data, keeping the previous page's data visible while the next page loads:"}]},{"type":"code","value":"import { keepPreviousData, useQuery } from '@tanstack/preact-query'\nimport { useState } from 'preact/hooks'\n\nfunction Posts() {\n  const [page, setPage] = useState(0)\n\n  const { data, isPlaceholderData, isError, error } = useQuery({\n    queryKey: ['posts', page],\n    queryFn: () => fetchPosts(page),\n    placeholderData: keepPreviousData,\n  })\n\n  if (isError) return <span>Error: {error.message}</span>\n\n  return (\n    <div>\n      <ul>\n        {data?.map((post) => <li key={post.id}>{post.title}</li>)}\n      </ul>\n      <button\n        disabled={isPlaceholderData}\n        onClick={() => setPage((old) => old + 1)}\n      >\n        Next Page\n      </button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-4","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/UseQueryOptions.md","children":[{"type":"inlineCode","value":"UseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../interfaces/UseQueryOptions.md","children":[{"type":"text","value":"UseQueryOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":"."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Default value"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-enabled\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"enabled?"}]},{"type":"tableCell","children":[{"type":"text","value":"| "},{"type":"inlineCode","value":"false"},{"type":"text","value":" | "},{"type":"inlineCode","value":"true"},{"type":"text","value":" | (("},{"type":"inlineCode","value":"query"},{"type":"text","value":": "},{"type":"link","href":"../classes/Query.md","children":[{"type":"inlineCode","value":"Query"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">) => "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"true"}]},{"type":"tableCell","children":[{"type":"text","value":"Set this to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" or a function that returns "},{"type":"inlineCode","value":"false"},{"type":"text","value":" to disable automatic refetching when the query mounts or changes query keys. To refetch the query, use the "},{"type":"inlineCode","value":"refetch"},{"type":"text","value":" method returned from the "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" instance. Accepts a boolean or function that returns a boolean."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-gctime\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"gcTime?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The time in milliseconds that unused/inactive cache data remains in memory. When a query's cache becomes unused or inactive, that cache data will be garbage collected after this duration. When different garbage collection times are specified, the longest one will be used. Setting it to "},{"type":"inlineCode","value":"Infinity"},{"type":"text","value":" will disable garbage collection. Defaults to "},{"type":"inlineCode","value":"5 * 60 * 1000"},{"type":"text","value":" (5 minutes), or "},{"type":"inlineCode","value":"Infinity"},{"type":"text","value":" during SSR. Note: the maximum allowed time is about 24 days, imposed by "},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":"'s 32-bit signed integer delay — see "},{"type":"inlineCode","value":"timeoutManager.setTimeoutProvider"},{"type":"text","value":" for a workaround."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-initialdata\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"initialData?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" | (() => "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"If set, this value will be used as the initial data for the query cache (as long as the query hasn't been created or cached yet). If set to a function, the function will be called "},{"type":"strong","children":[{"type":"text","value":"once"}]},{"type":"text","value":" during the shared/root query initialization, and be expected to synchronously return the initial data. Initial data is considered stale by default unless a "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" has been set. "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" "},{"type":"strong","children":[{"type":"text","value":"is persisted"}]},{"type":"text","value":" to the cache."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-initialdataupdatedat\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"initialDataUpdatedAt?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"},{"type":"text","value":" | (() => "},{"type":"inlineCode","value":"number"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"If set, this value will be used as the time (in milliseconds) of when the "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" itself was last updated."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-maxpages\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"maxPages?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Maximum number of pages to store in the data of an infinite query."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-meta\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"meta?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Additional payload to be stored on each query. Use this property to pass information that can be used in other places."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-networkmode\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"networkMode?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"online\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"always\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"offlineFirst\""}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'online'"}]},{"type":"tableCell","children":[{"type":"text","value":"Controls whether a query is allowed to run based on the current network connectivity. "},{"type":"strong","children":[{"type":"text","value":"See"}]},{"type":"text","value":" "},{"type":"link","href":"https://tanstack.com/query/latest/docs/framework/react/guides/network-mode","children":[{"type":"text","value":"Network Mode"}]},{"type":"text","value":" for more information."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-notifyonchangeprops\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"notifyOnChangeProps?"}]},{"type":"tableCell","children":[{"type":"text","value":"| ( | "},{"type":"inlineCode","value":"\"error\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"data\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isError\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isPending\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isLoading\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isLoadingError\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isRefetchError\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isSuccess\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isPlaceholderData\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"status\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"dataUpdatedAt\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"errorUpdatedAt\""},{"type":"text","value":" | "},{"type":"inlineCode"