"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The current query result. "},{"type":"inlineCode","value":"status"},{"type":"text","value":" is "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" if there is no cached data to display, "},{"type":"inlineCode","value":"error"},{"type":"text","value":" if\nthe last fetch attempt failed, or "},{"type":"inlineCode","value":"success"},{"type":"text","value":" if the query has data to display. "},{"type":"inlineCode","value":"isPending"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isError"},{"type":"text","value":"\nare derived booleans for convenience."}]},{"type":"heading","depth":3,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"queryOptions.md","children":[{"type":"text","value":"queryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" and imperative APIs like "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { useQuery } from '@tanstack/preact-query'\n\nfunction Posts() {\n  const { status, data, error, isFetching } = useQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  })\n\n  if (status === 'pending') return 'Loading...'\n  if (status === 'error') return <span>Error: {error.message}</span>\n\n  return (\n    <div>\n      <ul>\n        {data.map((post) => (\n          <li key={post.id}>{post.title}</li>\n        ))}\n      </ul>\n      <div>{isFetching ? 'Background Updating...' : ' '}</div>\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The same query, checking "},{"type":"inlineCode","value":"isPending"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isError"},{"type":"text","value":" instead of "},{"type":"inlineCode","value":"status"},{"type":"text","value":" — pick whichever reads better to you:"}]},{"type":"code","value":"import { useQuery } from '@tanstack/preact-query'\n\nfunction Posts() {\n  const { isPending, isError, data, error } = useQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  })\n\n  if (isPending) return 'Loading...'\n  if (isError) return <span>Error: {error.message}</span>\n\n  return (\n    <ul>\n      {data.map((post) => <li key={post.id}>{post.title}</li>)}\n    </ul>\n  )\n}","lang":"tsx"},{"type":"html","value":"<a id=\"call-signature-3\"></a>"},{"type":"heading","depth":2,"id":"call-signature-3","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UseQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryResult<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/preact-query/src/useQuery.ts#L281","children":[{"type":"text","value":"packages/preact-query/src/useQuery.ts:281"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Fallback overload for options whose "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" presence isn't statically known — for example, an\nobject typed as "},{"type":"link","href":"../interfaces/UseQueryOptions.md","children":[{"type":"text","value":"UseQueryOptions"}]},{"type":"text","value":" rather than an object literal. Prefer one of the other overloads\nwhen possible, since they infer whether "},{"type":"inlineCode","value":"data"},{"type":"text","value":" can be "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" from "},{"type":"inline