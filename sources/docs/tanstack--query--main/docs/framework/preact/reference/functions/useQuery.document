ldren":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/DefinedInitialDataOptions.md","children":[{"type":"inlineCode","value":"DefinedInitialDataOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/DefinedInitialDataOptions.md","children":[{"type":"text","value":"DefinedInitialDataOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" set."}]},{"type":"heading","depth":4,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will\nbe used."}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/DefinedUseQueryResult.md","children":[{"type":"inlineCode","value":"DefinedUseQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The current query result, typed so that "},{"type":"inlineCode","value":"status"},{"type":"text","value":" is "},{"type":"inlineCode","value":"success"},{"type":"text","value":" — or "},{"type":"inlineCode","value":"error"},{"type":"text","value":" if a fetch attempt\nfails while keeping the existing data ("},{"type":"inlineCode","value":"status"},{"type":"text","value":" never resolves to "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" in this overload's type,\nsince "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" guarantees data upfront). "},{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isError"},{"type":"text","value":" are derived booleans for convenience."}]},{"type":"heading","depth":3,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"queryOptions.md","children":[{"type":"text","value":"queryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" and imperative APIs like "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { useQuery } from '@tanstack/preact-query'\n\nfunction Posts() {\n  // `data` is `Post[]`, never `undefined`, thanks to `initialData` — even if a refetch fails,\n  // so the list stays visible alongside the error.\n  const { data, isError, error } = useQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    initialData: [],\n  })\n\n  return (\n    <div>\n      {isError ? <span>Error: {error.message}</span> : null}\n      <ul>\n        {data.map((post) => <li key={post.id}>{post.title}</li>)}\n      </ul>\n    </div>\n  )\n}","lang":"tsx"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryResult<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/preact-query/src/useQuery.ts#L116","children":[{"type":"text","value":"packages/preact-query/src/useQuery.ts:116"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This overload is selected when "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" is omitted or may be "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", so the resulting "},{"type":"inlineCode","value":"data"},{"type":"text","value":"\ncan be "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-2","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"terror-2","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-2","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"tquerykey-2","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"