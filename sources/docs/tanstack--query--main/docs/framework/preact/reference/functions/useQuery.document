ue":"\"isError\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isPending\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isLoading\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isLoadingError\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isRefetchError\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isSuccess\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isPlaceholderData\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"status\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"dataUpdatedAt\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"errorUpdatedAt\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"failureCount\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"failureReason\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"errorUpdateCount\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isFetched\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isFetchedAfterMount\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isFetching\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isInitialLoading\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isPaused\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isRefetching\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isStale\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isEnabled\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"refetch\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"fetchStatus\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"fetchNextPage\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"fetchPreviousPage\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"hasNextPage\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"hasPreviousPage\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isFetchNextPageError\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isFetchingNextPage\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isFetchPreviousPageError\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"isFetchingPreviousPage\""},{"type":"text","value":")[] | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"If set, the component will only re-render if any of the listed properties change. When set to "},{"type":"inlineCode","value":"['data', 'error']"},{"type":"text","value":", the component will only re-render when the "},{"type":"inlineCode","value":"data"},{"type":"text","value":" or "},{"type":"inlineCode","value":"error"},{"type":"text","value":" properties change. When set to "},{"type":"inlineCode","value":"'all'"},{"type":"text","value":", the component will re-render whenever a query is updated. When set to a function, the function will be executed to compute the list of properties. Defaults to "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", in which case property access is tracked automatically, and the component only re-renders when one of the tracked properties changes."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-persister\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"persister?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":": ("},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"inlineCode","value":"object"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":">, "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"inlineCode","value":"object"},{"type":"text","value":", "},{"type":"inlineCode","value":"query"},{"type":"text","value":": "},{"type":"link","href":"../classes/Query.md","children":[{"type":"inlineCode","value":"Query"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This option can be used to persist the result of a query to an external storage, bypassing the need to actually call the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":". Useful for persisting a query's data across e.g. server/client boundaries."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-placeholderdata\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"placeholderData?"}]},{"type":"tableCell","children":[{"type":"text","value":"| "},{"type":"inlineCode","value":"NonFunctionGuard"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":"> | (("},{"type":"inlineCode","value":"previousData"},{"type":"text","value":": "},{"type":"inlineCode","value":"NonFunctionGuard"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":"> | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", "},{"type":"inlineCode","value":"previousQuery"},{"type":"text","value":": | "},{"type":"link","href":"../classes/Query.md","children"