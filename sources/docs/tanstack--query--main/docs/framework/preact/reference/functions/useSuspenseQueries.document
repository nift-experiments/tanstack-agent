inlineCode","value":"unknown"},{"type":"text","value":"[] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"T"},{"type":"text","value":" ? "},{"type":"inlineCode","value":"T"},{"type":"text","value":" : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../interfaces/UseSuspenseQueryOptions.md","children":[{"type":"inlineCode","value":"UseSuspenseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">[] ? "},{"type":"link","href":"../interfaces/UseSuspenseQueryOptions.md","children":[{"type":"inlineCode","value":"UseSuspenseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">[] : "},{"type":"link","href":"../interfaces/UseSuspenseQueryOptions.md","children":[{"type":"inlineCode","value":"UseSuspenseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]>[]]"}]},{"type":"paragraph","children":[{"type":"text","value":"An array with query option objects identical to "},{"type":"inlineCode","value":"useSuspenseQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"queryclient-2","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to provide a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"type":"text","value":"The same structure as "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":", except that for each "},{"type":"inlineCode","value":"query"},{"type":"text","value":", "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is guaranteed to be\ndefined, "},{"type":"inlineCode","value":"isPlaceholderData"},{"type":"text","value":" is missing, and "},{"type":"inlineCode","value":"status"},{"type":"text","value":" is either "},{"type":"inlineCode","value":"success"},{"type":"text","value":" or "},{"type":"inlineCode","value":"error"},{"type":"text","value":" (with the derived\nflags set accordingly)."}]},{"type":"paragraph","children":[{"type":"text","value":"Caveat: the component will only re-mount after all queries have finished loading. Hence, if a query has gone\nstale in the time it took for all the queries to complete, it will be fetched again at re-mount. To avoid\nthis, make sure to set a high enough "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":". Cancellation does not work."}]},{"type":"heading","depth":3,"id":"examples-2","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"The query error is thrown if a fetch fails and no cached data exists yet, so an error boundary is\nrequired around "},{"type":"inlineCode","value":"<Suspense>"},{"type":"text","value":". A failed background refetch instead continues to render the cached data.\nUse "},{"type":"link","href":"QueryErrorResetBoundary.md","children":[{"type":"text","value":"QueryErrorResetBoundary"}]},{"type":"text","value":" to let the user retry after such an error:"}]},{"type":"code","value":"import { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  // Every result is guaranteed to be defined — no per-query `isPending` check needed.\n  const postQueries = useSuspenseQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n  })\n\n  return (\n    <ul>\n      {postQueries.map((query) => (\n        <li key={query.data.id}>{query.data.title}</li>\n      ))}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading posts...</h1>}>\n            <Posts ids={[1, 2, 3]} />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Several different queries — use "},{"type":"inlineCode","value":"useSuspenseQueries"},{"type":"text","value":" instead of multiple "},{"type":"inlineCode","value":"useSuspenseQuery"},{"type":"text","value":" calls, so\nthey fetch in parallel rather than suspending one after another:"}]},{"type":"code","value":"import { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Dashboard() {\n  const [usersQuery, teamsQuery, projectsQuery] = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: fetchUsers },\n      { queryKey: ['teams'], queryFn: fetchTeams },\n      { queryKey: ['projects'], queryFn: fetchProjects },\n    ],\n  })\n\n  return (\n    <div>\n      <UserList users={usersQuery.data} />\n      <TeamList teams={teamsQuery.data} />\n      <ProjectList projects={projectsQuery.data} />\n    </div>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading dashboard...</h1>}>\n            <Dashboard />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}","lang":"tsx"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-3","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"queries"},{"type":"text","value":" array to run in Suspense, and an optional "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" function."}]},{"type":"heading","depth":4,"id":"combine-3","children":[{"type":"text","value":"combine?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"result"},{"type":"text","value":": "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseSuspenseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseSuspenseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">, "},{"type":"inlineCode","value":"GetUseSuspenseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ... "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : ["},{"type":"inlineCode","value":"...{ [K in (...)]: (...) }[]"},{"type":"text","value":"] : { [K in string | number | symbol]: GetUseSuspenseQueryResult<T[K]> }) => "},{"type":"inlineCode","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible."}]},{"type":"heading","depth":4,"id":"queries-3","children":[{"type":"text","value":"queries"}]},{"type":"paragraph","children":[{"type":"text","value":"readonly ["},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseSuspenseQueryOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseSuspenseQueryOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">, "},{"type":"inlineCode","value":"GetUseSuspenseQueryOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [...] ? [..., ..., ...] : ... "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] : ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ...[] ? ...[] : ...[] : "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"T"},{"type":"text","value":" ? "},{"type":"inlineCode","value":"T"},{"type":"text","value":" : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../interfaces/UseSuspenseQueryOptions.md","children":[{"type":"inlineCode","value":"UseSuspenseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">[] ? "},{"type":"link","href":"../interfaces/UseSuspenseQueryOptions.md","children":[{"type":"inlineCode","value":"UseSuspenseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">[] : "},{"type":"link","href":"../interfaces/UseSuspenseQueryOptions.md","children":[{"type":"inlineCode","value":"UseSuspenseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]>[]]"}]},{"type":"paragraph","children":[{"type":"text","value":"An array with query option objects identical to "},{"type":"inlineCode","value":"useSuspenseQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"queryclient-3","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to provide a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"type":"text","value":"The same structure as "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":", except that for each "},{"type":"inlineCode","value":"query"},{"type":"text","value":", "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is guaranteed to be\ndefined, "},{"type":"inlineCode","value":"isPlaceholderData"},{"type":"text","value":" is missing, and "},{"type":"inlineCode","value":"status"},{"type":"text","value":" is either "},{"type":"inlineCode","value":"success"},{"type":"text","value":" or "},{"type":"inlineCode","value":"error"},{"type":"text","value":" (with the derived\nflags set accordingly)."}]},{"type":"paragraph","children":[{"type":"text","value":"Caveat: the component will only re-mount after all queries have finished loading. Hence, if a query has gone\nstale in the time it took for all the queries to complete, it will be fetched again at re-mount. To avoid\nthis, make sure to set a high enough "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":". Cancellation does not work."}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"t","text":"T","level":4},{"id":"tcombinedresult","text":"TCombinedResult","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"combine","text":"combine?","level":5},{"id":"queries","text":"queries","level":5},{"id":"queryclient","text":"queryClient?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"t-2","text":"T","level":4},{"id":"tcombinedresult-2","text":"TCombinedResult","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"combine-2","text":"combine?","level":5},{"id":"queries-2","text":"queries","level":5},{"id":"queryclient-2","text":"queryClient?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"examples-2","text":"Examples","level":3},{"id":"parameters-3","text":"Parameters","level":2},{"id":"options-3","text":"options","level":3},{"id":"combine-3","text":"combine?","level":4},{"id":"queries-3","text":"queries","level":4},{"id":"queryclient-3","text":"queryClient?","level":3},{"id":"returns-3","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\nfunction useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\n```\n\n- [`{ queries, combine }` → `TCombinedResult`](#call-signature-1): The options for `useSuspenseQueries` are the same as for `useQueries`, except that the top-level `subscribed` option isn't supported, and each `query` can't have `throwOnError`, `enabled`, or `placeholderData`.\n- [`{ queries, combine }` → `TCombinedResult`](#call-signature-2): The options for `useSuspenseQueries` are the same as for `useQueries`, except that the top-level `subscribed` option isn't supported, and each `query` can't have `throwOnError`, `enabled`, or `placeholderData`.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\n```\n\nDefined in: [packages/preact-query/src/useSuspenseQueries.ts:407](https://github.com/TanStack/query/blob/main/packages/preact-query/src/useSuspenseQueries.ts#L407)\n\nThe options for `useSuspenseQueries` are the same as for `useQueries`, except that the top-level `subscribed`\noption isn't supported, and each `query` can't have `throwOnError`, `enabled`, or `placeholderData`.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `any`[]\n\n#### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}\n\n### Parameters\n\n#### options\n\nThe `queries` array to run in Suspense, and an optional `combine` function.\n\n##### combine?\n\n(`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`\n\nUse this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible.\n\n##### queries\n\n  \\| readonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>, `GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : ...[] *extends* \\[`...(...)[]`\\] ? \\[`...(...)[]`\\] : ... *extends* ... ? ... : ... : `unknown`[] *extends* `T` ? `T` : `T` *extends* [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] ? [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] : [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`unknown`, `Error`, `unknown`, readonly ...[]\\>[]\\]\n  \\| readonly \\[\\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryOptions\\<T\\[K\\]\\> \\}\\]\n\nAn array with query option objects identical to `useSuspenseQuery`.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to provide a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n`TCombinedResult`\n\nThe same structure as `useQueries`, except that for each `query`, `data` is guaranteed to be\ndefined, `isPlaceholderData` is missing, and `status` is either `success` or `error` (with the derived\nflags set accordingly).\n\nCaveat: the component will only re-mount after all queries have finished loading. Hence, if a query has gone\nstale in the time it took for all the queries to complete, it will be fetched again at re-mount. To avoid\nthis, make sure to set a high enough `staleTime`. Cancellation does not work.\n\n### Examples\n\nThe query error is thrown if a fetch fails and no cached data exists yet, so an error boundary is\nrequired around `<Suspense>`. A failed background refetch instead continues to render the cached data.\nUse [QueryErrorResetBoundary](QueryErrorResetBoundary.md) to let the user retry after such an error:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  // Every result is guaranteed to be defined — no per-query `isPending` check needed.\n  const postQueries = useSuspenseQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n  })\n\n  return (\n    <ul>\n      {postQueries.map((query) => (\n        <li key={query.data.id}>{query.data.title}</li>\n      ))}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading posts...</h1>}>\n            <Posts ids={[1, 2, 3]} />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\nSeveral different queries — use `useSuspenseQueries` instead of multiple `useSuspenseQuery` calls, so\nthey fetch in parallel rather than suspending one after another:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Dashboard() {\n  const [usersQuery, teamsQuery, projectsQuery] = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: fetchUsers },\n      { queryKey: ['teams'], queryFn: fetchTeams },\n      { queryKey: ['projects'], queryFn: fetchProjects },\n    ],\n  })\n\n  return (\n    <div>\n      <UserList users={usersQuery.data} />\n      <TeamList teams={teamsQuery.data} />\n      <ProjectList projects={projectsQuery.data} />\n    </div>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading dashboard...</h1>}>\n            <Dashboard />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\n`combine`s the results into a single boolean, so `Refresh` only re-renders when that boolean changes,\nnot on every individual query update. This overload is the only one that accepts `combine`:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Refresh() {\n  const anyFetching = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: fetchUsers },\n      { queryKey: ['teams'], queryFn: fetchTeams },\n    ],\n    combine: (results) => results.some((result) => result.isFetching),\n  })\n\n  return anyFetching ? <span>Refreshing…</span> : null\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading dashboard...</h1>}>\n            <Refresh />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\n```\n\nDefined in: [packages/preact-query/src/useSuspenseQueries.ts:584](https://github.com/TanStack/query/blob/main/packages/preact-query/src/useSuspenseQueries.ts#L584)\n\nThe options for `useSuspenseQueries` are the same as for `useQueries`, except that the top-level `subscribed`\noption isn't supported, and each `query` can't have `throwOnError`, `enabled`, or `placeholderData`.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `any`[]\n\n#### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}\n\n### Parameters\n\n#### options\n\nThe `queries` array to run in Suspense, and an optional `combine` function.\n\n##### combine?\n\n(`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`\n\nUse this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible.\n\n##### queries\n\nreadonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>, `GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...(...)[]`\\] *extends* \\[...\\] ? \\[..., ..., ...\\] : ... *extends* ... ? ... : ... : `unknown`[] *extends* \\[`...Tails[]`\\] ? \\[`...Tails[]`\\] : \\[`...(...)[]`\\] *extends* ...[] ? ...[] : ...[] : `unknown`[] *extends* `T` ? `T` : `T` *extends* [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] ? [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] : [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`unknown`, `Error`, `unknown`, readonly `unknown`[]\\>[]\\]\n\nAn array with query option objects identical to `useSuspenseQuery`.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to provide a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n`TCombinedResult`\n\nThe same structure as `useQueries`, except that for each `query`, `data` is guaranteed to be\ndefined, `isPlaceholderData` is missing, and `status` is either `success` or `error` (with the derived\nflags set accordingly).\n\nCaveat: the component will only re-mount after all queries have finished loading. Hence, if a query has gone\nstale in the time it took for all the queries to complete, it will be fetched again at re-mount. To avoid\nthis, make sure to set a high enough `staleTime`. Cancellation does not work.\n\n### Examples\n\nThe query error is thrown if a fetch fails and no cached data exists yet, so an error boundary is\nrequired around `<Suspense>`. A failed background refetch instead continues to render the cached data.\nUse [QueryErrorResetBoundary](QueryErrorResetBoundary.md) to let the user retry after such an error:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  // Every result is guaranteed to be defined — no per-query `isPending` check needed.\n  const postQueries = useSuspenseQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n  })\n\n  return (\n    <ul>\n      {postQueries.map((query) => (\n        <li key={query.data.id}>{query.data.title}</li>\n      ))}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading posts...</h1>}>\n            <Posts ids={[1, 2, 3]} />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\nSeveral different queries — use `useSuspenseQueries` instead of multiple `useSuspenseQuery` calls, so\nthey fetch in parallel rather than suspending one after another:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Dashboard() {\n  const [usersQuery, teamsQuery, projectsQuery] = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: fetchUsers },\n      { queryKey: ['teams'], queryFn: fetchTeams },\n      { queryKey: ['projects'], queryFn: fetchProjects },\n    ],\n  })\n\n  return (\n    <div>\n      <UserList users={usersQuery.data} />\n      <TeamList teams={teamsQuery.data} />\n      <ProjectList projects={projectsQuery.data} />\n    </div>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading dashboard...</h1>}>\n            <Dashboard />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\nThe `queries` array to run in Suspense, and an optional `combine` function.\n\n#### combine?\n\n(`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`\n\nUse this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible.\n\n#### queries\n\nreadonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>, `GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...(...)[]`\\] *extends* \\[...\\] ? \\[..., ..., ...\\] : ... *extends* ... ? ... : ... : `unknown`[] *extends* \\[`...Tails[]`\\] ? \\[`...Tails[]`\\] : \\[`...(...)[]`\\] *extends* ...[] ? ...[] : ...[] : `unknown`[] *extends* `T` ? `T` : `T` *extends* [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] ? [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] : [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`unknown`, `Error`, `unknown`, readonly `unknown`[]\\>[]\\]\n\nAn array with query option objects identical to `useSuspenseQuery`.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to provide a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n`TCombinedResult`\n\nThe same structure as `useQueries`, except that for each `query`, `data` is guaranteed to be\ndefined, `isPlaceholderData` is missing, and `status` is either `success` or `error` (with the derived\nflags set accordingly).\n\nCaveat: the component will only re-mount after all queries have finished loading. Hence, if a query has gone\nstale in the time it took for all the queries to complete, it will be fetched again at re-mount. To avoid\nthis, make sure to set a high enough `staleTime`. Cancellation does not work.\n","originalRawMarkdown":"---\nid: useSuspenseQueries\ntitle: useSuspenseQueries\n---\n\n## Overview\n\n```ts\nfunction useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\nfunction useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\n```\n\n- [`{ queries, combine }` → `TCombinedResult`](#call-signature-1): The options for `useSuspenseQueries` are the same as for `useQueries`, except that the top-level `subscribed` option isn't supported, and each `query` can't have `throwOnError`, `enabled`, or `placeholderData`.\n- [`{ queries, combine }` → `TCombinedResult`](#call-signature-2): The options for `useSuspenseQueries` are the same as for `useQueries`, except that the top-level `subscribed` option isn't supported, and each `query` can't have `throwOnError`, `enabled`, or `placeholderData`.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\n```\n\nDefined in: [packages/preact-query/src/useSuspenseQueries.ts:407](https://github.com/TanStack/query/blob/main/packages/preact-query/src/useSuspenseQueries.ts#L407)\n\nThe options for `useSuspenseQueries` are the same as for `useQueries`, except that the top-level `subscribed`\noption isn't supported, and each `query` can't have `throwOnError`, `enabled`, or `placeholderData`.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `any`[]\n\n#### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}\n\n### Parameters\n\n#### options\n\nThe `queries` array to run in Suspense, and an optional `combine` function.\n\n##### combine?\n\n(`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`\n\nUse this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible.\n\n##### queries\n\n  \\| readonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>, `GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : ...[] *extends* \\[`...(...)[]`\\] ? \\[`...(...)[]`\\] : ... *extends* ... ? ... : ... : `unknown`[] *extends* `T` ? `T` : `T` *extends* [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] ? [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] : [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`unknown`, `Error`, `unknown`, readonly ...[]\\>[]\\]\n  \\| readonly \\[\\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryOptions\\<T\\[K\\]\\> \\}\\]\n\nAn array with query option objects identical to `useSuspenseQuery`.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to provide a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n`TCombinedResult`\n\nThe same structure as `useQueries`, except that for each `query`, `data` is guaranteed to be\ndefined, `isPlaceholderData` is missing, and `status` is either `success` or `error` (with the derived\nflags set accordingly).\n\nCaveat: the component will only re-mount after all queries have finished loading. Hence, if a query has gone\nstale in the time it took for all the queries to complete, it will be fetched again at re-mount. To avoid\nthis, make sure to set a high enough `staleTime`. Cancellation does not work.\n\n### Examples\n\nThe query error is thrown if a fetch fails and no cached data exists yet, so an error boundary is\nrequired around `<Suspense>`. A failed background refetch instead continues to render the cached data.\nUse [QueryErrorResetBoundary](QueryErrorResetBoundary.md) to let the user retry after such an error:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  // Every result is guaranteed to be defined — no per-query `isPending` check needed.\n  const postQueries = useSuspenseQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n  })\n\n  return (\n    <ul>\n      {postQueries.map((query) => (\n        <li key={query.data.id}>{query.data.title}</li>\n      ))}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading posts...</h1>}>\n            <Posts ids={[1, 2, 3]} />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\nSeveral different queries — use `useSuspenseQueries` instead of multiple `useSuspenseQuery` calls, so\nthey fetch in parallel rather than suspending one after another:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Dashboard() {\n  const [usersQuery, teamsQuery, projectsQuery] = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: fetchUsers },\n      { queryKey: ['teams'], queryFn: fetchTeams },\n      { queryKey: ['projects'], queryFn: fetchProjects },\n    ],\n  })\n\n  return (\n    <div>\n      <UserList users={usersQuery.data} />\n      <TeamList teams={teamsQuery.data} />\n      <ProjectList projects={projectsQuery.data} />\n    </div>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading dashboard...</h1>}>\n            <Dashboard />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\n`combine`s the results into a single boolean, so `Refresh` only re-renders when that boolean changes,\nnot on every individual query update. This overload is the only one that accepts `combine`:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Refresh() {\n  const anyFetching = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: fetchUsers },\n      { queryKey: ['teams'], queryFn: fetchTeams },\n    ],\n    combine: (results) => results.some((result) => result.isFetching),\n  })\n\n  return anyFetching ? <span>Refreshing…</span> : null\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading dashboard...</h1>}>\n            <Refresh />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\n```\n\nDefined in: [packages/preact-query/src/useSuspenseQueries.ts:584](https://github.com/TanStack/query/blob/main/packages/preact-query/src/useSuspenseQueries.ts#L584)\n\nThe options for `useSuspenseQueries` are the same as for `useQueries`, except that the top-level `subscribed`\noption isn't supported, and each `query` can't have `throwOnError`, `enabled`, or `placeholderData`.\n\n### Type Parameters\n\n#### T\n\n`T` *extends* `any`[]\n\n#### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}\n\n### Parameters\n\n#### options\n\nThe `queries` array to run in Suspense, and an optional `combine` function.\n\n##### combine?\n\n(`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`\n\nUse this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible.\n\n##### queries\n\nreadonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>, `GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...(...)[]`\\] *extends* \\[...\\] ? \\[..., ..., ...\\] : ... *extends* ... ? ... : ... : `unknown`[] *extends* \\[`...Tails[]`\\] ? \\[`...Tails[]`\\] : \\[`...(...)[]`\\] *extends* ...[] ? ...[] : ...[] : `unknown`[] *extends* `T` ? `T` : `T` *extends* [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] ? [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] : [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`unknown`, `Error`, `unknown`, readonly `unknown`[]\\>[]\\]\n\nAn array with query option objects identical to `useSuspenseQuery`.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to provide a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n`TCombinedResult`\n\nThe same structure as `useQueries`, except that for each `query`, `data` is guaranteed to be\ndefined, `isPlaceholderData` is missing, and `status` is either `success` or `error` (with the derived\nflags set accordingly).\n\nCaveat: the component will only re-mount after all queries have finished loading. Hence, if a query has gone\nstale in the time it took for all the queries to complete, it will be fetched again at re-mount. To avoid\nthis, make sure to set a high enough `staleTime`. Cancellation does not work.\n\n### Examples\n\nThe query error is thrown if a fetch fails and no cached data exists yet, so an error boundary is\nrequired around `<Suspense>`. A failed background refetch instead continues to render the cached data.\nUse [QueryErrorResetBoundary](QueryErrorResetBoundary.md) to let the user retry after such an error:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  // Every result is guaranteed to be defined — no per-query `isPending` check needed.\n  const postQueries = useSuspenseQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n  })\n\n  return (\n    <ul>\n      {postQueries.map((query) => (\n        <li key={query.data.id}>{query.data.title}</li>\n      ))}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading posts...</h1>}>\n            <Posts ids={[1, 2, 3]} />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\nSeveral different queries — use `useSuspenseQueries` instead of multiple `useSuspenseQuery` calls, so\nthey fetch in parallel rather than suspending one after another:\n```tsx\nimport { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Dashboard() {\n  const [usersQuery, teamsQuery, projectsQuery] = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: fetchUsers },\n      { queryKey: ['teams'], queryFn: fetchTeams },\n      { queryKey: ['projects'], queryFn: fetchProjects },\n    ],\n  })\n\n  return (\n    <div>\n      <UserList users={usersQuery.data} />\n      <TeamList teams={teamsQuery.data} />\n      <ProjectList projects={projectsQuery.data} />\n    </div>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading dashboard...</h1>}>\n            <Dashboard />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\nThe `queries` array to run in Suspense, and an optional `combine` function.\n\n#### combine?\n\n(`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryResult`\\<`Head`\\>, `GetUseSuspenseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseSuspenseQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`\n\nUse this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible.\n\n#### queries\n\nreadonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseSuspenseQueryOptions`\\<`Head`\\>, `GetUseSuspenseQueryOptions`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...(...)[]`\\] *extends* \\[...\\] ? \\[..., ..., ...\\] : ... *extends* ... ? ... : ... : `unknown`[] *extends* \\[`...Tails[]`\\] ? \\[`...Tails[]`\\] : \\[`...(...)[]`\\] *extends* ...[] ? ...[] : ...[] : `unknown`[] *extends* `T` ? `T` : `T` *extends* [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] ? [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] : [`UseSuspenseQueryOptions`](../interfaces/UseSuspenseQueryOptions.md)\\<`unknown`, `Error`, `unknown`, readonly `unknown`[]\\>[]\\]\n\nAn array with query option objects identical to `useSuspenseQuery`.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to provide a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n`TCombinedResult`\n\nThe same structure as `useQueries`, except that for each `query`, `data` is guaranteed to be\ndefined, `isPlaceholderData` is missing, and `status` is either `success` or `error` (with the derived\nflags set accordingly).\n\nCaveat: the component will only re-mount after all queries have finished loading. Hence, if a query has gone\nstale in the time it took for all the queries to complete, it will be fetched again at re-mount. To avoid\nthis, make sure to set a high enough `staleTime`. Cancellation does not work.\n"}
