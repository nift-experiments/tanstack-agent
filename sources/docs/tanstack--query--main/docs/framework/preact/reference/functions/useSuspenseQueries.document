e":" ... ? ... : ... : "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"T"},{"type":"text","value":" ? "},{"type":"inlineCode","value":"T"},{"type":"text","value":" : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../interfaces/UseSuspenseQueryOptions.md","children":[{"type":"inlineCode","value":"UseSuspenseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">[] ? "},{"type":"link","href":"../interfaces/UseSuspenseQueryOptions.md","children":[{"type":"inlineCode","value":"UseSuspenseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">[] : "},{"type":"link","href":"../interfaces/UseSuspenseQueryOptions.md","children":[{"type":"inlineCode","value":"UseSuspenseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", readonly ...[]>[]]\n| readonly [{ [K in string | number | symbol]: GetUseSuspenseQueryOptions<T[K]> }]"}]},{"type":"paragraph","children":[{"type":"text","value":"An array with query option objects identical to "},{"type":"inlineCode","value":"useSuspenseQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to provide a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"type":"text","value":"The same structure as "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":", except that for each "},{"type":"inlineCode","value":"query"},{"type":"text","value":", "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is guaranteed to be\ndefined, "},{"type":"inlineCode","value":"isPlaceholderData"},{"type":"text","value":" is missing, and "},{"type":"inlineCode","value":"status"},{"type":"text","value":" is either "},{"type":"inlineCode","value":"success"},{"type":"text","value":" or "},{"type":"inlineCode","value":"error"},{"type":"text","value":" (with the derived\nflags set accordingly)."}]},{"type":"paragraph","children":[{"type":"text","value":"Caveat: the component will only re-mount after all queries have finished loading. Hence, if a query has gone\nstale in the time it took for all the queries to complete, it will be fetched again at re-mount. To avoid\nthis, make sure to set a high enough "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":". Cancellation does not work."}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"The query error is thrown if a fetch fails and no cached data exists yet, so an error boundary is\nrequired around "},{"type":"inlineCode","value":"<Suspense>"},{"type":"text","value":". A failed background refetch instead continues to render the cached data.\nUse "},{"type":"link","href":"QueryErrorResetBoundary.md","children":[{"type":"text","value":"QueryErrorResetBoundary"}]},{"type":"text","value":" to let the user retry after such an error:"}]},{"type":"code","value":"import { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  // Every result is guaranteed to be defined — no per-query `isPending` check needed.\n  const postQueries = useSuspenseQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n  })\n\n  return (\n    <ul>\n      {postQueries.map((query) => (\n        <li key={query.data.id}>{query.data.title}</li>\n      ))}\n    </ul>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading posts...</h1>}>\n            <Posts ids={[1, 2, 3]} />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Several different queries — use "},{"type":"inlineCode","value":"useSuspenseQueries"},{"type":"text","value":" instead of multiple "},{"type":"inlineCode","value":"useSuspenseQuery"},{"type":"text","value":" calls, so\nthey fetch in parallel rather than suspending one after another:"}]},{"type":"code","value":"import { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Dashboard() {\n  const [usersQuery, teamsQuery, projectsQuery] = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: fetchUsers },\n      { queryKey: ['teams'], queryFn: fetchTeams },\n      { queryKey: ['projects'], queryFn: fetchProjects },\n    ],\n  })\n\n  return (\n    <div>\n      <UserList users={usersQuery.data} />\n      <TeamList teams={teamsQuery.data} />\n      <ProjectList projects={projectsQuery.data} />\n    </div>\n  )\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading dashboard...</h1>}>\n            <Dashboard />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"combine"},{"type":"text","value":"s the results into a single boolean, so "},{"type":"inlineCode","value":"Refresh"},{"type":"text","value":" only re-renders when that boolean changes,\nnot on every individual query update. This overload is the only one that accepts "},{"type":"inlineCode","value":"combine"},{"type":"text","value":":"}]},{"type":"code","value":"import { Suspense } from 'preact/compat'\nimport { useErrorBoundary } from 'preact/hooks'\nimport {\n  QueryErrorResetBoundary,\n  useSuspenseQueries,\n} from '@tanstack/preact-query'\nimport type { ComponentChildren } from 'preact'\n\nfunction Refresh() {\n  const anyFetching = useSuspenseQueries({\n    queries: [\n      { queryKey: ['users'], queryFn: fetchUsers },\n      { queryKey: ['teams'], queryFn: fetchTeams },\n    ],\n    combine: (results) => results.some((result) => result.isFetching),\n  })\n\n  return anyFetching ? <span>Refreshing…</span> : null\n}\n\nfunction App() {\n  return (\n    <QueryErrorResetBoundary>\n      {({ reset }) => (\n        <ErrorBoundary\n          onReset={reset}\n          fallbackRender={({ resetErrorBoundary }) => (\n            <div>\n              There was an error!\n              <button onClick={() => resetErrorBoundary()}>Try again</button>\n            </div>\n          )}\n        >\n          <Suspense fallback={<h1>Loading dashboard...</h1>}>\n            <Refresh />\n          </Suspense>\n        </ErrorBoundary>\n      )}\n    </QueryErrorResetBoundary>\n  )\n}\n\nfunction ErrorBoundary({\n  children,\n  onReset,\n  fallbackRender,\n}: {\n  children: ComponentChildren\n  onReset: () => void\n  fallbackRender: (props: {\n    error: Error\n    resetErrorBoundary: () => void\n  }) => ComponentChildren\n}) {\n  const [error, resetErrorBoundary] = useErrorBoundary(() => onReset())\n\n  if (error) return fallbackRender({ error, resetErrorBoundary })\n\n  return children\n}","lang":"tsx"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useSuspenseQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/preact-query/src/useSuspenseQueries.ts#L584","children":[{"type":"text","value":"packages/preact-query/src/useSuspenseQueries.ts:584"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"useSuspenseQueries"},{"type":"text","value":" are the same as for "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":", except that the top-level "},{"type":"inlineCode","value":"subscribed"},{"type":"text","value":"\noption isn't supported, and each "},{"type":"inlineCode","value":"query"},{"type":"text","value":" can't have "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":", "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":", or "},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"t-2","children":[{"type":"text","value":"T"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"any"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"tcombinedresult-2","children":[{"type":"text","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"