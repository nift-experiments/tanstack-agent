inlineHtml","value":"<a id=\"property-querykey\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"queryKey?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" | "},{"type":"inlineCode","value":"TuplePrefixes"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Include queries matching this query key"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-refetchtype\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"refetchType?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"QueryTypeFilter"},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"none\""}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'active'"}]},{"type":"tableCell","children":[{"type":"text","value":"Controls which of the matched (now-invalidated) queries are refetched in the background. - "},{"type":"inlineCode","value":"'active'"},{"type":"text","value":": only queries with at least one active observer are refetched. - "},{"type":"inlineCode","value":"'inactive'"},{"type":"text","value":": only queries with no active observer are refetched. - "},{"type":"inlineCode","value":"'all'"},{"type":"text","value":": every matched query is refetched, active or not. - "},{"type":"inlineCode","value":"'none'"},{"type":"text","value":": no query is refetched; matched queries are only marked as invalidated."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-stale\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"stale?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Include or exclude stale queries"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-type\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"type?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"QueryTypeFilter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'all'"}]},{"type":"tableCell","children":[{"type":"text","value":"Filter to active queries, inactive queries or all queries"}]}]]}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tquerykey","text":"TQueryKey","level":3},{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/types.ts:889](https://github.com/TanStack/query/blob/main/packages/query-core/src/types.ts#L889)\n\nThe filters of `queryClient.invalidateQueries`: the [QueryFilters](QueryFilters.md) that select the queries\nto invalidate, plus `refetchType` to choose which of them are refetched.\n\n## Extends\n\n- [`QueryFilters`](QueryFilters.md)\\<`TQueryKey`\\>\n\n## Type Parameters\n\n### TQueryKey\n\n`TQueryKey` *extends* [`QueryKey`](../type-aliases/QueryKey.md) = [`QueryKey`](../type-aliases/QueryKey.md)\n\n## Properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"property-exact\"></a> `exact?` | `boolean` | `undefined` | Match query key exactly |\n| <a id=\"property-fetchstatus\"></a> `fetchStatus?` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | `undefined` | Include queries matching their fetchStatus |\n| <a id=\"property-predicate\"></a> `predicate?` | (`query`: [`Query`](../classes/Query.md)) => `boolean` | `undefined` | Include queries matching this predicate function |\n| <a id=\"property-querykey\"></a> `queryKey?` | `TQueryKey` \\| `TuplePrefixes`\\<`TQueryKey`\\> | `undefined` | Include queries matching this query key |\n| <a id=\"property-refetchtype\"></a> `refetchType?` | `QueryTypeFilter` \\| `\"none\"` | `'active'` | Controls which of the matched (now-invalidated) queries are refetched in the background. - `'active'`: only queries with at least one active observer are refetched. - `'inactive'`: only queries with no active observer are refetched. - `'all'`: every matched query is refetched, active or not. - `'none'`: no query is refetched; matched queries are only marked as invalidated. |\n| <a id=\"property-stale\"></a> `stale?` | `boolean` | `undefined` | Include or exclude stale queries |\n| <a id=\"property-type\"></a> `type?` | `QueryTypeFilter` | `'all'` | Filter to active queries, inactive queries or all queries |\n","originalRawMarkdown":"---\nid: InvalidateQueryFilters\ntitle: InvalidateQueryFilters\n---\n\nDefined in: [packages/query-core/src/types.ts:889](https://github.com/TanStack/query/blob/main/packages/query-core/src/types.ts#L889)\n\nThe filters of `queryClient.invalidateQueries`: the [QueryFilters](QueryFilters.md) that select the queries\nto invalidate, plus `refetchType` to choose which of them are refetched.\n\n## Extends\n\n- [`QueryFilters`](QueryFilters.md)\\<`TQueryKey`\\>\n\n## Type Parameters\n\n### TQueryKey\n\n`TQueryKey` *extends* [`QueryKey`](../type-aliases/QueryKey.md) = [`QueryKey`](../type-aliases/QueryKey.md)\n\n## Properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"property-exact\"></a> `exact?` | `boolean` | `undefined` | Match query key exactly |\n| <a id=\"property-fetchstatus\"></a> `fetchStatus?` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | `undefined` | Include queries matching their fetchStatus |\n| <a id=\"property-predicate\"></a> `predicate?` | (`query`: [`Query`](../classes/Query.md)) => `boolean` | `undefined` | Include queries matching this predicate function |\n| <a id=\"property-querykey\"></a> `queryKey?` | `TQueryKey` \\| `TuplePrefixes`\\<`TQueryKey`\\> | `undefined` | Include queries matching this query key |\n| <a id=\"property-refetchtype\"></a> `refetchType?` | `QueryTypeFilter` \\| `\"none\"` | `'active'` | Controls which of the matched (now-invalidated) queries are refetched in the background. - `'active'`: only queries with at least one active observer are refetched. - `'inactive'`: only queries with no active observer are refetched. - `'all'`: every matched query is refetched, active or not. - `'none'`: no query is refetched; matched queries are only marked as invalidated. |\n| <a id=\"property-stale\"></a> `stale?` | `boolean` | `undefined` | Include or exclude stale queries |\n| <a id=\"property-type\"></a> `type?` | `QueryTypeFilter` | `'all'` | Filter to active queries, inactive queries or all queries |\n"}
