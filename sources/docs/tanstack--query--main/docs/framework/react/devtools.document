id: devtools
title: Devtools
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Wave your hands in the air and shout hooray because React Query comes with dedicated devtools! 🥳"}]},{"type":"paragraph","children":[{"type":"text","value":"When you begin your React Query journey, you'll want these devtools by your side. They help visualize all the inner workings of React Query and will likely save you hours of debugging if you find yourself in a pinch!"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"For Chrome, Firefox, and Edge users: Third-party browser extensions are available for debugging TanStack Query directly in browser DevTools. These provide the same functionality as the framework-specific devtools packages:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"html","value":"<img alt=\"Chrome logo\" src=\"https://www.google.com/chrome/static/images/chrome-logo.svg\" width=\"16\" height=\"16\" class=\"inline mr-1 not-prose\" /> <a href=\"https://chromewebstore.google.com/detail/tanstack-query-devtools/annajfchloimdhceglpgglpeepfghfai\">Devtools for Chrome</a>"}]},{"type":"listItem","children":[{"type":"html","value":"<img alt=\"Firefox logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/a/a0/Firefox_logo%2C_2019.svg\" width=\"16\" height=\"16\" class=\"inline mr-1 not-prose\" /> <a href=\"https://addons.mozilla.org/en-US/firefox/addon/tanstack-query-devtools/\">Devtools for Firefox</a>"}]},{"type":"listItem","children":[{"type":"html","value":"<img alt=\"Edge logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/9/98/Microsoft_Edge_logo_%282019%29.svg\" width=\"16\" height=\"16\" class=\"inline mr-1 not-prose\" /> <a href=\"https://microsoftedge.microsoft.com/addons/detail/tanstack-query-devtools/edmdpkgkacmjopodhfolmphdenmddobj\">Devtools for Edge</a>"}]}]},{"type":"paragraph","children":[{"type":"text","value":"For React Native users: A third-party native macOS app is available for debugging React Query in ANY js-based application. Monitor queries across devices in real-time. Check it out here: "},{"type":"link","href":"https://github.com/LovesWorking/rn-better-dev-tools","children":[{"type":"text","value":"rn-better-dev-tools"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Note that since version 5, the dev tools support observing mutations as well."}]}]},{"type":"heading","depth":2,"id":"install-and-import-the-devtools","children":[{"type":"text","value":"Install and Import the Devtools"}]},{"type":"paragraph","children":[{"type":"text","value":"The devtools are a separate package that you need to install:"}]},{"type":"code","value":"npm i @tanstack/react-query-devtools","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"or"}]},{"type":"code","value":"pnpm add @tanstack/react-query-devtools","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"or"}]},{"type":"code","value":"yarn add @tanstack/react-query-devtools","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"or"}]},{"type":"code","value":"bun add @tanstack/react-query-devtools","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"For Next 13+ App Dir you must install it as a dev dependency for it to work."}]},{"type":"paragraph","children":[{"type":"text","value":"You can import the devtools like this:"}]},{"type":"code","value":"import { ReactQueryDevtools } from '@tanstack/react-query-devtools'","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"By default, React Query Devtools are only included in bundles when "},{"type":"inlineCode","value":"process.env.NODE_ENV === 'development'"},{"type":"text","value":", so you don't need to worry about excluding them during a production build."}]},{"type":"heading","depth":2,"id":"floating-mode","children":[{"type":"text","value":"Floating Mode"}]},{"type":"paragraph","children":[{"type":"text","value":"Floating Mode will mount the devtools as a fixed, floating element in your app and provide a toggle in the corner of the screen to show and hide the devtools. This toggle state will be stored and remembered in localStorage across reloads."}]},{"type":"paragraph","children":[{"type":"text","value":"Place the following code as high in your React app as you can. The closer it is to the root of the page, the better it will work!"}]},{"type":"code","value":"import { ReactQueryDevtools } from '@tanstack/react-query-devtools'\n\nfunction App() {\n  return (\n    <QueryClientProvider client={queryClient}>\n      {/* The rest of your application */}\n      <ReactQueryDevtools initialIsOpen={false} />\n    </QueryClientProvider>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"initialIsOpen: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if you want the dev tools to default to being open"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"buttonPosition?: \"top-left\" | \"top-right\" | \"bottom-left\" | \"bottom-right\" | \"relative\""}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"bottom-right"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The position of the TanStack logo to open and close the devtools panel"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"relative"},{"type":"text","value":", the button is placed in the location that you render the devtools."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"position?: \"top\" | \"bottom\" | \"left\" | \"right\""}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"bottom"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The position of the React Query devtools panel"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"client?: QueryClient"},{"type":"text","value":","}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom QueryClient. Otherwise, the one from the nearest context will be used."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"errorTypes?: { name: string; initializer: (query: Query) => TError}[]"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to predefine some errors that can be triggered on your queries. Initializer will be called (with the specific query) when that error is toggled on from the UI. It must return an Error."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"styleNonce?: string"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to pass a nonce to the style tag that is added to the document head. This is useful if you are using a Content Security Policy (CSP) nonce to allow inline styles."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"shadowDOMTarget?: ShadowRoot"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Default behavior will apply the devtool's styles to the head tag within the DOM."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to pass a shadow DOM target to the devtools so that the styles will be applied within the shadow DOM instead of within the head tag in the light DOM."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"theme?: \"light\" | \"dark\" | \"system\""}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"system"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this to change the theme of the devtools panel."}]}]}]}]}]},{"type":"heading","depth":2,"id":"embedded-mode","children":[{"type":"text","value":"Embedded Mode"}]},{"type":"paragraph","children":[{"type":"text","value":"Embedded mode will show the development tools as a fixed element in your application, so you can use our panel in your own development tools."}]},{"type":"paragraph","children":[{"type":"text","value":"Place the following code as high in your React app as you can. The closer it is to the root of the page, the better it will work!"}]},{"type":"code","value":"import { ReactQueryDevtoolsPanel } from '@tanstack/react-query-devtools'\n\nfunction App() {\n  const [isOpen, setIsOpen] = React.useState(false)\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      {/* The rest of your application */}\n      <button\n        onClick={() => setIsOpen(!isOpen)}\n      >{`${isOpen ? 'Close' : 'Open'} the devtools panel`}</button>\n      {isOpen && <ReactQueryDevtoolsPanel onClose={() => setIsOpen(false)} />}\n    </QueryClientProvider>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"options-2","children":[{"type":"text","value":"Options"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"style?: React.CSSProperties"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Custom styles for the devtools panel"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Default: "},{"type":"inlineCode","value":"{ height: '500px' }"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Example: "},{"type":"inlineCode","value":"{ height: '100%' }"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Example: "},{"type":"inlineCode","value":"{ height: '100%', width: '100%' }"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onClose?: () => void"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Callback function that is called when the devtools panel is closed"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"client?: QueryClient"},{"type":"text","value":","}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom QueryClient. Otherwise, the one from the nearest context will be used."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"errorTypes?: { name: string; initializer: (query: Query) => TError}[]"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to predefine some errors that can be triggered on your queries. Initializer will be called (with the specific query) when that error is toggled on from the UI. It must return an Error."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"styleNonce?: string"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to pass a nonce to the style tag that is added to the document head. This is useful if you are using a Content Security Policy (CSP) nonce to allow inline styles."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"shadowDOMTarget?: ShadowRoot"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Default behavior will apply the devtool's styles to the head tag within the DOM."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to pass a shadow DOM target to the devtools so that the styles will be applied within the shadow DOM instead of within the head tag in the light DOM."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"theme?: \"light\" | \"dark\" | \"system\""}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"system"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this to change the theme of the devtools panel."}]}]}]}]}]},{"type":"heading","depth":2,"id":"devtools-in-production","children":[{"type":"text","value":"Devtools in production"}]},{"type":"paragraph","children":[{"type":"text","value":"Devtools are excluded in production builds. However, it might be desirable to lazy load the devtools in production:"}]},{"type":"code","value":"import * as React from 'react'\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query'\nimport { ReactQueryDevtools } from '@tanstack/react-query-devtools'\nimport { Example } from './Example'\n\nconst queryClient = new QueryClient()\n\nconst ReactQueryDevtoolsProduction = React.lazy(() =>\n  import('@tanstack/react-query-devtools/build/modern/production.js').then(\n    (d) => ({\n      default: d.ReactQueryDevtools,\n    }),\n  ),\n)\n\nfunction App() {\n  const [showDevtools, setShowDevtools] = React.useState(false)\n\n  React.useEffect(() => {\n    // @ts-expect-error\n    window.toggleDevtools = () => setShowDevtools((old) => !old)\n  }, [])\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      <Example />\n      <ReactQueryDevtools initialIsOpen />\n      {showDevtools && (\n        <React.Suspense fallback={null}>\n          <ReactQueryDevtoolsProduction />\n        </React.Suspense>\n      )}\n    </QueryClientProvider>\n  )\n}\n\nexport default App","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"With this, calling "},{"type":"inlineCode","value":"window.toggleDevtools()"},{"type":"text","value":" will download the devtools bundle and show them."}]},{"type":"heading","depth":3,"id":"modern-bundlers","children":[{"type":"text","value":"Modern bundlers"}]},{"type":"paragraph","children":[{"type":"text","value":"If your bundler supports package exports, you can use the following import path:"}]},{"type":"code","value":"const ReactQueryDevtoolsProduction = React.lazy(() =>\n  import('@tanstack/react-query-devtools/production').then((d) => ({\n    default: d.ReactQueryDevtools,\n  })),\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"For TypeScript, you would need to set "},{"type":"inlineCode","value":"moduleResolution: 'nodenext'"},{"type":"text","value":" in your tsconfig, which requires at least TypeScript v4.7."}]}],"headings":[{"id":"install-and-import-the-devtools","text":"Install and Import the Devtools","level":2},{"id":"floating-mode","text":"Floating Mode","level":2},{"id":"options","text":"Options","level":3},{"id":"embedded-mode","text":"Embedded Mode","level":2},{"id":"options-2","text":"Options","level":3},{"id":"devtools-in-production","text":"Devtools in production","level":2},{"id":"modern-bundlers","text":"Modern bundlers","level":3}]},"frameworks":[],"downloadMarkdown":"\nWave your hands in the air and shout hooray because React Query comes with dedicated devtools! 🥳\n\nWhen you begin your React Query journey, you'll want these devtools by your side. They help visualize all the inner workings of React Query and will likely save you hours of debugging if you find yourself in a pinch!\n\n> For Chrome, Firefox, and Edge users: Third-party browser extensions are available for debugging TanStack Query directly in browser DevTools. These provide the same functionality as the framework-specific devtools packages:\n>\n> - <img alt=\"Chrome logo\" src=\"https://www.google.com/chrome/static/images/chrome-logo.svg\" width=\"16\" height=\"16\" class=\"inline mr-1 not-prose\" /> <a href=\"https://chromewebstore.google.com/detail/tanstack-query-devtools/annajfchloimdhceglpgglpeepfghfai\">Devtools for Chrome</a>\n> - <img alt=\"Firefox logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/a/a0/Firefox_logo%2C_2019.svg\" width=\"16\" height=\"16\" class=\"inline mr-1 not-prose\" /> <a href=\"https://addons.mozilla.org/en-US/firefox/addon/tanstack-query-devtools/\">Devtools for Firefox</a>\n> - <img alt=\"Edge logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/9/98/Microsoft_Edge_logo_%282019%29.svg\" width=\"16\" height=\"16\" class=\"inline mr-1 not-prose\" /> <a href=\"https://microsoftedge.microsoft.com/addons/detail/tanstack-query-devtools/edmdpkgkacmjopodhfolmphdenmddobj\">Devtools for Edge</a>\n\n> For React Native users: A third-party native macOS app is available for debugging React Query in ANY js-based application. Monitor queries across devices in real-time. Check it out here: [rn-better-dev-tools](https://github.com/LovesWorking/rn-better-dev-tools)\n\n> Note that since version 5, the dev tools support observing mutations as well.\n\n## Install and Import the Devtools\n\nThe devtools are a separate package that you need to install:\n\n```bash\nnpm i @tanstack/react-query-devtools\n```\n\nor\n\n```bash\npnpm add @tanstack/react-query-devtools\n```\n\nor\n\n```bash\nyarn add @tanstack/react-query-devtools\n```\n\nor\n\n```bash\nbun add @tanstack/react-query-devtools\n```\n\nFor Next 13+ App Dir you must install it as a dev dependency for it to work.\n\nYou can import the devtools like this:\n\n```tsx\nimport { ReactQueryDevtools } from '@tanstack/react-query-devtools'\n```\n\nBy default, React Query Devtools are only included in bundles when `process.env.NODE_ENV === 'development'`, so you don't need to worry about excluding them during a production build.\n\n## Floating Mode\n\nFloating Mode will mount the devtools as a fixed, floating element in your app and provide a toggle in the corner of the screen to show and hide the devtools. This toggle state will be stored and remembered in localStorage across reloads.\n\nPlace the following code as high in your React app as you can. The closer it is to the root of the page, the better it will work!\n\n```tsx\nimport { ReactQueryDevtools } from '@tanstack/react-query-devtools'\n\nfunction App() {\n  return (\n    <QueryClientProvider client={queryClient}>\n      {/* The rest of your application */}\n      <ReactQueryDevtools initialIsOpen={false} />\n    </QueryClientProvider>\n  )\n}\n```\n\n### Options\n\n- `initialIsOpen: boolean`\n  - Set this `true` if you want the dev tools to default to being open\n- `buttonPosition?: \"top-left\" | \"top-right\" | \"bottom-left\" | \"bottom-right\" | \"relative\"`\n  - Defaults to `bottom-right`\n  - The position of the TanStack logo to open and close the devtools panel\n  - If `relative`, the button is placed in the location that you render the devtools.\n- `position?: \"top\" | \"bottom\" | \"left\" | \"right\"`\n  - Defaults to `bottom`\n  - The position of the React Query devtools panel\n- `client?: QueryClient`,\n  - Use this to use a custom QueryClient. Otherwise, the one from the nearest context will be used.\n- `errorTypes?: { name: string; initializer: (query: Query) => TError}[]`\n  - Use this to predefine some errors that can be triggered on your queries. Initializer will be called (with the specific query) when that error is toggled on from the UI. It must return an Error.\n- `styleNonce?: string`\n  - Use this to pass a nonce to the style tag that is added to the document head. This is useful if you are using a Content Security Policy (CSP) nonce to allow inline styles.\n- `shadowDOMTarget?: ShadowRoot`\n  - Default behavior will apply the devtool's styles to the head tag within the DOM.\n  - Use this to pass a shadow DOM target to the devtools so that the styles will be applied within the shadow DOM instead of within the head tag in the light DOM.\n- `theme?: \"light\" | \"dark\" | \"system\"`\n  - Defaults to `system`.\n  - Set this to change the theme of the devtools panel.\n\n## Embedded Mode\n\nEmbedded mode will show the development tools as a fixed element in your application, so you can use our panel in your own development tools.\n\nPlace the following code as high in your React app as you can. The closer it is to the root of the page, the better it will work!\n\n```tsx\nimport { ReactQueryDevtoolsPanel } from '@tanstack/react-query-devtools'\n\nfunction App() {\n  const [isOpen, setIsOpen] = React.useState(false)\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      {/* The rest of your application */}\n      <button\n        onClick={() => setIsOpen(!isOpen)}\n      >{`${isOpen ? 'Close' : 'Open'} the devtools panel`}</button>\n      {isOpen && <ReactQueryDevtoolsPanel onClose={() => setIsOpen(false)} />}\n    </QueryClientProvider>\n  )\n}\n```\n\n### Options\n\n- `style?: React.CSSProperties`\n  - Custom styles for the devtools panel\n  - Default: `{ height: '500px' }`\n  - Example: `{ height: '100%' }`\n  - Example: `{ height: '100%', width: '100%' }`\n- `onClose?: () => void`\n  - Callback function that is called when the devtools panel is closed\n- `client?: QueryClient`,\n  - Use this to use a custom QueryClient. Otherwise, the one from the nearest context will be used.\n- `errorTypes?: { name: string; initializer: (query: Query) => TError}[]`\n  - Use this to predefine some errors that can be triggered on your queries. Initializer will be called (with the specific query) when that error is toggled on from the UI. It must return an Error.\n- `styleNonce?: string`\n  - Use this to pass a nonce to the style tag that is added to the document head. This is useful if you are using a Content Security Policy (CSP) nonce to allow inline styles.\n- `shadowDOMTarget?: ShadowRoot`\n  - Default behavior will apply the devtool's styles to the head tag within the DOM.\n  - Use this to pass a shadow DOM target to the devtools so that the styles will be applied within the shadow DOM instead of within the head tag in the light DOM.\n- `theme?: \"light\" | \"dark\" | \"system\"`\n  - Defaults to `system`.\n  - Set this to change the theme of the devtools panel.\n\n## Devtools in production\n\nDevtools are excluded in production builds. However, it might be desirable to lazy load the devtools in production:\n\n```tsx\nimport * as React from 'react'\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query'\nimport { ReactQueryDevtools } from '@tanstack/react-query-devtools'\nimport { Example } from './Example'\n\nconst queryClient = new QueryClient()\n\nconst ReactQueryDevtoolsProduction = React.lazy(() =>\n  import('@tanstack/react-query-devtools/build/modern/production.js').then(\n    (d) => ({\n      default: d.ReactQueryDevtools,\n    }),\n  ),\n)\n\nfunction App() {\n  const [showDevtools, setShowDevtools] = React.useState(false)\n\n  React.useEffect(() => {\n    // @ts-expect-error\n    window.toggleDevtools = () => setShowDevtools((old) => !old)\n  }, [])\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      <Example />\n      <ReactQueryDevtools initialIsOpen />\n      {showDevtools && (\n        <React.Suspense fallback={null}>\n          <ReactQueryDevtoolsProduction />\n        </React.Suspense>\n      )}\n    </QueryClientProvider>\n  )\n}\n\nexport default App\n```\n\nWith this, calling `window.toggleDevtools()` will download the devtools bundle and show them.\n\n### Modern bundlers\n\nIf your bundler supports package exports, you can use the following import path:\n\n```tsx\nconst ReactQueryDevtoolsProduction = React.lazy(() =>\n  import('@tanstack/react-query-devtools/production').then((d) => ({\n    default: d.ReactQueryDevtools,\n  })),\n)\n```\n\nFor TypeScript, you would need to set `moduleResolution: 'nodenext'` in your tsconfig, which requires at least TypeScript v4.7.\n","originalRawMarkdown":"---\nid: devtools\ntitle: Devtools\n---\n\nWave your hands in the air and shout hooray because React Query comes with dedicated devtools! 🥳\n\nWhen you begin your React Query journey, you'll want these devtools by your side. They help visualize all the inner workings of React Query and will likely save you hours of debugging if you find yourself in a pinch!\n\n> For Chrome, Firefox, and Edge users: Third-party browser extensions are available for debugging TanStack Query directly in browser DevTools. These provide the same functionality as the framework-specific devtools packages:\n>\n> - <img alt=\"Chrome logo\" src=\"https://www.google.com/chrome/static/images/chrome-logo.svg\" width=\"16\" height=\"16\" class=\"inline mr-1 not-prose\" /> <a href=\"https://chromewebstore.google.com/detail/tanstack-query-devtools/annajfchloimdhceglpgglpeepfghfai\">Devtools for Chrome</a>\n> - <img alt=\"Firefox logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/a/a0/Firefox_logo%2C_2019.svg\" width=\"16\" height=\"16\" class=\"inline mr-1 not-prose\" /> <a href=\"https://addons.mozilla.org/en-US/firefox/addon/tanstack-query-devtools/\">Devtools for Firefox</a>\n> - <img alt=\"Edge logo\" src=\"https://upload.wikimedia.org/wikipedia/commons/9/98/Microsoft_Edge_logo_%282019%29.svg\" width=\"16\" height=\"16\" class=\"inline mr-1 not-prose\" /> <a href=\"https://microsoftedge.microsoft.com/addons/detail/tanstack-query-devtools/edmdpkgkacmjopodhfolmphdenmddobj\">Devtools for Edge</a>\n\n> For React Native users: A third-party native macOS app is available for debugging React Query in ANY js-based application. Monitor queries across devices in real-time. Check it out here: [rn-better-dev-tools](https://github.com/LovesWorking/rn-better-dev-tools)\n\n> Note that since version 5, the dev tools support observing mutations as well.\n\n## Install and Import the Devtools\n\nThe devtools are a separate package that you need to install:\n\n```bash\nnpm i @tanstack/react-query-devtools\n```\n\nor\n\n```bash\npnpm add @tanstack/react-query-devtools\n```\n\nor\n\n```bash\nyarn add @tanstack/react-query-devtools\n```\n\nor\n\n```bash\nbun add @tanstack/react-query-devtools\n```\n\nFor Next 13+ App Dir you must install it as a dev dependency for it to work.\n\nYou can import the devtools like this:\n\n```tsx\nimport { ReactQueryDevtools } from '@tanstack/react-query-devtools'\n```\n\nBy default, React Query Devtools are only included in bundles when `process.env.NODE_ENV === 'development'`, so you don't need to worry about excluding them during a production build.\n\n## Floating Mode\n\nFloating Mode will mount the devtools as a fixed, floating element in your app and provide a toggle in the corner of the screen to show and hide the devtools. This toggle state will be stored and remembered in localStorage across reloads.\n\nPlace the following code as high in your React app as you can. The closer it is to the root of the page, the better it will work!\n\n```tsx\nimport { ReactQueryDevtools } from '@tanstack/react-query-devtools'\n\nfunction App() {\n  return (\n    <QueryClientProvider client={queryClient}>\n      {/* The rest of your application */}\n      <ReactQueryDevtools initialIsOpen={false} />\n    </QueryClientProvider>\n  )\n}\n```\n\n### Options\n\n- `initialIsOpen: boolean`\n  - Set this `true` if you want the dev tools to default to being open\n- `buttonPosition?: \"top-left\" | \"top-right\" | \"bottom-left\" | \"bottom-right\" | \"relative\"`\n  - Defaults to `bottom-right`\n  - The position of the TanStack logo to open and close the devtools panel\n  - If `relative`, the button is placed in the location that you render the devtools.\n- `position?: \"top\" | \"bottom\" | \"left\" | \"right\"`\n  - Defaults to `bottom`\n  - The position of the React Query devtools panel\n- `client?: QueryClient`,\n  - Use this to use a custom QueryClient. Otherwise, the one from the nearest context will be used.\n- `errorTypes?: { name: string; initializer: (query: Query) => TError}[]`\n  - Use this to predefine some errors that can be triggered on your queries. Initializer will be called (with the specific query) when that error is toggled on from the UI. It must return an Error.\n- `styleNonce?: string`\n  - Use this to pass a nonce to the style tag that is added to the document head. This is useful if you are using a Content Security Policy (CSP) nonce to allow inline styles.\n- `shadowDOMTarget?: ShadowRoot`\n  - Default behavior will apply the devtool's styles to the head tag within the DOM.\n  - Use this to pass a shadow DOM target to the devtools so that the styles will be applied within the shadow DOM instead of within the head tag in the light DOM.\n- `theme?: \"light\" | \"dark\" | \"system\"`\n  - Defaults to `system`.\n  - Set this to change the theme of the devtools panel.\n\n## Embedded Mode\n\nEmbedded mode will show the development tools as a fixed element in your application, so you can use our panel in your own development tools.\n\nPlace the following code as high in your React app as you can. The closer it is to the root of the page, the better it will work!\n\n```tsx\nimport { ReactQueryDevtoolsPanel } from '@tanstack/react-query-devtools'\n\nfunction App() {\n  const [isOpen, setIsOpen] = React.useState(false)\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      {/* The rest of your application */}\n      <button\n        onClick={() => setIsOpen(!isOpen)}\n      >{`${isOpen ? 'Close' : 'Open'} the devtools panel`}</button>\n      {isOpen && <ReactQueryDevtoolsPanel onClose={() => setIsOpen(false)} />}\n    </QueryClientProvider>\n  )\n}\n```\n\n### Options\n\n- `style?: React.CSSProperties`\n  - Custom styles for the devtools panel\n  - Default: `{ height: '500px' }`\n  - Example: `{ height: '100%' }`\n  - Example: `{ height: '100%', width: '100%' }`\n- `onClose?: () => void`\n  - Callback function that is called when the devtools panel is closed\n- `client?: QueryClient`,\n  - Use this to use a custom QueryClient. Otherwise, the one from the nearest context will be used.\n- `errorTypes?: { name: string; initializer: (query: Query) => TError}[]`\n  - Use this to predefine some errors that can be triggered on your queries. Initializer will be called (with the specific query) when that error is toggled on from the UI. It must return an Error.\n- `styleNonce?: string`\n  - Use this to pass a nonce to the style tag that is added to the document head. This is useful if you are using a Content Security Policy (CSP) nonce to allow inline styles.\n- `shadowDOMTarget?: ShadowRoot`\n  - Default behavior will apply the devtool's styles to the head tag within the DOM.\n  - Use this to pass a shadow DOM target to the devtools so that the styles will be applied within the shadow DOM instead of within the head tag in the light DOM.\n- `theme?: \"light\" | \"dark\" | \"system\"`\n  - Defaults to `system`.\n  - Set this to change the theme of the devtools panel.\n\n## Devtools in production\n\nDevtools are excluded in production builds. However, it might be desirable to lazy load the devtools in production:\n\n```tsx\nimport * as React from 'react'\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query'\nimport { ReactQueryDevtools } from '@tanstack/react-query-devtools'\nimport { Example } from './Example'\n\nconst queryClient = new QueryClient()\n\nconst ReactQueryDevtoolsProduction = React.lazy(() =>\n  import('@tanstack/react-query-devtools/build/modern/production.js').then(\n    (d) => ({\n      default: d.ReactQueryDevtools,\n    }),\n  ),\n)\n\nfunction App() {\n  const [showDevtools, setShowDevtools] = React.useState(false)\n\n  React.useEffect(() => {\n    // @ts-expect-error\n    window.toggleDevtools = () => setShowDevtools((old) => !old)\n  }, [])\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      <Example />\n      <ReactQueryDevtools initialIsOpen />\n      {showDevtools && (\n        <React.Suspense fallback={null}>\n          <ReactQueryDevtoolsProduction />\n        </React.Suspense>\n      )}\n    </QueryClientProvider>\n  )\n}\n\nexport default App\n```\n\nWith this, calling `window.toggleDevtools()` will download the devtools bundle and show them.\n\n### Modern bundlers\n\nIf your bundler supports package exports, you can use the following import path:\n\n```tsx\nconst ReactQueryDevtoolsProduction = React.lazy(() =>\n  import('@tanstack/react-query-devtools/production').then((d) => ({\n    default: d.ReactQueryDevtools,\n  })),\n)\n```\n\nFor TypeScript, you would need to set `moduleResolution: 'nodenext'` in your tsconfig, which requires at least TypeScript v4.7.\n"}
