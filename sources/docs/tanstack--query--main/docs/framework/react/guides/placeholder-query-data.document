ext","value":"Prefetch or fetch the data using "},{"type":"inlineCode","value":"queryClient"},{"type":"text","value":" and the "},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" option"}]}]}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"When we use "},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":", our Query will not be in a "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" state - it will start out as being in "},{"type":"inlineCode","value":"success"},{"type":"text","value":" state, because we have "},{"type":"inlineCode","value":"data"},{"type":"text","value":" to display - even if that data is just \"placeholder\" data. To distinguish it from \"real\" data, we will also have the "},{"type":"inlineCode","value":"isPlaceholderData"},{"type":"text","value":" flag set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" on the Query result."}]},{"type":"heading","depth":2,"id":"placeholder-data-as-a-value","children":[{"type":"text","value":"Placeholder Data as a Value"}]},{"type":"code","value":"function Todos() {\n  const result = useQuery({\n    queryKey: ['todos'],\n    queryFn: () => fetch('/todos'),\n    placeholderData: placeholderTodos,\n  })\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"placeholder-data-memoization","children":[{"type":"text","value":"Placeholder Data Memoization"}]},{"type":"paragraph","children":[{"type":"text","value":"If the process for accessing a query's placeholder data is intensive or just not something you want to perform on every render, you can memoize the value:"}]},{"type":"code","value":"function Todos() {\n  const placeholderData = useMemo(() => generateFakeTodos(), [])\n  const result = useQuery({\n    queryKey: ['todos'],\n    queryFn: () => fetch('/todos'),\n    placeholderData,\n  })\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"placeholder-data-as-a-function","children":[{"type":"text","value":"Placeholder Data as a Function"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" can also be a function, where you can get access to the data and Query meta information of a \"previous\" successful Query. This is useful for situations where you want to use the data from one query as the placeholder data for another query. When the QueryKey changes, e.g. from "},{"type":"inlineCode","value":"['todos', 1]"},{"type":"text","value":" to "},{"type":"inlineCode","value":"['todos', 2]"},{"type":"text","value":", we can keep displaying \"old\" data instead of having to show a loading spinner while data is "},{"type":"emphasis","children":[{"type":"text","value":"transitioning"}]},{"type":"text","value":" from one Query to the next. For more information, see "},{"type":"link","href":"./paginated-queries.md","children":[{"type":"text","value":"Paginated Queries"}]},{"type":"text","value":"."}]},{"type":"code","value":"const result = useQuery({\n  queryKey: ['todos', id],\n  queryFn: () => fetch(`/todos/${id}`),\n  placeholderData: (previousData, previousQuery) => previousData,\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"placeholder-data-from-cache","children":[{"type":"text","value":"Placeholder Data from Cache"}]},{"type":"paragraph","children":[{"type":"text","value":"In some circumstances, you may be able to provide the placeholder data for a query from the cached result of another. A good example of this would be searching the cached data from a blog post list query for a preview version of the post, then using that as the placeholder data for your individual post query:"}]},{"type":"code","value":"function BlogPost({ blogPostId }) {\n  const queryClient = useQueryClient()\n  const result = useQuery({\n    queryKey: ['blogPost', blogPostId],\n    queryFn: () => fetch(`/blogPosts/${blogPostId}`),\n    placeholderData: () => {\n      // Use the smaller/preview version of the blogPost from the 'blogPosts'\n      // query as the placeholder data for this blogPost query\n      return queryClient\n        .getQueryData(['blogPosts'])\n        ?.find((d) => d.id === blogPostId)\n    },\n  })\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"further-reading","children":[{"type":"text","value":"Further reading"}]},{"type":"paragraph","children":[{"type":"text","value":"For a comparison between "},{"type":"inlineCode","value":"Placeholder Data"},{"type":"text","value":" and "},{"type":"inlineCode","value":"Initial Data"},{"type":"text","value":", see the "},{"type":"link","href":"https://tkdodo.eu/blog/placeholder-and-initial-data-in-react-query","children":[{"type":"text","value":"article by TkDodo"}]},{"type":"text","value":"."}]}],"headings":[{"id":"what-is-placeholder-data","text":"What is placeholder data?","level":2},{"id":"placeholder-data-as-a-value","text":"Placeholder Data as a Value","level":2},{"id":"placeholder-data-memoization","text":"Placeholder Data Memoization","level":3},{"id":"placeholder-data-as-a-function","text":"Placeholder Data as a Function","level":2},{"id":"placeholder-data-from-cache","text":"Placeholder Data from Cache","level":3},{"id":"further-reading","text":"Further reading","level":2}]},"frameworks":[],"downloadMarkdown":"\n## What is placeholder data?\n\nPlaceholder data allows a query to behave as if it already has data, similar to the `initialData` option, but **the data is not persisted to the cache**. This comes in handy for situations where you have enough partial (or fake) data to render the query successfully while the actual data is fetched in the background.\n\n> Example: An individual blog post query could pull \"preview\" data from a parent list of blog posts that only include title and a small snippet of the post body. You would not want to persist this partial data to the query result of the individual query, but it is useful for showing the content layout as quickly as possible while the actual query finishes to fetch the entire object.\n\nThere are a few ways to supply placeholder data for a query to the cache before you need it:\n\n- Declaratively:\n  - Provide `placeholderData` to a query to prepopulate its cache if empty\n- Imperatively:\n  - [Prefetch or fetch the data using `queryClient` and the `placeholderData` option](./prefetching.md)\n\nWhen we use `placeholderData`, our Query will not be in a `pending` state - it will start out as being in `success` state, because we have `data` to display - even if that data is just \"placeholder\" data. To distinguish it from \"real\" data, we will also have the `isPlaceholderData` flag set to `true` on the Query result.\n\n## Placeholder Data as a Value\n\n[//]: # 'ExampleValue'\n\n```tsx\nfunction Todos() {\n  const result = useQuery({\n    queryKey: ['todos'],\n    queryFn: () => fetch('/todos'),\n    placeholderData: placeholderTodos,\n  })\n}\n```\n\n[//]: # 'ExampleValue'\n[//]: # 'Memoization'\n\n### Placeholder Data Memoization\n\nIf the process for accessing a query's placeholder data is intensive or just not something you want to perform on every render, you can memoize the value:\n\n```tsx\nfunction Todos() {\n  const placeholderData = useMemo(() => generateFakeTodos(), [])\n  const result = useQuery({\n    queryKey: ['todos'],\n    queryFn: () => fetch('/todos'),\n    placeholderData,\n  })\n}\n```\n\n[//]: # 'Memoization'\n\n## Placeholder Data as a Function\n\n`placeholderData` can also be a function, where you can get access to the data and Query meta information of a \"previous\" successful Query. This is useful for situations where you want to use the data from one query as the placeholder data for another query. When the QueryKey changes, e.g. from `['todos', 1]` to `['todos', 2]`, we can keep displaying \"old\" data instead of having to show a loading spinner while data is _transitioning_ from one Query to the next. For more information, see [Paginated Queries](./paginated-queries.md).\n\n[//]: # 'ExampleFunction'\n\n```tsx\nconst result = useQuery({\n  queryKey: ['todos', id],\n  queryFn: () => fetch(`/todos/${id}`),\n  placeholderData: (previousData, previousQuery) => previousData,\n})\n```\n\n[//]: # 'ExampleFunction'\n\n### Placeholder Data from Cache\n\nIn some circumstances, you may be able to provide the placeholder data for a query from the cached result of another. A good example of this would be searching the cached data from a blog post list query for a preview version of the post, then using that as the placeholder data for your individual post query:\n\n[//]: # 'ExampleCache'\n\n```tsx\nfunction BlogPost({ blogPostId }) {\n  const queryClient = useQueryClient()\n  const result = useQuery({\n    queryKey: ['blogPost', blogPostId],\n    queryFn: () => fetch(`/blogPosts/${blogPostId}`),\n    placeholderData: () => {\n      // Use the smaller/preview version of the blogPost from the 'blogPosts'\n      // query as the placeholder data for this blogPost query\n      return queryClient\n        .getQueryData(['blogPosts'])\n        ?.find((d) => d.id === blogPostId)\n    },\n  })\n}\n```\n\n[//]: # 'ExampleCache'\n[//]: # 'Materials'\n\n## Further reading\n\nFor a comparison between `Placeholder Data` and `Initial Data`, see the [article by TkDodo](https://tkdodo.eu/blog/placeholder-and-initial-data-in-react-query).\n\n[//]: # 'Materials'\n","originalRawMarkdown":"---\nid: placeholder-query-data\ntitle: Placeholder Query Data\n---\n\n## What is placeholder data?\n\nPlaceholder data allows a query to behave as if it already has data, similar to the `initialData` option, but **the data is not persisted to the cache**. This comes in handy for situations where you have enough partial (or fake) data to render the query successfully while the actual data is fetched in the background.\n\n> Example: An individual blog post query could pull \"preview\" data from a parent list of blog posts that only include title and a small snippet of the post body. You would not want to persist this partial data to the query result of the individual query, but it is useful for showing the content layout as quickly as possible while the actual query finishes to fetch the entire object.\n\nThere are a few ways to supply placeholder data for a query to the cache before you need it:\n\n- Declaratively:\n  - Provide `placeholderData` to a query to prepopulate its cache if empty\n- Imperatively:\n  - [Prefetch or fetch the data using `queryClient` and the `placeholderData` option](./prefetching.md)\n\nWhen we use `placeholderData`, our Query will not be in a `pending` state - it will start out as being in `success` state, because we have `data` to display - even if that data is just \"placeholder\" data. To distinguish it from \"real\" data, we will also have the `isPlaceholderData` flag set to `true` on the Query result.\n\n## Placeholder Data as a Value\n\n[//]: # 'ExampleValue'\n\n```tsx\nfunction Todos() {\n  const result = useQuery({\n    queryKey: ['todos'],\n    queryFn: () => fetch('/todos'),\n    placeholderData: placeholderTodos,\n  })\n}\n```\n\n[//]: # 'ExampleValue'\n[//]: # 'Memoization'\n\n### Placeholder Data Memoization\n\nIf the process for accessing a query's placeholder data is intensive or just not something you want to perform on every render, you can memoize the value:\n\n```tsx\nfunction Todos() {\n  const placeholderData = useMemo(() => generateFakeTodos(), [])\n  const result = useQuery({\n    queryKey: ['todos'],\n    queryFn: () => fetch('/todos'),\n    placeholderData,\n  })\n}\n```\n\n[//]: # 'Memoization'\n\n## Placeholder Data as a Function\n\n`placeholderData` can also be a function, where you can get access to the data and Query meta information of a \"previous\" successful Query. This is useful for situations where you want to use the data from one query as the placeholder data for another query. When the QueryKey changes, e.g. from `['todos', 1]` to `['todos', 2]`, we can keep displaying \"old\" data instead of having to show a loading spinner while data is _transitioning_ from one Query to the next. For more information, see [Paginated Queries](./paginated-queries.md).\n\n[//]: # 'ExampleFunction'\n\n```tsx\nconst result = useQuery({\n  queryKey: ['todos', id],\n  queryFn: () => fetch(`/todos/${id}`),\n  placeholderData: (previousData, previousQuery) => previousData,\n})\n```\n\n[//]: # 'ExampleFunction'\n\n### Placeholder Data from Cache\n\nIn some circumstances, you may be able to provide the placeholder data for a query from the cached result of another. A good example of this would be searching the cached data from a blog post list query for a preview version of the post, then using that as the placeholder data for your individual post query:\n\n[//]: # 'ExampleCache'\n\n```tsx\nfunction BlogPost({ blogPostId }) {\n  const queryClient = useQueryClient()\n  const result = useQuery({\n    queryKey: ['blogPost', blogPostId],\n    queryFn: () => fetch(`/blogPosts/${blogPostId}`),\n    placeholderData: () => {\n      // Use the smaller/preview version of the blogPost from the 'blogPosts'\n      // query as the placeholder data for this blogPost query\n      return queryClient\n        .getQueryData(['blogPosts'])\n        ?.find((d) => d.id === blogPostId)\n    },\n  })\n}\n```\n\n[//]: # 'ExampleCache'\n[//]: # 'Materials'\n\n## Further reading\n\nFor a comparison between `Placeholder Data` and `Initial Data`, see the [article by TkDodo](https://tkdodo.eu/blog/placeholder-and-initial-data-in-react-query).\n\n[//]: # 'Materials'\n"}
