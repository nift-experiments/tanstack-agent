{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"React Query can also be used with React's Suspense for Data Fetching APIs. For this, we have dedicated hooks:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../reference/functions/useSuspenseQuery.md","children":[{"type":"text","value":"useSuspenseQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../reference/functions/useSuspenseInfiniteQuery.md","children":[{"type":"text","value":"useSuspenseInfiniteQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../reference/functions/useSuspenseQueries.md","children":[{"type":"text","value":"useSuspenseQueries"}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"When using suspense mode, "},{"type":"inlineCode","value":"status"},{"type":"text","value":" states and "},{"type":"inlineCode","value":"error"},{"type":"text","value":" objects are not needed and are then replaced by usage of the "},{"type":"inlineCode","value":"React.Suspense"},{"type":"text","value":" component (including the use of the "},{"type":"inlineCode","value":"fallback"},{"type":"text","value":" prop and React error boundaries for catching errors). Please read the "},{"type":"link","href":"#resetting-error-boundaries","children":[{"type":"text","value":"Resetting Error Boundaries"}]},{"type":"text","value":" and look at the "},{"type":"link","href":"../examples/suspense","children":[{"type":"text","value":"Suspense Example"}]},{"type":"text","value":" for more information on how to set up suspense mode."}]},{"type":"paragraph","children":[{"type":"text","value":"If you want mutations to propagate errors to the nearest error boundary (similar to queries), you can set the "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" option to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" as well."}]},{"type":"paragraph","children":[{"type":"text","value":"Enabling suspense mode for a query:"}]},{"type":"code","value":"import { useSuspenseQuery } from '@tanstack/react-query'\n\nconst { data } = useSuspenseQuery({ queryKey, queryFn })","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"This works nicely in TypeScript, because "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is guaranteed to be defined (as errors and loading states are handled by Suspense- and ErrorBoundaries)."}]},{"type":"paragraph","children":[{"type":"text","value":"On the flip side, you therefore can't conditionally enable / disable the Query. This generally shouldn't be necessary for dependent Queries because with suspense, all your Queries inside one component are fetched in serial."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" also doesn't exist for this Query. To prevent the UI from being replaced by a fallback during an update, wrap your updates that change the QueryKey into "},{"type":"link","href":"https://react.dev/reference/react/Suspense#preventing-unwanted-fallbacks","children":[{"type":"text","value":"startTransition"}]},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"throwonerror-default","children":[{"type":"text","value":"throwOnError default"}]},{"type":"paragraph","children":[{"type":"text","value":"Not all errors are thrown to the nearest Error Boundary per default - we're only throwing errors if there is no other data to show. That means if a Query ever successfully got data in the cache, the component will render, even if data is "},{"type":"inlineCode","value":"stale"},{"type":"text","value":". Thus, the default for "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is:"}]},{"type":"code","value":"throwOnError: (error, query) => typeof query.state.data === 'undefined'"},{"type":"paragraph","children":[{"type":"text","value":"Since you can't change "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" (because it would allow for "},{"type":"inlineCode","value":"data"},{"type":"text","value":" to become potentially "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"), you have to throw errors manually if you want all errors to be handled by Error Boundaries:"}]},{"type":"code","value":"import { useSuspenseQuery } from '@tanstack/react-query'\n\nconst { data, error, isFetching } = useSuspenseQuery({ queryKey, queryFn })\n\nif (error && !isFetching) {\n  throw error\n}\n\n// continue rendering data","lang":"tsx"},{"type":"heading","depth":2,"id":"resetting-error-boundaries","children":[{"type":"text","value":"Resetting Error Boundaries"}]},{"type":"paragraph","children":[{"type":"text","value":"Whether you are using "},{"type":"strong","children":[{"type":"text","value":"suspense"}]},{"type":"text","value":" or "},{"type":"strong","children":[{"type":"text","value":"throwOnError"}]},{"type":"text","value":" in your queries, you will need a way to let queries know that you want to try again when re-rendering after some error occurred."}]},{"type":"paragraph","children":[{"type":"text","value":"Query errors can be reset with the "},{"type":"inlineCode","value":"QueryErrorResetBoundary"},{"type":"text","value":" component or with the "},{"type":"inlineCode","value":"useQueryErrorResetBoundary"},{"type":"text","value":" hook."}]},{"type":"paragraph","children":[{"type":"text","value":"When using the component it will reset any query errors within the boundaries of the component:"}]},{"type":"code","value":"import { QueryErrorResetBoundary } from '@tanstack/react-query'\nimport { ErrorBoundary } from 'react-error-boundary'\n\nconst App = () => (\n  <QueryErrorResetBoundary>\n    {({ reset }) => (\n      <ErrorBoundary\n        onReset={reset}\n        fallbackRender={({ resetErrorBoundary }) => (\n          <div>\n            There was an error!\n            <button onClick={() => resetErrorBoundary()}>Try again</button>\n          </div>\n        )}\n      >\n        <Page />\n      </ErrorBoundary>\n    )}\n  </QueryErrorResetBoundary>\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"When using the hook it will reset any query errors within the closest "},{"type":"inlineCode","value":"QueryErrorResetBoundary"},{"type":"text","value":". If there is no boundary defined it will reset them globally:"}]},{"type":"code","value":"import { useQueryErrorResetBoundary } from '@tanstack/react-query'\nimport { ErrorBoundary } from 'react-error-boundary'\n\nconst App = () => {\n  const { reset } = useQueryErrorResetBoundary()\n  return (\n    <ErrorBoundary\n      onReset={reset}\n      fallbackRender={({ resetErrorBoundary }) => (\n        <div>\n          There was an error!\n          <button onClick={() => resetErrorBoundary()}>Try again</button>\n        </div>\n      )}\n    >\n      <Page />\n    </ErrorBoundary>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"fetch-on-render-vs-render-as-you-fetch","children":[{"type":"text","value":"Fetch-on-render vs Render-as-you-fetch"}]},{"type":"paragraph","children":[{"type":"text","value":"Out of the box, React Query in "},{"type":"inlineCode","value":"suspense"},{"type":"text","value":" mode works really well as a "},{"type":"strong","children":[{"type":"text","value":"Fetch-on-render"}]},{"type":"text","value":" solution with no additional configuration. This means that when your components attempt to mount, they will trigger query fetching and suspend, but only once you have imported them and mounted them. If you want to take it to the next level and implement a "},{"type":"strong","children":[{"type":"text","value":"Render-as-you-fetch"}]},{"type":"text","value":" model, we recommend implementing "},{"type":"link","href":"./prefetching.md","children":[{"type":"text","value":"Prefetching"}]},{"type":"text","value":" on routing callbacks and/or user interactions events to start loading queries before they are mounted and hopefully even before you start importing or mounting their parent components."}]},{"type":"heading","depth":2,"id":"suspense-on-the-server-with-streaming","children":[{"type":"text","value":"Suspense on the Server with streaming"}]},{"type":"paragraph","children":[{"type":"text","value":"If you are using "},{"type":"inlineCode","value":"NextJs"},{"type":"text","value":", you can use our "},{"type":"strong","children":[{"type":"text","value":"experimental"}]},{"type":"text","value":" integration for Suspense on the Server: "},{"type":"inlineCode","value":"@tanstack/react-query-next-experimental"},{"type":"text","value":". This package will allow you to fetch data on the server (in a client component) by just calling "},{"type":"inlineCode","value":"useSuspenseQuery"},{"type":"text","value":" in your component. Results will then be streamed from the server to the client as SuspenseBoundaries resolve."}]},{"type":"paragraph","children":[{"type":"text","value":"To achieve this, wrap your app in the "},{"type":"inlineCode","value":"ReactQueryStreamedHydration"},{"type":"text","value":" component:"}]},{"type":"code","value":"// app/providers.tsx\n'use client'\n\nimport {\n  environmentManager,\n  QueryClient,\n  QueryClientProvider,\n} from '@tanstack/react-query'\nimport * as React from 'react'\nimport { ReactQueryStreamedHydration } from '@tanstack/react-query-next-experimental'\n\nfunction makeQueryClient() {\n  return new QueryClient({\n    defaultOptions: {\n      queries: {\n        // With SSR, we usually want to set some default staleTime\n        // above 0 to avoid refetching immediately on the client\n        staleTime: 60 * 1000,\n      },\n    },\n  })\n}\n\nlet browserQueryClient: QueryClient | undefined = undefined\n\nfunction getQueryClient() {\n  if (environmentManager.isServer()) {\n    // Server: always make a new query client\n    return makeQueryClient()\n  } else {\n    // Browser: make a new query client if we don't already have one\n    // This is very important, so we don't re-make a new client if React\n    // suspends during the initial render. This may not be needed if we\n    // have a suspense boundary BELOW the creation of the query client\n    if (!browserQueryClient) browserQueryClient = makeQueryClient()\n    return browserQueryClient\n  }\n}\n\nexport function Providers(props: { children: React.ReactNode }) {\n  // NOTE: Avoid useState when initializing the query client if you don't\n  //       have a suspense boundary between this and the code that may\n  //       suspend because React will throw away the client on the initial\n  //       render if it suspends and there is no boundary\n  const queryClient = getQueryClient()\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      <ReactQueryStreamedHydration>\n        {props.children}\n      </ReactQueryStreamedHydration>\n    </QueryClientProvider>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"For more information, check out the "},{"type":"link","href":"../examples/nextjs-suspense-streaming","children":[{"type":"text","value":"NextJs Suspense Streaming Example"}]},{"type":"text","value":" and the "},{"type":"link","href":"./advanced-ssr.md","children":[{"type":"text","value":"Advanced Rendering & Hydration"}]},{"type":"text","value":" guide."}]}],"headings":[{"id":"throwonerror-default","text":"throwOnError default","level":3},{"id":"resetting-error-boundaries","text":"Resetting Error Boundaries","level":2},{"id":"fetch-on-render-vs-render-as-you-fetch","text":"Fetch-on-render vs Render-as-you-fetch","level":2},{"id":"suspense-on-the-server-with-streaming","text":"Suspense on the Server with streaming","level":2}]},"frameworks":[],"downloadMarkdown":"\nReact Query can also be used with React's Suspense for Data Fetching APIs. For this, we have dedicated hooks:\n\n- [useSuspenseQuery](../reference/functions/useSuspenseQuery.md)\n- [useSuspenseInfiniteQuery](../reference/functions/useSuspenseInfiniteQuery.md)\n- [useSuspenseQueries](../reference/functions/useSuspenseQueries.md)\n\n[//]: # 'Info'\n\nWhen using suspense mode, `status` states and `error` objects are not needed and are then replaced by usage of the `React.Suspense` component (including the use of the `fallback` prop and React error boundaries for catching errors). Please read the [Resetting Error Boundaries](#resetting-error-boundaries) and look at the [Suspense Example](../examples/suspense) for more information on how to set up suspense mode.\n[//]: # 'Info'\n\nIf you want mutations to propagate errors to the nearest error boundary (similar to queries), you can set the `throwOnError` option to `true` as well.\n\nEnabling suspense mode for a query:\n\n```tsx\nimport { useSuspenseQuery } from '@tanstack/react-query'\n\nconst { data } = useSuspenseQuery({ queryKey, queryFn })\n```\n\nThis works nicely in TypeScript, because `data` is guaranteed to be defined (as errors and loading states are handled by Suspense- and ErrorBoundaries).\n\nOn the flip side, you therefore can't conditionally enable / disable the Query. This generally shouldn't be necessary for dependent Queries because with suspense, all your Queries inside one component are fetched in serial.\n\n[//]: # 'PlaceholderData'\n\n`placeholderData` also doesn't exist for this Query. To prevent the UI from being replaced by a fallback during an update, wrap your updates that change the QueryKey into [startTransition](https://react.dev/reference/react/Suspense#preventing-unwanted-fallbacks).\n[//]: # 'PlaceholderData'\n\n### throwOnError default\n\nNot all errors are thrown to the nearest Error Boundary per default - we're only throwing errors if there is no other data to show. That means if a Query ever successfully got data in the cache, the component will render, even if data is `stale`. Thus, the default for `throwOnError` is:\n\n```\nthrowOnError: (error, query) => typeof query.state.data === 'undefined'\n```\n\nSince you can't change `throwOnError` (because it would allow for `data` to become potentially `undefined`), you have to throw errors manually if you want all errors to be handled by Error Boundaries:\n\n```tsx\nimport { useSuspenseQuery } from '@tanstack/react-query'\n\nconst { data, error, isFetching } = useSuspenseQuery({ queryKey, queryFn })\n\nif (error && !isFetching) {\n  throw error\n}\n\n// continue rendering data\n```\n\n## Resetting Error Boundaries\n\nWhether you are using **suspense** or **throwOnError** in your queries, you will need a way to let queries know that you want to try again when re-rendering after some error occurred.\n\nQuery errors can be reset with the `QueryErrorResetBoundary` component or with the `useQueryErrorResetBoundary` hook.\n\nWhen using the component it will reset any query errors within the boundaries of the component:\n\n[//]: # 'ExampleResetComponent'\n\n```tsx\nimport { QueryErrorResetBoundary } from '@tanstack/react-query'\nimport { ErrorBoundary } from 'react-error-boundary'\n\nconst App = () => (\n  <QueryErrorResetBoundary>\n    {({ reset }) => (\n      <ErrorBoundary\n        onReset={reset}\n        fallbackRender={({ resetErrorBoundary }) => (\n          <div>\n            There was an error!\n            <button onClick={() => resetErrorBoundary()}>Try again</button>\n          </div>\n        )}\n      >\n        <Page />\n      </ErrorBoundary>\n    )}\n  </QueryErrorResetBoundary>\n)\n```\n\n[//]: # 'ExampleResetComponent'\n\nWhen using the hook it will reset any query errors within the closest `QueryErrorResetBoundary`. If there is no boundary defined it will reset them globally:\n\n[//]: # 'ExampleResetHook'\n\n```tsx\nimport { useQueryErrorResetBoundary } from '@tanstack/react-query'\nimport { ErrorBoundary } from 'react-error-boundary'\n\nconst App = () => {\n  const { reset } = useQueryErrorResetBoundary()\n  return (\n    <ErrorBoundary\n      onReset={reset}\n      fallbackRender={({ resetErrorBoundary }) => (\n        <div>\n          There was an error!\n          <button onClick={() => resetErrorBoundary()}>Try again</button>\n        </div>\n      )}\n    >\n      <Page />\n    </ErrorBoundary>\n  )\n}\n```\n\n[//]: # 'ExampleResetHook'\n\n## Fetch-on-render vs Render-as-you-fetch\n\nOut of the box, React Query in `suspense` mode works really well as a **Fetch-on-render** solution with no additional configuration. This means that when your components attempt to mount, they will trigger query fetching and suspend, but only once you have imported them and mounted them. If you want to take it to the next level and implement a **Render-as-you-fetch** model, we recommend implementing [Prefetching](./prefetching.md) on routing callbacks and/or user interactions events to start loading queries before they are mounted and hopefully even before you start importing or mounting their parent components.\n\n[//]: # 'Streaming'\n\n## Suspense on the Server with streaming\n\nIf you are using `NextJs`, you can use our **experimental** integration for Suspense on the Server: `@tanstack/react-query-next-experimental`. This package will allow you to fetch data on the server (in a client component) by just calling `useSuspenseQuery` in your component. Results will then be streamed from the server to the client as SuspenseBoundaries resolve.\n\nTo achieve this, wrap your app in the `ReactQueryStreamedHydration` component:\n\n```tsx\n// app/providers.tsx\n'use client'\n\nimport {\n  environmentManager,\n  QueryClient,\n  QueryClientProvider,\n} from '@tanstack/react-query'\nimport * as React from 'react'\nimport { ReactQueryStreamedHydration } from '@tanstack/react-query-next-experimental'\n\nfunction makeQueryClient() {\n  return new QueryClient({\n    defaultOptions: {\n      queries: {\n        // With SSR, we usually want to set some default staleTime\n        // above 0 to avoid refetching immediately on the client\n        staleTime: 60 * 1000,\n      },\n    },\n  })\n}\n\nlet browserQueryClient: QueryClient | undefined = undefined\n\nfunction getQueryClient() {\n  if (environmentManager.isServer()) {\n    // Server: always make a new query client\n    return makeQueryClient()\n  } else {\n    // Browser: make a new query client if we don't already have one\n    // This is very important, so we don't re-make a new client if React\n    // suspends during the initial render. This may not be needed if we\n    // have a suspense boundary BELOW the creation of the query client\n    if (!browserQueryClient) browserQueryClient = makeQueryClient()\n    return browserQueryClient\n  }\n}\n\nexport function Providers(props: { children: React.ReactNode }) {\n  // NOTE: Avoid useState when initializing the query client if you don't\n  //       have a suspense boundary between this and the code that may\n  //       suspend because React will throw away the client on the initial\n  //       render if it suspends and there is no boundary\n  const queryClient = getQueryClient()\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      <ReactQueryStreamedHydration>\n        {props.children}\n      </ReactQueryStreamedHydration>\n    </QueryClientProvider>\n  )\n}\n```\n\nFor more information, check out the [NextJs Suspense Streaming Example](../examples/nextjs-suspense-streaming) and the [Advanced Rendering & Hydration](./advanced-ssr.md) guide.\n[//]: # 'Streaming'\n","originalRawMarkdown":"---\nid: suspense\ntitle: Suspense\n---\n\nReact Query can also be used with React's Suspense for Data Fetching APIs. For this, we have dedicated hooks:\n\n- [useSuspenseQuery](../reference/functions/useSuspenseQuery.md)\n- [useSuspenseInfiniteQuery](../reference/functions/useSuspenseInfiniteQuery.md)\n- [useSuspenseQueries](../reference/functions/useSuspenseQueries.md)\n\n[//]: # 'Info'\n\nWhen using suspense mode, `status` states and `error` objects are not needed and are then replaced by usage of the `React.Suspense` component (including the use of the `fallback` prop and React error boundaries for catching errors). Please read the [Resetting Error Boundaries](#resetting-error-boundaries) and look at the [Suspense Example](../examples/suspense) for more information on how to set up suspense mode.\n[//]: # 'Info'\n\nIf you want mutations to propagate errors to the nearest error boundary (similar to queries), you can set the `throwOnError` option to `true` as well.\n\nEnabling suspense mode for a query:\n\n```tsx\nimport { useSuspenseQuery } from '@tanstack/react-query'\n\nconst { data } = useSuspenseQuery({ queryKey, queryFn })\n```\n\nThis works nicely in TypeScript, because `data` is guaranteed to be defined (as errors and loading states are handled by Suspense- and ErrorBoundaries).\n\nOn the flip side, you therefore can't conditionally enable / disable the Query. This generally shouldn't be necessary for dependent Queries because with suspense, all your Queries inside one component are fetched in serial.\n\n[//]: # 'PlaceholderData'\n\n`placeholderData` also doesn't exist for this Query. To prevent the UI from being replaced by a fallback during an update, wrap your updates that change the QueryKey into [startTransition](https://react.dev/reference/react/Suspense#preventing-unwanted-fallbacks).\n[//]: # 'PlaceholderData'\n\n### throwOnError default\n\nNot all errors are thrown to the nearest Error Boundary per default - we're only throwing errors if there is no other data to show. That means if a Query ever successfully got data in the cache, the component will render, even if data is `stale`. Thus, the default for `throwOnError` is:\n\n```\nthrowOnError: (error, query) => typeof query.state.data === 'undefined'\n```\n\nSince you can't change `throwOnError` (because it would allow for `data` to become potentially `undefined`), you have to throw errors manually if you want all errors to be handled by Error Boundaries:\n\n```tsx\nimport { useSuspenseQuery } from '@tanstack/react-query'\n\nconst { data, error, isFetching } = useSuspenseQuery({ queryKey, queryFn })\n\nif (error && !isFetching) {\n  throw error\n}\n\n// continue rendering data\n```\n\n## Resetting Error Boundaries\n\nWhether you are using **suspense** or **throwOnError** in your queries, you will need a way to let queries know that you want to try again when re-rendering after some error occurred.\n\nQuery errors can be reset with the `QueryErrorResetBoundary` component or with the `useQueryErrorResetBoundary` hook.\n\nWhen using the component it will reset any query errors within the boundaries of the component:\n\n[//]: # 'ExampleResetComponent'\n\n```tsx\nimport { QueryErrorResetBoundary } from '@tanstack/react-query'\nimport { ErrorBoundary } from 'react-error-boundary'\n\nconst App = () => (\n  <QueryErrorResetBoundary>\n    {({ reset }) => (\n      <ErrorBoundary\n        onReset={reset}\n        fallbackRender={({ resetErrorBoundary }) => (\n          <div>\n            There was an error!\n            <button onClick={() => resetErrorBoundary()}>Try again</button>\n          </div>\n        )}\n      >\n        <Page />\n      </ErrorBoundary>\n    )}\n  </QueryErrorResetBoundary>\n)\n```\n\n[//]: # 'ExampleResetComponent'\n\nWhen using the hook it will reset any query errors within the closest `QueryErrorResetBoundary`. If there is no boundary defined it will reset them globally:\n\n[//]: # 'ExampleResetHook'\n\n```tsx\nimport { useQueryErrorResetBoundary } from '@tanstack/react-query'\nimport { ErrorBoundary } from 'react-error-boundary'\n\nconst App = () => {\n  const { reset } = useQueryErrorResetBoundary()\n  return (\n    <ErrorBoundary\n      onReset={reset}\n      fallbackRender={({ resetErrorBoundary }) => (\n        <div>\n          There was an error!\n          <button onClick={() => resetErrorBoundary()}>Try again</button>\n        </div>\n      )}\n    >\n      <Page />\n    </ErrorBoundary>\n  )\n}\n```\n\n[//]: # 'ExampleResetHook'\n\n## Fetch-on-render vs Render-as-you-fetch\n\nOut of the box, React Query in `suspense` mode works really well as a **Fetch-on-render** solution with no additional configuration. This means that when your components attempt to mount, they will trigger query fetching and suspend, but only once you have imported them and mounted them. If you want to take it to the next level and implement a **Render-as-you-fetch** model, we recommend implementing [Prefetching](./prefetching.md) on routing callbacks and/or user interactions events to start loading queries before they are mounted and hopefully even before you start importing or mounting their parent components.\n\n[//]: # 'Streaming'\n\n## Suspense on the Server with streaming\n\nIf you are using `NextJs`, you can use our **experimental** integration for Suspense on the Server: `@tanstack/react-query-next-experimental`. This package will allow you to fetch data on the server (in a client component) by just calling `useSuspenseQuery` in your component. Results will then be streamed from the server to the client as SuspenseBoundaries resolve.\n\nTo achieve this, wrap your app in the `ReactQueryStreamedHydration` component:\n\n```tsx\n// app/providers.tsx\n'use client'\n\nimport {\n  environmentManager,\n  QueryClient,\n  QueryClientProvider,\n} from '@tanstack/react-query'\nimport * as React from 'react'\nimport { ReactQueryStreamedHydration } from '@tanstack/react-query-next-experimental'\n\nfunction makeQueryClient() {\n  return new QueryClient({\n    defaultOptions: {\n      queries: {\n        // With SSR, we usually want to set some default staleTime\n        // above 0 to avoid refetching immediately on the client\n        staleTime: 60 * 1000,\n      },\n    },\n  })\n}\n\nlet browserQueryClient: QueryClient | undefined = undefined\n\nfunction getQueryClient() {\n  if (environmentManager.isServer()) {\n    // Server: always make a new query client\n    return makeQueryClient()\n  } else {\n    // Browser: make a new query client if we don't already have one\n    // This is very important, so we don't re-make a new client if React\n    // suspends during the initial render. This may not be needed if we\n    // have a suspense boundary BELOW the creation of the query client\n    if (!browserQueryClient) browserQueryClient = makeQueryClient()\n    return browserQueryClient\n  }\n}\n\nexport function Providers(props: { children: React.ReactNode }) {\n  // NOTE: Avoid useState when initializing the query client if you don't\n  //       have a suspense boundary between this and the code that may\n  //       suspend because React will throw away the client on the initial\n  //       render if it suspends and there is no boundary\n  const queryClient = getQueryClient()\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      <ReactQueryStreamedHydration>\n        {props.children}\n      </ReactQueryStreamedHydration>\n    </QueryClientProvider>\n  )\n}\n```\n\nFor more information, check out the [NextJs Suspense Streaming Example](../examples/nextjs-suspense-streaming) and the [Advanced Rendering & Hydration](./advanced-ssr.md) guide.\n[//]: # 'Streaming'\n"}
