{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"paragraph","children":[{"type":"text","value":"This utility comes as a separate package and is available under the "},{"type":"inlineCode","value":"'@tanstack/query-persist-client-core'"},{"type":"text","value":" import."}]},{"type":"code","value":"npm install @tanstack/query-persist-client-core","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"or"}]},{"type":"code","value":"pnpm add @tanstack/query-persist-client-core","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"or"}]},{"type":"code","value":"yarn add @tanstack/query-persist-client-core","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"or"}]},{"type":"code","value":"bun add @tanstack/query-persist-client-core","lang":"bash"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Note: This util is also included in the "},{"type":"inlineCode","value":"@tanstack/react-query-persist-client"},{"type":"text","value":" package, so you do not need to install it separately if you are using that package."}]}]},{"type":"heading","depth":2,"id":"usage","children":[{"type":"text","value":"Usage"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Import the "},{"type":"inlineCode","value":"experimental_createQueryPersister"},{"type":"text","value":" function"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Create a new "},{"type":"inlineCode","value":"experimental_createQueryPersister"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you can pass any "},{"type":"inlineCode","value":"storage"},{"type":"text","value":" to it that adheres to the "},{"type":"inlineCode","value":"AsyncStorage"},{"type":"text","value":" interface - the example below uses the async-storage from React Native."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Pass that "},{"type":"inlineCode","value":"persister"},{"type":"text","value":" as an option to your Query. This can be done either by passing it to the "},{"type":"inlineCode","value":"defaultOptions"},{"type":"text","value":" of the "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":" or to any "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" hook instance."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you pass this "},{"type":"inlineCode","value":"persister"},{"type":"text","value":" as "},{"type":"inlineCode","value":"defaultOptions"},{"type":"text","value":", all queries will be persisted to the provided "},{"type":"inlineCode","value":"storage"},{"type":"text","value":". You can additionally narrow this down by passing "},{"type":"inlineCode","value":"filters"},{"type":"text","value":". In contrast to the "},{"type":"inlineCode","value":"persistClient"},{"type":"text","value":" plugin, this will not persist the whole query client as a single item, but each query separately. As a key, the query hash is used."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you provide this "},{"type":"inlineCode","value":"persister"},{"type":"text","value":" to a single "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" hook, only this Query will be persisted."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Note: "},{"type":"inlineCode","value":"queryClient.setQueryData()"},{"type":"text","value":" operations are not persisted, this means that if you perform an optimistic update and refresh the page before the query has been invalidated, your changes to the query data will be lost. See https://github.com/TanStack/query/issues/6310"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"This way, you do not need to store whole "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":", but choose what is worth to be persisted in your application. Each query is lazily restored (when the Query is first used) and persisted (after each run of the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":"), so it does not need to be throttled. "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" is also respected after restoring the Query, so if data is considered "},{"type":"inlineCode","value":"stale"},{"type":"text","value":", it will be refetched immediately after restoring. If data is "},{"type":"inlineCode","value":"fresh"},{"type":"text","value":", the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" will not run."}]},{"type":"paragraph","children":[{"type":"text","value":"Garbage collecting a Query from memory "},{"type":"strong","children":[{"type":"text","value":"does not"}]},{"type":"text","value":" affect the persisted data. That means Queries can be kept in memory for a shorter period of time to be more "},{"type":"strong","children":[{"type":"text","value":"memory efficient"}]},{"type":"text","value":". If they are used the next time, they will just be restored from the persistent storage again."}]},{"type":"code","value":"import AsyncStorage from '@react-native-async-storage/async-storage'\nimport { QueryClient } from '@tanstack/react-query'\nimport { experimental_createQueryPersister } from '@tanstack/query-persist-client-core'\n\nconst persister = experimental_createQueryPersister({\n  storage: AsyncStorage,\n  maxAge: 1000 * 60 * 60 * 12, // 12 hours\n})\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: {\n      gcTime: 1000 * 30, // 30 seconds\n      persister: persister.persisterFn,\n    },\n  },\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"adapted-defaults","children":[{"type":"text","value":"Adapted defaults"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"createPersister"},{"type":"text","value":" plugin technically wraps the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":", so it doesn't restore if the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" doesn't run. In that way, it acts as a caching layer between the Query and the network. Thus, the "},{"type":"inlineCode","value":"networkMode"},{"type":"text","value":" defaults to "},{"type":"inlineCode","value":"'offlineFirst'"},{"type":"text","value":" when a persister is used, so that restoring from the persistent storage can also happen even if there is no network connection."}]},{"type":"heading","depth":2,"id":"additional-utilities","children":[{"type":"text","value":"Additional utilities"}]},{"type":"paragraph","children":[{"type":"text","value":"Invoking "},{"type":"inlineCode","value":"experimental_createQueryPersister"},{"type":"text","value":" returns additional utilities in addition to "},{"type":"inlineCode","value":"persisterFn"},{"type":"text","value":" for easier implementation of userland functionalities."}]},{"type":"heading","depth":3,"id":"persistquerybykey-querykey-querykey-queryclient-queryclient-promisevoid","children":[{"type":"inlineCode","value":"persistQueryByKey(queryKey: QueryKey, queryClient: QueryClient): Promise<void>"}]},{"type":"paragraph","children":[{"type":"text","value":"This function will persist "},{"type":"inlineCode","value":"Query"},{"type":"text","value":" to storage and key defined when creating persister.\nThis utility might be used along "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" to persist optimistic update to storage without waiting for invalidation."}]},{"type":"code","value":"const persister = experimental_createQueryPersister({\n  storage: AsyncStorage,\n  maxAge: 1000 * 60 * 60 * 12, // 12 hours\n})\n\nconst queryClient = useQueryClient()\n\nuseMutation({\n  mutationFn: updateTodo,\n  onMutate: async (newTodo) => {\n    ...\n    // Optimistically update to the new value\n    queryClient.setQueryData(['todos'], (old) => [...old, newTodo])\n    // And persist it to storage\n    persister.persistQueryByKey(['todos'], queryClient)\n    ...\n  },\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"retrievequeryt-queryhash-string-promiset-undefined","children":[{"type":"inlineCode","value":"retrieveQuery<T>(queryHash: string): Promise<T | undefined>"}]},{"type":"paragraph","children":[{"type":"text","value":"This function would attempt to retrieve persisted query by "},{"type":"inlineCode","value":"queryHash"},{"type":"text","value":".\nIf "},{"type":"inlineCode","value":"query"},{"type":"text","value":" is "},{"type":"inlineCode","value":"expired"},{"type":"text","value":", "},{"type":"inlineCode","value":"busted"},{"type":"text","value":" or "},{"type":"inlineCode","value":"malformed"},{"type":"text","value":" it would be removed from the storage instead, and "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" would be returned."}]},{"type":"heading","depth":3,"id":"persistergc-promisevoid","children":[{"type":"inlineCode","value":"persisterGc(): Promise<void>"}]},{"type":"paragraph","children":[{"type":"text","value":"This function can be used to sporadically clean up storage from "},{"type":"inlineCode","value":"expired"},{"type":"text","value":", "},{"type":"inlineCode","value":"busted"},{"type":"text","value":" or "},{"type":"inlineCode","value":"malformed"},{"type":"text","value":" entries."}]},{"type":"paragraph","children":[{"type":"text","value":"For this function to work, your storage must expose "},{"type":"inlineCode","value":"entries"},{"type":"text","value":" method that would return a "},{"type":"inlineCode","value":"key-value tuple array"},{"type":"text","value":".\nFor example "},{"type":"inlineCode","value":"Object.entries(localStorage)"},{"type":"text","value":" for "},{"type":"inlineCode","value":"localStorage"},{"type":"text","value":" or "},{"type":"inlineCode","value":"entries"},{"type":"text","value":" from "},{"type":"inlineCode","value":"idb-keyval"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"restorequeries-queryclient-queryclient-filters-promisevoid","children":[{"type":"inlineCode","value":"restoreQueries(queryClient: QueryClient, filters): Promise<void>"}]},{"type":"paragraph","children":[{"type":"text","value":"This function can be used to restore queries that are currently stored by persister.\nFor example when your app is starting up in offline mode, or you want all or only specific data from previous session to be immediately available without intermediate "},{"type":"inlineCode","value":"loading"},{"type":"text","value":" state."}]},{"type":"paragraph","children":[{"type":"text","value":"The filter object supports the following properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this property to define a query key to match on."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"exact?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you don't want to search queries inclusively by query key, you can pass the "},{"type":"inlineCode","value":"exact: true"},{"type":"text","value":" option to return only the query with the exact query key you have passed."}]}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"For this function to work, your storage must expose "},{"type":"inlineCode","value":"entries"},{"type":"text","value":" method that would return a "},{"type":"inlineCode","value":"key-value tuple array"},{"type":"text","value":".\nFor example "},{"type":"inlineCode","value":"Object.entries(localStorage)"},{"type":"text","value":" for "},{"type":"inlineCode","value":"localStorage"},{"type":"text","value":" or "},{"type":"inlineCode","value":"entries"},{"type":"text","value":" from "},{"type":"inlineCode","value":"idb-keyval"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"removequeries-filters-promisevoid","children":[{"type":"inlineCode","value":"removeQueries(filters): Promise<void>"}]},{"type":"paragraph","children":[{"type":"text","value":"When using "},{"type":"inlineCode","value":"queryClient.removeQueries"},{"type":"text","value":", the data remains in the persister and needs to be removed separately.\nThis function can be used to remove queries that are currently stored by persister."}]},{"type":"paragraph","children":[{"type":"text","value":"The filter object supports the following properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this property to define a query key to match on."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"exact?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you don't want to search queries inclusively by query key, you can pass the "},{"type":"inlineCode","value":"exact: true"},{"type":"text","value":" option to return only the query with the exact query key you have passed."}]}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"For this function to work, your storage must expose "},{"type":"inlineCode","value":"entries"},{"type":"text","value":" method that would return a "},{"type":"inlineCode","value":"key-value tuple array"},{"type":"text","value":".\nFor example "},{"type":"inlineCode","value":"Object.entries(localStorage)"},{"type":"text","value":" for "},{"type":"inlineCode","value":"localStorage"},{"type":"text","value":" or "},{"type":"inlineCode","value":"entries"},{"type":"text","value":" from "},{"type":"inlineCode","value":"idb-keyval"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"api","children":[{"type":"text","value":"API"}]},{"type":"heading","depth":3,"id":"experimental-createquerypersister","children":[{"type":"inlineCode","value":"experimental_createQueryPersister"}]},{"type":"code","value":"experimental_createQueryPersister(options: StoragePersisterOptions)","lang":"tsx"},{"type":"heading","depth":4,"id":"options","children":[{"type":"inlineCode","value":"Options"}]},{"type":"code","value":"export interface StoragePersisterOptions {\n  /** The storage client used for setting and retrieving items from cache.\n   * For SSR pass in `undefined`.\n   */\n  storage: AsyncStorage | Storage | undefined | null\n  /**\n   * How to serialize the data to storage.\n   * @default `JSON.stringify`\n   */\n  serialize?: (persistedQuery: PersistedQuery) => string\n  /**\n   * How to deserialize the data from storage.\n   * @default `JSON.parse`\n   */\n  deserialize?: (cachedString: string) => PersistedQuery\n  /**\n   * A unique string that can be used to forcefully invalidate existing caches,\n   * if they do not share the same buster string\n   */\n  buster?: string\n  /**\n   * The max-allowed age of the cache in milliseconds.\n   * If a persisted cache is found that is older than this\n   * time, it will be discarded\n   * @default 24 hours\n   */\n  maxAge?: number\n  /**\n   * Prefix to be used for storage key.\n   * Storage key is a combination of prefix and query hash in a form of `prefix-queryHash`.\n   */\n  prefix?: string\n  /**\n   * If set to `true`, the query will refetch on successful query restoration if the data is stale.\n   * If set to `false`, the query will not refetch on successful query restoration.\n   * If set to `'always'`, the query will always refetch on successful query restoration.\n   * Defaults to `true`.\n   */\n  refetchOnRestore?: boolean | 'always'\n  /**\n   * Filters to narrow down which Queries should be persisted.\n   */\n  filters?: QueryFilters\n}\n\ninterface AsyncStorage<TStorageValue = string> {\n  getItem: (key: string) => MaybePromise<TStorageValue | undefined | null>\n  setItem: (key: string, value: TStorageValue) => MaybePromise<unknown>\n  removeItem: (key: string) => MaybePromise<void>\n  entries?: () => MaybePromise<Array<[key: string, value: TStorageValue]>>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The default options are:"}]},{"type":"code","value":"{\n  prefix = 'tanstack-query',\n  maxAge = 1000 * 60 * 60 * 24,\n  serialize = JSON.stringify,\n  deserialize = JSON.parse,\n  refetchOnRestore = true,\n}","lang":"tsx"}],"headings":[{"id":"installation","text":"Installation","level":2},{"id":"usage","text":"Usage","level":2},{"id":"adapted-defaults","text":"Adapted defaults","level":3},{"id":"additional-utilities","text":"Additional utilities","level":2},{"id":"persistquerybykey-querykey-querykey-queryclient-queryclient-promisevoid","text":"persistQueryByKey(queryKey: QueryKey, queryClient: QueryClient): Promise<void>","level":3},{"id":"retrievequeryt-queryhash-string-promiset-undefined","text":"retrieveQuery<T>(queryHash: string): Promise<T | undefined>","level":3},{"id":"persistergc-promisevoid","text":"persisterGc(): Promise<void>","level":3},{"id":"restorequeries-queryclient-queryclient-filters-promisevoid","text":"restoreQueries(queryClient: QueryClient, filters): Promise<void>","level":3},{"id":"removequeries-filters-promisevoid","text":"removeQueries(filters): Promise<void>","level":3},{"id":"api","text":"API","level":2},{"id":"experimental-createquerypersister","text":"experimental_createQueryPersister","level":3},{"id":"options","text":"Options","level":4}]},"frameworks":[],"downloadMarkdown":"\n## Installation\n\nThis utility comes as a separate package and is available under the `'@tanstack/query-persist-client-core'` import.\n\n```bash\nnpm install @tanstack/query-persist-client-core\n```\n\nor\n\n```bash\npnpm add @tanstack/query-persist-client-core\n```\n\nor\n\n```bash\nyarn add @tanstack/query-persist-client-core\n```\n\nor\n\n```bash\nbun add @tanstack/query-persist-client-core\n```\n\n> Note: This util is also included in the `@tanstack/react-query-persist-client` package, so you do not need to install it separately if you are using that package.\n\n## Usage\n\n- Import the `experimental_createQueryPersister` function\n- Create a new `experimental_createQueryPersister`\n  - you can pass any `storage` to it that adheres to the `AsyncStorage` interface - the example below uses the async-storage from React Native.\n- Pass that `persister` as an option to your Query. This can be done either by passing it to the `defaultOptions` of the `QueryClient` or to any `useQuery` hook instance.\n  - If you pass this `persister` as `defaultOptions`, all queries will be persisted to the provided `storage`. You can additionally narrow this down by passing `filters`. In contrast to the `persistClient` plugin, this will not persist the whole query client as a single item, but each query separately. As a key, the query hash is used.\n  - If you provide this `persister` to a single `useQuery` hook, only this Query will be persisted.\n- Note: `queryClient.setQueryData()` operations are not persisted, this means that if you perform an optimistic update and refresh the page before the query has been invalidated, your changes to the query data will be lost. See https://github.com/TanStack/query/issues/6310\n\nThis way, you do not need to store whole `QueryClient`, but choose what is worth to be persisted in your application. Each query is lazily restored (when the Query is first used) and persisted (after each run of the `queryFn`), so it does not need to be throttled. `staleTime` is also respected after restoring the Query, so if data is considered `stale`, it will be refetched immediately after restoring. If data is `fresh`, the `queryFn` will not run.\n\nGarbage collecting a Query from memory **does not** affect the persisted data. That means Queries can be kept in memory for a shorter period of time to be more **memory efficient**. If they are used the next time, they will just be restored from the persistent storage again.\n\n```tsx\nimport AsyncStorage from '@react-native-async-storage/async-storage'\nimport { QueryClient } from '@tanstack/react-query'\nimport { experimental_createQueryPersister } from '@tanstack/query-persist-client-core'\n\nconst persister = experimental_createQueryPersister({\n  storage: AsyncStorage,\n  maxAge: 1000 * 60 * 60 * 12, // 12 hours\n})\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: {\n      gcTime: 1000 * 30, // 30 seconds\n      persister: persister.persisterFn,\n    },\n  },\n})\n```\n\n### Adapted defaults\n\nThe `createPersister` plugin technically wraps the `queryFn`, so it doesn't restore if the `queryFn` doesn't run. In that way, it acts as a caching layer between the Query and the network. Thus, the `networkMode` defaults to `'offlineFirst'` when a persister is used, so that restoring from the persistent storage can also happen even if there is no network connection.\n\n## Additional utilities\n\nInvoking `experimental_createQueryPersister` returns additional utilities in addition to `persisterFn` for easier implementation of userland functionalities.\n\n### `persistQueryByKey(queryKey: QueryKey, queryClient: QueryClient): Promise<void>`\n\nThis function will persist `Query` to storage and key defined when creating persister.  \nThis utility might be used along `setQueryData` to persist optimistic update to storage without waiting for invalidation.\n\n```tsx\nconst persister = experimental_createQueryPersister({\n  storage: AsyncStorage,\n  maxAge: 1000 * 60 * 60 * 12, // 12 hours\n})\n\nconst queryClient = useQueryClient()\n\nuseMutation({\n  mutationFn: updateTodo,\n  onMutate: async (newTodo) => {\n    ...\n    // Optimistically update to the new value\n    queryClient.setQueryData(['todos'], (old) => [...old, newTodo])\n    // And persist it to storage\n    persister.persistQueryByKey(['todos'], queryClient)\n    ...\n  },\n})\n```\n\n### `retrieveQuery<T>(queryHash: string): Promise<T | undefined>`\n\nThis function would attempt to retrieve persisted query by `queryHash`.  \nIf `query` is `expired`, `busted` or `malformed` it would be removed from the storage instead, and `undefined` would be returned.\n\n### `persisterGc(): Promise<void>`\n\nThis function can be used to sporadically clean up storage from `expired`, `busted` or `malformed` entries.\n\nFor this function to work, your storage must expose `entries` method that would return a `key-value tuple array`.  \nFor example `Object.entries(localStorage)` for `localStorage` or `entries` from `idb-keyval`.\n\n### `restoreQueries(queryClient: QueryClient, filters): Promise<void>`\n\nThis function can be used to restore queries that are currently stored by persister.  \nFor example when your app is starting up in offline mode, or you want all or only specific data from previous session to be immediately available without intermediate `loading` state.\n\nThe filter object supports the following properties:\n\n- `queryKey?: QueryKey`\n  - Set this property to define a query key to match on.\n- `exact?: boolean`\n  - If you don't want to search queries inclusively by query key, you can pass the `exact: true` option to return only the query with the exact query key you have passed.\n\nFor this function to work, your storage must expose `entries` method that would return a `key-value tuple array`.  \nFor example `Object.entries(localStorage)` for `localStorage` or `entries` from `idb-keyval`.\n\n### `removeQueries(filters): Promise<void>`\n\nWhen using `queryClient.removeQueries`, the data remains in the persister and needs to be removed separately.\nThis function can be used to remove queries that are currently stored by persister.\n\nThe filter object supports the following properties:\n\n- `queryKey?: QueryKey`\n  - Set this property to define a query key to match on.\n- `exact?: boolean`\n  - If you don't want to search queries inclusively by query key, you can pass the `exact: true` option to return only the query with the exact query key you have passed.\n\nFor this function to work, your storage must expose `entries` method that would return a `key-value tuple array`.  \nFor example `Object.entries(localStorage)` for `localStorage` or `entries` from `idb-keyval`.\n\n## API\n\n### `experimental_createQueryPersister`\n\n```tsx\nexperimental_createQueryPersister(options: StoragePersisterOptions)\n```\n\n#### `Options`\n\n```tsx\nexport interface StoragePersisterOptions {\n  /** The storage client used for setting and retrieving items from cache.\n   * For SSR pass in `undefined`.\n   */\n  storage: AsyncStorage | Storage | undefined | null\n  /**\n   * How to serialize the data to storage.\n   * @default `JSON.stringify`\n   */\n  serialize?: (persistedQuery: PersistedQuery) => string\n  /**\n   * How to deserialize the data from storage.\n   * @default `JSON.parse`\n   */\n  deserialize?: (cachedString: string) => PersistedQuery\n  /**\n   * A unique string that can be used to forcefully invalidate existing caches,\n   * if they do not share the same buster string\n   */\n  buster?: string\n  /**\n   * The max-allowed age of the cache in milliseconds.\n   * If a persisted cache is found that is older than this\n   * time, it will be discarded\n   * @default 24 hours\n   */\n  maxAge?: number\n  /**\n   * Prefix to be used for storage key.\n   * Storage key is a combination of prefix and query hash in a form of `prefix-queryHash`.\n   */\n  prefix?: string\n  /**\n   * If set to `true`, the query will refetch on successful query restoration if the data is stale.\n   * If set to `false`, the query will not refetch on successful query restoration.\n   * If set to `'always'`, the query will always refetch on successful query restoration.\n   * Defaults to `true`.\n   */\n  refetchOnRestore?: boolean | 'always'\n  /**\n   * Filters to narrow down which Queries should be persisted.\n   */\n  filters?: QueryFilters\n}\n\ninterface AsyncStorage<TStorageValue = string> {\n  getItem: (key: string) => MaybePromise<TStorageValue | undefined | null>\n  setItem: (key: string, value: TStorageValue) => MaybePromise<unknown>\n  removeItem: (key: string) => MaybePromise<void>\n  entries?: () => MaybePromise<Array<[key: string, value: TStorageValue]>>\n}\n```\n\nThe default options are:\n\n```tsx\n{\n  prefix = 'tanstack-query',\n  maxAge = 1000 * 60 * 60 * 24,\n  serialize = JSON.stringify,\n  deserialize = JSON.parse,\n  refetchOnRestore = true,\n}\n```\n","originalRawMarkdown":"---\nid: createPersister\ntitle: experimental_createQueryPersister\n---\n\n## Installation\n\nThis utility comes as a separate package and is available under the `'@tanstack/query-persist-client-core'` import.\n\n```bash\nnpm install @tanstack/query-persist-client-core\n```\n\nor\n\n```bash\npnpm add @tanstack/query-persist-client-core\n```\n\nor\n\n```bash\nyarn add @tanstack/query-persist-client-core\n```\n\nor\n\n```bash\nbun add @tanstack/query-persist-client-core\n```\n\n> Note: This util is also included in the `@tanstack/react-query-persist-client` package, so you do not need to install it separately if you are using that package.\n\n## Usage\n\n- Import the `experimental_createQueryPersister` function\n- Create a new `experimental_createQueryPersister`\n  - you can pass any `storage` to it that adheres to the `AsyncStorage` interface - the example below uses the async-storage from React Native.\n- Pass that `persister` as an option to your Query. This can be done either by passing it to the `defaultOptions` of the `QueryClient` or to any `useQuery` hook instance.\n  - If you pass this `persister` as `defaultOptions`, all queries will be persisted to the provided `storage`. You can additionally narrow this down by passing `filters`. In contrast to the `persistClient` plugin, this will not persist the whole query client as a single item, but each query separately. As a key, the query hash is used.\n  - If you provide this `persister` to a single `useQuery` hook, only this Query will be persisted.\n- Note: `queryClient.setQueryData()` operations are not persisted, this means that if you perform an optimistic update and refresh the page before the query has been invalidated, your changes to the query data will be lost. See https://github.com/TanStack/query/issues/6310\n\nThis way, you do not need to store whole `QueryClient`, but choose what is worth to be persisted in your application. Each query is lazily restored (when the Query is first used) and persisted (after each run of the `queryFn`), so it does not need to be throttled. `staleTime` is also respected after restoring the Query, so if data is considered `stale`, it will be refetched immediately after restoring. If data is `fresh`, the `queryFn` will not run.\n\nGarbage collecting a Query from memory **does not** affect the persisted data. That means Queries can be kept in memory for a shorter period of time to be more **memory efficient**. If they are used the next time, they will just be restored from the persistent storage again.\n\n```tsx\nimport AsyncStorage from '@react-native-async-storage/async-storage'\nimport { QueryClient } from '@tanstack/react-query'\nimport { experimental_createQueryPersister } from '@tanstack/query-persist-client-core'\n\nconst persister = experimental_createQueryPersister({\n  storage: AsyncStorage,\n  maxAge: 1000 * 60 * 60 * 12, // 12 hours\n})\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: {\n      gcTime: 1000 * 30, // 30 seconds\n      persister: persister.persisterFn,\n    },\n  },\n})\n```\n\n### Adapted defaults\n\nThe `createPersister` plugin technically wraps the `queryFn`, so it doesn't restore if the `queryFn` doesn't run. In that way, it acts as a caching layer between the Query and the network. Thus, the `networkMode` defaults to `'offlineFirst'` when a persister is used, so that restoring from the persistent storage can also happen even if there is no network connection.\n\n## Additional utilities\n\nInvoking `experimental_createQueryPersister` returns additional utilities in addition to `persisterFn` for easier implementation of userland functionalities.\n\n### `persistQueryByKey(queryKey: QueryKey, queryClient: QueryClient): Promise<void>`\n\nThis function will persist `Query` to storage and key defined when creating persister.  \nThis utility might be used along `setQueryData` to persist optimistic update to storage without waiting for invalidation.\n\n```tsx\nconst persister = experimental_createQueryPersister({\n  storage: AsyncStorage,\n  maxAge: 1000 * 60 * 60 * 12, // 12 hours\n})\n\nconst queryClient = useQueryClient()\n\nuseMutation({\n  mutationFn: updateTodo,\n  onMutate: async (newTodo) => {\n    ...\n    // Optimistically update to the new value\n    queryClient.setQueryData(['todos'], (old) => [...old, newTodo])\n    // And persist it to storage\n    persister.persistQueryByKey(['todos'], queryClient)\n    ...\n  },\n})\n```\n\n### `retrieveQuery<T>(queryHash: string): Promise<T | undefined>`\n\nThis function would attempt to retrieve persisted query by `queryHash`.  \nIf `query` is `expired`, `busted` or `malformed` it would be removed from the storage instead, and `undefined` would be returned.\n\n### `persisterGc(): Promise<void>`\n\nThis function can be used to sporadically clean up storage from `expired`, `busted` or `malformed` entries.\n\nFor this function to work, your storage must expose `entries` method that would return a `key-value tuple array`.  \nFor example `Object.entries(localStorage)` for `localStorage` or `entries` from `idb-keyval`.\n\n### `restoreQueries(queryClient: QueryClient, filters): Promise<void>`\n\nThis function can be used to restore queries that are currently stored by persister.  \nFor example when your app is starting up in offline mode, or you want all or only specific data from previous session to be immediately available without intermediate `loading` state.\n\nThe filter object supports the following properties:\n\n- `queryKey?: QueryKey`\n  - Set this property to define a query key to match on.\n- `exact?: boolean`\n  - If you don't want to search queries inclusively by query key, you can pass the `exact: true` option to return only the query with the exact query key you have passed.\n\nFor this function to work, your storage must expose `entries` method that would return a `key-value tuple array`.  \nFor example `Object.entries(localStorage)` for `localStorage` or `entries` from `idb-keyval`.\n\n### `removeQueries(filters): Promise<void>`\n\nWhen using `queryClient.removeQueries`, the data remains in the persister and needs to be removed separately.\nThis function can be used to remove queries that are currently stored by persister.\n\nThe filter object supports the following properties:\n\n- `queryKey?: QueryKey`\n  - Set this property to define a query key to match on.\n- `exact?: boolean`\n  - If you don't want to search queries inclusively by query key, you can pass the `exact: true` option to return only the query with the exact query key you have passed.\n\nFor this function to work, your storage must expose `entries` method that would return a `key-value tuple array`.  \nFor example `Object.entries(localStorage)` for `localStorage` or `entries` from `idb-keyval`.\n\n## API\n\n### `experimental_createQueryPersister`\n\n```tsx\nexperimental_createQueryPersister(options: StoragePersisterOptions)\n```\n\n#### `Options`\n\n```tsx\nexport interface StoragePersisterOptions {\n  /** The storage client used for setting and retrieving items from cache.\n   * For SSR pass in `undefined`.\n   */\n  storage: AsyncStorage | Storage | undefined | null\n  /**\n   * How to serialize the data to storage.\n   * @default `JSON.stringify`\n   */\n  serialize?: (persistedQuery: PersistedQuery) => string\n  /**\n   * How to deserialize the data from storage.\n   * @default `JSON.parse`\n   */\n  deserialize?: (cachedString: string) => PersistedQuery\n  /**\n   * A unique string that can be used to forcefully invalidate existing caches,\n   * if they do not share the same buster string\n   */\n  buster?: string\n  /**\n   * The max-allowed age of the cache in milliseconds.\n   * If a persisted cache is found that is older than this\n   * time, it will be discarded\n   * @default 24 hours\n   */\n  maxAge?: number\n  /**\n   * Prefix to be used for storage key.\n   * Storage key is a combination of prefix and query hash in a form of `prefix-queryHash`.\n   */\n  prefix?: string\n  /**\n   * If set to `true`, the query will refetch on successful query restoration if the data is stale.\n   * If set to `false`, the query will not refetch on successful query restoration.\n   * If set to `'always'`, the query will always refetch on successful query restoration.\n   * Defaults to `true`.\n   */\n  refetchOnRestore?: boolean | 'always'\n  /**\n   * Filters to narrow down which Queries should be persisted.\n   */\n  filters?: QueryFilters\n}\n\ninterface AsyncStorage<TStorageValue = string> {\n  getItem: (key: string) => MaybePromise<TStorageValue | undefined | null>\n  setItem: (key: string, value: TStorageValue) => MaybePromise<unknown>\n  removeItem: (key: string) => MaybePromise<void>\n  entries?: () => MaybePromise<Array<[key: string, value: TStorageValue]>>\n}\n```\n\nThe default options are:\n\n```tsx\n{\n  prefix = 'tanstack-query',\n  maxAge = 1000 * 60 * 60 * 24,\n  serialize = JSON.stringify,\n  deserialize = JSON.parse,\n  refetchOnRestore = true,\n}\n```\n"}
