","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"link","href":"../type-aliases/DefaultError.md","children":[{"type":"inlineCode","value":"DefaultError"}]}]},{"type":"heading","depth":3,"id":"tvariables","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"tonmutateresult","children":[{"type":"text","value":"TOnMutateResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,"id":"constructor","children":[{"type":"text","value":"Constructor"}]},{"type":"code","value":"new Mutation<TData, TError, TVariables, TOnMutateResult>(config: MutationConfig<TData, TError, TVariables, TOnMutateResult>): Mutation<TData, TError, TVariables, TOnMutateResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L155","children":[{"type":"text","value":"packages/query-core/src/mutation.ts:155"}]}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"config","children":[{"type":"text","value":"config"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MutationConfig"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Mutation"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"overrides","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"Removable.constructor","lang":"ts"},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"gctime","children":[{"type":"text","value":"gcTime"}]},{"type":"code","value":"gcTime: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/removable.ts#L11","children":[{"type":"text","value":"packages/query-core/src/removable.ts:11"}]}]},{"type":"heading","depth":4,"id":"inherited-from","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"Removable.gcTime","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"mutationid","children":[{"type":"text","value":"mutationId"}]},{"type":"code","value":"readonly mutationId: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L146","children":[{"type":"text","value":"packages/query-core/src/mutation.ts:146"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"code","value":"options: MutationOptions<TData, TError, TVariables, TOnMutateResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L145","children":[{"type":"text","value":"packages/query-core/src/mutation.ts:145"}]}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"state","children":[{"type":"text","value":"state"}]},{"type":"code","value":"state: MutationState<TData, TError, TVariables, TOnMutateResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L144","children":[{"type":"text","value":"packages/query-core/src/mutation.ts:144"}]}]},{"type":"heading","depth":2,"id":"accessors","children":[{"type":"text","value":"Accessors"}]},{"type":"heading","depth":3,"id":"meta","children":[{"type":"text","value":"meta"}]},{"type":"heading","depth":4,"id":"get-signature","children":[{"type":"text","value":"Get Signature"}]},{"type":"code","value":"get meta(): Record<string, unknown> | undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L187","children":[{"type":"text","value":"packages/query-core/src/mutation.ts:187"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"meta"},{"type":"text","value":" object passed in the mutation's options, if any."}]},{"type":"heading","depth":5,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"> | "},{"type":"inlineCode","value":"undefined"}]},{"type":"paragraph","children":[{"type":"text","value":"The mutation's "},{"type":"inlineCode","value":"meta"},{"type":"text","value":", or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" if none was set."}]},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"continue","children":[{"type":"text","value":"continue()"}]},{"type":"code","value":"continue(): Promise<unknown>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L260","children":[{"type":"text","value":"packages/query-core/src/mutation.ts:260"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Resumes a mutation that is currently paused or was restored from a\ndehydrated, still-"},{"type":"inlineCode","value":"pending"},{"type":"text","value":" state."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If this mutation has an active retryer (it paused mid-attempt, e.g. due\nto the network mode or scope-based queuing), its retryer is resumed."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Otherwise, if the mutation's status is still "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" (e.g. it was\ndehydrated while an attempt was in flight and never got a retryer in\nthis instance), "},{"type":"inlineCode","value":"execute"},{"type":"text","value":" is called again with the last known variables."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Otherwise the mutation has already settled and this resolves immediately\nwithout running anything again."}]}]}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise that settles with the resumed mutation: it rejects if the mutation fails.\nIt resolves immediately if the mutation has already settled."}]},{"type":"heading","depth":4,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"#execute","children":[{"type":"text","value":"Mutation#execute"}]}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// typically driven by reconnect handling, e.g. queryClient.resumePausedMutations()\nconst mutation = mutationCache.find({ mutationKey: ['addPost'] })\nawait mutation?.continue()","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"destroy","children":[{"type":"text","value":"destroy()"}]},{"type":"code","value":"destroy(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/removable.ts#L19","children":[{"type":"text","value":"packages/query-core/src/removable.ts:19"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Clears the pending garbage collection timeout, so the entry is no longer scheduled for removal.\nA subclass may override this to release what it holds on to as well — "},{"type":"inlineCode","value":"Query"},{"type":"text","value":" also cancels any\nin-flight fetch."}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"inherited-from-2","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"Removable.destroy","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"execute","children":[{"type":"text","value":"execute()"}]},{"type":"code","value":"execute(variables: TVariables): Promise<TData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L301","children":[{"type":"text","value":"packages/query-core/src/mutation.ts:301"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Runs the mutation function for the given variables through a retryer, and\ndrives the mutation's state and lifecycle callbacks through to settlement."}]},{"type":"paragraph","children":[{"type":"text","value":"If this mutation's state is already "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" when "},{"type":"inlineCode","value":"execute"},{"type":"text","value":" is called\n(i.e. it was restored, still in-flight, from a dehydrated state), the\n"},{"type":"inlineCode","value":"onMutate"},{"type":"text","value":" step is skipped and a "},{"type":"inlineCode","value":"continue"},{"type":"text","value":" action is dispatched to\nunpause it; otherwise a "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" action is dispatched first, then the\nmutation cache's "},{"type":"inlineCode","value":"onMutate"},{"type":"text","value":" and the mutation's own "},{"type":"inlineCode","value":"onMutate"},{"type":"text","value":" option are\nawaited in that order, and the resulting context is stored."}]},{"type":"paragraph","children":[{"type":"text","value":"The mutation function is then run (subject to "},{"type":"inlineCode","value":"retry"},{"type":"text","value":"/"},{"type":"inlineCode","value":"retryDelay"},{"type":"text","value":"/\n"},{"type":"inlineCode","value":"networkMode"},{"type":"text","value":", and to the mutation cache's scope-based serialization).\nOn success, the cache's "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callbacks run before the\nmutation's own "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" options, a "},{"type":"inlineCode","value":"success"},{"type":"text","value":" action is\ndispatched, and the resolved data is returned. On failure, the same\ncache-then-option ordering is used for "},{"type":"inlineCode","value":"onError"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":", but each of\nthose four callbacks is individually caught so that a throwing callback\ncannot mask the original error; an "},{"type":"inlineCode","value":"error"},{"type":"text","value":" action is then dispatched and\nthe original error is re-thrown."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"variables","children":[{"type":"text","value":"variables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"text","value":"The variables passed to the "},{"type":"inlineCode","value":"mutationFn"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise that resolves with the mutation's data, or rejects with its error."}]},{"type":"heading","depth":4,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"#continue","children":[{"type":"text","value":"Mutation#continue"}]}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Called internally by `MutationObserver.mutate` and `Mutation.continue` —\n// applications normally trigger mutations through those, not this method.\nconst data = await mutation.execute(variables)","lang":"ts"}],"headings":[{"id":"example","text":"Example","level":2},{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tvariables","text":"TVariables","level":3},{"id":"tonmutateresult","text":"TOnMutateResult","level":3},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"config","text":"config","level":5},{"id":"returns","text":"Returns","level":4},{"id":"overrides","text":"Overrides","level":4},{"id":"properties","text":"Properties","level":2},{"id":"gctime","text":"gcTime","level":3},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"mutationid","text":"mutationId","level":3},{"id":"options","text":"options","level":3},{"id":"state","text":"state","level":3},{"id":"accessors","text":"Accessors","level":2},{"id":"meta","text":"meta","level":3},{"id":"get-signature","text":"Get Signature","level":4},{"id":"returns-2","text":"Returns","level":5},{"id":"methods","text":"Methods","level":2},{"id":"continue","text":"continue()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"see","text":"See","level":4},{"id":"example-2","text":"Example","level":4},{"id":"destroy","text":"destroy()","level":3},{"id":"returns-4","text":"Returns","level":4},{"id":"inherited-from-2","text":"Inherited from","level":4},{"id":"execute","text":"execute()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"variables","text":"variables","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"see-2","text":"See","level":4},{"id":"example-3","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/mutation.ts:138](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L138)\n\nRepresents a single mutation attempt. A `Mutation` holds the mutation's\noptions, state (data/error/status), and the `MutationObserver`s currently\nsubscribed to it.\n\nInstances are created and managed internally by `MutationCache`; application\ncode typically interacts with mutations indirectly through `QueryClient` or\na framework hook like `useMutation`. Direct access to a `Mutation` instance\nis possible via `mutationCache.find()`/`getAll()` for inspecting cache state.\n\n## Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst mutation = mutationCache.find({ mutationKey: ['addPost'] })\n```\n\n## Extends\n\n- `Removable`\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\n### TVariables\n\n`TVariables` = `unknown`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew Mutation<TData, TError, TVariables, TOnMutateResult>(config: MutationConfig<TData, TError, TVariables, TOnMutateResult>): Mutation<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:155](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L155)\n\n#### Parameters\n\n##### config\n\n`MutationConfig`\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\n#### Returns\n\n`Mutation`\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\n#### Overrides\n\n```ts\nRemovable.constructor\n```\n\n## Properties\n\n### gcTime\n\n```ts\ngcTime: number;\n```\n\nDefined in: [packages/query-core/src/removable.ts:11](https://github.com/TanStack/query/blob/main/packages/query-core/src/removable.ts#L11)\n\n#### Inherited from\n\n```ts\nRemovable.gcTime\n```\n\n***\n\n### mutationId\n\n```ts\nreadonly mutationId: number;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:146](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L146)\n\n***\n\n### options\n\n```ts\noptions: MutationOptions<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:145](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L145)\n\n***\n\n### state\n\n```ts\nstate: MutationState<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:144](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L144)\n\n## Accessors\n\n### meta\n\n#### Get Signature\n\n```ts\nget meta(): Record<string, unknown> | undefined;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:187](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L187)\n\nThe `meta` object passed in the mutation's options, if any.\n\n##### Returns\n\n`Record`\\<`string`, `unknown`\\> \\| `undefined`\n\nThe mutation's `meta`, or `undefined` if none was set.\n\n## Methods\n\n### continue()\n\n```ts\ncontinue(): Promise<unknown>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:260](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L260)\n\nResumes a mutation that is currently paused or was restored from a\ndehydrated, still-`pending` state.\n\n- If this mutation has an active retryer (it paused mid-attempt, e.g. due\n  to the network mode or scope-based queuing), its retryer is resumed.\n- Otherwise, if the mutation's status is still `pending` (e.g. it was\n  dehydrated while an attempt was in flight and never got a retryer in\n  this instance), `execute` is called again with the last known variables.\n- Otherwise the mutation has already settled and this resolves immediately\n  without running anything again.\n\n#### Returns\n\n`Promise`\\<`unknown`\\>\n\nA promise that settles with the resumed mutation: it rejects if the mutation fails.\nIt resolves immediately if the mutation has already settled.\n\n#### See\n\n[Mutation#execute](#execute)\n\n#### Example\n\n```ts\n// typically driven by reconnect handling, e.g. queryClient.resumePausedMutations()\nconst mutation = mutationCache.find({ mutationKey: ['addPost'] })\nawait mutation?.continue()\n```\n\n***\n\n### destroy()\n\n```ts\ndestroy(): void;\n```\n\nDefined in: [packages/query-core/src/removable.ts:19](https://github.com/TanStack/query/blob/main/packages/query-core/src/removable.ts#L19)\n\nClears the pending garbage collection timeout, so the entry is no longer scheduled for removal.\nA subclass may override this to release what it holds on to as well — `Query` also cancels any\nin-flight fetch.\n\n#### Returns\n\n`void`\n\n#### Inherited from\n\n```ts\nRemovable.destroy\n```\n\n***\n\n### execute()\n\n```ts\nexecute(variables: TVariables): Promise<TData>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:301](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L301)\n\nRuns the mutation function for the given variables through a retryer, and\ndrives the mutation's state and lifecycle callbacks through to settlement.\n\nIf this mutation's state is already `pending` when `execute` is called\n(i.e. it was restored, still in-flight, from a dehydrated state), the\n`onMutate` step is skipped and a `continue` action is dispatched to\nunpause it; otherwise a `pending` action is dispatched first, then the\nmutation cache's `onMutate` and the mutation's own `onMutate` option are\nawaited in that order, and the resulting context is stored.\n\nThe mutation function is then run (subject to `retry`/`retryDelay`/\n`networkMode`, and to the mutation cache's scope-based serialization).\nOn success, the cache's `onSuccess`/`onSettled` callbacks run before the\nmutation's own `onSuccess`/`onSettled` options, a `success` action is\ndispatched, and the resolved data is returned. On failure, the same\ncache-then-option ordering is used for `onError`/`onSettled`, but each of\nthose four callbacks is individually caught so that a throwing callback\ncannot mask the original error; an `error` action is then dispatched and\nthe original error is re-thrown.\n\n#### Parameters\n\n##### variables\n\n`TVariables`\n\nThe variables passed to the `mutationFn`.\n\n#### Returns\n\n`Promise`\\<`TData`\\>\n\nA promise that resolves with the mutation's data, or rejects with its error.\n\n#### See\n\n[Mutation#continue](#continue)\n\n#### Example\n\n```ts\n// Called internally by `MutationObserver.mutate` and `Mutation.continue` —\n// applications normally trigger mutations through those, not this method.\nconst data = await mutation.execute(variables)\n```\n","originalRawMarkdown":"---\nid: Mutation\ntitle: Mutation\n---\n\nDefined in: [packages/query-core/src/mutation.ts:138](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L138)\n\nRepresents a single mutation attempt. A `Mutation` holds the mutation's\noptions, state (data/error/status), and the `MutationObserver`s currently\nsubscribed to it.\n\nInstances are created and managed internally by `MutationCache`; application\ncode typically interacts with mutations indirectly through `QueryClient` or\na framework hook like `useMutation`. Direct access to a `Mutation` instance\nis possible via `mutationCache.find()`/`getAll()` for inspecting cache state.\n\n## Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst mutation = mutationCache.find({ mutationKey: ['addPost'] })\n```\n\n## Extends\n\n- `Removable`\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\n### TVariables\n\n`TVariables` = `unknown`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew Mutation<TData, TError, TVariables, TOnMutateResult>(config: MutationConfig<TData, TError, TVariables, TOnMutateResult>): Mutation<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:155](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L155)\n\n#### Parameters\n\n##### config\n\n`MutationConfig`\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\n#### Returns\n\n`Mutation`\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\n#### Overrides\n\n```ts\nRemovable.constructor\n```\n\n## Properties\n\n### gcTime\n\n```ts\ngcTime: number;\n```\n\nDefined in: [packages/query-core/src/removable.ts:11](https://github.com/TanStack/query/blob/main/packages/query-core/src/removable.ts#L11)\n\n#### Inherited from\n\n```ts\nRemovable.gcTime\n```\n\n***\n\n### mutationId\n\n```ts\nreadonly mutationId: number;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:146](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L146)\n\n***\n\n### options\n\n```ts\noptions: MutationOptions<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:145](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L145)\n\n***\n\n### state\n\n```ts\nstate: MutationState<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:144](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L144)\n\n## Accessors\n\n### meta\n\n#### Get Signature\n\n```ts\nget meta(): Record<string, unknown> | undefined;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:187](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L187)\n\nThe `meta` object passed in the mutation's options, if any.\n\n##### Returns\n\n`Record`\\<`string`, `unknown`\\> \\| `undefined`\n\nThe mutation's `meta`, or `undefined` if none was set.\n\n## Methods\n\n### continue()\n\n```ts\ncontinue(): Promise<unknown>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:260](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L260)\n\nResumes a mutation that is currently paused or was restored from a\ndehydrated, still-`pending` state.\n\n- If this mutation has an active retryer (it paused mid-attempt, e.g. due\n  to the network mode or scope-based queuing), its retryer is resumed.\n- Otherwise, if the mutation's status is still `pending` (e.g. it was\n  dehydrated while an attempt was in flight and never got a retryer in\n  this instance), `execute` is called again with the last known variables.\n- Otherwise the mutation has already settled and this resolves immediately\n  without running anything again.\n\n#### Returns\n\n`Promise`\\<`unknown`\\>\n\nA promise that settles with the resumed mutation: it rejects if the mutation fails.\nIt resolves immediately if the mutation has already settled.\n\n#### See\n\n[Mutation#execute](#execute)\n\n#### Example\n\n```ts\n// typically driven by reconnect handling, e.g. queryClient.resumePausedMutations()\nconst mutation = mutationCache.find({ mutationKey: ['addPost'] })\nawait mutation?.continue()\n```\n\n***\n\n### destroy()\n\n```ts\ndestroy(): void;\n```\n\nDefined in: [packages/query-core/src/removable.ts:19](https://github.com/TanStack/query/blob/main/packages/query-core/src/removable.ts#L19)\n\nClears the pending garbage collection timeout, so the entry is no longer scheduled for removal.\nA subclass may override this to release what it holds on to as well — `Query` also cancels any\nin-flight fetch.\n\n#### Returns\n\n`void`\n\n#### Inherited from\n\n```ts\nRemovable.destroy\n```\n\n***\n\n### execute()\n\n```ts\nexecute(variables: TVariables): Promise<TData>;\n```\n\nDefined in: [packages/query-core/src/mutation.ts:301](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L301)\n\nRuns the mutation function for the given variables through a retryer, and\ndrives the mutation's state and lifecycle callbacks through to settlement.\n\nIf this mutation's state is already `pending` when `execute` is called\n(i.e. it was restored, still in-flight, from a dehydrated state), the\n`onMutate` step is skipped and a `continue` action is dispatched to\nunpause it; otherwise a `pending` action is dispatched first, then the\nmutation cache's `onMutate` and the mutation's own `onMutate` option are\nawaited in that order, and the resulting context is stored.\n\nThe mutation function is then run (subject to `retry`/`retryDelay`/\n`networkMode`, and to the mutation cache's scope-based serialization).\nOn success, the cache's `onSuccess`/`onSettled` callbacks run before the\nmutation's own `onSuccess`/`onSettled` options, a `success` action is\ndispatched, and the resolved data is returned. On failure, the same\ncache-then-option ordering is used for `onError`/`onSettled`, but each of\nthose four callbacks is individually caught so that a throwing callback\ncannot mask the original error; an `error` action is then dispatched and\nthe original error is re-thrown.\n\n#### Parameters\n\n##### variables\n\n`TVariables`\n\nThe variables passed to the `mutationFn`.\n\n#### Returns\n\n`Promise`\\<`TData`\\>\n\nA promise that resolves with the mutation's data, or rejects with its error.\n\n#### See\n\n[Mutation#continue](#continue)\n\n#### Example\n\n```ts\n// Called internally by `MutationObserver.mutate` and `Mutation.continue` —\n// applications normally trigger mutations through those, not this method.\nconst data = await mutation.execute(variables)\n```\n"}
