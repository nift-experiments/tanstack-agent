","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred data type."}]},{"type":"heading","depth":3,"id":"remarks-3","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"useInfiniteQuery.md","children":[{"type":"text","value":"useInfiniteQuery"}]},{"type":"text","value":" for examples that fetch further pages (from a button click or\nautomatically as the user scrolls) and that use "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" to disable the query until "},{"type":"inlineCode","value":"postId"},{"type":"text","value":" is set."}]},{"type":"heading","depth":3,"id":"see-3","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"useInfiniteQuery.md","children":[{"type":"text","value":"useInfiniteQuery"}]},{"type":"text","value":" to run an infinite query with these options."}]},{"type":"heading","depth":3,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"A parameterized factory, so the same options object can be reused per "},{"type":"inlineCode","value":"postId"},{"type":"text","value":":"}]},{"type":"code","value":"import { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/react-query'\n\nexport const commentsOptions = (postId: string) =>\n  infiniteQueryOptions({\n    queryKey: ['post', postId, 'comments'],\n    queryFn: ({ pageParam }) => fetchComments(postId, pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  })\n\nfunction Comments({ postId }: { postId: string }) {\n  const { data, isPending, isError, error } = useInfiniteQuery(commentsOptions(postId))\n\n  if (isPending) return 'Loading...'\n  if (isError) return <span>Error: {error.message}</span>\n\n  return (\n    <ul>\n      {data.pages.map((page) => page.comments.map((c) => <li key={c.id}>{c.text}</li>))}\n    </ul>\n  )\n}","lang":"tsx"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-4","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"text","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":"."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/UseInfiniteQueryOptions.md#properties","children":[{"type":"inlineCode","value":"UseInfiniteQueryOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":"> & "},{"type":"link","href":"../type-aliases/QueryKeyWithDataTag.md","children":[{"type":"inlineCode","value":"QueryKeyWithDataTag"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred data type."}]},{"type":"html","value":"<a id=\"result-properties\"></a>"},{"type":"heading","depth":3,"id":"result-properties","children":[{"type":"text","value":"Result properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/UseInfiniteQueryOptions.md#properties","children":[{"type":"inlineCode","value":"UseInfiniteQueryOptions"}]},{"type":"text","value":", "},{"type":"link","href":"../type-aliases/QueryKeyWithDataTag.md#properties","children":[{"type":"inlineCode","value":"QueryKeyWithDataTag"}]},{"type":"text","value":". See the type above for what it changes."}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tqueryfndata","text":"TQueryFnData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tdata","text":"TData","level":4},{"id":"tquerykey","text":"TQueryKey","level":4},{"id":"tpageparam","text":"TPageParam","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"returns","text":"Returns","level":3},{"id":"remarks","text":"Remarks","level":3},{"id":"see","text":"See","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tqueryfndata-2","text":"TQueryFnData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tdata-2","text":"TData","level":4},{"id":"tquerykey-2","text":"TQueryKey","level":4},{"id":"tpageparam-2","text":"TPageParam","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"remarks-2","text":"Remarks","level":3},{"id":"see-2","text":"See","level":3},{"id":"example-2","text":"Example","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tqueryfndata-3","text":"TQueryFnData","level":4},{"id":"terror-3","text":"TError","level":4},{"id":"tdata-3","text":"TData","level":4},{"id":"tquerykey-3","text":"TQueryKey","level":4},{"id":"tpageparam-3","text":"TPageParam","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"options-3","text":"options","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"remarks-3","text":"Remarks","level":3},{"id":"see-3","text":"See","level":3},{"id":"example-3","text":"Example","level":3},{"id":"parameters-4","text":"Parameters","level":2},{"id":"options-4","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"returns-4","text":"Returns","level":2},{"id":"result-properties","text":"Result properties","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\n- [`DefinedInitialDataInfiniteOptions` → `DefinedInitialDataInfiniteOptions & QueryKeyWithDataTag`](#call-signature-1): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n- [`UnusedSkipTokenInfiniteOptions` → `UnusedSkipTokenInfiniteOptions & QueryKeyWithDataTag`](#call-signature-2): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n- [`UndefinedInitialDataInfiniteOptions` → `UndefinedInitialDataInfiniteOptions & QueryKeyWithDataTag`](#call-signature-3): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/react-query/src/infiniteQueryOptions.ts:165](https://github.com/TanStack/query/blob/main/packages/react-query/src/infiniteQueryOptions.ts#L165)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\nThis overload is selected when `initialData` is set.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you can pass to `useInfiniteQuery`, with `initialData` set.\n\n### Returns\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### Remarks\n\nSee [useInfiniteQuery](useInfiniteQuery.md) for examples that fetch further pages, from a button click or\nautomatically as the user scrolls.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\n```tsx\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/react-query'\n\nexport const projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  initialData: { pages: [], pageParams: [] },\n})\n\nfunction Projects() {\n  // `data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const { data, isError, error } = useInfiniteQuery(projectsOptions)\n\n  return (\n    <div>\n      {isError ? <span>Error: {error.message}</span> : null}\n      <ul>\n        {data.pages.map((page) => page.projects.map((p) => <li key={p.id}>{p.name}</li>))}\n      </ul>\n    </div>\n  )\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/react-query/src/infiniteQueryOptions.ts:224](https://github.com/TanStack/query/blob/main/packages/react-query/src/infiniteQueryOptions.ts#L224)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UnusedSkipTokenInfiniteOptions`](../type-aliases/UnusedSkipTokenInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [UnusedSkipTokenInfiniteOptions](../type-aliases/UnusedSkipTokenInfiniteOptions.md) to use — everything you can pass to `useInfiniteQuery`.\n\n### Returns\n\n[`UnusedSkipTokenInfiniteOptions`](../type-aliases/UnusedSkipTokenInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### Remarks\n\nSee [useInfiniteQuery](useInfiniteQuery.md) for examples that fetch further pages, from a button click or\nautomatically as the user scrolls.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\nA parameterized factory, so the same options object can be reused per `postId`:\n```tsx\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/react-query'\n\nexport const commentsOptions = (postId: string) =>\n  infiniteQueryOptions({\n    queryKey: ['post', postId, 'comments'],\n    queryFn: ({ pageParam }) => fetchComments(postId, pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  })\n\nfunction Comments({ postId }: { postId: string }) {\n  const { data, isPending, isError, error } = useInfiniteQuery(commentsOptions(postId))\n\n  if (isPending) return 'Loading...'\n  if (isError) return <span>Error: {error.message}</span>\n\n  return (\n    <ul>\n      {data.pages.map((page) => page.comments.map((c) => <li key={c.id}>{c.text}</li>))}\n    </ul>\n  )\n}\n```\n\n<a id=\"call-signature-3\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/react-query/src/infiniteQueryOptions.ts:283](https://github.com/TanStack/query/blob/main/packages/react-query/src/infiniteQueryOptions.ts#L283)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything you can pass to `useInfiniteQuery`.\n\n### Returns\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### Remarks\n\nSee [useInfiniteQuery](useInfiniteQuery.md) for examples that fetch further pages (from a button click or\nautomatically as the user scrolls) and that use `skipToken` to disable the query until `postId` is set.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\nA parameterized factory, so the same options object can be reused per `postId`:\n```tsx\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/react-query'\n\nexport const commentsOptions = (postId: string) =>\n  infiniteQueryOptions({\n    queryKey: ['post', postId, 'comments'],\n    queryFn: ({ pageParam }) => fetchComments(postId, pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  })\n\nfunction Comments({ postId }: { postId: string }) {\n  const { data, isPending, isError, error } = useInfiniteQuery(commentsOptions(postId))\n\n  if (isPending) return 'Loading...'\n  if (isError) return <span>Error: {error.message}</span>\n\n  return (\n    <ul>\n      {data.pages.map((page) => page.comments.map((c) => <li key={c.id}>{c.text}</li>))}\n    </ul>\n  )\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything you can pass to `useInfiniteQuery`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`UseInfiniteQueryOptions`](../interfaces/UseInfiniteQueryOptions.md#properties). See the type above for what it changes.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`UseInfiniteQueryOptions`](../interfaces/UseInfiniteQueryOptions.md#properties), [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md#properties). See the type above for what it changes.\n","originalRawMarkdown":"---\nid: infiniteQueryOptions\ntitle: infiniteQueryOptions\nredirect_from:\n  - framework/react/reference/infiniteQueryOptions\n---\n\n## Overview\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\n- [`DefinedInitialDataInfiniteOptions` → `DefinedInitialDataInfiniteOptions & QueryKeyWithDataTag`](#call-signature-1): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n- [`UnusedSkipTokenInfiniteOptions` → `UnusedSkipTokenInfiniteOptions & QueryKeyWithDataTag`](#call-signature-2): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n- [`UndefinedInitialDataInfiniteOptions` → `UndefinedInitialDataInfiniteOptions & QueryKeyWithDataTag`](#call-signature-3): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/react-query/src/infiniteQueryOptions.ts:165](https://github.com/TanStack/query/blob/main/packages/react-query/src/infiniteQueryOptions.ts#L165)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\nThis overload is selected when `initialData` is set.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you can pass to `useInfiniteQuery`, with `initialData` set.\n\n### Returns\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### Remarks\n\nSee [useInfiniteQuery](useInfiniteQuery.md) for examples that fetch further pages, from a button click or\nautomatically as the user scrolls.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\n```tsx\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/react-query'\n\nexport const projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  initialData: { pages: [], pageParams: [] },\n})\n\nfunction Projects() {\n  // `data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const { data, isError, error } = useInfiniteQuery(projectsOptions)\n\n  return (\n    <div>\n      {isError ? <span>Error: {error.message}</span> : null}\n      <ul>\n        {data.pages.map((page) => page.projects.map((p) => <li key={p.id}>{p.name}</li>))}\n      </ul>\n    </div>\n  )\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UnusedSkipTokenInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/react-query/src/infiniteQueryOptions.ts:224](https://github.com/TanStack/query/blob/main/packages/react-query/src/infiniteQueryOptions.ts#L224)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UnusedSkipTokenInfiniteOptions`](../type-aliases/UnusedSkipTokenInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [UnusedSkipTokenInfiniteOptions](../type-aliases/UnusedSkipTokenInfiniteOptions.md) to use — everything you can pass to `useInfiniteQuery`.\n\n### Returns\n\n[`UnusedSkipTokenInfiniteOptions`](../type-aliases/UnusedSkipTokenInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### Remarks\n\nSee [useInfiniteQuery](useInfiniteQuery.md) for examples that fetch further pages, from a button click or\nautomatically as the user scrolls.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\nA parameterized factory, so the same options object can be reused per `postId`:\n```tsx\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/react-query'\n\nexport const commentsOptions = (postId: string) =>\n  infiniteQueryOptions({\n    queryKey: ['post', postId, 'comments'],\n    queryFn: ({ pageParam }) => fetchComments(postId, pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  })\n\nfunction Comments({ postId }: { postId: string }) {\n  const { data, isPending, isError, error } = useInfiniteQuery(commentsOptions(postId))\n\n  if (isPending) return 'Loading...'\n  if (isError) return <span>Error: {error.message}</span>\n\n  return (\n    <ul>\n      {data.pages.map((page) => page.comments.map((c) => <li key={c.id}>{c.text}</li>))}\n    </ul>\n  )\n}\n```\n\n<a id=\"call-signature-3\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/react-query/src/infiniteQueryOptions.ts:283](https://github.com/TanStack/query/blob/main/packages/react-query/src/infiniteQueryOptions.ts#L283)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything you can pass to `useInfiniteQuery`.\n\n### Returns\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### Remarks\n\nSee [useInfiniteQuery](useInfiniteQuery.md) for examples that fetch further pages (from a button click or\nautomatically as the user scrolls) and that use `skipToken` to disable the query until `postId` is set.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\nA parameterized factory, so the same options object can be reused per `postId`:\n```tsx\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/react-query'\n\nexport const commentsOptions = (postId: string) =>\n  infiniteQueryOptions({\n    queryKey: ['post', postId, 'comments'],\n    queryFn: ({ pageParam }) => fetchComments(postId, pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  })\n\nfunction Comments({ postId }: { postId: string }) {\n  const { data, isPending, isError, error } = useInfiniteQuery(commentsOptions(postId))\n\n  if (isPending) return 'Loading...'\n  if (isError) return <span>Error: {error.message}</span>\n\n  return (\n    <ul>\n      {data.pages.map((page) => page.comments.map((c) => <li key={c.id}>{c.text}</li>))}\n    </ul>\n  )\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything you can pass to `useInfiniteQuery`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`UseInfiniteQueryOptions`](../interfaces/UseInfiniteQueryOptions.md#properties). See the type above for what it changes.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`UseInfiniteQueryOptions`](../interfaces/UseInfiniteQueryOptions.md#properties), [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md#properties). See the type above for what it changes.\n"}
