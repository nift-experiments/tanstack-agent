ineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":3,"id":"tquerydata","children":[{"type":"text","value":"TQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":3,"id":"tquerykey","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UsePrefetchQueryOptions.md","children":[{"type":"inlineCode","value":"UsePrefetchQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/UsePrefetchQueryOptions.md","children":[{"type":"text","value":"UsePrefetchQueryOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":"."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/QueryExecuteOptions.md#properties","children":[{"type":"inlineCode","value":"QueryExecuteOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will\nbe used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { Suspense } from 'react'\nimport { usePrefetchQuery } from '@tanstack/react-query'\n\nfunction App() {\n  // Fire the prefetch during render, before the suspense boundary below.\n  usePrefetchQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  })\n\n  return (\n    <Suspense fallback={<h1>Loading posts...</h1>}>\n      <Posts />\n    </Suspense>\n  )\n}","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tqueryfndata","text":"TQueryFnData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tquerydata","text":"TQueryData","level":3},{"id":"tquerykey","text":"TQueryKey","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction usePrefetchQuery<TQueryFnData, TError, TData, TQueryData, TQueryKey>(options: UsePrefetchQueryOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>, queryClient?: QueryClient): void;\n```\n\nDefined in: [packages/react-query/src/usePrefetchQuery.tsx:39](https://github.com/TanStack/query/blob/main/packages/react-query/src/usePrefetchQuery.tsx#L39)\n\n`usePrefetchQuery` does not return anything, it should be used just to fire a prefetch during render, before\na suspense boundary that wraps a component that uses `useSuspenseQuery`. You can pass everything to\n`usePrefetchQuery` that you can pass to `queryClient.query`, though `queryKey` is always required, and\n`queryFn` is required unless a default query function has been defined.\n\nThe prefetch is skipped if the query already has any cached state — including a `pending`/`error` state left\nover from a previous attempt — so calling this on every render is cheap and won't refetch data that's\nalready there or already in flight.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TData\n\n`TData` = `TQueryFnData`\n\n### TQueryData\n\n`TQueryData` = `TQueryFnData`\n\n### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n## Parameters\n\n### options\n\n[`UsePrefetchQueryOptions`](../type-aliases/UsePrefetchQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryData`, `TQueryKey`\\>\n\nThe [UsePrefetchQueryOptions](../type-aliases/UsePrefetchQueryOptions.md) to use — everything you can pass to `queryClient.query`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`QueryExecuteOptions`](../interfaces/QueryExecuteOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`void`\n\n## Example\n\n```tsx\nimport { Suspense } from 'react'\nimport { usePrefetchQuery } from '@tanstack/react-query'\n\nfunction App() {\n  // Fire the prefetch during render, before the suspense boundary below.\n  usePrefetchQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  })\n\n  return (\n    <Suspense fallback={<h1>Loading posts...</h1>}>\n      <Posts />\n    </Suspense>\n  )\n}\n```\n","originalRawMarkdown":"---\nid: usePrefetchQuery\ntitle: usePrefetchQuery\nredirect_from:\n  - framework/react/reference/usePrefetchQuery\n---\n\n```ts\nfunction usePrefetchQuery<TQueryFnData, TError, TData, TQueryData, TQueryKey>(options: UsePrefetchQueryOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>, queryClient?: QueryClient): void;\n```\n\nDefined in: [packages/react-query/src/usePrefetchQuery.tsx:39](https://github.com/TanStack/query/blob/main/packages/react-query/src/usePrefetchQuery.tsx#L39)\n\n`usePrefetchQuery` does not return anything, it should be used just to fire a prefetch during render, before\na suspense boundary that wraps a component that uses `useSuspenseQuery`. You can pass everything to\n`usePrefetchQuery` that you can pass to `queryClient.query`, though `queryKey` is always required, and\n`queryFn` is required unless a default query function has been defined.\n\nThe prefetch is skipped if the query already has any cached state — including a `pending`/`error` state left\nover from a previous attempt — so calling this on every render is cheap and won't refetch data that's\nalready there or already in flight.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TData\n\n`TData` = `TQueryFnData`\n\n### TQueryData\n\n`TQueryData` = `TQueryFnData`\n\n### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n## Parameters\n\n### options\n\n[`UsePrefetchQueryOptions`](../type-aliases/UsePrefetchQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryData`, `TQueryKey`\\>\n\nThe [UsePrefetchQueryOptions](../type-aliases/UsePrefetchQueryOptions.md) to use — everything you can pass to `queryClient.query`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`QueryExecuteOptions`](../interfaces/QueryExecuteOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`void`\n\n## Example\n\n```tsx\nimport { Suspense } from 'react'\nimport { usePrefetchQuery } from '@tanstack/react-query'\n\nfunction App() {\n  // Fire the prefetch during render, before the suspense boundary below.\n  usePrefetchQuery({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  })\n\n  return (\n    <Suspense fallback={<h1>Loading posts...</h1>}>\n      <Posts />\n    </Suspense>\n  )\n}\n```\n"}
