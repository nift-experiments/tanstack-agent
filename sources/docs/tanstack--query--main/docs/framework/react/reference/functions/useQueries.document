ext","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">, "},{"type":"inlineCode","value":"GetUseQueryResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ... "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : ["},{"type":"inlineCode","value":"...{ [K in (...)]: (...) }[]"},{"type":"text","value":"] : { [K in string | number | symbol]: GetUseQueryResult<T[K]> }) => "},{"type":"inlineCode","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible."}]},{"type":"heading","depth":4,"id":"queries","children":[{"type":"text","value":"queries"}]},{"type":"paragraph","children":[{"type":"text","value":"| readonly ["},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseQueryOptionsForUseQueries"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetUseQueryOptionsForUseQueries"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">, "},{"type":"inlineCode","value":"GetUseQueryOptionsForUseQueries"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ... "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : readonly ...[] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] : ... "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"T"},{"type":"text","value":" ? "},{"type":"inlineCode","value":"T"},{"type":"text","value":" : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"UseQueryOptionsForUseQueries"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">[] ? "},{"type":"inlineCode","value":"UseQueryOptionsForUseQueries"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">[] : "},{"type":"inlineCode","value":"UseQueryOptionsForUseQueries"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", readonly ...[]>[]]\n| readonly [{ [K in string | number | symbol]: GetUseQueryOptionsForUseQueries<T[K]> }]"}]},{"type":"paragraph","children":[{"type":"text","value":"An array with query option objects, mostly identical to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" — except that "},{"type":"inlineCode","value":"queryClient"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"subscribed"},{"type":"text","value":" aren't accepted per-query ("},{"type":"inlineCode","value":"subscribed"},{"type":"text","value":" is a top-level option here instead), and\n"},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" accepts a "},{"type":"link","href":"../type-aliases/QueriesPlaceholderDataFunction.md","children":[{"type":"text","value":"QueriesPlaceholderDataFunction"}]},{"type":"text","value":", which is called with "},{"type":"inlineCode","value":"previousData"},{"type":"text","value":"\nand "},{"type":"inlineCode","value":"previousQuery"},{"type":"text","value":" always "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", rather than "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":"'s placeholder function."}]},{"type":"heading","depth":4,"id":"subscribed","children":[{"type":"text","value":"subscribed?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"paragraph","children":[{"type":"text","value":"Set this to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" to unsubscribe this observer from updates to the query cache."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Default Value"}]}]},{"type":"code","value":"true","lang":"ts"},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to provide a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"type":"text","value":"The combined result. Without "},{"type":"inlineCode","value":"combine"},{"type":"text","value":", this is an array with all the query results, in the same\norder as the input. When "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" is provided, this is the value returned by "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" instead."}]},{"type":"heading","depth":2,"id":"throws","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"The error of the first query that should be thrown to the nearest error boundary (see\n"},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":"). While suspending, it throws a promise instead."}]},{"type":"heading","depth":2,"id":"remarks","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" function only re-runs if it changed referentially, or if any of the query results\nchanged. An inlined "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" function, as shown in the example below, therefore runs on every render — wrap\nit in "},{"type":"inlineCode","value":"useCallback"},{"type":"text","value":", or extract it to a stable function reference if it doesn't have any dependencies, to\navoid that."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":" cannot infer the "},{"type":"inlineCode","value":"data"},{"type":"text","value":" argument of an "},{"type":"emphasis","children":[{"type":"text","value":"inline"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"select"},{"type":"text","value":" from its sibling\n"},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":". Because "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":" infers the type of the whole "},{"type":"inlineCode","value":"queries"},{"type":"text","value":" array at once, the "},{"type":"inlineCode","value":"select"},{"type":"text","value":" parameter\nof a query object written inline cannot be contextually typed from that same object's "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":", so it falls\nback to "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" — a "},{"type":"link","href":"https://github.com/TanStack/query/issues/6556","children":[{"type":"text","value":"known TypeScript limitation"}]},{"type":"text","value":". Annotate\nthe "},{"type":"inlineCode","value":"select"},{"type":"text","value":" parameter explicitly, or define the query with "},{"type":"link","href":"queryOptions.md","children":[{"type":"text","value":"queryOptions"}]},{"type":"text","value":", which resolves its types in\na single object "},{"type":"emphasis","children":[{"type":"text","value":"before"}]},{"type":"text","value":" it reaches "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":", to work around this — see the example below. The same\nlimitation applies to "},{"type":"link","href":"useSuspenseQueries.md","children":[{"type":"text","value":"useSuspenseQueries"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" is supported here too, but unlike "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", it doesn't receive information from\npreviously rendered queries, because the number of queries can differ between renders."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { useQueries } from '@tanstack/react-query'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  const postQueries = useQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n      staleTime: Infinity,\n    })),\n  })\n\n  return (\n    <ul>\n      {postQueries.map((query, index) => {\n        if (query.isPending) return <li key={ids[index]}>Loading...</li>\n        if (query.isError) return <li key={ids[index]}>Error: {query.error.message}</li>\n        return <li key={ids[index]}>{query.data.title}</li>\n      })}\n    </ul>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Combining results into a single value:"}]},{"type":"code","value":"import { useQueries } from '@tanstack/react-query'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  const { data, isPending, isError } = useQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n    combine: (postQueries) => {\n      return {\n        data: postQueries.map((query) => query.data),\n        isPending: postQueries.some((query) => query.isPending),\n        isError: postQueries.some((query) => query.isError),\n      }\n    },\n  })\n\n  if (isPending) return 'Loading...'\n  if (isError) return 'Error loading posts'\n\n  return (\n    <ul>\n      {data.map((post) => (\n        <li key={post?.id}>{post?.title}</li>\n      ))}\n    </ul>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Typing "},{"type":"inlineCode","value":"select"},{"type":"text","value":" via "},{"type":"link","href":"queryOptions.md","children":[{"type":"text","value":"queryOptions"}]},{"type":"text","value":". Note that spreading a "},{"type":"inlineCode","value":"queryOptions"},{"type":"text","value":" result and overriding\n"},{"type":"inlineCode","value":"select"},{"type":"text","value":" inline still falls back to "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" — wrap the spread in "},{"type":"inlineCode","value":"queryOptions"},{"type":"text","value":" again so the override is\nresolved before it reaches "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":":"}]},{"type":"code","value":"import { queryOptions, useQueries } from '@tanstack/react-query'\n\nconst postOptions = (id: number) =>\n  queryOptions({\n    queryKey: ['post', id],\n    queryFn: () => fetchPost(id),\n  })\n\nfunction PostTitle({ id }: { id: number }) {\n  const [{ data: broken }] = useQueries({\n    queries: [\n      {\n        ...postOptions(id),\n        // ❌ `data` is `unknown` here\n        select: (data) => data.title,\n      },\n    ],\n  })\n\n  const [{ data: fixed }] = useQueries({\n    queries: [\n      queryOptions({\n        ...postOptions(id),\n        // ✅ `data` is `Post`\n        select: (data) => data.title,\n      }),\n    ],\n  })\n\n  return <h1>{fixed}</h1>\n}","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"tcombinedresult","text":"TCombinedResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"combine","text":"combine?","level":4},{"id":"queries","text":"queries","level":4},{"id":"subscribed","text":"subscribed?","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"throws","text":"Throws","level":2},{"id":"remarks","text":"Remarks","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\n```\n\nDefined in: [packages/react-query/src/useQueries.ts:356](https://github.com/TanStack/query/blob/main/packages/react-query/src/useQueries.ts#L356)\n\nThe `useQueries` hook can be used to fetch a variable number of queries.\n\nThe `queries` key accepts an array with query option objects mostly identical to `useQuery` — the top-level\n`subscribed` option isn't accepted per query (see `placeholderData` below for another difference). A custom\n`QueryClient` is supplied once, as `useQueries`' own top-level second argument, rather than per query.\n\nHaving the same query key more than once in the array of query objects may cause some data to be shared\nbetween queries. To avoid this, consider de-duplicating the queries and map the results back to the desired\nstructure.\n\nThe `combine` option can be used to combine the results of the queries into a single value. The result will\nbe structurally shared to be as referentially stable as possible.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `any`[]\n\n### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<T\\[K\\]\\> \\}\n\n## Parameters\n\n### options\n\nThe `queries` array to run, and the optional `combine` and `subscribed` options.\n\n#### combine?\n\n(`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`\n\nUse this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible.\n\n#### queries\n\n  \\| readonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseQueryOptionsForUseQueries`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryOptionsForUseQueries`\\<`Head`\\>, `GetUseQueryOptionsForUseQueries`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : readonly ...[] *extends* \\[`...(...)[]`\\] ? \\[`...(...)[]`\\] : ... *extends* ... ? ... : ... : readonly `unknown`[] *extends* `T` ? `T` : `T` *extends* `UseQueryOptionsForUseQueries`\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] ? `UseQueryOptionsForUseQueries`\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] : `UseQueryOptionsForUseQueries`\\<`unknown`, `Error`, `unknown`, readonly ...[]\\>[]\\]\n  \\| readonly \\[\\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryOptionsForUseQueries\\<T\\[K\\]\\> \\}\\]\n\nAn array with query option objects, mostly identical to `useQuery` — except that `queryClient` and\n`subscribed` aren't accepted per-query (`subscribed` is a top-level option here instead), and\n`placeholderData` accepts a [QueriesPlaceholderDataFunction](../type-aliases/QueriesPlaceholderDataFunction.md), which is called with `previousData`\nand `previousQuery` always `undefined`, rather than `useQuery`'s placeholder function.\n\n#### subscribed?\n\n`boolean`\n\nSet this to `false` to unsubscribe this observer from updates to the query cache.\n\n**Default Value**\n\n```ts\ntrue\n```\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to provide a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n## Returns\n\n`TCombinedResult`\n\nThe combined result. Without `combine`, this is an array with all the query results, in the same\norder as the input. When `combine` is provided, this is the value returned by `combine` instead.\n\n## Throws\n\nThe error of the first query that should be thrown to the nearest error boundary (see\n`throwOnError`). While suspending, it throws a promise instead.\n\n## Remarks\n\nThe `combine` function only re-runs if it changed referentially, or if any of the query results\nchanged. An inlined `combine` function, as shown in the example below, therefore runs on every render — wrap\nit in `useCallback`, or extract it to a stable function reference if it doesn't have any dependencies, to\navoid that.\n\nUnlike `useQuery`, `useQueries` cannot infer the `data` argument of an _inline_ `select` from its sibling\n`queryFn`. Because `useQueries` infers the type of the whole `queries` array at once, the `select` parameter\nof a query object written inline cannot be contextually typed from that same object's `queryFn`, so it falls\nback to `unknown` — a [known TypeScript limitation](https://github.com/TanStack/query/issues/6556). Annotate\nthe `select` parameter explicitly, or define the query with [queryOptions](queryOptions.md), which resolves its types in\na single object _before_ it reaches `useQueries`, to work around this — see the example below. The same\nlimitation applies to [useSuspenseQueries](useSuspenseQueries.md).\n\n`placeholderData` is supported here too, but unlike `useQuery`, it doesn't receive information from\npreviously rendered queries, because the number of queries can differ between renders.\n\n## Examples\n\n```tsx\nimport { useQueries } from '@tanstack/react-query'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  const postQueries = useQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n      staleTime: Infinity,\n    })),\n  })\n\n  return (\n    <ul>\n      {postQueries.map((query, index) => {\n        if (query.isPending) return <li key={ids[index]}>Loading...</li>\n        if (query.isError) return <li key={ids[index]}>Error: {query.error.message}</li>\n        return <li key={ids[index]}>{query.data.title}</li>\n      })}\n    </ul>\n  )\n}\n```\n\nCombining results into a single value:\n```tsx\nimport { useQueries } from '@tanstack/react-query'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  const { data, isPending, isError } = useQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n    combine: (postQueries) => {\n      return {\n        data: postQueries.map((query) => query.data),\n        isPending: postQueries.some((query) => query.isPending),\n        isError: postQueries.some((query) => query.isError),\n      }\n    },\n  })\n\n  if (isPending) return 'Loading...'\n  if (isError) return 'Error loading posts'\n\n  return (\n    <ul>\n      {data.map((post) => (\n        <li key={post?.id}>{post?.title}</li>\n      ))}\n    </ul>\n  )\n}\n```\n\nTyping `select` via [queryOptions](queryOptions.md). Note that spreading a `queryOptions` result and overriding\n`select` inline still falls back to `unknown` — wrap the spread in `queryOptions` again so the override is\nresolved before it reaches `useQueries`:\n```tsx\nimport { queryOptions, useQueries } from '@tanstack/react-query'\n\nconst postOptions = (id: number) =>\n  queryOptions({\n    queryKey: ['post', id],\n    queryFn: () => fetchPost(id),\n  })\n\nfunction PostTitle({ id }: { id: number }) {\n  const [{ data: broken }] = useQueries({\n    queries: [\n      {\n        ...postOptions(id),\n        // ❌ `data` is `unknown` here\n        select: (data) => data.title,\n      },\n    ],\n  })\n\n  const [{ data: fixed }] = useQueries({\n    queries: [\n      queryOptions({\n        ...postOptions(id),\n        // ✅ `data` is `Post`\n        select: (data) => data.title,\n      }),\n    ],\n  })\n\n  return <h1>{fixed}</h1>\n}\n```\n","originalRawMarkdown":"---\nid: useQueries\ntitle: useQueries\nredirect_from:\n  - framework/react/reference/useQueries\n---\n\n```ts\nfunction useQueries<T, TCombinedResult>(options: object, queryClient?: QueryClient): TCombinedResult;\n```\n\nDefined in: [packages/react-query/src/useQueries.ts:356](https://github.com/TanStack/query/blob/main/packages/react-query/src/useQueries.ts#L356)\n\nThe `useQueries` hook can be used to fetch a variable number of queries.\n\nThe `queries` key accepts an array with query option objects mostly identical to `useQuery` — the top-level\n`subscribed` option isn't accepted per query (see `placeholderData` below for another difference). A custom\n`QueryClient` is supplied once, as `useQueries`' own top-level second argument, rather than per query.\n\nHaving the same query key more than once in the array of query objects may cause some data to be shared\nbetween queries. To avoid this, consider de-duplicating the queries and map the results back to the desired\nstructure.\n\nThe `combine` option can be used to combine the results of the queries into a single value. The result will\nbe structurally shared to be as referentially stable as possible.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `any`[]\n\n### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<T\\[K\\]\\> \\}\n\n## Parameters\n\n### options\n\nThe `queries` array to run, and the optional `combine` and `subscribed` options.\n\n#### combine?\n\n(`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`\n\nUse this to combine the results of the queries into a single value. The result will be structurally\nshared to be as referentially stable as possible.\n\n#### queries\n\n  \\| readonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseQueryOptionsForUseQueries`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryOptionsForUseQueries`\\<`Head`\\>, `GetUseQueryOptionsForUseQueries`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : readonly ...[] *extends* \\[`...(...)[]`\\] ? \\[`...(...)[]`\\] : ... *extends* ... ? ... : ... : readonly `unknown`[] *extends* `T` ? `T` : `T` *extends* `UseQueryOptionsForUseQueries`\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] ? `UseQueryOptionsForUseQueries`\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>[] : `UseQueryOptionsForUseQueries`\\<`unknown`, `Error`, `unknown`, readonly ...[]\\>[]\\]\n  \\| readonly \\[\\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryOptionsForUseQueries\\<T\\[K\\]\\> \\}\\]\n\nAn array with query option objects, mostly identical to `useQuery` — except that `queryClient` and\n`subscribed` aren't accepted per-query (`subscribed` is a top-level option here instead), and\n`placeholderData` accepts a [QueriesPlaceholderDataFunction](../type-aliases/QueriesPlaceholderDataFunction.md), which is called with `previousData`\nand `previousQuery` always `undefined`, rather than `useQuery`'s placeholder function.\n\n#### subscribed?\n\n`boolean`\n\nSet this to `false` to unsubscribe this observer from updates to the query cache.\n\n**Default Value**\n\n```ts\ntrue\n```\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to provide a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n## Returns\n\n`TCombinedResult`\n\nThe combined result. Without `combine`, this is an array with all the query results, in the same\norder as the input. When `combine` is provided, this is the value returned by `combine` instead.\n\n## Throws\n\nThe error of the first query that should be thrown to the nearest error boundary (see\n`throwOnError`). While suspending, it throws a promise instead.\n\n## Remarks\n\nThe `combine` function only re-runs if it changed referentially, or if any of the query results\nchanged. An inlined `combine` function, as shown in the example below, therefore runs on every render — wrap\nit in `useCallback`, or extract it to a stable function reference if it doesn't have any dependencies, to\navoid that.\n\nUnlike `useQuery`, `useQueries` cannot infer the `data` argument of an _inline_ `select` from its sibling\n`queryFn`. Because `useQueries` infers the type of the whole `queries` array at once, the `select` parameter\nof a query object written inline cannot be contextually typed from that same object's `queryFn`, so it falls\nback to `unknown` — a [known TypeScript limitation](https://github.com/TanStack/query/issues/6556). Annotate\nthe `select` parameter explicitly, or define the query with [queryOptions](queryOptions.md), which resolves its types in\na single object _before_ it reaches `useQueries`, to work around this — see the example below. The same\nlimitation applies to [useSuspenseQueries](useSuspenseQueries.md).\n\n`placeholderData` is supported here too, but unlike `useQuery`, it doesn't receive information from\npreviously rendered queries, because the number of queries can differ between renders.\n\n## Examples\n\n```tsx\nimport { useQueries } from '@tanstack/react-query'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  const postQueries = useQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n      staleTime: Infinity,\n    })),\n  })\n\n  return (\n    <ul>\n      {postQueries.map((query, index) => {\n        if (query.isPending) return <li key={ids[index]}>Loading...</li>\n        if (query.isError) return <li key={ids[index]}>Error: {query.error.message}</li>\n        return <li key={ids[index]}>{query.data.title}</li>\n      })}\n    </ul>\n  )\n}\n```\n\nCombining results into a single value:\n```tsx\nimport { useQueries } from '@tanstack/react-query'\n\nfunction Posts({ ids }: { ids: Array<number> }) {\n  const { data, isPending, isError } = useQueries({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n    combine: (postQueries) => {\n      return {\n        data: postQueries.map((query) => query.data),\n        isPending: postQueries.some((query) => query.isPending),\n        isError: postQueries.some((query) => query.isError),\n      }\n    },\n  })\n\n  if (isPending) return 'Loading...'\n  if (isError) return 'Error loading posts'\n\n  return (\n    <ul>\n      {data.map((post) => (\n        <li key={post?.id}>{post?.title}</li>\n      ))}\n    </ul>\n  )\n}\n```\n\nTyping `select` via [queryOptions](queryOptions.md). Note that spreading a `queryOptions` result and overriding\n`select` inline still falls back to `unknown` — wrap the spread in `queryOptions` again so the override is\nresolved before it reaches `useQueries`:\n```tsx\nimport { queryOptions, useQueries } from '@tanstack/react-query'\n\nconst postOptions = (id: number) =>\n  queryOptions({\n    queryKey: ['post', id],\n    queryFn: () => fetchPost(id),\n  })\n\nfunction PostTitle({ id }: { id: number }) {\n  const [{ data: broken }] = useQueries({\n    queries: [\n      {\n        ...postOptions(id),\n        // ❌ `data` is `unknown` here\n        select: (data) => data.title,\n      },\n    ],\n  })\n\n  const [{ data: fixed }] = useQueries({\n    queries: [\n      queryOptions({\n        ...postOptions(id),\n        // ✅ `data` is `Post`\n        select: (data) => data.title,\n      }),\n    ],\n  })\n\n  return <h1>{fixed}</h1>\n}\n```\n"}
