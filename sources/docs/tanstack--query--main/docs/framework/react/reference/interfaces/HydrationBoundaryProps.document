Code","value":"HydrateOptions"}]},{"type":"text","value":", "},{"type":"inlineCode","value":"\"defaultOptions\""},{"type":"text","value":"> & "},{"type":"inlineCode","value":"object"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional. Note: unlike "},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":", "},{"type":"inlineCode","value":"mutations"},{"type":"text","value":" cannot be set here."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-queryclient\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"queryClient?"}]},{"type":"tableCell","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will be used."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-state\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"state"}]},{"type":"tableCell","children":[{"type":"link","href":"DehydratedState.md","children":[{"type":"inlineCode","value":"DehydratedState"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The state to hydrate."}]}]]}],"headings":[{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/react-query/src/HydrationBoundary.tsx:16](https://github.com/TanStack/query/blob/main/packages/react-query/src/HydrationBoundary.tsx#L16)\n\nThe props accepted by `HydrationBoundary`.\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-children\"></a> `children?` | `ReactNode` | The components to render — always rendered unconditionally, not gated on hydration. New queries are hydrated into the cache during render; for queries that already exist in the cache, only newer dehydrated data is hydrated, and that happens in an effect after commit, so `children` may render briefly before it lands. |\n| <a id=\"property-options\"></a> `options?` | [`OmitKeyof`](../type-aliases/OmitKeyof.md)\\<[`HydrateOptions`](HydrateOptions.md), `\"defaultOptions\"`\\> & `object` | Optional. Note: unlike `hydrate`, `mutations` cannot be set here. |\n| <a id=\"property-queryclient\"></a> `queryClient?` | [`QueryClient`](../classes/QueryClient.md) | Use this to use a custom `QueryClient`. Otherwise, the one from the nearest context will be used. |\n| <a id=\"property-state\"></a> `state` | [`DehydratedState`](DehydratedState.md) \\| `null` \\| `undefined` | The state to hydrate. |\n","originalRawMarkdown":"---\nid: HydrationBoundaryProps\ntitle: HydrationBoundaryProps\n---\n\nDefined in: [packages/react-query/src/HydrationBoundary.tsx:16](https://github.com/TanStack/query/blob/main/packages/react-query/src/HydrationBoundary.tsx#L16)\n\nThe props accepted by `HydrationBoundary`.\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-children\"></a> `children?` | `ReactNode` | The components to render — always rendered unconditionally, not gated on hydration. New queries are hydrated into the cache during render; for queries that already exist in the cache, only newer dehydrated data is hydrated, and that happens in an effect after commit, so `children` may render briefly before it lands. |\n| <a id=\"property-options\"></a> `options?` | [`OmitKeyof`](../type-aliases/OmitKeyof.md)\\<[`HydrateOptions`](HydrateOptions.md), `\"defaultOptions\"`\\> & `object` | Optional. Note: unlike `hydrate`, `mutations` cannot be set here. |\n| <a id=\"property-queryclient\"></a> `queryClient?` | [`QueryClient`](../classes/QueryClient.md) | Use this to use a custom `QueryClient`. Otherwise, the one from the nearest context will be used. |\n| <a id=\"property-state\"></a> `state` | [`DehydratedState`](DehydratedState.md) \\| `null` \\| `undefined` | The state to hydrate. |\n"}
