neCode","value":"null"}]},{"type":"tableCell","children":[{"type":"text","value":"The error object for the mutation, if the last attempt resulted in an error. - Defaults to "},{"type":"inlineCode","value":"null"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-failurecount\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"failureCount"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The number of times the mutation function has failed for the current attempt."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-failurereason\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"failureReason"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"tableCell","children":[{"type":"text","value":"The reason the current attempt failed, as reported by the retryer."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-ispaused\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isPaused"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether the mutation is currently paused (see network mode), or is waiting for another mutation with the same "},{"type":"inlineCode","value":"scope"},{"type":"text","value":" to finish."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-status\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"status"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"error\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"pending\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"success\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"idle\""}]},{"type":"tableCell","children":[{"type":"text","value":"The status of the mutation."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-submittedat\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"submittedAt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The timestamp for when the mutation was submitted."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-variables\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"variables"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The variables the mutation was last called with."}]}]]}],"headings":[{"id":"extended-by","text":"Extended by","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tvariables","text":"TVariables","level":3},{"id":"tonmutateresult","text":"TOnMutateResult","level":3},{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/mutation.ts:30](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L30)\n\nThe raw state stored on a `Mutation` instance. This is the underlying state\nthat observer results (e.g. `MutationObserverResult`) are derived from.\n\n## Extended by\n\n- [`MutationObserverBaseResult`](MutationObserverBaseResult.md)\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\n### TVariables\n\n`TVariables` = `unknown`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-context\"></a> `context` | `TOnMutateResult` \\| `undefined` | The value returned by `onMutate`, if defined. Passed to `onSuccess`, `onError` and `onSettled` as the mutation's context. |\n| <a id=\"property-data\"></a> `data` | `TData` \\| `undefined` | The last successfully resolved data for the mutation. |\n| <a id=\"property-error\"></a> `error` | `TError` \\| `null` | The error object for the mutation, if the last attempt resulted in an error. - Defaults to `null`. |\n| <a id=\"property-failurecount\"></a> `failureCount` | `number` | The number of times the mutation function has failed for the current attempt. |\n| <a id=\"property-failurereason\"></a> `failureReason` | `TError` \\| `null` | The reason the current attempt failed, as reported by the retryer. |\n| <a id=\"property-ispaused\"></a> `isPaused` | `boolean` | Whether the mutation is currently paused (see network mode), or is waiting for another mutation with the same `scope` to finish. |\n| <a id=\"property-status\"></a> `status` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` \\| `\"idle\"` | The status of the mutation. |\n| <a id=\"property-submittedat\"></a> `submittedAt` | `number` | The timestamp for when the mutation was submitted. |\n| <a id=\"property-variables\"></a> `variables` | `TVariables` \\| `undefined` | The variables the mutation was last called with. |\n","originalRawMarkdown":"---\nid: MutationState\ntitle: MutationState\n---\n\nDefined in: [packages/query-core/src/mutation.ts:30](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutation.ts#L30)\n\nThe raw state stored on a `Mutation` instance. This is the underlying state\nthat observer results (e.g. `MutationObserverResult`) are derived from.\n\n## Extended by\n\n- [`MutationObserverBaseResult`](MutationObserverBaseResult.md)\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\n### TVariables\n\n`TVariables` = `unknown`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-context\"></a> `context` | `TOnMutateResult` \\| `undefined` | The value returned by `onMutate`, if defined. Passed to `onSuccess`, `onError` and `onSettled` as the mutation's context. |\n| <a id=\"property-data\"></a> `data` | `TData` \\| `undefined` | The last successfully resolved data for the mutation. |\n| <a id=\"property-error\"></a> `error` | `TError` \\| `null` | The error object for the mutation, if the last attempt resulted in an error. - Defaults to `null`. |\n| <a id=\"property-failurecount\"></a> `failureCount` | `number` | The number of times the mutation function has failed for the current attempt. |\n| <a id=\"property-failurereason\"></a> `failureReason` | `TError` \\| `null` | The reason the current attempt failed, as reported by the retryer. |\n| <a id=\"property-ispaused\"></a> `isPaused` | `boolean` | Whether the mutation is currently paused (see network mode), or is waiting for another mutation with the same `scope` to finish. |\n| <a id=\"property-status\"></a> `status` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` \\| `\"idle\"` | The status of the mutation. |\n| <a id=\"property-submittedat\"></a> `submittedAt` | `number` | The timestamp for when the mutation was submitted. |\n| <a id=\"property-variables\"></a> `variables` | `TVariables` \\| `undefined` | The variables the mutation was last called with. |\n"}
