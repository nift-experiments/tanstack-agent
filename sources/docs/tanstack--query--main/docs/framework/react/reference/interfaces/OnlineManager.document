ager.ts:76"}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setEventListener"},{"type":"text","value":" can be used to set a custom event listener that will\nbe used to determine the online state. The provided "},{"type":"inlineCode","value":"setup"},{"type":"text","value":" function\nreceives a "},{"type":"inlineCode","value":"setOnline"},{"type":"text","value":" callback that should be called with a "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":"\nwhenever the online state changes."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"setup","children":[{"type":"text","value":"setup"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"SetupFn"}]},{"type":"paragraph","children":[{"type":"text","value":"Receives the "},{"type":"inlineCode","value":"setOnline"},{"type":"text","value":" callback, registers the event listener, and may return\na cleanup function that is called when the listener is replaced or no longer needed."}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import NetInfo from '@react-native-community/netinfo'\nimport { onlineManager } from '@tanstack/query-core'\n\nonlineManager.setEventListener((setOnline) => {\n  return NetInfo.addEventListener((state) => {\n    setOnline(!!state.isConnected)\n  })\n})","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setonline","children":[{"type":"text","value":"setOnline()"}]},{"type":"code","value":"setOnline(online: boolean): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/onlineManager.ts#L96","children":[{"type":"text","value":"packages/query-core/src/onlineManager.ts:96"}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setOnline"},{"type":"text","value":" can be used to manually set the online state."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"online","children":[{"type":"text","value":"online"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"paragraph","children":[{"type":"text","value":"The online state."}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { onlineManager } from '@tanstack/query-core'\n\n// Set to online\nonlineManager.setOnline(true)\n\n// Set to offline\nonlineManager.setOnline(false)","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"subscribe","children":[{"type":"text","value":"subscribe()"}]},{"type":"code","value":"subscribe(listener: Listener): () => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L28","children":[{"type":"text","value":"packages/query-core/src/subscribable.ts:28"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Registers a listener to be called on every update this object notifies about. Returns a function\nthat removes the listener again — call it to stop listening. The base class never drops a listener\non its own, though some subclasses clear all of theirs in "},{"type":"inlineCode","value":"destroy()"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"listener","children":[{"type":"text","value":"listener"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Listener"}]},{"type":"paragraph","children":[{"type":"text","value":"Called on each update, with whatever the subclass passes to its subscribers."}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that removes the listener."}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const unsubscribe = subscribable.subscribe(() => {\n  // react to the update\n})\n\nunsubscribe()","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-2","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"Subscribable.subscribe","lang":"ts"}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"methods","text":"Methods","level":2},{"id":"haslisteners","text":"hasListeners()","level":3},{"id":"returns","text":"Returns","level":4},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"isonline","text":"isOnline()","level":3},{"id":"returns-2","text":"Returns","level":4},{"id":"seteventlistener","text":"setEventListener()","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"setup","text":"setup","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"setonline","text":"setOnline()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"online","text":"online","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"subscribe","text":"subscribe()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"listener","text":"listener","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"example-3","text":"Example","level":4},{"id":"inherited-from-2","text":"Inherited from","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/onlineManager.ts:15](https://github.com/TanStack/query/blob/main/packages/query-core/src/onlineManager.ts#L15)\n\nThe `OnlineManager` manages the online state within TanStack Query. It can\nbe used to change the default event listeners or to manually change the\nonline state.\n\nBy default, the `onlineManager` assumes an active network connection, and\nlistens to the `online` and `offline` events on the `window` object to\ndetect changes.\n\n## Extends\n\n- `Subscribable`\\<`Listener`\\>\n\n## Methods\n\n### hasListeners()\n\n```ts\nhasListeners(): boolean;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:43](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L43)\n\nReturns `true` while at least one listener is registered, `false` once they have all unsubscribed.\n\n#### Returns\n\n`boolean`\n\n`true` if at least one listener is registered.\n\n#### Inherited from\n\n```ts\nSubscribable.hasListeners\n```\n\n***\n\n### isOnline()\n\n```ts\nisOnline(): boolean;\n```\n\nDefined in: [packages/query-core/src/onlineManager.ts:111](https://github.com/TanStack/query/blob/main/packages/query-core/src/onlineManager.ts#L111)\n\n`isOnline` can be used to get the current online state.\n\n#### Returns\n\n`boolean`\n\n`true` if online.\n\n***\n\n### setEventListener()\n\n```ts\nsetEventListener(setup: SetupFn): void;\n```\n\nDefined in: [packages/query-core/src/onlineManager.ts:76](https://github.com/TanStack/query/blob/main/packages/query-core/src/onlineManager.ts#L76)\n\n`setEventListener` can be used to set a custom event listener that will\nbe used to determine the online state. The provided `setup` function\nreceives a `setOnline` callback that should be called with a `boolean`\nwhenever the online state changes.\n\n#### Parameters\n\n##### setup\n\n`SetupFn`\n\nReceives the `setOnline` callback, registers the event listener, and may return\na cleanup function that is called when the listener is replaced or no longer needed.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport NetInfo from '@react-native-community/netinfo'\nimport { onlineManager } from '@tanstack/query-core'\n\nonlineManager.setEventListener((setOnline) => {\n  return NetInfo.addEventListener((state) => {\n    setOnline(!!state.isConnected)\n  })\n})\n```\n\n***\n\n### setOnline()\n\n```ts\nsetOnline(online: boolean): void;\n```\n\nDefined in: [packages/query-core/src/onlineManager.ts:96](https://github.com/TanStack/query/blob/main/packages/query-core/src/onlineManager.ts#L96)\n\n`setOnline` can be used to manually set the online state.\n\n#### Parameters\n\n##### online\n\n`boolean`\n\nThe online state.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { onlineManager } from '@tanstack/query-core'\n\n// Set to online\nonlineManager.setOnline(true)\n\n// Set to offline\nonlineManager.setOnline(false)\n```\n\n***\n\n### subscribe()\n\n```ts\nsubscribe(listener: Listener): () => void;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:28](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L28)\n\nRegisters a listener to be called on every update this object notifies about. Returns a function\nthat removes the listener again — call it to stop listening. The base class never drops a listener\non its own, though some subclasses clear all of theirs in `destroy()`.\n\n#### Parameters\n\n##### listener\n\n`Listener`\n\nCalled on each update, with whatever the subclass passes to its subscribers.\n\n#### Returns\n\nA function that removes the listener.\n\n() => `void`\n\n#### Example\n\n```ts\nconst unsubscribe = subscribable.subscribe(() => {\n  // react to the update\n})\n\nunsubscribe()\n```\n\n#### Inherited from\n\n```ts\nSubscribable.subscribe\n```\n","originalRawMarkdown":"---\nid: OnlineManager\ntitle: OnlineManager\nredirect_from:\n  - reference/onlineManager\n  - framework/react/reference/onlineManager\n---\n\nDefined in: [packages/query-core/src/onlineManager.ts:15](https://github.com/TanStack/query/blob/main/packages/query-core/src/onlineManager.ts#L15)\n\nThe `OnlineManager` manages the online state within TanStack Query. It can\nbe used to change the default event listeners or to manually change the\nonline state.\n\nBy default, the `onlineManager` assumes an active network connection, and\nlistens to the `online` and `offline` events on the `window` object to\ndetect changes.\n\n## Extends\n\n- `Subscribable`\\<`Listener`\\>\n\n## Methods\n\n### hasListeners()\n\n```ts\nhasListeners(): boolean;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:43](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L43)\n\nReturns `true` while at least one listener is registered, `false` once they have all unsubscribed.\n\n#### Returns\n\n`boolean`\n\n`true` if at least one listener is registered.\n\n#### Inherited from\n\n```ts\nSubscribable.hasListeners\n```\n\n***\n\n### isOnline()\n\n```ts\nisOnline(): boolean;\n```\n\nDefined in: [packages/query-core/src/onlineManager.ts:111](https://github.com/TanStack/query/blob/main/packages/query-core/src/onlineManager.ts#L111)\n\n`isOnline` can be used to get the current online state.\n\n#### Returns\n\n`boolean`\n\n`true` if online.\n\n***\n\n### setEventListener()\n\n```ts\nsetEventListener(setup: SetupFn): void;\n```\n\nDefined in: [packages/query-core/src/onlineManager.ts:76](https://github.com/TanStack/query/blob/main/packages/query-core/src/onlineManager.ts#L76)\n\n`setEventListener` can be used to set a custom event listener that will\nbe used to determine the online state. The provided `setup` function\nreceives a `setOnline` callback that should be called with a `boolean`\nwhenever the online state changes.\n\n#### Parameters\n\n##### setup\n\n`SetupFn`\n\nReceives the `setOnline` callback, registers the event listener, and may return\na cleanup function that is called when the listener is replaced or no longer needed.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport NetInfo from '@react-native-community/netinfo'\nimport { onlineManager } from '@tanstack/query-core'\n\nonlineManager.setEventListener((setOnline) => {\n  return NetInfo.addEventListener((state) => {\n    setOnline(!!state.isConnected)\n  })\n})\n```\n\n***\n\n### setOnline()\n\n```ts\nsetOnline(online: boolean): void;\n```\n\nDefined in: [packages/query-core/src/onlineManager.ts:96](https://github.com/TanStack/query/blob/main/packages/query-core/src/onlineManager.ts#L96)\n\n`setOnline` can be used to manually set the online state.\n\n#### Parameters\n\n##### online\n\n`boolean`\n\nThe online state.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { onlineManager } from '@tanstack/query-core'\n\n// Set to online\nonlineManager.setOnline(true)\n\n// Set to offline\nonlineManager.setOnline(false)\n```\n\n***\n\n### subscribe()\n\n```ts\nsubscribe(listener: Listener): () => void;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:28](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L28)\n\nRegisters a listener to be called on every update this object notifies about. Returns a function\nthat removes the listener again — call it to stop listening. The base class never drops a listener\non its own, though some subclasses clear all of theirs in `destroy()`.\n\n#### Parameters\n\n##### listener\n\n`Listener`\n\nCalled on each update, with whatever the subclass passes to its subscribers.\n\n#### Returns\n\nA function that removes the listener.\n\n() => `void`\n\n#### Example\n\n```ts\nconst unsubscribe = subscribable.subscribe(() => {\n  // react to the update\n})\n\nunsubscribe()\n```\n\n#### Inherited from\n\n```ts\nSubscribable.subscribe\n```\n"}
