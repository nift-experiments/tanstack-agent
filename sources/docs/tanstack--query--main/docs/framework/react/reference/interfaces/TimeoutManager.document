{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L82","children":[{"type":"text","value":"packages/query-core/src/timeoutManager.ts:82"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Allows customization of how timeouts are created."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/query-core"},{"type":"text","value":" makes liberal use of timeouts to implement "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":"\nand "},{"type":"inlineCode","value":"gcTime"},{"type":"text","value":". The default TimeoutManager provider uses the platform's global\n"},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":" implementation, which is known to have scalability issues with\nthousands of timeouts on the event loop."}]},{"type":"paragraph","children":[{"type":"text","value":"If you hit this limitation, consider providing a custom TimeoutProvider that\ncoalesces timeouts."}]},{"type":"heading","depth":2,"id":"implements","children":[{"type":"text","value":"Implements"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/TimeoutProvider.md","children":[{"type":"inlineCode","value":"TimeoutProvider"}]},{"type":"text","value":", "},{"type":"inlineCode","value":"\"name\""},{"type":"text","value":">"}]}]}]},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"clearinterval","children":[{"type":"text","value":"clearInterval()"}]},{"type":"code","value":"clearInterval(intervalId: ManagedTimerId | undefined): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L240","children":[{"type":"text","value":"packages/query-core/src/timeoutManager.ts:240"}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"clearInterval"},{"type":"text","value":" can be used to cancel an interval, like the global\n"},{"type":"inlineCode","value":"clearInterval"},{"type":"text","value":" function. It should be called with an interval ID\nreturned by "},{"type":"inlineCode","value":"setInterval"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"intervalid","children":[{"type":"text","value":"intervalId"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/ManagedTimerId.md","children":[{"type":"inlineCode","value":"ManagedTimerId"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"}]},{"type":"paragraph","children":[{"type":"text","value":"The timer ID returned by "},{"type":"inlineCode","value":"setInterval"},{"type":"text","value":", or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { timeoutManager } from '@tanstack/query-core'\n\nconst intervalId = timeoutManager.setInterval(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n\ntimeoutManager.clearInterval(intervalId)","lang":"ts"},{"type":"heading","depth":4,"id":"implementation-of","children":[{"type":"text","value":"Implementation of"}]},{"type":"code","value":"Omit.clearInterval","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"cleartimeout","children":[{"type":"text","value":"clearTimeout()"}]},{"type":"c