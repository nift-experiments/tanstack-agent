","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/ManagedTimerId.md","children":[{"type":"inlineCode","value":"ManagedTimerId"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The timer ID, to pass to "},{"type":"link","href":"#clearinterval","children":[{"type":"text","value":"TimeoutManager#clearInterval"}]},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { timeoutManager } from '@tanstack/query-core'\n\nconst intervalId = timeoutManager.setInterval(\n  () => console.log('ran at:', new Date()),\n  1000,\n)","lang":"ts"},{"type":"heading","depth":4,"id":"implementation-of-3","children":[{"type":"text","value":"Implementation of"}]},{"type":"code","value":"Omit.setInterval","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"settimeout","children":[{"type":"text","value":"setTimeout()"}]},{"type":"code","value":"setTimeout(callback: TimeoutCallback, delay: number): ManagedTimerId;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L169","children":[{"type":"text","value":"packages/query-core/src/timeoutManager.ts:169"}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":" schedules a callback to run after approximately "},{"type":"inlineCode","value":"delay"},{"type":"text","value":"\nmilliseconds, like the global "},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":" function. The callback can be\ncanceled with "},{"type":"inlineCode","value":"clearTimeout"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"It returns a timer ID, which may be a number or an object that can be\ncoerced to a number via "},{"type":"inlineCode","value":"Symbol.toPrimitive"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"callback-2","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/TimeoutCallback.md","children":[{"type":"inlineCode","value":"TimeoutCallback"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The function to call when the timeout elapses."}]},{"type":"heading","depth":5,"id":"delay-2","children":[{"type":"text","value":"delay"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"paragraph","children":[{"type":"text","value":"The time to wait before calling "},{"type":"inlineCode","value":"callback"},{"type":"text","value":", in milliseconds."}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/ManagedTimerId.md","children":[{"type":"inlineCode","value":"ManagedTimerId"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The timer ID, to pass to "},{"type":"link","href":"#cleartimeout","children":[{"type":"text","value":"TimeoutManager#clearTimeout"}]},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { timeoutManager } from '@tanstack/query-core'\n\nconst timeoutId = timeoutManager.setTimeout(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n\nconst timeoutIdNumber: number = Number(timeoutId)","lang":"ts"},{"type":"heading","depth":4,"id":"implementation-of-4","children":[{"type":"text","value":"Implementation of"}]},{"type":"code","value":"Omit.setTimeout","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"settimeoutprovider","children":[{"type":"text","value":"setTimeoutProvider()"}]},{"type":"code","value":"setTimeoutProvider<TTimerId>(provider: TimeoutProvider<TTimerId>): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L118","children":[{"type":"text","value":"packages/query-core/src/timeoutManager.ts:118"}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setTimeoutProvider"},{"type":"text","value":" can be used to set a custom implementation of the\n"},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":", "},{"type":"inlineCode","value":"clearTimeout"},{"type":"text","value":", "},{"type":"inlineCode","value":"setInterval"},{"type":"text","value":", "},{"type":"inlineCode","value":"clearInterval"},{"type":"text","value":" functions,\ncalled a "},{"type":"inlineCode","value":"TimeoutProvider"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"This may be useful if you notice event loop performance issues with\nthousands of queries. A custom TimeoutProvider could also support timer\ndelays longer than the global "},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":" maximum delay value of about\n24 days."}]},{"type":"paragraph","children":[{"type":"text","value":"It is important to call "},{"type":"inlineCode","value":"setTimeoutProvider"},{"type":"text","value":" before creating a\nQueryClient or queries, so that the same provider is used consistently\nfor all timers in the application, since different TimeoutProviders\ncannot cancel each others' timers."}]},{"type":"heading","depth":4,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"ttimerid","children":[{"type":"text","value":"TTimerId"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTimerId"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/ManagedTimerId.md","children":[{"type":"inlineCode","value":"ManagedTimerId"}]}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"provider","children":[{"type":"text","value":"provider"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/TimeoutProvider.md","children":[{"type":"inlineCode","value":"TimeoutProvider"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTimerId"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"TimeoutProvider"},{"type":"text","value":" to use for all timers from now on."}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-5","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { timeoutManager, QueryClient } from '@tanstack/query-core'\nimport { CustomTimeoutProvider } from './CustomTimeoutProvider'\n\ntimeoutManager.setTimeoutProvider(new CustomTimeoutProvider())\n\nexport const queryClient = new QueryClient()","lang":"ts"}],"headings":[{"id":"implements","text":"Implements","level":2},{"id":"methods","text":"Methods","level":2},{"id":"clearinterval","text":"clearInterval()","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"intervalid","text":"intervalId","level":5},{"id":"returns","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"implementation-of","text":"Implementation of","level":4},{"id":"cleartimeout","text":"clearTimeout()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"timeoutid","text":"timeoutId","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"implementation-of-2","text":"Implementation of","level":4},{"id":"setinterval","text":"setInterval()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"callback","text":"callback","level":5},{"id":"delay","text":"delay","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"example-3","text":"Example","level":4},{"id":"implementation-of-3","text":"Implementation of","level":4},{"id":"settimeout","text":"setTimeout()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"callback-2","text":"callback","level":5},{"id":"delay-2","text":"delay","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"example-4","text":"Example","level":4},{"id":"implementation-of-4","text":"Implementation of","level":4},{"id":"settimeoutprovider","text":"setTimeoutProvider()","level":3},{"id":"type-parameters","text":"Type Parameters","level":4},{"id":"ttimerid","text":"TTimerId","level":5},{"id":"parameters-5","text":"Parameters","level":4},{"id":"provider","text":"provider","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"example-5","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/timeoutManager.ts:82](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L82)\n\nAllows customization of how timeouts are created.\n\n`@tanstack/query-core` makes liberal use of timeouts to implement `staleTime`\nand `gcTime`. The default TimeoutManager provider uses the platform's global\n`setTimeout` implementation, which is known to have scalability issues with\nthousands of timeouts on the event loop.\n\nIf you hit this limitation, consider providing a custom TimeoutProvider that\ncoalesces timeouts.\n\n## Implements\n\n- `Omit`\\<[`TimeoutProvider`](../type-aliases/TimeoutProvider.md), `\"name\"`\\>\n\n## Methods\n\n### clearInterval()\n\n```ts\nclearInterval(intervalId: ManagedTimerId | undefined): void;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:240](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L240)\n\n`clearInterval` can be used to cancel an interval, like the global\n`clearInterval` function. It should be called with an interval ID\nreturned by `setInterval`.\n\n#### Parameters\n\n##### intervalId\n\n[`ManagedTimerId`](../type-aliases/ManagedTimerId.md) \\| `undefined`\n\nThe timer ID returned by `setInterval`, or `undefined`.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { timeoutManager } from '@tanstack/query-core'\n\nconst intervalId = timeoutManager.setInterval(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n\ntimeoutManager.clearInterval(intervalId)\n```\n\n#### Implementation of\n\n```ts\nOmit.clearInterval\n```\n\n***\n\n### clearTimeout()\n\n```ts\nclearTimeout(timeoutId: ManagedTimerId | undefined): void;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:193](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L193)\n\n`clearTimeout` cancels a timeout callback scheduled with `setTimeout`,\nlike the global `clearTimeout` function. It should be called with a\ntimer ID returned by `setTimeout`.\n\n#### Parameters\n\n##### timeoutId\n\n[`ManagedTimerId`](../type-aliases/ManagedTimerId.md) \\| `undefined`\n\nThe timer ID returned by `setTimeout`, or `undefined`.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { timeoutManager } from '@tanstack/query-core'\n\nconst timeoutId = timeoutManager.setTimeout(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n\ntimeoutManager.clearTimeout(timeoutId)\n```\n\n#### Implementation of\n\n```ts\nOmit.clearTimeout\n```\n\n***\n\n### setInterval()\n\n```ts\nsetInterval(callback: TimeoutCallback, delay: number): ManagedTimerId;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:216](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L216)\n\n`setInterval` schedules a callback to be called approximately every\n`delay` milliseconds, like the global `setInterval` function.\n\nLike `setTimeout`, it returns a timer ID, which may be a number or an\nobject that can be coerced to a number via `Symbol.toPrimitive`.\n\n#### Parameters\n\n##### callback\n\n[`TimeoutCallback`](../type-aliases/TimeoutCallback.md)\n\nThe function to call on every interval.\n\n##### delay\n\n`number`\n\nThe time between calls, in milliseconds.\n\n#### Returns\n\n[`ManagedTimerId`](../type-aliases/ManagedTimerId.md)\n\nThe timer ID, to pass to [TimeoutManager#clearInterval](#clearinterval).\n\n#### Example\n\n```ts\nimport { timeoutManager } from '@tanstack/query-core'\n\nconst intervalId = timeoutManager.setInterval(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n```\n\n#### Implementation of\n\n```ts\nOmit.setInterval\n```\n\n***\n\n### setTimeout()\n\n```ts\nsetTimeout(callback: TimeoutCallback, delay: number): ManagedTimerId;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:169](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L169)\n\n`setTimeout` schedules a callback to run after approximately `delay`\nmilliseconds, like the global `setTimeout` function. The callback can be\ncanceled with `clearTimeout`.\n\nIt returns a timer ID, which may be a number or an object that can be\ncoerced to a number via `Symbol.toPrimitive`.\n\n#### Parameters\n\n##### callback\n\n[`TimeoutCallback`](../type-aliases/TimeoutCallback.md)\n\nThe function to call when the timeout elapses.\n\n##### delay\n\n`number`\n\nThe time to wait before calling `callback`, in milliseconds.\n\n#### Returns\n\n[`ManagedTimerId`](../type-aliases/ManagedTimerId.md)\n\nThe timer ID, to pass to [TimeoutManager#clearTimeout](#cleartimeout).\n\n#### Example\n\n```ts\nimport { timeoutManager } from '@tanstack/query-core'\n\nconst timeoutId = timeoutManager.setTimeout(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n\nconst timeoutIdNumber: number = Number(timeoutId)\n```\n\n#### Implementation of\n\n```ts\nOmit.setTimeout\n```\n\n***\n\n### setTimeoutProvider()\n\n```ts\nsetTimeoutProvider<TTimerId>(provider: TimeoutProvider<TTimerId>): void;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:118](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L118)\n\n`setTimeoutProvider` can be used to set a custom implementation of the\n`setTimeout`, `clearTimeout`, `setInterval`, `clearInterval` functions,\ncalled a `TimeoutProvider`.\n\nThis may be useful if you notice event loop performance issues with\nthousands of queries. A custom TimeoutProvider could also support timer\ndelays longer than the global `setTimeout` maximum delay value of about\n24 days.\n\nIt is important to call `setTimeoutProvider` before creating a\nQueryClient or queries, so that the same provider is used consistently\nfor all timers in the application, since different TimeoutProviders\ncannot cancel each others' timers.\n\n#### Type Parameters\n\n##### TTimerId\n\n`TTimerId` *extends* [`ManagedTimerId`](../type-aliases/ManagedTimerId.md)\n\n#### Parameters\n\n##### provider\n\n[`TimeoutProvider`](../type-aliases/TimeoutProvider.md)\\<`TTimerId`\\>\n\nThe `TimeoutProvider` to use for all timers from now on.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { timeoutManager, QueryClient } from '@tanstack/query-core'\nimport { CustomTimeoutProvider } from './CustomTimeoutProvider'\n\ntimeoutManager.setTimeoutProvider(new CustomTimeoutProvider())\n\nexport const queryClient = new QueryClient()\n```\n","originalRawMarkdown":"---\nid: TimeoutManager\ntitle: TimeoutManager\nredirect_from:\n  - reference/timeoutManager\n---\n\nDefined in: [packages/query-core/src/timeoutManager.ts:82](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L82)\n\nAllows customization of how timeouts are created.\n\n`@tanstack/query-core` makes liberal use of timeouts to implement `staleTime`\nand `gcTime`. The default TimeoutManager provider uses the platform's global\n`setTimeout` implementation, which is known to have scalability issues with\nthousands of timeouts on the event loop.\n\nIf you hit this limitation, consider providing a custom TimeoutProvider that\ncoalesces timeouts.\n\n## Implements\n\n- `Omit`\\<[`TimeoutProvider`](../type-aliases/TimeoutProvider.md), `\"name\"`\\>\n\n## Methods\n\n### clearInterval()\n\n```ts\nclearInterval(intervalId: ManagedTimerId | undefined): void;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:240](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L240)\n\n`clearInterval` can be used to cancel an interval, like the global\n`clearInterval` function. It should be called with an interval ID\nreturned by `setInterval`.\n\n#### Parameters\n\n##### intervalId\n\n[`ManagedTimerId`](../type-aliases/ManagedTimerId.md) \\| `undefined`\n\nThe timer ID returned by `setInterval`, or `undefined`.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { timeoutManager } from '@tanstack/query-core'\n\nconst intervalId = timeoutManager.setInterval(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n\ntimeoutManager.clearInterval(intervalId)\n```\n\n#### Implementation of\n\n```ts\nOmit.clearInterval\n```\n\n***\n\n### clearTimeout()\n\n```ts\nclearTimeout(timeoutId: ManagedTimerId | undefined): void;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:193](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L193)\n\n`clearTimeout` cancels a timeout callback scheduled with `setTimeout`,\nlike the global `clearTimeout` function. It should be called with a\ntimer ID returned by `setTimeout`.\n\n#### Parameters\n\n##### timeoutId\n\n[`ManagedTimerId`](../type-aliases/ManagedTimerId.md) \\| `undefined`\n\nThe timer ID returned by `setTimeout`, or `undefined`.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { timeoutManager } from '@tanstack/query-core'\n\nconst timeoutId = timeoutManager.setTimeout(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n\ntimeoutManager.clearTimeout(timeoutId)\n```\n\n#### Implementation of\n\n```ts\nOmit.clearTimeout\n```\n\n***\n\n### setInterval()\n\n```ts\nsetInterval(callback: TimeoutCallback, delay: number): ManagedTimerId;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:216](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L216)\n\n`setInterval` schedules a callback to be called approximately every\n`delay` milliseconds, like the global `setInterval` function.\n\nLike `setTimeout`, it returns a timer ID, which may be a number or an\nobject that can be coerced to a number via `Symbol.toPrimitive`.\n\n#### Parameters\n\n##### callback\n\n[`TimeoutCallback`](../type-aliases/TimeoutCallback.md)\n\nThe function to call on every interval.\n\n##### delay\n\n`number`\n\nThe time between calls, in milliseconds.\n\n#### Returns\n\n[`ManagedTimerId`](../type-aliases/ManagedTimerId.md)\n\nThe timer ID, to pass to [TimeoutManager#clearInterval](#clearinterval).\n\n#### Example\n\n```ts\nimport { timeoutManager } from '@tanstack/query-core'\n\nconst intervalId = timeoutManager.setInterval(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n```\n\n#### Implementation of\n\n```ts\nOmit.setInterval\n```\n\n***\n\n### setTimeout()\n\n```ts\nsetTimeout(callback: TimeoutCallback, delay: number): ManagedTimerId;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:169](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L169)\n\n`setTimeout` schedules a callback to run after approximately `delay`\nmilliseconds, like the global `setTimeout` function. The callback can be\ncanceled with `clearTimeout`.\n\nIt returns a timer ID, which may be a number or an object that can be\ncoerced to a number via `Symbol.toPrimitive`.\n\n#### Parameters\n\n##### callback\n\n[`TimeoutCallback`](../type-aliases/TimeoutCallback.md)\n\nThe function to call when the timeout elapses.\n\n##### delay\n\n`number`\n\nThe time to wait before calling `callback`, in milliseconds.\n\n#### Returns\n\n[`ManagedTimerId`](../type-aliases/ManagedTimerId.md)\n\nThe timer ID, to pass to [TimeoutManager#clearTimeout](#cleartimeout).\n\n#### Example\n\n```ts\nimport { timeoutManager } from '@tanstack/query-core'\n\nconst timeoutId = timeoutManager.setTimeout(\n  () => console.log('ran at:', new Date()),\n  1000,\n)\n\nconst timeoutIdNumber: number = Number(timeoutId)\n```\n\n#### Implementation of\n\n```ts\nOmit.setTimeout\n```\n\n***\n\n### setTimeoutProvider()\n\n```ts\nsetTimeoutProvider<TTimerId>(provider: TimeoutProvider<TTimerId>): void;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:118](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L118)\n\n`setTimeoutProvider` can be used to set a custom implementation of the\n`setTimeout`, `clearTimeout`, `setInterval`, `clearInterval` functions,\ncalled a `TimeoutProvider`.\n\nThis may be useful if you notice event loop performance issues with\nthousands of queries. A custom TimeoutProvider could also support timer\ndelays longer than the global `setTimeout` maximum delay value of about\n24 days.\n\nIt is important to call `setTimeoutProvider` before creating a\nQueryClient or queries, so that the same provider is used consistently\nfor all timers in the application, since different TimeoutProviders\ncannot cancel each others' timers.\n\n#### Type Parameters\n\n##### TTimerId\n\n`TTimerId` *extends* [`ManagedTimerId`](../type-aliases/ManagedTimerId.md)\n\n#### Parameters\n\n##### provider\n\n[`TimeoutProvider`](../type-aliases/TimeoutProvider.md)\\<`TTimerId`\\>\n\nThe `TimeoutProvider` to use for all timers from now on.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { timeoutManager, QueryClient } from '@tanstack/query-core'\nimport { CustomTimeoutProvider } from './CustomTimeoutProvider'\n\ntimeoutManager.setTimeoutProvider(new CustomTimeoutProvider())\n\nexport const queryClient = new QueryClient()\n```\n"}
