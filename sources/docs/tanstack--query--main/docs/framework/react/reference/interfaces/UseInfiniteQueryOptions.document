pe":"tableCell","children":[{"type":"text","value":"If set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", the query will refetch on mount if the data is stale. If set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":", will disable additional instances of a query to trigger background refetch. If set to "},{"type":"inlineCode","value":"'always'"},{"type":"text","value":", the query will always refetch on mount (except when "},{"type":"inlineCode","value":"staleTime: 'static'"},{"type":"text","value":" is used). If set to a function, the function will be executed with the latest data and query to compute the value"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-refetchonreconnect\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"refetchOnReconnect?"}]},{"type":"tableCell","children":[{"type":"text","value":"| "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"always\""},{"type":"text","value":" | (("},{"type":"inlineCode","value":"query"},{"type":"text","value":": "},{"type":"link","href":"../classes/Query.md","children":[{"type":"inlineCode","value":"Query"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"link","href":"InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">) => "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"always\""},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"If set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", the query will refetch on reconnect if the data is stale. If set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":", the query will not refetch on reconnect. If set to "},{"type":"inlineCode","value":"'always'"},{"type":"text","value":", the query will always refetch on reconnect (except when "},{"type":"inlineCode","value":"staleTime: 'static'"},{"type":"text","value":" is used). If set to a function, the function will be executed with the latest data and query to compute the value. Defaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" unless "},{"type":"inlineCode","value":"networkMode"},{"type":"text","value":" is "},{"type":"inlineCode","value":"'always'"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-refetchonwindowfocus\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"refetchOnWindowFocus?"}]},{"type":"tableCell","children":[{"type":"text","value":"| "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"always\""},{"type":"text","value":" | (("},{"type":"inlineCode","value":"query"},{"type":"text","value":": "},{"type":"link","href":"../classes/Query.md","children":[{"type":"inlineCode","value":"Query"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"link","href":"InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">) => "},{"type":"inlineC