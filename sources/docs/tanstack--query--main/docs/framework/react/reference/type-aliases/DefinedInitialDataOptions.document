,"value":"staleTime"},{"type":"text","value":" has been set. "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" "},{"type":"strong","children":[{"type":"text","value":"is persisted"}]},{"type":"text","value":" to the\ncache."}]},{"type":"heading","depth":3,"id":"queryfn","children":[{"type":"text","value":"queryFn?"}]},{"type":"code","value":"optional queryFn?: QueryFunction<TQueryFnData, TQueryKey>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Optional here, but omitting it is only safe when no fetch will be attempted — for example with\n"},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":", or when a default query function has been defined. Otherwise, an enabled query with no\n"},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" still tries to fetch and fails with a \"Missing queryFn\" error; "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" does not prevent this."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tqueryfndata","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"paragraph","children":[{"type":"text","value":"The type your "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" resolves to."}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"link","href":"DefaultError.md","children":[{"type":"inlineCode","value":"DefaultError"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of errors your "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" may throw."}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"text","value":"The type "},{"type":"inlineCode","value":"data"},{"type":"text","value":" ends up as after "},{"type":"inlineCode","value":"select"},{"type":"text","value":" runs."}]},{"type":"heading","depth":3,"id":"tquerykey","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"QueryKey.md","children":[{"type":"inlineCode","value":"QueryKey"}]},{"type":"text","value":" = "},{"type":"link","href":"QueryKey.md","children":[{"type":"inlineCode","value":"QueryKey"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of your "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":"."}]}],"headings":[{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"initialdata","text":"initialData","level":3},{"id":"queryfn","text":"queryFn?","level":3},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tqueryfndata","text":"TQueryFnData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tquerykey","text":"TQueryKey","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> = Omit<UseQueryOptions<TQueryFnData, TError, TData, TQueryKey>, \"queryFn\"> & object;\n```\n\nDefined in: [packages/react-query/src/queryOptions.ts:77](https://github.com/TanStack/query/blob/main/packages/react-query/src/queryOptions.ts#L77)\n\nThe options accepted by the `queryOptions` overload selected when `initialData` is set — `data` is never\n`undefined` (unless a `select` changes `TData` to include `undefined`).\n\n## Type Declaration\n\n### initialData\n\n```ts\ninitialData: \n  | NonUndefinedGuard<TQueryFnData>\n  | (() => NonUndefinedGuard<TQueryFnData>);\n```\n\nIf set, this value will be used as the initial data for the query cache (as long as the query hasn't been\ncreated or cached yet). If set to a function, the function will be called **once** during the shared/root\nquery initialization, and be expected to synchronously return the initial data. Initial data is\nconsidered stale by default unless a `staleTime` has been set. `initialData` **is persisted** to the\ncache.\n\n### queryFn?\n\n```ts\noptional queryFn?: QueryFunction<TQueryFnData, TQueryKey>;\n```\n\nOptional here, but omitting it is only safe when no fetch will be attempted — for example with\n`enabled: false`, or when a default query function has been defined. Otherwise, an enabled query with no\n`queryFn` still tries to fetch and fails with a \"Missing queryFn\" error; `initialData` does not prevent this.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\nThe type your `queryFn` resolves to.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n### TData\n\n`TData` = `TQueryFnData`\n\nThe type `data` ends up as after `select` runs.\n\n### TQueryKey\n\n`TQueryKey` *extends* [`QueryKey`](QueryKey.md) = [`QueryKey`](QueryKey.md)\n\nThe type of your `queryKey`.\n","originalRawMarkdown":"---\nid: DefinedInitialDataOptions\ntitle: DefinedInitialDataOptions\n---\n\n```ts\ntype DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> = Omit<UseQueryOptions<TQueryFnData, TError, TData, TQueryKey>, \"queryFn\"> & object;\n```\n\nDefined in: [packages/react-query/src/queryOptions.ts:77](https://github.com/TanStack/query/blob/main/packages/react-query/src/queryOptions.ts#L77)\n\nThe options accepted by the `queryOptions` overload selected when `initialData` is set — `data` is never\n`undefined` (unless a `select` changes `TData` to include `undefined`).\n\n## Type Declaration\n\n### initialData\n\n```ts\ninitialData: \n  | NonUndefinedGuard<TQueryFnData>\n  | (() => NonUndefinedGuard<TQueryFnData>);\n```\n\nIf set, this value will be used as the initial data for the query cache (as long as the query hasn't been\ncreated or cached yet). If set to a function, the function will be called **once** during the shared/root\nquery initialization, and be expected to synchronously return the initial data. Initial data is\nconsidered stale by default unless a `staleTime` has been set. `initialData` **is persisted** to the\ncache.\n\n### queryFn?\n\n```ts\noptional queryFn?: QueryFunction<TQueryFnData, TQueryKey>;\n```\n\nOptional here, but omitting it is only safe when no fetch will be attempted — for example with\n`enabled: false`, or when a default query function has been defined. Otherwise, an enabled query with no\n`queryFn` still tries to fetch and fails with a \"Missing queryFn\" error; `initialData` does not prevent this.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\nThe type your `queryFn` resolves to.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n### TData\n\n`TData` = `TQueryFnData`\n\nThe type `data` ends up as after `select` runs.\n\n### TQueryKey\n\n`TQueryKey` *extends* [`QueryKey`](QueryKey.md) = [`QueryKey`](QueryKey.md)\n\nThe type of your `queryKey`.\n"}
