"value":" runs."}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"link","href":"DefaultError.md","children":[{"type":"inlineCode","value":"DefaultError"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of errors your "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" may throw."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype DefinedUseQueryResult<TData, TError> = DefinedQueryObserverResult<TData, TError>;\n```\n\nDefined in: [packages/react-query/src/types.ts:340](https://github.com/TanStack/query/blob/main/packages/react-query/src/types.ts#L340)\n\nThe result of `useQuery` when `initialData` is set, or of `useSuspenseQuery` before the `isPlaceholderData`\nomission — `data` is never `undefined` (unless a `select` changes `TData` to include `undefined`).\nRe-exports [DefinedQueryObserverResult](DefinedQueryObserverResult.md) from `@tanstack/query-core`.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type `data` ends up as after `select` runs.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n","originalRawMarkdown":"---\nid: DefinedUseQueryResult\ntitle: DefinedUseQueryResult\n---\n\n```ts\ntype DefinedUseQueryResult<TData, TError> = DefinedQueryObserverResult<TData, TError>;\n```\n\nDefined in: [packages/react-query/src/types.ts:340](https://github.com/TanStack/query/blob/main/packages/react-query/src/types.ts#L340)\n\nThe result of `useQuery` when `initialData` is set, or of `useSuspenseQuery` before the `isPlaceholderData`\nomission — `data` is never `undefined` (unless a `select` changes `TData` to include `undefined`).\nRe-exports [DefinedQueryObserverResult](DefinedQueryObserverResult.md) from `@tanstack/query-core`.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type `data` ends up as after `select` runs.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n"}
