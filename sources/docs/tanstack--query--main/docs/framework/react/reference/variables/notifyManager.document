tifyCallback) => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Schedules a function to be run on the next batch.\nBy default, the batch is run with a "},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":", but this can be configured via "},{"type":"inlineCode","value":"setScheduler"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"callback-3","children":[{"type":"text","value":"callback"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"NotifyCallback"}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"setbatchnotifyfunction","children":[{"type":"text","value":"setBatchNotifyFunction"}]},{"type":"code","value":"readonly setBatchNotifyFunction: (fn: BatchNotifyFunction) => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Use this method to set a custom function to batch notifications together into a single tick.\nFramework adapters use this to plug in their own batching primitive, so that a single query\nupdate only triggers one re-render instead of one per subscriber."}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"fn","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"BatchNotifyFunction"}]},{"type":"paragraph","children":[{"type":"text","value":"Receives a function that runs a batch of notifications and must call it."}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { notifyManager } from '@tanstack/query-core'\nimport { batch } from 'solid-js'\n\nnotifyManager.setBatchNotifyFunction(batch)","lang":"ts"},{"type":"heading","depth":3,"id":"setnotifyfunction","children":[{"type":"text","value":"setNotifyFunction"}]},{"type":"code","value":"readonly setNotifyFunction: (fn: NotifyFunction) => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Use this method to set a custom notify function.\nThis can be used to for example wrap notifications with "},{"type":"inlineCode","value":"React.act"},{"type":"text","value":" while running tests."}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"fn-2","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"NotifyFunction"}]},{"type":"paragraph","children":[{"type":"text","value":"Receives each notification callback and must call it."}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"setscheduler","children":[{"type":"text","value":"setScheduler"}]},{"type":"code","value":"readonly setScheduler: (fn: ScheduleFunction) => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Configures a custom callback that schedules when the next batch runs.\nThe default behavior is "},{"type":"inlineCode","value":"setTimeout(callback, 0)"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"parameters-6","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"fn-3","children":[{"type":"text","value":"fn"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ScheduleFunction"}]},{"type":"paragraph","children":[{"type":"text","value":"Receives a callback that runs the next batch, and schedules it."}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { notifyManager } from '@tanstack/query-core'\n\n// Schedule batches in the next microtask\nnotifyManager.setScheduler(queueMicrotask)\n\n// Schedule batches before the next frame is rendered\nnotifyManager.setScheduler(requestAnimationFrame)\n\n// Schedule batches some time in the future\nnotifyManager.setScheduler((cb) => setTimeout(cb, 10))","lang":"ts"}],"headings":[{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"batch","text":"batch","level":3},{"id":"type-parameters","text":"Type Parameters","level":4},{"id":"t","text":"T","level":5},{"id":"parameters","text":"Parameters","level":4},{"id":"callback","text":"callback","level":5},{"id":"returns","text":"Returns","level":4},{"id":"batchcalls","text":"batchCalls","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":4},{"id":"t-2","text":"T","level":5},{"id":"parameters-2","text":"Parameters","level":4},{"id":"callback-2","text":"callback","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"schedule","text":"schedule","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"callback-3","text":"callback","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"setbatchnotifyfunction","text":"setBatchNotifyFunction","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"fn","text":"fn","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"setnotifyfunction","text":"setNotifyFunction","level":3},{"id":"parameters-5","text":"Parameters","level":4},{"id":"fn-2","text":"fn","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"setscheduler","text":"setScheduler","level":3},{"id":"parameters-6","text":"Parameters","level":4},{"id":"fn-3","text":"fn","level":5},{"id":"returns-6","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\n```ts\nconst notifyManager: object;\n```\n\nDefined in: [packages/query-core/src/notifyManager.ts:154](https://github.com/TanStack/query/blob/main/packages/query-core/src/notifyManager.ts#L154)\n\nHandles scheduling and batching callbacks in TanStack Query.\n\n## Type Declaration\n\n### batch\n\n```ts\nreadonly batch: <T>(callback: () => T) => T;\n```\n\nBatches all updates scheduled inside the passed callback.\nThis is mainly used internally to optimize query client updating.\nBatches can be nested; the queue is only flushed once the outermost `batch` call finishes.\nThe return value of `callback` is passed through.\n\n#### Type Parameters\n\n##### T\n\n`T`\n\n#### Parameters\n\n##### callback\n\n() => `T`\n\nThe function to run in the batch.\n\n#### Returns\n\n`T`\n\nThe return value of `callback`.\n\n### batchCalls\n\n```ts\nreadonly batchCalls: <T>(callback: BatchCallsCallback<T>) => BatchCallsCallback<T>;\n```\n\nAll calls to the wrapped function will be batched.\n\n#### Type Parameters\n\n##### T\n\n`T` *extends* `unknown`[]\n\n#### Parameters\n\n##### callback\n\n`BatchCallsCallback`\\<`T`\\>\n\nThe function to wrap.\n\n#### Returns\n\n`BatchCallsCallback`\\<`T`\\>\n\nA function that schedules a call to `callback` with the given arguments.\n\n### schedule\n\n```ts\nschedule: (callback: NotifyCallback) => void;\n```\n\nSchedules a function to be run on the next batch.\nBy default, the batch is run with a `setTimeout`, but this can be configured via `setScheduler`.\n\n#### Parameters\n\n##### callback\n\n`NotifyCallback`\n\n#### Returns\n\n`void`\n\n### setBatchNotifyFunction\n\n```ts\nreadonly setBatchNotifyFunction: (fn: BatchNotifyFunction) => void;\n```\n\nUse this method to set a custom function to batch notifications together into a single tick.\nFramework adapters use this to plug in their own batching primitive, so that a single query\nupdate only triggers one re-render instead of one per subscriber.\n\n#### Parameters\n\n##### fn\n\n`BatchNotifyFunction`\n\nReceives a function that runs a batch of notifications and must call it.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { notifyManager } from '@tanstack/query-core'\nimport { batch } from 'solid-js'\n\nnotifyManager.setBatchNotifyFunction(batch)\n```\n\n### setNotifyFunction\n\n```ts\nreadonly setNotifyFunction: (fn: NotifyFunction) => void;\n```\n\nUse this method to set a custom notify function.\nThis can be used to for example wrap notifications with `React.act` while running tests.\n\n#### Parameters\n\n##### fn\n\n`NotifyFunction`\n\nReceives each notification callback and must call it.\n\n#### Returns\n\n`void`\n\n### setScheduler\n\n```ts\nreadonly setScheduler: (fn: ScheduleFunction) => void;\n```\n\nConfigures a custom callback that schedules when the next batch runs.\nThe default behavior is `setTimeout(callback, 0)`.\n\n#### Parameters\n\n##### fn\n\n`ScheduleFunction`\n\nReceives a callback that runs the next batch, and schedules it.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { notifyManager } from '@tanstack/query-core'\n\n// Schedule batches in the next microtask\nnotifyManager.setScheduler(queueMicrotask)\n\n// Schedule batches before the next frame is rendered\nnotifyManager.setScheduler(requestAnimationFrame)\n\n// Schedule batches some time in the future\nnotifyManager.setScheduler((cb) => setTimeout(cb, 10))\n```\n","originalRawMarkdown":"---\nid: notifyManager\ntitle: notifyManager\nredirect_from:\n  - reference/notifyManager\n  - framework/react/reference/notifyManager\n---\n\n```ts\nconst notifyManager: object;\n```\n\nDefined in: [packages/query-core/src/notifyManager.ts:154](https://github.com/TanStack/query/blob/main/packages/query-core/src/notifyManager.ts#L154)\n\nHandles scheduling and batching callbacks in TanStack Query.\n\n## Type Declaration\n\n### batch\n\n```ts\nreadonly batch: <T>(callback: () => T) => T;\n```\n\nBatches all updates scheduled inside the passed callback.\nThis is mainly used internally to optimize query client updating.\nBatches can be nested; the queue is only flushed once the outermost `batch` call finishes.\nThe return value of `callback` is passed through.\n\n#### Type Parameters\n\n##### T\n\n`T`\n\n#### Parameters\n\n##### callback\n\n() => `T`\n\nThe function to run in the batch.\n\n#### Returns\n\n`T`\n\nThe return value of `callback`.\n\n### batchCalls\n\n```ts\nreadonly batchCalls: <T>(callback: BatchCallsCallback<T>) => BatchCallsCallback<T>;\n```\n\nAll calls to the wrapped function will be batched.\n\n#### Type Parameters\n\n##### T\n\n`T` *extends* `unknown`[]\n\n#### Parameters\n\n##### callback\n\n`BatchCallsCallback`\\<`T`\\>\n\nThe function to wrap.\n\n#### Returns\n\n`BatchCallsCallback`\\<`T`\\>\n\nA function that schedules a call to `callback` with the given arguments.\n\n### schedule\n\n```ts\nschedule: (callback: NotifyCallback) => void;\n```\n\nSchedules a function to be run on the next batch.\nBy default, the batch is run with a `setTimeout`, but this can be configured via `setScheduler`.\n\n#### Parameters\n\n##### callback\n\n`NotifyCallback`\n\n#### Returns\n\n`void`\n\n### setBatchNotifyFunction\n\n```ts\nreadonly setBatchNotifyFunction: (fn: BatchNotifyFunction) => void;\n```\n\nUse this method to set a custom function to batch notifications together into a single tick.\nFramework adapters use this to plug in their own batching primitive, so that a single query\nupdate only triggers one re-render instead of one per subscriber.\n\n#### Parameters\n\n##### fn\n\n`BatchNotifyFunction`\n\nReceives a function that runs a batch of notifications and must call it.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { notifyManager } from '@tanstack/query-core'\nimport { batch } from 'solid-js'\n\nnotifyManager.setBatchNotifyFunction(batch)\n```\n\n### setNotifyFunction\n\n```ts\nreadonly setNotifyFunction: (fn: NotifyFunction) => void;\n```\n\nUse this method to set a custom notify function.\nThis can be used to for example wrap notifications with `React.act` while running tests.\n\n#### Parameters\n\n##### fn\n\n`NotifyFunction`\n\nReceives each notification callback and must call it.\n\n#### Returns\n\n`void`\n\n### setScheduler\n\n```ts\nreadonly setScheduler: (fn: ScheduleFunction) => void;\n```\n\nConfigures a custom callback that schedules when the next batch runs.\nThe default behavior is `setTimeout(callback, 0)`.\n\n#### Parameters\n\n##### fn\n\n`ScheduleFunction`\n\nReceives a callback that runs the next batch, and schedules it.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { notifyManager } from '@tanstack/query-core'\n\n// Schedule batches in the next microtask\nnotifyManager.setScheduler(queueMicrotask)\n\n// Schedule batches before the next frame is rendered\nnotifyManager.setScheduler(requestAnimationFrame)\n\n// Schedule batches some time in the future\nnotifyManager.setScheduler((cb) => setTimeout(cb, 10))\n```\n"}
