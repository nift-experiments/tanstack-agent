{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"If you ever want to disable a query from automatically running, you can use the "},{"type":"inlineCode","value":"enabled = false"},{"type":"text","value":" option. The enabled option also accepts a callback that returns a boolean."}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" is "},{"type":"inlineCode","value":"false"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If the query has cached data, then the query will be initialized in the "},{"type":"inlineCode","value":"status === 'success'"},{"type":"text","value":" or "},{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":" state."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If the query does not have cached data, then the query will start in the "},{"type":"inlineCode","value":"status === 'pending'"},{"type":"text","value":" and "},{"type":"inlineCode","value":"fetchStatus === 'idle'"},{"type":"text","value":" state."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query will not automatically fetch on mount."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query will not automatically refetch in the background."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query will ignore query client "},{"type":"inlineCode","value":"invalidateQueries"},{"type":"text","value":" and "},{"type":"inlineCode","value":"refetchQueries"},{"type":"text","value":" calls that would normally result in the query refetching."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"refetch"},{"type":"text","value":" returned from "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" can be used to manually trigger the query to fetch. However, it will not work with "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":"."}]}]}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"TypeScript users may prefer to use "},{"type":"link","href":"#typesafe-disabling-of-queries-using-skiptoken","children":[{"type":"text","value":"skipToken"}]},{"type":"text","value":" as an alternative to "},{"type":"inlineCode","value":"enabled = false"},{"type":"text","value":"."}]}]},{"type":"code","value":"import { Switch, Match, Show, For } from 'solid-js'\n\nfunction Todos() {\n  const todosQuery = useQuery(() => ({\n    queryKey: ['todos'],\n    queryFn: fetchTodoList,\n    enabled: false,\n  }))\n\n  return (\n    <div>\n      <button onClick={() => todosQuery.refetch()}>Fetch Todos</button>\n\n      <Switch>\n        <Match when={todosQuery.data}>\n          <ul>\n            <For each={todosQuery.data}>{(todo) => <li>{todo.title}</li>}</For>\n          </ul>\n        </Match>\n        <Match when={todosQuery.isError}>\n          <span>Error: {todosQuery.error.message}</span>\n        </Match>\n        <Match when={todosQuery.isLoading}>\n          <span>Loading...</span>\n        </Match>\n        <Match when={true}>\n          <span>Not ready ...</span>\n        </Match>\n      </Switch>\n\n      <div>{todosQuery.isFetching ? 'Fetching...' : null}</div>\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Permanently disabling a query opts out of many great features that TanStack Query has to offer (like background refetches), and it's also not the idiomatic way. It takes you from the declarative approach (defining dependencies when your query should run) into an imperative mode (fetch whenever I click here). It is also not possible to pass parameters to "},{"type":"inlineCode","value":"refetch"},{"type":"text","value":". Oftentimes, all you want is a lazy query that defers the initial fetch:"}]},{"type":"heading","depth":2,"id":"lazy-queries","children":[{"type":"text","value":"Lazy Queries"}]},{"type":"paragraph","children":[{"type":"text","value":"The enabled option can not only be used to permanently disable a query, but also to enable / disable it at a later time. A good example would be a filter form where you only want to fire off the first request once the user has entered a filter value:"}]},{"type":"code","value":"import { createSignal } from 'solid-js'\n\nfunction Todos() {\n  const [filter, setFilter] = createSignal('')\n\n  const todosQuery = useQuery(() => ({\n    queryKey: ['todos', filter()],\n    queryFn: () => fetchTodos(filter()),\n    // ⬇️ disabled as long as the filter is empty\n    enabled: !!filter(),\n  }))\n\n  return (\n    <div>\n      {/* 🚀 applying the filter will enable and execute the query */}\n      <FiltersForm onApply={setFilter} />\n      <Show when={todosQuery.data}>\n        <TodosTable data={todosQuery.data} />\n      </Show>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"isloading-previously-isinitialloading","children":[{"type":"text","value":"isLoading (Previously: "},{"type":"inlineCode","value":"isInitialLoading"},{"type":"text","value":")"}]},{"type":"paragraph","children":[{"type":"text","value":"Lazy queries will be in "},{"type":"inlineCode","value":"status: 'pending'"},{"type":"text","value":" right from the start because "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" means that there is no data yet. This is technically true, however, since we are not currently fetching any data (as the query is not "},{"type":"emphasis","children":[{"type":"text","value":"enabled"}]},{"type":"text","value":"), it also means you likely cannot use this flag to show a loading spinner."}]},{"type":"paragraph","children":[{"type":"text","value":"If you are using disabled or lazy queries, you can use the "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":" flag instead. It's a derived flag that is computed from:"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"isPending && isFetching"}]},{"type":"paragraph","children":[{"type":"text","value":"so it will only be true if the query is currently fetching for the first time."}]},{"type":"heading","depth":2,"id":"typesafe-disabling-of-queries-using-skiptoken","children":[{"type":"text","value":"Typesafe disabling of queries using "},{"type":"inlineCode","value":"skipToken"}]},{"type":"paragraph","children":[{"type":"text","value":"If you are using TypeScript, you can use the "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" to disable a query. This is useful when you want to disable a query based on a condition, but you still want the query to be type safe."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"IMPORTANT"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"refetch"},{"type":"text","value":" from "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" will not work with "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":". Calling "},{"type":"inlineCode","value":"refetch()"},{"type":"text","value":" on a query that uses "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" will result in a "},{"type":"inlineCode","value":"Missing queryFn"},{"type":"text","value":" error because there is no valid query function to execute. If you need to manually trigger queries, consider using "},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":" instead, which allows "},{"type":"inlineCode","value":"refetch()"},{"type":"text","value":" to work properly. Other than this limitation, "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" works the same as "},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":"."}]}]},{"type":"code","value":"import { createSignal } from 'solid-js'\nimport { skipToken, useQuery } from '@tanstack/solid-query'\n\nfunction Todos() {\n  const [filter, setFilter] = createSignal<string | undefined>()\n\n  const todosQuery = useQuery(() => ({\n    queryKey: ['todos', filter()],\n    // ⬇️ disabled as long as the filter is undefined or empty\n    queryFn: filter() ? () => fetchTodos(filter()!) : skipToken,\n  }))\n\n  return (\n    <div>\n      {/* 🚀 applying the filter will enable and execute the query */}\n      <FiltersForm onApply={setFilter} />\n      <Show when={todosQuery.data}>\n        <TodosTable data={todosQuery.data} />\n      </Show>\n    </div>\n  )\n}","lang":"tsx"}],"headings":[{"id":"lazy-queries","text":"Lazy Queries","level":2},{"id":"isloading-previously-isinitialloading","text":"isLoading (Previously: isInitialLoading)","level":3},{"id":"typesafe-disabling-of-queries-using-skiptoken","text":"Typesafe disabling of queries using skipToken","level":2}]},"frameworks":[],"downloadMarkdown":"\nIf you ever want to disable a query from automatically running, you can use the `enabled = false` option. The enabled option also accepts a callback that returns a boolean.\n\nWhen `enabled` is `false`:\n\n- If the query has cached data, then the query will be initialized in the `status === 'success'` or `isSuccess` state.\n- If the query does not have cached data, then the query will start in the `status === 'pending'` and `fetchStatus === 'idle'` state.\n- The query will not automatically fetch on mount.\n- The query will not automatically refetch in the background.\n- The query will ignore query client `invalidateQueries` and `refetchQueries` calls that would normally result in the query refetching.\n- `refetch` returned from `useQuery` can be used to manually trigger the query to fetch. However, it will not work with `skipToken`.\n\n> TypeScript users may prefer to use [skipToken](#typesafe-disabling-of-queries-using-skiptoken) as an alternative to `enabled = false`.\n\n\n\n```tsx\nimport { Switch, Match, Show, For } from 'solid-js'\n\nfunction Todos() {\n  const todosQuery = useQuery(() => ({\n    queryKey: ['todos'],\n    queryFn: fetchTodoList,\n    enabled: false,\n  }))\n\n  return (\n    <div>\n      <button onClick={() => todosQuery.refetch()}>Fetch Todos</button>\n\n      <Switch>\n        <Match when={todosQuery.data}>\n          <ul>\n            <For each={todosQuery.data}>{(todo) => <li>{todo.title}</li>}</For>\n          </ul>\n        </Match>\n        <Match when={todosQuery.isError}>\n          <span>Error: {todosQuery.error.message}</span>\n        </Match>\n        <Match when={todosQuery.isLoading}>\n          <span>Loading...</span>\n        </Match>\n        <Match when={true}>\n          <span>Not ready ...</span>\n        </Match>\n      </Switch>\n\n      <div>{todosQuery.isFetching ? 'Fetching...' : null}</div>\n    </div>\n  )\n}\n```\n\n\n\nPermanently disabling a query opts out of many great features that TanStack Query has to offer (like background refetches), and it's also not the idiomatic way. It takes you from the declarative approach (defining dependencies when your query should run) into an imperative mode (fetch whenever I click here). It is also not possible to pass parameters to `refetch`. Oftentimes, all you want is a lazy query that defers the initial fetch:\n\n## Lazy Queries\n\nThe enabled option can not only be used to permanently disable a query, but also to enable / disable it at a later time. A good example would be a filter form where you only want to fire off the first request once the user has entered a filter value:\n\n\n\n```tsx\nimport { createSignal } from 'solid-js'\n\nfunction Todos() {\n  const [filter, setFilter] = createSignal('')\n\n  const todosQuery = useQuery(() => ({\n    queryKey: ['todos', filter()],\n    queryFn: () => fetchTodos(filter()),\n    // ⬇️ disabled as long as the filter is empty\n    enabled: !!filter(),\n  }))\n\n  return (\n    <div>\n      {/* 🚀 applying the filter will enable and execute the query */}\n      <FiltersForm onApply={setFilter} />\n      <Show when={todosQuery.data}>\n        <TodosTable data={todosQuery.data} />\n      </Show>\n    </div>\n  )\n}\n```\n\n\n\n### isLoading (Previously: `isInitialLoading`)\n\nLazy queries will be in `status: 'pending'` right from the start because `pending` means that there is no data yet. This is technically true, however, since we are not currently fetching any data (as the query is not _enabled_), it also means you likely cannot use this flag to show a loading spinner.\n\nIf you are using disabled or lazy queries, you can use the `isLoading` flag instead. It's a derived flag that is computed from:\n\n`isPending && isFetching`\n\nso it will only be true if the query is currently fetching for the first time.\n\n## Typesafe disabling of queries using `skipToken`\n\nIf you are using TypeScript, you can use the `skipToken` to disable a query. This is useful when you want to disable a query based on a condition, but you still want the query to be type safe.\n\n> **IMPORTANT**: `refetch` from `useQuery` will not work with `skipToken`. Calling `refetch()` on a query that uses `skipToken` will result in a `Missing queryFn` error because there is no valid query function to execute. If you need to manually trigger queries, consider using `enabled: false` instead, which allows `refetch()` to work properly. Other than this limitation, `skipToken` works the same as `enabled: false`.\n\n\n\n```tsx\nimport { createSignal } from 'solid-js'\nimport { skipToken, useQuery } from '@tanstack/solid-query'\n\nfunction Todos() {\n  const [filter, setFilter] = createSignal<string | undefined>()\n\n  const todosQuery = useQuery(() => ({\n    queryKey: ['todos', filter()],\n    // ⬇️ disabled as long as the filter is undefined or empty\n    queryFn: filter() ? () => fetchTodos(filter()!) : skipToken,\n  }))\n\n  return (\n    <div>\n      {/* 🚀 applying the filter will enable and execute the query */}\n      <FiltersForm onApply={setFilter} />\n      <Show when={todosQuery.data}>\n        <TodosTable data={todosQuery.data} />\n      </Show>\n    </div>\n  )\n}\n```\n\n\n","originalRawMarkdown":"---\nid: disabling-queries\ntitle: Disabling/Pausing Queries\nref: docs/framework/react/guides/disabling-queries.md\n---\n\n[//]: # 'Example'\n\n```tsx\nimport { Switch, Match, Show, For } from 'solid-js'\n\nfunction Todos() {\n  const todosQuery = useQuery(() => ({\n    queryKey: ['todos'],\n    queryFn: fetchTodoList,\n    enabled: false,\n  }))\n\n  return (\n    <div>\n      <button onClick={() => todosQuery.refetch()}>Fetch Todos</button>\n\n      <Switch>\n        <Match when={todosQuery.data}>\n          <ul>\n            <For each={todosQuery.data}>{(todo) => <li>{todo.title}</li>}</For>\n          </ul>\n        </Match>\n        <Match when={todosQuery.isError}>\n          <span>Error: {todosQuery.error.message}</span>\n        </Match>\n        <Match when={todosQuery.isLoading}>\n          <span>Loading...</span>\n        </Match>\n        <Match when={true}>\n          <span>Not ready ...</span>\n        </Match>\n      </Switch>\n\n      <div>{todosQuery.isFetching ? 'Fetching...' : null}</div>\n    </div>\n  )\n}\n```\n\n[//]: # 'Example'\n[//]: # 'Example2'\n\n```tsx\nimport { createSignal } from 'solid-js'\n\nfunction Todos() {\n  const [filter, setFilter] = createSignal('')\n\n  const todosQuery = useQuery(() => ({\n    queryKey: ['todos', filter()],\n    queryFn: () => fetchTodos(filter()),\n    // ⬇️ disabled as long as the filter is empty\n    enabled: !!filter(),\n  }))\n\n  return (\n    <div>\n      {/* 🚀 applying the filter will enable and execute the query */}\n      <FiltersForm onApply={setFilter} />\n      <Show when={todosQuery.data}>\n        <TodosTable data={todosQuery.data} />\n      </Show>\n    </div>\n  )\n}\n```\n\n[//]: # 'Example2'\n[//]: # 'Example3'\n\n```tsx\nimport { createSignal } from 'solid-js'\nimport { skipToken, useQuery } from '@tanstack/solid-query'\n\nfunction Todos() {\n  const [filter, setFilter] = createSignal<string | undefined>()\n\n  const todosQuery = useQuery(() => ({\n    queryKey: ['todos', filter()],\n    // ⬇️ disabled as long as the filter is undefined or empty\n    queryFn: filter() ? () => fetchTodos(filter()!) : skipToken,\n  }))\n\n  return (\n    <div>\n      {/* 🚀 applying the filter will enable and execute the query */}\n      <FiltersForm onApply={setFilter} />\n      <Show when={todosQuery.data}>\n        <TodosTable data={todosQuery.data} />\n      </Show>\n    </div>\n  )\n}\n```\n\n[//]: # 'Example3'\n"}
