ext","value":" is persisted to the cache, so it is not recommended to provide placeholder, partial or incomplete data to this option and instead use "},{"type":"inlineCode","value":"placeholderData"}]}]},{"type":"code","value":"const todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n}))","lang":"tsx"},{"type":"heading","depth":3,"id":"staletime-and-initialdataupdatedat","children":[{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" and "},{"type":"inlineCode","value":"initialDataUpdatedAt"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" is treated as totally fresh, as if it were just fetched. This also means that it will affect how it is interpreted by the "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" option."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you configure your query observer with "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":", and no "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" (the default "},{"type":"inlineCode","value":"staleTime: 0"},{"type":"text","value":"), the query will immediately refetch when it mounts:"}]}]}]},{"type":"code","value":"// Will show initialTodos immediately, but also immediately refetch todos after mount\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n}))","lang":"tsx"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you configure your query observer with "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" and a "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" of "},{"type":"inlineCode","value":"1000"},{"type":"text","value":" ms, the data will be considered fresh for that same amount of time, as if it was just fetched from your query function."}]}]}]},{"type":"code","value":"// Show initialTodos immediately, but won't refetch until another interaction event is encountered after 1000 ms\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n  staleTime: 1000,\n}))","lang":"tsx"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"So what if your "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" isn't totally fresh? That leaves us with the last configuration that is actually the most accurate and uses an option called "},{"type":"inlineCode","value":"initialDataUpdatedAt"},{"type":"text","value":". This option allows you to pass a numeric JS timestamp in milliseconds of when the initialData itself was last updated, e.g. what "},{"type":"inlineCode","value":"Date.now()"},{"type":"text","value":" provides. Take note that if you have a unix timestamp, you'll need to convert it to a JS timestamp by multiplying it by "},{"type":"inlineCode","value":"1000"},{"type":"text","value":"."}]}]}]},{"type":"code","value":"// Show initialTodos immediately, but won't refetch until another interaction event is encountered after 1000 ms\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n  staleTime: 60 * 1000, // 1 minute\n  // This could be 10 seconds ago or 10 minutes ago\n  initialDataUpdatedAt: initialTodosUpdatedTimestamp, // eg. 1608412420052\n}))","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"This option allows the staleTime to be used for its original purpose, determining how fresh the data needs to be, while also allowing the data to be refetched on mount if the "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" is older than the "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":". In the example above, our data needs to be fresh within 1 minute, and we can hint to the query when the initialData was last updated so the query can decide for itself whether the data needs to be refetched again or not."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"If you would rather treat your data as "},{"type":"strong","children":[{"type":"text","value":"prefetched data"}]},{"type":"text","value":", we recommend that you use the "},{"type":"inlineCode","value":"query"},{"type":"text","value":" api to populate the cache beforehand, thus letting you configure your "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" independently from your "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":"."}]}]},{"type":"heading","depth":3,"id":"initial-data-function","children":[{"type":"text","value":"Initial Data Function"}]},{"type":"paragraph","children":[{"type":"text","value":"If the process for accessing a query's initial data is intensive or just not something you want to perform on every render, you can pass a function as the "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" value. This function will be executed only once when the query is initialized, saving you precious memory and/or CPU:"}]},{"type":"code","value":"const todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: () => getExpensiveTodos(),\n}))","lang":"tsx"},{"type":"heading","depth":3,"id":"initial-data-from-cache","children":[{"type":"text","value":"Initial Data from Cache"}]},{"type":"paragraph","children":[{"type":"text","value":"In some circumstances, you may be able to provide the initial data for a query from the cached result of another. A good example of this would be searching the cached data from a todos list query for an individual todo item, then using that as the initial data for your individual todo query:"}]},{"type":"code","value":"const todoQuery = useQuery(() => ({\n  queryKey: ['todo', todoId],\n  queryFn: () => fetch('/todos'),\n  initialData: () => {\n    // Use a todo from the 'todos' query as the initial data for this todo query\n    return queryClient.getQueryData(['todos'])?.find((d) => d.id === todoId)\n  },\n}))","lang":"tsx"},{"type":"heading","depth":3,"id":"initial-data-from-the-cache-with-initialdataupdatedat","children":[{"type":"text","value":"Initial Data from the cache with "},{"type":"inlineCode","value":"initialDataUpdatedAt"}]},{"type":"paragraph","children":[{"type":"text","value":"Getting initial data from the cache means the source query you're using to look up the initial data from is likely old. Instead of using an artificial "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" to keep your query from refetching immediately, it's suggested that you pass the source query's "},{"type":"inlineCode","value":"dataUpdatedAt"},{"type":"text","value":" to "},{"type":"inlineCode","value":"initialDataUpdatedAt"},{"type":"text","value":". This provides the query instance with all the information it needs to determine if and when the query needs to be refetched, regardless of initial data being provided."}]},{"type":"code","value":"const todoQuery = useQuery(() => ({\n  queryKey: ['todos', todoId],\n  queryFn: () => fetch(`/todos/${todoId}`),\n  initialData: () =>\n    queryClient.getQueryData(['todos'])?.find((d) => d.id === todoId),\n  initialDataUpdatedAt: () =>\n    queryClient.getQueryState(['todos'])?.dataUpdatedAt,\n}))","lang":"tsx"},{"type":"heading","depth":3,"id":"conditional-initial-data-from-cache","children":[{"type":"text","value":"Conditional Initial Data from Cache"}]},{"type":"paragraph","children":[{"type":"text","value":"If the source query you're using to look up the initial data from is old, you may not want to use the cached data at all and just fetch from the server. To make this decision easier, you can use the "},{"type":"inlineCode","value":"queryClient.getQueryState"},{"type":"text","value":" method instead to get more information about the source query, including a "},{"type":"inlineCode","value":"state.dataUpdatedAt"},{"type":"text","value":" timestamp you can use to decide if the query is \"fresh\" enough for your needs:"}]},{"type":"code","value":"const todoQuery = useQuery(() => ({\n  queryKey: ['todo', todoId],\n  queryFn: () => fetch(`/todos/${todoId}`),\n  initialData: () => {\n    // Get the query state\n    const state = queryClient.getQueryState(['todos'])\n\n    // If the query exists and has data that is no older than 10 seconds...\n    if (state && Date.now() - state.dataUpdatedAt <= 10 * 1000) {\n      // return the individual todo\n      return state.data.find((d) => d.id === todoId)\n    }\n\n    // Otherwise, return undefined and let it fetch from a hard loading state!\n  },\n}))","lang":"tsx"},{"type":"heading","depth":2,"id":"further-reading","children":[{"type":"text","value":"Further reading"}]},{"type":"paragraph","children":[{"type":"text","value":"For a comparison between "},{"type":"inlineCode","value":"Initial Data"},{"type":"text","value":" and "},{"type":"inlineCode","value":"Placeholder Data"},{"type":"text","value":", see the "},{"type":"link","href":"https://tkdodo.eu/blog/placeholder-and-initial-data-in-react-query","children":[{"type":"text","value":"article by TkDodo"}]},{"type":"text","value":"."}]}],"headings":[{"id":"using-initialdata-to-prepopulate-a-query","text":"Using initialData to prepopulate a query","level":2},{"id":"staletime-and-initialdataupdatedat","text":"staleTime and initialDataUpdatedAt","level":3},{"id":"initial-data-function","text":"Initial Data Function","level":3},{"id":"initial-data-from-cache","text":"Initial Data from Cache","level":3},{"id":"initial-data-from-the-cache-with-initialdataupdatedat","text":"Initial Data from the cache with initialDataUpdatedAt","level":3},{"id":"conditional-initial-data-from-cache","text":"Conditional Initial Data from Cache","level":3},{"id":"further-reading","text":"Further reading","level":2}]},"frameworks":[],"downloadMarkdown":"\nThere are many ways to supply initial data for a query to the cache before you need it:\n\n- Declaratively:\n  - Provide `initialData` to a query to prepopulate its cache if empty\n- Imperatively:\n  - [Prefetch the data using `queryClient.query`](./prefetching.md)\n  - [Manually place the data into the cache using `queryClient.setQueryData`](./prefetching.md)\n\n## Using `initialData` to prepopulate a query\n\nThere may be times when you already have the initial data for a query available in your app and can simply provide it directly to your query. If and when this is the case, you can use the `config.initialData` option to set the initial data for a query and skip the initial loading state!\n\n> IMPORTANT: `initialData` is persisted to the cache, so it is not recommended to provide placeholder, partial or incomplete data to this option and instead use `placeholderData`\n\n\n\n```tsx\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n}))\n```\n\n\n\n### `staleTime` and `initialDataUpdatedAt`\n\nBy default, `initialData` is treated as totally fresh, as if it were just fetched. This also means that it will affect how it is interpreted by the `staleTime` option.\n\n- If you configure your query observer with `initialData`, and no `staleTime` (the default `staleTime: 0`), the query will immediately refetch when it mounts:\n\n  \n\n```tsx\n// Will show initialTodos immediately, but also immediately refetch todos after mount\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n}))\n```\n\n\n\n- If you configure your query observer with `initialData` and a `staleTime` of `1000` ms, the data will be considered fresh for that same amount of time, as if it was just fetched from your query function.\n\n  \n\n```tsx\n// Show initialTodos immediately, but won't refetch until another interaction event is encountered after 1000 ms\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n  staleTime: 1000,\n}))\n```\n\n\n\n- So what if your `initialData` isn't totally fresh? That leaves us with the last configuration that is actually the most accurate and uses an option called `initialDataUpdatedAt`. This option allows you to pass a numeric JS timestamp in milliseconds of when the initialData itself was last updated, e.g. what `Date.now()` provides. Take note that if you have a unix timestamp, you'll need to convert it to a JS timestamp by multiplying it by `1000`.\n\n  \n\n```tsx\n// Show initialTodos immediately, but won't refetch until another interaction event is encountered after 1000 ms\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n  staleTime: 60 * 1000, // 1 minute\n  // This could be 10 seconds ago or 10 minutes ago\n  initialDataUpdatedAt: initialTodosUpdatedTimestamp, // eg. 1608412420052\n}))\n```\n\n\n\n  This option allows the staleTime to be used for its original purpose, determining how fresh the data needs to be, while also allowing the data to be refetched on mount if the `initialData` is older than the `staleTime`. In the example above, our data needs to be fresh within 1 minute, and we can hint to the query when the initialData was last updated so the query can decide for itself whether the data needs to be refetched again or not.\n\n  > If you would rather treat your data as **prefetched data**, we recommend that you use the `query` api to populate the cache beforehand, thus letting you configure your `staleTime` independently from your `initialData`.\n\n### Initial Data Function\n\nIf the process for accessing a query's initial data is intensive or just not something you want to perform on every render, you can pass a function as the `initialData` value. This function will be executed only once when the query is initialized, saving you precious memory and/or CPU:\n\n\n\n```tsx\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: () => getExpensiveTodos(),\n}))\n```\n\n\n\n### Initial Data from Cache\n\nIn some circumstances, you may be able to provide the initial data for a query from the cached result of another. A good example of this would be searching the cached data from a todos list query for an individual todo item, then using that as the initial data for your individual todo query:\n\n\n\n```tsx\nconst todoQuery = useQuery(() => ({\n  queryKey: ['todo', todoId],\n  queryFn: () => fetch('/todos'),\n  initialData: () => {\n    // Use a todo from the 'todos' query as the initial data for this todo query\n    return queryClient.getQueryData(['todos'])?.find((d) => d.id === todoId)\n  },\n}))\n```\n\n\n\n### Initial Data from the cache with `initialDataUpdatedAt`\n\nGetting initial data from the cache means the source query you're using to look up the initial data from is likely old. Instead of using an artificial `staleTime` to keep your query from refetching immediately, it's suggested that you pass the source query's `dataUpdatedAt` to `initialDataUpdatedAt`. This provides the query instance with all the information it needs to determine if and when the query needs to be refetched, regardless of initial data being provided.\n\n\n\n```tsx\nconst todoQuery = useQuery(() => ({\n  queryKey: ['todos', todoId],\n  queryFn: () => fetch(`/todos/${todoId}`),\n  initialData: () =>\n    queryClient.getQueryData(['todos'])?.find((d) => d.id === todoId),\n  initialDataUpdatedAt: () =>\n    queryClient.getQueryState(['todos'])?.dataUpdatedAt,\n}))\n```\n\n\n\n### Conditional Initial Data from Cache\n\nIf the source query you're using to look up the initial data from is old, you may not want to use the cached data at all and just fetch from the server. To make this decision easier, you can use the `queryClient.getQueryState` method instead to get more information about the source query, including a `state.dataUpdatedAt` timestamp you can use to decide if the query is \"fresh\" enough for your needs:\n\n\n\n```tsx\nconst todoQuery = useQuery(() => ({\n  queryKey: ['todo', todoId],\n  queryFn: () => fetch(`/todos/${todoId}`),\n  initialData: () => {\n    // Get the query state\n    const state = queryClient.getQueryState(['todos'])\n\n    // If the query exists and has data that is no older than 10 seconds...\n    if (state && Date.now() - state.dataUpdatedAt <= 10 * 1000) {\n      // return the individual todo\n      return state.data.find((d) => d.id === todoId)\n    }\n\n    // Otherwise, return undefined and let it fetch from a hard loading state!\n  },\n}))\n```\n\n\n\n\n## Further reading\n\nFor a comparison between `Initial Data` and `Placeholder Data`, see the [article by TkDodo](https://tkdodo.eu/blog/placeholder-and-initial-data-in-react-query).\n\n\n","originalRawMarkdown":"---\nid: initial-query-data\ntitle: Initial Query Data\nref: docs/framework/react/guides/initial-query-data.md\nreplace:\n  {\n    '@tanstack/react-query': '@tanstack/solid-query',\n    'useMutationState[(]': 'useMutationState(() => ',\n    'useMutation[(]': 'useMutation(() => ',\n    'useQuery[(]': 'useQuery(() => ',\n    'useQueries[(]': 'useQueries(() => ',\n    'useInfiniteQuery[(]': 'useInfiniteQuery(() => ',\n  }\n---\n\n[//]: # 'Example'\n\n```tsx\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n}))\n```\n\n[//]: # 'Example'\n[//]: # 'Example2'\n\n```tsx\n// Will show initialTodos immediately, but also immediately refetch todos after mount\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n}))\n```\n\n[//]: # 'Example2'\n[//]: # 'Example3'\n\n```tsx\n// Show initialTodos immediately, but won't refetch until another interaction event is encountered after 1000 ms\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n  staleTime: 1000,\n}))\n```\n\n[//]: # 'Example3'\n[//]: # 'Example4'\n\n```tsx\n// Show initialTodos immediately, but won't refetch until another interaction event is encountered after 1000 ms\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: initialTodos,\n  staleTime: 60 * 1000, // 1 minute\n  // This could be 10 seconds ago or 10 minutes ago\n  initialDataUpdatedAt: initialTodosUpdatedTimestamp, // eg. 1608412420052\n}))\n```\n\n[//]: # 'Example4'\n[//]: # 'Example5'\n\n```tsx\nconst todosQuery = useQuery(() => ({\n  queryKey: ['todos'],\n  queryFn: () => fetch('/todos'),\n  initialData: () => getExpensiveTodos(),\n}))\n```\n\n[//]: # 'Example5'\n[//]: # 'Example6'\n\n```tsx\nconst todoQuery = useQuery(() => ({\n  queryKey: ['todo', todoId],\n  queryFn: () => fetch('/todos'),\n  initialData: () => {\n    // Use a todo from the 'todos' query as the initial data for this todo query\n    return queryClient.getQueryData(['todos'])?.find((d) => d.id === todoId)\n  },\n}))\n```\n\n[//]: # 'Example6'\n[//]: # 'Example7'\n\n```tsx\nconst todoQuery = useQuery(() => ({\n  queryKey: ['todos', todoId],\n  queryFn: () => fetch(`/todos/${todoId}`),\n  initialData: () =>\n    queryClient.getQueryData(['todos'])?.find((d) => d.id === todoId),\n  initialDataUpdatedAt: () =>\n    queryClient.getQueryState(['todos'])?.dataUpdatedAt,\n}))\n```\n\n[//]: # 'Example7'\n[//]: # 'Example8'\n\n```tsx\nconst todoQuery = useQuery(() => ({\n  queryKey: ['todo', todoId],\n  queryFn: () => fetch(`/todos/${todoId}`),\n  initialData: () => {\n    // Get the query state\n    const state = queryClient.getQueryState(['todos'])\n\n    // If the query exists and has data that is no older than 10 seconds...\n    if (state && Date.now() - state.dataUpdatedAt <= 10 * 1000) {\n      // return the individual todo\n      return state.data.find((d) => d.id === todoId)\n    }\n\n    // Otherwise, return undefined and let it fetch from a hard loading state!\n  },\n}))\n```\n\n[//]: # 'Example8'\n"}
