de","value":"TCombinedResult"},{"type":"text","value":" = "},{"type":"link","href":"../type-aliases/QueryObserverResult.md","children":[{"type":"inlineCode","value":"QueryObserverResult"}]},{"type":"text","value":"[]"}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,"id":"constructor","children":[{"type":"text","value":"Constructor"}]},{"type":"code","value":"new QueriesObserver<TCombinedResult>(\n   client: QueryClient, \n   queries: QueryObserverOptions<any, any, any, any, any, never>[], \noptions?: QueriesObserverOptions<TCombinedResult>): QueriesObserver<TCombinedResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queriesObserver.ts#L78","children":[{"type":"text","value":"packages/query-core/src/queriesObserver.ts:78"}]}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"client","children":[{"type":"text","value":"client"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"heading","depth":5,"id":"queries","children":[{"type":"text","value":"queries"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"QueryObserverOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"never"},{"type":"text","value":">[]"}]},{"type":"heading","depth":5,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/QueriesObserverOptions.md","children":[{"type":"inlineCode","value":"QueriesObserverOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TCombinedResult"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"QueriesObserver"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TCombinedResult"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"overrides","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"Subscribable<QueriesObserverListener>.constructor","lang":"ts"},{"type":"heading","depth":2,"id":"methods","children":[{"type":"text","value":"Methods"}]},{"type":"heading","depth":3,"id":"destroy","children":[{"type":"text","value":"destroy()"}]},{"type":"code","value":"destroy(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queriesObserver.ts#L114","children":[{"type":"text","value":"packages/query-core/src/queriesObserver.ts:114"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Stops observing all queries: clears all listeners and destroys every\nunderlying "},{"type":"inlineCode","value":"QueryObserver"},{"type":"text","value":" this observer manages."}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getcurrentresult","children":[{"type":"text","value":"getCurrentResult()"}]},{"type":"code","value":"getCurrentResult(): QueryObserverResult[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queriesObserver.ts#L219","children":[{"type":"text","value":"packages/query-core/src/queriesObserver.ts:219"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns the most recently computed array of "},{"type":"inlineCode","value":"QueryObserverResult"},{"type":"text","value":"s, one\nper observed query, in the same order as the queries passed to the\nconstructor or "},{"type":"inlineCode","value":"setQueries"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/QueryObserverResult.md","children":[{"type":"inlineCode","value":"QueryObserverResult"}]},{"type":"text","value":"[]"}]},{"type":"paragraph","children":[{"type":"text","value":"The current results."}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const results = observer.getCurrentResult()\nconst data = results.map((result) => result.data)","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getobservers","children":[{"type":"text","value":"getObservers()"}]},{"type":"code","value":"getObservers(): QueryObserver<unknown, Error, unknown, unknown, readonly unknown[]>[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queriesObserver.ts#L238","children":[{"type":"text","value":"packages/query-core/src/queriesObserver.ts:238"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns the underlying "},{"type":"inlineCode","value":"QueryObserver"},{"type":"text","value":" instances this observer manages,\nin the same order as the queries passed to the constructor or\n"},{"type":"inlineCode","value":"setQueries"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"QueryObserver.md","children":[{"type":"inlineCode","value":"QueryObserver"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]>[]"}]},{"type":"paragraph","children":[{"type":"text","value":"The managed query observers."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getoptimisticresult","children":[{"type":"text","value":"getOptimisticResult()"}]},{"type":"code","value":"getOptimisticResult(queries: QueryObserverOptions<unknown, Error, unknown, unknown, readonly unknown[], never>[], combine: CombineFn<TCombinedResult> | undefined): [QueryObserverResult[], (r?: QueryObserverResult[]) => TCombinedResult, () => QueryObserverResult[]];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queriesObserver.ts#L253","children":[{"type":"text","value":"packages/query-core/src/queriesObserver.ts:253"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"QueriesObserver"},{"type":"text","value":" counterpart of "},{"type":"link","href":"QueryObserver.md#getoptimisticresult","children":[{"type":"text","value":"QueryObserver#getOptimisticResult"}]},{"type":"text","value":" — computes\nthe result for the given (already-defaulted) queries right now, synchronously. Called by\nframework adapters (e.g. "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":") ahead of subscribing, returning a tuple of the raw\nper-query results, a function to compute the combined result from them, and a function to\nwrap the results for property-access tracking."}]},{"type":"heading","depth":4,