depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const queryCache = queryClient.getQueryCache()\n\nqueryCache.clear()","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"find","children":[{"type":"text","value":"find()"}]},{"type":"code","value":"find<TQueryFnData, TError, TData>(filters: WithRequired<QueryFilters<readonly unknown[]>, \"queryKey\">): \n  | Query<TQueryFnData, TError, TData, readonly unknown[]>\n  | undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/queryCache.ts#L323","children":[{"type":"text","value":"packages/query-core/src/queryCache.ts:323"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A slightly more advanced method that can be used to get an existing query instance from the\ncache. This instance not only contains all the state for the query, but all of the instances,\nand underlying guts of the query as well. If the query does not exist, "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" is\nreturned."}]},{"type":"paragraph","children":[{"type":"text","value":"This is not typically needed for most applications, but can come in handy when needing more\ninformation about a query in rare scenarios (e.g. looking at "},{"type":"inlineCode","value":"query.state.dataUpdatedAt"},{"type":"text","value":" to\ndecide whether a query is fresh enough to be used as an initial value)."}]},{"type":"heading","depth":4,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tqueryfndata-2","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":5,"id":"terror-2","children":[{"type":"text","value":"