ned"},{"type":"text","value":" if none\nexists. Unlike "},{"type":"link","href":"#find","children":[{"type":"text","value":"QueryCache#find"}]},{"type":"text","value":", this looks up by the already-computed hash rather\nthan by "},{"type":"inlineCode","value":"QueryFilters"},{"type":"text","value":". Used by plugins (e.g. broadcast/hydration) that already have a hash\nto look up directly."}]},{"type":"heading","depth":4,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tqueryfndata-3","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":5,"id":"terror-3","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":5,"id":"tdata-3","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":5,"id":"tquerykey-2","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"queryhash","children":[{"type":"text","value":"queryHash"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"string"}]},{"type":"paragraph","children":[{"type":"text","valu