de","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Include queries matching this query key"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-stale\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"stale?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Include or exclude stale queries"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-type\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"type?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"QueryTypeFilter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'all'"}]},{"type":"tableCell","children":[{"type":"text","value":"Filter to active queries, inactive queries or all queries"}]}]]},{"type":"heading","depth":3,"id":"query","children":[{"type":"text","value":"query"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/Query.md","children":[{"type":"inlineCode","value":"Query"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The query to check."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query matches every specified filter."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const queryCache = queryClient.getQueryCache()\n\nconst matchingQueries = queryCache\n  .getAll()\n  .filter((query) => matchQuery({ queryKey: ['posts'] }, query))","lang":"ts"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"filters","text":"filters","level":3},{"id":"filters-properties","text":"filters properties","level":4},{"id":"query","text":"query","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction matchQuery(filters: QueryFilters, query: Query<any, any, any, any>): boolean;\n```\n\nDefined in: [packages/query-core/src/utils.ts:205](https://github.com/TanStack/query/blob/main/packages/query-core/src/utils.ts#L205)\n\nChecks whether a query matches the given [QueryFilters](../interfaces/QueryFilters.md).\nEvery filter that is specified must match; filters that are left unspecified are ignored.\n\n## Parameters\n\n### filters\n\n[`QueryFilters`](../interfaces/QueryFilters.md)\n\nThe filters to check the query against.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | `undefined` | Match query key exactly |\n| <a id=\"filters-property-fetchstatus\"></a> `fetchStatus?` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | `undefined` | Include queries matching their fetchStatus |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`query`: [`Query`](../classes/Query.md)) => `boolean` | `undefined` | Include queries matching this predicate function |\n| <a id=\"filters-property-querykey\"></a> `queryKey?` | `TQueryKey` \\| `TuplePrefixes`\\<`TQueryKey`\\> | `undefined` | Include queries matching this query key |\n| <a id=\"filters-property-stale\"></a> `stale?` | `boolean` | `undefined` | Include or exclude stale queries |\n| <a id=\"filters-property-type\"></a> `type?` | `QueryTypeFilter` | `'all'` | Filter to active queries, inactive queries or all queries |\n\n### query\n\n[`Query`](../classes/Query.md)\\<`any`, `any`, `any`, `any`\\>\n\nThe query to check.\n\n## Returns\n\n`boolean`\n\n`true` if the query matches every specified filter.\n\n## Example\n\n```ts\nconst queryCache = queryClient.getQueryCache()\n\nconst matchingQueries = queryCache\n  .getAll()\n  .filter((query) => matchQuery({ queryKey: ['posts'] }, query))\n```\n","originalRawMarkdown":"---\nid: matchQuery\ntitle: matchQuery\n---\n\n```ts\nfunction matchQuery(filters: QueryFilters, query: Query<any, any, any, any>): boolean;\n```\n\nDefined in: [packages/query-core/src/utils.ts:205](https://github.com/TanStack/query/blob/main/packages/query-core/src/utils.ts#L205)\n\nChecks whether a query matches the given [QueryFilters](../interfaces/QueryFilters.md).\nEvery filter that is specified must match; filters that are left unspecified are ignored.\n\n## Parameters\n\n### filters\n\n[`QueryFilters`](../interfaces/QueryFilters.md)\n\nThe filters to check the query against.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | `undefined` | Match query key exactly |\n| <a id=\"filters-property-fetchstatus\"></a> `fetchStatus?` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | `undefined` | Include queries matching their fetchStatus |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`query`: [`Query`](../classes/Query.md)) => `boolean` | `undefined` | Include queries matching this predicate function |\n| <a id=\"filters-property-querykey\"></a> `queryKey?` | `TQueryKey` \\| `TuplePrefixes`\\<`TQueryKey`\\> | `undefined` | Include queries matching this query key |\n| <a id=\"filters-property-stale\"></a> `stale?` | `boolean` | `undefined` | Include or exclude stale queries |\n| <a id=\"filters-property-type\"></a> `type?` | `QueryTypeFilter` | `'all'` | Filter to active queries, inactive queries or all queries |\n\n### query\n\n[`Query`](../classes/Query.md)\\<`any`, `any`, `any`, `any`\\>\n\nThe query to check.\n\n## Returns\n\n`boolean`\n\n`true` if the query matches every specified filter.\n\n## Example\n\n```ts\nconst queryCache = queryClient.getQueryCache()\n\nconst matchingQueries = queryCache\n  .getAll()\n  .filter((query) => matchQuery({ queryKey: ['posts'] }, query))\n```\n"}
