{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"overview","children":[{"type":"text","value":"Overview"}]},{"type":"code","value":"function mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#call-signature-1","children":[{"type":"inlineCode","value":"WithRequired<MutationOptions>"},{"type":"text","value":" → "},{"type":"inlineCode","value":"WithRequired<MutationOptions>"}]},{"type":"text","value":": You can generally pass everything to "},{"type":"inlineCode","value":"mutationOptions"},{"type":"text","value":" that you can also pass to "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":". A "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":" is required on this overload so the mutation can be looked up later, e.g. with "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#call-signature-2","children":[{"type":"inlineCode","value":"Omit<MutationOptions>"},{"type":"text","value":" → "},{"type":"inlineCode","value":"Omit<MutationOptions>"}]},{"type":"text","value":": You can generally pass everything to "},{"type":"inlineCode","value":"mutationOptions"},{"type":"text","value":" that you can also pass to "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":". No "},{"type":"inlineCode","value":"