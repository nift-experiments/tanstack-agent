ype-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tvariables","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" = "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"tonmutateresult","children":[{"type":"text","value":"TOnMutateResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/WithRequired.md","children":[{"type":"inlineCode","value":"WithRequired"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/MutationOptions.md","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The mutation options to use, identical to what you'd pass to "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":", with a\nrequired "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/WithRequired.md","children":[{"type":"inlineCode","value":"WithRequired"}]},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/MutationOptions.md","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, unchanged."}]},{"type":"heading","depth":3,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"useMutation.md","children":[{"type":"text","value":"useMutation"}]},{"type":"text","value":" to run the mutation these options describe."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"Looking the mutation up elsewhere via its "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":", e.g. for a global \"saving…\" indicator:"}]},{"type":"code","value":"import { mutationOptions, useMutationState } from '@tanstack/solid-query'\n\nconst createPostOptions = mutationOptions({\n  mutationKey: ['posts', 'create'],\n  mutationFn: createPost,\n})\n\nfunction SavingIndicator() {\n  const isCreatingPost = useMutationState(() => ({\n    filters: { mutationKey: createPostOptions.mutationKey, status: 'pending' },\n  }))\n\n  return isCreatingPost().length > 0 ? <span>Saving…</span> : null\n}","lang":"tsx"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/solid-query/src/mutationOptions.ts#L69","children":[{"type":"text","value":"packages/solid-query/src/mutationOptions.ts:69"}]}]},{"type":"paragraph","children":[{"type":"text","value":"You can generally pass everything to "},{"type":"inlineCode","value":"mutationOptions"},{"type":"text","value":" that you can also pass to "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":". No\n"},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":" is required on this overload — use this when you don't need to target the mutation via a\n"},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":" filter later (e.g. with "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":"); it can still be observed through other filters,\nsuch as "},{"type":"inlineCode","value":"status"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tdata-2","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"terror-2","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tvariables-2","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" = "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"tonmutateresult-2","children":[{"type":"text","value":"TOnMutateResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options-2","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/MutationOptions.md","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The mutation options to use, identical to what you'd pass to "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":", without a\n"},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/MutationOptions.md","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, unchanged."}]},{"type":"heading","depth":3,"id":"remarks","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"See the other overload's example for looking a mutation up via "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"useMutation.md","children":[{"type":"text","value":"useMutation"}]},{"type":"text","value":" to run the mutation these options describe."}]},{"type":"heading","depth":3,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { mutationOptions, useMutation } from '@tanstack/solid-query'\n\nconst createPostOptions = mutationOptions({\n  mutationFn: createPost,\n})\n\nfunction CreatePost() {\n  const createPostMutation = useMutation(() => createPostOptions)\n  return <button onClick={() => createPostMutation.mutate({ title: 'Hello' })}>Create</button>\n}","lang":"tsx"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-3","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/MutationOptions.md","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The mutation options to use, identical to what you'd pass to "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":", without a\n"},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":"."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/MutationOptions.md#properties","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/MutationOptions.md","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, unchanged."}]},{"type":"html","value":"<a id=\"result-properties\"></a>"},{"type":"heading","depth":3,"id":"result-properties","children":[{"type":"text","value":"Result properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/MutationOptions.md#properties","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":". See the type above for what it changes."}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tdata","text":"TData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tvariables","text":"TVariables","level":4},{"id":"tonmutateresult","text":"TOnMutateResult","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"returns","text":"Returns","level":3},{"id":"see","text":"See","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tdata-2","text":"TData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tvariables-2","text":"TVariables","level":4},{"id":"tonmutateresult-2","text":"TOnMutateResult","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"remarks","text":"Remarks","level":3},{"id":"see-2","text":"See","level":3},{"id":"example-2","text":"Example","level":3},{"id":"parameters-3","text":"Parameters","level":2},{"id":"options-3","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"returns-3","text":"Returns","level":2},{"id":"result-properties","text":"Result properties","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\n- [`WithRequired<MutationOptions>` → `WithRequired<MutationOptions>`](#call-signature-1): You can generally pass everything to `mutationOptions` that you can also pass to `useMutation`. A `mutationKey` is required on this overload so the mutation can be looked up later, e.g. with `useMutationState`.\n- [`Omit<MutationOptions>` → `Omit<MutationOptions>`](#call-signature-2): You can generally pass everything to `mutationOptions` that you can also pass to `useMutation`. No `mutationKey` is required on this overload — use this when you don't need to target the mutation via a `mutationKey` filter later (e.g. with `useMutationState`); it can still be observed through other filters, such as `status`.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\nDefined in: [packages/solid-query/src/mutationOptions.ts:31](https://github.com/TanStack/query/blob/main/packages/solid-query/src/mutationOptions.ts#L31)\n\nYou can generally pass everything to `mutationOptions` that you can also pass to `useMutation`. A\n`mutationKey` is required on this overload so the mutation can be looked up later, e.g. with\n`useMutationState`.\n\n### Type Parameters\n\n#### TData\n\n`TData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TVariables\n\n`TVariables` = `void`\n\n#### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n### Parameters\n\n#### options\n\n[`WithRequired`](../type-aliases/WithRequired.md)\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe mutation options to use, identical to what you'd pass to `useMutation`, with a\nrequired `mutationKey`.\n\n### Returns\n\n[`WithRequired`](../type-aliases/WithRequired.md)\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object, unchanged.\n\n### See\n\n[useMutation](useMutation.md) to run the mutation these options describe.\n\n### Example\n\nLooking the mutation up elsewhere via its `mutationKey`, e.g. for a global \"saving…\" indicator:\n```tsx\nimport { mutationOptions, useMutationState } from '@tanstack/solid-query'\n\nconst createPostOptions = mutationOptions({\n  mutationKey: ['posts', 'create'],\n  mutationFn: createPost,\n})\n\nfunction SavingIndicator() {\n  const isCreatingPost = useMutationState(() => ({\n    filters: { mutationKey: createPostOptions.mutationKey, status: 'pending' },\n  }))\n\n  return isCreatingPost().length > 0 ? <span>Saving…</span> : null\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\nDefined in: [packages/solid-query/src/mutationOptions.ts:69](https://github.com/TanStack/query/blob/main/packages/solid-query/src/mutationOptions.ts#L69)\n\nYou can generally pass everything to `mutationOptions` that you can also pass to `useMutation`. No\n`mutationKey` is required on this overload — use this when you don't need to target the mutation via a\n`mutationKey` filter later (e.g. with `useMutationState`); it can still be observed through other filters,\nsuch as `status`.\n\n### Type Parameters\n\n#### TData\n\n`TData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TVariables\n\n`TVariables` = `void`\n\n#### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n### Parameters\n\n#### options\n\n`Omit`\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe mutation options to use, identical to what you'd pass to `useMutation`, without a\n`mutationKey`.\n\n### Returns\n\n`Omit`\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object, unchanged.\n\n### Remarks\n\nSee the other overload's example for looking a mutation up via `useMutationState`.\n\n### See\n\n[useMutation](useMutation.md) to run the mutation these options describe.\n\n### Example\n\n```tsx\nimport { mutationOptions, useMutation } from '@tanstack/solid-query'\n\nconst createPostOptions = mutationOptions({\n  mutationFn: createPost,\n})\n\nfunction CreatePost() {\n  const createPostMutation = useMutation(() => createPostOptions)\n  return <button onClick={() => createPostMutation.mutate({ title: 'Hello' })}>Create</button>\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n`Omit`\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe mutation options to use, identical to what you'd pass to `useMutation`, without a\n`mutationKey`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationOptions`](../interfaces/MutationOptions.md#properties). See the type above for what it changes.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n`Omit`\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object, unchanged.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`MutationOptions`](../interfaces/MutationOptions.md#properties). See the type above for what it changes.\n","originalRawMarkdown":"---\nid: mutationOptions\ntitle: mutationOptions\nredirect_from:\n  - framework/solid/reference/mutationOptions\n---\n\n## Overview\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\n- [`WithRequired<MutationOptions>` → `WithRequired<MutationOptions>`](#call-signature-1): You can generally pass everything to `mutationOptions` that you can also pass to `useMutation`. A `mutationKey` is required on this overload so the mutation can be looked up later, e.g. with `useMutationState`.\n- [`Omit<MutationOptions>` → `Omit<MutationOptions>`](#call-signature-2): You can generally pass everything to `mutationOptions` that you can also pass to `useMutation`. No `mutationKey` is required on this overload — use this when you don't need to target the mutation via a `mutationKey` filter later (e.g. with `useMutationState`); it can still be observed through other filters, such as `status`.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): WithRequired<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\nDefined in: [packages/solid-query/src/mutationOptions.ts:31](https://github.com/TanStack/query/blob/main/packages/solid-query/src/mutationOptions.ts#L31)\n\nYou can generally pass everything to `mutationOptions` that you can also pass to `useMutation`. A\n`mutationKey` is required on this overload so the mutation can be looked up later, e.g. with\n`useMutationState`.\n\n### Type Parameters\n\n#### TData\n\n`TData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TVariables\n\n`TVariables` = `void`\n\n#### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n### Parameters\n\n#### options\n\n[`WithRequired`](../type-aliases/WithRequired.md)\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe mutation options to use, identical to what you'd pass to `useMutation`, with a\nrequired `mutationKey`.\n\n### Returns\n\n[`WithRequired`](../type-aliases/WithRequired.md)\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object, unchanged.\n\n### See\n\n[useMutation](useMutation.md) to run the mutation these options describe.\n\n### Example\n\nLooking the mutation up elsewhere via its `mutationKey`, e.g. for a global \"saving…\" indicator:\n```tsx\nimport { mutationOptions, useMutationState } from '@tanstack/solid-query'\n\nconst createPostOptions = mutationOptions({\n  mutationKey: ['posts', 'create'],\n  mutationFn: createPost,\n})\n\nfunction SavingIndicator() {\n  const isCreatingPost = useMutationState(() => ({\n    filters: { mutationKey: createPostOptions.mutationKey, status: 'pending' },\n  }))\n\n  return isCreatingPost().length > 0 ? <span>Saving…</span> : null\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<MutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\nDefined in: [packages/solid-query/src/mutationOptions.ts:69](https://github.com/TanStack/query/blob/main/packages/solid-query/src/mutationOptions.ts#L69)\n\nYou can generally pass everything to `mutationOptions` that you can also pass to `useMutation`. No\n`mutationKey` is required on this overload — use this when you don't need to target the mutation via a\n`mutationKey` filter later (e.g. with `useMutationState`); it can still be observed through other filters,\nsuch as `status`.\n\n### Type Parameters\n\n#### TData\n\n`TData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TVariables\n\n`TVariables` = `void`\n\n#### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n### Parameters\n\n#### options\n\n`Omit`\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe mutation options to use, identical to what you'd pass to `useMutation`, without a\n`mutationKey`.\n\n### Returns\n\n`Omit`\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object, unchanged.\n\n### Remarks\n\nSee the other overload's example for looking a mutation up via `useMutationState`.\n\n### See\n\n[useMutation](useMutation.md) to run the mutation these options describe.\n\n### Example\n\n```tsx\nimport { mutationOptions, useMutation } from '@tanstack/solid-query'\n\nconst createPostOptions = mutationOptions({\n  mutationFn: createPost,\n})\n\nfunction CreatePost() {\n  const createPostMutation = useMutation(() => createPostOptions)\n  return <button onClick={() => createPostMutation.mutate({ title: 'Hello' })}>Create</button>\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n`Omit`\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe mutation options to use, identical to what you'd pass to `useMutation`, without a\n`mutationKey`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationOptions`](../interfaces/MutationOptions.md#properties). See the type above for what it changes.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n`Omit`\\<[`MutationOptions`](../interfaces/MutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object, unchanged.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`MutationOptions`](../interfaces/MutationOptions.md#properties). See the type above for what it changes.\n"}
