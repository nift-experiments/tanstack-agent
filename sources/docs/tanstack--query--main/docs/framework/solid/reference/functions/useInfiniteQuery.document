type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same properties as "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":". "},{"type":"inlineCode","value":"data.pages"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"data.pageParams"},{"type":"text","value":" are also added, as long as a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" doesn't change "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" away from its default\n"},{"type":"inlineCode","value":"InfiniteData<TQueryFnData>"},{"type":"text","value":" shape."}]},{"type":"heading","depth":3,"id":"remarks","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"Keep in mind that imperative fetch calls, such as "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like "},{"type":"inlineCode","value":"hasNextPage && !isFetching"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"infiniteQueryOptions.md","children":[{"type":"text","value":"infiniteQueryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" and imperative APIs like "},{"type":"inlineCode","value":"queryClient.infiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { For } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  // `projectsQuery.data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n    initialData: { pages: [], pageParams: [] },\n  }))\n\n  return (\n    <div>\n      {projectsQuery.isError ? <span>Error: {projectsQuery.error.message}</span> : null}\n      <ul>\n        <For each={projectsQuery.data.pages}>\n          {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n        </For>\n      </ul>\n    </div>\n  )\n}","lang":"tsx"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/solid-query/src/useInfiniteQuery.ts#L184","children":[{"type":"text","value":"packages/solid-query/src/useInfiniteQuery.ts:184"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" are identical to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of\n"},{"type":"inlineCode","value":"initialPageParam"},{"type":"text","value":", "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":", "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":", and "},{"type":"inlineCode","value":"maxPages"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-2","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"terror-2","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-2","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"tquerykey-2","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"tpageparam-2","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options-2","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor returning the "},{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"text","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":" to use — everything\nyou can pass to "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"queryclient-2","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor for a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseInfiniteQueryResult.md","children":[{"type":"inlineCode","value":"UseInfiniteQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same properties as "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":". "},{"type":"inlineCode","value":"data.pages"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"data.pageParams"},{"type":"text","value":" are also added, as long as a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" doesn't change "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" away from its default\n"},{"type":"inlineCode","value":"InfiniteData<TQueryFnData>"},{"type":"text","value":" shape."}]},{"type":"heading","depth":3,"id":"remarks-2","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"Keep in mind that imperative fetch calls, such as "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like "},{"type":"inlineCode","value":"hasNextPage && !isFetching"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"infiniteQueryOptions.md","children":[{"type":"text","value":"infiniteQueryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" and imperative APIs like "},{"type":"inlineCode","value":"queryClient.infiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Fetching the next page from a \"Load More\" button click:"}]},{"type":"code","value":"import { For, Match, Switch } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <button\n          onClick={() => projectsQuery.fetchNextPage()}\n          disabled={!projectsQuery.hasNextPage || projectsQuery.isFetching}\n        >\n          {projectsQuery.isFetchingNextPage\n            ? 'Loading more...'\n            : projectsQuery.hasNextPage\n              ? 'Load More'\n              : 'Nothing more to load'}\n        </button>\n      </Match>\n    </Switch>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Fetching the next page automatically as the user scrolls, using an "},{"type":"inlineCode","value":"IntersectionObserver"},{"type":"text","value":" on a\nsentinel element after the list:"}]},{"type":"code","value":"import { For, Match, Switch, createEffect, onCleanup } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  let sentinelRef: HTMLDivElement | undefined\n\n  createEffect(() => {\n    if (sentinelRef == null || !projectsQuery.hasNextPage || projectsQuery.isFetching) return\n\n    const observer = new IntersectionObserver(([entry]) => {\n      if (entry?.isIntersecting) projectsQuery.fetchNextPage()\n    })\n    observer.observe(sentinelRef)\n\n    onCleanup(() => observer.disconnect())\n  })\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <div ref={sentinelRef}>{projectsQuery.isFetchingNextPage ? 'Loading more...' : null}</div>\n      </Match>\n    </Switch>\n  )\n}","lang":"tsx"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-3","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor returning the "},{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"text","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":" to use — everything\nyou can pass to "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":"."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/InfiniteQueryOptions.md#properties","children":[{"type":"inlineCode","value":"InfiniteQueryOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":3,"id":"queryclient-3","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor for a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseInfiniteQueryResult.md","children":[{"type":"inlineCode","value":"UseInfiniteQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same properties as "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":". "},{"type":"inlineCode","value":"data.pages"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"data.pageParams"},{"type":"text","value":" are also added, as long as a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" doesn't change "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" away from its default\n"},{"type":"inlineCode","value":"InfiniteData<TQueryFnData>"},{"type":"text","value":" shape."}]},{"type":"html","value":"<a id=\"result-properties\"></a>"},{"type":"heading","depth":3,"id":"result-properties","children":[{"type":"text","value":"Result properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-data\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"data"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The last successfully resolved data for the query."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-dataupdatedat\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"dataUpdatedAt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The timestamp for when the query most recently returned the "},{"type":"inlineCode","value":"status"},{"type":"text","value":" as "},{"type":"inlineCode","value":"\"success\""},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-error\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"error"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"tableCell","children":[{"type":"text","value":"The error object for the query, if an error was thrown. - Defaults to "},{"type":"inlineCode","value":"null"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-errorupdatecount\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"errorUpdateCount"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The sum of all errors."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-errorupdatedat\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"errorUpdatedAt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The timestamp for when the query most recently returned the "},{"type":"inlineCode","value":"status"},{"type":"text","value":" as "},{"type":"inlineCode","value":"\"error\""},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-failurecount\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"failureCount"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The failure count for the query. - Incremented every time the query fails. - Reset to "},{"type":"inlineCode","value":"0"},{"type":"text","value":" when the query succeeds."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-failurereason\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"failureReason"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"tableCell","children":[{"type":"text","value":"The failure reason for the query retry. - Reset to "},{"type":"inlineCode","value":"null"},{"type":"text","value":" when the query succeeds."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-fetchnextpage\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"fetchNextPage"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"options?"},{"type":"text","value":": "},{"type":"link","href":"../interfaces/FetchNextPageOptions.md","children":[{"type":"inlineCode","value":"FetchNextPageOptions"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/InfiniteQueryObserverResult.md","children":[{"type":"inlineCode","value":"InfiniteQueryObserverResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">>"}]},{"type":"tableCell","children":[{"type":"text","value":"This function allows you to fetch the next \"page\" of results."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-fetchpreviouspage\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"fetchPreviousPage"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"options?"},{"type":"text","value":": "},{"type":"link","href":"../interfaces/FetchPreviousPageOptions.md","children":[{"type":"inlineCode","value":"FetchPreviousPageOptions"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/InfiniteQueryObserverResult.md","children":[{"type":"inlineCode","value":"InfiniteQueryObserverResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">>"}]},{"type":"tableCell","children":[{"type":"text","value":"This function allows you to fetch the previous \"page\" of results."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-fetchstatus\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"fetchStatus"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"fetching\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"paused\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"idle\""}]},{"type":"tableCell","children":[{"type":"text","value":"The fetch status of the query. - "},{"type":"inlineCode","value":"fetching"},{"type":"text","value":": Is "},{"type":"inlineCode","value":"true"},{"type":"text","value":" whenever the queryFn is executing, which includes initial "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" as well as background refetch. - "},{"type":"inlineCode","value":"paused"},{"type":"text","value":": The query wanted to fetch, but has been "},{"type":"inlineCode","value":"paused"},{"type":"text","value":". - "},{"type":"inlineCode","value":"idle"},{"type":"text","value":": The query is not fetching. - See "},{"type":"link","href":"https://tanstack.com/query/latest/docs/framework/react/guides/network-mode","children":[{"type":"text","value":"Network Mode"}]},{"type":"text","value":" for more information."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-hasnextpage\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"hasNextPage"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if there is a next page to be fetched (known via the "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":" option)."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-haspreviouspage\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"hasPreviousPage"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if there is a previous page to be fetched (known via the "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":" option)."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isenabled\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isEnabled"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"true"},{"type":"text","value":" if this observer is enabled, "},{"type":"inlineCode","value":"false"},{"type":"text","value":" otherwise."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-iserror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"A derived boolean from the "},{"type":"inlineCode","value":"status"},{"type":"text","value":" variable, provided for convenience. - "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query attempt resulted in an error."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetched\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetched"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query has been fetched."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetchedaftermount\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetchedAfterMount"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query has been fetched after the component mounted. - This property can be used to not show any previously cached data."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetching\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetching"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"A derived boolean from the "},{"type":"inlineCode","value":"fetchStatus"},{"type":"text","value":" variable, provided for convenience. - "},{"type":"inlineCode","value":"true"},{"type":"text","value":" whenever the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" is executing, which includes initial "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" as well as background refetch."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetchingnextpage\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetchingNextPage"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" while fetching the next page with "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetchingpreviouspage\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetchingPreviousPage"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" while fetching the previous page with "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetchnextpageerror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetchNextPageError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query failed while fetching the next page."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetchpreviouspageerror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetchPreviousPageError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query failed while fetching the previous page."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isinitialloading\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"strike","children":[{"type":"inlineCode","value":"isInitialLoading"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Deprecated"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"isInitialLoading"},{"type":"text","value":" is being deprecated in favor of "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":" and will be removed in the next major version."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isloading\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isLoading"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Is "},{"type":"inlineCode","value":"true"},{"type":"text","value":" whenever the first fetch for a query is in-flight. - Is the same as "},{"type":"inlineCode","value":"isFetching && isPending"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isloadingerror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isLoadingError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query failed while fetching for the first time."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-ispaused\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isPaused"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"A derived boolean from the "},{"type":"inlineCode","value":"fetchStatus"},{"type":"text","value":" variable, provided for convenience. - The query wanted to fetch, but has been "},{"type":"inlineCode","value":"paused"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-ispending\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isPending"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" if there's no cached data and no query attempt was finished yet."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isplaceholderdata\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isPlaceholderData"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the data shown is the placeholder data."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isrefetcherror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isRefetchError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query failed while refetching."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isrefetching\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isRefetching"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Is "},{"type":"inlineCode","value":"true"},{"type":"text","value":" whenever a background refetch is in-flight, which "},{"type":"emphasis","children":[{"type":"text","value":"does not"}]},{"type":"text","value":" include initial "},{"type":"inlineCode","value":"pending"},{"type":"text","value":". - Is the same as "},{"type":"inlineCode","value":"isFetching && !isPending"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isstale\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isStale"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the data in the cache is invalidated or if the data is older than the given "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-issuccess\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isSuccess"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"A derived boolean from the "},{"type":"inlineCode","value":"status"},{"type":"text","value":" variable, provided for convenience. - "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query has received a response with no errors and is ready to display its data."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-refetch\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"refetch"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"options?"},{"type":"text","value":": "},{"type":"link","href":"../interfaces/RefetchOptions.md","children":[{"type":"inlineCode","value":"RefetchOptions"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/QueryObserverResult.md","children":[{"type":"inlineCode","value":"QueryObserverResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">>"}]},{"type":"tableCell","children":[{"type":"text","value":"A function to manually refetch the query."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-status\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"status"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"error\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"pending\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"success\""}]},{"type":"tableCell","children":[{"type":"text","value":"The status of the query. - Will be: - "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" if there's no cached data and no query attempt was finished yet. - "},{"type":"inlineCode","value":"error"},{"type":"text","value":" if the query attempt resulted in an error. - "},{"type":"inlineCode","value":"success"},{"type":"text","value":" if the query has received a response with no errors and is ready to display its data."}]}]]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tqueryfndata","text":"TQueryFnData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tdata","text":"TData","level":4},{"id":"tquerykey","text":"TQueryKey","level":4},{"id":"tpageparam","text":"TPageParam","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"queryclient","text":"queryClient?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"remarks","text":"Remarks","level":3},{"id":"see","text":"See","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tqueryfndata-2","text":"TQueryFnData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tdata-2","text":"TData","level":4},{"id":"tquerykey-2","text":"TQueryKey","level":4},{"id":"tpageparam-2","text":"TPageParam","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"queryclient-2","text":"queryClient?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"remarks-2","text":"Remarks","level":3},{"id":"see-2","text":"See","level":3},{"id":"examples","text":"Examples","level":3},{"id":"parameters-3","text":"Parameters","level":2},{"id":"options-3","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient-3","text":"queryClient?","level":3},{"id":"returns-3","text":"Returns","level":2},{"id":"result-properties","text":"Result properties","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;\n```\n\n- [`DefinedInitialDataInfiniteOptions` → `DefinedUseInfiniteQueryResult`](#call-signature-1): The options for `useInfiniteQuery` are identical to `useQuery`, with the addition of `initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n- [`UndefinedInitialDataInfiniteOptions` → `UseInfiniteQueryResult`](#call-signature-2): The options for `useInfiniteQuery` are identical to `useQuery`, with the addition of `initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;\n```\n\nDefined in: [packages/solid-query/src/useInfiniteQuery.ts:68](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useInfiniteQuery.ts#L68)\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\nThis overload is selected when `initialData` is set.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you\ncan pass to `useInfiniteQuery`, with `initialData` set.\n\n#### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`DefinedUseInfiniteQueryResult`](../type-aliases/DefinedUseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### See\n\n[infiniteQueryOptions](infiniteQueryOptions.md) to share these options between `useInfiniteQuery` and imperative APIs like `queryClient.infiniteQuery`.\n\n### Example\n\n```tsx\nimport { For } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  // `projectsQuery.data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n    initialData: { pages: [], pageParams: [] },\n  }))\n\n  return (\n    <div>\n      {projectsQuery.isError ? <span>Error: {projectsQuery.error.message}</span> : null}\n      <ul>\n        <For each={projectsQuery.data.pages}>\n          {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n        </For>\n      </ul>\n    </div>\n  )\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;\n```\n\nDefined in: [packages/solid-query/src/useInfiniteQuery.ts:184](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useInfiniteQuery.ts#L184)\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything\nyou can pass to `useInfiniteQuery`.\n\n#### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryResult`](../type-aliases/UseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### See\n\n[infiniteQueryOptions](infiniteQueryOptions.md) to share these options between `useInfiniteQuery` and imperative APIs like `queryClient.infiniteQuery`.\n\n### Examples\n\nFetching the next page from a \"Load More\" button click:\n```tsx\nimport { For, Match, Switch } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <button\n          onClick={() => projectsQuery.fetchNextPage()}\n          disabled={!projectsQuery.hasNextPage || projectsQuery.isFetching}\n        >\n          {projectsQuery.isFetchingNextPage\n            ? 'Loading more...'\n            : projectsQuery.hasNextPage\n              ? 'Load More'\n              : 'Nothing more to load'}\n        </button>\n      </Match>\n    </Switch>\n  )\n}\n```\n\nFetching the next page automatically as the user scrolls, using an `IntersectionObserver` on a\nsentinel element after the list:\n```tsx\nimport { For, Match, Switch, createEffect, onCleanup } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  let sentinelRef: HTMLDivElement | undefined\n\n  createEffect(() => {\n    if (sentinelRef == null || !projectsQuery.hasNextPage || projectsQuery.isFetching) return\n\n    const observer = new IntersectionObserver(([entry]) => {\n      if (entry?.isIntersecting) projectsQuery.fetchNextPage()\n    })\n    observer.observe(sentinelRef)\n\n    onCleanup(() => observer.disconnect())\n  })\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <div ref={sentinelRef}>{projectsQuery.isFetchingNextPage ? 'Loading more...' : null}</div>\n      </Match>\n    </Switch>\n  )\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything\nyou can pass to `useInfiniteQuery`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`InfiniteQueryOptions`](../interfaces/InfiniteQueryOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UseInfiniteQueryResult`](../type-aliases/UseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"result-property-data\"></a> `data` | `TData` \\| `undefined` | The last successfully resolved data for the query. |\n| <a id=\"result-property-dataupdatedat\"></a> `dataUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"success\"`. |\n| <a id=\"result-property-error\"></a> `error` | `TError` \\| `null` | The error object for the query, if an error was thrown. - Defaults to `null`. |\n| <a id=\"result-property-errorupdatecount\"></a> `errorUpdateCount` | `number` | The sum of all errors. |\n| <a id=\"result-property-errorupdatedat\"></a> `errorUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"error\"`. |\n| <a id=\"result-property-failurecount\"></a> `failureCount` | `number` | The failure count for the query. - Incremented every time the query fails. - Reset to `0` when the query succeeds. |\n| <a id=\"result-property-failurereason\"></a> `failureReason` | `TError` \\| `null` | The failure reason for the query retry. - Reset to `null` when the query succeeds. |\n| <a id=\"result-property-fetchnextpage\"></a> `fetchNextPage` | (`options?`: [`FetchNextPageOptions`](../interfaces/FetchNextPageOptions.md)) => `Promise`\\<[`InfiniteQueryObserverResult`](../type-aliases/InfiniteQueryObserverResult.md)\\<`TData`, `TError`\\>\\> | This function allows you to fetch the next \"page\" of results. |\n| <a id=\"result-property-fetchpreviouspage\"></a> `fetchPreviousPage` | (`options?`: [`FetchPreviousPageOptions`](../interfaces/FetchPreviousPageOptions.md)) => `Promise`\\<[`InfiniteQueryObserverResult`](../type-aliases/InfiniteQueryObserverResult.md)\\<`TData`, `TError`\\>\\> | This function allows you to fetch the previous \"page\" of results. |\n| <a id=\"result-property-fetchstatus\"></a> `fetchStatus` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | The fetch status of the query. - `fetching`: Is `true` whenever the queryFn is executing, which includes initial `pending` as well as background refetch. - `paused`: The query wanted to fetch, but has been `paused`. - `idle`: The query is not fetching. - See [Network Mode](https://tanstack.com/query/latest/docs/framework/react/guides/network-mode) for more information. |\n| <a id=\"result-property-hasnextpage\"></a> `hasNextPage` | `boolean` | Will be `true` if there is a next page to be fetched (known via the `getNextPageParam` option). |\n| <a id=\"result-property-haspreviouspage\"></a> `hasPreviousPage` | `boolean` | Will be `true` if there is a previous page to be fetched (known via the `getPreviousPageParam` option). |\n| <a id=\"result-property-isenabled\"></a> `isEnabled` | `boolean` | `true` if this observer is enabled, `false` otherwise. |\n| <a id=\"result-property-iserror\"></a> `isError` | `boolean` | A derived boolean from the `status` variable, provided for convenience. - `true` if the query attempt resulted in an error. |\n| <a id=\"result-property-isfetched\"></a> `isFetched` | `boolean` | Will be `true` if the query has been fetched. |\n| <a id=\"result-property-isfetchedaftermount\"></a> `isFetchedAfterMount` | `boolean` | Will be `true` if the query has been fetched after the component mounted. - This property can be used to not show any previously cached data. |\n| <a id=\"result-property-isfetching\"></a> `isFetching` | `boolean` | A derived boolean from the `fetchStatus` variable, provided for convenience. - `true` whenever the `queryFn` is executing, which includes initial `pending` as well as background refetch. |\n| <a id=\"result-property-isfetchingnextpage\"></a> `isFetchingNextPage` | `boolean` | Will be `true` while fetching the next page with `fetchNextPage`. |\n| <a id=\"result-property-isfetchingpreviouspage\"></a> `isFetchingPreviousPage` | `boolean` | Will be `true` while fetching the previous page with `fetchPreviousPage`. |\n| <a id=\"result-property-isfetchnextpageerror\"></a> `isFetchNextPageError` | `boolean` | Will be `true` if the query failed while fetching the next page. |\n| <a id=\"result-property-isfetchpreviouspageerror\"></a> `isFetchPreviousPageError` | `boolean` | Will be `true` if the query failed while fetching the previous page. |\n| <a id=\"result-property-isinitialloading\"></a> ~~`isInitialLoading`~~ | `boolean` | **Deprecated** `isInitialLoading` is being deprecated in favor of `isLoading` and will be removed in the next major version. |\n| <a id=\"result-property-isloading\"></a> `isLoading` | `boolean` | Is `true` whenever the first fetch for a query is in-flight. - Is the same as `isFetching && isPending`. |\n| <a id=\"result-property-isloadingerror\"></a> `isLoadingError` | `boolean` | Will be `true` if the query failed while fetching for the first time. |\n| <a id=\"result-property-ispaused\"></a> `isPaused` | `boolean` | A derived boolean from the `fetchStatus` variable, provided for convenience. - The query wanted to fetch, but has been `paused`. |\n| <a id=\"result-property-ispending\"></a> `isPending` | `boolean` | Will be `pending` if there's no cached data and no query attempt was finished yet. |\n| <a id=\"result-property-isplaceholderdata\"></a> `isPlaceholderData` | `boolean` | Will be `true` if the data shown is the placeholder data. |\n| <a id=\"result-property-isrefetcherror\"></a> `isRefetchError` | `boolean` | Will be `true` if the query failed while refetching. |\n| <a id=\"result-property-isrefetching\"></a> `isRefetching` | `boolean` | Is `true` whenever a background refetch is in-flight, which _does not_ include initial `pending`. - Is the same as `isFetching && !isPending`. |\n| <a id=\"result-property-isstale\"></a> `isStale` | `boolean` | Will be `true` if the data in the cache is invalidated or if the data is older than the given `staleTime`. |\n| <a id=\"result-property-issuccess\"></a> `isSuccess` | `boolean` | A derived boolean from the `status` variable, provided for convenience. - `true` if the query has received a response with no errors and is ready to display its data. |\n| <a id=\"result-property-refetch\"></a> `refetch` | (`options?`: [`RefetchOptions`](../interfaces/RefetchOptions.md)) => `Promise`\\<[`QueryObserverResult`](../type-aliases/QueryObserverResult.md)\\<`TData`, `TError`\\>\\> | A function to manually refetch the query. |\n| <a id=\"result-property-status\"></a> `status` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` | The status of the query. - Will be: - `pending` if there's no cached data and no query attempt was finished yet. - `error` if the query attempt resulted in an error. - `success` if the query has received a response with no errors and is ready to display its data. |\n","originalRawMarkdown":"---\nid: useInfiniteQuery\ntitle: useInfiniteQuery\nredirect_from:\n  - framework/solid/reference/useInfiniteQuery\n---\n\n## Overview\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;\n```\n\n- [`DefinedInitialDataInfiniteOptions` → `DefinedUseInfiniteQueryResult`](#call-signature-1): The options for `useInfiniteQuery` are identical to `useQuery`, with the addition of `initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n- [`UndefinedInitialDataInfiniteOptions` → `UseInfiniteQueryResult`](#call-signature-2): The options for `useInfiniteQuery` are identical to `useQuery`, with the addition of `initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;\n```\n\nDefined in: [packages/solid-query/src/useInfiniteQuery.ts:68](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useInfiniteQuery.ts#L68)\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\nThis overload is selected when `initialData` is set.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you\ncan pass to `useInfiniteQuery`, with `initialData` set.\n\n#### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`DefinedUseInfiniteQueryResult`](../type-aliases/DefinedUseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### See\n\n[infiniteQueryOptions](infiniteQueryOptions.md) to share these options between `useInfiniteQuery` and imperative APIs like `queryClient.infiniteQuery`.\n\n### Example\n\n```tsx\nimport { For } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  // `projectsQuery.data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n    initialData: { pages: [], pageParams: [] },\n  }))\n\n  return (\n    <div>\n      {projectsQuery.isError ? <span>Error: {projectsQuery.error.message}</span> : null}\n      <ul>\n        <For each={projectsQuery.data.pages}>\n          {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n        </For>\n      </ul>\n    </div>\n  )\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;\n```\n\nDefined in: [packages/solid-query/src/useInfiniteQuery.ts:184](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useInfiniteQuery.ts#L184)\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything\nyou can pass to `useInfiniteQuery`.\n\n#### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryResult`](../type-aliases/UseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### See\n\n[infiniteQueryOptions](infiniteQueryOptions.md) to share these options between `useInfiniteQuery` and imperative APIs like `queryClient.infiniteQuery`.\n\n### Examples\n\nFetching the next page from a \"Load More\" button click:\n```tsx\nimport { For, Match, Switch } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <button\n          onClick={() => projectsQuery.fetchNextPage()}\n          disabled={!projectsQuery.hasNextPage || projectsQuery.isFetching}\n        >\n          {projectsQuery.isFetchingNextPage\n            ? 'Loading more...'\n            : projectsQuery.hasNextPage\n              ? 'Load More'\n              : 'Nothing more to load'}\n        </button>\n      </Match>\n    </Switch>\n  )\n}\n```\n\nFetching the next page automatically as the user scrolls, using an `IntersectionObserver` on a\nsentinel element after the list:\n```tsx\nimport { For, Match, Switch, createEffect, onCleanup } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  let sentinelRef: HTMLDivElement | undefined\n\n  createEffect(() => {\n    if (sentinelRef == null || !projectsQuery.hasNextPage || projectsQuery.isFetching) return\n\n    const observer = new IntersectionObserver(([entry]) => {\n      if (entry?.isIntersecting) projectsQuery.fetchNextPage()\n    })\n    observer.observe(sentinelRef)\n\n    onCleanup(() => observer.disconnect())\n  })\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <div ref={sentinelRef}>{projectsQuery.isFetchingNextPage ? 'Loading more...' : null}</div>\n      </Match>\n    </Switch>\n  )\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything\nyou can pass to `useInfiniteQuery`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`InfiniteQueryOptions`](../interfaces/InfiniteQueryOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UseInfiniteQueryResult`](../type-aliases/UseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"result-property-data\"></a> `data` | `TData` \\| `undefined` | The last successfully resolved data for the query. |\n| <a id=\"result-property-dataupdatedat\"></a> `dataUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"success\"`. |\n| <a id=\"result-property-error\"></a> `error` | `TError` \\| `null` | The error object for the query, if an error was thrown. - Defaults to `null`. |\n| <a id=\"result-property-errorupdatecount\"></a> `errorUpdateCount` | `number` | The sum of all errors. |\n| <a id=\"result-property-errorupdatedat\"></a> `errorUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"error\"`. |\n| <a id=\"result-property-failurecount\"></a> `failureCount` | `number` | The failure count for the query. - Incremented every time the query fails. - Reset to `0` when the query succeeds. |\n| <a id=\"result-property-failurereason\"></a> `failureReason` | `TError` \\| `null` | The failure reason for the query retry. - Reset to `null` when the query succeeds. |\n| <a id=\"result-property-fetchnextpage\"></a> `fetchNextPage` | (`options?`: [`FetchNextPageOptions`](../interfaces/FetchNextPageOptions.md)) => `Promise`\\<[`InfiniteQueryObserverResult`](../type-aliases/InfiniteQueryObserverResult.md)\\<`TData`, `TError`\\>\\> | This function allows you to fetch the next \"page\" of results. |\n| <a id=\"result-property-fetchpreviouspage\"></a> `fetchPreviousPage` | (`options?`: [`FetchPreviousPageOptions`](../interfaces/FetchPreviousPageOptions.md)) => `Promise`\\<[`InfiniteQueryObserverResult`](../type-aliases/InfiniteQueryObserverResult.md)\\<`TData`, `TError`\\>\\> | This function allows you to fetch the previous \"page\" of results. |\n| <a id=\"result-property-fetchstatus\"></a> `fetchStatus` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | The fetch status of the query. - `fetching`: Is `true` whenever the queryFn is executing, which includes initial `pending` as well as background refetch. - `paused`: The query wanted to fetch, but has been `paused`. - `idle`: The query is not fetching. - See [Network Mode](https://tanstack.com/query/latest/docs/framework/react/guides/network-mode) for more information. |\n| <a id=\"result-property-hasnextpage\"></a> `hasNextPage` | `boolean` | Will be `true` if there is a next page to be fetched (known via the `getNextPageParam` option). |\n| <a id=\"result-property-haspreviouspage\"></a> `hasPreviousPage` | `boolean` | Will be `true` if there is a previous page to be fetched (known via the `getPreviousPageParam` option). |\n| <a id=\"result-property-isenabled\"></a> `isEnabled` | `boolean` | `true` if this observer is enabled, `false` otherwise. |\n| <a id=\"result-property-iserror\"></a> `isError` | `boolean` | A derived boolean from the `status` variable, provided for convenience. - `true` if the query attempt resulted in an error. |\n| <a id=\"result-property-isfetched\"></a> `isFetched` | `boolean` | Will be `true` if the query has been fetched. |\n| <a id=\"result-property-isfetchedaftermount\"></a> `isFetchedAfterMount` | `boolean` | Will be `true` if the query has been fetched after the component mounted. - This property can be used to not show any previously cached data. |\n| <a id=\"result-property-isfetching\"></a> `isFetching` | `boolean` | A derived boolean from the `fetchStatus` variable, provided for convenience. - `true` whenever the `queryFn` is executing, which includes initial `pending` as well as background refetch. |\n| <a id=\"result-property-isfetchingnextpage\"></a> `isFetchingNextPage` | `boolean` | Will be `true` while fetching the next page with `fetchNextPage`. |\n| <a id=\"result-property-isfetchingpreviouspage\"></a> `isFetchingPreviousPage` | `boolean` | Will be `true` while fetching the previous page with `fetchPreviousPage`. |\n| <a id=\"result-property-isfetchnextpageerror\"></a> `isFetchNextPageError` | `boolean` | Will be `true` if the query failed while fetching the next page. |\n| <a id=\"result-property-isfetchpreviouspageerror\"></a> `isFetchPreviousPageError` | `boolean` | Will be `true` if the query failed while fetching the previous page. |\n| <a id=\"result-property-isinitialloading\"></a> ~~`isInitialLoading`~~ | `boolean` | **Deprecated** `isInitialLoading` is being deprecated in favor of `isLoading` and will be removed in the next major version. |\n| <a id=\"result-property-isloading\"></a> `isLoading` | `boolean` | Is `true` whenever the first fetch for a query is in-flight. - Is the same as `isFetching && isPending`. |\n| <a id=\"result-property-isloadingerror\"></a> `isLoadingError` | `boolean` | Will be `true` if the query failed while fetching for the first time. |\n| <a id=\"result-property-ispaused\"></a> `isPaused` | `boolean` | A derived boolean from the `fetchStatus` variable, provided for convenience. - The query wanted to fetch, but has been `paused`. |\n| <a id=\"result-property-ispending\"></a> `isPending` | `boolean` | Will be `pending` if there's no cached data and no query attempt was finished yet. |\n| <a id=\"result-property-isplaceholderdata\"></a> `isPlaceholderData` | `boolean` | Will be `true` if the data shown is the placeholder data. |\n| <a id=\"result-property-isrefetcherror\"></a> `isRefetchError` | `boolean` | Will be `true` if the query failed while refetching. |\n| <a id=\"result-property-isrefetching\"></a> `isRefetching` | `boolean` | Is `true` whenever a background refetch is in-flight, which _does not_ include initial `pending`. - Is the same as `isFetching && !isPending`. |\n| <a id=\"result-property-isstale\"></a> `isStale` | `boolean` | Will be `true` if the data in the cache is invalidated or if the data is older than the given `staleTime`. |\n| <a id=\"result-property-issuccess\"></a> `isSuccess` | `boolean` | A derived boolean from the `status` variable, provided for convenience. - `true` if the query has received a response with no errors and is ready to display its data. |\n| <a id=\"result-property-refetch\"></a> `refetch` | (`options?`: [`RefetchOptions`](../interfaces/RefetchOptions.md)) => `Promise`\\<[`QueryObserverResult`](../type-aliases/QueryObserverResult.md)\\<`TData`, `TError`\\>\\> | A function to manually refetch the query. |\n| <a id=\"result-property-status\"></a> `status` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` | The status of the query. - Will be: - `pending` if there's no cached data and no query attempt was finished yet. - `error` if the query attempt resulted in an error. - `success` if the query has received a response with no errors and is ready to display its data. |\n"}
