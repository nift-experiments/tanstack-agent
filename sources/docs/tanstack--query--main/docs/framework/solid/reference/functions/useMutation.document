{"document":{"type":"root","children":[{"type":"code","value":"function useMutation<TData, TError, TVariables, TOnMutateResult>(options: UseMutationOptions<TData, TError, TVariables, TOnMutateResult>, queryClient?: Accessor<QueryClient>): UseMutationResult<TData, TError, TVariables, TOnMutateResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/solid-query/src/useMutation.ts#L170","children":[{"type":"text","value":"packages/solid-query/src/useMutation.ts:170"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n"},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":" is the primitive for that."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":3,"id":"tvariables","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" = "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"tonmutateresult","children":[{"type":"text","value":"TOnMutateResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseMutationOptions.md","children":[{"type":"inlineCode","value":"UseMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor returning the "},{"type":"link","href":"../type-aliases/UseMutationOptions.md","children":[{"type":"text","value":"UseMutationOptions"}]},{"type":"text","value":" to use."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/MutationOptions.md#properties","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor for a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseMutationResult.md","children":[{"type":"inlineCode","value":"UseMutationResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"mutate"},{"type":"text","value":"/"},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" also accept per-call "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onError"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callbacks as a second\nargument, useful for triggering call-site side effects (e.g. navigation) without coupling them to the shared\nmutation definition. Hook-level callbacks (passed to "},{"type":"inlineCode","value":"options"},{"type":"text","value":") fire for every mutation; per-call callbacks\nfire only for the latest call you've made, and only while the component is still mounted — unmounting before\nthe mutation settles removes the subscription and prevents them from firing."}]},{"type":"html","value":"<a id=\"result-properties\"></a>"},{"type":"heading","depth":3,"id":"result-properties","children":[{"type":"text","value":"Result properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/MutationObserverBaseResult.md#properties","children":[{"type":"inlineCode","value":"MutationObserverBaseResult"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction TodoItem(props: { id: number }) {\n  const queryClient = useQueryClient()\n\n  const deleteTodoMutation = useMutation(() => ({\n    mutationFn: deleteTodo,\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n\n  return (\n    <button onClick={() => deleteTodoMutation.mutate({ id: props.id })} disabled={deleteTodoMutation.isPending}>\n      Delete\n    </button>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Rendering the mutation's own state, rather than just firing it off:"}]},{"type":"code","value":"import { Match, Switch } from 'solid-js'\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodo() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  return (\n    <Switch fallback={<button onClick={() => addMutation.mutate('Item')}>Add</button>}>\n      <Match when={addMutation.isPending}>Adding todo...</Match>\n      <Match when={addMutation.isError}>\n        <div>An error occurred: {addMutation.error?.message}</div>\n        <button onClick={() => addMutation.mutate('Item')}>Add</button>\n      </Match>\n    </Switch>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Optimistic update via "},{"type":"inlineCode","value":"onMutate"},{"type":"text","value":", rolling back on "},{"type":"inlineCode","value":"onError"},{"type":"text","value":":"}]},{"type":"code","value":"import { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodo() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onMutate: async (newTodo) => {\n      await queryClient.cancelQueries({ queryKey: ['todos'] })\n      const previousTodos = queryClient.getQueryData<Array<string>>(['todos'])\n\n      queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n        ...(old ?? []),\n        newTodo,\n      ])\n\n      // Passed to `onError` as `onMutateResult` if the mutation fails.\n      return { previousTodos }\n    },\n    onError: (_err, _newTodo, onMutateResult) => {\n      queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n    },\n    onSettled: () => {\n      queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n\n  return (\n    <button onClick={() => addMutation.mutate('Item')}>Add</button>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Callbacks passed per call to "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" only fire for the last call — "},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" gives you a\npromise per call instead, so you can wait for all of them when they succeed:"}]},{"type":"code","value":"import { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodos() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    try {\n      await Promise.all(todos.map((todo) => addMutation.mutateAsync(todo)))\n    } catch (error) {\n      console.error('Failed to add todos:', error)\n    }\n  }\n\n  return (\n    <button onClick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n      Add all\n    </button>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If some of the mutations above can fail independently of the others, and you want to know which ones\ndid — rather than losing that information the moment the first one rejects — swap "},{"type":"inlineCode","value":"Promise.all"},{"type":"text","value":" for\n"},{"type":"inlineCode","value":"Promise.allSettled"},{"type":"text","value":":"}]},{"type":"code","value":"import { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodos() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    const addResults = await Promise.allSettled(\n      todos.map((todo) => addMutation.mutateAsync(todo)),\n    )\n\n    addResults.forEach((addResult, index) => {\n      if (addResult.status === 'rejected') {\n        console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n      }\n    })\n  }\n\n  return (\n    <button onClick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n      Add all\n    </button>\n  )\n}","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tvariables","text":"TVariables","level":3},{"id":"tonmutateresult","text":"TOnMutateResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"result-properties","text":"Result properties","level":3},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useMutation<TData, TError, TVariables, TOnMutateResult>(options: UseMutationOptions<TData, TError, TVariables, TOnMutateResult>, queryClient?: Accessor<QueryClient>): UseMutationResult<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/solid-query/src/useMutation.ts:170](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useMutation.ts#L170)\n\nUnlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n`useMutation` is the primitive for that.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Parameters\n\n### options\n\n[`UseMutationOptions`](../type-aliases/UseMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nAn accessor returning the [UseMutationOptions](../type-aliases/UseMutationOptions.md) to use.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationOptions`](../interfaces/MutationOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n## Returns\n\n[`UseMutationResult`](../type-aliases/UseMutationResult.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\n`mutate`/`mutateAsync` also accept per-call `onSuccess`/`onError`/`onSettled` callbacks as a second\nargument, useful for triggering call-site side effects (e.g. navigation) without coupling them to the shared\nmutation definition. Hook-level callbacks (passed to `options`) fire for every mutation; per-call callbacks\nfire only for the latest call you've made, and only while the component is still mounted — unmounting before\nthe mutation settles removes the subscription and prevents them from firing.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`MutationObserverBaseResult`](../interfaces/MutationObserverBaseResult.md#properties). See the type above for what it changes.\n\n## Examples\n\n```tsx\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction TodoItem(props: { id: number }) {\n  const queryClient = useQueryClient()\n\n  const deleteTodoMutation = useMutation(() => ({\n    mutationFn: deleteTodo,\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n\n  return (\n    <button onClick={() => deleteTodoMutation.mutate({ id: props.id })} disabled={deleteTodoMutation.isPending}>\n      Delete\n    </button>\n  )\n}\n```\n\nRendering the mutation's own state, rather than just firing it off:\n```tsx\nimport { Match, Switch } from 'solid-js'\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodo() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  return (\n    <Switch fallback={<button onClick={() => addMutation.mutate('Item')}>Add</button>}>\n      <Match when={addMutation.isPending}>Adding todo...</Match>\n      <Match when={addMutation.isError}>\n        <div>An error occurred: {addMutation.error?.message}</div>\n        <button onClick={() => addMutation.mutate('Item')}>Add</button>\n      </Match>\n    </Switch>\n  )\n}\n```\n\nOptimistic update via `onMutate`, rolling back on `onError`:\n```tsx\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodo() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onMutate: async (newTodo) => {\n      await queryClient.cancelQueries({ queryKey: ['todos'] })\n      const previousTodos = queryClient.getQueryData<Array<string>>(['todos'])\n\n      queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n        ...(old ?? []),\n        newTodo,\n      ])\n\n      // Passed to `onError` as `onMutateResult` if the mutation fails.\n      return { previousTodos }\n    },\n    onError: (_err, _newTodo, onMutateResult) => {\n      queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n    },\n    onSettled: () => {\n      queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n\n  return (\n    <button onClick={() => addMutation.mutate('Item')}>Add</button>\n  )\n}\n```\n\nCallbacks passed per call to `mutate` only fire for the last call — `mutateAsync` gives you a\npromise per call instead, so you can wait for all of them when they succeed:\n```tsx\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodos() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    try {\n      await Promise.all(todos.map((todo) => addMutation.mutateAsync(todo)))\n    } catch (error) {\n      console.error('Failed to add todos:', error)\n    }\n  }\n\n  return (\n    <button onClick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n      Add all\n    </button>\n  )\n}\n```\n\nIf some of the mutations above can fail independently of the others, and you want to know which ones\ndid — rather than losing that information the moment the first one rejects — swap `Promise.all` for\n`Promise.allSettled`:\n```tsx\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodos() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    const addResults = await Promise.allSettled(\n      todos.map((todo) => addMutation.mutateAsync(todo)),\n    )\n\n    addResults.forEach((addResult, index) => {\n      if (addResult.status === 'rejected') {\n        console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n      }\n    })\n  }\n\n  return (\n    <button onClick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n      Add all\n    </button>\n  )\n}\n```\n","originalRawMarkdown":"---\nid: useMutation\ntitle: useMutation\nredirect_from:\n  - framework/solid/reference/useMutation\n---\n\n```ts\nfunction useMutation<TData, TError, TVariables, TOnMutateResult>(options: UseMutationOptions<TData, TError, TVariables, TOnMutateResult>, queryClient?: Accessor<QueryClient>): UseMutationResult<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/solid-query/src/useMutation.ts:170](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useMutation.ts#L170)\n\nUnlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n`useMutation` is the primitive for that.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Parameters\n\n### options\n\n[`UseMutationOptions`](../type-aliases/UseMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nAn accessor returning the [UseMutationOptions](../type-aliases/UseMutationOptions.md) to use.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationOptions`](../interfaces/MutationOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n## Returns\n\n[`UseMutationResult`](../type-aliases/UseMutationResult.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\n`mutate`/`mutateAsync` also accept per-call `onSuccess`/`onError`/`onSettled` callbacks as a second\nargument, useful for triggering call-site side effects (e.g. navigation) without coupling them to the shared\nmutation definition. Hook-level callbacks (passed to `options`) fire for every mutation; per-call callbacks\nfire only for the latest call you've made, and only while the component is still mounted — unmounting before\nthe mutation settles removes the subscription and prevents them from firing.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`MutationObserverBaseResult`](../interfaces/MutationObserverBaseResult.md#properties). See the type above for what it changes.\n\n## Examples\n\n```tsx\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction TodoItem(props: { id: number }) {\n  const queryClient = useQueryClient()\n\n  const deleteTodoMutation = useMutation(() => ({\n    mutationFn: deleteTodo,\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n\n  return (\n    <button onClick={() => deleteTodoMutation.mutate({ id: props.id })} disabled={deleteTodoMutation.isPending}>\n      Delete\n    </button>\n  )\n}\n```\n\nRendering the mutation's own state, rather than just firing it off:\n```tsx\nimport { Match, Switch } from 'solid-js'\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodo() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  return (\n    <Switch fallback={<button onClick={() => addMutation.mutate('Item')}>Add</button>}>\n      <Match when={addMutation.isPending}>Adding todo...</Match>\n      <Match when={addMutation.isError}>\n        <div>An error occurred: {addMutation.error?.message}</div>\n        <button onClick={() => addMutation.mutate('Item')}>Add</button>\n      </Match>\n    </Switch>\n  )\n}\n```\n\nOptimistic update via `onMutate`, rolling back on `onError`:\n```tsx\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodo() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onMutate: async (newTodo) => {\n      await queryClient.cancelQueries({ queryKey: ['todos'] })\n      const previousTodos = queryClient.getQueryData<Array<string>>(['todos'])\n\n      queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n        ...(old ?? []),\n        newTodo,\n      ])\n\n      // Passed to `onError` as `onMutateResult` if the mutation fails.\n      return { previousTodos }\n    },\n    onError: (_err, _newTodo, onMutateResult) => {\n      queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n    },\n    onSettled: () => {\n      queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n\n  return (\n    <button onClick={() => addMutation.mutate('Item')}>Add</button>\n  )\n}\n```\n\nCallbacks passed per call to `mutate` only fire for the last call — `mutateAsync` gives you a\npromise per call instead, so you can wait for all of them when they succeed:\n```tsx\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodos() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    try {\n      await Promise.all(todos.map((todo) => addMutation.mutateAsync(todo)))\n    } catch (error) {\n      console.error('Failed to add todos:', error)\n    }\n  }\n\n  return (\n    <button onClick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n      Add all\n    </button>\n  )\n}\n```\n\nIf some of the mutations above can fail independently of the others, and you want to know which ones\ndid — rather than losing that information the moment the first one rejects — swap `Promise.all` for\n`Promise.allSettled`:\n```tsx\nimport { useMutation, useQueryClient } from '@tanstack/solid-query'\n\nfunction AddTodos() {\n  const queryClient = useQueryClient()\n\n  const addMutation = useMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    const addResults = await Promise.allSettled(\n      todos.map((todo) => addMutation.mutateAsync(todo)),\n    )\n\n    addResults.forEach((addResult, index) => {\n      if (addResult.status === 'rejected') {\n        console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n      }\n    })\n  }\n\n  return (\n    <button onClick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n      Add all\n    </button>\n  )\n}\n```\n"}
