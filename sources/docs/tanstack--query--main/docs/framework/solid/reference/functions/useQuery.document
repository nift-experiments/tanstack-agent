ode","value":"isSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isError"},{"type":"text","value":" are derived booleans for\nconvenience."}]},{"type":"html","value":"<a id=\"result-properties\"></a>"},{"type":"heading","depth":3,"id":"result-properties","children":[{"type":"text","value":"Result properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-data\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"data"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"The last successfully resolved data for the query."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-dataupdatedat\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"dataUpdatedAt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The timestamp for when the query most recently returned the "},{"type":"inlineCode","value":"status"},{"type":"text","value":" as "},{"type":"inlineCode","value":"\"success\""},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-error\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"error"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"tableCell","children":[{"type":"text","value":"The error object for the query, if an error was thrown. - Defaults to "},{"type":"inlineCode","value":"null"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-errorupdatecount\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"errorUpdateCount"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The sum of all errors."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-errorupdatedat\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"errorUpdatedAt"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The timestamp for when the query most recently returned the "},{"type":"inlineCode","value":"status"},{"type":"text","value":" as "},{"type":"inlineCode","value":"\"error\""},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-failurecount\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"failureCount"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"text","value":"The failure count for the query. - Incremented every time the query fails. - Reset to "},{"type":"inlineCode","value":"0"},{"type":"text","value":" when the query succeeds."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-failurereason\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"failureReason"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"}]},{"type":"tableCell","children":[{"type":"text","value":"The failure reason for the query retry. - Reset to "},{"type":"inlineCode","value":"null"},{"type":"text","value":" when the query succeeds."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-fetchstatus\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"fetchStatus"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"fetching\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"paused\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"idle\""}]},{"type":"tableCell","children":[{"type":"text","value":"The fetch status of the query. - "},{"type":"inlineCode","value":"fetching"},{"type":"text","value":": Is "},{"type":"inlineCode","value":"true"},{"type":"text","value":" whenever the queryFn is executing, which includes initial "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" as well as background refetch. - "},{"type":"inlineCode","value":"paused"},{"type":"text","value":": The query wanted to fetch, but has been "},{"type":"inlineCode","value":"paused"},{"type":"text","value":". - "},{"type":"inlineCode","value":"idle"},{"type":"text","value":": The query is not fetching. - See "},{"type":"link","href":"https://tanstack.com/query/latest/docs/framework/react/guides/network-mode","children":[{"type":"text","value":"Network Mode"}]},{"type":"text","value":" for more information."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isenabled\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isEnabled"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"true"},{"type":"text","value":" if this observer is enabled, "},{"type":"inlineCode","value":"false"},{"type":"text","value":" otherwise."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-iserror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"A derived boolean from the "},{"type":"inlineCode","value":"status"},{"type":"text","value":" variable, provided for convenience. - "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query attempt resulted in an error."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetched\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetched"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query has been fetched."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetchedaftermount\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetchedAfterMount"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query has been fetched after the component mounted. - This property can be used to not show any previously cached data."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isfetching\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isFetching"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"A derived boolean from the "},{"type":"inlineCode","value":"fetchStatus"},{"type":"text","value":" variable, provided for convenience. - "},{"type":"inlineCode","value":"true"},{"type":"text","value":" whenever the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" is executing, which includes initial "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" as well as background refetch."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isinitialloading\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"strike","children":[{"type":"inlineCode","value":"isInitialLoading"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Deprecated"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"isInitialLoading"},{"type":"text","value":" is being deprecated in favor of "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":" and will be removed in the next major version."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isloading\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isLoading"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Is "},{"type":"inlineCode","value":"true"},{"type":"text","value":" whenever the first fetch for a query is in-flight. - Is the same as "},{"type":"inlineCode","value":"isFetching && isPending"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isloadingerror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isLoadingError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query failed while fetching for the first time."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-ispaused\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isPaused"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"A derived boolean from the "},{"type":"inlineCode","value":"fetchStatus"},{"type":"text","value":" variable, provided for convenience. - The query wanted to fetch, but has been "},{"type":"inlineCode","value":"paused"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-ispending\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isPending"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" if there's no cached data and no query attempt was finished yet."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isplaceholderdata\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isPlaceholderData"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the data shown is the placeholder data."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isrefetcherror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isRefetchError"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query failed while refetching."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isrefetching\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isRefetching"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Is "},{"type":"inlineCode","value":"true"},{"type":"text","value":" whenever a background refetch is in-flight, which "},{"type":"emphasis","children":[{"type":"text","value":"does not"}]},{"type":"text","value":" include initial "},{"type":"inlineCode","value":"pending"},{"type":"text","value":". - Is the same as "},{"type":"inlineCode","value":"isFetching && !isPending"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-isstale\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isStale"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Will be "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the data in the cache is invalidated or if the data is older than the given "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-issuccess\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"isSuccess"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"A derived boolean from the "},{"type":"inlineCode","value":"status"},{"type":"text","value":" variable, provided for convenience. - "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if the query has received a response with no errors and is ready to display its data."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-refetch\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"refetch"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"options?"},{"type":"text","value":": "},{"type":"link","href":"../interfaces/RefetchOptions.md","children":[{"type":"inlineCode","value":"RefetchOptions"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/QueryObserverResult.md","children":[{"type":"inlineCode","value":"QueryObserverResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">>"}]},{"type":"tableCell","children":[{"type":"text","value":"A function to manually refetch the query."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-status\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"status"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"error\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"pending\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"success\""}]},{"type":"tableCell","children":[{"type":"text","value":"The status of the query. - Will be: - "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" if there's no cached data and no query attempt was finished yet. - "},{"type":"inlineCode","value":"error"},{"type":"text","value":" if the query attempt resulted in an error. - "},{"type":"inlineCode","value":"success"},{"type":"text","value":" if the query has received a response with no errors and is ready to display its data."}]}]]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tqueryfndata","text":"TQueryFnData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tdata","text":"TData","level":4},{"id":"tquerykey","text":"TQueryKey","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"queryclient","text":"queryClient?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"see","text":"See","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tqueryfndata-2","text":"TQueryFnData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tdata-2","text":"TData","level":4},{"id":"tquerykey-2","text":"TQueryKey","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"queryclient-2","text":"queryClient?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"see-2","text":"See","level":3},{"id":"example","text":"Example","level":3},{"id":"parameters-3","text":"Parameters","level":2},{"id":"options-3","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient-3","text":"queryClient?","level":3},{"id":"returns-3","text":"Returns","level":2},{"id":"result-properties","text":"Result properties","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: () => QueryClient): UseQueryResult<TData, TError>;\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: () => QueryClient): DefinedUseQueryResult<TData, TError>;\n```\n\n- [`UndefinedInitialDataOptions` → `UseQueryResult`](#call-signature-1): Subscribes to a query: a declarative dependency on an asynchronous source of data that is tied to a unique key. The query runs when the options call for it — `enabled: false` skips the initial fetch.\n- [`DefinedInitialDataOptions` → `DefinedUseQueryResult`](#call-signature-2): Subscribes to a query: a declarative dependency on an asynchronous source of data that is tied to a unique key. The query runs when the options call for it — `enabled: false` skips the initial fetch.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: () => QueryClient): UseQueryResult<TData, TError>;\n```\n\nDefined in: [packages/solid-query/src/useQuery.ts:178](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useQuery.ts#L178)\n\nSubscribes to a query: a declarative dependency on an asynchronous source of data that is tied to a unique key.\nThe query runs when the options call for it — `enabled: false` skips the initial fetch.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nAn accessor returning the [UndefinedInitialDataOptions](../type-aliases/UndefinedInitialDataOptions.md) to use — everything you can\npass to `useQuery`.\n\n#### queryClient?\n\n() => [`QueryClient`](../classes/QueryClient.md)\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`UseQueryResult`](../type-aliases/UseQueryResult.md)\\<`TData`, `TError`\\>\n\nThe current query result, as a Solid store. `status` is `pending` if there is no cached data to\ndisplay, `error` if the last fetch attempt failed, or `success` if the query has data to display.\n`isPending`/`isSuccess`/`isError` are derived booleans for convenience.\n\n### See\n\n[queryOptions](queryOptions.md) to share these options between `useQuery` and imperative APIs like `queryClient.query`.\n\n### Examples\n\n```tsx\nimport { For, Match, Switch } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction Posts() {\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  }))\n\n  return (\n    <Switch>\n      <Match when={postsQuery.isPending}>Loading...</Match>\n      <Match when={postsQuery.isError}>Error: {postsQuery.error.message}</Match>\n      <Match when={postsQuery.isSuccess}>\n        <ul>\n          <For each={postsQuery.data}>{(post) => <li>{post.title}</li>}</For>\n        </ul>\n        <div>{postsQuery.isFetching ? 'Background Updating...' : ' '}</div>\n      </Match>\n    </Switch>\n  )\n}\n```\n\n`select` derives whatever `data` a component needs from the cached value, without changing what's\nactually stored in the cache — the cache still holds the full `Post[]`, but `data` here is a `number`:\n```tsx\nimport { Match, Switch } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction PostCount() {\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    select: (posts) => posts.length,\n  }))\n\n  return (\n    <Switch>\n      <Match when={postsQuery.isPending}>Loading...</Match>\n      <Match when={postsQuery.isError}>Error: {postsQuery.error.message}</Match>\n      <Match when={postsQuery.isSuccess}>{postsQuery.data} posts</Match>\n    </Switch>\n  )\n}\n```\n\nA dependent query, only enabled once `postId` is set:\n```tsx\nimport { Match, Switch } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction Post(props: { postId: number | undefined }) {\n  const postQuery = useQuery(() => ({\n    queryKey: ['post', props.postId],\n    queryFn: () => fetchPost(props.postId!),\n    enabled: props.postId != null,\n  }))\n\n  return (\n    <Switch fallback={<h1>{postQuery.data?.title}</h1>}>\n      <Match when={props.postId == null}>Select a post</Match>\n      <Match when={postQuery.isLoading}>Loading...</Match>\n      <Match when={postQuery.isError}>Error: {postQuery.error.message}</Match>\n    </Switch>\n  )\n}\n```\n\nThe same dependent query, using `skipToken` to disable it in a type-safe way instead of relying on\n`enabled`. The non-null assertion is still needed — Solid's `props` narrowing doesn't survive into the\n`queryFn` closure the way a local `const` would — but `skipToken` keeps `queryFn`'s return type accurate\nwithout it. `refetch` doesn't work while `queryFn` is `skipToken` — use `enabled: false` instead if you\nneed to trigger the query manually:\n```tsx\nimport { Match, Switch } from 'solid-js'\nimport { skipToken, useQuery } from '@tanstack/solid-query'\n\nfunction Post(props: { postId: number | undefined }) {\n  const postQuery = useQuery(() => ({\n    queryKey: ['post', props.postId],\n    queryFn: props.postId != null ? () => fetchPost(props.postId!) : skipToken,\n  }))\n\n  return (\n    <Switch fallback={<h1>{postQuery.data?.title}</h1>}>\n      <Match when={props.postId == null}>Select a post</Match>\n      <Match when={postQuery.isLoading}>Loading...</Match>\n      <Match when={postQuery.isError}>Error: {postQuery.error.message}</Match>\n    </Switch>\n  )\n}\n```\n\nSeeding a detail query from an already-cached list, to skip the loading state. `initialDataUpdatedAt` carries\nover the list's own fetch time, so that if you set a `staleTime`, it's measured from when the list was\nfetched rather than from now:\n```tsx\nimport { useQuery, useQueryClient } from '@tanstack/solid-query'\n\nfunction Post(props: { postId: number }) {\n  const queryClient = useQueryClient()\n\n  const postQuery = useQuery(() => ({\n    queryKey: ['post', props.postId],\n    queryFn: () => fetchPost(props.postId),\n    initialData: () =>\n      queryClient\n        .getQueryData<Array<Post>>(['posts'])\n        ?.find((post) => post.id === props.postId),\n    initialDataUpdatedAt: () =>\n      queryClient.getQueryState(['posts'])?.dataUpdatedAt,\n  }))\n\n  return postQuery.isError ? <span>Error: {postQuery.error.message}</span> : <h1>{postQuery.data?.title}</h1>\n}\n```\n\nPaginated data, keeping the previous page's data visible while the next page loads:\n```tsx\nimport { For, createSignal } from 'solid-js'\nimport { keepPreviousData, useQuery } from '@tanstack/solid-query'\n\nfunction Posts() {\n  const [page, setPage] = createSignal(0)\n\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts', page()],\n    queryFn: () => fetchPosts(page()),\n    placeholderData: keepPreviousData,\n  }))\n\n  return (\n    <div>\n      <ul>\n        <For each={postsQuery.data}>{(post) => <li>{post.title}</li>}</For>\n      </ul>\n      <button\n        disabled={postsQuery.isPlaceholderData}\n        onClick={() => setPage((old) => old + 1)}\n      >\n        Next Page\n      </button>\n    </div>\n  )\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: () => QueryClient): DefinedUseQueryResult<TData, TError>;\n```\n\nDefined in: [packages/solid-query/src/useQuery.ts:228](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useQuery.ts#L228)\n\nSubscribes to a query: a declarative dependency on an asynchronous source of data that is tied to a unique key.\nThe query runs when the options call for it — `enabled: false` skips the initial fetch.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataOptions`](../type-aliases/DefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nAn accessor returning the [DefinedInitialDataOptions](../type-aliases/DefinedInitialDataOptions.md) to use — everything you can\npass to `useQuery`, with `initialData` set.\n\n#### queryClient?\n\n() => [`QueryClient`](../classes/QueryClient.md)\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`DefinedUseQueryResult`](../type-aliases/DefinedUseQueryResult.md)\\<`TData`, `TError`\\>\n\nThe current query result, as a Solid store, typed so that `status` is `success` — or `error` if a\nfetch attempt fails while keeping the existing data (`status` never resolves to `pending` in this overload's\ntype, since `initialData` guarantees data upfront). `isSuccess`/`isError` are derived booleans for\nconvenience.\n\n### See\n\n[queryOptions](queryOptions.md) to share these options between `useQuery` and imperative APIs like `queryClient.query`.\n\n### Example\n\n```tsx\nimport { For } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction Posts() {\n  // `postsQuery.data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    initialData: [],\n  }))\n\n  return (\n    <div>\n      {postsQuery.isError ? <span>Error: {postsQuery.error.message}</span> : null}\n      <ul>\n        <For each={postsQuery.data}>{(post) => <li>{post.title}</li>}</For>\n      </ul>\n    </div>\n  )\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`DefinedInitialDataOptions`](../type-aliases/DefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nAn accessor returning the [DefinedInitialDataOptions](../type-aliases/DefinedInitialDataOptions.md) to use — everything you can\npass to `useQuery`, with `initialData` set.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`QueryOptions`](../interfaces/QueryOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n() => [`QueryClient`](../classes/QueryClient.md)\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`DefinedUseQueryResult`](../type-aliases/DefinedUseQueryResult.md)\\<`TData`, `TError`\\>\n\nThe current query result, as a Solid store, typed so that `status` is `success` — or `error` if a\nfetch attempt fails while keeping the existing data (`status` never resolves to `pending` in this overload's\ntype, since `initialData` guarantees data upfront). `isSuccess`/`isError` are derived booleans for\nconvenience.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"result-property-data\"></a> `data` | `TData` \\| `undefined` | The last successfully resolved data for the query. |\n| <a id=\"result-property-dataupdatedat\"></a> `dataUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"success\"`. |\n| <a id=\"result-property-error\"></a> `error` | `TError` \\| `null` | The error object for the query, if an error was thrown. - Defaults to `null`. |\n| <a id=\"result-property-errorupdatecount\"></a> `errorUpdateCount` | `number` | The sum of all errors. |\n| <a id=\"result-property-errorupdatedat\"></a> `errorUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"error\"`. |\n| <a id=\"result-property-failurecount\"></a> `failureCount` | `number` | The failure count for the query. - Incremented every time the query fails. - Reset to `0` when the query succeeds. |\n| <a id=\"result-property-failurereason\"></a> `failureReason` | `TError` \\| `null` | The failure reason for the query retry. - Reset to `null` when the query succeeds. |\n| <a id=\"result-property-fetchstatus\"></a> `fetchStatus` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | The fetch status of the query. - `fetching`: Is `true` whenever the queryFn is executing, which includes initial `pending` as well as background refetch. - `paused`: The query wanted to fetch, but has been `paused`. - `idle`: The query is not fetching. - See [Network Mode](https://tanstack.com/query/latest/docs/framework/react/guides/network-mode) for more information. |\n| <a id=\"result-property-isenabled\"></a> `isEnabled` | `boolean` | `true` if this observer is enabled, `false` otherwise. |\n| <a id=\"result-property-iserror\"></a> `isError` | `boolean` | A derived boolean from the `status` variable, provided for convenience. - `true` if the query attempt resulted in an error. |\n| <a id=\"result-property-isfetched\"></a> `isFetched` | `boolean` | Will be `true` if the query has been fetched. |\n| <a id=\"result-property-isfetchedaftermount\"></a> `isFetchedAfterMount` | `boolean` | Will be `true` if the query has been fetched after the component mounted. - This property can be used to not show any previously cached data. |\n| <a id=\"result-property-isfetching\"></a> `isFetching` | `boolean` | A derived boolean from the `fetchStatus` variable, provided for convenience. - `true` whenever the `queryFn` is executing, which includes initial `pending` as well as background refetch. |\n| <a id=\"result-property-isinitialloading\"></a> ~~`isInitialLoading`~~ | `boolean` | **Deprecated** `isInitialLoading` is being deprecated in favor of `isLoading` and will be removed in the next major version. |\n| <a id=\"result-property-isloading\"></a> `isLoading` | `boolean` | Is `true` whenever the first fetch for a query is in-flight. - Is the same as `isFetching && isPending`. |\n| <a id=\"result-property-isloadingerror\"></a> `isLoadingError` | `boolean` | Will be `true` if the query failed while fetching for the first time. |\n| <a id=\"result-property-ispaused\"></a> `isPaused` | `boolean` | A derived boolean from the `fetchStatus` variable, provided for convenience. - The query wanted to fetch, but has been `paused`. |\n| <a id=\"result-property-ispending\"></a> `isPending` | `boolean` | Will be `pending` if there's no cached data and no query attempt was finished yet. |\n| <a id=\"result-property-isplaceholderdata\"></a> `isPlaceholderData` | `boolean` | Will be `true` if the data shown is the placeholder data. |\n| <a id=\"result-property-isrefetcherror\"></a> `isRefetchError` | `boolean` | Will be `true` if the query failed while refetching. |\n| <a id=\"result-property-isrefetching\"></a> `isRefetching` | `boolean` | Is `true` whenever a background refetch is in-flight, which _does not_ include initial `pending`. - Is the same as `isFetching && !isPending`. |\n| <a id=\"result-property-isstale\"></a> `isStale` | `boolean` | Will be `true` if the data in the cache is invalidated or if the data is older than the given `staleTime`. |\n| <a id=\"result-property-issuccess\"></a> `isSuccess` | `boolean` | A derived boolean from the `status` variable, provided for convenience. - `true` if the query has received a response with no errors and is ready to display its data. |\n| <a id=\"result-property-refetch\"></a> `refetch` | (`options?`: [`RefetchOptions`](../interfaces/RefetchOptions.md)) => `Promise`\\<[`QueryObserverResult`](../type-aliases/QueryObserverResult.md)\\<`TData`, `TError`\\>\\> | A function to manually refetch the query. |\n| <a id=\"result-property-status\"></a> `status` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` | The status of the query. - Will be: - `pending` if there's no cached data and no query attempt was finished yet. - `error` if the query attempt resulted in an error. - `success` if the query has received a response with no errors and is ready to display its data. |\n","originalRawMarkdown":"---\nid: useQuery\ntitle: useQuery\nredirect_from:\n  - framework/solid/reference/useQuery\n---\n\n## Overview\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: () => QueryClient): UseQueryResult<TData, TError>;\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: () => QueryClient): DefinedUseQueryResult<TData, TError>;\n```\n\n- [`UndefinedInitialDataOptions` → `UseQueryResult`](#call-signature-1): Subscribes to a query: a declarative dependency on an asynchronous source of data that is tied to a unique key. The query runs when the options call for it — `enabled: false` skips the initial fetch.\n- [`DefinedInitialDataOptions` → `DefinedUseQueryResult`](#call-signature-2): Subscribes to a query: a declarative dependency on an asynchronous source of data that is tied to a unique key. The query runs when the options call for it — `enabled: false` skips the initial fetch.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: () => QueryClient): UseQueryResult<TData, TError>;\n```\n\nDefined in: [packages/solid-query/src/useQuery.ts:178](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useQuery.ts#L178)\n\nSubscribes to a query: a declarative dependency on an asynchronous source of data that is tied to a unique key.\nThe query runs when the options call for it — `enabled: false` skips the initial fetch.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nAn accessor returning the [UndefinedInitialDataOptions](../type-aliases/UndefinedInitialDataOptions.md) to use — everything you can\npass to `useQuery`.\n\n#### queryClient?\n\n() => [`QueryClient`](../classes/QueryClient.md)\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`UseQueryResult`](../type-aliases/UseQueryResult.md)\\<`TData`, `TError`\\>\n\nThe current query result, as a Solid store. `status` is `pending` if there is no cached data to\ndisplay, `error` if the last fetch attempt failed, or `success` if the query has data to display.\n`isPending`/`isSuccess`/`isError` are derived booleans for convenience.\n\n### See\n\n[queryOptions](queryOptions.md) to share these options between `useQuery` and imperative APIs like `queryClient.query`.\n\n### Examples\n\n```tsx\nimport { For, Match, Switch } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction Posts() {\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  }))\n\n  return (\n    <Switch>\n      <Match when={postsQuery.isPending}>Loading...</Match>\n      <Match when={postsQuery.isError}>Error: {postsQuery.error.message}</Match>\n      <Match when={postsQuery.isSuccess}>\n        <ul>\n          <For each={postsQuery.data}>{(post) => <li>{post.title}</li>}</For>\n        </ul>\n        <div>{postsQuery.isFetching ? 'Background Updating...' : ' '}</div>\n      </Match>\n    </Switch>\n  )\n}\n```\n\n`select` derives whatever `data` a component needs from the cached value, without changing what's\nactually stored in the cache — the cache still holds the full `Post[]`, but `data` here is a `number`:\n```tsx\nimport { Match, Switch } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction PostCount() {\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    select: (posts) => posts.length,\n  }))\n\n  return (\n    <Switch>\n      <Match when={postsQuery.isPending}>Loading...</Match>\n      <Match when={postsQuery.isError}>Error: {postsQuery.error.message}</Match>\n      <Match when={postsQuery.isSuccess}>{postsQuery.data} posts</Match>\n    </Switch>\n  )\n}\n```\n\nA dependent query, only enabled once `postId` is set:\n```tsx\nimport { Match, Switch } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction Post(props: { postId: number | undefined }) {\n  const postQuery = useQuery(() => ({\n    queryKey: ['post', props.postId],\n    queryFn: () => fetchPost(props.postId!),\n    enabled: props.postId != null,\n  }))\n\n  return (\n    <Switch fallback={<h1>{postQuery.data?.title}</h1>}>\n      <Match when={props.postId == null}>Select a post</Match>\n      <Match when={postQuery.isLoading}>Loading...</Match>\n      <Match when={postQuery.isError}>Error: {postQuery.error.message}</Match>\n    </Switch>\n  )\n}\n```\n\nThe same dependent query, using `skipToken` to disable it in a type-safe way instead of relying on\n`enabled`. The non-null assertion is still needed — Solid's `props` narrowing doesn't survive into the\n`queryFn` closure the way a local `const` would — but `skipToken` keeps `queryFn`'s return type accurate\nwithout it. `refetch` doesn't work while `queryFn` is `skipToken` — use `enabled: false` instead if you\nneed to trigger the query manually:\n```tsx\nimport { Match, Switch } from 'solid-js'\nimport { skipToken, useQuery } from '@tanstack/solid-query'\n\nfunction Post(props: { postId: number | undefined }) {\n  const postQuery = useQuery(() => ({\n    queryKey: ['post', props.postId],\n    queryFn: props.postId != null ? () => fetchPost(props.postId!) : skipToken,\n  }))\n\n  return (\n    <Switch fallback={<h1>{postQuery.data?.title}</h1>}>\n      <Match when={props.postId == null}>Select a post</Match>\n      <Match when={postQuery.isLoading}>Loading...</Match>\n      <Match when={postQuery.isError}>Error: {postQuery.error.message}</Match>\n    </Switch>\n  )\n}\n```\n\nSeeding a detail query from an already-cached list, to skip the loading state. `initialDataUpdatedAt` carries\nover the list's own fetch time, so that if you set a `staleTime`, it's measured from when the list was\nfetched rather than from now:\n```tsx\nimport { useQuery, useQueryClient } from '@tanstack/solid-query'\n\nfunction Post(props: { postId: number }) {\n  const queryClient = useQueryClient()\n\n  const postQuery = useQuery(() => ({\n    queryKey: ['post', props.postId],\n    queryFn: () => fetchPost(props.postId),\n    initialData: () =>\n      queryClient\n        .getQueryData<Array<Post>>(['posts'])\n        ?.find((post) => post.id === props.postId),\n    initialDataUpdatedAt: () =>\n      queryClient.getQueryState(['posts'])?.dataUpdatedAt,\n  }))\n\n  return postQuery.isError ? <span>Error: {postQuery.error.message}</span> : <h1>{postQuery.data?.title}</h1>\n}\n```\n\nPaginated data, keeping the previous page's data visible while the next page loads:\n```tsx\nimport { For, createSignal } from 'solid-js'\nimport { keepPreviousData, useQuery } from '@tanstack/solid-query'\n\nfunction Posts() {\n  const [page, setPage] = createSignal(0)\n\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts', page()],\n    queryFn: () => fetchPosts(page()),\n    placeholderData: keepPreviousData,\n  }))\n\n  return (\n    <div>\n      <ul>\n        <For each={postsQuery.data}>{(post) => <li>{post.title}</li>}</For>\n      </ul>\n      <button\n        disabled={postsQuery.isPlaceholderData}\n        onClick={() => setPage((old) => old + 1)}\n      >\n        Next Page\n      </button>\n    </div>\n  )\n}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: () => QueryClient): DefinedUseQueryResult<TData, TError>;\n```\n\nDefined in: [packages/solid-query/src/useQuery.ts:228](https://github.com/TanStack/query/blob/main/packages/solid-query/src/useQuery.ts#L228)\n\nSubscribes to a query: a declarative dependency on an asynchronous source of data that is tied to a unique key.\nThe query runs when the options call for it — `enabled: false` skips the initial fetch.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataOptions`](../type-aliases/DefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nAn accessor returning the [DefinedInitialDataOptions](../type-aliases/DefinedInitialDataOptions.md) to use — everything you can\npass to `useQuery`, with `initialData` set.\n\n#### queryClient?\n\n() => [`QueryClient`](../classes/QueryClient.md)\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`DefinedUseQueryResult`](../type-aliases/DefinedUseQueryResult.md)\\<`TData`, `TError`\\>\n\nThe current query result, as a Solid store, typed so that `status` is `success` — or `error` if a\nfetch attempt fails while keeping the existing data (`status` never resolves to `pending` in this overload's\ntype, since `initialData` guarantees data upfront). `isSuccess`/`isError` are derived booleans for\nconvenience.\n\n### See\n\n[queryOptions](queryOptions.md) to share these options between `useQuery` and imperative APIs like `queryClient.query`.\n\n### Example\n\n```tsx\nimport { For } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction Posts() {\n  // `postsQuery.data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    initialData: [],\n  }))\n\n  return (\n    <div>\n      {postsQuery.isError ? <span>Error: {postsQuery.error.message}</span> : null}\n      <ul>\n        <For each={postsQuery.data}>{(post) => <li>{post.title}</li>}</For>\n      </ul>\n    </div>\n  )\n}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`DefinedInitialDataOptions`](../type-aliases/DefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nAn accessor returning the [DefinedInitialDataOptions](../type-aliases/DefinedInitialDataOptions.md) to use — everything you can\npass to `useQuery`, with `initialData` set.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`QueryOptions`](../interfaces/QueryOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n() => [`QueryClient`](../classes/QueryClient.md)\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`DefinedUseQueryResult`](../type-aliases/DefinedUseQueryResult.md)\\<`TData`, `TError`\\>\n\nThe current query result, as a Solid store, typed so that `status` is `success` — or `error` if a\nfetch attempt fails while keeping the existing data (`status` never resolves to `pending` in this overload's\ntype, since `initialData` guarantees data upfront). `isSuccess`/`isError` are derived booleans for\nconvenience.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"result-property-data\"></a> `data` | `TData` \\| `undefined` | The last successfully resolved data for the query. |\n| <a id=\"result-property-dataupdatedat\"></a> `dataUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"success\"`. |\n| <a id=\"result-property-error\"></a> `error` | `TError` \\| `null` | The error object for the query, if an error was thrown. - Defaults to `null`. |\n| <a id=\"result-property-errorupdatecount\"></a> `errorUpdateCount` | `number` | The sum of all errors. |\n| <a id=\"result-property-errorupdatedat\"></a> `errorUpdatedAt` | `number` | The timestamp for when the query most recently returned the `status` as `\"error\"`. |\n| <a id=\"result-property-failurecount\"></a> `failureCount` | `number` | The failure count for the query. - Incremented every time the query fails. - Reset to `0` when the query succeeds. |\n| <a id=\"result-property-failurereason\"></a> `failureReason` | `TError` \\| `null` | The failure reason for the query retry. - Reset to `null` when the query succeeds. |\n| <a id=\"result-property-fetchstatus\"></a> `fetchStatus` | `\"fetching\"` \\| `\"paused\"` \\| `\"idle\"` | The fetch status of the query. - `fetching`: Is `true` whenever the queryFn is executing, which includes initial `pending` as well as background refetch. - `paused`: The query wanted to fetch, but has been `paused`. - `idle`: The query is not fetching. - See [Network Mode](https://tanstack.com/query/latest/docs/framework/react/guides/network-mode) for more information. |\n| <a id=\"result-property-isenabled\"></a> `isEnabled` | `boolean` | `true` if this observer is enabled, `false` otherwise. |\n| <a id=\"result-property-iserror\"></a> `isError` | `boolean` | A derived boolean from the `status` variable, provided for convenience. - `true` if the query attempt resulted in an error. |\n| <a id=\"result-property-isfetched\"></a> `isFetched` | `boolean` | Will be `true` if the query has been fetched. |\n| <a id=\"result-property-isfetchedaftermount\"></a> `isFetchedAfterMount` | `boolean` | Will be `true` if the query has been fetched after the component mounted. - This property can be used to not show any previously cached data. |\n| <a id=\"result-property-isfetching\"></a> `isFetching` | `boolean` | A derived boolean from the `fetchStatus` variable, provided for convenience. - `true` whenever the `queryFn` is executing, which includes initial `pending` as well as background refetch. |\n| <a id=\"result-property-isinitialloading\"></a> ~~`isInitialLoading`~~ | `boolean` | **Deprecated** `isInitialLoading` is being deprecated in favor of `isLoading` and will be removed in the next major version. |\n| <a id=\"result-property-isloading\"></a> `isLoading` | `boolean` | Is `true` whenever the first fetch for a query is in-flight. - Is the same as `isFetching && isPending`. |\n| <a id=\"result-property-isloadingerror\"></a> `isLoadingError` | `boolean` | Will be `true` if the query failed while fetching for the first time. |\n| <a id=\"result-property-ispaused\"></a> `isPaused` | `boolean` | A derived boolean from the `fetchStatus` variable, provided for convenience. - The query wanted to fetch, but has been `paused`. |\n| <a id=\"result-property-ispending\"></a> `isPending` | `boolean` | Will be `pending` if there's no cached data and no query attempt was finished yet. |\n| <a id=\"result-property-isplaceholderdata\"></a> `isPlaceholderData` | `boolean` | Will be `true` if the data shown is the placeholder data. |\n| <a id=\"result-property-isrefetcherror\"></a> `isRefetchError` | `boolean` | Will be `true` if the query failed while refetching. |\n| <a id=\"result-property-isrefetching\"></a> `isRefetching` | `boolean` | Is `true` whenever a background refetch is in-flight, which _does not_ include initial `pending`. - Is the same as `isFetching && !isPending`. |\n| <a id=\"result-property-isstale\"></a> `isStale` | `boolean` | Will be `true` if the data in the cache is invalidated or if the data is older than the given `staleTime`. |\n| <a id=\"result-property-issuccess\"></a> `isSuccess` | `boolean` | A derived boolean from the `status` variable, provided for convenience. - `true` if the query has received a response with no errors and is ready to display its data. |\n| <a id=\"result-property-refetch\"></a> `refetch` | (`options?`: [`RefetchOptions`](../interfaces/RefetchOptions.md)) => `Promise`\\<[`QueryObserverResult`](../type-aliases/QueryObserverResult.md)\\<`TData`, `TError`\\>\\> | A function to manually refetch the query. |\n| <a id=\"result-property-status\"></a> `status` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` | The status of the query. - Will be: - `pending` if there's no cached data and no query attempt was finished yet. - `error` if the query attempt resulted in an error. - `success` if the query has received a response with no errors and is ready to display its data. |\n"}
