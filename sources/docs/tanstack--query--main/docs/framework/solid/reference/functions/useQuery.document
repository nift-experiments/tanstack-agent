,"value":"UseQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The current query result, as a Solid store. "},{"type":"inlineCode","value":"status"},{"type":"text","value":" is "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" if there is no cached data to\ndisplay, "},{"type":"inlineCode","value":"error"},{"type":"text","value":" if the last fetch attempt failed, or "},{"type":"inlineCode","value":"success"},{"type":"text","value":" if the query has data to display.\n"},{"type":"inlineCode","value":"isPending"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"isError"},{"type":"text","value":" are derived booleans for convenience."}]},{"type":"heading","depth":3,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"queryOptions.md","children":[{"type":"text","value":"queryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" and imperative APIs like "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { For, Match, Switch } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction Posts() {\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n  }))\n\n  return (\n    <Switch>\n      <Match when={postsQuery.isPending}>Loading...</Match>\n      <Match when={postsQuery.isError}>Error: {postsQuery.error.message}</Match>\n      <Match when={postsQuery.isSuccess}>\n        <ul>\n          <For each={postsQuery.data}>{(post) => <li>{post.title}</li>}</For>\n        </ul>\n        <div>{postsQuery.isFetching ? 'Background Updating...' : ' '}</div>\n      </Match>\n    </Switch>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"inlineCode","value":"select"},{"type":"text","value":" derives whatever "},{"type":"inlineCode","value":"data"},{"type":"text","value":" a component needs from the cached value, without changing what's\nactually stored in the cache — the cache still holds the full "},{"type":"inlineCode","value":"Post[]"},{"type":"text","value":", but "},{"type":"inlineCode","value":"data"},{"type":"text","value":" here is a "},{"type":"inlineCode","value":"number"},{"type":"text","value":":"}]},{"type":"code","value":"import { Match, Switch } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction PostCount() {\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    select: (posts) => posts.length,\n  }))\n\n  return (\n    <Switch>\n      <Match when={postsQuery.isPending}>Loading...</Match>\n      <Match when={postsQuery.isError}>Error: {postsQuery.error.message}</Match>\n      <Match when={postsQuery.isSuccess}>{postsQuery.data} posts</Match>\n    </Switch>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"A dependent query, only enabled once "},{"type":"inlineCode","value":"postId"},{"type":"text","value":" is set:"}]},{"type":"code","value":"import { Match, Switch } from 'solid-js'\nimport { useQuery } from '@tanstack/solid-query'\n\nfunction Post(props: { postId: number | undefined }) {\n  const postQuery = useQuery(() => ({\n    queryKey: ['post', props.postId],\n    queryFn: () => fetchPost(props.postId!),\n    enabled: props.postId != null,\n  }))\n\n  return (\n    <Switch fallback={<h1>{postQuery.data?.title}</h1>}>\n      <Match when={props.postId == null}>Select a post</Match>\n      <Match when={postQuery.isLoading}>Loading...</Match>\n      <Match when={postQuery.isError}>Error: {postQuery.error.message}</Match>\n    </Switch>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The same dependent query, using "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" to disable it in a type-safe way instead of relying on\n"},{"type":"inlineCode","value":"enabled"},{"type":"text","value":". The non-null assertion is still needed — Solid's "},{"type":"inlineCode","value":"props"},{"type":"text","value":" narrowing doesn't survive into the\n"},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" closure the way a local "},{"type":"inlineCode","value":"const"},{"type":"text","value":" would — but "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" keeps "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":"'s return type accurate\nwithout it. "},{"type":"inlineCode","value":"refetch"},{"type":"text","value":" doesn't work while "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" is "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" — use "},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":" instead if you\nneed to trigger the query manually:"}]},{"type":"code","value":"import { Match, Switch } from 'solid-js'\nimport { skipToken, useQuery } from '@tanstack/solid-query'\n\nfunction Post(props: { postId: number | undefined }) {\n  const postQuery = useQuery(() => ({\n    queryKey: ['post', props.postId],\n    queryFn: props.postId != null ? () => fetchPost(props.postId!) : skipToken,\n  }))\n\n  return (\n    <Switch fallback={<h1>{postQuery.data?.title}</h1>}>\n      <Match when={props.postId == null}>Select a post</Match>\n      <Match when={postQuery.isLoading}>Loading...</Match>\n      <Match when={postQuery.isError}>Error: {postQuery.error.message}</Match>\n    </Switch>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Seeding a detail query from an already-cached list, to skip the loading state. "},{"type":"inlineCode","value":"initialDataUpdatedAt"},{"type":"text","value":" carries\nover the list's own fetch time, so that if you set a "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":", it's measured from when the list was\nfetched rather than from now:"}]},{"type":"code","value":"import { useQuery, useQueryClient } from '@tanstack/solid-query'\n\nfunction Post(props: { postId: number }) {\n  const queryClient = useQueryClient()\n\n  const postQuery = useQuery(() => ({\n    queryKey: ['post', props.postId],\n    queryFn: () => fetchPost(props.postId),\n    initialData: () =>\n      queryClient\n        .getQueryData<Array<Post>>(['posts'])\n        ?.find((post) => post.id === props.postId),\n    initialDataUpdatedAt: () =>\n      queryClient.getQueryState(['posts'])?.dataUpdatedAt,\n  }))\n\n  return postQuery.isError ? <span>Error: {postQuery.error.message}</span> : <h1>{postQuery.data?.title}</h1>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Paginated data, keeping the previous page's data visible while the next page loads:"}]},{"type":"code","value":"import { For, createSignal } from 'solid-js'\nimport { keepPreviousData, useQuery } from '@tanstack/solid-query'\n\nfunction Posts() {\n  const [page, setPage] = createSignal(0)\n\n  const postsQuery = useQuery(() => ({\n    queryKey: ['posts', page()],\n    queryFn: () => fetchPosts(page()),\n    placeholderData: keepPreviousData,\n  }))\n\n  return (\n    <div>\n      <ul>\n        <For each={postsQuery.data}>{(post) => <li>{post.title}</li>}</For>\n      </ul>\n      <button\n        disabled={postsQuery.isPlaceholderData}\n        onClick={() => setPage((old) => old + 1)}\n      >\n        Next Page\n      </button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useQuery<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: () => QueryClient): DefinedUseQueryResult<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/solid-query/src/useQuery.ts#L228","children":[{"type":"text","value":"packages/solid-query/src/useQuery.ts:228"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Subscribes to a query: a declarative dependency on an asynchronous source of data that is tied to a unique key.\nThe query runs when the options call for it — "},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":" skips the initial fetch."}]},{"type":"paragraph","children":[{"type":"text","value":"This overload is selected when "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" is set, so the resulting "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is never "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" (unless\na "},{"type":"inlineCode","value":"select"},{"type":"text","value":" changes "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" to include "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":")."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-2","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"terror-2","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-2"