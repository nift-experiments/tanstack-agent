ue":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"tableCell","children":[{"type":"text","value":"Called before any mutation in the cache executes."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-onsettled\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onSettled?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"data"},{"type":"text","value":": "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"Error"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"},{"type":"text","value":", "},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":": "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"mutation"},{"type":"text","value":": "},{"type":"link","href":"../classes/Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">, "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"tableCell","children":[{"type":"text","value":"Called when any mutation in the cache is settled, either successfully or with an error."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-onsuccess\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onSuccess?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"data"},{"type":"text","value":": "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":": "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"mutation"},{"type":"text","value":": "},{"type":"link","href":"../classes/Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">, "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"tableCell","children":[{"type":"text","value":"Called when any mutation in the cache is successful."}]}]]}],"headings":[{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/mutationCache.ts:26](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L26)\n\nGlobal callbacks that fire for every mutation handled by a `MutationCache`, regardless of which\ncomponent or observer triggered it. They differ from the `defaultOptions` provided to a\n`QueryClient` in two ways: `defaultOptions` can be overridden by each mutation, while these\ncallbacks are always called, and `onMutate` here does not allow returning a result.\n\nIf a callback returns a promise, it will be awaited before the mutation continues.\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-onerror\"></a> `onError?` | (`error`: `Error`, `variables`: `unknown`, `onMutateResult`: `unknown`, `mutation`: [`Mutation`](../classes/Mutation.md)\\<`unknown`, `unknown`, `unknown`\\>, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | Called when any mutation in the cache encounters an error. |\n| <a id=\"property-onmutate\"></a> `onMutate?` | (`variables`: `unknown`, `mutation`: [`Mutation`](../classes/Mutation.md)\\<`unknown`, `unknown`, `unknown`\\>, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | Called before any mutation in the cache executes. |\n| <a id=\"property-onsettled\"></a> `onSettled?` | (`data`: `unknown`, `error`: `Error` \\| `null`, `variables`: `unknown`, `onMutateResult`: `unknown`, `mutation`: [`Mutation`](../classes/Mutation.md)\\<`unknown`, `unknown`, `unknown`\\>, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | Called when any mutation in the cache is settled, either successfully or with an error. |\n| <a id=\"property-onsuccess\"></a> `onSuccess?` | (`data`: `unknown`, `variables`: `unknown`, `onMutateResult`: `unknown`, `mutation`: [`Mutation`](../classes/Mutation.md)\\<`unknown`, `unknown`, `unknown`\\>, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | Called when any mutation in the cache is successful. |\n","originalRawMarkdown":"---\nid: MutationCacheConfig\ntitle: MutationCacheConfig\n---\n\nDefined in: [packages/query-core/src/mutationCache.ts:26](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L26)\n\nGlobal callbacks that fire for every mutation handled by a `MutationCache`, regardless of which\ncomponent or observer triggered it. They differ from the `defaultOptions` provided to a\n`QueryClient` in two ways: `defaultOptions` can be overridden by each mutation, while these\ncallbacks are always called, and `onMutate` here does not allow returning a result.\n\nIf a callback returns a promise, it will be awaited before the mutation continues.\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-onerror\"></a> `onError?` | (`error`: `Error`, `variables`: `unknown`, `onMutateResult`: `unknown`, `mutation`: [`Mutation`](../classes/Mutation.md)\\<`unknown`, `unknown`, `unknown`\\>, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | Called when any mutation in the cache encounters an error. |\n| <a id=\"property-onmutate\"></a> `onMutate?` | (`variables`: `unknown`, `mutation`: [`Mutation`](../classes/Mutation.md)\\<`unknown`, `unknown`, `unknown`\\>, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | Called before any mutation in the cache executes. |\n| <a id=\"property-onsettled\"></a> `onSettled?` | (`data`: `unknown`, `error`: `Error` \\| `null`, `variables`: `unknown`, `onMutateResult`: `unknown`, `mutation`: [`Mutation`](../classes/Mutation.md)\\<`unknown`, `unknown`, `unknown`\\>, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | Called when any mutation in the cache is settled, either successfully or with an error. |\n| <a id=\"property-onsuccess\"></a> `onSuccess?` | (`data`: `unknown`, `variables`: `unknown`, `onMutateResult`: `unknown`, `mutation`: [`Mutation`](../classes/Mutation.md)\\<`unknown`, `unknown`, `unknown`\\>, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | Called when any mutation in the cache is successful. |\n"}
