":"queryClient.setMutationDefaults"},{"type":"text","value":", and to match this mutation with "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":" or "},{"type":"inlineCode","value":"queryClient.isMutating"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-networkmode\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"networkMode?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"online\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"always\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"offlineFirst\""}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'online'"}]},{"type":"tableCell","children":[{"type":"text","value":"Controls whether a mutation is allowed to run based on the current network connectivity. "},{"type":"strong","children":[{"type":"text","value":"See"}]},{"type":"text","value":" "},{"type":"link","href":"https://tanstack.com/query/latest/docs/framework/react/guides/network-mode","children":[{"type":"text","value":"Network Mode"}]},{"type":"text","value":" for more information."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-onerror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onError?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":": "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function fires when the mutation encounters an error, and is passed the error. If a promise is returned, it is awaited before "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" runs."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-onmutate\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onMutate?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function fires before the mutation function runs, and receives the same variables. Useful for optimistic updates applied in the hope that the mutation succeeds. The value it returns is passed to "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" and "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" as "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":", which is where an optimistic update is usually rolled back. If a promise is returned, it is awaited before the mutation function runs."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-onsettled\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onSettled?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"data"},{"type":"text","value":": "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":" | "},{"type":"inlineCode","value":"null"},{"type":"text","value":", "},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":": "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function fires when the mutation either succeeds or errors, and is passed either the data or the error. If a promise is returned, it is awaited before the mutation settles."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-onsuccess\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"onSuccess?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"data"},{"type":"text","value":": "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"variables"},{"type":"text","value":": "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"onMutateResult"},{"type":"text","value":": "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/MutationFunctionContext.md","children":[{"type":"inlineCode","value":"MutationFunctionContext"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function fires when the mutation succeeds, and is passed the mutation's result. If a promise is returned, it is awaited before "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" runs."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-retry\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"retry?"}]},{"type":"tableCell","children":[{"type":"text","value":"| "},{"type":"inlineCode","value":"number"},{"type":"text","value":" | "},{"type":"inlineCode","value":"false"},{"type":"text","value":" | "},{"type":"inlineCode","value":"true"},{"type":"text","value":" | (("},{"type":"inlineCode","value":"failureCount"},{"type":"text","value":": "},{"type":"inlineCode","value":"number"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":") => "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"0"}]},{"type":"tableCell","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"false"},{"type":"text","value":", failed mutations will not retry by default. If "},{"type":"inlineCode","value":"true"},{"type":"text","value":", failed mutations will retry infinitely. If set to an integer number, e.g. 3, failed mutations will retry until the failed mutation count meets that number. If set to a function "},{"type":"inlineCode","value":"(failureCount, error) => boolean"},{"type":"text","value":" failed mutations will retry until the function returns false."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-retrydelay\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"retryDelay?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"},{"type":"text","value":" | (("},{"type":"inlineCode","value":"failureCount"},{"type":"text","value":": "},{"type":"inlineCode","value":"number"},{"type":"text","value":", "},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":") => "},{"type":"inlineCode","value":"number"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"This function receives a "},{"type":"inlineCode","value":"retryAttempt"},{"type":"text","value":" integer and the actual Error and returns the delay to apply before the next attempt in milliseconds. Defaults to a function that applies exponential backoff, capped at 30 seconds."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-scope\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"scope?"}]},{"type":"tableCell","children":[{"type":"link","href":"../type-aliases/MutationScope.md","children":[{"type":"inlineCode","value":"MutationScope"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Controls whether this mutation runs alongside others or waits its turn. Mutations sharing the same "},{"type":"inlineCode","value":"scope.id"},{"type":"text","value":" run serially, in the order they were started. Without a scope, a mutation runs as soon as it is triggered."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-throwonerror\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"throwOnError?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"},{"type":"text","value":" | (("},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"TError"},{"type":"text","value":") => "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"false"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether errors should be thrown instead of setting the "},{"type":"inlineCode","value":"error"},{"type":"text","value":" property. If set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", all errors will be thrown to the nearest error boundary. If set to a function, it will be passed the error and should return a boolean indicating whether to throw the error ("},{"type":"inlineCode","value":"true"},{"type":"text","value":") or return it as state ("},{"type":"inlineCode","value":"false"},{"type":"text","value":")."}]}]]}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tvariables","text":"TVariables","level":3},{"id":"tonmutateresult","text":"TOnMutateResult","level":3},{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/solid-query/src/types.ts:240](https://github.com/TanStack/query/blob/main/packages/solid-query/src/types.ts#L240)\n\nThe options accepted by `useMutation` and `mutationOptions`.\n\n## Extends\n\n- [`OmitKeyof`](../type-aliases/OmitKeyof.md)\\<[`MutationObserverOptions`](MutationObserverOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"_defaulted\"`\\>\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type your `mutationFn` resolves to.\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\nThe type of errors your `mutationFn` may throw.\n\n### TVariables\n\n`TVariables` = `void`\n\nThe type of the variables your `mutationFn` accepts.\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\nThe type returned by `onMutate`, passed on to `onSuccess`/`onError`/`onSettled`.\n\n## Properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"property-gctime\"></a> `gcTime?` | `number` | `undefined` | The time in milliseconds that an unused/inactive mutation remains in memory before it is garbage collected. Defaults to `5 * 60 * 1000` (5 minutes), or `Infinity` during SSR. |\n| <a id=\"property-meta\"></a> `meta?` | `Record`\\<`string`, `unknown`\\> | `undefined` | Additional payload to be stored on the mutation cache entry. Use it to pass information that can be read wherever the `mutation` is available, such as the `onError` and `onSuccess` callbacks of the `MutationCache`. |\n| <a id=\"property-mutationfn\"></a> `mutationFn?` | (`variables`: `TVariables`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `Promise`\\<`TData`\\> | `undefined` | The function that performs the asynchronous task this mutation runs. Required, unless a default mutation function has been set for the matching `mutationKey` via `queryClient.setMutationDefaults`. Receives the `variables` passed to `mutate`, and a [MutationFunctionContext](../type-aliases/MutationFunctionContext.md) holding the `QueryClient`, the `mutationKey` and `meta`. Must return a promise that resolves the mutation's data. |\n| <a id=\"property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | `undefined` | The key to use for this mutation. Optional, but required to inherit defaults registered with `queryClient.setMutationDefaults`, and to match this mutation with `useMutationState` or `queryClient.isMutating`. |\n| <a id=\"property-networkmode\"></a> `networkMode?` | `\"online\"` \\| `\"always\"` \\| `\"offlineFirst\"` | `'online'` | Controls whether a mutation is allowed to run based on the current network connectivity. **See** [Network Mode](https://tanstack.com/query/latest/docs/framework/react/guides/network-mode) for more information. |\n| <a id=\"property-onerror\"></a> `onError?` | (`error`: `TError`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult` \\| `undefined`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation encounters an error, and is passed the error. If a promise is returned, it is awaited before `onSettled` runs. |\n| <a id=\"property-onmutate\"></a> `onMutate?` | (`variables`: `TVariables`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `TOnMutateResult` \\| `Promise`\\<`TOnMutateResult`\\> | `undefined` | This function fires before the mutation function runs, and receives the same variables. Useful for optimistic updates applied in the hope that the mutation succeeds. The value it returns is passed to `onSuccess`, `onError` and `onSettled` as `onMutateResult`, which is where an optimistic update is usually rolled back. If a promise is returned, it is awaited before the mutation function runs. |\n| <a id=\"property-onsettled\"></a> `onSettled?` | (`data`: `TData` \\| `undefined`, `error`: `TError` \\| `null`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult` \\| `undefined`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation either succeeds or errors, and is passed either the data or the error. If a promise is returned, it is awaited before the mutation settles. |\n| <a id=\"property-onsuccess\"></a> `onSuccess?` | (`data`: `TData`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation succeeds, and is passed the mutation's result. If a promise is returned, it is awaited before `onSettled` runs. |\n| <a id=\"property-retry\"></a> `retry?` | \\| `number` \\| `false` \\| `true` \\| ((`failureCount`: `number`, `error`: `TError`) => `boolean`) | `0` | If `false`, failed mutations will not retry by default. If `true`, failed mutations will retry infinitely. If set to an integer number, e.g. 3, failed mutations will retry until the failed mutation count meets that number. If set to a function `(failureCount, error) => boolean` failed mutations will retry until the function returns false. |\n| <a id=\"property-retrydelay\"></a> `retryDelay?` | `number` \\| ((`failureCount`: `number`, `error`: `TError`) => `number`) | `undefined` | This function receives a `retryAttempt` integer and the actual Error and returns the delay to apply before the next attempt in milliseconds. Defaults to a function that applies exponential backoff, capped at 30 seconds. |\n| <a id=\"property-scope\"></a> `scope?` | [`MutationScope`](../type-aliases/MutationScope.md) | `undefined` | Controls whether this mutation runs alongside others or waits its turn. Mutations sharing the same `scope.id` run serially, in the order they were started. Without a scope, a mutation runs as soon as it is triggered. |\n| <a id=\"property-throwonerror\"></a> `throwOnError?` | `boolean` \\| ((`error`: `TError`) => `boolean`) | `false` | Whether errors should be thrown instead of setting the `error` property. If set to `true`, all errors will be thrown to the nearest error boundary. If set to a function, it will be passed the error and should return a boolean indicating whether to throw the error (`true`) or return it as state (`false`). |\n","originalRawMarkdown":"---\nid: MutationOptions\ntitle: MutationOptions\n---\n\nDefined in: [packages/solid-query/src/types.ts:240](https://github.com/TanStack/query/blob/main/packages/solid-query/src/types.ts#L240)\n\nThe options accepted by `useMutation` and `mutationOptions`.\n\n## Extends\n\n- [`OmitKeyof`](../type-aliases/OmitKeyof.md)\\<[`MutationObserverOptions`](MutationObserverOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"_defaulted\"`\\>\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\nThe type your `mutationFn` resolves to.\n\n### TError\n\n`TError` = [`DefaultError`](../type-aliases/DefaultError.md)\n\nThe type of errors your `mutationFn` may throw.\n\n### TVariables\n\n`TVariables` = `void`\n\nThe type of the variables your `mutationFn` accepts.\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\nThe type returned by `onMutate`, passed on to `onSuccess`/`onError`/`onSettled`.\n\n## Properties\n\n| Property | Type | Default value | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"property-gctime\"></a> `gcTime?` | `number` | `undefined` | The time in milliseconds that an unused/inactive mutation remains in memory before it is garbage collected. Defaults to `5 * 60 * 1000` (5 minutes), or `Infinity` during SSR. |\n| <a id=\"property-meta\"></a> `meta?` | `Record`\\<`string`, `unknown`\\> | `undefined` | Additional payload to be stored on the mutation cache entry. Use it to pass information that can be read wherever the `mutation` is available, such as the `onError` and `onSuccess` callbacks of the `MutationCache`. |\n| <a id=\"property-mutationfn\"></a> `mutationFn?` | (`variables`: `TVariables`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `Promise`\\<`TData`\\> | `undefined` | The function that performs the asynchronous task this mutation runs. Required, unless a default mutation function has been set for the matching `mutationKey` via `queryClient.setMutationDefaults`. Receives the `variables` passed to `mutate`, and a [MutationFunctionContext](../type-aliases/MutationFunctionContext.md) holding the `QueryClient`, the `mutationKey` and `meta`. Must return a promise that resolves the mutation's data. |\n| <a id=\"property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | `undefined` | The key to use for this mutation. Optional, but required to inherit defaults registered with `queryClient.setMutationDefaults`, and to match this mutation with `useMutationState` or `queryClient.isMutating`. |\n| <a id=\"property-networkmode\"></a> `networkMode?` | `\"online\"` \\| `\"always\"` \\| `\"offlineFirst\"` | `'online'` | Controls whether a mutation is allowed to run based on the current network connectivity. **See** [Network Mode](https://tanstack.com/query/latest/docs/framework/react/guides/network-mode) for more information. |\n| <a id=\"property-onerror\"></a> `onError?` | (`error`: `TError`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult` \\| `undefined`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation encounters an error, and is passed the error. If a promise is returned, it is awaited before `onSettled` runs. |\n| <a id=\"property-onmutate\"></a> `onMutate?` | (`variables`: `TVariables`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `TOnMutateResult` \\| `Promise`\\<`TOnMutateResult`\\> | `undefined` | This function fires before the mutation function runs, and receives the same variables. Useful for optimistic updates applied in the hope that the mutation succeeds. The value it returns is passed to `onSuccess`, `onError` and `onSettled` as `onMutateResult`, which is where an optimistic update is usually rolled back. If a promise is returned, it is awaited before the mutation function runs. |\n| <a id=\"property-onsettled\"></a> `onSettled?` | (`data`: `TData` \\| `undefined`, `error`: `TError` \\| `null`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult` \\| `undefined`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation either succeeds or errors, and is passed either the data or the error. If a promise is returned, it is awaited before the mutation settles. |\n| <a id=\"property-onsuccess\"></a> `onSuccess?` | (`data`: `TData`, `variables`: `TVariables`, `onMutateResult`: `TOnMutateResult`, `context`: [`MutationFunctionContext`](../type-aliases/MutationFunctionContext.md)) => `unknown` | `undefined` | This function fires when the mutation succeeds, and is passed the mutation's result. If a promise is returned, it is awaited before `onSettled` runs. |\n| <a id=\"property-retry\"></a> `retry?` | \\| `number` \\| `false` \\| `true` \\| ((`failureCount`: `number`, `error`: `TError`) => `boolean`) | `0` | If `false`, failed mutations will not retry by default. If `true`, failed mutations will retry infinitely. If set to an integer number, e.g. 3, failed mutations will retry until the failed mutation count meets that number. If set to a function `(failureCount, error) => boolean` failed mutations will retry until the function returns false. |\n| <a id=\"property-retrydelay\"></a> `retryDelay?` | `number` \\| ((`failureCount`: `number`, `error`: `TError`) => `number`) | `undefined` | This function receives a `retryAttempt` integer and the actual Error and returns the delay to apply before the next attempt in milliseconds. Defaults to a function that applies exponential backoff, capped at 30 seconds. |\n| <a id=\"property-scope\"></a> `scope?` | [`MutationScope`](../type-aliases/MutationScope.md) | `undefined` | Controls whether this mutation runs alongside others or waits its turn. Mutations sharing the same `scope.id` run serially, in the order they were started. Without a scope, a mutation runs as soon as it is triggered. |\n| <a id=\"property-throwonerror\"></a> `throwOnError?` | `boolean` \\| ((`error`: `TError`) => `boolean`) | `false` | Whether errors should be thrown instead of setting the `error` property. If set to `true`, all errors will be thrown to the nearest error boundary. If set to a function, it will be passed the error and should return a boolean indicating whether to throw the error (`true`) or return it as state (`false`). |\n"}
