t","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Modifier"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-clearinterval\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"clearInterval"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"readonly"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"intervalId"},{"type":"text","value":": "},{"type":"inlineCode","value":"TTimerId"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"}]},{"type":"tableCell","children":[{"type":"text","value":"Cancels an interval scheduled with "},{"type":"inlineCode","value":"setInterval"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-cleartimeout\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"clearTimeout"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"readonly"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"timeoutId"},{"type":"text","value":": "},{"type":"inlineCode","value":"TTimerId"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"}]},{"type":"tableCell","children":[{"type":"text","value":"Cancels a timeout scheduled with "},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-setinterval\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"setInterval"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"readonly"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"callback"},{"type":"text","value":": "},{"type":"link","href":"TimeoutCallback.md","children":[{"type":"inlineCode","value":"TimeoutCallback"}]},{"type":"text","value":", "},{"type":"inlineCode","value":"delay"},{"type":"text","value":": "},{"type":"inlineCode","value":"number"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TTimerId"}]},{"type":"tableCell","children":[{"type":"text","value":"Schedules "},{"type":"inlineCode","value":"callback"},{"type":"text","value":" to run every "},{"type":"inlineCode","value":"delay"},{"type":"text","value":" milliseconds, like the global "},{"type":"inlineCode","value":"setInterval"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-settimeout\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"setTimeout"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"readonly"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"callback"},{"type":"text","value":": "},{"type":"link","href":"TimeoutCallback.md","children":[{"type":"inlineCode","value":"TimeoutCallback"}]},{"type":"text","value":", "},{"type":"inlineCode","value":"delay"},{"type":"text","value":": "},{"type":"inlineCode","value":"number"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TTimerId"}]},{"type":"tableCell","children":[{"type":"text","value":"Schedules "},{"type":"inlineCode","value":"callback"},{"type":"text","value":" to run once after "},{"type":"inlineCode","value":"delay"},{"type":"text","value":" milliseconds, like the global "},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":"."}]}]]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"ttimerid","text":"TTimerId","level":3},{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype TimeoutProvider<TTimerId> = object;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:28](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L28)\n\nBackend for timer functions.\n\nTimers are performance-sensitive: short-lived timers (delays under a few seconds) tend to be\nlatency-sensitive, while long-lived ones may benefit more from coalescing — batching timers\nwith similar deadlines together — which the default provider (backed by the platform's global\n`setTimeout`/`setInterval`) does not do. A custom provider can implement coalescing, and can\nalso support delays longer than the ~24-day maximum of the global `setTimeout`.\n\n## Type Parameters\n\n### TTimerId\n\n`TTimerId` *extends* [`ManagedTimerId`](ManagedTimerId.md) = [`ManagedTimerId`](ManagedTimerId.md)\n\n## Properties\n\n| Property | Modifier | Type | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"property-clearinterval\"></a> `clearInterval` | `readonly` | (`intervalId`: `TTimerId` \\| `undefined`) => `void` | Cancels an interval scheduled with `setInterval`. |\n| <a id=\"property-cleartimeout\"></a> `clearTimeout` | `readonly` | (`timeoutId`: `TTimerId` \\| `undefined`) => `void` | Cancels a timeout scheduled with `setTimeout`. |\n| <a id=\"property-setinterval\"></a> `setInterval` | `readonly` | (`callback`: [`TimeoutCallback`](TimeoutCallback.md), `delay`: `number`) => `TTimerId` | Schedules `callback` to run every `delay` milliseconds, like the global `setInterval`. |\n| <a id=\"property-settimeout\"></a> `setTimeout` | `readonly` | (`callback`: [`TimeoutCallback`](TimeoutCallback.md), `delay`: `number`) => `TTimerId` | Schedules `callback` to run once after `delay` milliseconds, like the global `setTimeout`. |\n","originalRawMarkdown":"---\nid: TimeoutProvider\ntitle: TimeoutProvider\n---\n\n```ts\ntype TimeoutProvider<TTimerId> = object;\n```\n\nDefined in: [packages/query-core/src/timeoutManager.ts:28](https://github.com/TanStack/query/blob/main/packages/query-core/src/timeoutManager.ts#L28)\n\nBackend for timer functions.\n\nTimers are performance-sensitive: short-lived timers (delays under a few seconds) tend to be\nlatency-sensitive, while long-lived ones may benefit more from coalescing — batching timers\nwith similar deadlines together — which the default provider (backed by the platform's global\n`setTimeout`/`setInterval`) does not do. A custom provider can implement coalescing, and can\nalso support delays longer than the ~24-day maximum of the global `setTimeout`.\n\n## Type Parameters\n\n### TTimerId\n\n`TTimerId` *extends* [`ManagedTimerId`](ManagedTimerId.md) = [`ManagedTimerId`](ManagedTimerId.md)\n\n## Properties\n\n| Property | Modifier | Type | Description |\n| ------ | ------ | ------ | ------ |\n| <a id=\"property-clearinterval\"></a> `clearInterval` | `readonly` | (`intervalId`: `TTimerId` \\| `undefined`) => `void` | Cancels an interval scheduled with `setInterval`. |\n| <a id=\"property-cleartimeout\"></a> `clearTimeout` | `readonly` | (`timeoutId`: `TTimerId` \\| `undefined`) => `void` | Cancels a timeout scheduled with `setTimeout`. |\n| <a id=\"property-setinterval\"></a> `setInterval` | `readonly` | (`callback`: [`TimeoutCallback`](TimeoutCallback.md), `delay`: `number`) => `TTimerId` | Schedules `callback` to run every `delay` milliseconds, like the global `setInterval`. |\n| <a id=\"property-settimeout\"></a> `setTimeout` | `readonly` | (`callback`: [`TimeoutCallback`](TimeoutCallback.md), `delay`: `number`) => `TTimerId` | Schedules `callback` to run once after `delay` milliseconds, like the global `setTimeout`. |\n"}
