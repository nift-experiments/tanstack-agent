:"text","value":" resolves it."}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"link","href":"DefaultError.md","children":[{"type":"inlineCode","value":"DefaultError"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of errors your "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" may throw."}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The type "},{"type":"inlineCode","value":"data"},{"type":"text","value":" ends up as after "},{"type":"inlineCode","value":"select"},{"type":"text","value":" runs — defaults to "},{"type":"inlineCode","value":"InfiniteData<TQueryFnData>"},{"type":"text","value":",\nthe shape of all fetched pages plus their page params."}]},{"type":"heading","depth":3,"id":"tquerykey","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"QueryKey.md","children":[{"type":"inlineCode","value":"QueryKey"}]},{"type":"text","value":" = "},{"type":"link","href":"QueryKey.md","children":[{"type":"inlineCode","value":"QueryKey"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of your "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"tpageparam","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"paragraph","children":[{"type":"text","value":"The type of the parameter passed to "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" to fetch a given page."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tqueryfndata","text":"TQueryFnData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tquerykey","text":"TQueryKey","level":3},{"id":"tpageparam","text":"TPageParam","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> = Accessor<InfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & object>;\n```\n\nDefined in: [packages/solid-query/src/infiniteQueryOptions.ts:24](https://github.com/TanStack/query/blob/main/packages/solid-query/src/infiniteQueryOptions.ts#L24)\n\nThe options accepted by the `infiniteQueryOptions` overload selected when no `initialData` is set — `data`\nmay be `undefined` while the query is `pending`. `infiniteQueryOptions` itself accepts and returns a plain\nobject (its parameter type is `ReturnType<UndefinedInitialDataInfiniteOptions<...>>`, i.e. this `Accessor`\ncalled); Solid's reactivity applies where the result is consumed instead, e.g.\n`useInfiniteQuery(() => options)`.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData`\n\nThe type of a single page, as your `queryFn` resolves it.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>\n\nThe type `data` ends up as after `select` runs — defaults to `InfiniteData<TQueryFnData>`,\nthe shape of all fetched pages plus their page params.\n\n### TQueryKey\n\n`TQueryKey` *extends* [`QueryKey`](QueryKey.md) = [`QueryKey`](QueryKey.md)\n\nThe type of your `queryKey`.\n\n### TPageParam\n\n`TPageParam` = `unknown`\n\nThe type of the parameter passed to `queryFn` to fetch a given page.\n","originalRawMarkdown":"---\nid: UndefinedInitialDataInfiniteOptions\ntitle: UndefinedInitialDataInfiniteOptions\n---\n\n```ts\ntype UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> = Accessor<InfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & object>;\n```\n\nDefined in: [packages/solid-query/src/infiniteQueryOptions.ts:24](https://github.com/TanStack/query/blob/main/packages/solid-query/src/infiniteQueryOptions.ts#L24)\n\nThe options accepted by the `infiniteQueryOptions` overload selected when no `initialData` is set — `data`\nmay be `undefined` while the query is `pending`. `infiniteQueryOptions` itself accepts and returns a plain\nobject (its parameter type is `ReturnType<UndefinedInitialDataInfiniteOptions<...>>`, i.e. this `Accessor`\ncalled); Solid's reactivity applies where the result is consumed instead, e.g.\n`useInfiniteQuery(() => options)`.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData`\n\nThe type of a single page, as your `queryFn` resolves it.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>\n\nThe type `data` ends up as after `select` runs — defaults to `InfiniteData<TQueryFnData>`,\nthe shape of all fetched pages plus their page params.\n\n### TQueryKey\n\n`TQueryKey` *extends* [`QueryKey`](QueryKey.md) = [`QueryKey`](QueryKey.md)\n\nThe type of your `queryKey`.\n\n### TPageParam\n\n`TPageParam` = `unknown`\n\nThe type of the parameter passed to `queryFn` to fetch a given page.\n"}
