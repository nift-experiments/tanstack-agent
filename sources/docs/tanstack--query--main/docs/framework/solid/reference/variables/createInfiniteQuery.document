{"document":{"type":"root","children":[{"type":"code","value":"const createInfiniteQuery: {\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>  (options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>  (options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;\n} = useInfiniteQuery;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/solid-query/src/index.ts#L72","children":[{"type":"text","value":"packages/solid-query/src/index.ts:72"}]}]},{"type":"heading","depth":2,"id":"call-signature","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" are identical to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of\n"},{"type":"inlineCode","value":"initialPageParam"},{"type":"text","value":", "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":", "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":", and "},{"type":"inlineCode","value":"maxPages"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"This overload is selected when "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" is set."}]},{"type":"heading","depth":3,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"tquerykey","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"tpageparam","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/DefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"DefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor returning the "},{"type":"link","href":"../type-aliases/DefinedInitialDataInfiniteOptions.md","children":[{"type":"text","value":"DefinedInitialDataInfiniteOptions"}]},{"type":"text","value":" to use — everything you\ncan pass to "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":", with "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" set."}]},{"type":"heading","depth":4,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor for a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/DefinedUseInfiniteQueryResult.md","children":[{"type":"inlineCode","value":"DefinedUseInfiniteQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same properties as "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":". "},{"type":"inlineCode","value":"data.pages"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"data.pageParams"},{"type":"text","value":" are also added, as long as a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" doesn't change "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" away from its default\n"},{"type":"inlineCode","value":"InfiniteData<TQueryFnData>"},{"type":"text","value":" shape."}]},{"type":"heading","depth":3,"id":"remarks","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"Keep in mind that imperative fetch calls, such as "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like "},{"type":"inlineCode","value":"hasNextPage && !isFetching"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"../functions/infiniteQueryOptions.md","children":[{"type":"text","value":"infiniteQueryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" and imperative APIs like "},{"type":"inlineCode","value":"queryClient.infiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { For } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  // `projectsQuery.data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n    initialData: { pages: [], pageParams: [] },\n  }))\n\n  return (\n    <div>\n      {projectsQuery.isError ? <span>Error: {projectsQuery.error.message}</span> : null}\n      <ul>\n        <For each={projectsQuery.data.pages}>\n          {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n        </For>\n      </ul>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" are identical to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of\n"},{"type":"inlineCode","value":"initialPageParam"},{"type":"text","value":", "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":", "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":", and "},{"type":"inlineCode","value":"maxPages"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-2","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"terror-2","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-2","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"tquerykey-2","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"tpageparam-2","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options-2","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor returning the "},{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"text","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":" to use — everything\nyou can pass to "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"queryclient-2","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An accessor for a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseInfiniteQueryResult.md","children":[{"type":"inlineCode","value":"UseInfiniteQueryResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same properties as "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":". "},{"type":"inlineCode","value":"data.pages"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"data.pageParams"},{"type":"text","value":" are also added, as long as a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" doesn't change "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" away from its default\n"},{"type":"inlineCode","value":"InfiniteData<TQueryFnData>"},{"type":"text","value":" shape."}]},{"type":"heading","depth":3,"id":"remarks-2","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"Keep in mind that imperative fetch calls, such as "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like "},{"type":"inlineCode","value":"hasNextPage && !isFetching"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"../functions/infiniteQueryOptions.md","children":[{"type":"text","value":"infiniteQueryOptions"}]},{"type":"text","value":" to share these options between "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" and imperative APIs like "},{"type":"inlineCode","value":"queryClient.infiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Fetching the next page from a \"Load More\" button click:"}]},{"type":"code","value":"import { For, Match, Switch } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <button\n          onClick={() => projectsQuery.fetchNextPage()}\n          disabled={!projectsQuery.hasNextPage || projectsQuery.isFetching}\n        >\n          {projectsQuery.isFetchingNextPage\n            ? 'Loading more...'\n            : projectsQuery.hasNextPage\n              ? 'Load More'\n              : 'Nothing more to load'}\n        </button>\n      </Match>\n    </Switch>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Fetching the next page automatically as the user scrolls, using an "},{"type":"inlineCode","value":"IntersectionObserver"},{"type":"text","value":" on a\nsentinel element after the list:"}]},{"type":"code","value":"import { For, Match, Switch, createEffect, onCleanup } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  let sentinelRef: HTMLDivElement | undefined\n\n  createEffect(() => {\n    if (sentinelRef == null || !projectsQuery.hasNextPage || projectsQuery.isFetching) return\n\n    const observer = new IntersectionObserver(([entry]) => {\n      if (entry?.isIntersecting) projectsQuery.fetchNextPage()\n    })\n    observer.observe(sentinelRef)\n\n    onCleanup(() => observer.disconnect())\n  })\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <div ref={sentinelRef}>{projectsQuery.isFetchingNextPage ? 'Loading more...' : null}</div>\n      </Match>\n    </Switch>\n  )\n}","lang":"tsx"}],"headings":[{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tqueryfndata","text":"TQueryFnData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tdata","text":"TData","level":4},{"id":"tquerykey","text":"TQueryKey","level":4},{"id":"tpageparam","text":"TPageParam","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"queryclient","text":"queryClient?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"remarks","text":"Remarks","level":3},{"id":"see","text":"See","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tqueryfndata-2","text":"TQueryFnData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tdata-2","text":"TData","level":4},{"id":"tquerykey-2","text":"TQueryKey","level":4},{"id":"tpageparam-2","text":"TPageParam","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"queryclient-2","text":"queryClient?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"remarks-2","text":"Remarks","level":3},{"id":"see-2","text":"See","level":3},{"id":"examples","text":"Examples","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\nconst createInfiniteQuery: {\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>  (options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>  (options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;\n} = useInfiniteQuery;\n```\n\nDefined in: [packages/solid-query/src/index.ts:72](https://github.com/TanStack/query/blob/main/packages/solid-query/src/index.ts#L72)\n\n## Call Signature\n\n```ts\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;\n```\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\nThis overload is selected when `initialData` is set.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you\ncan pass to `useInfiniteQuery`, with `initialData` set.\n\n#### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`DefinedUseInfiniteQueryResult`](../type-aliases/DefinedUseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### See\n\n[infiniteQueryOptions](../functions/infiniteQueryOptions.md) to share these options between `useInfiniteQuery` and imperative APIs like `queryClient.infiniteQuery`.\n\n### Example\n\n```tsx\nimport { For } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  // `projectsQuery.data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n    initialData: { pages: [], pageParams: [] },\n  }))\n\n  return (\n    <div>\n      {projectsQuery.isError ? <span>Error: {projectsQuery.error.message}</span> : null}\n      <ul>\n        <For each={projectsQuery.data.pages}>\n          {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n        </For>\n      </ul>\n    </div>\n  )\n}\n```\n\n## Call Signature\n\n```ts\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;\n```\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything\nyou can pass to `useInfiniteQuery`.\n\n#### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryResult`](../type-aliases/UseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### See\n\n[infiniteQueryOptions](../functions/infiniteQueryOptions.md) to share these options between `useInfiniteQuery` and imperative APIs like `queryClient.infiniteQuery`.\n\n### Examples\n\nFetching the next page from a \"Load More\" button click:\n```tsx\nimport { For, Match, Switch } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <button\n          onClick={() => projectsQuery.fetchNextPage()}\n          disabled={!projectsQuery.hasNextPage || projectsQuery.isFetching}\n        >\n          {projectsQuery.isFetchingNextPage\n            ? 'Loading more...'\n            : projectsQuery.hasNextPage\n              ? 'Load More'\n              : 'Nothing more to load'}\n        </button>\n      </Match>\n    </Switch>\n  )\n}\n```\n\nFetching the next page automatically as the user scrolls, using an `IntersectionObserver` on a\nsentinel element after the list:\n```tsx\nimport { For, Match, Switch, createEffect, onCleanup } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  let sentinelRef: HTMLDivElement | undefined\n\n  createEffect(() => {\n    if (sentinelRef == null || !projectsQuery.hasNextPage || projectsQuery.isFetching) return\n\n    const observer = new IntersectionObserver(([entry]) => {\n      if (entry?.isIntersecting) projectsQuery.fetchNextPage()\n    })\n    observer.observe(sentinelRef)\n\n    onCleanup(() => observer.disconnect())\n  })\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <div ref={sentinelRef}>{projectsQuery.isFetchingNextPage ? 'Loading more...' : null}</div>\n      </Match>\n    </Switch>\n  )\n}\n```\n","originalRawMarkdown":"---\nid: createInfiniteQuery\ntitle: createInfiniteQuery\n---\n\n```ts\nconst createInfiniteQuery: {\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>  (options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>  (options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;\n} = useInfiniteQuery;\n```\n\nDefined in: [packages/solid-query/src/index.ts:72](https://github.com/TanStack/query/blob/main/packages/solid-query/src/index.ts#L72)\n\n## Call Signature\n\n```ts\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): DefinedUseInfiniteQueryResult<TData, TError>;\n```\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\nThis overload is selected when `initialData` is set.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you\ncan pass to `useInfiniteQuery`, with `initialData` set.\n\n#### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`DefinedUseInfiniteQueryResult`](../type-aliases/DefinedUseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### See\n\n[infiniteQueryOptions](../functions/infiniteQueryOptions.md) to share these options between `useInfiniteQuery` and imperative APIs like `queryClient.infiniteQuery`.\n\n### Example\n\n```tsx\nimport { For } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  // `projectsQuery.data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n  // list stays visible alongside the error.\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n    initialData: { pages: [], pageParams: [] },\n  }))\n\n  return (\n    <div>\n      {projectsQuery.isError ? <span>Error: {projectsQuery.error.message}</span> : null}\n      <ul>\n        <For each={projectsQuery.data.pages}>\n          {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n        </For>\n      </ul>\n    </div>\n  )\n}\n```\n\n## Call Signature\n\n```ts\n<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>, queryClient?: Accessor<QueryClient>): UseInfiniteQueryResult<TData, TError>;\n```\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nAn accessor returning the [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything\nyou can pass to `useInfiniteQuery`.\n\n#### queryClient?\n\n`Accessor`\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nAn accessor for a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryResult`](../type-aliases/UseInfiniteQueryResult.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.pages` and\n`data.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### See\n\n[infiniteQueryOptions](../functions/infiniteQueryOptions.md) to share these options between `useInfiniteQuery` and imperative APIs like `queryClient.infiniteQuery`.\n\n### Examples\n\nFetching the next page from a \"Load More\" button click:\n```tsx\nimport { For, Match, Switch } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <button\n          onClick={() => projectsQuery.fetchNextPage()}\n          disabled={!projectsQuery.hasNextPage || projectsQuery.isFetching}\n        >\n          {projectsQuery.isFetchingNextPage\n            ? 'Loading more...'\n            : projectsQuery.hasNextPage\n              ? 'Load More'\n              : 'Nothing more to load'}\n        </button>\n      </Match>\n    </Switch>\n  )\n}\n```\n\nFetching the next page automatically as the user scrolls, using an `IntersectionObserver` on a\nsentinel element after the list:\n```tsx\nimport { For, Match, Switch, createEffect, onCleanup } from 'solid-js'\nimport { useInfiniteQuery } from '@tanstack/solid-query'\n\nfunction Projects() {\n  const projectsQuery = useInfiniteQuery(() => ({\n    queryKey: ['projects'],\n    queryFn: ({ pageParam }) => fetchProjects(pageParam),\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }))\n\n  let sentinelRef: HTMLDivElement | undefined\n\n  createEffect(() => {\n    if (sentinelRef == null || !projectsQuery.hasNextPage || projectsQuery.isFetching) return\n\n    const observer = new IntersectionObserver(([entry]) => {\n      if (entry?.isIntersecting) projectsQuery.fetchNextPage()\n    })\n    observer.observe(sentinelRef)\n\n    onCleanup(() => observer.disconnect())\n  })\n\n  return (\n    <Switch>\n      <Match when={projectsQuery.isPending}>Loading...</Match>\n      <Match when={projectsQuery.isError}>Error: {projectsQuery.error.message}</Match>\n      <Match when={projectsQuery.isSuccess}>\n        <ul>\n          <For each={projectsQuery.data.pages}>\n            {(page) => <For each={page.projects}>{(p) => <li>{p.name}</li>}</For>}\n          </For>\n        </ul>\n        <div ref={sentinelRef}>{projectsQuery.isFetchingNextPage ? 'Loading more...' : null}</div>\n      </Match>\n    </Switch>\n  )\n}\n```\n"}
