{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"@tanstack/svelte-query"},{"type":"text","value":" package offers a 1st-class API for using TanStack Query via Svelte."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { QueryClient, QueryClientProvider } from '@tanstack/svelte-query'\n  import Example from './lib/Example.svelte'\n\n  const queryClient = new QueryClient()\n</script>\n\n<QueryClientProvider client={queryClient}>\n  <Example />\n</QueryClientProvider>","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"Then call any function (e.g. createQuery) from any component:"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createQuery } from '@tanstack/svelte-query'\n\n  const query = createQuery(() => ({\n    queryKey: ['todos'],\n    queryFn: () => fetchTodos(),\n  }))\n</script>\n\n<div>\n  {#if query.isPending}\n    <p>Loading...</p>\n  {:else if query.isError}\n    <p>Error: {query.error.message}</p>\n  {:else if query.isSuccess}\n    {#each query.data as todo}\n      <p>{todo.title}</p>\n    {/each}\n  {/if}\n</div>","lang":"svelte"},{"type":"heading","depth":2,"id":"important-differences-between-svelte-query-react-query","children":[{"type":"text","value":"Important Differences between Svelte Query & React Query"}]},{"type":"paragraph","children":[{"type":"text","value":"Svelte Query offers an API similar to React Query, but there are some key differences to be mindful of."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Arguments to "},{"type":"inlineCode","value":"svelte-query"},{"type":"text","value":" primitives (like "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":", "},{"type":"inlineCode","value":"createMutation"},{"type":"text","value":") are functions, so that they can be tracked in a reactive scope."}]}]}]},{"type":"code","value":"// ❌ react version\nuseQuery({\n  queryKey: ['todos', todo],\n  queryFn: fetchTodos,\n})\n\n// ✅ svelte version\ncreateQuery(() => ({\n  queryKey: ['todos', todo],\n  queryFn: fetchTodos,\n}))","lang":"ts"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Svelte Query primitives do not support destructuring. The return value from these functions is a proxy, and their properties are dynamically resolved."}]}]}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createQuery } from '@tanstack/svelte-query'\n\n  const query = createQuery(() => ({\n    queryKey: ['repoData'],\n    queryFn: () =>\n      fetch('https://api.github.com/repos/tannerlinsley/react-query').then(\n        (res) => res.json(),\n      ),\n  }))\n</script>\n\n<!-- ❌ react version -- supports destructuring outside reactive context\n  const { isPending, error, data } = useQuery({\n    queryKey: ['repoData'],\n    queryFn: () =>\n      fetch('https://api.github.com/repos/tannerlinsley/react-query').then(\n        (res) => res.json(),\n      ),\n  }) -->\n\n<!-- ✅ access query properties in svelte reactive context -->\n<div>\n  {#if query.isPending}\n    <p>Loading...</p>\n  {:else if query.isError}\n    <p>Error: {query.error.message}</p>\n  {:else if query.isSuccess}\n    <div>\n      <h1>{query.data.name}</h1>\n      <p>{query.data.description}</p>\n      <strong>👀 {query.data.subscribers_count}</strong>\n      <strong>✨ {query.data.stargazers_count}</strong>\n      <strong>🍴 {query.data.forks_count}</strong>\n    </div>\n  {/if}\n</div>","lang":"svelte"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Runes values can be passed in directly to function arguments. Svelte Query will update the query automatically."}]}]}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createQuery } from '@tanstack/svelte-query'\n\n  let enabled = $state(false)\n  let todoCount = $state(0)\n\n  // ✅ passing a rune directly is safe and observers update\n  // automatically when the value of a rune changes\n  const todosQuery = createQuery(() => ({\n    queryKey: ['todos'],\n    queryFn: () => fetchTodos(),\n    enabled: enabled,\n  }))\n\n  const todoDetailsQuery = createQuery(() => ({\n    queryKey: ['todo', todoCount],\n    queryFn: fetchTodo,\n    enabled: todoCount > 0,\n  }))\n</script>\n\n<div>\n  {#if todosQuery.isPending}\n    <p>Loading...</p>\n  {:else if todosQuery.isError}\n    <p>Error: {todosQuery.error.message}</p>\n  {:else if todosQuery.isSuccess}\n    {#each todosQuery.data as todo}\n      <button onclick={() => (todoCount = todo.id)}>{todo.title}</button>\n    {/each}\n  {/if}\n  <button onclick={() => (enabled = !enabled)}>Toggle enabled</button>\n</div>","lang":"svelte"},{"type":"list","ordered":false,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Errors can be caught and reset using Svelte's native "},{"type":"inlineCode","value":"<svelte:boundary>"},{"type":"text","value":" component.\nSet "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" option to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" to make sure errors are thrown to the "},{"type":"inlineCode","value":"<svelte:boundary>"},{"type":"text","value":" component."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Since property tracking is handled through Svelte's fine-grained reactivity, options like "},{"type":"inlineCode","value":"notifyOnChangeProps"},{"type":"text","value":" are not needed"}]}]}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"important-differences-between-svelte-query-react-query","text":"Important Differences between Svelte Query & React Query","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe `@tanstack/svelte-query` package offers a 1st-class API for using TanStack Query via Svelte.\n\n## Example\n\n```svelte\n<script lang=\"ts\">\n  import { QueryClient, QueryClientProvider } from '@tanstack/svelte-query'\n  import Example from './lib/Example.svelte'\n\n  const queryClient = new QueryClient()\n</script>\n\n<QueryClientProvider client={queryClient}>\n  <Example />\n</QueryClientProvider>\n```\n\nThen call any function (e.g. createQuery) from any component:\n\n```svelte\n<script lang=\"ts\">\n  import { createQuery } from '@tanstack/svelte-query'\n\n  const query = createQuery(() => ({\n    queryKey: ['todos'],\n    queryFn: () => fetchTodos(),\n  }))\n</script>\n\n<div>\n  {#if query.isPending}\n    <p>Loading...</p>\n  {:else if query.isError}\n    <p>Error: {query.error.message}</p>\n  {:else if query.isSuccess}\n    {#each query.data as todo}\n      <p>{todo.title}</p>\n    {/each}\n  {/if}\n</div>\n```\n\n## Important Differences between Svelte Query & React Query\n\nSvelte Query offers an API similar to React Query, but there are some key differences to be mindful of.\n\n- Arguments to `svelte-query` primitives (like `createQuery`, `createMutation`) are functions, so that they can be tracked in a reactive scope.\n\n```ts\n// ❌ react version\nuseQuery({\n  queryKey: ['todos', todo],\n  queryFn: fetchTodos,\n})\n\n// ✅ svelte version\ncreateQuery(() => ({\n  queryKey: ['todos', todo],\n  queryFn: fetchTodos,\n}))\n```\n\n- Svelte Query primitives do not support destructuring. The return value from these functions is a proxy, and their properties are dynamically resolved.\n\n```svelte\n<script lang=\"ts\">\n  import { createQuery } from '@tanstack/svelte-query'\n\n  const query = createQuery(() => ({\n    queryKey: ['repoData'],\n    queryFn: () =>\n      fetch('https://api.github.com/repos/tannerlinsley/react-query').then(\n        (res) => res.json(),\n      ),\n  }))\n</script>\n\n<!-- ❌ react version -- supports destructuring outside reactive context\n  const { isPending, error, data } = useQuery({\n    queryKey: ['repoData'],\n    queryFn: () =>\n      fetch('https://api.github.com/repos/tannerlinsley/react-query').then(\n        (res) => res.json(),\n      ),\n  }) -->\n\n<!-- ✅ access query properties in svelte reactive context -->\n<div>\n  {#if query.isPending}\n    <p>Loading...</p>\n  {:else if query.isError}\n    <p>Error: {query.error.message}</p>\n  {:else if query.isSuccess}\n    <div>\n      <h1>{query.data.name}</h1>\n      <p>{query.data.description}</p>\n      <strong>👀 {query.data.subscribers_count}</strong>\n      <strong>✨ {query.data.stargazers_count}</strong>\n      <strong>🍴 {query.data.forks_count}</strong>\n    </div>\n  {/if}\n</div>\n```\n\n- Runes values can be passed in directly to function arguments. Svelte Query will update the query automatically.\n\n```svelte\n<script lang=\"ts\">\n  import { createQuery } from '@tanstack/svelte-query'\n\n  let enabled = $state(false)\n  let todoCount = $state(0)\n\n  // ✅ passing a rune directly is safe and observers update\n  // automatically when the value of a rune changes\n  const todosQuery = createQuery(() => ({\n    queryKey: ['todos'],\n    queryFn: () => fetchTodos(),\n    enabled: enabled,\n  }))\n\n  const todoDetailsQuery = createQuery(() => ({\n    queryKey: ['todo', todoCount],\n    queryFn: fetchTodo,\n    enabled: todoCount > 0,\n  }))\n</script>\n\n<div>\n  {#if todosQuery.isPending}\n    <p>Loading...</p>\n  {:else if todosQuery.isError}\n    <p>Error: {todosQuery.error.message}</p>\n  {:else if todosQuery.isSuccess}\n    {#each todosQuery.data as todo}\n      <button onclick={() => (todoCount = todo.id)}>{todo.title}</button>\n    {/each}\n  {/if}\n  <button onclick={() => (enabled = !enabled)}>Toggle enabled</button>\n</div>\n```\n\n- Errors can be caught and reset using Svelte's native `<svelte:boundary>` component.\n  Set `throwOnError` option to `true` to make sure errors are thrown to the `<svelte:boundary>` component.\n\n- Since property tracking is handled through Svelte's fine-grained reactivity, options like `notifyOnChangeProps` are not needed\n","originalRawMarkdown":"---\nid: quick-start\ntitle: Quick Start\n---\n\nThe `@tanstack/svelte-query` package offers a 1st-class API for using TanStack Query via Svelte.\n\n## Example\n\n```svelte\n<script lang=\"ts\">\n  import { QueryClient, QueryClientProvider } from '@tanstack/svelte-query'\n  import Example from './lib/Example.svelte'\n\n  const queryClient = new QueryClient()\n</script>\n\n<QueryClientProvider client={queryClient}>\n  <Example />\n</QueryClientProvider>\n```\n\nThen call any function (e.g. createQuery) from any component:\n\n```svelte\n<script lang=\"ts\">\n  import { createQuery } from '@tanstack/svelte-query'\n\n  const query = createQuery(() => ({\n    queryKey: ['todos'],\n    queryFn: () => fetchTodos(),\n  }))\n</script>\n\n<div>\n  {#if query.isPending}\n    <p>Loading...</p>\n  {:else if query.isError}\n    <p>Error: {query.error.message}</p>\n  {:else if query.isSuccess}\n    {#each query.data as todo}\n      <p>{todo.title}</p>\n    {/each}\n  {/if}\n</div>\n```\n\n## Important Differences between Svelte Query & React Query\n\nSvelte Query offers an API similar to React Query, but there are some key differences to be mindful of.\n\n- Arguments to `svelte-query` primitives (like `createQuery`, `createMutation`) are functions, so that they can be tracked in a reactive scope.\n\n```ts\n// ❌ react version\nuseQuery({\n  queryKey: ['todos', todo],\n  queryFn: fetchTodos,\n})\n\n// ✅ svelte version\ncreateQuery(() => ({\n  queryKey: ['todos', todo],\n  queryFn: fetchTodos,\n}))\n```\n\n- Svelte Query primitives do not support destructuring. The return value from these functions is a proxy, and their properties are dynamically resolved.\n\n```svelte\n<script lang=\"ts\">\n  import { createQuery } from '@tanstack/svelte-query'\n\n  const query = createQuery(() => ({\n    queryKey: ['repoData'],\n    queryFn: () =>\n      fetch('https://api.github.com/repos/tannerlinsley/react-query').then(\n        (res) => res.json(),\n      ),\n  }))\n</script>\n\n<!-- ❌ react version -- supports destructuring outside reactive context\n  const { isPending, error, data } = useQuery({\n    queryKey: ['repoData'],\n    queryFn: () =>\n      fetch('https://api.github.com/repos/tannerlinsley/react-query').then(\n        (res) => res.json(),\n      ),\n  }) -->\n\n<!-- ✅ access query properties in svelte reactive context -->\n<div>\n  {#if query.isPending}\n    <p>Loading...</p>\n  {:else if query.isError}\n    <p>Error: {query.error.message}</p>\n  {:else if query.isSuccess}\n    <div>\n      <h1>{query.data.name}</h1>\n      <p>{query.data.description}</p>\n      <strong>👀 {query.data.subscribers_count}</strong>\n      <strong>✨ {query.data.stargazers_count}</strong>\n      <strong>🍴 {query.data.forks_count}</strong>\n    </div>\n  {/if}\n</div>\n```\n\n- Runes values can be passed in directly to function arguments. Svelte Query will update the query automatically.\n\n```svelte\n<script lang=\"ts\">\n  import { createQuery } from '@tanstack/svelte-query'\n\n  let enabled = $state(false)\n  let todoCount = $state(0)\n\n  // ✅ passing a rune directly is safe and observers update\n  // automatically when the value of a rune changes\n  const todosQuery = createQuery(() => ({\n    queryKey: ['todos'],\n    queryFn: () => fetchTodos(),\n    enabled: enabled,\n  }))\n\n  const todoDetailsQuery = createQuery(() => ({\n    queryKey: ['todo', todoCount],\n    queryFn: fetchTodo,\n    enabled: todoCount > 0,\n  }))\n</script>\n\n<div>\n  {#if todosQuery.isPending}\n    <p>Loading...</p>\n  {:else if todosQuery.isError}\n    <p>Error: {todosQuery.error.message}</p>\n  {:else if todosQuery.isSuccess}\n    {#each todosQuery.data as todo}\n      <button onclick={() => (todoCount = todo.id)}>{todo.title}</button>\n    {/each}\n  {/if}\n  <button onclick={() => (enabled = !enabled)}>Toggle enabled</button>\n</div>\n```\n\n- Errors can be caught and reset using Svelte's native `<svelte:boundary>` component.\n  Set `throwOnError` option to `true` to make sure errors are thrown to the `<svelte:boundary>` component.\n\n- Since property tracking is handled through Svelte's fine-grained reactivity, options like `notifyOnChangeProps` are not needed\n"}
