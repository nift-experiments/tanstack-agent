{"document":{"type":"root","children":[{"type":"code","value":"function createMutation<TData, TError, TVariables, TContext>(options: Accessor<CreateMutationOptions<TData, TError, TVariables, TContext>>, queryClient?: Accessor<QueryClient>): CreateMutationResult<TData, TError, TVariables, TContext>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/svelte-query/src/createMutation.svelte.ts#L165","children":[{"type":"text","value":"packages/svelte-query/src/createMutation.svelte.ts:165"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n"},{"type":"inlineCode","value":"createMutation"},{"type":"text","value":" is the function for that."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":3,"id":"tvariables","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" = "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"tcontext","children":[{"type":"text","value":"TContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TContext"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Accessor.md","children":[{"type":"inlineCode","value":"Accessor"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateMutationOptions.md","children":[{"type":"inlineCode","value":"CreateMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/CreateMutationOptions.md","children":[{"type":"text","value":"CreateMutationOptions"}]},{"type":"text","value":" to use, wrapped in an "},{"type":"link","href":"../type-aliases/Accessor.md","children":[{"type":"text","value":"Accessor"}]},{"type":"text","value":" so options can be\nreactive."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/MutationObserverOptions.md#properties","children":[{"type":"inlineCode","value":"MutationObserverOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Accessor.md","children":[{"type":"inlineCode","value":"Accessor"}]},{"type":"text","value":"<"},{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will\nbe used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/CreateMutationResult.md","children":[{"type":"inlineCode","value":"CreateMutationResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TContext"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"mutate"},{"type":"text","value":"/"},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" also accept per-call "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onError"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callbacks as a second\nargument, useful for triggering call-site side effects (e.g. navigation) without coupling them to the shared\nmutation definition. If you make multiple requests, "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" will fire only after the latest call you've\nmade."}]},{"type":"html","value":"<a id=\"result-properties\"></a>"},{"type":"heading","depth":3,"id":"result-properties","children":[{"type":"text","value":"Result properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/MutationObserverBaseResult.md#properties","children":[{"type":"inlineCode","value":"MutationObserverBaseResult"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":2,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"mutationOptions.md","children":[{"type":"text","value":"mutationOptions"}]},{"type":"text","value":" to share these options across multiple "},{"type":"inlineCode","value":"createMutation"},{"type":"text","value":" call sites, or to look\nthe mutation up elsewhere via its "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":" (e.g. with "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n</script>\n\n<button\n  onclick={() =>\n    addMutation.mutate('Item', {\n      onError: (error) => console.error('Failed to add item:', error),\n    })\n  }\n>\n  Add\n</button>","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"Rendering the mutation's own state, rather than just firing it off:"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n</script>\n\n{#if addMutation.isPending}\n  Adding todo...\n{:else}\n  {#if addMutation.isError}\n    <div>An error occurred: {addMutation.error.message}</div>\n  {/if}\n  <button onclick={() => addMutation.mutate('Item')}>Add</button>\n{/if}","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"Optimistic update via "},{"type":"inlineCode","value":"onMutate"},{"type":"text","value":", rolling back on "},{"type":"inlineCode","value":"onError"},{"type":"text","value":":"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onMutate: async (newTodo: string) => {\n      await queryClient.cancelQueries({ queryKey: ['todos'] })\n      const previousTodos = queryClient.getQueryData<Array<string>>(['todos'])\n\n      queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n        ...(old ?? []),\n        newTodo,\n      ])\n\n      // Passed to `onError` as `onMutateResult` if the mutation fails.\n      return { previousTodos }\n    },\n    onError: (_err, _newTodo, onMutateResult) => {\n      queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n    },\n    onSettled: () => {\n      queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n</script>\n\n<button onclick={() => addMutation.mutate('Item')}>Add</button>","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"Callbacks passed per call to "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" only fire for the last call — "},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" gives you a\npromise per call instead, so you can wait for all of them when they succeed:"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    try {\n      await Promise.all(todos.map((todo) => addMutation.mutateAsync(todo)))\n    } catch (error) {\n      console.error('Failed to add todos:', error)\n    }\n  }\n</script>\n\n<button onclick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n  Add all\n</button>","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"If some of the mutations above can fail independently of the others, and you want to know which ones\ndid — rather than losing that information the moment the first one rejects — swap "},{"type":"inlineCode","value":"Promise.all"},{"type":"text","value":" for\n"},{"type":"inlineCode","value":"Promise.allSettled"},{"type":"text","value":":"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    const addResults = await Promise.allSettled(\n      todos.map((todo) => addMutation.mutateAsync(todo)),\n    )\n\n    addResults.forEach((addResult, index) => {\n      if (addResult.status === 'rejected') {\n        console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n      }\n    })\n  }\n</script>\n\n<button onclick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n  Add all\n</button>","lang":"svelte"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tvariables","text":"TVariables","level":3},{"id":"tcontext","text":"TContext","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"result-properties","text":"Result properties","level":3},{"id":"see","text":"See","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createMutation<TData, TError, TVariables, TContext>(options: Accessor<CreateMutationOptions<TData, TError, TVariables, TContext>>, queryClient?: Accessor<QueryClient>): CreateMutationResult<TData, TError, TVariables, TContext>;\n```\n\nDefined in: [packages/svelte-query/src/createMutation.svelte.ts:165](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/createMutation.svelte.ts#L165)\n\nUnlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n`createMutation` is the function for that.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TContext\n\n`TContext` = `unknown`\n\n## Parameters\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TContext`\\>\\>\n\nThe [CreateMutationOptions](../type-aliases/CreateMutationOptions.md) to use, wrapped in an [Accessor](../type-aliases/Accessor.md) so options can be\nreactive.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationObserverOptions`](../interfaces/MutationObserverOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n[`CreateMutationResult`](../type-aliases/CreateMutationResult.md)\\<`TData`, `TError`, `TVariables`, `TContext`\\>\n\n`mutate`/`mutateAsync` also accept per-call `onSuccess`/`onError`/`onSettled` callbacks as a second\nargument, useful for triggering call-site side effects (e.g. navigation) without coupling them to the shared\nmutation definition. If you make multiple requests, `onSuccess` will fire only after the latest call you've\nmade.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`MutationObserverBaseResult`](../interfaces/MutationObserverBaseResult.md#properties). See the type above for what it changes.\n\n## See\n\n[mutationOptions](mutationOptions.md) to share these options across multiple `createMutation` call sites, or to look\nthe mutation up elsewhere via its `mutationKey` (e.g. with `useMutationState`).\n\n## Examples\n\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n</script>\n\n<button\n  onclick={() =>\n    addMutation.mutate('Item', {\n      onError: (error) => console.error('Failed to add item:', error),\n    })\n  }\n>\n  Add\n</button>\n```\n\nRendering the mutation's own state, rather than just firing it off:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n</script>\n\n{#if addMutation.isPending}\n  Adding todo...\n{:else}\n  {#if addMutation.isError}\n    <div>An error occurred: {addMutation.error.message}</div>\n  {/if}\n  <button onclick={() => addMutation.mutate('Item')}>Add</button>\n{/if}\n```\n\nOptimistic update via `onMutate`, rolling back on `onError`:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onMutate: async (newTodo: string) => {\n      await queryClient.cancelQueries({ queryKey: ['todos'] })\n      const previousTodos = queryClient.getQueryData<Array<string>>(['todos'])\n\n      queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n        ...(old ?? []),\n        newTodo,\n      ])\n\n      // Passed to `onError` as `onMutateResult` if the mutation fails.\n      return { previousTodos }\n    },\n    onError: (_err, _newTodo, onMutateResult) => {\n      queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n    },\n    onSettled: () => {\n      queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n</script>\n\n<button onclick={() => addMutation.mutate('Item')}>Add</button>\n```\n\nCallbacks passed per call to `mutate` only fire for the last call — `mutateAsync` gives you a\npromise per call instead, so you can wait for all of them when they succeed:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    try {\n      await Promise.all(todos.map((todo) => addMutation.mutateAsync(todo)))\n    } catch (error) {\n      console.error('Failed to add todos:', error)\n    }\n  }\n</script>\n\n<button onclick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n  Add all\n</button>\n```\n\nIf some of the mutations above can fail independently of the others, and you want to know which ones\ndid — rather than losing that information the moment the first one rejects — swap `Promise.all` for\n`Promise.allSettled`:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    const addResults = await Promise.allSettled(\n      todos.map((todo) => addMutation.mutateAsync(todo)),\n    )\n\n    addResults.forEach((addResult, index) => {\n      if (addResult.status === 'rejected') {\n        console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n      }\n    })\n  }\n</script>\n\n<button onclick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n  Add all\n</button>\n```\n","originalRawMarkdown":"---\nid: createMutation\ntitle: createMutation\n---\n\n```ts\nfunction createMutation<TData, TError, TVariables, TContext>(options: Accessor<CreateMutationOptions<TData, TError, TVariables, TContext>>, queryClient?: Accessor<QueryClient>): CreateMutationResult<TData, TError, TVariables, TContext>;\n```\n\nDefined in: [packages/svelte-query/src/createMutation.svelte.ts:165](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/createMutation.svelte.ts#L165)\n\nUnlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n`createMutation` is the function for that.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TContext\n\n`TContext` = `unknown`\n\n## Parameters\n\n### options\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TContext`\\>\\>\n\nThe [CreateMutationOptions](../type-aliases/CreateMutationOptions.md) to use, wrapped in an [Accessor](../type-aliases/Accessor.md) so options can be\nreactive.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationObserverOptions`](../interfaces/MutationObserverOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n[`CreateMutationResult`](../type-aliases/CreateMutationResult.md)\\<`TData`, `TError`, `TVariables`, `TContext`\\>\n\n`mutate`/`mutateAsync` also accept per-call `onSuccess`/`onError`/`onSettled` callbacks as a second\nargument, useful for triggering call-site side effects (e.g. navigation) without coupling them to the shared\nmutation definition. If you make multiple requests, `onSuccess` will fire only after the latest call you've\nmade.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`MutationObserverBaseResult`](../interfaces/MutationObserverBaseResult.md#properties). See the type above for what it changes.\n\n## See\n\n[mutationOptions](mutationOptions.md) to share these options across multiple `createMutation` call sites, or to look\nthe mutation up elsewhere via its `mutationKey` (e.g. with `useMutationState`).\n\n## Examples\n\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n</script>\n\n<button\n  onclick={() =>\n    addMutation.mutate('Item', {\n      onError: (error) => console.error('Failed to add item:', error),\n    })\n  }\n>\n  Add\n</button>\n```\n\nRendering the mutation's own state, rather than just firing it off:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n</script>\n\n{#if addMutation.isPending}\n  Adding todo...\n{:else}\n  {#if addMutation.isError}\n    <div>An error occurred: {addMutation.error.message}</div>\n  {/if}\n  <button onclick={() => addMutation.mutate('Item')}>Add</button>\n{/if}\n```\n\nOptimistic update via `onMutate`, rolling back on `onError`:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onMutate: async (newTodo: string) => {\n      await queryClient.cancelQueries({ queryKey: ['todos'] })\n      const previousTodos = queryClient.getQueryData<Array<string>>(['todos'])\n\n      queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n        ...(old ?? []),\n        newTodo,\n      ])\n\n      // Passed to `onError` as `onMutateResult` if the mutation fails.\n      return { previousTodos }\n    },\n    onError: (_err, _newTodo, onMutateResult) => {\n      queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n    },\n    onSettled: () => {\n      queryClient.invalidateQueries({ queryKey: ['todos'] })\n    },\n  }))\n</script>\n\n<button onclick={() => addMutation.mutate('Item')}>Add</button>\n```\n\nCallbacks passed per call to `mutate` only fire for the last call — `mutateAsync` gives you a\npromise per call instead, so you can wait for all of them when they succeed:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    try {\n      await Promise.all(todos.map((todo) => addMutation.mutateAsync(todo)))\n    } catch (error) {\n      console.error('Failed to add todos:', error)\n    }\n  }\n</script>\n\n<button onclick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n  Add all\n</button>\n```\n\nIf some of the mutations above can fail independently of the others, and you want to know which ones\ndid — rather than losing that information the moment the first one rejects — swap `Promise.all` for\n`Promise.allSettled`:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useQueryClient } from '@tanstack/svelte-query'\n\n  const queryClient = useQueryClient()\n\n  const addMutation = createMutation(() => ({\n    mutationFn: addTodo,\n    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n  }))\n\n  async function handleAddAll(todos: Array<string>) {\n    const addResults = await Promise.allSettled(\n      todos.map((todo) => addMutation.mutateAsync(todo)),\n    )\n\n    addResults.forEach((addResult, index) => {\n      if (addResult.status === 'rejected') {\n        console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n      }\n    })\n  }\n</script>\n\n<button onclick={() => handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])}>\n  Add all\n</button>\n```\n"}
