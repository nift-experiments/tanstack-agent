:"<...>] : ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [..., "},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] ? ... "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] : { [K in string | number | symbol]: GetCreateQueryResult<T[K]> }) => "},{"type":"inlineCode","value":"TCombinedResult"},{"type":"text","value":";\n"},{"type":"inlineCode","value":"queries"},{"type":"text","value":":   | readonly ["},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetCreateQueryOptionsForCreateQueries"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Head"},{"type":"text","value":">] : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":", "},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [] ? [] : ["},{"type":"inlineCode","value":"...Tails[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"Head"},{"type":"text","value":"] ? ["},{"type":"inlineCode","value":"GetCreateQueryOptionsForCreateQueries"},{"type":"text","value":"<...>, "},{"type":"inlineCode","value":"GetCreateQueryOptionsForCreateQueries"},{"type":"text","value":"<...>] : ["},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" [..., "},{"type":"inlineCode","value":"...(...)[]"},{"type":"text","value":"] ? ... "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : ... "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"T"},{"type":"text","value":" ? "},{"type":"inlineCode","value":"T"},{"type":"text","value":" : "},{"type":"inlineCode","value":"T"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"CreateQueryOptionsForCreateQueries"},{"type":"text","value":"<..., ..., ..., ...>[] ? "},{"type":"inlineCode","value":"CreateQueryOptionsForCreateQueries"},{"type":"text","value":"<..., ..., ..., ...>[] : "},{"type":"inlineCode","value":"CreateQueryOptionsForCreateQueries"},{"type":"text","value":"<..., ..., ..., ...>[]]\n| readonly [{ [K in string | number | symbol]: GetCreateQueryOptionsForCreateQueries<T[K]> }];\n}>"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"queries"},{"type":"text","value":" array to run, and an optional "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" function, wrapped in an\n"},{"type":"link","href":"../type-aliases/Accessor.md","children":[{"type":"text","value":"Accessor"}]},{"type":"text","value":" so options can be reactive."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Accessor.md","children":[{"type":"inlineCode","value":"Accessor"}]},{"type":"text","value":"<"},{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context\nwill be used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCombinedResult"}]},{"type":"paragraph","children":[{"type":"text","value":"An array with one result per query, in the same order as "},{"type":"inlineCode","value":"queries"},{"type":"text","value":" — or, if "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" is provided,\nwhatever "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" returns."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createQueries } from '@tanstack/svelte-query'\n\n  let { ids }: { ids: Array<number> } = $props()\n\n  const postQueries = createQueries(() => ({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n      staleTime: Infinity,\n    })),\n  }))\n</script>\n\n<ul>\n  {#each postQueries as query, index (ids[index])}\n    {#if query.isPending}\n      <li>Loading...</li>\n    {:else if query.isError}\n      <li>Error: {query.error.message}</li>\n    {:else}\n      <li>{query.data.title}</li>\n    {/if}\n  {/each}\n</ul>","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"Combining results into a single value:"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createQueries } from '@tanstack/svelte-query'\n\n  let { ids }: { ids: Array<number> } = $props()\n\n  const combined = createQueries(() => ({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n    combine: (postQueries) => ({\n      data: postQueries.map((query) => query.data),\n      isPending: postQueries.some((query) => query.isPending),\n      isError: postQueries.some((query) => query.isError),\n    }),\n  }))\n</script>\n\n{#if combined.isPending}\n  Loading...\n{:else if combined.isError}\n  Error loading posts\n{:else}\n  <ul>\n    {#each combined.data as post}\n      <li>{post?.title}</li>\n    {/each}\n  </ul>\n{/if}","lang":"svelte"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"tcombinedresult","text":"TCombinedResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"createqueriesoptions","text":"createQueriesOptions","level":3},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createQueries<T, TCombinedResult>(createQueriesOptions: Accessor<{\n  combine?: (result: T extends [] ? [] : T extends [Head] ? [GetCreateQueryResult<Head>] : T extends [Head, ...Tails[]] ? [...Tails[]] extends [] ? [] : [...Tails[]] extends [Head] ? [GetCreateQueryResult<...>, GetCreateQueryResult<...>] : [...(...)[]] extends [..., ...(...)[]] ? ... extends ... ? ... : ... : [...(...)[]] : { [K in string | number | symbol]: GetCreateQueryResult<T[K]> }) => TCombinedResult;\n  queries:   | readonly [T extends [] ? [] : T extends [Head] ? [GetCreateQueryOptionsForCreateQueries<Head>] : T extends [Head, ...Tails[]] ? [...Tails[]] extends [] ? [] : [...Tails[]] extends [Head] ? [GetCreateQueryOptionsForCreateQueries<...>, GetCreateQueryOptionsForCreateQueries<...>] : [...(...)[]] extends [..., ...(...)[]] ? ... extends ... ? ... : ... : ... extends ... ? ... : ... : readonly unknown[] extends T ? T : T extends CreateQueryOptionsForCreateQueries<..., ..., ..., ...>[] ? CreateQueryOptionsForCreateQueries<..., ..., ..., ...>[] : CreateQueryOptionsForCreateQueries<..., ..., ..., ...>[]]\n     | readonly [{ [K in string | number | symbol]: GetCreateQueryOptionsForCreateQueries<T[K]> }];\n}>, queryClient?: Accessor<QueryClient>): TCombinedResult;\n```\n\nDefined in: [packages/svelte-query/src/createQueries.svelte.ts:259](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/createQueries.svelte.ts#L259)\n\nThe `createQueries` function can be used to fetch a variable number of queries.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `any`[]\n\n### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<`Head`\\>, `GetCreateQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<`Head`\\>, `GetCreateQueryResult`\\<`Head`\\>, `GetCreateQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetCreateQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetCreateQueryResult\\<T\\[K\\]\\> \\}\n\n## Parameters\n\n### createQueriesOptions\n\n[`Accessor`](../type-aliases/Accessor.md)\\<\\{\n  `combine?`: (`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<...\\>, `GetCreateQueryResult`\\<...\\>\\] : \\[`...(...)[]`\\] *extends* \\[..., `...(...)[]`\\] ? ... *extends* ... ? ... : ... : \\[`...(...)[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetCreateQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`;\n  `queries`:   \\| readonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetCreateQueryOptionsForCreateQueries`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetCreateQueryOptionsForCreateQueries`\\<...\\>, `GetCreateQueryOptionsForCreateQueries`\\<...\\>\\] : \\[`...(...)[]`\\] *extends* \\[..., `...(...)[]`\\] ? ... *extends* ... ? ... : ... : ... *extends* ... ? ... : ... : readonly `unknown`[] *extends* `T` ? `T` : `T` *extends* `CreateQueryOptionsForCreateQueries`\\<..., ..., ..., ...\\>[] ? `CreateQueryOptionsForCreateQueries`\\<..., ..., ..., ...\\>[] : `CreateQueryOptionsForCreateQueries`\\<..., ..., ..., ...\\>[]\\]\n     \\| readonly \\[\\{ \\[K in string \\| number \\| symbol\\]: GetCreateQueryOptionsForCreateQueries\\<T\\[K\\]\\> \\}\\];\n\\}\\>\n\nThe `queries` array to run, and an optional `combine` function, wrapped in an\n[Accessor](../type-aliases/Accessor.md) so options can be reactive.\n\n### queryClient?\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n## Returns\n\n`TCombinedResult`\n\nAn array with one result per query, in the same order as `queries` — or, if `combine` is provided,\nwhatever `combine` returns.\n\n## Examples\n\n```svelte\n<script lang=\"ts\">\n  import { createQueries } from '@tanstack/svelte-query'\n\n  let { ids }: { ids: Array<number> } = $props()\n\n  const postQueries = createQueries(() => ({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n      staleTime: Infinity,\n    })),\n  }))\n</script>\n\n<ul>\n  {#each postQueries as query, index (ids[index])}\n    {#if query.isPending}\n      <li>Loading...</li>\n    {:else if query.isError}\n      <li>Error: {query.error.message}</li>\n    {:else}\n      <li>{query.data.title}</li>\n    {/if}\n  {/each}\n</ul>\n```\n\nCombining results into a single value:\n```svelte\n<script lang=\"ts\">\n  import { createQueries } from '@tanstack/svelte-query'\n\n  let { ids }: { ids: Array<number> } = $props()\n\n  const combined = createQueries(() => ({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n    combine: (postQueries) => ({\n      data: postQueries.map((query) => query.data),\n      isPending: postQueries.some((query) => query.isPending),\n      isError: postQueries.some((query) => query.isError),\n    }),\n  }))\n</script>\n\n{#if combined.isPending}\n  Loading...\n{:else if combined.isError}\n  Error loading posts\n{:else}\n  <ul>\n    {#each combined.data as post}\n      <li>{post?.title}</li>\n    {/each}\n  </ul>\n{/if}\n```\n","originalRawMarkdown":"---\nid: createQueries\ntitle: createQueries\n---\n\n```ts\nfunction createQueries<T, TCombinedResult>(createQueriesOptions: Accessor<{\n  combine?: (result: T extends [] ? [] : T extends [Head] ? [GetCreateQueryResult<Head>] : T extends [Head, ...Tails[]] ? [...Tails[]] extends [] ? [] : [...Tails[]] extends [Head] ? [GetCreateQueryResult<...>, GetCreateQueryResult<...>] : [...(...)[]] extends [..., ...(...)[]] ? ... extends ... ? ... : ... : [...(...)[]] : { [K in string | number | symbol]: GetCreateQueryResult<T[K]> }) => TCombinedResult;\n  queries:   | readonly [T extends [] ? [] : T extends [Head] ? [GetCreateQueryOptionsForCreateQueries<Head>] : T extends [Head, ...Tails[]] ? [...Tails[]] extends [] ? [] : [...Tails[]] extends [Head] ? [GetCreateQueryOptionsForCreateQueries<...>, GetCreateQueryOptionsForCreateQueries<...>] : [...(...)[]] extends [..., ...(...)[]] ? ... extends ... ? ... : ... : ... extends ... ? ... : ... : readonly unknown[] extends T ? T : T extends CreateQueryOptionsForCreateQueries<..., ..., ..., ...>[] ? CreateQueryOptionsForCreateQueries<..., ..., ..., ...>[] : CreateQueryOptionsForCreateQueries<..., ..., ..., ...>[]]\n     | readonly [{ [K in string | number | symbol]: GetCreateQueryOptionsForCreateQueries<T[K]> }];\n}>, queryClient?: Accessor<QueryClient>): TCombinedResult;\n```\n\nDefined in: [packages/svelte-query/src/createQueries.svelte.ts:259](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/createQueries.svelte.ts#L259)\n\nThe `createQueries` function can be used to fetch a variable number of queries.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `any`[]\n\n### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<`Head`\\>, `GetCreateQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<`Head`\\>, `GetCreateQueryResult`\\<`Head`\\>, `GetCreateQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetCreateQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetCreateQueryResult\\<T\\[K\\]\\> \\}\n\n## Parameters\n\n### createQueriesOptions\n\n[`Accessor`](../type-aliases/Accessor.md)\\<\\{\n  `combine?`: (`result`: `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetCreateQueryResult`\\<...\\>, `GetCreateQueryResult`\\<...\\>\\] : \\[`...(...)[]`\\] *extends* \\[..., `...(...)[]`\\] ? ... *extends* ... ? ... : ... : \\[`...(...)[]`\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetCreateQueryResult\\<T\\[K\\]\\> \\}) => `TCombinedResult`;\n  `queries`:   \\| readonly \\[`T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetCreateQueryOptionsForCreateQueries`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetCreateQueryOptionsForCreateQueries`\\<...\\>, `GetCreateQueryOptionsForCreateQueries`\\<...\\>\\] : \\[`...(...)[]`\\] *extends* \\[..., `...(...)[]`\\] ? ... *extends* ... ? ... : ... : ... *extends* ... ? ... : ... : readonly `unknown`[] *extends* `T` ? `T` : `T` *extends* `CreateQueryOptionsForCreateQueries`\\<..., ..., ..., ...\\>[] ? `CreateQueryOptionsForCreateQueries`\\<..., ..., ..., ...\\>[] : `CreateQueryOptionsForCreateQueries`\\<..., ..., ..., ...\\>[]\\]\n     \\| readonly \\[\\{ \\[K in string \\| number \\| symbol\\]: GetCreateQueryOptionsForCreateQueries\\<T\\[K\\]\\> \\}\\];\n\\}\\>\n\nThe `queries` array to run, and an optional `combine` function, wrapped in an\n[Accessor](../type-aliases/Accessor.md) so options can be reactive.\n\n### queryClient?\n\n[`Accessor`](../type-aliases/Accessor.md)\\<[`QueryClient`](../classes/QueryClient.md)\\>\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context\nwill be used.\n\n## Returns\n\n`TCombinedResult`\n\nAn array with one result per query, in the same order as `queries` — or, if `combine` is provided,\nwhatever `combine` returns.\n\n## Examples\n\n```svelte\n<script lang=\"ts\">\n  import { createQueries } from '@tanstack/svelte-query'\n\n  let { ids }: { ids: Array<number> } = $props()\n\n  const postQueries = createQueries(() => ({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n      staleTime: Infinity,\n    })),\n  }))\n</script>\n\n<ul>\n  {#each postQueries as query, index (ids[index])}\n    {#if query.isPending}\n      <li>Loading...</li>\n    {:else if query.isError}\n      <li>Error: {query.error.message}</li>\n    {:else}\n      <li>{query.data.title}</li>\n    {/if}\n  {/each}\n</ul>\n```\n\nCombining results into a single value:\n```svelte\n<script lang=\"ts\">\n  import { createQueries } from '@tanstack/svelte-query'\n\n  let { ids }: { ids: Array<number> } = $props()\n\n  const combined = createQueries(() => ({\n    queries: ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n    combine: (postQueries) => ({\n      data: postQueries.map((query) => query.data),\n      isPending: postQueries.some((query) => query.isPending),\n      isError: postQueries.some((query) => query.isError),\n    }),\n  }))\n</script>\n\n{#if combined.isPending}\n  Loading...\n{:else if combined.isError}\n  Error loading posts\n{:else}\n  <ul>\n    {#each combined.data as post}\n      <li>{post?.title}</li>\n    {/each}\n  </ul>\n{/if}\n```\n"}
