ype":"inlineCode","value":"WithRequired"}]},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateMutationOptions.md","children":[{"type":"inlineCode","value":"CreateMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object."}]},{"type":"heading","depth":3,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"createMutation.md","children":[{"type":"text","value":"createMutation"}]},{"type":"text","value":" to run a mutation with these options."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"Looking the mutation up elsewhere via its "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":", e.g. for a global \"saving…\" indicator:"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { mutationOptions, useMutationState } from '@tanstack/svelte-query'\n\n  const createPostOptions = mutationOptions({\n    mutationKey: ['posts', 'create'],\n    mutationFn: createPost,\n  })\n\n  const pending = useMutationState({\n    filters: { mutationKey: createPostOptions.mutationKey, status: 'pending' },\n  })\n</script>\n\n{#if pending.length > 0}\n  <span>Saving…</span>\n{/if}","lang":"svelte"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<