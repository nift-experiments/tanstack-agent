ptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateMutationOptions.md","children":[{"type":"inlineCode","value":"CreateMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The options to use — everything you can pass to "},{"type":"inlineCode","value":"createMutation"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateMutationOptions.md","children":[{"type":"inlineCode","value":"CreateMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object."}]},{"type":"heading","depth":3,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"createMutation.md","children":[{"type":"text","value":"createMutation"}]},{"type":"text","value":" to run a mutation with these options."}]},{"type":"heading","depth":3,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { mutationOptions, createMutation } from '@tanstack/svelte-query'\n\n  const createPostOptions = mutationOptions({\n    mutationFn: createPost,\n  })\n\n  const mutation = createMutation(() => createPostOptions)\n</script>\n\n<button onclick={() => mutation.mutate({ title: 'Hello' })}>Create</button>","lang":"svelte"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-3","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateMutationOptions.md","children":[{"type":"inlineCode","value":"CreateMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The options to use — everything you can pass to "},{"type":"inlineCode","value":"createMutation"},{"type":"text","value":"."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/MutationObserverOptions.md#properties","children":[{"type":"inlineCode","value":"MutationObserverOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/CreateMutationOptions.md","children":[{"type":"inlineCode","value":"CreateMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"mutationKey\""},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object."}]},{"type":"html","value":"<a id=\"result-properties\"></a>"},{"type":"heading","depth":3,"id":"result-properties","children":[{"type":"text","value":"Result properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/MutationObserverOptions.md#properties","children":[{"type":"inlineCode","value":"MutationObserverOptions"}]},{"type":"text","value":". See the type above for what it changes."}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tdata","text":"TData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tvariables","text":"TVariables","level":4},{"id":"tonmutateresult","text":"TOnMutateResult","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"returns","text":"Returns","level":3},{"id":"see","text":"See","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tdata-2","text":"TData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tvariables-2","text":"TVariables","level":4},{"id":"tonmutateresult-2","text":"TOnMutateResult","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"see-2","text":"See","level":3},{"id":"example-2","text":"Example","level":3},{"id":"parameters-3","text":"Parameters","level":2},{"id":"options-3","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"returns-3","text":"Returns","level":2},{"id":"result-properties","text":"Result properties","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: WithRequired<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): WithRequired<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\n- [`WithRequired<CreateMutationOptions>` → `WithRequired<CreateMutationOptions>`](#call-signature-1): You can generally pass everything to `mutationOptions` that you can also pass to `createMutation`. This overload requires `mutationKey`, so the resulting options can be looked up elsewhere (e.g. with `useMutationState`).\n- [`Omit<CreateMutationOptions>` → `Omit<CreateMutationOptions>`](#call-signature-2): You can generally pass everything to `mutationOptions` that you can also pass to `createMutation`.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: WithRequired<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): WithRequired<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\nDefined in: [packages/svelte-query/src/mutationOptions.ts:32](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/mutationOptions.ts#L32)\n\nYou can generally pass everything to `mutationOptions` that you can also pass to `createMutation`. This\noverload requires `mutationKey`, so the resulting options can be looked up elsewhere (e.g. with\n`useMutationState`).\n\n### Type Parameters\n\n#### TData\n\n`TData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TVariables\n\n`TVariables` = `void`\n\n#### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n### Parameters\n\n#### options\n\n[`WithRequired`](../type-aliases/WithRequired.md)\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe options to use — everything you can pass to `createMutation`, with `mutationKey` set.\n\n### Returns\n\n[`WithRequired`](../type-aliases/WithRequired.md)\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object.\n\n### See\n\n[createMutation](createMutation.md) to run a mutation with these options.\n\n### Example\n\nLooking the mutation up elsewhere via its `mutationKey`, e.g. for a global \"saving…\" indicator:\n```svelte\n<script lang=\"ts\">\n  import { mutationOptions, useMutationState } from '@tanstack/svelte-query'\n\n  const createPostOptions = mutationOptions({\n    mutationKey: ['posts', 'create'],\n    mutationFn: createPost,\n  })\n\n  const pending = useMutationState({\n    filters: { mutationKey: createPostOptions.mutationKey, status: 'pending' },\n  })\n</script>\n\n{#if pending.length > 0}\n  <span>Saving…</span>\n{/if}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\nDefined in: [packages/svelte-query/src/mutationOptions.ts:67](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/mutationOptions.ts#L67)\n\nYou can generally pass everything to `mutationOptions` that you can also pass to `createMutation`.\n\n### Type Parameters\n\n#### TData\n\n`TData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TVariables\n\n`TVariables` = `void`\n\n#### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n### Parameters\n\n#### options\n\n`Omit`\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe options to use — everything you can pass to `createMutation`.\n\n### Returns\n\n`Omit`\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object.\n\n### See\n\n[createMutation](createMutation.md) to run a mutation with these options.\n\n### Example\n\n```svelte\n<script lang=\"ts\">\n  import { mutationOptions, createMutation } from '@tanstack/svelte-query'\n\n  const createPostOptions = mutationOptions({\n    mutationFn: createPost,\n  })\n\n  const mutation = createMutation(() => createPostOptions)\n</script>\n\n<button onclick={() => mutation.mutate({ title: 'Hello' })}>Create</button>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n`Omit`\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe options to use — everything you can pass to `createMutation`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationObserverOptions`](../interfaces/MutationObserverOptions.md#properties). See the type above for what it changes.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n`Omit`\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`MutationObserverOptions`](../interfaces/MutationObserverOptions.md#properties). See the type above for what it changes.\n","originalRawMarkdown":"---\nid: mutationOptions\ntitle: mutationOptions\n---\n\n## Overview\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: WithRequired<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): WithRequired<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\n- [`WithRequired<CreateMutationOptions>` → `WithRequired<CreateMutationOptions>`](#call-signature-1): You can generally pass everything to `mutationOptions` that you can also pass to `createMutation`. This overload requires `mutationKey`, so the resulting options can be looked up elsewhere (e.g. with `useMutationState`).\n- [`Omit<CreateMutationOptions>` → `Omit<CreateMutationOptions>`](#call-signature-2): You can generally pass everything to `mutationOptions` that you can also pass to `createMutation`.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: WithRequired<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): WithRequired<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\nDefined in: [packages/svelte-query/src/mutationOptions.ts:32](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/mutationOptions.ts#L32)\n\nYou can generally pass everything to `mutationOptions` that you can also pass to `createMutation`. This\noverload requires `mutationKey`, so the resulting options can be looked up elsewhere (e.g. with\n`useMutationState`).\n\n### Type Parameters\n\n#### TData\n\n`TData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TVariables\n\n`TVariables` = `void`\n\n#### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n### Parameters\n\n#### options\n\n[`WithRequired`](../type-aliases/WithRequired.md)\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe options to use — everything you can pass to `createMutation`, with `mutationKey` set.\n\n### Returns\n\n[`WithRequired`](../type-aliases/WithRequired.md)\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object.\n\n### See\n\n[createMutation](createMutation.md) to run a mutation with these options.\n\n### Example\n\nLooking the mutation up elsewhere via its `mutationKey`, e.g. for a global \"saving…\" indicator:\n```svelte\n<script lang=\"ts\">\n  import { mutationOptions, useMutationState } from '@tanstack/svelte-query'\n\n  const createPostOptions = mutationOptions({\n    mutationKey: ['posts', 'create'],\n    mutationFn: createPost,\n  })\n\n  const pending = useMutationState({\n    filters: { mutationKey: createPostOptions.mutationKey, status: 'pending' },\n  })\n</script>\n\n{#if pending.length > 0}\n  <span>Saving…</span>\n{/if}\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction mutationOptions<TData, TError, TVariables, TOnMutateResult>(options: Omit<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">): Omit<CreateMutationOptions<TData, TError, TVariables, TOnMutateResult>, \"mutationKey\">;\n```\n\nDefined in: [packages/svelte-query/src/mutationOptions.ts:67](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/mutationOptions.ts#L67)\n\nYou can generally pass everything to `mutationOptions` that you can also pass to `createMutation`.\n\n### Type Parameters\n\n#### TData\n\n`TData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TVariables\n\n`TVariables` = `void`\n\n#### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n### Parameters\n\n#### options\n\n`Omit`\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe options to use — everything you can pass to `createMutation`.\n\n### Returns\n\n`Omit`\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object.\n\n### See\n\n[createMutation](createMutation.md) to run a mutation with these options.\n\n### Example\n\n```svelte\n<script lang=\"ts\">\n  import { mutationOptions, createMutation } from '@tanstack/svelte-query'\n\n  const createPostOptions = mutationOptions({\n    mutationFn: createPost,\n  })\n\n  const mutation = createMutation(() => createPostOptions)\n</script>\n\n<button onclick={() => mutation.mutate({ title: 'Hello' })}>Create</button>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n`Omit`\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe options to use — everything you can pass to `createMutation`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationObserverOptions`](../interfaces/MutationObserverOptions.md#properties). See the type above for what it changes.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n`Omit`\\<[`CreateMutationOptions`](../type-aliases/CreateMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>, `\"mutationKey\"`\\>\n\nThe same options object.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`MutationObserverOptions`](../interfaces/MutationObserverOptions.md#properties). See the type above for what it changes.\n"}
