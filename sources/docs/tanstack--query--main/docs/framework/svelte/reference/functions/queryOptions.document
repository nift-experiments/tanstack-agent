alue":"queryOptions"},{"type":"text","value":" that you can also pass to "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":". These options can be shared across "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":" calls and imperative APIs such as "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":". "},{"type":"inlineCode","value":"options.queryKey"},{"type":"text","value":" is required and is the query key to generate options for."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"See also: "},{"type":"link","href":"#parameters-summary","children":[{"type":"text","value":"Parameters"}]},{"type":"text","value":" · "},{"type":"link","href":"#returns-summary","children":[{"type":"text","value":"Returns"}]}]},{"type":"html","value":"<a id=\"call-signature-1\"></a>"},{"type":"heading","depth":2,"id":"call-signature","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/svelte-query/src/queryOptions.ts#L77","children":[{"type":"text","value":"packages/svelte-query/src/queryOptions.ts:77"}]}]},{"type":"paragraph","children":[{"type":"text","value":"You can generally pass everything to "},{"type":"inlineCode","value":"queryOptions"},{"type":"text","value":" that you can also pass to "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":". These options\ncan be shared across "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":" calls and imperative APIs such as "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":". "},{"type":"inlineCode","value":"options.queryKey"},{"type":"text","value":"\nis required and is the query key to generate options for."}]},{"type":"paragraph","children":[{"type":"text","value":"This overload is selected when "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" is set, so the resulting "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is never "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" (unless\na "},{"type":"inlineCode","value":"select"},{"type":"text","value":" changes "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" to include "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":")."}]},{"type":"heading","depth":3,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"tquerykey","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/DefinedInitialDataOptions.md","children":[{"type":"inlineCode","value":"DefinedInitialDataOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/DefinedInitialDataOptions.md","children":[{"type":"text","value":"DefinedInitialDataOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":",\nwith "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" set."}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/DefinedInitialDataOptions.md","children":[{"type":"inlineCode","value":"DefinedInitialDataOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":"> & "},{"type":"link","href":"../type-aliases/QueryKeyWithDataTag.md","children":[{"type":"inlineCode","value":"QueryKeyWithDataTag"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred data type."}]},{"type":"heading","depth":3,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"createQuery.md","children":[{"type":"text","value":"createQuery"}]},{"type":"text","value":" to run a query with these options."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { queryOptions, createQuery } from '@tanstack/svelte-query'\n\n  const postsOptions = queryOptions({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    initialData: [],\n  })\n\n  // `data` is `Post[]`, never `undefined`, thanks to `initialData` — even if a refetch fails,\n  // so the list stays visible alongside the error.\n  const query = createQuery(() => postsOptions)\n</script>\n\n{#if query.isError}\n  <span>Error: {query.error.message}</span>\n{/if}\n<ul>\n  {#each query.data as post (post.id)}\n    <li>{post.title}</li>\n  {/each}\n</ul>","lang":"svelte"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/svelte-query/src/queryOptions.ts#L120","children":[{"type":"text","value":"packages/svelte-query/src/queryOptions.ts:120"}]}]},{"type":"paragraph","children":[{"type":"text","value":"You can generally pass everything to "},{"type":"inlineCode","value":"queryOptions"},{"type":"text","value":" that you can also pass to "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":". These options\ncan be shared across "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":" calls and imperative APIs such as "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":". "},{"type":"inlineCode","value":"options.queryKey"},{"type":"text","value":"\nis required and is the query key to generate options for."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-2","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"terror-2","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-2","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"tquerykey-2","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options-2","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UndefinedInitialDataOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/UndefinedInitialDataOptions.md","children":[{"type":"text","value":"UndefinedInitialDataOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UndefinedInitialDataOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":"> & "},{"type":"link","href":"../type-aliases/QueryKeyWithDataTag.md","children":[{"type":"inlineCode","value":"QueryKeyWithDataTag"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred data type."}]},{"type":"heading","depth":3,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"createQuery.md","children":[{"type":"text","value":"createQuery"}]},{"type":"text","value":" to run a query with these options."}]},{"type":"heading","depth":3,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"A parameterized factory, so the same options object can be reused per "},{"type":"inlineCode","value":"id"},{"type":"text","value":":"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { queryOptions, createQuery } from '@tanstack/svelte-query'\n\n  let { id }: { id: string } = $props()\n\n  const postOptions = (id: string) =>\n    queryOptions({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })\n\n  const query = createQuery(() => postOptions(id))\n</script>\n\n{#if query.isPending}\n  Loading...\n{:else if query.isError}\n  <span>Error: {query.error.message}</span>\n{:else}\n  <h1>{query.data.title}</h1>\n{/if}","lang":"svelte"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-3","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UndefinedInitialDataOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/UndefinedInitialDataOptions.md","children":[{"type":"text","value":"UndefinedInitialDataOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"createQuery"},{"type":"text","value":"."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/QueryObserverOptions.md#properties","children":[{"type":"inlineCode","value":"QueryObserverOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UndefinedInitialDataOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":"> & "},{"type":"link","href":"../type-aliases/QueryKeyWithDataTag.md","children":[{"type":"inlineCode","value":"QueryKeyWithDataTag"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred data type."}]},{"type":"html","value":"<a id=\"result-properties\"></a>"},{"type":"heading","depth":3,"id":"result-properties","children":[{"type":"text","value":"Result properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../interfaces/QueryObserverOptions.md#properties","children":[{"type":"inlineCode","value":"QueryObserverOptions"}]},{"type":"text","value":", "},{"type":"link","href":"../type-aliases/QueryKeyWithDataTag.md#properties","children":[{"type":"inlineCode","value":"QueryKeyWithDataTag"}]},{"type":"text","value":". See the type above for what it changes."}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tqueryfndata","text":"TQueryFnData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tdata","text":"TData","level":4},{"id":"tquerykey","text":"TQueryKey","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"returns","text":"Returns","level":3},{"id":"see","text":"See","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tqueryfndata-2","text":"TQueryFnData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tdata-2","text":"TData","level":4},{"id":"tquerykey-2","text":"TQueryKey","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"see-2","text":"See","level":3},{"id":"example-2","text":"Example","level":3},{"id":"parameters-3","text":"Parameters","level":2},{"id":"options-3","text":"options","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"returns-3","text":"Returns","level":2},{"id":"result-properties","text":"Result properties","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;\n```\n\n- [`DefinedInitialDataOptions` → `DefinedInitialDataOptions & QueryKeyWithDataTag`](#call-signature-1): You can generally pass everything to `queryOptions` that you can also pass to `createQuery`. These options can be shared across `createQuery` calls and imperative APIs such as `queryClient.query`. `options.queryKey` is required and is the query key to generate options for.\n- [`UndefinedInitialDataOptions` → `UndefinedInitialDataOptions & QueryKeyWithDataTag`](#call-signature-2): You can generally pass everything to `queryOptions` that you can also pass to `createQuery`. These options can be shared across `createQuery` calls and imperative APIs such as `queryClient.query`. `options.queryKey` is required and is the query key to generate options for.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;\n```\n\nDefined in: [packages/svelte-query/src/queryOptions.ts:77](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/queryOptions.ts#L77)\n\nYou can generally pass everything to `queryOptions` that you can also pass to `createQuery`. These options\ncan be shared across `createQuery` calls and imperative APIs such as `queryClient.query`. `options.queryKey`\nis required and is the query key to generate options for.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataOptions`](../type-aliases/DefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [DefinedInitialDataOptions](../type-aliases/DefinedInitialDataOptions.md) to use — everything you can pass to `createQuery`,\nwith `initialData` set.\n\n### Returns\n\n[`DefinedInitialDataOptions`](../type-aliases/DefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, `TQueryFnData`, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[createQuery](createQuery.md) to run a query with these options.\n\n### Example\n\n```svelte\n<script lang=\"ts\">\n  import { queryOptions, createQuery } from '@tanstack/svelte-query'\n\n  const postsOptions = queryOptions({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    initialData: [],\n  })\n\n  // `data` is `Post[]`, never `undefined`, thanks to `initialData` — even if a refetch fails,\n  // so the list stays visible alongside the error.\n  const query = createQuery(() => postsOptions)\n</script>\n\n{#if query.isError}\n  <span>Error: {query.error.message}</span>\n{/if}\n<ul>\n  {#each query.data as post (post.id)}\n    <li>{post.title}</li>\n  {/each}\n</ul>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;\n```\n\nDefined in: [packages/svelte-query/src/queryOptions.ts:120](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/queryOptions.ts#L120)\n\nYou can generally pass everything to `queryOptions` that you can also pass to `createQuery`. These options\ncan be shared across `createQuery` calls and imperative APIs such as `queryClient.query`. `options.queryKey`\nis required and is the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [UndefinedInitialDataOptions](../type-aliases/UndefinedInitialDataOptions.md) to use — everything you can pass to `createQuery`.\n\n### Returns\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, `TQueryFnData`, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[createQuery](createQuery.md) to run a query with these options.\n\n### Example\n\nA parameterized factory, so the same options object can be reused per `id`:\n```svelte\n<script lang=\"ts\">\n  import { queryOptions, createQuery } from '@tanstack/svelte-query'\n\n  let { id }: { id: string } = $props()\n\n  const postOptions = (id: string) =>\n    queryOptions({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })\n\n  const query = createQuery(() => postOptions(id))\n</script>\n\n{#if query.isPending}\n  Loading...\n{:else if query.isError}\n  <span>Error: {query.error.message}</span>\n{:else}\n  <h1>{query.data.title}</h1>\n{/if}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [UndefinedInitialDataOptions](../type-aliases/UndefinedInitialDataOptions.md) to use — everything you can pass to `createQuery`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`QueryObserverOptions`](../interfaces/QueryObserverOptions.md#properties). See the type above for what it changes.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, `TQueryFnData`, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`QueryObserverOptions`](../interfaces/QueryObserverOptions.md#properties), [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md#properties). See the type above for what it changes.\n","originalRawMarkdown":"---\nid: queryOptions\ntitle: queryOptions\n---\n\n## Overview\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;\n```\n\n- [`DefinedInitialDataOptions` → `DefinedInitialDataOptions & QueryKeyWithDataTag`](#call-signature-1): You can generally pass everything to `queryOptions` that you can also pass to `createQuery`. These options can be shared across `createQuery` calls and imperative APIs such as `queryClient.query`. `options.queryKey` is required and is the query key to generate options for.\n- [`UndefinedInitialDataOptions` → `UndefinedInitialDataOptions & QueryKeyWithDataTag`](#call-signature-2): You can generally pass everything to `queryOptions` that you can also pass to `createQuery`. These options can be shared across `createQuery` calls and imperative APIs such as `queryClient.query`. `options.queryKey` is required and is the query key to generate options for.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;\n```\n\nDefined in: [packages/svelte-query/src/queryOptions.ts:77](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/queryOptions.ts#L77)\n\nYou can generally pass everything to `queryOptions` that you can also pass to `createQuery`. These options\ncan be shared across `createQuery` calls and imperative APIs such as `queryClient.query`. `options.queryKey`\nis required and is the query key to generate options for.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataOptions`](../type-aliases/DefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [DefinedInitialDataOptions](../type-aliases/DefinedInitialDataOptions.md) to use — everything you can pass to `createQuery`,\nwith `initialData` set.\n\n### Returns\n\n[`DefinedInitialDataOptions`](../type-aliases/DefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, `TQueryFnData`, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[createQuery](createQuery.md) to run a query with these options.\n\n### Example\n\n```svelte\n<script lang=\"ts\">\n  import { queryOptions, createQuery } from '@tanstack/svelte-query'\n\n  const postsOptions = queryOptions({\n    queryKey: ['posts'],\n    queryFn: fetchPosts,\n    initialData: [],\n  })\n\n  // `data` is `Post[]`, never `undefined`, thanks to `initialData` — even if a refetch fails,\n  // so the list stays visible alongside the error.\n  const query = createQuery(() => postsOptions)\n</script>\n\n{#if query.isError}\n  <span>Error: {query.error.message}</span>\n{/if}\n<ul>\n  {#each query.data as post (post.id)}\n    <li>{post.title}</li>\n  {/each}\n</ul>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey>): UndefinedInitialDataOptions<TQueryFnData, TError, TData, TQueryKey> & QueryKeyWithDataTag<TQueryKey, TQueryFnData, TError>;\n```\n\nDefined in: [packages/svelte-query/src/queryOptions.ts:120](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/queryOptions.ts#L120)\n\nYou can generally pass everything to `queryOptions` that you can also pass to `createQuery`. These options\ncan be shared across `createQuery` calls and imperative APIs such as `queryClient.query`. `options.queryKey`\nis required and is the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [UndefinedInitialDataOptions](../type-aliases/UndefinedInitialDataOptions.md) to use — everything you can pass to `createQuery`.\n\n### Returns\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, `TQueryFnData`, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[createQuery](createQuery.md) to run a query with these options.\n\n### Example\n\nA parameterized factory, so the same options object can be reused per `id`:\n```svelte\n<script lang=\"ts\">\n  import { queryOptions, createQuery } from '@tanstack/svelte-query'\n\n  let { id }: { id: string } = $props()\n\n  const postOptions = (id: string) =>\n    queryOptions({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })\n\n  const query = createQuery(() => postOptions(id))\n</script>\n\n{#if query.isPending}\n  Loading...\n{:else if query.isError}\n  <span>Error: {query.error.message}</span>\n{:else}\n  <h1>{query.data.title}</h1>\n{/if}\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [UndefinedInitialDataOptions](../type-aliases/UndefinedInitialDataOptions.md) to use — everything you can pass to `createQuery`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`QueryObserverOptions`](../interfaces/QueryObserverOptions.md#properties). See the type above for what it changes.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UndefinedInitialDataOptions`](../type-aliases/UndefinedInitialDataOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, `TQueryFnData`, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\nBuilt from [`QueryObserverOptions`](../interfaces/QueryObserverOptions.md#properties), [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md#properties). See the type above for what it changes.\n"}
