g","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-defaultoptions\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"defaultOptions?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"object"}]},{"type":"tableCell","children":[{"type":"text","value":"Options applied to the queries and mutations restored from the dehydrated state."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"defaultOptions.deserializeData?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TransformerFn"}]},{"type":"tableCell","children":[{"type":"text","value":"Transforms a query's "},{"type":"inlineCode","value":"data"},{"type":"text","value":" after it is read from the dehydrated state, reversing "},{"type":"inlineCode","value":"serializeData"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"defaultOptions.mutations?"}]},{"type":"tableCell","children":[{"type":"link","href":"../interfaces/MutationOptions.md","children":[{"type":"inlineCode","value":"MutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"text","value":"Default options merged into every mutation restored from the dehydrated state."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"defaultOptions.queries?"}]},{"type":"tableCell","children":[{"type":"link","href":"../interfaces/QueryOptions.md","children":[{"type":"inlineCode","value":"QueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[], "},{"type":"inlineCode","value":"never"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"text","value":"Default options merged into every query restored from the dehydrated state."}]}]]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will\nbe used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"Server-side prefetch handed off to the client via "},{"type":"inlineCode","value":"dehydrate"},{"type":"text","value":" — "},{"type":"inlineCode","value":"dehydratedState"},{"type":"text","value":" would typically come\nfrom a server load function that prefetched with "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":" and called "},{"type":"inlineCode","value":"dehydrate(queryClient)"},{"type":"text","value":":"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { HydrationBoundary } from '@tanstack/svelte-query'\n  import type { DehydratedState } from '@tanstack/svelte-query'\n  import Posts from './Posts.svelte'\n\n  let { dehydratedState }: { dehydratedState: DehydratedState } = $props()\n</script>\n\n<HydrationBoundary state={dehydratedState}>\n  <Posts />\n</HydrationBoundary>","lang":"svelte"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"state","text":"state?","level":3},{"id":"options","text":"options?","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useHydrate(\n   state?: unknown, \n   options?: HydrateOptions, \n   queryClient?: QueryClient): void;\n```\n\nDefined in: [packages/svelte-query/src/useHydrate.ts:31](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/useHydrate.ts#L31)\n\nAdds a previously dehydrated `state` into the `queryClient` (from the nearest context, or the one\npassed explicitly). If the client already contains data, the new queries will be intelligently merged based\non update timestamp. `HydrationBoundary` wraps this — use it directly only if you need to hydrate from your\nown component instead.\n\n## Parameters\n\n### state?\n\n`unknown`\n\nThe dehydrated state to hydrate into the cache, as produced by `dehydrate`.\n\n### options?\n\n[`HydrateOptions`](../interfaces/HydrateOptions.md)\n\n[HydrateOptions](../interfaces/HydrateOptions.md) to control the hydration.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-defaultoptions\"></a> `defaultOptions?` | `object` | Options applied to the queries and mutations restored from the dehydrated state. |\n| `defaultOptions.deserializeData?` | `TransformerFn` | Transforms a query's `data` after it is read from the dehydrated state, reversing `serializeData`. |\n| `defaultOptions.mutations?` | [`MutationOptions`](../interfaces/MutationOptions.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\> | Default options merged into every mutation restored from the dehydrated state. |\n| `defaultOptions.queries?` | [`QueryOptions`](../interfaces/QueryOptions.md)\\<`unknown`, `Error`, `unknown`, readonly `unknown`[], `never`\\> | Default options merged into every query restored from the dehydrated state. |\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`void`\n\n## Example\n\nServer-side prefetch handed off to the client via `dehydrate` — `dehydratedState` would typically come\nfrom a server load function that prefetched with `queryClient.query` and called `dehydrate(queryClient)`:\n```svelte\n<script lang=\"ts\">\n  import { HydrationBoundary } from '@tanstack/svelte-query'\n  import type { DehydratedState } from '@tanstack/svelte-query'\n  import Posts from './Posts.svelte'\n\n  let { dehydratedState }: { dehydratedState: DehydratedState } = $props()\n</script>\n\n<HydrationBoundary state={dehydratedState}>\n  <Posts />\n</HydrationBoundary>\n```\n","originalRawMarkdown":"---\nid: useHydrate\ntitle: useHydrate\n---\n\n```ts\nfunction useHydrate(\n   state?: unknown, \n   options?: HydrateOptions, \n   queryClient?: QueryClient): void;\n```\n\nDefined in: [packages/svelte-query/src/useHydrate.ts:31](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/useHydrate.ts#L31)\n\nAdds a previously dehydrated `state` into the `queryClient` (from the nearest context, or the one\npassed explicitly). If the client already contains data, the new queries will be intelligently merged based\non update timestamp. `HydrationBoundary` wraps this — use it directly only if you need to hydrate from your\nown component instead.\n\n## Parameters\n\n### state?\n\n`unknown`\n\nThe dehydrated state to hydrate into the cache, as produced by `dehydrate`.\n\n### options?\n\n[`HydrateOptions`](../interfaces/HydrateOptions.md)\n\n[HydrateOptions](../interfaces/HydrateOptions.md) to control the hydration.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-defaultoptions\"></a> `defaultOptions?` | `object` | Options applied to the queries and mutations restored from the dehydrated state. |\n| `defaultOptions.deserializeData?` | `TransformerFn` | Transforms a query's `data` after it is read from the dehydrated state, reversing `serializeData`. |\n| `defaultOptions.mutations?` | [`MutationOptions`](../interfaces/MutationOptions.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\> | Default options merged into every mutation restored from the dehydrated state. |\n| `defaultOptions.queries?` | [`QueryOptions`](../interfaces/QueryOptions.md)\\<`unknown`, `Error`, `unknown`, readonly `unknown`[], `never`\\> | Default options merged into every query restored from the dehydrated state. |\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`void`\n\n## Example\n\nServer-side prefetch handed off to the client via `dehydrate` — `dehydratedState` would typically come\nfrom a server load function that prefetched with `queryClient.query` and called `dehydrate(queryClient)`:\n```svelte\n<script lang=\"ts\">\n  import { HydrationBoundary } from '@tanstack/svelte-query'\n  import type { DehydratedState } from '@tanstack/svelte-query'\n  import Posts from './Posts.svelte'\n\n  let { dehydratedState }: { dehydratedState: DehydratedState } = $props()\n</script>\n\n<HydrationBoundary state={dehydratedState}>\n  <Posts />\n</HydrationBoundary>\n```\n"}
