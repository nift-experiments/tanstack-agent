leCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-exact\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"exact?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Match mutation key exactly"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-mutationkey\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"mutationKey?"}]},{"type":"tableCell","children":[{"type":"text","value":"readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"tableCell","children":[{"type":"text","value":"Include mutations matching this mutation key"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-predicate\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"predicate?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"mutation"},{"type":"text","value":": "},{"type":"link","href":"../classes/Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">) => "},{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Include mutations matching this predicate function"}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"filters-property-status\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"status?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"error\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"pending\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"success\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"idle\""}]},{"type":"tableCell","children":[{"type":"text","value":"Filter by mutation status"}]}]]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will\nbe used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveValue"},{"type":"text","value":"<"},{"type":"inlineCode","value":"number"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A reactive value — read "},{"type":"inlineCode","value":".current"},{"type":"text","value":" to get how many matching mutations are currently running."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { useIsMutating } from '@tanstack/svelte-query'\n\n  // How many mutations matching the posts prefix are in progress?\n  const isMutatingPosts = useIsMutating({ mutationKey: ['posts'] })\n</script>\n\n{#if isMutatingPosts.current}\n  <span>Saving posts...</span>\n{/if}","lang":"svelte"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"filters","text":"filters?","level":3},{"id":"filters-properties","text":"filters properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useIsMutating(filters?: MutationFilters<unknown, Error, unknown, unknown>, queryClient?: QueryClient): ReactiveValue<number>;\n```\n\nDefined in: [packages/svelte-query/src/useIsMutating.svelte.ts:26](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/useIsMutating.svelte.ts#L26)\n\n`useIsMutating` is an optional function that returns the `number` of mutations that your application is\nrunning (useful for app-wide loading indicators).\n\n## Parameters\n\n### filters?\n\n[`MutationFilters`](../interfaces/MutationFilters.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n[MutationFilters](../interfaces/MutationFilters.md) to narrow down which mutations to count.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | Match mutation key exactly |\n| <a id=\"filters-property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | Include mutations matching this mutation key |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`mutation`: [`Mutation`](../classes/Mutation.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>) => `boolean` | Include mutations matching this predicate function |\n| <a id=\"filters-property-status\"></a> `status?` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` \\| `\"idle\"` | Filter by mutation status |\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`ReactiveValue`\\<`number`\\>\n\nA reactive value — read `.current` to get how many matching mutations are currently running.\n\n## Example\n\n```svelte\n<script lang=\"ts\">\n  import { useIsMutating } from '@tanstack/svelte-query'\n\n  // How many mutations matching the posts prefix are in progress?\n  const isMutatingPosts = useIsMutating({ mutationKey: ['posts'] })\n</script>\n\n{#if isMutatingPosts.current}\n  <span>Saving posts...</span>\n{/if}\n```\n","originalRawMarkdown":"---\nid: useIsMutating\ntitle: useIsMutating\n---\n\n```ts\nfunction useIsMutating(filters?: MutationFilters<unknown, Error, unknown, unknown>, queryClient?: QueryClient): ReactiveValue<number>;\n```\n\nDefined in: [packages/svelte-query/src/useIsMutating.svelte.ts:26](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/useIsMutating.svelte.ts#L26)\n\n`useIsMutating` is an optional function that returns the `number` of mutations that your application is\nrunning (useful for app-wide loading indicators).\n\n## Parameters\n\n### filters?\n\n[`MutationFilters`](../interfaces/MutationFilters.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n[MutationFilters](../interfaces/MutationFilters.md) to narrow down which mutations to count.\n\n<a id=\"filters-properties\"></a>\n\n#### `filters` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"filters-property-exact\"></a> `exact?` | `boolean` | Match mutation key exactly |\n| <a id=\"filters-property-mutationkey\"></a> `mutationKey?` | readonly `unknown`[] | Include mutations matching this mutation key |\n| <a id=\"filters-property-predicate\"></a> `predicate?` | (`mutation`: [`Mutation`](../classes/Mutation.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>) => `boolean` | Include mutations matching this predicate function |\n| <a id=\"filters-property-status\"></a> `status?` | `\"error\"` \\| `\"pending\"` \\| `\"success\"` \\| `\"idle\"` | Filter by mutation status |\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`ReactiveValue`\\<`number`\\>\n\nA reactive value — read `.current` to get how many matching mutations are currently running.\n\n## Example\n\n```svelte\n<script lang=\"ts\">\n  import { useIsMutating } from '@tanstack/svelte-query'\n\n  // How many mutations matching the posts prefix are in progress?\n  const isMutatingPosts = useIsMutating({ mutationKey: ['posts'] })\n</script>\n\n{#if isMutatingPosts.current}\n  <span>Saving posts...</span>\n{/if}\n```\n"}
