"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../classes/Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":"> = "},{"type":"link","href":"../type-aliases/MutationTypeFromResult.md","children":[{"type":"inlineCode","value":"MutationTypeFromResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/MutationStateOptions.md","children":[{"type":"inlineCode","value":"MutationStateOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TMutation"},{"type":"text","value":"> = "},{"type":"inlineCode","value":"{}"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"filters"},{"type":"text","value":" to narrow down matched mutations, and an optional "},{"type":"inlineCode","value":"select"},{"type":"text","value":" to transform the\nmutation state."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-filters\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"filters?"}]},{"type":"tableCell","children":[{"type":"link","href":"../interfaces/MutationFilters.md","children":[{"type":"inlineCode","value":"MutationFilters"}]}]},{"type":"tableCell","children":[{"type":"text","value":"The filters that select the mutations to return the state of."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-select\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"select?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"mutation"},{"type":"text","value":": "},{"type":"inlineCode","value":"TMutation"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TResult"}]},{"type":"tableCell","children":[{"type":"text","value":"Maps each matching mutation to the value returned for it. Defaults to the mutation's "},{"type":"inlineCode","value":"state"},{"type":"text","value":"."}]}]]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one from the nearest context will\nbe used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TResult"},{"type":"text","value":"[]"}]},{"type":"paragraph","children":[{"type":"text","value":"An Array of whatever "},{"type":"inlineCode","value":"select"},{"type":"text","value":" returns for each matching mutation."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Get all variables of all running mutations:"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { useMutationState } from '@tanstack/svelte-query'\n\n  const pendingVariables = useMutationState({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  })\n</script>\n\n{pendingVariables.length} posts saving...","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"Get all data for specific mutations via the "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":":"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { createMutation, useMutationState } from '@tanstack/svelte-query'\n\n  const mutationKey = ['posts']\n\n  // Some mutation that we want to get the state for\n  const mutation = createMutation(() => ({\n    mutationKey,\n    mutationFn: createPosts,\n  }))\n\n  const savedPosts = useMutationState({\n    // this mutation key needs to match the mutation key of the given mutation (see above)\n    filters: { mutationKey, status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n</script>\n\n<button onclick={() => mutation.mutate(['New Post'])}>\n  Create post ({savedPosts.length} saved so far)\n</button>","lang":"svelte"},{"type":"paragraph","children":[{"type":"text","value":"Access the latest mutation data via the "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":". Each invocation of "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" adds a new entry to the\nmutation cache for "},{"type":"inlineCode","value":"gcTime"},{"type":"text","value":" milliseconds — check the last item that "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":" returns to get the\nlatest successful mutation (the "},{"type":"inlineCode","value":"status: 'success'"},{"type":"text","value":" filter above excludes pending/errored ones):"}]},{"type":"code","value":"<script lang=\"ts\">\n  import { useMutationState } from '@tanstack/svelte-query'\n\n  const savedPosts = useMutationState({\n    filters: { mutationKey: ['posts'], status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n\n  const latestSavedPost = $derived(savedPosts[savedPosts.length - 1])\n</script>\n\n{latestSavedPost ? 'Saved' : 'Nothing saved yet'}","lang":"svelte"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tresult","text":"TResult","level":3},{"id":"tmutation","text":"TMutation","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options?","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useMutationState<TResult, TMutation>(options?: MutationStateOptions<TResult, TMutation>, queryClient?: QueryClient): TResult[];\n```\n\nDefined in: [packages/svelte-query/src/useMutationState.svelte.ts:103](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/useMutationState.svelte.ts#L103)\n\n`useMutationState` is a function that gives you access to all mutations in the `MutationCache`. You can pass\n`filters` ([MutationFilters](../interfaces/MutationFilters.md)) to narrow down your mutations, and `select` to transform the mutation\nstate.\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n### TMutation\n\n`TMutation` *extends* [`Mutation`](../classes/Mutation.md)\\<`any`, `any`, `any`, `any`\\> = [`MutationTypeFromResult`](../type-aliases/MutationTypeFromResult.md)\\<`TResult`\\>\n\n## Parameters\n\n### options?\n\n[`MutationStateOptions`](../type-aliases/MutationStateOptions.md)\\<`TResult`, `TMutation`\\> = `{}`\n\nThe `filters` to narrow down matched mutations, and an optional `select` to transform the\nmutation state.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-filters\"></a> `filters?` | [`MutationFilters`](../interfaces/MutationFilters.md) | The filters that select the mutations to return the state of. |\n| <a id=\"options-property-select\"></a> `select?` | (`mutation`: `TMutation`) => `TResult` | Maps each matching mutation to the value returned for it. Defaults to the mutation's `state`. |\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`TResult`[]\n\nAn Array of whatever `select` returns for each matching mutation.\n\n## Examples\n\nGet all variables of all running mutations:\n```svelte\n<script lang=\"ts\">\n  import { useMutationState } from '@tanstack/svelte-query'\n\n  const pendingVariables = useMutationState({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  })\n</script>\n\n{pendingVariables.length} posts saving...\n```\n\nGet all data for specific mutations via the `mutationKey`:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useMutationState } from '@tanstack/svelte-query'\n\n  const mutationKey = ['posts']\n\n  // Some mutation that we want to get the state for\n  const mutation = createMutation(() => ({\n    mutationKey,\n    mutationFn: createPosts,\n  }))\n\n  const savedPosts = useMutationState({\n    // this mutation key needs to match the mutation key of the given mutation (see above)\n    filters: { mutationKey, status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n</script>\n\n<button onclick={() => mutation.mutate(['New Post'])}>\n  Create post ({savedPosts.length} saved so far)\n</button>\n```\n\nAccess the latest mutation data via the `mutationKey`. Each invocation of `mutate` adds a new entry to the\nmutation cache for `gcTime` milliseconds — check the last item that `useMutationState` returns to get the\nlatest successful mutation (the `status: 'success'` filter above excludes pending/errored ones):\n```svelte\n<script lang=\"ts\">\n  import { useMutationState } from '@tanstack/svelte-query'\n\n  const savedPosts = useMutationState({\n    filters: { mutationKey: ['posts'], status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n\n  const latestSavedPost = $derived(savedPosts[savedPosts.length - 1])\n</script>\n\n{latestSavedPost ? 'Saved' : 'Nothing saved yet'}\n```\n","originalRawMarkdown":"---\nid: useMutationState\ntitle: useMutationState\n---\n\n```ts\nfunction useMutationState<TResult, TMutation>(options?: MutationStateOptions<TResult, TMutation>, queryClient?: QueryClient): TResult[];\n```\n\nDefined in: [packages/svelte-query/src/useMutationState.svelte.ts:103](https://github.com/TanStack/query/blob/main/packages/svelte-query/src/useMutationState.svelte.ts#L103)\n\n`useMutationState` is a function that gives you access to all mutations in the `MutationCache`. You can pass\n`filters` ([MutationFilters](../interfaces/MutationFilters.md)) to narrow down your mutations, and `select` to transform the mutation\nstate.\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n### TMutation\n\n`TMutation` *extends* [`Mutation`](../classes/Mutation.md)\\<`any`, `any`, `any`, `any`\\> = [`MutationTypeFromResult`](../type-aliases/MutationTypeFromResult.md)\\<`TResult`\\>\n\n## Parameters\n\n### options?\n\n[`MutationStateOptions`](../type-aliases/MutationStateOptions.md)\\<`TResult`, `TMutation`\\> = `{}`\n\nThe `filters` to narrow down matched mutations, and an optional `select` to transform the\nmutation state.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-filters\"></a> `filters?` | [`MutationFilters`](../interfaces/MutationFilters.md) | The filters that select the mutations to return the state of. |\n| <a id=\"options-property-select\"></a> `select?` | (`mutation`: `TMutation`) => `TResult` | Maps each matching mutation to the value returned for it. Defaults to the mutation's `state`. |\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one from the nearest context will\nbe used.\n\n## Returns\n\n`TResult`[]\n\nAn Array of whatever `select` returns for each matching mutation.\n\n## Examples\n\nGet all variables of all running mutations:\n```svelte\n<script lang=\"ts\">\n  import { useMutationState } from '@tanstack/svelte-query'\n\n  const pendingVariables = useMutationState({\n    filters: { status: 'pending' },\n    select: (mutation) => mutation.state.variables,\n  })\n</script>\n\n{pendingVariables.length} posts saving...\n```\n\nGet all data for specific mutations via the `mutationKey`:\n```svelte\n<script lang=\"ts\">\n  import { createMutation, useMutationState } from '@tanstack/svelte-query'\n\n  const mutationKey = ['posts']\n\n  // Some mutation that we want to get the state for\n  const mutation = createMutation(() => ({\n    mutationKey,\n    mutationFn: createPosts,\n  }))\n\n  const savedPosts = useMutationState({\n    // this mutation key needs to match the mutation key of the given mutation (see above)\n    filters: { mutationKey, status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n</script>\n\n<button onclick={() => mutation.mutate(['New Post'])}>\n  Create post ({savedPosts.length} saved so far)\n</button>\n```\n\nAccess the latest mutation data via the `mutationKey`. Each invocation of `mutate` adds a new entry to the\nmutation cache for `gcTime` milliseconds — check the last item that `useMutationState` returns to get the\nlatest successful mutation (the `status: 'success'` filter above excludes pending/errored ones):\n```svelte\n<script lang=\"ts\">\n  import { useMutationState } from '@tanstack/svelte-query'\n\n  const savedPosts = useMutationState({\n    filters: { mutationKey: ['posts'], status: 'success' },\n    select: (mutation) => mutation.state.data,\n  })\n\n  const latestSavedPost = $derived(savedPosts[savedPosts.length - 1])\n</script>\n\n{latestSavedPost ? 'Saved' : 'Nothing saved yet'}\n```\n"}
