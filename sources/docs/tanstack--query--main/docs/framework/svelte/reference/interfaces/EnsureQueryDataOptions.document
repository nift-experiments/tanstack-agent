ble garbage collection. Defaults to "},{"type":"inlineCode","value":"5 * 60 * 1000"},{"type":"text","value":" (5 minutes), or "},{"type":"inlineCode","value":"Infinity"},{"type":"text","value":" during SSR. Note: the maximum allowed time is about 24 days, imposed by "},{"type":"inlineCode","value":"setTimeout"},{"type":"text","value":"'s 32-bit signed integer delay — see "},{"type":"inlineCode","value":"timeoutManager.setTimeoutProvider"},{"type":"text","value":" for a workaround."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-initialdata\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"strike","children":[{"type":"inlineCode","value":"initialData?"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" | (() => "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"If set, this value will be used as the initial data for the query cache (as long as the query hasn't been created or cached yet). If set to a function, the function will be called "},{"type":"strong","children":[{"type":"text","value":"once"}]},{"type":"text","value":" during the shared/root query initialization, and be expected to synchronously return the initial data. Initial data is considered stale by default unless a "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" has been set. "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" "},{"type":"strong","children":[{"type":"text","value":"is persisted"}]},{"type":"text","value":" to the cache."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-initialdataupdatedat\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"strike","children":[{"type":"inlineCode","value":"initialDataUpdatedAt?"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"},{"type":"text","value":" | (() => "},{"type":"inlineCode","value":"number"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":")"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"If set, this value will be used as the time (in milliseconds) of when the "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" itself was last updated."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-initialpageparam\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"strike","children":[{"type":"inlineCode","value":"initialPageParam?"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Not allowed here, since "},{"type":"inlineCode","value":"initialPageParam"},{"type":"text","value":" only applies to infinite queries."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-maxpages\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"strike","children":[{"type":"inlineCode","value":"maxPages?"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"number"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Maximum number of pages to store in the data of an infinite query."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-meta\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"strike","children":[{"type":"inlineCode","value":"meta?"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"undefined"}]},{"type":"tableCell","children":[{"type":"text","value":"Additional payload to be stored on each query. Use this property to pass information that can be used in other places."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-networkmode\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"strike","children":[{"type":"inlineCode","value":"networkMode?"}]}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"\"online\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"always\""},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"offlineFirst\""}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"'online'"}]},{"type":"tableCell","children":[{"type":"text","value":"Controls whether a query is allowed to run based on the current network connectivity. "},{"type":"strong","children":[{"type":"text","value":"See"}]},{"type":"text","value":" "},{"type":"link","href":"https://tanstack.com/query/latest/docs/framework/react/guides/network-mode","children":[{"type":"text","value":"Network Mode"}]},{"type":"text","value":" for more information."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-persister\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"strike","children":[{"type":"inlineCode","value":"persister?"}]}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":": ("},{"type":"inlineCode","value":"context"},{"type":"text","value":": "},{"type":"link","href":"../type-aliases/QueryFunctionContext.md","children":[{"type":"inlineCode","value":"QueryFunctionContext"}]},