listener = () => handleFocus()\n  // Listen to visibilitychange\n  if (typeof window !== 'undefined' && window.addEventListener) {\n    window.addEventListener('visibilitychange', listener, false)\n  }\n\n  return () => {\n    // Be sure to unsubscribe if a new handler is set\n    window.removeEventListener('visibilitychange', listener)\n  }\n})","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"setfocused","children":[{"type":"text","value":"setFocused()"}]},{"type":"code","value":"setFocused(focused?: boolean): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L108","children":[{"type":"text","value":"packages/query-core/src/focusManager.ts:108"}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setFocused"},{"type":"text","value":" can be used to manually set the focus state. Set "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"\nto fall back to the default focus check."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"focused","children":[{"type":"text","value":"focused?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"paragraph","children":[{"type":"text","value":"The focus state, or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" to use the default focus check."}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"import { focusManager } from '@tanstack/query-core'\n\n// Set focused\nfocusManager.setFocused(true)\n\n// Set unfocused\nfocusManager.setFocused(false)\n\n// Fallback to the default focus check\nfocusManager.setFocused(undefined)","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"subscribe","children":[{"type":"text","value":"subscribe()"}]},{"type":"code","value":"subscribe(listener: Listener): () => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L28","children":[{"type":"text","value":"packages/query-core/src/subscribable.ts:28"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Registers a listener to be called on every update this object notifies about. Returns a function\nthat removes the listener again — call it to stop listening. The base class never drops a listener\non its own, though some subclasses clear all of theirs in "},{"type":"inlineCode","value":"destroy()"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"listener","children":[{"type":"text","value":"listener"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Listener"}]},{"type":"paragraph","children":[{"type":"text","value":"Called on each update, with whatever the subclass passes to its subscribers."}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that removes the listener."}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const unsubscribe = subscribable.subscribe(() => {\n  // react to the update\n})\n\nunsubscribe()","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-2","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"Subscribable.subscribe","lang":"ts"}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"methods","text":"Methods","level":2},{"id":"haslisteners","text":"hasListeners()","level":3},{"id":"returns","text":"Returns","level":4},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"isfocused","text":"isFocused()","level":3},{"id":"returns-2","text":"Returns","level":4},{"id":"onfocus","text":"onFocus()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"seteventlistener","text":"setEventListener()","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"setup","text":"setup","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"setfocused","text":"setFocused()","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"focused","text":"focused?","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"subscribe","text":"subscribe()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"listener","text":"listener","level":5},{"id":"returns-6","text":"Returns","level":4},{"id":"example-3","text":"Example","level":4},{"id":"inherited-from-2","text":"Inherited from","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/focusManager.ts:14](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L14)\n\nThe `FocusManager` manages the focus state within TanStack Query.\n\nIt can be used to change the default event listeners or to manually change the focus state.\n\n## Extends\n\n- `Subscribable`\\<`Listener`\\>\n\n## Methods\n\n### hasListeners()\n\n```ts\nhasListeners(): boolean;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:43](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L43)\n\nReturns `true` while at least one listener is registered, `false` once they have all unsubscribed.\n\n#### Returns\n\n`boolean`\n\n`true` if at least one listener is registered.\n\n#### Inherited from\n\n```ts\nSubscribable.hasListeners\n```\n\n***\n\n### isFocused()\n\n```ts\nisFocused(): boolean;\n```\n\nDefined in: [packages/query-core/src/focusManager.ts:130](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L130)\n\n`isFocused` can be used to get the current focus state.\n\n#### Returns\n\n`boolean`\n\nThe focus state set with `setFocused`, or otherwise whether the document is visible.\n\n***\n\n### onFocus()\n\n```ts\nonFocus(): void;\n```\n\nDefined in: [packages/query-core/src/focusManager.ts:119](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L119)\n\n`onFocus` notifies all subscribed listeners with the current focus state.\n\n#### Returns\n\n`void`\n\n***\n\n### setEventListener()\n\n```ts\nsetEventListener(setup: SetupFn): void;\n```\n\nDefined in: [packages/query-core/src/focusManager.ts:78](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L78)\n\n`setEventListener` can be used to set a custom event listener that will\nbe used to determine the focus state. The provided `setup` function\nreceives a `setFocused` callback: call it with a `boolean` to manually\nset the focus state, or with no arguments to re-evaluate the current\nfocus state and notify subscribers.\n\n#### Parameters\n\n##### setup\n\n`SetupFn`\n\nReceives the `setFocused` callback, registers the event listener, and may return\na cleanup function that is called when the listener is replaced or no longer needed.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { focusManager } from '@tanstack/query-core'\n\nfocusManager.setEventListener((handleFocus) => {\n  const listener = () => handleFocus()\n  // Listen to visibilitychange\n  if (typeof window !== 'undefined' && window.addEventListener) {\n    window.addEventListener('visibilitychange', listener, false)\n  }\n\n  return () => {\n    // Be sure to unsubscribe if a new handler is set\n    window.removeEventListener('visibilitychange', listener)\n  }\n})\n```\n\n***\n\n### setFocused()\n\n```ts\nsetFocused(focused?: boolean): void;\n```\n\nDefined in: [packages/query-core/src/focusManager.ts:108](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L108)\n\n`setFocused` can be used to manually set the focus state. Set `undefined`\nto fall back to the default focus check.\n\n#### Parameters\n\n##### focused?\n\n`boolean`\n\nThe focus state, or `undefined` to use the default focus check.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { focusManager } from '@tanstack/query-core'\n\n// Set focused\nfocusManager.setFocused(true)\n\n// Set unfocused\nfocusManager.setFocused(false)\n\n// Fallback to the default focus check\nfocusManager.setFocused(undefined)\n```\n\n***\n\n### subscribe()\n\n```ts\nsubscribe(listener: Listener): () => void;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:28](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L28)\n\nRegisters a listener to be called on every update this object notifies about. Returns a function\nthat removes the listener again — call it to stop listening. The base class never drops a listener\non its own, though some subclasses clear all of theirs in `destroy()`.\n\n#### Parameters\n\n##### listener\n\n`Listener`\n\nCalled on each update, with whatever the subclass passes to its subscribers.\n\n#### Returns\n\nA function that removes the listener.\n\n() => `void`\n\n#### Example\n\n```ts\nconst unsubscribe = subscribable.subscribe(() => {\n  // react to the update\n})\n\nunsubscribe()\n```\n\n#### Inherited from\n\n```ts\nSubscribable.subscribe\n```\n","originalRawMarkdown":"---\nid: FocusManager\ntitle: FocusManager\n---\n\nDefined in: [packages/query-core/src/focusManager.ts:14](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L14)\n\nThe `FocusManager` manages the focus state within TanStack Query.\n\nIt can be used to change the default event listeners or to manually change the focus state.\n\n## Extends\n\n- `Subscribable`\\<`Listener`\\>\n\n## Methods\n\n### hasListeners()\n\n```ts\nhasListeners(): boolean;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:43](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L43)\n\nReturns `true` while at least one listener is registered, `false` once they have all unsubscribed.\n\n#### Returns\n\n`boolean`\n\n`true` if at least one listener is registered.\n\n#### Inherited from\n\n```ts\nSubscribable.hasListeners\n```\n\n***\n\n### isFocused()\n\n```ts\nisFocused(): boolean;\n```\n\nDefined in: [packages/query-core/src/focusManager.ts:130](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L130)\n\n`isFocused` can be used to get the current focus state.\n\n#### Returns\n\n`boolean`\n\nThe focus state set with `setFocused`, or otherwise whether the document is visible.\n\n***\n\n### onFocus()\n\n```ts\nonFocus(): void;\n```\n\nDefined in: [packages/query-core/src/focusManager.ts:119](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L119)\n\n`onFocus` notifies all subscribed listeners with the current focus state.\n\n#### Returns\n\n`void`\n\n***\n\n### setEventListener()\n\n```ts\nsetEventListener(setup: SetupFn): void;\n```\n\nDefined in: [packages/query-core/src/focusManager.ts:78](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L78)\n\n`setEventListener` can be used to set a custom event listener that will\nbe used to determine the focus state. The provided `setup` function\nreceives a `setFocused` callback: call it with a `boolean` to manually\nset the focus state, or with no arguments to re-evaluate the current\nfocus state and notify subscribers.\n\n#### Parameters\n\n##### setup\n\n`SetupFn`\n\nReceives the `setFocused` callback, registers the event listener, and may return\na cleanup function that is called when the listener is replaced or no longer needed.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { focusManager } from '@tanstack/query-core'\n\nfocusManager.setEventListener((handleFocus) => {\n  const listener = () => handleFocus()\n  // Listen to visibilitychange\n  if (typeof window !== 'undefined' && window.addEventListener) {\n    window.addEventListener('visibilitychange', listener, false)\n  }\n\n  return () => {\n    // Be sure to unsubscribe if a new handler is set\n    window.removeEventListener('visibilitychange', listener)\n  }\n})\n```\n\n***\n\n### setFocused()\n\n```ts\nsetFocused(focused?: boolean): void;\n```\n\nDefined in: [packages/query-core/src/focusManager.ts:108](https://github.com/TanStack/query/blob/main/packages/query-core/src/focusManager.ts#L108)\n\n`setFocused` can be used to manually set the focus state. Set `undefined`\nto fall back to the default focus check.\n\n#### Parameters\n\n##### focused?\n\n`boolean`\n\nThe focus state, or `undefined` to use the default focus check.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nimport { focusManager } from '@tanstack/query-core'\n\n// Set focused\nfocusManager.setFocused(true)\n\n// Set unfocused\nfocusManager.setFocused(false)\n\n// Fallback to the default focus check\nfocusManager.setFocused(undefined)\n```\n\n***\n\n### subscribe()\n\n```ts\nsubscribe(listener: Listener): () => void;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:28](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L28)\n\nRegisters a listener to be called on every update this object notifies about. Returns a function\nthat removes the listener again — call it to stop listening. The base class never drops a listener\non its own, though some subclasses clear all of theirs in `destroy()`.\n\n#### Parameters\n\n##### listener\n\n`Listener`\n\nCalled on each update, with whatever the subclass passes to its subscribers.\n\n#### Returns\n\nA function that removes the listener.\n\n() => `void`\n\n#### Example\n\n```ts\nconst unsubscribe = subscribable.subscribe(() => {\n  // react to the update\n})\n\nunsubscribe()\n```\n\n#### Inherited from\n\n```ts\nSubscribable.subscribe\n```\n"}
