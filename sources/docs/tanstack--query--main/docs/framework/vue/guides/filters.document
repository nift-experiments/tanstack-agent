","children":[{"type":"inlineCode","value":"type?: 'active' | 'inactive' | 'all'"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"all"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"active"},{"type":"text","value":" it will match active queries."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"inactive"},{"type":"text","value":" it will match inactive queries."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"stale?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" it will match stale queries."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" it will match fresh queries."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"fetchStatus?: FetchStatus"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"fetching"},{"type":"text","value":" it will match queries that are currently fetching."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"paused"},{"type":"text","value":" it will match queries that wanted to fetch, but have been "},{"type":"inlineCode","value":"paused"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"idle"},{"type":"text","value":" it will match queries that are not fetching."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"predicate?: (query: Query) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This predicate function will be used as a final filter on all matching queries. If no other filters are specified, this function will be evaluated against every query in the cache."}]}]}]}]}]},{"type":"heading","depth":2,"id":"mutation-filters","children":[{"type":"inlineCode","value":"Mutation Filters"}]},{"type":"paragraph","children":[{"type":"text","value":"A mutation filter is an object with certain conditions to match a mutation with:"}]},{"type":"code","value":"// Get the number of all fetching mutations\nawait queryClient.isMutating()\n\n// Filter mutations by mutationKey\nawait queryClient.isMutating({ mutationKey: ['post'] })\n\n// Filter mutations using a predicate function\nawait queryClient.isMutating({\n  predicate: (mutation) => mutation.state.variables?.id === 1,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"A mutation filter object supports the following properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutationKey?: MutationKey"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this property to define a mutation key to match on."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"exact?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you don't want to search mutations inclusively by mutation key, you can pass the "},{"type":"inlineCode","value":"exact: true"},{"type":"text","value":" option to return only the mutation with the exact mutation key you have passed."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status?: MutationStatus"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Allows for filtering mutations according to their status."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"predicate?: (mutation: Mutation) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This predicate function will be used as a final filter on all matching mutations. If no other filters are specified, this function will be evaluated against every mutation in the cache."}]}]}]}]}]},{"type":"heading","depth":2,"id":"utils","children":[{"type":"text","value":"Utils"}]},{"type":"heading","depth":3,"id":"matchquery","children":[{"type":"inlineCode","value":"matchQuery"}]},{"type":"code","value":"const isMatching = matchQuery(filters, query)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns a boolean that indicates whether a query matches the provided set of query filters."}]},{"type":"heading","depth":3,"id":"matchmutation","children":[{"type":"inlineCode","value":"matchMutation"}]},{"type":"code","value":"const isMatching = matchMutation(filters, mutation)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns a boolean that indicates whether a mutation matches the provided set of mutation filters."}]}],"headings":[{"id":"query-filters","text":"Query Filters","level":2},{"id":"mutation-filters","text":"Mutation Filters","level":2},{"id":"utils","text":"Utils","level":2},{"id":"matchquery","text":"matchQuery","level":3},{"id":"matchmutation","text":"matchMutation","level":3}]},"frameworks":[],"downloadMarkdown":"\nSome methods within TanStack Query accept a `QueryFilters` or `MutationFilters` object.\n\n## `Query Filters`\n\nA query filter is an object with certain conditions to match a query with:\n\n```tsx\n// Cancel all queries\nawait queryClient.cancelQueries()\n\n// Remove all inactive queries that begin with `posts` in the key\nqueryClient.removeQueries({ queryKey: ['posts'], type: 'inactive' })\n\n// Refetch all active queries\nawait queryClient.refetchQueries({ type: 'active' })\n\n// Refetch all active queries that begin with `posts` in the key\nawait queryClient.refetchQueries({ queryKey: ['posts'], type: 'active' })\n```\n\nA query filter object supports the following properties:\n\n- `queryKey?: QueryKey`\n  - Set this property to define a query key to match on.\n- `exact?: boolean`\n  - If you don't want to search queries inclusively by query key, you can pass the `exact: true` option to return only the query with the exact query key you have passed.\n- `type?: 'active' | 'inactive' | 'all'`\n  - Defaults to `all`\n  - When set to `active` it will match active queries.\n  - When set to `inactive` it will match inactive queries.\n- `stale?: boolean`\n  - When set to `true` it will match stale queries.\n  - When set to `false` it will match fresh queries.\n- `fetchStatus?: FetchStatus`\n  - When set to `fetching` it will match queries that are currently fetching.\n  - When set to `paused` it will match queries that wanted to fetch, but have been `paused`.\n  - When set to `idle` it will match queries that are not fetching.\n- `predicate?: (query: Query) => boolean`\n  - This predicate function will be used as a final filter on all matching queries. If no other filters are specified, this function will be evaluated against every query in the cache.\n\n## `Mutation Filters`\n\nA mutation filter is an object with certain conditions to match a mutation with:\n\n```tsx\n// Get the number of all fetching mutations\nawait queryClient.isMutating()\n\n// Filter mutations by mutationKey\nawait queryClient.isMutating({ mutationKey: ['post'] })\n\n// Filter mutations using a predicate function\nawait queryClient.isMutating({\n  predicate: (mutation) => mutation.state.variables?.id === 1,\n})\n```\n\nA mutation filter object supports the following properties:\n\n- `mutationKey?: MutationKey`\n  - Set this property to define a mutation key to match on.\n- `exact?: boolean`\n  - If you don't want to search mutations inclusively by mutation key, you can pass the `exact: true` option to return only the mutation with the exact mutation key you have passed.\n- `status?: MutationStatus`\n  - Allows for filtering mutations according to their status.\n- `predicate?: (mutation: Mutation) => boolean`\n  - This predicate function will be used as a final filter on all matching mutations. If no other filters are specified, this function will be evaluated against every mutation in the cache.\n\n## Utils\n\n### `matchQuery`\n\n```tsx\nconst isMatching = matchQuery(filters, query)\n```\n\nReturns a boolean that indicates whether a query matches the provided set of query filters.\n\n### `matchMutation`\n\n```tsx\nconst isMatching = matchMutation(filters, mutation)\n```\n\nReturns a boolean that indicates whether a mutation matches the provided set of mutation filters.\n","originalRawMarkdown":"---\nid: filters\ntitle: Filters\nref: docs/framework/react/guides/filters.md\n---\n"}
