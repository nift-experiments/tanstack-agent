NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Vue Query supports prefetching multiple queries on the server and then "},{"type":"emphasis","children":[{"type":"text","value":"dehydrating"}]},{"type":"text","value":" those queries to the queryClient. This means the server can prerender markup that is immediately available on page load and as soon as JS is available, Vue Query can upgrade or "},{"type":"emphasis","children":[{"type":"text","value":"hydrate"}]},{"type":"text","value":" those queries with the full functionality of the library. This includes refetching those queries on the client if they have become stale since the time they were rendered on the server."}]},{"type":"heading","depth":2,"id":"using-nuxt-js","children":[{"type":"text","value":"Using Nuxt.js"}]},{"type":"heading","depth":3,"id":"nuxt-3","children":[{"type":"text","value":"Nuxt 3"}]},{"type":"paragraph","children":[{"type":"text","value":"First create "},{"type":"inlineCode","value":"vue-query.ts"},{"type":"text","value":" file in your "},{"type":"inlineCode","value":"plugins"},{"type":"text","value":" directory with the following content:"}]},{"type":"code","value":"import type {\n  DehydratedState,\n  VueQueryPluginOptions,\n} from '@tanstack/vue-query'\nimport {\n  VueQueryPlugin,\n  QueryClient,\n  hydrate,\n  dehydrate,\n} from '@tanstack/vue-query'\n// Nuxt 3 app aliases\nimport { defineNuxtPlugin, useState } from '#imports'\n\nexport default defineNuxtPlugin((nuxt) => {\n  const vueQueryState = useState<DehydratedState | null>('vue-query')\n\n  // Modify your Vue Query global settings here\n  const queryClient = new QueryClient({\n    defaultOptions: { queries: { staleTime: 5000 } },\n  })\n  const options: VueQueryPluginOptions = { queryClient }\n\n  nuxt.vueApp.use(VueQueryPlugin, options)\n\n  if (import.meta.server) {\n    nuxt.hooks.hook('app:rendered', () => {\n      vueQueryState.value = dehydrate(queryClient)\n    })\n  }\n\n  if (import.meta.client && vueQueryState.value !== null) {\n    hydrate(queryClient, vueQueryState.value)\n  }\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Now you are ready to prefetch some data in your pages with "},{"type":"inlineCode","value":"onServerPrefetch"},{"type":"text","value":"."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Prefetch all the queries that you need with "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":", "},{"type":"inlineCode","value":"queryClient.infiniteQuery"},{"type":"text","value":", or "},{"type":"inlineCode","value":"suspense"}]}]}]},{"type":"code","value":"export default defineComponent({\n  setup() {\n    const { data, suspense } = useQuery({\n      queryKey: ['test'],\n      queryFn: fetcher,\n    })\n\n    onServerPrefetch(async () => {\n      await suspense()\n    })\n\n    return { data }\n  },\n})","lang":"ts"},{"type":"heading","depth":3,"id":"nuxt-2","children":[{"type":"text","value":"Nuxt 2"}]},{"type":"paragraph","children":[{"type":"text","value":"First create "},{"type":"inlineCode","value":"vue-query.js"},{"type":"text","value":" file in your "},{"type":"inlineCode","value":"plugins"},{"type":"text","value":" directory with the following content:"}]},{"type":"code","value":"import Vue from 'vue'\nimport { VueQueryPlugin, QueryClient, hydrate } from '@tanstack/vue-query'\n\nexport default (context) => {\n  // Modify your Vue Query global settings here\n  const queryClient = new QueryClient({\n    defaultOptions: { queries: { staleTime: 5000 } },\n  })\n\n  if (process.server) {\n    context.ssrContext.VueQuery = queryClient\n  }\n\n  if (process.client) {\n    Vue.use(VueQueryPlugin, { queryClient })\n\n    if (context.nuxtState && context.nuxtState.vueQueryState) {\n      hydrate(queryClient, context.nuxtState.vueQueryState)\n    }\n  }\n}","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"Add this plugin to your "},{"type":"inlineCode","value":"nuxt.config.js"}]},{"type":"code","value":"module.exports = {\n  ...\n  plugins: ['~/plugins/vue-query.js'],\n}","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"Now you are ready to prefetch some data in your pages with "},{"type":"inlineCode","value":"onServerPrefetch"},{"type":"text","value":"."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"useContext"},{"type":"text","value":" to get nuxt context"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"useQueryClient"},{"type":"text","value":" to get server-side instance of "},{"type":"inlineCode","value":"queryClient"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Prefetch all the queries that you need with "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":", "},{"type":"inlineCode","value":"queryClient.infiniteQuery"},{"type":"text","value":", or "},{"type":"inlineCode","value":"suspense"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Dehydrate "},{"type":"inlineCode","value":"queryClient"},{"type":"text","value":" to the "},{"type":"inlineCode","value":"nuxtContext"}]}]}]},{"type":"code","value":"// pages/todos.vue\n<template>\n  <div>\n    <button @click=\"refetch\">Refetch</button>\n    <p>{{ data }}</p>\n  </div>\n</template>\n\n<script lang=\"ts\">\nimport {\n  defineComponent,\n  onServerPrefetch,\n  useContext,\n} from '@nuxtjs/composition-api'\nimport { useQuery, useQueryClient, dehydrate } from '@tanstack/vue-query'\n\nexport default defineComponent({\n  setup() {\n    // Get QueryClient either from SSR context, or Vue context\n    const { ssrContext } = useContext()\n    // Make sure to provide `queryClient` as a second parameter to `useQuery` calls\n    const queryClient =\n      (ssrContext != null && ssrContext.VueQuery) || useQueryClient()\n\n    // This will be prefetched and sent from the server\n    const { data, refetch, suspense } = useQuery(\n      {\n        queryKey: ['todos'],\n        queryFn: getTodos,\n      },\n      queryClient,\n    )\n    // This won't be prefetched, it will start fetching on client side\n    const { data: data2 } = useQuery(\n      {\n        queryKey: ['todos2'],\n        queryFn: getTodos,\n      },\n      queryClient,\n    )\n\n    onServerPrefetch(async () => {\n      await suspense()\n      ssrContext.nuxt.vueQueryState = dehydrate(queryClient)\n    })\n\n    return {\n      refetch,\n      data,\n    }\n  },\n})\n</script>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"As demonstrated, it's fine to prefetch some queries and let others fetch on the client. This means you can control what content server renders or not by adding or removing "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":" or "},{"type":"inlineCode","value":"suspense"},{"type":"text","value":" for a specific query."}]},{"type":"heading","depth":2,"id":"using-vite-ssr","children":[{"type":"text","value":"Using Vite SSR"}]},{"type":"paragraph","children":[{"type":"text","value":"Sync VueQuery client state with "},{"type":"link","href":"https://github.com/frandiox/vite-ssr","children":[{"type":"text","value":"vite-ssr"}]},{"type":"text","value":" in order to serialize it in the DOM:"}]},{"type":"code","value":"// main.js (entry point)\nimport App from './App.vue'\nimport viteSSR from 'vite-ssr/vue'\nimport {\n  QueryClient,\n  VueQueryPlugin,\n  hydrate,\n  dehydrate,\n} from '@tanstack/vue-query'\n\nexport default viteSSR(App, { routes: [] }, ({ app, initialState }) => {\n  // -- This is Vite SSR main hook, which is called once per request\n\n  // Create a fresh VueQuery client\n  const queryClient = new QueryClient()\n\n  // Sync initialState with the client state\n  if (import.meta.env.SSR) {\n    // Indicate how to access and serialize VueQuery state during SSR\n    initialState.vueQueryState = { toJSON: () => dehydrate(queryClient) }\n  } else {\n    // Reuse the existing state in the browser\n    hydrate(queryClient, initialState.vueQueryState)\n  }\n\n  // Mount and provide the client to the app components\n  app.use(VueQueryPlugin, { queryClient })\n})","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"Then, call VueQuery from any component using Vue's "},{"type":"inlineCode","value":"onServerPrefetch"},{"type":"text","value":":"}]},{"type":"code","value":"<!-- MyComponent.vue -->\n<template>\n  <div>\n    <button @click=\"refetch\">Refetch</button>\n    <p>{{ data }}</p>\n  </div>\n</template>\n\n<script setup>\nimport { useQuery } from '@tanstack/vue-query'\nimport { onServerPrefetch } from 'vue'\n\n// This will be prefetched and sent from the server\nconst { refetch, data, suspense } = useQuery({\n  queryKey: ['todos'],\n  queryFn: getTodos,\n})\n\nonServerPrefetch(suspense)\n</script>","lang":"vue"},{"type":"heading","depth":2,"id":"tips-tricks-and-caveats","children":[{"type":"text","value":"Tips, Tricks and Caveats"}]},{"type":"heading","depth":3,"id":"only-successful-queries-are-included-in-dehydration","children":[{"type":"text","value":"Only successful queries are included in dehydration"}]},{"type":"paragraph","children":[{"type":"text","value":"Any query with an error is automatically excluded from dehydration. This means that the default behavior is to pretend these queries were never loaded on the server, usually showing a loading state instead, and retrying the queries on the queryClient. This happens regardless of error."}]},{"type":"paragraph","children":[{"type":"text","value":"Sometimes this behavior is not desirable, maybe you want to render an error page with a correct status code instead on certain errors or queries. In those cases, use "},{"type":"inlineCode","value":"queryClient.query"},{"type":"text","value":" and catch any errors to handle those manually."}]},{"type":"heading","depth":3,"id":"staleness-is-measured-from-when-the-query-was-fetched-on-the-server","children":[{"type":"text","value":"Staleness is measured from when the query was fetched on the server"}]},{"type":"paragraph","children":[{"type":"text","value":"A query is considered stale depending on when it was "},{"type":"inlineCode","value":"dataUpdatedAt"},{"type":"text","value":". A caveat here is that the server needs to have the correct time for this to work properly, but UTC time is used, so timezones do not factor into this."}]},{"type":"paragraph","children":[{"type":"text","value":"Because "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" defaults to "},{"type":"inlineCode","value":"0"},{"type":"text","value":", queries will be refetched in the background on page load by default. You might want to use a higher "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" to avoid this double fetching, especially if you don't cache your markup."}]},{"type":"paragraph","children":[{"type":"text","value":"This refetching of stale queries is a perfect match when caching markup in a CDN! You can set the cache time of the page itself decently high to avoid having to re-render pages on the server, but configure the "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" of the queries lower to make sure data is refetched in the background as soon as a user visits the page. Maybe you want to cache the pages for a week, but refetch the data automatically on page load if it's older than a day?"}]},{"type":"heading","depth":3,"id":"suspense-of-a-query-that-stays-disabled-blocks-the-render-on-the-server","children":[{"type":"inlineCode","value":"suspense()"},{"type":"text","value":" of a query that stays disabled blocks the render on the server"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"suspense()"},{"type":"text","value":" waits until the query is enabled, so it never resolves for a query that stays disabled. On the server, awaiting it in "},{"type":"inlineCode","value":"onServerPrefetch"},{"type":"text","value":" for such a query (for example, a dependent query whose dependency failed) blocks the render. Skip it when the query is disabled:"}]},{"type":"code","value":"<script setup>\nimport { computed, onServerPrefetch } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\n\nconst { data: user, suspense: userSuspense } = useQuery({\n  queryKey: ['user'],\n  queryFn: getUser,\n})\n\nconst userId = computed(() => user.value?.id)\nconst enabled = computed(() => !!user.value?.id)\nconst { data: projects, suspense: projectsSuspense } = useQuery({\n  queryKey: ['projects', userId],\n  queryFn: () => getProjectsByUser(userId.value),\n  enabled,\n})\n\nonServerPrefetch(async () => {\n  await userSuspense()\n  if (enabled.value) {\n    await projectsSuspense()\n  }\n})\n</script>","lang":"vue"},{"type":"heading","depth":3,"id":"high-memory-consumption-on-server","children":[{"type":"text","value":"High memory consumption on server"}]},{"type":"paragraph","children":[{"type":"text","value":"In case you are creating the "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":" for every request, Vue Query creates the isolated cache for this client, which is preserved in memory for the "},{"type":"inlineCode","value":"gcTime"},{"type":"text","value":" period. That may lead to high memory consumption on server in case of high number of requests during that period."}]},{"type":"paragraph","children":[{"type":"text","value":"On the server, "},{"type":"inlineCode","value":"gcTime"},{"type":"text","value":" defaults to "},{"type":"inlineCode","value":"Infinity"},{"type":"text","value":" which disables manual garbage collection and will automatically clear memory once a request has finished. If you are explicitly setting a non-Infinity "},{"type":"inlineCode","value":"gcTime"},{"type":"text","value":" then you will be responsible for clearing the cache early."}]},{"type":"paragraph","children":[{"type":"text","value":"To clear the cache after it is not needed and to lower memory consumption, you can add a call to "},{"type":"link","href":"../reference/classes/QueryClient.md#clear","children":[{"type":"inlineCode","value":"queryClient.clear()"}]},{"type":"text","value":" after the request is handled and dehydrated state has been sent to the client."}]},{"type":"heading","depth":2,"id":"dehydrate-hydrate-options","children":[{"type":"inlineCode","value":"dehydrate"},{"type":"text","value":"/"},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"dehydrate"},{"type":"text","value":" and "},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" are re-exported from "},{"type":"inlineCode","value":"@tanstack/query-core"},{"type":"text","value":", so they're available directly from "},{"type":"inlineCode","value":"@tanstack/vue-query"},{"type":"text","value":" — as used throughout this guide."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"dehydrate(client, options?)"},{"type":"text","value":" accepts a "},{"type":"inlineCode","value":"DehydrateOptions"},{"type":"text","value":" object:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"shouldDehydrateMutation: (mutation) => boolean"},{"type":"text","value":" — whether to dehydrate a given mutation. Called for each mutation in the cache; defaults to only including paused mutations. To extend the default behavior instead of replacing it, import and call "},{"type":"inlineCode","value":"defaultShouldDehydrateMutation"},{"type":"text","value":" as part of your return statement."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"shouldDehydrateQuery: (query) => boolean"},{"type":"text","value":" — whether to dehydrate a given query. Called for each query in the cache; defaults to only including successful queries (see "},{"type":"link","href":"#only-successful-queries-are-included-in-dehydration","children":[{"type":"text","value":"above"}]},{"type":"text","value":"). Extend it the same way, with "},{"type":"inlineCode","value":"defaultShouldDehydrateQuery"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"serializeData?: (data) => any"},{"type":"text","value":" — transforms (serializes) data during dehydration."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"shouldRedactErrors?: (error) => boolean"},{"type":"text","value":" — only applies to queries still "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" at dehydration time, whose promise is dehydrated too: decides whether to redact the error if that promise later rejects. Defaults to redacting all such errors. Does "},{"type":"strong","children":[{"type":"text","value":"not"}]},{"type":"text","value":" apply to "},{"type":"inlineCode","value":"query.state.error"},{"type":"text","value":" on already-settled queries — that error is included in the dehydrated state as-is, so sanitize it yourself via "},{"type":"inlineCode","value":"shouldDehydrateQuery"},{"type":"text","value":" if it may contain sensitive data."}]}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"hydrate(client, dehydratedState, options?)"},{"type":"text","value":" accepts a "},{"type":"inlineCode","value":"HydrateOptions"},{"type":"text","value":" object:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultOptions.mutations"},{"type":"text","value":" — default mutation options for the hydrated mutations."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultOptions.queries"},{"type":"text","value":" — default query options for the hydrated queries."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultOptions.deserializeData?: (data) => any"},{"type":"text","value":" — transforms (deserializes) data before it's put into the cache."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"One caveat with "},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":": if a query being hydrated already exists in the cache, it's only overwritten when the incoming data is newer than what's already there — otherwise it's silently skipped."}]},{"type":"paragraph","children":[{"type":"text","value":"Alternatively, you can set a smaller "},{"type":"inlineCode","value":"gcTime"},{"type":"text","value":"."}]}],"headings":[{"id":"using-nuxt-js","text":"Using Nuxt.js","level":2},{"id":"nuxt-3","text":"Nuxt 3","level":3},{"id":"nuxt-2","text":"Nuxt 2","level":3},{"id":"using-vite-ssr","text":"Using Vite SSR","level":2},{"id":"tips-tricks-and-caveats","text":"Tips, Tricks and Caveats","level":2},{"id":"only-successful-queries-are-included-in-dehydration","text":"Only successful queries are included in dehydration","level":3},{"id":"staleness-is-measured-from-when-the-query-was-fetched-on-the-server","text":"Staleness is measured from when the query was fetched on the server","level":3},{"id":"suspense-of-a-query-that-stays-disabled-blocks-the-render-on-the-server","text":"suspense() of a query that stays disabled blocks the render on the server","level":3},{"id":"high-memory-consumption-on-server","text":"High memory consumption on server","level":3},{"id":"dehydrate-hydrate-options","text":"dehydrate/hydrate options","level":2}]},"frameworks":[],"downloadMarkdown":"\nVue Query supports prefetching multiple queries on the server and then _dehydrating_ those queries to the queryClient. This means the server can prerender markup that is immediately available on page load and as soon as JS is available, Vue Query can upgrade or _hydrate_ those queries with the full functionality of the library. This includes refetching those queries on the client if they have become stale since the time they were rendered on the server.\n\n## Using Nuxt.js\n\n### Nuxt 3\n\nFirst create `vue-query.ts` file in your `plugins` directory with the following content:\n\n```ts\nimport type {\n  DehydratedState,\n  VueQueryPluginOptions,\n} from '@tanstack/vue-query'\nimport {\n  VueQueryPlugin,\n  QueryClient,\n  hydrate,\n  dehydrate,\n} from '@tanstack/vue-query'\n// Nuxt 3 app aliases\nimport { defineNuxtPlugin, useState } from '#imports'\n\nexport default defineNuxtPlugin((nuxt) => {\n  const vueQueryState = useState<DehydratedState | null>('vue-query')\n\n  // Modify your Vue Query global settings here\n  const queryClient = new QueryClient({\n    defaultOptions: { queries: { staleTime: 5000 } },\n  })\n  const options: VueQueryPluginOptions = { queryClient }\n\n  nuxt.vueApp.use(VueQueryPlugin, options)\n\n  if (import.meta.server) {\n    nuxt.hooks.hook('app:rendered', () => {\n      vueQueryState.value = dehydrate(queryClient)\n    })\n  }\n\n  if (import.meta.client && vueQueryState.value !== null) {\n    hydrate(queryClient, vueQueryState.value)\n  }\n})\n```\n\nNow you are ready to prefetch some data in your pages with `onServerPrefetch`.\n\n- Prefetch all the queries that you need with `queryClient.query`, `queryClient.infiniteQuery`, or `suspense`\n\n```ts\nexport default defineComponent({\n  setup() {\n    const { data, suspense } = useQuery({\n      queryKey: ['test'],\n      queryFn: fetcher,\n    })\n\n    onServerPrefetch(async () => {\n      await suspense()\n    })\n\n    return { data }\n  },\n})\n```\n\n### Nuxt 2\n\nFirst create `vue-query.js` file in your `plugins` directory with the following content:\n\n```js\nimport Vue from 'vue'\nimport { VueQueryPlugin, QueryClient, hydrate } from '@tanstack/vue-query'\n\nexport default (context) => {\n  // Modify your Vue Query global settings here\n  const queryClient = new QueryClient({\n    defaultOptions: { queries: { staleTime: 5000 } },\n  })\n\n  if (process.server) {\n    context.ssrContext.VueQuery = queryClient\n  }\n\n  if (process.client) {\n    Vue.use(VueQueryPlugin, { queryClient })\n\n    if (context.nuxtState && context.nuxtState.vueQueryState) {\n      hydrate(queryClient, context.nuxtState.vueQueryState)\n    }\n  }\n}\n```\n\nAdd this plugin to your `nuxt.config.js`\n\n```js\nmodule.exports = {\n  ...\n  plugins: ['~/plugins/vue-query.js'],\n}\n```\n\nNow you are ready to prefetch some data in your pages with `onServerPrefetch`.\n\n- Use `useContext` to get nuxt context\n- Use `useQueryClient` to get server-side instance of `queryClient`\n- Prefetch all the queries that you need with `queryClient.query`, `queryClient.infiniteQuery`, or `suspense`\n- Dehydrate `queryClient` to the `nuxtContext`\n\n```vue\n// pages/todos.vue\n<template>\n  <div>\n    <button @click=\"refetch\">Refetch</button>\n    <p>{{ data }}</p>\n  </div>\n</template>\n\n<script lang=\"ts\">\nimport {\n  defineComponent,\n  onServerPrefetch,\n  useContext,\n} from '@nuxtjs/composition-api'\nimport { useQuery, useQueryClient, dehydrate } from '@tanstack/vue-query'\n\nexport default defineComponent({\n  setup() {\n    // Get QueryClient either from SSR context, or Vue context\n    const { ssrContext } = useContext()\n    // Make sure to provide `queryClient` as a second parameter to `useQuery` calls\n    const queryClient =\n      (ssrContext != null && ssrContext.VueQuery) || useQueryClient()\n\n    // This will be prefetched and sent from the server\n    const { data, refetch, suspense } = useQuery(\n      {\n        queryKey: ['todos'],\n        queryFn: getTodos,\n      },\n      queryClient,\n    )\n    // This won't be prefetched, it will start fetching on client side\n    const { data: data2 } = useQuery(\n      {\n        queryKey: ['todos2'],\n        queryFn: getTodos,\n      },\n      queryClient,\n    )\n\n    onServerPrefetch(async () => {\n      await suspense()\n      ssrContext.nuxt.vueQueryState = dehydrate(queryClient)\n    })\n\n    return {\n      refetch,\n      data,\n    }\n  },\n})\n</script>\n```\n\nAs demonstrated, it's fine to prefetch some queries and let others fetch on the client. This means you can control what content server renders or not by adding or removing `queryClient.query` or `suspense` for a specific query.\n\n## Using Vite SSR\n\nSync VueQuery client state with [vite-ssr](https://github.com/frandiox/vite-ssr) in order to serialize it in the DOM:\n\n```js\n// main.js (entry point)\nimport App from './App.vue'\nimport viteSSR from 'vite-ssr/vue'\nimport {\n  QueryClient,\n  VueQueryPlugin,\n  hydrate,\n  dehydrate,\n} from '@tanstack/vue-query'\n\nexport default viteSSR(App, { routes: [] }, ({ app, initialState }) => {\n  // -- This is Vite SSR main hook, which is called once per request\n\n  // Create a fresh VueQuery client\n  const queryClient = new QueryClient()\n\n  // Sync initialState with the client state\n  if (import.meta.env.SSR) {\n    // Indicate how to access and serialize VueQuery state during SSR\n    initialState.vueQueryState = { toJSON: () => dehydrate(queryClient) }\n  } else {\n    // Reuse the existing state in the browser\n    hydrate(queryClient, initialState.vueQueryState)\n  }\n\n  // Mount and provide the client to the app components\n  app.use(VueQueryPlugin, { queryClient })\n})\n```\n\nThen, call VueQuery from any component using Vue's `onServerPrefetch`:\n\n```vue\n<!-- MyComponent.vue -->\n<template>\n  <div>\n    <button @click=\"refetch\">Refetch</button>\n    <p>{{ data }}</p>\n  </div>\n</template>\n\n<script setup>\nimport { useQuery } from '@tanstack/vue-query'\nimport { onServerPrefetch } from 'vue'\n\n// This will be prefetched and sent from the server\nconst { refetch, data, suspense } = useQuery({\n  queryKey: ['todos'],\n  queryFn: getTodos,\n})\n\nonServerPrefetch(suspense)\n</script>\n```\n\n## Tips, Tricks and Caveats\n\n### Only successful queries are included in dehydration\n\nAny query with an error is automatically excluded from dehydration. This means that the default behavior is to pretend these queries were never loaded on the server, usually showing a loading state instead, and retrying the queries on the queryClient. This happens regardless of error.\n\nSometimes this behavior is not desirable, maybe you want to render an error page with a correct status code instead on certain errors or queries. In those cases, use `queryClient.query` and catch any errors to handle those manually.\n\n### Staleness is measured from when the query was fetched on the server\n\nA query is considered stale depending on when it was `dataUpdatedAt`. A caveat here is that the server needs to have the correct time for this to work properly, but UTC time is used, so timezones do not factor into this.\n\nBecause `staleTime` defaults to `0`, queries will be refetched in the background on page load by default. You might want to use a higher `staleTime` to avoid this double fetching, especially if you don't cache your markup.\n\nThis refetching of stale queries is a perfect match when caching markup in a CDN! You can set the cache time of the page itself decently high to avoid having to re-render pages on the server, but configure the `staleTime` of the queries lower to make sure data is refetched in the background as soon as a user visits the page. Maybe you want to cache the pages for a week, but refetch the data automatically on page load if it's older than a day?\n\n### `suspense()` of a query that stays disabled blocks the render on the server\n\n`suspense()` waits until the query is enabled, so it never resolves for a query that stays disabled. On the server, awaiting it in `onServerPrefetch` for such a query (for example, a dependent query whose dependency failed) blocks the render. Skip it when the query is disabled:\n\n```vue\n<script setup>\nimport { computed, onServerPrefetch } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\n\nconst { data: user, suspense: userSuspense } = useQuery({\n  queryKey: ['user'],\n  queryFn: getUser,\n})\n\nconst userId = computed(() => user.value?.id)\nconst enabled = computed(() => !!user.value?.id)\nconst { data: projects, suspense: projectsSuspense } = useQuery({\n  queryKey: ['projects', userId],\n  queryFn: () => getProjectsByUser(userId.value),\n  enabled,\n})\n\nonServerPrefetch(async () => {\n  await userSuspense()\n  if (enabled.value) {\n    await projectsSuspense()\n  }\n})\n</script>\n```\n\n### High memory consumption on server\n\nIn case you are creating the `QueryClient` for every request, Vue Query creates the isolated cache for this client, which is preserved in memory for the `gcTime` period. That may lead to high memory consumption on server in case of high number of requests during that period.\n\nOn the server, `gcTime` defaults to `Infinity` which disables manual garbage collection and will automatically clear memory once a request has finished. If you are explicitly setting a non-Infinity `gcTime` then you will be responsible for clearing the cache early.\n\nTo clear the cache after it is not needed and to lower memory consumption, you can add a call to [`queryClient.clear()`](../reference/classes/QueryClient.md#clear) after the request is handled and dehydrated state has been sent to the client.\n\n## `dehydrate`/`hydrate` options\n\n`dehydrate` and `hydrate` are re-exported from `@tanstack/query-core`, so they're available directly from `@tanstack/vue-query` — as used throughout this guide.\n\n`dehydrate(client, options?)` accepts a `DehydrateOptions` object:\n\n- `shouldDehydrateMutation: (mutation) => boolean` — whether to dehydrate a given mutation. Called for each mutation in the cache; defaults to only including paused mutations. To extend the default behavior instead of replacing it, import and call `defaultShouldDehydrateMutation` as part of your return statement.\n- `shouldDehydrateQuery: (query) => boolean` — whether to dehydrate a given query. Called for each query in the cache; defaults to only including successful queries (see [above](#only-successful-queries-are-included-in-dehydration)). Extend it the same way, with `defaultShouldDehydrateQuery`.\n- `serializeData?: (data) => any` — transforms (serializes) data during dehydration.\n- `shouldRedactErrors?: (error) => boolean` — only applies to queries still `pending` at dehydration time, whose promise is dehydrated too: decides whether to redact the error if that promise later rejects. Defaults to redacting all such errors. Does **not** apply to `query.state.error` on already-settled queries — that error is included in the dehydrated state as-is, so sanitize it yourself via `shouldDehydrateQuery` if it may contain sensitive data.\n\n`hydrate(client, dehydratedState, options?)` accepts a `HydrateOptions` object:\n\n- `defaultOptions.mutations` — default mutation options for the hydrated mutations.\n- `defaultOptions.queries` — default query options for the hydrated queries.\n- `defaultOptions.deserializeData?: (data) => any` — transforms (deserializes) data before it's put into the cache.\n\nOne caveat with `hydrate`: if a query being hydrated already exists in the cache, it's only overwritten when the incoming data is newer than what's already there — otherwise it's silently skipped.\n\nAlternatively, you can set a smaller `gcTime`.\n","originalRawMarkdown":"---\nid: ssr\ntitle: SSR\nredirect_from:\n  - framework/vue/reference/hydration\n---\n\nVue Query supports prefetching multiple queries on the server and then _dehydrating_ those queries to the queryClient. This means the server can prerender markup that is immediately available on page load and as soon as JS is available, Vue Query can upgrade or _hydrate_ those queries with the full functionality of the library. This includes refetching those queries on the client if they have become stale since the time they were rendered on the server.\n\n## Using Nuxt.js\n\n### Nuxt 3\n\nFirst create `vue-query.ts` file in your `plugins` directory with the following content:\n\n```ts\nimport type {\n  DehydratedState,\n  VueQueryPluginOptions,\n} from '@tanstack/vue-query'\nimport {\n  VueQueryPlugin,\n  QueryClient,\n  hydrate,\n  dehydrate,\n} from '@tanstack/vue-query'\n// Nuxt 3 app aliases\nimport { defineNuxtPlugin, useState } from '#imports'\n\nexport default defineNuxtPlugin((nuxt) => {\n  const vueQueryState = useState<DehydratedState | null>('vue-query')\n\n  // Modify your Vue Query global settings here\n  const queryClient = new QueryClient({\n    defaultOptions: { queries: { staleTime: 5000 } },\n  })\n  const options: VueQueryPluginOptions = { queryClient }\n\n  nuxt.vueApp.use(VueQueryPlugin, options)\n\n  if (import.meta.server) {\n    nuxt.hooks.hook('app:rendered', () => {\n      vueQueryState.value = dehydrate(queryClient)\n    })\n  }\n\n  if (import.meta.client && vueQueryState.value !== null) {\n    hydrate(queryClient, vueQueryState.value)\n  }\n})\n```\n\nNow you are ready to prefetch some data in your pages with `onServerPrefetch`.\n\n- Prefetch all the queries that you need with `queryClient.query`, `queryClient.infiniteQuery`, or `suspense`\n\n```ts\nexport default defineComponent({\n  setup() {\n    const { data, suspense } = useQuery({\n      queryKey: ['test'],\n      queryFn: fetcher,\n    })\n\n    onServerPrefetch(async () => {\n      await suspense()\n    })\n\n    return { data }\n  },\n})\n```\n\n### Nuxt 2\n\nFirst create `vue-query.js` file in your `plugins` directory with the following content:\n\n```js\nimport Vue from 'vue'\nimport { VueQueryPlugin, QueryClient, hydrate } from '@tanstack/vue-query'\n\nexport default (context) => {\n  // Modify your Vue Query global settings here\n  const queryClient = new QueryClient({\n    defaultOptions: { queries: { staleTime: 5000 } },\n  })\n\n  if (process.server) {\n    context.ssrContext.VueQuery = queryClient\n  }\n\n  if (process.client) {\n    Vue.use(VueQueryPlugin, { queryClient })\n\n    if (context.nuxtState && context.nuxtState.vueQueryState) {\n      hydrate(queryClient, context.nuxtState.vueQueryState)\n    }\n  }\n}\n```\n\nAdd this plugin to your `nuxt.config.js`\n\n```js\nmodule.exports = {\n  ...\n  plugins: ['~/plugins/vue-query.js'],\n}\n```\n\nNow you are ready to prefetch some data in your pages with `onServerPrefetch`.\n\n- Use `useContext` to get nuxt context\n- Use `useQueryClient` to get server-side instance of `queryClient`\n- Prefetch all the queries that you need with `queryClient.query`, `queryClient.infiniteQuery`, or `suspense`\n- Dehydrate `queryClient` to the `nuxtContext`\n\n```vue\n// pages/todos.vue\n<template>\n  <div>\n    <button @click=\"refetch\">Refetch</button>\n    <p>{{ data }}</p>\n  </div>\n</template>\n\n<script lang=\"ts\">\nimport {\n  defineComponent,\n  onServerPrefetch,\n  useContext,\n} from '@nuxtjs/composition-api'\nimport { useQuery, useQueryClient, dehydrate } from '@tanstack/vue-query'\n\nexport default defineComponent({\n  setup() {\n    // Get QueryClient either from SSR context, or Vue context\n    const { ssrContext } = useContext()\n    // Make sure to provide `queryClient` as a second parameter to `useQuery` calls\n    const queryClient =\n      (ssrContext != null && ssrContext.VueQuery) || useQueryClient()\n\n    // This will be prefetched and sent from the server\n    const { data, refetch, suspense } = useQuery(\n      {\n        queryKey: ['todos'],\n        queryFn: getTodos,\n      },\n      queryClient,\n    )\n    // This won't be prefetched, it will start fetching on client side\n    const { data: data2 } = useQuery(\n      {\n        queryKey: ['todos2'],\n        queryFn: getTodos,\n      },\n      queryClient,\n    )\n\n    onServerPrefetch(async () => {\n      await suspense()\n      ssrContext.nuxt.vueQueryState = dehydrate(queryClient)\n    })\n\n    return {\n      refetch,\n      data,\n    }\n  },\n})\n</script>\n```\n\nAs demonstrated, it's fine to prefetch some queries and let others fetch on the client. This means you can control what content server renders or not by adding or removing `queryClient.query` or `suspense` for a specific query.\n\n## Using Vite SSR\n\nSync VueQuery client state with [vite-ssr](https://github.com/frandiox/vite-ssr) in order to serialize it in the DOM:\n\n```js\n// main.js (entry point)\nimport App from './App.vue'\nimport viteSSR from 'vite-ssr/vue'\nimport {\n  QueryClient,\n  VueQueryPlugin,\n  hydrate,\n  dehydrate,\n} from '@tanstack/vue-query'\n\nexport default viteSSR(App, { routes: [] }, ({ app, initialState }) => {\n  // -- This is Vite SSR main hook, which is called once per request\n\n  // Create a fresh VueQuery client\n  const queryClient = new QueryClient()\n\n  // Sync initialState with the client state\n  if (import.meta.env.SSR) {\n    // Indicate how to access and serialize VueQuery state during SSR\n    initialState.vueQueryState = { toJSON: () => dehydrate(queryClient) }\n  } else {\n    // Reuse the existing state in the browser\n    hydrate(queryClient, initialState.vueQueryState)\n  }\n\n  // Mount and provide the client to the app components\n  app.use(VueQueryPlugin, { queryClient })\n})\n```\n\nThen, call VueQuery from any component using Vue's `onServerPrefetch`:\n\n```vue\n<!-- MyComponent.vue -->\n<template>\n  <div>\n    <button @click=\"refetch\">Refetch</button>\n    <p>{{ data }}</p>\n  </div>\n</template>\n\n<script setup>\nimport { useQuery } from '@tanstack/vue-query'\nimport { onServerPrefetch } from 'vue'\n\n// This will be prefetched and sent from the server\nconst { refetch, data, suspense } = useQuery({\n  queryKey: ['todos'],\n  queryFn: getTodos,\n})\n\nonServerPrefetch(suspense)\n</script>\n```\n\n## Tips, Tricks and Caveats\n\n### Only successful queries are included in dehydration\n\nAny query with an error is automatically excluded from dehydration. This means that the default behavior is to pretend these queries were never loaded on the server, usually showing a loading state instead, and retrying the queries on the queryClient. This happens regardless of error.\n\nSometimes this behavior is not desirable, maybe you want to render an error page with a correct status code instead on certain errors or queries. In those cases, use `queryClient.query` and catch any errors to handle those manually.\n\n### Staleness is measured from when the query was fetched on the server\n\nA query is considered stale depending on when it was `dataUpdatedAt`. A caveat here is that the server needs to have the correct time for this to work properly, but UTC time is used, so timezones do not factor into this.\n\nBecause `staleTime` defaults to `0`, queries will be refetched in the background on page load by default. You might want to use a higher `staleTime` to avoid this double fetching, especially if you don't cache your markup.\n\nThis refetching of stale queries is a perfect match when caching markup in a CDN! You can set the cache time of the page itself decently high to avoid having to re-render pages on the server, but configure the `staleTime` of the queries lower to make sure data is refetched in the background as soon as a user visits the page. Maybe you want to cache the pages for a week, but refetch the data automatically on page load if it's older than a day?\n\n### `suspense()` of a query that stays disabled blocks the render on the server\n\n`suspense()` waits until the query is enabled, so it never resolves for a query that stays disabled. On the server, awaiting it in `onServerPrefetch` for such a query (for example, a dependent query whose dependency failed) blocks the render. Skip it when the query is disabled:\n\n```vue\n<script setup>\nimport { computed, onServerPrefetch } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\n\nconst { data: user, suspense: userSuspense } = useQuery({\n  queryKey: ['user'],\n  queryFn: getUser,\n})\n\nconst userId = computed(() => user.value?.id)\nconst enabled = computed(() => !!user.value?.id)\nconst { data: projects, suspense: projectsSuspense } = useQuery({\n  queryKey: ['projects', userId],\n  queryFn: () => getProjectsByUser(userId.value),\n  enabled,\n})\n\nonServerPrefetch(async () => {\n  await userSuspense()\n  if (enabled.value) {\n    await projectsSuspense()\n  }\n})\n</script>\n```\n\n### High memory consumption on server\n\nIn case you are creating the `QueryClient` for every request, Vue Query creates the isolated cache for this client, which is preserved in memory for the `gcTime` period. That may lead to high memory consumption on server in case of high number of requests during that period.\n\nOn the server, `gcTime` defaults to `Infinity` which disables manual garbage collection and will automatically clear memory once a request has finished. If you are explicitly setting a non-Infinity `gcTime` then you will be responsible for clearing the cache early.\n\nTo clear the cache after it is not needed and to lower memory consumption, you can add a call to [`queryClient.clear()`](../reference/classes/QueryClient.md#clear) after the request is handled and dehydrated state has been sent to the client.\n\n## `dehydrate`/`hydrate` options\n\n`dehydrate` and `hydrate` are re-exported from `@tanstack/query-core`, so they're available directly from `@tanstack/vue-query` — as used throughout this guide.\n\n`dehydrate(client, options?)` accepts a `DehydrateOptions` object:\n\n- `shouldDehydrateMutation: (mutation) => boolean` — whether to dehydrate a given mutation. Called for each mutation in the cache; defaults to only including paused mutations. To extend the default behavior instead of replacing it, import and call `defaultShouldDehydrateMutation` as part of your return statement.\n- `shouldDehydrateQuery: (query) => boolean` — whether to dehydrate a given query. Called for each query in the cache; defaults to only including successful queries (see [above](#only-successful-queries-are-included-in-dehydration)). Extend it the same way, with `defaultShouldDehydrateQuery`.\n- `serializeData?: (data) => any` — transforms (serializes) data during dehydration.\n- `shouldRedactErrors?: (error) => boolean` — only applies to queries still `pending` at dehydration time, whose promise is dehydrated too: decides whether to redact the error if that promise later rejects. Defaults to redacting all such errors. Does **not** apply to `query.state.error` on already-settled queries — that error is included in the dehydrated state as-is, so sanitize it yourself via `shouldDehydrateQuery` if it may contain sensitive data.\n\n`hydrate(client, dehydratedState, options?)` accepts a `HydrateOptions` object:\n\n- `defaultOptions.mutations` — default mutation options for the hydrated mutations.\n- `defaultOptions.queries` — default query options for the hydrated queries.\n- `defaultOptions.deserializeData?: (data) => any` — transforms (deserializes) data before it's put into the cache.\n\nOne caveat with `hydrate`: if a query being hydrated already exists in the cache, it's only overwritten when the incoming data is newer than what's already there — otherwise it's silently skipped.\n\nAlternatively, you can set a smaller `gcTime`.\n"}
