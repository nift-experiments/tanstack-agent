pe":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const mutationCache = queryClient.getMutationCache()\n\nmutationCache.clear()","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-3","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"MC.clear","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"find","children":[{"type":"text","value":"find()"}]},{"type":"code","value":"find<TData, TError, TVariables, TOnMutateResult>(filters: MaybeRefDeep<MutationFilters<unknown, Error, unknown, unknown>>): \n  | Mutation<TData, TError, TVariables, TOnMutateResult>\n  | undefined;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/mutationCache.ts#L16","children":[{"type":"text","value":"packages/vue-query/src/mutationCache.ts:16"}]}]},{"type":"paragraph","children":[{"type":"text","value":"A slightly more advanced method that can be used to get an existing mutation instance from\nthe cache. If the mutation does not exist, "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" is returned."}]},{"type":"paragraph","children":[{"type":"text","value":"This is not typically needed for most applications, but can come in handy when needing more\ninformation about a mutation in rare scenarios."}]},{"type":"heading","depth":4,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":5,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode