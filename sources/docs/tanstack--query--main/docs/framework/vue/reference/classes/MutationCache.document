value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">\n| "},{"type":"inlineCode","value":"undefined"}]},{"type":"paragraph","children":[{"type":"text","value":"The first matching mutation, or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"#findall","children":[{"type":"text","value":"MutationCache#findAll"}]}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const mutationCache = queryClient.getMutationCache()\n\nconst mutation = mutationCache.find({ mutationKey: ['addPost'] })","lang":"ts"},{"type":"heading","depth":4,"id":"overrides","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"MC.find","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"findall","children":[{"type":"text","value":"findAll()"}]},{"type":"code","value":"findAll(filters?: MaybeRefDeep<MutationFilters<unknown, Error, unknown, unknown>>): Mutation<unknown, Error, unknown, unknown>[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/mutationCache.ts#L27","children":[{"type":"text","value":"packages/vue-query/src/mutationCache.ts:27"}]}]},{"type":"paragraph","children":[{"type":"text","value":"An even more advanced method that can be used to get existing mutation instances from the\ncache that match the given filters. If no mutations match, an empty array is returned."}]},{"type":"paragraph","children":[{"type":"text","value":"This is not typically needed for most applications, but can come in handy when needing more\ninformation about mutations in rare scenarios."}]},{"type":"heading","depth":4,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"filters-2","children":[{"type":"text","value":"filters?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefDeep"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/MutationFilters.md","children":[{"type":"inlineCode","value":"MutationFilters"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">> = "},{"type":"inlineCode","value":"{}"}]},{"type":"paragraph","children":[{"type":"text","value":"The filters to match. Without filters, every mutation is returned."}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">[]"}]},{"type":"paragraph","children":[{"type":"text","value":"The matching mutations."}]},{"type":"heading","depth":4,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"#find","children":[{"type":"text","value":"MutationCache#find"}]}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const mutationCache = queryClient.getMutationCache()\n\nconst mutations = mutationCache.findAll({ mutationKey: ['addPost'] })","lang":"ts"},{"type":"heading","depth":4,"id":"overrides-2","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"MC.findAll","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getall","children":[{"type":"text","value":"getAll()"}]},{"type":"code","value":"getAll(): Mutation<unknown, Error, unknown, unknown>[];","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L285","children":[{"type":"text","value":"packages/query-core/src/mutationCache.ts:285"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns all mutations within the cache."}]},{"type":"paragraph","children":[{"type":"text","value":"This is not typically needed for most applications, but can come in handy when needing more\ninformation about a mutation in rare scenarios."}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">[]"}]},{"type":"paragraph","children":[{"type":"text","value":"Every mutation in the cache."}]},{"type":"heading","depth":4,"id":"example-4","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const mutationCache = queryClient.getMutationCache()\n\nconst mutations = mutationCache.getAll()","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-4","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"MC.getAll","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"haslisteners","children":[{"type":"text","value":"hasListeners()"}]},{"type":"code","value":"hasListeners(): boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L43","children":[{"type":"text","value":"packages/query-core/src/subscribable.ts:43"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns "},{"type":"inlineCode","value":"true"},{"type":"text","value":" while at least one listener is registered, "},{"type":"inlineCode","value":"false"},{"type":"text","value":" once they have all unsubscribed."}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"true"},{"type":"text","value":" if at least one listener is registered."}]},{"type":"heading","depth":4,"id":"inherited-from-5","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"MC.hasListeners","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"subscribe","children":[{"type":"text","value":"subscribe()"}]},{"type":"code","value":"subscribe(listener: MutationCacheListener): () => void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L28","children":[{"type":"text","value":"packages/query-core/src/subscribable.ts:28"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Registers a listener to be called on every update this object notifies about. Returns a function\nthat removes the listener again — call it to stop listening. The base class never drops a listener\non its own, though some subclasses clear all of theirs in "},{"type":"inlineCode","value":"destroy()"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"listener","children":[{"type":"text","value":"listener"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MutationCacheListener"}]},{"type":"paragraph","children":[{"type":"text","value":"Called on each update, with whatever the subclass passes to its subscribers."}]},{"type":"heading","depth":4,"id":"returns-7","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that removes the listener."}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-5","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const unsubscribe = subscribable.subscribe(() => {\n  // react to the update\n})\n\nunsubscribe()","lang":"ts"},{"type":"heading","depth":4,"id":"inherited-from-6","children":[{"type":"text","value":"Inherited from"}]},{"type":"code","value":"MC.subscribe","lang":"ts"}],"headings":[{"id":"extends","text":"Extends","level":2},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"config","text":"config?","level":5},{"id":"returns","text":"Returns","level":4},{"id":"inherited-from","text":"Inherited from","level":4},{"id":"properties","text":"Properties","level":2},{"id":"config-2","text":"config","level":3},{"id":"inherited-from-2","text":"Inherited from","level":4},{"id":"methods","text":"Methods","level":2},{"id":"clear","text":"clear()","level":3},{"id":"returns-2","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"inherited-from-3","text":"Inherited from","level":4},{"id":"find","text":"find()","level":3},{"id":"type-parameters","text":"Type Parameters","level":4},{"id":"tdata","text":"TData","level":5},{"id":"terror","text":"TError","level":5},{"id":"tvariables","text":"TVariables","level":5},{"id":"tonmutateresult","text":"TOnMutateResult","level":5},{"id":"parameters-2","text":"Parameters","level":4},{"id":"filters","text":"filters","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"see","text":"See","level":4},{"id":"example-2","text":"Example","level":4},{"id":"overrides","text":"Overrides","level":4},{"id":"findall","text":"findAll()","level":3},{"id":"parameters-3","text":"Parameters","level":4},{"id":"filters-2","text":"filters?","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"see-2","text":"See","level":4},{"id":"example-3","text":"Example","level":4},{"id":"overrides-2","text":"Overrides","level":4},{"id":"getall","text":"getAll()","level":3},{"id":"returns-5","text":"Returns","level":4},{"id":"example-4","text":"Example","level":4},{"id":"inherited-from-4","text":"Inherited from","level":4},{"id":"haslisteners","text":"hasListeners()","level":3},{"id":"returns-6","text":"Returns","level":4},{"id":"inherited-from-5","text":"Inherited from","level":4},{"id":"subscribe","text":"subscribe()","level":3},{"id":"parameters-4","text":"Parameters","level":4},{"id":"listener","text":"listener","level":5},{"id":"returns-7","text":"Returns","level":4},{"id":"example-5","text":"Example","level":4},{"id":"inherited-from-6","text":"Inherited from","level":4}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/vue-query/src/mutationCache.ts:15](https://github.com/TanStack/query/blob/main/packages/vue-query/src/mutationCache.ts#L15)\n\nVue-aware subclass of `@tanstack/query-core`'s `MutationCache`. `find`/`findAll` also accept a\nMaybeRefDeep filters object, so `ref`s can be passed directly without unwrapping. Access it via\n`queryClient.getMutationCache()` — `QueryClient` constructs one of these by default.\n\n## Extends\n\n- `MutationCache`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew MutationCache(config?: MutationCacheConfig): MutationCache;\n```\n\nDefined in: [packages/query-core/src/mutationCache.ts:128](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L128)\n\n#### Parameters\n\n##### config?\n\n[`MutationCacheConfig`](../interfaces/MutationCacheConfig.md) = `{}`\n\n#### Returns\n\n`MutationCache`\n\n#### Inherited from\n\n```ts\nMC.constructor\n```\n\n## Properties\n\n### config\n\n```ts\nconfig: MutationCacheConfig = {};\n```\n\nDefined in: [packages/query-core/src/mutationCache.ts:128](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L128)\n\n#### Inherited from\n\n```ts\nMC.config\n```\n\n## Methods\n\n### clear()\n\n```ts\nclear(): void;\n```\n\nDefined in: [packages/query-core/src/mutationCache.ts:262](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L262)\n\nRemoves all mutations from the cache.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nmutationCache.clear()\n```\n\n#### Inherited from\n\n```ts\nMC.clear\n```\n\n***\n\n### find()\n\n```ts\nfind<TData, TError, TVariables, TOnMutateResult>(filters: MaybeRefDeep<MutationFilters<unknown, Error, unknown, unknown>>): \n  | Mutation<TData, TError, TVariables, TOnMutateResult>\n  | undefined;\n```\n\nDefined in: [packages/vue-query/src/mutationCache.ts:16](https://github.com/TanStack/query/blob/main/packages/vue-query/src/mutationCache.ts#L16)\n\nA slightly more advanced method that can be used to get an existing mutation instance from\nthe cache. If the mutation does not exist, `undefined` is returned.\n\nThis is not typically needed for most applications, but can come in handy when needing more\ninformation about a mutation in rare scenarios.\n\n#### Type Parameters\n\n##### TData\n\n`TData` = `unknown`\n\n##### TError\n\n`TError` = `Error`\n\n##### TVariables\n\n`TVariables` = `any`\n\n##### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n#### Parameters\n\n##### filters\n\n`MaybeRefDeep`\\<[`MutationFilters`](../interfaces/MutationFilters.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\\>\n\nThe filters to match. `exact` defaults to `true`.\n\n#### Returns\n\n  \\| [`Mutation`](Mutation.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n  \\| `undefined`\n\nThe first matching mutation, or `undefined`.\n\n#### See\n\n[MutationCache#findAll](#findall)\n\n#### Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst mutation = mutationCache.find({ mutationKey: ['addPost'] })\n```\n\n#### Overrides\n\n```ts\nMC.find\n```\n\n***\n\n### findAll()\n\n```ts\nfindAll(filters?: MaybeRefDeep<MutationFilters<unknown, Error, unknown, unknown>>): Mutation<unknown, Error, unknown, unknown>[];\n```\n\nDefined in: [packages/vue-query/src/mutationCache.ts:27](https://github.com/TanStack/query/blob/main/packages/vue-query/src/mutationCache.ts#L27)\n\nAn even more advanced method that can be used to get existing mutation instances from the\ncache that match the given filters. If no mutations match, an empty array is returned.\n\nThis is not typically needed for most applications, but can come in handy when needing more\ninformation about mutations in rare scenarios.\n\n#### Parameters\n\n##### filters?\n\n`MaybeRefDeep`\\<[`MutationFilters`](../interfaces/MutationFilters.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\\> = `{}`\n\nThe filters to match. Without filters, every mutation is returned.\n\n#### Returns\n\n[`Mutation`](Mutation.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>[]\n\nThe matching mutations.\n\n#### See\n\n[MutationCache#find](#find)\n\n#### Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst mutations = mutationCache.findAll({ mutationKey: ['addPost'] })\n```\n\n#### Overrides\n\n```ts\nMC.findAll\n```\n\n***\n\n### getAll()\n\n```ts\ngetAll(): Mutation<unknown, Error, unknown, unknown>[];\n```\n\nDefined in: [packages/query-core/src/mutationCache.ts:285](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L285)\n\nReturns all mutations within the cache.\n\nThis is not typically needed for most applications, but can come in handy when needing more\ninformation about a mutation in rare scenarios.\n\n#### Returns\n\n[`Mutation`](Mutation.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>[]\n\nEvery mutation in the cache.\n\n#### Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst mutations = mutationCache.getAll()\n```\n\n#### Inherited from\n\n```ts\nMC.getAll\n```\n\n***\n\n### hasListeners()\n\n```ts\nhasListeners(): boolean;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:43](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L43)\n\nReturns `true` while at least one listener is registered, `false` once they have all unsubscribed.\n\n#### Returns\n\n`boolean`\n\n`true` if at least one listener is registered.\n\n#### Inherited from\n\n```ts\nMC.hasListeners\n```\n\n***\n\n### subscribe()\n\n```ts\nsubscribe(listener: MutationCacheListener): () => void;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:28](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L28)\n\nRegisters a listener to be called on every update this object notifies about. Returns a function\nthat removes the listener again — call it to stop listening. The base class never drops a listener\non its own, though some subclasses clear all of theirs in `destroy()`.\n\n#### Parameters\n\n##### listener\n\n`MutationCacheListener`\n\nCalled on each update, with whatever the subclass passes to its subscribers.\n\n#### Returns\n\nA function that removes the listener.\n\n() => `void`\n\n#### Example\n\n```ts\nconst unsubscribe = subscribable.subscribe(() => {\n  // react to the update\n})\n\nunsubscribe()\n```\n\n#### Inherited from\n\n```ts\nMC.subscribe\n```\n","originalRawMarkdown":"---\nid: MutationCache\ntitle: MutationCache\n---\n\nDefined in: [packages/vue-query/src/mutationCache.ts:15](https://github.com/TanStack/query/blob/main/packages/vue-query/src/mutationCache.ts#L15)\n\nVue-aware subclass of `@tanstack/query-core`'s `MutationCache`. `find`/`findAll` also accept a\nMaybeRefDeep filters object, so `ref`s can be passed directly without unwrapping. Access it via\n`queryClient.getMutationCache()` — `QueryClient` constructs one of these by default.\n\n## Extends\n\n- `MutationCache`\n\n## Constructors\n\n### Constructor\n\n```ts\nnew MutationCache(config?: MutationCacheConfig): MutationCache;\n```\n\nDefined in: [packages/query-core/src/mutationCache.ts:128](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L128)\n\n#### Parameters\n\n##### config?\n\n[`MutationCacheConfig`](../interfaces/MutationCacheConfig.md) = `{}`\n\n#### Returns\n\n`MutationCache`\n\n#### Inherited from\n\n```ts\nMC.constructor\n```\n\n## Properties\n\n### config\n\n```ts\nconfig: MutationCacheConfig = {};\n```\n\nDefined in: [packages/query-core/src/mutationCache.ts:128](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L128)\n\n#### Inherited from\n\n```ts\nMC.config\n```\n\n## Methods\n\n### clear()\n\n```ts\nclear(): void;\n```\n\nDefined in: [packages/query-core/src/mutationCache.ts:262](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L262)\n\nRemoves all mutations from the cache.\n\n#### Returns\n\n`void`\n\n#### Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nmutationCache.clear()\n```\n\n#### Inherited from\n\n```ts\nMC.clear\n```\n\n***\n\n### find()\n\n```ts\nfind<TData, TError, TVariables, TOnMutateResult>(filters: MaybeRefDeep<MutationFilters<unknown, Error, unknown, unknown>>): \n  | Mutation<TData, TError, TVariables, TOnMutateResult>\n  | undefined;\n```\n\nDefined in: [packages/vue-query/src/mutationCache.ts:16](https://github.com/TanStack/query/blob/main/packages/vue-query/src/mutationCache.ts#L16)\n\nA slightly more advanced method that can be used to get an existing mutation instance from\nthe cache. If the mutation does not exist, `undefined` is returned.\n\nThis is not typically needed for most applications, but can come in handy when needing more\ninformation about a mutation in rare scenarios.\n\n#### Type Parameters\n\n##### TData\n\n`TData` = `unknown`\n\n##### TError\n\n`TError` = `Error`\n\n##### TVariables\n\n`TVariables` = `any`\n\n##### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n#### Parameters\n\n##### filters\n\n`MaybeRefDeep`\\<[`MutationFilters`](../interfaces/MutationFilters.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\\>\n\nThe filters to match. `exact` defaults to `true`.\n\n#### Returns\n\n  \\| [`Mutation`](Mutation.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n  \\| `undefined`\n\nThe first matching mutation, or `undefined`.\n\n#### See\n\n[MutationCache#findAll](#findall)\n\n#### Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst mutation = mutationCache.find({ mutationKey: ['addPost'] })\n```\n\n#### Overrides\n\n```ts\nMC.find\n```\n\n***\n\n### findAll()\n\n```ts\nfindAll(filters?: MaybeRefDeep<MutationFilters<unknown, Error, unknown, unknown>>): Mutation<unknown, Error, unknown, unknown>[];\n```\n\nDefined in: [packages/vue-query/src/mutationCache.ts:27](https://github.com/TanStack/query/blob/main/packages/vue-query/src/mutationCache.ts#L27)\n\nAn even more advanced method that can be used to get existing mutation instances from the\ncache that match the given filters. If no mutations match, an empty array is returned.\n\nThis is not typically needed for most applications, but can come in handy when needing more\ninformation about mutations in rare scenarios.\n\n#### Parameters\n\n##### filters?\n\n`MaybeRefDeep`\\<[`MutationFilters`](../interfaces/MutationFilters.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\\> = `{}`\n\nThe filters to match. Without filters, every mutation is returned.\n\n#### Returns\n\n[`Mutation`](Mutation.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>[]\n\nThe matching mutations.\n\n#### See\n\n[MutationCache#find](#find)\n\n#### Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst mutations = mutationCache.findAll({ mutationKey: ['addPost'] })\n```\n\n#### Overrides\n\n```ts\nMC.findAll\n```\n\n***\n\n### getAll()\n\n```ts\ngetAll(): Mutation<unknown, Error, unknown, unknown>[];\n```\n\nDefined in: [packages/query-core/src/mutationCache.ts:285](https://github.com/TanStack/query/blob/main/packages/query-core/src/mutationCache.ts#L285)\n\nReturns all mutations within the cache.\n\nThis is not typically needed for most applications, but can come in handy when needing more\ninformation about a mutation in rare scenarios.\n\n#### Returns\n\n[`Mutation`](Mutation.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>[]\n\nEvery mutation in the cache.\n\n#### Example\n\n```ts\nconst mutationCache = queryClient.getMutationCache()\n\nconst mutations = mutationCache.getAll()\n```\n\n#### Inherited from\n\n```ts\nMC.getAll\n```\n\n***\n\n### hasListeners()\n\n```ts\nhasListeners(): boolean;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:43](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L43)\n\nReturns `true` while at least one listener is registered, `false` once they have all unsubscribed.\n\n#### Returns\n\n`boolean`\n\n`true` if at least one listener is registered.\n\n#### Inherited from\n\n```ts\nMC.hasListeners\n```\n\n***\n\n### subscribe()\n\n```ts\nsubscribe(listener: MutationCacheListener): () => void;\n```\n\nDefined in: [packages/query-core/src/subscribable.ts:28](https://github.com/TanStack/query/blob/main/packages/query-core/src/subscribable.ts#L28)\n\nRegisters a listener to be called on every update this object notifies about. Returns a function\nthat removes the listener again — call it to stop listening. The base class never drops a listener\non its own, though some subclasses clear all of theirs in `destroy()`.\n\n#### Parameters\n\n##### listener\n\n`MutationCacheListener`\n\nCalled on each update, with whatever the subclass passes to its subscribers.\n\n#### Returns\n\nA function that removes the listener.\n\n() => `void`\n\n#### Example\n\n```ts\nconst unsubscribe = subscribable.subscribe(() => {\n  // react to the update\n})\n\nunsubscribe()\n```\n\n#### Inherited from\n\n```ts\nMC.subscribe\n```\n"}
