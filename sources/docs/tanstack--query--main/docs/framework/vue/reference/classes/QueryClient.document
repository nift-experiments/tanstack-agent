dren":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":6,"id":"options-19","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefDeep"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/QueryExecuteOptions.md","children":[{"type":"inlineCode","value":"QueryExecuteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">>"}]},{"type":"heading","depth":5,"id":"returns-33","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"overrides-25","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"QC.query","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"refetchqueries","children":[{"type":"text","value":"refetchQueries()"}]},{"type":"code","value":"refetchQueries<TTaggedQueryKey>(filters?: RefetchQueryFilters<TTaggedQueryKey>, options?: MaybeRefDeep<RefetchOptions>): Promise<void>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryClient.ts#L247","children":[{"type":"text","value":"packages/vue-query/src/queryClient.ts:247"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Refetches queries matching the given filters, regardless of whether they are stale. Without\nfilters, every query in the cache is refetched. Queries that are disabled, or static (only\nhave observers with a static "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":"), are never refetched."}]},{"type":"paragraph","children":[{"type":"text","value":"By default ("},{"type":"inlineCode","value":"cancelRefetch: true"},{"type":"text","value":"), a currently running fetch is cancelled before the new\none starts. The returned promise resolves once all matching queries have settled; it does\nnot reject on individual query failures unless "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" is set."}]},{"type":"heading","depth":4,"id":"type-parameters-24","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"ttaggedquerykey-4","children":[{"type":"text","value":"TTaggedQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"parameters-29","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"filters-6","children":[{"type":"text","value":"filters?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/RefetchQueryFilters.md","children":[{"type":"inlineCode","value":"RefetchQueryFilters"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The filters that select which queries to refetch. Without filters, every query\nin the cache is included."}]},{"type":"heading","depth":5,"id":"options-20","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefDeep"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/RefetchOptions.md","children":[{"type":"inlineCode","value":"RefetchOptions"}]},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"cancelRefetch"},{"type":"text","value":" to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" to keep a running fetch instead of cancelling\nit, and "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" to reject when a refetch fails."}]},{"type":"heading","depth":4,"id":"returns-34","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise that resolves once every matched query has settled."}]},{"type":"heading","depth":4,"id":"example-15","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// refetch all active queries partially matching a query key:\nawait queryClient.refetchQueries({ queryKey: ['posts'], type: 'active' })","lang":"ts"},{"type":"heading","depth":4,"id":"overrides-26","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"QC.refetchQueries","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"removequeries","children":[{"type":"text","value":"removeQueries()"}]},{"type":"code","value":"removeQueries<TTaggedQueryKey>(filters?: QueryFilters<TTaggedQueryKey>): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryClient.ts#L178","children":[{"type":"text","value":"packages/vue-query/src/queryClient.ts:178"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Removes queries from the cache that match the given filters. Unlike\n"},{"type":"link","href":"#invalidatequeries","children":[{"type":"text","value":"QueryClient#invalidateQueries"}]},{"type":"text","value":" or "},{"type":"link","href":"#refetchqueries","children":[{"type":"text","value":"QueryClient#refetchQueries"}]},{"type":"text","value":", this removes\nmatching queries from the cache instead of refetching them. Without filters, every query in\nthe cache is removed."}]},{"type":"heading","depth":4,"id":"type-parameters-25","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"ttaggedquerykey-5","children":[{"type":"text","value":"TTaggedQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"parameters-30","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"filters-7","children":[{"type":"text","value":"filters?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/QueryFilters.md","children":[{"type":"inlineCode","value":"QueryFilters"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TTaggedQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The filters that select which queries to remove. Without filters, every query\nis removed."}]},{"type":"heading","depth":4,"id":"returns-35","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"example-16","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"queryClient.removeQueries({ queryKey: ['posts'], exact: true })","lang":"ts"},{"type":"head