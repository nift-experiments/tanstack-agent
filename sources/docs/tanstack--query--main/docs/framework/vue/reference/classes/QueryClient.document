type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"void"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"deprecated-11","children":[{"type":"text","value":"Deprecated"}]},{"type":"paragraph","children":[{"type":"text","value":"Use queryClient.query(options) instead. You can swallow errors with "},{"type":"inlineCode","value":".catch(noop)"},{"type":"text","value":". This method will be removed in the next major version."}]},{"type":"heading","depth":5,"id":"overrides-23","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"QC.prefetchQuery","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"query","children":[{"type":"text","value":"query()"}]},{"type":"heading","depth":4,"id":"call-signature-15","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"query<TQueryFnData, TError, TData, TQueryData, TQueryKey, TPageParam>(options: QueryExecuteOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey, TPageParam>): Promise<TData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryClient.ts#L263","children":[{"type":"text","value":"packages/vue-query/src/queryClient.ts:263"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Asynchronous method to fetch and cache a query, resolving with the data or throwing with\nthe error."}]},{"type":"paragraph","children":[{"type":"text","value":"If the query already exists in the cache and its data is not stale (per the given\n"},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":"), the cached data is returned without fetching. Otherwise, the query is fetched\nand the promise resolves once the fetch settles. If a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function is provided, it is\napplied to the data in both cases (cached or freshly fetched) before it is returned."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike a reactive observer, retries are disabled by default here ("},{"type":"inlineCode","value":"retry: false"},{"type":"text","value":") unless\nexplicitly configured, since there is no component to catch a thrown error and retry through\nre-render."}]},{"type":"paragraph","children":[{"type":"text","value":"The accepted options are "},{"type":"inlineCode","value":"QueryObserverOptions"},{"type":"text","value":" minus the fields that only make sense for a\nreactive observer — "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":", "},{"type":"inlineCode","value":"refetchInterval"},{"type":"text","value":", "},{"type":"inlineCode","value":"refetchIntervalInBackground"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"refetchOnWindowFocus"},{"type":"text","value":", "},{"type":"inlineCode","value":"refetchOnReconnect"},{"type":"text","value":", "},{"type":"inlineCode","value":"refetchOnMount"},{"type":"text","value":", "},{"type":"inlineCode","value":"retryOnMount"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"notifyOnChangeProps"},{"type":"text","value":", "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":", "},{"type":"inlineCode","value":"suspense"},{"type":"text","value":", and "},{"type":"inlineCode","value":"placeholderData"},{"type":"text","value":" are not part of this\nmethod's options."}]},{"type":"paragraph","children":[{"type":"text","value":"This method replaces the deprecated "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":", and — combined with\n"},{"type":"inlineCode","value":"{ staleTime: 'static' }"},{"type":"text","value":" — the deprecated "},{"type":"inlineCode","value":"ensureQueryData"},{"type":"text","value":"."}]},{"type":"heading","depth":5,"id":"type-parameters-22","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":6,"id":"tqueryfndata-15","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":6,"id":"terror-16","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":6,"id":"tdata-19","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":6,"id":"tquerydata-2","children":[{"type":"text","value":"TQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":6,"id":"tquerykey-15","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":6,"id":"tpageparam-11","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"never"}]},{"type":"heading","depth":5,"id":"parameters-27","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":6,"id":"options-18","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/QueryExecuteOptions.md","children":[{"type":"inlineCode","value":"QueryExecuteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The query options, including the "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" and the "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" used if the\nquery needs to fetch."}]},{"type":"heading","depth":5,"id":"returns-32","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A promise that resolves to the data, or to the result of "},{"type":"inlineCode","value":"select"},{"type":"text","value":" if provided. It\nrejects with the error from the fetch or from "},{"type":"inlineCode","value":"select"},{"type":"text","value":"."}]},{"type":"heading","depth":5,"id":"example-14","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"try {\n  const data = await queryClient.query({ queryKey, queryFn, staleTime: 10000 })\n} catch (error) {\n  console.log(error)\n}","lang":"ts"},{"type":"heading","depth":5,"id":"overrides-24","children":[{"type":"text","value":"Overrides"}]},{"type":"code","value":"QC.query","lang":"ts"},{"type":"heading","depth":4,"id":"call-signature-16","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"query<TQueryFnData, TError, TData, TQueryData, TQueryKey, TPageParam>(options: MaybeRefDeep<QueryExecuteOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey, TPageParam>>): Promise<TData>;","lang":"ts"},{"type":"paragraph","children":[{"t