"type":"inlineCode","value":"TData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"Either the new data, or a function that receives each matched query's current\ndata (which may be "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":") and returns the new data."}]},{"type":"heading","depth":5,"id":"options-24","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefDeep"},{"type":"text","value":"<"},{"type":"link","href":"../interfaces/SetDataOptions.md","children":[{"type":"inlineCode","value":"SetDataOptions"}]},{"type":"text","value":"> = "},{"type":"inlineCode","value":"{}"}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"updatedAt"},{"type":"text","value":" to override the timestamp the written data is recorded with."}]},{"type":"heading","depth":4,"id":"returns-40","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"[readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[], "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" | "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"][]"}]},{"type":"paragraph","children":[{"type":"text","value":"One "},{"type":"inlineCode","value":"[queryKey, data]"},{"type":"text","value":" tuple per matched query, in the same shape and with the same\n"},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" case as "},{"type":"link","href":"#setquerydata","children":[{"type":"text","value":"QueryClient#setQueryData"}]},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"example-21","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"queryClient.setQueriesData({ queryKey: ['posts'] }, (oldPosts) =>\n  oldPosts ? oldPosts.filter((post) => post.id !== d