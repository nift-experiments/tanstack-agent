ue":"DehydrateOptions"}]},{"type":"text","value":" = "},{"type":"inlineCode","value":"{}"}]},{"type":"paragraph","children":[{"type":"text","value":"Controls which queries and mutations are included and how their data and errors\nare transformed. Each option falls back to the client's "},{"type":"inlineCode","value":"defaultOptions.dehydrate"},{"type":"text","value":"."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-serializedata\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"serializeData?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TransformerFn"}]},{"type":"tableCell","children":[{"type":"text","value":"Transforms a query's "},{"type":"inlineCode","value":"data"},{"type":"text","value":" before it is dehydrated. Useful for non-JSON-serializable data."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-shoulddehydratemutation\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"shouldDehydrateMutation?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"mutation"},{"type":"text","value":": "},{"type":"link","href":"../classes/Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Predicate to decide whether a given "},{"type":"inlineCode","value":"Mutation"},{"type":"text","value":" should be dehydrated. Defaults to "},{"type":"inlineCode","value":"defaultShouldDehydrateMutation"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-shoulddehydratequery\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"shouldDehydrateQuery?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"query"},{"type":"text","value":": "},{"type":"link","href":"../classes/Query.md","children":[{"type":"inlineCode","value":"Query"}]},{"type":"text","value":") => "},{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Predicate to decide whether a given "},{"type":"inlineCode","value":"Query"},{"type":"text","value":" should be dehydrated. Defaults to "},{"type":"inlineCode","value":"defaultShouldDehydrateQuery"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"options-property-shouldredacterrors\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"shouldRedactErrors?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"error"},{"type":"text","value":": "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":") => "},{"type":"inlineCode","value":"boolean"}]},{"type":"tableCell","children":[{"type":"text","value":"Predicate to decide whether a query's error should be redacted before dehydration. Errors are redacted (replaced with a generic "},{"type":"inlineCode","value":"Error('redacted')"},{"type":"text","value":") unless this function is provided and returns "},{"type":"inlineCode","value":"false"},{"type":"text","value":" for the given error, in which case the original error is kept."}]}]]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/DehydratedState.md","children":[{"type":"inlineCode","value":"DehydratedState"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The dehydrated state, with the included "},{"type":"inlineCode","value":"queries"},{"type":"text","value":" and "},{"type":"inlineCode","value":"mutations"},{"type":"text","value":"."}]},{"type":"html","value":"<a id=\"result-properties\"></a>"},{"type":"heading","depth":3,"id":"result-properties","children":[{"type":"text","value":"Result properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-mutations\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"mutations"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"DehydratedMutation"},{"type":"text","value":"[]"}]},{"type":"tableCell","children":[{"type":"text","value":"The dehydrated mutations, by default only the paused ones."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"result-property-queries\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"queries"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"DehydratedQuery"},{"type":"text","value":"[]"}]},{"type":"tableCell","children":[{"type":"text","value":"The dehydrated queries, by default only the successful ones."}]}]]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const queryClient = new QueryClient()\n\nawait queryClient.prefetchQuery({\n  queryKey: ['posts'],\n  queryFn: getPosts,\n})\n\nconst dehydratedState = dehydrate(queryClient)","lang":"ts"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"client","text":"client","level":3},{"id":"options","text":"options?","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"returns","text":"Returns","level":2},{"id":"result-properties","text":"Result properties","level":3},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction dehydrate(client: QueryClient, options?: DehydrateOptions): DehydratedState;\n```\n\nDefined in: [packages/query-core/src/hydration.ts:245](https://github.com/TanStack/query/blob/main/packages/query-core/src/hydration.ts#L245)\n\nDehydrates a `QueryClient`'s cache (queries and mutations) into a plain, serializable `DehydratedState`,\ntypically to embed in server-rendered markup and later restore into a client-side `QueryClient` via `hydrate`.\nWhich queries/mutations are included, and how their data/errors are transformed, is controlled by `options`,\nfalling back to the client's `dehydrate` default options, and finally to `defaultShouldDehydrateQuery` /\n`defaultShouldDehydrateMutation`.\n\n## Parameters\n\n### client\n\n`QueryClient`\n\nThe client whose cache is dehydrated.\n\n### options?\n\n[`DehydrateOptions`](../interfaces/DehydrateOptions.md) = `{}`\n\nControls which queries and mutations are included and how their data and errors\nare transformed. Each option falls back to the client's `defaultOptions.dehydrate`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-serializedata\"></a> `serializeData?` | `TransformerFn` | Transforms a query's `data` before it is dehydrated. Useful for non-JSON-serializable data. |\n| <a id=\"options-property-shoulddehydratemutation\"></a> `shouldDehydrateMutation?` | (`mutation`: [`Mutation`](../classes/Mutation.md)) => `boolean` | Predicate to decide whether a given `Mutation` should be dehydrated. Defaults to `defaultShouldDehydrateMutation`. |\n| <a id=\"options-property-shoulddehydratequery\"></a> `shouldDehydrateQuery?` | (`query`: [`Query`](../classes/Query.md)) => `boolean` | Predicate to decide whether a given `Query` should be dehydrated. Defaults to `defaultShouldDehydrateQuery`. |\n| <a id=\"options-property-shouldredacterrors\"></a> `shouldRedactErrors?` | (`error`: `unknown`) => `boolean` | Predicate to decide whether a query's error should be redacted before dehydration. Errors are redacted (replaced with a generic `Error('redacted')`) unless this function is provided and returns `false` for the given error, in which case the original error is kept. |\n\n## Returns\n\n[`DehydratedState`](../interfaces/DehydratedState.md)\n\nThe dehydrated state, with the included `queries` and `mutations`.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"result-property-mutations\"></a> `mutations` | `DehydratedMutation`[] | The dehydrated mutations, by default only the paused ones. |\n| <a id=\"result-property-queries\"></a> `queries` | `DehydratedQuery`[] | The dehydrated queries, by default only the successful ones. |\n\n## Example\n\n```ts\nconst queryClient = new QueryClient()\n\nawait queryClient.prefetchQuery({\n  queryKey: ['posts'],\n  queryFn: getPosts,\n})\n\nconst dehydratedState = dehydrate(queryClient)\n```\n","originalRawMarkdown":"---\nid: dehydrate\ntitle: dehydrate\n---\n\n```ts\nfunction dehydrate(client: QueryClient, options?: DehydrateOptions): DehydratedState;\n```\n\nDefined in: [packages/query-core/src/hydration.ts:245](https://github.com/TanStack/query/blob/main/packages/query-core/src/hydration.ts#L245)\n\nDehydrates a `QueryClient`'s cache (queries and mutations) into a plain, serializable `DehydratedState`,\ntypically to embed in server-rendered markup and later restore into a client-side `QueryClient` via `hydrate`.\nWhich queries/mutations are included, and how their data/errors are transformed, is controlled by `options`,\nfalling back to the client's `dehydrate` default options, and finally to `defaultShouldDehydrateQuery` /\n`defaultShouldDehydrateMutation`.\n\n## Parameters\n\n### client\n\n`QueryClient`\n\nThe client whose cache is dehydrated.\n\n### options?\n\n[`DehydrateOptions`](../interfaces/DehydrateOptions.md) = `{}`\n\nControls which queries and mutations are included and how their data and errors\nare transformed. Each option falls back to the client's `defaultOptions.dehydrate`.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"options-property-serializedata\"></a> `serializeData?` | `TransformerFn` | Transforms a query's `data` before it is dehydrated. Useful for non-JSON-serializable data. |\n| <a id=\"options-property-shoulddehydratemutation\"></a> `shouldDehydrateMutation?` | (`mutation`: [`Mutation`](../classes/Mutation.md)) => `boolean` | Predicate to decide whether a given `Mutation` should be dehydrated. Defaults to `defaultShouldDehydrateMutation`. |\n| <a id=\"options-property-shoulddehydratequery\"></a> `shouldDehydrateQuery?` | (`query`: [`Query`](../classes/Query.md)) => `boolean` | Predicate to decide whether a given `Query` should be dehydrated. Defaults to `defaultShouldDehydrateQuery`. |\n| <a id=\"options-property-shouldredacterrors\"></a> `shouldRedactErrors?` | (`error`: `unknown`) => `boolean` | Predicate to decide whether a query's error should be redacted before dehydration. Errors are redacted (replaced with a generic `Error('redacted')`) unless this function is provided and returns `false` for the given error, in which case the original error is kept. |\n\n## Returns\n\n[`DehydratedState`](../interfaces/DehydratedState.md)\n\nThe dehydrated state, with the included `queries` and `mutations`.\n\n<a id=\"result-properties\"></a>\n\n### Result properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"result-property-mutations\"></a> `mutations` | `DehydratedMutation`[] | The dehydrated mutations, by default only the paused ones. |\n| <a id=\"result-property-queries\"></a> `queries` | `DehydratedQuery`[] | The dehydrated queries, by default only the successful ones. |\n\n## Example\n\n```ts\nconst queryClient = new QueryClient()\n\nawait queryClient.prefetchQuery({\n  queryKey: ['posts'],\n  queryFn: getPosts,\n})\n\nconst dehydratedState = dehydrate(queryClient)\n```\n"}
