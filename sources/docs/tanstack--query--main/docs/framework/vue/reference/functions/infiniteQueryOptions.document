pe":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":", with "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" set."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/DefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"DefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":"> & "},{"type":"link","href":"../type-aliases/QueryKeyWithDataTag.md","children":[{"type":"inlineCode","value":"QueryKeyWithDataTag"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred data type."}]},{"type":"heading","depth":3,"id":"see-2","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"useInfiniteQuery.md","children":[{"type":"text","value":"useInfiniteQuery"}]},{"type":"text","value":" to run an infinite query with these options."}]},{"type":"heading","depth":3,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/vue-query'\n\nconst projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  initialData: { pages: [], pageParams: [] },\n})\n\n// `data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n// list stays visible alongside the error.\nconst { data, isError, error } = useInfiniteQuery(projectsOptions)\n</script>","lang":"vue"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-3","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/DefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"DefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/DefinedInitialDataInfiniteOptions.md","children":[{"type":"text","value":"DefinedInitialDataInfiniteOptions"}]},{"type":"text","value":" to use — everything you can pass to\n"},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":", with "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" set."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/DefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"DefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":"> & "},{"type":"link","href":"../type-aliases/QueryKeyWithDataTag.md","children":[{"type":"inlineCode","value":"QueryKeyWithDataTag"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":">, "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred data type."}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tqueryfndata","text":"TQueryFnData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tdata","text":"TData","level":4},{"id":"tquerykey","text":"TQueryKey","level":4},{"id":"tpageparam","text":"TPageParam","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"returns","text":"Returns","level":3},{"id":"see","text":"See","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tqueryfndata-2","text":"TQueryFnData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tdata-2","text":"TData","level":4},{"id":"tquerykey-2","text":"TQueryKey","level":4},{"id":"tpageparam-2","text":"TPageParam","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"see-2","text":"See","level":3},{"id":"example-2","text":"Example","level":3},{"id":"parameters-3","text":"Parameters","level":2},{"id":"options-3","text":"options","level":3},{"id":"returns-3","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\n- [`UndefinedInitialDataInfiniteOptions` → `UndefinedInitialDataInfiniteOptions & QueryKeyWithDataTag`](#call-signature-1): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n- [`DefinedInitialDataInfiniteOptions` → `DefinedInitialDataInfiniteOptions & QueryKeyWithDataTag`](#call-signature-2): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/vue-query/src/infiniteQueryOptions.ts:95](https://github.com/TanStack/query/blob/main/packages/vue-query/src/infiniteQueryOptions.ts#L95)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`.\n\n### Returns\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/vue-query'\n\nconst projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n\nconst { data, isError, error, fetchNextPage } = useInfiniteQuery(projectsOptions)\n</script>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/vue-query/src/infiniteQueryOptions.ts:148](https://github.com/TanStack/query/blob/main/packages/vue-query/src/infiniteQueryOptions.ts#L148)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`, with `initialData` set.\n\n### Returns\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/vue-query'\n\nconst projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  initialData: { pages: [], pageParams: [] },\n})\n\n// `data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n// list stays visible alongside the error.\nconst { data, isError, error } = useInfiniteQuery(projectsOptions)\n</script>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`, with `initialData` set.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n","originalRawMarkdown":"---\nid: infiniteQueryOptions\ntitle: infiniteQueryOptions\nredirect_from:\n  - framework/vue/reference/infiniteQueryOptions\n---\n\n## Overview\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\n- [`UndefinedInitialDataInfiniteOptions` → `UndefinedInitialDataInfiniteOptions & QueryKeyWithDataTag`](#call-signature-1): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n- [`DefinedInitialDataInfiniteOptions` → `DefinedInitialDataInfiniteOptions & QueryKeyWithDataTag`](#call-signature-2): You can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`. `options.queryKey` is required and is the query key to generate options for.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/vue-query/src/infiniteQueryOptions.ts:95](https://github.com/TanStack/query/blob/main/packages/vue-query/src/infiniteQueryOptions.ts#L95)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`.\n\n### Returns\n\n[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/vue-query'\n\nconst projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n\nconst { data, isError, error, fetchNextPage } = useInfiniteQuery(projectsOptions)\n</script>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction infiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>): DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam> & QueryKeyWithDataTag<TQueryKey, InfiniteData<TQueryFnData>, TError>;\n```\n\nDefined in: [packages/vue-query/src/infiniteQueryOptions.ts:148](https://github.com/TanStack/query/blob/main/packages/vue-query/src/infiniteQueryOptions.ts#L148)\n\nYou can generally pass everything to `infiniteQueryOptions` that you can also pass to `useInfiniteQuery`.\nThese options can be shared across hooks and imperative APIs such as `queryClient.infiniteQuery`.\n`options.queryKey` is required and is the query key to generate options for.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`, with `initialData` set.\n\n### Returns\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[useInfiniteQuery](useInfiniteQuery.md) to run an infinite query with these options.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { infiniteQueryOptions, useInfiniteQuery } from '@tanstack/vue-query'\n\nconst projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  initialData: { pages: [], pageParams: [] },\n})\n\n// `data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n// list stays visible alongside the error.\nconst { data, isError, error } = useInfiniteQuery(projectsOptions)\n</script>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\n\nThe [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`, with `initialData` set.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\> & [`QueryKeyWithDataTag`](../type-aliases/QueryKeyWithDataTag.md)\\<`TQueryKey`, [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`\\>, `TError`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n"}
