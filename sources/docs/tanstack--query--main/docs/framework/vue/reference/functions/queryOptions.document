"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred data type."}]},{"type":"heading","depth":3,"id":"see-3","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"useQuery.md","children":[{"type":"text","value":"useQuery"}]},{"type":"text","value":" to run a query with these options."}]},{"type":"heading","depth":3,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"paragraph","children":[{"type":"text","value":"A parameterized factory, so the same options object can be reused per "},{"type":"inlineCode","value":"id"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { queryOptions, useQuery } from '@tanstack/vue-query'\n\nfunction postOptions(id: string) {\n  return queryOptions({\n    queryKey: ['post', id],\n    queryFn: () => fetchPost(id),\n  })\n}\n\nconst { data, isPending, isError, error } = useQuery(postOptions('1'))\n</script>","lang":"vue"},{"type":"html","value":"<a id=\"call-signature-4\"></a>"},{"type":"heading","depth":2,"id":"call-signature-4","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: () => UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): () => UndefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L390","children":[{"type":"text","value":"packages/vue-query/src/queryOptions.ts:390"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Same as the plain-object overload, but for options that close over reactive state ("},{"type":"inlineCode","value":"ref"},{"type":"text","value":"s read inside the\nfunction body). Wrap them in a getter so the "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" — and anything else derived from a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":" — reacts\nto changes, and so "},{"type":"inlineCode","value":"queryClient"},{"type":"text","value":" methods like "},{"type":"inlineCode","value":"invalidateQueries"},{"type":"text","value":"/"},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" always read the current\nvalues instead of the ones captured when the options were created."}]},{"type":"heading","depth":3,"id":"type-parameters-4","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-4","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"terror-4","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-4","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"tquerykey-4","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":3,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options-4","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"link","href":"../type-aliases/UndefinedInitialQueryOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A function returning the "},{"type":"link","href":"../type-aliases/UndefinedInitialQueryOptions.md","children":[{"type":"text","value":"UndefinedInitialQueryOptions"}]},{"type":"text","value":" to use, re-evaluated on\ndemand."}]},{"type":"heading","depth":3,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that returns the same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred\ndata type."}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"link","href":"../type-aliases/UndefinedInitialQueryOptionsWithDataTag.md","children":[{"type":"inlineCode","value":"UndefinedInitialQueryOptionsWithDataTag"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"see-4","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"useQuery.md","children":[{"type":"text","value":"useQuery"}]},{"type":"text","value":" to run a query with these options."}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { queryOptions, useQuery, useQueryClient } from '@tanstack/vue-query'\n\nconst postId = ref(1)\nconst postOptions = queryOptions(() => ({\n  queryKey: ['post', postId.value],\n  queryFn: () => fetchPost(postId.value),\n}))\n\n// Pass the getter itself, not `postOptions()`, so the query keeps reacting to `postId` changes.\nconst { data } = useQuery(postOptions)\nconst queryClient = useQueryClient()\n// Here, call `postOptions()` so `invalidateQueries` reads the current `queryKey` right away.\nqueryClient.invalidateQueries(postOptions())\n</script>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"A parameterized factory that disables the query, type safe, until "},{"type":"inlineCode","value":"postId"},{"type":"text","value":" is set. The whole-options getter\nre-evaluates "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" on every change to "},{"type":"inlineCode","value":"postId"},{"type":"text","value":". "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" can also be a "},{"type":"inlineCode","value":"computed"},{"type":"text","value":", but never a bare\ngetter, since a function there is the query function itself:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { queryOptions, skipToken, useQuery } from '@tanstack/vue-query'\n\nfunction postOptions(postId: number | undefined) {\n  return queryOptions(() => ({\n    queryKey: ['post', postId],\n    queryFn: postId != null ? () => fetchPost(postId) : skipToken,\n  }))\n}\n\nconst props = defineProps<{ postId: number | undefined }>()\nconst { data, isLoading, isError, error } = useQuery(postOptions(props.postId))\n</script>","lang":"vue"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-5","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-5","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"link","href":"../type-aliases/UndefinedInitialQueryOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A function returning the "},{"type":"link","href":"../type-aliases/UndefinedInitialQueryOptions.md","children":[{"type":"text","value":"UndefinedInitialQueryOptions"}]},{"type":"text","value":" to use, re-evaluated on\ndemand."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"A function that returns the same options object, typed so that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" carries the inferred\ndata type."}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"link","href":"../type-aliases/UndefinedInitialQueryOptionsWithDataTag.md","children":[{"type":"inlineCode","value":"UndefinedInitialQueryOptionsWithDataTag"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tqueryfndata","text":"TQueryFnData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tdata","text":"TData","level":4},{"id":"tquerykey","text":"TQueryKey","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"returns","text":"Returns","level":3},{"id":"see","text":"See","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tqueryfndata-2","text":"TQueryFnData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tdata-2","text":"TData","level":4},{"id":"tquerykey-2","text":"TQueryKey","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"see-2","text":"See","level":3},{"id":"example-2","text":"Example","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tqueryfndata-3","text":"TQueryFnData","level":4},{"id":"terror-3","text":"TError","level":4},{"id":"tdata-3","text":"TData","level":4},{"id":"tquerykey-3","text":"TQueryKey","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"options-3","text":"options","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"see-3","text":"See","level":3},{"id":"example-3","text":"Example","level":3},{"id":"call-signature-4","text":"Call Signature","level":2},{"id":"type-parameters-4","text":"Type Parameters","level":3},{"id":"tqueryfndata-4","text":"TQueryFnData","level":4},{"id":"terror-4","text":"TError","level":4},{"id":"tdata-4","text":"TData","level":4},{"id":"tquerykey-4","text":"TQueryKey","level":4},{"id":"parameters-4","text":"Parameters","level":3},{"id":"options-4","text":"options","level":4},{"id":"returns-4","text":"Returns","level":3},{"id":"see-4","text":"See","level":3},{"id":"examples","text":"Examples","level":3},{"id":"parameters-5","text":"Parameters","level":2},{"id":"options-5","text":"options","level":3},{"id":"returns-5","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: () => DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): () => DefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): UndefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: () => UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): () => UndefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\n- [`DefinedInitialQueryOptions` → `DefinedInitialQueryOptionsWithDataTag`](#call-signature-1): You can generally pass everything to `queryOptions` that you can also pass to `useQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.query`. `options.queryKey` is required and is the query key to generate options for.\n- [`() => DefinedInitialQueryOptions` → `() => DefinedInitialQueryOptionsWithDataTag`](#call-signature-2): Same as the plain-object overload, but for options that close over reactive state (`ref`s read inside the function body). Wrap them in a getter so `queryClient` methods like `invalidateQueries`/`fetchQuery` always read the current values instead of the ones captured when the options were created.\n- [`UndefinedInitialQueryOptions` → `UndefinedInitialQueryOptionsWithDataTag`](#call-signature-3): You can generally pass everything to `queryOptions` that you can also pass to `useQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.query`. `options.queryKey` is required and is the query key to generate options for.\n- [`() => UndefinedInitialQueryOptions` → `() => UndefinedInitialQueryOptionsWithDataTag`](#call-signature-4): Same as the plain-object overload, but for options that close over reactive state (`ref`s read inside the function body). Wrap them in a getter so the `queryKey` — and anything else derived from a `ref` — reacts to changes, and so `queryClient` methods like `invalidateQueries`/`fetchQuery` always read the current values instead of the ones captured when the options were created.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:249](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L249)\n\nYou can generally pass everything to `queryOptions` that you can also pass to `useQuery`. These options can\nbe shared across hooks and imperative APIs such as `queryClient.query`. `options.queryKey` is required and\nis the query key to generate options for.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`DefinedInitialQueryOptions`](../type-aliases/DefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [DefinedInitialQueryOptions](../type-aliases/DefinedInitialQueryOptions.md) to use — everything you can pass to `useQuery`, with\n`initialData` set.\n\n### Returns\n\n[`DefinedInitialQueryOptionsWithDataTag`](../type-aliases/DefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[useQuery](useQuery.md) to run a query with these options.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { queryOptions, useQuery } from '@tanstack/vue-query'\n\nconst postsOptions = queryOptions({\n  queryKey: ['posts'],\n  queryFn: fetchPosts,\n  initialData: [],\n})\n\n// `data` is `Post[]`, never `undefined`, thanks to `initialData` — even if a refetch fails,\n// so the list stays visible alongside the error.\nconst { data, isError, error } = useQuery(postsOptions)\n</script>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: () => DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): () => DefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:284](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L284)\n\nSame as the plain-object overload, but for options that close over reactive state (`ref`s read inside the\nfunction body). Wrap them in a getter so `queryClient` methods like `invalidateQueries`/`fetchQuery` always\nread the current values instead of the ones captured when the options were created.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n() => [`DefinedInitialQueryOptions`](../type-aliases/DefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nA function returning the [DefinedInitialQueryOptions](../type-aliases/DefinedInitialQueryOptions.md) to use, re-evaluated on demand.\n\n### Returns\n\nA function that returns the same options object, typed so that `queryKey` carries the inferred data\ntype.\n\n() => [`DefinedInitialQueryOptionsWithDataTag`](../type-aliases/DefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\n### See\n\n[useQuery](useQuery.md) to run a query with these options.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { queryOptions, useQuery } from '@tanstack/vue-query'\n\nconst postId = ref(1)\nconst postOptions = queryOptions(() => ({\n  queryKey: ['post', postId.value],\n  queryFn: () => fetchPost(postId.value),\n  initialData: { id: postId.value, title: '' },\n}))\n\n// Pass the getter itself, not `postOptions()`, so the query keeps reacting to `postId` changes.\nconst { data } = useQuery(postOptions)\n</script>\n```\n\n<a id=\"call-signature-3\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): UndefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:327](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L327)\n\nYou can generally pass everything to `queryOptions` that you can also pass to `useQuery`. These options can\nbe shared across hooks and imperative APIs such as `queryClient.query`. `options.queryKey` is required and\nis the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialQueryOptions`](../type-aliases/UndefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [UndefinedInitialQueryOptions](../type-aliases/UndefinedInitialQueryOptions.md) to use — everything you can pass to `useQuery`.\n\n### Returns\n\n[`UndefinedInitialQueryOptionsWithDataTag`](../type-aliases/UndefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[useQuery](useQuery.md) to run a query with these options.\n\n### Example\n\nA parameterized factory, so the same options object can be reused per `id`:\n```vue\n<script setup lang=\"ts\">\nimport { queryOptions, useQuery } from '@tanstack/vue-query'\n\nfunction postOptions(id: string) {\n  return queryOptions({\n    queryKey: ['post', id],\n    queryFn: () => fetchPost(id),\n  })\n}\n\nconst { data, isPending, isError, error } = useQuery(postOptions('1'))\n</script>\n```\n\n<a id=\"call-signature-4\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: () => UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): () => UndefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:390](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L390)\n\nSame as the plain-object overload, but for options that close over reactive state (`ref`s read inside the\nfunction body). Wrap them in a getter so the `queryKey` — and anything else derived from a `ref` — reacts\nto changes, and so `queryClient` methods like `invalidateQueries`/`fetchQuery` always read the current\nvalues instead of the ones captured when the options were created.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n() => [`UndefinedInitialQueryOptions`](../type-aliases/UndefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nA function returning the [UndefinedInitialQueryOptions](../type-aliases/UndefinedInitialQueryOptions.md) to use, re-evaluated on\ndemand.\n\n### Returns\n\nA function that returns the same options object, typed so that `queryKey` carries the inferred\ndata type.\n\n() => [`UndefinedInitialQueryOptionsWithDataTag`](../type-aliases/UndefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\n### See\n\n[useQuery](useQuery.md) to run a query with these options.\n\n### Examples\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { queryOptions, useQuery, useQueryClient } from '@tanstack/vue-query'\n\nconst postId = ref(1)\nconst postOptions = queryOptions(() => ({\n  queryKey: ['post', postId.value],\n  queryFn: () => fetchPost(postId.value),\n}))\n\n// Pass the getter itself, not `postOptions()`, so the query keeps reacting to `postId` changes.\nconst { data } = useQuery(postOptions)\nconst queryClient = useQueryClient()\n// Here, call `postOptions()` so `invalidateQueries` reads the current `queryKey` right away.\nqueryClient.invalidateQueries(postOptions())\n</script>\n```\n\nA parameterized factory that disables the query, type safe, until `postId` is set. The whole-options getter\nre-evaluates `queryFn` on every change to `postId`. `queryFn` can also be a `computed`, but never a bare\ngetter, since a function there is the query function itself:\n```vue\n<script setup lang=\"ts\">\nimport { queryOptions, skipToken, useQuery } from '@tanstack/vue-query'\n\nfunction postOptions(postId: number | undefined) {\n  return queryOptions(() => ({\n    queryKey: ['post', postId],\n    queryFn: postId != null ? () => fetchPost(postId) : skipToken,\n  }))\n}\n\nconst props = defineProps<{ postId: number | undefined }>()\nconst { data, isLoading, isError, error } = useQuery(postOptions(props.postId))\n</script>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n() => [`UndefinedInitialQueryOptions`](../type-aliases/UndefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nA function returning the [UndefinedInitialQueryOptions](../type-aliases/UndefinedInitialQueryOptions.md) to use, re-evaluated on\ndemand.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\nA function that returns the same options object, typed so that `queryKey` carries the inferred\ndata type.\n\n() => [`UndefinedInitialQueryOptionsWithDataTag`](../type-aliases/UndefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n","originalRawMarkdown":"---\nid: queryOptions\ntitle: queryOptions\nredirect_from:\n  - framework/vue/reference/queryOptions\n---\n\n## Overview\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: () => DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): () => DefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): UndefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: () => UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): () => UndefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\n- [`DefinedInitialQueryOptions` → `DefinedInitialQueryOptionsWithDataTag`](#call-signature-1): You can generally pass everything to `queryOptions` that you can also pass to `useQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.query`. `options.queryKey` is required and is the query key to generate options for.\n- [`() => DefinedInitialQueryOptions` → `() => DefinedInitialQueryOptionsWithDataTag`](#call-signature-2): Same as the plain-object overload, but for options that close over reactive state (`ref`s read inside the function body). Wrap them in a getter so `queryClient` methods like `invalidateQueries`/`fetchQuery` always read the current values instead of the ones captured when the options were created.\n- [`UndefinedInitialQueryOptions` → `UndefinedInitialQueryOptionsWithDataTag`](#call-signature-3): You can generally pass everything to `queryOptions` that you can also pass to `useQuery`. These options can be shared across hooks and imperative APIs such as `queryClient.query`. `options.queryKey` is required and is the query key to generate options for.\n- [`() => UndefinedInitialQueryOptions` → `() => UndefinedInitialQueryOptionsWithDataTag`](#call-signature-4): Same as the plain-object overload, but for options that close over reactive state (`ref`s read inside the function body). Wrap them in a getter so the `queryKey` — and anything else derived from a `ref` — reacts to changes, and so `queryClient` methods like `invalidateQueries`/`fetchQuery` always read the current values instead of the ones captured when the options were created.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): DefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:249](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L249)\n\nYou can generally pass everything to `queryOptions` that you can also pass to `useQuery`. These options can\nbe shared across hooks and imperative APIs such as `queryClient.query`. `options.queryKey` is required and\nis the query key to generate options for.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`DefinedInitialQueryOptions`](../type-aliases/DefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [DefinedInitialQueryOptions](../type-aliases/DefinedInitialQueryOptions.md) to use — everything you can pass to `useQuery`, with\n`initialData` set.\n\n### Returns\n\n[`DefinedInitialQueryOptionsWithDataTag`](../type-aliases/DefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[useQuery](useQuery.md) to run a query with these options.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { queryOptions, useQuery } from '@tanstack/vue-query'\n\nconst postsOptions = queryOptions({\n  queryKey: ['posts'],\n  queryFn: fetchPosts,\n  initialData: [],\n})\n\n// `data` is `Post[]`, never `undefined`, thanks to `initialData` — even if a refetch fails,\n// so the list stays visible alongside the error.\nconst { data, isError, error } = useQuery(postsOptions)\n</script>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: () => DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): () => DefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:284](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L284)\n\nSame as the plain-object overload, but for options that close over reactive state (`ref`s read inside the\nfunction body). Wrap them in a getter so `queryClient` methods like `invalidateQueries`/`fetchQuery` always\nread the current values instead of the ones captured when the options were created.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n() => [`DefinedInitialQueryOptions`](../type-aliases/DefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nA function returning the [DefinedInitialQueryOptions](../type-aliases/DefinedInitialQueryOptions.md) to use, re-evaluated on demand.\n\n### Returns\n\nA function that returns the same options object, typed so that `queryKey` carries the inferred data\ntype.\n\n() => [`DefinedInitialQueryOptionsWithDataTag`](../type-aliases/DefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\n### See\n\n[useQuery](useQuery.md) to run a query with these options.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { queryOptions, useQuery } from '@tanstack/vue-query'\n\nconst postId = ref(1)\nconst postOptions = queryOptions(() => ({\n  queryKey: ['post', postId.value],\n  queryFn: () => fetchPost(postId.value),\n  initialData: { id: postId.value, title: '' },\n}))\n\n// Pass the getter itself, not `postOptions()`, so the query keeps reacting to `postId` changes.\nconst { data } = useQuery(postOptions)\n</script>\n```\n\n<a id=\"call-signature-3\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): UndefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:327](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L327)\n\nYou can generally pass everything to `queryOptions` that you can also pass to `useQuery`. These options can\nbe shared across hooks and imperative APIs such as `queryClient.query`. `options.queryKey` is required and\nis the query key to generate options for.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialQueryOptions`](../type-aliases/UndefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [UndefinedInitialQueryOptions](../type-aliases/UndefinedInitialQueryOptions.md) to use — everything you can pass to `useQuery`.\n\n### Returns\n\n[`UndefinedInitialQueryOptionsWithDataTag`](../type-aliases/UndefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe same options object, typed so that `queryKey` carries the inferred data type.\n\n### See\n\n[useQuery](useQuery.md) to run a query with these options.\n\n### Example\n\nA parameterized factory, so the same options object can be reused per `id`:\n```vue\n<script setup lang=\"ts\">\nimport { queryOptions, useQuery } from '@tanstack/vue-query'\n\nfunction postOptions(id: string) {\n  return queryOptions({\n    queryKey: ['post', id],\n    queryFn: () => fetchPost(id),\n  })\n}\n\nconst { data, isPending, isError, error } = useQuery(postOptions('1'))\n</script>\n```\n\n<a id=\"call-signature-4\"></a>\n\n## Call Signature\n\n```ts\nfunction queryOptions<TQueryFnData, TError, TData, TQueryKey>(options: () => UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>): () => UndefinedInitialQueryOptionsWithDataTag<TQueryFnData, TError, TData, TQueryKey>;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:390](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L390)\n\nSame as the plain-object overload, but for options that close over reactive state (`ref`s read inside the\nfunction body). Wrap them in a getter so the `queryKey` — and anything else derived from a `ref` — reacts\nto changes, and so `queryClient` methods like `invalidateQueries`/`fetchQuery` always read the current\nvalues instead of the ones captured when the options were created.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n() => [`UndefinedInitialQueryOptions`](../type-aliases/UndefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nA function returning the [UndefinedInitialQueryOptions](../type-aliases/UndefinedInitialQueryOptions.md) to use, re-evaluated on\ndemand.\n\n### Returns\n\nA function that returns the same options object, typed so that `queryKey` carries the inferred\ndata type.\n\n() => [`UndefinedInitialQueryOptionsWithDataTag`](../type-aliases/UndefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\n### See\n\n[useQuery](useQuery.md) to run a query with these options.\n\n### Examples\n\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { queryOptions, useQuery, useQueryClient } from '@tanstack/vue-query'\n\nconst postId = ref(1)\nconst postOptions = queryOptions(() => ({\n  queryKey: ['post', postId.value],\n  queryFn: () => fetchPost(postId.value),\n}))\n\n// Pass the getter itself, not `postOptions()`, so the query keeps reacting to `postId` changes.\nconst { data } = useQuery(postOptions)\nconst queryClient = useQueryClient()\n// Here, call `postOptions()` so `invalidateQueries` reads the current `queryKey` right away.\nqueryClient.invalidateQueries(postOptions())\n</script>\n```\n\nA parameterized factory that disables the query, type safe, until `postId` is set. The whole-options getter\nre-evaluates `queryFn` on every change to `postId`. `queryFn` can also be a `computed`, but never a bare\ngetter, since a function there is the query function itself:\n```vue\n<script setup lang=\"ts\">\nimport { queryOptions, skipToken, useQuery } from '@tanstack/vue-query'\n\nfunction postOptions(postId: number | undefined) {\n  return queryOptions(() => ({\n    queryKey: ['post', postId],\n    queryFn: postId != null ? () => fetchPost(postId) : skipToken,\n  }))\n}\n\nconst props = defineProps<{ postId: number | undefined }>()\nconst { data, isLoading, isError, error } = useQuery(postOptions(props.postId))\n</script>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n() => [`UndefinedInitialQueryOptions`](../type-aliases/UndefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nA function returning the [UndefinedInitialQueryOptions](../type-aliases/UndefinedInitialQueryOptions.md) to use, re-evaluated on\ndemand.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\nA function that returns the same options object, typed so that `queryKey` carries the inferred\ndata type.\n\n() => [`UndefinedInitialQueryOptionsWithDataTag`](../type-aliases/UndefinedInitialQueryOptionsWithDataTag.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n"}
