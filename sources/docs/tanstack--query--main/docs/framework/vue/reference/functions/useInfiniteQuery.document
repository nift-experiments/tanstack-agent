import { useInfiniteQuery } from '@tanstack/vue-query'\n\n// `data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n// list stays visible alongside the error.\nconst { data, isError, error } = useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  initialData: { pages: [], pageParams: [] },\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <ul>\n    <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n      <li v-for=\"project in page.projects\" :key=\"project.id\">{{ project.name }}</li>\n    </template>\n  </ul>\n</template>","lang":"vue"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/useInfiniteQuery.ts#L258","children":[{"type":"text","value":"packages/vue-query/src/useInfiniteQuery.ts:258"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":" are identical to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of\n"},{"type":"inlineCode","value":"initialPageParam"},{"type":"text","value":", "},{"type":"inlineCode","value":"getNextPageParam"},{"type":"text","value":", "},{"type":"inlineCode","value":"getPreviousPageParam"},{"type":"text","value":", and "},{"type":"inlineCode","value":"maxPages"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"enabled"},{"type":"text","value":" tracks reactive dependencies automatically as a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", a plain value, or a reactive getter\n("},{"type":"inlineCode","value":"() => ..."},{"type":"text","value":"). "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" reacts through a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":" for the array itself, or "},{"type":"inlineCode","value":"ref"},{"type":"text","value":"s and reactive getters as\nindividual entries — the array itself can't be a bare getter."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-2","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"terror-2","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-2","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"tquerykey-2","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"tpageparam-2","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options-2","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefOrGetter"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"inlineCode","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/UndefinedInitialDataInfiniteOptions.md","children":[{"type":"text","value":"UndefinedInitialDataInfiniteOptions"}]},{"type":"text","value":" to use — everything you can pass to\n"},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"queryclient-2","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseInfiniteQueryReturnType.md","children":[{"type":"inlineCode","value":"UseInfiniteQueryReturnType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same properties as "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":". "},{"type":"inlineCode","value":"data.value.pages"},{"type":"text","value":" and\n"},{"type":"inlineCode","value":"data.value.pageParams"},{"type":"text","value":" are also added, as long as a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" doesn't change "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" away from its default\n"},{"type":"inlineCode","value":"InfiniteData<TQueryFnData>"},{"type":"text","value":" shape."}]},{"type":"heading","depth":3,"id":"remarks-2","children":[{"type":"text","value":"Remarks"}]},{"type":"paragraph","children":[{"type":"text","value":"Keep in mind that imperative fetch calls, such as "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like "},{"type":"inlineCode","value":"hasNextPage && !isFetching"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Fetching the next page from a \"Load More\" button click:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\nconst {\n  data,\n  isPending,\n  isError,\n  error,\n  fetchNextPage,\n  hasNextPage,\n  isFetching,\n  isFetchingNextPage,\n} = useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n</script>\n\n<template>\n  <span v-if=\"isPending\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <template v-else>\n    <ul>\n      <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n        <li v-for=\"project in page.projects\" :key=\"project.id\">{{ project.name }}</li>\n      </template>\n    </ul>\n    <button @click=\"fetchNextPage()\" :disabled=\"!hasNextPage || isFetching\">\n      {{ isFetchingNextPage ? 'Loading more...' : hasNextPage ? 'Load More' : 'Nothing more to load' }}\n    </button>\n  </template>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Fetching the next page automatically as the user scrolls, using an "},{"type":"inlineCode","value":"IntersectionObserver"},{"type":"text","value":" on a\nsentinel element after the list:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { onUnmounted, ref, watch } from 'vue'\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\nconst {\n  data,\n  isPending,\n  isError,\n  error,\n  fetchNextPage,\n  hasNextPage,\n  isFetching,\n  isFetchingNextPage,\n} = useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n\nconst sentinel = ref<HTMLElement>()\nlet observer: IntersectionObserver | undefined\n\nwatch(sentinel, (el) => {\n  observer?.disconnect()\n  if (el == null) return\n\n  observer = new IntersectionObserver(([entry]) => {\n    if (entry?.isIntersecting && hasNextPage.value && !isFetching.value) {\n      fetchNextPage()\n    }\n  })\n  observer.observe(el)\n})\n\nonUnmounted(() => observer?.disconnect())\n</script>\n\n<template>\n  <span v-if=\"isPending\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <template v-else>\n    <ul>\n      <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n        <li v-for=\"project in page.projects\" :key=\"project.id\">{{ project.name }}</li>\n      </template>\n    </ul>\n    <div ref=\"sentinel\">{{ isFetchingNextPage ? 'Loading more...' : '' }}</div>\n  </template>\n</template>","lang":"vue"},{"type":"html","value":"<a id=\"call-signature-3\"></a>"},{"type":"heading","depth":2,"id":"call-signature-3","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UseInfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/useInfiniteQuery.ts#L351","children":[{"type":"text","value":"packages/vue-query/src/useInfiniteQuery.ts:351"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Fallback overload for options whose "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" presence isn't statically known — for example, a\n"},{"type":"inlineCode","value":"ref"},{"type":"text","value":"/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other\noverloads when possible, since they infer whether "},{"type":"inlineCode","value":"data"},{"type":"text","value":" can be "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" from "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" directly."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"enabled"},{"type":"text","value":" tracks reactive dependencies automatically as a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", a plain value, or a reactive getter\n("},{"type":"inlineCode","value":"() => ..."},{"type":"text","value":"). "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" reacts through a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":" for the array itself, or "},{"type":"inlineCode","value":"ref"},{"type":"text","value":"s and reactive getters as\nindividual entries — the array itself can't be a bare getter."}]},{"type":"heading","depth":3,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-3","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"terror-3","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-3","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"tquerykey-3","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":4,"id":"tpageparam-3","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options-3","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefOrGetter"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/UseInfiniteQueryOptions.md","children":[{"type":"inlineCode","value":"UseInfiniteQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", plain value, or reactive getter resolving to the "},{"type":"link","href":"../type-aliases/UseInfiniteQueryOptions.md","children":[{"type":"text","value":"UseInfiniteQueryOptions"}]},{"type":"text","value":" to\nuse."}]},{"type":"heading","depth":4,"id":"queryclient-3","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":3,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseInfiniteQueryReturnType.md","children":[{"type":"inlineCode","value":"UseInfiniteQueryReturnType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same properties as "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"examples-2","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Passing a whole-options getter so "},{"type":"inlineCode","value":"maxPages"},{"type":"text","value":" reacts to a setting stored elsewhere, not just "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ projectId: number; maxPages: number }>()\n\nconst { data } = useInfiniteQuery(() => ({\n  queryKey: ['project', props.projectId, 'issues'],\n  queryFn: ({ pageParam }) => fetchIssues(props.projectId, pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  maxPages: props.maxPages,\n}))\n</script>\n\n<template>\n  <template v-for=\"page in data?.pages\" :key=\"page.nextId\">\n    <li v-for=\"issue in page.issues\" :key=\"issue.id\">{{ issue.title }}</li>\n  </template>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"A query that's disabled, type-safe, until "},{"type":"inlineCode","value":"postId"},{"type":"text","value":" is set — pass "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" as "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" instead of\nsetting "},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":". This requires a whole-options getter: "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" isn't itself reactive, so the\ngetter is what re-evaluates it on every change to "},{"type":"inlineCode","value":"props.postId"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { skipToken, useInfiniteQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: string | undefined }>()\n\n// Use `isLoading`, not `isPending`, so the loading state doesn't show while the query is disabled.\nconst { data, isLoading, isError, error } = useInfiniteQuery(() => {\n  const postId = props.postId\n  return {\n    queryKey: ['post', postId, 'comments'],\n    queryFn:\n      postId != null\n        ? ({ pageParam }) => fetchComments(postId, pageParam)\n        : skipToken,\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }\n})\n</script>\n\n<template>\n  <span v-if=\"props.postId == null\">Select a post</span>\n  <span v-else-if=\"isLoading\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <ul v-else>\n    <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n      <li v-for=\"comment in page.comments\" :key=\"comment.id\">{{ comment.text }}</li>\n    </template>\n  </ul>\n</template>","lang":"vue"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-4","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefOrGetter"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/UseInfiniteQueryOptions.md","children":[{"type":"inlineCode","value":"UseInfiniteQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", plain value, or reactive getter resolving to the "},{"type":"link","href":"../type-aliases/UseInfiniteQueryOptions.md","children":[{"type":"text","value":"UseInfiniteQueryOptions"}]},{"type":"text","value":" to\nuse."}]},{"type":"heading","depth":3,"id":"queryclient-4","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseInfiniteQueryReturnType.md","children":[{"type":"inlineCode","value":"UseInfiniteQueryReturnType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The same properties as "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with the addition of "},{"type":"inlineCode","value":"fetchNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"fetchPreviousPage"},{"type":"text","value":",\n"},{"type":"inlineCode","value":"hasNextPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"hasPreviousPage"},{"type":"text","value":", "},{"type":"inlineCode","value":"isFetchingNextPage"},{"type":"text","value":", and "},{"type":"inlineCode","value":"isFetchingPreviousPage"},{"type":"text","value":"."}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tqueryfndata","text":"TQueryFnData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tdata","text":"TData","level":4},{"id":"tquerykey","text":"TQueryKey","level":4},{"id":"tpageparam","text":"TPageParam","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"queryclient","text":"queryClient?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"remarks","text":"Remarks","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tqueryfndata-2","text":"TQueryFnData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tdata-2","text":"TData","level":4},{"id":"tquerykey-2","text":"TQueryKey","level":4},{"id":"tpageparam-2","text":"TPageParam","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"queryclient-2","text":"queryClient?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"remarks-2","text":"Remarks","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tqueryfndata-3","text":"TQueryFnData","level":4},{"id":"terror-3","text":"TError","level":4},{"id":"tdata-3","text":"TData","level":4},{"id":"tquerykey-3","text":"TQueryKey","level":4},{"id":"tpageparam-3","text":"TPageParam","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"options-3","text":"options","level":4},{"id":"queryclient-3","text":"queryClient?","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"examples-2","text":"Examples","level":3},{"id":"parameters-4","text":"Parameters","level":2},{"id":"options-4","text":"options","level":3},{"id":"queryclient-4","text":"queryClient?","level":3},{"id":"returns-4","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UseInfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\n```\n\n- [`MaybeRefOrGetter` → `UseInfiniteQueryReturnType`](#call-signature-1): The options for `useInfiniteQuery` are identical to `useQuery`, with the addition of `initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n- [`MaybeRefOrGetter` → `UseInfiniteQueryReturnType`](#call-signature-2): The options for `useInfiniteQuery` are identical to `useQuery`, with the addition of `initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n- [`MaybeRefOrGetter` → `UseInfiniteQueryReturnType`](#call-signature-3): Fallback overload for options whose `initialData` presence isn't statically known — for example, a `ref`/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other overloads when possible, since they infer whether `data` can be `undefined` from `initialData` directly.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useInfiniteQuery.ts:127](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useInfiniteQuery.ts#L127)\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` for the array itself, or `ref`s and reactive getters as\nindividual entries — the array itself can't be a bare getter.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n`MaybeRefOrGetter`\\<[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nThe [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`, with `initialData` set.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryReturnType`](../type-aliases/UseInfiniteQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.value.pages` and\n`data.value.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\n// `data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n// list stays visible alongside the error.\nconst { data, isError, error } = useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  initialData: { pages: [], pageParams: [] },\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <ul>\n    <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n      <li v-for=\"project in page.projects\" :key=\"project.id\">{{ project.name }}</li>\n    </template>\n  </ul>\n</template>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useInfiniteQuery.ts:258](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useInfiniteQuery.ts#L258)\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` for the array itself, or `ref`s and reactive getters as\nindividual entries — the array itself can't be a bare getter.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n`MaybeRefOrGetter`\\<[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nThe [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryReturnType`](../type-aliases/UseInfiniteQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.value.pages` and\n`data.value.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### Examples\n\nFetching the next page from a \"Load More\" button click:\n```vue\n<script setup lang=\"ts\">\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\nconst {\n  data,\n  isPending,\n  isError,\n  error,\n  fetchNextPage,\n  hasNextPage,\n  isFetching,\n  isFetchingNextPage,\n} = useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n</script>\n\n<template>\n  <span v-if=\"isPending\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <template v-else>\n    <ul>\n      <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n        <li v-for=\"project in page.projects\" :key=\"project.id\">{{ project.name }}</li>\n      </template>\n    </ul>\n    <button @click=\"fetchNextPage()\" :disabled=\"!hasNextPage || isFetching\">\n      {{ isFetchingNextPage ? 'Loading more...' : hasNextPage ? 'Load More' : 'Nothing more to load' }}\n    </button>\n  </template>\n</template>\n```\n\nFetching the next page automatically as the user scrolls, using an `IntersectionObserver` on a\nsentinel element after the list:\n```vue\n<script setup lang=\"ts\">\nimport { onUnmounted, ref, watch } from 'vue'\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\nconst {\n  data,\n  isPending,\n  isError,\n  error,\n  fetchNextPage,\n  hasNextPage,\n  isFetching,\n  isFetchingNextPage,\n} = useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n\nconst sentinel = ref<HTMLElement>()\nlet observer: IntersectionObserver | undefined\n\nwatch(sentinel, (el) => {\n  observer?.disconnect()\n  if (el == null) return\n\n  observer = new IntersectionObserver(([entry]) => {\n    if (entry?.isIntersecting && hasNextPage.value && !isFetching.value) {\n      fetchNextPage()\n    }\n  })\n  observer.observe(el)\n})\n\nonUnmounted(() => observer?.disconnect())\n</script>\n\n<template>\n  <span v-if=\"isPending\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <template v-else>\n    <ul>\n      <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n        <li v-for=\"project in page.projects\" :key=\"project.id\">{{ project.name }}</li>\n      </template>\n    </ul>\n    <div ref=\"sentinel\">{{ isFetchingNextPage ? 'Loading more...' : '' }}</div>\n  </template>\n</template>\n```\n\n<a id=\"call-signature-3\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UseInfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useInfiniteQuery.ts:351](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useInfiniteQuery.ts#L351)\n\nFallback overload for options whose `initialData` presence isn't statically known — for example, a\n`ref`/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other\noverloads when possible, since they infer whether `data` can be `undefined` from `initialData` directly.\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` for the array itself, or `ref`s and reactive getters as\nindividual entries — the array itself can't be a bare getter.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n`MaybeRefOrGetter`\\<[`UseInfiniteQueryOptions`](../type-aliases/UseInfiniteQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the [UseInfiniteQueryOptions](../type-aliases/UseInfiniteQueryOptions.md) to\nuse.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryReturnType`](../type-aliases/UseInfiniteQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`.\n\n### Examples\n\nPassing a whole-options getter so `maxPages` reacts to a setting stored elsewhere, not just `queryKey`:\n```vue\n<script setup lang=\"ts\">\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ projectId: number; maxPages: number }>()\n\nconst { data } = useInfiniteQuery(() => ({\n  queryKey: ['project', props.projectId, 'issues'],\n  queryFn: ({ pageParam }) => fetchIssues(props.projectId, pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  maxPages: props.maxPages,\n}))\n</script>\n\n<template>\n  <template v-for=\"page in data?.pages\" :key=\"page.nextId\">\n    <li v-for=\"issue in page.issues\" :key=\"issue.id\">{{ issue.title }}</li>\n  </template>\n</template>\n```\n\nA query that's disabled, type-safe, until `postId` is set — pass `skipToken` as `queryFn` instead of\nsetting `enabled: false`. This requires a whole-options getter: `queryFn` isn't itself reactive, so the\ngetter is what re-evaluates it on every change to `props.postId`:\n```vue\n<script setup lang=\"ts\">\nimport { skipToken, useInfiniteQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: string | undefined }>()\n\n// Use `isLoading`, not `isPending`, so the loading state doesn't show while the query is disabled.\nconst { data, isLoading, isError, error } = useInfiniteQuery(() => {\n  const postId = props.postId\n  return {\n    queryKey: ['post', postId, 'comments'],\n    queryFn:\n      postId != null\n        ? ({ pageParam }) => fetchComments(postId, pageParam)\n        : skipToken,\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }\n})\n</script>\n\n<template>\n  <span v-if=\"props.postId == null\">Select a post</span>\n  <span v-else-if=\"isLoading\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <ul v-else>\n    <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n      <li v-for=\"comment in page.comments\" :key=\"comment.id\">{{ comment.text }}</li>\n    </template>\n  </ul>\n</template>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n`MaybeRefOrGetter`\\<[`UseInfiniteQueryOptions`](../type-aliases/UseInfiniteQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the [UseInfiniteQueryOptions](../type-aliases/UseInfiniteQueryOptions.md) to\nuse.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UseInfiniteQueryReturnType`](../type-aliases/UseInfiniteQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`.\n","originalRawMarkdown":"---\nid: useInfiniteQuery\ntitle: useInfiniteQuery\nredirect_from:\n  - framework/vue/reference/useInfiniteQuery\n---\n\n## Overview\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UseInfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\n```\n\n- [`MaybeRefOrGetter` → `UseInfiniteQueryReturnType`](#call-signature-1): The options for `useInfiniteQuery` are identical to `useQuery`, with the addition of `initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n- [`MaybeRefOrGetter` → `UseInfiniteQueryReturnType`](#call-signature-2): The options for `useInfiniteQuery` are identical to `useQuery`, with the addition of `initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n- [`MaybeRefOrGetter` → `UseInfiniteQueryReturnType`](#call-signature-3): Fallback overload for options whose `initialData` presence isn't statically known — for example, a `ref`/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other overloads when possible, since they infer whether `data` can be `undefined` from `initialData` directly.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<DefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useInfiniteQuery.ts:127](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useInfiniteQuery.ts#L127)\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` for the array itself, or `ref`s and reactive getters as\nindividual entries — the array itself can't be a bare getter.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n`MaybeRefOrGetter`\\<[`DefinedInitialDataInfiniteOptions`](../type-aliases/DefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nThe [DefinedInitialDataInfiniteOptions](../type-aliases/DefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`, with `initialData` set.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryReturnType`](../type-aliases/UseInfiniteQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.value.pages` and\n`data.value.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\n// `data` is never `undefined`, thanks to `initialData` — even if a refetch fails, so the\n// list stays visible alongside the error.\nconst { data, isError, error } = useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  initialData: { pages: [], pageParams: [] },\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <ul>\n    <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n      <li v-for=\"project in page.projects\" :key=\"project.id\">{{ project.name }}</li>\n    </template>\n  </ul>\n</template>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UndefinedInitialDataInfiniteOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useInfiniteQuery.ts:258](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useInfiniteQuery.ts#L258)\n\nThe options for `useInfiniteQuery` are identical to `useQuery`, with the addition of\n`initialPageParam`, `getNextPageParam`, `getPreviousPageParam`, and `maxPages`.\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` for the array itself, or `ref`s and reactive getters as\nindividual entries — the array itself can't be a bare getter.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n`MaybeRefOrGetter`\\<[`UndefinedInitialDataInfiniteOptions`](../type-aliases/UndefinedInitialDataInfiniteOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nThe [UndefinedInitialDataInfiniteOptions](../type-aliases/UndefinedInitialDataInfiniteOptions.md) to use — everything you can pass to\n`useInfiniteQuery`.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryReturnType`](../type-aliases/UseInfiniteQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`. `data.value.pages` and\n`data.value.pageParams` are also added, as long as a `select` doesn't change `TData` away from its default\n`InfiniteData<TQueryFnData>` shape.\n\n### Remarks\n\nKeep in mind that imperative fetch calls, such as `fetchNextPage`, may interfere with the default\nrefetch behavior, resulting in outdated data. Make sure to call these functions only in response to user\nactions, or add conditions like `hasNextPage && !isFetching`.\n\n### Examples\n\nFetching the next page from a \"Load More\" button click:\n```vue\n<script setup lang=\"ts\">\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\nconst {\n  data,\n  isPending,\n  isError,\n  error,\n  fetchNextPage,\n  hasNextPage,\n  isFetching,\n  isFetchingNextPage,\n} = useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n</script>\n\n<template>\n  <span v-if=\"isPending\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <template v-else>\n    <ul>\n      <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n        <li v-for=\"project in page.projects\" :key=\"project.id\">{{ project.name }}</li>\n      </template>\n    </ul>\n    <button @click=\"fetchNextPage()\" :disabled=\"!hasNextPage || isFetching\">\n      {{ isFetchingNextPage ? 'Loading more...' : hasNextPage ? 'Load More' : 'Nothing more to load' }}\n    </button>\n  </template>\n</template>\n```\n\nFetching the next page automatically as the user scrolls, using an `IntersectionObserver` on a\nsentinel element after the list:\n```vue\n<script setup lang=\"ts\">\nimport { onUnmounted, ref, watch } from 'vue'\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\nconst {\n  data,\n  isPending,\n  isError,\n  error,\n  fetchNextPage,\n  hasNextPage,\n  isFetching,\n  isFetchingNextPage,\n} = useInfiniteQuery({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n\nconst sentinel = ref<HTMLElement>()\nlet observer: IntersectionObserver | undefined\n\nwatch(sentinel, (el) => {\n  observer?.disconnect()\n  if (el == null) return\n\n  observer = new IntersectionObserver(([entry]) => {\n    if (entry?.isIntersecting && hasNextPage.value && !isFetching.value) {\n      fetchNextPage()\n    }\n  })\n  observer.observe(el)\n})\n\nonUnmounted(() => observer?.disconnect())\n</script>\n\n<template>\n  <span v-if=\"isPending\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <template v-else>\n    <ul>\n      <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n        <li v-for=\"project in page.projects\" :key=\"project.id\">{{ project.name }}</li>\n      </template>\n    </ul>\n    <div ref=\"sentinel\">{{ isFetchingNextPage ? 'Loading more...' : '' }}</div>\n  </template>\n</template>\n```\n\n<a id=\"call-signature-3\"></a>\n\n## Call Signature\n\n```ts\nfunction useInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<UseInfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>, queryClient?: QueryClient): UseInfiniteQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useInfiniteQuery.ts:351](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useInfiniteQuery.ts#L351)\n\nFallback overload for options whose `initialData` presence isn't statically known — for example, a\n`ref`/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other\noverloads when possible, since they infer whether `data` can be `undefined` from `initialData` directly.\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` for the array itself, or `ref`s and reactive getters as\nindividual entries — the array itself can't be a bare getter.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n#### TPageParam\n\n`TPageParam` = `unknown`\n\n### Parameters\n\n#### options\n\n`MaybeRefOrGetter`\\<[`UseInfiniteQueryOptions`](../type-aliases/UseInfiniteQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the [UseInfiniteQueryOptions](../type-aliases/UseInfiniteQueryOptions.md) to\nuse.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseInfiniteQueryReturnType`](../type-aliases/UseInfiniteQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`.\n\n### Examples\n\nPassing a whole-options getter so `maxPages` reacts to a setting stored elsewhere, not just `queryKey`:\n```vue\n<script setup lang=\"ts\">\nimport { useInfiniteQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ projectId: number; maxPages: number }>()\n\nconst { data } = useInfiniteQuery(() => ({\n  queryKey: ['project', props.projectId, 'issues'],\n  queryFn: ({ pageParam }) => fetchIssues(props.projectId, pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n  maxPages: props.maxPages,\n}))\n</script>\n\n<template>\n  <template v-for=\"page in data?.pages\" :key=\"page.nextId\">\n    <li v-for=\"issue in page.issues\" :key=\"issue.id\">{{ issue.title }}</li>\n  </template>\n</template>\n```\n\nA query that's disabled, type-safe, until `postId` is set — pass `skipToken` as `queryFn` instead of\nsetting `enabled: false`. This requires a whole-options getter: `queryFn` isn't itself reactive, so the\ngetter is what re-evaluates it on every change to `props.postId`:\n```vue\n<script setup lang=\"ts\">\nimport { skipToken, useInfiniteQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: string | undefined }>()\n\n// Use `isLoading`, not `isPending`, so the loading state doesn't show while the query is disabled.\nconst { data, isLoading, isError, error } = useInfiniteQuery(() => {\n  const postId = props.postId\n  return {\n    queryKey: ['post', postId, 'comments'],\n    queryFn:\n      postId != null\n        ? ({ pageParam }) => fetchComments(postId, pageParam)\n        : skipToken,\n    initialPageParam: 0,\n    getNextPageParam: (lastPage) => lastPage.nextId,\n  }\n})\n</script>\n\n<template>\n  <span v-if=\"props.postId == null\">Select a post</span>\n  <span v-else-if=\"isLoading\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <ul v-else>\n    <template v-for=\"page in data.pages\" :key=\"page.nextId\">\n      <li v-for=\"comment in page.comments\" :key=\"comment.id\">{{ comment.text }}</li>\n    </template>\n  </ul>\n</template>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n`MaybeRefOrGetter`\\<[`UseInfiniteQueryOptions`](../type-aliases/UseInfiniteQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the [UseInfiniteQueryOptions](../type-aliases/UseInfiniteQueryOptions.md) to\nuse.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UseInfiniteQueryReturnType`](../type-aliases/UseInfiniteQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe same properties as `useQuery`, with the addition of `fetchNextPage`, `fetchPreviousPage`,\n`hasNextPage`, `hasPreviousPage`, `isFetchingNextPage`, and `isFetchingPreviousPage`.\n"}
