queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Ref"},{"type":"text","value":"<"},{"type":"inlineCode","value":"number"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ref"},{"type":"text","value":" to the "},{"type":"inlineCode","value":"number"},{"type":"text","value":" of the queries that your application is currently loading or fetching in\nthe background."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useIsFetching } from '@tanstack/vue-query'\n\n// How many queries matching the posts prefix are fetching?\nconst isFetchingPosts = useIsFetching({ queryKey: ['posts'] })\n</script>\n\n<template>\n  <span v-if=\"isFetchingPosts\">Refreshing posts...</span>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"A global loading indicator for any query fetching in the background, not just the ones on screen:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useIsFetching } from '@tanstack/vue-query'\n\nconst isFetching = useIsFetching()\n</script>\n\n<template>\n  <div v-if=\"isFetching\">Queries are fetching in the background...</div>\n</template>","lang":"vue"}],"headings":[{"id":"parameters","text":"Parameters","level":2},{"id":"fetchingfilters","text":"fetchingFilters?","level":3},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useIsFetching(fetchingFilters?: UseIsFetchingFilters, queryClient?: QueryClient): Ref<number>;\n```\n\nDefined in: [packages/vue-query/src/useIsFetching.ts:54](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useIsFetching.ts#L54)\n\nThe `useIsFetching` composable returns a `ref` to the `number` of the queries that your application is\nloading or fetching in the background (useful for app-wide loading indicators).\n\n`fetchingFilters` may be a plain object, `MaybeRefDeep`, or a reactive getter (`() => ({ ... })`) — pass a\ngetter if the filters themselves depend on other reactive state.\n\n## Parameters\n\n### fetchingFilters?\n\n[`UseIsFetchingFilters`](../type-aliases/UseIsFetchingFilters.md) = `{}`\n\nThe [QueryFilters](../interfaces/QueryFilters.md) to narrow down the matched queries.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n`Ref`\\<`number`\\>\n\nA `ref` to the `number` of the queries that your application is currently loading or fetching in\nthe background.\n\n## Examples\n\n```vue\n<script setup lang=\"ts\">\nimport { useIsFetching } from '@tanstack/vue-query'\n\n// How many queries matching the posts prefix are fetching?\nconst isFetchingPosts = useIsFetching({ queryKey: ['posts'] })\n</script>\n\n<template>\n  <span v-if=\"isFetchingPosts\">Refreshing posts...</span>\n</template>\n```\n\nA global loading indicator for any query fetching in the background, not just the ones on screen:\n```vue\n<script setup lang=\"ts\">\nimport { useIsFetching } from '@tanstack/vue-query'\n\nconst isFetching = useIsFetching()\n</script>\n\n<template>\n  <div v-if=\"isFetching\">Queries are fetching in the background...</div>\n</template>\n```\n","originalRawMarkdown":"---\nid: useIsFetching\ntitle: useIsFetching\nredirect_from:\n  - framework/vue/reference/useIsFetching\n---\n\n```ts\nfunction useIsFetching(fetchingFilters?: UseIsFetchingFilters, queryClient?: QueryClient): Ref<number>;\n```\n\nDefined in: [packages/vue-query/src/useIsFetching.ts:54](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useIsFetching.ts#L54)\n\nThe `useIsFetching` composable returns a `ref` to the `number` of the queries that your application is\nloading or fetching in the background (useful for app-wide loading indicators).\n\n`fetchingFilters` may be a plain object, `MaybeRefDeep`, or a reactive getter (`() => ({ ... })`) — pass a\ngetter if the filters themselves depend on other reactive state.\n\n## Parameters\n\n### fetchingFilters?\n\n[`UseIsFetchingFilters`](../type-aliases/UseIsFetchingFilters.md) = `{}`\n\nThe [QueryFilters](../interfaces/QueryFilters.md) to narrow down the matched queries.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n`Ref`\\<`number`\\>\n\nA `ref` to the `number` of the queries that your application is currently loading or fetching in\nthe background.\n\n## Examples\n\n```vue\n<script setup lang=\"ts\">\nimport { useIsFetching } from '@tanstack/vue-query'\n\n// How many queries matching the posts prefix are fetching?\nconst isFetchingPosts = useIsFetching({ queryKey: ['posts'] })\n</script>\n\n<template>\n  <span v-if=\"isFetchingPosts\">Refreshing posts...</span>\n</template>\n```\n\nA global loading indicator for any query fetching in the background, not just the ones on screen:\n```vue\n<script setup lang=\"ts\">\nimport { useIsFetching } from '@tanstack/vue-query'\n\nconst isFetching = useIsFetching()\n</script>\n\n<template>\n  <div v-if=\"isFetching\">Queries are fetching in the background...</div>\n</template>\n```\n"}
