{"document":{"type":"root","children":[{"type":"code","value":"function useMutation<TData, TError, TVariables, TOnMutateResult>(options: UseMutationOptions<TData, TError, TVariables, TOnMutateResult>, queryClient?: QueryClient): UseMutationReturnType<TData, TError, TVariables, TOnMutateResult>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/useMutation.ts#L233","children":[{"type":"text","value":"packages/vue-query/src/useMutation.ts:233"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n"},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":" is the composable for that."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" may be a plain object, a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", or a reactive getter ("},{"type":"inlineCode","value":"() => ({ ... })"},{"type":"text","value":") — pass a getter\nif the options themselves depend on other reactive state."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":3,"id":"tvariables","children":[{"type":"text","value":"TVariables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TVariables"},{"type":"text","value":" = "},{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":3,"id":"tonmutateresult","children":[{"type":"text","value":"TOnMutateResult"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseMutationOptions.md","children":[{"type":"inlineCode","value":"UseMutationOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/UseMutationOptions.md","children":[{"type":"text","value":"UseMutationOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseMutationReturnType.md","children":[{"type":"inlineCode","value":"UseMutationReturnType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TVariables"},{"type":"text","value":", "},{"type":"inlineCode","value":"TOnMutateResult"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"mutate"},{"type":"text","value":"/"},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" also accept per-call "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onError"},{"type":"text","value":"/"},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" callbacks as a second\nargument, useful for triggering call-site side effects (e.g. navigation) without coupling them to the shared\nmutation definition. Hook-level callbacks (passed to "},{"type":"inlineCode","value":"options"},{"type":"text","value":") fire for every mutation; per-call\ncallbacks fire only for the latest call you've made."}]},{"type":"heading","depth":2,"id":"see","children":[{"type":"text","value":"See"}]},{"type":"paragraph","children":[{"type":"link","href":"mutationOptions.md","children":[{"type":"text","value":"mutationOptions"}]},{"type":"text","value":" to share these options across multiple "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":" call sites, or to look\nthe mutation up elsewhere via its "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":" (e.g. with "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n\nfunction onAdd() {\n  addMutation.mutate('Item', {\n    onError: (error) => console.error('Failed to add item:', error),\n  })\n}\n</script>\n\n<template>\n  <button @click=\"onAdd\">Add</button>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Rendering the mutation's own state, rather than just firing it off:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n</script>\n\n<template>\n  <div v-if=\"addMutation.isPending.value\">Adding todo...</div>\n  <div v-else>\n    <div v-if=\"addMutation.isError.value\">An error occurred: {{ addMutation.error.value.message }}</div>\n    <button @click=\"addMutation.mutate('Item')\">Add</button>\n  </div>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Optimistic update via "},{"type":"inlineCode","value":"onMutate"},{"type":"text","value":", rolling back on "},{"type":"inlineCode","value":"onError"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onMutate: async (newTodo: string) => {\n    await queryClient.cancelQueries({ queryKey: ['todos'] })\n    const previousTodos = queryClient.getQueryData<Array<string>>(['todos'])\n\n    queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n      ...(old ?? []),\n      newTodo,\n    ])\n\n    // Passed to `onError` as `onMutateResult` if the mutation fails.\n    return { previousTodos }\n  },\n  onError: (_err, _newTodo, onMutateResult) => {\n    queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n  },\n  onSettled: () => {\n    queryClient.invalidateQueries({ queryKey: ['todos'] })\n  },\n})\n</script>\n\n<template>\n  <button @click=\"addMutation.mutate('Item')\">Add</button>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Callbacks passed per call to "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" only fire for the last call — "},{"type":"inlineCode","value":"mutateAsync"},{"type":"text","value":" gives you a\npromise per call instead, so you can wait for all of them when they succeed:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n\nasync function handleAddAll(todos: Array<string>) {\n  try {\n    await Promise.all(todos.map((todo) => addMutation.mutateAsync(todo)))\n  } catch (error) {\n    console.error('Failed to add todos:', error)\n  }\n}\n</script>\n\n<template>\n  <button @click=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"If some of the mutations above can fail independently of the others, and you want to know which ones\ndid — rather than losing that information the moment the first one rejects — swap "},{"type":"inlineCode","value":"Promise.all"},{"type":"text","value":" for\n"},{"type":"inlineCode","value":"Promise.allSettled"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n\nasync function handleAddAll(todos: Array<string>) {\n  const addResults = await Promise.allSettled(\n    todos.map((todo) => addMutation.mutateAsync(todo)),\n  )\n\n  addResults.forEach((addResult, index) => {\n    if (addResult.status === 'rejected') {\n      console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n    }\n  })\n}\n</script>\n\n<template>\n  <button @click=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n</template>","lang":"vue"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tvariables","text":"TVariables","level":3},{"id":"tonmutateresult","text":"TOnMutateResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"see","text":"See","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useMutation<TData, TError, TVariables, TOnMutateResult>(options: UseMutationOptions<TData, TError, TVariables, TOnMutateResult>, queryClient?: QueryClient): UseMutationReturnType<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/vue-query/src/useMutation.ts:233](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useMutation.ts#L233)\n\nUnlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n`useMutation` is the composable for that.\n\n`options` may be a plain object, a `ref`, or a reactive getter (`() => ({ ... })`) — pass a getter\nif the options themselves depend on other reactive state.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Parameters\n\n### options\n\n[`UseMutationOptions`](../type-aliases/UseMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nThe [UseMutationOptions](../type-aliases/UseMutationOptions.md) to use — everything you can pass to `useMutation`.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n[`UseMutationReturnType`](../type-aliases/UseMutationReturnType.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\n`mutate`/`mutateAsync` also accept per-call `onSuccess`/`onError`/`onSettled` callbacks as a second\nargument, useful for triggering call-site side effects (e.g. navigation) without coupling them to the shared\nmutation definition. Hook-level callbacks (passed to `options`) fire for every mutation; per-call\ncallbacks fire only for the latest call you've made.\n\n## See\n\n[mutationOptions](mutationOptions.md) to share these options across multiple `useMutation` call sites, or to look\nthe mutation up elsewhere via its `mutationKey` (e.g. with `useMutationState`).\n\n## Examples\n\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n\nfunction onAdd() {\n  addMutation.mutate('Item', {\n    onError: (error) => console.error('Failed to add item:', error),\n  })\n}\n</script>\n\n<template>\n  <button @click=\"onAdd\">Add</button>\n</template>\n```\n\nRendering the mutation's own state, rather than just firing it off:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n</script>\n\n<template>\n  <div v-if=\"addMutation.isPending.value\">Adding todo...</div>\n  <div v-else>\n    <div v-if=\"addMutation.isError.value\">An error occurred: {{ addMutation.error.value.message }}</div>\n    <button @click=\"addMutation.mutate('Item')\">Add</button>\n  </div>\n</template>\n```\n\nOptimistic update via `onMutate`, rolling back on `onError`:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onMutate: async (newTodo: string) => {\n    await queryClient.cancelQueries({ queryKey: ['todos'] })\n    const previousTodos = queryClient.getQueryData<Array<string>>(['todos'])\n\n    queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n      ...(old ?? []),\n      newTodo,\n    ])\n\n    // Passed to `onError` as `onMutateResult` if the mutation fails.\n    return { previousTodos }\n  },\n  onError: (_err, _newTodo, onMutateResult) => {\n    queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n  },\n  onSettled: () => {\n    queryClient.invalidateQueries({ queryKey: ['todos'] })\n  },\n})\n</script>\n\n<template>\n  <button @click=\"addMutation.mutate('Item')\">Add</button>\n</template>\n```\n\nCallbacks passed per call to `mutate` only fire for the last call — `mutateAsync` gives you a\npromise per call instead, so you can wait for all of them when they succeed:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n\nasync function handleAddAll(todos: Array<string>) {\n  try {\n    await Promise.all(todos.map((todo) => addMutation.mutateAsync(todo)))\n  } catch (error) {\n    console.error('Failed to add todos:', error)\n  }\n}\n</script>\n\n<template>\n  <button @click=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n</template>\n```\n\nIf some of the mutations above can fail independently of the others, and you want to know which ones\ndid — rather than losing that information the moment the first one rejects — swap `Promise.all` for\n`Promise.allSettled`:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n\nasync function handleAddAll(todos: Array<string>) {\n  const addResults = await Promise.allSettled(\n    todos.map((todo) => addMutation.mutateAsync(todo)),\n  )\n\n  addResults.forEach((addResult, index) => {\n    if (addResult.status === 'rejected') {\n      console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n    }\n  })\n}\n</script>\n\n<template>\n  <button @click=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n</template>\n```\n","originalRawMarkdown":"---\nid: useMutation\ntitle: useMutation\nredirect_from:\n  - framework/vue/reference/useMutation\n---\n\n```ts\nfunction useMutation<TData, TError, TVariables, TOnMutateResult>(options: UseMutationOptions<TData, TError, TVariables, TOnMutateResult>, queryClient?: QueryClient): UseMutationReturnType<TData, TError, TVariables, TOnMutateResult>;\n```\n\nDefined in: [packages/vue-query/src/useMutation.ts:233](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useMutation.ts#L233)\n\nUnlike queries, mutations are typically used to create/update/delete data or perform server side-effects.\n`useMutation` is the composable for that.\n\n`options` may be a plain object, a `ref`, or a reactive getter (`() => ({ ... })`) — pass a getter\nif the options themselves depend on other reactive state.\n\n## Type Parameters\n\n### TData\n\n`TData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TVariables\n\n`TVariables` = `void`\n\n### TOnMutateResult\n\n`TOnMutateResult` = `unknown`\n\n## Parameters\n\n### options\n\n[`UseMutationOptions`](../type-aliases/UseMutationOptions.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\nThe [UseMutationOptions](../type-aliases/UseMutationOptions.md) to use — everything you can pass to `useMutation`.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n[`UseMutationReturnType`](../type-aliases/UseMutationReturnType.md)\\<`TData`, `TError`, `TVariables`, `TOnMutateResult`\\>\n\n`mutate`/`mutateAsync` also accept per-call `onSuccess`/`onError`/`onSettled` callbacks as a second\nargument, useful for triggering call-site side effects (e.g. navigation) without coupling them to the shared\nmutation definition. Hook-level callbacks (passed to `options`) fire for every mutation; per-call\ncallbacks fire only for the latest call you've made.\n\n## See\n\n[mutationOptions](mutationOptions.md) to share these options across multiple `useMutation` call sites, or to look\nthe mutation up elsewhere via its `mutationKey` (e.g. with `useMutationState`).\n\n## Examples\n\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n\nfunction onAdd() {\n  addMutation.mutate('Item', {\n    onError: (error) => console.error('Failed to add item:', error),\n  })\n}\n</script>\n\n<template>\n  <button @click=\"onAdd\">Add</button>\n</template>\n```\n\nRendering the mutation's own state, rather than just firing it off:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n</script>\n\n<template>\n  <div v-if=\"addMutation.isPending.value\">Adding todo...</div>\n  <div v-else>\n    <div v-if=\"addMutation.isError.value\">An error occurred: {{ addMutation.error.value.message }}</div>\n    <button @click=\"addMutation.mutate('Item')\">Add</button>\n  </div>\n</template>\n```\n\nOptimistic update via `onMutate`, rolling back on `onError`:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onMutate: async (newTodo: string) => {\n    await queryClient.cancelQueries({ queryKey: ['todos'] })\n    const previousTodos = queryClient.getQueryData<Array<string>>(['todos'])\n\n    queryClient.setQueryData<Array<string>>(['todos'], (old) => [\n      ...(old ?? []),\n      newTodo,\n    ])\n\n    // Passed to `onError` as `onMutateResult` if the mutation fails.\n    return { previousTodos }\n  },\n  onError: (_err, _newTodo, onMutateResult) => {\n    queryClient.setQueryData(['todos'], onMutateResult?.previousTodos)\n  },\n  onSettled: () => {\n    queryClient.invalidateQueries({ queryKey: ['todos'] })\n  },\n})\n</script>\n\n<template>\n  <button @click=\"addMutation.mutate('Item')\">Add</button>\n</template>\n```\n\nCallbacks passed per call to `mutate` only fire for the last call — `mutateAsync` gives you a\npromise per call instead, so you can wait for all of them when they succeed:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n\nasync function handleAddAll(todos: Array<string>) {\n  try {\n    await Promise.all(todos.map((todo) => addMutation.mutateAsync(todo)))\n  } catch (error) {\n    console.error('Failed to add todos:', error)\n  }\n}\n</script>\n\n<template>\n  <button @click=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n</template>\n```\n\nIf some of the mutations above can fail independently of the others, and you want to know which ones\ndid — rather than losing that information the moment the first one rejects — swap `Promise.all` for\n`Promise.allSettled`:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient()\n\nconst addMutation = useMutation({\n  mutationFn: addTodo,\n  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['todos'] }),\n})\n\nasync function handleAddAll(todos: Array<string>) {\n  const addResults = await Promise.allSettled(\n    todos.map((todo) => addMutation.mutateAsync(todo)),\n  )\n\n  addResults.forEach((addResult, index) => {\n    if (addResult.status === 'rejected') {\n      console.error(`Failed to add \"${todos[index]}\":`, addResult.reason)\n    }\n  })\n}\n</script>\n\n<template>\n  <button @click=\"handleAddAll(['Todo 1', 'Todo 2', 'Todo 3'])\">Add all</button>\n</template>\n```\n"}
