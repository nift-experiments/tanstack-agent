,"value":"Error"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"tmutation","children":[{"type":"text","value":"TMutation"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TMutation"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../classes/Mutation.md","children":[{"type":"inlineCode","value":"Mutation"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":"> = "},{"type":"inlineCode","value":"MutationTypeFromResult"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"text","value":"| "},{"type":"link","href":"../type-aliases/MutationStateOptions.md","children":[{"type":"inlineCode","value":"MutationStateOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TMutation"},{"type":"text","value":">\n| (() => "},{"type":"link","href":"../type-aliases/MutationStateOptions.md","children":[{"type":"inlineCode","value":"MutationStateOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":", "},{"type":"inlineCode","value":"TMutation"},{"type":"text","value":">)"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"filters"},{"type":"text","value":" to narrow down matched mutations, and an optional "},{"type":"inlineCode","value":"select"},{"type":"text","value":" to transform the\nmutation state."}]},{"type":"html","value":"<a id=\"options-properties\"></a>"},{"type":"heading","depth":4,"id":"options-properties","children":[{"type":"inlineCode","value":"options"},{"type":"text","value":" properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Built from "},{"type":"link","href":"../type-aliases/MutationStateOptions.md#properties","children":[{"type":"inlineCode","value":"MutationStateOptions"}]},{"type":"text","value":". See the type above for what it changes."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Readonly"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Ref"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TResult"},{"type":"text","value":"[]>>"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ref"},{"type":"text","value":" to an Array of whatever "},{"type":"inlineCode","value":"select"},{"type":"text","value":" returns for each matching mutation."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Get all variables of all running mutations:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useMutationState } from '@tanstack/vue-query'\n\nconst pendingVariables = useMutationState({\n  filters: { status: 'pending' },\n  select: (mutation) => mutation.state.variables,\n})\n</script>\n\n<template>{{ pendingVariables.length }} posts saving...</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Get all data for specific mutations via the "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useMutation, useMutationState } from '@tanstack/vue-query'\n\nconst mutationKey = ['posts']\n\n// Some mutation that we want to get the state for\nconst mutation = useMutation({\n  mutationKey,\n  mutationFn: createPosts,\n})\n\nconst savedPosts = useMutationState({\n  // this mutation key needs to match the mutation key of the given mutation (see above)\n  filters: { mutationKey, status: 'success' },\n  select: (mutation) => mutation.state.data,\n})\n</script>\n\n<template>\n  <button @click=\"mutation.mutate(['New Post'])\">\n    Create post ({{ savedPosts.length }} saved so far)\n  </button>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Access the latest successful mutation data via the "},{"type":"inlineCode","value":"mutationKey"},{"type":"text","value":". Each invocation of "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" adds a new\nentry to the mutation cache for "},{"type":"inlineCode","value":"gcTime"},{"type":"text","value":" milliseconds — with the "},{"type":"inlineCode","value":"status: 'success'"},{"type":"text","value":" filter below, check the\nlast item that "},{"type":"inlineCode","value":"useMutationState"},{"type":"text","value":" returns to get the latest successful invocation:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport { useMutationState } from '@tanstack/vue-query'\n\nconst savedPosts = useMutationState({\n  filters: { mutationKey: ['posts'], status: 'success' },\n  select: (mutation) => mutation.state.data,\n})\n\nconst latestSavedPost = computed(() => savedPosts.value[savedPosts.value.length - 1])\n</script>\n\n<template>{{ latestSavedPost ? 'Saved' : 'Nothing saved yet' }}</template>","lang":"vue"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tresult","text":"TResult","level":3},{"id":"tmutation","text":"TMutation","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options?","level":3},{"id":"options-properties","text":"options properties","level":4},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useMutationState<TResult, TMutation>(options?: \n  | MutationStateOptions<TResult, TMutation>\n| (() => MutationStateOptions<TResult, TMutation>), queryClient?: QueryClient): Readonly<Ref<TResult[]>>;\n```\n\nDefined in: [packages/vue-query/src/useMutationState.ts:210](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useMutationState.ts#L210)\n\n`useMutationState` is a composable that gives you access to all mutations in the `MutationCache`. You can\npass `filters` ([MutationFilters](../interfaces/MutationFilters.md)) to narrow down your mutations, and `select` to transform the\nmutation state.\n\n`options` may be a plain object or a reactive getter (`() => ({ ... })`) — pass a getter if the filters\nthemselves depend on other reactive state.\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n### TMutation\n\n`TMutation` *extends* [`Mutation`](../classes/Mutation.md)\\<`any`, `any`, `any`, `any`\\> = `MutationTypeFromResult`\\<`TResult`\\>\n\n## Parameters\n\n### options?\n\n  \\| [`MutationStateOptions`](../type-aliases/MutationStateOptions.md)\\<`TResult`, `TMutation`\\>\n  \\| (() => [`MutationStateOptions`](../type-aliases/MutationStateOptions.md)\\<`TResult`, `TMutation`\\>)\n\nThe `filters` to narrow down matched mutations, and an optional `select` to transform the\nmutation state.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationStateOptions`](../type-aliases/MutationStateOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n`Readonly`\\<`Ref`\\<`TResult`[]\\>\\>\n\nA `ref` to an Array of whatever `select` returns for each matching mutation.\n\n## Examples\n\nGet all variables of all running mutations:\n```vue\n<script setup lang=\"ts\">\nimport { useMutationState } from '@tanstack/vue-query'\n\nconst pendingVariables = useMutationState({\n  filters: { status: 'pending' },\n  select: (mutation) => mutation.state.variables,\n})\n</script>\n\n<template>{{ pendingVariables.length }} posts saving...</template>\n```\n\nGet all data for specific mutations via the `mutationKey`:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useMutationState } from '@tanstack/vue-query'\n\nconst mutationKey = ['posts']\n\n// Some mutation that we want to get the state for\nconst mutation = useMutation({\n  mutationKey,\n  mutationFn: createPosts,\n})\n\nconst savedPosts = useMutationState({\n  // this mutation key needs to match the mutation key of the given mutation (see above)\n  filters: { mutationKey, status: 'success' },\n  select: (mutation) => mutation.state.data,\n})\n</script>\n\n<template>\n  <button @click=\"mutation.mutate(['New Post'])\">\n    Create post ({{ savedPosts.length }} saved so far)\n  </button>\n</template>\n```\n\nAccess the latest successful mutation data via the `mutationKey`. Each invocation of `mutate` adds a new\nentry to the mutation cache for `gcTime` milliseconds — with the `status: 'success'` filter below, check the\nlast item that `useMutationState` returns to get the latest successful invocation:\n```vue\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport { useMutationState } from '@tanstack/vue-query'\n\nconst savedPosts = useMutationState({\n  filters: { mutationKey: ['posts'], status: 'success' },\n  select: (mutation) => mutation.state.data,\n})\n\nconst latestSavedPost = computed(() => savedPosts.value[savedPosts.value.length - 1])\n</script>\n\n<template>{{ latestSavedPost ? 'Saved' : 'Nothing saved yet' }}</template>\n```\n","originalRawMarkdown":"---\nid: useMutationState\ntitle: useMutationState\nredirect_from:\n  - framework/vue/reference/useMutationState\n---\n\n```ts\nfunction useMutationState<TResult, TMutation>(options?: \n  | MutationStateOptions<TResult, TMutation>\n| (() => MutationStateOptions<TResult, TMutation>), queryClient?: QueryClient): Readonly<Ref<TResult[]>>;\n```\n\nDefined in: [packages/vue-query/src/useMutationState.ts:210](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useMutationState.ts#L210)\n\n`useMutationState` is a composable that gives you access to all mutations in the `MutationCache`. You can\npass `filters` ([MutationFilters](../interfaces/MutationFilters.md)) to narrow down your mutations, and `select` to transform the\nmutation state.\n\n`options` may be a plain object or a reactive getter (`() => ({ ... })`) — pass a getter if the filters\nthemselves depend on other reactive state.\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\\<`unknown`, `Error`, `unknown`, `unknown`\\>\n\n### TMutation\n\n`TMutation` *extends* [`Mutation`](../classes/Mutation.md)\\<`any`, `any`, `any`, `any`\\> = `MutationTypeFromResult`\\<`TResult`\\>\n\n## Parameters\n\n### options?\n\n  \\| [`MutationStateOptions`](../type-aliases/MutationStateOptions.md)\\<`TResult`, `TMutation`\\>\n  \\| (() => [`MutationStateOptions`](../type-aliases/MutationStateOptions.md)\\<`TResult`, `TMutation`\\>)\n\nThe `filters` to narrow down matched mutations, and an optional `select` to transform the\nmutation state.\n\n<a id=\"options-properties\"></a>\n\n#### `options` properties\n\nBuilt from [`MutationStateOptions`](../type-aliases/MutationStateOptions.md#properties). See the type above for what it changes.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n`Readonly`\\<`Ref`\\<`TResult`[]\\>\\>\n\nA `ref` to an Array of whatever `select` returns for each matching mutation.\n\n## Examples\n\nGet all variables of all running mutations:\n```vue\n<script setup lang=\"ts\">\nimport { useMutationState } from '@tanstack/vue-query'\n\nconst pendingVariables = useMutationState({\n  filters: { status: 'pending' },\n  select: (mutation) => mutation.state.variables,\n})\n</script>\n\n<template>{{ pendingVariables.length }} posts saving...</template>\n```\n\nGet all data for specific mutations via the `mutationKey`:\n```vue\n<script setup lang=\"ts\">\nimport { useMutation, useMutationState } from '@tanstack/vue-query'\n\nconst mutationKey = ['posts']\n\n// Some mutation that we want to get the state for\nconst mutation = useMutation({\n  mutationKey,\n  mutationFn: createPosts,\n})\n\nconst savedPosts = useMutationState({\n  // this mutation key needs to match the mutation key of the given mutation (see above)\n  filters: { mutationKey, status: 'success' },\n  select: (mutation) => mutation.state.data,\n})\n</script>\n\n<template>\n  <button @click=\"mutation.mutate(['New Post'])\">\n    Create post ({{ savedPosts.length }} saved so far)\n  </button>\n</template>\n```\n\nAccess the latest successful mutation data via the `mutationKey`. Each invocation of `mutate` adds a new\nentry to the mutation cache for `gcTime` milliseconds — with the `status: 'success'` filter below, check the\nlast item that `useMutationState` returns to get the latest successful invocation:\n```vue\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport { useMutationState } from '@tanstack/vue-query'\n\nconst savedPosts = useMutationState({\n  filters: { mutationKey: ['posts'], status: 'success' },\n  select: (mutation) => mutation.state.data,\n})\n\nconst latestSavedPost = computed(() => savedPosts.value[savedPosts.value.length - 1])\n</script>\n\n<template>{{ latestSavedPost ? 'Saved' : 'Nothing saved yet' }}</template>\n```\n"}
