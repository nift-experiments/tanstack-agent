ype":"inlineCode","value":"undefined"},{"type":"text","value":" or "},{"type":"inlineCode","value":"null"},{"type":"text","value":" to indicate there is no next page available."}]},{"type":"paragraph","children":[{"type":"text","value":"The prefetch is skipped if the query already has any cached state — including a "},{"type":"inlineCode","value":"pending"},{"type":"text","value":"/"},{"type":"inlineCode","value":"error"},{"type":"text","value":" state left\nover from a previous attempt — so it won't refetch data that's already there or already in flight. It\nre-runs whenever a reactive dependency in "},{"type":"inlineCode","value":"options"},{"type":"text","value":" (built with "},{"type":"inlineCode","value":"infiniteQueryOptions"},{"type":"text","value":", for example) changes."}]},{"type":"paragraph","children":[{"type":"text","value":"Fire this during render, before a suspense boundary that wraps a component using "},{"type":"inlineCode","value":"useInfiniteQuery"},{"type":"text","value":"'s\n"},{"type":"inlineCode","value":"suspense()"},{"type":"text","value":" — see the "},{"type":"link","href":"https://tanstack.com/query/latest/docs/framework/vue/guides/suspense","children":[{"type":"text","value":"Suspense guide"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tqueryfndata","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"link","href":"../interfaces/InfiniteData.md","children":[{"type":"inlineCode","value":"InfiniteData"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"tquerykey","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":3,"id":"tpageparam","children":[{"type":"text","value":"TPageParam"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefOrGetter"},{"type":"text","value":"<"},{"type":"inlineCode","value":"MaybeRefDeep"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/UsePrefetchInfiniteQueryOptions.md","children":[{"type":"inlineCode","value":"UsePrefetchInfiniteQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":", "},{"type":"inlineCode","value":"TPageParam"},{"type":"text","value":">>>"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", plain value, or reactive getter resolving to the\n"},{"type":"link","href":"../type-aliases/UsePrefetchInfiniteQueryOptions.md","children":[{"type":"text","value":"UsePrefetchInfiniteQueryOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"queryClient.infiniteQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { infiniteQueryOptions, usePrefetchInfiniteQuery } from '@tanstack/vue-query'\nimport Projects from './Projects.vue'\n\nconst projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n\n// Fire the prefetch as soon as this component runs, before `Projects` mounts and calls `useInfiniteQuery`.\nusePrefetchInfiniteQuery(projectsOptions)\n</script>\n\n<template>\n  <Projects />\n</template>","lang":"vue"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tqueryfndata","text":"TQueryFnData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tquerykey","text":"TQueryKey","level":3},{"id":"tpageparam","text":"TPageParam","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction usePrefetchInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<MaybeRefDeep<UsePrefetchInfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>>, queryClient?: QueryClient): void;\n```\n\nDefined in: [packages/vue-query/src/usePrefetchInfiniteQuery.ts:100](https://github.com/TanStack/query/blob/main/packages/vue-query/src/usePrefetchInfiniteQuery.ts#L100)\n\n`usePrefetchInfiniteQuery` does not return anything — it fires a prefetch as a reactive side effect, useful\nfor kicking off a fetch ahead of the component that will actually render the data with `useInfiniteQuery`.\nYou can pass everything to `usePrefetchInfiniteQuery` that you can pass to `queryClient.infiniteQuery`,\nthough `queryKey`, `initialPageParam`, and `getNextPageParam` are always required, and `queryFn` is required\nunless a default query function has been defined.\n\n`getNextPageParam` receives both the last page of the infinite list of data and the full array of all pages,\nas well as pageParam information, and should return a single variable that will be passed to your query\nfunction as `context.pageParam`. Return `undefined` or `null` to indicate there is no next page available.\n\nThe prefetch is skipped if the query already has any cached state — including a `pending`/`error` state left\nover from a previous attempt — so it won't refetch data that's already there or already in flight. It\nre-runs whenever a reactive dependency in `options` (built with `infiniteQueryOptions`, for example) changes.\n\nFire this during render, before a suspense boundary that wraps a component using `useInfiniteQuery`'s\n`suspense()` — see the [Suspense guide](https://tanstack.com/query/latest/docs/framework/vue/guides/suspense).\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### TPageParam\n\n`TPageParam` = `unknown`\n\n## Parameters\n\n### options\n\n`MaybeRefOrGetter`\\<`MaybeRefDeep`\\<[`UsePrefetchInfiniteQueryOptions`](../type-aliases/UsePrefetchInfiniteQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the\n[UsePrefetchInfiniteQueryOptions](../type-aliases/UsePrefetchInfiniteQueryOptions.md) to use — everything you can pass to `queryClient.infiniteQuery`.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n`void`\n\n## Example\n\n```vue\n<script setup lang=\"ts\">\nimport { infiniteQueryOptions, usePrefetchInfiniteQuery } from '@tanstack/vue-query'\nimport Projects from './Projects.vue'\n\nconst projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n\n// Fire the prefetch as soon as this component runs, before `Projects` mounts and calls `useInfiniteQuery`.\nusePrefetchInfiniteQuery(projectsOptions)\n</script>\n\n<template>\n  <Projects />\n</template>\n```\n","originalRawMarkdown":"---\nid: usePrefetchInfiniteQuery\ntitle: usePrefetchInfiniteQuery\nredirect_from:\n  - framework/vue/reference/usePrefetchInfiniteQuery\n---\n\n```ts\nfunction usePrefetchInfiniteQuery<TQueryFnData, TError, TData, TQueryKey, TPageParam>(options: MaybeRefOrGetter<MaybeRefDeep<UsePrefetchInfiniteQueryOptions<TQueryFnData, TError, TData, TQueryKey, TPageParam>>>, queryClient?: QueryClient): void;\n```\n\nDefined in: [packages/vue-query/src/usePrefetchInfiniteQuery.ts:100](https://github.com/TanStack/query/blob/main/packages/vue-query/src/usePrefetchInfiniteQuery.ts#L100)\n\n`usePrefetchInfiniteQuery` does not return anything — it fires a prefetch as a reactive side effect, useful\nfor kicking off a fetch ahead of the component that will actually render the data with `useInfiniteQuery`.\nYou can pass everything to `usePrefetchInfiniteQuery` that you can pass to `queryClient.infiniteQuery`,\nthough `queryKey`, `initialPageParam`, and `getNextPageParam` are always required, and `queryFn` is required\nunless a default query function has been defined.\n\n`getNextPageParam` receives both the last page of the infinite list of data and the full array of all pages,\nas well as pageParam information, and should return a single variable that will be passed to your query\nfunction as `context.pageParam`. Return `undefined` or `null` to indicate there is no next page available.\n\nThe prefetch is skipped if the query already has any cached state — including a `pending`/`error` state left\nover from a previous attempt — so it won't refetch data that's already there or already in flight. It\nre-runs whenever a reactive dependency in `options` (built with `infiniteQueryOptions`, for example) changes.\n\nFire this during render, before a suspense boundary that wraps a component using `useInfiniteQuery`'s\n`suspense()` — see the [Suspense guide](https://tanstack.com/query/latest/docs/framework/vue/guides/suspense).\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n### TError\n\n`TError` = `Error`\n\n### TData\n\n`TData` = [`InfiniteData`](../interfaces/InfiniteData.md)\\<`TQueryFnData`, `unknown`\\>\n\n### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### TPageParam\n\n`TPageParam` = `unknown`\n\n## Parameters\n\n### options\n\n`MaybeRefOrGetter`\\<`MaybeRefDeep`\\<[`UsePrefetchInfiniteQueryOptions`](../type-aliases/UsePrefetchInfiniteQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`, `TPageParam`\\>\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the\n[UsePrefetchInfiniteQueryOptions](../type-aliases/UsePrefetchInfiniteQueryOptions.md) to use — everything you can pass to `queryClient.infiniteQuery`.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n`void`\n\n## Example\n\n```vue\n<script setup lang=\"ts\">\nimport { infiniteQueryOptions, usePrefetchInfiniteQuery } from '@tanstack/vue-query'\nimport Projects from './Projects.vue'\n\nconst projectsOptions = infiniteQueryOptions({\n  queryKey: ['projects'],\n  queryFn: ({ pageParam }) => fetchProjects(pageParam),\n  initialPageParam: 0,\n  getNextPageParam: (lastPage) => lastPage.nextId,\n})\n\n// Fire the prefetch as soon as this component runs, before `Projects` mounts and calls `useInfiniteQuery`.\nusePrefetchInfiniteQuery(projectsOptions)\n</script>\n\n<template>\n  <Projects />\n</template>\n```\n"}
