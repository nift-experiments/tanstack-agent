emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ... ? ... : ... : ["},{"type":"inlineCode","value":"...{ [K in (...)]: (...) }[]"},{"type":"text","value":"] : [...{ [K in string | number | symbol]: GetUseQueryResult<Tails[K]> }[]] : { [K in string | number | symbol]: GetUseQueryResult<T[K]> }"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ShallowOption"},{"type":"text","value":" & "},{"type":"inlineCode","value":"object"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"queries"},{"type":"text","value":" array to run, and the optional "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" and "},{"type":"inlineCode","value":"shallow"},{"type":"text","value":" options."}]},{"type":"heading","depth":3,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Readonly"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Ref"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TCombinedResult"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ref"},{"type":"text","value":" to the combined result. Without "},{"type":"inlineCode","value":"combine"},{"type":"text","value":", this is an array with all the query results, in\nthe same order as the input. When "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" is provided, this is the value returned by "},{"type":"inlineCode","value":"combine"},{"type":"text","value":" instead."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useQueries } from '@tanstack/vue-query'\n\nconst props = defineProps<{ ids: Array<number> }>()\n\nconst postQueries = useQueries({\n  queries: () =>\n    props.ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n      staleTime: Infinity,\n    })),\n})\n</script>\n\n<template>\n  <ul>\n    <li v-for=\"(query, index) in postQueries\" :key=\"props.ids[index]\">\n      <span v-if=\"query.isPending\">Loading...</span>\n      <span v-else-if=\"query.isError\">Error: {{ query.error.message }}</span>\n      <span v-else>{{ query.data.title }}</span>\n    </li>\n  </ul>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Combining results into a single value:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useQueries } from '@tanstack/vue-query'\n\nconst props = defineProps<{ ids: Array<number> }>()\n\nconst combined = useQueries({\n  queries: () =>\n    props.ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n  combine: (postQueries) => ({\n    data: postQueries.map((query) => query.data),\n    isPending: postQueries.some((query) => query.isPending),\n    isError: postQueries.some((query) => query.isError),\n  }),\n})\n</script>\n\n<template>\n  <span v-if=\"combined.isPending\">Loading...</span>\n  <span v-else-if=\"combined.isError\">Error!</span>\n  <ul v-else>\n    <li v-for=\"post in combined.data\" :key=\"post.id\">{{ post.title }}</li>\n  </ul>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Typing "},{"type":"inlineCode","value":"select"},{"type":"text","value":" via "},{"type":"link","href":"queryOptions.md","children":[{"type":"text","value":"queryOptions"}]},{"type":"text","value":". Note that spreading a "},{"type":"inlineCode","value":"queryOptions"},{"type":"text","value":" result and overriding\n"},{"type":"inlineCode","value":"select"},{"type":"text","value":" inline still falls back to "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" — wrap the spread in "},{"type":"inlineCode","value":"queryOptions"},{"type":"text","value":" again so the override is\nresolved before it reaches "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { queryOptions, useQueries } from '@tanstack/vue-query'\n\nconst props = defineProps<{ id: number }>()\n\nconst postOptions = (id: number) =>\n  queryOptions({\n    queryKey: ['post', id],\n    queryFn: () => fetchPost(id),\n  })\n\nconst [{ data: broken }] = useQueries({\n  queries: () => [\n    {\n      ...postOptions(props.id),\n      // ❌ `data` is `unknown` here\n      select: (data) => data.title,\n    },\n  ],\n})\n\nconst [{ data: fixed }] = useQueries({\n  queries: () => [\n    queryOptions({\n      ...postOptions(props.id),\n      // ✅ `data` is `Post`\n      select: (data) => data.title,\n    }),\n  ],\n})\n</script>\n\n<template>\n  <h1>{{ fixed }}</h1>\n</template>","lang":"vue"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"tcombinedresult","text":"TCombinedResult","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"queryclient","text":"queryClient?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useQueries<T, TCombinedResult>(options: ShallowOption & object, queryClient?: QueryClient): Readonly<Ref<TCombinedResult>>;\n```\n\nDefined in: [packages/vue-query/src/useQueries.ts:354](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQueries.ts#L354)\n\nThe `useQueries` composable can be used to fetch a variable number of queries.\n\nThe `queries` option accepts an array of query option objects mostly identical to `useQuery`'s. It may be a\nplain array, a `ref`/reactive array (each entry tracked individually), or a getter function — pass a getter\nif the array itself (its length, or which queries are in it) depends on other reactive state.\n\nHaving the same query key more than once in the array of query objects may cause some data to be shared\nbetween queries. To avoid this, consider de-duplicating the queries and map the results back to the desired\nstructure.\n\nThe `combine` option can be used to combine the results of the queries into a single value. The result will\nbe structurally shared to be as referentially stable as possible.\n\n`placeholderData` is supported here too, but unlike `useQuery`, it doesn't receive information from\npreviously rendered queries, because the number of queries can differ between renders.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `any`[]\n\n### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<T\\[K\\]\\> \\}\n\n## Parameters\n\n### options\n\n`ShallowOption` & `object`\n\nThe `queries` array to run, and the optional `combine` and `shallow` options.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n`Readonly`\\<`Ref`\\<`TCombinedResult`\\>\\>\n\nA `ref` to the combined result. Without `combine`, this is an array with all the query results, in\nthe same order as the input. When `combine` is provided, this is the value returned by `combine` instead.\n\n## Examples\n\n```vue\n<script setup lang=\"ts\">\nimport { useQueries } from '@tanstack/vue-query'\n\nconst props = defineProps<{ ids: Array<number> }>()\n\nconst postQueries = useQueries({\n  queries: () =>\n    props.ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n      staleTime: Infinity,\n    })),\n})\n</script>\n\n<template>\n  <ul>\n    <li v-for=\"(query, index) in postQueries\" :key=\"props.ids[index]\">\n      <span v-if=\"query.isPending\">Loading...</span>\n      <span v-else-if=\"query.isError\">Error: {{ query.error.message }}</span>\n      <span v-else>{{ query.data.title }}</span>\n    </li>\n  </ul>\n</template>\n```\n\nCombining results into a single value:\n```vue\n<script setup lang=\"ts\">\nimport { useQueries } from '@tanstack/vue-query'\n\nconst props = defineProps<{ ids: Array<number> }>()\n\nconst combined = useQueries({\n  queries: () =>\n    props.ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n  combine: (postQueries) => ({\n    data: postQueries.map((query) => query.data),\n    isPending: postQueries.some((query) => query.isPending),\n    isError: postQueries.some((query) => query.isError),\n  }),\n})\n</script>\n\n<template>\n  <span v-if=\"combined.isPending\">Loading...</span>\n  <span v-else-if=\"combined.isError\">Error!</span>\n  <ul v-else>\n    <li v-for=\"post in combined.data\" :key=\"post.id\">{{ post.title }}</li>\n  </ul>\n</template>\n```\n\nTyping `select` via [queryOptions](queryOptions.md). Note that spreading a `queryOptions` result and overriding\n`select` inline still falls back to `unknown` — wrap the spread in `queryOptions` again so the override is\nresolved before it reaches `useQueries`:\n```vue\n<script setup lang=\"ts\">\nimport { queryOptions, useQueries } from '@tanstack/vue-query'\n\nconst props = defineProps<{ id: number }>()\n\nconst postOptions = (id: number) =>\n  queryOptions({\n    queryKey: ['post', id],\n    queryFn: () => fetchPost(id),\n  })\n\nconst [{ data: broken }] = useQueries({\n  queries: () => [\n    {\n      ...postOptions(props.id),\n      // ❌ `data` is `unknown` here\n      select: (data) => data.title,\n    },\n  ],\n})\n\nconst [{ data: fixed }] = useQueries({\n  queries: () => [\n    queryOptions({\n      ...postOptions(props.id),\n      // ✅ `data` is `Post`\n      select: (data) => data.title,\n    }),\n  ],\n})\n</script>\n\n<template>\n  <h1>{{ fixed }}</h1>\n</template>\n```\n","originalRawMarkdown":"---\nid: useQueries\ntitle: useQueries\nredirect_from:\n  - framework/vue/reference/useQueries\n---\n\n```ts\nfunction useQueries<T, TCombinedResult>(options: ShallowOption & object, queryClient?: QueryClient): Readonly<Ref<TCombinedResult>>;\n```\n\nDefined in: [packages/vue-query/src/useQueries.ts:354](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQueries.ts#L354)\n\nThe `useQueries` composable can be used to fetch a variable number of queries.\n\nThe `queries` option accepts an array of query option objects mostly identical to `useQuery`'s. It may be a\nplain array, a `ref`/reactive array (each entry tracked individually), or a getter function — pass a getter\nif the array itself (its length, or which queries are in it) depends on other reactive state.\n\nHaving the same query key more than once in the array of query objects may cause some data to be shared\nbetween queries. To avoid this, consider de-duplicating the queries and map the results back to the desired\nstructure.\n\nThe `combine` option can be used to combine the results of the queries into a single value. The result will\nbe structurally shared to be as referentially stable as possible.\n\n`placeholderData` is supported here too, but unlike `useQuery`, it doesn't receive information from\npreviously rendered queries, because the number of queries can differ between renders.\n\n## Type Parameters\n\n### T\n\n`T` *extends* `any`[]\n\n### TCombinedResult\n\n`TCombinedResult` = `T` *extends* \\[\\] ? \\[\\] : `T` *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>\\] : `T` *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...Tails[]`\\] *extends* \\[\\] ? \\[\\] : \\[`...Tails[]`\\] *extends* \\[`Head`\\] ? \\[`GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>, `GetUseQueryResult`\\<`Head`\\>\\] : \\[`...Tails[]`\\] *extends* \\[`Head`, `...Tails[]`\\] ? \\[`...(...)[]`\\] *extends* \\[\\] ? \\[\\] : ... *extends* ... ? ... : ... : \\[`...{ [K in (...)]: (...) }[]`\\] : \\[...\\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<Tails\\[K\\]\\> \\}\\[\\]\\] : \\{ \\[K in string \\| number \\| symbol\\]: GetUseQueryResult\\<T\\[K\\]\\> \\}\n\n## Parameters\n\n### options\n\n`ShallowOption` & `object`\n\nThe `queries` array to run, and the optional `combine` and `shallow` options.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n## Returns\n\n`Readonly`\\<`Ref`\\<`TCombinedResult`\\>\\>\n\nA `ref` to the combined result. Without `combine`, this is an array with all the query results, in\nthe same order as the input. When `combine` is provided, this is the value returned by `combine` instead.\n\n## Examples\n\n```vue\n<script setup lang=\"ts\">\nimport { useQueries } from '@tanstack/vue-query'\n\nconst props = defineProps<{ ids: Array<number> }>()\n\nconst postQueries = useQueries({\n  queries: () =>\n    props.ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n      staleTime: Infinity,\n    })),\n})\n</script>\n\n<template>\n  <ul>\n    <li v-for=\"(query, index) in postQueries\" :key=\"props.ids[index]\">\n      <span v-if=\"query.isPending\">Loading...</span>\n      <span v-else-if=\"query.isError\">Error: {{ query.error.message }}</span>\n      <span v-else>{{ query.data.title }}</span>\n    </li>\n  </ul>\n</template>\n```\n\nCombining results into a single value:\n```vue\n<script setup lang=\"ts\">\nimport { useQueries } from '@tanstack/vue-query'\n\nconst props = defineProps<{ ids: Array<number> }>()\n\nconst combined = useQueries({\n  queries: () =>\n    props.ids.map((id) => ({\n      queryKey: ['post', id],\n      queryFn: () => fetchPost(id),\n    })),\n  combine: (postQueries) => ({\n    data: postQueries.map((query) => query.data),\n    isPending: postQueries.some((query) => query.isPending),\n    isError: postQueries.some((query) => query.isError),\n  }),\n})\n</script>\n\n<template>\n  <span v-if=\"combined.isPending\">Loading...</span>\n  <span v-else-if=\"combined.isError\">Error!</span>\n  <ul v-else>\n    <li v-for=\"post in combined.data\" :key=\"post.id\">{{ post.title }}</li>\n  </ul>\n</template>\n```\n\nTyping `select` via [queryOptions](queryOptions.md). Note that spreading a `queryOptions` result and overriding\n`select` inline still falls back to `unknown` — wrap the spread in `queryOptions` again so the override is\nresolved before it reaches `useQueries`:\n```vue\n<script setup lang=\"ts\">\nimport { queryOptions, useQueries } from '@tanstack/vue-query'\n\nconst props = defineProps<{ id: number }>()\n\nconst postOptions = (id: number) =>\n  queryOptions({\n    queryKey: ['post', id],\n    queryFn: () => fetchPost(id),\n  })\n\nconst [{ data: broken }] = useQueries({\n  queries: () => [\n    {\n      ...postOptions(props.id),\n      // ❌ `data` is `unknown` here\n      select: (data) => data.title,\n    },\n  ],\n})\n\nconst [{ data: fixed }] = useQueries({\n  queries: () => [\n    queryOptions({\n      ...postOptions(props.id),\n      // ✅ `data` is `Post`\n      select: (data) => data.title,\n    }),\n  ],\n})\n</script>\n\n<template>\n  <h1>{{ fixed }}</h1>\n</template>\n```\n"}
