{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/DefinedInitialQueryOptions.md","children":[{"type":"text","value":"DefinedInitialQueryOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":", with\n"},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" set."}]},{"type":"heading","depth":4,"id":"queryclient","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseQueryDefinedReturnType.md","children":[{"type":"inlineCode","value":"UseQueryDefinedReturnType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The current query result, typed so that "},{"type":"inlineCode","value":"data"},{"type":"text","value":" is never "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" (unless a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" changes\n"},{"type":"inlineCode","value":"TData"},{"type":"text","value":" to include "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"). "},{"type":"inlineCode","value":"status"},{"type":"text","value":" never resolves to "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" in this overload's type, since\n"},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" guarantees data upfront."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useQuery } from '@tanstack/vue-query'\n\n// `data` is `Post[]`, never `undefined`, thanks to `initialData` — even if a refetch fails,\n// so the list stays visible alongside the error.\nconst { data, isError, error } = useQuery({\n  queryKey: ['posts'],\n  queryFn: fetchPosts,\n  initialData: [],\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <ul>\n    <li v-for=\"post in data\" :key=\"post.id\">{{ post.title }}</li>\n  </ul>\n</template>","lang":"vue"},{"type":"html","value":"<a id=\"call-signature-2\"></a>"},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQuery.ts#L212","children":[{"type":"text","value":"packages/vue-query/src/useQuery.ts:212"}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"enabled"},{"type":"text","value":" tracks reactive dependencies automatically as a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", a plain value, or a reactive getter\n("},{"type":"inlineCode","value":"() => ..."},{"type":"text","value":"). "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" reacts through a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":" or a reactive getter for the array itself, or "},{"type":"inlineCode","value":"ref"},{"type":"text","value":"s and\n