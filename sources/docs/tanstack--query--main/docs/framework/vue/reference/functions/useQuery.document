ta"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"../type-aliases/UndefinedInitialQueryOptions.md","children":[{"type":"text","value":"UndefinedInitialQueryOptions"}]},{"type":"text","value":" to use — everything you can pass to "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"queryclient-2","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseQueryReturnType.md","children":[{"type":"inlineCode","value":"UseQueryReturnType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The current query result. "},{"type":"inlineCode","value":"status"},{"type":"text","value":" is "},{"type":"inlineCode","value":"pending"},{"type":"text","value":" if there is no cached data to display, "},{"type":"inlineCode","value":"error"},{"type":"text","value":" if\nthe last fetch attempt failed, or "},{"type":"inlineCode","value":"success"},{"type":"text","value":" if the query has data to display."}]},{"type":"heading","depth":3,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"A query key built from a reactive "},{"type":"inlineCode","value":"ref"},{"type":"text","value":" — the query refetches whenever "},{"type":"inlineCode","value":"postId"},{"type":"text","value":" changes:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\n\nconst postId = ref(1)\nconst { status, data, error } = useQuery({\n  queryKey: ['post', postId],\n  queryFn: () => fetchPost(postId.value),\n})\n</script>\n\n<template>\n  <span v-if=\"status === 'pending'\">Loading...</span>\n  <span v-else-if=\"status === 'error'\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data.title }}</h1>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"inlineCode","value":"select"},{"type":"text","value":" derives whatever "},{"type":"inlineCode","value":"data"},{"type":"text","value":" a component needs from the cached value, without changing what's\nactually stored in the cache — the cache still holds the full "},{"type":"inlineCode","value":"Post[]"},{"type":"text","value":", but "},{"type":"inlineCode","value":"data"},{"type":"text","value":" here is a "},{"type":"inlineCode","value":"number"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useQuery } from '@tanstack/vue-query'\n\nconst { data, isPending, isError, error } = useQuery({\n  queryKey: ['posts'],\n  queryFn: fetchPosts,\n  select: (posts) => posts.length,\n})\n</script>\n\n<template>\n  <span v-if=\"isPending\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <span v-else>{{ data }} posts</span>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"A dependent query, only enabled once "},{"type":"inlineCode","value":"postId"},{"type":"text","value":" is set — use "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", not "},{"type":"inlineCode","value":"isPending"},{"type":"text","value":", so the\nloading state doesn't show while the query is disabled:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: number | undefined }>()\n\nconst { data, isLoading, isError, error } = useQuery({\n  queryKey: ['post', props.postId],\n  queryFn: () => fetchPost(props.postId!),\n  enabled: () => props.postId != null,\n})\n</script>\n\n<template>\n  <span v-if=\"props.postId == null\">Select a post</span>\n  <span v-else-if=\"isLoading\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data?.title }}</h1>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Seeding a detail query from an already-cached list, to skip the loading state. "},{"type":"inlineCode","value":"initialDataUpdatedAt"},{"type":"text","value":" carries\nover the list's own fetch time, so that if you set a "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":", it's measured from when the list was\nfetched rather than from now:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useQuery, useQueryClient } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: number }>()\nconst queryClient = useQueryClient()\n\nconst { data, isError, error } = useQuery({\n  queryKey: ['post', props.postId],\n  queryFn: () => fetchPost(props.postId),\n  initialData: () =>\n    queryClient\n      .getQueryData<Array<Post>>(['posts'])\n      ?.find((post) => post.id === props.postId),\n  initialDataUpdatedAt: () =>\n    queryClient.getQueryState(['posts'])?.dataUpdatedAt,\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data?.title }}</h1>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"text","value":"Paginated data, keeping the previous page's data visible while the next page loads:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { keepPreviousData, useQuery } from '@tanstack/vue-query'\n\nconst page = ref(0)\n\nconst { data, isPlaceholderData, isError, error } = useQuery({\n  queryKey: ['posts', page],\n  queryFn: () => fetchPosts(page.value),\n  placeholderData: keepPreviousData,\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <template v-else>\n    <ul>\n      <li v-for=\"post in data\" :key=\"post.id\">{{ post.title }}</li>\n    </ul>\n    <button :disabled=\"isPlaceholderData\" @click=\"page++\">Next Page</button>\n  </template>\n</template>","lang":"vue"},{"type":"html","value":"<a id=\"call-signature-3\"></a>"},{"type":"heading","depth":2,"id":"call-signature-3","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"function useQuery<TQueryFnData, TError, TData, TQueryKey>(options: MaybeRefOrGetter<UseQueryOptions<TQueryFnData, TError, TData, TQueryFnData, TQueryKey>>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQuery.ts#L285","children":[{"type":"text","value":"packages/vue-query/src/useQuery.ts:285"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Fallback overload for options whose "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" presence isn't statically known — for example, a\n"},{"type":"inlineCode","value":"ref"},{"type":"text","value":"/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other\noverloads when possible, since they infer whether "},{"type":"inlineCode","value":"data"},{"type":"text","value":" can be "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" from "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":" directly."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"enabled"},{"type":"text","value":" tracks reactive dependencies automatically as a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", a plain value, or a reactive getter\n("},{"type":"inlineCode","value":"() => ..."},{"type":"text","value":"). "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" reacts through a "},{"type":"inlineCode","value":"ref"},{"type":"text","value":" or a reactive getter for the array itself, or "},{"type":"inlineCode","value":"ref"},{"type":"text","value":"s and\nreactive getters as individual entries."}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"options"},{"type":"text","value":" itself is a reactive getter, the whole object is re-evaluated on every change to its\ndependencies, so any option inside it — not just "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" and "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" — can change over time."}]},{"type":"heading","depth":3,"id":"type-parameters-3","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tqueryfndata-3","children":[{"type":"text","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"terror-3","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"inlineCode","value":"Error"}]},{"type":"heading","depth":4,"id":"tdata-3","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"heading","depth":4,"id":"tquerykey-3","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[] = readonly "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":"[]"}]},{"type":"heading","depth":3,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"options-3","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefOrGetter"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/UseQueryOptions.md","children":[{"type":"inlineCode","value":"UseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", plain value, or reactive getter resolving to the "},{"type":"link","href":"../type-aliases/UseQueryOptions.md","children":[{"type":"text","value":"UseQueryOptions"}]},{"type":"text","value":" to use."}]},{"type":"heading","depth":4,"id":"queryclient-3","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"heading","depth":3,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseQueryReturnType.md","children":[{"type":"inlineCode","value":"UseQueryReturnType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The current query result, with "},{"type":"inlineCode","value":"data"},{"type":"text","value":" typed as possibly "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"examples-2","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Passing a whole-options getter so "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" reacts to a setting stored elsewhere, not just "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":":"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { useQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ id: number; staleTime: number }>()\n\nconst { data } = useQuery(() => ({\n  queryKey: ['post', props.id],\n  queryFn: () => fetchPost(props.id),\n  staleTime: props.staleTime,\n}))\n</script>\n\n<template>\n  <h1 v-if=\"data\">{{ data.title }}</h1>\n</template>","lang":"vue"},{"type":"paragraph","children":[{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" disables the query in a type-safe way, without a non-null assertion on "},{"type":"inlineCode","value":"props.postId"},{"type":"text","value":" —\n"},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" is only ever called when it's defined. The whole-options getter re-evaluates "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" on every\nchange to "},{"type":"inlineCode","value":"props.postId"},{"type":"text","value":". "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" can also be a "},{"type":"inlineCode","value":"computed"},{"type":"text","value":", but never a bare getter, since a function\nthere is the query function itself. "},{"type":"inlineCode","value":"refetch"},{"type":"text","value":" doesn't work while "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" is "},{"type":"inlineCode","value":"skipToken"},{"type":"text","value":" — use\n"},{"type":"inlineCode","value":"enabled: false"},{"type":"text","value":" instead if you need to trigger the query manually:"}]},{"type":"code","value":"<script setup lang=\"ts\">\nimport { skipToken, useQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: number | undefined }>()\n\nconst { data, isLoading, isError, error } = useQuery(() => {\n  const postId = props.postId\n  return {\n    queryKey: ['post', postId],\n    queryFn: postId != null ? () => fetchPost(postId) : skipToken,\n  }\n})\n</script>\n\n<template>\n  <span v-if=\"props.postId == null\">Select a post</span>\n  <span v-else-if=\"isLoading\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data?.title }}</h1>\n</template>","lang":"vue"},{"type":"html","value":"<a id=\"parameters-summary\"></a>"},{"type":"heading","depth":2,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options-4","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"MaybeRefOrGetter"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/UseQueryOptions.md","children":[{"type":"inlineCode","value":"UseQueryOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":">>"}]},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineCode","value":"ref"},{"type":"text","value":", plain value, or reactive getter resolving to the "},{"type":"link","href":"../type-aliases/UseQueryOptions.md","children":[{"type":"text","value":"UseQueryOptions"}]},{"type":"text","value":" to use."}]},{"type":"heading","depth":3,"id":"queryclient-4","children":[{"type":"text","value":"queryClient?"}]},{"type":"paragraph","children":[{"type":"link","href":"../classes/QueryClient.md","children":[{"type":"inlineCode","value":"QueryClient"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":". Otherwise, the one provided by "},{"type":"inlineCode","value":"VueQueryPlugin"},{"type":"text","value":"\nwill be used."}]},{"type":"html","value":"<a id=\"returns-summary\"></a>"},{"type":"heading","depth":2,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/UseQueryReturnType.md","children":[{"type":"inlineCode","value":"UseQueryReturnType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TError"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"The current query result, with "},{"type":"inlineCode","value":"data"},{"type":"text","value":" typed as possibly "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"."}]}],"headings":[{"id":"overview","text":"Overview","level":2},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tqueryfndata","text":"TQueryFnData","level":4},{"id":"terror","text":"TError","level":4},{"id":"tdata","text":"TData","level":4},{"id":"tquerykey","text":"TQueryKey","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"options","text":"options","level":4},{"id":"queryclient","text":"queryClient?","level":4},{"id":"returns","text":"Returns","level":3},{"id":"example","text":"Example","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tqueryfndata-2","text":"TQueryFnData","level":4},{"id":"terror-2","text":"TError","level":4},{"id":"tdata-2","text":"TData","level":4},{"id":"tquerykey-2","text":"TQueryKey","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"options-2","text":"options","level":4},{"id":"queryclient-2","text":"queryClient?","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tqueryfndata-3","text":"TQueryFnData","level":4},{"id":"terror-3","text":"TError","level":4},{"id":"tdata-3","text":"TData","level":4},{"id":"tquerykey-3","text":"TQueryKey","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"options-3","text":"options","level":4},{"id":"queryclient-3","text":"queryClient?","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"examples-2","text":"Examples","level":3},{"id":"parameters-4","text":"Parameters","level":2},{"id":"options-4","text":"options","level":3},{"id":"queryclient-4","text":"queryClient?","level":3},{"id":"returns-4","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n## Overview\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryDefinedReturnType<TData, TError>;\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: MaybeRefOrGetter<UseQueryOptions<TQueryFnData, TError, TData, TQueryFnData, TQueryKey>>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;\n```\n\n- [`DefinedInitialQueryOptions` → `UseQueryDefinedReturnType`](#call-signature-1): This overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless a `select` changes `TData` to include `undefined`).\n- [`UndefinedInitialQueryOptions` → `UseQueryReturnType`](#call-signature-2): `enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter (`() => ...`). `queryKey` reacts through a `ref` or a reactive getter for the array itself, or `ref`s and reactive getters as individual entries. Other options are read once when passed as a plain value, and stay reactive when passed as a `ref` or a `computed`.\n- [`MaybeRefOrGetter` → `UseQueryReturnType`](#call-signature-3): Fallback overload for options whose `initialData` presence isn't statically known — for example, a `ref`/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other overloads when possible, since they infer whether `data` can be `undefined` from `initialData` directly.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryDefinedReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useQuery.ts:73](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQuery.ts#L73)\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` or a reactive getter for the array itself, or `ref`s and\nreactive getters as individual entries. Other options are read once when passed as a plain value, and stay\nreactive when passed as a `ref` or a `computed`.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`DefinedInitialQueryOptions`](../type-aliases/DefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [DefinedInitialQueryOptions](../type-aliases/DefinedInitialQueryOptions.md) to use — everything you can pass to `useQuery`, with\n`initialData` set.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseQueryDefinedReturnType`](../type-aliases/UseQueryDefinedReturnType.md)\\<`TData`, `TError`\\>\n\nThe current query result, typed so that `data` is never `undefined` (unless a `select` changes\n`TData` to include `undefined`). `status` never resolves to `pending` in this overload's type, since\n`initialData` guarantees data upfront.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { useQuery } from '@tanstack/vue-query'\n\n// `data` is `Post[]`, never `undefined`, thanks to `initialData` — even if a refetch fails,\n// so the list stays visible alongside the error.\nconst { data, isError, error } = useQuery({\n  queryKey: ['posts'],\n  queryFn: fetchPosts,\n  initialData: [],\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <ul>\n    <li v-for=\"post in data\" :key=\"post.id\">{{ post.title }}</li>\n  </ul>\n</template>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useQuery.ts:212](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQuery.ts#L212)\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` or a reactive getter for the array itself, or `ref`s and\nreactive getters as individual entries. Other options are read once when passed as a plain value, and stay\nreactive when passed as a `ref` or a `computed`.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialQueryOptions`](../type-aliases/UndefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [UndefinedInitialQueryOptions](../type-aliases/UndefinedInitialQueryOptions.md) to use — everything you can pass to `useQuery`.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseQueryReturnType`](../type-aliases/UseQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe current query result. `status` is `pending` if there is no cached data to display, `error` if\nthe last fetch attempt failed, or `success` if the query has data to display.\n\n### Examples\n\nA query key built from a reactive `ref` — the query refetches whenever `postId` changes:\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\n\nconst postId = ref(1)\nconst { status, data, error } = useQuery({\n  queryKey: ['post', postId],\n  queryFn: () => fetchPost(postId.value),\n})\n</script>\n\n<template>\n  <span v-if=\"status === 'pending'\">Loading...</span>\n  <span v-else-if=\"status === 'error'\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data.title }}</h1>\n</template>\n```\n\n`select` derives whatever `data` a component needs from the cached value, without changing what's\nactually stored in the cache — the cache still holds the full `Post[]`, but `data` here is a `number`:\n```vue\n<script setup lang=\"ts\">\nimport { useQuery } from '@tanstack/vue-query'\n\nconst { data, isPending, isError, error } = useQuery({\n  queryKey: ['posts'],\n  queryFn: fetchPosts,\n  select: (posts) => posts.length,\n})\n</script>\n\n<template>\n  <span v-if=\"isPending\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <span v-else>{{ data }} posts</span>\n</template>\n```\n\nA dependent query, only enabled once `postId` is set — use `isLoading`, not `isPending`, so the\nloading state doesn't show while the query is disabled:\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: number | undefined }>()\n\nconst { data, isLoading, isError, error } = useQuery({\n  queryKey: ['post', props.postId],\n  queryFn: () => fetchPost(props.postId!),\n  enabled: () => props.postId != null,\n})\n</script>\n\n<template>\n  <span v-if=\"props.postId == null\">Select a post</span>\n  <span v-else-if=\"isLoading\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data?.title }}</h1>\n</template>\n```\n\nSeeding a detail query from an already-cached list, to skip the loading state. `initialDataUpdatedAt` carries\nover the list's own fetch time, so that if you set a `staleTime`, it's measured from when the list was\nfetched rather than from now:\n```vue\n<script setup lang=\"ts\">\nimport { useQuery, useQueryClient } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: number }>()\nconst queryClient = useQueryClient()\n\nconst { data, isError, error } = useQuery({\n  queryKey: ['post', props.postId],\n  queryFn: () => fetchPost(props.postId),\n  initialData: () =>\n    queryClient\n      .getQueryData<Array<Post>>(['posts'])\n      ?.find((post) => post.id === props.postId),\n  initialDataUpdatedAt: () =>\n    queryClient.getQueryState(['posts'])?.dataUpdatedAt,\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data?.title }}</h1>\n</template>\n```\n\nPaginated data, keeping the previous page's data visible while the next page loads:\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { keepPreviousData, useQuery } from '@tanstack/vue-query'\n\nconst page = ref(0)\n\nconst { data, isPlaceholderData, isError, error } = useQuery({\n  queryKey: ['posts', page],\n  queryFn: () => fetchPosts(page.value),\n  placeholderData: keepPreviousData,\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <template v-else>\n    <ul>\n      <li v-for=\"post in data\" :key=\"post.id\">{{ post.title }}</li>\n    </ul>\n    <button :disabled=\"isPlaceholderData\" @click=\"page++\">Next Page</button>\n  </template>\n</template>\n```\n\n<a id=\"call-signature-3\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: MaybeRefOrGetter<UseQueryOptions<TQueryFnData, TError, TData, TQueryFnData, TQueryKey>>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useQuery.ts:285](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQuery.ts#L285)\n\nFallback overload for options whose `initialData` presence isn't statically known — for example, a\n`ref`/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other\noverloads when possible, since they infer whether `data` can be `undefined` from `initialData` directly.\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` or a reactive getter for the array itself, or `ref`s and\nreactive getters as individual entries.\n\nWhen `options` itself is a reactive getter, the whole object is re-evaluated on every change to its\ndependencies, so any option inside it — not just `queryKey` and `enabled` — can change over time.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n`MaybeRefOrGetter`\\<[`UseQueryOptions`](../type-aliases/UseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryFnData`, `TQueryKey`\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the [UseQueryOptions](../type-aliases/UseQueryOptions.md) to use.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseQueryReturnType`](../type-aliases/UseQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe current query result, with `data` typed as possibly `undefined`.\n\n### Examples\n\nPassing a whole-options getter so `staleTime` reacts to a setting stored elsewhere, not just `queryKey`:\n```vue\n<script setup lang=\"ts\">\nimport { useQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ id: number; staleTime: number }>()\n\nconst { data } = useQuery(() => ({\n  queryKey: ['post', props.id],\n  queryFn: () => fetchPost(props.id),\n  staleTime: props.staleTime,\n}))\n</script>\n\n<template>\n  <h1 v-if=\"data\">{{ data.title }}</h1>\n</template>\n```\n\n`skipToken` disables the query in a type-safe way, without a non-null assertion on `props.postId` —\n`queryFn` is only ever called when it's defined. The whole-options getter re-evaluates `queryFn` on every\nchange to `props.postId`. `queryFn` can also be a `computed`, but never a bare getter, since a function\nthere is the query function itself. `refetch` doesn't work while `queryFn` is `skipToken` — use\n`enabled: false` instead if you need to trigger the query manually:\n```vue\n<script setup lang=\"ts\">\nimport { skipToken, useQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: number | undefined }>()\n\nconst { data, isLoading, isError, error } = useQuery(() => {\n  const postId = props.postId\n  return {\n    queryKey: ['post', postId],\n    queryFn: postId != null ? () => fetchPost(postId) : skipToken,\n  }\n})\n</script>\n\n<template>\n  <span v-if=\"props.postId == null\">Select a post</span>\n  <span v-else-if=\"isLoading\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data?.title }}</h1>\n</template>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n`MaybeRefOrGetter`\\<[`UseQueryOptions`](../type-aliases/UseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryFnData`, `TQueryKey`\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the [UseQueryOptions](../type-aliases/UseQueryOptions.md) to use.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UseQueryReturnType`](../type-aliases/UseQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe current query result, with `data` typed as possibly `undefined`.\n","originalRawMarkdown":"---\nid: useQuery\ntitle: useQuery\nredirect_from:\n  - framework/vue/reference/useQuery\n---\n\n## Overview\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryDefinedReturnType<TData, TError>;\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: MaybeRefOrGetter<UseQueryOptions<TQueryFnData, TError, TData, TQueryFnData, TQueryKey>>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;\n```\n\n- [`DefinedInitialQueryOptions` → `UseQueryDefinedReturnType`](#call-signature-1): This overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless a `select` changes `TData` to include `undefined`).\n- [`UndefinedInitialQueryOptions` → `UseQueryReturnType`](#call-signature-2): `enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter (`() => ...`). `queryKey` reacts through a `ref` or a reactive getter for the array itself, or `ref`s and reactive getters as individual entries. Other options are read once when passed as a plain value, and stay reactive when passed as a `ref` or a `computed`.\n- [`MaybeRefOrGetter` → `UseQueryReturnType`](#call-signature-3): Fallback overload for options whose `initialData` presence isn't statically known — for example, a `ref`/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other overloads when possible, since they infer whether `data` can be `undefined` from `initialData` directly.\n\nSee also: [Parameters](#parameters-summary) · [Returns](#returns-summary)\n\n<a id=\"call-signature-1\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: DefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryDefinedReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useQuery.ts:73](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQuery.ts#L73)\n\nThis overload is selected when `initialData` is set, so the resulting `data` is never `undefined` (unless\na `select` changes `TData` to include `undefined`).\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` or a reactive getter for the array itself, or `ref`s and\nreactive getters as individual entries. Other options are read once when passed as a plain value, and stay\nreactive when passed as a `ref` or a `computed`.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`DefinedInitialQueryOptions`](../type-aliases/DefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [DefinedInitialQueryOptions](../type-aliases/DefinedInitialQueryOptions.md) to use — everything you can pass to `useQuery`, with\n`initialData` set.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseQueryDefinedReturnType`](../type-aliases/UseQueryDefinedReturnType.md)\\<`TData`, `TError`\\>\n\nThe current query result, typed so that `data` is never `undefined` (unless a `select` changes\n`TData` to include `undefined`). `status` never resolves to `pending` in this overload's type, since\n`initialData` guarantees data upfront.\n\n### Example\n\n```vue\n<script setup lang=\"ts\">\nimport { useQuery } from '@tanstack/vue-query'\n\n// `data` is `Post[]`, never `undefined`, thanks to `initialData` — even if a refetch fails,\n// so the list stays visible alongside the error.\nconst { data, isError, error } = useQuery({\n  queryKey: ['posts'],\n  queryFn: fetchPosts,\n  initialData: [],\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <ul>\n    <li v-for=\"post in data\" :key=\"post.id\">{{ post.title }}</li>\n  </ul>\n</template>\n```\n\n<a id=\"call-signature-2\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: UndefinedInitialQueryOptions<TQueryFnData, TError, TData, TQueryKey>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useQuery.ts:212](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQuery.ts#L212)\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` or a reactive getter for the array itself, or `ref`s and\nreactive getters as individual entries. Other options are read once when passed as a plain value, and stay\nreactive when passed as a `ref` or a `computed`.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n[`UndefinedInitialQueryOptions`](../type-aliases/UndefinedInitialQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryKey`\\>\n\nThe [UndefinedInitialQueryOptions](../type-aliases/UndefinedInitialQueryOptions.md) to use — everything you can pass to `useQuery`.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseQueryReturnType`](../type-aliases/UseQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe current query result. `status` is `pending` if there is no cached data to display, `error` if\nthe last fetch attempt failed, or `success` if the query has data to display.\n\n### Examples\n\nA query key built from a reactive `ref` — the query refetches whenever `postId` changes:\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\n\nconst postId = ref(1)\nconst { status, data, error } = useQuery({\n  queryKey: ['post', postId],\n  queryFn: () => fetchPost(postId.value),\n})\n</script>\n\n<template>\n  <span v-if=\"status === 'pending'\">Loading...</span>\n  <span v-else-if=\"status === 'error'\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data.title }}</h1>\n</template>\n```\n\n`select` derives whatever `data` a component needs from the cached value, without changing what's\nactually stored in the cache — the cache still holds the full `Post[]`, but `data` here is a `number`:\n```vue\n<script setup lang=\"ts\">\nimport { useQuery } from '@tanstack/vue-query'\n\nconst { data, isPending, isError, error } = useQuery({\n  queryKey: ['posts'],\n  queryFn: fetchPosts,\n  select: (posts) => posts.length,\n})\n</script>\n\n<template>\n  <span v-if=\"isPending\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <span v-else>{{ data }} posts</span>\n</template>\n```\n\nA dependent query, only enabled once `postId` is set — use `isLoading`, not `isPending`, so the\nloading state doesn't show while the query is disabled:\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: number | undefined }>()\n\nconst { data, isLoading, isError, error } = useQuery({\n  queryKey: ['post', props.postId],\n  queryFn: () => fetchPost(props.postId!),\n  enabled: () => props.postId != null,\n})\n</script>\n\n<template>\n  <span v-if=\"props.postId == null\">Select a post</span>\n  <span v-else-if=\"isLoading\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data?.title }}</h1>\n</template>\n```\n\nSeeding a detail query from an already-cached list, to skip the loading state. `initialDataUpdatedAt` carries\nover the list's own fetch time, so that if you set a `staleTime`, it's measured from when the list was\nfetched rather than from now:\n```vue\n<script setup lang=\"ts\">\nimport { useQuery, useQueryClient } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: number }>()\nconst queryClient = useQueryClient()\n\nconst { data, isError, error } = useQuery({\n  queryKey: ['post', props.postId],\n  queryFn: () => fetchPost(props.postId),\n  initialData: () =>\n    queryClient\n      .getQueryData<Array<Post>>(['posts'])\n      ?.find((post) => post.id === props.postId),\n  initialDataUpdatedAt: () =>\n    queryClient.getQueryState(['posts'])?.dataUpdatedAt,\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data?.title }}</h1>\n</template>\n```\n\nPaginated data, keeping the previous page's data visible while the next page loads:\n```vue\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { keepPreviousData, useQuery } from '@tanstack/vue-query'\n\nconst page = ref(0)\n\nconst { data, isPlaceholderData, isError, error } = useQuery({\n  queryKey: ['posts', page],\n  queryFn: () => fetchPosts(page.value),\n  placeholderData: keepPreviousData,\n})\n</script>\n\n<template>\n  <span v-if=\"isError\">Error: {{ error.message }}</span>\n  <template v-else>\n    <ul>\n      <li v-for=\"post in data\" :key=\"post.id\">{{ post.title }}</li>\n    </ul>\n    <button :disabled=\"isPlaceholderData\" @click=\"page++\">Next Page</button>\n  </template>\n</template>\n```\n\n<a id=\"call-signature-3\"></a>\n\n## Call Signature\n\n```ts\nfunction useQuery<TQueryFnData, TError, TData, TQueryKey>(options: MaybeRefOrGetter<UseQueryOptions<TQueryFnData, TError, TData, TQueryFnData, TQueryKey>>, queryClient?: QueryClient): UseQueryReturnType<TData, TError>;\n```\n\nDefined in: [packages/vue-query/src/useQuery.ts:285](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useQuery.ts#L285)\n\nFallback overload for options whose `initialData` presence isn't statically known — for example, a\n`ref`/reactive object built up conditionally, rather than a plain object literal. Prefer one of the other\noverloads when possible, since they infer whether `data` can be `undefined` from `initialData` directly.\n\n`enabled` tracks reactive dependencies automatically as a `ref`, a plain value, or a reactive getter\n(`() => ...`). `queryKey` reacts through a `ref` or a reactive getter for the array itself, or `ref`s and\nreactive getters as individual entries.\n\nWhen `options` itself is a reactive getter, the whole object is re-evaluated on every change to its\ndependencies, so any option inside it — not just `queryKey` and `enabled` — can change over time.\n\n### Type Parameters\n\n#### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\n#### TError\n\n`TError` = `Error`\n\n#### TData\n\n`TData` = `TQueryFnData`\n\n#### TQueryKey\n\n`TQueryKey` *extends* readonly `unknown`[] = readonly `unknown`[]\n\n### Parameters\n\n#### options\n\n`MaybeRefOrGetter`\\<[`UseQueryOptions`](../type-aliases/UseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryFnData`, `TQueryKey`\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the [UseQueryOptions](../type-aliases/UseQueryOptions.md) to use.\n\n#### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n### Returns\n\n[`UseQueryReturnType`](../type-aliases/UseQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe current query result, with `data` typed as possibly `undefined`.\n\n### Examples\n\nPassing a whole-options getter so `staleTime` reacts to a setting stored elsewhere, not just `queryKey`:\n```vue\n<script setup lang=\"ts\">\nimport { useQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ id: number; staleTime: number }>()\n\nconst { data } = useQuery(() => ({\n  queryKey: ['post', props.id],\n  queryFn: () => fetchPost(props.id),\n  staleTime: props.staleTime,\n}))\n</script>\n\n<template>\n  <h1 v-if=\"data\">{{ data.title }}</h1>\n</template>\n```\n\n`skipToken` disables the query in a type-safe way, without a non-null assertion on `props.postId` —\n`queryFn` is only ever called when it's defined. The whole-options getter re-evaluates `queryFn` on every\nchange to `props.postId`. `queryFn` can also be a `computed`, but never a bare getter, since a function\nthere is the query function itself. `refetch` doesn't work while `queryFn` is `skipToken` — use\n`enabled: false` instead if you need to trigger the query manually:\n```vue\n<script setup lang=\"ts\">\nimport { skipToken, useQuery } from '@tanstack/vue-query'\n\nconst props = defineProps<{ postId: number | undefined }>()\n\nconst { data, isLoading, isError, error } = useQuery(() => {\n  const postId = props.postId\n  return {\n    queryKey: ['post', postId],\n    queryFn: postId != null ? () => fetchPost(postId) : skipToken,\n  }\n})\n</script>\n\n<template>\n  <span v-if=\"props.postId == null\">Select a post</span>\n  <span v-else-if=\"isLoading\">Loading...</span>\n  <span v-else-if=\"isError\">Error: {{ error.message }}</span>\n  <h1 v-else>{{ data?.title }}</h1>\n</template>\n```\n\n<a id=\"parameters-summary\"></a>\n\n## Parameters\n\n### options\n\n`MaybeRefOrGetter`\\<[`UseQueryOptions`](../type-aliases/UseQueryOptions.md)\\<`TQueryFnData`, `TError`, `TData`, `TQueryFnData`, `TQueryKey`\\>\\>\n\nA `ref`, plain value, or reactive getter resolving to the [UseQueryOptions](../type-aliases/UseQueryOptions.md) to use.\n\n### queryClient?\n\n[`QueryClient`](../classes/QueryClient.md)\n\nUse this to use a custom `QueryClient`. Otherwise, the one provided by `VueQueryPlugin`\nwill be used.\n\n<a id=\"returns-summary\"></a>\n\n## Returns\n\n[`UseQueryReturnType`](../type-aliases/UseQueryReturnType.md)\\<`TData`, `TError`\\>\n\nThe current query result, with `data` typed as possibly `undefined`.\n"}
