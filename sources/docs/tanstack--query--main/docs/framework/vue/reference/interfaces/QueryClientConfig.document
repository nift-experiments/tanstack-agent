ype":"text","value":"The mutation cache this client is connected to. A new "},{"type":"inlineCode","value":"MutationCache"},{"type":"text","value":" is created if not provided."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-querycache\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"queryCache?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"QueryCache"}]},{"type":"tableCell","children":[{"type":"text","value":"The query cache this client is connected to. A new "},{"type":"inlineCode","value":"QueryCache"},{"type":"text","value":" is created if not provided."}]}]]}],"headings":[{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\nDefined in: [packages/query-core/src/types.ts:2355](https://github.com/TanStack/query/blob/main/packages/query-core/src/types.ts#L2355)\n\nThe options of `new QueryClient()`: the `queryCache` and `mutationCache` to use, and the\n`defaultOptions` for its queries and mutations.\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-defaultoptions\"></a> `defaultOptions?` | [`DefaultOptions`](DefaultOptions.md)\\<`Error`\\> | Default options for all queries and mutations created through this client. |\n| <a id=\"property-mutationcache\"></a> `mutationCache?` | `MutationCache` | The mutation cache this client is connected to. A new `MutationCache` is created if not provided. |\n| <a id=\"property-querycache\"></a> `queryCache?` | `QueryCache` | The query cache this client is connected to. A new `QueryCache` is created if not provided. |\n","originalRawMarkdown":"---\nid: QueryClientConfig\ntitle: QueryClientConfig\n---\n\nDefined in: [packages/query-core/src/types.ts:2355](https://github.com/TanStack/query/blob/main/packages/query-core/src/types.ts#L2355)\n\nThe options of `new QueryClient()`: the `queryCache` and `mutationCache` to use, and the\n`defaultOptions` for its queries and mutations.\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-defaultoptions\"></a> `defaultOptions?` | [`DefaultOptions`](DefaultOptions.md)\\<`Error`\\> | Default options for all queries and mutations created through this client. |\n| <a id=\"property-mutationcache\"></a> `mutationCache?` | `MutationCache` | The mutation cache this client is connected to. A new `MutationCache` is created if not provided. |\n| <a id=\"property-querycache\"></a> `queryCache?` | `QueryCache` | The query cache this client is connected to. A new `QueryCache` is created if not provided. |\n"}
