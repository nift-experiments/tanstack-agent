lt"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Property"}]},{"type":"tableCell","children":[{"type":"text","value":"Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-filters\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"filters?"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"VueMutationFilters"}]},{"type":"tableCell","children":[{"type":"text","value":"The filters that select the mutations to return the state of."}]}],[{"type":"tableCell","children":[{"type":"inlineHtml","value":"<a id=\"property-select\">"},{"type":"inlineHtml","value":"</a>"},{"type":"text","value":" "},{"type":"inlineCode","value":"select?"}]},{"type":"tableCell","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"mutation"},{"type":"text","value":": "},{"type":"inlineCode","value":"TMutation"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TResult"}]},{"type":"tableCell","children":[{"type":"text","value":"Maps each matching mutation to the value returned for it. Defaults to the mutation's "},{"type":"inlineCode","value":"state"},{"type":"text","value":"."}]}]]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tresult","text":"TResult","level":3},{"id":"tmutation","text":"TMutation","level":3},{"id":"properties","text":"Properties","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype MutationStateOptions<TResult, TMutation> = object;\n```\n\nDefined in: [packages/vue-query/src/useMutationState.ts:97](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useMutationState.ts#L97)\n\nThe options accepted by `useMutationState`: the `filters` matching the mutations, and `select` to map each\none (to its state, by default).\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\n\n### TMutation\n\n`TMutation` *extends* [`Mutation`](../classes/Mutation.md)\\<`any`, `any`, `any`, `any`\\> = `MutationTypeFromResult`\\<`TResult`\\>\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-filters\"></a> `filters?` | `VueMutationFilters` | The filters that select the mutations to return the state of. |\n| <a id=\"property-select\"></a> `select?` | (`mutation`: `TMutation`) => `TResult` | Maps each matching mutation to the value returned for it. Defaults to the mutation's `state`. |\n","originalRawMarkdown":"---\nid: MutationStateOptions\ntitle: MutationStateOptions\n---\n\n```ts\ntype MutationStateOptions<TResult, TMutation> = object;\n```\n\nDefined in: [packages/vue-query/src/useMutationState.ts:97](https://github.com/TanStack/query/blob/main/packages/vue-query/src/useMutationState.ts#L97)\n\nThe options accepted by `useMutationState`: the `filters` matching the mutations, and `select` to map each\none (to its state, by default).\n\n## Type Parameters\n\n### TResult\n\n`TResult` = [`MutationState`](../interfaces/MutationState.md)\n\n### TMutation\n\n`TMutation` *extends* [`Mutation`](../classes/Mutation.md)\\<`any`, `any`, `any`, `any`\\> = `MutationTypeFromResult`\\<`TResult`\\>\n\n## Properties\n\n| Property | Type | Description |\n| ------ | ------ | ------ |\n| <a id=\"property-filters\"></a> `filters?` | `VueMutationFilters` | The filters that select the mutations to return the state of. |\n| <a id=\"property-select\"></a> `select?` | (`mutation`: `TMutation`) => `TResult` | Maps each matching mutation to the value returned for it. Defaults to the mutation's `state`. |\n"}
