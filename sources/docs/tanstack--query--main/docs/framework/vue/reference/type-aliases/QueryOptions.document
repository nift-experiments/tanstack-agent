":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"paragraph","children":[{"type":"text","value":"The type your "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" resolves to."}]},{"type":"heading","depth":3,"id":"terror","children":[{"type":"text","value":"TError"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TError"},{"type":"text","value":" = "},{"type":"link","href":"DefaultError.md","children":[{"type":"inlineCode","value":"DefaultError"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of errors your "},{"type":"inlineCode","value":"queryFn"},{"type":"text","value":" may throw."}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"text","value":"The type "},{"type":"inlineCode","value":"data"},{"type":"text","value":" ends up as after "},{"type":"inlineCode","value":"select"},{"type":"text","value":" runs."}]},{"type":"heading","depth":3,"id":"tquerydata","children":[{"type":"text","value":"TQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TQueryFnData"}]},{"type":"paragraph","children":[{"type":"text","value":"The type of data stored in the cache, before "},{"type":"inlineCode","value":"select"},{"type":"text","value":" runs. Defaults to\n"},{"type":"inlineCode","value":"TQueryFnData"},{"type":"text","value":" and can be configured independently of it."}]},{"type":"heading","depth":3,"id":"tquerykey","children":[{"type":"text","value":"TQueryKey"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TQueryKey"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"QueryKey.md","children":[{"type":"inlineCode","value":"QueryKey"}]},{"type":"text","value":" = "},{"type":"link","href":"QueryKey.md","children":[{"type":"inlineCode","value":"QueryKey"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The type of your "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":"."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tqueryfndata","text":"TQueryFnData","level":3},{"id":"terror","text":"TError","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tquerydata","text":"TQueryData","level":3},{"id":"tquerykey","text":"TQueryKey","level":3}]},"frameworks":[],"downloadMarkdown":"\n```ts\ntype QueryOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey> = { [Property in keyof QueryObserverOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>]: Property extends \"enabled\" ? MaybeRefOrGetter<boolean | undefined> | (() => QueryBooleanOption<TQueryFnData, TError, TQueryData, DeepUnwrapRef<TQueryKey>>) : Property extends \"queryKey\" ? MaybeRefOrGetter<TQueryKey> : QueryObserverOptions<TQueryFnData, TError, TData, TQueryData, DeepUnwrapRef<TQueryKey>>[Property] } & ShallowOption;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:29](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L29)\n\nThe plain, unwrapped options that `queryOptions` hands back, and what `useQuery`, `useQueries`, and the\n`queryClient` methods see once `ref`s have been resolved. To pass options in, use\n[UseQueryOptions](UseQueryOptions.md), which accepts the same options as `ref`s and `computed`s too.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\nThe type your `queryFn` resolves to.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n### TData\n\n`TData` = `TQueryFnData`\n\nThe type `data` ends up as after `select` runs.\n\n### TQueryData\n\n`TQueryData` = `TQueryFnData`\n\nThe type of data stored in the cache, before `select` runs. Defaults to\n`TQueryFnData` and can be configured independently of it.\n\n### TQueryKey\n\n`TQueryKey` *extends* [`QueryKey`](QueryKey.md) = [`QueryKey`](QueryKey.md)\n\nThe type of your `queryKey`.\n","originalRawMarkdown":"---\nid: QueryOptions\ntitle: QueryOptions\n---\n\n```ts\ntype QueryOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey> = { [Property in keyof QueryObserverOptions<TQueryFnData, TError, TData, TQueryData, TQueryKey>]: Property extends \"enabled\" ? MaybeRefOrGetter<boolean | undefined> | (() => QueryBooleanOption<TQueryFnData, TError, TQueryData, DeepUnwrapRef<TQueryKey>>) : Property extends \"queryKey\" ? MaybeRefOrGetter<TQueryKey> : QueryObserverOptions<TQueryFnData, TError, TData, TQueryData, DeepUnwrapRef<TQueryKey>>[Property] } & ShallowOption;\n```\n\nDefined in: [packages/vue-query/src/queryOptions.ts:29](https://github.com/TanStack/query/blob/main/packages/vue-query/src/queryOptions.ts#L29)\n\nThe plain, unwrapped options that `queryOptions` hands back, and what `useQuery`, `useQueries`, and the\n`queryClient` methods see once `ref`s have been resolved. To pass options in, use\n[UseQueryOptions](UseQueryOptions.md), which accepts the same options as `ref`s and `computed`s too.\n\n## Type Parameters\n\n### TQueryFnData\n\n`TQueryFnData` = `unknown`\n\nThe type your `queryFn` resolves to.\n\n### TError\n\n`TError` = [`DefaultError`](DefaultError.md)\n\nThe type of errors your `queryFn` may throw.\n\n### TData\n\n`TData` = `TQueryFnData`\n\nThe type `data` ends up as after `select` runs.\n\n### TQueryData\n\n`TQueryData` = `TQueryFnData`\n\nThe type of data stored in the cache, before `select` runs. Defaults to\n`TQueryFnData` and can be configured independently of it.\n\n### TQueryKey\n\n`TQueryKey` *extends* [`QueryKey`](QueryKey.md) = [`QueryKey`](QueryKey.md)\n\nThe type of your `queryKey`.\n"}
