id: disabling-queries
title: Disabling/Pausing Queries
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"If you ever want to disable a query from automatically running, you can use the "},{"type":"inlineCode","value":"enabled = false"},{"type":"text","value":" option."}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" is "},{"type":"inlineCode","value":"false"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If the query has cached data"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query will be initialized in the "},{"type":"inlineCode","value":"status === 'success'"},{"type":"text","value":" or "},{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":" state."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If the query does not have cached data"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query will start in the "},{"type":"inlineCode","value":"status === 'idle'"},{"type":"text","value":" or "},{"type":"inlineCode","value":"isIdle"},{"type":"text","value":" state."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query will not automatically fetch on mount."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query will not automatically refetch in the background when new instances mount or new instances appearing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query will ignore query client "},{"type":"inlineCode","value":"invalidateQueries"},{"type":"text","value":" and "},{"type":"inlineCode","value":"refetchQueries"},{"type":"text","value":" calls that would normally result in the query refetching."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"refetch"},{"type":"text","value":" can be used to manually trigger the query to fetch."}]}]}]},{"type":"code","value":"function Todos() {\n  const {\n    isIdle,\n    isLoading,\n    isError,\n    data,\n    error,\n    refetch,\n    isFetching,\n  } = useQuery('todos', fetchTodoList, {\n    enabled: false,\n  })\n\n  return (\n    <>\n      <button onClick={() => refetch()}>Fetch Todos</button>\n\n      {isIdle ? (\n        'Not ready...'\n      ) : isLoading ? (\n        <span>Loading...</span>\n      ) : isError ? (\n        <span>Error: {error.message}</span>\n      ) : (\n        <>\n          <ul>\n            {data.map(todo => (\n              <li key={todo.id}>{todo.title}</li>\n            ))}\n          </ul>\n          <div>{isFetching ? 'Fetching...' : null}</div>\n        </>\n      )}\n    </>\n  )\n}","lang":"js"}],"headings":[]},"frameworks":[],"downloadMarkdown":"\nIf you ever want to disable a query from automatically running, you can use the `enabled = false` option.\n\nWhen `enabled` is `false`:\n\n- If the query has cached data\n  - The query will be initialized in the `status === 'success'` or `isSuccess` state.\n- If the query does not have cached data\n  - The query will start in the `status === 'idle'` or `isIdle` state.\n- The query will not automatically fetch on mount.\n- The query will not automatically refetch in the background when new instances mount or new instances appearing\n- The query will ignore query client `invalidateQueries` and `refetchQueries` calls that would normally result in the query refetching.\n- `refetch` can be used to manually trigger the query to fetch.\n\n```js\nfunction Todos() {\n  const {\n    isIdle,\n    isLoading,\n    isError,\n    data,\n    error,\n    refetch,\n    isFetching,\n  } = useQuery('todos', fetchTodoList, {\n    enabled: false,\n  })\n\n  return (\n    <>\n      <button onClick={() => refetch()}>Fetch Todos</button>\n\n      {isIdle ? (\n        'Not ready...'\n      ) : isLoading ? (\n        <span>Loading...</span>\n      ) : isError ? (\n        <span>Error: {error.message}</span>\n      ) : (\n        <>\n          <ul>\n            {data.map(todo => (\n              <li key={todo.id}>{todo.title}</li>\n            ))}\n          </ul>\n          <div>{isFetching ? 'Fetching...' : null}</div>\n        </>\n      )}\n    </>\n  )\n}\n```\n","originalRawMarkdown":"---\nid: disabling-queries\ntitle: Disabling/Pausing Queries\n---\n\nIf you ever want to disable a query from automatically running, you can use the `enabled = false` option.\n\nWhen `enabled` is `false`:\n\n- If the query has cached data\n  - The query will be initialized in the `status === 'success'` or `isSuccess` state.\n- If the query does not have cached data\n  - The query will start in the `status === 'idle'` or `isIdle` state.\n- The query will not automatically fetch on mount.\n- The query will not automatically refetch in the background when new instances mount or new instances appearing\n- The query will ignore query client `invalidateQueries` and `refetchQueries` calls that would normally result in the query refetching.\n- `refetch` can be used to manually trigger the query to fetch.\n\n```js\nfunction Todos() {\n  const {\n    isIdle,\n    isLoading,\n    isError,\n    data,\n    error,\n    refetch,\n    isFetching,\n  } = useQuery('todos', fetchTodoList, {\n    enabled: false,\n  })\n\n  return (\n    <>\n      <button onClick={() => refetch()}>Fetch Todos</button>\n\n      {isIdle ? (\n        'Not ready...'\n      ) : isLoading ? (\n        <span>Loading...</span>\n      ) : isError ? (\n        <span>Error: {error.message}</span>\n      ) : (\n        <>\n          <ul>\n            {data.map(todo => (\n              <li key={todo.id}>{todo.title}</li>\n            ))}\n          </ul>\n          <div>{isFetching ? 'Fetching...' : null}</div>\n        </>\n      )}\n    </>\n  )\n}\n```\n"}
