e":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" it will match inactive queries."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"inactive?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" it will match inactive queries."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" it will match active queries."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"stale?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" it will match stale queries."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" it will match fresh queries."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"fetching?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" it will match queries that are currently fetching."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" it will match queries that are not fetching."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"predicate?: (query: Query) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This predicate function will be called for every single query in the cache and be expected to return truthy for queries that are "},{"type":"inlineCode","value":"found"},{"type":"text","value":"."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this property to define a query key to match on."}]}]}]}]}]},{"type":"heading","depth":2,"id":"mutation-filters","children":[{"type":"inlineCode","value":"Mutation Filters"}]},{"type":"paragraph","children":[{"type":"text","value":"A mutation filter is an object with certain conditions to match a mutation with:"}]},{"type":"code","value":"// Get the number of all fetching mutations\nawait queryClient.isMutating()\n\n// Filter mutations by mutationKey\nawait queryClient.isMutating({ mutationKey: \"post\" })\n\n// Filter mutations using a predicate function\nawait queryClient.isMutating({ predicate: (mutation) => mutation.options.variables?.id === 1 })","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"A mutation filter object supports the following properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"exact?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you don't want to search mutations inclusively by mutation key, you can pass the "},{"type":"inlineCode","value":"exact: true"},{"type":"text","value":" option to return only the mutation with the exact mutation key you have passed."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"fetching?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" it will match mutations that are currently fetching."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" it will match mutations that are not fetching."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"predicate?: (mutation: Mutation) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This predicate function will be called for every single mutation in the cache and be expected to return truthy for mutations that are "},{"type":"inlineCode","value":"found"},{"type":"text","value":"."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutationKey?: MutationKey"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this property to define a mutation key to match on."}]}]}]}]}]}],"headings":[{"id":"query-filters","text":"Query Filters","level":2},{"id":"mutation-filters","text":"Mutation Filters","level":2}]},"frameworks":[],"downloadMarkdown":"\nSome methods within React Query accept a `QueryFilters` or `MutationFilters` object.\n\n## `Query Filters`\n\nA query filter is an object with certain conditions to match a query with:\n\n```js\n// Cancel all queries\nawait queryClient.cancelQueries()\n\n// Remove all inactive queries that begin with `posts` in the key\nqueryClient.removeQueries('posts', { inactive: true })\n\n// Refetch all active queries\nawait queryClient.refetchQueries({ active: true })\n\n// Refetch all active queries that begin with `posts` in the key\nawait queryClient.refetchQueries('posts', { active: true })\n```\n\nA query filter object supports the following properties:\n\n- `exact?: boolean`\n  - If you don't want to search queries inclusively by query key, you can pass the `exact: true` option to return only the query with the exact query key you have passed.\n- `active?: boolean`\n  - When set to `true` it will match active queries.\n  - When set to `false` it will match inactive queries.\n- `inactive?: boolean`\n  - When set to `true` it will match inactive queries.\n  - When set to `false` it will match active queries.\n- `stale?: boolean`\n  - When set to `true` it will match stale queries.\n  - When set to `false` it will match fresh queries.\n- `fetching?: boolean`\n  - When set to `true` it will match queries that are currently fetching.\n  - When set to `false` it will match queries that are not fetching.\n- `predicate?: (query: Query) => boolean`\n  - This predicate function will be called for every single query in the cache and be expected to return truthy for queries that are `found`.\n- `queryKey?: QueryKey`\n  - Set this property to define a query key to match on.\n\n## `Mutation Filters`\n\nA mutation filter is an object with certain conditions to match a mutation with:\n\n```js\n// Get the number of all fetching mutations\nawait queryClient.isMutating()\n\n// Filter mutations by mutationKey\nawait queryClient.isMutating({ mutationKey: \"post\" })\n\n// Filter mutations using a predicate function\nawait queryClient.isMutating({ predicate: (mutation) => mutation.options.variables?.id === 1 })\n```\n\nA mutation filter object supports the following properties:\n\n- `exact?: boolean`\n  - If you don't want to search mutations inclusively by mutation key, you can pass the `exact: true` option to return only the mutation with the exact mutation key you have passed.\n- `fetching?: boolean`\n  - When set to `true` it will match mutations that are currently fetching.\n  - When set to `false` it will match mutations that are not fetching.\n- `predicate?: (mutation: Mutation) => boolean`\n  - This predicate function will be called for every single mutation in the cache and be expected to return truthy for mutations that are `found`.\n- `mutationKey?: MutationKey`\n  - Set this property to define a mutation key to match on.\n","originalRawMarkdown":"---\nid: filters\ntitle: Filters\n---\n\nSome methods within React Query accept a `QueryFilters` or `MutationFilters` object.\n\n## `Query Filters`\n\nA query filter is an object with certain conditions to match a query with:\n\n```js\n// Cancel all queries\nawait queryClient.cancelQueries()\n\n// Remove all inactive queries that begin with `posts` in the key\nqueryClient.removeQueries('posts', { inactive: true })\n\n// Refetch all active queries\nawait queryClient.refetchQueries({ active: true })\n\n// Refetch all active queries that begin with `posts` in the key\nawait queryClient.refetchQueries('posts', { active: true })\n```\n\nA query filter object supports the following properties:\n\n- `exact?: boolean`\n  - If you don't want to search queries inclusively by query key, you can pass the `exact: true` option to return only the query with the exact query key you have passed.\n- `active?: boolean`\n  - When set to `true` it will match active queries.\n  - When set to `false` it will match inactive queries.\n- `inactive?: boolean`\n  - When set to `true` it will match inactive queries.\n  - When set to `false` it will match active queries.\n- `stale?: boolean`\n  - When set to `true` it will match stale queries.\n  - When set to `false` it will match fresh queries.\n- `fetching?: boolean`\n  - When set to `true` it will match queries that are currently fetching.\n  - When set to `false` it will match queries that are not fetching.\n- `predicate?: (query: Query) => boolean`\n  - This predicate function will be called for every single query in the cache and be expected to return truthy for queries that are `found`.\n- `queryKey?: QueryKey`\n  - Set this property to define a query key to match on.\n\n## `Mutation Filters`\n\nA mutation filter is an object with certain conditions to match a mutation with:\n\n```js\n// Get the number of all fetching mutations\nawait queryClient.isMutating()\n\n// Filter mutations by mutationKey\nawait queryClient.isMutating({ mutationKey: \"post\" })\n\n// Filter mutations using a predicate function\nawait queryClient.isMutating({ predicate: (mutation) => mutation.options.variables?.id === 1 })\n```\n\nA mutation filter object supports the following properties:\n\n- `exact?: boolean`\n  - If you don't want to search mutations inclusively by mutation key, you can pass the `exact: true` option to return only the mutation with the exact mutation key you have passed.\n- `fetching?: boolean`\n  - When set to `true` it will match mutations that are currently fetching.\n  - When set to `false` it will match mutations that are not fetching.\n- `predicate?: (mutation: Mutation) => boolean`\n  - This predicate function will be called for every single mutation in the cache and be expected to return truthy for mutations that are `found`.\n- `mutationKey?: MutationKey`\n  - Set this property to define a mutation key to match on.\n"}
