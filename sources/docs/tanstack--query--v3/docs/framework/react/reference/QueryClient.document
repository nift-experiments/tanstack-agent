{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"queryclient","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":" can be used to interact with a cache:"}]},{"type":"code","value":"import { QueryClient } from 'react-query'\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: {\n      staleTime: Infinity,\n    },\n  },\n})\n\nawait queryClient.prefetchQuery('posts', fetchPosts)","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"Its available methods are:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientfetchquery","children":[{"type":"inlineCode","value":"queryClient.fetchQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientfetchinfinitequery","children":[{"type":"inlineCode","value":"queryClient.fetchInfiniteQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientprefetchquery","children":[{"type":"inlineCode","value":"queryClient.prefetchQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientprefetchinfinitequery","children":[{"type":"inlineCode","value":"queryClient.prefetchInfiniteQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetquerydata","children":[{"type":"inlineCode","value":"queryClient.getQueryData"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetqueriesdata","children":[{"type":"inlineCode","value":"queryClient.getQueriesData"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetquerydata","children":[{"type":"inlineCode","value":"queryClient.setQueryData"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetquerystate","children":[{"type":"inlineCode","value":"queryClient.getQueryState"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetqueriesdata","children":[{"type":"inlineCode","value":"queryClient.setQueriesData"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientinvalidatequeries","children":[{"type":"inlineCode","value":"queryClient.invalidateQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientrefetchqueries","children":[{"type":"inlineCode","value":"queryClient.refetchQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientcancelqueries","children":[{"type":"inlineCode","value":"queryClient.cancelQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientremovequeries","children":[{"type":"inlineCode","value":"queryClient.removeQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientresetqueries","children":[{"type":"inlineCode","value":"queryClient.resetQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientisfetching","children":[{"type":"inlineCode","value":"queryClient.isFetching"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientismutating","children":[{"type":"inlineCode","value":"queryClient.isMutating"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetdefaultoptions","children":[{"type":"inlineCode","value":"queryClient.getDefaultOptions"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetdefaultoptions","children":[{"type":"inlineCode","value":"queryClient.setDefaultOptions"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetquerydefaults","children":[{"type":"inlineCode","value":"queryClient.getQueryDefaults"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetquerydefaults","children":[{"type":"inlineCode","value":"queryClient.setQueryDefaults"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetmutationdefaults","children":[{"type":"inlineCode","value":"queryClient.getMutationDefaults"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetmutationdefaults","children":[{"type":"inlineCode","value":"queryClient.setMutationDefaults"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetquerycache","children":[{"type":"inlineCode","value":"queryClient.getQueryCache"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetmutationcache","children":[{"type":"inlineCode","value":"queryClient.getMutationCache"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientclear","children":[{"type":"inlineCode","value":"queryClient.clear"}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryCache?: QueryCache"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query cache this client is connected to."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutationCache?: MutationCache"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The mutation cache this client is connected to."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultOptions?: DefaultOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Define defaults for all queries and mutations using this queryClient."}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-fetchquery","children":[{"type":"inlineCode","value":"queryClient.fetchQuery"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" is an asynchronous method that can be used to fetch and cache a query. It will either resolve with the data or throw with the error. Use the "},{"type":"inlineCode","value":"prefetchQuery"},{"type":"text","value":" method if you just want to fetch a query without needing the result."}]},{"type":"paragraph","children":[{"type":"text","value":"If the query exists and the data is not invalidated or older than the given "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":", then the data from the cache will be returned. Otherwise it will try to fetch the latest data."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"The difference between using "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" and "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" is that "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" is async and will ensure that duplicate requests for this query are not created with "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" instances for the same query are rendered while the data is fetching."}]}]},{"type":"code","value":"try {\n  const data = await queryClient.fetchQuery(queryKey, queryFn)\n} catch (error) {\n  console.log(error)\n}","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"Specify a "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" to only fetch when the data is older than a certain amount of time:"}]},{"type":"code","value":"try {\n  const data = await queryClient.fetchQuery(queryKey, queryFn, {\n    staleTime: 10000,\n  })\n} catch (error) {\n  console.log(error)\n}","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" are exactly the same as those of "},{"type":"link","href":"./useQuery","children":[{"type":"inlineCode","value":"useQuery"}]},{"type":"text","value":", except the following: "},{"type":"inlineCode","value":"enabled, refetchInterval, refetchIntervalInBackground, refetchOnWindowFocus, refetchOnReconnect, notifyOnChangeProps, notifyOnChangePropsExclusions, onSuccess, onError, onSettled, useErrorBoundary, select, suspense, keepPreviousData, placeholderData"},{"type":"text","value":"; which are strictly for useQuery and useInfiniteQuery. You can check the "},{"type":"link","href":"https://github.com/tannerlinsley/react-query/blob/361935a12cec6f36d0bd6ba12e84136c405047c5/src/core/types.ts#L83","children":[{"type":"text","value":"source code"}]},{"type":"text","value":" for more clarity."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise<TData>"}]}]}]},{"type":"heading","depth":2,"id":"queryclient-fetchinfinitequery","children":[{"type":"inlineCode","value":"queryClient.fetchInfiniteQuery"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"fetchInfiniteQuery"},{"type":"text","value":" is similar to "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" but can be used to fetch and cache an infinite query."}]},{"type":"code","value":"try {\n  const data = await queryClient.fetchInfiniteQuery(queryKey, queryFn)\n  console.log(data.pages)\n} catch (error) {\n  console.log(error)\n}","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"fetchInfiniteQuery"},{"type":"text","value":" are exactly the same as those of "},{"type":"link","href":"#queryclientfetchquery","children":[{"type":"inlineCode","value":"fetchQuery"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise<InfiniteData<TData>>"}]}]}]},{"type":"heading","depth":2,"id":"queryclient-prefetchquery","children":[{"type":"inlineCode","value":"queryClient.prefetchQuery"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"prefetchQuery"},{"type":"text","value":" is an asynchronous method that can be used to prefetch a query before it is needed or rendered with "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" and friends. The method works the same as "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" except that it will not throw or return any data."}]},{"type":"code","value":"await queryClient.prefetchQuery(queryKey, queryFn)","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"You can even use it with a default queryFn in your config!"}]},{"type":"code","value":"await queryClient.prefetchQuery(queryKey)","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"prefetchQuery"},{"type":"text","value":" are exactly the same as those of "},{"type":"link","href":"#queryclientfetchquery","children":[{"type":"inlineCode","value":"fetchQuery"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise<void>"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A promise is returned that will either immediately resolve if no fetch is needed or after the query has been executed. It will not return any data or throw any errors."}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-prefetchinfinitequery","children":[{"type":"inlineCode","value":"queryClient.prefetchInfiniteQuery"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"prefetchInfiniteQuery"},{"type":"text","value":" is similar to "},{"type":"inlineCode","value":"prefetchQuery"},{"type":"text","value":" but can be used to prefetch and cache an infinite query."}]},{"type":"code","value":"await queryClient.prefetchInfiniteQuery(queryKey, queryFn)","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"prefetchInfiniteQuery"},{"type":"text","value":" are exactly the same as those of "},{"type":"link","href":"#queryclientfetchquery","children":[{"type":"inlineCode","value":"fetchQuery"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise<void>"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A promise is returned that will either immediately resolve if no fetch is needed or after the query has been executed. It will not return any data or throw any errors."}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-getquerydata","children":[{"type":"inlineCode","value":"queryClient.getQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"getQueryData"},{"type":"text","value":" is a synchronous function that can be used to get an existing query's cached data. If the query does not exist, "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" will be returned."}]},{"type":"code","value":"const data = queryClient.getQueryData(queryKey)","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"data: TData | undefined"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The data for the cached query, or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" if the query does not exist."}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-getqueriesdata","children":[{"type":"inlineCode","value":"queryClient.getQueriesData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"getQueriesData"},{"type":"text","value":" is a synchronous function that can be used to get the cached data of multiple queries. Only queries that match the passed queryKey or queryFilter will be returned. If there are no matching queries, an empty array will be returned."}]},{"type":"code","value":"const data = queryClient.getQueriesData(queryKey | filters)","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"filters: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"if a queryKey is passed as the argument, the data with queryKeys fuzzily matching this param will be returned"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"if a filter is passed, the data with queryKeys matching the filter will be returned"}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"[queryKey:QueryKey, data:TData | unknown][]"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"An array of tuples for the matched query keys, or "},{"type":"inlineCode","value":"[]"},{"type":"text","value":" if there are no matches. The tuples are the query key and its associated data."}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Caveats"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Because the returned data in each tuple can be of varying structures (i.e. using a filter to return \"active\" queries can return different data types), the "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" generic defaults to "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":". If you provide a more specific type to "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" it is assumed that you are certain each tuple's data entry is all the same type."}]},{"type":"paragraph","children":[{"type":"text","value":"This distinction is more a \"convenience\" for ts devs that know which structure will be returned."}]},{"type":"heading","depth":2,"id":"queryclient-setquerydata","children":[{"type":"inlineCode","value":"queryClient.setQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" is a synchronous function that can be used to immediately update a query's cached data. If the query does not exist, it will be created. "},{"type":"strong","children":[{"type":"text","value":"If the query is not utilized by a query hook in the default "},{"type":"inlineCode","value":"cacheTime"},{"type":"text","value":" of 5 minutes, the query will be garbage collected"}]},{"type":"text","value":". To update multiple queries at once and match query keys partially, you need to use "},{"type":"link","href":"#queryclientsetqueriesdata","children":[{"type":"inlineCode","value":"queryClient.setQueriesData"}]},{"type":"text","value":" instead."}]},{"type":"paragraph","children":[{"type":"text","value":"After successful changing query's cached data via "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":", it will also trigger "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" callback from that query."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"The difference between using "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" and "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" is that "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" is sync and assumes that you already synchronously have the data available. If you need to fetch the data asynchronously, it's suggested that you either refetch the query key or use "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" to handle the asynchronous fetch."}]}]},{"type":"code","value":"queryClient.setQueryData(queryKey, updater)","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"updater: TData | (oldData: TData | undefined) => TData"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If non-function is passed, the data will be updated to this value"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a function is passed, it will receive the old data value and be expected to return a new one."}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Using an updater value"}]}]},{"type":"code","value":"setQueryData(queryKey, newData)","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Using an updater function"}]}]},{"type":"paragraph","children":[{"type":"text","value":"For convenience in syntax, you can also pass an updater function which receives the current data value and returns the new one:"}]},{"type":"code","value":"setQueryData(queryKey, oldData => newData)","lang":"js"},{"type":"heading","depth":2,"id":"queryclient-getquerystate","children":[{"type":"inlineCode","value":"queryClient.getQueryState"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"getQueryState"},{"type":"text","value":" is a synchronous function that can be used to get an existing query's state. If the query does not exist, "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" will be returned."}]},{"type":"code","value":"const state = queryClient.getQueryState(queryKey)\nconsole.log(state.dataUpdatedAt)","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-setqueriesdata","children":[{"type":"inlineCode","value":"queryClient.setQueriesData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setQueriesData"},{"type":"text","value":" is a synchronous function that can be used to immediately update cached data of multiple queries by using filter function or partially matching the query key. Only queries that match the passed queryKey or queryFilter will be updated - no new cache entries will be created. Under the hood, "},{"type":"link","href":"#queryclientsetquerydata","children":[{"type":"inlineCode","value":"setQueryData"}]},{"type":"text","value":" is called for each query."}]},{"type":"code","value":"queryClient.setQueriesData(queryKey | filters, updater)","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"filters: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"if a queryKey is passed as first argument, queryKeys partially matching this param will be updated"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"if a filter is passed, queryKeys matching the filter will be updated"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"updater: TData | (oldData: TData | undefined) => TData"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the "},{"type":"link","href":"#queryclientsetquerydata","children":[{"type":"text","value":"setQueryData"}]},{"type":"text","value":" updater function or new data, will be called for each matching queryKey"}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-invalidatequeries","children":[{"type":"inlineCode","value":"queryClient.invalidateQueries"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"invalidateQueries"},{"type":"text","value":" method can be used to invalidate and refetch single or multiple queries in the cache based on their query keys or any other functionally accessible property/state of the query. By default, all matching queries are immediately marked as invalid and active queries are refetched in the background."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you "},{"type":"strong","children":[{"type":"text","value":"do not want active queries to refetch"}]},{"type":"text","value":", and simply be marked as invalid, you can use the "},{"type":"inlineCode","value":"refetchActive: false"},{"type":"text","value":" option."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you "},{"type":"strong","children":[{"type":"text","value":"want inactive queries to refetch"}]},{"type":"text","value":" as well, use the "},{"type":"inlineCode","value":"refetchInactive: true"},{"type":"text","value":" option"}]}]}]},{"type":"code","value":"await queryClient.invalidateQueries('posts', {\n  exact,\n  refetchActive: true,\n  refetchInactive: false\n}, { throwOnError, cancelRefetch })","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"refetchActive: Boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"true"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":", queries that match the refetch predicate and are actively being rendered via "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" and friends will NOT be refetched in the background, and only marked as invalid."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"refetchInactive: Boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"false"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", queries that match the refetch predicate and are not being rendered via "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" and friends will be both marked as invalid and also refetched in the background"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"refetchPage: (page: TData, index: number, allPages: TData[]) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Only for "},{"type":"link","href":"../guides/infinite-queries#refetchpage","children":[{"type":"text","value":"Infinite Queries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this function to specify which pages should be refetched"}]}]}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options?: InvalidateOptions"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"throwOnError?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", this method will throw if any of the query refetch tasks fail."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"cancelRefetch?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", then the current request will be cancelled before a new request is made"}]}]}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-refetchqueries","children":[{"type":"inlineCode","value":"queryClient.refetchQueries"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"refetchQueries"},{"type":"text","value":" method can be used to refetch queries based on certain conditions."}]},{"type":"paragraph","children":[{"type":"text","value":"Examples:"}]},{"type":"code","value":"// refetch all queries:\nawait queryClient.refetchQueries()\n\n// refetch all stale queries:\nawait queryClient.refetchQueries({ stale: true })\n\n// refetch all active queries partially matching a query key:\nawait queryClient.refetchQueries(['posts'], { active: true })\n\n// refetch all active queries exactly matching a query key:\nawait queryClient.refetchQueries(['posts', 1], { active: true, exact: true })","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"refetchPage: (page: TData, index: number, allPages: TData[]) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Only for "},{"type":"link","href":"../guides/infinite-queries#refetchpage","children":[{"type":"text","value":"Infinite Queries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this function to specify which pages should be refetched"}]}]}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options?: RefetchOptions"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"throwOnError?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", this method will throw if any of the query refetch tasks fail."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"cancelRefetch?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", then the current request will be cancelled before a new request is made"}]}]}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This function returns a promise that will resolve when all of the queries are done being refetched. By default, it "},{"type":"strong","children":[{"type":"text","value":"will not"}]},{"type":"text","value":" throw an error if any of those queries refetches fail, but this can be configured by setting the "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" option to "},{"type":"inlineCode","value":"true"}]},{"type":"heading","depth":2,"id":"queryclient-cancelqueries","children":[{"type":"inlineCode","value":"queryClient.cancelQueries"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"cancelQueries"},{"type":"text","value":" method can be used to cancel outgoing queries based on their query keys or any other functionally accessible property/state of the query."}]},{"type":"paragraph","children":[{"type":"text","value":"This is most useful when performing optimistic updates since you will likely need to cancel any outgoing query refetches so they don't clobber your optimistic update when they resolve."}]},{"type":"code","value":"await queryClient.cancelQueries('posts', { exact: true })","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This method does not return anything"}]},{"type":"heading","depth":2,"id":"queryclient-removequeries","children":[{"type":"inlineCode","value":"queryClient.removeQueries"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"removeQueries"},{"type":"text","value":" method can be used to remove queries from the cache based on their query keys or any other functionally accessible property/state of the query."}]},{"type":"code","value":"queryClient.removeQueries(queryKey, { exact: true })","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This method does not return anything"}]},{"type":"heading","depth":2,"id":"queryclient-resetqueries","children":[{"type":"inlineCode","value":"queryClient.resetQueries"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"resetQueries"},{"type":"text","value":" method can be used to reset queries in the cache to their\ninitial state based on their query keys or any other functionally accessible\nproperty/state of the query."}]},{"type":"paragraph","children":[{"type":"text","value":"This will notify subscribers &mdash; unlike "},{"type":"inlineCode","value":"clear"},{"type":"text","value":", which removes all\nsubscribers &mdash; and reset the query to its pre-loaded state &mdash; unlike\n"},{"type":"inlineCode","value":"invalidateQueries"},{"type":"text","value":". If a query has "},{"type":"inlineCode","value":"initialData"},{"type":"text","value":", the query's data will be\nreset to that. If a query is active, it will be refetched."}]},{"type":"code","value":"queryClient.resetQueries(queryKey, { exact: true })","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"refetchPage: (page: TData, index: number, allPages: TData[]) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Only for "},{"type":"link","href":"../guides/infinite-queries#refetchpage","children":[{"type":"text","value":"Infinite Queries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this function to specify which pages should be refetched"}]}]}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options?: ResetOptions"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"throwOnError?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", this method will throw if any of the query refetch tasks fail."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"cancelRefetch?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", then the current request will be cancelled before a new request is made"}]}]}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This method returns a promise that resolves when all active queries have been refetched."}]},{"type":"heading","depth":2,"id":"queryclient-isfetching","children":[{"type":"inlineCode","value":"queryClient.isFetching"}]},{"type":"paragraph","children":[{"type":"text","value":"This "},{"type":"inlineCode","value":"isFetching"},{"type":"text","value":" method returns an "},{"type":"inlineCode","value":"integer"},{"type":"text","value":" representing how many queries, if any, in the cache are currently fetching (including background-fetching, loading new pages, or loading more infinite query results)"}]},{"type":"code","value":"if (queryClient.isFetching()) {\n  console.log('At least one query is fetching!')\n}","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"React Query also exports a handy "},{"type":"link","href":"./useIsFetching","children":[{"type":"inlineCode","value":"useIsFetching"}]},{"type":"text","value":" hook that will let you subscribe to this state in your components without creating a manual subscription to the query cache."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This method returns the number of fetching queries."}]},{"type":"heading","depth":2,"id":"queryclient-ismutating","children":[{"type":"inlineCode","value":"queryClient.isMutating"}]},{"type":"paragraph","children":[{"type":"text","value":"This "},{"type":"inlineCode","value":"isMutating"},{"type":"text","value":" method returns an "},{"type":"inlineCode","value":"integer"},{"type":"text","value":" representing how many mutations, if any, in the cache are currently fetching."}]},{"type":"code","value":"if (queryClient.isMutating()) {\n  console.log('At least one mutation is fetching!')\n}","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"React Query also exports a handy "},{"type":"link","href":"./useIsMutating","children":[{"type":"inlineCode","value":"useIsMutating"}]},{"type":"text","value":" hook that will let you subscribe to this state in your components without creating a manual subscription to the mutation cache."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters: MutationFilters"},{"type":"text","value":": "},{"type":"link","href":"../guides/filters#mutation-filters","children":[{"type":"text","value":"Mutation Filters"}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This method returns the number of fetching mutations."}]},{"type":"heading","depth":2,"id":"queryclient-getdefaultoptions","children":[{"type":"inlineCode","value":"queryClient.getDefaultOptions"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"getDefaultOptions"},{"type":"text","value":" method returns the default options which have been set when creating the client or with "},{"type":"inlineCode","value":"setDefaultOptions"},{"type":"text","value":"."}]},{"type":"code","value":"const defaultOptions = queryClient.getDefaultOptions()","lang":"js"},{"type":"heading","depth":2,"id":"queryclient-setdefaultoptions","children":[{"type":"inlineCode","value":"queryClient.setDefaultOptions"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"setDefaultOptions"},{"type":"text","value":" method can be used to dynamically set the default options for this queryClient. Previously defined default options will be overwritten."}]},{"type":"code","value":"queryClient.setDefaultOptions({\n  queries: {\n    staleTime: Infinity,\n  },\n})","lang":"js"},{"type":"heading","depth":2,"id":"queryclient-getquerydefaults","children":[{"type":"inlineCode","value":"queryClient.getQueryDefaults"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"getQueryDefaults"},{"type":"text","value":" method returns the default options which have been set for specific queries:"}]},{"type":"code","value":"const defaultOptions = queryClient.getQueryDefaults('posts')","lang":"js"},{"type":"heading","depth":2,"id":"queryclient-setquerydefaults","children":[{"type":"inlineCode","value":"queryClient.setQueryDefaults"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setQueryDefaults"},{"type":"text","value":" can be used to set default options for specific queries:"}]},{"type":"code","value":"queryClient.setQueryDefaults('posts', { queryFn: fetchPosts })\n\nfunction Component() {\n  const { data } = useQuery('posts')\n}","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options: QueryOptions"}]}]}]},{"type":"heading","depth":2,"id":"queryclient-getmutationdefaults","children":[{"type":"inlineCode","value":"queryClient.getMutationDefaults"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"getMutationDefaults"},{"type":"text","value":" method returns the default options which have been set for specific mutations:"}]},{"type":"code","value":"const defaultOptions = queryClient.getMutationDefaults('addPost')","lang":"js"},{"type":"heading","depth":2,"id":"queryclient-setmutationdefaults","children":[{"type":"inlineCode","value":"queryClient.setMutationDefaults"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setMutationDefaults"},{"type":"text","value":" can be used to set default options for specific mutations:"}]},{"type":"code","value":"queryClient.setMutationDefaults('addPost', { mutationFn: addPost })\n\nfunction Component() {\n  const { data } = useMutation('addPost')\n}","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutationKey: string | unknown[]"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options: MutationOptions"}]}]}]},{"type":"heading","depth":2,"id":"queryclient-getquerycache","children":[{"type":"inlineCode","value":"queryClient.getQueryCache"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"getQueryCache"},{"type":"text","value":" method returns the query cache this client is connected to."}]},{"type":"code","value":"const queryCache = queryClient.getQueryCache()","lang":"js"},{"type":"heading","depth":2,"id":"queryclient-getmutationcache","children":[{"type":"inlineCode","value":"queryClient.getMutationCache"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"getMutationCache"},{"type":"text","value":" method returns the mutation cache this client is connected to."}]},{"type":"code","value":"const mutationCache = queryClient.getMutationCache()","lang":"js"},{"type":"heading","depth":2,"id":"queryclient-clear","children":[{"type":"inlineCode","value":"queryClient.clear"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"clear"},{"type":"text","value":" method clears all connected caches."}]},{"type":"code","value":"queryClient.clear()","lang":"js"}],"headings":[{"id":"queryclient","text":"QueryClient","level":2},{"id":"queryclient-fetchquery","text":"queryClient.fetchQuery","level":2},{"id":"queryclient-fetchinfinitequery","text":"queryClient.fetchInfiniteQuery","level":2},{"id":"queryclient-prefetchquery","text":"queryClient.prefetchQuery","level":2},{"id":"queryclient-prefetchinfinitequery","text":"queryClient.prefetchInfiniteQuery","level":2},{"id":"queryclient-getquerydata","text":"queryClient.getQueryData","level":2},{"id":"queryclient-getqueriesdata","text":"queryClient.getQueriesData","level":2},{"id":"queryclient-setquerydata","text":"queryClient.setQueryData","level":2},{"id":"queryclient-getquerystate","text":"queryClient.getQueryState","level":2},{"id":"queryclient-setqueriesdata","text":"queryClient.setQueriesData","level":2},{"id":"queryclient-invalidatequeries","text":"queryClient.invalidateQueries","level":2},{"id":"queryclient-refetchqueries","text":"queryClient.refetchQueries","level":2},{"id":"queryclient-cancelqueries","text":"queryClient.cancelQueries","level":2},{"id":"queryclient-removequeries","text":"queryClient.removeQueries","level":2},{"id":"queryclient-resetqueries","text":"queryClient.resetQueries","level":2},{"id":"queryclient-isfetching","text":"queryClient.isFetching","level":2},{"id":"queryclient-ismutating","text":"queryClient.isMutating","level":2},{"id":"queryclient-getdefaultoptions","text":"queryClient.getDefaultOptions","level":2},{"id":"queryclient-setdefaultoptions","text":"queryClient.setDefaultOptions","level":2},{"id":"queryclient-getquerydefaults","text":"queryClient.getQueryDefaults","level":2},{"id":"queryclient-setquerydefaults","text":"queryClient.setQueryDefaults","level":2},{"id":"queryclient-getmutationdefaults","text":"queryClient.getMutationDefaults","level":2},{"id":"queryclient-setmutationdefaults","text":"queryClient.setMutationDefaults","level":2},{"id":"queryclient-getquerycache","text":"queryClient.getQueryCache","level":2},{"id":"queryclient-getmutationcache","text":"queryClient.getMutationCache","level":2},{"id":"queryclient-clear","text":"queryClient.clear","level":2}]},"frameworks":[],"downloadMarkdown":"\n## `QueryClient`\n\nThe `QueryClient` can be used to interact with a cache:\n\n```js\nimport { QueryClient } from 'react-query'\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: {\n      staleTime: Infinity,\n    },\n  },\n})\n\nawait queryClient.prefetchQuery('posts', fetchPosts)\n```\n\nIts available methods are:\n\n- [`queryClient.fetchQuery`](#queryclientfetchquery)\n- [`queryClient.fetchInfiniteQuery`](#queryclientfetchinfinitequery)\n- [`queryClient.prefetchQuery`](#queryclientprefetchquery)\n- [`queryClient.prefetchInfiniteQuery`](#queryclientprefetchinfinitequery)\n- [`queryClient.getQueryData`](#queryclientgetquerydata)\n- [`queryClient.getQueriesData`](#queryclientgetqueriesdata)\n- [`queryClient.setQueryData`](#queryclientsetquerydata)\n- [`queryClient.getQueryState`](#queryclientgetquerystate)\n- [`queryClient.setQueriesData`](#queryclientsetqueriesdata)\n- [`queryClient.invalidateQueries`](#queryclientinvalidatequeries)\n- [`queryClient.refetchQueries`](#queryclientrefetchqueries)\n- [`queryClient.cancelQueries`](#queryclientcancelqueries)\n- [`queryClient.removeQueries`](#queryclientremovequeries)\n- [`queryClient.resetQueries`](#queryclientresetqueries)\n- [`queryClient.isFetching`](#queryclientisfetching)\n- [`queryClient.isMutating`](#queryclientismutating)\n- [`queryClient.getDefaultOptions`](#queryclientgetdefaultoptions)\n- [`queryClient.setDefaultOptions`](#queryclientsetdefaultoptions)\n- [`queryClient.getQueryDefaults`](#queryclientgetquerydefaults)\n- [`queryClient.setQueryDefaults`](#queryclientsetquerydefaults)\n- [`queryClient.getMutationDefaults`](#queryclientgetmutationdefaults)\n- [`queryClient.setMutationDefaults`](#queryclientsetmutationdefaults)\n- [`queryClient.getQueryCache`](#queryclientgetquerycache)\n- [`queryClient.getMutationCache`](#queryclientgetmutationcache)\n- [`queryClient.clear`](#queryclientclear)\n\n**Options**\n\n- `queryCache?: QueryCache`\n  - Optional\n  - The query cache this client is connected to.\n- `mutationCache?: MutationCache`\n  - Optional\n  - The mutation cache this client is connected to.\n- `defaultOptions?: DefaultOptions`\n  - Optional\n  - Define defaults for all queries and mutations using this queryClient.\n\n## `queryClient.fetchQuery`\n\n`fetchQuery` is an asynchronous method that can be used to fetch and cache a query. It will either resolve with the data or throw with the error. Use the `prefetchQuery` method if you just want to fetch a query without needing the result.\n\nIf the query exists and the data is not invalidated or older than the given `staleTime`, then the data from the cache will be returned. Otherwise it will try to fetch the latest data.\n\n> The difference between using `fetchQuery` and `setQueryData` is that `fetchQuery` is async and will ensure that duplicate requests for this query are not created with `useQuery` instances for the same query are rendered while the data is fetching.\n\n```js\ntry {\n  const data = await queryClient.fetchQuery(queryKey, queryFn)\n} catch (error) {\n  console.log(error)\n}\n```\n\nSpecify a `staleTime` to only fetch when the data is older than a certain amount of time:\n\n```js\ntry {\n  const data = await queryClient.fetchQuery(queryKey, queryFn, {\n    staleTime: 10000,\n  })\n} catch (error) {\n  console.log(error)\n}\n```\n\n**Options**\n\nThe options for `fetchQuery` are exactly the same as those of [`useQuery`](./useQuery), except the following: `enabled, refetchInterval, refetchIntervalInBackground, refetchOnWindowFocus, refetchOnReconnect, notifyOnChangeProps, notifyOnChangePropsExclusions, onSuccess, onError, onSettled, useErrorBoundary, select, suspense, keepPreviousData, placeholderData`; which are strictly for useQuery and useInfiniteQuery. You can check the [source code](https://github.com/tannerlinsley/react-query/blob/361935a12cec6f36d0bd6ba12e84136c405047c5/src/core/types.ts#L83) for more clarity.\n\n**Returns**\n\n- `Promise<TData>`\n\n## `queryClient.fetchInfiniteQuery`\n\n`fetchInfiniteQuery` is similar to `fetchQuery` but can be used to fetch and cache an infinite query.\n\n```js\ntry {\n  const data = await queryClient.fetchInfiniteQuery(queryKey, queryFn)\n  console.log(data.pages)\n} catch (error) {\n  console.log(error)\n}\n```\n\n**Options**\n\nThe options for `fetchInfiniteQuery` are exactly the same as those of [`fetchQuery`](#queryclientfetchquery).\n\n**Returns**\n\n- `Promise<InfiniteData<TData>>`\n\n## `queryClient.prefetchQuery`\n\n`prefetchQuery` is an asynchronous method that can be used to prefetch a query before it is needed or rendered with `useQuery` and friends. The method works the same as `fetchQuery` except that it will not throw or return any data.\n\n```js\nawait queryClient.prefetchQuery(queryKey, queryFn)\n```\n\nYou can even use it with a default queryFn in your config!\n\n```js\nawait queryClient.prefetchQuery(queryKey)\n```\n\n**Options**\n\nThe options for `prefetchQuery` are exactly the same as those of [`fetchQuery`](#queryclientfetchquery).\n\n**Returns**\n\n- `Promise<void>`\n  - A promise is returned that will either immediately resolve if no fetch is needed or after the query has been executed. It will not return any data or throw any errors.\n\n## `queryClient.prefetchInfiniteQuery`\n\n`prefetchInfiniteQuery` is similar to `prefetchQuery` but can be used to prefetch and cache an infinite query.\n\n```js\nawait queryClient.prefetchInfiniteQuery(queryKey, queryFn)\n```\n\n**Options**\n\nThe options for `prefetchInfiniteQuery` are exactly the same as those of [`fetchQuery`](#queryclientfetchquery).\n\n**Returns**\n\n- `Promise<void>`\n  - A promise is returned that will either immediately resolve if no fetch is needed or after the query has been executed. It will not return any data or throw any errors.\n\n## `queryClient.getQueryData`\n\n`getQueryData` is a synchronous function that can be used to get an existing query's cached data. If the query does not exist, `undefined` will be returned.\n\n```js\nconst data = queryClient.getQueryData(queryKey)\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n**Returns**\n\n- `data: TData | undefined`\n  - The data for the cached query, or `undefined` if the query does not exist.\n\n## `queryClient.getQueriesData`\n\n`getQueriesData` is a synchronous function that can be used to get the cached data of multiple queries. Only queries that match the passed queryKey or queryFilter will be returned. If there are no matching queries, an empty array will be returned.\n\n```js\nconst data = queryClient.getQueriesData(queryKey | filters)\n```\n\n**Options**\n\n- `queryKey: QueryKey`: [Query Keys](../guides/query-keys) | `filters: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - if a queryKey is passed as the argument, the data with queryKeys fuzzily matching this param will be returned\n  - if a filter is passed, the data with queryKeys matching the filter will be returned\n\n**Returns**\n\n- `[queryKey:QueryKey, data:TData | unknown][]`\n  - An array of tuples for the matched query keys, or `[]` if there are no matches. The tuples are the query key and its associated data.\n\n**Caveats**\n\nBecause the returned data in each tuple can be of varying structures (i.e. using a filter to return \"active\" queries can return different data types), the `TData` generic defaults to `unknown`. If you provide a more specific type to `TData` it is assumed that you are certain each tuple's data entry is all the same type.\n\nThis distinction is more a \"convenience\" for ts devs that know which structure will be returned.\n\n## `queryClient.setQueryData`\n\n`setQueryData` is a synchronous function that can be used to immediately update a query's cached data. If the query does not exist, it will be created. **If the query is not utilized by a query hook in the default `cacheTime` of 5 minutes, the query will be garbage collected**. To update multiple queries at once and match query keys partially, you need to use [`queryClient.setQueriesData`](#queryclientsetqueriesdata) instead. \n\nAfter successful changing query's cached data via `setQueryData`, it will also trigger `onSuccess` callback from that query.\n\n> The difference between using `setQueryData` and `fetchQuery` is that `setQueryData` is sync and assumes that you already synchronously have the data available. If you need to fetch the data asynchronously, it's suggested that you either refetch the query key or use `fetchQuery` to handle the asynchronous fetch.\n\n```js\nqueryClient.setQueryData(queryKey, updater)\n```\n\n**Options**\n\n- `queryKey: QueryKey`: [Query Keys](../guides/query-keys)\n- `updater: TData | (oldData: TData | undefined) => TData`\n  - If non-function is passed, the data will be updated to this value\n  - If a function is passed, it will receive the old data value and be expected to return a new one.\n\n**Using an updater value**\n\n```js\nsetQueryData(queryKey, newData)\n```\n\n**Using an updater function**\n\nFor convenience in syntax, you can also pass an updater function which receives the current data value and returns the new one:\n\n```js\nsetQueryData(queryKey, oldData => newData)\n```\n\n## `queryClient.getQueryState`\n\n`getQueryState` is a synchronous function that can be used to get an existing query's state. If the query does not exist, `undefined` will be returned.\n\n```js\nconst state = queryClient.getQueryState(queryKey)\nconsole.log(state.dataUpdatedAt)\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n## `queryClient.setQueriesData`\n\n`setQueriesData` is a synchronous function that can be used to immediately update cached data of multiple queries by using filter function or partially matching the query key. Only queries that match the passed queryKey or queryFilter will be updated - no new cache entries will be created. Under the hood, [`setQueryData`](#queryclientsetquerydata) is called for each query.\n\n```js\nqueryClient.setQueriesData(queryKey | filters, updater)\n```\n\n**Options**\n\n- `queryKey: QueryKey`: [Query Keys](../guides/query-keys) | `filters: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - if a queryKey is passed as first argument, queryKeys partially matching this param will be updated\n  - if a filter is passed, queryKeys matching the filter will be updated\n- `updater: TData | (oldData: TData | undefined) => TData`\n  - the [setQueryData](#queryclientsetquerydata) updater function or new data, will be called for each matching queryKey\n\n## `queryClient.invalidateQueries`\n\nThe `invalidateQueries` method can be used to invalidate and refetch single or multiple queries in the cache based on their query keys or any other functionally accessible property/state of the query. By default, all matching queries are immediately marked as invalid and active queries are refetched in the background.\n\n- If you **do not want active queries to refetch**, and simply be marked as invalid, you can use the `refetchActive: false` option.\n- If you **want inactive queries to refetch** as well, use the `refetchInactive: true` option\n\n```js\nawait queryClient.invalidateQueries('posts', {\n  exact,\n  refetchActive: true,\n  refetchInactive: false\n}, { throwOnError, cancelRefetch })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - `refetchActive: Boolean`\n    - Defaults to `true`\n    - When set to `false`, queries that match the refetch predicate and are actively being rendered via `useQuery` and friends will NOT be refetched in the background, and only marked as invalid.\n  - `refetchInactive: Boolean`\n    - Defaults to `false`\n    - When set to `true`, queries that match the refetch predicate and are not being rendered via `useQuery` and friends will be both marked as invalid and also refetched in the background\n  - `refetchPage: (page: TData, index: number, allPages: TData[]) => boolean`\n    - Only for [Infinite Queries](../guides/infinite-queries#refetchpage)\n    - Use this function to specify which pages should be refetched\n- `options?: InvalidateOptions`:\n  - `throwOnError?: boolean`\n    - When set to `true`, this method will throw if any of the query refetch tasks fail.\n  - cancelRefetch?: boolean\n    - When set to `true`, then the current request will be cancelled before a new request is made\n\n## `queryClient.refetchQueries`\n\nThe `refetchQueries` method can be used to refetch queries based on certain conditions.\n\nExamples:\n\n```js\n// refetch all queries:\nawait queryClient.refetchQueries()\n\n// refetch all stale queries:\nawait queryClient.refetchQueries({ stale: true })\n\n// refetch all active queries partially matching a query key:\nawait queryClient.refetchQueries(['posts'], { active: true })\n\n// refetch all active queries exactly matching a query key:\nawait queryClient.refetchQueries(['posts', 1], { active: true, exact: true })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - `refetchPage: (page: TData, index: number, allPages: TData[]) => boolean`\n    - Only for [Infinite Queries](../guides/infinite-queries#refetchpage)\n    - Use this function to specify which pages should be refetched\n- `options?: RefetchOptions`:\n  - `throwOnError?: boolean`\n    - When set to `true`, this method will throw if any of the query refetch tasks fail.\n  - cancelRefetch?: boolean\n    - When set to `true`, then the current request will be cancelled before a new request is made\n\n**Returns**\n\nThis function returns a promise that will resolve when all of the queries are done being refetched. By default, it **will not** throw an error if any of those queries refetches fail, but this can be configured by setting the `throwOnError` option to `true`\n\n## `queryClient.cancelQueries`\n\nThe `cancelQueries` method can be used to cancel outgoing queries based on their query keys or any other functionally accessible property/state of the query.\n\nThis is most useful when performing optimistic updates since you will likely need to cancel any outgoing query refetches so they don't clobber your optimistic update when they resolve.\n\n```js\nawait queryClient.cancelQueries('posts', { exact: true })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n**Returns**\n\nThis method does not return anything\n\n## `queryClient.removeQueries`\n\nThe `removeQueries` method can be used to remove queries from the cache based on their query keys or any other functionally accessible property/state of the query.\n\n```js\nqueryClient.removeQueries(queryKey, { exact: true })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n**Returns**\n\nThis method does not return anything\n\n## `queryClient.resetQueries`\n\nThe `resetQueries` method can be used to reset queries in the cache to their\ninitial state based on their query keys or any other functionally accessible\nproperty/state of the query.\n\nThis will notify subscribers &mdash; unlike `clear`, which removes all\nsubscribers &mdash; and reset the query to its pre-loaded state &mdash; unlike\n`invalidateQueries`. If a query has `initialData`, the query's data will be\nreset to that. If a query is active, it will be refetched.\n\n```js\nqueryClient.resetQueries(queryKey, { exact: true })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - `refetchPage: (page: TData, index: number, allPages: TData[]) => boolean`\n    - Only for [Infinite Queries](../guides/infinite-queries#refetchpage)\n    - Use this function to specify which pages should be refetched\n- `options?: ResetOptions`:\n  - `throwOnError?: boolean`\n    - When set to `true`, this method will throw if any of the query refetch tasks fail.\n  - cancelRefetch?: boolean\n    - When set to `true`, then the current request will be cancelled before a new request is made\n\n**Returns**\n\nThis method returns a promise that resolves when all active queries have been refetched.\n\n## `queryClient.isFetching`\n\nThis `isFetching` method returns an `integer` representing how many queries, if any, in the cache are currently fetching (including background-fetching, loading new pages, or loading more infinite query results)\n\n```js\nif (queryClient.isFetching()) {\n  console.log('At least one query is fetching!')\n}\n```\n\nReact Query also exports a handy [`useIsFetching`](./useIsFetching) hook that will let you subscribe to this state in your components without creating a manual subscription to the query cache.\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n**Returns**\n\nThis method returns the number of fetching queries.\n\n## `queryClient.isMutating`\n\nThis `isMutating` method returns an `integer` representing how many mutations, if any, in the cache are currently fetching.\n\n```js\nif (queryClient.isMutating()) {\n  console.log('At least one mutation is fetching!')\n}\n```\n\nReact Query also exports a handy [`useIsMutating`](./useIsMutating) hook that will let you subscribe to this state in your components without creating a manual subscription to the mutation cache.\n\n**Options**\n\n- `filters: MutationFilters`: [Mutation Filters](../guides/filters#mutation-filters)\n\n**Returns**\n\nThis method returns the number of fetching mutations.\n## `queryClient.getDefaultOptions`\n\nThe `getDefaultOptions` method returns the default options which have been set when creating the client or with `setDefaultOptions`.\n\n```js\nconst defaultOptions = queryClient.getDefaultOptions()\n```\n\n## `queryClient.setDefaultOptions`\n\nThe `setDefaultOptions` method can be used to dynamically set the default options for this queryClient. Previously defined default options will be overwritten.\n\n```js\nqueryClient.setDefaultOptions({\n  queries: {\n    staleTime: Infinity,\n  },\n})\n```\n\n## `queryClient.getQueryDefaults`\n\nThe `getQueryDefaults` method returns the default options which have been set for specific queries:\n\n```js\nconst defaultOptions = queryClient.getQueryDefaults('posts')\n```\n\n## `queryClient.setQueryDefaults`\n\n`setQueryDefaults` can be used to set default options for specific queries:\n\n```js\nqueryClient.setQueryDefaults('posts', { queryFn: fetchPosts })\n\nfunction Component() {\n  const { data } = useQuery('posts')\n}\n```\n\n**Options**\n\n- `queryKey: QueryKey`: [Query Keys](../guides/query-keys)\n- `options: QueryOptions`\n\n## `queryClient.getMutationDefaults`\n\nThe `getMutationDefaults` method returns the default options which have been set for specific mutations:\n\n```js\nconst defaultOptions = queryClient.getMutationDefaults('addPost')\n```\n\n## `queryClient.setMutationDefaults`\n\n`setMutationDefaults` can be used to set default options for specific mutations:\n\n```js\nqueryClient.setMutationDefaults('addPost', { mutationFn: addPost })\n\nfunction Component() {\n  const { data } = useMutation('addPost')\n}\n```\n\n**Options**\n\n- `mutationKey: string | unknown[]`\n- `options: MutationOptions`\n\n## `queryClient.getQueryCache`\n\nThe `getQueryCache` method returns the query cache this client is connected to.\n\n```js\nconst queryCache = queryClient.getQueryCache()\n```\n\n## `queryClient.getMutationCache`\n\nThe `getMutationCache` method returns the mutation cache this client is connected to.\n\n```js\nconst mutationCache = queryClient.getMutationCache()\n```\n\n## `queryClient.clear`\n\nThe `clear` method clears all connected caches.\n\n```js\nqueryClient.clear()\n```\n","originalRawMarkdown":"---\nid: QueryClient\ntitle: QueryClient\n---\n\n## `QueryClient`\n\nThe `QueryClient` can be used to interact with a cache:\n\n```js\nimport { QueryClient } from 'react-query'\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: {\n      staleTime: Infinity,\n    },\n  },\n})\n\nawait queryClient.prefetchQuery('posts', fetchPosts)\n```\n\nIts available methods are:\n\n- [`queryClient.fetchQuery`](#queryclientfetchquery)\n- [`queryClient.fetchInfiniteQuery`](#queryclientfetchinfinitequery)\n- [`queryClient.prefetchQuery`](#queryclientprefetchquery)\n- [`queryClient.prefetchInfiniteQuery`](#queryclientprefetchinfinitequery)\n- [`queryClient.getQueryData`](#queryclientgetquerydata)\n- [`queryClient.getQueriesData`](#queryclientgetqueriesdata)\n- [`queryClient.setQueryData`](#queryclientsetquerydata)\n- [`queryClient.getQueryState`](#queryclientgetquerystate)\n- [`queryClient.setQueriesData`](#queryclientsetqueriesdata)\n- [`queryClient.invalidateQueries`](#queryclientinvalidatequeries)\n- [`queryClient.refetchQueries`](#queryclientrefetchqueries)\n- [`queryClient.cancelQueries`](#queryclientcancelqueries)\n- [`queryClient.removeQueries`](#queryclientremovequeries)\n- [`queryClient.resetQueries`](#queryclientresetqueries)\n- [`queryClient.isFetching`](#queryclientisfetching)\n- [`queryClient.isMutating`](#queryclientismutating)\n- [`queryClient.getDefaultOptions`](#queryclientgetdefaultoptions)\n- [`queryClient.setDefaultOptions`](#queryclientsetdefaultoptions)\n- [`queryClient.getQueryDefaults`](#queryclientgetquerydefaults)\n- [`queryClient.setQueryDefaults`](#queryclientsetquerydefaults)\n- [`queryClient.getMutationDefaults`](#queryclientgetmutationdefaults)\n- [`queryClient.setMutationDefaults`](#queryclientsetmutationdefaults)\n- [`queryClient.getQueryCache`](#queryclientgetquerycache)\n- [`queryClient.getMutationCache`](#queryclientgetmutationcache)\n- [`queryClient.clear`](#queryclientclear)\n\n**Options**\n\n- `queryCache?: QueryCache`\n  - Optional\n  - The query cache this client is connected to.\n- `mutationCache?: MutationCache`\n  - Optional\n  - The mutation cache this client is connected to.\n- `defaultOptions?: DefaultOptions`\n  - Optional\n  - Define defaults for all queries and mutations using this queryClient.\n\n## `queryClient.fetchQuery`\n\n`fetchQuery` is an asynchronous method that can be used to fetch and cache a query. It will either resolve with the data or throw with the error. Use the `prefetchQuery` method if you just want to fetch a query without needing the result.\n\nIf the query exists and the data is not invalidated or older than the given `staleTime`, then the data from the cache will be returned. Otherwise it will try to fetch the latest data.\n\n> The difference between using `fetchQuery` and `setQueryData` is that `fetchQuery` is async and will ensure that duplicate requests for this query are not created with `useQuery` instances for the same query are rendered while the data is fetching.\n\n```js\ntry {\n  const data = await queryClient.fetchQuery(queryKey, queryFn)\n} catch (error) {\n  console.log(error)\n}\n```\n\nSpecify a `staleTime` to only fetch when the data is older than a certain amount of time:\n\n```js\ntry {\n  const data = await queryClient.fetchQuery(queryKey, queryFn, {\n    staleTime: 10000,\n  })\n} catch (error) {\n  console.log(error)\n}\n```\n\n**Options**\n\nThe options for `fetchQuery` are exactly the same as those of [`useQuery`](./useQuery), except the following: `enabled, refetchInterval, refetchIntervalInBackground, refetchOnWindowFocus, refetchOnReconnect, notifyOnChangeProps, notifyOnChangePropsExclusions, onSuccess, onError, onSettled, useErrorBoundary, select, suspense, keepPreviousData, placeholderData`; which are strictly for useQuery and useInfiniteQuery. You can check the [source code](https://github.com/tannerlinsley/react-query/blob/361935a12cec6f36d0bd6ba12e84136c405047c5/src/core/types.ts#L83) for more clarity.\n\n**Returns**\n\n- `Promise<TData>`\n\n## `queryClient.fetchInfiniteQuery`\n\n`fetchInfiniteQuery` is similar to `fetchQuery` but can be used to fetch and cache an infinite query.\n\n```js\ntry {\n  const data = await queryClient.fetchInfiniteQuery(queryKey, queryFn)\n  console.log(data.pages)\n} catch (error) {\n  console.log(error)\n}\n```\n\n**Options**\n\nThe options for `fetchInfiniteQuery` are exactly the same as those of [`fetchQuery`](#queryclientfetchquery).\n\n**Returns**\n\n- `Promise<InfiniteData<TData>>`\n\n## `queryClient.prefetchQuery`\n\n`prefetchQuery` is an asynchronous method that can be used to prefetch a query before it is needed or rendered with `useQuery` and friends. The method works the same as `fetchQuery` except that it will not throw or return any data.\n\n```js\nawait queryClient.prefetchQuery(queryKey, queryFn)\n```\n\nYou can even use it with a default queryFn in your config!\n\n```js\nawait queryClient.prefetchQuery(queryKey)\n```\n\n**Options**\n\nThe options for `prefetchQuery` are exactly the same as those of [`fetchQuery`](#queryclientfetchquery).\n\n**Returns**\n\n- `Promise<void>`\n  - A promise is returned that will either immediately resolve if no fetch is needed or after the query has been executed. It will not return any data or throw any errors.\n\n## `queryClient.prefetchInfiniteQuery`\n\n`prefetchInfiniteQuery` is similar to `prefetchQuery` but can be used to prefetch and cache an infinite query.\n\n```js\nawait queryClient.prefetchInfiniteQuery(queryKey, queryFn)\n```\n\n**Options**\n\nThe options for `prefetchInfiniteQuery` are exactly the same as those of [`fetchQuery`](#queryclientfetchquery).\n\n**Returns**\n\n- `Promise<void>`\n  - A promise is returned that will either immediately resolve if no fetch is needed or after the query has been executed. It will not return any data or throw any errors.\n\n## `queryClient.getQueryData`\n\n`getQueryData` is a synchronous function that can be used to get an existing query's cached data. If the query does not exist, `undefined` will be returned.\n\n```js\nconst data = queryClient.getQueryData(queryKey)\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n**Returns**\n\n- `data: TData | undefined`\n  - The data for the cached query, or `undefined` if the query does not exist.\n\n## `queryClient.getQueriesData`\n\n`getQueriesData` is a synchronous function that can be used to get the cached data of multiple queries. Only queries that match the passed queryKey or queryFilter will be returned. If there are no matching queries, an empty array will be returned.\n\n```js\nconst data = queryClient.getQueriesData(queryKey | filters)\n```\n\n**Options**\n\n- `queryKey: QueryKey`: [Query Keys](../guides/query-keys) | `filters: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - if a queryKey is passed as the argument, the data with queryKeys fuzzily matching this param will be returned\n  - if a filter is passed, the data with queryKeys matching the filter will be returned\n\n**Returns**\n\n- `[queryKey:QueryKey, data:TData | unknown][]`\n  - An array of tuples for the matched query keys, or `[]` if there are no matches. The tuples are the query key and its associated data.\n\n**Caveats**\n\nBecause the returned data in each tuple can be of varying structures (i.e. using a filter to return \"active\" queries can return different data types), the `TData` generic defaults to `unknown`. If you provide a more specific type to `TData` it is assumed that you are certain each tuple's data entry is all the same type.\n\nThis distinction is more a \"convenience\" for ts devs that know which structure will be returned.\n\n## `queryClient.setQueryData`\n\n`setQueryData` is a synchronous function that can be used to immediately update a query's cached data. If the query does not exist, it will be created. **If the query is not utilized by a query hook in the default `cacheTime` of 5 minutes, the query will be garbage collected**. To update multiple queries at once and match query keys partially, you need to use [`queryClient.setQueriesData`](#queryclientsetqueriesdata) instead. \n\nAfter successful changing query's cached data via `setQueryData`, it will also trigger `onSuccess` callback from that query.\n\n> The difference between using `setQueryData` and `fetchQuery` is that `setQueryData` is sync and assumes that you already synchronously have the data available. If you need to fetch the data asynchronously, it's suggested that you either refetch the query key or use `fetchQuery` to handle the asynchronous fetch.\n\n```js\nqueryClient.setQueryData(queryKey, updater)\n```\n\n**Options**\n\n- `queryKey: QueryKey`: [Query Keys](../guides/query-keys)\n- `updater: TData | (oldData: TData | undefined) => TData`\n  - If non-function is passed, the data will be updated to this value\n  - If a function is passed, it will receive the old data value and be expected to return a new one.\n\n**Using an updater value**\n\n```js\nsetQueryData(queryKey, newData)\n```\n\n**Using an updater function**\n\nFor convenience in syntax, you can also pass an updater function which receives the current data value and returns the new one:\n\n```js\nsetQueryData(queryKey, oldData => newData)\n```\n\n## `queryClient.getQueryState`\n\n`getQueryState` is a synchronous function that can be used to get an existing query's state. If the query does not exist, `undefined` will be returned.\n\n```js\nconst state = queryClient.getQueryState(queryKey)\nconsole.log(state.dataUpdatedAt)\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n## `queryClient.setQueriesData`\n\n`setQueriesData` is a synchronous function that can be used to immediately update cached data of multiple queries by using filter function or partially matching the query key. Only queries that match the passed queryKey or queryFilter will be updated - no new cache entries will be created. Under the hood, [`setQueryData`](#queryclientsetquerydata) is called for each query.\n\n```js\nqueryClient.setQueriesData(queryKey | filters, updater)\n```\n\n**Options**\n\n- `queryKey: QueryKey`: [Query Keys](../guides/query-keys) | `filters: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - if a queryKey is passed as first argument, queryKeys partially matching this param will be updated\n  - if a filter is passed, queryKeys matching the filter will be updated\n- `updater: TData | (oldData: TData | undefined) => TData`\n  - the [setQueryData](#queryclientsetquerydata) updater function or new data, will be called for each matching queryKey\n\n## `queryClient.invalidateQueries`\n\nThe `invalidateQueries` method can be used to invalidate and refetch single or multiple queries in the cache based on their query keys or any other functionally accessible property/state of the query. By default, all matching queries are immediately marked as invalid and active queries are refetched in the background.\n\n- If you **do not want active queries to refetch**, and simply be marked as invalid, you can use the `refetchActive: false` option.\n- If you **want inactive queries to refetch** as well, use the `refetchInactive: true` option\n\n```js\nawait queryClient.invalidateQueries('posts', {\n  exact,\n  refetchActive: true,\n  refetchInactive: false\n}, { throwOnError, cancelRefetch })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - `refetchActive: Boolean`\n    - Defaults to `true`\n    - When set to `false`, queries that match the refetch predicate and are actively being rendered via `useQuery` and friends will NOT be refetched in the background, and only marked as invalid.\n  - `refetchInactive: Boolean`\n    - Defaults to `false`\n    - When set to `true`, queries that match the refetch predicate and are not being rendered via `useQuery` and friends will be both marked as invalid and also refetched in the background\n  - `refetchPage: (page: TData, index: number, allPages: TData[]) => boolean`\n    - Only for [Infinite Queries](../guides/infinite-queries#refetchpage)\n    - Use this function to specify which pages should be refetched\n- `options?: InvalidateOptions`:\n  - `throwOnError?: boolean`\n    - When set to `true`, this method will throw if any of the query refetch tasks fail.\n  - cancelRefetch?: boolean\n    - When set to `true`, then the current request will be cancelled before a new request is made\n\n## `queryClient.refetchQueries`\n\nThe `refetchQueries` method can be used to refetch queries based on certain conditions.\n\nExamples:\n\n```js\n// refetch all queries:\nawait queryClient.refetchQueries()\n\n// refetch all stale queries:\nawait queryClient.refetchQueries({ stale: true })\n\n// refetch all active queries partially matching a query key:\nawait queryClient.refetchQueries(['posts'], { active: true })\n\n// refetch all active queries exactly matching a query key:\nawait queryClient.refetchQueries(['posts', 1], { active: true, exact: true })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - `refetchPage: (page: TData, index: number, allPages: TData[]) => boolean`\n    - Only for [Infinite Queries](../guides/infinite-queries#refetchpage)\n    - Use this function to specify which pages should be refetched\n- `options?: RefetchOptions`:\n  - `throwOnError?: boolean`\n    - When set to `true`, this method will throw if any of the query refetch tasks fail.\n  - cancelRefetch?: boolean\n    - When set to `true`, then the current request will be cancelled before a new request is made\n\n**Returns**\n\nThis function returns a promise that will resolve when all of the queries are done being refetched. By default, it **will not** throw an error if any of those queries refetches fail, but this can be configured by setting the `throwOnError` option to `true`\n\n## `queryClient.cancelQueries`\n\nThe `cancelQueries` method can be used to cancel outgoing queries based on their query keys or any other functionally accessible property/state of the query.\n\nThis is most useful when performing optimistic updates since you will likely need to cancel any outgoing query refetches so they don't clobber your optimistic update when they resolve.\n\n```js\nawait queryClient.cancelQueries('posts', { exact: true })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n**Returns**\n\nThis method does not return anything\n\n## `queryClient.removeQueries`\n\nThe `removeQueries` method can be used to remove queries from the cache based on their query keys or any other functionally accessible property/state of the query.\n\n```js\nqueryClient.removeQueries(queryKey, { exact: true })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n**Returns**\n\nThis method does not return anything\n\n## `queryClient.resetQueries`\n\nThe `resetQueries` method can be used to reset queries in the cache to their\ninitial state based on their query keys or any other functionally accessible\nproperty/state of the query.\n\nThis will notify subscribers &mdash; unlike `clear`, which removes all\nsubscribers &mdash; and reset the query to its pre-loaded state &mdash; unlike\n`invalidateQueries`. If a query has `initialData`, the query's data will be\nreset to that. If a query is active, it will be refetched.\n\n```js\nqueryClient.resetQueries(queryKey, { exact: true })\n```\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n  - `refetchPage: (page: TData, index: number, allPages: TData[]) => boolean`\n    - Only for [Infinite Queries](../guides/infinite-queries#refetchpage)\n    - Use this function to specify which pages should be refetched\n- `options?: ResetOptions`:\n  - `throwOnError?: boolean`\n    - When set to `true`, this method will throw if any of the query refetch tasks fail.\n  - cancelRefetch?: boolean\n    - When set to `true`, then the current request will be cancelled before a new request is made\n\n**Returns**\n\nThis method returns a promise that resolves when all active queries have been refetched.\n\n## `queryClient.isFetching`\n\nThis `isFetching` method returns an `integer` representing how many queries, if any, in the cache are currently fetching (including background-fetching, loading new pages, or loading more infinite query results)\n\n```js\nif (queryClient.isFetching()) {\n  console.log('At least one query is fetching!')\n}\n```\n\nReact Query also exports a handy [`useIsFetching`](./useIsFetching) hook that will let you subscribe to this state in your components without creating a manual subscription to the query cache.\n\n**Options**\n\n- `queryKey?: QueryKey`: [Query Keys](../guides/query-keys)\n- `filters?: QueryFilters`: [Query Filters](../guides/filters#query-filters)\n\n**Returns**\n\nThis method returns the number of fetching queries.\n\n## `queryClient.isMutating`\n\nThis `isMutating` method returns an `integer` representing how many mutations, if any, in the cache are currently fetching.\n\n```js\nif (queryClient.isMutating()) {\n  console.log('At least one mutation is fetching!')\n}\n```\n\nReact Query also exports a handy [`useIsMutating`](./useIsMutating) hook that will let you subscribe to this state in your components without creating a manual subscription to the mutation cache.\n\n**Options**\n\n- `filters: MutationFilters`: [Mutation Filters](../guides/filters#mutation-filters)\n\n**Returns**\n\nThis method returns the number of fetching mutations.\n## `queryClient.getDefaultOptions`\n\nThe `getDefaultOptions` method returns the default options which have been set when creating the client or with `setDefaultOptions`.\n\n```js\nconst defaultOptions = queryClient.getDefaultOptions()\n```\n\n## `queryClient.setDefaultOptions`\n\nThe `setDefaultOptions` method can be used to dynamically set the default options for this queryClient. Previously defined default options will be overwritten.\n\n```js\nqueryClient.setDefaultOptions({\n  queries: {\n    staleTime: Infinity,\n  },\n})\n```\n\n## `queryClient.getQueryDefaults`\n\nThe `getQueryDefaults` method returns the default options which have been set for specific queries:\n\n```js\nconst defaultOptions = queryClient.getQueryDefaults('posts')\n```\n\n## `queryClient.setQueryDefaults`\n\n`setQueryDefaults` can be used to set default options for specific queries:\n\n```js\nqueryClient.setQueryDefaults('posts', { queryFn: fetchPosts })\n\nfunction Component() {\n  const { data } = useQuery('posts')\n}\n```\n\n**Options**\n\n- `queryKey: QueryKey`: [Query Keys](../guides/query-keys)\n- `options: QueryOptions`\n\n## `queryClient.getMutationDefaults`\n\nThe `getMutationDefaults` method returns the default options which have been set for specific mutations:\n\n```js\nconst defaultOptions = queryClient.getMutationDefaults('addPost')\n```\n\n## `queryClient.setMutationDefaults`\n\n`setMutationDefaults` can be used to set default options for specific mutations:\n\n```js\nqueryClient.setMutationDefaults('addPost', { mutationFn: addPost })\n\nfunction Component() {\n  const { data } = useMutation('addPost')\n}\n```\n\n**Options**\n\n- `mutationKey: string | unknown[]`\n- `options: MutationOptions`\n\n## `queryClient.getQueryCache`\n\nThe `getQueryCache` method returns the query cache this client is connected to.\n\n```js\nconst queryCache = queryClient.getQueryCache()\n```\n\n## `queryClient.getMutationCache`\n\nThe `getMutationCache` method returns the mutation cache this client is connected to.\n\n```js\nconst mutationCache = queryClient.getMutationCache()\n```\n\n## `queryClient.clear`\n\nThe `clear` method clears all connected caches.\n\n```js\nqueryClient.clear()\n```\n"}
