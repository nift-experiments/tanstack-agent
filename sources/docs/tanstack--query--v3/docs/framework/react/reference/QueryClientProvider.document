{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inlineCode","value":"QueryClientProvider"},{"type":"text","value":" component to connect and provide a "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":" to your application:"}]},{"type":"code","value":"import { QueryClient, QueryClientProvider } from 'react-query'\n\nconst queryClient = new QueryClient()\n\nfunction App() {\n  return <QueryClientProvider client={queryClient}>...</QueryClientProvider>\n}","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"client: QueryClient"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Required"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the QueryClient instance to provide"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"contextSharing: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"defaults to "},{"type":"inlineCode","value":"false"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" to enable context sharing, which will share the first and at least one instance of the context across the window  to ensure that if React Query is used across  different bundles or microfrontends they will  all use the same "},{"type":"strong","children":[{"type":"text","value":"instance"}]},{"type":"text","value":" of context, regardless of module scoping."}]}]}]}]}]}],"headings":[]},"frameworks":[],"downloadMarkdown":"\nUse the `QueryClientProvider` component to connect and provide a `QueryClient` to your application:\n\n```js\nimport { QueryClient, QueryClientProvider } from 'react-query'\n\nconst queryClient = new QueryClient()\n\nfunction App() {\n  return <QueryClientProvider client={queryClient}>...</QueryClientProvider>\n}\n```\n**Options**\n\n- `client: QueryClient`\n  - **Required**\n  - the QueryClient instance to provide\n- `contextSharing: boolean`\n  - defaults to `false`\n  - Set this to `true` to enable context sharing, which will share the first and at least one instance of the context across the window  to ensure that if React Query is used across  different bundles or microfrontends they will  all use the same **instance** of context, regardless of module scoping.\n","originalRawMarkdown":"---\nid: QueryClientProvider\ntitle: QueryClientProvider\n---\n\nUse the `QueryClientProvider` component to connect and provide a `QueryClient` to your application:\n\n```js\nimport { QueryClient, QueryClientProvider } from 'react-query'\n\nconst queryClient = new QueryClient()\n\nfunction App() {\n  return <QueryClientProvider client={queryClient}>...</QueryClientProvider>\n}\n```\n**Options**\n\n- `client: QueryClient`\n  - **Required**\n  - the QueryClient instance to provide\n- `contextSharing: boolean`\n  - defaults to `false`\n  - Set this to `true` to enable context sharing, which will share the first and at least one instance of the context across the window  to ensure that if React Query is used across  different bundles or microfrontends they will  all use the same **instance** of context, regardless of module scoping.\n"}
