value":"limitations"}]},{"type":"paragraph","children":[{"type":"text","value":"The hydration API requires values to be JSON serializable. If you need to dehydrate values that are not automatically serializable to JSON (like "},{"type":"inlineCode","value":"Error"},{"type":"text","value":" or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"), you have to serialize them for yourself. Since only successful queries are included per default, to also include "},{"type":"inlineCode","value":"Errors"},{"type":"text","value":", you have to provide "},{"type":"inlineCode","value":"shouldDehydrateQuery"},{"type":"text","value":", e.g.:"}]},{"type":"code","value":"// server\nconst state = dehydrate(client, { shouldDehydrateQuery: () => true }) // to also include Errors\nconst serializedState = mySerialize(state) // transform Error instances to objects\n\n// client\nconst state = myDeserialize(serializedState)  // transform objects back to Error instances\nhydrate(client, state)","lang":"js"},{"type":"heading","depth":2,"id":"hydrate","children":[{"type":"inlineCode","value":"hydrate"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" adds a previously dehydrated state into a "},{"type":"inlineCode","value":"cache"},{"type":"text","value":". If the queries included in dehydration already exist in the queryCache, "},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" does not overwrite them."}]},{"type":"code","value":"import { hydrate } from 'react-query'\n\nhydrate(queryClient, dehydratedState, options)","lang":"js"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Note: Since version "},{"type":"inlineCode","value":"3.22.0"},{"type":"text","value":" hydration utilities moved into to core. If you using lower version your should import "},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" from "},{"type":"inlineCode","value":"react-query/hydration"}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"client: QueryClient"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Required"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"queryClient"},{"type":"text","value":" to hydrate the state into"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"dehydratedState: DehydratedState"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Required"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state to hydrate into the client"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options: HydrateOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultOptions: DefaultOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutations: MutationOptions"},{"type":"text","value":" The default mutation options to use for the hydrated mutations."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queries: QueryOptions"},{"type":"text","value":" The default query options to use for the hydrated queries."}]}]}]}]}]}]}]},{"type":"heading","depth":2,"id":"usehydrate","children":[{"type":"inlineCode","value":"useHydrate"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"useHydrate"},{"type":"text","value":" adds a previously dehydrated state into the "},{"type":"inlineCode","value":"queryClient"},{"type":"text","value":" that would be returned by "},{"type":"inlineCode","value":"useQueryClient()"},{"type":"text","value":". If the client already contains data, the new queries will be intelligently merged based on update timestamp."}]},{"type":"code","value":"import { useHydrate } from 'react-query'\n\nuseHydrate(dehydratedState, options)","lang":"jsx"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Note: Since version "},{"type":"inlineCode","value":"3.22.0"},{"type":"text","value":" hydration utilities moved into to core. If you using lower version your should import "},{"type":"inlineCode","value":"useHydrate"},{"type":"text","value":" from "},{"type":"inlineCode","value":"react-query/hydration"}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"dehydratedState: DehydratedState"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Required"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state to hydrate"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options: HydrateOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultOptions: QueryOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The default query options to use for the hydrated queries."}]}]}]}]}]}]}]},{"type":"heading","depth":2,"id":"hydrate-2","children":[{"type":"inlineCode","value":"Hydrate"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Hydrate"},{"type":"text","value":" wraps "},{"type":"inlineCode","value":"useHydrate"},{"type":"text","value":" into component. Can be useful when you need hydrate in class component or need hydrate on same level where "},{"type":"inlineCode","value":"QueryClientProvider"},{"type":"text","value":" rendered."}]},{"type":"code","value":"import { Hydrate } from 'react-query'\n\nfunction App() {\n  return <Hydrate state={dehydratedState}>...</Hydrate>\n}","lang":"js"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Note: Since version "},{"type":"inlineCode","value":"3.22.0"},{"type":"text","value":" hydration utilities moved into to core. If you using lower version your should import "},{"type":"inlineCode","value":"Hydrate"},{"type":"text","value":" from "},{"type":"inlineCode","value":"react-query/hydration"}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"state: DehydratedState"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state to hydrate"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options: HydrateOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultOptions: QueryOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The default query options to use for the hydrated queries."}]}]}]}]}]}]}]}],"headings":[{"id":"dehydrate","text":"dehydrate","level":2},{"id":"limitations","text":"limitations","level":3},{"id":"hydrate","text":"hydrate","level":2},{"id":"usehydrate","text":"useHydrate","level":2},{"id":"hydrate-2","text":"Hydrate","level":2}]},"frameworks":[],"downloadMarkdown":"\n## `dehydrate`\n\n`dehydrate` creates a frozen representation of a `cache` that can later be hydrated with `Hydrate`, `useHydrate`, or `hydrate`. This is useful for passing prefetched queries from server to client or persisting queries to localStorage or other persistent locations. It only includes currently successful queries by default.\n\n```js\nimport { dehydrate } from 'react-query'\n\nconst dehydratedState = dehydrate(queryClient, {\n  shouldDehydrateQuery,\n})\n```\n\n> Note: Since version `3.22.0` hydration utilities moved into to core. If you using lower version your should import `dehydrate` from `react-query/hydration`\n\n**Options**\n\n- `client: QueryClient`\n  - **Required**\n  - The `queryClient` that should be dehydrated\n- `options: DehydrateOptions`\n  - Optional\n  - `dehydrateMutations: boolean`\n    - Optional\n    - Whether or not to dehydrate mutations.\n  - `dehydrateQueries: boolean`\n    - Optional\n    - Whether or not to dehydrate queries.\n  - `shouldDehydrateMutation: (mutation: Mutation) => boolean`\n    - Optional\n    - This function is called for each mutation in the cache\n    - Return `true` to include this mutation in dehydration, or `false` otherwise\n    - The default version only includes paused mutations\n  - `shouldDehydrateQuery: (query: Query) => boolean`\n    - Optional\n    - This function is called for each query in the cache\n    - Return `true` to include this query in dehydration, or `false` otherwise\n    - The default version only includes successful queries, do `shouldDehydrateQuery: () => true` to include all queries\n\n**Returns**\n\n- `dehydratedState: DehydratedState`\n  - This includes everything that is needed to hydrate the `queryClient` at a later point\n  - You **should not** rely on the exact format of this response, it is not part of the public API and can change at any time\n  - This result is not in serialized form, you need to do that yourself if desired\n\n### limitations\n\nThe hydration API requires values to be JSON serializable. If you need to dehydrate values that are not automatically serializable to JSON (like `Error` or `undefined`), you have to serialize them for yourself. Since only successful queries are included per default, to also include `Errors`, you have to provide `shouldDehydrateQuery`, e.g.:\n\n```js\n// server\nconst state = dehydrate(client, { shouldDehydrateQuery: () => true }) // to also include Errors\nconst serializedState = mySerialize(state) // transform Error instances to objects\n\n// client\nconst state = myDeserialize(serializedState)  // transform objects back to Error instances\nhydrate(client, state)\n```\n\n## `hydrate`\n\n`hydrate` adds a previously dehydrated state into a `cache`. If the queries included in dehydration already exist in the queryCache, `hydrate` does not overwrite them.\n\n```js\nimport { hydrate } from 'react-query'\n\nhydrate(queryClient, dehydratedState, options)\n```\n\n> Note: Since version `3.22.0` hydration utilities moved into to core. If you using lower version your should import `hydrate` from `react-query/hydration`\n\n**Options**\n\n- `client: QueryClient`\n  - **Required**\n  - The `queryClient` to hydrate the state into\n- `dehydratedState: DehydratedState`\n  - **Required**\n  - The state to hydrate into the client\n- `options: HydrateOptions`\n  - Optional\n  - `defaultOptions: DefaultOptions`\n    - Optional\n    - `mutations: MutationOptions` The default mutation options to use for the hydrated mutations.\n    - `queries: QueryOptions` The default query options to use for the hydrated queries.\n\n## `useHydrate`\n\n`useHydrate` adds a previously dehydrated state into the `queryClient` that would be returned by `useQueryClient()`. If the client already contains data, the new queries will be intelligently merged based on update timestamp.\n\n```jsx\nimport { useHydrate } from 'react-query'\n\nuseHydrate(dehydratedState, options)\n```\n\n> Note: Since version `3.22.0` hydration utilities moved into to core. If you using lower version your should import `useHydrate` from `react-query/hydration`\n\n**Options**\n\n- `dehydratedState: DehydratedState`\n  - **Required**\n  - The state to hydrate\n- `options: HydrateOptions`\n  - Optional\n  - `defaultOptions: QueryOptions`\n    - The default query options to use for the hydrated queries.\n\n## `Hydrate`\n\n`Hydrate` wraps `useHydrate` into component. Can be useful when you need hydrate in class component or need hydrate on same level where `QueryClientProvider` rendered.\n\n```js\nimport { Hydrate } from 'react-query'\n\nfunction App() {\n  return <Hydrate state={dehydratedState}>...</Hydrate>\n}\n```\n\n> Note: Since version `3.22.0` hydration utilities moved into to core. If you using lower version your should import `Hydrate` from `react-query/hydration`\n\n**Options**\n\n- `state: DehydratedState`\n  - The state to hydrate\n- `options: HydrateOptions`\n  - Optional\n  - `defaultOptions: QueryOptions`\n    - The default query options to use for the hydrated queries.\n","originalRawMarkdown":"---\nid: hydration\ntitle: hydration\n---\n\n## `dehydrate`\n\n`dehydrate` creates a frozen representation of a `cache` that can later be hydrated with `Hydrate`, `useHydrate`, or `hydrate`. This is useful for passing prefetched queries from server to client or persisting queries to localStorage or other persistent locations. It only includes currently successful queries by default.\n\n```js\nimport { dehydrate } from 'react-query'\n\nconst dehydratedState = dehydrate(queryClient, {\n  shouldDehydrateQuery,\n})\n```\n\n> Note: Since version `3.22.0` hydration utilities moved into to core. If you using lower version your should import `dehydrate` from `react-query/hydration`\n\n**Options**\n\n- `client: QueryClient`\n  - **Required**\n  - The `queryClient` that should be dehydrated\n- `options: DehydrateOptions`\n  - Optional\n  - `dehydrateMutations: boolean`\n    - Optional\n    - Whether or not to dehydrate mutations.\n  - `dehydrateQueries: boolean`\n    - Optional\n    - Whether or not to dehydrate queries.\n  - `shouldDehydrateMutation: (mutation: Mutation) => boolean`\n    - Optional\n    - This function is called for each mutation in the cache\n    - Return `true` to include this mutation in dehydration, or `false` otherwise\n    - The default version only includes paused mutations\n  - `shouldDehydrateQuery: (query: Query) => boolean`\n    - Optional\n    - This function is called for each query in the cache\n    - Return `true` to include this query in dehydration, or `false` otherwise\n    - The default version only includes successful queries, do `shouldDehydrateQuery: () => true` to include all queries\n\n**Returns**\n\n- `dehydratedState: DehydratedState`\n  - This includes everything that is needed to hydrate the `queryClient` at a later point\n  - You **should not** rely on the exact format of this response, it is not part of the public API and can change at any time\n  - This result is not in serialized form, you need to do that yourself if desired\n\n### limitations\n\nThe hydration API requires values to be JSON serializable. If you need to dehydrate values that are not automatically serializable to JSON (like `Error` or `undefined`), you have to serialize them for yourself. Since only successful queries are included per default, to also include `Errors`, you have to provide `shouldDehydrateQuery`, e.g.:\n\n```js\n// server\nconst state = dehydrate(client, { shouldDehydrateQuery: () => true }) // to also include Errors\nconst serializedState = mySerialize(state) // transform Error instances to objects\n\n// client\nconst state = myDeserialize(serializedState)  // transform objects back to Error instances\nhydrate(client, state)\n```\n\n## `hydrate`\n\n`hydrate` adds a previously dehydrated state into a `cache`. If the queries included in dehydration already exist in the queryCache, `hydrate` does not overwrite them.\n\n```js\nimport { hydrate } from 'react-query'\n\nhydrate(queryClient, dehydratedState, options)\n```\n\n> Note: Since version `3.22.0` hydration utilities moved into to core. If you using lower version your should import `hydrate` from `react-query/hydration`\n\n**Options**\n\n- `client: QueryClient`\n  - **Required**\n  - The `queryClient` to hydrate the state into\n- `dehydratedState: DehydratedState`\n  - **Required**\n  - The state to hydrate into the client\n- `options: HydrateOptions`\n  - Optional\n  - `defaultOptions: DefaultOptions`\n    - Optional\n    - `mutations: MutationOptions` The default mutation options to use for the hydrated mutations.\n    - `queries: QueryOptions` The default query options to use for the hydrated queries.\n\n## `useHydrate`\n\n`useHydrate` adds a previously dehydrated state into the `queryClient` that would be returned by `useQueryClient()`. If the client already contains data, the new queries will be intelligently merged based on update timestamp.\n\n```jsx\nimport { useHydrate } from 'react-query'\n\nuseHydrate(dehydratedState, options)\n```\n\n> Note: Since version `3.22.0` hydration utilities moved into to core. If you using lower version your should import `useHydrate` from `react-query/hydration`\n\n**Options**\n\n- `dehydratedState: DehydratedState`\n  - **Required**\n  - The state to hydrate\n- `options: HydrateOptions`\n  - Optional\n  - `defaultOptions: QueryOptions`\n    - The default query options to use for the hydrated queries.\n\n## `Hydrate`\n\n`Hydrate` wraps `useHydrate` into component. Can be useful when you need hydrate in class component or need hydrate on same level where `QueryClientProvider` rendered.\n\n```js\nimport { Hydrate } from 'react-query'\n\nfunction App() {\n  return <Hydrate state={dehydratedState}>...</Hydrate>\n}\n```\n\n> Note: Since version `3.22.0` hydration utilities moved into to core. If you using lower version your should import `Hydrate` from `react-query/hydration`\n\n**Options**\n\n- `state: DehydratedState`\n  - The state to hydrate\n- `options: HydrateOptions`\n  - Optional\n  - `defaultOptions: QueryOptions`\n    - The default query options to use for the hydrated queries.\n"}
