{"document":{"type":"root","children":[{"type":"code","value":"const {\n  data,\n  error,\n  isError,\n  isIdle,\n  isLoading,\n  isPaused,\n  isSuccess,\n  mutate,\n  mutateAsync,\n  reset,\n  status,\n} = useMutation(mutationFn, {\n  mutationKey,\n  onError,\n  onMutate,\n  onSettled,\n  onSuccess,\n  retry,\n  retryDelay,\n  useErrorBoundary,\n  meta,\n})\n\nmutate(variables, {\n  onError,\n  onSettled,\n  onSuccess,\n})","lang":"js"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutationFn: (variables: TVariables) => Promise<TData>"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Required"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A function that performs an asynchronous task and returns a promise."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"variables"},{"type":"text","value":" is an object that "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" will pass to your "},{"type":"inlineCode","value":"mutationFn"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutationKey: string"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A mutation key can be set to inherit defaults set with "},{"type":"inlineCode","value":"queryClient.setMutationDefaults"},{"type":"text","value":" or to identify the mutation in the devtools."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onMutate: (variables: TVariables) => Promise<TContext | void> | TContext | void"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This function will fire before the mutation function is fired and is passed the same variables the mutation function would receive"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Useful to perform optimistic updates to a resource in hopes that the mutation succeeds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The value returned from this function will be passed to both the "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" and "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" functions in the event of a mutation failure and can be useful for rolling back optimistic updates."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onSuccess: (data: TData, variables: TVariables, context?: TContext) => Promise<unknown> | void"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This function will fire when the mutation is successful and will be passed the mutation's result."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a promise is returned, it will be awaited and resolved before proceeding"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onError: (err: TError, variables: TVariables, context?: TContext) => Promise<unknown> | void"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This function will fire if the mutation encounters an error and will be passed the error."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a promise is returned, it will be awaited and resolved before proceeding"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onSettled: (data: TData, error: TError, variables: TVariables, context?: TContext) => Promise<unknown> | void"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This function will fire when the mutation is either successfully fetched or encounters an error and be passed either the data or error"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a promise is returned, it will be awaited and resolved before proceeding"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"retry: boolean | number | (failureCount: number, error: TError) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"0"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"false"},{"type":"text","value":", failed mutations will not retry."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"true"},{"type":"text","value":", failed mutations will retry infinitely."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If set to an "},{"type":"inlineCode","value":"number"},{"type":"text","value":", e.g. "},{"type":"inlineCode","value":"3"},{"type":"text","value":", failed mutations will retry until the failed mutations count meets that number."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"retryDelay: number | (retryAttempt: number, error: TError) => number"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This function receives a "},{"type":"inlineCode","value":"retryAttempt"},{"type":"text","value":" integer and the actual Error and returns the delay to apply before the next attempt in milliseconds."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A function like "},{"type":"inlineCode","value":"attempt => Math.min(attempt > 1 ? 2 ** attempt * 1000 : 1000, 30 * 1000)"},{"type":"text","value":" applies exponential backoff."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A function like "},{"type":"inlineCode","value":"attempt => attempt * 1000"},{"type":"text","value":" applies linear backoff."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"useErrorBoundary: undefined | boolean | (error: TError) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to the global query config's "},{"type":"inlineCode","value":"useErrorBoundary"},{"type":"text","value":" value, which is "},{"type":"inlineCode","value":"undefined"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if you want mutation errors to be thrown in the render phase and propagate to the nearest error boundary"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" to disable the behavior of throwing errors to the error boundary."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If set to a function, it will be passed the error and should return a boolean indicating whether to show the error in an error boundary ("},{"type":"inlineCode","value":"true"},{"type":"text","value":") or return the error as state ("},{"type":"inlineCode","value":"false"},{"type":"text","value":")"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"meta: Record<string, unknown>"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If set, stores additional information on the mutation cache entry that can be used as needed. It will be accessible wherever the "},{"type":"inlineCode","value":"mutation"},{"type":"text","value":" is available (eg. "},{"type":"inlineCode","value":"onError"},{"type":"text","value":", "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" functions of the "},{"type":"inlineCode","value":"MutationCache"},{"type":"text","value":")."}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutate: (variables: TVariables, { onSuccess, onSettled, onError }) => void"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The mutation function you can call with variables to trigger the mutation and optionally override options passed to "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"variables: TVariables"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The variables object to pass to the "},{"type":"inlineCode","value":"mutationFn"},{"type":"text","value":"."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Remaining options extend the same options described above in the "},{"type":"inlineCode","value":"useMutation"},{"type":"text","value":" hook."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you make multiple requests, "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":" will fire only after the latest call you've made."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutateAsync: (variables: TVariables, { onSuccess, onSettled, onError }) => Promise<TData>"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Similar to "},{"type":"inlineCode","value":"mutate"},{"type":"text","value":" but returns a promise which can be awaited."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status: string"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Will be:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"idle"},{"type":"text","value":" initial status prior to the mutation function executing."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"loading"},{"type":"text","value":" if the mutation is currently executing."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"error"},{"type":"text","value":" if the last mutation attempt resulted in an error."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"success"},{"type":"text","value":" if the last mutation attempt was successful."}]}]}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"isIdle"},{"type":"text","value":", "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":", "},{"type":"inlineCode","value":"isSuccess"},{"type":"text","value":", "},{"type":"inlineCode","value":"isError"},{"type":"text","value":": boolean variables derived from "},{"type":"inlineCode","value":"status"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"data: undefined | unknown"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"undefined"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The last successfully resolved data for the query."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"error: null | TError"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The error object for the query, if an error was encountered."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"reset: () => void"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A function to clean the mutation internal state (i.e., it resets the mutation to its initial state)."}]}]}]}]}]}],"headings":[]},"frameworks":[],"downloadMarkdown":"\n```js\nconst {\n  data,\n  error,\n  isError,\n  isIdle,\n  isLoading,\n  isPaused,\n  isSuccess,\n  mutate,\n  mutateAsync,\n  reset,\n  status,\n} = useMutation(mutationFn, {\n  mutationKey,\n  onError,\n  onMutate,\n  onSettled,\n  onSuccess,\n  retry,\n  retryDelay,\n  useErrorBoundary,\n  meta,\n})\n\nmutate(variables, {\n  onError,\n  onSettled,\n  onSuccess,\n})\n```\n\n**Options**\n\n- `mutationFn: (variables: TVariables) => Promise<TData>`\n  - **Required**\n  - A function that performs an asynchronous task and returns a promise.\n  - `variables` is an object that `mutate` will pass to your `mutationFn`\n- `mutationKey: string`\n  - Optional\n  - A mutation key can be set to inherit defaults set with `queryClient.setMutationDefaults` or to identify the mutation in the devtools.\n- `onMutate: (variables: TVariables) => Promise<TContext | void> | TContext | void`\n  - Optional\n  - This function will fire before the mutation function is fired and is passed the same variables the mutation function would receive\n  - Useful to perform optimistic updates to a resource in hopes that the mutation succeeds\n  - The value returned from this function will be passed to both the `onError` and `onSettled` functions in the event of a mutation failure and can be useful for rolling back optimistic updates.\n- `onSuccess: (data: TData, variables: TVariables, context?: TContext) => Promise<unknown> | void`\n  - Optional\n  - This function will fire when the mutation is successful and will be passed the mutation's result.\n  - If a promise is returned, it will be awaited and resolved before proceeding\n- `onError: (err: TError, variables: TVariables, context?: TContext) => Promise<unknown> | void`\n  - Optional\n  - This function will fire if the mutation encounters an error and will be passed the error.\n  - If a promise is returned, it will be awaited and resolved before proceeding\n- `onSettled: (data: TData, error: TError, variables: TVariables, context?: TContext) => Promise<unknown> | void`\n  - Optional\n  - This function will fire when the mutation is either successfully fetched or encounters an error and be passed either the data or error\n  - If a promise is returned, it will be awaited and resolved before proceeding\n- `retry: boolean | number | (failureCount: number, error: TError) => boolean`\n  - Defaults to `0`.\n  - If `false`, failed mutations will not retry.\n  - If `true`, failed mutations will retry infinitely.\n  - If set to an `number`, e.g. `3`, failed mutations will retry until the failed mutations count meets that number.\n- `retryDelay: number | (retryAttempt: number, error: TError) => number`\n  - This function receives a `retryAttempt` integer and the actual Error and returns the delay to apply before the next attempt in milliseconds.\n  - A function like `attempt => Math.min(attempt > 1 ? 2 ** attempt * 1000 : 1000, 30 * 1000)` applies exponential backoff.\n  - A function like `attempt => attempt * 1000` applies linear backoff.\n- `useErrorBoundary: undefined | boolean | (error: TError) => boolean`\n  - Defaults to the global query config's `useErrorBoundary` value, which is `undefined`\n  - Set this to `true` if you want mutation errors to be thrown in the render phase and propagate to the nearest error boundary\n  - Set this to `false` to disable the behavior of throwing errors to the error boundary.\n  - If set to a function, it will be passed the error and should return a boolean indicating whether to show the error in an error boundary (`true`) or return the error as state (`false`)\n- `meta: Record<string, unknown>`\n  - Optional\n  - If set, stores additional information on the mutation cache entry that can be used as needed. It will be accessible wherever the `mutation` is available (eg. `onError`, `onSuccess` functions of the `MutationCache`).\n\n**Returns**\n\n- `mutate: (variables: TVariables, { onSuccess, onSettled, onError }) => void`\n  - The mutation function you can call with variables to trigger the mutation and optionally override options passed to `useMutation`.\n  - `variables: TVariables`\n    - Optional\n    - The variables object to pass to the `mutationFn`.\n  - Remaining options extend the same options described above in the `useMutation` hook.\n  - If you make multiple requests, `onSuccess` will fire only after the latest call you've made.\n- `mutateAsync: (variables: TVariables, { onSuccess, onSettled, onError }) => Promise<TData>`\n  - Similar to `mutate` but returns a promise which can be awaited.\n- `status: string`\n  - Will be:\n    - `idle` initial status prior to the mutation function executing.\n    - `loading` if the mutation is currently executing.\n    - `error` if the last mutation attempt resulted in an error.\n    - `success` if the last mutation attempt was successful.\n- `isIdle`, `isLoading`, `isSuccess`, `isError`: boolean variables derived from `status`\n- `data: undefined | unknown`\n  - Defaults to `undefined`\n  - The last successfully resolved data for the query.\n- `error: null | TError`\n  - The error object for the query, if an error was encountered.\n- `reset: () => void`\n  - A function to clean the mutation internal state (i.e., it resets the mutation to its initial state).\n","originalRawMarkdown":"---\nid: useMutation\ntitle: useMutation\n---\n\n```js\nconst {\n  data,\n  error,\n  isError,\n  isIdle,\n  isLoading,\n  isPaused,\n  isSuccess,\n  mutate,\n  mutateAsync,\n  reset,\n  status,\n} = useMutation(mutationFn, {\n  mutationKey,\n  onError,\n  onMutate,\n  onSettled,\n  onSuccess,\n  retry,\n  retryDelay,\n  useErrorBoundary,\n  meta,\n})\n\nmutate(variables, {\n  onError,\n  onSettled,\n  onSuccess,\n})\n```\n\n**Options**\n\n- `mutationFn: (variables: TVariables) => Promise<TData>`\n  - **Required**\n  - A function that performs an asynchronous task and returns a promise.\n  - `variables` is an object that `mutate` will pass to your `mutationFn`\n- `mutationKey: string`\n  - Optional\n  - A mutation key can be set to inherit defaults set with `queryClient.setMutationDefaults` or to identify the mutation in the devtools.\n- `onMutate: (variables: TVariables) => Promise<TContext | void> | TContext | void`\n  - Optional\n  - This function will fire before the mutation function is fired and is passed the same variables the mutation function would receive\n  - Useful to perform optimistic updates to a resource in hopes that the mutation succeeds\n  - The value returned from this function will be passed to both the `onError` and `onSettled` functions in the event of a mutation failure and can be useful for rolling back optimistic updates.\n- `onSuccess: (data: TData, variables: TVariables, context?: TContext) => Promise<unknown> | void`\n  - Optional\n  - This function will fire when the mutation is successful and will be passed the mutation's result.\n  - If a promise is returned, it will be awaited and resolved before proceeding\n- `onError: (err: TError, variables: TVariables, context?: TContext) => Promise<unknown> | void`\n  - Optional\n  - This function will fire if the mutation encounters an error and will be passed the error.\n  - If a promise is returned, it will be awaited and resolved before proceeding\n- `onSettled: (data: TData, error: TError, variables: TVariables, context?: TContext) => Promise<unknown> | void`\n  - Optional\n  - This function will fire when the mutation is either successfully fetched or encounters an error and be passed either the data or error\n  - If a promise is returned, it will be awaited and resolved before proceeding\n- `retry: boolean | number | (failureCount: number, error: TError) => boolean`\n  - Defaults to `0`.\n  - If `false`, failed mutations will not retry.\n  - If `true`, failed mutations will retry infinitely.\n  - If set to an `number`, e.g. `3`, failed mutations will retry until the failed mutations count meets that number.\n- `retryDelay: number | (retryAttempt: number, error: TError) => number`\n  - This function receives a `retryAttempt` integer and the actual Error and returns the delay to apply before the next attempt in milliseconds.\n  - A function like `attempt => Math.min(attempt > 1 ? 2 ** attempt * 1000 : 1000, 30 * 1000)` applies exponential backoff.\n  - A function like `attempt => attempt * 1000` applies linear backoff.\n- `useErrorBoundary: undefined | boolean | (error: TError) => boolean`\n  - Defaults to the global query config's `useErrorBoundary` value, which is `undefined`\n  - Set this to `true` if you want mutation errors to be thrown in the render phase and propagate to the nearest error boundary\n  - Set this to `false` to disable the behavior of throwing errors to the error boundary.\n  - If set to a function, it will be passed the error and should return a boolean indicating whether to show the error in an error boundary (`true`) or return the error as state (`false`)\n- `meta: Record<string, unknown>`\n  - Optional\n  - If set, stores additional information on the mutation cache entry that can be used as needed. It will be accessible wherever the `mutation` is available (eg. `onError`, `onSuccess` functions of the `MutationCache`).\n\n**Returns**\n\n- `mutate: (variables: TVariables, { onSuccess, onSettled, onError }) => void`\n  - The mutation function you can call with variables to trigger the mutation and optionally override options passed to `useMutation`.\n  - `variables: TVariables`\n    - Optional\n    - The variables object to pass to the `mutationFn`.\n  - Remaining options extend the same options described above in the `useMutation` hook.\n  - If you make multiple requests, `onSuccess` will fire only after the latest call you've made.\n- `mutateAsync: (variables: TVariables, { onSuccess, onSettled, onError }) => Promise<TData>`\n  - Similar to `mutate` but returns a promise which can be awaited.\n- `status: string`\n  - Will be:\n    - `idle` initial status prior to the mutation function executing.\n    - `loading` if the mutation is currently executing.\n    - `error` if the last mutation attempt resulted in an error.\n    - `success` if the last mutation attempt was successful.\n- `isIdle`, `isLoading`, `isSuccess`, `isError`: boolean variables derived from `status`\n- `data: undefined | unknown`\n  - Defaults to `undefined`\n  - The last successfully resolved data for the query.\n- `error: null | TError`\n  - The error object for the query, if an error was encountered.\n- `reset: () => void`\n  - A function to clean the mutation internal state (i.e., it resets the mutation to its initial state).\n"}
