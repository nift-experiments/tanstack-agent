{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"🕊️ A toolkit for ReactQuery that makes ReactQuery hooks reusable and typesafe"}]},{"type":"heading","depth":2,"id":"what-do-you-benefit-from-it","children":[{"type":"text","value":"what do you benefit from it"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Make "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" strongly related with "},{"type":"inlineCode","value":"queryFn"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Manage "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" in a type-safe way"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Generate a custom ReactQuery hook quickly"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Make "},{"type":"inlineCode","value":"queryClient"},{"type":"text","value":"'s operations clearly associated with custom ReactQuery hooks"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set defaultOptions for custom ReactQuery hooks easier and clearer"}]}]}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"paragraph","children":[{"type":"text","value":"This module is distributed via "},{"type":"link","href":"https://www.npmjs.com/package/react-query-kit","children":[{"type":"text","value":"NPM"}]},{"type":"text","value":" and\nshould be installed as one of your project's "},{"type":"inlineCode","value":"dependencies"},{"type":"text","value":":"}]},{"type":"code","value":"npm i react-query-kit","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"or"}]},{"type":"code","value":"pnpm add react-query-kit","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"or"}]},{"type":"code","value":"yarn add react-query-kit","lang":"bash"},{"type":"heading","depth":2,"id":"quick-start-with-nextjs","children":[{"type":"text","value":"Quick start with nextjs"}]},{"type":"paragraph","children":[{"type":"link","href":"https://codesandbox.io/s/example-react-query-kit-nextjs-uldl88","children":[{"type":"text","value":"CodeSandbox"}]}]},{"type":"code","value":"import { QueryClient, dehydrate } from '@tanstack/react-query'\nimport { createQuery } from 'react-query-kit'\n\ntype Response = { title: string; content: string }\ntype Variables = { id: number }\n\nconst usePost = createQuery<Response, Variables, Error>({\n  primaryKey: '/posts',\n  queryFn: ({ queryKey: [primaryKey, variables] }) => {\n    // primaryKey equals to '/posts'\n    return fetch(`${primaryKey}/${variables.id}`).then(res => res.json())\n  },\n  suspense: true\n})\n\nconst variables = { id: 1 }\n\nexport default function Page() {\n  // queryKey equals to ['/posts', { id: 1 }]\n  const { data } = usePost({ variables, suspense: true })\n\n  return (\n    <div>\n      <div>{data?.title}</div>\n      <div>{data?.content}</div>\n    </div>\n  )\n}\n\nconsole.log(usePost.getKey()) //  ['/posts']\nconsole.log(usePost.getKey(variables)) //  ['/posts', { id: 1 }]\n\nexport async function getStaticProps() {\n  const queryClient = new QueryClient()\n\n  await queryClient.prefetchQuery(usePost.getKey(variables), usePost.queryFn)\n\n  return {\n    props: {\n      dehydratedState: dehydrate(queryClient),\n    },\n  }\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Check the complete documentation on "},{"type":"link","href":"https://github.com/liaoliao666/react-query-kit","children":[{"type":"text","value":"GitHub"}]},{"type":"text","value":"."}]}],"headings":[{"id":"what-do-you-benefit-from-it","text":"what do you benefit from it","level":2},{"id":"installation","text":"Installation","level":2},{"id":"quick-start-with-nextjs","text":"Quick start with nextjs","level":2}]},"frameworks":[],"downloadMarkdown":"\n🕊️ A toolkit for ReactQuery that makes ReactQuery hooks reusable and typesafe\n\n## what do you benefit from it\n\n- Make `queryKey` strongly related with `queryFn`\n- Manage `queryKey` in a type-safe way\n- Generate a custom ReactQuery hook quickly\n- Make `queryClient`'s operations clearly associated with custom ReactQuery hooks\n- Set defaultOptions for custom ReactQuery hooks easier and clearer\n\n## Installation\n\nThis module is distributed via [NPM](https://www.npmjs.com/package/react-query-kit) and\nshould be installed as one of your project's `dependencies`:\n\n```bash\nnpm i react-query-kit\n```\n\nor\n\n```bash\npnpm add react-query-kit\n```\n\nor\n\n```bash\nyarn add react-query-kit\n```\n\n## Quick start with nextjs\n\n[CodeSandbox](https://codesandbox.io/s/example-react-query-kit-nextjs-uldl88)\n\n```tsx\nimport { QueryClient, dehydrate } from '@tanstack/react-query'\nimport { createQuery } from 'react-query-kit'\n\ntype Response = { title: string; content: string }\ntype Variables = { id: number }\n\nconst usePost = createQuery<Response, Variables, Error>({\n  primaryKey: '/posts',\n  queryFn: ({ queryKey: [primaryKey, variables] }) => {\n    // primaryKey equals to '/posts'\n    return fetch(`${primaryKey}/${variables.id}`).then(res => res.json())\n  },\n  suspense: true\n})\n\nconst variables = { id: 1 }\n\nexport default function Page() {\n  // queryKey equals to ['/posts', { id: 1 }]\n  const { data } = usePost({ variables, suspense: true })\n\n  return (\n    <div>\n      <div>{data?.title}</div>\n      <div>{data?.content}</div>\n    </div>\n  )\n}\n\nconsole.log(usePost.getKey()) //  ['/posts']\nconsole.log(usePost.getKey(variables)) //  ['/posts', { id: 1 }]\n\nexport async function getStaticProps() {\n  const queryClient = new QueryClient()\n\n  await queryClient.prefetchQuery(usePost.getKey(variables), usePost.queryFn)\n\n  return {\n    props: {\n      dehydratedState: dehydrate(queryClient),\n    },\n  }\n}\n```\n\nCheck the complete documentation on [GitHub](https://github.com/liaoliao666/react-query-kit).\n","originalRawMarkdown":"---\nid: liaoliao666-react-query-kit\ntitle: React Query Kit\n---\n\n🕊️ A toolkit for ReactQuery that makes ReactQuery hooks reusable and typesafe\n\n## what do you benefit from it\n\n- Make `queryKey` strongly related with `queryFn`\n- Manage `queryKey` in a type-safe way\n- Generate a custom ReactQuery hook quickly\n- Make `queryClient`'s operations clearly associated with custom ReactQuery hooks\n- Set defaultOptions for custom ReactQuery hooks easier and clearer\n\n## Installation\n\nThis module is distributed via [NPM](https://www.npmjs.com/package/react-query-kit) and\nshould be installed as one of your project's `dependencies`:\n\n```bash\nnpm i react-query-kit\n```\n\nor\n\n```bash\npnpm add react-query-kit\n```\n\nor\n\n```bash\nyarn add react-query-kit\n```\n\n## Quick start with nextjs\n\n[CodeSandbox](https://codesandbox.io/s/example-react-query-kit-nextjs-uldl88)\n\n```tsx\nimport { QueryClient, dehydrate } from '@tanstack/react-query'\nimport { createQuery } from 'react-query-kit'\n\ntype Response = { title: string; content: string }\ntype Variables = { id: number }\n\nconst usePost = createQuery<Response, Variables, Error>({\n  primaryKey: '/posts',\n  queryFn: ({ queryKey: [primaryKey, variables] }) => {\n    // primaryKey equals to '/posts'\n    return fetch(`${primaryKey}/${variables.id}`).then(res => res.json())\n  },\n  suspense: true\n})\n\nconst variables = { id: 1 }\n\nexport default function Page() {\n  // queryKey equals to ['/posts', { id: 1 }]\n  const { data } = usePost({ variables, suspense: true })\n\n  return (\n    <div>\n      <div>{data?.title}</div>\n      <div>{data?.content}</div>\n    </div>\n  )\n}\n\nconsole.log(usePost.getKey()) //  ['/posts']\nconsole.log(usePost.getKey(variables)) //  ['/posts', { id: 1 }]\n\nexport async function getStaticProps() {\n  const queryClient = new QueryClient()\n\n  await queryClient.prefetchQuery(usePost.getKey(variables), usePost.queryFn)\n\n  return {\n    props: {\n      dehydratedState: dehydrate(queryClient),\n    },\n  }\n}\n```\n\nCheck the complete documentation on [GitHub](https://github.com/liaoliao666/react-query-kit).\n"}
