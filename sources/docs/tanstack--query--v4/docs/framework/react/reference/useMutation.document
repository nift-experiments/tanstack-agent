}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If set to "},{"type":"inlineCode","value":"Infinity"},{"type":"text","value":", will disable garbage collection"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutationKey: unknown[]"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A mutation key can be set to inherit defaults set with "},{"type":"inlineCode","value":"queryClient.setMutationDefaults"},{"type":"text","value":"."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"networkMode: 'online' | 'always' | 'offlineFirst'"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"defaults to "},{"type":"inlineCode","value":"'online'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"see "},{"type":"link","href":"../../../../framework/react/guides/network-mode","children":[{"type":"text","value":"Network Mode"}]},{"type":"text","value":" for more information."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onMutate: (variables: TVariables) => Promise<TContext | void> | TContext | void"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This function will fire before the mutation function is fired and is passed the same variables the mutation function would receive"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Useful to perform optimistic updates to a resource in hopes that the mutation succeeds"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The value returned from this function will be passed to the "},{"type":"inlineCode","value":"onSuccess"},{"type":"text","value":", "},{"type":"inlineCode","value":"onError"},{"type":"text","value":", and "},{"type":"inlineCode","value":"onSettled"},{"type":"text","value":" functions and can be useful for rolling back optimistic updates."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onSuccess: (data: TData, variables: TVariables, context?: TContext) => Promise<unknown> | unknown"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This function will fire when the mutation is successful and will be passed the mutation's result."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a promise is returned, it will be awaited and resolved before proceeding"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onError: (err: TError, variables: TVariables, context?: TContext) => Promise<unknown> | unknown"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This function will fire if the mutation encounters an error and will be passed the error."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a promise is returned, it will be awaited and resolved before proceeding"}]}]}]}]},{"type":"listItem