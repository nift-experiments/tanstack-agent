NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"usequery-dependent-query","children":[{"type":"text","value":"useQuery dependent Query"}]},{"type":"paragraph","children":[{"type":"text","value":"Dependent (or serial) queries depend on previous ones to finish before they can execute. To achieve this, it's as easy as using the "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" option to tell a query when it is ready to run:"}]},{"type":"code","value":"// Get the user\nconst { data: user } = useQuery({\n  queryKey: ['user', email],\n  queryFn: () => getUserByEmail(email.value),\n})\n\nconst userId = computed(() => user.value?.id)\nconst enabled = computed(() => !!user.value?.id)\n\n// Then get the user's projects\nconst { isIdle, data: projects } = useQuery({\n  queryKey: ['projects', userId],\n  queryFn: () => getProjectsByUser(userId.value),\n  enabled, // The query will not execute until `enabled == true`\n})","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"projects"},{"type":"text","value":" query will start in:"}]},{"type":"code","value":"status: 'loading'\nfetchStatus: 'idle'","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"As soon as the "},{"type":"inlineCode","value":"user"},{"type":"text","value":" is available, the "},{"type":"inlineCode","value":"projects"},{"type":"text","value":" query will be "},{"type":"inlineCode","value":"enabled"},{"type":"text","value":" and will then transition to:"}]},{"type":"code","value":"status: 'loading'\nfetchStatus: 'fetching'","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Once we have the projects, it will go to:"}]},{"type":"code","value":"status: 'success'\nfetchStatus: 'idle'","lang":"tsx"},{"type":"heading","depth":2,"id":"usequeries-dependent-query","children":[{"type":"text","value":"useQueries dependent Query"}]},{"type":"paragraph","children":[{"type":"text","value":"Dynamic parallel query - "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":" can depend on a previous query also, here's how to achieve this:"}]},{"type":"code","value":"// Get the users ids\nconst { data: userIds } = useQuery({\n  queryKey: ['users'],\n  queryFn: getUsersData,\n  select: users => users.map(user => user.id),\n})\n\n// Then get the users messages\nconst usersMessages = useQueries({\n  queries: userIds\n    ? userIds.map(id => {\n        return {\n          queryKey: ['messages', id],\n          queryFn: () => getMessagesByUsers(id),\n        };\n      })\n  : [], // if users is undefined, an empty array will be returned\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note"}]},{"type":"text","value":" that "},{"type":"inlineCode","value":"useQueries"},{"type":"text","value":" return an "},{"type":"strong","children":[{"type":"text","value":"array of query results"}]}]}],"headings":[{"id":"usequery-dependent-query","text":"useQuery dependent Query","level":2},{"id":"usequeries-dependent-query","text":"useQueries dependent Query","level":2}]},"frameworks":[],"downloadMarkdown":"\n## useQuery dependent Query\n\nDependent (or serial) queries depend on previous ones to finish before they can execute. To achieve this, it's as easy as using the `enabled` option to tell a query when it is ready to run:\n\n\n\n```js\n// Get the user\nconst { data: user } = useQuery({\n  queryKey: ['user', email],\n  queryFn: () => getUserByEmail(email.value),\n})\n\nconst userId = computed(() => user.value?.id)\nconst enabled = computed(() => !!user.value?.id)\n\n// Then get the user's projects\nconst { isIdle, data: projects } = useQuery({\n  queryKey: ['projects', userId],\n  queryFn: () => getProjectsByUser(userId.value),\n  enabled, // The query will not execute until `enabled == true`\n})\n```\n\n\n\nThe `projects` query will start in:\n\n```tsx\nstatus: 'loading'\nfetchStatus: 'idle'\n```\n\nAs soon as the `user` is available, the `projects` query will be `enabled` and will then transition to:\n\n```tsx\nstatus: 'loading'\nfetchStatus: 'fetching'\n```\n\nOnce we have the projects, it will go to:\n\n```tsx\nstatus: 'success'\nfetchStatus: 'idle'\n```\n\n## useQueries dependent Query\n\nDynamic parallel query - `useQueries` can depend on a previous query also, here's how to achieve this:\n\n\n\n```tsx\n// Get the users ids\nconst { data: userIds } = useQuery({\n  queryKey: ['users'],\n  queryFn: getUsersData,\n  select: users => users.map(user => user.id),\n})\n\n// Then get the users messages\nconst usersMessages = useQueries({\n  queries: userIds\n    ? userIds.map(id => {\n        return {\n          queryKey: ['messages', id],\n          queryFn: () => getMessagesByUsers(id),\n        };\n      })\n  : [], // if users is undefined, an empty array will be returned\n})\n```\n\n\n\n**Note** that `useQueries` return an **array of query results**\n","originalRawMarkdown":"---\nid: dependent-queries\ntitle: Dependent Queries\nref: docs/framework/react/guides/dependent-queries.md\n---\n\n[//]: # 'Example'\n\n```js\n// Get the user\nconst { data: user } = useQuery({\n  queryKey: ['user', email],\n  queryFn: () => getUserByEmail(email.value),\n})\n\nconst userId = computed(() => user.value?.id)\nconst enabled = computed(() => !!user.value?.id)\n\n// Then get the user's projects\nconst { isIdle, data: projects } = useQuery({\n  queryKey: ['projects', userId],\n  queryFn: () => getProjectsByUser(userId.value),\n  enabled, // The query will not execute until `enabled == true`\n})\n```\n\n[//]: # 'Example'\n"}
