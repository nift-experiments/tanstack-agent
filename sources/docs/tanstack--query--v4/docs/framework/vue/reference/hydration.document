,"ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This function is called for each query in the cache"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Return "},{"type":"inlineCode","value":"true"},{"type":"text","value":" to include this query in dehydration, or "},{"type":"inlineCode","value":"false"},{"type":"text","value":" otherwise"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The default version only includes successful queries, do "},{"type":"inlineCode","value":"shouldDehydrateQuery: () => true"},{"type":"text","value":" to include all queries"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you would like to extend the function while retaining the previous behavior, import and execute "},{"type":"inlineCode","value":"defaultShouldDehydrateQuery"},{"type":"text","value":" as part of the return statement"}]}]}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"dehydratedState: DehydratedState"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This includes everything that is needed to hydrate the "},{"type":"inlineCode","value":"queryClient"},{"type":"text","value":" at a later point"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"You "},{"type":"strong","children":[{"type":"text","value":"should not"}]},{"type":"text","value":" rely on the exact format of this response, it is not part of the public API and can change at any time"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This result is not in serialized form, you need to do that yourself if desired"}]}]}]}]}]},{"type":"heading","depth":3,"id":"limitations","children":[{"type":"text","value":"limitations"}]},{"type":"paragraph","children":[{"type":"text","value":"Some storage systems (such as browser "},{"type":"link","href":"https://developer.mozilla.org/en-US/docs/Web/API/Web_Storage_API","children":[{"type":"text","value":"Web Storage API"}]},{"type":"text","value":") require values to be JSON serializable. If you need to dehydrate values that are not automatically serializable to JSON (like "},{"type":"inlineCode","value":"Error"},{"type":"text","value":" or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"), you have to serialize them for yourself. Since only successful queries are included per default, to also include "},{"type":"inlineCode","value":"Errors"},{"type":"text","value":", you have to provide "},{"type":"inlineCode","value":"shouldDehydrateQuery"},{"type":"text","value":", e.g.:"}]},{"type":"code","value":"// server\nconst state = dehydrate(client, { shouldDehydrateQuery: () => true }) // to also include Errors\nconst serializedState = mySerialize(state) // transform Error instances to objects\n\n// client\nconst state = myDeserialize(serializedState) // transform objects back to Error instances\nhydrate(client, state)","lang":"tsx"},{"type":"heading","depth":2,"id":"hydrate","children":[{"type":"inlineCode","value":"hydrate"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" adds a previously dehydrated state into a "},{"type":"inlineCode","value":"cache"},{"type":"text","value":"."}]},{"type":"code","value":"import { hydrate } from '@tanstack/vue-query'\n\nhydrate(queryClient, dehydratedState, options)","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"client: QueryClient"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Required"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"queryClient"},{"type":"text","value":" to hydrate the state into"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"dehydratedState: DehydratedState"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Required"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The state to hydrate into the client"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options: HydrateOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultOptions: DefaultOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutations: MutationOptions"},{"type":"text","value":" The default mutation options to use for the hydrated mutations."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queries: QueryOptions"},{"type":"text","value":" The default query options to use for the hydrated queries."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context?: React.Context<QueryClient | undefined>"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom React Query context. Otherwise, "},{"type":"inlineCode","value":"defaultContext"},{"type":"text","value":" will be used."}]}]}]}]}]}]}]},{"type":"heading","depth":3,"id":"limitations-2","children":[{"type":"text","value":"Limitations"}]},{"type":"paragraph","children":[{"type":"text","value":"If the queries included in dehydration already exist in the queryCache, "},{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" does not overwrite them and they will be "},{"type":"strong","children":[{"type":"text","value":"silently"}]},{"type":"text","value":" discarded."}]}],"headings":[{"id":"dehydrate","text":"dehydrate","level":2},{"id":"limitations","text":"limitations","level":3},{"id":"hydrate","text":"hydrate","level":2},{"id":"limitations-2","text":"Limitations","level":3}]},"frameworks":[],"downloadMarkdown":"\n## `dehydrate`\n\n`dehydrate` creates a frozen representation of a `cache` that can later be hydrated with `Hydrate`, `useHydrate`, or `hydrate`. This is useful for passing prefetched queries from server to client or persisting queries to localStorage or other persistent locations. It only includes currently successful queries by default.\n\n```tsx\nimport { dehydrate } from '@tanstack/vue-query'\n\nconst dehydratedState = dehydrate(queryClient, {\n  shouldDehydrateQuery,\n})\n```\n\n**Options**\n\n- `client: QueryClient`\n  - **Required**\n  - The `queryClient` that should be dehydrated\n- `options: DehydrateOptions`\n  - Optional\n  - `dehydrateMutations: boolean`\n    - Optional\n    - Whether or not to dehydrate mutations.\n  - `dehydrateQueries: boolean`\n    - Optional\n    - Whether or not to dehydrate queries.\n  - `shouldDehydrateMutation: (mutation: Mutation) => boolean`\n    - Optional\n    - This function is called for each mutation in the cache\n    - Return `true` to include this mutation in dehydration, or `false` otherwise\n    - The default version only includes paused mutations\n    - If you would like to extend the function while retaining the previous behavior, import and execute `defaultShouldDehydrateMutation` as part of the return statement\n  - `shouldDehydrateQuery: (query: Query) => boolean`\n    - Optional\n    - This function is called for each query in the cache\n    - Return `true` to include this query in dehydration, or `false` otherwise\n    - The default version only includes successful queries, do `shouldDehydrateQuery: () => true` to include all queries\n    - If you would like to extend the function while retaining the previous behavior, import and execute `defaultShouldDehydrateQuery` as part of the return statement\n\n**Returns**\n\n- `dehydratedState: DehydratedState`\n  - This includes everything that is needed to hydrate the `queryClient` at a later point\n  - You **should not** rely on the exact format of this response, it is not part of the public API and can change at any time\n  - This result is not in serialized form, you need to do that yourself if desired\n\n### limitations\n\nSome storage systems (such as browser [Web Storage API](https://developer.mozilla.org/en-US/docs/Web/API/Web_Storage_API)) require values to be JSON serializable. If you need to dehydrate values that are not automatically serializable to JSON (like `Error` or `undefined`), you have to serialize them for yourself. Since only successful queries are included per default, to also include `Errors`, you have to provide `shouldDehydrateQuery`, e.g.:\n\n```tsx\n// server\nconst state = dehydrate(client, { shouldDehydrateQuery: () => true }) // to also include Errors\nconst serializedState = mySerialize(state) // transform Error instances to objects\n\n// client\nconst state = myDeserialize(serializedState) // transform objects back to Error instances\nhydrate(client, state)\n```\n\n## `hydrate`\n\n`hydrate` adds a previously dehydrated state into a `cache`.\n\n```tsx\nimport { hydrate } from '@tanstack/vue-query'\n\nhydrate(queryClient, dehydratedState, options)\n```\n\n**Options**\n\n- `client: QueryClient`\n  - **Required**\n  - The `queryClient` to hydrate the state into\n- `dehydratedState: DehydratedState`\n  - **Required**\n  - The state to hydrate into the client\n- `options: HydrateOptions`\n  - Optional\n  - `defaultOptions: DefaultOptions`\n    - Optional\n    - `mutations: MutationOptions` The default mutation options to use for the hydrated mutations.\n    - `queries: QueryOptions` The default query options to use for the hydrated queries.\n  - `context?: React.Context<QueryClient | undefined>`\n    - Use this to use a custom React Query context. Otherwise, `defaultContext` will be used.\n\n### Limitations\n\nIf the queries included in dehydration already exist in the queryCache, `hydrate` does not overwrite them and they will be **silently** discarded.\n\n\n\n\n\n","originalRawMarkdown":"---\nid: hydration\ntitle: hydration\nref: docs/framework/react/reference/hydration.md\nreplace: { '@tanstack/react-query': '@tanstack/vue-query' }\n---\n\n[//]: # 'useHydrate'\n[//]: # 'useHydrate'\n[//]: # 'Hydrate'\n[//]: # 'Hydrate'\n"}
