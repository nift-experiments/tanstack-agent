{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"useQueryClient"},{"type":"text","value":" hook returns the current "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":" instance."}]},{"type":"code","value":"import { useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient({ context })","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context?: React.Context<QueryClient | undefined>"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to use a custom React Query context. Otherwise, "},{"type":"inlineCode","value":"defaultContext"},{"type":"text","value":" will be used."}]}]}]}]}]}],"headings":[]},"frameworks":[],"downloadMarkdown":"\nThe `useQueryClient` hook returns the current `QueryClient` instance.\n\n```tsx\nimport { useQueryClient } from '@tanstack/vue-query'\n\nconst queryClient = useQueryClient({ context })\n```\n\n**Options**\n\n- `context?: React.Context<QueryClient | undefined>`\n  - Use this to use a custom React Query context. Otherwise, `defaultContext` will be used.\n","originalRawMarkdown":"---\nid: useQueryClient\ntitle: useQueryClient\nref: docs/framework/react/reference/useQueryClient.md\nreplace: { '@tanstack/react-query': '@tanstack/vue-query' }\n---\n"}
