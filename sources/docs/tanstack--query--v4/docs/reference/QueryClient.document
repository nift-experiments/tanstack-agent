:"text","value":", no refetch will be made if there is already a request running."}]}]}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This function returns a promise that will resolve when all of the queries are done being refetched. By default, it "},{"type":"strong","children":[{"type":"text","value":"will not"}]},{"type":"text","value":" throw an error if any of those queries refetches fail, but this can be configured by setting the "},{"type":"inlineCode","value":"throwOnError"},{"type":"text","value":" option to "},{"type":"inlineCode","value":"true"}]},{"type":"heading","depth":2,"id":"queryclient-cancelqueries","children":[{"type":"inlineCode","value":"queryClient.cancelQueries"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"cancelQueries"},{"type":"text","value":" method can be used to cancel outgoing queries based on their query keys or any other functionally accessible property/state of the query."}]},{"type":"paragraph","children":[{"type":"text","value":"This is most useful when performing optimistic updates since you will likely need to cancel any outgoing query refetches so they don't clobber your optimistic update when they resolve."}]},{"type":"code","value":"await queryClient.cancelQueries({ queryKey: ['posts'], exact: true })","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"paragraph","children":[{