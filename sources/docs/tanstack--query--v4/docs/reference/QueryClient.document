Code","value":"initialData"},{"type":"text","value":", the query's data will be\nreset to that. If a query is active, it will be refetched."}]},{"type":"code","value":"queryClient.resetQueries({ queryKey, exact: true })","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"refetchPage: (page: TData, index: number, allPages: TData[]) => boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Only for "},{"type":"link","href":"../../framework/react/guides/infinite-queries#refetchpage","children":[{"type":"text","value":"Infinite Queries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this function to specify which pages should be refetched"}]}]}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"options?: ResetOptions"},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"throwOnError?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", this method will throw if any of the query refetch tasks fail."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"cancelRefetch?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"true"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Per default, a currently running request will be cancelled before a new request is made"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":", no refetch will be made if there is already a request running."}]}]}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This method returns a promise that resolves when all active queries have been refetched."}]},{"type":"heading","depth":2,"id":"queryclient-isfetching","children":[{"type":"inlineCode","value":"queryClient.isFetching"}]},{"type":"paragraph","children":[{"type":"text","value":"This "},{"type":"inlineCode","value":"isFetching"},{"type":"text","value":" method returns an "},{"type":"inlineCode","value":"integer"},{"type":"text","value":" representing how many queries, if any, in the cache are currently fetching (including background-fetching, loading new pages, or loading more infinite query results)"}]},{"type":"code","value":"if (queryClient.isFetching()) {\n  console.log('At least one query is fetching!')\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"TanStack Query also exports a handy "},{"type":"link","href":"../../framework/react/reference/useIsFetching","children":[{"type":"inlineCode","value":"useIsFetching"}]},{"type":"text","value":" hook that will let you subscribe to this state in your components without creating a manual subscription to the query cache."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"t