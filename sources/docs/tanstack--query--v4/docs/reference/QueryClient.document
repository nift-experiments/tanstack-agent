{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"queryclient","children":[{"type":"inlineCode","value":"QueryClient"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"QueryClient"},{"type":"text","value":" can be used to interact with a cache:"}]},{"type":"code","value":"import { QueryClient } from '@tanstack/react-query'\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: {\n      staleTime: Infinity,\n    },\n  },\n})\n\nawait queryClient.prefetchQuery({ queryKey: ['posts'], queryFn: fetchPosts })","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Its available methods are:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientfetchquery","children":[{"type":"inlineCode","value":"queryClient.fetchQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientfetchinfinitequery","children":[{"type":"inlineCode","value":"queryClient.fetchInfiniteQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientprefetchquery","children":[{"type":"inlineCode","value":"queryClient.prefetchQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientprefetchinfinitequery","children":[{"type":"inlineCode","value":"queryClient.prefetchInfiniteQuery"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetquerydata","children":[{"type":"inlineCode","value":"queryClient.getQueryData"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientensurequerydata","children":[{"type":"inlineCode","value":"queryClient.ensureQueryData"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetqueriesdata","children":[{"type":"inlineCode","value":"queryClient.getQueriesData"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetquerydata","children":[{"type":"inlineCode","value":"queryClient.setQueryData"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetquerystate","children":[{"type":"inlineCode","value":"queryClient.getQueryState"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetqueriesdata","children":[{"type":"inlineCode","value":"queryClient.setQueriesData"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientinvalidatequeries","children":[{"type":"inlineCode","value":"queryClient.invalidateQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientrefetchqueries","children":[{"type":"inlineCode","value":"queryClient.refetchQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientcancelqueries","children":[{"type":"inlineCode","value":"queryClient.cancelQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientremovequeries","children":[{"type":"inlineCode","value":"queryClient.removeQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientresetqueries","children":[{"type":"inlineCode","value":"queryClient.resetQueries"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientisfetching","children":[{"type":"inlineCode","value":"queryClient.isFetching"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientismutating","children":[{"type":"inlineCode","value":"queryClient.isMutating"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetlogger","children":[{"type":"inlineCode","value":"queryClient.getLogger"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetdefaultoptions","children":[{"type":"inlineCode","value":"queryClient.getDefaultOptions"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetdefaultoptions","children":[{"type":"inlineCode","value":"queryClient.setDefaultOptions"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetquerydefaults","children":[{"type":"inlineCode","value":"queryClient.getQueryDefaults"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetquerydefaults","children":[{"type":"inlineCode","value":"queryClient.setQueryDefaults"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetmutationdefaults","children":[{"type":"inlineCode","value":"queryClient.getMutationDefaults"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientsetmutationdefaults","children":[{"type":"inlineCode","value":"queryClient.setMutationDefaults"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetquerycache","children":[{"type":"inlineCode","value":"queryClient.getQueryCache"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientgetmutationcache","children":[{"type":"inlineCode","value":"queryClient.getMutationCache"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientclear","children":[{"type":"inlineCode","value":"queryClient.clear"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"#queryclientresumepausedmutations","children":[{"type":"inlineCode","value":"queryClient.resumePausedMutations"}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryCache?: QueryCache"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The query cache this client is connected to."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mutationCache?: MutationCache"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The mutation cache this client is connected to."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"logger?: Logger"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The logger this client uses to log debugging information, warnings and errors. If not set, "},{"type":"inlineCode","value":"console"},{"type":"text","value":" is the default logger."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultOptions?: DefaultOptions"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Define defaults for all queries and mutations using this queryClient."}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-fetchquery","children":[{"type":"inlineCode","value":"queryClient.fetchQuery"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" is an asynchronous method that can be used to fetch and cache a query. It will either resolve with the data or throw with the error. Use the "},{"type":"inlineCode","value":"prefetchQuery"},{"type":"text","value":" method if you just want to fetch a query without needing the result."}]},{"type":"paragraph","children":[{"type":"text","value":"If the query exists and the data is not invalidated or older than the given "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":", then the data from the cache will be returned. Otherwise it will try to fetch the latest data."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"The difference between using "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" and "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" is that "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" is async and will ensure that duplicate requests for this query are not created with "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" instances for the same query are rendered while the data is fetching."}]}]},{"type":"code","value":"try {\n  const data = await queryClient.fetchQuery({ queryKey, queryFn })\n} catch (error) {\n  console.log(error)\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Specify a "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" to only fetch when the data is older than a certain amount of time:"}]},{"type":"code","value":"try {\n  const data = await queryClient.fetchQuery({\n    queryKey,\n    queryFn,\n    staleTime: 10000,\n  })\n} catch (error) {\n  console.log(error)\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" are exactly the same as those of "},{"type":"link","href":"../../framework/react/reference/useQuery","children":[{"type":"inlineCode","value":"useQuery"}]},{"type":"text","value":", except the following: "},{"type":"inlineCode","value":"enabled, refetchInterval, refetchIntervalInBackground, refetchOnWindowFocus, refetchOnReconnect, notifyOnChangeProps, onSuccess, onError, onSettled, useErrorBoundary, select, suspense, keepPreviousData, placeholderData"},{"type":"text","value":"; which are strictly for useQuery and useInfiniteQuery. You can check the "},{"type":"link","href":"https://github.com/tannerlinsley/react-query/blob/361935a12cec6f36d0bd6ba12e84136c405047c5/src/core/types.ts#L83","children":[{"type":"text","value":"source code"}]},{"type":"text","value":" for more clarity."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise<TData>"}]}]}]},{"type":"heading","depth":2,"id":"queryclient-fetchinfinitequery","children":[{"type":"inlineCode","value":"queryClient.fetchInfiniteQuery"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"fetchInfiniteQuery"},{"type":"text","value":" is similar to "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" but can be used to fetch and cache an infinite query."}]},{"type":"code","value":"try {\n  const data = await queryClient.fetchInfiniteQuery({ queryKey, queryFn })\n  console.log(data.pages)\n} catch (error) {\n  console.log(error)\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"fetchInfiniteQuery"},{"type":"text","value":" are exactly the same as those of "},{"type":"link","href":"#queryclientfetchquery","children":[{"type":"inlineCode","value":"fetchQuery"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise<InfiniteData<TData>>"}]}]}]},{"type":"heading","depth":2,"id":"queryclient-prefetchquery","children":[{"type":"inlineCode","value":"queryClient.prefetchQuery"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"prefetchQuery"},{"type":"text","value":" is an asynchronous method that can be used to prefetch a query before it is needed or rendered with "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" and friends. The method works the same as "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" except that it will not throw or return any data."}]},{"type":"code","value":"await queryClient.prefetchQuery({ queryKey, queryFn })","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"You can even use it with a default queryFn in your config!"}]},{"type":"code","value":"await queryClient.prefetchQuery({ queryKey })","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"prefetchQuery"},{"type":"text","value":" are exactly the same as those of "},{"type":"link","href":"#queryclientfetchquery","children":[{"type":"inlineCode","value":"fetchQuery"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise<void>"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A promise is returned that will either immediately resolve if no fetch is needed or after the query has been executed. It will not return any data or throw any errors."}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-prefetchinfinitequery","children":[{"type":"inlineCode","value":"queryClient.prefetchInfiniteQuery"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"prefetchInfiniteQuery"},{"type":"text","value":" is similar to "},{"type":"inlineCode","value":"prefetchQuery"},{"type":"text","value":" but can be used to prefetch and cache an infinite query."}]},{"type":"code","value":"await queryClient.prefetchInfiniteQuery({ queryKey, queryFn })","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"prefetchInfiniteQuery"},{"type":"text","value":" are exactly the same as those of "},{"type":"link","href":"#queryclientfetchquery","children":[{"type":"inlineCode","value":"fetchQuery"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise<void>"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A promise is returned that will either immediately resolve if no fetch is needed or after the query has been executed. It will not return any data or throw any errors."}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-getquerydata","children":[{"type":"inlineCode","value":"queryClient.getQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"getQueryData"},{"type":"text","value":" is a synchronous function that can be used to get an existing query's cached data. If the query does not exist, "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" will be returned."}]},{"type":"code","value":"const data = queryClient.getQueryData(queryKey)","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"data: TQueryFnData | undefined"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The data for the cached query, or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" if the query does not exist."}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-ensurequerydata","children":[{"type":"inlineCode","value":"queryClient.ensureQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ensureQueryData"},{"type":"text","value":" is an asynchronous function that can be used to get an existing query's cached data. If the query does not exist, "},{"type":"inlineCode","value":"queryClient.fetchQuery"},{"type":"text","value":" will be called and its results returned."}]},{"type":"code","value":"const data = await queryClient.ensureQueryData({ queryKey, queryFn })","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The options for "},{"type":"inlineCode","value":"ensureQueryData"},{"type":"text","value":" are exactly the same as those of "},{"type":"link","href":"#queryclientfetchquery","children":[{"type":"inlineCode","value":"fetchQuery"}]},{"type":"text","value":" except that "},{"type":"inlineCode","value":"queryKey"},{"type":"text","value":" is required."}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise<TData>"}]}]}]},{"type":"heading","depth":2,"id":"queryclient-getqueriesdata","children":[{"type":"inlineCode","value":"queryClient.getQueriesData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"getQueriesData"},{"type":"text","value":" is a synchronous function that can be used to get the cached data of multiple queries. Only queries that match the passed queryKey or queryFilter will be returned. If there are no matching queries, an empty array will be returned."}]},{"type":"code","value":"const data = queryClient.getQueriesData(filters)","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"if a filter is passed, the data with queryKeys matching the filter will be returned"}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Returns"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"[queryKey: QueryKey, data: TQueryFnData | undefined][]"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"An array of tuples for the matched query keys, or "},{"type":"inlineCode","value":"[]"},{"type":"text","value":" if there are no matches. The tuples are the query key and its associated data."}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Caveats"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Because the returned data in each tuple can be of varying structures (i.e. using a filter to return \"active\" queries can return different data types), the "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" generic defaults to "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":". If you provide a more specific type to "},{"type":"inlineCode","value":"TData"},{"type":"text","value":" it is assumed that you are certain each tuple's data entry is all the same type."}]},{"type":"paragraph","children":[{"type":"text","value":"This distinction is more a \"convenience\" for ts devs that know which structure will be returned."}]},{"type":"heading","depth":2,"id":"queryclient-setquerydata","children":[{"type":"inlineCode","value":"queryClient.setQueryData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" is a synchronous function that can be used to immediately update a query's cached data. If the query does not exist, it will be created. "},{"type":"strong","children":[{"type":"text","value":"If the query is not utilized by a query hook in the default "},{"type":"inlineCode","value":"cacheTime"},{"type":"text","value":" of 5 minutes, the query will be garbage collected"}]},{"type":"text","value":". To update multiple queries at once and match query keys partially, you need to use "},{"type":"link","href":"#queryclientsetqueriesdata","children":[{"type":"inlineCode","value":"queryClient.setQueriesData"}]},{"type":"text","value":" instead."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"The difference between using "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" and "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" is that "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" is sync and assumes that you already synchronously have the data available. If you need to fetch the data asynchronously, it's suggested that you either refetch the query key or use "},{"type":"inlineCode","value":"fetchQuery"},{"type":"text","value":" to handle the asynchronous fetch."}]}]},{"type":"code","value":"queryClient.setQueryData(queryKey, updater)","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"updater: TQueryFnData | undefined | ((oldData: TQueryFnData | undefined) => TQueryFnData | undefined)"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If non-function is passed, the data will be updated to this value"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a function is passed, it will receive the old data value and be expected to return a new one."}]}]}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Using an updater value"}]}]},{"type":"code","value":"setQueryData(queryKey, newData)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If the value is "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", the query data is not updated."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Using an updater function"}]}]},{"type":"paragraph","children":[{"type":"text","value":"For convenience in syntax, you can also pass an updater function which receives the current data value and returns the new one:"}]},{"type":"code","value":"setQueryData(queryKey, (oldData) => newData)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If the updater function returns "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":", the query data will not be updated. If the updater function receives "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" as input, you can return "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" to bail out of the update and thus "},{"type":"emphasis","children":[{"type":"text","value":"not"}]},{"type":"text","value":" create a new cache entry."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Immutability"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Updates via "},{"type":"inlineCode","value":"setQueryData"},{"type":"text","value":" must be performed in an "},{"type":"emphasis","children":[{"type":"text","value":"immutable"}]},{"type":"text","value":" way. "},{"type":"strong","children":[{"type":"text","value":"DO NOT"}]},{"type":"text","value":" attempt to write directly to the cache by mutating "},{"type":"inlineCode","value":"oldData"},{"type":"text","value":" or data that you retrieved via "},{"type":"inlineCode","value":"getQueryData"},{"type":"text","value":" in place."}]},{"type":"heading","depth":2,"id":"queryclient-getquerystate","children":[{"type":"inlineCode","value":"queryClient.getQueryState"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"getQueryState"},{"type":"text","value":" is a synchronous function that can be used to get an existing query's state. If the query does not exist, "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" will be returned."}]},{"type":"code","value":"const state = queryClient.getQueryState({ queryKey })\nconsole.log(state.dataUpdatedAt)","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-setqueriesdata","children":[{"type":"inlineCode","value":"queryClient.setQueriesData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"setQueriesData"},{"type":"text","value":" is a synchronous function that can be used to immediately update cached data of multiple queries by using filter function or partially matching the query key. Only queries that match the passed queryKey or queryFilter will be updated - no new cache entries will be created. Under the hood, "},{"type":"link","href":"#queryclientsetquerydata","children":[{"type":"inlineCode","value":"setQueryData"}]},{"type":"text","value":" is called for each existing query."}]},{"type":"code","value":"queryClient.setQueriesData(filters, updater)","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"if a filter is passed, queryKeys matching the filter will be updated"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"updater: TQueryFnData | (oldData: TQueryFnData | undefined) => TQueryFnData"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"the "},{"type":"link","href":"#queryclientsetquerydata","children":[{"type":"text","value":"setQueryData"}]},{"type":"text","value":" updater function or new data, will be called for each matching queryKey"}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-invalidatequeries","children":[{"type":"inlineCode","value":"queryClient.invalidateQueries"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"invalidateQueries"},{"type":"text","value":" method can be used to invalidate and refetch single or multiple queries in the cache based on their query keys or any other functionally accessible property/state of the query. By default, all matching queries are immediately marked as invalid and active queries are refetched in the background."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you "},{"type":"strong","children":[{"type":"text","value":"do not want active queries to refetch"}]},{"type":"text","value":", and simply be marked as invalid, you can use the "},{"type":"inlineCode","value":"refetchType: 'none'"},{"type":"text","value":" option."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you "},{"type":"strong","children":[{"type":"text","value":"want inactive queries to refetch"}]},{"type":"text","value":" as well, use the "},{"type":"inlineCode","value":"refetchType: 'all'"},{"type":"text","value":" option"}]}]}]},{"type":"code","value":"await queryClient.invalidateQueries(\n  {\n    queryKey: ['posts'],\n    exact,\n    refetchType: 'active',\n  },\n  { throwOnError, cancelRefetch },\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/guides/filters#query-filters","children":[{"type":"text","value":"Query Filters"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"queryKey?: QueryKey"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/guides/query-keys","children":[{"type":"text","value":"Query Keys"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"refetchType?: 'active' | 'inactive' | 'all' | 'none'"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"'active'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"active"},{"type":"text","value":", only queries that match the refetch predicate and are actively being rendered via "},{"type":"inlineCode","value":"useQuery"},{"type":"text","value":" and friends will be refetched in the background."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineC