ype":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"cancelRefetch?: boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"true"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Per default, a currently running request will be cancelled before a new request is made"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"When set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":", no refetch will be made if there is already a request running."}]}]}]}]}]}]}]},{"type":"heading","depth":2,"id":"queryclient-refetchqueries","children":[{"type":"inlineCode","value":"queryClient.refetchQueries"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"refetchQueries"},{"type":"text","value":" method can be used to refetch queries based on certain conditions."}]},{"type":"paragraph","children":[{"type":"text","value":"Examples:"}]},{"type":"code","value":"// refetch all queries:\nawait queryClient.refetchQueries()\n\n// refetch all stale queries:\nawait queryClient.refetchQueries({ stale: true })\n\n// refetch all active queries partially matching a query key:\nawait queryClient.refetchQueries({ queryKey: ['posts'], type: 'active' })\n\n// refetch all active queries exactly matching a query key:\nawait queryClient.refetchQueries({\n  queryKey: ['posts', 1],\n  type: 'active',\n  exact: true,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Options"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"filters?: QueryFilters"},{"type":"text","value":": "},{"type":"link","href":"../../framework/react/g