{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"Redirect"},{"type":"text","value":" type is used to represent a redirect action in TanStack Router."}]},{"type":"code","value":"export type Redirect = {\n  statusCode?: number\n  throw?: any\n  headers?: HeadersInit\n} & NavigateOptions","lang":"tsx"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./NavigateOptionsType.md","children":[{"type":"inlineCode","value":"NavigateOptions"}]}]}]}]},{"type":"heading","depth":2,"id":"redirect-properties","children":[{"type":"text","value":"Redirect properties"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"Redirect"},{"type":"text","value":" object accepts/contains the following properties:"}]},{"type":"heading","depth":3,"id":"statuscode-property","children":[{"type":"inlineCode","value":"statusCode"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"number"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The HTTP status code to use when redirecting"}]}]}]},{"type":"heading","depth":3,"id":"throw-property","children":[{"type":"inlineCode","value":"throw"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"any"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If provided, will throw the redirect object instead of returning it. This can be useful in places where "},{"type":"inlineCode","value":"throwing"},{"type":"text","value":" in a function might cause it to have a return type of "},{"type":"inlineCode","value":"never"},{"type":"text","value":". In that case, you can use "},{"type":"inlineCode","value":"redirect({ throw: true })"},{"type":"text","value":" to throw the redirect object instead of returning it."}]}]}]},{"type":"heading","depth":3,"id":"headers-property","children":[{"type":"inlineCode","value":"headers"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"HeadersInit"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The HTTP headers to use when redirecting."}]}]}]},{"type":"heading","depth":3,"id":"navigation-properties","children":[{"type":"text","value":"Navigation Properties"}]},{"type":"paragraph","children":[{"type":"text","value":"Since "},{"type":"inlineCode","value":"Redirect"},{"type":"text","value":" extends "},{"type":"inlineCode","value":"NavigateOptions"},{"type":"text","value":", it also supports navigation properties:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"to"}]},{"type":"text","value":": Use for internal application routes (e.g., "},{"type":"inlineCode","value":"/dashboard"},{"type":"text","value":", "},{"type":"inlineCode","value":"../profile"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"href"}]},{"type":"text","value":": Use for external URLs (e.g., "},{"type":"inlineCode","value":"https://example.com"},{"type":"text","value":", "},{"type":"inlineCode","value":"https://authprovider.com"},{"type":"text","value":")"}]}]}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Important"}]},{"type":"text","value":": For external URLs, always use the "},{"type":"inlineCode","value":"href"},{"type":"text","value":" property instead of "},{"type":"inlineCode","value":"to"},{"type":"text","value":". The "},{"type":"inlineCode","value":"to"},{"type":"text","value":" property is designed for internal navigation within your application."}]}]}],"headings":[{"id":"redirect-properties","text":"Redirect properties","level":2},{"id":"statuscode-property","text":"statusCode property","level":3},{"id":"throw-property","text":"throw property","level":3},{"id":"headers-property","text":"headers property","level":3},{"id":"navigation-properties","text":"Navigation Properties","level":3}]},"frameworks":[],"downloadMarkdown":"\nThe `Redirect` type is used to represent a redirect action in TanStack Router.\n\n```tsx\nexport type Redirect = {\n  statusCode?: number\n  throw?: any\n  headers?: HeadersInit\n} & NavigateOptions\n```\n\n- [`NavigateOptions`](./NavigateOptionsType.md)\n\n## Redirect properties\n\nThe `Redirect` object accepts/contains the following properties:\n\n### `statusCode` property\n\n- Type: `number`\n- Optional\n- The HTTP status code to use when redirecting\n\n### `throw` property\n\n- Type: `any`\n- Optional\n- If provided, will throw the redirect object instead of returning it. This can be useful in places where `throwing` in a function might cause it to have a return type of `never`. In that case, you can use `redirect({ throw: true })` to throw the redirect object instead of returning it.\n\n### `headers` property\n\n- Type: `HeadersInit`\n- Optional\n- The HTTP headers to use when redirecting.\n\n### Navigation Properties\n\nSince `Redirect` extends `NavigateOptions`, it also supports navigation properties:\n\n- **`to`**: Use for internal application routes (e.g., `/dashboard`, `../profile`)\n- **`href`**: Use for external URLs (e.g., `https://example.com`, `https://authprovider.com`)\n\n> **Important**: For external URLs, always use the `href` property instead of `to`. The `to` property is designed for internal navigation within your application.\n","originalRawMarkdown":"---\nid: RedirectType\ntitle: Redirect type\n---\n\nThe `Redirect` type is used to represent a redirect action in TanStack Router.\n\n```tsx\nexport type Redirect = {\n  statusCode?: number\n  throw?: any\n  headers?: HeadersInit\n} & NavigateOptions\n```\n\n- [`NavigateOptions`](./NavigateOptionsType.md)\n\n## Redirect properties\n\nThe `Redirect` object accepts/contains the following properties:\n\n### `statusCode` property\n\n- Type: `number`\n- Optional\n- The HTTP status code to use when redirecting\n\n### `throw` property\n\n- Type: `any`\n- Optional\n- If provided, will throw the redirect object instead of returning it. This can be useful in places where `throwing` in a function might cause it to have a return type of `never`. In that case, you can use `redirect({ throw: true })` to throw the redirect object instead of returning it.\n\n### `headers` property\n\n- Type: `HeadersInit`\n- Optional\n- The HTTP headers to use when redirecting.\n\n### Navigation Properties\n\nSince `Redirect` extends `NavigateOptions`, it also supports navigation properties:\n\n- **`to`**: Use for internal application routes (e.g., `/dashboard`, `../profile`)\n- **`href`**: Use for external URLs (e.g., `https://example.com`, `https://authprovider.com`)\n\n> **Important**: For external URLs, always use the `href` property instead of `to`. The `to` property is designed for internal navigation within your application.\n"}
