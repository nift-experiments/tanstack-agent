":"casesensitive-property","children":[{"type":"inlineCode","value":"caseSensitive"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"false"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"true"},{"type":"text","value":", all routes will be matched as case-sensitive."}]}]}]},{"type":"heading","depth":3,"id":"basepath-property","children":[{"type":"inlineCode","value":"basepath"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"string"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"/"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The basepath for the entire router. This is useful for mounting a router instance at a subpath."}]}]}]},{"type":"heading","depth":3,"id":"origin-property","children":[{"type":"inlineCode","value":"origin"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"string"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The origin used to resolve URLs. Defaults to the browser origin, or "},{"type":"inlineCode","value":"http://localhost"},{"type":"text","value":" on the server and in browsers with an opaque origin."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Pass a normalized origin, such as "},{"type":"inlineCode","value":"https://example.com"},{"type":"text","value":" or "},{"type":"inlineCode","value":"http://localhost:3000"},{"type":"text","value":", without a path or trailing slash. The router uses this value as provided; if you have a full URL, normalize it with "},{"type":"inlineCode","value":"new URL(url).origin"},{"type":"text","value":" before passing it to the router."}]}]}]},{"type":"heading","depth":3,"id":"rewrite-property","children":[{"type":"inlineCode","value":"rewrite"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"LocationRewrite"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Configures bidirectional URL transformation between the browser URL and the router's internal URL."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../../guide/url-rewrites.md","children":[{"type":"text","value":"URL Rewrites guide"}]},{"type":"text","value":" for detailed usage and patterns."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"LocationRewrite"},{"type":"text","value":" type has the following shape:"}]},{"type":"code","value":"type LocationRewrite = {\n  input?: LocationRewriteFunction\n  output?: LocationRewriteFunction\n}\n\ntype LocationRewriteFunction = (opts: { url: URL }) => undefined | string | URL","lang":"tsx"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"input"},{"type":"text","value":": Transforms the URL before the router interprets it (browser → router)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"output"},{"type":"text","value":": Transforms the URL before it's written to browser history (router → browser)"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Example"}]}]},{"type":"code","value":"import { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  routeTree,\n  rewrite: {\n    input: ({ url }) => {\n      // Strip locale prefix: /en/about → /about\n      if (url.pathname.startsWith('/en')) {\n        url.pathname = url.pathname.replace(/^\\/en/, '') || '/'\n      }\n      return url\n    },\n    output: ({ url }) => {\n      // Add locale prefix: /about → /en/about\n      url.pathname = `/en${url.pathname === '/' ? '' : url.pathname}`\n      return url\n    },\n  },\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"When both "},{"type":"inlineCode","value":"basepath"},{"type":"text","value":" and "},{"type":"inlineCode","value":"rewrite"},{"type":"text","value":" are configured, they are automatically composed. The basepath rewrite runs first on input (stripping the basepath) and last on output (adding it back)."}]},{"type":"heading","depth":3,"id":"context-property","children":[{"type":"inlineCode","value":"context"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"any"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional or required if the root route was created with "},{"type":"link","href":"./createRootRouteWithContextFunction.md","children":[{"type":"inlineCode","value":"createRootRouteWithContext()"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The root context that will be provided to all routes in the route tree. This can be used to provide a context to all routes in the tree without having to provide it to each route individually."}]}]}]},{"type":"heading","depth":3,"id":"dehydrate-method","children":[{"type":"inlineCode","value":"dehydrate"},{"type":"text","value":" method"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"() => TDehydrated"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A function that will be called when the router is dehydrated. The return value of this function will be serialized and stored in the router's dehydrated state."}]}]}]},{"type":"heading","depth":3,"id":"hydrate-method","children":[{"type":"inlineCode","value":"hydrate"},{"type":"text","value":" method"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"(dehydrated: TDehydrated) => void"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A function that will be called when the router is hydrated. The return value of this function will be serialized and stored in the router's dehydrated state."}]}]}]},{"type":"heading","depth":3,"id":"routemasks-property","children":[{"type":"inlineCode","value":"routeMasks"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"RouteMask[]"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"An array of route masks that will be used to mask routes in the route tree. Route masking is when you display a route at a different path than the one it is configured to match, like a modal popup that when shared will unmask to the modal's content instead of the modal's context."}]}]}]},{"type":"heading","depth":3,"id":"unmaskonreload-property","children":[{"type":"inlineCode","value":"unmaskOnReload"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"false"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"true"},{"type":"text","value":", route masks will, by default, be removed when the page is reloaded. This can be overridden on a per-mask basis by setting "},{"type":"inlineCode","value":"unmaskOnReload"},{"type":"text","value":" on the mask, or on a per-navigation basis by setting "},{"type":"inlineCode","value":"mask.unmaskOnReload"},{"type":"text","value":" in "},{"type":"link","href":"./NavigateOptionsType.md","children":[{"type":"inlineCode","value":"NavigateOptions"}]},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":3,"id":"wrap-property","children":[{"type":"inlineCode","value":"Wrap"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"React.Component"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A component that will be used to wrap the entire router. This is useful for providing a context to the entire router. Only non-DOM-rendering components like providers should be used, anything else will cause a hydration error."}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Example"}]}]},{"type":"code","value":"import { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  Wrap: ({ children }) => {\n    return <MyContext.Provider value={myContext}>{children}</MyContext>\n  },\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"innerwrap-property","children":[{"type":"inlineCode","value":"InnerWrap"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"React.Component"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A component that will be used to wrap the inner contents of the router. This is useful for providing a context to the inner contents of the router where you also need access to the router context and hooks. Only non-DOM-rendering components like providers should be used, anything else will cause a hydration error."}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Example"}]}]},{"type":"code","value":"import { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  InnerWrap: ({ children }) => {\n    const routerState = useRouterState()\n\n    return (\n      <MyContext.Provider value={myContext}>\n        {children}\n      </MyContext>\n    )\n  },\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"notfoundmode-property","children":[{"type":"inlineCode","value":"notFoundMode"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"'root' | 'fuzzy'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"'fuzzy'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This property controls how TanStack Router will handle scenarios where it cannot find a route to match the current location. See the "},{"type":"link","href":"../../guide/not-found-errors.md","children":[{"type":"text","value":"Not Found Errors guide"}]},{"type":"text","value":" for more information."}]}]}]},{"type":"heading","depth":3,"id":"notfoundroute-property","children":[{"type":"inlineCode","value":"notFoundRoute"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Deprecated"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"NotFoundRoute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A route that will be used as the default not found route for every branch of the route tree. This can be overridden on a per-branch basis by providing a not found route to the "},{"type":"inlineCode","value":"NotFoundRoute"},{"type":"text","value":" option on the root route of the branch."}]}]}]},{"type":"heading","depth":3,"id":"trailingslash-property","children":[{"type":"inlineCode","value":"trailingSlash"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"'always' | 'never' | 'preserve'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"never"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Configures how trailing slashes are treated. "},{"type":"inlineCode","value":"'always'"},{"type":"text","value":" will add a trailing slash if not present, "},{"type":"inlineCode","value":"'never'"},{"type":"text","value":" will remove the trailing slash if present and "},{"type":"inlineCode","value":"'preserve'"},{"type":"text","value":" will not modify the trailing slash."}]}]}]},{"type":"heading","depth":3,"id":"pathparamsallowedcharacters-property","children":[{"type":"inlineCode","value":"pathParamsAllowedCharacters"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"ReadonlyArray<';' | ':' | '@' | '&' | '=' | '+' | '$' | ','>"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Configures which URI characters are allowed in path params that would ordinarily be escaped by encodeURIComponent."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Read only when the router is created. To change these characters, create a new router instance. Router option updates and provider props do not change this setting."}]}]}]},{"type":"heading","depth":3,"id":"defaultstructuralsharing-property","children":[{"type":"inlineCode","value":"defaultStructuralSharing"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"false"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Configures whether structural sharing is enabled by default for fine-grained selectors."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../../guide/render-optimizations.md","children":[{"type":"text","value":"Render Optimizations guide"}]},{"type":"text","value":" for more information."}]}]}]},{"type":"heading","depth":3,"id":"defaultremountdeps-property","children":[{"type":"inlineCode","value":"defaultRemountDeps"},{"type":"text","value":" property"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type:"}]}]}]},{"type":"code","value":"type defaultRemountDeps = (opts: RemountDepsOptions) => any\n\ninterface RemountDepsOptions<\n  in out TRouteId,\n  in out TFullSearchSchema,\n  in out TAllParams,\n  in out TLoaderDeps,\n> {\n  routeId: TRouteId\n  search: TFullSearchSchema\n  params: TAllParams\n  loaderDeps: TLoaderDeps\n}","lang":"tsx"},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A default function that will be called to determine whether a route component shall be remounted after navigation. If this function returns a different value than previously, it will remount."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The return value needs to be JSON serializable."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"By default, a route component will not be remounted if it stays active after a navigation"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Example:\nIf you want to configure to remount all route components upon "},{"type":"inlineCode","value":"params"},{"type":"text","value":" change, use:"}]},{"type":"code","value":"remountDeps: ({ params }) => params","lang":"tsx"}],"headings":[{"id":"routeroptions-properties","text":"RouterOptions properties","level":2},{"id":"routetree-property","text":"routeTree property","level":3},{"id":"history-property","text":"history property","level":3},{"id":"stringifysearch-method","text":"stringifySearch method","level":3},{"id":"parsesearch-method","text":"parseSearch method","level":3},{"id":"search-strict-property","text":"search.strict property","level":3},{"id":"defaultpreload-property","text":"defaultPreload property","level":3},{"id":"defaultpreloaddelay-property","text":"defaultPreloadDelay property","level":3},{"id":"defaultcomponent-property","text":"defaultComponent property","level":3},{"id":"defaulterrorcomponent-property","text":"defaultErrorComponent property","level":3},{"id":"defaultnotfoundcomponent-property","text":"defaultNotFoundComponent property","level":3},{"id":"defaultpendingcomponent-property","text":"defaultPendingComponent property","level":3},{"id":"defaultpendingms-property","text":"defaultPendingMs property","level":3},{"id":"defaultpendingminms-property","text":"defaultPendingMinMs property","level":3},{"id":"defaultstaletime-property","text":"defaultStaleTime property","level":3},{"id":"defaultstalereloadmode-property","text":"defaultStaleReloadMode property","level":3},{"id":"defaultpreloadstaletime-property","text":"defaultPreloadStaleTime property","level":3},{"id":"defaultpreloadgctime-property","text":"defaultPreloadGcTime property","level":3},{"id":"defaultgctime-property","text":"defaultGcTime property","level":3},{"id":"defaultoncatch-property","text":"defaultOnCatch property","level":3},{"id":"disableglobalcatchboundary-property","text":"disableGlobalCatchBoundary property","level":3},{"id":"protocolallowlist-property","text":"protocolAllowlist property","level":3},{"id":"defaultviewtransition-property","text":"defaultViewTransition property","level":3},{"id":"defaulthashscrollintoview-property","text":"defaultHashScrollIntoView property","level":3},{"id":"casesensitive-property","text":"caseSensitive property","level":3},{"id":"basepath-property","text":"basepath property","level":3},{"id":"origin-property","text":"origin property","level":3},{"id":"rewrite-property","text":"rewrite property","level":3},{"id":"context-property","text":"context property","level":3},{"id":"dehydrate-method","text":"dehydrate method","level":3},{"id":"hydrate-method","text":"hydrate method","level":3},{"id":"routemasks-property","text":"routeMasks property","level":3},{"id":"unmaskonreload-property","text":"unmaskOnReload property","level":3},{"id":"wrap-property","text":"Wrap property","level":3},{"id":"innerwrap-property","text":"InnerWrap property","level":3},{"id":"notfoundmode-property","text":"notFoundMode property","level":3},{"id":"notfoundroute-property","text":"notFoundRoute property","level":3},{"id":"trailingslash-property","text":"trailingSlash property","level":3},{"id":"pathparamsallowedcharacters-property","text":"pathParamsAllowedCharacters property","level":3},{"id":"defaultstructuralsharing-property","text":"defaultStructuralSharing property","level":3},{"id":"defaultremountdeps-property","text":"defaultRemountDeps property","level":3}]},"frameworks":[],"downloadMarkdown":"\nThe `RouterOptions` type contains all of the options that can be used to configure a router instance.\n\n## RouterOptions properties\n\nThe `RouterOptions` type accepts an object with the following properties and methods:\n\n### `routeTree` property\n\n- Type: `AnyRoute`\n- Required\n- The route tree that will be used to configure the router instance.\n\n### `history` property\n\n- Type: `RouterHistory`\n- Optional\n- The history object that will be used to manage the browser history. If not provided, a new `createBrowserHistory` instance will be created and used.\n\n### `stringifySearch` method\n\n- Type: `(search: Record<string, any>) => string`\n- Optional\n- A function that will be used to stringify search params when generating links.\n- Defaults to `defaultStringifySearch`.\n\n### `parseSearch` method\n\n- Type: `(search: string) => Record<string, any>`\n- Optional\n- A function that will be used to parse search params when parsing the current location.\n- Defaults to `defaultParseSearch`.\n\n### `search.strict` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- Configures how unknown search params (= not returned by any `validateSearch`) are treated.\n- If `false`, unknown search params will be kept.\n- If `true`, unknown search params will be removed.\n\n### `defaultPreload` property\n\n- Type: `undefined | false | 'intent' | 'viewport' | 'render'`\n- Optional\n- Defaults to `false`\n- If `false`, routes will not be preloaded by default in any way.\n- If `'intent'`, routes will be preloaded by default when the user hovers over a link or a `touchstart` event is detected on a `<Link>`.\n- If `'viewport'`, routes will be preloaded by default when they are within the viewport of the browser.\n- If `'render'`, routes will be preloaded by default as soon as they are rendered in the DOM.\n\n### `defaultPreloadDelay` property\n\n- Type: `number`\n- Optional\n- Defaults to `50`\n- The delay in milliseconds before intent focus/hover and viewport preloading. Touch intent preloads immediately.\n\n### `defaultComponent` property\n\n- Type: `RouteComponent`\n- Optional\n- Defaults to `Outlet`\n- The default `component` a route should use if no component is provided.\n\n### `defaultErrorComponent` property\n\n- Type: `RouteComponent`\n- Optional\n- Defaults to `ErrorComponent`\n- The default `errorComponent` a route should use if no error component is provided.\n\n### `defaultNotFoundComponent` property\n\n- Type: `NotFoundRouteComponent`\n- Optional\n- Defaults to `NotFound`\n- The default `notFoundComponent` a route should use if no notFound component is provided.\n\n### `defaultPendingComponent` property\n\n- Type: `RouteComponent`\n- Optional\n- The default `pendingComponent` a route should use if no pending component is provided.\n\n### `defaultPendingMs` property\n\n- Type: `number`\n- Optional\n- Defaults to `1000`\n- The default `pendingMs` a route should use if no pendingMs is provided.\n\n### `defaultPendingMinMs` property\n\n- Type: `number`\n- Optional\n- Defaults to `500`\n- The default `pendingMinMs` a route should use if no pendingMinMs is provided.\n\n### `defaultStaleTime` property\n\n- Type: `number`\n- Optional\n- Defaults to `0`\n- The default `staleTime` a route should use if no staleTime is provided.\n\n### `defaultStaleReloadMode` property\n\n- Type: `'background' | 'blocking'`\n- Optional\n- Defaults to `'background'`\n- Controls how stale successful loader data is revalidated by default.\n- `'background'` preserves stale-while-revalidate behavior.\n- `'blocking'` waits for the stale loader reload to finish before navigation resolves.\n\n### `defaultPreloadStaleTime` property\n\n- Type: `number`\n- Optional\n- Defaults to `30_000` ms (30 seconds)\n- The default `preloadStaleTime` a route should use if no preloadStaleTime is provided.\n\n### `defaultPreloadGcTime` property\n\n- Type: `number`\n- Optional\n- Defaults to 5 minutes.\n- The default `preloadGcTime` a route should use if no preloadGcTime is provided.\n\n### `defaultGcTime` property\n\n- Type: `number`\n- Optional\n- Defaults to 5 minutes.\n- The default `gcTime` a route should use if no gcTime is provided.\n\n### `defaultOnCatch` property\n\n- Type: `(error: unknown, errorInfo: ErrorInfo) => void`\n- Optional\n- The default `onCatch` handler for errors caught by the Router ErrorBoundary\n\n### `disableGlobalCatchBoundary` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- When `true`, disables the global catch boundary that normally wraps all route matches. This allows unhandled errors to bubble up to top-level error handlers in the browser.\n- Useful for testing tools, error reporting services, and debugging scenarios.\n\n### `protocolAllowlist` property\n\n- Type: `Array<string>`\n- Optional\n- Defaults to `DEFAULT_PROTOCOL_ALLOWLIST` which includes:\n  - Web navigation: `http:`, `https:`\n  - Common browser-safe actions: `mailto:`, `tel:`\n- An array of URL protocols that are allowed in links, redirects, and navigation. Absolute URLs with protocols not in this list are rejected to prevent security vulnerabilities like XSS attacks.\n- This check is applied across router navigation APIs, including:\n  - `<Link to=\"...\">`\n  - `navigate({ to: ... })` and `navigate({ href: ... })`\n  - `redirect({ to: ... })` and `redirect({ href: ... })`\n- Protocol entries must match `URL.protocol` format (lowercase with a trailing `:`), for example `blob:` or `data:`. If you configure `protocolAllowlist: ['blob']` (without `:`), links using `blob:` will still be blocked.\n\n**Example**\n\n```tsx\nimport {\n  createRouter,\n  DEFAULT_PROTOCOL_ALLOWLIST,\n} from '@tanstack/react-router'\n\n// Use a custom allowlist (replaces the default)\nconst router = createRouter({\n  routeTree,\n  protocolAllowlist: ['https:', 'mailto:'],\n})\n\n// Or extend the default allowlist\nconst router = createRouter({\n  routeTree,\n  protocolAllowlist: [...DEFAULT_PROTOCOL_ALLOWLIST, 'ftp:'],\n})\n```\n\n### `defaultViewTransition` property\n\n- Type: `boolean | ViewTransitionOptions`\n- Optional\n- If `true`, route navigations will be called using `document.startViewTransition()`.\n- If [`ViewTransitionOptions`](./ViewTransitionOptionsType.md), route navigations will be called using `document.startViewTransition({update, types})`\n  where `types` will be the strings array passed with `ViewTransitionOptions[\"types\"]`. If the browser does not support viewTransition types,\n  the navigation will fall back to normal `document.startTransition()`, same as if `true` was passed.\n- If the browser does not support this api, this option will be ignored.\n- See [MDN](https://developer.mozilla.org/en-US/docs/Web/API/Document/startViewTransition) for more information on how this function works.\n- See [Google](https://developer.chrome.com/docs/web-platform/view-transitions/same-document#view-transition-types) for more information on viewTransition types\n\n### `defaultHashScrollIntoView` property\n\n- Type: `boolean | ScrollIntoViewOptions`\n- Optional\n- Defaults to `true` so the element with an id matching the hash will be scrolled into view after the location is committed to history.\n- If `false`, the element with an id matching the hash will not be scrolled into view after the location is committed to history.\n- If an object is provided, it will be passed to the `scrollIntoView` method as options.\n- See [MDN](https://developer.mozilla.org/en-US/docs/Web/API/Element/scrollIntoView) for more information on `ScrollIntoViewOptions`.\n\n### `caseSensitive` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- If `true`, all routes will be matched as case-sensitive.\n\n### `basepath` property\n\n- Type: `string`\n- Optional\n- Defaults to `/`\n- The basepath for the entire router. This is useful for mounting a router instance at a subpath.\n\n### `origin` property\n\n- Type: `string`\n- Optional\n- The origin used to resolve URLs. Defaults to the browser origin, or `http://localhost` on the server and in browsers with an opaque origin.\n- Pass a normalized origin, such as `https://example.com` or `http://localhost:3000`, without a path or trailing slash. The router uses this value as provided; if you have a full URL, normalize it with `new URL(url).origin` before passing it to the router.\n\n### `rewrite` property\n\n- Type: `LocationRewrite`\n- Optional\n- Configures bidirectional URL transformation between the browser URL and the router's internal URL.\n- See the [URL Rewrites guide](../../guide/url-rewrites.md) for detailed usage and patterns.\n\nThe `LocationRewrite` type has the following shape:\n\n```tsx\ntype LocationRewrite = {\n  input?: LocationRewriteFunction\n  output?: LocationRewriteFunction\n}\n\ntype LocationRewriteFunction = (opts: { url: URL }) => undefined | string | URL\n```\n\n- `input`: Transforms the URL before the router interprets it (browser → router)\n- `output`: Transforms the URL before it's written to browser history (router → browser)\n\n**Example**\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  routeTree,\n  rewrite: {\n    input: ({ url }) => {\n      // Strip locale prefix: /en/about → /about\n      if (url.pathname.startsWith('/en')) {\n        url.pathname = url.pathname.replace(/^\\/en/, '') || '/'\n      }\n      return url\n    },\n    output: ({ url }) => {\n      // Add locale prefix: /about → /en/about\n      url.pathname = `/en${url.pathname === '/' ? '' : url.pathname}`\n      return url\n    },\n  },\n})\n```\n\nWhen both `basepath` and `rewrite` are configured, they are automatically composed. The basepath rewrite runs first on input (stripping the basepath) and last on output (adding it back).\n\n### `context` property\n\n- Type: `any`\n- Optional or required if the root route was created with [`createRootRouteWithContext()`](./createRootRouteWithContextFunction.md).\n- The root context that will be provided to all routes in the route tree. This can be used to provide a context to all routes in the tree without having to provide it to each route individually.\n\n### `dehydrate` method\n\n- Type: `() => TDehydrated`\n- Optional\n- A function that will be called when the router is dehydrated. The return value of this function will be serialized and stored in the router's dehydrated state.\n\n### `hydrate` method\n\n- Type: `(dehydrated: TDehydrated) => void`\n- Optional\n- A function that will be called when the router is hydrated. The return value of this function will be serialized and stored in the router's dehydrated state.\n\n### `routeMasks` property\n\n- Type: `RouteMask[]`\n- Optional\n- An array of route masks that will be used to mask routes in the route tree. Route masking is when you display a route at a different path than the one it is configured to match, like a modal popup that when shared will unmask to the modal's content instead of the modal's context.\n\n### `unmaskOnReload` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- If `true`, route masks will, by default, be removed when the page is reloaded. This can be overridden on a per-mask basis by setting `unmaskOnReload` on the mask, or on a per-navigation basis by setting `mask.unmaskOnReload` in [`NavigateOptions`](./NavigateOptionsType.md).\n\n### `Wrap` property\n\n- Type: `React.Component`\n- Optional\n- A component that will be used to wrap the entire router. This is useful for providing a context to the entire router. Only non-DOM-rendering components like providers should be used, anything else will cause a hydration error.\n\n**Example**\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  Wrap: ({ children }) => {\n    return <MyContext.Provider value={myContext}>{children}</MyContext>\n  },\n})\n```\n\n### `InnerWrap` property\n\n- Type: `React.Component`\n- Optional\n- A component that will be used to wrap the inner contents of the router. This is useful for providing a context to the inner contents of the router where you also need access to the router context and hooks. Only non-DOM-rendering components like providers should be used, anything else will cause a hydration error.\n\n**Example**\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  InnerWrap: ({ children }) => {\n    const routerState = useRouterState()\n\n    return (\n      <MyContext.Provider value={myContext}>\n        {children}\n      </MyContext>\n    )\n  },\n})\n```\n\n### `notFoundMode` property\n\n- Type: `'root' | 'fuzzy'`\n- Optional\n- Defaults to `'fuzzy'`\n- This property controls how TanStack Router will handle scenarios where it cannot find a route to match the current location. See the [Not Found Errors guide](../../guide/not-found-errors.md) for more information.\n\n### `notFoundRoute` property\n\n- **Deprecated**\n- Type: `NotFoundRoute`\n- Optional\n- A route that will be used as the default not found route for every branch of the route tree. This can be overridden on a per-branch basis by providing a not found route to the `NotFoundRoute` option on the root route of the branch.\n\n### `trailingSlash` property\n\n- Type: `'always' | 'never' | 'preserve'`\n- Optional\n- Defaults to `never`\n- Configures how trailing slashes are treated. `'always'` will add a trailing slash if not present, `'never'` will remove the trailing slash if present and `'preserve'` will not modify the trailing slash.\n\n### `pathParamsAllowedCharacters` property\n\n- Type: `ReadonlyArray<';' | ':' | '@' | '&' | '=' | '+' | '$' | ','>`\n- Optional\n- Configures which URI characters are allowed in path params that would ordinarily be escaped by encodeURIComponent.\n- Read only when the router is created. To change these characters, create a new router instance. Router option updates and provider props do not change this setting.\n\n### `defaultStructuralSharing` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- Configures whether structural sharing is enabled by default for fine-grained selectors.\n- See the [Render Optimizations guide](../../guide/render-optimizations.md) for more information.\n\n### `defaultRemountDeps` property\n\n- Type:\n\n```tsx\ntype defaultRemountDeps = (opts: RemountDepsOptions) => any\n\ninterface RemountDepsOptions<\n  in out TRouteId,\n  in out TFullSearchSchema,\n  in out TAllParams,\n  in out TLoaderDeps,\n> {\n  routeId: TRouteId\n  search: TFullSearchSchema\n  params: TAllParams\n  loaderDeps: TLoaderDeps\n}\n```\n\n- Optional\n- A default function that will be called to determine whether a route component shall be remounted after navigation. If this function returns a different value than previously, it will remount.\n- The return value needs to be JSON serializable.\n- By default, a route component will not be remounted if it stays active after a navigation\n\nExample:  \nIf you want to configure to remount all route components upon `params` change, use:\n\n```tsx\nremountDeps: ({ params }) => params\n```\n","originalRawMarkdown":"---\nid: RouterOptions\ntitle: RouterOptions\n---\n\nThe `RouterOptions` type contains all of the options that can be used to configure a router instance.\n\n## RouterOptions properties\n\nThe `RouterOptions` type accepts an object with the following properties and methods:\n\n### `routeTree` property\n\n- Type: `AnyRoute`\n- Required\n- The route tree that will be used to configure the router instance.\n\n### `history` property\n\n- Type: `RouterHistory`\n- Optional\n- The history object that will be used to manage the browser history. If not provided, a new `createBrowserHistory` instance will be created and used.\n\n### `stringifySearch` method\n\n- Type: `(search: Record<string, any>) => string`\n- Optional\n- A function that will be used to stringify search params when generating links.\n- Defaults to `defaultStringifySearch`.\n\n### `parseSearch` method\n\n- Type: `(search: string) => Record<string, any>`\n- Optional\n- A function that will be used to parse search params when parsing the current location.\n- Defaults to `defaultParseSearch`.\n\n### `search.strict` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- Configures how unknown search params (= not returned by any `validateSearch`) are treated.\n- If `false`, unknown search params will be kept.\n- If `true`, unknown search params will be removed.\n\n### `defaultPreload` property\n\n- Type: `undefined | false | 'intent' | 'viewport' | 'render'`\n- Optional\n- Defaults to `false`\n- If `false`, routes will not be preloaded by default in any way.\n- If `'intent'`, routes will be preloaded by default when the user hovers over a link or a `touchstart` event is detected on a `<Link>`.\n- If `'viewport'`, routes will be preloaded by default when they are within the viewport of the browser.\n- If `'render'`, routes will be preloaded by default as soon as they are rendered in the DOM.\n\n### `defaultPreloadDelay` property\n\n- Type: `number`\n- Optional\n- Defaults to `50`\n- The delay in milliseconds before intent focus/hover and viewport preloading. Touch intent preloads immediately.\n\n### `defaultComponent` property\n\n- Type: `RouteComponent`\n- Optional\n- Defaults to `Outlet`\n- The default `component` a route should use if no component is provided.\n\n### `defaultErrorComponent` property\n\n- Type: `RouteComponent`\n- Optional\n- Defaults to `ErrorComponent`\n- The default `errorComponent` a route should use if no error component is provided.\n\n### `defaultNotFoundComponent` property\n\n- Type: `NotFoundRouteComponent`\n- Optional\n- Defaults to `NotFound`\n- The default `notFoundComponent` a route should use if no notFound component is provided.\n\n### `defaultPendingComponent` property\n\n- Type: `RouteComponent`\n- Optional\n- The default `pendingComponent` a route should use if no pending component is provided.\n\n### `defaultPendingMs` property\n\n- Type: `number`\n- Optional\n- Defaults to `1000`\n- The default `pendingMs` a route should use if no pendingMs is provided.\n\n### `defaultPendingMinMs` property\n\n- Type: `number`\n- Optional\n- Defaults to `500`\n- The default `pendingMinMs` a route should use if no pendingMinMs is provided.\n\n### `defaultStaleTime` property\n\n- Type: `number`\n- Optional\n- Defaults to `0`\n- The default `staleTime` a route should use if no staleTime is provided.\n\n### `defaultStaleReloadMode` property\n\n- Type: `'background' | 'blocking'`\n- Optional\n- Defaults to `'background'`\n- Controls how stale successful loader data is revalidated by default.\n- `'background'` preserves stale-while-revalidate behavior.\n- `'blocking'` waits for the stale loader reload to finish before navigation resolves.\n\n### `defaultPreloadStaleTime` property\n\n- Type: `number`\n- Optional\n- Defaults to `30_000` ms (30 seconds)\n- The default `preloadStaleTime` a route should use if no preloadStaleTime is provided.\n\n### `defaultPreloadGcTime` property\n\n- Type: `number`\n- Optional\n- Defaults to 5 minutes.\n- The default `preloadGcTime` a route should use if no preloadGcTime is provided.\n\n### `defaultGcTime` property\n\n- Type: `number`\n- Optional\n- Defaults to 5 minutes.\n- The default `gcTime` a route should use if no gcTime is provided.\n\n### `defaultOnCatch` property\n\n- Type: `(error: unknown, errorInfo: ErrorInfo) => void`\n- Optional\n- The default `onCatch` handler for errors caught by the Router ErrorBoundary\n\n### `disableGlobalCatchBoundary` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- When `true`, disables the global catch boundary that normally wraps all route matches. This allows unhandled errors to bubble up to top-level error handlers in the browser.\n- Useful for testing tools, error reporting services, and debugging scenarios.\n\n### `protocolAllowlist` property\n\n- Type: `Array<string>`\n- Optional\n- Defaults to `DEFAULT_PROTOCOL_ALLOWLIST` which includes:\n  - Web navigation: `http:`, `https:`\n  - Common browser-safe actions: `mailto:`, `tel:`\n- An array of URL protocols that are allowed in links, redirects, and navigation. Absolute URLs with protocols not in this list are rejected to prevent security vulnerabilities like XSS attacks.\n- This check is applied across router navigation APIs, including:\n  - `<Link to=\"...\">`\n  - `navigate({ to: ... })` and `navigate({ href: ... })`\n  - `redirect({ to: ... })` and `redirect({ href: ... })`\n- Protocol entries must match `URL.protocol` format (lowercase with a trailing `:`), for example `blob:` or `data:`. If you configure `protocolAllowlist: ['blob']` (without `:`), links using `blob:` will still be blocked.\n\n**Example**\n\n```tsx\nimport {\n  createRouter,\n  DEFAULT_PROTOCOL_ALLOWLIST,\n} from '@tanstack/react-router'\n\n// Use a custom allowlist (replaces the default)\nconst router = createRouter({\n  routeTree,\n  protocolAllowlist: ['https:', 'mailto:'],\n})\n\n// Or extend the default allowlist\nconst router = createRouter({\n  routeTree,\n  protocolAllowlist: [...DEFAULT_PROTOCOL_ALLOWLIST, 'ftp:'],\n})\n```\n\n### `defaultViewTransition` property\n\n- Type: `boolean | ViewTransitionOptions`\n- Optional\n- If `true`, route navigations will be called using `document.startViewTransition()`.\n- If [`ViewTransitionOptions`](./ViewTransitionOptionsType.md), route navigations will be called using `document.startViewTransition({update, types})`\n  where `types` will be the strings array passed with `ViewTransitionOptions[\"types\"]`. If the browser does not support viewTransition types,\n  the navigation will fall back to normal `document.startTransition()`, same as if `true` was passed.\n- If the browser does not support this api, this option will be ignored.\n- See [MDN](https://developer.mozilla.org/en-US/docs/Web/API/Document/startViewTransition) for more information on how this function works.\n- See [Google](https://developer.chrome.com/docs/web-platform/view-transitions/same-document#view-transition-types) for more information on viewTransition types\n\n### `defaultHashScrollIntoView` property\n\n- Type: `boolean | ScrollIntoViewOptions`\n- Optional\n- Defaults to `true` so the element with an id matching the hash will be scrolled into view after the location is committed to history.\n- If `false`, the element with an id matching the hash will not be scrolled into view after the location is committed to history.\n- If an object is provided, it will be passed to the `scrollIntoView` method as options.\n- See [MDN](https://developer.mozilla.org/en-US/docs/Web/API/Element/scrollIntoView) for more information on `ScrollIntoViewOptions`.\n\n### `caseSensitive` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- If `true`, all routes will be matched as case-sensitive.\n\n### `basepath` property\n\n- Type: `string`\n- Optional\n- Defaults to `/`\n- The basepath for the entire router. This is useful for mounting a router instance at a subpath.\n\n### `origin` property\n\n- Type: `string`\n- Optional\n- The origin used to resolve URLs. Defaults to the browser origin, or `http://localhost` on the server and in browsers with an opaque origin.\n- Pass a normalized origin, such as `https://example.com` or `http://localhost:3000`, without a path or trailing slash. The router uses this value as provided; if you have a full URL, normalize it with `new URL(url).origin` before passing it to the router.\n\n### `rewrite` property\n\n- Type: `LocationRewrite`\n- Optional\n- Configures bidirectional URL transformation between the browser URL and the router's internal URL.\n- See the [URL Rewrites guide](../../guide/url-rewrites.md) for detailed usage and patterns.\n\nThe `LocationRewrite` type has the following shape:\n\n```tsx\ntype LocationRewrite = {\n  input?: LocationRewriteFunction\n  output?: LocationRewriteFunction\n}\n\ntype LocationRewriteFunction = (opts: { url: URL }) => undefined | string | URL\n```\n\n- `input`: Transforms the URL before the router interprets it (browser → router)\n- `output`: Transforms the URL before it's written to browser history (router → browser)\n\n**Example**\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  routeTree,\n  rewrite: {\n    input: ({ url }) => {\n      // Strip locale prefix: /en/about → /about\n      if (url.pathname.startsWith('/en')) {\n        url.pathname = url.pathname.replace(/^\\/en/, '') || '/'\n      }\n      return url\n    },\n    output: ({ url }) => {\n      // Add locale prefix: /about → /en/about\n      url.pathname = `/en${url.pathname === '/' ? '' : url.pathname}`\n      return url\n    },\n  },\n})\n```\n\nWhen both `basepath` and `rewrite` are configured, they are automatically composed. The basepath rewrite runs first on input (stripping the basepath) and last on output (adding it back).\n\n### `context` property\n\n- Type: `any`\n- Optional or required if the root route was created with [`createRootRouteWithContext()`](./createRootRouteWithContextFunction.md).\n- The root context that will be provided to all routes in the route tree. This can be used to provide a context to all routes in the tree without having to provide it to each route individually.\n\n### `dehydrate` method\n\n- Type: `() => TDehydrated`\n- Optional\n- A function that will be called when the router is dehydrated. The return value of this function will be serialized and stored in the router's dehydrated state.\n\n### `hydrate` method\n\n- Type: `(dehydrated: TDehydrated) => void`\n- Optional\n- A function that will be called when the router is hydrated. The return value of this function will be serialized and stored in the router's dehydrated state.\n\n### `routeMasks` property\n\n- Type: `RouteMask[]`\n- Optional\n- An array of route masks that will be used to mask routes in the route tree. Route masking is when you display a route at a different path than the one it is configured to match, like a modal popup that when shared will unmask to the modal's content instead of the modal's context.\n\n### `unmaskOnReload` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- If `true`, route masks will, by default, be removed when the page is reloaded. This can be overridden on a per-mask basis by setting `unmaskOnReload` on the mask, or on a per-navigation basis by setting `mask.unmaskOnReload` in [`NavigateOptions`](./NavigateOptionsType.md).\n\n### `Wrap` property\n\n- Type: `React.Component`\n- Optional\n- A component that will be used to wrap the entire router. This is useful for providing a context to the entire router. Only non-DOM-rendering components like providers should be used, anything else will cause a hydration error.\n\n**Example**\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  Wrap: ({ children }) => {\n    return <MyContext.Provider value={myContext}>{children}</MyContext>\n  },\n})\n```\n\n### `InnerWrap` property\n\n- Type: `React.Component`\n- Optional\n- A component that will be used to wrap the inner contents of the router. This is useful for providing a context to the inner contents of the router where you also need access to the router context and hooks. Only non-DOM-rendering components like providers should be used, anything else will cause a hydration error.\n\n**Example**\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  InnerWrap: ({ children }) => {\n    const routerState = useRouterState()\n\n    return (\n      <MyContext.Provider value={myContext}>\n        {children}\n      </MyContext>\n    )\n  },\n})\n```\n\n### `notFoundMode` property\n\n- Type: `'root' | 'fuzzy'`\n- Optional\n- Defaults to `'fuzzy'`\n- This property controls how TanStack Router will handle scenarios where it cannot find a route to match the current location. See the [Not Found Errors guide](../../guide/not-found-errors.md) for more information.\n\n### `notFoundRoute` property\n\n- **Deprecated**\n- Type: `NotFoundRoute`\n- Optional\n- A route that will be used as the default not found route for every branch of the route tree. This can be overridden on a per-branch basis by providing a not found route to the `NotFoundRoute` option on the root route of the branch.\n\n### `trailingSlash` property\n\n- Type: `'always' | 'never' | 'preserve'`\n- Optional\n- Defaults to `never`\n- Configures how trailing slashes are treated. `'always'` will add a trailing slash if not present, `'never'` will remove the trailing slash if present and `'preserve'` will not modify the trailing slash.\n\n### `pathParamsAllowedCharacters` property\n\n- Type: `ReadonlyArray<';' | ':' | '@' | '&' | '=' | '+' | '$' | ','>`\n- Optional\n- Configures which URI characters are allowed in path params that would ordinarily be escaped by encodeURIComponent.\n- Read only when the router is created. To change these characters, create a new router instance. Router option updates and provider props do not change this setting.\n\n### `defaultStructuralSharing` property\n\n- Type: `boolean`\n- Optional\n- Defaults to `false`\n- Configures whether structural sharing is enabled by default for fine-grained selectors.\n- See the [Render Optimizations guide](../../guide/render-optimizations.md) for more information.\n\n### `defaultRemountDeps` property\n\n- Type:\n\n```tsx\ntype defaultRemountDeps = (opts: RemountDepsOptions) => any\n\ninterface RemountDepsOptions<\n  in out TRouteId,\n  in out TFullSearchSchema,\n  in out TAllParams,\n  in out TLoaderDeps,\n> {\n  routeId: TRouteId\n  search: TFullSearchSchema\n  params: TAllParams\n  loaderDeps: TLoaderDeps\n}\n```\n\n- Optional\n- A default function that will be called to determine whether a route component shall be remounted after navigation. If this function returns a different value than previously, it will remount.\n- The return value needs to be JSON serializable.\n- By default, a route component will not be remounted if it stays active after a navigation\n\nExample:  \nIf you want to configure to remount all route components upon `params` change, use:\n\n```tsx\nremountDeps: ({ params }) => params\n```\n"}
