NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"ClientOnly"},{"type":"text","value":" component is used to render a component only in the client, without breaking the server-side rendering due to hydration errors. It accepts a "},{"type":"inlineCode","value":"fallback"},{"type":"text","value":" prop that will be rendered if the JS is not yet loaded in the client."}]},{"type":"heading","depth":2,"id":"props","children":[{"type":"text","value":"Props"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"ClientOnly"},{"type":"text","value":" component accepts the following props:"}]},{"type":"heading","depth":3,"id":"props-fallback-prop","children":[{"type":"inlineCode","value":"props.fallback"},{"type":"text","value":" prop"}]},{"type":"paragraph","children":[{"type":"text","value":"The fallback component to render if the JS is not yet loaded in the client."}]},{"type":"heading","depth":3,"id":"props-children-prop","children":[{"type":"inlineCode","value":"props.children"},{"type":"text","value":" prop"}]},{"type":"paragraph","children":[{"type":"text","value":"The component to render if the JS is loaded in the client."}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Returns the component's children if the JS is loaded in the client."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Returns the "},{"type":"inlineCode","value":"fallback"},{"type":"text","value":" component if the JS is not yet loaded in the client."}]}]}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"// src/routes/dashboard.tsx\nimport { ClientOnly, createFileRoute } from '@tanstack/react-router'\nimport {\n  Charts,\n  FallbackCharts,\n} from './charts-that-break-server-side-rendering'\n\nexport const Route = createFileRoute('/dashboard')({\n  component: Dashboard,\n  // ... other route options\n})\n\nfunction Dashboard() {\n  return (\n    <div>\n      <p>Dashboard</p>\n      <ClientOnly fallback={<FallbackCharts />}>\n        <Charts />\n      </ClientOnly>\n    </div>\n  )\n}","lang":"tsx"}],"headings":[{"id":"props","text":"Props","level":2},{"id":"props-fallback-prop","text":"props.fallback prop","level":3},{"id":"props-children-prop","text":"props.children prop","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe `ClientOnly` component is used to render a component only in the client, without breaking the server-side rendering due to hydration errors. It accepts a `fallback` prop that will be rendered if the JS is not yet loaded in the client.\n\n## Props\n\nThe `ClientOnly` component accepts the following props:\n\n### `props.fallback` prop\n\nThe fallback component to render if the JS is not yet loaded in the client.\n\n### `props.children` prop\n\nThe component to render if the JS is loaded in the client.\n\n## Returns\n\n- Returns the component's children if the JS is loaded in the client.\n- Returns the `fallback` component if the JS is not yet loaded in the client.\n\n## Examples\n\n```tsx\n// src/routes/dashboard.tsx\nimport { ClientOnly, createFileRoute } from '@tanstack/react-router'\nimport {\n  Charts,\n  FallbackCharts,\n} from './charts-that-break-server-side-rendering'\n\nexport const Route = createFileRoute('/dashboard')({\n  component: Dashboard,\n  // ... other route options\n})\n\nfunction Dashboard() {\n  return (\n    <div>\n      <p>Dashboard</p>\n      <ClientOnly fallback={<FallbackCharts />}>\n        <Charts />\n      </ClientOnly>\n    </div>\n  )\n}\n```\n","originalRawMarkdown":"---\nid: clientOnlyComponent\ntitle: ClientOnly Component\n---\n\nThe `ClientOnly` component is used to render a component only in the client, without breaking the server-side rendering due to hydration errors. It accepts a `fallback` prop that will be rendered if the JS is not yet loaded in the client.\n\n## Props\n\nThe `ClientOnly` component accepts the following props:\n\n### `props.fallback` prop\n\nThe fallback component to render if the JS is not yet loaded in the client.\n\n### `props.children` prop\n\nThe component to render if the JS is loaded in the client.\n\n## Returns\n\n- Returns the component's children if the JS is loaded in the client.\n- Returns the `fallback` component if the JS is not yet loaded in the client.\n\n## Examples\n\n```tsx\n// src/routes/dashboard.tsx\nimport { ClientOnly, createFileRoute } from '@tanstack/react-router'\nimport {\n  Charts,\n  FallbackCharts,\n} from './charts-that-break-server-side-rendering'\n\nexport const Route = createFileRoute('/dashboard')({\n  component: Dashboard,\n  // ... other route options\n})\n\nfunction Dashboard() {\n  return (\n    <div>\n      <p>Dashboard</p>\n      <ClientOnly fallback={<FallbackCharts />}>\n        <Charts />\n      </ClientOnly>\n    </div>\n  )\n}\n```\n"}
