{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"getRouteApi"},{"type":"text","value":" function provides type-safe version of common hooks like "},{"type":"inlineCode","value":"useParams"},{"type":"text","value":", "},{"type":"inlineCode","value":"useSearch"},{"type":"text","value":", "},{"type":"inlineCode","value":"useRouteContext"},{"type":"text","value":", "},{"type":"inlineCode","value":"useNavigate"},{"type":"text","value":", "},{"type":"inlineCode","value":"useLoaderData"},{"type":"text","value":", and "},{"type":"inlineCode","value":"useLoaderDeps"},{"type":"text","value":" that are pre-bound to a specific route ID and corresponding registered route types."}]},{"type":"heading","depth":2,"id":"getrouteapi-options","children":[{"type":"text","value":"getRouteApi options"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"getRouteApi"},{"type":"text","value":" function accepts a single argument, a "},{"type":"inlineCode","value":"routeId"},{"type":"text","value":" string literal."}]},{"type":"heading","depth":3,"id":"routeid-option","children":[{"type":"inlineCode","value":"routeId"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"string"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Required"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The route ID to which the "},{"type":"link","href":"./RouteApiClass.md","children":[{"type":"inlineCode","value":"RouteApi"}]},{"type":"text","value":" instance will be bound"}]}]}]},{"type":"heading","depth":2,"id":"getrouteapi-returns","children":[{"type":"text","value":"getRouteApi returns"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"An instance of the "},{"type":"link","href":"./RouteApiType.md","children":[{"type":"inlineCode","value":"RouteApi"}]},{"type":"text","value":" that is pre-bound to the route ID that the "},{"type":"inlineCode","value":"getRouteApi"},{"type":"text","value":" function was called with."}]}]}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { getRouteApi } from '@tanstack/react-router'\n\nconst routeApi = getRouteApi('/posts')\n\nexport function PostsPage() {\n  const posts = routeApi.useLoaderData()\n  // ...\n}","lang":"tsx"}],"headings":[{"id":"getrouteapi-options","text":"getRouteApi options","level":2},{"id":"routeid-option","text":"routeId option","level":3},{"id":"getrouteapi-returns","text":"getRouteApi returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe `getRouteApi` function provides type-safe version of common hooks like `useParams`, `useSearch`, `useRouteContext`, `useNavigate`, `useLoaderData`, and `useLoaderDeps` that are pre-bound to a specific route ID and corresponding registered route types.\n\n## getRouteApi options\n\nThe `getRouteApi` function accepts a single argument, a `routeId` string literal.\n\n### `routeId` option\n\n- Type: `string`\n- Required\n- The route ID to which the [`RouteApi`](./RouteApiClass.md) instance will be bound\n\n## getRouteApi returns\n\n- An instance of the [`RouteApi`](./RouteApiType.md) that is pre-bound to the route ID that the `getRouteApi` function was called with.\n\n## Examples\n\n```tsx\nimport { getRouteApi } from '@tanstack/react-router'\n\nconst routeApi = getRouteApi('/posts')\n\nexport function PostsPage() {\n  const posts = routeApi.useLoaderData()\n  // ...\n}\n```\n","originalRawMarkdown":"---\nid: getRouteApiFunction\ntitle: getRouteApi function\n---\n\nThe `getRouteApi` function provides type-safe version of common hooks like `useParams`, `useSearch`, `useRouteContext`, `useNavigate`, `useLoaderData`, and `useLoaderDeps` that are pre-bound to a specific route ID and corresponding registered route types.\n\n## getRouteApi options\n\nThe `getRouteApi` function accepts a single argument, a `routeId` string literal.\n\n### `routeId` option\n\n- Type: `string`\n- Required\n- The route ID to which the [`RouteApi`](./RouteApiClass.md) instance will be bound\n\n## getRouteApi returns\n\n- An instance of the [`RouteApi`](./RouteApiType.md) that is pre-bound to the route ID that the `getRouteApi` function was called with.\n\n## Examples\n\n```tsx\nimport { getRouteApi } from '@tanstack/react-router'\n\nconst routeApi = getRouteApi('/posts')\n\nexport function PostsPage() {\n  const posts = routeApi.useLoaderData()\n  // ...\n}\n```\n"}
