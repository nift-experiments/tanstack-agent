{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"redirect"},{"type":"text","value":" function returns a new "},{"type":"inlineCode","value":"Redirect"},{"type":"text","value":" object that can be either returned or thrown from places like a Route's "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":" or "},{"type":"inlineCode","value":"loader"},{"type":"text","value":" callbacks to trigger "},{"type":"emphasis","children":[{"type":"text","value":"redirect"}]},{"type":"text","value":" to a new location."}]},{"type":"heading","depth":2,"id":"redirect-options","children":[{"type":"text","value":"redirect options"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"redirect"},{"type":"text","value":" function accepts a single argument, the "},{"type":"inlineCode","value":"options"},{"type":"text","value":" to determine the redirect behavior."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"link","href":"./RedirectType.md","children":[{"type":"inlineCode","value":"Redirect"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Required"}]}]}]},{"type":"heading","depth":2,"id":"redirect-returns","children":[{"type":"text","value":"redirect returns"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If the "},{"type":"inlineCode","value":"throw"},{"type":"text","value":" property is "},{"type":"inlineCode","value":"true"},{"type":"text","value":" in the "},{"type":"inlineCode","value":"options"},{"type":"text","value":" object, the "},{"type":"inlineCode","value":"Redirect"},{"type":"text","value":" object will be thrown from within the function call."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If the "},{"type":"inlineCode","value":"throw"},{"type":"text","value":" property is "},{"type":"inlineCode","value":"false | undefined"},{"type":"text","value":" in the "},{"type":"inlineCode","value":"options"},{"type":"text","value":" object, the "},{"type":"inlineCode","value":"Redirect"},{"type":"text","value":" object will be returned."}]}]}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"heading","depth":3,"id":"using-the-standalone-redirect-function","children":[{"type":"text","value":"Using the standalone "},{"type":"inlineCode","value":"redirect"},{"type":"text","value":" function"}]},{"type":"code","value":"import { redirect } from '@tanstack/react-router'\n\nconst route = createRoute({\n  // throwing an internal redirect object using 'to' property\n  loader: () => {\n    if (!user) {\n      throw redirect({\n        to: '/login',\n      })\n    }\n  },\n  // throwing an external redirect object using 'href' property\n  loader: () => {\n    if (needsExternalAuth) {\n      throw redirect({\n        href: 'https://authprovider.com/login',\n      })\n    }\n  },\n  // or forcing `redirect` to throw itself\n  loader: () => {\n    if (!user) {\n      redirect({\n        to: '/login',\n        throw: true,\n      })\n    }\n  },\n  // ... other route options\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"using-route-redirect-file-based-routes","children":[{"type":"text","value":"Using Route.redirect (File-Based Routes)"}]},{"type":"paragraph","children":[{"type":"text","value":"When using file-based routing with "},{"type":"inlineCode","value":"createFileRoute"},{"type":"text","value":", you can use the "},{"type":"inlineCode","value":"Route.redirect"},{"type":"text","value":" method directly. This method automatically sets the "},{"type":"inlineCode","value":"from"},{"type":"text","value":" parameter based on the route's path, enabling type-safe relative redirects without manually specifying the origin route:"}]},{"type":"code","value":"// In routes/dashboard/settings.tsx\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/dashboard/settings')({\n  beforeLoad: ({ context }) => {\n    if (!context.user) {\n      // Relative redirect - automatically knows we're redirecting from '/dashboard/settings'\n      throw Route.redirect({\n        to: '../login', // Redirects to '/dashboard/login'\n      })\n    }\n  },\n  loader: () => {\n    // Also works in loader\n    if (needsMigration) {\n      throw Route.redirect({\n        to: './migrate', // Redirects to '/dashboard/settings/migrate'\n      })\n    }\n  },\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"using-getrouteapi-redirect","children":[{"type":"text","value":"Using getRouteApi().redirect"}]},{"type":"paragraph","children":[{"type":"text","value":"For accessing the redirect method outside of the route definition file, you can use "},{"type":"inlineCode","value":"getRouteApi"},{"type":"text","value":":"}]},{"type":"code","value":"import { getRouteApi } from '@tanstack/react-router'\n\nconst routeApi = getRouteApi('/dashboard/settings')\n\n// In a beforeLoad or loader callback\nfunction checkAuth() {\n  if (!user) {\n    // Type-safe redirect with automatic 'from' parameter\n    throw routeApi.redirect({\n      to: '../login',\n    })\n  }\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"benefits-of-route-bound-redirect","children":[{"type":"text","value":"Benefits of Route-Bound Redirect"}]},{"type":"paragraph","children":[{"type":"text","value":"Using "},{"type":"inlineCode","value":"Route.redirect"},{"type":"text","value":" or "},{"type":"inlineCode","value":"getRouteApi().redirect"},{"type":"text","value":" instead of the standalone "},{"type":"inlineCode","value":"redirect"},{"type":"text","value":" function offers several advantages:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"No need to specify "},{"type":"inlineCode","value":"from"}]},{"type":"text","value":": The route path is automatically used as the origin"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Type-safe relative paths"}]},{"type":"text","value":": TypeScript validates that relative paths like "},{"type":"inlineCode","value":"../sibling"},{"type":"text","value":" or "},{"type":"inlineCode","value":"./child"},{"type":"text","value":" resolve to valid routes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Refactoring-friendly"}]},{"type":"text","value":": If the route path changes, the redirect origin updates automatically"}]}]}]}],"headings":[{"id":"redirect-options","text":"redirect options","level":2},{"id":"redirect-returns","text":"redirect returns","level":2},{"id":"examples","text":"Examples","level":2},{"id":"using-the-standalone-redirect-function","text":"Using the standalone redirect function","level":3},{"id":"using-route-redirect-file-based-routes","text":"Using Route.redirect (File-Based Routes)","level":3},{"id":"using-getrouteapi-redirect","text":"Using getRouteApi().redirect","level":3},{"id":"benefits-of-route-bound-redirect","text":"Benefits of Route-Bound Redirect","level":3}]},"frameworks":[],"downloadMarkdown":"\nThe `redirect` function returns a new `Redirect` object that can be either returned or thrown from places like a Route's `beforeLoad` or `loader` callbacks to trigger _redirect_ to a new location.\n\n## redirect options\n\nThe `redirect` function accepts a single argument, the `options` to determine the redirect behavior.\n\n- Type: [`Redirect`](./RedirectType.md)\n- Required\n\n## redirect returns\n\n- If the `throw` property is `true` in the `options` object, the `Redirect` object will be thrown from within the function call.\n- If the `throw` property is `false | undefined` in the `options` object, the `Redirect` object will be returned.\n\n## Examples\n\n### Using the standalone `redirect` function\n\n```tsx\nimport { redirect } from '@tanstack/react-router'\n\nconst route = createRoute({\n  // throwing an internal redirect object using 'to' property\n  loader: () => {\n    if (!user) {\n      throw redirect({\n        to: '/login',\n      })\n    }\n  },\n  // throwing an external redirect object using 'href' property\n  loader: () => {\n    if (needsExternalAuth) {\n      throw redirect({\n        href: 'https://authprovider.com/login',\n      })\n    }\n  },\n  // or forcing `redirect` to throw itself\n  loader: () => {\n    if (!user) {\n      redirect({\n        to: '/login',\n        throw: true,\n      })\n    }\n  },\n  // ... other route options\n})\n```\n\n### Using Route.redirect (File-Based Routes)\n\nWhen using file-based routing with `createFileRoute`, you can use the `Route.redirect` method directly. This method automatically sets the `from` parameter based on the route's path, enabling type-safe relative redirects without manually specifying the origin route:\n\n```tsx\n// In routes/dashboard/settings.tsx\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/dashboard/settings')({\n  beforeLoad: ({ context }) => {\n    if (!context.user) {\n      // Relative redirect - automatically knows we're redirecting from '/dashboard/settings'\n      throw Route.redirect({\n        to: '../login', // Redirects to '/dashboard/login'\n      })\n    }\n  },\n  loader: () => {\n    // Also works in loader\n    if (needsMigration) {\n      throw Route.redirect({\n        to: './migrate', // Redirects to '/dashboard/settings/migrate'\n      })\n    }\n  },\n})\n```\n\n### Using getRouteApi().redirect\n\nFor accessing the redirect method outside of the route definition file, you can use `getRouteApi`:\n\n```tsx\nimport { getRouteApi } from '@tanstack/react-router'\n\nconst routeApi = getRouteApi('/dashboard/settings')\n\n// In a beforeLoad or loader callback\nfunction checkAuth() {\n  if (!user) {\n    // Type-safe redirect with automatic 'from' parameter\n    throw routeApi.redirect({\n      to: '../login',\n    })\n  }\n}\n```\n\n### Benefits of Route-Bound Redirect\n\nUsing `Route.redirect` or `getRouteApi().redirect` instead of the standalone `redirect` function offers several advantages:\n\n1. **No need to specify `from`**: The route path is automatically used as the origin\n2. **Type-safe relative paths**: TypeScript validates that relative paths like `../sibling` or `./child` resolve to valid routes\n3. **Refactoring-friendly**: If the route path changes, the redirect origin updates automatically\n","originalRawMarkdown":"---\nid: redirectFunction\ntitle: redirect function\n---\n\nThe `redirect` function returns a new `Redirect` object that can be either returned or thrown from places like a Route's `beforeLoad` or `loader` callbacks to trigger _redirect_ to a new location.\n\n## redirect options\n\nThe `redirect` function accepts a single argument, the `options` to determine the redirect behavior.\n\n- Type: [`Redirect`](./RedirectType.md)\n- Required\n\n## redirect returns\n\n- If the `throw` property is `true` in the `options` object, the `Redirect` object will be thrown from within the function call.\n- If the `throw` property is `false | undefined` in the `options` object, the `Redirect` object will be returned.\n\n## Examples\n\n### Using the standalone `redirect` function\n\n```tsx\nimport { redirect } from '@tanstack/react-router'\n\nconst route = createRoute({\n  // throwing an internal redirect object using 'to' property\n  loader: () => {\n    if (!user) {\n      throw redirect({\n        to: '/login',\n      })\n    }\n  },\n  // throwing an external redirect object using 'href' property\n  loader: () => {\n    if (needsExternalAuth) {\n      throw redirect({\n        href: 'https://authprovider.com/login',\n      })\n    }\n  },\n  // or forcing `redirect` to throw itself\n  loader: () => {\n    if (!user) {\n      redirect({\n        to: '/login',\n        throw: true,\n      })\n    }\n  },\n  // ... other route options\n})\n```\n\n### Using Route.redirect (File-Based Routes)\n\nWhen using file-based routing with `createFileRoute`, you can use the `Route.redirect` method directly. This method automatically sets the `from` parameter based on the route's path, enabling type-safe relative redirects without manually specifying the origin route:\n\n```tsx\n// In routes/dashboard/settings.tsx\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/dashboard/settings')({\n  beforeLoad: ({ context }) => {\n    if (!context.user) {\n      // Relative redirect - automatically knows we're redirecting from '/dashboard/settings'\n      throw Route.redirect({\n        to: '../login', // Redirects to '/dashboard/login'\n      })\n    }\n  },\n  loader: () => {\n    // Also works in loader\n    if (needsMigration) {\n      throw Route.redirect({\n        to: './migrate', // Redirects to '/dashboard/settings/migrate'\n      })\n    }\n  },\n})\n```\n\n### Using getRouteApi().redirect\n\nFor accessing the redirect method outside of the route definition file, you can use `getRouteApi`:\n\n```tsx\nimport { getRouteApi } from '@tanstack/react-router'\n\nconst routeApi = getRouteApi('/dashboard/settings')\n\n// In a beforeLoad or loader callback\nfunction checkAuth() {\n  if (!user) {\n    // Type-safe redirect with automatic 'from' parameter\n    throw routeApi.redirect({\n      to: '../login',\n    })\n  }\n}\n```\n\n### Benefits of Route-Bound Redirect\n\nUsing `Route.redirect` or `getRouteApi().redirect` instead of the standalone `redirect` function offers several advantages:\n\n1. **No need to specify `from`**: The route path is automatically used as the origin\n2. **Type-safe relative paths**: TypeScript validates that relative paths like `../sibling` or `./child` resolve to valid routes\n3. **Refactoring-friendly**: If the route path changes, the redirect origin updates automatically\n"}
