{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"retainSearchParams"},{"type":"text","value":" is a search middleware that allows to keep search params."}]},{"type":"heading","depth":2,"id":"retainsearchparams-props","children":[{"type":"text","value":"retainSearchParams props"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"retainSearchParams"},{"type":"text","value":" either accepts "},{"type":"inlineCode","value":"true"},{"type":"text","value":" or a list of keys of those search params that shall be retained.\nIf "},{"type":"inlineCode","value":"true"},{"type":"text","value":" is passed in, all search params will be retained."}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { z } from 'zod'\nimport { createRootRoute, retainSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  // Use the schema directly for Zod v4\n  validateSearch: searchSchema,\n  search: {\n    middlewares: [retainSearchParams(['rootValue'])],\n  },\n})","lang":"tsx"},{"type":"code","value":"import { z } from 'zod'\nimport { createFileRoute, retainSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  one: z.string().optional(),\n  two: z.string().optional(),\n})\n\nexport const Route = createFileRoute('/')({\n  // Use the schema directly for Zod v4\n  validateSearch: searchSchema,\n  search: {\n    middlewares: [retainSearchParams(true)],\n  },\n})","lang":"tsx"}],"headings":[{"id":"retainsearchparams-props","text":"retainSearchParams props","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n`retainSearchParams` is a search middleware that allows to keep search params.\n\n## retainSearchParams props\n\nThe `retainSearchParams` either accepts `true` or a list of keys of those search params that shall be retained.\nIf `true` is passed in, all search params will be retained.\n\n## Examples\n\n```tsx\nimport { z } from 'zod'\nimport { createRootRoute, retainSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  // Use the schema directly for Zod v4\n  validateSearch: searchSchema,\n  search: {\n    middlewares: [retainSearchParams(['rootValue'])],\n  },\n})\n```\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, retainSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  one: z.string().optional(),\n  two: z.string().optional(),\n})\n\nexport const Route = createFileRoute('/')({\n  // Use the schema directly for Zod v4\n  validateSearch: searchSchema,\n  search: {\n    middlewares: [retainSearchParams(true)],\n  },\n})\n```\n","originalRawMarkdown":"---\nid: retainSearchParams\ntitle: Search middleware to retain search params\n---\n\n`retainSearchParams` is a search middleware that allows to keep search params.\n\n## retainSearchParams props\n\nThe `retainSearchParams` either accepts `true` or a list of keys of those search params that shall be retained.\nIf `true` is passed in, all search params will be retained.\n\n## Examples\n\n```tsx\nimport { z } from 'zod'\nimport { createRootRoute, retainSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  // Use the schema directly for Zod v4\n  validateSearch: searchSchema,\n  search: {\n    middlewares: [retainSearchParams(['rootValue'])],\n  },\n})\n```\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, retainSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  one: z.string().optional(),\n  two: z.string().optional(),\n})\n\nexport const Route = createFileRoute('/')({\n  // Use the schema directly for Zod v4\n  validateSearch: searchSchema,\n  search: {\n    middlewares: [retainSearchParams(true)],\n  },\n})\n```\n"}
