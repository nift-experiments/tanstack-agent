{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"stripSearchParams"},{"type":"text","value":" is a search middleware that allows to remove search params."}]},{"type":"heading","depth":2,"id":"stripsearchparams-props","children":[{"type":"text","value":"stripSearchParams props"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"stripSearchParams"},{"type":"text","value":" accepts one of the following inputs:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"true"},{"type":"text","value":": if the search schema has no required params, "},{"type":"inlineCode","value":"true"},{"type":"text","value":" can be used to strip all search params"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"a list of keys of those search params that shall be removed; only keys of optional search params are allowed."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"an object that conforms to the partial input search schema. The search params are compared against the values of this object; if the value is deeply equal, it will be removed. This is especially useful to strip out default search params."}]}]}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\n\nconst defaultValues = {\n  one: 'abc',\n  two: 'xyz',\n}\n\nconst searchSchema = z.object({\n  one: z.string().default(defaultValues.one),\n  two: z.string().default(defaultValues.two),\n})\n\nexport const Route = createFileRoute('/')({\n  // for Zod v4, use the schema directly\n  validateSearch: searchSchema,\n  search: {\n    // strip default values\n    middlewares: [stripSearchParams(defaultValues)],\n  },\n})","lang":"tsx"},{"type":"code","value":"import { z } from 'zod'\nimport { createRootRoute, stripSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  hello: z.string().default('world'),\n  requiredParam: z.string(),\n})\n\nexport const Route = createRootRoute({\n  // for Zod v4, use the schema directly\n  validateSearch: searchSchema,\n  search: {\n    // always remove `hello`\n    middlewares: [stripSearchParams(['hello'])],\n  },\n})","lang":"tsx"},{"type":"code","value":"import { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  one: z.string().default('abc'),\n  two: z.string().default('xyz'),\n})\n\nexport const Route = createFileRoute('/')({\n  // for Zod v4, use the schema directly\n  validateSearch: searchSchema,\n  search: {\n    // remove all search params\n    middlewares: [stripSearchParams(true)],\n  },\n})","lang":"tsx"}],"headings":[{"id":"stripsearchparams-props","text":"stripSearchParams props","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n`stripSearchParams` is a search middleware that allows to remove search params.\n\n## stripSearchParams props\n\n`stripSearchParams` accepts one of the following inputs:\n\n- `true`: if the search schema has no required params, `true` can be used to strip all search params\n- a list of keys of those search params that shall be removed; only keys of optional search params are allowed.\n- an object that conforms to the partial input search schema. The search params are compared against the values of this object; if the value is deeply equal, it will be removed. This is especially useful to strip out default search params.\n\n## Examples\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\n\nconst defaultValues = {\n  one: 'abc',\n  two: 'xyz',\n}\n\nconst searchSchema = z.object({\n  one: z.string().default(defaultValues.one),\n  two: z.string().default(defaultValues.two),\n})\n\nexport const Route = createFileRoute('/')({\n  // for Zod v4, use the schema directly\n  validateSearch: searchSchema,\n  search: {\n    // strip default values\n    middlewares: [stripSearchParams(defaultValues)],\n  },\n})\n```\n\n```tsx\nimport { z } from 'zod'\nimport { createRootRoute, stripSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  hello: z.string().default('world'),\n  requiredParam: z.string(),\n})\n\nexport const Route = createRootRoute({\n  // for Zod v4, use the schema directly\n  validateSearch: searchSchema,\n  search: {\n    // always remove `hello`\n    middlewares: [stripSearchParams(['hello'])],\n  },\n})\n```\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  one: z.string().default('abc'),\n  two: z.string().default('xyz'),\n})\n\nexport const Route = createFileRoute('/')({\n  // for Zod v4, use the schema directly\n  validateSearch: searchSchema,\n  search: {\n    // remove all search params\n    middlewares: [stripSearchParams(true)],\n  },\n})\n```\n","originalRawMarkdown":"---\nid: stripSearchParams\ntitle: Search middleware to strip search params\n---\n\n`stripSearchParams` is a search middleware that allows to remove search params.\n\n## stripSearchParams props\n\n`stripSearchParams` accepts one of the following inputs:\n\n- `true`: if the search schema has no required params, `true` can be used to strip all search params\n- a list of keys of those search params that shall be removed; only keys of optional search params are allowed.\n- an object that conforms to the partial input search schema. The search params are compared against the values of this object; if the value is deeply equal, it will be removed. This is especially useful to strip out default search params.\n\n## Examples\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\n\nconst defaultValues = {\n  one: 'abc',\n  two: 'xyz',\n}\n\nconst searchSchema = z.object({\n  one: z.string().default(defaultValues.one),\n  two: z.string().default(defaultValues.two),\n})\n\nexport const Route = createFileRoute('/')({\n  // for Zod v4, use the schema directly\n  validateSearch: searchSchema,\n  search: {\n    // strip default values\n    middlewares: [stripSearchParams(defaultValues)],\n  },\n})\n```\n\n```tsx\nimport { z } from 'zod'\nimport { createRootRoute, stripSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  hello: z.string().default('world'),\n  requiredParam: z.string(),\n})\n\nexport const Route = createRootRoute({\n  // for Zod v4, use the schema directly\n  validateSearch: searchSchema,\n  search: {\n    // always remove `hello`\n    middlewares: [stripSearchParams(['hello'])],\n  },\n})\n```\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\n\nconst searchSchema = z.object({\n  one: z.string().default('abc'),\n  two: z.string().default('xyz'),\n})\n\nexport const Route = createFileRoute('/')({\n  // for Zod v4, use the schema directly\n  validateSearch: searchSchema,\n  search: {\n    // remove all search params\n    middlewares: [stripSearchParams(true)],\n  },\n})\n```\n"}
