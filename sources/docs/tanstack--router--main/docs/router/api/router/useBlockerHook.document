Code","value":"ShouldBlockFnArgs"},{"type":"text","value":" passed to it, which tells you information about the current and next route and the action performed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Think of this function as telling the router if it should block the navigation, so returning "},{"type":"inlineCode","value":"true"},{"type":"text","value":" mean that it should block the navigation and "},{"type":"inlineCode","value":"false"},{"type":"text","value":" meaning that it should be allowed"}]}]}]},{"type":"code","value":"type ShouldBlockFnLocation<...> = {\n  routeId: TRouteId\n  fullPath: TFullPath\n  pathname: string\n  params: TAllParams\n  search: TFullSearchSchema\n}\n\ntype ShouldBlockFnArgs = {\n  current: ShouldBlockFnLocation\n  next: ShouldBlockFnLocation\n  action: HistoryAction\n}","lang":"ts"},{"type":"heading","depth":3,"id":"options-disabled-option","children":[{"type":"inlineCode","value":"options.disabled"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional - defaults to "},{"type":"inlineCode","value":"false"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Specifies if the blocker should be entirely disabled or not"}]}]}]},{"type":"heading","depth":3,"id":"options-enablebeforeunload-option","children":[{"type":"inlineCode","value":"options.enableBeforeUnload"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional - defaults to "},{"type":"inlineCode","value":"true"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean | (() => boolean)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Tell the blocker to sometimes or always block the browser "},{"type":"inlineCode","value":"beforeUnload"},{"type":"text","value":" event or not"}]}]}]},{"type":"heading","depth":3,"id":"options-withresolver-option","children":[{"type":"inlineCode","value":"options.withResolver"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional - defaults to "},{"type":"inlineCode","value":"false"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Specify if the resolver returned by the hook should be used or whether your "},{"type":"inlineCode","value":"shouldBlockFn"},{"type":"text","value":" function itself resolves the blocking"}]}]}]},{"type":"heading","depth":3,"id":"options-blockerfn-option-deprecated","children":[{"type":"inlineCode","value":"options.blockerFn"},{"type":"text","value":" option (⚠️ deprecated)"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"BlockerFn"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The function that returns a "},{"type":"inlineCode","value":"boolean"},{"type":"text","value":" or "},{"type":"inlineCode","value":"Promise<boolean>"},{"type":"text","value":" indicating whether to allow navigation."}]}]}]},{"type":"heading","depth":3,"id":"options-condition-option-deprecated","children":[{"type":"inlineCode","value":"options.condition"},{"type":"text","value":" option (⚠️ deprecated)"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional - defaults to "},{"type":"inlineCode","value":"true"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"A navigation attempt is blocked when this condition is "},{"type":"inlineCode","value":"true"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":2,"id":"useblocker-returns","children":[{"type":"text","value":"useBlocker returns"}]},{"type":"paragraph","children":[{"type":"text","value":"An object with the controls to allow manual blocking and unblocking of navigation."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"status"},{"type":"text","value":" - A string literal that can be either "},{"type":"inlineCode","value":"'blocked'"},{"type":"text","value":" or "},{"type":"inlineCode","value":"'idle'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"next"},{"type":"text","value":" - When status is "},{"type":"inlineCode","value":"blocked"},{"type":"text","value":", a type narrrowable object that contains information about the next location"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"current"},{"type":"text","value":" - When status is "},{"type":"inlineCode","value":"blocked"},{"type":"text","value":", a type narrrowable object that contains information about the current location"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"action"},{"type":"text","value":" - When status is "},{"type":"inlineCode","value":"blocked"},{"type":"text","value":", a "},{"type":"inlineCode","value":"HistoryAction"},{"type":"text","value":" string that shows the action that triggered the navigation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"proceed"},{"type":"text","value":" - When status is "},{"type":"inlineCode","value":"blocked"},{"type":"text","value":", a function that allows navigation to continue"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"reset"},{"type":"text","value":" - When status is "},{"type":"inlineCode","value":"blocked"},{"type":"text","value":", a function that cancels navigation ("},{"type":"inlineCode","value":"status"},{"type":"text","value":" will be reset to "},{"type":"inlineCode","value":"'idle'"},{"type":"text","value":")"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"or"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"},{"type":"text","value":" when "},{"type":"inlineCode","value":"withResolver"},{"type":"text","value":" is "},{"type":"inlineCode","value":"false"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"paragraph","children":[{"type":"text","value":"Two common use cases for the "},{"type":"inlineCode","value":"useBlocker"},{"type":"text","value":" hook are:"}]},{"type":"heading","depth":3,"id":"basic-usage","children":[{"type":"text","value":"Basic usage"}]},{"type":"code","value":"import { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  useBlocker({\n    shouldBlockFn: () => formIsDirty,\n  })\n\n  // ...\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"custom-ui","children":[{"type":"text","value":"Custom UI"}]},{"type":"code","value":"import { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  const { proceed, reset, status, next } = useBlocker({\n    shouldBlockFn: () => formIsDirty,\n    withResolver: true,\n  })\n\n  // ...\n\n  return (\n    <>\n      {/* ... */}\n      {status === 'blocked' && (\n        <div>\n          <p>You are navigating to {next.pathname}</p>\n          <p>Are you sure you want to leave?</p>\n          <button onClick={proceed}>Yes</button>\n          <button onClick={reset}>No</button>\n        </div>\n      )}\n    </>\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"conditional-blocking","children":[{"type":"text","value":"Conditional blocking"}]},{"type":"code","value":"import { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const { proceed, reset, status } = useBlocker({\n    shouldBlockFn: ({ next }) => {\n      return !next.pathname.includes('step/')\n    },\n    withResolver: true,\n  })\n\n  // ...\n\n  return (\n    <>\n      {/* ... */}\n      {status === 'blocked' && (\n        <div>\n          <p>Are you sure you want to leave?</p>\n          <button onClick={proceed}>Yes</button>\n          <button onClick={reset}>No</button>\n        </div>\n      )}\n    </>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"without-resolver","children":[{"type":"text","value":"Without resolver"}]},{"type":"code","value":"import { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  useBlocker({\n    shouldBlockFn: ({ next }) => {\n      if (next.pathname.includes('step/')) {\n        return false\n      }\n\n      const shouldLeave = confirm('Are you sure you want to leave?')\n      return !shouldLeave\n    },\n  })\n\n  // ...\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"type-narrowing","children":[{"type":"text","value":"Type narrowing"}]},{"type":"code","value":"import { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  // block going from editor-1 to /foo/123?hello=world\n  const { proceed, reset, status } = useBlocker({\n    shouldBlockFn: ({ current, next }) => {\n      if (\n        current.routeId === '/editor-1' &&\n        next.fullPath === '/foo/$id' &&\n        next.params.id === '123' &&\n        next.search.hello === 'world'\n      ) {\n        return true\n      }\n      return false\n    },\n    enableBeforeUnload: false,\n    withResolver: true,\n  })\n\n  // ...\n}","lang":"tsx"}],"headings":[{"id":"useblocker-options","text":"useBlocker options","level":2},{"id":"options-shouldblockfn-option","text":"options.shouldBlockFn option","level":3},{"id":"options-disabled-option","text":"options.disabled option","level":3},{"id":"options-enablebeforeunload-option","text":"options.enableBeforeUnload option","level":3},{"id":"options-withresolver-option","text":"options.withResolver option","level":3},{"id":"options-blockerfn-option-deprecated","text":"options.blockerFn option (⚠️ deprecated)","level":3},{"id":"options-condition-option-deprecated","text":"options.condition option (⚠️ deprecated)","level":3},{"id":"useblocker-returns","text":"useBlocker returns","level":2},{"id":"examples","text":"Examples","level":2},{"id":"basic-usage","text":"Basic usage","level":3},{"id":"custom-ui","text":"Custom UI","level":3},{"id":"conditional-blocking","text":"Conditional blocking","level":3},{"id":"without-resolver","text":"Without resolver","level":3},{"id":"type-narrowing","text":"Type narrowing","level":3}]},"frameworks":[],"downloadMarkdown":"\nThe `useBlocker` method is a hook that [blocks navigation](../../guide/navigation-blocking.md) when a condition is met.\n\n> ⚠️ The following new `useBlocker` API is currently _experimental_.\n\n## useBlocker options\n\nThe `useBlocker` hook accepts a single _required_ argument, an option object:\n\n### `options.shouldBlockFn` option\n\n- Required\n- Type: `ShouldBlockFn`\n- This function should return a `boolean` or a `Promise<boolean>` that tells the blocker if it should block the current navigation\n- The function has the argument of type `ShouldBlockFnArgs` passed to it, which tells you information about the current and next route and the action performed\n- Think of this function as telling the router if it should block the navigation, so returning `true` mean that it should block the navigation and `false` meaning that it should be allowed\n\n```ts\ntype ShouldBlockFnLocation<...> = {\n  routeId: TRouteId\n  fullPath: TFullPath\n  pathname: string\n  params: TAllParams\n  search: TFullSearchSchema\n}\n\ntype ShouldBlockFnArgs = {\n  current: ShouldBlockFnLocation\n  next: ShouldBlockFnLocation\n  action: HistoryAction\n}\n```\n\n### `options.disabled` option\n\n- Optional - defaults to `false`\n- Type: `boolean`\n- Specifies if the blocker should be entirely disabled or not\n\n### `options.enableBeforeUnload` option\n\n- Optional - defaults to `true`\n- Type: `boolean | (() => boolean)`\n- Tell the blocker to sometimes or always block the browser `beforeUnload` event or not\n\n### `options.withResolver` option\n\n- Optional - defaults to `false`\n- Type: `boolean`\n- Specify if the resolver returned by the hook should be used or whether your `shouldBlockFn` function itself resolves the blocking\n\n### `options.blockerFn` option (⚠️ deprecated)\n\n- Optional\n- Type: `BlockerFn`\n- The function that returns a `boolean` or `Promise<boolean>` indicating whether to allow navigation.\n\n### `options.condition` option (⚠️ deprecated)\n\n- Optional - defaults to `true`\n- Type: `boolean`\n- A navigation attempt is blocked when this condition is `true`.\n\n## useBlocker returns\n\nAn object with the controls to allow manual blocking and unblocking of navigation.\n\n- `status` - A string literal that can be either `'blocked'` or `'idle'`\n- `next` - When status is `blocked`, a type narrrowable object that contains information about the next location\n- `current` - When status is `blocked`, a type narrrowable object that contains information about the current location\n- `action` - When status is `blocked`, a `HistoryAction` string that shows the action that triggered the navigation\n- `proceed` - When status is `blocked`, a function that allows navigation to continue\n- `reset` - When status is `blocked`, a function that cancels navigation (`status` will be reset to `'idle'`)\n\nor\n\n`void` when `withResolver` is `false`\n\n## Examples\n\nTwo common use cases for the `useBlocker` hook are:\n\n### Basic usage\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  useBlocker({\n    shouldBlockFn: () => formIsDirty,\n  })\n\n  // ...\n}\n```\n\n### Custom UI\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  const { proceed, reset, status, next } = useBlocker({\n    shouldBlockFn: () => formIsDirty,\n    withResolver: true,\n  })\n\n  // ...\n\n  return (\n    <>\n      {/* ... */}\n      {status === 'blocked' && (\n        <div>\n          <p>You are navigating to {next.pathname}</p>\n          <p>Are you sure you want to leave?</p>\n          <button onClick={proceed}>Yes</button>\n          <button onClick={reset}>No</button>\n        </div>\n      )}\n    </>\n}\n```\n\n### Conditional blocking\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const { proceed, reset, status } = useBlocker({\n    shouldBlockFn: ({ next }) => {\n      return !next.pathname.includes('step/')\n    },\n    withResolver: true,\n  })\n\n  // ...\n\n  return (\n    <>\n      {/* ... */}\n      {status === 'blocked' && (\n        <div>\n          <p>Are you sure you want to leave?</p>\n          <button onClick={proceed}>Yes</button>\n          <button onClick={reset}>No</button>\n        </div>\n      )}\n    </>\n  )\n}\n```\n\n### Without resolver\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  useBlocker({\n    shouldBlockFn: ({ next }) => {\n      if (next.pathname.includes('step/')) {\n        return false\n      }\n\n      const shouldLeave = confirm('Are you sure you want to leave?')\n      return !shouldLeave\n    },\n  })\n\n  // ...\n}\n```\n\n### Type narrowing\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  // block going from editor-1 to /foo/123?hello=world\n  const { proceed, reset, status } = useBlocker({\n    shouldBlockFn: ({ current, next }) => {\n      if (\n        current.routeId === '/editor-1' &&\n        next.fullPath === '/foo/$id' &&\n        next.params.id === '123' &&\n        next.search.hello === 'world'\n      ) {\n        return true\n      }\n      return false\n    },\n    enableBeforeUnload: false,\n    withResolver: true,\n  })\n\n  // ...\n}\n```\n","originalRawMarkdown":"---\nid: useBlockerHook\ntitle: useBlocker hook\n---\n\nThe `useBlocker` method is a hook that [blocks navigation](../../guide/navigation-blocking.md) when a condition is met.\n\n> ⚠️ The following new `useBlocker` API is currently _experimental_.\n\n## useBlocker options\n\nThe `useBlocker` hook accepts a single _required_ argument, an option object:\n\n### `options.shouldBlockFn` option\n\n- Required\n- Type: `ShouldBlockFn`\n- This function should return a `boolean` or a `Promise<boolean>` that tells the blocker if it should block the current navigation\n- The function has the argument of type `ShouldBlockFnArgs` passed to it, which tells you information about the current and next route and the action performed\n- Think of this function as telling the router if it should block the navigation, so returning `true` mean that it should block the navigation and `false` meaning that it should be allowed\n\n```ts\ntype ShouldBlockFnLocation<...> = {\n  routeId: TRouteId\n  fullPath: TFullPath\n  pathname: string\n  params: TAllParams\n  search: TFullSearchSchema\n}\n\ntype ShouldBlockFnArgs = {\n  current: ShouldBlockFnLocation\n  next: ShouldBlockFnLocation\n  action: HistoryAction\n}\n```\n\n### `options.disabled` option\n\n- Optional - defaults to `false`\n- Type: `boolean`\n- Specifies if the blocker should be entirely disabled or not\n\n### `options.enableBeforeUnload` option\n\n- Optional - defaults to `true`\n- Type: `boolean | (() => boolean)`\n- Tell the blocker to sometimes or always block the browser `beforeUnload` event or not\n\n### `options.withResolver` option\n\n- Optional - defaults to `false`\n- Type: `boolean`\n- Specify if the resolver returned by the hook should be used or whether your `shouldBlockFn` function itself resolves the blocking\n\n### `options.blockerFn` option (⚠️ deprecated)\n\n- Optional\n- Type: `BlockerFn`\n- The function that returns a `boolean` or `Promise<boolean>` indicating whether to allow navigation.\n\n### `options.condition` option (⚠️ deprecated)\n\n- Optional - defaults to `true`\n- Type: `boolean`\n- A navigation attempt is blocked when this condition is `true`.\n\n## useBlocker returns\n\nAn object with the controls to allow manual blocking and unblocking of navigation.\n\n- `status` - A string literal that can be either `'blocked'` or `'idle'`\n- `next` - When status is `blocked`, a type narrrowable object that contains information about the next location\n- `current` - When status is `blocked`, a type narrrowable object that contains information about the current location\n- `action` - When status is `blocked`, a `HistoryAction` string that shows the action that triggered the navigation\n- `proceed` - When status is `blocked`, a function that allows navigation to continue\n- `reset` - When status is `blocked`, a function that cancels navigation (`status` will be reset to `'idle'`)\n\nor\n\n`void` when `withResolver` is `false`\n\n## Examples\n\nTwo common use cases for the `useBlocker` hook are:\n\n### Basic usage\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  useBlocker({\n    shouldBlockFn: () => formIsDirty,\n  })\n\n  // ...\n}\n```\n\n### Custom UI\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  const { proceed, reset, status, next } = useBlocker({\n    shouldBlockFn: () => formIsDirty,\n    withResolver: true,\n  })\n\n  // ...\n\n  return (\n    <>\n      {/* ... */}\n      {status === 'blocked' && (\n        <div>\n          <p>You are navigating to {next.pathname}</p>\n          <p>Are you sure you want to leave?</p>\n          <button onClick={proceed}>Yes</button>\n          <button onClick={reset}>No</button>\n        </div>\n      )}\n    </>\n}\n```\n\n### Conditional blocking\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const { proceed, reset, status } = useBlocker({\n    shouldBlockFn: ({ next }) => {\n      return !next.pathname.includes('step/')\n    },\n    withResolver: true,\n  })\n\n  // ...\n\n  return (\n    <>\n      {/* ... */}\n      {status === 'blocked' && (\n        <div>\n          <p>Are you sure you want to leave?</p>\n          <button onClick={proceed}>Yes</button>\n          <button onClick={reset}>No</button>\n        </div>\n      )}\n    </>\n  )\n}\n```\n\n### Without resolver\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  useBlocker({\n    shouldBlockFn: ({ next }) => {\n      if (next.pathname.includes('step/')) {\n        return false\n      }\n\n      const shouldLeave = confirm('Are you sure you want to leave?')\n      return !shouldLeave\n    },\n  })\n\n  // ...\n}\n```\n\n### Type narrowing\n\n```tsx\nimport { useBlocker } from '@tanstack/react-router'\n\nfunction MyComponent() {\n  const [formIsDirty, setFormIsDirty] = useState(false)\n\n  // block going from editor-1 to /foo/123?hello=world\n  const { proceed, reset, status } = useBlocker({\n    shouldBlockFn: ({ current, next }) => {\n      if (\n        current.routeId === '/editor-1' &&\n        next.fullPath === '/foo/$id' &&\n        next.params.id === '123' &&\n        next.search.hello === 'world'\n      ) {\n        return true\n      }\n      return false\n    },\n    enableBeforeUnload: false,\n    withResolver: true,\n  })\n\n  // ...\n}\n```\n"}
