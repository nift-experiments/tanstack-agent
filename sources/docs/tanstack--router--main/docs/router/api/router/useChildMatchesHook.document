 will also be used to determine if the hook should re-render its parent component using shallow equality checks."}]}]}]},{"type":"heading","depth":3,"id":"opts-structuralsharing-option","children":[{"type":"inlineCode","value":"opts.structuralSharing"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Configures whether structural sharing is enabled for the value returned by "},{"type":"inlineCode","value":"select"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../../guide/render-optimizations.md","children":[{"type":"text","value":"Render Optimizations guide"}]},{"type":"text","value":" for more information."}]}]}]},{"type":"heading","depth":2,"id":"usechildmatches-returns","children":[{"type":"text","value":"useChildMatches returns"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function is provided, the return value of the "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If no "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function is provided, an array of "},{"type":"link","href":"./RouteMatchType.md","children":[{"type":"inlineCode","value":"RouteMatch"}]},{"type":"text","value":" objects."}]}]}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { useChildMatches } from '@tanstack/react-router'\n\nfunction Component() {\n  const childMatches = useChildMatches()\n  // ...\n}","lang":"tsx"}],"headings":[{"id":"usechildmatches-options","text":"useChildMatches options","level":2},{"id":"opts-select-option","text":"opts.select option","level":3},{"id":"opts-structuralsharing-option","text":"opts.structuralSharing option","level":3},{"id":"usechildmatches-returns","text":"useChildMatches returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe `useChildMatches` hook returns all of the child [`RouteMatch`](./RouteMatchType.md) objects from the closest match down to the leaf-most match. **It does not include the current match, which can be obtained using the `useMatch` hook.**\n\nThe result is derived from the router's current match presentation. It can\ninclude still-loading descendants and descendants below the current render\nboundary.\n\n## useChildMatches options\n\nThe `useChildMatches` hook accepts a single _optional_ argument, an `options` object.\n\n### `opts.select` option\n\n- Optional\n- `(matches: RouteMatch[]) => TSelected`\n- If supplied, this function will be called with the route matches and the return value will be returned from `useChildMatches`. This value will also be used to determine if the hook should re-render its parent component using shallow equality checks.\n\n### `opts.structuralSharing` option\n\n- Type: `boolean`\n- Optional\n- Configures whether structural sharing is enabled for the value returned by `select`.\n- See the [Render Optimizations guide](../../guide/render-optimizations.md) for more information.\n\n## useChildMatches returns\n\n- If a `select` function is provided, the return value of the `select` function.\n- If no `select` function is provided, an array of [`RouteMatch`](./RouteMatchType.md) objects.\n\n## Examples\n\n```tsx\nimport { useChildMatches } from '@tanstack/react-router'\n\nfunction Component() {\n  const childMatches = useChildMatches()\n  // ...\n}\n```\n","originalRawMarkdown":"---\nid: useChildMatchesHook\ntitle: useChildMatches hook\n---\n\nThe `useChildMatches` hook returns all of the child [`RouteMatch`](./RouteMatchType.md) objects from the closest match down to the leaf-most match. **It does not include the current match, which can be obtained using the `useMatch` hook.**\n\nThe result is derived from the router's current match presentation. It can\ninclude still-loading descendants and descendants below the current render\nboundary.\n\n## useChildMatches options\n\nThe `useChildMatches` hook accepts a single _optional_ argument, an `options` object.\n\n### `opts.select` option\n\n- Optional\n- `(matches: RouteMatch[]) => TSelected`\n- If supplied, this function will be called with the route matches and the return value will be returned from `useChildMatches`. This value will also be used to determine if the hook should re-render its parent component using shallow equality checks.\n\n### `opts.structuralSharing` option\n\n- Type: `boolean`\n- Optional\n- Configures whether structural sharing is enabled for the value returned by `select`.\n- See the [Render Optimizations guide](../../guide/render-optimizations.md) for more information.\n\n## useChildMatches returns\n\n- If a `select` function is provided, the return value of the `select` function.\n- If no `select` function is provided, an array of [`RouteMatch`](./RouteMatchType.md) objects.\n\n## Examples\n\n```tsx\nimport { useChildMatches } from '@tanstack/react-router'\n\nfunction Component() {\n  const childMatches = useChildMatches()\n  // ...\n}\n```\n"}
