"inlineCode","value":"opts.strict"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional - "},{"type":"inlineCode","value":"default: true"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"false"},{"type":"text","value":", the "},{"type":"inlineCode","value":"opts.from"},{"type":"text","value":" option will be ignored and types will be loosened to reflect the shared types of all possible loader data."}]}]}]},{"type":"heading","depth":3,"id":"opts-select-option","children":[{"type":"inlineCode","value":"opts.select"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"(loaderData: TLoaderData) => TSelected"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If supplied, this function will be called with the loader data and the return value will be returned from "},{"type":"inlineCode","value":"useLoaderData"},{"type":"text","value":". This value will also be used to determine if the hook should re-render its parent component using shallow equality checks."}]}]}]},{"type":"heading","depth":3,"id":"opts-structuralsharing-option","children":[{"type":"inlineCode","value":"opts.structuralSharing"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Configures whether structural sharing is enabled for the value returned by "},{"type":"inlineCode","value":"select"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../../guide/render-optimizations.md","children":[{"type":"text","value":"Render Optimizations guide"}]},{"type":"text","value":" for more information."}]}]}]},{"type":"heading","depth":2,"id":"useloaderdata-returns","children":[{"type":"text","value":"useLoaderData returns"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function is provided, the return value of the "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If no "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function is provided, the loader data or a loosened version of the loader data if "},{"type":"inlineCode","value":"opts.strict"},{"type":"text","value":" is "},{"type":"inlineCode","value":"false"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"import { useLoaderData } from '@tanstack/react-router'\n\nfunction Component() {\n  const loaderData = useLoaderData({ from: '/posts/$postId' })\n  //     ^? { postId: string, body: string, ... }\n  // ...\n}","lang":"tsx"}],"headings":[{"id":"useloaderdata-options","text":"useLoaderData options","level":2},{"id":"opts-from-option","text":"opts.from option","level":3},{"id":"opts-strict-option","text":"opts.strict option","level":3},{"id":"opts-select-option","text":"opts.select option","level":3},{"id":"opts-structuralsharing-option","text":"opts.structuralSharing option","level":3},{"id":"useloaderdata-returns","text":"useLoaderData returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\nThe `useLoaderData` hook returns the loader data from the closest [`RouteMatch`](./RouteMatchType.md) in the component tree.\n\n## useLoaderData options\n\nThe `useLoaderData` hook accepts an `options` object.\n\n### `opts.from` option\n\n- Type: `string`\n- The route id of the closest parent match\n- Optional, but recommended for full type safety.\n- If `opts.strict` is `true`, TypeScript will warn for this option if it is not provided.\n- If `opts.strict` is `false`, TypeScript will provide loosened types for the returned loader data.\n\n### `opts.strict` option\n\n- Type: `boolean`\n- Optional - `default: true`\n- If `false`, the `opts.from` option will be ignored and types will be loosened to reflect the shared types of all possible loader data.\n\n### `opts.select` option\n\n- Optional\n- `(loaderData: TLoaderData) => TSelected`\n- If supplied, this function will be called with the loader data and the return value will be returned from `useLoaderData`. This value will also be used to determine if the hook should re-render its parent component using shallow equality checks.\n\n### `opts.structuralSharing` option\n\n- Type: `boolean`\n- Optional\n- Configures whether structural sharing is enabled for the value returned by `select`.\n- See the [Render Optimizations guide](../../guide/render-optimizations.md) for more information.\n\n## useLoaderData returns\n\n- If a `select` function is provided, the return value of the `select` function.\n- If no `select` function is provided, the loader data or a loosened version of the loader data if `opts.strict` is `false`.\n\n## Examples\n\n```tsx\nimport { useLoaderData } from '@tanstack/react-router'\n\nfunction Component() {\n  const loaderData = useLoaderData({ from: '/posts/$postId' })\n  //     ^? { postId: string, body: string, ... }\n  // ...\n}\n```\n","originalRawMarkdown":"---\nid: useLoaderDataHook\ntitle: useLoaderData hook\n---\n\nThe `useLoaderData` hook returns the loader data from the closest [`RouteMatch`](./RouteMatchType.md) in the component tree.\n\n## useLoaderData options\n\nThe `useLoaderData` hook accepts an `options` object.\n\n### `opts.from` option\n\n- Type: `string`\n- The route id of the closest parent match\n- Optional, but recommended for full type safety.\n- If `opts.strict` is `true`, TypeScript will warn for this option if it is not provided.\n- If `opts.strict` is `false`, TypeScript will provide loosened types for the returned loader data.\n\n### `opts.strict` option\n\n- Type: `boolean`\n- Optional - `default: true`\n- If `false`, the `opts.from` option will be ignored and types will be loosened to reflect the shared types of all possible loader data.\n\n### `opts.select` option\n\n- Optional\n- `(loaderData: TLoaderData) => TSelected`\n- If supplied, this function will be called with the loader data and the return value will be returned from `useLoaderData`. This value will also be used to determine if the hook should re-render its parent component using shallow equality checks.\n\n### `opts.structuralSharing` option\n\n- Type: `boolean`\n- Optional\n- Configures whether structural sharing is enabled for the value returned by `select`.\n- See the [Render Optimizations guide](../../guide/render-optimizations.md) for more information.\n\n## useLoaderData returns\n\n- If a `select` function is provided, the return value of the `select` function.\n- If no `select` function is provided, the loader data or a loosened version of the loader data if `opts.strict` is `false`.\n\n## Examples\n\n```tsx\nimport { useLoaderData } from '@tanstack/react-router'\n\nfunction Component() {\n  const loaderData = useLoaderData({ from: '/posts/$postId' })\n  //     ^? { postId: string, body: string, ... }\n  // ...\n}\n```\n"}
