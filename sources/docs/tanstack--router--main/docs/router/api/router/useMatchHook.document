"type":"paragraph","children":[{"type":"text","value":"If supplied, this function will be called with the route match and the return value will be returned from "},{"type":"inlineCode","value":"useMatch"},{"type":"text","value":". This value will also be used to determine if the hook should re-render its parent component using shallow equality checks."}]}]}]},{"type":"heading","depth":3,"id":"opts-structuralsharing-option","children":[{"type":"inlineCode","value":"opts.structuralSharing"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Configures whether structural sharing is enabled for the value returned by "},{"type":"inlineCode","value":"select"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"../../guide/render-optimizations.md","children":[{"type":"text","value":"Render Optimizations guide"}]},{"type":"text","value":" for more information."}]}]}]},{"type":"heading","depth":3,"id":"opts-shouldthrow-option","children":[{"type":"inlineCode","value":"opts.shouldThrow"},{"type":"text","value":" option"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Type: "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Optional"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"default: true"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"false"},{"type":"text","value":","},{"type":"inlineCode","value":"useMatch"},{"type":"text","value":" will not throw an invariant exception in case a match was not found in the currently rendered matches; in this case, it will return "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":2,"id":"usematch-returns","children":[{"type":"text","value":"useMatch returns"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If a "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function is provided, the return value of the "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If no "},{"type":"inlineCode","value":"select"},{"type":"text","value":" function is provided, the "},{"type":"link","href":"./RouteMatchType.md","children":[{"type":"inlineCode","value":"RouteMatch"}]},{"type":"text","value":" object or a loosened version of the "},{"type":"inlineCode","value":"RouteMatch"},{"type":"text","value":" object if "},{"type":"inlineCode","value":"opts.strict"},{"type":"text","value":" is "},{"type":"inlineCode","value":"false"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"heading","depth":3,"id":"accessing-a-route-match","children":[{"type":"text","value":"Accessing a route match"}]},{"type":"code","value":"import { useMatch } from '@tanstack/react-router'\n\nfunction Component() {\n  const match = useMatch({ from: '/posts/$postId' })\n  //     ^? strict match for RouteMatch\n  // ...\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"accessing-the-root-route-s-match","children":[{"type":"text","value":"Accessing the root route's match"}]},{"type":"code","value":"import {\n  useMatch,\n  rootRouteId, // <<<< use this token!\n} from '@tanstack/react-router'\n\nfunction Component() {\n  const match = useMatch({ from: rootRouteId })\n  //     ^? strict match for RouteMatch\n  // ...\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"checking-if-a-specific-route-is-currently-rendered","children":[{"type":"text","value":"Checking if a specific route is currently rendered"}]},{"type":"code","value":"import { useMatch } from '@tanstack/react-router'\n\nfunction Component() {\n  const match = useMatch({ from: '/posts', shouldThrow: false })\n  //     ^? RouteMatch | undefined\n  if (match !== undefined) {\n    // ...\n  }\n}","lang":"tsx"}],"headings":[{"id":"usematch-options","text":"useMatch options","level":2},{"id":"opts-from-option","text":"opts.from option","level":3},{"id":"opts-strict-option","text":"opts.strict option","level":3},{"id":"opts-select-option","text":"opts.select option","level":3},{"id":"opts-structuralsharing-option","text":"opts.structuralSharing option","level":3},{"id":"opts-shouldthrow-option","text":"opts.shouldThrow option","level":3},{"id":"usematch-returns","text":"useMatch returns","level":2},{"id":"examples","text":"Examples","level":2},{"id":"accessing-a-route-match","text":"Accessing a route match","level":3},{"id":"accessing-the-root-route-s-match","text":"Accessing the root route's match","level":3},{"id":"checking-if-a-specific-route-is-currently-rendered","text":"Checking if a specific route is currently rendered","level":3}]},"frameworks":[],"downloadMarkdown":"\nThe `useMatch` hook returns a [`RouteMatch`](./RouteMatchType.md) in the component tree. The raw route match contains all of the information about a route match in the router and also powers many other hooks under the hood like `useParams`, `useLoaderData`, `useRouteContext`, and `useSearch`.\n\n## useMatch options\n\nThe `useMatch` hook accepts a single argument, an `options` object.\n\n### `opts.from` option\n\n- Type: `string`\n- The route id of a match\n- Optional, but recommended for full type safety.\n- If `opts.strict` is `true`, `from` is required and TypeScript will warn for this option if it is not provided.\n- If `opts.strict` is `false`, `from` must not be set and TypeScript will provided loosened types for the returned [`RouteMatch`](./RouteMatchType.md).\n\n### `opts.strict` option\n\n- Type: `boolean`\n- Optional\n- `default: true`\n- If `false`, the `opts.from` must not be set and types will be loosened to `Partial<RouteMatch>` to reflect the shared types of all matches.\n\n### `opts.select` option\n\n- Optional\n- `(match: RouteMatch) => TSelected`\n- If supplied, this function will be called with the route match and the return value will be returned from `useMatch`. This value will also be used to determine if the hook should re-render its parent component using shallow equality checks.\n\n### `opts.structuralSharing` option\n\n- Type: `boolean`\n- Optional\n- Configures whether structural sharing is enabled for the value returned by `select`.\n- See the [Render Optimizations guide](../../guide/render-optimizations.md) for more information.\n\n### `opts.shouldThrow` option\n\n- Type: `boolean`\n- Optional\n- `default: true`\n- If `false`,`useMatch` will not throw an invariant exception in case a match was not found in the currently rendered matches; in this case, it will return `undefined`.\n\n## useMatch returns\n\n- If a `select` function is provided, the return value of the `select` function.\n- If no `select` function is provided, the [`RouteMatch`](./RouteMatchType.md) object or a loosened version of the `RouteMatch` object if `opts.strict` is `false`.\n\n## Examples\n\n### Accessing a route match\n\n```tsx\nimport { useMatch } from '@tanstack/react-router'\n\nfunction Component() {\n  const match = useMatch({ from: '/posts/$postId' })\n  //     ^? strict match for RouteMatch\n  // ...\n}\n```\n\n### Accessing the root route's match\n\n```tsx\nimport {\n  useMatch,\n  rootRouteId, // <<<< use this token!\n} from '@tanstack/react-router'\n\nfunction Component() {\n  const match = useMatch({ from: rootRouteId })\n  //     ^? strict match for RouteMatch\n  // ...\n}\n```\n\n### Checking if a specific route is currently rendered\n\n```tsx\nimport { useMatch } from '@tanstack/react-router'\n\nfunction Component() {\n  const match = useMatch({ from: '/posts', shouldThrow: false })\n  //     ^? RouteMatch | undefined\n  if (match !== undefined) {\n    // ...\n  }\n}\n```\n","originalRawMarkdown":"---\nid: useMatchHook\ntitle: useMatch hook\n---\n\nThe `useMatch` hook returns a [`RouteMatch`](./RouteMatchType.md) in the component tree. The raw route match contains all of the information about a route match in the router and also powers many other hooks under the hood like `useParams`, `useLoaderData`, `useRouteContext`, and `useSearch`.\n\n## useMatch options\n\nThe `useMatch` hook accepts a single argument, an `options` object.\n\n### `opts.from` option\n\n- Type: `string`\n- The route id of a match\n- Optional, but recommended for full type safety.\n- If `opts.strict` is `true`, `from` is required and TypeScript will warn for this option if it is not provided.\n- If `opts.strict` is `false`, `from` must not be set and TypeScript will provided loosened types for the returned [`RouteMatch`](./RouteMatchType.md).\n\n### `opts.strict` option\n\n- Type: `boolean`\n- Optional\n- `default: true`\n- If `false`, the `opts.from` must not be set and types will be loosened to `Partial<RouteMatch>` to reflect the shared types of all matches.\n\n### `opts.select` option\n\n- Optional\n- `(match: RouteMatch) => TSelected`\n- If supplied, this function will be called with the route match and the return value will be returned from `useMatch`. This value will also be used to determine if the hook should re-render its parent component using shallow equality checks.\n\n### `opts.structuralSharing` option\n\n- Type: `boolean`\n- Optional\n- Configures whether structural sharing is enabled for the value returned by `select`.\n- See the [Render Optimizations guide](../../guide/render-optimizations.md) for more information.\n\n### `opts.shouldThrow` option\n\n- Type: `boolean`\n- Optional\n- `default: true`\n- If `false`,`useMatch` will not throw an invariant exception in case a match was not found in the currently rendered matches; in this case, it will return `undefined`.\n\n## useMatch returns\n\n- If a `select` function is provided, the return value of the `select` function.\n- If no `select` function is provided, the [`RouteMatch`](./RouteMatchType.md) object or a loosened version of the `RouteMatch` object if `opts.strict` is `false`.\n\n## Examples\n\n### Accessing a route match\n\n```tsx\nimport { useMatch } from '@tanstack/react-router'\n\nfunction Component() {\n  const match = useMatch({ from: '/posts/$postId' })\n  //     ^? strict match for RouteMatch\n  // ...\n}\n```\n\n### Accessing the root route's match\n\n```tsx\nimport {\n  useMatch,\n  rootRouteId, // <<<< use this token!\n} from '@tanstack/react-router'\n\nfunction Component() {\n  const match = useMatch({ from: rootRouteId })\n  //     ^? strict match for RouteMatch\n  // ...\n}\n```\n\n### Checking if a specific route is currently rendered\n\n```tsx\nimport { useMatch } from '@tanstack/react-router'\n\nfunction Component() {\n  const match = useMatch({ from: '/posts', shouldThrow: false })\n  //     ^? RouteMatch | undefined\n  if (match !== undefined) {\n    // ...\n  }\n}\n```\n"}
