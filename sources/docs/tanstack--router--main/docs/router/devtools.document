er} />\n      <TanStackRouterDevtools initialIsOpen={false} />\n    </>\n  )\n}","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"function App() {\n  return (\n    <>\n      <RouterProvider router={router} />\n      <TanStackRouterDevtools initialIsOpen={false} />\n    </>\n  )\n}","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"function App() {\\n  return (\\n    <>\\n      <RouterProvider router={router} />\\n      <TanStackRouterDevtools initialIsOpen={false} />\\n    </>\\n  )\\n}\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"function App() {\\n  return (\\n    <>\\n      <RouterProvider router={router} />\\n      <TanStackRouterDevtools initialIsOpen={false} />\\n    </>\\n  )\\n}\",\"language\":\"tsx\"}]}}"}},{"type":"heading","depth":3,"id":"devtools-options","children":[{"type":"text","value":"Devtools Options"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"router: Router"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The router instance to connect to."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"initialIsOpen: Boolean"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set this "},{"type":"inlineCode","value":"true"},{"type":"text","value":" if you want the devtools to default to being open."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"panelProps: PropsObject"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to add props to the panel. For example, you can add "},{"type":"inlineCode","value":"className"},{"type":"text","value":", "},{"type":"inlineCode","value":"style"},{"type":"text","value":" (merge and override default style), etc."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"closeButtonProps: PropsObject"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to add props to the close button. For example, you can add "},{"type":"inlineCode","value":"className"},{"type":"text","value":", "},{"type":"inlineCode","value":"style"},{"type":"text","value":" (merge and override default style), "},{"type":"inlineCode","value":"onClick"},{"type":"text","value":" (extend default handler), etc."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"toggleButtonProps: PropsObject"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to add props to the toggle button. For example, you can add "},{"type":"inlineCode","value":"className"},{"type":"text","value":", "},{"type":"inlineCode","value":"style"},{"type":"text","value":" (merge and override default style), "},{"type":"inlineCode","value":"onClick"},{"type":"text","value":" (extend default handler), etc."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"position?: \"top-left\" | \"top-right\" | \"bottom-left\" | \"bottom-right\""}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"bottom-left"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The position of the TanStack Router logo to open and close the devtools panel."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"shadowDOMTarget?: ShadowRoot"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Specifies a Shadow DOM target for the devtools."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"By default, devtool styles are applied to the "},{"type":"inlineCode","value":"<head>"},{"type":"text","value":" tag of the main document (light DOM). When a "},{"type":"inlineCode","value":"shadowDOMTarget"},{"type":"text","value":" is provided, styles will be applied within this Shadow DOM instead."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"containerElement?: string | any"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use this to render the devtools inside a different type of container element for ally purposes."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Any string which corresponds to a valid intrinsic JSX element is allowed."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Defaults to 'footer'."}]}]}]}]}]},{"type":"heading","depth":2,"id":"fixed-mode","children":[{"type":"text","value":"Fixed Mode"}]},{"type":"paragraph","children":[{"type":"text","value":"To control the position of the devtools, import the "},{"type":"inlineCode","value":"TanStackRouterDevtoolsPanel"},{"type":"text","value":":"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { TanStackRouterD