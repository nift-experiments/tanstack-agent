{"document":{"type":"root","children":[{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Link, take this sword... I mean Devtools!... to help you on your way!"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Wave your hands in the air and shout hooray because TanStack Router comes with dedicated devtools! 🥳"}]},{"type":"paragraph","children":[{"type":"text","value":"When you begin your TanStack Router journey, you'll want these devtools by your side. They help visualize all of the inner workings of TanStack Router and will likely save you hours of debugging if you find yourself in a pinch!"}]},{"type":"heading","depth":2,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"paragraph","children":[{"type":"text","value":"The devtools are a separate package that you need to install:"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-manager"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/react-router-devtools\"]],\"solid\":[[\"@tanstack/solid-router-devtools\"]]},\"mode\":\"install\"}"}},{"type":"heading","depth":2,"id":"import-the-devtools","children":[{"type":"text","value":"Import the Devtools"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { TanStackRouterDevtools } from '@tanstack/react-router-devtools'","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'\",\"language\":\"tsx\"}]}}"}},{"type":"heading","depth":2,"id":"using-devtools-in-production","children":[{"type":"text","value":"Using Devtools in production"}]},{"type":"paragraph","children":[{"type":"text","value":"The Devtools, if imported as "},{"type":"inlineCode","value":"TanStackRouterDevtools"},{"type":"text","value":" will not be shown in production. If you want to have devtools in an environment with "},{"type":"inlineCode","value":"process.env.NODE_ENV === 'production'"},{"type":"text","value":", use instead "},{"type":"inlineCode","value":"TanStackRouterDevtoolsInProd"},{"type":"text","value":", which has all the same options:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { TanStackRouterDevtoolsInProd } from '@tanstack/react-router-devtools'","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import { TanStackRouterDevtoolsInProd } from '@tanstack/solid-router-devtools'","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { TanStackRouterDevtoolsInProd } from '@tanstack/react-router-devtools'\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import { TanStackRouterDevtoolsInProd } from '@tanstack/solid-router-devtools'\",\"language\":\"tsx\"}]}}"}},{"type":"heading","depth":2,"id":"using-the-devtools-in-the-root-route","children":[{"type":"text","value":"Using the Devtools in the root route"}]},{"type":"paragraph","children":[{"type":"text","value":"The easiest way for the devtools to work is to render them inside of your root route (or any other route). This will automatically connect the devtools to the router instance."}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { createRootRoute, Outlet } from '@tanstack/react-router'\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\n\nexport const Route = createRootRoute({\n  component: () => (\n    <>\n      <Outlet />\n      <TanStackRouterDevtools />\n    </>\n  ),\n})","lang":"tsx","meta":"title=\"src/routes/__root.tsx\"","title":"src/routes/__root.tsx","file":"src/routes/__root.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/__root.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/__root.tsx\",\"code\":\"import { createRootRoute, Outlet } from '@tanstack/react-router'\\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\\n\\nexport const Route = createRootRoute({\\n  component: () => (\\n    <>\\n      <Outlet />\\n      <TanStackRouterDevtools />\\n    </>\\n  ),\\n})\",\"language\":\"tsx\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index"