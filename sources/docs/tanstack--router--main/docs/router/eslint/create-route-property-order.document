is rule:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/path')({\n  beforeLoad: () => ({ hello: 'world' }),\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n})","lang":"tsx","meta":"title=\"src/routes/path.tsx\"","title":"src/routes/path.tsx","file":"src/routes/path.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/path.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/path.tsx\",\"code\":\"/* eslint \\\"@tanstack/router/create-route-property-order\\\": \\\"warn\\\" */\\nimport { createFileRoute } from '@tanstack/react-router'\\n\\nexport const Route = createFileRoute('/path')({\\n  beforeLoad: () => ({ hello: 'world' }),\\n  loader: async ({ context }) => {\\n    await context.queryClient.query({\\n      ...getQueryOptions(context.hello),\\n      staleTime: 'static',\\n    })\\n  },\\n})\",\"language\":\"tsx\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/path')({\n  beforeLoad: () => ({ hello: 'world' }),\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n})","lang":"tsx","meta":"title=\"src/routes/path.tsx\"","title":"src/routes/path.tsx","file":"src/routes/path.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/path.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/path.tsx\",\"code\":\"/* eslint \\\"@tanstack/router/create-route-property-order\\\": \\\"warn\\\" */\\nimport { createFileRoute } from '@tanstack/solid-router'\\n\\nexport const Route = createFileRoute('/path')({\\n  beforeLoad: () => ({ hello: 'world' }),\\n  loader: async ({ context }) => {\\n    await context.queryClient.query({\\n      ...getQueryOptions(context.hello),\\n      staleTime: 'static',\\n    })\\n  },\\n})\",\"language\":\"tsx\"}]}"}}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[],\"solid\":[]}}"}},{"type":"heading","depth":2,"id":"attributes","children":[{"type":"text","value":"Attributes"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ Recommended"}]}],"checked":true},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"🔧 Fixable"}]}],"checked":true}]}],"headings":[{"id":"rule-details","text":"Rule Details","level":2},{"id":"attributes","text":"Attributes","level":2}]},"frameworks":["react","solid"],"downloadMarkdown":"\nFor the following functions, the property order of the passed in object matters due to type inference:\n\n- `createRoute`\n- `createFileRoute`\n- `createRootRoute`\n- `createRootRouteWithContext`\n\nThe correct property order is as follows\n\n- `params`, `validateSearch`\n- `loaderDeps`, `search.middlewares`, `ssr`\n- `context`\n- `beforeLoad`\n- `loader`\n- `onEnter`, `onStay`, `onLeave`, `head`, `scripts`, `headers`, `remountDeps`\n\nAll other properties are insensitive to the order as they do not depend on type inference.\n\n## Rule Details\n\nExamples of **incorrect** code for this rule:\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/path.tsx\"\n/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/path')({\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n  beforeLoad: () => ({ hello: 'world' }),\n})\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/path.tsx\"\n/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/path')({\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n  beforeLoad: () => ({ hello: 'world' }),\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\nExamples of **correct** code for this rule:\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/path.tsx\"\n/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/path')({\n  beforeLoad: () => ({ hello: 'world' }),\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/path.tsx\"\n/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/path')({\n  beforeLoad: () => ({ hello: 'world' }),\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n## Attributes\n\n- [x] ✅ Recommended\n- [x] 🔧 Fixable\n","originalRawMarkdown":"---\nid: create-route-property-order\ntitle: Ensure correct order of inference sensitive properties for createRoute functions\n---\n\nFor the following functions, the property order of the passed in object matters due to type inference:\n\n- `createRoute`\n- `createFileRoute`\n- `createRootRoute`\n- `createRootRouteWithContext`\n\nThe correct property order is as follows\n\n- `params`, `validateSearch`\n- `loaderDeps`, `search.middlewares`, `ssr`\n- `context`\n- `beforeLoad`\n- `loader`\n- `onEnter`, `onStay`, `onLeave`, `head`, `scripts`, `headers`, `remountDeps`\n\nAll other properties are insensitive to the order as they do not depend on type inference.\n\n## Rule Details\n\nExamples of **incorrect** code for this rule:\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/path.tsx\"\n/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/path')({\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n  beforeLoad: () => ({ hello: 'world' }),\n})\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/path.tsx\"\n/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/path')({\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n  beforeLoad: () => ({ hello: 'world' }),\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\nExamples of **correct** code for this rule:\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/path.tsx\"\n/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/path')({\n  beforeLoad: () => ({ hello: 'world' }),\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/path.tsx\"\n/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/path')({\n  beforeLoad: () => ({ hello: 'world' }),\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n## Attributes\n\n- [x] ✅ Recommended\n- [x] 🔧 Fixable\n"}
