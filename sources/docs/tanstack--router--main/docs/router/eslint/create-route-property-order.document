{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"For the following functions, the property order of the passed in object matters due to type inference:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"createRoute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"createFileRoute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"createRootRoute"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"createRootRouteWithContext"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The correct property order is as follows"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"params"},{"type":"text","value":", "},{"type":"inlineCode","value":"validateSearch"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"loaderDeps"},{"type":"text","value":", "},{"type":"inlineCode","value":"search.middlewares"},{"type":"text","value":", "},{"type":"inlineCode","value":"ssr"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"context"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"beforeLoad"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"loader"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onEnter"},{"type":"text","value":", "},{"type":"inlineCode","value":"onStay"},{"type":"text","value":", "},{"type":"inlineCode","value":"onLeave"},{"type":"text","value":", "},{"type":"inlineCode","value":"head"},{"type":"text","value":", "},{"type":"inlineCode","value":"scripts"},{"type":"text","value":", "},{"type":"inlineCode","value":"headers"},{"type":"text","value":", "},{"type":"inlineCode","value":"remountDeps"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"All other properties are insensitive to the order as they do not depend on type inference."}]},{"type":"heading","depth":2,"id":"rule-details","children":[{"type":"text","value":"Rule Details"}]},{"type":"paragraph","children":[{"type":"text","value":"Examples of "},{"type":"strong","children":[{"type":"text","value":"incorrect"}]},{"type":"text","value":" code for this rule:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"/* eslint \"@tanstack/router/create-route-property-order\": \"warn\" */\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/path')({\n  loader: async ({ context }) => {\n    await context.queryClient.query({\n      ...getQueryOptions(context.hello),\n      staleTime: 'static',\n    })\n  },\n  beforeLoad: () => ({ hello: 'world' }),\n})","lang":"tsx","meta":"title=\"src/routes/path.tsx\"","title":"src/routes/path.tsx","file":"src/routes/path.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/path.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/path.tsx\",\"code\":\"/* eslint \\\"@tanstack/router/create-route-property-order\\\": \\\"warn\\\" */\\nimport { createFileRoute } from '@tanstack/react-router'\\n\\nexport const Route = createFileRoute('/path')({\\n  loader: async ({ context }) => {\\n    await context.queryClient.query({\\n      