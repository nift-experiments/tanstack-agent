---
title: Preloading
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Preloading in TanStack Router is a way to load a route before the user actually navigates to it. This is useful for routes that are likely to be visited by the user next. For example, if you have a list of posts and the user is likely to click on one of them, you can preload the post route so that it's ready to go when the user clicks on it."}]},{"type":"heading","depth":2,"id":"supported-preloading-strategies","children":[{"type":"text","value":"Supported Preloading Strategies"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Intent"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Preloading by "},{"type":"strong","children":[{"type":"text","value":"\"intent\""}]},{"type":"text","value":" works by using hover and touch start events on "},{"type":"inlineCode","value":"<Link>"},{"type":"text","value":" components to preload the dependencies for the destination route."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This strategy is useful for preloading routes that the user is likely to visit next."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Viewport Visibility"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Preloading by "},{"type":"strong","children":[{"type":"text","value":"\"viewport"}]},{"type":"text","value":"\" works by using the Intersection Observer API to preload the dependencies for the destination route when the "},{"type":"inlineCode","value":"<Link>"},{"type":"text","value":" component is in the viewport."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This strategy is useful for preloading routes that are below the fold or off-screen."}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Render"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Preloading by "},{"type":"strong","children":[{"type":"text","value":"\"render\""}]},{"type":"text","value":" works by preloading the dependencies for the destination route as soon as the "},{"type":"inlineCode","value":"<Link>"},{"type":"text","value":" component is rendered in the DOM."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"This strategy is useful for preloading routes that are always needed."}]}]}]}]}]},{"type":"heading","depth":2,"id":"how-long-does-preloaded-data-stay-in-memory","children":[{"type":"text","value":"How long does preloaded data stay in memory?"}]},{"type":"paragraph","children":[{"type":"text","value":"Successful preloaded loader results can enter the router's in-memory cache with\ntwo independent policies:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Freshness defaults to 30 seconds."}]},{"type":"text","value":" Configure it with\n"},{"type":"inlineCode","value":"defaultPreloadStaleTime"},{"type":"text","value":" or a route's "},{"type":"inlineCode","value":"preloadStaleTime"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"The unused retention window defaults to 5 minutes."}]},{"type":"text","value":" Configure it with\n"},{"type":"inlineCode","value":"defaultPreloadGcTime"},{"type":"text","value":" or a route's "},{"type":"inlineCode","value":"preloadGcTime"},{"type":"text","value":". Older unused entries\nare eligible for pruning during a later cache reconciliation."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"The speculative lane is never promoted into router state."}]},{"type":"text","value":" Navigation\ncreates its own presentation and runs its own "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":" chain. It can reuse\ncached loader data or join a loader that is still in flight."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"If you need more control over preloading, caching and/or garbage collection of preloaded data, you should use an external caching library like "},{"type":"link","href":"https://tanstack.com/query","children":[{"type":"text","value":"TanStack Query"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The simplest way to preload routes for your application is to set the "},{"type":"inlineCode","value":"defaultPreload"},{"type":"text","value":" option to "},{"type":"inlineCode","value":"intent"},{"type":"text","value":" for your entire router:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreload: 'intent',\n})","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreload: 'intent',\n})","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { createRouter } from '@tanstack/react-router'\\n\\nconst router = createRouter({\\n  // ...\\n  defaultPreload: 'intent',\\n})\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import { createRouter } from '@tanstack/solid-router'\\n\\nconst router = createRouter({\\n  // ...\\n  defaultPreload: 'intent',\\n})\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"This will turn on "},{"type":"inlineCode","value":"intent"},{"type":"text","value":" preloading by default for all "},{"type":"inlineCode","value":"<Link>"},{"type":"text","value":" components in your application. You can also set the "},{"type":"inlineCode","value":"preload"},{"type":"text","value":" prop on individual "},{"type":"inlineCode","value":"<Link>"},{"type":"text","value":" components to override the default behavior."}]},{"type":"heading","depth":2,"id":"preload-delay","children":[{"type":"text","value":"Preload Delay"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, intent focus/hover and viewport preloading start after "},{"type":"strong","children":[{"type":"text","value":"50ms"}]},{"type":"text","value":". Pending preloads are cancelled if focus or hover ends, or the link leaves the viewport. Touch intent preloads immediately. You can change this delay by setting the "},{"type":"inlineCode","value":"defaultPreloadDelay"},{"type":"text","value":" option on your router:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadDelay: 100,\n})","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadDelay: 100,\n})","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { createRouter } from '@tanstack/react-router'\\n\\nconst router = createRouter({\\n  // ...\\n  defaultPreloadDelay: 100,\\n})\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import { createRouter } from '@tanstack/solid-router'\\n\\nconst router = createRouter({\\n  // ...\\n  defaultPreloadDelay: 100,\\n})\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"You can also set the "},{"type":"inlineCode","value":"preloadDelay"},{"type":"text","value":" prop on individual "},{"type":"inlineCode","value":"<Link>"},{"type":"text","value":" components to override the default behavior on a per-link basis."}]},{"type":"heading","depth":2,"id":"built-in-preloading-freshness-and-retention","children":[{"type":"text","value":"Built-in Preloading, Freshness, and Retention"}]},{"type":"paragraph","children":[{"type":"text","value":"If you're using the built-in loaders, you can control how long preloaded data is considered fresh by setting either "},{"type":"inlineCode","value":"routerOptions.defaultPreloadStaleTime"},{"type":"text","value":" or "},{"type":"inlineCode","value":"routeOptions.preloadStaleTime"},{"type":"text","value":" to a number of milliseconds. "},{"type":"strong","children":[{"type":"text","value":"By default, preloaded data is considered fresh for 30 seconds."}]}]},{"type":"paragraph","children":[{"type":"text","value":"Freshness and retention are separate. "},{"type":"inlineCode","value":"preloadStaleTime"},{"type":"text","value":" controls whether the\nretained loader result can be reused without another loader call.\n"},{"type":"inlineCode","value":"preloadGcTime"},{"type":"text","value":" (or "},{"type":"inlineCode","value":"defaultPreloadGcTime"},{"type":"text","value":") controls when an unused preload\nresult becomes eligible for pruning during a later cache reconciliation; it\ndoes not schedule a timer to evict the result at that exact moment. Both preload\nGC options default to 5 minutes."}]},{"type":"paragraph","children":[{"type":"text","value":"To change this, you can set the "},{"type":"inlineCode","value":"defaultPreloadStaleTime"},{"type":"text","value":" option on your router:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 10_000,\n})","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 10_000,\n})","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { createRouter } from '@tanstack/react-router'\\n\\nconst router = createRouter({\\n  // ...\\n  defaultPreloadStaleTime: 10_000,\\n})\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import { createRouter } from '@tanstack/solid-router'\\n\\nconst router = createRouter({\\n  // ...\\n  defaultPreloadStaleTime: 10_000,\\n})\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"Or, you can use the "},{"type":"inlineCode","value":"routeOptions.preloadStaleTime"},{"type":"text","value":" option on individual routes:"}]},{"type":"code","value":"// src/routes/posts.$postId.tsx\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ params }) => fetchPost(params.postId),\n  // Reload preloaded data when it is more than 10 seconds old\n  preloadStaleTime: 10_000,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Client-side preloading runs each route's "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":" with "},{"type":"inlineCode","value":"preload: true"},{"type":"text","value":".\nEvery later preload or navigation runs its own "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":" chain, so a\nnavigation observes "},{"type":"inlineCode","value":"preload: false"},{"type":"text","value":" even when an identical preload is still\nactive. A later lane can reuse successful settled loader data or join loader\nwork that is still in flight, but it never reuses "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":" context or an\nalready-settled redirect, error, or not-found result. If joined loader work\nlater produces a terminal outcome, all current consumers of that flight observe\nit. The "},{"type":"inlineCode","value":"shouldReload"},{"type":"text","value":" option remains loader-only."}]},{"type":"paragraph","children":[{"type":"text","value":"If a route has "},{"type":"inlineCode","value":"preload: false"},{"type":"text","value":", its speculative lane still runs "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":",\nbut skips that route's loader. Navigation runs "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":" again and performs\nthe skipped loader work."}]},{"type":"heading","depth":2,"id":"preloading-with-external-libraries","children":[{"type":"text","value":"Preloading with External Libraries"}]},{"type":"paragraph","children":[{"type":"text","value":"When integrating external caching libraries like React Query, which have their own mechanisms for determining stale data, you may want to override the default preloading and stale-while-revalidate logic of TanStack Router. These libraries often use options like staleTime to control the freshness of data."}]},{"type":"paragraph","children":[{"type":"text","value":"To let an external cache make the freshness decision, set\n"},{"type":"inlineCode","value":"routerOptions.defaultPreloadStaleTime"},{"type":"text","value":" or "},{"type":"inlineCode","value":"routeOptions.preloadStaleTime"},{"type":"text","value":" to\n"},{"type":"inlineCode","value":"0"},{"type":"text","value":". Settled preload data then becomes immediately stale in the Router, while\nretention still follows "},{"type":"inlineCode","value":"preloadGcTime"},{"type":"text","value":". Overlapping preload or navigation\nconsumers can still share in-flight loader work, and "},{"type":"inlineCode","value":"shouldReload"},{"type":"text","value":" can still\nsuppress a loader call."}]},{"type":"paragraph","children":[{"type":"text","value":"For example:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 0,\n})","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 0,\n})","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { createRouter } from '@tanstack/react-router'\\n\\nconst router = createRouter({\\n  // ...\\n  defaultPreloadStaleTime: 0,\\n})\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import { createRouter } from '@tanstack/solid-router'\\n\\nconst router = createRouter({\\n  // ...\\n  defaultPreloadStaleTime: 0,\\n})\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"This would then allow you, for instance, to use an option like React Query's "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":" to control the freshness of your preloads."}]},{"type":"heading","depth":2,"id":"preloading-manually","children":[{"type":"text","value":"Preloading Manually"}]},{"type":"paragraph","children":[{"type":"text","value":"If you need to manually preload a route, use the router's "},{"type":"inlineCode","value":"preloadRoute"},{"type":"text","value":" method.\nIt accepts a standard TanStack "},{"type":"inlineCode","value":"NavigateOptions"},{"type":"text","value":" object and returns the\nspeculative match lane. An ordinary error or not-found thrown while loading is\nrepresented in that returned lane; cancellation or control flow that produces\nno reusable lane can return "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":"."}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { isNotFound } from '@tanstack/react-router'\n\nfunction Component() {\n  const router = useRouter()\n\n  useEffect(() => {\n    async function preload() {\n      const matches = await router.preloadRoute({\n        to: postRoute,\n        params: { id: 1 },\n      })\n\n      const routeFailure = matches?.find(\n        (match) =>\n          match.status === 'error' ||\n          match.status === 'notFound' ||\n          isNotFound(match.error),\n      )\n\n      if (routeFailure) {\n        // Inspect routeFailure.error\n      }\n    }\n\n    preload()\n  }, [router])\n\n  return <div />\n}","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import { isNotFound } from '@tanstack/solid-router'\n\nfunction Component() {\n  const router = useRouter()\n\n  createEffect(() => {\n    async function preload() {\n      const matches = await router.preloadRoute({\n        to: postRoute,\n        params: { id: 1 },\n      })\n\n      const routeFailure = matches?.find(\n        (match) =>\n          match.status === 'error' ||\n          match.status === 'notFound' ||\n          isNotFound(match.error),\n      )\n\n      if (routeFailure) {\n        // Inspect routeFailure.error\n      }\n    }\n\n    preload()\n  })\n\n  return <div />\n}","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { isNotFound } from '@tanstack/react-router'\\n\\nfunction Component() {\\n  const router = useRouter()\\n\\n  useEffect(() => {\\n    async function preload() {\\n      const matches = await router.preloadRoute({\\n        to: postRoute,\\n        params: { id: 1 },\\n      })\\n\\n      const routeFailure = matches?.find(\\n        (match) =>\\n          match.status === 'error' ||\\n          match.status === 'notFound' ||\\n          isNotFound(match.error),\\n      )\\n\\n      if (routeFailure) {\\n        // Inspect routeFailure.error\\n      }\\n    }\\n\\n    preload()\\n  }, [router])\\n\\n  return <div />\\n}\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import { isNotFound } from '@tanstack/solid-router'\\n\\nfunction Component() {\\n  const router = useRouter()\\n\\n  createEffect(() => {\\n    async function preload() {\\n      const matches = await router.preloadRoute({\\n        to: postRoute,\\n        params: { id: 1 },\\n      })\\n\\n      const routeFailure = matches?.find(\\n        (match) =>\\n          match.status === 'error' ||\\n          match.status === 'notFound' ||\\n          isNotFound(match.error),\\n      )\\n\\n      if (routeFailure) {\\n        // Inspect routeFailure.error\\n      }\\n    }\\n\\n    preload()\\n  })\\n\\n  return <div />\\n}\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"If you need to preload only the JS chunk of a route, you can use the router's "},{"type":"inlineCode","value":"loadRouteChunk"},{"type":"text","value":" method. It accepts a route object and returns a promise that resolves when the route chunk is loaded."}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"function Component() {\n  const router = useRouter()\n\n  useEffect(() => {\n    async function preloadRouteChunks() {\n      try {\n        const postsRoute = router.routesByPath['/posts']\n        await Promise.all([\n          router.loadRouteChunk(router.routesByPath['/']),\n          router.loadRouteChunk(postsRoute),\n          router.loadRouteChunk(postsRoute.parentRoute),\n        ])\n      } catch (err) {\n        // Failed to preload route chunk\n      }\n    }\n\n    preloadRouteChunks()\n  }, [router])\n\n  return <div />\n}","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"function Component() {\n  const router = useRouter()\n\n  createEffect(() => {\n    async function preloadRouteChunks() {\n      try {\n        const postsRoute = router.routesByPath['/posts']\n        await Promise.all([\n          router.loadRouteChunk(router.routesByPath['/']),\n          router.loadRouteChunk(postsRoute),\n          router.loadRouteChunk(postsRoute.parentRoute),\n        ])\n      } catch (err) {\n        // Failed to preload route chunk\n      }\n    }\n\n    preloadRouteChunks()\n  })\n\n  return <div />\n}","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"function Component() {\\n  const router = useRouter()\\n\\n  useEffect(() => {\\n    async function preloadRouteChunks() {\\n      try {\\n        const postsRoute = router.routesByPath['/posts']\\n        await Promise.all([\\n          router.loadRouteChunk(router.routesByPath['/']),\\n          router.loadRouteChunk(postsRoute),\\n          router.loadRouteChunk(postsRoute.parentRoute),\\n        ])\\n      } catch (err) {\\n        // Failed to preload route chunk\\n      }\\n    }\\n\\n    preloadRouteChunks()\\n  }, [router])\\n\\n  return <div />\\n}\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"function Component() {\\n  const router = useRouter()\\n\\n  createEffect(() => {\\n    async function preloadRouteChunks() {\\n      try {\\n        const postsRoute = router.routesByPath['/posts']\\n        await Promise.all([\\n          router.loadRouteChunk(router.routesByPath['/']),\\n          router.loadRouteChunk(postsRoute),\\n          router.loadRouteChunk(postsRoute.parentRoute),\\n        ])\\n      } catch (err) {\\n        // Failed to preload route chunk\\n      }\\n    }\\n\\n    preloadRouteChunks()\\n  })\\n\\n  return <div />\\n}\",\"language\":\"tsx\"}]}}"}}],"headings":[{"id":"supported-preloading-strategies","text":"Supported Preloading Strategies","level":2},{"id":"how-long-does-preloaded-data-stay-in-memory","text":"How long does preloaded data stay in memory?","level":2},{"id":"preload-delay","text":"Preload Delay","level":2},{"id":"built-in-preloading-freshness-and-retention","text":"Built-in Preloading, Freshness, and Retention","level":2},{"id":"preloading-with-external-libraries","text":"Preloading with External Libraries","level":2},{"id":"preloading-manually","text":"Preloading Manually","level":2}]},"frameworks":["react","solid"],"downloadMarkdown":"\nPreloading in TanStack Router is a way to load a route before the user actually navigates to it. This is useful for routes that are likely to be visited by the user next. For example, if you have a list of posts and the user is likely to click on one of them, you can preload the post route so that it's ready to go when the user clicks on it.\n\n## Supported Preloading Strategies\n\n- Intent\n  - Preloading by **\"intent\"** works by using hover and touch start events on `<Link>` components to preload the dependencies for the destination route.\n  - This strategy is useful for preloading routes that the user is likely to visit next.\n- Viewport Visibility\n  - Preloading by **\"viewport**\" works by using the Intersection Observer API to preload the dependencies for the destination route when the `<Link>` component is in the viewport.\n  - This strategy is useful for preloading routes that are below the fold or off-screen.\n- Render\n  - Preloading by **\"render\"** works by preloading the dependencies for the destination route as soon as the `<Link>` component is rendered in the DOM.\n  - This strategy is useful for preloading routes that are always needed.\n\n## How long does preloaded data stay in memory?\n\nSuccessful preloaded loader results can enter the router's in-memory cache with\ntwo independent policies:\n\n- **Freshness defaults to 30 seconds.** Configure it with\n  `defaultPreloadStaleTime` or a route's `preloadStaleTime`.\n- **The unused retention window defaults to 5 minutes.** Configure it with\n  `defaultPreloadGcTime` or a route's `preloadGcTime`. Older unused entries\n  are eligible for pruning during a later cache reconciliation.\n- **The speculative lane is never promoted into router state.** Navigation\n  creates its own presentation and runs its own `beforeLoad` chain. It can reuse\n  cached loader data or join a loader that is still in flight.\n\nIf you need more control over preloading, caching and/or garbage collection of preloaded data, you should use an external caching library like [TanStack Query](https://tanstack.com/query).\n\nThe simplest way to preload routes for your application is to set the `defaultPreload` option to `intent` for your entire router:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreload: 'intent',\n})\n```\n\n# Solid\n\n```tsx\nimport { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreload: 'intent',\n})\n```\n\n<!-- ::end:framework -->\n\nThis will turn on `intent` preloading by default for all `<Link>` components in your application. You can also set the `preload` prop on individual `<Link>` components to override the default behavior.\n\n## Preload Delay\n\nBy default, intent focus/hover and viewport preloading start after **50ms**. Pending preloads are cancelled if focus or hover ends, or the link leaves the viewport. Touch intent preloads immediately. You can change this delay by setting the `defaultPreloadDelay` option on your router:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadDelay: 100,\n})\n```\n\n# Solid\n\n```tsx\nimport { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadDelay: 100,\n})\n```\n\n<!-- ::end:framework -->\n\nYou can also set the `preloadDelay` prop on individual `<Link>` components to override the default behavior on a per-link basis.\n\n## Built-in Preloading, Freshness, and Retention\n\nIf you're using the built-in loaders, you can control how long preloaded data is considered fresh by setting either `routerOptions.defaultPreloadStaleTime` or `routeOptions.preloadStaleTime` to a number of milliseconds. **By default, preloaded data is considered fresh for 30 seconds.**\n\nFreshness and retention are separate. `preloadStaleTime` controls whether the\nretained loader result can be reused without another loader call.\n`preloadGcTime` (or `defaultPreloadGcTime`) controls when an unused preload\nresult becomes eligible for pruning during a later cache reconciliation; it\ndoes not schedule a timer to evict the result at that exact moment. Both preload\nGC options default to 5 minutes.\n\nTo change this, you can set the `defaultPreloadStaleTime` option on your router:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 10_000,\n})\n```\n\n# Solid\n\n```tsx\nimport { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 10_000,\n})\n```\n\n<!-- ::end:framework -->\n\nOr, you can use the `routeOptions.preloadStaleTime` option on individual routes:\n\n```tsx\n// src/routes/posts.$postId.tsx\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ params }) => fetchPost(params.postId),\n  // Reload preloaded data when it is more than 10 seconds old\n  preloadStaleTime: 10_000,\n})\n```\n\nClient-side preloading runs each route's `beforeLoad` with `preload: true`.\nEvery later preload or navigation runs its own `beforeLoad` chain, so a\nnavigation observes `preload: false` even when an identical preload is still\nactive. A later lane can reuse successful settled loader data or join loader\nwork that is still in flight, but it never reuses `beforeLoad` context or an\nalready-settled redirect, error, or not-found result. If joined loader work\nlater produces a terminal outcome, all current consumers of that flight observe\nit. The `shouldReload` option remains loader-only.\n\nIf a route has `preload: false`, its speculative lane still runs `beforeLoad`,\nbut skips that route's loader. Navigation runs `beforeLoad` again and performs\nthe skipped loader work.\n\n## Preloading with External Libraries\n\nWhen integrating external caching libraries like React Query, which have their own mechanisms for determining stale data, you may want to override the default preloading and stale-while-revalidate logic of TanStack Router. These libraries often use options like staleTime to control the freshness of data.\n\nTo let an external cache make the freshness decision, set\n`routerOptions.defaultPreloadStaleTime` or `routeOptions.preloadStaleTime` to\n`0`. Settled preload data then becomes immediately stale in the Router, while\nretention still follows `preloadGcTime`. Overlapping preload or navigation\nconsumers can still share in-flight loader work, and `shouldReload` can still\nsuppress a loader call.\n\nFor example:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 0,\n})\n```\n\n# Solid\n\n```tsx\nimport { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 0,\n})\n```\n\n<!-- ::end:framework -->\n\nThis would then allow you, for instance, to use an option like React Query's `staleTime` to control the freshness of your preloads.\n\n## Preloading Manually\n\nIf you need to manually preload a route, use the router's `preloadRoute` method.\nIt accepts a standard TanStack `NavigateOptions` object and returns the\nspeculative match lane. An ordinary error or not-found thrown while loading is\nrepresented in that returned lane; cancellation or control flow that produces\nno reusable lane can return `undefined`.\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { isNotFound } from '@tanstack/react-router'\n\nfunction Component() {\n  const router = useRouter()\n\n  useEffect(() => {\n    async function preload() {\n      const matches = await router.preloadRoute({\n        to: postRoute,\n        params: { id: 1 },\n      })\n\n      const routeFailure = matches?.find(\n        (match) =>\n          match.status === 'error' ||\n          match.status === 'notFound' ||\n          isNotFound(match.error),\n      )\n\n      if (routeFailure) {\n        // Inspect routeFailure.error\n      }\n    }\n\n    preload()\n  }, [router])\n\n  return <div />\n}\n```\n\n# Solid\n\n```tsx\nimport { isNotFound } from '@tanstack/solid-router'\n\nfunction Component() {\n  const router = useRouter()\n\n  createEffect(() => {\n    async function preload() {\n      const matches = await router.preloadRoute({\n        to: postRoute,\n        params: { id: 1 },\n      })\n\n      const routeFailure = matches?.find(\n        (match) =>\n          match.status === 'error' ||\n          match.status === 'notFound' ||\n          isNotFound(match.error),\n      )\n\n      if (routeFailure) {\n        // Inspect routeFailure.error\n      }\n    }\n\n    preload()\n  })\n\n  return <div />\n}\n```\n\n<!-- ::end:framework -->\n\nIf you need to preload only the JS chunk of a route, you can use the router's `loadRouteChunk` method. It accepts a route object and returns a promise that resolves when the route chunk is loaded.\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nfunction Component() {\n  const router = useRouter()\n\n  useEffect(() => {\n    async function preloadRouteChunks() {\n      try {\n        const postsRoute = router.routesByPath['/posts']\n        await Promise.all([\n          router.loadRouteChunk(router.routesByPath['/']),\n          router.loadRouteChunk(postsRoute),\n          router.loadRouteChunk(postsRoute.parentRoute),\n        ])\n      } catch (err) {\n        // Failed to preload route chunk\n      }\n    }\n\n    preloadRouteChunks()\n  }, [router])\n\n  return <div />\n}\n```\n\n# Solid\n\n```tsx\nfunction Component() {\n  const router = useRouter()\n\n  createEffect(() => {\n    async function preloadRouteChunks() {\n      try {\n        const postsRoute = router.routesByPath['/posts']\n        await Promise.all([\n          router.loadRouteChunk(router.routesByPath['/']),\n          router.loadRouteChunk(postsRoute),\n          router.loadRouteChunk(postsRoute.parentRoute),\n        ])\n      } catch (err) {\n        // Failed to preload route chunk\n      }\n    }\n\n    preloadRouteChunks()\n  })\n\n  return <div />\n}\n```\n\n<!-- ::end:framework -->\n","originalRawMarkdown":"---\ntitle: Preloading\n---\n\nPreloading in TanStack Router is a way to load a route before the user actually navigates to it. This is useful for routes that are likely to be visited by the user next. For example, if you have a list of posts and the user is likely to click on one of them, you can preload the post route so that it's ready to go when the user clicks on it.\n\n## Supported Preloading Strategies\n\n- Intent\n  - Preloading by **\"intent\"** works by using hover and touch start events on `<Link>` components to preload the dependencies for the destination route.\n  - This strategy is useful for preloading routes that the user is likely to visit next.\n- Viewport Visibility\n  - Preloading by **\"viewport**\" works by using the Intersection Observer API to preload the dependencies for the destination route when the `<Link>` component is in the viewport.\n  - This strategy is useful for preloading routes that are below the fold or off-screen.\n- Render\n  - Preloading by **\"render\"** works by preloading the dependencies for the destination route as soon as the `<Link>` component is rendered in the DOM.\n  - This strategy is useful for preloading routes that are always needed.\n\n## How long does preloaded data stay in memory?\n\nSuccessful preloaded loader results can enter the router's in-memory cache with\ntwo independent policies:\n\n- **Freshness defaults to 30 seconds.** Configure it with\n  `defaultPreloadStaleTime` or a route's `preloadStaleTime`.\n- **The unused retention window defaults to 5 minutes.** Configure it with\n  `defaultPreloadGcTime` or a route's `preloadGcTime`. Older unused entries\n  are eligible for pruning during a later cache reconciliation.\n- **The speculative lane is never promoted into router state.** Navigation\n  creates its own presentation and runs its own `beforeLoad` chain. It can reuse\n  cached loader data or join a loader that is still in flight.\n\nIf you need more control over preloading, caching and/or garbage collection of preloaded data, you should use an external caching library like [TanStack Query](https://tanstack.com/query).\n\nThe simplest way to preload routes for your application is to set the `defaultPreload` option to `intent` for your entire router:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreload: 'intent',\n})\n```\n\n# Solid\n\n```tsx\nimport { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreload: 'intent',\n})\n```\n\n<!-- ::end:framework -->\n\nThis will turn on `intent` preloading by default for all `<Link>` components in your application. You can also set the `preload` prop on individual `<Link>` components to override the default behavior.\n\n## Preload Delay\n\nBy default, intent focus/hover and viewport preloading start after **50ms**. Pending preloads are cancelled if focus or hover ends, or the link leaves the viewport. Touch intent preloads immediately. You can change this delay by setting the `defaultPreloadDelay` option on your router:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadDelay: 100,\n})\n```\n\n# Solid\n\n```tsx\nimport { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadDelay: 100,\n})\n```\n\n<!-- ::end:framework -->\n\nYou can also set the `preloadDelay` prop on individual `<Link>` components to override the default behavior on a per-link basis.\n\n## Built-in Preloading, Freshness, and Retention\n\nIf you're using the built-in loaders, you can control how long preloaded data is considered fresh by setting either `routerOptions.defaultPreloadStaleTime` or `routeOptions.preloadStaleTime` to a number of milliseconds. **By default, preloaded data is considered fresh for 30 seconds.**\n\nFreshness and retention are separate. `preloadStaleTime` controls whether the\nretained loader result can be reused without another loader call.\n`preloadGcTime` (or `defaultPreloadGcTime`) controls when an unused preload\nresult becomes eligible for pruning during a later cache reconciliation; it\ndoes not schedule a timer to evict the result at that exact moment. Both preload\nGC options default to 5 minutes.\n\nTo change this, you can set the `defaultPreloadStaleTime` option on your router:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 10_000,\n})\n```\n\n# Solid\n\n```tsx\nimport { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 10_000,\n})\n```\n\n<!-- ::end:framework -->\n\nOr, you can use the `routeOptions.preloadStaleTime` option on individual routes:\n\n```tsx\n// src/routes/posts.$postId.tsx\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ params }) => fetchPost(params.postId),\n  // Reload preloaded data when it is more than 10 seconds old\n  preloadStaleTime: 10_000,\n})\n```\n\nClient-side preloading runs each route's `beforeLoad` with `preload: true`.\nEvery later preload or navigation runs its own `beforeLoad` chain, so a\nnavigation observes `preload: false` even when an identical preload is still\nactive. A later lane can reuse successful settled loader data or join loader\nwork that is still in flight, but it never reuses `beforeLoad` context or an\nalready-settled redirect, error, or not-found result. If joined loader work\nlater produces a terminal outcome, all current consumers of that flight observe\nit. The `shouldReload` option remains loader-only.\n\nIf a route has `preload: false`, its speculative lane still runs `beforeLoad`,\nbut skips that route's loader. Navigation runs `beforeLoad` again and performs\nthe skipped loader work.\n\n## Preloading with External Libraries\n\nWhen integrating external caching libraries like React Query, which have their own mechanisms for determining stale data, you may want to override the default preloading and stale-while-revalidate logic of TanStack Router. These libraries often use options like staleTime to control the freshness of data.\n\nTo let an external cache make the freshness decision, set\n`routerOptions.defaultPreloadStaleTime` or `routeOptions.preloadStaleTime` to\n`0`. Settled preload data then becomes immediately stale in the Router, while\nretention still follows `preloadGcTime`. Overlapping preload or navigation\nconsumers can still share in-flight loader work, and `shouldReload` can still\nsuppress a loader call.\n\nFor example:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { createRouter } from '@tanstack/react-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 0,\n})\n```\n\n# Solid\n\n```tsx\nimport { createRouter } from '@tanstack/solid-router'\n\nconst router = createRouter({\n  // ...\n  defaultPreloadStaleTime: 0,\n})\n```\n\n<!-- ::end:framework -->\n\nThis would then allow you, for instance, to use an option like React Query's `staleTime` to control the freshness of your preloads.\n\n## Preloading Manually\n\nIf you need to manually preload a route, use the router's `preloadRoute` method.\nIt accepts a standard TanStack `NavigateOptions` object and returns the\nspeculative match lane. An ordinary error or not-found thrown while loading is\nrepresented in that returned lane; cancellation or control flow that produces\nno reusable lane can return `undefined`.\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { isNotFound } from '@tanstack/react-router'\n\nfunction Component() {\n  const router = useRouter()\n\n  useEffect(() => {\n    async function preload() {\n      const matches = await router.preloadRoute({\n        to: postRoute,\n        params: { id: 1 },\n      })\n\n      const routeFailure = matches?.find(\n        (match) =>\n          match.status === 'error' ||\n          match.status === 'notFound' ||\n          isNotFound(match.error),\n      )\n\n      if (routeFailure) {\n        // Inspect routeFailure.error\n      }\n    }\n\n    preload()\n  }, [router])\n\n  return <div />\n}\n```\n\n# Solid\n\n```tsx\nimport { isNotFound } from '@tanstack/solid-router'\n\nfunction Component() {\n  const router = useRouter()\n\n  createEffect(() => {\n    async function preload() {\n      const matches = await router.preloadRoute({\n        to: postRoute,\n        params: { id: 1 },\n      })\n\n      const routeFailure = matches?.find(\n        (match) =>\n          match.status === 'error' ||\n          match.status === 'notFound' ||\n          isNotFound(match.error),\n      )\n\n      if (routeFailure) {\n        // Inspect routeFailure.error\n      }\n    }\n\n    preload()\n  })\n\n  return <div />\n}\n```\n\n<!-- ::end:framework -->\n\nIf you need to preload only the JS chunk of a route, you can use the router's `loadRouteChunk` method. It accepts a route object and returns a promise that resolves when the route chunk is loaded.\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nfunction Component() {\n  const router = useRouter()\n\n  useEffect(() => {\n    async function preloadRouteChunks() {\n      try {\n        const postsRoute = router.routesByPath['/posts']\n        await Promise.all([\n          router.loadRouteChunk(router.routesByPath['/']),\n          router.loadRouteChunk(postsRoute),\n          router.loadRouteChunk(postsRoute.parentRoute),\n        ])\n      } catch (err) {\n        // Failed to preload route chunk\n      }\n    }\n\n    preloadRouteChunks()\n  }, [router])\n\n  return <div />\n}\n```\n\n# Solid\n\n```tsx\nfunction Component() {\n  const router = useRouter()\n\n  createEffect(() => {\n    async function preloadRouteChunks() {\n      try {\n        const postsRoute = router.routesByPath['/posts']\n        await Promise.all([\n          router.loadRouteChunk(router.routesByPath['/']),\n          router.loadRouteChunk(postsRoute),\n          router.loadRouteChunk(postsRoute.parentRoute),\n        ])\n      } catch (err) {\n        // Failed to preload route chunk\n      }\n    }\n\n    preloadRouteChunks()\n  })\n\n  return <div />\n}\n```\n\n<!-- ::end:framework -->\n"}
