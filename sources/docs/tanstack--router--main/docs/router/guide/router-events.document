is:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onBeforeNavigate"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onBeforeLoad"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onLoad"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onBeforeRouteMount"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onResolved"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"onRendered"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"You usually do not need every event. A good rule of thumb is:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onBeforeNavigate"},{"type":"text","value":" or "},{"type":"inlineCode","value":"onBeforeLoad"},{"type":"text","value":" to observe navigation start"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onResolved"},{"type":"text","value":" for analytics and cleanup after navigation finishes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onRendered"},{"type":"text","value":" for DOM-dependent work"}]}]}]},{"type":"heading","depth":2,"id":"event-payload","children":[{"type":"text","value":"Event payload"}]},{"type":"paragraph","children":[{"type":"text","value":"Navigation events receive location change metadata describing what changed:"}]},{"type":"code","value":"const unsubscribe = router.subscribe('onBeforeNavigate', (event) => {\n  console.info({\n    from: event.fromLocation?.href,\n    to: event.toLocation.href,\n    pathChanged: event.pathChanged,\n    hrefChanged: event.hrefChanged,\n    hashChanged: event.hashChanged,\n  })\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"A few useful details:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"fromLocation"},{"type":"text","value":" can be "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" on the initial load"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"pathChanged"},{"type":"text","value":" tells you whether the pathname changed"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"hrefChanged"},{"type":"text","value":" includes pathname, search, and hash changes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"hashChanged"},{"type":"text","value":" is useful for distinguishing hash-only navigations"}]}]}]},{"type":"heading","depth":2,"id":"common-patterns","children":[{"type":"text","value":"Common patterns"}]},{"type":"heading","depth":3,"id":"track-pageviews","children":[{"type":"text","value":"Track pageviews"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"onResolved"},{"type":"text","value":" is a good default for analytics because it fires after navigation finishes:"}]},{"type":"code","value":"const unsubscribe = router.subscribe('onResolved', ({ toLocation }) => {\n  analytics.track('page_view', {\n    path: toLocation.pathname,\n    href: toLocation.href,\n  })\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"clear-external-mutation-state","children":[{"type":"text","value":"Clear external mutation state"}]},{"type":"paragraph","children":[{"type":"text","value":"If you use a mutation library without keyed mutation state, clear it after navigation:"}]},{"type":"code","value":"const unsubscribe = router.subscribe('onResolved', ({ pathChanged }) => {\n  if (pathChanged) {\n    mutationCache.clear()\n  }\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"run-dom-dependent-logic","children":[{"type":"text","value":"Run DOM-dependent logic"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"onRendered"},{"type":"text","value":" when your side effect depends on the new route content already being in the DOM:"}]},{"type":"code","value":"const unsubscribe = router.subscribe('onRendered', ({ toLocation }) => {\n  focusPageHeading(toLocation.pathname)\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"unsubscribing-in-components","children":[{"type":"text","value":"Unsubscribing in components"}]},{"type":"paragraph","children":[{"type":"text","value":"If you subscribe from a component or framework effect, always return the unsubscribe function from your cleanup so the listener is removed when the component unmounts."}]},{"type":"heading","depth":2,"id":"related-apis","children":[{"type":"text","value":"Related APIs"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../api/router/RouterType.md","children":[{"type":"inlineCode","value":"Router"},{"type":"text","value":" type"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../api/router/RouterEventsType.md","children":[{"type":"inlineCode","value":"RouterEvents"},{"type":"text","value":" type"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./data-mutations.md","children":[{"type":"text","value":"Data Mutations"}]}]}]}]}],"headings":[{"id":"basic-usage","text":"Basic usage","level":2},{"id":"when-to-use-it","text":"When to use it","level":2},{"id":"available-events","text":"Available events","level":2},{"id":"typical-event-flow","text":"Typical event flow","level":2},{"id":"event-payload","text":"Event payload","level":2},{"id":"common-patterns","text":"Common patterns","level":2},{"id":"track-pageviews","text":"Track pageviews","level":3},{"id":"clear-external-mutation-state","text":"Clear external mutation state","level":3},{"id":"run-dom-dependent-logic","text":"Run DOM-dependent logic","level":3},{"id":"unsubscribing-in-components","text":"Unsubscribing in components","level":2},{"id":"related-apis","text":"Related APIs","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Router exposes router lifecycle events through `router.subscribe`. This is useful for imperative side effects like analytics, resetting external state, or running DOM-dependent logic after navigation.\n\n## Basic usage\n\n`router.subscribe` takes an event name and a listener, then returns an unsubscribe function:\n\n```tsx\nconst unsubscribe = router.subscribe('onResolved', (event) => {\n  console.info('Navigation finished:', event.toLocation.href)\n})\n\n// Later, clean up the listener\nunsubscribe()\n```\n\n## When to use it\n\n`router.subscribe` is best for imperative integrations that need to observe navigation without driving rendering:\n\n- Analytics and pageview tracking\n- Resetting external caches or mutation state\n- Logging navigation timing and transitions\n- Running DOM-dependent logic after routes render\n\nIf you need reactive UI updates, prefer framework hooks like `useRouterState`, `useSearch`, and `useParams` instead of subscribing manually.\n\n## Available events\n\nTanStack Router emits these lifecycle events:\n\n- `onBeforeNavigate` - right before a navigation begins\n- `onBeforeLoad` - before route loading starts\n- `onLoad` - after the next location has committed and route matches have loaded\n- `onBeforeRouteMount` - after loading finishes, just before route components mount\n- `onResolved` - after the navigation has fully resolved\n- `onRendered` - after the route has rendered\n\nFor the full event payload types, see the [`RouterEvents` type](../api/router/RouterEventsType.md).\n\n## Typical event flow\n\nFor a normal navigation, the events usually flow like this:\n\n1. `onBeforeNavigate`\n2. `onBeforeLoad`\n3. `onLoad`\n4. `onBeforeRouteMount`\n5. `onResolved`\n6. `onRendered`\n\nYou usually do not need every event. A good rule of thumb is:\n\n- Use `onBeforeNavigate` or `onBeforeLoad` to observe navigation start\n- Use `onResolved` for analytics and cleanup after navigation finishes\n- Use `onRendered` for DOM-dependent work\n\n## Event payload\n\nNavigation events receive location change metadata describing what changed:\n\n```tsx\nconst unsubscribe = router.subscribe('onBeforeNavigate', (event) => {\n  console.info({\n    from: event.fromLocation?.href,\n    to: event.toLocation.href,\n    pathChanged: event.pathChanged,\n    hrefChanged: event.hrefChanged,\n    hashChanged: event.hashChanged,\n  })\n})\n```\n\nA few useful details:\n\n- `fromLocation` can be `undefined` on the initial load\n- `pathChanged` tells you whether the pathname changed\n- `hrefChanged` includes pathname, search, and hash changes\n- `hashChanged` is useful for distinguishing hash-only navigations\n\n## Common patterns\n\n### Track pageviews\n\n`onResolved` is a good default for analytics because it fires after navigation finishes:\n\n```tsx\nconst unsubscribe = router.subscribe('onResolved', ({ toLocation }) => {\n  analytics.track('page_view', {\n    path: toLocation.pathname,\n    href: toLocation.href,\n  })\n})\n```\n\n### Clear external mutation state\n\nIf you use a mutation library without keyed mutation state, clear it after navigation:\n\n```tsx\nconst unsubscribe = router.subscribe('onResolved', ({ pathChanged }) => {\n  if (pathChanged) {\n    mutationCache.clear()\n  }\n})\n```\n\n### Run DOM-dependent logic\n\nUse `onRendered` when your side effect depends on the new route content already being in the DOM:\n\n```tsx\nconst unsubscribe = router.subscribe('onRendered', ({ toLocation }) => {\n  focusPageHeading(toLocation.pathname)\n})\n```\n\n## Unsubscribing in components\n\nIf you subscribe from a component or framework effect, always return the unsubscribe function from your cleanup so the listener is removed when the component unmounts.\n\n## Related APIs\n\n- [`Router` type](../api/router/RouterType.md)\n- [`RouterEvents` type](../api/router/RouterEventsType.md)\n- [Data Mutations](./data-mutations.md)\n","originalRawMarkdown":"---\ntitle: Router Events\n---\n\nTanStack Router exposes router lifecycle events through `router.subscribe`. This is useful for imperative side effects like analytics, resetting external state, or running DOM-dependent logic after navigation.\n\n## Basic usage\n\n`router.subscribe` takes an event name and a listener, then returns an unsubscribe function:\n\n```tsx\nconst unsubscribe = router.subscribe('onResolved', (event) => {\n  console.info('Navigation finished:', event.toLocation.href)\n})\n\n// Later, clean up the listener\nunsubscribe()\n```\n\n## When to use it\n\n`router.subscribe` is best for imperative integrations that need to observe navigation without driving rendering:\n\n- Analytics and pageview tracking\n- Resetting external caches or mutation state\n- Logging navigation timing and transitions\n- Running DOM-dependent logic after routes render\n\nIf you need reactive UI updates, prefer framework hooks like `useRouterState`, `useSearch`, and `useParams` instead of subscribing manually.\n\n## Available events\n\nTanStack Router emits these lifecycle events:\n\n- `onBeforeNavigate` - right before a navigation begins\n- `onBeforeLoad` - before route loading starts\n- `onLoad` - after the next location has committed and route matches have loaded\n- `onBeforeRouteMount` - after loading finishes, just before route components mount\n- `onResolved` - after the navigation has fully resolved\n- `onRendered` - after the route has rendered\n\nFor the full event payload types, see the [`RouterEvents` type](../api/router/RouterEventsType.md).\n\n## Typical event flow\n\nFor a normal navigation, the events usually flow like this:\n\n1. `onBeforeNavigate`\n2. `onBeforeLoad`\n3. `onLoad`\n4. `onBeforeRouteMount`\n5. `onResolved`\n6. `onRendered`\n\nYou usually do not need every event. A good rule of thumb is:\n\n- Use `onBeforeNavigate` or `onBeforeLoad` to observe navigation start\n- Use `onResolved` for analytics and cleanup after navigation finishes\n- Use `onRendered` for DOM-dependent work\n\n## Event payload\n\nNavigation events receive location change metadata describing what changed:\n\n```tsx\nconst unsubscribe = router.subscribe('onBeforeNavigate', (event) => {\n  console.info({\n    from: event.fromLocation?.href,\n    to: event.toLocation.href,\n    pathChanged: event.pathChanged,\n    hrefChanged: event.hrefChanged,\n    hashChanged: event.hashChanged,\n  })\n})\n```\n\nA few useful details:\n\n- `fromLocation` can be `undefined` on the initial load\n- `pathChanged` tells you whether the pathname changed\n- `hrefChanged` includes pathname, search, and hash changes\n- `hashChanged` is useful for distinguishing hash-only navigations\n\n## Common patterns\n\n### Track pageviews\n\n`onResolved` is a good default for analytics because it fires after navigation finishes:\n\n```tsx\nconst unsubscribe = router.subscribe('onResolved', ({ toLocation }) => {\n  analytics.track('page_view', {\n    path: toLocation.pathname,\n    href: toLocation.href,\n  })\n})\n```\n\n### Clear external mutation state\n\nIf you use a mutation library without keyed mutation state, clear it after navigation:\n\n```tsx\nconst unsubscribe = router.subscribe('onResolved', ({ pathChanged }) => {\n  if (pathChanged) {\n    mutationCache.clear()\n  }\n})\n```\n\n### Run DOM-dependent logic\n\nUse `onRendered` when your side effect depends on the new route content already being in the DOM:\n\n```tsx\nconst unsubscribe = router.subscribe('onRendered', ({ toLocation }) => {\n  focusPageHeading(toLocation.pathname)\n})\n```\n\n## Unsubscribing in components\n\nIf you subscribe from a component or framework effect, always return the unsubscribe function from your cleanup so the listener is removed when the component unmounts.\n\n## Related APIs\n\n- [`Router` type](../api/router/RouterType.md)\n- [`RouterEvents` type](../api/router/RouterEventsType.md)\n- [Data Mutations](./data-mutations.md)\n"}
