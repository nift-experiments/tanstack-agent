---
title: Search Params
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Similar to how TanStack Query made handling server-state in your React and Solid applications a breeze, TanStack Router aims to unlock the power of URL search params in your applications."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"🧠 If you are on a really old browser, like IE11, you may need to use a polyfill for "},{"type":"inlineCode","value":"URLSearchParams"},{"type":"text","value":"."}]}]},{"type":"heading","depth":2,"id":"why-not-just-use-urlsearchparams","children":[{"type":"text","value":"Why not just use "},{"type":"inlineCode","value":"URLSearchParams"},{"type":"text","value":"?"}]},{"type":"paragraph","children":[{"type":"text","value":"We get it, you've been hearing a lot of \"use the platform\" lately and for the most part, we agree. However, we also believe it's important to recognize where the platform falls short for more advanced use-cases and we believe "},{"type":"inlineCode","value":"URLSearchParams"},{"type":"text","value":" is one of these circumstances."}]},{"type":"paragraph","children":[{"type":"text","value":"Traditional Search Param APIs usually assume a few things:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Search params are always strings"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"They are "},{"type":"emphasis","children":[{"type":"text","value":"mostly"}]},{"type":"text","value":" flat"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Serializing and deserializing using "},{"type":"inlineCode","value":"URLSearchParams"},{"type":"text","value":" is good enough (Spoiler alert: it's not.)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Search params modifications are tightly coupled with the URL's pathname and must be updated together, even if the pathname is not changing."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Reality is very different from these assumptions though."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Search params represent application state, so inevitably, we will expect them to have the same DX associated with other state managers. This means having the capability of distinguishing between primitive value types and efficiently storing and manipulating complex data structures like nested arrays and objects."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"There are many ways to serialize and deserialize state with different tradeoffs. You should be able to choose the best one for your application or at the very least get a better default than "},{"type":"inlineCode","value":"URLSearchParams"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Immutability & Structural Sharing. Every time you stringify and parse url search params, referential integrity and object identity is lost because each new parse creates a brand new data structure with a unique memory reference. If not properly managed over its lifetime, this constant serialization and parsing can result in unexpected and undesirable performance issues, especially in frameworks like React that choose to track reactivity via immutability or in Solid that normally relies on reconciliation to detect changes from deserialized data sources."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Search params, while an important part of the URL, do frequently change independently of the URL's pathname. For example, a user may want to change the page number of a paginated list without touching the URL's pathname."}]}]}]},{"type":"heading","depth":2,"id":"search-params-the-og-state-manager","children":[{"type":"text","value":"Search Params, the \"OG\" State Manager"}]},{"type":"paragraph","children":[{"type":"text","value":"You've probably seen search params like "},{"type":"inlineCode","value":"?page=3"},{"type":"text","value":" or "},{"type":"inlineCode","value":"?filter-name=tanner"},{"type":"text","value":" in the URL. There is no question that this is truly "},{"type":"strong","children":[{"type":"text","value":"a form of global state"}]},{"type":"text","value":" living inside of the URL. It's valuable to store specific pieces of state in the URL because:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Users should be able to:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Cmd/Ctrl + Click to open a link in a new tab and reliably see the state they expected"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Bookmark and share links from your application with others with assurances that they will see exactly the state as when the link was copied."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Refresh your app or navigate back and forth between pages without losing their state"}]}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Developers should be able to easily:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add, remove or modify state in the URL with the same great DX as other state managers"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Easily validate search params coming from the URL in a format and type that is safe for their application to consume"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Read and write to search params without having to worry about the underlying serialization format"}]}]}]}]}]},{"type":"heading","depth":2,"id":"json-first-search-params","children":[{"type":"text","value":"JSON-first Search Params"}]},{"type":"paragraph","children":[{"type":"text","value":"To achieve the above, the first step built in to TanStack Router is a powerful search param parser that automatically converts the search string of your URL to structured JSON. This means that you can store any JSON-serializable data structure in your search params and it will be parsed and serialized as JSON. This is a huge improvement over "},{"type":"inlineCode","value":"URLSearchParams"},{"type":"text","value":" which has limited support for array-like structures and nested data."}]},{"type":"paragraph","children":[{"type":"text","value":"For example, navigating to the following route:"}]},{"type":"code","value":"const link = (\n  <Link\n    to=\"/shop\"\n    search={{\n      pageIndex: 3,\n      includeCategories: ['electronics', 'gifts'],\n      sortBy: 'price',\n      desc: true,\n    }}\n  />\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Will result in the following URL:"}]},{"type":"code","value":"/shop?pageIndex=3&includeCategories=%5B%22electronics%22%2C%22gifts%22%5D&sortBy=price&desc=true"},{"type":"paragraph","children":[{"type":"text","value":"When this URL is parsed, the search params will be accurately converted back to the following JSON:"}]},{"type":"code","value":"{\n  \"pageIndex\": 3,\n  \"includeCategories\": [\"electronics\", \"gifts\"],\n  \"sortBy\": \"price\",\n  \"desc\": true\n}","lang":"json"},{"type":"paragraph","children":[{"type":"text","value":"If you noticed, there are a few things going on here:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The first level of the search params is flat and string based, just like "},{"type":"inlineCode","value":"URLSearchParams"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"First level values that are not strings are accurately preserved as actual numbers and booleans."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Nested data structures are automatically converted to URL-safe JSON strings"}]}]}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"🧠 It's common for other tools to assume that search params are always flat and string-based which is why we've chosen to keep things URLSearchParam compliant at the first level. This ultimately means that even though TanStack Router is managing your nested search params as JSON, other tools will still be able to write to the URL and read first-level params normally."}]}]},{"type":"heading","depth":2,"id":"validating-and-typing-search-params","children":[{"type":"text","value":"Validating and Typing Search Params"}]},{"type":"paragraph","children":[{"type":"text","value":"Despite TanStack Router being able to parse search params into reliable JSON, they ultimately still came from "},{"type":"strong","children":[{"type":"text","value":"a user-facing raw-text input"}]},{"type":"text","value":". Similar to other serialization boundaries, this means that before you consume search params, they should be validated into a format that your application can trust and rely on."}]},{"type":"heading","depth":3,"id":"enter-validation-typescript","children":[{"type":"text","value":"Enter Validation + TypeScript!"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Router provides convenient APIs for validating and typing search params. This all starts with the "},{"type":"inlineCode","value":"Route"},{"type":"text","value":"'s "},{"type":"inlineCode","value":"validateSearch"},{"type":"text","value":" option:"}]},{"type":"code","value":"type ProductSearchSortOptions = 'newest' | 'oldest' | 'price'\n\ntype ProductSearch = {\n  page: number\n  filter: string\n  sort: ProductSearchSortOptions\n}\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: (search: Record<string, unknown>): ProductSearch => {\n    // validate and parse the search params into a typed state\n    return {\n      page: Number(search?.page ?? 1),\n      filter: (search.filter as string) || '',\n      sort: (search.sort as ProductSearchSortOptions) || 'newest',\n    }\n  },\n})","lang":"tsx","meta":"title=\"src/routes/shop/products.tsx\"","title":"src/routes/shop/products.tsx","file":"src/routes/shop/products.tsx"},{"type":"paragraph","children":[{"type":"text","value":"In the above example, we're validating the search params of the "},{"type":"inlineCode","value":"Route"},{"type":"text","value":" and returning a typed "},{"type":"inlineCode","value":"ProductSearch"},{"type":"text","value":" object. This typed object is then made available to this route's other options "},{"type":"strong","children":[{"type":"text","value":"and any child routes, too!"}]}]},{"type":"heading","depth":3,"id":"validating-search-params","children":[{"type":"text","value":"Validating Search Params"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"validateSearch"},{"type":"text","value":" option is a function that is provided the JSON parsed (but non-validated) search params as a "},{"type":"inlineCode","value":"Record<string, unknown>"},{"type":"text","value":" and returns a typed object of your choice. It's usually best to provide sensible fallbacks for malformed or unexpected search params so your users' experience stays non-interrupted."}]},{"type":"paragraph","children":[{"type":"text","value":"Here's an example:"}]},{"type":"code","value":"type ProductSearchSortOptions = 'newest' | 'oldest' | 'price'\n\ntype ProductSearch = {\n  page: number\n  filter: string\n  sort: ProductSearchSortOptions\n}\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: (search: Record<string, unknown>): ProductSearch => {\n    // validate and parse the search params into a typed state\n    return {\n      page: Number(search?.page ?? 1),\n      filter: (search.filter as string) || '',\n      sort: (search.sort as ProductSearchSortOptions) || 'newest',\n    }\n  },\n})","lang":"tsx","meta":"title=\"src/routes/shop/products.tsx\"","title":"src/routes/shop/products.tsx","file":"src/routes/shop/products.tsx"},{"type":"paragraph","children":[{"type":"text","value":"Here's an example using the "},{"type":"link","href":"https://zod.dev/","children":[{"type":"text","value":"Zod"}]},{"type":"text","value":" library (but feel free to use any validation library you want) to both validate and type the search params in a single step:"}]},{"type":"code","value":"import { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().catch(1),\n  filter: z.string().catch(''),\n  sort: z.enum(['newest', 'oldest', 'price']).catch('newest'),\n})\n\ntype ProductSearch = z.infer<typeof productSearchSchema>\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: (search) => productSearchSchema.parse(search),\n})","lang":"tsx","meta":"title=\"src/routes/shop/products.tsx\"","title":"src/routes/shop/products.tsx","file":"src/routes/shop/products.tsx"},{"type":"paragraph","children":[{"type":"text","value":"Because "},{"type":"inlineCode","value":"validateSearch"},{"type":"text","value":" also accepts an object with the "},{"type":"inlineCode","value":"parse"},{"type":"text","value":" property, this can be shortened to:"}]},{"type":"code","value":"validateSearch: productSearchSchema","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"In the above example, we used Zod's "},{"type":"inlineCode","value":".catch()"},{"type":"text","value":" modifier instead of "},{"type":"inlineCode","value":".default()"},{"type":"text","value":" to avoid showing an error to the user because we firmly believe that if a search parameter is malformed, you probably don't want to halt the user's experience through the app to show a big fat error message. That said, there may be times that you "},{"type":"strong","children":[{"type":"text","value":"do want to show an error message"}]},{"type":"text","value":". In that case, you can use "},{"type":"inlineCode","value":".default()"},{"type":"text","value":" instead of "},{"type":"inlineCode","value":".catch()"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The underlying mechanics why this works relies on the "},{"type":"inlineCode","value":"validateSearch"},{"type":"text","value":" function throwing an error. If an error is thrown, the route's "},{"type":"inlineCode","value":"onError"},{"type":"text","value":" option will be triggered (and "},{"type":"inlineCode","value":"error.routerCode"},{"type":"text","value":" will be set to "},{"type":"inlineCode","value":"VALIDATE_SEARCH"},{"type":"text","value":" and the "},{"type":"inlineCode","value":"errorComponent"},{"type":"text","value":" will be rendered instead of the route's "},{"type":"inlineCode","value":"component"},{"type":"text","value":" where you can handle the search param error however you'd like."}]},{"type":"heading","depth":4,"id":"adapters","children":[{"type":"text","value":"Adapters"}]},{"type":"paragraph","children":[{"type":"text","value":"When using a library like "},{"type":"link","href":"https://zod.dev/","children":[{"type":"text","value":"Zod"}]},{"type":"text","value":" to validate search params you might want to "},{"type":"inlineCode","value":"transform"},{"type":"text","value":" search params before committing the search params to the URL. A common "},{"type":"inlineCode","value":"zod"},{"type":"text","value":" "},{"type":"inlineCode","value":"transform"},{"type":"text","value":" is "},{"type":"inlineCode","value":"default"},{"type":"text","value":" for example."}]},{"type":"code","value":"import { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  filter: z.string().default(''),\n  sort: z.enum(['newest', 'oldest', 'price']).default('newest'),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"It might be surprising that when you try to navigate to this route, "},{"type":"inlineCode","value":"search"},{"type":"text","value":" is required. The following "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" will type error as "},{"type":"inlineCode","value":"search"},{"type":"text","value":" is missing."}]},{"type":"code","value":"<Link to=\"/shop/products\" />","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"For validation libraries we recommend using adapters which infer the correct "},{"type":"inlineCode","value":"input"},{"type":"text","value":" and "},{"type":"inlineCode","value":"output"},{"type":"text","value":" types."}]},{"type":"heading","depth":3,"id":"zod","children":[{"type":"text","value":"Zod"}]},{"type":"paragraph","children":[{"type":"text","value":"An adapter is provided for "},{"type":"link","href":"https://zod.dev/","children":[{"type":"text","value":"Zod"}]},{"type":"text","value":" which will pipe through the correct "},{"type":"inlineCode","value":"input"},{"type":"text","value":" type and "},{"type":"inlineCode","value":"output"},{"type":"text","value":" type."}]},{"type":"paragraph","children":[{"type":"text","value":"For Zod v3:"}]},{"type":"code","value":"import { zodValidator } from '@tanstack/zod-adapter'\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  filter: z.string().default(''),\n  sort: z.enum(['newest', 'oldest', 'price']).default('newest'),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: zodValidator(productSearchSchema),\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"With Zod v4, you should directly use the schema in "},{"type":"inlineCode","value":"validateSearch"},{"type":"text","value":":"}]},{"type":"code","value":"import { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  filter: z.string().default(''),\n  sort: z.enum(['newest', 'oldest', 'price']).default('newest'),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  // With Zod v4, we can use the schema without the adapter\n  validateSearch: productSearchSchema,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The important part here is the following use of "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" no longer requires "},{"type":"inlineCode","value":"search"},{"type":"text","value":" params:"}]},{"type":"code","value":"<Link to=\"/shop/products\" />","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"In Zod v3, the use of "},{"type":"inlineCode","value":"catch"},{"type":"text","value":" here overrides the types and makes "},{"type":"inlineCode","value":"page"},{"type":"text","value":", "},{"type":"inlineCode","value":"filter"},{"type":"text","value":" and "},{"type":"inlineCode","value":"sort"},{"type":"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" causing type loss. We have handled this case by providing a "},{"type":"inlineCode","value":"fallback"},{"type":"text","value":" generic function which retains the types but provides a "},{"type":"inlineCode","value":"fallback"},{"type":"text","value":" value when validation fails:"}]},{"type":"code","value":"import { fallback, zodValidator } from '@tanstack/zod-adapter'\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: fallback(z.number(), 1).default(1),\n  filter: fallback(z.string(), '').default(''),\n  sort: fallback(z.enum(['newest', 'oldest', 'price']), 'newest').default(\n    'newest',\n  ),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: zodValidator(productSearchSchema),\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Therefore when navigating to this route, "},{"type":"inlineCode","value":"search"},{"type":"text","value":" is optional and retains the correct types."}]},{"type":"paragraph","children":[{"type":"text","value":"In Zod v4, schemas may use "},{"type":"inlineCode","value":"catch"},{"type":"text","value":" instead of the fallback and will retain type inference throughout."}]},{"type":"paragraph","children":[{"type":"text","value":"While not recommended, it is also possible to configure "},{"type":"inlineCode","value":"input"},{"type":"text","value":" and "},{"type":"inlineCode","value":"output"},{"type":"text","value":" type in case the "},{"type":"inlineCode","value":"output"},{"type":"text","value":" type is more accurate than the "},{"type":"inlineCode","value":"input"},{"type":"text","value":" type:"}]},{"type":"code","value":"const productSearchSchema = z.object({\n  page: fallback(z.number(), 1).default(1),\n  filter: fallback(z.string(), '').default(''),\n  sort: fallback(z.enum(['newest', 'oldest', 'price']), 'newest').default(\n    'newest',\n  ),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: zodValidator({\n    schema: productSearchSchema,\n    input: 'output',\n    output: 'input',\n  }),\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"This provides flexibility in which type you want to infer for navigation and which types you want to infer for reading search params."}]},{"type":"heading","depth":3,"id":"valibot","children":[{"type":"text","value":"Valibot"}]},{"type":"callout","kind":"warning","title":"Warning","children":[{"type":"paragraph","children":[{"type":"text","value":"Router expects the valibot 1.0 package to be installed."}]}]},{"type":"paragraph","children":[{"type":"text","value":"When using "},{"type":"link","href":"https://valibot.dev/","children":[{"type":"text","value":"Valibot"}]},{"type":"text","value":" an adapter is not needed to ensure the correct "},{"type":"inlineCode","value":"input"},{"type":"text","value":" and "},{"type":"inlineCode","value":"output"},{"type":"text","value":" types are used for navigation and reading search params. This is because "},{"type":"inlineCode","value":"valibot"},{"type":"text","value":" implements "},{"type":"link","href":"https://github.com/standard-schema/standard-schema","children":[{"type":"text","value":"Standard Schema"}]}]},{"type":"code","value":"import * as v from 'valibot'\n\nconst productSearchSchema = v.object({\n  page: v.optional(v.fallback(v.number(), 1), 1),\n  filter: v.optional(v.fallback(v.string(), ''), ''),\n  sort: v.optional(\n    v.fallback(v.picklist(['newest', 'oldest', 'price']), 'newest'),\n    'newest',\n  ),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"arktype","children":[{"type":"text","value":"Arktype"}]},{"type":"callout","kind":"warning","title":"Warning","children":[{"type":"paragraph","children":[{"type":"text","value":"Router expects the arktype 2.0-rc package to be installed."}]}]},{"type":"paragraph","children":[{"type":"text","value":"When using "},{"type":"link","href":"https://arktype.io/","children":[{"type":"text","value":"ArkType"}]},{"type":"text","value":" an adapter is not needed to ensure the correct "},{"type":"inlineCode","value":"input"},{"type":"text","value":" and "},{"type":"inlineCode","value":"output"},{"type":"text","value":" types are used for navigation and reading search params. This is because "},{"type":"link","href":"https://arktype.io/","children":[{"type":"text","value":"ArkType"}]},{"type":"text","value":" implements "},{"type":"link","href":"https://github.com/standard-schema/standard-schema","children":[{"type":"text","value":"Standard Schema"}]}]},{"type":"code","value":"import { type } from 'arktype'\n\nconst productSearchSchema = type({\n  page: 'number = 1',\n  filter: 'string = \"\"',\n  sort: '\"newest\" | \"oldest\" | \"price\" = \"newest\"',\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"effect-schema","children":[{"type":"text","value":"Effect/Schema"}]},{"type":"paragraph","children":[{"type":"text","value":"When using "},{"type":"link","href":"https://effect.website/docs/schema/introduction/","children":[{"type":"text","value":"Effect/Schema"}]},{"type":"text","value":" an adapter is not needed to ensure the correct "},{"type":"inlineCode","value":"input"},{"type":"text","value":" and "},{"type":"inlineCode","value":"output"},{"type":"text","value":" types are used for navigation and reading search params. This is because "},{"type":"link","href":"https://effect.website/docs/schema/standard-schema/","children":[{"type":"text","value":"Effect/Schema"}]},{"type":"text","value":" implements "},{"type":"link","href":"https://github.com/standard-schema/standard-schema","children":[{"type":"text","value":"Standard Schema"}]}]},{"type":"code","value":"import { Schema as S } from 'effect'\n\nconst productSearchSchema = S.standardSchemaV1(\n  S.Struct({\n    page: S.NumberFromString.pipe(\n      S.optional,\n      S.withDefaults({\n        constructor: () => 1,\n        decoding: () => 1,\n      }),\n    ),\n    filter: S.String.pipe(\n      S.optional,\n      S.withDefaults({\n        constructor: () => '',\n        decoding: () => '',\n      }),\n    ),\n    sort: S.Literal('newest', 'oldest', 'price').pipe(\n      S.optional,\n      S.withDefaults({\n        constructor: () => 'newest' as const,\n        decoding: () => 'newest' as const,\n      }),\n    ),\n  }),\n)\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"reading-search-params","children":[{"type":"text","value":"Reading Search Params"}]},{"type":"paragraph","children":[{"type":"text","value":"Once your search params have been validated and typed, you're finally ready to start reading and writing to them. There are a few ways to do this in TanStack Router, so let's check them out."}]},{"type":"heading","depth":3,"id":"using-search-params-in-loaders","children":[{"type":"text","value":"Using Search Params in Loaders"}]},{"type":"paragraph","children":[{"type":"text","value":"Please read the "},{"type":"link","href":"./data-loading.md#using-loaderdeps-to-access-search-params","children":[{"type":"text","value":"Search Params in Loaders"}]},{"type":"text","value":" section for more information about how to read search params in loaders with the "},{"type":"inlineCode","value":"loaderDeps"},{"type":"text","value":" option."}]},{"type":"heading","depth":3,"id":"search-params-are-inherited-from-parent-routes","children":[{"type":"text","value":"Search Params are inherited from Parent Routes"}]},{"type":"paragraph","children":[{"type":"text","value":"The search parameters and types of parents are merged as you go down the route tree, so child routes also have access to their parent's search params:"}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"const productSearchSchema = z.object({\n  page: z.number().catch(1),\n  filter: z.string().catch(''),\n  sort: z.enum(['newest', 'oldest', 'price']).catch('newest'),\n})\n\ntype ProductSearch = z.infer<typeof productSearchSchema>\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n})","lang":"tsx","meta":"title=\"src/routes/shop/products.tsx\"","title":"src/routes/shop/products.tsx","file":"src/routes/shop/products.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"export const Route = createFileRoute('/shop/products/$productId')({\n  beforeLoad: ({ search }) => {\n    search\n    // ^? ProductSearch ✅\n  },\n})","lang":"tsx","meta":"title=\"src/routes/shop/products/$productId.tsx\"","title":"src/routes/shop/products/$productId.tsx","file":"src/routes/shop/products/$productId.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/shop/products.tsx\"},{\"slug\":\"file-1\",\"name\":\"src/routes/shop/products/$productId.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/shop/products.tsx\",\"code\":\"const productSearchSchema = z.object({\\n  page: z.number().catch(1),\\n  filter: z.string().catch(''),\\n  sort: z.enum(['newest', 'oldest', 'price']).catch('newest'),\\n})\\n\\ntype ProductSearch = z.infer<typeof productSearchSchema>\\n\\nexport const Route = createFileRoute('/shop/products')({\\n  validateSearch: productSearchSchema,\\n})\",\"language\":\"tsx\"},{\"title\":\"src/routes/shop/products/$productId.tsx\",\"code\":\"export const Route = createFileRoute('/shop/products/$productId')({\\n  beforeLoad: ({ search }) => {\\n    search\\n    // ^? ProductSearch ✅\\n  },\\n})\",\"language\":\"tsx\"}]}"}},{"type":"heading","depth":3,"id":"search-params-in-components","children":[{"type":"text","value":"Search Params in Components"}]},{"type":"paragraph","children":[{"type":"text","value":"You can access your route's validated search params in your route's "},{"type":"inlineCode","value":"component"},{"type":"text","value":" via the "},{"type":"inlineCode","value":"useSearch"},{"type":"text","value":" hook."}]},{"type":"code","value":"export const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n})\n\nconst ProductList = () => {\n  const { page, filter, sort } = Route.useSearch()\n\n  return <div>...</div>\n}","lang":"tsx","meta":"title=\"src/routes/shop/products.tsx\"","title":"src/routes/shop/products.tsx","file":"src/routes/shop/products.tsx"},{"type":"callout","kind":"tip","title":"Tip","children":[{"type":"paragraph","children":[{"type":"text","value":"If your component is code-split, you can use the "},{"type":"link","href":"./code-splitting.md#manually-accessing-route-apis-in-other-files-with-the-getrouteapi-helper","children":[{"type":"text","value":"getRouteApi function"}]},{"type":"text","value":" to avoid having to import the "},{"type":"inlineCode","value":"Route"},{"type":"text","value":" configuration to get access to the typed "},{"type":"inlineCode","value":"useSearch()"},{"type":"text","value":" hook."}]}]},{"type":"heading","depth":3,"id":"search-params-outside-of-route-components","children":[{"type":"text","value":"Search Params outside of Route Components"}]},{"type":"paragraph","children":[{"type":"text","value":"You can access your route's validated search params anywhere in your app using the "},{"type":"inlineCode","value":"useSearch"},{"type":"text","value":" hook. By passing the "},{"type":"inlineCode","value":"from"},{"type":"text","value":" id/path of your origin route, you'll get even better type safety:"}]},{"type":"code","value":"// src/routes/shop.products.tsx\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n  // ...\n})\n\n// Somewhere else...\n\n// src/components/product-list-sidebar.tsx\nconst routeApi = getRouteApi('/shop/products')\n\nconst ProductList = () => {\n  const routeSearch = routeApi.useSearch()\n\n  // OR\n\n  const { page, filter, sort } = useSearch({\n    from: Route.fullPath,\n  })\n\n  return <div>...</div>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Or, you can loosen up the type-safety and get an optional "},{"type":"inlineCode","value":"search"},{"type":"text","value":" object by passing "},{"type":"inlineCode","value":"strict: false"},{"type":"text","value":":"}]},{"type":"code","value":"function ProductList() {\n  const search = useSearch({\n    strict: false,\n  })\n  // {\n  //   page: number | undefined\n  //   filter: string | undefined\n  //   sort: 'newest' | 'oldest' | 'price' | undefined\n  // }\n\n  return <div>...</div>\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"writing-search-params","children":[{"type":"text","value":"Writing Search Params"}]},{"type":"paragraph","children":[{"type":"text","value":"Now that you've learned how to read your route's search params, you'll be happy to know that you've already seen the primary APIs to modify and update them. Let's remind ourselves a bit"}]},{"type":"heading","depth":3,"id":"link-search","children":[{"type":"inlineCode","value":"<Link search />"}]},{"type":"paragraph","children":[{"type":"text","value":"The best way to update search params is to use the "},{"type":"inlineCode","value":"search"},{"type":"text","value":" prop on the "},{"type":"inlineCode","value":"<Link />"},{"type":"text","value":" component."}]},{"type":"paragraph","children":[{"type":"text","value":"If the search for the current page shall be updated and the "},{"type":"inlineCode","value":"from"},{"type":"text","value":" prop is specified, the "},{"type":"inlineCode","value":"to"},{"type":"text","value":" prop can be omitted.\nHere's an example:"}]},{"type":"code","value":"export const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n})\n\nconst ProductList = () => {\n  return (\n    <div>\n      <Link from={Route.fullPath} search={(prev) => ({ page: prev.page + 1 })}>\n        Next Page\n      </Link>\n    </div>\n  )\n}","lang":"tsx","meta":"title=\"src/routes/shop/products.tsx\"","title":"src/routes/shop/products.tsx","file":"src/routes/shop/products.tsx"},{"type":"paragraph","children":[{"type":"text","value":"If you want to update the search params in a generic component that is rendered on multiple routes, specifying "},{"type":"inlineCode","value":"from"},{"type":"text","value":" can be challenging."}]},{"type":"paragraph","children":[{"type":"text","value":"In this scenario you can set "},{"type":"inlineCode","value":"to=\".\""},{"type":"text","value":" which will give you access to loosely typed search params.\nHere is an example that illustrates this:"}]},{"type":"code","value":"// `page` is a search param that is defined in the __root route and hence available on all routes.\nconst PageSelector = () => {\n  return (\n    <div>\n      <Link to=\".\" search={(prev) => ({ ...prev, page: prev.page + 1 })}>\n        Next Page\n      </Link>\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If the generic component is only rendered in a specific subtree of the route tree, you can specify that subtree using "},{"type":"inlineCode","value":"from"},{"type":"text","value":". Here you can omit "},{"type":"inlineCode","value":"to='.'"},{"type":"text","value":" if you want."}]},{"type":"code","value":"// `page` is a search param that is defined in the /posts route and hence available on all of its child routes.\nconst PageSelector = () => {\n  return (\n    <div>\n      <Link\n        from=\"/posts\"\n        to=\".\"\n        search={(prev) => ({ ...prev, page: prev.page + 1 })}\n      >\n        Next Page\n      </Link>\n    </div>\n  )","lang":"tsx"},{"type":"heading","depth":3,"id":"usenavigate-navigate-search","children":[{"type":"inlineCode","value":"useNavigate(), navigate({ search })"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"navigate"},{"type":"text","value":" function also accepts a "},{"type":"inlineCode","value":"search"},{"type":"text","value":" option that works the same way as the "},{"type":"inlineCode","value":"search"},{"type":"text","value":" prop on "},{"type":"inlineCode","value":"<Link />"},{"type":"text","value":":"}]},{"type":"code","value":"export const Route = createFileRoute('/shop/products/$productId')({\n  validateSearch: productSearchSchema,\n})\n\nconst ProductList = () => {\n  const navigate = useNavigate({ from: Route.fullPath })\n\n  return (\n    <div>\n      <button\n        onClick={() => {\n          navigate({\n            search: (prev) => ({ page: prev.page + 1 }),\n          })\n        }}\n      >\n        Next Page\n      </button>\n    </div>\n  )\n}","lang":"tsx","meta":"title=\"src/routes/shop/products.tsx\"","title":"src/routes/shop/products.tsx","file":"src/routes/shop/products.tsx"},{"type":"heading","depth":3,"id":"router-navigate-search","children":[{"type":"inlineCode","value":"router.navigate({ search })"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"router.navigate"},{"type":"text","value":" function works exactly the same way as the "},{"type":"inlineCode","value":"useNavigate"},{"type":"text","value":"/"},{"type":"inlineCode","value":"navigate"},{"type":"text","value":" hook/function above."}]},{"type":"heading","depth":3,"id":"navigate-search","children":[{"type":"inlineCode","value":"<Navigate search />"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"<Navigate search />"},{"type":"text","value":" component works exactly the same way as the "},{"type":"inlineCode","value":"useNavigate"},{"type":"text","value":"/"},{"type":"inlineCode","value":"navigate"},{"type":"text","value":" hook/function above, but accepts its options as props instead of a function argument."}]},{"type":"heading","depth":2,"id":"transforming-search-with-search-middlewares","children":[{"type":"text","value":"Transforming search with search middlewares"}]},{"type":"paragraph","children":[{"type":"text","value":"When link hrefs are built, by default the only thing that matters for the query string part is the "},{"type":"inlineCode","value":"search"},{"type":"text","value":" property of a "},{"type":"inlineCode","value":"<Link>"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Router provides a way to manipulate search params before the href is generated via "},{"type":"strong","children":[{"type":"text","value":"search middlewares"}]},{"type":"text","value":".\nSearch middlewares are functions that transform the search parameters when generating new links for a route or its descendants.\nThey are also executed upon navigation after search validation to allow manipulation of the query string."}]},{"type":"paragraph","children":[{"type":"text","value":"The following example shows how to make sure that for "},{"type":"strong","children":[{"type":"text","value":"every"}]},{"type":"text","value":" link that is being built, the "},{"type":"inlineCode","value":"rootValue"},{"type":"text","value":" search param is added "},{"type":"emphasis","children":[{"type":"text","value":"if"}]},{"type":"text","value":" it is part of the current search params. If a link specifies "},{"type":"inlineCode","value":"rootValue"},{"type":"text","value":" inside "},{"type":"inlineCode","value":"search"},{"type":"text","value":", then that value is used for building the link."}]},{"type":"code","value":"import { z } from 'zod'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    middlewares: [\n      ({ search, next }) => {\n        const result = next(search)\n        return {\n          rootValue: search.rootValue,\n          ...result,\n        }\n      },\n    ],\n  },\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Since this specific use case is quite common, TanStack Router provides a generic implementation to retain search params via "},{"type":"inlineCode","value":"retainSearchParams"},{"type":"text","value":":"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { z } from 'zod'\nimport { createFileRoute, retainSearchParams } from '@tanstack/react-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    middlewares: [retainSearchParams(['rootValue'])],\n  },\n})","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import { z } from 'zod'\nimport { createFileRoute, retainSearchParams } from '@tanstack/solid-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    middlewares: [retainSearchParams(['rootValue'])],\n  },\n})","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { z } from 'zod'\\nimport { createFileRoute, retainSearchParams } from '@tanstack/react-router'\\nimport { zodValidator } from '@tanstack/zod-adapter'\\n\\nconst searchSchema = z.object({\\n  rootValue: z.string().optional(),\\n})\\n\\nexport const Route = createRootRoute({\\n  validateSearch: zodValidator(searchSchema),\\n  search: {\\n    middlewares: [retainSearchParams(['rootValue'])],\\n  },\\n})\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import { z } from 'zod'\\nimport { createFileRoute, retainSearchParams } from '@tanstack/solid-router'\\nimport { zodValidator } from '@tanstack/zod-adapter'\\n\\nconst searchSchema = z.object({\\n  rootValue: z.string().optional(),\\n})\\n\\nexport const Route = createRootRoute({\\n  validateSearch: zodValidator(searchSchema),\\n  search: {\\n    middlewares: [retainSearchParams(['rootValue'])],\\n  },\\n})\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"Another common use case is to strip out search params from links if their default value is set. TanStack Router provides a generic implementation for this use case via "},{"type":"inlineCode","value":"stripSearchParams"},{"type":"text","value":":"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = {\n  one: 'abc',\n  two: 'xyz',\n}\n\nconst searchSchema = z.object({\n  one: z.string().default(defaultValues.one),\n  two: z.string().default(defaultValues.two),\n})\n\nexport const Route = createFileRoute('/hello')({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    // strip default values\n    middlewares: [stripSearchParams(defaultValues)],\n  },\n})","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/solid-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = {\n  one: 'abc',\n  two: 'xyz',\n}\n\nconst searchSchema = z.object({\n  one: z.string().default(defaultValues.one),\n  two: z.string().default(defaultValues.two),\n})\n\nexport const Route = createFileRoute('/hello')({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    // strip default values\n    middlewares: [stripSearchParams(defaultValues)],\n  },\n})","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { z } from 'zod'\\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\\nimport { zodValidator } from '@tanstack/zod-adapter'\\n\\nconst defaultValues = {\\n  one: 'abc',\\n  two: 'xyz',\\n}\\n\\nconst searchSchema = z.object({\\n  one: z.string().default(defaultValues.one),\\n  two: z.string().default(defaultValues.two),\\n})\\n\\nexport const Route = createFileRoute('/hello')({\\n  validateSearch: zodValidator(searchSchema),\\n  search: {\\n    // strip default values\\n    middlewares: [stripSearchParams(defaultValues)],\\n  },\\n})\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import { z } from 'zod'\\nimport { createFileRoute, stripSearchParams } from '@tanstack/solid-router'\\nimport { zodValidator } from '@tanstack/zod-adapter'\\n\\nconst defaultValues = {\\n  one: 'abc',\\n  two: 'xyz',\\n}\\n\\nconst searchSchema = z.object({\\n  one: z.string().default(defaultValues.one),\\n  two: z.string().default(defaultValues.two),\\n})\\n\\nexport const Route = createFileRoute('/hello')({\\n  validateSearch: zodValidator(searchSchema),\\n  search: {\\n    // strip default values\\n    middlewares: [stripSearchParams(defaultValues)],\\n  },\\n})\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"Multiple middlewares can be chained. The following example shows how to combine both "},{"type":"inlineCode","value":"retainSearchParams"},{"type":"text","value":" and "},{"type":"inlineCode","value":"stripSearchParams"},{"type":"text","value":"."}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import {\n  Link,\n  createFileRoute,\n  retainSearchParams,\n  stripSearchParams,\n} from '@tanstack/react-router'\nimport { z } from 'zod'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = ['foo', 'bar']\n\nexport const Route = createFileRoute('/search')({\n  validateSearch: zodValidator(\n    z.object({\n      retainMe: z.string().optional(),\n      arrayWithDefaults: z.string().array().default(defaultValues),\n      required: z.string(),\n    }),\n  ),\n  search: {\n    middlewares: [\n      retainSearchParams(['retainMe']),\n      stripSearchParams({ arrayWithDefaults: defaultValues }),\n    ],\n  },\n})","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"import {\n  Link,\n  createFileRoute,\n  retainSearchParams,\n  stripSearchParams,\n} from '@tanstack/solid-router'\nimport { z } from 'zod'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = ['foo', 'bar']\n\nexport const Route = createFileRoute('/search')({\n  validateSearch: zodValidator(\n    z.object({\n      retainMe: z.string().optional(),\n      arrayWithDefaults: z.string().array().default(defaultValues),\n      required: z.string(),\n    }),\n  ),\n  search: {\n    middlewares: [\n      retainSearchParams(['retainMe']),\n      stripSearchParams({ arrayWithDefaults: defaultValues }),\n    ],\n  },\n})","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import {\\n  Link,\\n  createFileRoute,\\n  retainSearchParams,\\n  stripSearchParams,\\n} from '@tanstack/react-router'\\nimport { z } from 'zod'\\nimport { zodValidator } from '@tanstack/zod-adapter'\\n\\nconst defaultValues = ['foo', 'bar']\\n\\nexport const Route = createFileRoute('/search')({\\n  validateSearch: zodValidator(\\n    z.object({\\n      retainMe: z.string().optional(),\\n      arrayWithDefaults: z.string().array().default(defaultValues),\\n      required: z.string(),\\n    }),\\n  ),\\n  search: {\\n    middlewares: [\\n      retainSearchParams(['retainMe']),\\n      stripSearchParams({ arrayWithDefaults: defaultValues }),\\n    ],\\n  },\\n})\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"import {\\n  Link,\\n  createFileRoute,\\n  retainSearchParams,\\n  stripSearchParams,\\n} from '@tanstack/solid-router'\\nimport { z } from 'zod'\\nimport { zodValidator } from '@tanstack/zod-adapter'\\n\\nconst defaultValues = ['foo', 'bar']\\n\\nexport const Route = createFileRoute('/search')({\\n  validateSearch: zodValidator(\\n    z.object({\\n      retainMe: z.string().optional(),\\n      arrayWithDefaults: z.string().array().default(defaultValues),\\n      required: z.string(),\\n    }),\\n  ),\\n  search: {\\n    middlewares: [\\n      retainSearchParams(['retainMe']),\\n      stripSearchParams({ arrayWithDefaults: defaultValues }),\\n    ],\\n  },\\n})\",\"language\":\"tsx\"}]}}"}}],"headings":[{"id":"why-not-just-use-urlsearchparams","text":"Why not just use URLSearchParams?","level":2},{"id":"search-params-the-og-state-manager","text":"Search Params, the \"OG\" State Manager","level":2},{"id":"json-first-search-params","text":"JSON-first Search Params","level":2},{"id":"validating-and-typing-search-params","text":"Validating and Typing Search Params","level":2},{"id":"enter-validation-typescript","text":"Enter Validation + TypeScript!","level":3},{"id":"validating-search-params","text":"Validating Search Params","level":3},{"id":"adapters","text":"Adapters","level":4},{"id":"zod","text":"Zod","level":3},{"id":"valibot","text":"Valibot","level":3},{"id":"arktype","text":"Arktype","level":3},{"id":"effect-schema","text":"Effect/Schema","level":3},{"id":"reading-search-params","text":"Reading Search Params","level":2},{"id":"using-search-params-in-loaders","text":"Using Search Params in Loaders","level":3},{"id":"search-params-are-inherited-from-parent-routes","text":"Search Params are inherited from Parent Routes","level":3},{"id":"search-params-in-components","text":"Search Params in Components","level":3},{"id":"search-params-outside-of-route-components","text":"Search Params outside of Route Components","level":3},{"id":"writing-search-params","text":"Writing Search Params","level":2},{"id":"link-search","text":"<Link search />","level":3},{"id":"usenavigate-navigate-search","text":"useNavigate(), navigate({ search })","level":3},{"id":"router-navigate-search","text":"router.navigate({ search })","level":3},{"id":"navigate-search","text":"<Navigate search />","level":3},{"id":"transforming-search-with-search-middlewares","text":"Transforming search with search middlewares","level":2}]},"frameworks":["react","solid"],"downloadMarkdown":"\nSimilar to how TanStack Query made handling server-state in your React and Solid applications a breeze, TanStack Router aims to unlock the power of URL search params in your applications.\n\n> 🧠 If you are on a really old browser, like IE11, you may need to use a polyfill for `URLSearchParams`.\n\n## Why not just use `URLSearchParams`?\n\nWe get it, you've been hearing a lot of \"use the platform\" lately and for the most part, we agree. However, we also believe it's important to recognize where the platform falls short for more advanced use-cases and we believe `URLSearchParams` is one of these circumstances.\n\nTraditional Search Param APIs usually assume a few things:\n\n- Search params are always strings\n- They are _mostly_ flat\n- Serializing and deserializing using `URLSearchParams` is good enough (Spoiler alert: it's not.)\n- Search params modifications are tightly coupled with the URL's pathname and must be updated together, even if the pathname is not changing.\n\nReality is very different from these assumptions though.\n\n- Search params represent application state, so inevitably, we will expect them to have the same DX associated with other state managers. This means having the capability of distinguishing between primitive value types and efficiently storing and manipulating complex data structures like nested arrays and objects.\n- There are many ways to serialize and deserialize state with different tradeoffs. You should be able to choose the best one for your application or at the very least get a better default than `URLSearchParams`.\n- Immutability & Structural Sharing. Every time you stringify and parse url search params, referential integrity and object identity is lost because each new parse creates a brand new data structure with a unique memory reference. If not properly managed over its lifetime, this constant serialization and parsing can result in unexpected and undesirable performance issues, especially in frameworks like React that choose to track reactivity via immutability or in Solid that normally relies on reconciliation to detect changes from deserialized data sources.\n- Search params, while an important part of the URL, do frequently change independently of the URL's pathname. For example, a user may want to change the page number of a paginated list without touching the URL's pathname.\n\n## Search Params, the \"OG\" State Manager\n\nYou've probably seen search params like `?page=3` or `?filter-name=tanner` in the URL. There is no question that this is truly **a form of global state** living inside of the URL. It's valuable to store specific pieces of state in the URL because:\n\n- Users should be able to:\n  - Cmd/Ctrl + Click to open a link in a new tab and reliably see the state they expected\n  - Bookmark and share links from your application with others with assurances that they will see exactly the state as when the link was copied.\n  - Refresh your app or navigate back and forth between pages without losing their state\n- Developers should be able to easily:\n  - Add, remove or modify state in the URL with the same great DX as other state managers\n  - Easily validate search params coming from the URL in a format and type that is safe for their application to consume\n  - Read and write to search params without having to worry about the underlying serialization format\n\n## JSON-first Search Params\n\nTo achieve the above, the first step built in to TanStack Router is a powerful search param parser that automatically converts the search string of your URL to structured JSON. This means that you can store any JSON-serializable data structure in your search params and it will be parsed and serialized as JSON. This is a huge improvement over `URLSearchParams` which has limited support for array-like structures and nested data.\n\nFor example, navigating to the following route:\n\n```tsx\nconst link = (\n  <Link\n    to=\"/shop\"\n    search={{\n      pageIndex: 3,\n      includeCategories: ['electronics', 'gifts'],\n      sortBy: 'price',\n      desc: true,\n    }}\n  />\n)\n```\n\nWill result in the following URL:\n\n```\n/shop?pageIndex=3&includeCategories=%5B%22electronics%22%2C%22gifts%22%5D&sortBy=price&desc=true\n```\n\nWhen this URL is parsed, the search params will be accurately converted back to the following JSON:\n\n```json\n{\n  \"pageIndex\": 3,\n  \"includeCategories\": [\"electronics\", \"gifts\"],\n  \"sortBy\": \"price\",\n  \"desc\": true\n}\n```\n\nIf you noticed, there are a few things going on here:\n\n- The first level of the search params is flat and string based, just like `URLSearchParams`.\n- First level values that are not strings are accurately preserved as actual numbers and booleans.\n- Nested data structures are automatically converted to URL-safe JSON strings\n\n> 🧠 It's common for other tools to assume that search params are always flat and string-based which is why we've chosen to keep things URLSearchParam compliant at the first level. This ultimately means that even though TanStack Router is managing your nested search params as JSON, other tools will still be able to write to the URL and read first-level params normally.\n\n## Validating and Typing Search Params\n\nDespite TanStack Router being able to parse search params into reliable JSON, they ultimately still came from **a user-facing raw-text input**. Similar to other serialization boundaries, this means that before you consume search params, they should be validated into a format that your application can trust and rely on.\n\n### Enter Validation + TypeScript!\n\nTanStack Router provides convenient APIs for validating and typing search params. This all starts with the `Route`'s `validateSearch` option:\n\n```tsx title=\"src/routes/shop/products.tsx\"\ntype ProductSearchSortOptions = 'newest' | 'oldest' | 'price'\n\ntype ProductSearch = {\n  page: number\n  filter: string\n  sort: ProductSearchSortOptions\n}\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: (search: Record<string, unknown>): ProductSearch => {\n    // validate and parse the search params into a typed state\n    return {\n      page: Number(search?.page ?? 1),\n      filter: (search.filter as string) || '',\n      sort: (search.sort as ProductSearchSortOptions) || 'newest',\n    }\n  },\n})\n```\n\nIn the above example, we're validating the search params of the `Route` and returning a typed `ProductSearch` object. This typed object is then made available to this route's other options **and any child routes, too!**\n\n### Validating Search Params\n\nThe `validateSearch` option is a function that is provided the JSON parsed (but non-validated) search params as a `Record<string, unknown>` and returns a typed object of your choice. It's usually best to provide sensible fallbacks for malformed or unexpected search params so your users' experience stays non-interrupted.\n\nHere's an example:\n\n```tsx title=\"src/routes/shop/products.tsx\"\ntype ProductSearchSortOptions = 'newest' | 'oldest' | 'price'\n\ntype ProductSearch = {\n  page: number\n  filter: string\n  sort: ProductSearchSortOptions\n}\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: (search: Record<string, unknown>): ProductSearch => {\n    // validate and parse the search params into a typed state\n    return {\n      page: Number(search?.page ?? 1),\n      filter: (search.filter as string) || '',\n      sort: (search.sort as ProductSearchSortOptions) || 'newest',\n    }\n  },\n})\n```\n\nHere's an example using the [Zod](https://zod.dev/) library (but feel free to use any validation library you want) to both validate and type the search params in a single step:\n\n```tsx title=\"src/routes/shop/products.tsx\"\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().catch(1),\n  filter: z.string().catch(''),\n  sort: z.enum(['newest', 'oldest', 'price']).catch('newest'),\n})\n\ntype ProductSearch = z.infer<typeof productSearchSchema>\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: (search) => productSearchSchema.parse(search),\n})\n```\n\nBecause `validateSearch` also accepts an object with the `parse` property, this can be shortened to:\n\n```tsx\nvalidateSearch: productSearchSchema\n```\n\nIn the above example, we used Zod's `.catch()` modifier instead of `.default()` to avoid showing an error to the user because we firmly believe that if a search parameter is malformed, you probably don't want to halt the user's experience through the app to show a big fat error message. That said, there may be times that you **do want to show an error message**. In that case, you can use `.default()` instead of `.catch()`.\n\nThe underlying mechanics why this works relies on the `validateSearch` function throwing an error. If an error is thrown, the route's `onError` option will be triggered (and `error.routerCode` will be set to `VALIDATE_SEARCH` and the `errorComponent` will be rendered instead of the route's `component` where you can handle the search param error however you'd like.\n\n#### Adapters\n\nWhen using a library like [Zod](https://zod.dev/) to validate search params you might want to `transform` search params before committing the search params to the URL. A common `zod` `transform` is `default` for example.\n\n```tsx\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  filter: z.string().default(''),\n  sort: z.enum(['newest', 'oldest', 'price']).default('newest'),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})\n```\n\nIt might be surprising that when you try to navigate to this route, `search` is required. The following `Link` will type error as `search` is missing.\n\n```tsx\n<Link to=\"/shop/products\" />\n```\n\nFor validation libraries we recommend using adapters which infer the correct `input` and `output` types.\n\n### Zod\n\nAn adapter is provided for [Zod](https://zod.dev/) which will pipe through the correct `input` type and `output` type.\n\nFor Zod v3:\n\n```tsx\nimport { zodValidator } from '@tanstack/zod-adapter'\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  filter: z.string().default(''),\n  sort: z.enum(['newest', 'oldest', 'price']).default('newest'),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: zodValidator(productSearchSchema),\n})\n```\n\nWith Zod v4, you should directly use the schema in `validateSearch`:\n\n```tsx\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  filter: z.string().default(''),\n  sort: z.enum(['newest', 'oldest', 'price']).default('newest'),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  // With Zod v4, we can use the schema without the adapter\n  validateSearch: productSearchSchema,\n})\n```\n\nThe important part here is the following use of `Link` no longer requires `search` params:\n\n```tsx\n<Link to=\"/shop/products\" />\n```\n\nIn Zod v3, the use of `catch` here overrides the types and makes `page`, `filter` and `sort` `unknown` causing type loss. We have handled this case by providing a `fallback` generic function which retains the types but provides a `fallback` value when validation fails:\n\n```tsx\nimport { fallback, zodValidator } from '@tanstack/zod-adapter'\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: fallback(z.number(), 1).default(1),\n  filter: fallback(z.string(), '').default(''),\n  sort: fallback(z.enum(['newest', 'oldest', 'price']), 'newest').default(\n    'newest',\n  ),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: zodValidator(productSearchSchema),\n})\n```\n\nTherefore when navigating to this route, `search` is optional and retains the correct types.\n\nIn Zod v4, schemas may use `catch` instead of the fallback and will retain type inference throughout.\n\nWhile not recommended, it is also possible to configure `input` and `output` type in case the `output` type is more accurate than the `input` type:\n\n```tsx\nconst productSearchSchema = z.object({\n  page: fallback(z.number(), 1).default(1),\n  filter: fallback(z.string(), '').default(''),\n  sort: fallback(z.enum(['newest', 'oldest', 'price']), 'newest').default(\n    'newest',\n  ),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: zodValidator({\n    schema: productSearchSchema,\n    input: 'output',\n    output: 'input',\n  }),\n})\n```\n\nThis provides flexibility in which type you want to infer for navigation and which types you want to infer for reading search params.\n\n### Valibot\n\n> [!WARNING]\n> Router expects the valibot 1.0 package to be installed.\n\nWhen using [Valibot](https://valibot.dev/) an adapter is not needed to ensure the correct `input` and `output` types are used for navigation and reading search params. This is because `valibot` implements [Standard Schema](https://github.com/standard-schema/standard-schema)\n\n```tsx\nimport * as v from 'valibot'\n\nconst productSearchSchema = v.object({\n  page: v.optional(v.fallback(v.number(), 1), 1),\n  filter: v.optional(v.fallback(v.string(), ''), ''),\n  sort: v.optional(\n    v.fallback(v.picklist(['newest', 'oldest', 'price']), 'newest'),\n    'newest',\n  ),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})\n```\n\n### Arktype\n\n> [!WARNING]\n> Router expects the arktype 2.0-rc package to be installed.\n\nWhen using [ArkType](https://arktype.io/) an adapter is not needed to ensure the correct `input` and `output` types are used for navigation and reading search params. This is because [ArkType](https://arktype.io/) implements [Standard Schema](https://github.com/standard-schema/standard-schema)\n\n```tsx\nimport { type } from 'arktype'\n\nconst productSearchSchema = type({\n  page: 'number = 1',\n  filter: 'string = \"\"',\n  sort: '\"newest\" | \"oldest\" | \"price\" = \"newest\"',\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})\n```\n\n### Effect/Schema\n\nWhen using [Effect/Schema](https://effect.website/docs/schema/introduction/) an adapter is not needed to ensure the correct `input` and `output` types are used for navigation and reading search params. This is because [Effect/Schema](https://effect.website/docs/schema/standard-schema/) implements [Standard Schema](https://github.com/standard-schema/standard-schema)\n\n```tsx\nimport { Schema as S } from 'effect'\n\nconst productSearchSchema = S.standardSchemaV1(\n  S.Struct({\n    page: S.NumberFromString.pipe(\n      S.optional,\n      S.withDefaults({\n        constructor: () => 1,\n        decoding: () => 1,\n      }),\n    ),\n    filter: S.String.pipe(\n      S.optional,\n      S.withDefaults({\n        constructor: () => '',\n        decoding: () => '',\n      }),\n    ),\n    sort: S.Literal('newest', 'oldest', 'price').pipe(\n      S.optional,\n      S.withDefaults({\n        constructor: () => 'newest' as const,\n        decoding: () => 'newest' as const,\n      }),\n    ),\n  }),\n)\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})\n```\n\n## Reading Search Params\n\nOnce your search params have been validated and typed, you're finally ready to start reading and writing to them. There are a few ways to do this in TanStack Router, so let's check them out.\n\n### Using Search Params in Loaders\n\nPlease read the [Search Params in Loaders](./data-loading.md#using-loaderdeps-to-access-search-params) section for more information about how to read search params in loaders with the `loaderDeps` option.\n\n### Search Params are inherited from Parent Routes\n\nThe search parameters and types of parents are merged as you go down the route tree, so child routes also have access to their parent's search params:\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/shop/products.tsx\"\nconst productSearchSchema = z.object({\n  page: z.number().catch(1),\n  filter: z.string().catch(''),\n  sort: z.enum(['newest', 'oldest', 'price']).catch('newest'),\n})\n\ntype ProductSearch = z.infer<typeof productSearchSchema>\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n})\n```\n\n```tsx title=\"src/routes/shop/products/$productId.tsx\"\nexport const Route = createFileRoute('/shop/products/$productId')({\n  beforeLoad: ({ search }) => {\n    search\n    // ^? ProductSearch ✅\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n### Search Params in Components\n\nYou can access your route's validated search params in your route's `component` via the `useSearch` hook.\n\n```tsx title=\"src/routes/shop/products.tsx\"\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n})\n\nconst ProductList = () => {\n  const { page, filter, sort } = Route.useSearch()\n\n  return <div>...</div>\n}\n```\n\n> [!TIP]\n> If your component is code-split, you can use the [getRouteApi function](./code-splitting.md#manually-accessing-route-apis-in-other-files-with-the-getrouteapi-helper) to avoid having to import the `Route` configuration to get access to the typed `useSearch()` hook.\n\n### Search Params outside of Route Components\n\nYou can access your route's validated search params anywhere in your app using the `useSearch` hook. By passing the `from` id/path of your origin route, you'll get even better type safety:\n\n```tsx\n// src/routes/shop.products.tsx\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n  // ...\n})\n\n// Somewhere else...\n\n// src/components/product-list-sidebar.tsx\nconst routeApi = getRouteApi('/shop/products')\n\nconst ProductList = () => {\n  const routeSearch = routeApi.useSearch()\n\n  // OR\n\n  const { page, filter, sort } = useSearch({\n    from: Route.fullPath,\n  })\n\n  return <div>...</div>\n}\n```\n\nOr, you can loosen up the type-safety and get an optional `search` object by passing `strict: false`:\n\n```tsx\nfunction ProductList() {\n  const search = useSearch({\n    strict: false,\n  })\n  // {\n  //   page: number | undefined\n  //   filter: string | undefined\n  //   sort: 'newest' | 'oldest' | 'price' | undefined\n  // }\n\n  return <div>...</div>\n}\n```\n\n## Writing Search Params\n\nNow that you've learned how to read your route's search params, you'll be happy to know that you've already seen the primary APIs to modify and update them. Let's remind ourselves a bit\n\n### `<Link search />`\n\nThe best way to update search params is to use the `search` prop on the `<Link />` component.\n\nIf the search for the current page shall be updated and the `from` prop is specified, the `to` prop can be omitted.\nHere's an example:\n\n```tsx title=\"src/routes/shop/products.tsx\"\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n})\n\nconst ProductList = () => {\n  return (\n    <div>\n      <Link from={Route.fullPath} search={(prev) => ({ page: prev.page + 1 })}>\n        Next Page\n      </Link>\n    </div>\n  )\n}\n```\n\nIf you want to update the search params in a generic component that is rendered on multiple routes, specifying `from` can be challenging.\n\nIn this scenario you can set `to=\".\"` which will give you access to loosely typed search params.\nHere is an example that illustrates this:\n\n```tsx\n// `page` is a search param that is defined in the __root route and hence available on all routes.\nconst PageSelector = () => {\n  return (\n    <div>\n      <Link to=\".\" search={(prev) => ({ ...prev, page: prev.page + 1 })}>\n        Next Page\n      </Link>\n    </div>\n  )\n}\n```\n\nIf the generic component is only rendered in a specific subtree of the route tree, you can specify that subtree using `from`. Here you can omit `to='.'` if you want.\n\n```tsx\n// `page` is a search param that is defined in the /posts route and hence available on all of its child routes.\nconst PageSelector = () => {\n  return (\n    <div>\n      <Link\n        from=\"/posts\"\n        to=\".\"\n        search={(prev) => ({ ...prev, page: prev.page + 1 })}\n      >\n        Next Page\n      </Link>\n    </div>\n  )\n```\n\n### `useNavigate(), navigate({ search })`\n\nThe `navigate` function also accepts a `search` option that works the same way as the `search` prop on `<Link />`:\n\n```tsx title=\"src/routes/shop/products.tsx\"\nexport const Route = createFileRoute('/shop/products/$productId')({\n  validateSearch: productSearchSchema,\n})\n\nconst ProductList = () => {\n  const navigate = useNavigate({ from: Route.fullPath })\n\n  return (\n    <div>\n      <button\n        onClick={() => {\n          navigate({\n            search: (prev) => ({ page: prev.page + 1 }),\n          })\n        }}\n      >\n        Next Page\n      </button>\n    </div>\n  )\n}\n```\n\n### `router.navigate({ search })`\n\nThe `router.navigate` function works exactly the same way as the `useNavigate`/`navigate` hook/function above.\n\n### `<Navigate search />`\n\nThe `<Navigate search />` component works exactly the same way as the `useNavigate`/`navigate` hook/function above, but accepts its options as props instead of a function argument.\n\n## Transforming search with search middlewares\n\nWhen link hrefs are built, by default the only thing that matters for the query string part is the `search` property of a `<Link>`.\n\nTanStack Router provides a way to manipulate search params before the href is generated via **search middlewares**.\nSearch middlewares are functions that transform the search parameters when generating new links for a route or its descendants.\nThey are also executed upon navigation after search validation to allow manipulation of the query string.\n\nThe following example shows how to make sure that for **every** link that is being built, the `rootValue` search param is added _if_ it is part of the current search params. If a link specifies `rootValue` inside `search`, then that value is used for building the link.\n\n```tsx\nimport { z } from 'zod'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    middlewares: [\n      ({ search, next }) => {\n        const result = next(search)\n        return {\n          rootValue: search.rootValue,\n          ...result,\n        }\n      },\n    ],\n  },\n})\n```\n\nSince this specific use case is quite common, TanStack Router provides a generic implementation to retain search params via `retainSearchParams`:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, retainSearchParams } from '@tanstack/react-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    middlewares: [retainSearchParams(['rootValue'])],\n  },\n})\n```\n\n# Solid\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, retainSearchParams } from '@tanstack/solid-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    middlewares: [retainSearchParams(['rootValue'])],\n  },\n})\n```\n\n<!-- ::end:framework -->\n\nAnother common use case is to strip out search params from links if their default value is set. TanStack Router provides a generic implementation for this use case via `stripSearchParams`:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = {\n  one: 'abc',\n  two: 'xyz',\n}\n\nconst searchSchema = z.object({\n  one: z.string().default(defaultValues.one),\n  two: z.string().default(defaultValues.two),\n})\n\nexport const Route = createFileRoute('/hello')({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    // strip default values\n    middlewares: [stripSearchParams(defaultValues)],\n  },\n})\n```\n\n# Solid\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/solid-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = {\n  one: 'abc',\n  two: 'xyz',\n}\n\nconst searchSchema = z.object({\n  one: z.string().default(defaultValues.one),\n  two: z.string().default(defaultValues.two),\n})\n\nexport const Route = createFileRoute('/hello')({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    // strip default values\n    middlewares: [stripSearchParams(defaultValues)],\n  },\n})\n```\n\n<!-- ::end:framework -->\n\nMultiple middlewares can be chained. The following example shows how to combine both `retainSearchParams` and `stripSearchParams`.\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport {\n  Link,\n  createFileRoute,\n  retainSearchParams,\n  stripSearchParams,\n} from '@tanstack/react-router'\nimport { z } from 'zod'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = ['foo', 'bar']\n\nexport const Route = createFileRoute('/search')({\n  validateSearch: zodValidator(\n    z.object({\n      retainMe: z.string().optional(),\n      arrayWithDefaults: z.string().array().default(defaultValues),\n      required: z.string(),\n    }),\n  ),\n  search: {\n    middlewares: [\n      retainSearchParams(['retainMe']),\n      stripSearchParams({ arrayWithDefaults: defaultValues }),\n    ],\n  },\n})\n```\n\n# Solid\n\n```tsx\nimport {\n  Link,\n  createFileRoute,\n  retainSearchParams,\n  stripSearchParams,\n} from '@tanstack/solid-router'\nimport { z } from 'zod'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = ['foo', 'bar']\n\nexport const Route = createFileRoute('/search')({\n  validateSearch: zodValidator(\n    z.object({\n      retainMe: z.string().optional(),\n      arrayWithDefaults: z.string().array().default(defaultValues),\n      required: z.string(),\n    }),\n  ),\n  search: {\n    middlewares: [\n      retainSearchParams(['retainMe']),\n      stripSearchParams({ arrayWithDefaults: defaultValues }),\n    ],\n  },\n})\n```\n\n<!-- ::end:framework -->\n","originalRawMarkdown":"---\ntitle: Search Params\n---\n\nSimilar to how TanStack Query made handling server-state in your React and Solid applications a breeze, TanStack Router aims to unlock the power of URL search params in your applications.\n\n> 🧠 If you are on a really old browser, like IE11, you may need to use a polyfill for `URLSearchParams`.\n\n## Why not just use `URLSearchParams`?\n\nWe get it, you've been hearing a lot of \"use the platform\" lately and for the most part, we agree. However, we also believe it's important to recognize where the platform falls short for more advanced use-cases and we believe `URLSearchParams` is one of these circumstances.\n\nTraditional Search Param APIs usually assume a few things:\n\n- Search params are always strings\n- They are _mostly_ flat\n- Serializing and deserializing using `URLSearchParams` is good enough (Spoiler alert: it's not.)\n- Search params modifications are tightly coupled with the URL's pathname and must be updated together, even if the pathname is not changing.\n\nReality is very different from these assumptions though.\n\n- Search params represent application state, so inevitably, we will expect them to have the same DX associated with other state managers. This means having the capability of distinguishing between primitive value types and efficiently storing and manipulating complex data structures like nested arrays and objects.\n- There are many ways to serialize and deserialize state with different tradeoffs. You should be able to choose the best one for your application or at the very least get a better default than `URLSearchParams`.\n- Immutability & Structural Sharing. Every time you stringify and parse url search params, referential integrity and object identity is lost because each new parse creates a brand new data structure with a unique memory reference. If not properly managed over its lifetime, this constant serialization and parsing can result in unexpected and undesirable performance issues, especially in frameworks like React that choose to track reactivity via immutability or in Solid that normally relies on reconciliation to detect changes from deserialized data sources.\n- Search params, while an important part of the URL, do frequently change independently of the URL's pathname. For example, a user may want to change the page number of a paginated list without touching the URL's pathname.\n\n## Search Params, the \"OG\" State Manager\n\nYou've probably seen search params like `?page=3` or `?filter-name=tanner` in the URL. There is no question that this is truly **a form of global state** living inside of the URL. It's valuable to store specific pieces of state in the URL because:\n\n- Users should be able to:\n  - Cmd/Ctrl + Click to open a link in a new tab and reliably see the state they expected\n  - Bookmark and share links from your application with others with assurances that they will see exactly the state as when the link was copied.\n  - Refresh your app or navigate back and forth between pages without losing their state\n- Developers should be able to easily:\n  - Add, remove or modify state in the URL with the same great DX as other state managers\n  - Easily validate search params coming from the URL in a format and type that is safe for their application to consume\n  - Read and write to search params without having to worry about the underlying serialization format\n\n## JSON-first Search Params\n\nTo achieve the above, the first step built in to TanStack Router is a powerful search param parser that automatically converts the search string of your URL to structured JSON. This means that you can store any JSON-serializable data structure in your search params and it will be parsed and serialized as JSON. This is a huge improvement over `URLSearchParams` which has limited support for array-like structures and nested data.\n\nFor example, navigating to the following route:\n\n```tsx\nconst link = (\n  <Link\n    to=\"/shop\"\n    search={{\n      pageIndex: 3,\n      includeCategories: ['electronics', 'gifts'],\n      sortBy: 'price',\n      desc: true,\n    }}\n  />\n)\n```\n\nWill result in the following URL:\n\n```\n/shop?pageIndex=3&includeCategories=%5B%22electronics%22%2C%22gifts%22%5D&sortBy=price&desc=true\n```\n\nWhen this URL is parsed, the search params will be accurately converted back to the following JSON:\n\n```json\n{\n  \"pageIndex\": 3,\n  \"includeCategories\": [\"electronics\", \"gifts\"],\n  \"sortBy\": \"price\",\n  \"desc\": true\n}\n```\n\nIf you noticed, there are a few things going on here:\n\n- The first level of the search params is flat and string based, just like `URLSearchParams`.\n- First level values that are not strings are accurately preserved as actual numbers and booleans.\n- Nested data structures are automatically converted to URL-safe JSON strings\n\n> 🧠 It's common for other tools to assume that search params are always flat and string-based which is why we've chosen to keep things URLSearchParam compliant at the first level. This ultimately means that even though TanStack Router is managing your nested search params as JSON, other tools will still be able to write to the URL and read first-level params normally.\n\n## Validating and Typing Search Params\n\nDespite TanStack Router being able to parse search params into reliable JSON, they ultimately still came from **a user-facing raw-text input**. Similar to other serialization boundaries, this means that before you consume search params, they should be validated into a format that your application can trust and rely on.\n\n### Enter Validation + TypeScript!\n\nTanStack Router provides convenient APIs for validating and typing search params. This all starts with the `Route`'s `validateSearch` option:\n\n```tsx title=\"src/routes/shop/products.tsx\"\ntype ProductSearchSortOptions = 'newest' | 'oldest' | 'price'\n\ntype ProductSearch = {\n  page: number\n  filter: string\n  sort: ProductSearchSortOptions\n}\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: (search: Record<string, unknown>): ProductSearch => {\n    // validate and parse the search params into a typed state\n    return {\n      page: Number(search?.page ?? 1),\n      filter: (search.filter as string) || '',\n      sort: (search.sort as ProductSearchSortOptions) || 'newest',\n    }\n  },\n})\n```\n\nIn the above example, we're validating the search params of the `Route` and returning a typed `ProductSearch` object. This typed object is then made available to this route's other options **and any child routes, too!**\n\n### Validating Search Params\n\nThe `validateSearch` option is a function that is provided the JSON parsed (but non-validated) search params as a `Record<string, unknown>` and returns a typed object of your choice. It's usually best to provide sensible fallbacks for malformed or unexpected search params so your users' experience stays non-interrupted.\n\nHere's an example:\n\n```tsx title=\"src/routes/shop/products.tsx\"\ntype ProductSearchSortOptions = 'newest' | 'oldest' | 'price'\n\ntype ProductSearch = {\n  page: number\n  filter: string\n  sort: ProductSearchSortOptions\n}\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: (search: Record<string, unknown>): ProductSearch => {\n    // validate and parse the search params into a typed state\n    return {\n      page: Number(search?.page ?? 1),\n      filter: (search.filter as string) || '',\n      sort: (search.sort as ProductSearchSortOptions) || 'newest',\n    }\n  },\n})\n```\n\nHere's an example using the [Zod](https://zod.dev/) library (but feel free to use any validation library you want) to both validate and type the search params in a single step:\n\n```tsx title=\"src/routes/shop/products.tsx\"\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().catch(1),\n  filter: z.string().catch(''),\n  sort: z.enum(['newest', 'oldest', 'price']).catch('newest'),\n})\n\ntype ProductSearch = z.infer<typeof productSearchSchema>\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: (search) => productSearchSchema.parse(search),\n})\n```\n\nBecause `validateSearch` also accepts an object with the `parse` property, this can be shortened to:\n\n```tsx\nvalidateSearch: productSearchSchema\n```\n\nIn the above example, we used Zod's `.catch()` modifier instead of `.default()` to avoid showing an error to the user because we firmly believe that if a search parameter is malformed, you probably don't want to halt the user's experience through the app to show a big fat error message. That said, there may be times that you **do want to show an error message**. In that case, you can use `.default()` instead of `.catch()`.\n\nThe underlying mechanics why this works relies on the `validateSearch` function throwing an error. If an error is thrown, the route's `onError` option will be triggered (and `error.routerCode` will be set to `VALIDATE_SEARCH` and the `errorComponent` will be rendered instead of the route's `component` where you can handle the search param error however you'd like.\n\n#### Adapters\n\nWhen using a library like [Zod](https://zod.dev/) to validate search params you might want to `transform` search params before committing the search params to the URL. A common `zod` `transform` is `default` for example.\n\n```tsx\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  filter: z.string().default(''),\n  sort: z.enum(['newest', 'oldest', 'price']).default('newest'),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})\n```\n\nIt might be surprising that when you try to navigate to this route, `search` is required. The following `Link` will type error as `search` is missing.\n\n```tsx\n<Link to=\"/shop/products\" />\n```\n\nFor validation libraries we recommend using adapters which infer the correct `input` and `output` types.\n\n### Zod\n\nAn adapter is provided for [Zod](https://zod.dev/) which will pipe through the correct `input` type and `output` type.\n\nFor Zod v3:\n\n```tsx\nimport { zodValidator } from '@tanstack/zod-adapter'\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  filter: z.string().default(''),\n  sort: z.enum(['newest', 'oldest', 'price']).default('newest'),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: zodValidator(productSearchSchema),\n})\n```\n\nWith Zod v4, you should directly use the schema in `validateSearch`:\n\n```tsx\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  filter: z.string().default(''),\n  sort: z.enum(['newest', 'oldest', 'price']).default('newest'),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  // With Zod v4, we can use the schema without the adapter\n  validateSearch: productSearchSchema,\n})\n```\n\nThe important part here is the following use of `Link` no longer requires `search` params:\n\n```tsx\n<Link to=\"/shop/products\" />\n```\n\nIn Zod v3, the use of `catch` here overrides the types and makes `page`, `filter` and `sort` `unknown` causing type loss. We have handled this case by providing a `fallback` generic function which retains the types but provides a `fallback` value when validation fails:\n\n```tsx\nimport { fallback, zodValidator } from '@tanstack/zod-adapter'\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: fallback(z.number(), 1).default(1),\n  filter: fallback(z.string(), '').default(''),\n  sort: fallback(z.enum(['newest', 'oldest', 'price']), 'newest').default(\n    'newest',\n  ),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: zodValidator(productSearchSchema),\n})\n```\n\nTherefore when navigating to this route, `search` is optional and retains the correct types.\n\nIn Zod v4, schemas may use `catch` instead of the fallback and will retain type inference throughout.\n\nWhile not recommended, it is also possible to configure `input` and `output` type in case the `output` type is more accurate than the `input` type:\n\n```tsx\nconst productSearchSchema = z.object({\n  page: fallback(z.number(), 1).default(1),\n  filter: fallback(z.string(), '').default(''),\n  sort: fallback(z.enum(['newest', 'oldest', 'price']), 'newest').default(\n    'newest',\n  ),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: zodValidator({\n    schema: productSearchSchema,\n    input: 'output',\n    output: 'input',\n  }),\n})\n```\n\nThis provides flexibility in which type you want to infer for navigation and which types you want to infer for reading search params.\n\n### Valibot\n\n> [!WARNING]\n> Router expects the valibot 1.0 package to be installed.\n\nWhen using [Valibot](https://valibot.dev/) an adapter is not needed to ensure the correct `input` and `output` types are used for navigation and reading search params. This is because `valibot` implements [Standard Schema](https://github.com/standard-schema/standard-schema)\n\n```tsx\nimport * as v from 'valibot'\n\nconst productSearchSchema = v.object({\n  page: v.optional(v.fallback(v.number(), 1), 1),\n  filter: v.optional(v.fallback(v.string(), ''), ''),\n  sort: v.optional(\n    v.fallback(v.picklist(['newest', 'oldest', 'price']), 'newest'),\n    'newest',\n  ),\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})\n```\n\n### Arktype\n\n> [!WARNING]\n> Router expects the arktype 2.0-rc package to be installed.\n\nWhen using [ArkType](https://arktype.io/) an adapter is not needed to ensure the correct `input` and `output` types are used for navigation and reading search params. This is because [ArkType](https://arktype.io/) implements [Standard Schema](https://github.com/standard-schema/standard-schema)\n\n```tsx\nimport { type } from 'arktype'\n\nconst productSearchSchema = type({\n  page: 'number = 1',\n  filter: 'string = \"\"',\n  sort: '\"newest\" | \"oldest\" | \"price\" = \"newest\"',\n})\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})\n```\n\n### Effect/Schema\n\nWhen using [Effect/Schema](https://effect.website/docs/schema/introduction/) an adapter is not needed to ensure the correct `input` and `output` types are used for navigation and reading search params. This is because [Effect/Schema](https://effect.website/docs/schema/standard-schema/) implements [Standard Schema](https://github.com/standard-schema/standard-schema)\n\n```tsx\nimport { Schema as S } from 'effect'\n\nconst productSearchSchema = S.standardSchemaV1(\n  S.Struct({\n    page: S.NumberFromString.pipe(\n      S.optional,\n      S.withDefaults({\n        constructor: () => 1,\n        decoding: () => 1,\n      }),\n    ),\n    filter: S.String.pipe(\n      S.optional,\n      S.withDefaults({\n        constructor: () => '',\n        decoding: () => '',\n      }),\n    ),\n    sort: S.Literal('newest', 'oldest', 'price').pipe(\n      S.optional,\n      S.withDefaults({\n        constructor: () => 'newest' as const,\n        decoding: () => 'newest' as const,\n      }),\n    ),\n  }),\n)\n\nexport const Route = createFileRoute('/shop/products/')({\n  validateSearch: productSearchSchema,\n})\n```\n\n## Reading Search Params\n\nOnce your search params have been validated and typed, you're finally ready to start reading and writing to them. There are a few ways to do this in TanStack Router, so let's check them out.\n\n### Using Search Params in Loaders\n\nPlease read the [Search Params in Loaders](./data-loading.md#using-loaderdeps-to-access-search-params) section for more information about how to read search params in loaders with the `loaderDeps` option.\n\n### Search Params are inherited from Parent Routes\n\nThe search parameters and types of parents are merged as you go down the route tree, so child routes also have access to their parent's search params:\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/shop/products.tsx\"\nconst productSearchSchema = z.object({\n  page: z.number().catch(1),\n  filter: z.string().catch(''),\n  sort: z.enum(['newest', 'oldest', 'price']).catch('newest'),\n})\n\ntype ProductSearch = z.infer<typeof productSearchSchema>\n\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n})\n```\n\n```tsx title=\"src/routes/shop/products/$productId.tsx\"\nexport const Route = createFileRoute('/shop/products/$productId')({\n  beforeLoad: ({ search }) => {\n    search\n    // ^? ProductSearch ✅\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n### Search Params in Components\n\nYou can access your route's validated search params in your route's `component` via the `useSearch` hook.\n\n```tsx title=\"src/routes/shop/products.tsx\"\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n})\n\nconst ProductList = () => {\n  const { page, filter, sort } = Route.useSearch()\n\n  return <div>...</div>\n}\n```\n\n> [!TIP]\n> If your component is code-split, you can use the [getRouteApi function](./code-splitting.md#manually-accessing-route-apis-in-other-files-with-the-getrouteapi-helper) to avoid having to import the `Route` configuration to get access to the typed `useSearch()` hook.\n\n### Search Params outside of Route Components\n\nYou can access your route's validated search params anywhere in your app using the `useSearch` hook. By passing the `from` id/path of your origin route, you'll get even better type safety:\n\n```tsx\n// src/routes/shop.products.tsx\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n  // ...\n})\n\n// Somewhere else...\n\n// src/components/product-list-sidebar.tsx\nconst routeApi = getRouteApi('/shop/products')\n\nconst ProductList = () => {\n  const routeSearch = routeApi.useSearch()\n\n  // OR\n\n  const { page, filter, sort } = useSearch({\n    from: Route.fullPath,\n  })\n\n  return <div>...</div>\n}\n```\n\nOr, you can loosen up the type-safety and get an optional `search` object by passing `strict: false`:\n\n```tsx\nfunction ProductList() {\n  const search = useSearch({\n    strict: false,\n  })\n  // {\n  //   page: number | undefined\n  //   filter: string | undefined\n  //   sort: 'newest' | 'oldest' | 'price' | undefined\n  // }\n\n  return <div>...</div>\n}\n```\n\n## Writing Search Params\n\nNow that you've learned how to read your route's search params, you'll be happy to know that you've already seen the primary APIs to modify and update them. Let's remind ourselves a bit\n\n### `<Link search />`\n\nThe best way to update search params is to use the `search` prop on the `<Link />` component.\n\nIf the search for the current page shall be updated and the `from` prop is specified, the `to` prop can be omitted.\nHere's an example:\n\n```tsx title=\"src/routes/shop/products.tsx\"\nexport const Route = createFileRoute('/shop/products')({\n  validateSearch: productSearchSchema,\n})\n\nconst ProductList = () => {\n  return (\n    <div>\n      <Link from={Route.fullPath} search={(prev) => ({ page: prev.page + 1 })}>\n        Next Page\n      </Link>\n    </div>\n  )\n}\n```\n\nIf you want to update the search params in a generic component that is rendered on multiple routes, specifying `from` can be challenging.\n\nIn this scenario you can set `to=\".\"` which will give you access to loosely typed search params.\nHere is an example that illustrates this:\n\n```tsx\n// `page` is a search param that is defined in the __root route and hence available on all routes.\nconst PageSelector = () => {\n  return (\n    <div>\n      <Link to=\".\" search={(prev) => ({ ...prev, page: prev.page + 1 })}>\n        Next Page\n      </Link>\n    </div>\n  )\n}\n```\n\nIf the generic component is only rendered in a specific subtree of the route tree, you can specify that subtree using `from`. Here you can omit `to='.'` if you want.\n\n```tsx\n// `page` is a search param that is defined in the /posts route and hence available on all of its child routes.\nconst PageSelector = () => {\n  return (\n    <div>\n      <Link\n        from=\"/posts\"\n        to=\".\"\n        search={(prev) => ({ ...prev, page: prev.page + 1 })}\n      >\n        Next Page\n      </Link>\n    </div>\n  )\n```\n\n### `useNavigate(), navigate({ search })`\n\nThe `navigate` function also accepts a `search` option that works the same way as the `search` prop on `<Link />`:\n\n```tsx title=\"src/routes/shop/products.tsx\"\nexport const Route = createFileRoute('/shop/products/$productId')({\n  validateSearch: productSearchSchema,\n})\n\nconst ProductList = () => {\n  const navigate = useNavigate({ from: Route.fullPath })\n\n  return (\n    <div>\n      <button\n        onClick={() => {\n          navigate({\n            search: (prev) => ({ page: prev.page + 1 }),\n          })\n        }}\n      >\n        Next Page\n      </button>\n    </div>\n  )\n}\n```\n\n### `router.navigate({ search })`\n\nThe `router.navigate` function works exactly the same way as the `useNavigate`/`navigate` hook/function above.\n\n### `<Navigate search />`\n\nThe `<Navigate search />` component works exactly the same way as the `useNavigate`/`navigate` hook/function above, but accepts its options as props instead of a function argument.\n\n## Transforming search with search middlewares\n\nWhen link hrefs are built, by default the only thing that matters for the query string part is the `search` property of a `<Link>`.\n\nTanStack Router provides a way to manipulate search params before the href is generated via **search middlewares**.\nSearch middlewares are functions that transform the search parameters when generating new links for a route or its descendants.\nThey are also executed upon navigation after search validation to allow manipulation of the query string.\n\nThe following example shows how to make sure that for **every** link that is being built, the `rootValue` search param is added _if_ it is part of the current search params. If a link specifies `rootValue` inside `search`, then that value is used for building the link.\n\n```tsx\nimport { z } from 'zod'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    middlewares: [\n      ({ search, next }) => {\n        const result = next(search)\n        return {\n          rootValue: search.rootValue,\n          ...result,\n        }\n      },\n    ],\n  },\n})\n```\n\nSince this specific use case is quite common, TanStack Router provides a generic implementation to retain search params via `retainSearchParams`:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, retainSearchParams } from '@tanstack/react-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    middlewares: [retainSearchParams(['rootValue'])],\n  },\n})\n```\n\n# Solid\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, retainSearchParams } from '@tanstack/solid-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst searchSchema = z.object({\n  rootValue: z.string().optional(),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    middlewares: [retainSearchParams(['rootValue'])],\n  },\n})\n```\n\n<!-- ::end:framework -->\n\nAnother common use case is to strip out search params from links if their default value is set. TanStack Router provides a generic implementation for this use case via `stripSearchParams`:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/react-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = {\n  one: 'abc',\n  two: 'xyz',\n}\n\nconst searchSchema = z.object({\n  one: z.string().default(defaultValues.one),\n  two: z.string().default(defaultValues.two),\n})\n\nexport const Route = createFileRoute('/hello')({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    // strip default values\n    middlewares: [stripSearchParams(defaultValues)],\n  },\n})\n```\n\n# Solid\n\n```tsx\nimport { z } from 'zod'\nimport { createFileRoute, stripSearchParams } from '@tanstack/solid-router'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = {\n  one: 'abc',\n  two: 'xyz',\n}\n\nconst searchSchema = z.object({\n  one: z.string().default(defaultValues.one),\n  two: z.string().default(defaultValues.two),\n})\n\nexport const Route = createFileRoute('/hello')({\n  validateSearch: zodValidator(searchSchema),\n  search: {\n    // strip default values\n    middlewares: [stripSearchParams(defaultValues)],\n  },\n})\n```\n\n<!-- ::end:framework -->\n\nMultiple middlewares can be chained. The following example shows how to combine both `retainSearchParams` and `stripSearchParams`.\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport {\n  Link,\n  createFileRoute,\n  retainSearchParams,\n  stripSearchParams,\n} from '@tanstack/react-router'\nimport { z } from 'zod'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = ['foo', 'bar']\n\nexport const Route = createFileRoute('/search')({\n  validateSearch: zodValidator(\n    z.object({\n      retainMe: z.string().optional(),\n      arrayWithDefaults: z.string().array().default(defaultValues),\n      required: z.string(),\n    }),\n  ),\n  search: {\n    middlewares: [\n      retainSearchParams(['retainMe']),\n      stripSearchParams({ arrayWithDefaults: defaultValues }),\n    ],\n  },\n})\n```\n\n# Solid\n\n```tsx\nimport {\n  Link,\n  createFileRoute,\n  retainSearchParams,\n  stripSearchParams,\n} from '@tanstack/solid-router'\nimport { z } from 'zod'\nimport { zodValidator } from '@tanstack/zod-adapter'\n\nconst defaultValues = ['foo', 'bar']\n\nexport const Route = createFileRoute('/search')({\n  validateSearch: zodValidator(\n    z.object({\n      retainMe: z.string().optional(),\n      arrayWithDefaults: z.string().array().default(defaultValues),\n      required: z.string(),\n    }),\n  ),\n  search: {\n    middlewares: [\n      retainSearchParams(['retainMe']),\n      stripSearchParams({ arrayWithDefaults: defaultValues }),\n    ],\n  },\n})\n```\n\n<!-- ::end:framework -->\n"}
