{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"When creating routes, you can optionally specify a "},{"type":"inlineCode","value":"staticData"},{"type":"text","value":" property in the route's options. This object can literally contain anything you want as long as it's synchronously available when you create your route."}]},{"type":"paragraph","children":[{"type":"text","value":"In addition to being able to access this data from the route itself, you can also access it from any match under the "},{"type":"inlineCode","value":"match.staticData"},{"type":"text","value":" property."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/posts')({\n  staticData: {\n    customData: 'Hello!',\n  },\n})","lang":"tsx","meta":"title='src/routes/posts.tsx'","title":"src/routes/posts.tsx","file":"src/routes/posts.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/posts.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/posts.tsx\",\"code\":\"import { createFileRoute } from '@tanstack/react-router'\\n\\nexport const Route = createFileRoute('/posts')({\\n  staticData: {\\n    customData: 'Hello!',\\n  },\\n})\",\"language\":\"tsx\"}]}"}},{"type":"paragraph","children":[{"type":"text","value":"You can then access this data anywhere you have access to your routes, including matches that can be mapped back to their routes."}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { createRootRoute } from '@tanstack/react-router'\n\nexport const Route = createRootRoute({\n  component: () => {\n    const matches = useMatches()\n\n    return (\n      <div>\n        {matches.map((match) => {\n          return <div key={match.id}>{match.staticData.customData}</div>\n        })}\n      </div>\n    )\n  },\n})","lang":"tsx","meta":"title='src/routes/__root.tsx'","title":"src/routes/__root.tsx","file":"src/routes/__root.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/__root.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/__root.tsx\",\"code\":\"import { createRootRoute } from '@tanstack/react-router'\\n\\nexport const Route = createRootRoute({\\n  component: () => {\\n    const matches = useMatches()\\n\\n    return (\\n      <div>\\n        {matches.map((match) => {\\n          return <div key={match.id}>{match.staticData.customData}</div>\\n        })}\\n      </div>\\n    )\\n  },\\n})\",\"language\":\"tsx\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/posts')({\n  staticData: {\n    customData: 'Hello!',\n  },\n})","lang":"tsx","meta":"title='src/routes/posts.tsx'","title":"src/routes/posts.tsx","file":"src/routes/posts.tsx"}]