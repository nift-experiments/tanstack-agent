ork-meta":"{\"codeBlocksByFramework\":{\"react\":[],\"solid\":[]}}"}},{"type":"heading","depth":2,"id":"enforcing-static-data","children":[{"type":"text","value":"Enforcing Static Data"}]},{"type":"paragraph","children":[{"type":"text","value":"If you want to enforce that a route has static data, you can use declaration merging to add a type to the route's static option:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"declare module '@tanstack/react-router' {\n  interface StaticDataRouteOption {\n    customData: string\n  }\n}","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"declare module '@tanstack/solid-router' {\n  interface StaticDataRouteOption {\n    customData: string\n  }\n}","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"declare module '@tanstack/react-router' {\\n  interface StaticDataRouteOption {\\n    customData: string\\n  }\\n}\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"declare module '@tanstack/solid-router' {\\n  interface StaticDataRouteOption {\\n    customData: string\\n  }\\n}\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"Now, if you try to create a route without the "},{"type":"inlineCode","value":"customData"},{"type":"text","value":" property, you'll get a type error:"}]},{"type":"code","value":"export const Route = createFileRoute('/posts')({\n  staticData: {\n    // Property 'customData' is missing in type '{ customData: number; }' but required in type 'StaticDataRouteOption'.ts(2741)\n  },\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"optional-static-data","children":[{"type":"text","value":"Optional Static Data"}]},{"type":"paragraph","children":[{"type":"text","value":"If you want to make static data optional, simply add a "},{"type":"inlineCode","value":"?"},{"type":"text","value":" to the property:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"declare module '@tanstack/react-router' {\n  interface StaticDataRouteOption {\n    customData?: string\n  }\n}","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"declare module '@tanstack/solid-router' {\n  interface StaticDataRouteOption {\n    customData?: string\n  }\n}","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"declare module '@tanstack/react-router' {\\n  interface StaticDataRouteOption {\\n    customData?: string\\n  }\\n}\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"declare module '@tanstack/solid-router' {\\n  interface StaticDataRouteOption {\\n    customData?: string\\n  }\\n}\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"As long as there are any required properties on the "},{"type":"inlineCode","value":"StaticDataRouteOption"},{"type":"text","value":", you'll be required to pass in an object."}]},{"type":"heading","depth":2,"id":"common-patterns","children":[{"type":"text","value":"Common Patterns"}]},{"type":"heading","depth":3,"id":"controlling-layout-visibility","children":[{"type":"text","value":"Controlling Layout Visibility"}]},{"type":"paragraph","children":[{"type":"text","value":"Use staticData to control which routes show or hide layout elements:"}]},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"export const Route = createFileRoute('/admin')({\n  staticData: { showNavbar: false },\n  component: AdminLayout,\n})","lang":"tsx","meta":"title='src/routes/admin/route.tsx'","title":"src/routes/admin/route.tsx","file":"src/routes/admin/route.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/admin/route.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/admin/route.tsx\",\"code\":\"export const Route = createFileRoute('/admin')({\\n  staticData: { showNavbar: false },\\n  component: AdminLayout,\\n})\",\"language\":\"tsx\"}]}"}},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"// routes/__root.tsx\nfunction RootComponent() {\n  const showNavbar = useMatches({\n    select: (matches) =>\n      !matches.some((m) => m.staticData?.showNavbar === false),\n  })\n\n  return showNavbar ? (\n    <Navbar>\n      <Outlet />\n    </Navbar>\n  ) : (\n    <Outlet />\n  )\n}","lang":"tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"Untitled\"}]}","data-files-meta":"{\"files\":[{\"title\":\"Untitled\",\"code\":\"// routes/__root.tsx\\nfunction RootComponent() {\\n  const showNavbar = useMatches({\\n    select: (matches) =>\\n      !matches.some((m) => m.staticData?.showNavbar === false),\\n  })\\n\\n  return showNavbar ? (\\n    <Navbar>\\n      <Outlet />\\n    </Navbar>\\n  ) : (\\n    <Outlet />\\n  )\\n}\",\"language\":\"tsx\"}]}"}},{"type":"heading","depth":3,"id":"route-titles-for-breadcrumbs","children":[{"type":"text","value":"Route Titles for Breadcrumbs"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"export const Route = createFileRoute('/posts/$postId')({\n  staticData: {\n    getTitle: () => 'Post Details',\n  },\n})","lang":"tsx","meta":"title='src/routes/posts/$postId.tsx'","title":"src/routes/posts/$postId.tsx","file":"src/routes/posts/$postId.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/posts/$postId.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/posts/$postId.tsx\",\"code\":\"export const Route = createFileRoute('/posts/$postId')({\\n  staticData: {\\n    getTitle: () => 'Post Details',\\n  },\\n})\",\"language\":\"tsx\"}]}"}},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"function Breadcrumbs() {\n  const matches = useMatches()\n\n  return (\n    <nav>\n      {matches\n        .filter((m) => m.staticData?.getTitle)\n        .map((m) => (\n          <span key={m.id}>{m.staticData.getTitle()}</span>\n        ))}\n    </nav>\n  )\n}","lang":"tsx","meta":"title='src/components/Breadcrumbs.tsx'","title":"src/components/Breadcrumbs.tsx","file":"src/components/Breadcrumbs.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/components/Breadcrumbs.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/components/Breadcrumbs.tsx\",\"code\":\"function Breadcrumbs() {\\n  const matches = useMatches()\\n\\n  return (\\n    <nav>\\n      {matches\\n        .filter((m) => m.staticData?.getTitle)\\n        .map((m) => (\\n          <span key={m.id}>{m.staticData.getTitle()}</span>\\n        ))}\\n    </nav>\\n  )\\n}\",\"language\":\"tsx\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"export const Route = createFileRoute('/posts/$postId')({\n  staticData: {\n    getTitle: () => 'Post Details',\n  },\n})","lang":"tsx","meta":"title='src/routes/posts/$postId.tsx'","title":"src/routes/posts/$postId.tsx","file":"src/routes/posts/$postId.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/posts/$postId.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/posts/$postId.tsx\",\"code\":\"export const Route = createFileRoute('/posts/$postId')({\\n  staticData: {\\n    getTitle: () => 'Post Details',\\n  },\\n})\",\"language\":\"tsx\"}]}"}},{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { useMatches } from '@tanstack/solid-router'\nimport { For } from 'solid-js'\n\nfunction Breadcrumbs() {\n  const matches = useMatches()\n\n  return (\n    <nav>\n      <For each={matches().filter((m) => m.staticData?.getTitle)}>\n        {(m) => <span>{m.staticData.getTitle()}</span>}\n      </For>\n    </nav>\n  )\n}","lang":"tsx","meta":"title='src/components/Breadcrumbs.tsx'","title":"src/components/Breadcrumbs.tsx","file":"src/components/Breadcrumbs.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/components/Breadcrumbs.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/components/Breadcrumbs.tsx\",\"code\":\"import { useMatches } from '@tanstack/solid-router'\\nimport { For } from 'solid-js'\\n\\nfunction Breadcrumbs() {\\n  const matches = useMatches()\\n\\n  return (\\n    <nav>\\n      <For each={matches().filter((m) => m.staticData?.getTitle)}>\\n        {(m) => <span>{m.staticData.getTitle()}</span>}\\n      </For>\\n    </nav>\\n  )\\n}\",\"language\":\"tsx\"}]}"}}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[],\"solid\":[]}}"}},{"type":"heading","depth":3,"id":"when-to-use-staticdata-vs-context","children":[{"type":"text","value":"When to Use staticData vs Context"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"staticData"}]},{"type":"tableCell","children":[{"type":"text","value":"context"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Synchronous, defined at route creation"}]},{"type":"tableCell","children":[{"type":"text","value":"Can be async (via "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":")"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Available before loading starts"}]},{"type":"tableCell","children":[{"type":"text","value":"Can depend on params/search"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Same for all instances of a route"}]},{"type":"tableCell","children":[{"type":"text","value":"Passed down to child routes"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Use staticData for static route metadata. Use context for dynamic data or auth state that varies per request."}]}],"headings":[{"id":"example","text":"Example","level":2},{"id":"enforcing-static-data","text":"Enforcing Static Data","level":2},{"id":"optional-static-data","text":"Optional Static Data","level":2},{"id":"common-patterns","text":"Common Patterns","level":2},{"id":"controlling-layout-visibility","text":"Controlling Layout Visibility","level":3},{"id":"route-titles-for-breadcrumbs","text":"Route Titles for Breadcrumbs","level":3},{"id":"when-to-use-staticdata-vs-context","text":"When to Use staticData vs Context","level":3}]},"frameworks":["react","solid"],"downloadMarkdown":"\nWhen creating routes, you can optionally specify a `staticData` property in the route's options. This object can literally contain anything you want as long as it's synchronously available when you create your route.\n\nIn addition to being able to access this data from the route itself, you can also access it from any match under the `match.staticData` property.\n\n## Example\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/posts.tsx'\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/posts')({\n  staticData: {\n    customData: 'Hello!',\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\nYou can then access this data anywhere you have access to your routes, including matches that can be mapped back to their routes.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/__root.tsx'\nimport { createRootRoute } from '@tanstack/react-router'\n\nexport const Route = createRootRoute({\n  component: () => {\n    const matches = useMatches()\n\n    return (\n      <div>\n        {matches.map((match) => {\n          return <div key={match.id}>{match.staticData.customData}</div>\n        })}\n      </div>\n    )\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/posts.tsx'\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/posts')({\n  staticData: {\n    customData: 'Hello!',\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\nYou can then access this data anywhere you have access to your routes, including matches that can be mapped back to their routes.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/__root.tsx'\nimport { createRootRoute, useMatches } from '@tanstack/solid-router'\nimport { For } from 'solid-js'\n\nexport const Route = createRootRoute({\n  component: () => {\n    const matches = useMatches()\n\n    return (\n      <div>\n        <For each={matches()}>\n          {(match) => <div>{match.staticData.customData}</div>}\n        </For>\n      </div>\n    )\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n## Enforcing Static Data\n\nIf you want to enforce that a route has static data, you can use declaration merging to add a type to the route's static option:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\ndeclare module '@tanstack/react-router' {\n  interface StaticDataRouteOption {\n    customData: string\n  }\n}\n```\n\n# Solid\n\n```tsx\ndeclare module '@tanstack/solid-router' {\n  interface StaticDataRouteOption {\n    customData: string\n  }\n}\n```\n\n<!-- ::end:framework -->\n\nNow, if you try to create a route without the `customData` property, you'll get a type error:\n\n```tsx\nexport const Route = createFileRoute('/posts')({\n  staticData: {\n    // Property 'customData' is missing in type '{ customData: number; }' but required in type 'StaticDataRouteOption'.ts(2741)\n  },\n})\n```\n\n## Optional Static Data\n\nIf you want to make static data optional, simply add a `?` to the property:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\ndeclare module '@tanstack/react-router' {\n  interface StaticDataRouteOption {\n    customData?: string\n  }\n}\n```\n\n# Solid\n\n```tsx\ndeclare module '@tanstack/solid-router' {\n  interface StaticDataRouteOption {\n    customData?: string\n  }\n}\n```\n\n<!-- ::end:framework -->\n\nAs long as there are any required properties on the `StaticDataRouteOption`, you'll be required to pass in an object.\n\n## Common Patterns\n\n### Controlling Layout Visibility\n\nUse staticData to control which routes show or hide layout elements:\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/admin/route.tsx'\nexport const Route = createFileRoute('/admin')({\n  staticData: { showNavbar: false },\n  component: AdminLayout,\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx\n// routes/__root.tsx\nfunction RootComponent() {\n  const showNavbar = useMatches({\n    select: (matches) =>\n      !matches.some((m) => m.staticData?.showNavbar === false),\n  })\n\n  return showNavbar ? (\n    <Navbar>\n      <Outlet />\n    </Navbar>\n  ) : (\n    <Outlet />\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n### Route Titles for Breadcrumbs\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/posts/$postId.tsx'\nexport const Route = createFileRoute('/posts/$postId')({\n  staticData: {\n    getTitle: () => 'Post Details',\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/components/Breadcrumbs.tsx'\nfunction Breadcrumbs() {\n  const matches = useMatches()\n\n  return (\n    <nav>\n      {matches\n        .filter((m) => m.staticData?.getTitle)\n        .map((m) => (\n          <span key={m.id}>{m.staticData.getTitle()}</span>\n        ))}\n    </nav>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/posts/$postId.tsx'\nexport const Route = createFileRoute('/posts/$postId')({\n  staticData: {\n    getTitle: () => 'Post Details',\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/components/Breadcrumbs.tsx'\nimport { useMatches } from '@tanstack/solid-router'\nimport { For } from 'solid-js'\n\nfunction Breadcrumbs() {\n  const matches = useMatches()\n\n  return (\n    <nav>\n      <For each={matches().filter((m) => m.staticData?.getTitle)}>\n        {(m) => <span>{m.staticData.getTitle()}</span>}\n      </For>\n    </nav>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n### When to Use staticData vs Context\n\n| staticData                             | context                         |\n| -------------------------------------- | ------------------------------- |\n| Synchronous, defined at route creation | Can be async (via `beforeLoad`) |\n| Available before loading starts        | Can depend on params/search     |\n| Same for all instances of a route      | Passed down to child routes     |\n\nUse staticData for static route metadata. Use context for dynamic data or auth state that varies per request.\n","originalRawMarkdown":"---\ntitle: Static Route Data\n---\n\nWhen creating routes, you can optionally specify a `staticData` property in the route's options. This object can literally contain anything you want as long as it's synchronously available when you create your route.\n\nIn addition to being able to access this data from the route itself, you can also access it from any match under the `match.staticData` property.\n\n## Example\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/posts.tsx'\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/posts')({\n  staticData: {\n    customData: 'Hello!',\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\nYou can then access this data anywhere you have access to your routes, including matches that can be mapped back to their routes.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/__root.tsx'\nimport { createRootRoute } from '@tanstack/react-router'\n\nexport const Route = createRootRoute({\n  component: () => {\n    const matches = useMatches()\n\n    return (\n      <div>\n        {matches.map((match) => {\n          return <div key={match.id}>{match.staticData.customData}</div>\n        })}\n      </div>\n    )\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/posts.tsx'\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/posts')({\n  staticData: {\n    customData: 'Hello!',\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\nYou can then access this data anywhere you have access to your routes, including matches that can be mapped back to their routes.\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/__root.tsx'\nimport { createRootRoute, useMatches } from '@tanstack/solid-router'\nimport { For } from 'solid-js'\n\nexport const Route = createRootRoute({\n  component: () => {\n    const matches = useMatches()\n\n    return (\n      <div>\n        <For each={matches()}>\n          {(match) => <div>{match.staticData.customData}</div>}\n        </For>\n      </div>\n    )\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n## Enforcing Static Data\n\nIf you want to enforce that a route has static data, you can use declaration merging to add a type to the route's static option:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\ndeclare module '@tanstack/react-router' {\n  interface StaticDataRouteOption {\n    customData: string\n  }\n}\n```\n\n# Solid\n\n```tsx\ndeclare module '@tanstack/solid-router' {\n  interface StaticDataRouteOption {\n    customData: string\n  }\n}\n```\n\n<!-- ::end:framework -->\n\nNow, if you try to create a route without the `customData` property, you'll get a type error:\n\n```tsx\nexport const Route = createFileRoute('/posts')({\n  staticData: {\n    // Property 'customData' is missing in type '{ customData: number; }' but required in type 'StaticDataRouteOption'.ts(2741)\n  },\n})\n```\n\n## Optional Static Data\n\nIf you want to make static data optional, simply add a `?` to the property:\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\ndeclare module '@tanstack/react-router' {\n  interface StaticDataRouteOption {\n    customData?: string\n  }\n}\n```\n\n# Solid\n\n```tsx\ndeclare module '@tanstack/solid-router' {\n  interface StaticDataRouteOption {\n    customData?: string\n  }\n}\n```\n\n<!-- ::end:framework -->\n\nAs long as there are any required properties on the `StaticDataRouteOption`, you'll be required to pass in an object.\n\n## Common Patterns\n\n### Controlling Layout Visibility\n\nUse staticData to control which routes show or hide layout elements:\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/admin/route.tsx'\nexport const Route = createFileRoute('/admin')({\n  staticData: { showNavbar: false },\n  component: AdminLayout,\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx\n// routes/__root.tsx\nfunction RootComponent() {\n  const showNavbar = useMatches({\n    select: (matches) =>\n      !matches.some((m) => m.staticData?.showNavbar === false),\n  })\n\n  return showNavbar ? (\n    <Navbar>\n      <Outlet />\n    </Navbar>\n  ) : (\n    <Outlet />\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n### Route Titles for Breadcrumbs\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/posts/$postId.tsx'\nexport const Route = createFileRoute('/posts/$postId')({\n  staticData: {\n    getTitle: () => 'Post Details',\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/components/Breadcrumbs.tsx'\nfunction Breadcrumbs() {\n  const matches = useMatches()\n\n  return (\n    <nav>\n      {matches\n        .filter((m) => m.staticData?.getTitle)\n        .map((m) => (\n          <span key={m.id}>{m.staticData.getTitle()}</span>\n        ))}\n    </nav>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/routes/posts/$postId.tsx'\nexport const Route = createFileRoute('/posts/$postId')({\n  staticData: {\n    getTitle: () => 'Post Details',\n  },\n})\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title='src/components/Breadcrumbs.tsx'\nimport { useMatches } from '@tanstack/solid-router'\nimport { For } from 'solid-js'\n\nfunction Breadcrumbs() {\n  const matches = useMatches()\n\n  return (\n    <nav>\n      <For each={matches().filter((m) => m.staticData?.getTitle)}>\n        {(m) => <span>{m.staticData.getTitle()}</span>}\n      </For>\n    </nav>\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\n### When to Use staticData vs Context\n\n| staticData                             | context                         |\n| -------------------------------------- | ------------------------------- |\n| Synchronous, defined at route creation | Can be async (via `beforeLoad`) |\n| Available before loading starts        | Can depend on params/search     |\n| Same for all instances of a route      | Passed down to child routes     |\n\nUse staticData for static route metadata. Use context for dynamic data or auth state that varies per request.\n"}
