{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"draft-build-search-based-filtering-systems","children":[{"type":"text","value":"DRAFT: Build Search-Based Filtering Systems"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Final Destination:"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"docs/router/framework/react/how-to/build-search-filtering-systems.md"},{"type":"text","value":"\n"},{"type":"strong","children":[{"type":"text","value":"Progressive Series Position:"}]},{"type":"text","value":" Specialized Use Cases - Guide #9\n"},{"type":"strong","children":[{"type":"text","value":"Depends On:"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"setup-basic-search-params.md"},{"type":"text","value":", "},{"type":"inlineCode","value":"navigate-with-search-params.md"},{"type":"text","value":", "},{"type":"inlineCode","value":"validate-search-params.md"},{"type":"text","value":"\n"},{"type":"strong","children":[{"type":"text","value":"Status:"}]},{"type":"text","value":" Ready for implementation - comprehensive UI patterns available"}]},{"type":"thematicBreak"},{"type":"heading","depth":2,"id":"content-staged-from-navigate-with-search-params-md","children":[{"type":"text","value":"Content Staged from navigate-with-search-params.md"}]},{"type":"heading","depth":3,"id":"search-result-navigation","children":[{"type":"text","value":"Search Result Navigation"}]},{"type":"paragraph","children":[{"type":"text","value":"Handle search result navigation with query preservation:"}]},{"type":"code","value":"import { Link, useSearch } from '@tanstack/react-router'\n\nfunction SearchResults() {\n  const search = useSearch({ from: '/search' })\n\n  return (\n    <div>\n      {/* Preserve search query, change view */}\n      <nav>\n        <Link search={(prev) => ({ ...prev, view: 'grid' })}>Grid View</Link>\n        <Link search={(prev) => ({ ...prev, view: 'list' })}>List View</Link>\n      </nav>\n\n      {/* Pagination with query preservation */}\n      <div>\n        {search.page > 1 && (\n          <Link search={(prev) => ({ ...prev, page: prev.page - 1 })}>\n            Previous\n          </Link>\n        )}\n\n        <Link search={(prev) => ({ ...prev, page: (prev.page || 1) + 1 })}>\n          Next\n        </Link>\n      </div>\n\n      {/* Related searches */}\n      <div>\n        Related searches:\n        {['laptops gaming', 'laptops business', 'laptops student'].map(\n          (suggestion) => (\n            <Link\n              key={suggestion}\n              search={(prev) => ({ ...prev, query: suggestion, page: 1 })}\n            >\n              {suggestion}\n            </Link>\n          ),\n        )}\n      </div>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"filter-navigation","children":[{"type":"text","value":"Filter Navigation"}]},{"type":"paragraph","children":[{"type":"text","value":"Build filtering interfaces with search parameter navigation:"}]},{"type":"code","value":"import { Link, useSearch } from '@tanstack/react-router'\n\nconst categories = ['electronics', 'clothing', 'books', 'home']\nconst sortOptions = [\n  { value: 'relevance', label: 'Relevance' },\n  { value: 'price-asc', label: 'Price: Low to High' },\n  { value: 'price-desc', label: 'Price: High to Low' },\n  { value: 'rating', label: 'Customer Rating' },\n]\n\nfunction FilterNavigation() {\n  const search = useSearch({ from: '/products' })\n\n  return (\n    <aside>\n      {/* Category filters */}\n      <div>\n        <h3>Categories</h3>\n        {categories.map((category) => (\n          <Link\n            key={category}\n            search={(prev) => ({\n              ...prev,\n              category: prev.category === category ? undefined : category,\n              page: 1,\n            })}\n            className={search.category === category ? 'active' : ''}\n          >\n            {category}\n          </Link>\n        ))}\n      </div>\n\n      {/* Sort options */}\n      <div>\n        <h3>Sort By</h3>\n        {sortOptions.map((option) => (\n          <Link\n            key={option.value}\n            search={(prev) => ({ ...prev, sort: option.value, page: 1 })}\n            className={search.sort === option.value ? 'active' : ''}\n          >\n            {option.label}\n          </Link>\n        ))}\n      </div>\n\n      {/* Clear all filters */}\n      <Link\n        search={(prev) => {\n          const { category, sort, minPrice, maxPrice, ...rest } = prev\n          return rest\n        }}\n      >\n        Clear All Filters\n      </Link>\n    </aside>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"programmatic-search-controls","children":[{"type":"text","value":"Programmatic Search Controls"}]},{"type":"paragraph","children":[{"type":"text","value":"Navigate programmatically with search parameter updates:"}]},{"type":"code","value":"import { useNavigate } from '@tanstack/react-router'\n\nfunction SearchControls() {\n  const navigate = useNavigate()\n\n  const handleSortChange = (sortBy: string) => {\n    navigate({\n      search: (prev) => ({ ...prev, sort: sortBy, page: 1 }),\n    })\n  }\n\n  const handleClearFilters = () => {\n    navigate({\n      search: (prev) => {\n        const { category, minPrice, maxPrice, ...rest } = prev\n        return rest\n      },\n    })\n  }\n\n  return (\n    <div>\n      <select onChange={(e) => handleSortChange(e.target.value)}>\n        <option value=\"relevance\">Sort by Relevance</option>\n        <option value=\"price-asc\">Price: Low to High</option>\n        <option value=\"price-desc\">Price: High to Low</option>\n      </select>\n\n      <button onClick={handleClearFilters}>Clear Filters</button>\n    </div>\n  )\n}","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":2,"id":"implementation-notes","children":[{"type":"text","value":"Implementation Notes"}]},{"type":"heading","depth":3,"id":"additional-content-needed","children":[{"type":"text","value":"Additional Content Needed:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Complete e-commerce filtering example"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Advanced filter combinations (price ranges, multi-select)"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Filter state persistence and sharing"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Search result highlighting and sorting"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Infinite scroll pagination patterns"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Filter URL state management best practices"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Accessibility considerations for filter UIs"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Mobile-responsive filter patterns"}]}],"checked":false}]},{"type":"heading","depth":3,"id":"cross-references-to-add","children":[{"type":"text","value":"Cross-References to Add:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Link to "},{"type":"inlineCode","value":"setup-basic-search-params.md"},{"type":"text","value":" for foundation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Link to "},{"type":"inlineCode","value":"navigate-with-search-params.md"},{"type":"text","value":" for navigation patterns"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Link to "},{"type":"inlineCode","value":"validate-search-params.md"},{"type":"text","value":" for filter validation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Forward link to "},{"type":"inlineCode","value":"search-params-with-data-loading.md"},{"type":"text","value":" for data integration"}]}]}]},{"type":"heading","depth":3,"id":"readme-update-required","children":[{"type":"text","value":"README Update Required:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Mark guide as completed in progressive series"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Uncomment \"Common Next Steps\" in related guides"}]}],"checked":false}]}],"headings":[{"id":"draft-build-search-based-filtering-systems","text":"DRAFT: Build Search-Based Filtering Systems","level":1},{"id":"content-staged-from-navigate-with-search-params-md","text":"Content Staged from navigate-with-search-params.md","level":2},{"id":"search-result-navigation","text":"Search Result Navigation","level":3},{"id":"filter-navigation","text":"Filter Navigation","level":3},{"id":"programmatic-search-controls","text":"Programmatic Search Controls","level":3},{"id":"implementation-notes","text":"Implementation Notes","level":2},{"id":"additional-content-needed","text":"Additional Content Needed:","level":3},{"id":"cross-references-to-add","text":"Cross-References to Add:","level":3},{"id":"readme-update-required","text":"README Update Required:","level":3}]},"frameworks":[],"downloadMarkdown":"# DRAFT: Build Search-Based Filtering Systems\n\n**Final Destination:** `docs/router/framework/react/how-to/build-search-filtering-systems.md`  \n**Progressive Series Position:** Specialized Use Cases - Guide #9  \n**Depends On:** `setup-basic-search-params.md`, `navigate-with-search-params.md`, `validate-search-params.md`  \n**Status:** Ready for implementation - comprehensive UI patterns available\n\n---\n\n## Content Staged from navigate-with-search-params.md\n\n### Search Result Navigation\n\nHandle search result navigation with query preservation:\n\n```tsx\nimport { Link, useSearch } from '@tanstack/react-router'\n\nfunction SearchResults() {\n  const search = useSearch({ from: '/search' })\n\n  return (\n    <div>\n      {/* Preserve search query, change view */}\n      <nav>\n        <Link search={(prev) => ({ ...prev, view: 'grid' })}>Grid View</Link>\n        <Link search={(prev) => ({ ...prev, view: 'list' })}>List View</Link>\n      </nav>\n\n      {/* Pagination with query preservation */}\n      <div>\n        {search.page > 1 && (\n          <Link search={(prev) => ({ ...prev, page: prev.page - 1 })}>\n            Previous\n          </Link>\n        )}\n\n        <Link search={(prev) => ({ ...prev, page: (prev.page || 1) + 1 })}>\n          Next\n        </Link>\n      </div>\n\n      {/* Related searches */}\n      <div>\n        Related searches:\n        {['laptops gaming', 'laptops business', 'laptops student'].map(\n          (suggestion) => (\n            <Link\n              key={suggestion}\n              search={(prev) => ({ ...prev, query: suggestion, page: 1 })}\n            >\n              {suggestion}\n            </Link>\n          ),\n        )}\n      </div>\n    </div>\n  )\n}\n```\n\n### Filter Navigation\n\nBuild filtering interfaces with search parameter navigation:\n\n```tsx\nimport { Link, useSearch } from '@tanstack/react-router'\n\nconst categories = ['electronics', 'clothing', 'books', 'home']\nconst sortOptions = [\n  { value: 'relevance', label: 'Relevance' },\n  { value: 'price-asc', label: 'Price: Low to High' },\n  { value: 'price-desc', label: 'Price: High to Low' },\n  { value: 'rating', label: 'Customer Rating' },\n]\n\nfunction FilterNavigation() {\n  const search = useSearch({ from: '/products' })\n\n  return (\n    <aside>\n      {/* Category filters */}\n      <div>\n        <h3>Categories</h3>\n        {categories.map((category) => (\n          <Link\n            key={category}\n            search={(prev) => ({\n              ...prev,\n              category: prev.category === category ? undefined : category,\n              page: 1,\n            })}\n            className={search.category === category ? 'active' : ''}\n          >\n            {category}\n          </Link>\n        ))}\n      </div>\n\n      {/* Sort options */}\n      <div>\n        <h3>Sort By</h3>\n        {sortOptions.map((option) => (\n          <Link\n            key={option.value}\n            search={(prev) => ({ ...prev, sort: option.value, page: 1 })}\n            className={search.sort === option.value ? 'active' : ''}\n          >\n            {option.label}\n          </Link>\n        ))}\n      </div>\n\n      {/* Clear all filters */}\n      <Link\n        search={(prev) => {\n          const { category, sort, minPrice, maxPrice, ...rest } = prev\n          return rest\n        }}\n      >\n        Clear All Filters\n      </Link>\n    </aside>\n  )\n}\n```\n\n### Programmatic Search Controls\n\nNavigate programmatically with search parameter updates:\n\n```tsx\nimport { useNavigate } from '@tanstack/react-router'\n\nfunction SearchControls() {\n  const navigate = useNavigate()\n\n  const handleSortChange = (sortBy: string) => {\n    navigate({\n      search: (prev) => ({ ...prev, sort: sortBy, page: 1 }),\n    })\n  }\n\n  const handleClearFilters = () => {\n    navigate({\n      search: (prev) => {\n        const { category, minPrice, maxPrice, ...rest } = prev\n        return rest\n      },\n    })\n  }\n\n  return (\n    <div>\n      <select onChange={(e) => handleSortChange(e.target.value)}>\n        <option value=\"relevance\">Sort by Relevance</option>\n        <option value=\"price-asc\">Price: Low to High</option>\n        <option value=\"price-desc\">Price: High to Low</option>\n      </select>\n\n      <button onClick={handleClearFilters}>Clear Filters</button>\n    </div>\n  )\n}\n```\n\n---\n\n## Implementation Notes\n\n### Additional Content Needed:\n\n- [ ] Complete e-commerce filtering example\n- [ ] Advanced filter combinations (price ranges, multi-select)\n- [ ] Filter state persistence and sharing\n- [ ] Search result highlighting and sorting\n- [ ] Infinite scroll pagination patterns\n- [ ] Filter URL state management best practices\n- [ ] Accessibility considerations for filter UIs\n- [ ] Mobile-responsive filter patterns\n\n### Cross-References to Add:\n\n- Link to `setup-basic-search-params.md` for foundation\n- Link to `navigate-with-search-params.md` for navigation patterns\n- Link to `validate-search-params.md` for filter validation\n- Forward link to `search-params-with-data-loading.md` for data integration\n\n### README Update Required:\n\n- [ ] Mark guide as completed in progressive series\n- [ ] Uncomment \"Common Next Steps\" in related guides\n","originalRawMarkdown":"# DRAFT: Build Search-Based Filtering Systems\n\n**Final Destination:** `docs/router/framework/react/how-to/build-search-filtering-systems.md`  \n**Progressive Series Position:** Specialized Use Cases - Guide #9  \n**Depends On:** `setup-basic-search-params.md`, `navigate-with-search-params.md`, `validate-search-params.md`  \n**Status:** Ready for implementation - comprehensive UI patterns available\n\n---\n\n## Content Staged from navigate-with-search-params.md\n\n### Search Result Navigation\n\nHandle search result navigation with query preservation:\n\n```tsx\nimport { Link, useSearch } from '@tanstack/react-router'\n\nfunction SearchResults() {\n  const search = useSearch({ from: '/search' })\n\n  return (\n    <div>\n      {/* Preserve search query, change view */}\n      <nav>\n        <Link search={(prev) => ({ ...prev, view: 'grid' })}>Grid View</Link>\n        <Link search={(prev) => ({ ...prev, view: 'list' })}>List View</Link>\n      </nav>\n\n      {/* Pagination with query preservation */}\n      <div>\n        {search.page > 1 && (\n          <Link search={(prev) => ({ ...prev, page: prev.page - 1 })}>\n            Previous\n          </Link>\n        )}\n\n        <Link search={(prev) => ({ ...prev, page: (prev.page || 1) + 1 })}>\n          Next\n        </Link>\n      </div>\n\n      {/* Related searches */}\n      <div>\n        Related searches:\n        {['laptops gaming', 'laptops business', 'laptops student'].map(\n          (suggestion) => (\n            <Link\n              key={suggestion}\n              search={(prev) => ({ ...prev, query: suggestion, page: 1 })}\n            >\n              {suggestion}\n            </Link>\n          ),\n        )}\n      </div>\n    </div>\n  )\n}\n```\n\n### Filter Navigation\n\nBuild filtering interfaces with search parameter navigation:\n\n```tsx\nimport { Link, useSearch } from '@tanstack/react-router'\n\nconst categories = ['electronics', 'clothing', 'books', 'home']\nconst sortOptions = [\n  { value: 'relevance', label: 'Relevance' },\n  { value: 'price-asc', label: 'Price: Low to High' },\n  { value: 'price-desc', label: 'Price: High to Low' },\n  { value: 'rating', label: 'Customer Rating' },\n]\n\nfunction FilterNavigation() {\n  const search = useSearch({ from: '/products' })\n\n  return (\n    <aside>\n      {/* Category filters */}\n      <div>\n        <h3>Categories</h3>\n        {categories.map((category) => (\n          <Link\n            key={category}\n            search={(prev) => ({\n              ...prev,\n              category: prev.category === category ? undefined : category,\n              page: 1,\n            })}\n            className={search.category === category ? 'active' : ''}\n          >\n            {category}\n          </Link>\n        ))}\n      </div>\n\n      {/* Sort options */}\n      <div>\n        <h3>Sort By</h3>\n        {sortOptions.map((option) => (\n          <Link\n            key={option.value}\n            search={(prev) => ({ ...prev, sort: option.value, page: 1 })}\n            className={search.sort === option.value ? 'active' : ''}\n          >\n            {option.label}\n          </Link>\n        ))}\n      </div>\n\n      {/* Clear all filters */}\n      <Link\n        search={(prev) => {\n          const { category, sort, minPrice, maxPrice, ...rest } = prev\n          return rest\n        }}\n      >\n        Clear All Filters\n      </Link>\n    </aside>\n  )\n}\n```\n\n### Programmatic Search Controls\n\nNavigate programmatically with search parameter updates:\n\n```tsx\nimport { useNavigate } from '@tanstack/react-router'\n\nfunction SearchControls() {\n  const navigate = useNavigate()\n\n  const handleSortChange = (sortBy: string) => {\n    navigate({\n      search: (prev) => ({ ...prev, sort: sortBy, page: 1 }),\n    })\n  }\n\n  const handleClearFilters = () => {\n    navigate({\n      search: (prev) => {\n        const { category, minPrice, maxPrice, ...rest } = prev\n        return rest\n      },\n    })\n  }\n\n  return (\n    <div>\n      <select onChange={(e) => handleSortChange(e.target.value)}>\n        <option value=\"relevance\">Sort by Relevance</option>\n        <option value=\"price-asc\">Price: Low to High</option>\n        <option value=\"price-desc\">Price: High to Low</option>\n      </select>\n\n      <button onClick={handleClearFilters}>Clear Filters</button>\n    </div>\n  )\n}\n```\n\n---\n\n## Implementation Notes\n\n### Additional Content Needed:\n\n- [ ] Complete e-commerce filtering example\n- [ ] Advanced filter combinations (price ranges, multi-select)\n- [ ] Filter state persistence and sharing\n- [ ] Search result highlighting and sorting\n- [ ] Infinite scroll pagination patterns\n- [ ] Filter URL state management best practices\n- [ ] Accessibility considerations for filter UIs\n- [ ] Mobile-responsive filter patterns\n\n### Cross-References to Add:\n\n- Link to `setup-basic-search-params.md` for foundation\n- Link to `navigate-with-search-params.md` for navigation patterns\n- Link to `validate-search-params.md` for filter validation\n- Forward link to `search-params-with-data-loading.md` for data integration\n\n### README Update Required:\n\n- [ ] Mark guide as completed in progressive series\n- [ ] Uncomment \"Common Next Steps\" in related guides\n"}
