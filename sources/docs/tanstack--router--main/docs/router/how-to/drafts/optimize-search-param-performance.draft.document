rn { ...prev, computed: result }\n}, [])\n\n<Link search={updateSearch}>Update</Link>","lang":"tsx"},{"type":"heading","depth":3,"id":"navigation-during-render","children":[{"type":"text","value":"Navigation During Render"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Problem:"}]},{"type":"text","value":" Calling navigate during component render causes infinite loops."}]},{"type":"code","value":"function ProblematicComponent() {\n  const navigate = useNavigate()\n\n  // ❌ Wrong - navigate during render\n  if (someCondition) {\n    navigate({ search: { redirect: true } })\n  }\n\n  return <div>Content</div>\n}\n\nfunction FixedComponent() {\n  const navigate = useNavigate()\n\n  // ✅ Correct - navigate in effect\n  useEffect(() => {\n    if (someCondition) {\n      navigate({ search: { redirect: true } })\n    }\n  }, [someCondition, navigate])\n\n  return <div>Content</div>\n}","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":2,"id":"implementation-notes","children":[{"type":"text","value":"Implementation Notes"}]},{"type":"heading","depth":3,"id":"additional-content-needed","children":[{"type":"text","value":"Additional Content Needed:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Search parameter selectors to prevent unnecessary re-renders"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Debouncing search input updates"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Memoization strategies for expensive search computations"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"React.memo usage with search parameters"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"useMemo patterns for derived search state"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Search parameter batching techniques"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Performance monitoring and profiling search params"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Bundle size optimization strategies"}]}],"checked":false}]},{"type":"heading","depth":3,"id":"cross-references-to-add","children":[{"type":"text","value":"Cross-References to Add:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Link to "},{"type":"inlineCode","value":"setup-basic-search-params.md"},{"type":"text","value":" for foundation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Link to "},{"type":"inlineCode","value":"navigate-with-search-params.md"},{"type":"text","value":" for navigation patterns"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Link to "},{"type":"inlineCode","value":"search-params-in-forms.md"},{"type":"text","value":" for debouncing forms"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Forward link to "},{"type":"inlineCode","value":"debug-search-param-issues.md"},{"type":"text","value":" for debugging performance"}]}]}]},{"type":"heading","depth":3,"id":"readme-update-required","children":[{"type":"text","value":"README Update Required:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Mark guide as completed in progressive series"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Uncomment \"Common Next Steps\" in related guides"}]}],"checked":false}]}],"headings":[{"id":"draft-optimize-search-parameter-performance","text":"DRAFT: Optimize Search Parameter Performance","level":1},{"id":"content-staged-from-navigate-with-search-params-md","text":"Content Staged from navigate-with-search-params.md","level":2},{"id":"performance-issues-with-functional-updates","text":"Performance Issues with Functional Updates","level":3},{"id":"navigation-during-render","text":"Navigation During Render","level":3},{"id":"implementation-notes","text":"Implementation Notes","level":2},{"id":"additional-content-needed","text":"Additional Content Needed:","level":3},{"id":"cross-references-to-add","text":"Cross-References to Add:","level":3},{"id":"readme-update-required","text":"README Update Required:","level":3}]},"frameworks":[],"downloadMarkdown":"# DRAFT: Optimize Search Parameter Performance\n\n**Final Destination:** `docs/router/framework/react/how-to/optimize-search-param-performance.md`  \n**Progressive Series Position:** Advanced Level (Power User Patterns) - Guide #7  \n**Depends On:** `setup-basic-search-params.md`, `navigate-with-search-params.md`  \n**Status:** Ready for implementation - performance patterns available\n\n---\n\n## Content Staged from navigate-with-search-params.md\n\n### Performance Issues with Functional Updates\n\n**Problem:** Complex functional updates cause unnecessary re-renders.\n\n```tsx\n// ❌ Wrong - complex computation in render\n<Link search={(prev) => {\n  // Expensive computation on every render\n  const result = expensiveCalculation(prev)\n  return { ...prev, computed: result }\n}}>\n  Update\n</Link>\n\n// ✅ Correct - memoize or use callback\nconst updateSearch = useCallback((prev) => {\n  const result = expensiveCalculation(prev)\n  return { ...prev, computed: result }\n}, [])\n\n<Link search={updateSearch}>Update</Link>\n```\n\n### Navigation During Render\n\n**Problem:** Calling navigate during component render causes infinite loops.\n\n```tsx\nfunction ProblematicComponent() {\n  const navigate = useNavigate()\n\n  // ❌ Wrong - navigate during render\n  if (someCondition) {\n    navigate({ search: { redirect: true } })\n  }\n\n  return <div>Content</div>\n}\n\nfunction FixedComponent() {\n  const navigate = useNavigate()\n\n  // ✅ Correct - navigate in effect\n  useEffect(() => {\n    if (someCondition) {\n      navigate({ search: { redirect: true } })\n    }\n  }, [someCondition, navigate])\n\n  return <div>Content</div>\n}\n```\n\n---\n\n## Implementation Notes\n\n### Additional Content Needed:\n\n- [ ] Search parameter selectors to prevent unnecessary re-renders\n- [ ] Debouncing search input updates\n- [ ] Memoization strategies for expensive search computations\n- [ ] React.memo usage with search parameters\n- [ ] useMemo patterns for derived search state\n- [ ] Search parameter batching techniques\n- [ ] Performance monitoring and profiling search params\n- [ ] Bundle size optimization strategies\n\n### Cross-References to Add:\n\n- Link to `setup-basic-search-params.md` for foundation\n- Link to `navigate-with-search-params.md` for navigation patterns\n- Link to `search-params-in-forms.md` for debouncing forms\n- Forward link to `debug-search-param-issues.md` for debugging performance\n\n### README Update Required:\n\n- [ ] Mark guide as completed in progressive series\n- [ ] Uncomment \"Common Next Steps\" in related guides\n","originalRawMarkdown":"# DRAFT: Optimize Search Parameter Performance\n\n**Final Destination:** `docs/router/framework/react/how-to/optimize-search-param-performance.md`  \n**Progressive Series Position:** Advanced Level (Power User Patterns) - Guide #7  \n**Depends On:** `setup-basic-search-params.md`, `navigate-with-search-params.md`  \n**Status:** Ready for implementation - performance patterns available\n\n---\n\n## Content Staged from navigate-with-search-params.md\n\n### Performance Issues with Functional Updates\n\n**Problem:** Complex functional updates cause unnecessary re-renders.\n\n```tsx\n// ❌ Wrong - complex computation in render\n<Link search={(prev) => {\n  // Expensive computation on every render\n  const result = expensiveCalculation(prev)\n  return { ...prev, computed: result }\n}}>\n  Update\n</Link>\n\n// ✅ Correct - memoize or use callback\nconst updateSearch = useCallback((prev) => {\n  const result = expensiveCalculation(prev)\n  return { ...prev, computed: result }\n}, [])\n\n<Link search={updateSearch}>Update</Link>\n```\n\n### Navigation During Render\n\n**Problem:** Calling navigate during component render causes infinite loops.\n\n```tsx\nfunction ProblematicComponent() {\n  const navigate = useNavigate()\n\n  // ❌ Wrong - navigate during render\n  if (someCondition) {\n    navigate({ search: { redirect: true } })\n  }\n\n  return <div>Content</div>\n}\n\nfunction FixedComponent() {\n  const navigate = useNavigate()\n\n  // ✅ Correct - navigate in effect\n  useEffect(() => {\n    if (someCondition) {\n      navigate({ search: { redirect: true } })\n    }\n  }, [someCondition, navigate])\n\n  return <div>Content</div>\n}\n```\n\n---\n\n## Implementation Notes\n\n### Additional Content Needed:\n\n- [ ] Search parameter selectors to prevent unnecessary re-renders\n- [ ] Debouncing search input updates\n- [ ] Memoization strategies for expensive search computations\n- [ ] React.memo usage with search parameters\n- [ ] useMemo patterns for derived search state\n- [ ] Search parameter batching techniques\n- [ ] Performance monitoring and profiling search params\n- [ ] Bundle size optimization strategies\n\n### Cross-References to Add:\n\n- Link to `setup-basic-search-params.md` for foundation\n- Link to `navigate-with-search-params.md` for navigation patterns\n- Link to `search-params-in-forms.md` for debouncing forms\n- Forward link to `debug-search-param-issues.md` for debugging performance\n\n### README Update Required:\n\n- [ ] Mark guide as completed in progressive series\n- [ ] Uncomment \"Common Next Steps\" in related guides\n"}
