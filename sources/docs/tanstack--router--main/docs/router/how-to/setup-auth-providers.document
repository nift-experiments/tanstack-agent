---
title: How to Set Up Authentication Providers
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"This guide covers integrating popular authentication services (Auth0, Clerk, Supabase) with TanStack Router."}]},{"type":"heading","depth":2,"id":"quick-start","children":[{"type":"text","value":"Quick Start"}]},{"type":"paragraph","children":[{"type":"text","value":"Choose an authentication provider, install their SDK, wrap your router with their context, and adapt their auth state to work with TanStack Router's context system."}]},{"type":"thematicBreak"},{"type":"heading","depth":2,"id":"auth0-integration","children":[{"type":"text","value":"Auth0 Integration"}]},{"type":"heading","depth":3,"id":"1-install-auth0","children":[{"type":"text","value":"1. Install Auth0"}]},{"type":"code","value":"npm install @auth0/auth0-react","lang":"bash"},{"type":"heading","depth":3,"id":"2-set-up-environment-variables","children":[{"type":"text","value":"2. Set Up Environment Variables"}]},{"type":"paragraph","children":[{"type":"text","value":"Add to your "},{"type":"inlineCode","value":".env"},{"type":"text","value":" file:"}]},{"type":"code","value":"VITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com\nVITE_AUTH0_CLIENT_ID=your_auth0_client_id","lang":"env"},{"type":"heading","depth":3,"id":"3-create-auth0-wrapper","children":[{"type":"text","value":"3. Create Auth0 Wrapper"}]},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/auth/auth0.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { Auth0Provider, useAuth0 } from '@auth0/auth0-react'\nimport { createContext, useContext } from 'react'\n\ninterface Auth0ContextType {\n  isAuthenticated: boolean\n  user: any\n  login: () => void\n  logout: () => void\n  isLoading: boolean\n}\n\nconst Auth0Context = createContext<Auth0ContextType | undefined>(undefined)\n\nexport function Auth0Wrapper({ children }: { children: React.ReactNode }) {\n  return (\n    <Auth0Provider\n      domain={import.meta.env.VITE_AUTH0_DOMAIN}\n      clientId={import.meta.env.VITE_AUTH0_CLIENT_ID}\n      authorizationParams={{\n        redirect_uri: window.location.origin,\n      }}\n    >\n      <Auth0ContextProvider>{children}</Auth0ContextProvider>\n    </Auth0Provider>\n  )\n}\n\nfunction Auth0ContextProvider({ children }: { children: React.ReactNode }) {\n  const { isAuthenticated, user, loginWithRedirect, logout, isLoading } =\n    useAuth0()\n\n  const contextValue = {\n    isAuthenticated,\n    user,\n    login: loginWithRedirect,\n    logout: () =>\n      logout({ logoutParams: { returnTo: window.location.origin } }),\n    isLoading,\n  }\n\n  return (\n    <Auth0Context.Provider value={contextValue}>\n      {children}\n    </Auth0Context.Provider>\n  )\n}\n\nexport function useAuth0Context() {\n  const context = useContext(Auth0Context)\n  if (context === undefined) {\n    throw new Error('useAuth0Context must be used within Auth0Wrapper')\n  }\n  return context\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"4-update-app-configuration","children":[{"type":"text","value":"4. Update App Configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"Update "},{"type":"inlineCode","value":"src/App.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { RouterProvider } from '@tanstack/react-router'\nimport { Auth0Wrapper, useAuth0Context } from './auth/auth0'\nimport { router } from './router'\n\nfunction InnerApp() {\n  const auth = useAuth0Context()\n\n  if (auth.isLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        Loading...\n      </div>\n    )\n  }\n\n  return <RouterProvider router={router} context={{ auth }} />\n}\n\nfunction App() {\n  return (\n    <Auth0Wrapper>\n      <InnerApp />\n    </Auth0Wrapper>\n  )\n}\n\nexport default App","lang":"tsx"},{"type":"heading","depth":3,"id":"5-create-protected-routes","children":[{"type":"text","value":"5. Create Protected Routes"}]},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/routes/_authenticated.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { createFileRoute, redirect, Outlet } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/_authenticated')({\n  beforeLoad: ({ context, location }) => {\n    if (!context.auth.isAuthenticated) {\n      // Auth0 handles login redirects, so just trigger login\n      context.auth.login()\n      return\n    }\n  },\n  component: () => <Outlet />,\n})","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":2,"id":"clerk-integration","children":[{"type":"text","value":"Clerk Integration"}]},{"type":"heading","depth":3,"id":"1-install-clerk","children":[{"type":"text","value":"1. Install Clerk"}]},{"type":"code","value":"npm install @clerk/clerk-react","lang":"bash"},{"type":"heading","depth":3,"id":"2-set-up-environment-variables-2","children":[{"type":"text","value":"2. Set Up Environment Variables"}]},{"type":"paragraph","children":[{"type":"text","value":"Add to your "},{"type":"inlineCode","value":".env"},{"type":"text","value":" file:"}]},{"type":"code","value":"VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key","lang":"env"},{"type":"heading","depth":3,"id":"3-create-clerk-wrapper","children":[{"type":"text","value":"3. Create Clerk Wrapper"}]},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/auth/clerk.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { ClerkProvider, useUser, useAuth } from '@clerk/clerk-react'\n\nexport function ClerkWrapper({ children }: { children: React.ReactNode }) {\n  return (\n    <ClerkProvider publishableKey={import.meta.env.VITE_CLERK_PUBLISHABLE_KEY}>\n      {children}\n    </ClerkProvider>\n  )\n}\n\nexport function useClerkAuth() {\n  const { isSignedIn, isLoaded } = useAuth()\n  const { user } = useUser()\n\n  return {\n    isAuthenticated: isSignedIn,\n    user: user\n      ? {\n          id: user.id,\n          username:\n            user.username || user.primaryEmailAddress?.emailAddress || '',\n          email: user.primaryEmailAddress?.emailAddress || '',\n        }\n      : null,\n    isLoading: !isLoaded,\n    login: () => {\n      // Clerk handles login through components\n      window.location.href = '/sign-in'\n    },\n    logout: () => {\n      // Clerk handles logout through components\n      window.location.href = '/sign-out'\n    },\n  }\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"4-create-clerk-auth-routes","children":[{"type":"text","value":"4. Create Clerk Auth Routes"}]},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/routes/sign-in.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\nimport { SignIn } from '@clerk/clerk-react'\n\nexport const Route = createFileRoute('/sign-in')({\n  component: () => (\n    <div className=\"flex items-center justify-center min-h-screen\">\n      <SignIn redirectUrl=\"/dashboard\" signUpUrl=\"/sign-up\" />\n    </div>\n  ),\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/routes/sign-up.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\nimport { SignUp } from '@clerk/clerk-react'\n\nexport const Route = createFileRoute('/sign-up')({\n  component: () => (\n    <div className=\"flex items-center justify-center min-h-screen\">\n      <SignUp redirectUrl=\"/dashboard\" signInUrl=\"/sign-in\" />\n    </div>\n  ),\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"5-update-app-configuration","children":[{"type":"text","value":"5. Update App Configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"Update "},{"type":"inlineCode","value":"src/App.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { RouterProvider } from '@tanstack/react-router'\nimport { ClerkWrapper, useClerkAuth } from './auth/clerk'\nimport { router } from './router'\n\nfunction InnerApp() {\n  const auth = useClerkAuth()\n\n  if (auth.isLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        Loading...\n      </div>\n    )\n  }\n\n  return <RouterProvider router={router} context={{ auth }} />\n}\n\nfunction App() {\n  return (\n    <ClerkWrapper>\n      <InnerApp />\n    </ClerkWrapper>\n  )\n}\n\nexport default App","lang":"tsx"},{"type":"heading","depth":3,"id":"6-create-protected-routes","children":[{"type":"text","value":"6. Create Protected Routes"}]},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/routes/_authenticated.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { createFileRoute, redirect, Outlet } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/_authenticated')({\n  beforeLoad: ({ context, location }) => {\n    if (!context.auth.isAuthenticated) {\n      throw redirect({\n        to: '/sign-in',\n        search: {\n          redirect: location.href,\n        },\n      })\n    }\n  },\n  component: () => <Outlet />,\n})","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":2,"id":"supabase-integration","children":[{"type":"text","value":"Supabase Integration"}]},{"type":"heading","depth":3,"id":"1-install-supabase","children":[{"type":"text","value":"1. Install Supabase"}]},{"type":"code","value":"npm install @supabase/supabase-js","lang":"bash"},{"type":"heading","depth":3,"id":"2-set-up-environment-variables-3","children":[{"type":"text","value":"2. Set Up Environment Variables"}]},{"type":"paragraph","children":[{"type":"text","value":"Add to your "},{"type":"inlineCode","value":".env"},{"type":"text","value":" file:"}]},{"type":"code","value":"VITE_SUPABASE_URL=https://your-project.supabase.co\nVITE_SUPABASE_ANON_KEY=your_supabase_anon_key","lang":"env"},{"type":"heading","depth":3,"id":"3-create-supabase-client","children":[{"type":"text","value":"3. Create Supabase Client"}]},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/auth/supabase.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { createClient } from '@supabase/supabase-js'\nimport { createContext, useContext, useEffect, useState } from 'react'\n\nconst supabase = createClient(\n  import.meta.env.VITE_SUPABASE_URL,\n  import.meta.env.VITE_SUPABASE_ANON_KEY,\n)\n\ninterface SupabaseAuthState {\n  isAuthenticated: boolean\n  user: any\n  login: (email: string, password: string) => Promise<void>\n  logout: () => Promise<void>\n  isLoading: boolean\n}\n\nconst SupabaseAuthContext = createContext<SupabaseAuthState | undefined>(\n  undefined,\n)\n\nexport function SupabaseAuthProvider({\n  children,\n}: {\n  children: React.ReactNode\n}) {\n  const [user, setUser] = useState(null)\n  const [isAuthenticated, setIsAuthenticated] = useState(false)\n  const [isLoading, setIsLoading] = useState(true)\n\n  useEffect(() => {\n    // Get initial session\n    supabase.auth.getSession().then(({ data: { session } }) => {\n      setUser(session?.user ?? null)\n      setIsAuthenticated(!!session?.user)\n      setIsLoading(false)\n    })\n\n    // Listen for auth changes\n    const {\n      data: { subscription },\n    } = supabase.auth.onAuthStateChange((_event, session) => {\n      setUser(session?.user ?? null)\n      setIsAuthenticated(!!session?.user)\n      setIsLoading(false)\n    })\n\n    return () => subscription.unsubscribe()\n  }, [])\n\n  const login = async (email: string, password: string) => {\n    const { error } = await supabase.auth.signInWithPassword({\n      email,\n      password,\n    })\n    if (error) throw error\n  }\n\n  const logout = async () => {\n    const { error } = await supabase.auth.signOut()\n    if (error) throw error\n  }\n\n  return (\n    <SupabaseAuthContext.Provider\n      value={{\n        isAuthenticated,\n        user,\n        login,\n        logout,\n        isLoading,\n      }}\n    >\n      {children}\n    </SupabaseAuthContext.Provider>\n  )\n}\n\nexport function useSupabaseAuth() {\n  const context = useContext(SupabaseAuthContext)\n  if (context === undefined) {\n    throw new Error('useSupabaseAuth must be used within SupabaseAuthProvider')\n  }\n  return context\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"4-create-login-component","children":[{"type":"text","value":"4. Create Login Component"}]},{"type":"paragraph","children":[{"type":"text","value":"Create "},{"type":"inlineCode","value":"src/routes/login.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { createFileRoute, redirect } from '@tanstack/react-router'\nimport { useState } from 'react'\n\nexport const Route = createFileRoute('/login')({\n  validateSearch: (search) => ({\n    redirect: (search.redirect as string) || '/dashboard',\n  }),\n  beforeLoad: ({ context, search }) => {\n    if (context.auth.isAuthenticated) {\n      throw redirect({ to: search.redirect })\n    }\n  },\n  component: LoginComponent,\n})\n\nfunction LoginComponent() {\n  const { auth } = Route.useRouteContext()\n  const { redirect } = Route.useSearch()\n  const [email, setEmail] = useState('')\n  const [password, setPassword] = useState('')\n  const [isLoading, setIsLoading] = useState(false)\n  const [error, setError] = useState('')\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault()\n    setIsLoading(true)\n    setError('')\n\n    try {\n      await auth.login(email, password)\n      // Supabase auth will automatically update context\n      window.location.href = redirect\n    } catch (err: any) {\n      setError(err.message || 'Login failed')\n    } finally {\n      setIsLoading(false)\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen flex items-center justify-center\">\n      <form\n        onSubmit={handleSubmit}\n        className=\"max-w-md w-full space-y-4 p-6 border rounded-lg\"\n      >\n        <h1 className=\"text-2xl font-bold text-center\">Sign In</h1>\n\n        {error && (\n          <div className=\"bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded\">\n            {error}\n          </div>\n        )}\n\n        <div>\n          <label htmlFor=\"email\" className=\"block text-sm font-medium mb-1\">\n            Email\n          </label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            value={email}\n            onChange={(e) => setEmail(e.target.value)}\n            className=\"w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            required\n          />\n        </div>\n\n        <div>\n          <label htmlFor=\"password\" className=\"block text-sm font-medium mb-1\">\n            Password\n          </label>\n          <input\n            id=\"password\"\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            className=\"w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            required\n          />\n        </div>\n\n        <button\n          type=\"submit\"\n          disabled={isLoading}\n          className=\"w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 disabled:opacity-50\"\n        >\n          {isLoading ? 'Signing in...' : 'Sign In'}\n        </button>\n      </form>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"5-update-app-configuration-2","children":[{"type":"text","value":"5. Update App Configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"Update "},{"type":"inlineCode","value":"src/App.tsx"},{"type":"text","value":":"}]},{"type":"code","value":"import { RouterProvider } from '@tanstack/react-router'\nimport { SupabaseAuthProvider, useSupabaseAuth } from './auth/supabase'\nimport { router } from './router'\n\nfunction InnerApp() {\n  const auth = useSupabaseAuth()\n\n  if (auth.isLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        Loading...\n      </div>\n    )\n  }\n\n  return <RouterProvider router={router} context={{ auth }} />\n}\n\nfunction App() {\n  return (\n    <SupabaseAuthProvider>\n      <InnerApp />\n    </SupabaseAuthProvider>\n  )\n}\n\nexport default App","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":2,"id":"provider-comparison","children":[{"type":"text","value":"Provider Comparison"}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Feature"}]},{"type":"tableCell","children":[{"type":"text","value":"Auth0"}]},{"type":"tableCell","children":[{"type":"text","value":"Clerk"}]},{"type":"tableCell","children":[{"type":"text","value":"Supabase"}]}],"rows":[[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Setup Complexity"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Medium"}]},{"type":"tableCell","children":[{"type":"text","value":"Low"}]},{"type":"tableCell","children":[{"type":"text","value":"Medium"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"UI Components"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Basic"}]},{"type":"tableCell","children":[{"type":"text","value":"Excellent"}]},{"type":"tableCell","children":[{"type":"text","value":"None"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Customization"}]}]},{"type":"tableCell","children":[{"type":"text","value":"High"}]},{"type":"tableCell","children":[{"type":"text","value":"Medium"}]},{"type":"tableCell","children":[{"type":"text","value":"High"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Pricing"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Freemium"}]},{"type":"tableCell","children":[{"type":"text","value":"Freemium"}]},{"type":"tableCell","children":[{"type":"text","value":"Freemium"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Social Login"}]}]},{"type":"tableCell","children":[{"type":"text","value":"✅"}]},{"type":"tableCell","children":[{"type":"text","value":"✅"}]},{"type":"tableCell","children":[{"type":"text","value":"✅"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Enterprise Features"}]}]},{"type":"tableCell","children":[{"type":"text","value":"✅"}]},{"type":"tableCell","children":[{"type":"text","value":"✅"}]},{"type":"tableCell","children":[{"type":"text","value":"✅"}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"text","value":"Database Included"}]}]},{"type":"tableCell","children":[{"type":"text","value":"❌"}]},{"type":"tableCell","children":[{"type":"text","value":"❌"}]},{"type":"tableCell","children":[{"type":"text","value":"✅"}]}]]},{"type":"heading","depth":3,"id":"when-to-choose-each","children":[{"type":"text","value":"When to Choose Each:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Auth0"}]},{"type":"text","value":": Complex enterprise requirements, extensive customization"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Clerk"}]},{"type":"text","value":": Quick setup with beautiful UI components"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Supabase"}]},{"type":"text","value":": Full-stack solution with database and real-time features"}]}]}]},{"type":"thematicBreak"},{"type":"heading","depth":2,"id":"common-problems","children":[{"type":"text","value":"Common Problems"}]},{"type":"heading","depth":3,"id":"provider-context-not-available","children":[{"type":"text","value":"Provider Context Not Available"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Problem:"}]},{"type":"text","value":" Auth context is undefined in components."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Solution:"}]},{"type":"text","value":" Ensure the provider wrapper is above "},{"type":"inlineCode","value":"RouterProvider"},{"type":"text","value":":"}]},{"type":"code","value":"// ✅ Correct order\n<AuthProvider>\n  <InnerApp>\n    <RouterProvider />\n  </InnerApp>\n</AuthProvider>\n\n// ❌ Wrong order\n<RouterProvider>\n  <AuthProvider />\n</RouterProvider>","lang":"tsx"},{"type":"heading","depth":3,"id":"infinite-loading-states","children":[{"type":"text","value":"Infinite Loading States"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Problem:"}]},{"type":"text","value":" App stuck on loading screen."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Solution:"}]},{"type":"text","value":" Check if auth provider properly sets "},{"type":"inlineCode","value":"isLoading"},{"type":"text","value":" to "},{"type":"inlineCode","value":"false"},{"type":"text","value":":"}]},{"type":"code","value":"// Add timeout fallback\nuseEffect(() => {\n  const timeout = setTimeout(() => {\n    if (isLoading) {\n      setIsLoading(false)\n    }\n  }, 5000)\n  return () => clearTimeout(timeout)\n}, [isLoading])","lang":"tsx"},{"type":"heading","depth":3,"id":"redirect-loops-with-auth0","children":[{"type":"text","value":"Redirect Loops with Auth0"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Problem:"}]},{"type":"text","value":" Continuous redirects between login and protected routes."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Solution:"}]},{"type":"text","value":" Handle Auth0's automatic redirects properly:"}]},{"type":"code","value":"export const Route = createFileRoute('/_authenticated')({\n  beforeLoad: ({ context }) => {\n    if (!context.auth.isAuthenticated && !context.auth.isLoading) {\n      context.auth.login()\n      // Don't throw redirect, let Auth0 handle it\n      return\n    }\n  },\n  component: () => <Outlet />,\n})","lang":"tsx"},{"type":"thematicBreak"},{"type":"heading","depth":2,"id":"common-next-steps","children":[{"type":"text","value":"Common Next Steps"}]},{"type":"paragraph","children":[{"type":"text","value":"After integrating authentication providers, you might want to:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./setup-rbac.md","children":[{"type":"text","value":"How to Set Up Role-Based Access Control"}]},{"type":"text","value":" - Add permission-based routing"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./setup-authentication.md","children":[{"type":"text","value":"How to Set Up Basic Authentication"}]},{"type":"text","value":" - Custom auth implementation"}]}]}]},{"type":"html","value":"<!-- TODO: Uncomment as how-to guides are created\n- [How to Handle User Sessions](./handle-user-sessions.md)\n- [How to Set Up Social Login](./setup-social-login.md)\n-->"},{"type":"heading","depth":2,"id":"related-resources","children":[{"type":"text","value":"Related Resources"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://auth0.com/docs/libraries/auth0-react","children":[{"type":"text","value":"Auth0 React SDK"}]},{"type":"text","value":" - Official Auth0 documentation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://clerk.com/docs/references/react/overview","children":[{"type":"text","value":"Clerk React SDK"}]},{"type":"text","value":" - Official Clerk documentation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://supabase.com/docs/guides/auth","children":[{"type":"text","value":"Supabase Auth"}]},{"type":"text","value":" - Official Supabase auth guide"}]}]}]}],"headings":[{"id":"quick-start","text":"Quick Start","level":2},{"id":"auth0-integration","text":"Auth0 Integration","level":2},{"id":"1-install-auth0","text":"1. Install Auth0","level":3},{"id":"2-set-up-environment-variables","text":"2. Set Up Environment Variables","level":3},{"id":"3-create-auth0-wrapper","text":"3. Create Auth0 Wrapper","level":3},{"id":"4-update-app-configuration","text":"4. Update App Configuration","level":3},{"id":"5-create-protected-routes","text":"5. Create Protected Routes","level":3},{"id":"clerk-integration","text":"Clerk Integration","level":2},{"id":"1-install-clerk","text":"1. Install Clerk","level":3},{"id":"2-set-up-environment-variables-2","text":"2. Set Up Environment Variables","level":3},{"id":"3-create-clerk-wrapper","text":"3. Create Clerk Wrapper","level":3},{"id":"4-create-clerk-auth-routes","text":"4. Create Clerk Auth Routes","level":3},{"id":"5-update-app-configuration","text":"5. Update App Configuration","level":3},{"id":"6-create-protected-routes","text":"6. Create Protected Routes","level":3},{"id":"supabase-integration","text":"Supabase Integration","level":2},{"id":"1-install-supabase","text":"1. Install Supabase","level":3},{"id":"2-set-up-environment-variables-3","text":"2. Set Up Environment Variables","level":3},{"id":"3-create-supabase-client","text":"3. Create Supabase Client","level":3},{"id":"4-create-login-component","text":"4. Create Login Component","level":3},{"id":"5-update-app-configuration-2","text":"5. Update App Configuration","level":3},{"id":"provider-comparison","text":"Provider Comparison","level":2},{"id":"when-to-choose-each","text":"When to Choose Each:","level":3},{"id":"common-problems","text":"Common Problems","level":2},{"id":"provider-context-not-available","text":"Provider Context Not Available","level":3},{"id":"infinite-loading-states","text":"Infinite Loading States","level":3},{"id":"redirect-loops-with-auth0","text":"Redirect Loops with Auth0","level":3},{"id":"common-next-steps","text":"Common Next Steps","level":2},{"id":"related-resources","text":"Related Resources","level":2}]},"frameworks":[],"downloadMarkdown":"\nThis guide covers integrating popular authentication services (Auth0, Clerk, Supabase) with TanStack Router.\n\n## Quick Start\n\nChoose an authentication provider, install their SDK, wrap your router with their context, and adapt their auth state to work with TanStack Router's context system.\n\n---\n\n## Auth0 Integration\n\n### 1. Install Auth0\n\n```bash\nnpm install @auth0/auth0-react\n```\n\n### 2. Set Up Environment Variables\n\nAdd to your `.env` file:\n\n```env\nVITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com\nVITE_AUTH0_CLIENT_ID=your_auth0_client_id\n```\n\n### 3. Create Auth0 Wrapper\n\nCreate `src/auth/auth0.tsx`:\n\n```tsx\nimport { Auth0Provider, useAuth0 } from '@auth0/auth0-react'\nimport { createContext, useContext } from 'react'\n\ninterface Auth0ContextType {\n  isAuthenticated: boolean\n  user: any\n  login: () => void\n  logout: () => void\n  isLoading: boolean\n}\n\nconst Auth0Context = createContext<Auth0ContextType | undefined>(undefined)\n\nexport function Auth0Wrapper({ children }: { children: React.ReactNode }) {\n  return (\n    <Auth0Provider\n      domain={import.meta.env.VITE_AUTH0_DOMAIN}\n      clientId={import.meta.env.VITE_AUTH0_CLIENT_ID}\n      authorizationParams={{\n        redirect_uri: window.location.origin,\n      }}\n    >\n      <Auth0ContextProvider>{children}</Auth0ContextProvider>\n    </Auth0Provider>\n  )\n}\n\nfunction Auth0ContextProvider({ children }: { children: React.ReactNode }) {\n  const { isAuthenticated, user, loginWithRedirect, logout, isLoading } =\n    useAuth0()\n\n  const contextValue = {\n    isAuthenticated,\n    user,\n    login: loginWithRedirect,\n    logout: () =>\n      logout({ logoutParams: { returnTo: window.location.origin } }),\n    isLoading,\n  }\n\n  return (\n    <Auth0Context.Provider value={contextValue}>\n      {children}\n    </Auth0Context.Provider>\n  )\n}\n\nexport function useAuth0Context() {\n  const context = useContext(Auth0Context)\n  if (context === undefined) {\n    throw new Error('useAuth0Context must be used within Auth0Wrapper')\n  }\n  return context\n}\n```\n\n### 4. Update App Configuration\n\nUpdate `src/App.tsx`:\n\n```tsx\nimport { RouterProvider } from '@tanstack/react-router'\nimport { Auth0Wrapper, useAuth0Context } from './auth/auth0'\nimport { router } from './router'\n\nfunction InnerApp() {\n  const auth = useAuth0Context()\n\n  if (auth.isLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        Loading...\n      </div>\n    )\n  }\n\n  return <RouterProvider router={router} context={{ auth }} />\n}\n\nfunction App() {\n  return (\n    <Auth0Wrapper>\n      <InnerApp />\n    </Auth0Wrapper>\n  )\n}\n\nexport default App\n```\n\n### 5. Create Protected Routes\n\nCreate `src/routes/_authenticated.tsx`:\n\n```tsx\nimport { createFileRoute, redirect, Outlet } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/_authenticated')({\n  beforeLoad: ({ context, location }) => {\n    if (!context.auth.isAuthenticated) {\n      // Auth0 handles login redirects, so just trigger login\n      context.auth.login()\n      return\n    }\n  },\n  component: () => <Outlet />,\n})\n```\n\n---\n\n## Clerk Integration\n\n### 1. Install Clerk\n\n```bash\nnpm install @clerk/clerk-react\n```\n\n### 2. Set Up Environment Variables\n\nAdd to your `.env` file:\n\n```env\nVITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key\n```\n\n### 3. Create Clerk Wrapper\n\nCreate `src/auth/clerk.tsx`:\n\n```tsx\nimport { ClerkProvider, useUser, useAuth } from '@clerk/clerk-react'\n\nexport function ClerkWrapper({ children }: { children: React.ReactNode }) {\n  return (\n    <ClerkProvider publishableKey={import.meta.env.VITE_CLERK_PUBLISHABLE_KEY}>\n      {children}\n    </ClerkProvider>\n  )\n}\n\nexport function useClerkAuth() {\n  const { isSignedIn, isLoaded } = useAuth()\n  const { user } = useUser()\n\n  return {\n    isAuthenticated: isSignedIn,\n    user: user\n      ? {\n          id: user.id,\n          username:\n            user.username || user.primaryEmailAddress?.emailAddress || '',\n          email: user.primaryEmailAddress?.emailAddress || '',\n        }\n      : null,\n    isLoading: !isLoaded,\n    login: () => {\n      // Clerk handles login through components\n      window.location.href = '/sign-in'\n    },\n    logout: () => {\n      // Clerk handles logout through components\n      window.location.href = '/sign-out'\n    },\n  }\n}\n```\n\n### 4. Create Clerk Auth Routes\n\nCreate `src/routes/sign-in.tsx`:\n\n```tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { SignIn } from '@clerk/clerk-react'\n\nexport const Route = createFileRoute('/sign-in')({\n  component: () => (\n    <div className=\"flex items-center justify-center min-h-screen\">\n      <SignIn redirectUrl=\"/dashboard\" signUpUrl=\"/sign-up\" />\n    </div>\n  ),\n})\n```\n\nCreate `src/routes/sign-up.tsx`:\n\n```tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { SignUp } from '@clerk/clerk-react'\n\nexport const Route = createFileRoute('/sign-up')({\n  component: () => (\n    <div className=\"flex items-center justify-center min-h-screen\">\n      <SignUp redirectUrl=\"/dashboard\" signInUrl=\"/sign-in\" />\n    </div>\n  ),\n})\n```\n\n### 5. Update App Configuration\n\nUpdate `src/App.tsx`:\n\n```tsx\nimport { RouterProvider } from '@tanstack/react-router'\nimport { ClerkWrapper, useClerkAuth } from './auth/clerk'\nimport { router } from './router'\n\nfunction InnerApp() {\n  const auth = useClerkAuth()\n\n  if (auth.isLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        Loading...\n      </div>\n    )\n  }\n\n  return <RouterProvider router={router} context={{ auth }} />\n}\n\nfunction App() {\n  return (\n    <ClerkWrapper>\n      <InnerApp />\n    </ClerkWrapper>\n  )\n}\n\nexport default App\n```\n\n### 6. Create Protected Routes\n\nCreate `src/routes/_authenticated.tsx`:\n\n```tsx\nimport { createFileRoute, redirect, Outlet } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/_authenticated')({\n  beforeLoad: ({ context, location }) => {\n    if (!context.auth.isAuthenticated) {\n      throw redirect({\n        to: '/sign-in',\n        search: {\n          redirect: location.href,\n        },\n      })\n    }\n  },\n  component: () => <Outlet />,\n})\n```\n\n---\n\n## Supabase Integration\n\n### 1. Install Supabase\n\n```bash\nnpm install @supabase/supabase-js\n```\n\n### 2. Set Up Environment Variables\n\nAdd to your `.env` file:\n\n```env\nVITE_SUPABASE_URL=https://your-project.supabase.co\nVITE_SUPABASE_ANON_KEY=your_supabase_anon_key\n```\n\n### 3. Create Supabase Client\n\nCreate `src/auth/supabase.tsx`:\n\n```tsx\nimport { createClient } from '@supabase/supabase-js'\nimport { createContext, useContext, useEffect, useState } from 'react'\n\nconst supabase = createClient(\n  import.meta.env.VITE_SUPABASE_URL,\n  import.meta.env.VITE_SUPABASE_ANON_KEY,\n)\n\ninterface SupabaseAuthState {\n  isAuthenticated: boolean\n  user: any\n  login: (email: string, password: string) => Promise<void>\n  logout: () => Promise<void>\n  isLoading: boolean\n}\n\nconst SupabaseAuthContext = createContext<SupabaseAuthState | undefined>(\n  undefined,\n)\n\nexport function SupabaseAuthProvider({\n  children,\n}: {\n  children: React.ReactNode\n}) {\n  const [user, setUser] = useState(null)\n  const [isAuthenticated, setIsAuthenticated] = useState(false)\n  const [isLoading, setIsLoading] = useState(true)\n\n  useEffect(() => {\n    // Get initial session\n    supabase.auth.getSession().then(({ data: { session } }) => {\n      setUser(session?.user ?? null)\n      setIsAuthenticated(!!session?.user)\n      setIsLoading(false)\n    })\n\n    // Listen for auth changes\n    const {\n      data: { subscription },\n    } = supabase.auth.onAuthStateChange((_event, session) => {\n      setUser(session?.user ?? null)\n      setIsAuthenticated(!!session?.user)\n      setIsLoading(false)\n    })\n\n    return () => subscription.unsubscribe()\n  }, [])\n\n  const login = async (email: string, password: string) => {\n    const { error } = await supabase.auth.signInWithPassword({\n      email,\n      password,\n    })\n    if (error) throw error\n  }\n\n  const logout = async () => {\n    const { error } = await supabase.auth.signOut()\n    if (error) throw error\n  }\n\n  return (\n    <SupabaseAuthContext.Provider\n      value={{\n        isAuthenticated,\n        user,\n        login,\n        logout,\n        isLoading,\n      }}\n    >\n      {children}\n    </SupabaseAuthContext.Provider>\n  )\n}\n\nexport function useSupabaseAuth() {\n  const context = useContext(SupabaseAuthContext)\n  if (context === undefined) {\n    throw new Error('useSupabaseAuth must be used within SupabaseAuthProvider')\n  }\n  return context\n}\n```\n\n### 4. Create Login Component\n\nCreate `src/routes/login.tsx`:\n\n```tsx\nimport { createFileRoute, redirect } from '@tanstack/react-router'\nimport { useState } from 'react'\n\nexport const Route = createFileRoute('/login')({\n  validateSearch: (search) => ({\n    redirect: (search.redirect as string) || '/dashboard',\n  }),\n  beforeLoad: ({ context, search }) => {\n    if (context.auth.isAuthenticated) {\n      throw redirect({ to: search.redirect })\n    }\n  },\n  component: LoginComponent,\n})\n\nfunction LoginComponent() {\n  const { auth } = Route.useRouteContext()\n  const { redirect } = Route.useSearch()\n  const [email, setEmail] = useState('')\n  const [password, setPassword] = useState('')\n  const [isLoading, setIsLoading] = useState(false)\n  const [error, setError] = useState('')\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault()\n    setIsLoading(true)\n    setError('')\n\n    try {\n      await auth.login(email, password)\n      // Supabase auth will automatically update context\n      window.location.href = redirect\n    } catch (err: any) {\n      setError(err.message || 'Login failed')\n    } finally {\n      setIsLoading(false)\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen flex items-center justify-center\">\n      <form\n        onSubmit={handleSubmit}\n        className=\"max-w-md w-full space-y-4 p-6 border rounded-lg\"\n      >\n        <h1 className=\"text-2xl font-bold text-center\">Sign In</h1>\n\n        {error && (\n          <div className=\"bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded\">\n            {error}\n          </div>\n        )}\n\n        <div>\n          <label htmlFor=\"email\" className=\"block text-sm font-medium mb-1\">\n            Email\n          </label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            value={email}\n            onChange={(e) => setEmail(e.target.value)}\n            className=\"w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            required\n          />\n        </div>\n\n        <div>\n          <label htmlFor=\"password\" className=\"block text-sm font-medium mb-1\">\n            Password\n          </label>\n          <input\n            id=\"password\"\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            className=\"w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            required\n          />\n        </div>\n\n        <button\n          type=\"submit\"\n          disabled={isLoading}\n          className=\"w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 disabled:opacity-50\"\n        >\n          {isLoading ? 'Signing in...' : 'Sign In'}\n        </button>\n      </form>\n    </div>\n  )\n}\n```\n\n### 5. Update App Configuration\n\nUpdate `src/App.tsx`:\n\n```tsx\nimport { RouterProvider } from '@tanstack/react-router'\nimport { SupabaseAuthProvider, useSupabaseAuth } from './auth/supabase'\nimport { router } from './router'\n\nfunction InnerApp() {\n  const auth = useSupabaseAuth()\n\n  if (auth.isLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        Loading...\n      </div>\n    )\n  }\n\n  return <RouterProvider router={router} context={{ auth }} />\n}\n\nfunction App() {\n  return (\n    <SupabaseAuthProvider>\n      <InnerApp />\n    </SupabaseAuthProvider>\n  )\n}\n\nexport default App\n```\n\n---\n\n## Provider Comparison\n\n| Feature                 | Auth0    | Clerk     | Supabase |\n| ----------------------- | -------- | --------- | -------- |\n| **Setup Complexity**    | Medium   | Low       | Medium   |\n| **UI Components**       | Basic    | Excellent | None     |\n| **Customization**       | High     | Medium    | High     |\n| **Pricing**             | Freemium | Freemium  | Freemium |\n| **Social Login**        | ✅       | ✅        | ✅       |\n| **Enterprise Features** | ✅       | ✅        | ✅       |\n| **Database Included**   | ❌       | ❌        | ✅       |\n\n### When to Choose Each:\n\n- **Auth0**: Complex enterprise requirements, extensive customization\n- **Clerk**: Quick setup with beautiful UI components\n- **Supabase**: Full-stack solution with database and real-time features\n\n---\n\n## Common Problems\n\n### Provider Context Not Available\n\n**Problem:** Auth context is undefined in components.\n\n**Solution:** Ensure the provider wrapper is above `RouterProvider`:\n\n```tsx\n// ✅ Correct order\n<AuthProvider>\n  <InnerApp>\n    <RouterProvider />\n  </InnerApp>\n</AuthProvider>\n\n// ❌ Wrong order\n<RouterProvider>\n  <AuthProvider />\n</RouterProvider>\n```\n\n### Infinite Loading States\n\n**Problem:** App stuck on loading screen.\n\n**Solution:** Check if auth provider properly sets `isLoading` to `false`:\n\n```tsx\n// Add timeout fallback\nuseEffect(() => {\n  const timeout = setTimeout(() => {\n    if (isLoading) {\n      setIsLoading(false)\n    }\n  }, 5000)\n  return () => clearTimeout(timeout)\n}, [isLoading])\n```\n\n### Redirect Loops with Auth0\n\n**Problem:** Continuous redirects between login and protected routes.\n\n**Solution:** Handle Auth0's automatic redirects properly:\n\n```tsx\nexport const Route = createFileRoute('/_authenticated')({\n  beforeLoad: ({ context }) => {\n    if (!context.auth.isAuthenticated && !context.auth.isLoading) {\n      context.auth.login()\n      // Don't throw redirect, let Auth0 handle it\n      return\n    }\n  },\n  component: () => <Outlet />,\n})\n```\n\n---\n\n## Common Next Steps\n\nAfter integrating authentication providers, you might want to:\n\n- [How to Set Up Role-Based Access Control](./setup-rbac.md) - Add permission-based routing\n- [How to Set Up Basic Authentication](./setup-authentication.md) - Custom auth implementation\n\n<!-- TODO: Uncomment as how-to guides are created\n- [How to Handle User Sessions](./handle-user-sessions.md)\n- [How to Set Up Social Login](./setup-social-login.md)\n-->\n\n## Related Resources\n\n- [Auth0 React SDK](https://auth0.com/docs/libraries/auth0-react) - Official Auth0 documentation\n- [Clerk React SDK](https://clerk.com/docs/references/react/overview) - Official Clerk documentation\n- [Supabase Auth](https://supabase.com/docs/guides/auth) - Official Supabase auth guide\n","originalRawMarkdown":"---\ntitle: How to Set Up Authentication Providers\n---\n\nThis guide covers integrating popular authentication services (Auth0, Clerk, Supabase) with TanStack Router.\n\n## Quick Start\n\nChoose an authentication provider, install their SDK, wrap your router with their context, and adapt their auth state to work with TanStack Router's context system.\n\n---\n\n## Auth0 Integration\n\n### 1. Install Auth0\n\n```bash\nnpm install @auth0/auth0-react\n```\n\n### 2. Set Up Environment Variables\n\nAdd to your `.env` file:\n\n```env\nVITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com\nVITE_AUTH0_CLIENT_ID=your_auth0_client_id\n```\n\n### 3. Create Auth0 Wrapper\n\nCreate `src/auth/auth0.tsx`:\n\n```tsx\nimport { Auth0Provider, useAuth0 } from '@auth0/auth0-react'\nimport { createContext, useContext } from 'react'\n\ninterface Auth0ContextType {\n  isAuthenticated: boolean\n  user: any\n  login: () => void\n  logout: () => void\n  isLoading: boolean\n}\n\nconst Auth0Context = createContext<Auth0ContextType | undefined>(undefined)\n\nexport function Auth0Wrapper({ children }: { children: React.ReactNode }) {\n  return (\n    <Auth0Provider\n      domain={import.meta.env.VITE_AUTH0_DOMAIN}\n      clientId={import.meta.env.VITE_AUTH0_CLIENT_ID}\n      authorizationParams={{\n        redirect_uri: window.location.origin,\n      }}\n    >\n      <Auth0ContextProvider>{children}</Auth0ContextProvider>\n    </Auth0Provider>\n  )\n}\n\nfunction Auth0ContextProvider({ children }: { children: React.ReactNode }) {\n  const { isAuthenticated, user, loginWithRedirect, logout, isLoading } =\n    useAuth0()\n\n  const contextValue = {\n    isAuthenticated,\n    user,\n    login: loginWithRedirect,\n    logout: () =>\n      logout({ logoutParams: { returnTo: window.location.origin } }),\n    isLoading,\n  }\n\n  return (\n    <Auth0Context.Provider value={contextValue}>\n      {children}\n    </Auth0Context.Provider>\n  )\n}\n\nexport function useAuth0Context() {\n  const context = useContext(Auth0Context)\n  if (context === undefined) {\n    throw new Error('useAuth0Context must be used within Auth0Wrapper')\n  }\n  return context\n}\n```\n\n### 4. Update App Configuration\n\nUpdate `src/App.tsx`:\n\n```tsx\nimport { RouterProvider } from '@tanstack/react-router'\nimport { Auth0Wrapper, useAuth0Context } from './auth/auth0'\nimport { router } from './router'\n\nfunction InnerApp() {\n  const auth = useAuth0Context()\n\n  if (auth.isLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        Loading...\n      </div>\n    )\n  }\n\n  return <RouterProvider router={router} context={{ auth }} />\n}\n\nfunction App() {\n  return (\n    <Auth0Wrapper>\n      <InnerApp />\n    </Auth0Wrapper>\n  )\n}\n\nexport default App\n```\n\n### 5. Create Protected Routes\n\nCreate `src/routes/_authenticated.tsx`:\n\n```tsx\nimport { createFileRoute, redirect, Outlet } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/_authenticated')({\n  beforeLoad: ({ context, location }) => {\n    if (!context.auth.isAuthenticated) {\n      // Auth0 handles login redirects, so just trigger login\n      context.auth.login()\n      return\n    }\n  },\n  component: () => <Outlet />,\n})\n```\n\n---\n\n## Clerk Integration\n\n### 1. Install Clerk\n\n```bash\nnpm install @clerk/clerk-react\n```\n\n### 2. Set Up Environment Variables\n\nAdd to your `.env` file:\n\n```env\nVITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key\n```\n\n### 3. Create Clerk Wrapper\n\nCreate `src/auth/clerk.tsx`:\n\n```tsx\nimport { ClerkProvider, useUser, useAuth } from '@clerk/clerk-react'\n\nexport function ClerkWrapper({ children }: { children: React.ReactNode }) {\n  return (\n    <ClerkProvider publishableKey={import.meta.env.VITE_CLERK_PUBLISHABLE_KEY}>\n      {children}\n    </ClerkProvider>\n  )\n}\n\nexport function useClerkAuth() {\n  const { isSignedIn, isLoaded } = useAuth()\n  const { user } = useUser()\n\n  return {\n    isAuthenticated: isSignedIn,\n    user: user\n      ? {\n          id: user.id,\n          username:\n            user.username || user.primaryEmailAddress?.emailAddress || '',\n          email: user.primaryEmailAddress?.emailAddress || '',\n        }\n      : null,\n    isLoading: !isLoaded,\n    login: () => {\n      // Clerk handles login through components\n      window.location.href = '/sign-in'\n    },\n    logout: () => {\n      // Clerk handles logout through components\n      window.location.href = '/sign-out'\n    },\n  }\n}\n```\n\n### 4. Create Clerk Auth Routes\n\nCreate `src/routes/sign-in.tsx`:\n\n```tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { SignIn } from '@clerk/clerk-react'\n\nexport const Route = createFileRoute('/sign-in')({\n  component: () => (\n    <div className=\"flex items-center justify-center min-h-screen\">\n      <SignIn redirectUrl=\"/dashboard\" signUpUrl=\"/sign-up\" />\n    </div>\n  ),\n})\n```\n\nCreate `src/routes/sign-up.tsx`:\n\n```tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { SignUp } from '@clerk/clerk-react'\n\nexport const Route = createFileRoute('/sign-up')({\n  component: () => (\n    <div className=\"flex items-center justify-center min-h-screen\">\n      <SignUp redirectUrl=\"/dashboard\" signInUrl=\"/sign-in\" />\n    </div>\n  ),\n})\n```\n\n### 5. Update App Configuration\n\nUpdate `src/App.tsx`:\n\n```tsx\nimport { RouterProvider } from '@tanstack/react-router'\nimport { ClerkWrapper, useClerkAuth } from './auth/clerk'\nimport { router } from './router'\n\nfunction InnerApp() {\n  const auth = useClerkAuth()\n\n  if (auth.isLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        Loading...\n      </div>\n    )\n  }\n\n  return <RouterProvider router={router} context={{ auth }} />\n}\n\nfunction App() {\n  return (\n    <ClerkWrapper>\n      <InnerApp />\n    </ClerkWrapper>\n  )\n}\n\nexport default App\n```\n\n### 6. Create Protected Routes\n\nCreate `src/routes/_authenticated.tsx`:\n\n```tsx\nimport { createFileRoute, redirect, Outlet } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/_authenticated')({\n  beforeLoad: ({ context, location }) => {\n    if (!context.auth.isAuthenticated) {\n      throw redirect({\n        to: '/sign-in',\n        search: {\n          redirect: location.href,\n        },\n      })\n    }\n  },\n  component: () => <Outlet />,\n})\n```\n\n---\n\n## Supabase Integration\n\n### 1. Install Supabase\n\n```bash\nnpm install @supabase/supabase-js\n```\n\n### 2. Set Up Environment Variables\n\nAdd to your `.env` file:\n\n```env\nVITE_SUPABASE_URL=https://your-project.supabase.co\nVITE_SUPABASE_ANON_KEY=your_supabase_anon_key\n```\n\n### 3. Create Supabase Client\n\nCreate `src/auth/supabase.tsx`:\n\n```tsx\nimport { createClient } from '@supabase/supabase-js'\nimport { createContext, useContext, useEffect, useState } from 'react'\n\nconst supabase = createClient(\n  import.meta.env.VITE_SUPABASE_URL,\n  import.meta.env.VITE_SUPABASE_ANON_KEY,\n)\n\ninterface SupabaseAuthState {\n  isAuthenticated: boolean\n  user: any\n  login: (email: string, password: string) => Promise<void>\n  logout: () => Promise<void>\n  isLoading: boolean\n}\n\nconst SupabaseAuthContext = createContext<SupabaseAuthState | undefined>(\n  undefined,\n)\n\nexport function SupabaseAuthProvider({\n  children,\n}: {\n  children: React.ReactNode\n}) {\n  const [user, setUser] = useState(null)\n  const [isAuthenticated, setIsAuthenticated] = useState(false)\n  const [isLoading, setIsLoading] = useState(true)\n\n  useEffect(() => {\n    // Get initial session\n    supabase.auth.getSession().then(({ data: { session } }) => {\n      setUser(session?.user ?? null)\n      setIsAuthenticated(!!session?.user)\n      setIsLoading(false)\n    })\n\n    // Listen for auth changes\n    const {\n      data: { subscription },\n    } = supabase.auth.onAuthStateChange((_event, session) => {\n      setUser(session?.user ?? null)\n      setIsAuthenticated(!!session?.user)\n      setIsLoading(false)\n    })\n\n    return () => subscription.unsubscribe()\n  }, [])\n\n  const login = async (email: string, password: string) => {\n    const { error } = await supabase.auth.signInWithPassword({\n      email,\n      password,\n    })\n    if (error) throw error\n  }\n\n  const logout = async () => {\n    const { error } = await supabase.auth.signOut()\n    if (error) throw error\n  }\n\n  return (\n    <SupabaseAuthContext.Provider\n      value={{\n        isAuthenticated,\n        user,\n        login,\n        logout,\n        isLoading,\n      }}\n    >\n      {children}\n    </SupabaseAuthContext.Provider>\n  )\n}\n\nexport function useSupabaseAuth() {\n  const context = useContext(SupabaseAuthContext)\n  if (context === undefined) {\n    throw new Error('useSupabaseAuth must be used within SupabaseAuthProvider')\n  }\n  return context\n}\n```\n\n### 4. Create Login Component\n\nCreate `src/routes/login.tsx`:\n\n```tsx\nimport { createFileRoute, redirect } from '@tanstack/react-router'\nimport { useState } from 'react'\n\nexport const Route = createFileRoute('/login')({\n  validateSearch: (search) => ({\n    redirect: (search.redirect as string) || '/dashboard',\n  }),\n  beforeLoad: ({ context, search }) => {\n    if (context.auth.isAuthenticated) {\n      throw redirect({ to: search.redirect })\n    }\n  },\n  component: LoginComponent,\n})\n\nfunction LoginComponent() {\n  const { auth } = Route.useRouteContext()\n  const { redirect } = Route.useSearch()\n  const [email, setEmail] = useState('')\n  const [password, setPassword] = useState('')\n  const [isLoading, setIsLoading] = useState(false)\n  const [error, setError] = useState('')\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault()\n    setIsLoading(true)\n    setError('')\n\n    try {\n      await auth.login(email, password)\n      // Supabase auth will automatically update context\n      window.location.href = redirect\n    } catch (err: any) {\n      setError(err.message || 'Login failed')\n    } finally {\n      setIsLoading(false)\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen flex items-center justify-center\">\n      <form\n        onSubmit={handleSubmit}\n        className=\"max-w-md w-full space-y-4 p-6 border rounded-lg\"\n      >\n        <h1 className=\"text-2xl font-bold text-center\">Sign In</h1>\n\n        {error && (\n          <div className=\"bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded\">\n            {error}\n          </div>\n        )}\n\n        <div>\n          <label htmlFor=\"email\" className=\"block text-sm font-medium mb-1\">\n            Email\n          </label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            value={email}\n            onChange={(e) => setEmail(e.target.value)}\n            className=\"w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            required\n          />\n        </div>\n\n        <div>\n          <label htmlFor=\"password\" className=\"block text-sm font-medium mb-1\">\n            Password\n          </label>\n          <input\n            id=\"password\"\n            type=\"password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            className=\"w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            required\n          />\n        </div>\n\n        <button\n          type=\"submit\"\n          disabled={isLoading}\n          className=\"w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 disabled:opacity-50\"\n        >\n          {isLoading ? 'Signing in...' : 'Sign In'}\n        </button>\n      </form>\n    </div>\n  )\n}\n```\n\n### 5. Update App Configuration\n\nUpdate `src/App.tsx`:\n\n```tsx\nimport { RouterProvider } from '@tanstack/react-router'\nimport { SupabaseAuthProvider, useSupabaseAuth } from './auth/supabase'\nimport { router } from './router'\n\nfunction InnerApp() {\n  const auth = useSupabaseAuth()\n\n  if (auth.isLoading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen\">\n        Loading...\n      </div>\n    )\n  }\n\n  return <RouterProvider router={router} context={{ auth }} />\n}\n\nfunction App() {\n  return (\n    <SupabaseAuthProvider>\n      <InnerApp />\n    </SupabaseAuthProvider>\n  )\n}\n\nexport default App\n```\n\n---\n\n## Provider Comparison\n\n| Feature                 | Auth0    | Clerk     | Supabase |\n| ----------------------- | -------- | --------- | -------- |\n| **Setup Complexity**    | Medium   | Low       | Medium   |\n| **UI Components**       | Basic    | Excellent | None     |\n| **Customization**       | High     | Medium    | High     |\n| **Pricing**             | Freemium | Freemium  | Freemium |\n| **Social Login**        | ✅       | ✅        | ✅       |\n| **Enterprise Features** | ✅       | ✅        | ✅       |\n| **Database Included**   | ❌       | ❌        | ✅       |\n\n### When to Choose Each:\n\n- **Auth0**: Complex enterprise requirements, extensive customization\n- **Clerk**: Quick setup with beautiful UI components\n- **Supabase**: Full-stack solution with database and real-time features\n\n---\n\n## Common Problems\n\n### Provider Context Not Available\n\n**Problem:** Auth context is undefined in components.\n\n**Solution:** Ensure the provider wrapper is above `RouterProvider`:\n\n```tsx\n// ✅ Correct order\n<AuthProvider>\n  <InnerApp>\n    <RouterProvider />\n  </InnerApp>\n</AuthProvider>\n\n// ❌ Wrong order\n<RouterProvider>\n  <AuthProvider />\n</RouterProvider>\n```\n\n### Infinite Loading States\n\n**Problem:** App stuck on loading screen.\n\n**Solution:** Check if auth provider properly sets `isLoading` to `false`:\n\n```tsx\n// Add timeout fallback\nuseEffect(() => {\n  const timeout = setTimeout(() => {\n    if (isLoading) {\n      setIsLoading(false)\n    }\n  }, 5000)\n  return () => clearTimeout(timeout)\n}, [isLoading])\n```\n\n### Redirect Loops with Auth0\n\n**Problem:** Continuous redirects between login and protected routes.\n\n**Solution:** Handle Auth0's automatic redirects properly:\n\n```tsx\nexport const Route = createFileRoute('/_authenticated')({\n  beforeLoad: ({ context }) => {\n    if (!context.auth.isAuthenticated && !context.auth.isLoading) {\n      context.auth.login()\n      // Don't throw redirect, let Auth0 handle it\n      return\n    }\n  },\n  component: () => <Outlet />,\n})\n```\n\n---\n\n## Common Next Steps\n\nAfter integrating authentication providers, you might want to:\n\n- [How to Set Up Role-Based Access Control](./setup-rbac.md) - Add permission-based routing\n- [How to Set Up Basic Authentication](./setup-authentication.md) - Custom auth implementation\n\n<!-- TODO: Uncomment as how-to guides are created\n- [How to Handle User Sessions](./handle-user-sessions.md)\n- [How to Set Up Social Login](./setup-social-login.md)\n-->\n\n## Related Resources\n\n- [Auth0 React SDK](https://auth0.com/docs/libraries/auth0-react) - Official Auth0 documentation\n- [Clerk React SDK](https://clerk.com/docs/references/react/overview) - Official Clerk documentation\n- [Supabase Auth](https://supabase.com/docs/guides/auth) - Official Supabase auth guide\n"}
