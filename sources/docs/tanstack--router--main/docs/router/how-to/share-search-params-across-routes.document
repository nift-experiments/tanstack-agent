{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Search parameters automatically inherit from parent routes in TanStack Router. When a parent route validates search parameters, child routes can access them via "},{"type":"inlineCode","value":"Route.useSearch()"},{"type":"text","value":" alongside their own parameters."}]},{"type":"heading","depth":2,"id":"how-parameter-inheritance-works","children":[{"type":"text","value":"How Parameter Inheritance Works"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Router automatically merges search parameters from parent routes with child route parameters. This happens through the route hierarchy:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Parent route"}]},{"type":"text","value":" validates shared parameters with "},{"type":"inlineCode","value":"validateSearch"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Child routes"}]},{"type":"text","value":" automatically inherit those validated parameters"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"Route.useSearch()"}]},{"type":"text","value":" returns both local and inherited parameters"}]}]}]},{"type":"heading","depth":2,"id":"global-parameters-via-root-route","children":[{"type":"text","value":"Global Parameters via Root Route"}]},{"type":"paragraph","children":[{"type":"text","value":"Share parameters across your entire application by validating them in the root route:"}]},{"type":"code","value":"// routes/__root.tsx\nimport { createRootRoute, Outlet } from '@tanstack/react-router'\nimport { z } from 'zod'\n\nconst globalSearchSchema = z.object({\n  theme: z.enum(['light', 'dark']).default('light'),\n  lang: z.enum(['en', 'es', 'fr']).default('en'),\n  debug: z.boolean().default(false),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: globalSearchSchema,\n  component: RootComponent,\n})\n\nfunction RootComponent() {\n  const { theme, lang, debug } = Route.useSearch()\n\n  return (\n    <div className={`app theme-${theme} lang-${lang}`}>\n      {debug && <DebugPanel />}\n      <Outlet />\n    </div>\n  )\n}","lang":"tsx"},{"type":"code","value":"// routes/products/index.tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  category: z.string().default('all'),\n})\n\nexport const Route = createFileRoute('/products/')({\n  validateSearch: productSearchSchema,\n  component: ProductsPage,\n})\n\nfunction ProductsPage() {\n  // Contains both local (page, category) AND inherited (theme, lang, debug) parameters\n  const search = Route.useSearch()\n\n  return (\n    <div>\n      <h1>Products (Theme: {search.theme})</h1>\n      <p>Page: {search.page}</p>\n      <p>Category: {search.category}</p>\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"section-specific-parameters-via-layout-routes","children":[{"type":"text","value":"Section-Specific Parameters via Layout Routes"}]},{"type":"paragraph","children":[{"type":"text","value":"Share parameters within a section of your app using layout routes:"}]},{"type":"code","value":"// routes/_authenticated.tsx\nimport { createFileRoute, Outlet } from '@tanstack/react-router'\nimport { z } from 'zod'\n\nconst authSearchSchema = z.object({\n  impersonate: z.string().optional(),\n  sidebar: z.boolean().default(true),\n  notifications: z.boolean().default(true),\n})\n\nexport const Route = createFileRoute('/_authenticated')({\n  validateSearch: authSearchSchema,\n  component: AuthenticatedLayout,\n})\n\nfunction AuthenticatedLayout() {\n  const search = Route.useSearch()\n\n  return (\n    <div className=\"authenticated-layout\">\n      {search.sidebar && <Sidebar />}\n      <main className=\"main-content\">\n        {search.notifications && <NotificationBar />}\n        <Outlet />\n      </main>\n      {search.impersonate && <ImpersonationBanner user={search.impersonate} />}\n    </div>\n  )\n}","lang":"tsx"},{"type":"code","value":"// routes/_authenticated/dashboard.tsx\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/_authenticated/dashboard')({\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  // Contains inherited auth parameters (impersonate, sidebar, notifications)\n  const search = Route.useSearch()\n\n  return (\n    <div>\n      <h1>Dashboard</h1>\n      {search.impersonate && (\n        <Alert>Currently impersonating: {search.impersonate}</Alert>\n      )}\n      <DashboardContent />\n    </div>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"common-use-cases","children":[{"type":"text","value":"Common Use Cases"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Global Application Settings:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Theme, language, timezone"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Debug flags, feature toggles"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Analytics tracking (UTM parameters)"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Section-Specific State:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Authentication context (user role, impersonation)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Layout preferences (sidebar, density)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Workspace or organization context"}]}]}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Persistent UI State:"}]}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Modal visibility, drawer state"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Filter presets, view modes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Accessibility preferences"}]}]}]},{"type":"heading","depth":2,"id":"common-problems","children":[{"type":"text","value":"Common Problems"}]},{"type":"heading","depth":3,"id":"problem-parameters-not-inheriting","children":[{"type":"text","value":"Problem: Parameters Not Inheriting"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Cause"}]},{"type":"text","value":": Parent route not validating the shared parameters."}]},{"type":"code","value":"// ❌ Root route missing validateSearch\nexport const Route = createRootRoute({\n  component: RootComponent, // No validateSearch\n})\n\n// Child route can't access theme parameter\nfunction ProductsPage() {\n  const search = Route.useSearch() // No theme available\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Solution"}]},{"type":"text","value":": Add "},{"type":"inlineCode","value":"validateSearch"},{"type":"text","value":" to the parent route:"}]},{"type":"code","value":"// ✅ Root route validates shared parameters\nexport const Route = createRootRoute({\n  validateSearch: globalSearchSchema,\n  component: RootComponent,\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"problem-navigation-loses-shared-parameters","children":[{"type":"text","value":"Problem: Navigation Loses Shared Parameters"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Cause"}]},{"type":"text","value":": Not preserving inherited parameters during navigation."}]},{"type":"code","value":"// ❌ Navigation overwrites all search parameters\nrouter.navigate({\n  to: '/products',\n  search: { page: 1 }, // Loses theme, lang, etc.\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Solution"}]},{"type":"text","value":": Preserve existing parameters with function syntax:"}]},{"type":"code","value":"// ✅ Preserve existing parameters\nrouter.navigate({\n  to: '/products',\n  search: (prev) => ({ ...prev, page: 1 }),\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"problem-type-errors-with-inherited-parameters","children":[{"type":"text","value":"Problem: Type Errors with Inherited Parameters"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Cause"}]},{"type":"text","value":": Child route schema doesn't account for inherited parameters."}]},{"type":"code","value":"// ❌ TypeScript error: Property 'theme' doesn't exist\nconst search = Route.useSearch()\nconsole.log(search.theme) // Type error","lang":"tsx"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Solution"}]},{"type":"text","value":": TypeScript automatically infers inherited types when using "},{"type":"inlineCode","value":"validateSearch"},{"type":"text","value":". No additional typing needed - the inheritance works automatically."}]},{"type":"heading","depth":2,"id":"production-checklist","children":[{"type":"text","value":"Production Checklist"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Clear ownership"}]},{"type":"text","value":": Document which route validates which shared parameters"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Avoid conflicts"}]},{"type":"text","value":": Use distinct parameter names across route levels"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Preserve on navigation"}]},{"type":"text","value":": Use function syntax to maintain inherited parameters"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Minimal URLs"}]},{"type":"text","value":": Only include essential shared parameters"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Graceful defaults"}]},{"type":"text","value":": Provide fallback values for all shared parameters"}]}],"checked":false}]},{"type":"html","value":"<!--\n## Common Next Steps\n\nAfter implementing shared search parameters, you might want to:\n\n- [Build Advanced Search Parameter Middleware](./advanced-search-param-middleware.md) - Create reusable parameter sharing logic\n- [Handle Search Parameters in Forms](./search-params-in-forms.md) - Integrate shared parameters with form state\n- [Debug Search Parameter Issues](./debug-search-param-issues.md) - Troubleshoot parameter sharing problems\n-->"},{"type":"heading","depth":2,"id":"related-resources","children":[{"type":"text","value":"Related Resources"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./setup-basic-search-params.md","children":[{"type":"text","value":"Set Up Basic Search Parameters"}]},{"type":"text","value":" - Learn search parameter fundamentals"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./navigate-with-search-params.md","children":[{"type":"text","value":"Navigate with Search Parameters"}]},{"type":"text","value":" - Navigate while preserving search state"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./validate-search-params.md","children":[{"type":"text","value":"Validate Search Parameters with Schemas"}]},{"type":"text","value":" - Add type safety to shared parameters"}]}]}]}],"headings":[{"id":"how-parameter-inheritance-works","text":"How Parameter Inheritance Works","level":2},{"id":"global-parameters-via-root-route","text":"Global Parameters via Root Route","level":2},{"id":"section-specific-parameters-via-layout-routes","text":"Section-Specific Parameters via Layout Routes","level":2},{"id":"common-use-cases","text":"Common Use Cases","level":2},{"id":"common-problems","text":"Common Problems","level":2},{"id":"problem-parameters-not-inheriting","text":"Problem: Parameters Not Inheriting","level":3},{"id":"problem-navigation-loses-shared-parameters","text":"Problem: Navigation Loses Shared Parameters","level":3},{"id":"problem-type-errors-with-inherited-parameters","text":"Problem: Type Errors with Inherited Parameters","level":3},{"id":"production-checklist","text":"Production Checklist","level":2},{"id":"related-resources","text":"Related Resources","level":2}]},"frameworks":[],"downloadMarkdown":"\nSearch parameters automatically inherit from parent routes in TanStack Router. When a parent route validates search parameters, child routes can access them via `Route.useSearch()` alongside their own parameters.\n\n## How Parameter Inheritance Works\n\nTanStack Router automatically merges search parameters from parent routes with child route parameters. This happens through the route hierarchy:\n\n1. **Parent route** validates shared parameters with `validateSearch`\n2. **Child routes** automatically inherit those validated parameters\n3. **`Route.useSearch()`** returns both local and inherited parameters\n\n## Global Parameters via Root Route\n\nShare parameters across your entire application by validating them in the root route:\n\n```tsx\n// routes/__root.tsx\nimport { createRootRoute, Outlet } from '@tanstack/react-router'\nimport { z } from 'zod'\n\nconst globalSearchSchema = z.object({\n  theme: z.enum(['light', 'dark']).default('light'),\n  lang: z.enum(['en', 'es', 'fr']).default('en'),\n  debug: z.boolean().default(false),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: globalSearchSchema,\n  component: RootComponent,\n})\n\nfunction RootComponent() {\n  const { theme, lang, debug } = Route.useSearch()\n\n  return (\n    <div className={`app theme-${theme} lang-${lang}`}>\n      {debug && <DebugPanel />}\n      <Outlet />\n    </div>\n  )\n}\n```\n\n```tsx\n// routes/products/index.tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  category: z.string().default('all'),\n})\n\nexport const Route = createFileRoute('/products/')({\n  validateSearch: productSearchSchema,\n  component: ProductsPage,\n})\n\nfunction ProductsPage() {\n  // Contains both local (page, category) AND inherited (theme, lang, debug) parameters\n  const search = Route.useSearch()\n\n  return (\n    <div>\n      <h1>Products (Theme: {search.theme})</h1>\n      <p>Page: {search.page}</p>\n      <p>Category: {search.category}</p>\n    </div>\n  )\n}\n```\n\n## Section-Specific Parameters via Layout Routes\n\nShare parameters within a section of your app using layout routes:\n\n```tsx\n// routes/_authenticated.tsx\nimport { createFileRoute, Outlet } from '@tanstack/react-router'\nimport { z } from 'zod'\n\nconst authSearchSchema = z.object({\n  impersonate: z.string().optional(),\n  sidebar: z.boolean().default(true),\n  notifications: z.boolean().default(true),\n})\n\nexport const Route = createFileRoute('/_authenticated')({\n  validateSearch: authSearchSchema,\n  component: AuthenticatedLayout,\n})\n\nfunction AuthenticatedLayout() {\n  const search = Route.useSearch()\n\n  return (\n    <div className=\"authenticated-layout\">\n      {search.sidebar && <Sidebar />}\n      <main className=\"main-content\">\n        {search.notifications && <NotificationBar />}\n        <Outlet />\n      </main>\n      {search.impersonate && <ImpersonationBanner user={search.impersonate} />}\n    </div>\n  )\n}\n```\n\n```tsx\n// routes/_authenticated/dashboard.tsx\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/_authenticated/dashboard')({\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  // Contains inherited auth parameters (impersonate, sidebar, notifications)\n  const search = Route.useSearch()\n\n  return (\n    <div>\n      <h1>Dashboard</h1>\n      {search.impersonate && (\n        <Alert>Currently impersonating: {search.impersonate}</Alert>\n      )}\n      <DashboardContent />\n    </div>\n  )\n}\n```\n\n## Common Use Cases\n\n**Global Application Settings:**\n\n- Theme, language, timezone\n- Debug flags, feature toggles\n- Analytics tracking (UTM parameters)\n\n**Section-Specific State:**\n\n- Authentication context (user role, impersonation)\n- Layout preferences (sidebar, density)\n- Workspace or organization context\n\n**Persistent UI State:**\n\n- Modal visibility, drawer state\n- Filter presets, view modes\n- Accessibility preferences\n\n## Common Problems\n\n### Problem: Parameters Not Inheriting\n\n**Cause**: Parent route not validating the shared parameters.\n\n```tsx\n// ❌ Root route missing validateSearch\nexport const Route = createRootRoute({\n  component: RootComponent, // No validateSearch\n})\n\n// Child route can't access theme parameter\nfunction ProductsPage() {\n  const search = Route.useSearch() // No theme available\n}\n```\n\n**Solution**: Add `validateSearch` to the parent route:\n\n```tsx\n// ✅ Root route validates shared parameters\nexport const Route = createRootRoute({\n  validateSearch: globalSearchSchema,\n  component: RootComponent,\n})\n```\n\n### Problem: Navigation Loses Shared Parameters\n\n**Cause**: Not preserving inherited parameters during navigation.\n\n```tsx\n// ❌ Navigation overwrites all search parameters\nrouter.navigate({\n  to: '/products',\n  search: { page: 1 }, // Loses theme, lang, etc.\n})\n```\n\n**Solution**: Preserve existing parameters with function syntax:\n\n```tsx\n// ✅ Preserve existing parameters\nrouter.navigate({\n  to: '/products',\n  search: (prev) => ({ ...prev, page: 1 }),\n})\n```\n\n### Problem: Type Errors with Inherited Parameters\n\n**Cause**: Child route schema doesn't account for inherited parameters.\n\n```tsx\n// ❌ TypeScript error: Property 'theme' doesn't exist\nconst search = Route.useSearch()\nconsole.log(search.theme) // Type error\n```\n\n**Solution**: TypeScript automatically infers inherited types when using `validateSearch`. No additional typing needed - the inheritance works automatically.\n\n## Production Checklist\n\n- [ ] **Clear ownership**: Document which route validates which shared parameters\n- [ ] **Avoid conflicts**: Use distinct parameter names across route levels\n- [ ] **Preserve on navigation**: Use function syntax to maintain inherited parameters\n- [ ] **Minimal URLs**: Only include essential shared parameters\n- [ ] **Graceful defaults**: Provide fallback values for all shared parameters\n\n<!--\n## Common Next Steps\n\nAfter implementing shared search parameters, you might want to:\n\n- [Build Advanced Search Parameter Middleware](./advanced-search-param-middleware.md) - Create reusable parameter sharing logic\n- [Handle Search Parameters in Forms](./search-params-in-forms.md) - Integrate shared parameters with form state\n- [Debug Search Parameter Issues](./debug-search-param-issues.md) - Troubleshoot parameter sharing problems\n-->\n\n## Related Resources\n\n- [Set Up Basic Search Parameters](./setup-basic-search-params.md) - Learn search parameter fundamentals\n- [Navigate with Search Parameters](./navigate-with-search-params.md) - Navigate while preserving search state\n- [Validate Search Parameters with Schemas](./validate-search-params.md) - Add type safety to shared parameters\n","originalRawMarkdown":"---\ntitle: Share Search Parameters Across Routes\n---\n\nSearch parameters automatically inherit from parent routes in TanStack Router. When a parent route validates search parameters, child routes can access them via `Route.useSearch()` alongside their own parameters.\n\n## How Parameter Inheritance Works\n\nTanStack Router automatically merges search parameters from parent routes with child route parameters. This happens through the route hierarchy:\n\n1. **Parent route** validates shared parameters with `validateSearch`\n2. **Child routes** automatically inherit those validated parameters\n3. **`Route.useSearch()`** returns both local and inherited parameters\n\n## Global Parameters via Root Route\n\nShare parameters across your entire application by validating them in the root route:\n\n```tsx\n// routes/__root.tsx\nimport { createRootRoute, Outlet } from '@tanstack/react-router'\nimport { z } from 'zod'\n\nconst globalSearchSchema = z.object({\n  theme: z.enum(['light', 'dark']).default('light'),\n  lang: z.enum(['en', 'es', 'fr']).default('en'),\n  debug: z.boolean().default(false),\n})\n\nexport const Route = createRootRoute({\n  validateSearch: globalSearchSchema,\n  component: RootComponent,\n})\n\nfunction RootComponent() {\n  const { theme, lang, debug } = Route.useSearch()\n\n  return (\n    <div className={`app theme-${theme} lang-${lang}`}>\n      {debug && <DebugPanel />}\n      <Outlet />\n    </div>\n  )\n}\n```\n\n```tsx\n// routes/products/index.tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { z } from 'zod'\n\nconst productSearchSchema = z.object({\n  page: z.number().default(1),\n  category: z.string().default('all'),\n})\n\nexport const Route = createFileRoute('/products/')({\n  validateSearch: productSearchSchema,\n  component: ProductsPage,\n})\n\nfunction ProductsPage() {\n  // Contains both local (page, category) AND inherited (theme, lang, debug) parameters\n  const search = Route.useSearch()\n\n  return (\n    <div>\n      <h1>Products (Theme: {search.theme})</h1>\n      <p>Page: {search.page}</p>\n      <p>Category: {search.category}</p>\n    </div>\n  )\n}\n```\n\n## Section-Specific Parameters via Layout Routes\n\nShare parameters within a section of your app using layout routes:\n\n```tsx\n// routes/_authenticated.tsx\nimport { createFileRoute, Outlet } from '@tanstack/react-router'\nimport { z } from 'zod'\n\nconst authSearchSchema = z.object({\n  impersonate: z.string().optional(),\n  sidebar: z.boolean().default(true),\n  notifications: z.boolean().default(true),\n})\n\nexport const Route = createFileRoute('/_authenticated')({\n  validateSearch: authSearchSchema,\n  component: AuthenticatedLayout,\n})\n\nfunction AuthenticatedLayout() {\n  const search = Route.useSearch()\n\n  return (\n    <div className=\"authenticated-layout\">\n      {search.sidebar && <Sidebar />}\n      <main className=\"main-content\">\n        {search.notifications && <NotificationBar />}\n        <Outlet />\n      </main>\n      {search.impersonate && <ImpersonationBanner user={search.impersonate} />}\n    </div>\n  )\n}\n```\n\n```tsx\n// routes/_authenticated/dashboard.tsx\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/_authenticated/dashboard')({\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  // Contains inherited auth parameters (impersonate, sidebar, notifications)\n  const search = Route.useSearch()\n\n  return (\n    <div>\n      <h1>Dashboard</h1>\n      {search.impersonate && (\n        <Alert>Currently impersonating: {search.impersonate}</Alert>\n      )}\n      <DashboardContent />\n    </div>\n  )\n}\n```\n\n## Common Use Cases\n\n**Global Application Settings:**\n\n- Theme, language, timezone\n- Debug flags, feature toggles\n- Analytics tracking (UTM parameters)\n\n**Section-Specific State:**\n\n- Authentication context (user role, impersonation)\n- Layout preferences (sidebar, density)\n- Workspace or organization context\n\n**Persistent UI State:**\n\n- Modal visibility, drawer state\n- Filter presets, view modes\n- Accessibility preferences\n\n## Common Problems\n\n### Problem: Parameters Not Inheriting\n\n**Cause**: Parent route not validating the shared parameters.\n\n```tsx\n// ❌ Root route missing validateSearch\nexport const Route = createRootRoute({\n  component: RootComponent, // No validateSearch\n})\n\n// Child route can't access theme parameter\nfunction ProductsPage() {\n  const search = Route.useSearch() // No theme available\n}\n```\n\n**Solution**: Add `validateSearch` to the parent route:\n\n```tsx\n// ✅ Root route validates shared parameters\nexport const Route = createRootRoute({\n  validateSearch: globalSearchSchema,\n  component: RootComponent,\n})\n```\n\n### Problem: Navigation Loses Shared Parameters\n\n**Cause**: Not preserving inherited parameters during navigation.\n\n```tsx\n// ❌ Navigation overwrites all search parameters\nrouter.navigate({\n  to: '/products',\n  search: { page: 1 }, // Loses theme, lang, etc.\n})\n```\n\n**Solution**: Preserve existing parameters with function syntax:\n\n```tsx\n// ✅ Preserve existing parameters\nrouter.navigate({\n  to: '/products',\n  search: (prev) => ({ ...prev, page: 1 }),\n})\n```\n\n### Problem: Type Errors with Inherited Parameters\n\n**Cause**: Child route schema doesn't account for inherited parameters.\n\n```tsx\n// ❌ TypeScript error: Property 'theme' doesn't exist\nconst search = Route.useSearch()\nconsole.log(search.theme) // Type error\n```\n\n**Solution**: TypeScript automatically infers inherited types when using `validateSearch`. No additional typing needed - the inheritance works automatically.\n\n## Production Checklist\n\n- [ ] **Clear ownership**: Document which route validates which shared parameters\n- [ ] **Avoid conflicts**: Use distinct parameter names across route levels\n- [ ] **Preserve on navigation**: Use function syntax to maintain inherited parameters\n- [ ] **Minimal URLs**: Only include essential shared parameters\n- [ ] **Graceful defaults**: Provide fallback values for all shared parameters\n\n<!--\n## Common Next Steps\n\nAfter implementing shared search parameters, you might want to:\n\n- [Build Advanced Search Parameter Middleware](./advanced-search-param-middleware.md) - Create reusable parameter sharing logic\n- [Handle Search Parameters in Forms](./search-params-in-forms.md) - Integrate shared parameters with form state\n- [Debug Search Parameter Issues](./debug-search-param-issues.md) - Troubleshoot parameter sharing problems\n-->\n\n## Related Resources\n\n- [Set Up Basic Search Parameters](./setup-basic-search-params.md) - Learn search parameter fundamentals\n- [Navigate with Search Parameters](./navigate-with-search-params.md) - Navigate while preserving search state\n- [Validate Search Parameters with Schemas](./validate-search-params.md) - Add type safety to shared parameters\n"}
