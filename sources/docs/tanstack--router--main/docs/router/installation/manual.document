{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"To set up TanStack Router manually in a React project, follow the steps below. This gives you a bare minimum setup to get going with TanStack Router using both file-based route generation and code-based route configuration:"}]},{"type":"heading","depth":2,"id":"using-file-based-route-generation","children":[{"type":"text","value":"Using File-Based Route Generation"}]},{"type":"heading","depth":4,"id":"install-tanstack-router-vite-plugin-and-the-router-devtools","children":[{"type":"text","value":"Install TanStack Router, Vite Plugin, and the Router Devtools"}]},{"type":"paragraph","children":[{"type":"text","value":"Install the necessary core dependencies:"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-managers"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/react-router\",\"@tanstack/react-router-devtools\"]],\"solid\":[[\"@tanstack/solid-router\",\"@tanstack/solid-router-devtools\"]]},\"mode\":\"install\"}"}},{"type":"paragraph","children":[{"type":"text","value":"Install the necessary development dependencies:"}]},{"type":"component","name":"tabs","attributes":{"variant":"package-managers","mode":"dev-install"},"children":[],"properties":{"data-package-manager-meta":"{\"packagesByFramework\":{\"react\":[[\"@tanstack/router-plugin\"]],\"solid\":[[\"@tanstack/router-plugin\"]]},\"mode\":\"dev-install\"}"}},{"type":"heading","depth":4,"id":"configure-the-vite-plugin","children":[{"type":"text","value":"Configure the Vite Plugin"}]},{"type":"code","value":"// vite.config.ts\nimport { defineConfig } from 'vite'\nimport react from '@vitejs/plugin-react'\nimport { tanstackRouter } from '@tanstack/router-plugin/vite'\n\n// https://vitejs.dev/config/\nexport default defineConfig({\n  plugins: [\n    // Please make sure that '@tanstack/router-plugin' is passed before '@vitejs/plugin-react'\n    tanstackRouter({\n      target: 'react',\n      autoCodeSplitting: true,\n    }),\n    react(),\n    // ...,\n  ],\n})","lang":"tsx"},{"type":"callout","kind":"tip","title":"Tip","children":[{"type":"paragraph","children":[{"type":"text","value":"If you are not using Vite, or any of the supported bundlers, you can check out the "},{"type":"link","href":"./with-router-cli","children":[{"type":"text","value":"TanStack Router CLI"}]},{"type":"text","value":" guide for more info."}]}]},{"type":"paragraph","children":[{"type":"text","value":"Create the following files:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"src/routes/__root.tsx"},{"type":"text","value":" (with two '"},{"type":"inlineCode","value":"_"},{"type":"text","value":"' characters)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"src/routes/index.tsx"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"src/routes/about.tsx"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"src/main.tsx"}]}]}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { createRootRoute, Link, Outlet } from '@tanstack/react-router'\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\n\nconst RootLayout = () => (\n  <>\n    <div className=\"p-2 flex gap-2\">\n      <Link to=\"/\" className=\"[&.active]:font-bold\">\n        Home\n      </Link>{' '}\n      <Link to=\"/about\" className=\"[&.active]:font-bold\">\n        About\n      </Link>\n    </div>\n    <hr />\n    <Outlet />\n    <TanStackRouterDevtools />\n  </>\n)\n\nexport const Route = createRootRoute({ component: RootLayout })","lang":"tsx","meta":"title=\"src/routes/__root.tsx\"","title":"src/routes/__root.tsx","file":"src/routes/__root.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/')({\n  component: Index,\n})\n\nfunction Index() {\n  return (\n    <div className=\"p-2\">\n      <h3>Welcome Home!</h3>\n    </div>\n  )\n}","lang":"tsx","meta":"title=\"src/routes/index.tsx\"","title":"src/routes/index.tsx","file":"src/routes/index.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-2","data-tab-index":"2"},"children":[{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/about')({\n  component: About,\n})\n\nfunction About() {\n  return <div className=\"p-2\">Hello from About!</div>\n}","lang":"tsx","meta":"title=\"src/routes/about.tsx\"","title":"src/routes/about.tsx","file":"src/routes/about.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-3","data-tab-index":"3"},"children":[{"type":"code","value":"import { StrictMode } from 'react'\nimport ReactDOM from 'react-dom/client'\nimport { RouterProvider, createRouter } from '@tanstack/react-router'\n\n// Import the generated route tree\nimport { routeTree } from './routeTree.gen'\n\n// Create a new router instance\nconst router = createRouter({ routeTree })\n\n// Register the router instance for type safety\ndeclare module '@tanstack/react-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\n// Render the app\nconst rootElement = document.getElementById('root')!\nif (!rootElement.innerHTML) {\n  const root = ReactDOM.createRoot(rootElement)\n  root.render(\n    <StrictMode>\n      <RouterProvider router={router} />\n    </StrictMode>,\n  )\n}","lang":"tsx","meta":"title=\"src/main.tsx\"","title":"src/main.tsx","file":"src/main.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/__root.tsx\"},{\"slug\":\"file-1\",\"name\":\"src/routes/index.tsx\"},{\"slug\":\"file-2\",\"name\":\"src/routes/about.tsx\"},{\"slug\":\"file-3\",\"name\":\"src/main.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/__root.tsx\",\"code\":\"import { createRootRoute, Link, Outlet } from '@tanstack/react-router'\\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\\n\\nconst RootLayout = () => (\\n  <>\\n    <div className=\\\"p-2 flex gap-2\\\">\\n      <Link to=\\\"/\\\" className=\\\"[&.active]:font-bold\\\">\\n        Home\\n      </Link>{' '}\\n      <Link to=\\\"/about\\\" className=\\\"[&.active]:font-bold\\\">\\n        About\\n      </Link>\\n    </div>\\n    <hr />\\n    <Outlet />\\n    <TanStackRouterDevtools />\\n  </>\\n)\\n\\nexport const Route = createRootRoute({ component: RootLayout })\",\"language\":\"tsx\"},{\"title\":\"src/routes/index.tsx\",\"code\":\"import { createFileRoute } from '@tanstack/react-router'\\n\\nexport const Route = createFileRoute('/')({\\n  component: Index,\\n})\\n\\nfunction Index() {\\n  return (\\n    <div className=\\\"p-2\\\">\\n      <h3>Welcome Home!</h3>\\n    </div>\\n  )\\n}\",\"language\":\"tsx\"},{\"title\":\"src/routes/about.tsx\",\"code\":\"import { createFileRoute } from '@tanstack/react-router'\\n\\nexport const Route = createFileRoute('/about')({\\n  component: About,\\n})\\n\\nfunction About() {\\n  return <div className=\\\"p-2\\\">Hello from About!</div>\\n}\",\"language\":\"tsx\"},{\"title\":\"src/main.tsx\",\"code\":\"import { StrictMode } from 'react'\\nimport ReactDOM from 'react-dom/client'\\nimport { RouterProvider, createRouter } from '@tanstack/react-router'\\n\\n// Import the generated route tree\\nimport { routeTree } from './routeTree.gen'\\n\\n// Create a new router instance\\nconst router = createRouter({ routeTree })\\n\\n// Register the router instance for type safety\\ndeclare module '@tanstack/react-router' {\\n  interface Register {\\n    router: typeof router\\n  }\\n}\\n\\n// Render the app\\nconst rootElement = document.getElementById('root')!\\nif (!rootElement.innerHTML) {\\n  const root = ReactDOM.createRoot(rootElement)\\n  root.render(\\n    <StrictMode>\\n      <RouterProvider router={router} />\\n    </StrictMode>,\\n  )\\n}\",\"language\":\"tsx\"}]}"}}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"component","name":"tabs","attributes":{"variant":"files"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-0","data-tab-index":"0"},"children":[{"type":"code","value":"import { createRootRoute, Link, Outlet } from '@tanstack/solid-router'\nimport { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'\n\nconst RootLayout = () => (\n  <>\n    <div class=\"p-2 flex gap-2\">\n      <Link to=\"/\" class=\"[&.active]:font-bold\">\n        Home\n      </Link>{' '}\n      <Link to=\"/about\" class=\"[&.active]:font-bold\">\n        About\n      </Link>\n    </div>\n    <hr />\n    <Outlet />\n    <TanStackRouterDevtools />\n  </>\n)\n\nexport const Route = createRootRoute({ component: RootLayout })","lang":"tsx","meta":"title=\"src/routes/__root.tsx\"","title":"src/routes/__root.tsx","file":"src/routes/__root.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-1","data-tab-index":"1"},"children":[{"type":"code","value":"import { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/')({\n  component: Index,\n})\n\nfunction Index() {\n  return (\n    <div class=\"p-2\">\n      <h3>Welcome Home!</h3>\n    </div>\n  )\n}","lang":"tsx","meta":"title=\"src/routes/index.tsx\"","title":"src/routes/index.tsx","file":"src/routes/index.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-2","data-tab-index":"2"},"children":[{"type":"code","value":"import { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/about')({\n  component: About,\n})\n\nfunction About() {\n  return <div class=\"p-2\">Hello from About!</div>\n}","lang":"tsx","meta":"title=\"src/routes/about.tsx\"","title":"src/routes/about.tsx","file":"src/routes/about.tsx"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"file-3","data-tab-index":"3"},"children":[{"type":"code","value":"/* @refresh reload */\nimport { render } from 'solid-js/web'\nimport { RouterProvider, createRouter } from '@tanstack/solid-router'\n\n// Import the generated route tree\nimport { routeTree } from './routeTree.gen'\n\n// Create a new router instance\nconst router = createRouter({ routeTree })\n\n// Register the router instance for type safety\ndeclare module '@tanstack/solid-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\n// Render the app\nconst rootElement = document.getElementById('root')!\n\nrender(() => <RouterProvider router={router} />, rootElement)","lang":"tsx","meta":"title=\"src/main.tsx\"","title":"src/main.tsx","file":"src/main.tsx"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"file-0\",\"name\":\"src/routes/__root.tsx\"},{\"slug\":\"file-1\",\"name\":\"src/routes/index.tsx\"},{\"slug\":\"file-2\",\"name\":\"src/routes/about.tsx\"},{\"slug\":\"file-3\",\"name\":\"src/main.tsx\"}]}","data-files-meta":"{\"files\":[{\"title\":\"src/routes/__root.tsx\",\"code\":\"import { createRootRoute, Link, Outlet } from '@tanstack/solid-router'\\nimport { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'\\n\\nconst RootLayout = () => (\\n  <>\\n    <div class=\\\"p-2 flex gap-2\\\">\\n      <Link to=\\\"/\\\" class=\\\"[&.active]:font-bold\\\">\\n        Home\\n      </Link>{' '}\\n      <Link to=\\\"/about\\\" class=\\\"[&.active]:font-bold\\\">\\n        About\\n      </Link>\\n    </div>\\n    <hr />\\n    <Outlet />\\n    <TanStackRouterDevtools />\\n  </>\\n)\\n\\nexport const Route = createRootRoute({ component: RootLayout })\",\"language\":\"tsx\"},{\"title\":\"src/routes/index.tsx\",\"code\":\"import { createFileRoute } from '@tanstack/solid-router'\\n\\nexport const Route = createFileRoute('/')({\\n  component: Index,\\n})\\n\\nfunction Index() {\\n  return (\\n    <div class=\\\"p-2\\\">\\n      <h3>Welcome Home!</h3>\\n    </div>\\n  )\\n}\",\"language\":\"tsx\"},{\"title\":\"src/routes/about.tsx\",\"code\":\"import { createFileRoute } from '@tanstack/solid-router'\\n\\nexport const Route = createFileRoute('/about')({\\n  component: About,\\n})\\n\\nfunction About() {\\n  return <div class=\\\"p-2\\\">Hello from About!</div>\\n}\",\"language\":\"tsx\"},{\"title\":\"src/main.tsx\",\"code\":\"/* @refresh reload */\\nimport { render } from 'solid-js/web'\\nimport { RouterProvider, createRouter } from '@tanstack/solid-router'\\n\\n// Import the generated route tree\\nimport { routeTree } from './routeTree.gen'\\n\\n// Create a new router instance\\nconst router = createRouter({ routeTree })\\n\\n// Register the router instance for type safety\\ndeclare module '@tanstack/solid-router' {\\n  interface Register {\\n    router: typeof router\\n  }\\n}\\n\\n// Render the app\\nconst rootElement = document.getElementById('root')!\\n\\nrender(() => <RouterProvider router={router} />, rootElement)\",\"language\":\"tsx\"}]}"}}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[],\"solid\":[]}}"}},{"type":"paragraph","children":[{"type":"text","value":"Regardless of whether you are using the "},{"type":"inlineCode","value":"@tanstack/router-plugin"},{"type":"text","value":" package and running the "},{"type":"inlineCode","value":"npm run dev"},{"type":"text","value":"/"},{"type":"inlineCode","value":"npm run build"},{"type":"text","value":" scripts, or manually running the "},{"type":"inlineCode","value":"tsr watch"},{"type":"text","value":"/"},{"type":"inlineCode","value":"tsr generate"},{"type":"text","value":" commands from your package scripts, the route tree file will be generated at "},{"type":"inlineCode","value":"src/routeTree.gen.ts"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"If you are working with this pattern, you should change the "},{"type":"inlineCode","value":"id"},{"type":"text","value":" of the root "},{"type":"inlineCode","value":"<div>"},{"type":"text","value":" on your "},{"type":"inlineCode","value":"index.html"},{"type":"text","value":" file to "},{"type":"inlineCode","value":"<div id='root'></div>"}]},{"type":"heading","depth":2,"id":"using-code-based-route-configuration","children":[{"type":"text","value":"Using Code-Based Route Configuration"}]},{"type":"callout","kind":"important","title":"Important","children":[{"type":"paragraph","children":[{"type":"text","value":"The following example shows how to configure routes using code, and for simplicity's sake is in a single file for this demo. While code-based generation allows you to declare many routes and even the router instance in a single file, we recommend splitting your routes into separate files for better organization and performance as your application grows."}]}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"import { StrictMode } from 'react'\nimport ReactDOM from 'react-dom/client'\nimport {\n  Outlet,\n  RouterProvider,\n  Link,\n  createRouter,\n  createRoute,\n  createRootRoute,\n} from '@tanstack/react-router'\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\n\nconst rootRoute = createRootRoute({\n  component: () => (\n    <>\n      <div className=\"p-2 flex gap-2\">\n        <Link to=\"/\" className=\"[&.active]:font-bold\">\n          Home\n        </Link>{' '}\n        <Link to=\"/about\" className=\"[&.active]:font-bold\">\n          About\n        </Link>\n      </div>\n      <hr />\n      <Outlet />\n      <TanStackRouterDevtools />\n    </>\n  ),\n})\n\nconst indexRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/',\n  component: function Index() {\n    return (\n      <div className=\"p-2\">\n        <h3>Welcome Home!</h3>\n      </div>\n    )\n  },\n})\n\nconst aboutRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/about',\n  component: function About() {\n    return <div className=\"p-2\">Hello from About!</div>\n  },\n})\n\nconst routeTree = rootRoute.addChildren([indexRoute, aboutRoute])\n\nconst router = createRouter({ routeTree })\n\ndeclare module '@tanstack/react-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\nconst rootElement = document.getElementById('app')!\nif (!rootElement.innerHTML) {\n  const root = ReactDOM.createRoot(rootElement)\n  root.render(\n    <StrictMode>\n      <RouterProvider router={router} />\n    </StrictMode>,\n  )\n}","lang":"tsx"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"/* @refresh reload */\nimport { render } from 'solid-js/web'\nimport {\n  Outlet,\n  RouterProvider,\n  Link,\n  createRouter,\n  createRoute,\n  createRootRoute,\n} from '@tanstack/solid-router'\nimport { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'\n\nconst rootRoute = createRootRoute({\n  component: () => (\n    <>\n      <div class=\"p-2 flex gap-2\">\n        <Link to=\"/\" class=\"[&.active]:font-bold\">\n          Home\n        </Link>{' '}\n        <Link to=\"/about\" class=\"[&.active]:font-bold\">\n          About\n        </Link>\n      </div>\n      <hr />\n      <Outlet />\n      <TanStackRouterDevtools />\n    </>\n  ),\n})\n\nconst indexRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/',\n  component: function Index() {\n    return (\n      <div class=\"p-2\">\n        <h3>Welcome Home!</h3>\n      </div>\n    )\n  },\n})\n\nconst aboutRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/about',\n  component: function About() {\n    return <div class=\"p-2\">Hello from About!</div>\n  },\n})\n\nconst routeTree = rootRoute.addChildren([indexRoute, aboutRoute])\n\nconst router = createRouter({ routeTree })\n\ndeclare module '@tanstack/solid-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\nconst rootElement = document.getElementById('app')!\nrender(() => <RouterProvider router={router} />, rootElement)","lang":"tsx"}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"import { StrictMode } from 'react'\\nimport ReactDOM from 'react-dom/client'\\nimport {\\n  Outlet,\\n  RouterProvider,\\n  Link,\\n  createRouter,\\n  createRoute,\\n  createRootRoute,\\n} from '@tanstack/react-router'\\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\\n\\nconst rootRoute = createRootRoute({\\n  component: () => (\\n    <>\\n      <div className=\\\"p-2 flex gap-2\\\">\\n        <Link to=\\\"/\\\" className=\\\"[&.active]:font-bold\\\">\\n          Home\\n        </Link>{' '}\\n        <Link to=\\\"/about\\\" className=\\\"[&.active]:font-bold\\\">\\n          About\\n        </Link>\\n      </div>\\n      <hr />\\n      <Outlet />\\n      <TanStackRouterDevtools />\\n    </>\\n  ),\\n})\\n\\nconst indexRoute = createRoute({\\n  getParentRoute: () => rootRoute,\\n  path: '/',\\n  component: function Index() {\\n    return (\\n      <div className=\\\"p-2\\\">\\n        <h3>Welcome Home!</h3>\\n      </div>\\n    )\\n  },\\n})\\n\\nconst aboutRoute = createRoute({\\n  getParentRoute: () => rootRoute,\\n  path: '/about',\\n  component: function About() {\\n    return <div className=\\\"p-2\\\">Hello from About!</div>\\n  },\\n})\\n\\nconst routeTree = rootRoute.addChildren([indexRoute, aboutRoute])\\n\\nconst router = createRouter({ routeTree })\\n\\ndeclare module '@tanstack/react-router' {\\n  interface Register {\\n    router: typeof router\\n  }\\n}\\n\\nconst rootElement = document.getElementById('app')!\\nif (!rootElement.innerHTML) {\\n  const root = ReactDOM.createRoot(rootElement)\\n  root.render(\\n    <StrictMode>\\n      <RouterProvider router={router} />\\n    </StrictMode>,\\n  )\\n}\",\"language\":\"tsx\"}],\"solid\":[{\"title\":\"\",\"code\":\"/* @refresh reload */\\nimport { render } from 'solid-js/web'\\nimport {\\n  Outlet,\\n  RouterProvider,\\n  Link,\\n  createRouter,\\n  createRoute,\\n  createRootRoute,\\n} from '@tanstack/solid-router'\\nimport { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'\\n\\nconst rootRoute = createRootRoute({\\n  component: () => (\\n    <>\\n      <div class=\\\"p-2 flex gap-2\\\">\\n        <Link to=\\\"/\\\" class=\\\"[&.active]:font-bold\\\">\\n          Home\\n        </Link>{' '}\\n        <Link to=\\\"/about\\\" class=\\\"[&.active]:font-bold\\\">\\n          About\\n        </Link>\\n      </div>\\n      <hr />\\n      <Outlet />\\n      <TanStackRouterDevtools />\\n    </>\\n  ),\\n})\\n\\nconst indexRoute = createRoute({\\n  getParentRoute: () => rootRoute,\\n  path: '/',\\n  component: function Index() {\\n    return (\\n      <div class=\\\"p-2\\\">\\n        <h3>Welcome Home!</h3>\\n      </div>\\n    )\\n  },\\n})\\n\\nconst aboutRoute = createRoute({\\n  getParentRoute: () => rootRoute,\\n  path: '/about',\\n  component: function About() {\\n    return <div class=\\\"p-2\\\">Hello from About!</div>\\n  },\\n})\\n\\nconst routeTree = rootRoute.addChildren([indexRoute, aboutRoute])\\n\\nconst router = createRouter({ routeTree })\\n\\ndeclare module '@tanstack/solid-router' {\\n  interface Register {\\n    router: typeof router\\n  }\\n}\\n\\nconst rootElement = document.getElementById('app')!\\nrender(() => <RouterProvider router={router} />, rootElement)\",\"language\":\"tsx\"}]}}"}},{"type":"paragraph","children":[{"type":"text","value":"If you glossed over these examples or didn't understand something, we don't blame you, because there's so much more to learn to really take advantage of TanStack Router! Let's move on."}]}],"headings":[{"id":"using-file-based-route-generation","text":"Using File-Based Route Generation","level":2},{"id":"install-tanstack-router-vite-plugin-and-the-router-devtools","text":"Install TanStack Router, Vite Plugin, and the Router Devtools","level":4},{"id":"configure-the-vite-plugin","text":"Configure the Vite Plugin","level":4},{"id":"using-code-based-route-configuration","text":"Using Code-Based Route Configuration","level":2}]},"frameworks":["react","solid"],"downloadMarkdown":"\nTo set up TanStack Router manually in a React project, follow the steps below. This gives you a bare minimum setup to get going with TanStack Router using both file-based route generation and code-based route configuration:\n\n## Using File-Based Route Generation\n\n#### Install TanStack Router, Vite Plugin, and the Router Devtools\n\nInstall the necessary core dependencies:\n\n<!-- ::start:tabs variant=\"package-managers\" -->\n\nreact: @tanstack/react-router @tanstack/react-router-devtools\nsolid: @tanstack/solid-router @tanstack/solid-router-devtools\n\n<!-- ::end:tabs -->\n\nInstall the necessary development dependencies:\n\n<!-- ::start:tabs variant=\"package-managers\" mode=\"dev-install\" -->\n\nreact: @tanstack/router-plugin\nsolid: @tanstack/router-plugin\n\n<!-- ::end:tabs -->\n\n#### Configure the Vite Plugin\n\n```tsx\n// vite.config.ts\nimport { defineConfig } from 'vite'\nimport react from '@vitejs/plugin-react'\nimport { tanstackRouter } from '@tanstack/router-plugin/vite'\n\n// https://vitejs.dev/config/\nexport default defineConfig({\n  plugins: [\n    // Please make sure that '@tanstack/router-plugin' is passed before '@vitejs/plugin-react'\n    tanstackRouter({\n      target: 'react',\n      autoCodeSplitting: true,\n    }),\n    react(),\n    // ...,\n  ],\n})\n```\n\n> [!TIP]\n> If you are not using Vite, or any of the supported bundlers, you can check out the [TanStack Router CLI](./with-router-cli) guide for more info.\n\nCreate the following files:\n\n- `src/routes/__root.tsx` (with two '`_`' characters)\n- `src/routes/index.tsx`\n- `src/routes/about.tsx`\n- `src/main.tsx`\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/__root.tsx\"\nimport { createRootRoute, Link, Outlet } from '@tanstack/react-router'\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\n\nconst RootLayout = () => (\n  <>\n    <div className=\"p-2 flex gap-2\">\n      <Link to=\"/\" className=\"[&.active]:font-bold\">\n        Home\n      </Link>{' '}\n      <Link to=\"/about\" className=\"[&.active]:font-bold\">\n        About\n      </Link>\n    </div>\n    <hr />\n    <Outlet />\n    <TanStackRouterDevtools />\n  </>\n)\n\nexport const Route = createRootRoute({ component: RootLayout })\n```\n\n```tsx title=\"src/routes/index.tsx\"\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/')({\n  component: Index,\n})\n\nfunction Index() {\n  return (\n    <div className=\"p-2\">\n      <h3>Welcome Home!</h3>\n    </div>\n  )\n}\n```\n\n```tsx title=\"src/routes/about.tsx\"\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/about')({\n  component: About,\n})\n\nfunction About() {\n  return <div className=\"p-2\">Hello from About!</div>\n}\n```\n\n```tsx title=\"src/main.tsx\"\nimport { StrictMode } from 'react'\nimport ReactDOM from 'react-dom/client'\nimport { RouterProvider, createRouter } from '@tanstack/react-router'\n\n// Import the generated route tree\nimport { routeTree } from './routeTree.gen'\n\n// Create a new router instance\nconst router = createRouter({ routeTree })\n\n// Register the router instance for type safety\ndeclare module '@tanstack/react-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\n// Render the app\nconst rootElement = document.getElementById('root')!\nif (!rootElement.innerHTML) {\n  const root = ReactDOM.createRoot(rootElement)\n  root.render(\n    <StrictMode>\n      <RouterProvider router={router} />\n    </StrictMode>,\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/__root.tsx\"\nimport { createRootRoute, Link, Outlet } from '@tanstack/solid-router'\nimport { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'\n\nconst RootLayout = () => (\n  <>\n    <div class=\"p-2 flex gap-2\">\n      <Link to=\"/\" class=\"[&.active]:font-bold\">\n        Home\n      </Link>{' '}\n      <Link to=\"/about\" class=\"[&.active]:font-bold\">\n        About\n      </Link>\n    </div>\n    <hr />\n    <Outlet />\n    <TanStackRouterDevtools />\n  </>\n)\n\nexport const Route = createRootRoute({ component: RootLayout })\n```\n\n```tsx title=\"src/routes/index.tsx\"\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/')({\n  component: Index,\n})\n\nfunction Index() {\n  return (\n    <div class=\"p-2\">\n      <h3>Welcome Home!</h3>\n    </div>\n  )\n}\n```\n\n```tsx title=\"src/routes/about.tsx\"\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/about')({\n  component: About,\n})\n\nfunction About() {\n  return <div class=\"p-2\">Hello from About!</div>\n}\n```\n\n```tsx title=\"src/main.tsx\"\n/* @refresh reload */\nimport { render } from 'solid-js/web'\nimport { RouterProvider, createRouter } from '@tanstack/solid-router'\n\n// Import the generated route tree\nimport { routeTree } from './routeTree.gen'\n\n// Create a new router instance\nconst router = createRouter({ routeTree })\n\n// Register the router instance for type safety\ndeclare module '@tanstack/solid-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\n// Render the app\nconst rootElement = document.getElementById('root')!\n\nrender(() => <RouterProvider router={router} />, rootElement)\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\nRegardless of whether you are using the `@tanstack/router-plugin` package and running the `npm run dev`/`npm run build` scripts, or manually running the `tsr watch`/`tsr generate` commands from your package scripts, the route tree file will be generated at `src/routeTree.gen.ts`.\n\nIf you are working with this pattern, you should change the `id` of the root `<div>` on your `index.html` file to `<div id='root'></div>`\n\n## Using Code-Based Route Configuration\n\n> [!IMPORTANT]\n> The following example shows how to configure routes using code, and for simplicity's sake is in a single file for this demo. While code-based generation allows you to declare many routes and even the router instance in a single file, we recommend splitting your routes into separate files for better organization and performance as your application grows.\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { StrictMode } from 'react'\nimport ReactDOM from 'react-dom/client'\nimport {\n  Outlet,\n  RouterProvider,\n  Link,\n  createRouter,\n  createRoute,\n  createRootRoute,\n} from '@tanstack/react-router'\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\n\nconst rootRoute = createRootRoute({\n  component: () => (\n    <>\n      <div className=\"p-2 flex gap-2\">\n        <Link to=\"/\" className=\"[&.active]:font-bold\">\n          Home\n        </Link>{' '}\n        <Link to=\"/about\" className=\"[&.active]:font-bold\">\n          About\n        </Link>\n      </div>\n      <hr />\n      <Outlet />\n      <TanStackRouterDevtools />\n    </>\n  ),\n})\n\nconst indexRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/',\n  component: function Index() {\n    return (\n      <div className=\"p-2\">\n        <h3>Welcome Home!</h3>\n      </div>\n    )\n  },\n})\n\nconst aboutRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/about',\n  component: function About() {\n    return <div className=\"p-2\">Hello from About!</div>\n  },\n})\n\nconst routeTree = rootRoute.addChildren([indexRoute, aboutRoute])\n\nconst router = createRouter({ routeTree })\n\ndeclare module '@tanstack/react-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\nconst rootElement = document.getElementById('app')!\nif (!rootElement.innerHTML) {\n  const root = ReactDOM.createRoot(rootElement)\n  root.render(\n    <StrictMode>\n      <RouterProvider router={router} />\n    </StrictMode>,\n  )\n}\n```\n\n# Solid\n\n```tsx\n/* @refresh reload */\nimport { render } from 'solid-js/web'\nimport {\n  Outlet,\n  RouterProvider,\n  Link,\n  createRouter,\n  createRoute,\n  createRootRoute,\n} from '@tanstack/solid-router'\nimport { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'\n\nconst rootRoute = createRootRoute({\n  component: () => (\n    <>\n      <div class=\"p-2 flex gap-2\">\n        <Link to=\"/\" class=\"[&.active]:font-bold\">\n          Home\n        </Link>{' '}\n        <Link to=\"/about\" class=\"[&.active]:font-bold\">\n          About\n        </Link>\n      </div>\n      <hr />\n      <Outlet />\n      <TanStackRouterDevtools />\n    </>\n  ),\n})\n\nconst indexRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/',\n  component: function Index() {\n    return (\n      <div class=\"p-2\">\n        <h3>Welcome Home!</h3>\n      </div>\n    )\n  },\n})\n\nconst aboutRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/about',\n  component: function About() {\n    return <div class=\"p-2\">Hello from About!</div>\n  },\n})\n\nconst routeTree = rootRoute.addChildren([indexRoute, aboutRoute])\n\nconst router = createRouter({ routeTree })\n\ndeclare module '@tanstack/solid-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\nconst rootElement = document.getElementById('app')!\nrender(() => <RouterProvider router={router} />, rootElement)\n```\n\n<!-- ::end:framework -->\n\nIf you glossed over these examples or didn't understand something, we don't blame you, because there's so much more to learn to really take advantage of TanStack Router! Let's move on.\n","originalRawMarkdown":"---\ntitle: Manual Setup\n---\n\nTo set up TanStack Router manually in a React project, follow the steps below. This gives you a bare minimum setup to get going with TanStack Router using both file-based route generation and code-based route configuration:\n\n## Using File-Based Route Generation\n\n#### Install TanStack Router, Vite Plugin, and the Router Devtools\n\nInstall the necessary core dependencies:\n\n<!-- ::start:tabs variant=\"package-managers\" -->\n\nreact: @tanstack/react-router @tanstack/react-router-devtools\nsolid: @tanstack/solid-router @tanstack/solid-router-devtools\n\n<!-- ::end:tabs -->\n\nInstall the necessary development dependencies:\n\n<!-- ::start:tabs variant=\"package-managers\" mode=\"dev-install\" -->\n\nreact: @tanstack/router-plugin\nsolid: @tanstack/router-plugin\n\n<!-- ::end:tabs -->\n\n#### Configure the Vite Plugin\n\n```tsx\n// vite.config.ts\nimport { defineConfig } from 'vite'\nimport react from '@vitejs/plugin-react'\nimport { tanstackRouter } from '@tanstack/router-plugin/vite'\n\n// https://vitejs.dev/config/\nexport default defineConfig({\n  plugins: [\n    // Please make sure that '@tanstack/router-plugin' is passed before '@vitejs/plugin-react'\n    tanstackRouter({\n      target: 'react',\n      autoCodeSplitting: true,\n    }),\n    react(),\n    // ...,\n  ],\n})\n```\n\n> [!TIP]\n> If you are not using Vite, or any of the supported bundlers, you can check out the [TanStack Router CLI](./with-router-cli) guide for more info.\n\nCreate the following files:\n\n- `src/routes/__root.tsx` (with two '`_`' characters)\n- `src/routes/index.tsx`\n- `src/routes/about.tsx`\n- `src/main.tsx`\n\n<!-- ::start:framework -->\n\n# React\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/__root.tsx\"\nimport { createRootRoute, Link, Outlet } from '@tanstack/react-router'\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\n\nconst RootLayout = () => (\n  <>\n    <div className=\"p-2 flex gap-2\">\n      <Link to=\"/\" className=\"[&.active]:font-bold\">\n        Home\n      </Link>{' '}\n      <Link to=\"/about\" className=\"[&.active]:font-bold\">\n        About\n      </Link>\n    </div>\n    <hr />\n    <Outlet />\n    <TanStackRouterDevtools />\n  </>\n)\n\nexport const Route = createRootRoute({ component: RootLayout })\n```\n\n```tsx title=\"src/routes/index.tsx\"\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/')({\n  component: Index,\n})\n\nfunction Index() {\n  return (\n    <div className=\"p-2\">\n      <h3>Welcome Home!</h3>\n    </div>\n  )\n}\n```\n\n```tsx title=\"src/routes/about.tsx\"\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/about')({\n  component: About,\n})\n\nfunction About() {\n  return <div className=\"p-2\">Hello from About!</div>\n}\n```\n\n```tsx title=\"src/main.tsx\"\nimport { StrictMode } from 'react'\nimport ReactDOM from 'react-dom/client'\nimport { RouterProvider, createRouter } from '@tanstack/react-router'\n\n// Import the generated route tree\nimport { routeTree } from './routeTree.gen'\n\n// Create a new router instance\nconst router = createRouter({ routeTree })\n\n// Register the router instance for type safety\ndeclare module '@tanstack/react-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\n// Render the app\nconst rootElement = document.getElementById('root')!\nif (!rootElement.innerHTML) {\n  const root = ReactDOM.createRoot(rootElement)\n  root.render(\n    <StrictMode>\n      <RouterProvider router={router} />\n    </StrictMode>,\n  )\n}\n```\n\n<!-- ::end:tabs -->\n\n# Solid\n\n<!-- ::start:tabs variant=\"files\" -->\n\n```tsx title=\"src/routes/__root.tsx\"\nimport { createRootRoute, Link, Outlet } from '@tanstack/solid-router'\nimport { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'\n\nconst RootLayout = () => (\n  <>\n    <div class=\"p-2 flex gap-2\">\n      <Link to=\"/\" class=\"[&.active]:font-bold\">\n        Home\n      </Link>{' '}\n      <Link to=\"/about\" class=\"[&.active]:font-bold\">\n        About\n      </Link>\n    </div>\n    <hr />\n    <Outlet />\n    <TanStackRouterDevtools />\n  </>\n)\n\nexport const Route = createRootRoute({ component: RootLayout })\n```\n\n```tsx title=\"src/routes/index.tsx\"\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/')({\n  component: Index,\n})\n\nfunction Index() {\n  return (\n    <div class=\"p-2\">\n      <h3>Welcome Home!</h3>\n    </div>\n  )\n}\n```\n\n```tsx title=\"src/routes/about.tsx\"\nimport { createFileRoute } from '@tanstack/solid-router'\n\nexport const Route = createFileRoute('/about')({\n  component: About,\n})\n\nfunction About() {\n  return <div class=\"p-2\">Hello from About!</div>\n}\n```\n\n```tsx title=\"src/main.tsx\"\n/* @refresh reload */\nimport { render } from 'solid-js/web'\nimport { RouterProvider, createRouter } from '@tanstack/solid-router'\n\n// Import the generated route tree\nimport { routeTree } from './routeTree.gen'\n\n// Create a new router instance\nconst router = createRouter({ routeTree })\n\n// Register the router instance for type safety\ndeclare module '@tanstack/solid-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\n// Render the app\nconst rootElement = document.getElementById('root')!\n\nrender(() => <RouterProvider router={router} />, rootElement)\n```\n\n<!-- ::end:tabs -->\n\n<!-- ::end:framework -->\n\nRegardless of whether you are using the `@tanstack/router-plugin` package and running the `npm run dev`/`npm run build` scripts, or manually running the `tsr watch`/`tsr generate` commands from your package scripts, the route tree file will be generated at `src/routeTree.gen.ts`.\n\nIf you are working with this pattern, you should change the `id` of the root `<div>` on your `index.html` file to `<div id='root'></div>`\n\n## Using Code-Based Route Configuration\n\n> [!IMPORTANT]\n> The following example shows how to configure routes using code, and for simplicity's sake is in a single file for this demo. While code-based generation allows you to declare many routes and even the router instance in a single file, we recommend splitting your routes into separate files for better organization and performance as your application grows.\n\n<!-- ::start:framework -->\n\n# React\n\n```tsx\nimport { StrictMode } from 'react'\nimport ReactDOM from 'react-dom/client'\nimport {\n  Outlet,\n  RouterProvider,\n  Link,\n  createRouter,\n  createRoute,\n  createRootRoute,\n} from '@tanstack/react-router'\nimport { TanStackRouterDevtools } from '@tanstack/react-router-devtools'\n\nconst rootRoute = createRootRoute({\n  component: () => (\n    <>\n      <div className=\"p-2 flex gap-2\">\n        <Link to=\"/\" className=\"[&.active]:font-bold\">\n          Home\n        </Link>{' '}\n        <Link to=\"/about\" className=\"[&.active]:font-bold\">\n          About\n        </Link>\n      </div>\n      <hr />\n      <Outlet />\n      <TanStackRouterDevtools />\n    </>\n  ),\n})\n\nconst indexRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/',\n  component: function Index() {\n    return (\n      <div className=\"p-2\">\n        <h3>Welcome Home!</h3>\n      </div>\n    )\n  },\n})\n\nconst aboutRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/about',\n  component: function About() {\n    return <div className=\"p-2\">Hello from About!</div>\n  },\n})\n\nconst routeTree = rootRoute.addChildren([indexRoute, aboutRoute])\n\nconst router = createRouter({ routeTree })\n\ndeclare module '@tanstack/react-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\nconst rootElement = document.getElementById('app')!\nif (!rootElement.innerHTML) {\n  const root = ReactDOM.createRoot(rootElement)\n  root.render(\n    <StrictMode>\n      <RouterProvider router={router} />\n    </StrictMode>,\n  )\n}\n```\n\n# Solid\n\n```tsx\n/* @refresh reload */\nimport { render } from 'solid-js/web'\nimport {\n  Outlet,\n  RouterProvider,\n  Link,\n  createRouter,\n  createRoute,\n  createRootRoute,\n} from '@tanstack/solid-router'\nimport { TanStackRouterDevtools } from '@tanstack/solid-router-devtools'\n\nconst rootRoute = createRootRoute({\n  component: () => (\n    <>\n      <div class=\"p-2 flex gap-2\">\n        <Link to=\"/\" class=\"[&.active]:font-bold\">\n          Home\n        </Link>{' '}\n        <Link to=\"/about\" class=\"[&.active]:font-bold\">\n          About\n        </Link>\n      </div>\n      <hr />\n      <Outlet />\n      <TanStackRouterDevtools />\n    </>\n  ),\n})\n\nconst indexRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/',\n  component: function Index() {\n    return (\n      <div class=\"p-2\">\n        <h3>Welcome Home!</h3>\n      </div>\n    )\n  },\n})\n\nconst aboutRoute = createRoute({\n  getParentRoute: () => rootRoute,\n  path: '/about',\n  component: function About() {\n    return <div class=\"p-2\">Hello from About!</div>\n  },\n})\n\nconst routeTree = rootRoute.addChildren([indexRoute, aboutRoute])\n\nconst router = createRouter({ routeTree })\n\ndeclare module '@tanstack/solid-router' {\n  interface Register {\n    router: typeof router\n  }\n}\n\nconst rootElement = document.getElementById('app')!\nrender(() => <RouterProvider router={router} />, rootElement)\n```\n\n<!-- ::end:framework -->\n\nIf you glossed over these examples or didn't understand something, we don't blame you, because there's so much more to learn to really take advantage of TanStack Router! Let's move on.\n"}
