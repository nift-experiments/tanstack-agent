"children":[{"type":"paragraph","children":[{"type":"text","value":"The api’s between React Router and TanStack Router are very similar and could most likely be handled in a sprint cycle or two if that is your companies way of doing things."}]}]}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Create Routes for each existing React Router route we have"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Create root route"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Create router instance"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add global module in main.tsx"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Remove any React Router ("},{"type":"inlineCode","value":"createBrowserRouter"},{"type":"text","value":" or "},{"type":"inlineCode","value":"BrowserRouter"},{"type":"text","value":"), "},{"type":"inlineCode","value":"Routes"},{"type":"text","value":", and "},{"type":"inlineCode","value":"Route"},{"type":"text","value":" Components from main.tsx"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Optional:"}]},{"type":"text","value":" Refactor "},{"type":"inlineCode","value":"render"},{"type":"text","value":" function for custom setup/providers - The repo referenced above has an example - This was necessary in the case of Supertokens. Supertoken has a specific setup with React Router and a different setup with all other React implementations"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set RouterProvider and pass it the router as the prop"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Replace all instances of React Router "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" component with "},{"type":"inlineCode","value":"@tanstack/react-router"},{"type":"text","value":" "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" component"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add "},{"type":"inlineCode","value":"to"},{"type":"text","value":" prop with literal path"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add "},{"type":"inlineCode","value":"params"},{"type":"text","value":" prop, where necessary with params like so "},{"type":"inlineCode","value":"params={{ orderId: order.id }}"}]}],"checked":false}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Replace all instances of React Router "},{"type":"inlineCode","value":"useNavigate"},{"type":"text","value":" hook with "},{"type":"inlineCode","value":"@tanstack/react-router"},{"type":"text","value":" "},{"type":"inlineCode","value":"useNavigate"},{"type":"text","value":" hook"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"to"},{"type":"text","value":" property and "},{"type":"inlineCode","value":"params"},{"type":"text","value":" property where needed"}]}],"checked":false}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Replace any React Router "},{"type":"inlineCode","value":"Outlet"},{"type":"text","value":"'s with the "},{"type":"inlineCode","value":"@tanstack/react-router"},{"type":"text","value":" equivalent"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If you are using "},{"type":"inlineCode","value":"useSearchParams"},{"type":"text","value":" hook from React Router, move the search params default value to the validateSearch property on a Route definition."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Instead of using the "},{"type":"inlineCode","value":"useSearchParams"},{"type":"text","value":" hook, use "},{"type":"inlineCode","value":"@tanstack/react-router"},{"type":"text","value":" "},{"type":"inlineCode","value":"Link"},{"type":"text","value":"'s search property to update the search params state"}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"To read search params you can do something like the following"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"const { page } = useSearch({ from: productPage.fullPath })"}]}]}]}],"checked":false}]}],"checked":false},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"If using React Router’s "},{"type":"inlineCode","value":"useParams"},{"type":"text","value":" hook, update the import to be from "},{"type":"inlineCode","value":"@tanstack/react-router"},{"type":"text","value":" and set the "},{"type":"inlineCode","value":"from"},{"type":"text","value":" property to the literal path name where you want to read the params object from"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"So say we have a route with the path name "},{"type":"inlineCode","value":"orders/$orderid"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"In the "},{"type":"inlineCode","value":"useParams"},{"type":"text","value":" hook we would set up our hook like so: "},{"type":"inlineCode","value":"const params = useParams({ from: \"/orders/$orderId\" })"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Then wherever we wanted to access the order id we would get it off of the params object "},{"type":"inlineCode","value":"params.orderId"}]}]}]}],"checked":false}]}],"headings":[]},"frameworks":[],"downloadMarkdown":"\n**_If your UI is blank, open the console, and you will probably have some errors that read something along the lines of `cannot use 'useNavigate' outside of context` . This means there are React Router api’s that are still imported and referenced that you need to find and remove. The easiest way to make sure you find all React Router imports is to uninstall `react-router-dom` and then you should get typescript errors in your files. Then you will know what to change to a `@tanstack/react-router` import._**\n\nHere is the [example repo](https://github.com/Benanna2019/SickFitsForEveryone/tree/migrate-to-tanstack/router/React-Router)\n\n- [ ] Install Router - `npm i @tanstack/react-router` (see [detailed installation guide](../how-to/install.md))\n- [ ] **Optional:** Uninstall React Router to get TypeScript errors on imports.\n  - At this point I don’t know if you can do a gradual migration, but it seems likely you could have multiple router providers, not desirable.\n  - The api’s between React Router and TanStack Router are very similar and could most likely be handled in a sprint cycle or two if that is your companies way of doing things.\n- [ ] Create Routes for each existing React Router route we have\n- [ ] Create root route\n- [ ] Create router instance\n- [ ] Add global module in main.tsx\n- [ ] Remove any React Router (`createBrowserRouter` or `BrowserRouter`), `Routes`, and `Route` Components from main.tsx\n- [ ] **Optional:** Refactor `render` function for custom setup/providers - The repo referenced above has an example - This was necessary in the case of Supertokens. Supertoken has a specific setup with React Router and a different setup with all other React implementations\n- [ ] Set RouterProvider and pass it the router as the prop\n- [ ] Replace all instances of React Router `Link` component with `@tanstack/react-router` `Link` component\n  - [ ] Add `to` prop with literal path\n  - [ ] Add `params` prop, where necessary with params like so `params={{ orderId: order.id }}`\n- [ ] Replace all instances of React Router `useNavigate` hook with `@tanstack/react-router` `useNavigate` hook\n  - [ ] Set `to` property and `params` property where needed\n- [ ] Replace any React Router `Outlet`'s with the `@tanstack/react-router` equivalent\n- [ ] If you are using `useSearchParams` hook from React Router, move the search params default value to the validateSearch property on a Route definition.\n  - [ ] Instead of using the `useSearchParams` hook, use `@tanstack/react-router` `Link`'s search property to update the search params state\n  - [ ] To read search params you can do something like the following\n    - `const { page } = useSearch({ from: productPage.fullPath })`\n- [ ] If using React Router’s `useParams` hook, update the import to be from `@tanstack/react-router` and set the `from` property to the literal path name where you want to read the params object from\n  - So say we have a route with the path name `orders/$orderid`.\n  - In the `useParams` hook we would set up our hook like so: `const params = useParams({ from: \"/orders/$orderId\" })`\n  - Then wherever we wanted to access the order id we would get it off of the params object `params.orderId`\n","originalRawMarkdown":"---\ntitle: Migration from React Router Checklist\ntoc: false\n---\n\n**_If your UI is blank, open the console, and you will probably have some errors that read something along the lines of `cannot use 'useNavigate' outside of context` . This means there are React Router api’s that are still imported and referenced that you need to find and remove. The easiest way to make sure you find all React Router imports is to uninstall `react-router-dom` and then you should get typescript errors in your files. Then you will know what to change to a `@tanstack/react-router` import._**\n\nHere is the [example repo](https://github.com/Benanna2019/SickFitsForEveryone/tree/migrate-to-tanstack/router/React-Router)\n\n- [ ] Install Router - `npm i @tanstack/react-router` (see [detailed installation guide](../how-to/install.md))\n- [ ] **Optional:** Uninstall React Router to get TypeScript errors on imports.\n  - At this point I don’t know if you can do a gradual migration, but it seems likely you could have multiple router providers, not desirable.\n  - The api’s between React Router and TanStack Router are very similar and could most likely be handled in a sprint cycle or two if that is your companies way of doing things.\n- [ ] Create Routes for each existing React Router route we have\n- [ ] Create root route\n- [ ] Create router instance\n- [ ] Add global module in main.tsx\n- [ ] Remove any React Router (`createBrowserRouter` or `BrowserRouter`), `Routes`, and `Route` Components from main.tsx\n- [ ] **Optional:** Refactor `render` function for custom setup/providers - The repo referenced above has an example - This was necessary in the case of Supertokens. Supertoken has a specific setup with React Router and a different setup with all other React implementations\n- [ ] Set RouterProvider and pass it the router as the prop\n- [ ] Replace all instances of React Router `Link` component with `@tanstack/react-router` `Link` component\n  - [ ] Add `to` prop with literal path\n  - [ ] Add `params` prop, where necessary with params like so `params={{ orderId: order.id }}`\n- [ ] Replace all instances of React Router `useNavigate` hook with `@tanstack/react-router` `useNavigate` hook\n  - [ ] Set `to` property and `params` property where needed\n- [ ] Replace any React Router `Outlet`'s with the `@tanstack/react-router` equivalent\n- [ ] If you are using `useSearchParams` hook from React Router, move the search params default value to the validateSearch property on a Route definition.\n  - [ ] Instead of using the `useSearchParams` hook, use `@tanstack/react-router` `Link`'s search property to update the search params state\n  - [ ] To read search params you can do something like the following\n    - `const { page } = useSearch({ from: productPage.fullPath })`\n- [ ] If using React Router’s `useParams` hook, update the import to be from `@tanstack/react-router` and set the `from` property to the literal path name where you want to read the params object from\n  - So say we have a route with the path name `orders/$orderid`.\n  - In the `useParams` hook we would set up our hook like so: `const params = useParams({ from: \"/orders/$orderId\" })`\n  - Then wherever we wanted to access the order id we would get it off of the params object `params.orderId`\n"}
