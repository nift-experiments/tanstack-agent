eCode","value":"<Root><PathlessLayout><RouteA>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"_pathlessLayout.route-b.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/route-b"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><PathlessLayout><RouteB>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"files.$.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/files/$"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Files>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"account.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/account"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Account>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"account.overview.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/account/overview"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Account><Overview>"}]}]]},{"type":"heading","depth":2,"id":"mixed-flat-and-directory-routes","children":[{"type":"text","value":"Mixed Flat and Directory Routes"}]},{"type":"paragraph","children":[{"type":"text","value":"It's extremely likely that a 100% directory or flat route structure won't be the best fit for your project, which is why TanStack Router allows you to mix both flat and directory routes together to create a route tree that uses the best of both worlds where it makes sense."}]},{"type":"paragraph","children":[{"type":"text","value":"See the example below:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Filename"}]},{"type":"tableCell","children":[{"type":"text","value":"Route Path"}]},{"type":"tableCell","children":[{"type":"text","value":"Component Output"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"__root.tsx"}]},{"type":"tableCell","children":[]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"index.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/"},{"type":"text","value":" (exact)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><RootIndex>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"about.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/about"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><About>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"posts.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/posts"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Posts>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"📂 "},{"type":"inlineCode","value":"posts"}]},{"type":"tableCell","children":[]},{"type":"tableCell","children":[]}],[{"type":"tableCell","children":[{"type":"text","value":"┄ ʦ "},{"type":"inlineCode","value":"index.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/posts"},{"type":"text","value":" (exact)"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Posts><PostsIndex>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"┄ ʦ "},{"type":"inlineCode","value":"$postId.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/posts/$postId"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Posts><Post>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"┄ ʦ "},{"type":"inlineCode","value":"$postId.edit.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/posts/$postId/edit"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Posts><Post><EditPost>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"settings.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/settings"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Settings>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"settings.profile.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/settings/profile"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Settings><Profile>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"settings.notifications.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/settings/notifications"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Settings><Notifications>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"account.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/account"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Account>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"account.overview.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/account/overview"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Account><Overview>"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Both flat and directory routes can be mixed together to create a route tree that uses the best of both worlds where it makes sense."}]},{"type":"callout","kind":"tip","title":"Tip","children":[{"type":"paragraph","children":[{"type":"text","value":"If you find that the default file-based routing structure doesn't fit your needs, you can always use "},{"type":"link","href":"./virtual-file-routes.md","children":[{"type":"text","value":"Virtual File Routes"}]},{"type":"text","value":" to control the source of your routes whilst still getting the awesome performance benefits of file-based routing."}]}]},{"type":"heading","depth":2,"id":"getting-started-with-file-based-routing","children":[{"type":"text","value":"Getting started with File-Based Routing"}]},{"type":"paragraph","children":[{"type":"text","value":"To get started with file-based routing, you'll need to configure your project's bundler to use the TanStack Router Plugin or the TanStack Router CLI."}]},{"type":"paragraph","children":[{"type":"text","value":"To enable file-based routing, you'll need to be using React with a supported bundler. See if your bundler is listed in the configuration guides below."}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../installation/with-vite","children":[{"type":"text","value":"Installation with Vite"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../installation/with-rspack","children":[{"type":"text","value":"Installation with Rspack/Rsbuild"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../installation/with-webpack","children":[{"type":"text","value":"Installation with Webpack"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../installation/with-esbuild","children":[{"type":"text","value":"Installation with Esbuild"}]}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../installation/with-vite","children":[{"type":"text","value":"Installation with Vite"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../installation/with-rspack","children":[{"type":"text","value":"Installation with Rspack/Rsbuild"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../installation/with-webpack","children":[{"type":"text","value":"Installation with Webpack"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../installation/with-esbuild","children":[{"type":"text","value":"Installation with Esbuild"}]}]}]}]}]}],"properties":{"data-available-frameworks":"[\"react\",\"solid\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[],\"solid\":[]}}"}},{"type":"paragraph","children":[{"type":"text","value":"When using TanStack Router's file-based routing through one of the supported bundlers, our plugin will "},{"type":"strong","children":[{"type":"text","value":"automatically generate your route configuration through your bundler's dev and build processes"}]},{"type":"text","value":". It is the easiest way to use TanStack Router's route generation features."}]},{"type":"paragraph","children":[{"type":"text","value":"If your bundler is not yet supported, you can reach out to us on Discord or GitHub to let us know."}]}],"headings":[{"id":"what-is-file-based-routing","text":"What is File-Based Routing?","level":2},{"id":"s-or-s","text":"/s or .s?","level":2},{"id":"directory-routes","text":"Directory Routes","level":2},{"id":"flat-routes","text":"Flat Routes","level":2},{"id":"mixed-flat-and-directory-routes","text":"Mixed Flat and Directory Routes","level":2},{"id":"getting-started-with-file-based-routing","text":"Getting started with File-Based Routing","level":2}]},"frameworks":["react","solid"],"downloadMarkdown":"\nMost of the TanStack Router documentation is written for file-based routing and is intended to help you understand in more detail how to configure file-based routing and the technical details behind how it works. While file-based routing is the preferred and recommended way to configure TanStack Router, you can also use [code-based routing](./code-based-routing.md) if you prefer.\n\n## What is File-Based Routing?\n\nFile-based routing is a way to configure your routes using the filesystem. Instead of defining your route structure via code, you can define your routes using a series of files and directories that represent the route hierarchy of your application. This brings a number of benefits:\n\n- **Simplicity**: File-based routing is visually intuitive and easy to understand for both new and experienced developers.\n- **Organization**: Routes are organized in a way that mirrors the URL structure of your application.\n- **Scalability**: As your application grows, file-based routing makes it easy to add new routes and maintain existing ones.\n- **Code-Splitting**: File-based routing allows TanStack Router to automatically code-split your routes for better performance.\n- **Type-Safety**: File-based routing raises the ceiling on type-safety by generating and managing type linkages for your routes, which can otherwise be a tedious process via code-based routing.\n- **Consistency**: File-based routing enforces a consistent structure for your routes, making it easier to maintain and update your application and move from one project to another.\n\n## `/`s or `.`s?\n\nWhile directories have long been used to represent route hierarchy, file-based routing introduces an additional concept of using the `.` character in the file-name to denote a route nesting. This allows you to avoid creating directories for few deeply nested routes and continue to use directories for wider route hierarchies. Let's take a look at some examples!\n\n## Directory Routes\n\nDirectories can be used to denote route hierarchy, which can be useful for organizing multiple routes into logical groups and also cutting down on the filename length for large groups of deeply nested routes.\n\nSee the example below:\n\n| Filename                | Route Path                | Component Output                  |\n| ----------------------- | ------------------------- | --------------------------------- |\n| ʦ `__root.tsx`          |                           | `<Root>`                          |\n| ʦ `index.tsx`           | `/` (exact)               | `<Root><RootIndex>`               |\n| ʦ `about.tsx`           | `/about`                  | `<Root><About>`                   |\n| ʦ `posts.tsx`           | `/posts`                  | `<Root><Posts>`                   |\n| 📂 `posts`              |                           |                                   |\n| ┄ ʦ `index.tsx`         | `/posts` (exact)          | `<Root><Posts><PostsIndex>`       |\n| ┄ ʦ `$postId.tsx`       | `/posts/$postId`          | `<Root><Posts><Post>`             |\n| 📂 `posts_`             |                           |                                   |\n| ┄ 📂 `$postId`          |                           |                                   |\n| ┄ ┄ ʦ `edit.tsx`        | `/posts/$postId/edit`     | `<Root><EditPost>`                |\n| ʦ `settings.tsx`        | `/settings`               | `<Root><Settings>`                |\n| 📂 `settings`           |                           | `<Root><Settings>`                |\n| ┄ ʦ `profile.tsx`       | `/settings/profile`       | `<Root><Settings><Profile>`       |\n| ┄ ʦ `notifications.tsx` | `/settings/notifications` | `<Root><Settings><Notifications>` |\n| ʦ `_pathlessLayout.tsx` |                           | `<Root><PathlessLayout>`          |\n| 📂 `_pathlessLayout`    |                           |                                   |\n| ┄ ʦ `route-a.tsx`       | `/route-a`                | `<Root><PathlessLayout><RouteA>`  |\n| ┄ ʦ `route-b.tsx`       | `/route-b`                | `<Root><PathlessLayout><RouteB>`  |\n| 📂 `files`              |                           |                                   |\n| ┄ ʦ `$.tsx`             | `/files/$`                | `<Root><Files>`                   |\n| 📂 `account`            |                           |                                   |\n| ┄ ʦ `route.tsx`         | `/account`                | `<Root><Account>`                 |\n| ┄ ʦ `overview.tsx`      | `/account/overview`       | `<Root><Account><Overview>`       |\n\n## Flat Routes\n\nFlat routing gives you the ability to use `.`s to denote route nesting levels.\n\nThis can be useful when you have a large number of uniquely deeply nested routes and want to avoid creating directories for each one:\n\nSee the example below:\n\n| Filename                        | Route Path                | Component Output                  |\n| ------------------------------- | ------------------------- | --------------------------------- |\n| ʦ `__root.tsx`                  |                           | `<Root>`                          |\n| ʦ `index.tsx`                   | `/` (exact)               | `<Root><RootIndex>`               |\n| ʦ `about.tsx`                   | `/about`                  | `<Root><About>`                   |\n| ʦ `posts.tsx`                   | `/posts`                  | `<Root><Posts>`                   |\n| ʦ `posts.index.tsx`             | `/posts` (exact)          | `<Root><Posts><PostsIndex>`       |\n| ʦ `posts.$postId.tsx`           | `/posts/$postId`          | `<Root><Posts><Post>`             |\n| ʦ `posts_.$postId.edit.tsx`     | `/posts/$postId/edit`     | `<Root><EditPost>`                |\n| ʦ `settings.tsx`                | `/settings`               | `<Root><Settings>`                |\n| ʦ `settings.profile.tsx`        | `/settings/profile`       | `<Root><Settings><Profile>`       |\n| ʦ `settings.notifications.tsx`  | `/settings/notifications` | `<Root><Settings><Notifications>` |\n| ʦ `_pathlessLayout.tsx`         |                           | `<Root><PathlessLayout>`          |\n| ʦ `_pathlessLayout.route-a.tsx` | `/route-a`                | `<Root><PathlessLayout><RouteA>`  |\n| ʦ `_pathlessLayout.route-b.tsx` | `/route-b`                | `<Root><PathlessLayout><RouteB>`  |\n| ʦ `files.$.tsx`                 | `/files/$`                | `<Root><Files>`                   |\n| ʦ `account.tsx`                 | `/account`                | `<Root><Account>`                 |\n| ʦ `account.overview.tsx`        | `/account/overview`       | `<Root><Account><Overview>`       |\n\n## Mixed Flat and Directory Routes\n\nIt's extremely likely that a 100% directory or flat route structure won't be the best fit for your project, which is why TanStack Router allows you to mix both flat and directory routes together to create a route tree that uses the best of both worlds where it makes sense.\n\nSee the example below:\n\n| Filename                       | Route Path                | Component Output                  |\n| ------------------------------ | ------------------------- | --------------------------------- |\n| ʦ `__root.tsx`                 |                           | `<Root>`                          |\n| ʦ `index.tsx`                  | `/` (exact)               | `<Root><RootIndex>`               |\n| ʦ `about.tsx`                  | `/about`                  | `<Root><About>`                   |\n| ʦ `posts.tsx`                  | `/posts`                  | `<Root><Posts>`                   |\n| 📂 `posts`                     |                           |                                   |\n| ┄ ʦ `index.tsx`                | `/posts` (exact)          | `<Root><Posts><PostsIndex>`       |\n| ┄ ʦ `$postId.tsx`              | `/posts/$postId`          | `<Root><Posts><Post>`             |\n| ┄ ʦ `$postId.edit.tsx`         | `/posts/$postId/edit`     | `<Root><Posts><Post><EditPost>`   |\n| ʦ `settings.tsx`               | `/settings`               | `<Root><Settings>`                |\n| ʦ `settings.profile.tsx`       | `/settings/profile`       | `<Root><Settings><Profile>`       |\n| ʦ `settings.notifications.tsx` | `/settings/notifications` | `<Root><Settings><Notifications>` |\n| ʦ `account.tsx`                | `/account`                | `<Root><Account>`                 |\n| ʦ `account.overview.tsx`       | `/account/overview`       | `<Root><Account><Overview>`       |\n\nBoth flat and directory routes can be mixed together to create a route tree that uses the best of both worlds where it makes sense.\n\n> [!TIP]\n> If you find that the default file-based routing structure doesn't fit your needs, you can always use [Virtual File Routes](./virtual-file-routes.md) to control the source of your routes whilst still getting the awesome performance benefits of file-based routing.\n\n## Getting started with File-Based Routing\n\nTo get started with file-based routing, you'll need to configure your project's bundler to use the TanStack Router Plugin or the TanStack Router CLI.\n\nTo enable file-based routing, you'll need to be using React with a supported bundler. See if your bundler is listed in the configuration guides below.\n\n<!-- ::start:framework -->\n\n# React\n\n- [Installation with Vite](../installation/with-vite)\n- [Installation with Rspack/Rsbuild](../installation/with-rspack)\n- [Installation with Webpack](../installation/with-webpack)\n- [Installation with Esbuild](../installation/with-esbuild)\n\n# Solid\n\n- [Installation with Vite](../installation/with-vite)\n- [Installation with Rspack/Rsbuild](../installation/with-rspack)\n- [Installation with Webpack](../installation/with-webpack)\n- [Installation with Esbuild](../installation/with-esbuild)\n\n<!-- ::end:framework -->\n\nWhen using TanStack Router's file-based routing through one of the supported bundlers, our plugin will **automatically generate your route configuration through your bundler's dev and build processes**. It is the easiest way to use TanStack Router's route generation features.\n\nIf your bundler is not yet supported, you can reach out to us on Discord or GitHub to let us know.\n","originalRawMarkdown":"---\ntitle: File-Based Routing\n---\n\nMost of the TanStack Router documentation is written for file-based routing and is intended to help you understand in more detail how to configure file-based routing and the technical details behind how it works. While file-based routing is the preferred and recommended way to configure TanStack Router, you can also use [code-based routing](./code-based-routing.md) if you prefer.\n\n## What is File-Based Routing?\n\nFile-based routing is a way to configure your routes using the filesystem. Instead of defining your route structure via code, you can define your routes using a series of files and directories that represent the route hierarchy of your application. This brings a number of benefits:\n\n- **Simplicity**: File-based routing is visually intuitive and easy to understand for both new and experienced developers.\n- **Organization**: Routes are organized in a way that mirrors the URL structure of your application.\n- **Scalability**: As your application grows, file-based routing makes it easy to add new routes and maintain existing ones.\n- **Code-Splitting**: File-based routing allows TanStack Router to automatically code-split your routes for better performance.\n- **Type-Safety**: File-based routing raises the ceiling on type-safety by generating and managing type linkages for your routes, which can otherwise be a tedious process via code-based routing.\n- **Consistency**: File-based routing enforces a consistent structure for your routes, making it easier to maintain and update your application and move from one project to another.\n\n## `/`s or `.`s?\n\nWhile directories have long been used to represent route hierarchy, file-based routing introduces an additional concept of using the `.` character in the file-name to denote a route nesting. This allows you to avoid creating directories for few deeply nested routes and continue to use directories for wider route hierarchies. Let's take a look at some examples!\n\n## Directory Routes\n\nDirectories can be used to denote route hierarchy, which can be useful for organizing multiple routes into logical groups and also cutting down on the filename length for large groups of deeply nested routes.\n\nSee the example below:\n\n| Filename                | Route Path                | Component Output                  |\n| ----------------------- | ------------------------- | --------------------------------- |\n| ʦ `__root.tsx`          |                           | `<Root>`                          |\n| ʦ `index.tsx`           | `/` (exact)               | `<Root><RootIndex>`               |\n| ʦ `about.tsx`           | `/about`                  | `<Root><About>`                   |\n| ʦ `posts.tsx`           | `/posts`                  | `<Root><Posts>`                   |\n| 📂 `posts`              |                           |                                   |\n| ┄ ʦ `index.tsx`         | `/posts` (exact)          | `<Root><Posts><PostsIndex>`       |\n| ┄ ʦ `$postId.tsx`       | `/posts/$postId`          | `<Root><Posts><Post>`             |\n| 📂 `posts_`             |                           |                                   |\n| ┄ 📂 `$postId`          |                           |                                   |\n| ┄ ┄ ʦ `edit.tsx`        | `/posts/$postId/edit`     | `<Root><EditPost>`                |\n| ʦ `settings.tsx`        | `/settings`               | `<Root><Settings>`                |\n| 📂 `settings`           |                           | `<Root><Settings>`                |\n| ┄ ʦ `profile.tsx`       | `/settings/profile`       | `<Root><Settings><Profile>`       |\n| ┄ ʦ `notifications.tsx` | `/settings/notifications` | `<Root><Settings><Notifications>` |\n| ʦ `_pathlessLayout.tsx` |                           | `<Root><PathlessLayout>`          |\n| 📂 `_pathlessLayout`    |                           |                                   |\n| ┄ ʦ `route-a.tsx`       | `/route-a`                | `<Root><PathlessLayout><RouteA>`  |\n| ┄ ʦ `route-b.tsx`       | `/route-b`                | `<Root><PathlessLayout><RouteB>`  |\n| 📂 `files`              |                           |                                   |\n| ┄ ʦ `$.tsx`             | `/files/$`                | `<Root><Files>`                   |\n| 📂 `account`            |                           |                                   |\n| ┄ ʦ `route.tsx`         | `/account`                | `<Root><Account>`                 |\n| ┄ ʦ `overview.tsx`      | `/account/overview`       | `<Root><Account><Overview>`       |\n\n## Flat Routes\n\nFlat routing gives you the ability to use `.`s to denote route nesting levels.\n\nThis can be useful when you have a large number of uniquely deeply nested routes and want to avoid creating directories for each one:\n\nSee the example below:\n\n| Filename                        | Route Path                | Component Output                  |\n| ------------------------------- | ------------------------- | --------------------------------- |\n| ʦ `__root.tsx`                  |                           | `<Root>`                          |\n| ʦ `index.tsx`                   | `/` (exact)               | `<Root><RootIndex>`               |\n| ʦ `about.tsx`                   | `/about`                  | `<Root><About>`                   |\n| ʦ `posts.tsx`                   | `/posts`                  | `<Root><Posts>`                   |\n| ʦ `posts.index.tsx`             | `/posts` (exact)          | `<Root><Posts><PostsIndex>`       |\n| ʦ `posts.$postId.tsx`           | `/posts/$postId`          | `<Root><Posts><Post>`             |\n| ʦ `posts_.$postId.edit.tsx`     | `/posts/$postId/edit`     | `<Root><EditPost>`                |\n| ʦ `settings.tsx`                | `/settings`               | `<Root><Settings>`                |\n| ʦ `settings.profile.tsx`        | `/settings/profile`       | `<Root><Settings><Profile>`       |\n| ʦ `settings.notifications.tsx`  | `/settings/notifications` | `<Root><Settings><Notifications>` |\n| ʦ `_pathlessLayout.tsx`         |                           | `<Root><PathlessLayout>`          |\n| ʦ `_pathlessLayout.route-a.tsx` | `/route-a`                | `<Root><PathlessLayout><RouteA>`  |\n| ʦ `_pathlessLayout.route-b.tsx` | `/route-b`                | `<Root><PathlessLayout><RouteB>`  |\n| ʦ `files.$.tsx`                 | `/files/$`                | `<Root><Files>`                   |\n| ʦ `account.tsx`                 | `/account`                | `<Root><Account>`                 |\n| ʦ `account.overview.tsx`        | `/account/overview`       | `<Root><Account><Overview>`       |\n\n## Mixed Flat and Directory Routes\n\nIt's extremely likely that a 100% directory or flat route structure won't be the best fit for your project, which is why TanStack Router allows you to mix both flat and directory routes together to create a route tree that uses the best of both worlds where it makes sense.\n\nSee the example below:\n\n| Filename                       | Route Path                | Component Output                  |\n| ------------------------------ | ------------------------- | --------------------------------- |\n| ʦ `__root.tsx`                 |                           | `<Root>`                          |\n| ʦ `index.tsx`                  | `/` (exact)               | `<Root><RootIndex>`               |\n| ʦ `about.tsx`                  | `/about`                  | `<Root><About>`                   |\n| ʦ `posts.tsx`                  | `/posts`                  | `<Root><Posts>`                   |\n| 📂 `posts`                     |                           |                                   |\n| ┄ ʦ `index.tsx`                | `/posts` (exact)          | `<Root><Posts><PostsIndex>`       |\n| ┄ ʦ `$postId.tsx`              | `/posts/$postId`          | `<Root><Posts><Post>`             |\n| ┄ ʦ `$postId.edit.tsx`         | `/posts/$postId/edit`     | `<Root><Posts><Post><EditPost>`   |\n| ʦ `settings.tsx`               | `/settings`               | `<Root><Settings>`                |\n| ʦ `settings.profile.tsx`       | `/settings/profile`       | `<Root><Settings><Profile>`       |\n| ʦ `settings.notifications.tsx` | `/settings/notifications` | `<Root><Settings><Notifications>` |\n| ʦ `account.tsx`                | `/account`                | `<Root><Account>`                 |\n| ʦ `account.overview.tsx`       | `/account/overview`       | `<Root><Account><Overview>`       |\n\nBoth flat and directory routes can be mixed together to create a route tree that uses the best of both worlds where it makes sense.\n\n> [!TIP]\n> If you find that the default file-based routing structure doesn't fit your needs, you can always use [Virtual File Routes](./virtual-file-routes.md) to control the source of your routes whilst still getting the awesome performance benefits of file-based routing.\n\n## Getting started with File-Based Routing\n\nTo get started with file-based routing, you'll need to configure your project's bundler to use the TanStack Router Plugin or the TanStack Router CLI.\n\nTo enable file-based routing, you'll need to be using React with a supported bundler. See if your bundler is listed in the configuration guides below.\n\n<!-- ::start:framework -->\n\n# React\n\n- [Installation with Vite](../installation/with-vite)\n- [Installation with Rspack/Rsbuild](../installation/with-rspack)\n- [Installation with Webpack](../installation/with-webpack)\n- [Installation with Esbuild](../installation/with-esbuild)\n\n# Solid\n\n- [Installation with Vite](../installation/with-vite)\n- [Installation with Rspack/Rsbuild](../installation/with-rspack)\n- [Installation with Webpack](../installation/with-webpack)\n- [Installation with Esbuild](../installation/with-esbuild)\n\n<!-- ::end:framework -->\n\nWhen using TanStack Router's file-based routing through one of the supported bundlers, our plugin will **automatically generate your route configuration through your bundler's dev and build processes**. It is the easiest way to use TanStack Router's route generation features.\n\nIf your bundler is not yet supported, you can reach out to us on Discord or GitHub to let us know.\n"}
