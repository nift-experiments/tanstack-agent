"children":[{"type":"inlineCode","value":"_"},{"type":"text","value":" Prefix"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Route segments with the "},{"type":"inlineCode","value":"_"},{"type":"text","value":" prefix are considered to be pathless layout routes and will not be used when matching its child routes against the URL pathname."}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"inlineCode","value":"_"},{"type":"text","value":" Suffix"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Route segments with the "},{"type":"inlineCode","value":"_"},{"type":"text","value":" suffix exclude the route from being nested under any parent routes."}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"inlineCode","value":"-"},{"type":"text","value":" Prefix"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Files and folders with the "},{"type":"inlineCode","value":"-"},{"type":"text","value":" prefix are excluded from the route tree. They will not be added to the "},{"type":"inlineCode","value":"routeTree.gen.ts"},{"type":"text","value":" file and can be used to colocate logic in route folders."}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"inlineCode","value":"(folder)"},{"type":"text","value":" folder name pattern"}]}]},{"type":"tableCell","children":[{"type":"text","value":"A folder that matches this pattern is treated as a "},{"type":"strong","children":[{"type":"text","value":"route group"}]},{"type":"text","value":", preventing the folder from being included in the route's URL path."}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"inlineCode","value":"[x]"},{"type":"text","value":" Escaping"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Square brackets escape special characters in filenames that would otherwise have routing meaning. For example, "},{"type":"inlineCode","value":"script[.]js.tsx"},{"type":"text","value":" becomes "},{"type":"inlineCode","value":"/script.js"},{"type":"text","value":" and "},{"type":"inlineCode","value":"api[.]v1.tsx"},{"type":"text","value":" becomes "},{"type":"inlineCode","value":"/api.v1"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"inlineCode","value":"index"},{"type":"text","value":" Token"}]}]},{"type":"tableCell","children":[{"type":"text","value":"Route segments ending with the "},{"type":"inlineCode","value":"index"},{"type":"text","value":" token (before any file extensions) will match the parent route when the URL pathname matches the parent route exactly. This can be configured via the "},{"type":"inlineCode","value":"indexToken"},{"type":"text","value":" configuration option (supports both strings and regex patterns), see "},{"type":"link","href":"../api/file-based-routing.md#indextoken","children":[{"type":"text","value":"options"}]},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"strong","children":[{"type":"inlineCode","value":".route.tsx"},{"type":"text","value":" File Type"}]}]},{"type":"tableCell","children":[{"type":"text","value":"When using directories to organise routes, the "},{"type":"inlineCode","value":"route"},{"type":"text","value":" suffix can be used to create a route file at the directory's path. For example, "},{"type":"inlineCode","value":"blog.post.route.tsx"},{"type":"text","value":" or "},{"type":"inlineCode","value":"blog/post/route.tsx"},{"type":"text","value":" can be used as the route file for the "},{"type":"inlineCode","value":"/blog/post"},{"type":"text","value":" route. This can be configured via the "},{"type":"inlineCode","value":"routeToken"},{"type":"text","value":" configuration option (supports both strings and regex patterns), see "},{"type":"link","href":"../api/file-based-routing.md#routetoken","children":[{"type":"text","value":"options"}]},{"type":"text","value":"."}]}]]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"💡 Remember:"}]},{"type":"text","value":" The file-naming conventions for your project could be affected by what "},{"type":"link","href":"../api/file-based-routing.md","children":[{"type":"text","value":"options"}]},{"type":"text","value":" are configured."}]}]},{"type":"heading","depth":2,"id":"dynamic-path-params","children":[{"type":"text","value":"Dynamic Path Params"}]},{"type":"paragraph","children":[{"type":"text","value":"Dynamic path params can be used in both flat and directory routes to create routes that can match a dynamic segment of the URL path. Dynamic path params are denoted by the "},{"type":"inlineCode","value":"$"},{"type":"text","value":" character in the filename:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Filename"}]},{"type":"tableCell","children":[{"type":"text","value":"Route Path"}]},{"type":"tableCell","children":[{"type":"text","value":"Component Output"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"..."}]},{"type":"tableCell","children":[{"type":"text","value":"..."}]},{"type":"tableCell","children":[{"type":"text","value":"..."}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"posts.$postId.tsx"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"/posts/$postId"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><Posts><Post>"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"We'll learn more about dynamic path params in the "},{"type":"link","href":"../guide/path-params.md","children":[{"type":"text","value":"Path Params"}]},{"type":"text","value":" guide."}]},{"type":"heading","depth":2,"id":"pathless-routes","children":[{"type":"text","value":"Pathless Routes"}]},{"type":"paragraph","children":[{"type":"text","value":"Pathless routes wrap child routes with either logic or a component without requiring a URL path. Non-path routes are denoted by the "},{"type":"inlineCode","value":"_"},{"type":"text","value":" character in the filename:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Filename"}]},{"type":"tableCell","children":[{"type":"text","value":"Route Path"}]},{"type":"tableCell","children":[{"type":"text","value":"Component Output"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"_app.tsx"}]},{"type":"tableCell","children":[]},{"type":"tableCell","children":[]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"_app.a.tsx"}]},{"type":"tableCell","children":[{"type":"text","value":"/a"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><App><A>"}]}],[{"type":"tableCell","children":[{"type":"text","value":"ʦ "},{"type":"inlineCode","value":"_app.b.tsx"}]},{"type":"tableCell","children":[{"type":"text","value":"/b"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"<Root><App><B>"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"To learn more about pathless routes, see the "},{"type":"link","href":"./routing-concepts.md#pathless-layout-routes","children":[{"type":"text","value":"Routing Concepts - Pathless Layout Routes"}]},{"type":"text","value":" guide."}]}],"headings":[{"id":"dynamic-path-params","text":"Dynamic Path Params","level":2},{"id":"pathless-routes","text":"Pathless Routes","level":2}]},"frameworks":[],"downloadMarkdown":"\nFile-based routing requires that you follow a few simple file naming conventions to ensure that your routes are generated correctly. The concepts these conventions enable are covered in detail in the [Route Trees](./route-trees.md) guide.\n\n| Feature                            | Description                                                                                                                                                                                                                                                                                                                                                                                                          |\n| ---------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| **`__root.tsx`**                   | The root route file must be named `__root.tsx` and must be placed in the root of the configured `routesDirectory`.                                                                                                                                                                                                                                                                                                   |\n| **`.` Separator**                  | Routes can use the `.` character to denote a nested route. For example, `blog.post` will be generated as a child of `blog`.                                                                                                                                                                                                                                                                                          |\n| **`$` Token**                      | Route segments with the `$` token are parameterized and will extract the value from the URL pathname as a route `param`.                                                                                                                                                                                                                                                                                             |\n| **`_` Prefix**                     | Route segments with the `_` prefix are considered to be pathless layout routes and will not be used when matching its child routes against the URL pathname.                                                                                                                                                                                                                                                         |\n| **`_` Suffix**                     | Route segments with the `_` suffix exclude the route from being nested under any parent routes.                                                                                                                                                                                                                                                                                                                      |\n| **`-` Prefix**                     | Files and folders with the `-` prefix are excluded from the route tree. They will not be added to the `routeTree.gen.ts` file and can be used to colocate logic in route folders.                                                                                                                                                                                                                                    |\n| **`(folder)` folder name pattern** | A folder that matches this pattern is treated as a **route group**, preventing the folder from being included in the route's URL path.                                                                                                                                                                                                                                                                               |\n| **`[x]` Escaping**                 | Square brackets escape special characters in filenames that would otherwise have routing meaning. For example, `script[.]js.tsx` becomes `/script.js` and `api[.]v1.tsx` becomes `/api.v1`.                                                                                                                                                                                                                          |\n| **`index` Token**                  | Route segments ending with the `index` token (before any file extensions) will match the parent route when the URL pathname matches the parent route exactly. This can be configured via the `indexToken` configuration option (supports both strings and regex patterns), see [options](../api/file-based-routing.md#indextoken).                                                                                   |\n| **`.route.tsx` File Type**         | When using directories to organise routes, the `route` suffix can be used to create a route file at the directory's path. For example, `blog.post.route.tsx` or `blog/post/route.tsx` can be used as the route file for the `/blog/post` route. This can be configured via the `routeToken` configuration option (supports both strings and regex patterns), see [options](../api/file-based-routing.md#routetoken). |\n\n> **💡 Remember:** The file-naming conventions for your project could be affected by what [options](../api/file-based-routing.md) are configured.\n\n## Dynamic Path Params\n\nDynamic path params can be used in both flat and directory routes to create routes that can match a dynamic segment of the URL path. Dynamic path params are denoted by the `$` character in the filename:\n\n| Filename              | Route Path       | Component Output      |\n| --------------------- | ---------------- | --------------------- |\n| ...                   | ...              | ...                   |\n| ʦ `posts.$postId.tsx` | `/posts/$postId` | `<Root><Posts><Post>` |\n\nWe'll learn more about dynamic path params in the [Path Params](../guide/path-params.md) guide.\n\n## Pathless Routes\n\nPathless routes wrap child routes with either logic or a component without requiring a URL path. Non-path routes are denoted by the `_` character in the filename:\n\n| Filename       | Route Path | Component Output |\n| -------------- | ---------- | ---------------- |\n| ʦ `_app.tsx`   |            |                  |\n| ʦ `_app.a.tsx` | /a         | `<Root><App><A>` |\n| ʦ `_app.b.tsx` | /b         | `<Root><App><B>` |\n\nTo learn more about pathless routes, see the [Routing Concepts - Pathless Layout Routes](./routing-concepts.md#pathless-layout-routes) guide.\n","originalRawMarkdown":"---\ntitle: File Naming Conventions\n---\n\nFile-based routing requires that you follow a few simple file naming conventions to ensure that your routes are generated correctly. The concepts these conventions enable are covered in detail in the [Route Trees](./route-trees.md) guide.\n\n| Feature                            | Description                                                                                                                                                                                                                                                                                                                                                                                                          |\n| ---------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| **`__root.tsx`**                   | The root route file must be named `__root.tsx` and must be placed in the root of the configured `routesDirectory`.                                                                                                                                                                                                                                                                                                   |\n| **`.` Separator**                  | Routes can use the `.` character to denote a nested route. For example, `blog.post` will be generated as a child of `blog`.                                                                                                                                                                                                                                                                                          |\n| **`$` Token**                      | Route segments with the `$` token are parameterized and will extract the value from the URL pathname as a route `param`.                                                                                                                                                                                                                                                                                             |\n| **`_` Prefix**                     | Route segments with the `_` prefix are considered to be pathless layout routes and will not be used when matching its child routes against the URL pathname.                                                                                                                                                                                                                                                         |\n| **`_` Suffix**                     | Route segments with the `_` suffix exclude the route from being nested under any parent routes.                                                                                                                                                                                                                                                                                                                      |\n| **`-` Prefix**                     | Files and folders with the `-` prefix are excluded from the route tree. They will not be added to the `routeTree.gen.ts` file and can be used to colocate logic in route folders.                                                                                                                                                                                                                                    |\n| **`(folder)` folder name pattern** | A folder that matches this pattern is treated as a **route group**, preventing the folder from being included in the route's URL path.                                                                                                                                                                                                                                                                               |\n| **`[x]` Escaping**                 | Square brackets escape special characters in filenames that would otherwise have routing meaning. For example, `script[.]js.tsx` becomes `/script.js` and `api[.]v1.tsx` becomes `/api.v1`.                                                                                                                                                                                                                          |\n| **`index` Token**                  | Route segments ending with the `index` token (before any file extensions) will match the parent route when the URL pathname matches the parent route exactly. This can be configured via the `indexToken` configuration option (supports both strings and regex patterns), see [options](../api/file-based-routing.md#indextoken).                                                                                   |\n| **`.route.tsx` File Type**         | When using directories to organise routes, the `route` suffix can be used to create a route file at the directory's path. For example, `blog.post.route.tsx` or `blog/post/route.tsx` can be used as the route file for the `/blog/post` route. This can be configured via the `routeToken` configuration option (supports both strings and regex patterns), see [options](../api/file-based-routing.md#routetoken). |\n\n> **💡 Remember:** The file-naming conventions for your project could be affected by what [options](../api/file-based-routing.md) are configured.\n\n## Dynamic Path Params\n\nDynamic path params can be used in both flat and directory routes to create routes that can match a dynamic segment of the URL path. Dynamic path params are denoted by the `$` character in the filename:\n\n| Filename              | Route Path       | Component Output      |\n| --------------------- | ---------------- | --------------------- |\n| ...                   | ...              | ...                   |\n| ʦ `posts.$postId.tsx` | `/posts/$postId` | `<Root><Posts><Post>` |\n\nWe'll learn more about dynamic path params in the [Path Params](../guide/path-params.md) guide.\n\n## Pathless Routes\n\nPathless routes wrap child routes with either logic or a component without requiring a URL path. Non-path routes are denoted by the `_` character in the filename:\n\n| Filename       | Route Path | Component Output |\n| -------------- | ---------- | ---------------- |\n| ʦ `_app.tsx`   |            |                  |\n| ʦ `_app.a.tsx` | /a         | `<Root><App><A>` |\n| ʦ `_app.b.tsx` | /b         | `<Root><App><B>` |\n\nTo learn more about pathless routes, see the [Routing Concepts - Pathless Layout Routes](./routing-concepts.md#pathless-layout-routes) guide.\n"}
