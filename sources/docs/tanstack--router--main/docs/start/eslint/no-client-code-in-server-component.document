{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"TanStack Start defines React Server Component boundaries via RSC helpers like "},{"type":"inlineCode","value":"renderServerComponent()"},{"type":"text","value":" and "},{"type":"inlineCode","value":"createCompositeComponent()"},{"type":"text","value":"."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"renderServerComponent(<Element />)"},{"type":"text","value":" is a server boundary around the element."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"createCompositeComponent((props) => <Element />)"},{"type":"text","value":" is a server boundary around the callback."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Inside these boundaries (and anything rendered from them, unless it crosses a "},{"type":"inlineCode","value":"'use client'"},{"type":"text","value":" boundary) you must not use client-only code."}]},{"type":"paragraph","children":[{"type":"text","value":"This rule detects common client-only patterns in server components:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"React client hooks (eg "},{"type":"inlineCode","value":"useState"},{"type":"text","value":", "},{"type":"inlineCode","value":"useEffect"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"browser-only globals (eg "},{"type":"inlineCode","value":"window"},{"type":"text","value":", "},{"type":"inlineCode","value":"document"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"React event handlers ("},{"type":"inlineCode","value":"onClick"},{"type":"text","value":", etc.)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"function props (non-serializable across the server/client boundary)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"class components"}]}]}]},{"type":"heading","depth":2,"id":"rule-details","children":[{"type":"text","value":"Rule Details"}]},{"type":"paragraph","children":[{"type":"text","value":"Examples of "},{"type":"strong","children":[{"type":"text","value":"incorrect"}]},{"type":"text","value":" code for this rule:"}]},{"type":"code","value":"/* eslint \"@tanstack/start/no-client-code-in-server-component\": \"error\" */\n\nimport { createCompositeComponent } from '@tanstack/react-start/rsc'\nimport { useState } from 'react'\n\nexport const Server = createCompositeComponent(() => {\n  const [count] = useState(0)\n  return <div>{count}</div>\n})","lang":"tsx"},{"type":"code","value":"/* eslint \"@tanstack/start/no-client-code-in-server-component\": \"error\" */\n\nimport { createCompositeComponent } from '@tanstack/react-start/rsc'\n\nexport const Server = createCompositeComponent(() => {\n  return <div>{window.location.href}</div>\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Examples of "},{"type":"strong","children":[{"type":"text","value":"correct"}]},{"type":"text","value":" code for this rule:"}]},{"type":"code","value":"/* eslint \"@tanstack/start/no-client-code-in-server-component\": \"error\" */\n\nimport { renderServerComponent } from '@tanstack/react-start/rsc'\n\nexport const Server = renderServerComponent(\n  (async () => {\n    const msg = await Promise.resolve('ok')\n    return <div>{msg}</div>\n  })(),\n)","lang":"tsx"},{"type":"heading","depth":2,"id":"attributes","children":[{"type":"text","value":"Attributes"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"✅ Recommended"}]}],"checked":true}]}],"headings":[{"id":"rule-details","text":"Rule Details","level":2},{"id":"attributes","text":"Attributes","level":2}]},"frameworks":[],"downloadMarkdown":"\nTanStack Start defines React Server Component boundaries via RSC helpers like `renderServerComponent()` and `createCompositeComponent()`.\n\n- `renderServerComponent(<Element />)` is a server boundary around the element.\n- `createCompositeComponent((props) => <Element />)` is a server boundary around the callback.\n\nInside these boundaries (and anything rendered from them, unless it crosses a `'use client'` boundary) you must not use client-only code.\n\nThis rule detects common client-only patterns in server components:\n\n- React client hooks (eg `useState`, `useEffect`)\n- browser-only globals (eg `window`, `document`)\n- React event handlers (`onClick`, etc.)\n- function props (non-serializable across the server/client boundary)\n- class components\n\n## Rule Details\n\nExamples of **incorrect** code for this rule:\n\n```tsx\n/* eslint \"@tanstack/start/no-client-code-in-server-component\": \"error\" */\n\nimport { createCompositeComponent } from '@tanstack/react-start/rsc'\nimport { useState } from 'react'\n\nexport const Server = createCompositeComponent(() => {\n  const [count] = useState(0)\n  return <div>{count}</div>\n})\n```\n\n```tsx\n/* eslint \"@tanstack/start/no-client-code-in-server-component\": \"error\" */\n\nimport { createCompositeComponent } from '@tanstack/react-start/rsc'\n\nexport const Server = createCompositeComponent(() => {\n  return <div>{window.location.href}</div>\n})\n```\n\nExamples of **correct** code for this rule:\n\n```tsx\n/* eslint \"@tanstack/start/no-client-code-in-server-component\": \"error\" */\n\nimport { renderServerComponent } from '@tanstack/react-start/rsc'\n\nexport const Server = renderServerComponent(\n  (async () => {\n    const msg = await Promise.resolve('ok')\n    return <div>{msg}</div>\n  })(),\n)\n```\n\n## Attributes\n\n- [x] ✅ Recommended\n","originalRawMarkdown":"---\nid: no-client-code-in-server-component\ntitle: Disallow client-only code in server components\n---\n\nTanStack Start defines React Server Component boundaries via RSC helpers like `renderServerComponent()` and `createCompositeComponent()`.\n\n- `renderServerComponent(<Element />)` is a server boundary around the element.\n- `createCompositeComponent((props) => <Element />)` is a server boundary around the callback.\n\nInside these boundaries (and anything rendered from them, unless it crosses a `'use client'` boundary) you must not use client-only code.\n\nThis rule detects common client-only patterns in server components:\n\n- React client hooks (eg `useState`, `useEffect`)\n- browser-only globals (eg `window`, `document`)\n- React event handlers (`onClick`, etc.)\n- function props (non-serializable across the server/client boundary)\n- class components\n\n## Rule Details\n\nExamples of **incorrect** code for this rule:\n\n```tsx\n/* eslint \"@tanstack/start/no-client-code-in-server-component\": \"error\" */\n\nimport { createCompositeComponent } from '@tanstack/react-start/rsc'\nimport { useState } from 'react'\n\nexport const Server = createCompositeComponent(() => {\n  const [count] = useState(0)\n  return <div>{count}</div>\n})\n```\n\n```tsx\n/* eslint \"@tanstack/start/no-client-code-in-server-component\": \"error\" */\n\nimport { createCompositeComponent } from '@tanstack/react-start/rsc'\n\nexport const Server = createCompositeComponent(() => {\n  return <div>{window.location.href}</div>\n})\n```\n\nExamples of **correct** code for this rule:\n\n```tsx\n/* eslint \"@tanstack/start/no-client-code-in-server-component\": \"error\" */\n\nimport { renderServerComponent } from '@tanstack/react-start/rsc'\n\nexport const Server = renderServerComponent(\n  (async () => {\n    const msg = await Promise.resolve('ok')\n    return <div>{msg}</div>\n  })(),\n)\n```\n\n## Attributes\n\n- [x] ✅ Recommended\n"}
