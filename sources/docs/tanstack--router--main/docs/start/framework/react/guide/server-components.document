---
id: server-components
title: Server Components
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"callout","kind":"warning","title":"Warning","children":[{"type":"paragraph","children":[{"type":"text","value":"Server Components are experimental! The API may see refinements."}]}]},{"type":"paragraph","children":[{"type":"text","value":"Server Components let you render React components on the server and stream them to the client. Heavy dependencies stay out of your bundle, data fetching lives in the component, and sensitive logic never reaches the browser."}]},{"type":"heading","depth":2,"id":"setup","children":[{"type":"text","value":"Setup"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Server Components are not enabled by default."}]},{"type":"text","value":" Complete these three steps first:"}]},{"type":"heading","depth":3,"id":"1-install-build-tool-specific-rsc-dependencies","children":[{"type":"text","value":"1. Install Build Tool-Specific RSC Dependencies"}]},{"type":"component","name":"tabs","attributes":{"variant":"bundler"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"vite","data-tab-index":"0","data-content":"code-only"},"children":[{"type":"code","value":"npm install -D @vitejs/plugin-rsc\n# or\npnpm add -D @vitejs/plugin-rsc\n# or\nyarn add -D @vitejs/plugin-rsc\n# or\nbun add -D @vitejs/plugin-rsc","lang":"bash"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"rsbuild","data-tab-index":"1","data-content":"mixed"},"children":[{"type":"paragraph","children":[{"type":"text","value":"Rsbuild does not need a separate RSC plugin. Make sure your Rsbuild React dependencies are installed:"}]},{"type":"code","value":"npm install -D @rsbuild/core @rsbuild/plugin-react","lang":"bash"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"vite\",\"name\":\"vite\"},{\"slug\":\"rsbuild\",\"name\":\"rsbuild\"}]}","data-bundler-meta":"{\"bundlers\":[\"vite\",\"rsbuild\"]}"}},{"type":"heading","depth":3,"id":"2-configure-your-build-tool","children":[{"type":"text","value":"2. Configure Your Build Tool"}]},{"type":"paragraph","children":[{"type":"text","value":"Update your build tool config to enable RSC in the TanStack Start plugin:"}]},{"type":"component","name":"tabs","attributes":{"variant":"bundler"},"children":[{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"vite","data-tab-index":"0","data-content":"code-only"},"children":[{"type":"code","value":"import { defineConfig } from 'vite'\nimport { tanstackStart } from '@tanstack/react-start/plugin/vite'\nimport viteReact from '@vitejs/plugin-react'\nimport rsc from '@vitejs/plugin-rsc'\n\nexport default defineConfig({\n  plugins: [\n    tanstackStart({\n      rsc: {\n        enabled: true,\n      },\n    }),\n    rsc(),\n    viteReact(),\n  ],\n})","lang":"ts","meta":"title=\"vite.config.ts\"","title":"vite.config.ts","file":"vite.config.ts"}]},{"type":"component","name":"tab-panel","tagName":"md-tab-panel","attributes":{},"properties":{"data-tab-slug":"rsbuild","data-tab-index":"1","data-content":"code-only"},"children":[{"type":"code","value":"import { defineConfig } from '@rsbuild/core'\nimport { pluginReact } from '@rsbuild/plugin-react'\nimport { tanstackStart } from '@tanstack/react-start/plugin/rsbuild'\n\nexport default defineConfig({\n  plugins: [\n    pluginReact(),\n    tanstackStart({\n      rsc: {\n        enabled: true,\n      },\n    }),\n  ],\n})","lang":"ts","meta":"title=\"rsbuild.config.ts\"","title":"rsbuild.config.ts","file":"rsbuild.config.ts"}]}],"properties":{"data-attributes":"{\"tabs\":[{\"slug\":\"vite\",\"name\":\"vite\"},{\"slug\":\"rsbuild\",\"name\":\"rsbuild\"}]}","data-bundler-meta":"{\"bundlers\":[\"vite\",\"rsbuild\"]}"}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Requirements:"}]},{"type":"text","value":" React 19+, Vite 7+ or Rsbuild 2+"}]},{"type":"heading","depth":2,"id":"quick-start","children":[{"type":"text","value":"Quick Start"}]},{"type":"paragraph","children":[{"type":"text","value":"In TanStack Start, you typically create server-rendered UI in a server function, then return it through a route "},{"type":"inlineCode","value":"loader"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"There are two high-level RSC helpers:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"renderServerComponent(<Element />)"},{"type":"text","value":" returns a "},{"type":"strong","children":[{"type":"text","value":"renderable value"}]},{"type":"text","value":" you can inline like "},{"type":"inlineCode","value":"{Renderable}"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"createCompositeComponent((props) => <Element />)"},{"type":"text","value":" returns a "},{"type":"strong","children":[{"type":"text","value":"composite source"}]},{"type":"text","value":" rendered via "},{"type":"inlineCode","value":"<CompositeComponent src={...} />"},{"type":"text","value":" (supports slots)."}]}]}]},{"type":"heading","depth":3,"id":"renderable-no-slots","children":[{"type":"text","value":"Renderable (no slots)"}]},{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\nimport { createServerFn } from '@tanstack/react-start'\nimport { renderServerComponent } from '@tanstack/react-start/rsc'\n\nfunction Greeting() {\n  return <h1>Hello from RSC</h1>\n}\n\nconst getGreeting = createServerFn().handler(async () => {\n  const Renderable = await renderServerComponent(<Greeting />)\n  return { Renderable }\n})\n\nexport const Route = createFileRoute('/')({\n  loader: async () => {\n    const { Renderable } = await getGreeting()\n    return { Greeting: Renderable }\n  },\n  component: HomePage,\n})\n\nfunction HomePage() {\n  const { Greeting } = Route.useLoaderData()\n  return <>{Greeting}</>\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"composite-slots","children":[{"type":"text","value":"Composite (slots)"}]},{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\nimport { createServerFn } from '@tanstack/react-start'\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getCard = createServerFn().handler(async () => {\n  const src = await createCompositeComponent(\n    (props: { children?: React.ReactNode }) => (\n      <div className=\"card\">\n        <h2>Server-rendered header</h2>\n        <div>{props.children}</div>\n      </div>\n    ),\n  )\n\n  return { src }\n})\n\nexport const Route = createFileRoute('/')({\n  loader: async () => ({\n    Card: await getCard(),\n  }),\n  component: HomePage,\n})\n\nfunction HomePage() {\n  const { Card } = Route.useLoaderData()\n\n  return (\n    <CompositeComponent src={Card.src}>\n      <Counter />\n    </CompositeComponent>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"why-server-components","children":[{"type":"text","value":"Why Server Components?"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Smaller bundles."}]},{"type":"text","value":" Markdown parsers, syntax highlighters, and heavy libraries run on the server. Only rendered HTML reaches the client."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Colocated data fetching."}]},{"type":"text","value":" Fetch data directly in the component that needs it."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Secure by default."}]},{"type":"text","value":" API keys, database queries, and business logic never appear in the client bundle."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Progressive streaming."}]},{"type":"text","value":" UI streams to the browser as it renders. Users see content immediately."}]}]}]},{"type":"heading","depth":2,"id":"passing-props-and-composition","children":[{"type":"text","value":"Passing Props and Composition"}]},{"type":"paragraph","children":[{"type":"text","value":"Renderable values returned from "},{"type":"inlineCode","value":"renderServerComponent"},{"type":"text","value":" do not support slots."}]},{"type":"paragraph","children":[{"type":"text","value":"To accept client-provided props (\"slots\"), use "},{"type":"inlineCode","value":"createCompositeComponent"},{"type":"text","value":" and render it with "},{"type":"inlineCode","value":"<CompositeComponent src={...} />"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Slots are declared on the server component props. There are three types of slots:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Slot Type"}]},{"type":"tableCell","children":[{"type":"text","value":"Use Case"}]},{"type":"tableCell","children":[{"type":"text","value":"Server Can Pass Data?"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"children"}]},{"type":"tableCell","children":[{"type":"text","value":"Simple composition"}]},{"type":"tableCell","children":[{"type":"text","value":"No"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Render props"}]},{"type":"tableCell","children":[{"type":"text","value":"Server passes data to client-rendered content"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Component props"}]},{"type":"tableCell","children":[{"type":"text","value":"Pass reusable components that receive server data"}]},{"type":"tableCell","children":[{"type":"text","value":"Yes"}]}]]},{"type":"heading","depth":3,"id":"children-slots","children":[{"type":"text","value":"Children Slots"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass client components as children. Simple and familiar, but the server cannot pass data to them:"}]},{"type":"code","value":"import {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getCard = createServerFn().handler(async () => {\n  const src = await createCompositeComponent(\n    (props: { children?: React.ReactNode }) => (\n      <div className=\"card\">\n        <h2>Server-rendered header</h2>\n        <div>{props.children}</div>\n      </div>\n    ),\n  )\n\n  return { src }\n})\n\nfunction MyPage() {\n  const { src } = Route.useLoaderData()\n\n  return (\n    <CompositeComponent src={src}>\n      {/* Client components with full interactivity */}\n      <Counter />\n      <button onClick={() => alert('Clicked!')}>Click me</button>\n    </CompositeComponent>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"render-props","children":[{"type":"text","value":"Render Props"}]},{"type":"paragraph","children":[{"type":"text","value":"Use render props when the server needs to pass data to client-rendered content:"}]},{"type":"code","value":"import {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getPost = createServerFn()\n  .validator(z.object({ postId: z.string() }))\n  .handler(async ({ data }) => {\n    const post = await db.posts.findById(data.postId)\n\n    const src = await createCompositeComponent(\n      (props: {\n        children?: React.ReactNode\n        renderActions?: (data: {\n          postId: string\n          authorId: string\n        }) => React.ReactNode\n      }) => (\n        <article>\n          <h1>{post.title}</h1>\n          <p>{post.body}</p>\n          <footer>\n            {props.renderActions?.({\n              postId: post.id,\n              authorId: post.authorId,\n            })}\n          </footer>\n          {props.children}\n        </article>\n      ),\n    )\n\n    return { src }\n  })\n\nfunction PostPage() {\n  const { src } = Route.useLoaderData()\n\n  return (\n    <CompositeComponent\n      src={src}\n      renderActions={({ postId, authorId }) => (\n        <PostActions postId={postId} authorId={authorId} />\n      )}\n    >\n      <Comments />\n    </CompositeComponent>\n  )\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"component-props","children":[{"type":"text","value":"Component Props"}]},{"type":"paragraph","children":[{"type":"text","value":"Pass React components as props. On the client, the passed in props will be rendered with data supplied by the server:"}]},{"type":"code","value":"import {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getProductCard = createServerFn()\n  .validator(z.object({ productId: z.string() }))\n  .handler(async ({ data }) => {\n    const product = await db.products.findById(data.productId)\n\n    const src = await createCompositeComponent(\n      ({\n        AddToCart,\n      }: {\n        AddToCart: React.ComponentType<{ productId: string; price: number }>\n      }) => (\n        <div className=\"product-card\">\n          <h2>{product.name}</h2>\n          <p>${product.price}</p>\n          <AddToCart productId={product.id} price={product.price} />\n        </div>\n      ),\n    )\n\n    return { src }\n  })\n\n// Client component with interactivity\nfunction AddToCartButton({\n  productId,\n  price,\n}: {\n  productId: string\n  price: number\n}) {\n  const [added, setAdded] = React.useState(false)\n\n  return (\n    <button onClick={() => setAdded(true)}>\n      {added ? '✓ Added!' : `Add to Cart - $${price}`}\n    </button>\n  )\n}\n\nfunction ProductPage() {\n  const { src } = Route.useLoaderData()\n\n  return <CompositeComponent src={src} AddToCart={AddToCartButton} />\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Component props are useful when:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"You want to pass reusable client components"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The component needs its own state or event handlers"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"You prefer component composition over render prop callbacks"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"All three slot types can be combined. "},{"type":"inlineCode","value":"createCompositeComponent"},{"type":"text","value":" provides full type safety for slot props."}]},{"type":"heading","depth":2,"id":"caching","children":[{"type":"text","value":"Caching"}]},{"type":"paragraph","children":[{"type":"text","value":"Server components work with TanStack Router's built-in caching. The cache key is the route path plus params:"}]},{"type":"code","value":"export const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ params }) => ({\n    Post: await getPost({ data: { postId: params.postId } }),\n  }),\n  component: PostPage,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Navigate to "},{"type":"inlineCode","value":"/posts/abc"},{"type":"text","value":", then "},{"type":"inlineCode","value":"/posts/xyz"},{"type":"text","value":", then back to "},{"type":"inlineCode","value":"/posts/abc"},{"type":"text","value":" - the cached component renders instantly."}]},{"type":"paragraph","children":[{"type":"text","value":"Control freshness with "},{"type":"inlineCode","value":"staleTime"},{"type":"text","value":":"}]},{"type":"code","value":"export const Route = createFileRoute('/posts/$postId')({\n  staleTime: 10_000, // Fresh for 10 seconds\n  loader: async ({ params }) => ({\n    Post: await getPost({ data: { postId: params.postId } }),\n  }),\n  component: PostPage,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"For cache keys beyond route params, use "},{"type":"inlineCode","value":"loaderDeps"},{"type":"text","value":":"}]},{"type":"code","value":"export const Route = createFileRoute('/posts/$postId')({\n  loaderDeps: ({ search }) => ({ tab: search.tab }),\n  loader: async ({ params, deps }) => ({\n    Post: await getPost({ data: { postId: params.postId, tab: deps.tab } }),\n  }),\n  component: PostPage,\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"tanstack-query","children":[{"type":"text","value":"TanStack Query"}]},{"type":"paragraph","children":[{"type":"text","value":"For fine-grained control, use TanStack Query:"}]},{"type":"code","value":"import { useSuspenseQuery, useQueryClient } from '@tanstack/react-query'\n\nconst postQueryOptions = (postId: string) => ({\n  queryKey: ['post', postId],\n  structuralSharing: false, // Required - RSC values must not be merged\n  queryFn: () => getPost({ data: { postId } }),\n  staleTime: 5 * 60 * 1000,\n})\n\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ context, params }) => {\n    // Prefetch during SSR - data reused on client without refetch\n    await context.queryClient.query({\n      ...postQueryOptions(params.postId),\n      staleTime: 'static',\n    })\n  },\n  component: PostPage,\n})\n\nfunction PostPage() {\n  const { postId } = Route.useParams()\n  const queryClient = useQueryClient()\n\n  const { data } = useSuspenseQuery(postQueryOptions(postId))\n\n  const handleRefresh = () => {\n    // Manually refetch the RSC\n    queryClient.refetchQueries({ queryKey: ['post', postId] })\n  }\n\n  return <CompositeComponent src={data.src} />\n}","lang":"tsx"},{"type":"callout","kind":"important","title":"Important","children":[{"type":"paragraph","children":[{"type":"text","value":"Always set "},{"type":"inlineCode","value":"structuralSharing: false"},{"type":"text","value":" when caching server components with React Query. Without this, React Query may attempt to merge RSC values between fetches, which can cause errors."}]}]},{"type":"heading","depth":3,"id":"invalidation","children":[{"type":"text","value":"Invalidation"}]},{"type":"paragraph","children":[{"type":"text","value":"To refetch a server component after data changes, use "},{"type":"inlineCode","value":"router.invalidate()"},{"type":"text","value":":"}]},{"type":"code","value":"import { useRouter } from '@tanstack/react-router'\n\nfunction PostPage() {\n  const router = useRouter()\n  const { Post } = Route.useLoaderData()\n\n  const handleUpdate = async () => {\n    await updatePost({ data: { ... } })\n    // Refetch the route's loader, including the RSC\n    router.invalidate()\n  }\n\n  return (\n    <CompositeComponent\n      src={Post.src}\n      renderActions={() => (\n        <button onClick={handleUpdate}>Update Post</button>\n      )}\n    />\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"This pattern is useful when server functions mutate data that the RSC displays. After the mutation completes, "},{"type":"inlineCode","value":"router.invalidate()"},{"type":"text","value":" triggers the loader to run again, fetching a fresh server component with updated data."}]},{"type":"heading","depth":2,"id":"combining-with-selective-ssr","children":[{"type":"text","value":"Combining with Selective SSR"}]},{"type":"paragraph","children":[{"type":"text","value":"Server Components pair with "},{"type":"link","href":"./selective-ssr.md","children":[{"type":"text","value":"Selective SSR"}]},{"type":"text","value":" when you need server-rendered content but client-only rendering for the route component itself."}]},{"type":"heading","depth":3,"id":"example-ssr-data-only","children":[{"type":"text","value":"Example: "},{"type":"inlineCode","value":"ssr: 'data-only'"}]},{"type":"paragraph","children":[{"type":"text","value":"The server fetches the RSC, but the route component renders on the client:"}]},{"type":"code","value":"export const Route = createFileRoute('/dashboard')({\n  ssr: 'data-only',\n  loader: async () => ({\n    Dashboard: await getDashboard(),\n  }),\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  const { Dashboard } = Route.useLoaderData()\n  const [width, setWidth] = React.useState(0)\n\n  React.useEffect(() => {\n    setWidth(window.innerWidth) // Browser API\n  }, [])\n\n  return (\n    <Dashboard\n      renderChart={({ data }) => <ResponsiveChart data={data} width={width} />}\n    />\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"This is useful when:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The server component fetches data and renders static content"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The route component needs "},{"type":"inlineCode","value":"window"},{"type":"text","value":", "},{"type":"inlineCode","value":"localStorage"},{"type":"text","value":", or other browser APIs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"You want the server component data ready before the client renders"}]}]}]},{"type":"heading","depth":3,"id":"example-ssr-false","children":[{"type":"text","value":"Example: "},{"type":"inlineCode","value":"ssr: false"}]},{"type":"paragraph","children":[{"type":"text","value":"Both loader and component run on the client:"}]},{"type":"code","value":"export const Route = createFileRoute('/canvas')({\n  ssr: false,\n  loader: async () => {\n    const savedState = localStorage.getItem('canvas-state')\n    return { Tools: await getDrawingTools({ data: { savedState } }) }\n  },\n  component: CanvasPage,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Use this when the loader itself requires browser APIs."}]},{"type":"heading","depth":2,"id":"advanced-patterns","children":[{"type":"text","value":"Advanced Patterns"}]},{"type":"heading","depth":3,"id":"multiple-server-components-in-parallel","children":[{"type":"text","value":"Multiple Server Components in Parallel"}]},{"type":"paragraph","children":[{"type":"text","value":"When a page needs several independent server components, fetch them in parallel using "},{"type":"inlineCode","value":"Promise.all"},{"type":"text","value":". Each component renders independently with its own data."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"When to use:"}]},{"type":"text","value":" Components from separate data sources with no shared dependencies. Maximizes concurrency when each component has independent fetch logic."}]},{"type":"code","value":"const getArticleA = createServerFn().handler(async () => {\n  const article = await db.articles.findById('a')\n  return renderServerComponent(<Article data={article} />)\n})\n\nconst getArticleB = createServerFn().handler(async () => {\n  const article = await db.articles.findById('b')\n  return renderServerComponent(<Article data={article} />)\n})\n\nconst getSidebar = createServerFn().handler(async () => {\n  const trending = await db.articles.getTrending()\n  return renderServerComponent(<Sidebar items={trending} />)\n})\n\nexport const Route = createFileRoute('/news')({\n  loader: async () => {\n    const [ArticleA, ArticleB, Sidebar] = await Promise.all([\n      getArticleA(),\n      getArticleB(),\n      getSidebar(),\n    ])\n    return { ArticleA, ArticleB, Sidebar }\n  },\n  component: NewsPage,\n})\n\nfunction NewsPage() {\n  const { ArticleA, ArticleB, Sidebar } = Route.useLoaderData()\n\n  return (\n    <div className=\"grid\">\n      <main>\n        {ArticleA}\n        {ArticleB}\n      </main>\n      <aside>{Sidebar}</aside>\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Each server function executes concurrently. The page renders when all complete."}]},{"type":"heading","depth":3,"id":"bundling-multiple-components","children":[{"type":"text","value":"Bundling Multiple Components"}]},{"type":"paragraph","children":[{"type":"text","value":"Return multiple server components from a single server function when they share data or should be fetched together. This reduces network round trips."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"When to use:"}]},{"type":"text","value":" Components that share fetched data, need a single cache key, or should invalidate together. Reduces database queries and network round trips."}]},{"type":"heading","depth":4,"id":"using-promise-all","children":[{"type":"text","value":"Using Promise.all"}]},{"type":"paragraph","children":[{"type":"text","value":"Create multiple "},{"type":"inlineCode","value":"renderServerComponent"},{"type":"text","value":" or "},{"type":"inlineCode","value":"createCompositeComponent"},{"type":"text","value":" calls and return them as an object:"}]},{"type":"code","value":"const getPageLayout = createServerFn().handler(async () => {\n  // Fetch shared data once\n  const user = await db.users.getCurrent()\n  const config = await db.config.get()\n\n  // Create multiple components that share this data\n  const [Header, Content, Footer] = await Promise.all([\n    renderServerComponent(\n      <header>\n        <Logo />\n        <nav>\n          {config.navItems.map((item) => (\n            <NavLink key={item.id} {...item} />\n          ))}\n        </nav>\n        <UserMenu name={user.name} />\n      </header>,\n    ),\n    renderServerComponent(\n      <main>\n        <h1>Welcome, {user.name}</h1>\n        <Dashboard stats={user.stats} />\n      </main>,\n    ),\n    renderServerComponent(\n      <footer>\n        <span>{config.copyright}</span>\n        {config.footerLinks.map((link) => (\n          <a key={link.id} href={link.url}>\n            {link.label}\n          </a>\n        ))}\n      </footer>,\n    ),\n  ])\n\n  return { Header, Content, Footer }\n})\n\nexport const Route = createFileRoute('/dashboard')({\n  loader: async () => await getPageLayout(),\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  const { Header, Content, Footer } = Route.useLoaderData()\n\n  return (\n    <>\n      {Header}\n      {Content}\n      {Footer}\n    </>\n  )\n}","lang":"tsx"},{"type":"heading","depth":4,"id":"using-nested-structures","children":[{"type":"text","value":"Using Nested Structures"}]},{"type":"paragraph","children":[{"type":"text","value":"Alternatively, return a nested object structure from a single server function."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"renderServerComponent"},{"type":"text","value":" when you just need renderables (no slots)."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"createCompositeComponent"},{"type":"text","value":" when you want each part to accept slots."}]}]}]},{"type":"code","value":"const getPageLayout = createServerFn().handler(async () => {\n  const user = await db.users.getCurrent()\n  const config = await db.config.get()\n\n  const [Header, Content, Footer] = await Promise.all([\n    createCompositeComponent((props: { children?: React.ReactNode }) => (\n      <header>\n        <Logo />\n        <nav>\n          {config.navItems.map((item) => (\n            <NavLink key={item.id} {...item} />\n          ))}\n        </nav>\n        <UserMenu name={user.name} />\n        {props.children}\n      </header>\n    )),\n    createCompositeComponent(\n      (props: { renderActions?: () => React.ReactNode }) => (\n        <main>\n          <h1>Welcome, {user.name}</h1>\n          <Dashboard stats={user.stats} />\n          {props.renderActions?.()}\n        </main>\n      ),\n    ),\n    createCompositeComponent(() => (\n      <footer>\n        <span>{config.copyright}</span>\n        {config.footerLinks.map((link) => (\n          <a key={link.id} href={link.url}>\n            {link.label}\n          </a>\n        ))}\n      </footer>\n    )),\n  ])\n\n  return { Header, Content, Footer }\n})\n\nexport const Route = createFileRoute('/dashboard')({\n  loader: async () => ({\n    Layout: await getPageLayout(),\n  }),\n  component: DashboardPage,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Render nested composites using dot notation:"}]},{"type":"code","value":"import { CompositeComponent } from '@tanstack/react-start/rsc'\n\nfunction DashboardPage() {\n  const { Layout } = Route.useLoaderData()\n\n  return (\n    <>\n      <CompositeComponent src={Layout.Header}>\n        <button onClick={() => setMenuOpen(true)}>Menu</button>\n      </CompositeComponent>\n      <CompositeComponent\n        src={Layout.Content}\n        renderActions={() => <ActionButtons />}\n      />\n      <CompositeComponent src={Layout.Footer} />\n    </>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Or destructure them from the loader data:"}]},{"type":"code","value":"import { CompositeComponent } from '@tanstack/react-start/rsc'\n\nfunction DashboardPage() {\n  const { Header, Content, Footer } = Route.useLoaderData().Layout\n\n  return (\n    <>\n      <CompositeComponent src={Header}>\n        <button onClick={() => setMenuOpen(true)}>Menu</button>\n      </CompositeComponent>\n      <CompositeComponent\n        src={Content}\n        renderActions={() => <ActionButtons />}\n      />\n      <CompositeComponent src={Footer} />\n    </>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Each nested component receives its own slot props independently. The "},{"type":"inlineCode","value":"children"},{"type":"text","value":" passed to "},{"type":"inlineCode","value":"<CompositeComponent src={Header}>"},{"type":"text","value":" only affects that component, not the others."}]},{"type":"paragraph","children":[{"type":"text","value":"All three components share the same user and config data from a single database query."}]},{"type":"heading","depth":3,"id":"deferred-component-loading","children":[{"type":"text","value":"Deferred Component Loading"}]},{"type":"paragraph","children":[{"type":"text","value":"Return promises for server components instead of awaiting them. The client uses "},{"type":"inlineCode","value":"React.use()"},{"type":"text","value":" with "},{"type":"inlineCode","value":"Suspense"},{"type":"text","value":" to render each component as it resolves."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"When to use:"}]},{"type":"text","value":" Components with varying data latencies where faster results should render before slower ones complete. Avoids blocking on the slowest query."}]},{"type":"code","value":"import { Suspense, use } from 'react'\n\nconst getDashboardBundle = createServerFn().handler(() => ({\n  // Fast - resolves in ~100ms\n  QuickStats: (async () => {\n    const stats = await cache.getStats() // Fast cache hit\n    return renderServerComponent(<StatsCard data={stats} />)\n  })(),\n\n  // Medium - resolves in ~500ms\n  RecentActivity: (async () => {\n    const activity = await db.activity.getRecent()\n    return renderServerComponent(<ActivityFeed items={activity} />)\n  })(),\n\n  // Slow - resolves in ~2000ms\n  Analytics: (async () => {\n    const data = await analytics.computeMetrics() // Expensive query\n    return renderServerComponent(<AnalyticsChart data={data} />)\n  })(),\n}))\n\nexport const Route = createFileRoute('/dashboard')({\n  loader: () => getDashboardBundle(),\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  const { QuickStats, RecentActivity, Analytics } = Route.useLoaderData()\n\n  return (\n    <div>\n      <Suspense fallback={<Skeleton />}>\n        <Deferred promise={QuickStats} />\n      </Suspense>\n\n      <Suspense fallback={<Skeleton />}>\n        <Deferred promise={RecentActivity} />\n      </Suspense>\n\n      <Suspense fallback={<Skeleton />}>\n        <Deferred promise={Analytics} />\n      </Suspense>\n    </div>\n  )\n}\n\nfunction Deferred({ promise }: { promise: Promise<unknown> }) {\n  const Renderable = use(promise)\n  return <>{Renderable}</>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"QuickStats appears first, RecentActivity follows, then Analytics loads last. Users see progressive content instead of waiting for everything."}]},{"type":"heading","depth":3,"id":"suspense-inside-server-components","children":[{"type":"text","value":"Suspense Inside Server Components"}]},{"type":"paragraph","children":[{"type":"text","value":"Use React's "},{"type":"inlineCode","value":"Suspense"},{"type":"text","value":" directly inside server components to stream parts of the component as they become ready."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"When to use:"}]},{"type":"text","value":" A single server component with multiple async child components that should stream independently. Keeps related UI in one component while allowing progressive rendering."}]},{"type":"code","value":"async function SlowMetric({ label, delay }: { label: string; delay: number }) {\n  await new Promise((resolve) => setTimeout(resolve, delay))\n  const value = await db.metrics.get(label)\n\n  return (\n    <div className=\"metric\">\n      <span>{label}</span>\n      <span>{value.toLocaleString()}</span>\n    </div>\n  )\n}\n\nconst getAnalyticsDashboard = createServerFn().handler(() =>\n  renderServerComponent(\n    <div className=\"dashboard\">\n      <h1>Analytics</h1>\n\n      <div className=\"metrics-grid\">\n        <Suspense fallback={<MetricSkeleton label=\"Active Users\" />}>\n          <SlowMetric label=\"Active Users\" delay={500} />\n        </Suspense>\n\n        <Suspense fallback={<MetricSkeleton label=\"Revenue\" />}>\n          <SlowMetric label=\"Revenue\" delay={1500} />\n        </Suspense>\n\n        <Suspense fallback={<MetricSkeleton label=\"Conversion\" />}>\n          <SlowMetric label=\"Conversion\" delay={2500} />\n        </Suspense>\n      </div>\n    </div>,\n  ),\n)","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Each metric streams independently. The dashboard shell appears immediately, then metrics pop in as their data loads."}]},{"type":"heading","depth":3,"id":"streaming-with-async-generators","children":[{"type":"text","value":"Streaming with Async Generators"}]},{"type":"paragraph","children":[{"type":"text","value":"Use async generators to stream server components one at a time. The client receives and renders each component as it's yielded."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"When to use:"}]},{"type":"text","value":" Unbounded or large result sets where items should render incrementally. Useful when processing time per item varies or total count is unknown upfront."}]},{"type":"code","value":"import {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst streamNotifications = createServerFn().handler(async function* () {\n  // Yield initial batch immediately\n  const recent = await db.notifications.getRecent(3)\n  for (const notification of recent) {\n    yield await createCompositeComponent<{\n      renderActions?: (data: { id: string }) => React.ReactNode\n    }>((props) => (\n      <div className=\"notification\">\n        <h3>{notification.title}</h3>\n        <p>{notification.message}</p>\n        {props.renderActions?.({ id: notification.id })}\n      </div>\n    ))\n  }\n\n  // Stream older notifications with delays\n  const older = await db.notifications.getOlder(5)\n  for (const notification of older) {\n    await new Promise((resolve) => setTimeout(resolve, 300))\n    yield await createCompositeComponent<{\n      renderActions?: (data: { id: string }) => React.ReactNode\n    }>((props) => (\n      <div className=\"notification\">\n        <h3>{notification.title}</h3>\n        <p>{notification.message}</p>\n        {props.renderActions?.({ id: notification.id })}\n      </div>\n    ))\n  }\n})\n\nexport const Route = createFileRoute('/notifications')({\n  component: NotificationsPage,\n})\n\nfunction NotificationsPage() {\n  const [notifications, setNotifications] = React.useState<Array<unknown>>([])\n  const [isStreaming, setIsStreaming] = React.useState(false)\n\n  const startStreaming = React.useCallback(async () => {\n    setNotifications([])\n    setIsStreaming(true)\n\n    const stream = await streamNotifications()\n    for await (const notification of stream) {\n      setNotifications((prev) => [...prev, notification])\n    }\n\n    setIsStreaming(false)\n  }, [])\n\n  return (\n    <div>\n      <button onClick={startStreaming} disabled={isStreaming}>\n        {isStreaming ? 'Streaming...' : 'Load Notifications'}\n      </button>\n\n      {notifications.map((notificationSrc, i) => (\n        <CompositeComponent\n          key={i}\n          src={notificationSrc}\n          renderActions={({ id }) => (\n            <button onClick={() => markAsRead(id)}>Mark read</button>\n          )}\n        />\n      ))}\n    </div>\n  )\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Notifications appear one by one. The first three show immediately, then more stream in. Each supports client interactivity through render props."}]},{"type":"heading","depth":2,"id":"error-handling","children":[{"type":"text","value":"Error Handling"}]},{"type":"paragraph","children":[{"type":"text","value":"Errors in Server Components—whether during data fetching or rendering—propagate to the client."}]},{"type":"heading","depth":3,"id":"route-level-errors","children":[{"type":"text","value":"Route Level Errors"}]},{"type":"paragraph","children":[{"type":"text","value":"If a Server Component fails to load in the "},{"type":"inlineCode","value":"loader"},{"type":"text","value":", the route's "},{"type":"inlineCode","value":"errorComponent"},{"type":"text","value":" renders:"}]},{"type":"code","value":"export const Route = createFileRoute('/')({\n  loader: async () => ({\n    // If this fails, the errorComponent renders\n    Greeting: await getGreeting(),\n  }),\n  errorComponent: ({ error }) => <div>Failed to load: {error.message}</div>,\n  component: HomePage,\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"component-level-errors","children":[{"type":"text","value":"Component Level Errors"}]},{"type":"paragraph","children":[{"type":"text","value":"To isolate errors (e.g., preventing a single failing widget from crashing the page), you must use "},{"type":"strong","children":[{"type":"link","href":"#deferred-component-loading","children":[{"type":"text","value":"Deferred Loading"}]}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"By returning a Promise from the loader instead of awaiting it, the Route Component renders immediately. If the Promise later rejects, the "},{"type":"inlineCode","value":"ErrorBoundary"},{"type":"text","value":" inside your component catches it."}]},{"type":"code","value":"// 1. Loader returns a Promise (don't await!)\nexport const Route = createFileRoute('/dashboard')({\n  loader: () => ({\n    // If this fails, only the specific ErrorBoundary below catches it\n    WidgetPromise: getWidget(),\n  }),\n  component: DashboardPage,\n})\n\n// 2. Component handles the potential failure\nfunction DashboardPage() {\n  const { WidgetPromise } = Route.useLoaderData()\n\n  return (\n    <ErrorBoundary fallback={<div>Widget unavailable</div>}>\n      <React.Suspense fallback={<Skeleton />}>\n        <Deferred promise={WidgetPromise} />\n      </React.Suspense>\n    </ErrorBoundary>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"tips","children":[{"type":"text","value":"Tips"}]},{"type":"heading","depth":3,"id":"using-react-cache","children":[{"type":"text","value":"Using "},{"type":"inlineCode","value":"React.cache"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"React.cache"},{"type":"text","value":" works inside server components for request-scoped memoization. This is useful when multiple components need the same expensive computation:"}]},{"type":"code","value":"import { cache } from 'react'\n\nconst getUser = cache(async (userId: string) => {\n  return db.users.findById(userId)\n})\n\n// Both components share the same cached result within a single request\nasync function UserHeader() {\n  const user = await getUser('123') // Fetches from DB\n  return <h1>{user.name}</h1>\n}\n\nasync function UserSidebar() {\n  const user = await getUser('123') // Returns cached result\n  return <aside>{user.bio}</aside>\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"router-links-in-server-components","children":[{"type":"text","value":"Router Links in Server Components"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Router's "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" component works inside server components. The link is serialized and hydrates on the client for client-side navigation:"}]},{"type":"code","value":"import { Link } from '@tanstack/react-router'\n\nconst getNavigation = createServerFn().handler(async () => {\n  const pages = await db.pages.list()\n\n  return renderServerComponent(\n    <nav>\n      {pages.map((page) => (\n        <Link key={page.id} to=\"/pages/$pageId\" params={{ pageId: page.id }}>\n          {page.title}\n        </Link>\n      ))}\n    </nav>,\n  )\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"css-in-server-components","children":[{"type":"text","value":"CSS in Server Components"}]},{"type":"paragraph","children":[{"type":"text","value":"CSS Modules and global CSS imports work in server components. Styles are extracted and sent to the client:"}]},{"type":"code","value":"import styles from './Card.module.css'\n\nconst getCard = createServerFn().handler(async () => {\n  return renderServerComponent(\n    <div className={styles.card}>\n      <h2 className={styles.title}>Server Rendered</h2>\n    </div>,\n  )\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"rules-and-limitations","children":[{"type":"text","value":"Rules and Limitations"}]},{"type":"heading","depth":3,"id":"slots-are-opaque-on-the-server","children":[{"type":"text","value":"Slots are opaque on the server"}]},{"type":"paragraph","children":[{"type":"text","value":"The server cannot inspect slot content. "},{"type":"inlineCode","value":"React.Children.map()"},{"type":"text","value":" and "},{"type":"inlineCode","value":"cloneElement()"},{"type":"text","value":" won't work on "},{"type":"inlineCode","value":"props.children"},{"type":"text","value":":"}]},{"type":"code","value":"// Won't work - children is a placeholder on the server\ncreateCompositeComponent((props: { children?: React.ReactNode }) => (\n  <div>\n    {React.Children.map(props.children, (child) =>\n      React.cloneElement(child, { extra: 'prop' }),\n    )}\n  </div>\n))\n\n// Do this instead - use render props\ncreateCompositeComponent<{\n  renderItem?: (data: { extra: string }) => React.ReactNode\n}>((props) => <div>{props.renderItem?.({ extra: 'prop' })}</div>)","lang":"tsx"},{"type":"heading","depth":3,"id":"render-prop-arguments-must-be-serializable","children":[{"type":"text","value":"Render prop arguments must be serializable"}]},{"type":"paragraph","children":[{"type":"text","value":"Arguments passed to slots via render props and or components travel through React's Flight protocol. Use serializable values only: strings, numbers, booleans, null, plain objects, and arrays."}]},{"type":"heading","depth":2,"id":"how-it-works","children":[{"type":"text","value":"How It Works"}]},{"type":"paragraph","children":[{"type":"text","value":"When a server component accesses slot props, it accesses a proxy:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Reading "},{"type":"inlineCode","value":"props.children"},{"type":"text","value":" creates a placeholder for \"whatever children the caller provides\""}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Calling "},{"type":"inlineCode","value":"props.renderFn(args)"},{"type":"text","value":" creates a placeholder that records "},{"type":"inlineCode","value":"args"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Start sends a React Flight stream with these placeholders. On the client, placeholders are replaced with the actual props you passed when rendering."}]},{"type":"heading","depth":2,"id":"current-status","children":[{"type":"text","value":"Current Status"}]},{"type":"paragraph","children":[{"type":"text","value":"Server Components are experimental in TanStack Start and will remain so into early v1."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Serialization:"}]},{"type":"text","value":" Uses React's native Flight protocol. TanStack Start's custom serialization isn't available in server components yet. Primitives, Dates, and React elements work. Custom serialization coming in a future release."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"API:"}]},{"type":"text","value":" The RSC helper APIs may see refinements."}]},{"type":"paragraph","children":[{"type":"text","value":"Questions? "},{"type":"link","href":"https://github.com/tanstack/router/issues","children":[{"type":"text","value":"Open an issue"}]},{"type":"text","value":" or join the "},{"type":"link","href":"https://tlinz.com/discord","children":[{"type":"text","value":"Discord"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"low-level-flight-stream-apis","children":[{"type":"text","value":"Low-Level Flight Stream APIs"}]},{"type":"paragraph","children":[{"type":"text","value":"For advanced use cases (custom streaming protocols, API route integration, external RSC-aware systems), TanStack Start exposes low-level Flight stream APIs. For most cases, prefer the high-level helpers which handle caching, streaming, and (for composites) slots automatically."}]},{"type":"paragraph","children":[{"type":"text","value":"Import from "},{"type":"inlineCode","value":"@tanstack/react-start/rsc"},{"type":"text","value":":"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Function"}]},{"type":"tableCell","children":[{"type":"text","value":"Available in"}]},{"type":"tableCell","children":[{"type":"text","value":"Description"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"renderToReadableStream"}]},{"type":"tableCell","children":[{"type":"text","value":"server functions only"}]},{"type":"tableCell","children":[{"type":"text","value":"Renders React elements to a Flight stream"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"createFromFetch"}]},{"type":"tableCell","children":[{"type":"text","value":"Client"}]},{"type":"tableCell","children":[{"type":"text","value":"Decodes a Flight stream from a "},{"type":"inlineCode","value":"Promise<Response>"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"createFromReadableStream"}]},{"type":"tableCell","children":[{"type":"text","value":"Client/SSR"}]},{"type":"tableCell","children":[{"type":"text","value":"Decodes a Flight stream from a "},{"type":"inlineCode","value":"ReadableStream"}]}]]},{"type":"paragraph","children":[{"type":"inlineCode","value":"createFromFetch"},{"type":"text","value":" is a convenience wrapper around "},{"type":"inlineCode","value":"createFromReadableStream"},{"type":"text","value":" that accepts a fetch promise directly and extracts the body stream internally."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// src/routes/api/rsc.ts - API route with Flight stream\nimport { createAPIFileRoute } from '@tanstack/react-start/api'\nimport { createServerFn } from '@tanstack/react-start'\nimport { renderToReadableStream } from '@tanstack/react-start/rsc'\n\nconst getFlightStream = createServerFn({ method: 'GET' }).handler(async () => {\n  return renderToReadableStream(<div>Server Rendered Content</div>)\n})\n\nexport const APIRoute = createAPIFileRoute('/api/rsc')({\n  GET: async () => {\n    const stream = await getFlightStream()\n    return new Response(stream, {\n      headers: { 'Content-Type': 'text/x-component' },\n    })\n  },\n})","lang":"tsx"},{"type":"code","value":"// Client: fetch and decode the Flight stream\nimport { createFromFetch } from '@tanstack/react-start/rsc'\n\nasync function fetchRSC() {\n  return createFromFetch(fetch('/api/rsc'))\n}","lang":"tsx"}],"headings":[{"id":"setup","text":"Setup","level":2},{"id":"1-install-build-tool-specific-rsc-dependencies","text":"1. Install Build Tool-Specific RSC Dependencies","level":3},{"id":"2-configure-your-build-tool","text":"2. Configure Your Build Tool","level":3},{"id":"quick-start","text":"Quick Start","level":2},{"id":"renderable-no-slots","text":"Renderable (no slots)","level":3},{"id":"composite-slots","text":"Composite (slots)","level":3},{"id":"why-server-components","text":"Why Server Components?","level":2},{"id":"passing-props-and-composition","text":"Passing Props and Composition","level":2},{"id":"children-slots","text":"Children Slots","level":3},{"id":"render-props","text":"Render Props","level":3},{"id":"component-props","text":"Component Props","level":3},{"id":"caching","text":"Caching","level":2},{"id":"tanstack-query","text":"TanStack Query","level":3},{"id":"invalidation","text":"Invalidation","level":3},{"id":"combining-with-selective-ssr","text":"Combining with Selective SSR","level":2},{"id":"example-ssr-data-only","text":"Example: ssr: 'data-only'","level":3},{"id":"example-ssr-false","text":"Example: ssr: false","level":3},{"id":"advanced-patterns","text":"Advanced Patterns","level":2},{"id":"multiple-server-components-in-parallel","text":"Multiple Server Components in Parallel","level":3},{"id":"bundling-multiple-components","text":"Bundling Multiple Components","level":3},{"id":"using-promise-all","text":"Using Promise.all","level":4},{"id":"using-nested-structures","text":"Using Nested Structures","level":4},{"id":"deferred-component-loading","text":"Deferred Component Loading","level":3},{"id":"suspense-inside-server-components","text":"Suspense Inside Server Components","level":3},{"id":"streaming-with-async-generators","text":"Streaming with Async Generators","level":3},{"id":"error-handling","text":"Error Handling","level":2},{"id":"route-level-errors","text":"Route Level Errors","level":3},{"id":"component-level-errors","text":"Component Level Errors","level":3},{"id":"tips","text":"Tips","level":2},{"id":"using-react-cache","text":"Using React.cache","level":3},{"id":"router-links-in-server-components","text":"Router Links in Server Components","level":3},{"id":"css-in-server-components","text":"CSS in Server Components","level":3},{"id":"rules-and-limitations","text":"Rules and Limitations","level":2},{"id":"slots-are-opaque-on-the-server","text":"Slots are opaque on the server","level":3},{"id":"render-prop-arguments-must-be-serializable","text":"Render prop arguments must be serializable","level":3},{"id":"how-it-works","text":"How It Works","level":2},{"id":"current-status","text":"Current Status","level":2},{"id":"low-level-flight-stream-apis","text":"Low-Level Flight Stream APIs","level":2},{"id":"example","text":"Example","level":3}]},"frameworks":[],"downloadMarkdown":"\n> [!WARNING]\n> Server Components are experimental! The API may see refinements.\n\nServer Components let you render React components on the server and stream them to the client. Heavy dependencies stay out of your bundle, data fetching lives in the component, and sensitive logic never reaches the browser.\n\n## Setup\n\n**Server Components are not enabled by default.** Complete these three steps first:\n\n### 1. Install Build Tool-Specific RSC Dependencies\n\n<!-- ::start:tabs variant=\"bundler\" -->\n\n# Vite\n\n```bash\nnpm install -D @vitejs/plugin-rsc\n# or\npnpm add -D @vitejs/plugin-rsc\n# or\nyarn add -D @vitejs/plugin-rsc\n# or\nbun add -D @vitejs/plugin-rsc\n```\n\n# Rsbuild\n\nRsbuild does not need a separate RSC plugin. Make sure your Rsbuild React dependencies are installed:\n\n```bash\nnpm install -D @rsbuild/core @rsbuild/plugin-react\n```\n\n<!-- ::end:tabs -->\n\n### 2. Configure Your Build Tool\n\nUpdate your build tool config to enable RSC in the TanStack Start plugin:\n\n<!-- ::start:tabs variant=\"bundler\" -->\n\n# Vite\n\n```ts title=\"vite.config.ts\"\nimport { defineConfig } from 'vite'\nimport { tanstackStart } from '@tanstack/react-start/plugin/vite'\nimport viteReact from '@vitejs/plugin-react'\nimport rsc from '@vitejs/plugin-rsc'\n\nexport default defineConfig({\n  plugins: [\n    tanstackStart({\n      rsc: {\n        enabled: true,\n      },\n    }),\n    rsc(),\n    viteReact(),\n  ],\n})\n```\n\n# Rsbuild\n\n```ts title=\"rsbuild.config.ts\"\nimport { defineConfig } from '@rsbuild/core'\nimport { pluginReact } from '@rsbuild/plugin-react'\nimport { tanstackStart } from '@tanstack/react-start/plugin/rsbuild'\n\nexport default defineConfig({\n  plugins: [\n    pluginReact(),\n    tanstackStart({\n      rsc: {\n        enabled: true,\n      },\n    }),\n  ],\n})\n```\n\n<!-- ::end:tabs -->\n\n**Requirements:** React 19+, Vite 7+ or Rsbuild 2+\n\n## Quick Start\n\nIn TanStack Start, you typically create server-rendered UI in a server function, then return it through a route `loader`.\n\nThere are two high-level RSC helpers:\n\n- `renderServerComponent(<Element />)` returns a **renderable value** you can inline like `{Renderable}`.\n- `createCompositeComponent((props) => <Element />)` returns a **composite source** rendered via `<CompositeComponent src={...} />` (supports slots).\n\n### Renderable (no slots)\n\n```tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { createServerFn } from '@tanstack/react-start'\nimport { renderServerComponent } from '@tanstack/react-start/rsc'\n\nfunction Greeting() {\n  return <h1>Hello from RSC</h1>\n}\n\nconst getGreeting = createServerFn().handler(async () => {\n  const Renderable = await renderServerComponent(<Greeting />)\n  return { Renderable }\n})\n\nexport const Route = createFileRoute('/')({\n  loader: async () => {\n    const { Renderable } = await getGreeting()\n    return { Greeting: Renderable }\n  },\n  component: HomePage,\n})\n\nfunction HomePage() {\n  const { Greeting } = Route.useLoaderData()\n  return <>{Greeting}</>\n}\n```\n\n### Composite (slots)\n\n```tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { createServerFn } from '@tanstack/react-start'\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getCard = createServerFn().handler(async () => {\n  const src = await createCompositeComponent(\n    (props: { children?: React.ReactNode }) => (\n      <div className=\"card\">\n        <h2>Server-rendered header</h2>\n        <div>{props.children}</div>\n      </div>\n    ),\n  )\n\n  return { src }\n})\n\nexport const Route = createFileRoute('/')({\n  loader: async () => ({\n    Card: await getCard(),\n  }),\n  component: HomePage,\n})\n\nfunction HomePage() {\n  const { Card } = Route.useLoaderData()\n\n  return (\n    <CompositeComponent src={Card.src}>\n      <Counter />\n    </CompositeComponent>\n  )\n}\n```\n\n## Why Server Components?\n\n- **Smaller bundles.** Markdown parsers, syntax highlighters, and heavy libraries run on the server. Only rendered HTML reaches the client.\n- **Colocated data fetching.** Fetch data directly in the component that needs it.\n- **Secure by default.** API keys, database queries, and business logic never appear in the client bundle.\n- **Progressive streaming.** UI streams to the browser as it renders. Users see content immediately.\n\n## Passing Props and Composition\n\nRenderable values returned from `renderServerComponent` do not support slots.\n\nTo accept client-provided props (\"slots\"), use `createCompositeComponent` and render it with `<CompositeComponent src={...} />`.\n\nSlots are declared on the server component props. There are three types of slots:\n\n| Slot Type       | Use Case                                          | Server Can Pass Data? |\n| --------------- | ------------------------------------------------- | --------------------- |\n| `children`      | Simple composition                                | No                    |\n| Render props    | Server passes data to client-rendered content     | Yes                   |\n| Component props | Pass reusable components that receive server data | Yes                   |\n\n### Children Slots\n\nPass client components as children. Simple and familiar, but the server cannot pass data to them:\n\n```tsx\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getCard = createServerFn().handler(async () => {\n  const src = await createCompositeComponent(\n    (props: { children?: React.ReactNode }) => (\n      <div className=\"card\">\n        <h2>Server-rendered header</h2>\n        <div>{props.children}</div>\n      </div>\n    ),\n  )\n\n  return { src }\n})\n\nfunction MyPage() {\n  const { src } = Route.useLoaderData()\n\n  return (\n    <CompositeComponent src={src}>\n      {/* Client components with full interactivity */}\n      <Counter />\n      <button onClick={() => alert('Clicked!')}>Click me</button>\n    </CompositeComponent>\n  )\n}\n```\n\n### Render Props\n\nUse render props when the server needs to pass data to client-rendered content:\n\n```tsx\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getPost = createServerFn()\n  .validator(z.object({ postId: z.string() }))\n  .handler(async ({ data }) => {\n    const post = await db.posts.findById(data.postId)\n\n    const src = await createCompositeComponent(\n      (props: {\n        children?: React.ReactNode\n        renderActions?: (data: {\n          postId: string\n          authorId: string\n        }) => React.ReactNode\n      }) => (\n        <article>\n          <h1>{post.title}</h1>\n          <p>{post.body}</p>\n          <footer>\n            {props.renderActions?.({\n              postId: post.id,\n              authorId: post.authorId,\n            })}\n          </footer>\n          {props.children}\n        </article>\n      ),\n    )\n\n    return { src }\n  })\n\nfunction PostPage() {\n  const { src } = Route.useLoaderData()\n\n  return (\n    <CompositeComponent\n      src={src}\n      renderActions={({ postId, authorId }) => (\n        <PostActions postId={postId} authorId={authorId} />\n      )}\n    >\n      <Comments />\n    </CompositeComponent>\n  )\n}\n```\n\n### Component Props\n\nPass React components as props. On the client, the passed in props will be rendered with data supplied by the server:\n\n```tsx\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getProductCard = createServerFn()\n  .validator(z.object({ productId: z.string() }))\n  .handler(async ({ data }) => {\n    const product = await db.products.findById(data.productId)\n\n    const src = await createCompositeComponent(\n      ({\n        AddToCart,\n      }: {\n        AddToCart: React.ComponentType<{ productId: string; price: number }>\n      }) => (\n        <div className=\"product-card\">\n          <h2>{product.name}</h2>\n          <p>${product.price}</p>\n          <AddToCart productId={product.id} price={product.price} />\n        </div>\n      ),\n    )\n\n    return { src }\n  })\n\n// Client component with interactivity\nfunction AddToCartButton({\n  productId,\n  price,\n}: {\n  productId: string\n  price: number\n}) {\n  const [added, setAdded] = React.useState(false)\n\n  return (\n    <button onClick={() => setAdded(true)}>\n      {added ? '✓ Added!' : `Add to Cart - $${price}`}\n    </button>\n  )\n}\n\nfunction ProductPage() {\n  const { src } = Route.useLoaderData()\n\n  return <CompositeComponent src={src} AddToCart={AddToCartButton} />\n}\n```\n\nComponent props are useful when:\n\n- You want to pass reusable client components\n- The component needs its own state or event handlers\n- You prefer component composition over render prop callbacks\n\nAll three slot types can be combined. `createCompositeComponent` provides full type safety for slot props.\n\n## Caching\n\nServer components work with TanStack Router's built-in caching. The cache key is the route path plus params:\n\n```tsx\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ params }) => ({\n    Post: await getPost({ data: { postId: params.postId } }),\n  }),\n  component: PostPage,\n})\n```\n\nNavigate to `/posts/abc`, then `/posts/xyz`, then back to `/posts/abc` - the cached component renders instantly.\n\nControl freshness with `staleTime`:\n\n```tsx\nexport const Route = createFileRoute('/posts/$postId')({\n  staleTime: 10_000, // Fresh for 10 seconds\n  loader: async ({ params }) => ({\n    Post: await getPost({ data: { postId: params.postId } }),\n  }),\n  component: PostPage,\n})\n```\n\nFor cache keys beyond route params, use `loaderDeps`:\n\n```tsx\nexport const Route = createFileRoute('/posts/$postId')({\n  loaderDeps: ({ search }) => ({ tab: search.tab }),\n  loader: async ({ params, deps }) => ({\n    Post: await getPost({ data: { postId: params.postId, tab: deps.tab } }),\n  }),\n  component: PostPage,\n})\n```\n\n### TanStack Query\n\nFor fine-grained control, use TanStack Query:\n\n```tsx\nimport { useSuspenseQuery, useQueryClient } from '@tanstack/react-query'\n\nconst postQueryOptions = (postId: string) => ({\n  queryKey: ['post', postId],\n  structuralSharing: false, // Required - RSC values must not be merged\n  queryFn: () => getPost({ data: { postId } }),\n  staleTime: 5 * 60 * 1000,\n})\n\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ context, params }) => {\n    // Prefetch during SSR - data reused on client without refetch\n    await context.queryClient.query({\n      ...postQueryOptions(params.postId),\n      staleTime: 'static',\n    })\n  },\n  component: PostPage,\n})\n\nfunction PostPage() {\n  const { postId } = Route.useParams()\n  const queryClient = useQueryClient()\n\n  const { data } = useSuspenseQuery(postQueryOptions(postId))\n\n  const handleRefresh = () => {\n    // Manually refetch the RSC\n    queryClient.refetchQueries({ queryKey: ['post', postId] })\n  }\n\n  return <CompositeComponent src={data.src} />\n}\n```\n\n> [!IMPORTANT]\n> Always set `structuralSharing: false` when caching server components with React Query. Without this, React Query may attempt to merge RSC values between fetches, which can cause errors.\n\n### Invalidation\n\nTo refetch a server component after data changes, use `router.invalidate()`:\n\n```tsx\nimport { useRouter } from '@tanstack/react-router'\n\nfunction PostPage() {\n  const router = useRouter()\n  const { Post } = Route.useLoaderData()\n\n  const handleUpdate = async () => {\n    await updatePost({ data: { ... } })\n    // Refetch the route's loader, including the RSC\n    router.invalidate()\n  }\n\n  return (\n    <CompositeComponent\n      src={Post.src}\n      renderActions={() => (\n        <button onClick={handleUpdate}>Update Post</button>\n      )}\n    />\n  )\n}\n```\n\nThis pattern is useful when server functions mutate data that the RSC displays. After the mutation completes, `router.invalidate()` triggers the loader to run again, fetching a fresh server component with updated data.\n\n## Combining with Selective SSR\n\nServer Components pair with [Selective SSR](./selective-ssr.md) when you need server-rendered content but client-only rendering for the route component itself.\n\n### Example: `ssr: 'data-only'`\n\nThe server fetches the RSC, but the route component renders on the client:\n\n```tsx\nexport const Route = createFileRoute('/dashboard')({\n  ssr: 'data-only',\n  loader: async () => ({\n    Dashboard: await getDashboard(),\n  }),\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  const { Dashboard } = Route.useLoaderData()\n  const [width, setWidth] = React.useState(0)\n\n  React.useEffect(() => {\n    setWidth(window.innerWidth) // Browser API\n  }, [])\n\n  return (\n    <Dashboard\n      renderChart={({ data }) => <ResponsiveChart data={data} width={width} />}\n    />\n  )\n}\n```\n\nThis is useful when:\n\n- The server component fetches data and renders static content\n- The route component needs `window`, `localStorage`, or other browser APIs\n- You want the server component data ready before the client renders\n\n### Example: `ssr: false`\n\nBoth loader and component run on the client:\n\n```tsx\nexport const Route = createFileRoute('/canvas')({\n  ssr: false,\n  loader: async () => {\n    const savedState = localStorage.getItem('canvas-state')\n    return { Tools: await getDrawingTools({ data: { savedState } }) }\n  },\n  component: CanvasPage,\n})\n```\n\nUse this when the loader itself requires browser APIs.\n\n## Advanced Patterns\n\n### Multiple Server Components in Parallel\n\nWhen a page needs several independent server components, fetch them in parallel using `Promise.all`. Each component renders independently with its own data.\n\n**When to use:** Components from separate data sources with no shared dependencies. Maximizes concurrency when each component has independent fetch logic.\n\n```tsx\nconst getArticleA = createServerFn().handler(async () => {\n  const article = await db.articles.findById('a')\n  return renderServerComponent(<Article data={article} />)\n})\n\nconst getArticleB = createServerFn().handler(async () => {\n  const article = await db.articles.findById('b')\n  return renderServerComponent(<Article data={article} />)\n})\n\nconst getSidebar = createServerFn().handler(async () => {\n  const trending = await db.articles.getTrending()\n  return renderServerComponent(<Sidebar items={trending} />)\n})\n\nexport const Route = createFileRoute('/news')({\n  loader: async () => {\n    const [ArticleA, ArticleB, Sidebar] = await Promise.all([\n      getArticleA(),\n      getArticleB(),\n      getSidebar(),\n    ])\n    return { ArticleA, ArticleB, Sidebar }\n  },\n  component: NewsPage,\n})\n\nfunction NewsPage() {\n  const { ArticleA, ArticleB, Sidebar } = Route.useLoaderData()\n\n  return (\n    <div className=\"grid\">\n      <main>\n        {ArticleA}\n        {ArticleB}\n      </main>\n      <aside>{Sidebar}</aside>\n    </div>\n  )\n}\n```\n\nEach server function executes concurrently. The page renders when all complete.\n\n### Bundling Multiple Components\n\nReturn multiple server components from a single server function when they share data or should be fetched together. This reduces network round trips.\n\n**When to use:** Components that share fetched data, need a single cache key, or should invalidate together. Reduces database queries and network round trips.\n\n#### Using Promise.all\n\nCreate multiple `renderServerComponent` or `createCompositeComponent` calls and return them as an object:\n\n```tsx\nconst getPageLayout = createServerFn().handler(async () => {\n  // Fetch shared data once\n  const user = await db.users.getCurrent()\n  const config = await db.config.get()\n\n  // Create multiple components that share this data\n  const [Header, Content, Footer] = await Promise.all([\n    renderServerComponent(\n      <header>\n        <Logo />\n        <nav>\n          {config.navItems.map((item) => (\n            <NavLink key={item.id} {...item} />\n          ))}\n        </nav>\n        <UserMenu name={user.name} />\n      </header>,\n    ),\n    renderServerComponent(\n      <main>\n        <h1>Welcome, {user.name}</h1>\n        <Dashboard stats={user.stats} />\n      </main>,\n    ),\n    renderServerComponent(\n      <footer>\n        <span>{config.copyright}</span>\n        {config.footerLinks.map((link) => (\n          <a key={link.id} href={link.url}>\n            {link.label}\n          </a>\n        ))}\n      </footer>,\n    ),\n  ])\n\n  return { Header, Content, Footer }\n})\n\nexport const Route = createFileRoute('/dashboard')({\n  loader: async () => await getPageLayout(),\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  const { Header, Content, Footer } = Route.useLoaderData()\n\n  return (\n    <>\n      {Header}\n      {Content}\n      {Footer}\n    </>\n  )\n}\n```\n\n#### Using Nested Structures\n\nAlternatively, return a nested object structure from a single server function.\n\n- Use `renderServerComponent` when you just need renderables (no slots).\n- Use `createCompositeComponent` when you want each part to accept slots.\n\n```tsx\nconst getPageLayout = createServerFn().handler(async () => {\n  const user = await db.users.getCurrent()\n  const config = await db.config.get()\n\n  const [Header, Content, Footer] = await Promise.all([\n    createCompositeComponent((props: { children?: React.ReactNode }) => (\n      <header>\n        <Logo />\n        <nav>\n          {config.navItems.map((item) => (\n            <NavLink key={item.id} {...item} />\n          ))}\n        </nav>\n        <UserMenu name={user.name} />\n        {props.children}\n      </header>\n    )),\n    createCompositeComponent(\n      (props: { renderActions?: () => React.ReactNode }) => (\n        <main>\n          <h1>Welcome, {user.name}</h1>\n          <Dashboard stats={user.stats} />\n          {props.renderActions?.()}\n        </main>\n      ),\n    ),\n    createCompositeComponent(() => (\n      <footer>\n        <span>{config.copyright}</span>\n        {config.footerLinks.map((link) => (\n          <a key={link.id} href={link.url}>\n            {link.label}\n          </a>\n        ))}\n      </footer>\n    )),\n  ])\n\n  return { Header, Content, Footer }\n})\n\nexport const Route = createFileRoute('/dashboard')({\n  loader: async () => ({\n    Layout: await getPageLayout(),\n  }),\n  component: DashboardPage,\n})\n```\n\nRender nested composites using dot notation:\n\n```tsx\nimport { CompositeComponent } from '@tanstack/react-start/rsc'\n\nfunction DashboardPage() {\n  const { Layout } = Route.useLoaderData()\n\n  return (\n    <>\n      <CompositeComponent src={Layout.Header}>\n        <button onClick={() => setMenuOpen(true)}>Menu</button>\n      </CompositeComponent>\n      <CompositeComponent\n        src={Layout.Content}\n        renderActions={() => <ActionButtons />}\n      />\n      <CompositeComponent src={Layout.Footer} />\n    </>\n  )\n}\n```\n\nOr destructure them from the loader data:\n\n```tsx\nimport { CompositeComponent } from '@tanstack/react-start/rsc'\n\nfunction DashboardPage() {\n  const { Header, Content, Footer } = Route.useLoaderData().Layout\n\n  return (\n    <>\n      <CompositeComponent src={Header}>\n        <button onClick={() => setMenuOpen(true)}>Menu</button>\n      </CompositeComponent>\n      <CompositeComponent\n        src={Content}\n        renderActions={() => <ActionButtons />}\n      />\n      <CompositeComponent src={Footer} />\n    </>\n  )\n}\n```\n\nEach nested component receives its own slot props independently. The `children` passed to `<CompositeComponent src={Header}>` only affects that component, not the others.\n\nAll three components share the same user and config data from a single database query.\n\n### Deferred Component Loading\n\nReturn promises for server components instead of awaiting them. The client uses `React.use()` with `Suspense` to render each component as it resolves.\n\n**When to use:** Components with varying data latencies where faster results should render before slower ones complete. Avoids blocking on the slowest query.\n\n```tsx\nimport { Suspense, use } from 'react'\n\nconst getDashboardBundle = createServerFn().handler(() => ({\n  // Fast - resolves in ~100ms\n  QuickStats: (async () => {\n    const stats = await cache.getStats() // Fast cache hit\n    return renderServerComponent(<StatsCard data={stats} />)\n  })(),\n\n  // Medium - resolves in ~500ms\n  RecentActivity: (async () => {\n    const activity = await db.activity.getRecent()\n    return renderServerComponent(<ActivityFeed items={activity} />)\n  })(),\n\n  // Slow - resolves in ~2000ms\n  Analytics: (async () => {\n    const data = await analytics.computeMetrics() // Expensive query\n    return renderServerComponent(<AnalyticsChart data={data} />)\n  })(),\n}))\n\nexport const Route = createFileRoute('/dashboard')({\n  loader: () => getDashboardBundle(),\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  const { QuickStats, RecentActivity, Analytics } = Route.useLoaderData()\n\n  return (\n    <div>\n      <Suspense fallback={<Skeleton />}>\n        <Deferred promise={QuickStats} />\n      </Suspense>\n\n      <Suspense fallback={<Skeleton />}>\n        <Deferred promise={RecentActivity} />\n      </Suspense>\n\n      <Suspense fallback={<Skeleton />}>\n        <Deferred promise={Analytics} />\n      </Suspense>\n    </div>\n  )\n}\n\nfunction Deferred({ promise }: { promise: Promise<unknown> }) {\n  const Renderable = use(promise)\n  return <>{Renderable}</>\n}\n```\n\nQuickStats appears first, RecentActivity follows, then Analytics loads last. Users see progressive content instead of waiting for everything.\n\n### Suspense Inside Server Components\n\nUse React's `Suspense` directly inside server components to stream parts of the component as they become ready.\n\n**When to use:** A single server component with multiple async child components that should stream independently. Keeps related UI in one component while allowing progressive rendering.\n\n```tsx\nasync function SlowMetric({ label, delay }: { label: string; delay: number }) {\n  await new Promise((resolve) => setTimeout(resolve, delay))\n  const value = await db.metrics.get(label)\n\n  return (\n    <div className=\"metric\">\n      <span>{label}</span>\n      <span>{value.toLocaleString()}</span>\n    </div>\n  )\n}\n\nconst getAnalyticsDashboard = createServerFn().handler(() =>\n  renderServerComponent(\n    <div className=\"dashboard\">\n      <h1>Analytics</h1>\n\n      <div className=\"metrics-grid\">\n        <Suspense fallback={<MetricSkeleton label=\"Active Users\" />}>\n          <SlowMetric label=\"Active Users\" delay={500} />\n        </Suspense>\n\n        <Suspense fallback={<MetricSkeleton label=\"Revenue\" />}>\n          <SlowMetric label=\"Revenue\" delay={1500} />\n        </Suspense>\n\n        <Suspense fallback={<MetricSkeleton label=\"Conversion\" />}>\n          <SlowMetric label=\"Conversion\" delay={2500} />\n        </Suspense>\n      </div>\n    </div>,\n  ),\n)\n```\n\nEach metric streams independently. The dashboard shell appears immediately, then metrics pop in as their data loads.\n\n### Streaming with Async Generators\n\nUse async generators to stream server components one at a time. The client receives and renders each component as it's yielded.\n\n**When to use:** Unbounded or large result sets where items should render incrementally. Useful when processing time per item varies or total count is unknown upfront.\n\n```tsx\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst streamNotifications = createServerFn().handler(async function* () {\n  // Yield initial batch immediately\n  const recent = await db.notifications.getRecent(3)\n  for (const notification of recent) {\n    yield await createCompositeComponent<{\n      renderActions?: (data: { id: string }) => React.ReactNode\n    }>((props) => (\n      <div className=\"notification\">\n        <h3>{notification.title}</h3>\n        <p>{notification.message}</p>\n        {props.renderActions?.({ id: notification.id })}\n      </div>\n    ))\n  }\n\n  // Stream older notifications with delays\n  const older = await db.notifications.getOlder(5)\n  for (const notification of older) {\n    await new Promise((resolve) => setTimeout(resolve, 300))\n    yield await createCompositeComponent<{\n      renderActions?: (data: { id: string }) => React.ReactNode\n    }>((props) => (\n      <div className=\"notification\">\n        <h3>{notification.title}</h3>\n        <p>{notification.message}</p>\n        {props.renderActions?.({ id: notification.id })}\n      </div>\n    ))\n  }\n})\n\nexport const Route = createFileRoute('/notifications')({\n  component: NotificationsPage,\n})\n\nfunction NotificationsPage() {\n  const [notifications, setNotifications] = React.useState<Array<unknown>>([])\n  const [isStreaming, setIsStreaming] = React.useState(false)\n\n  const startStreaming = React.useCallback(async () => {\n    setNotifications([])\n    setIsStreaming(true)\n\n    const stream = await streamNotifications()\n    for await (const notification of stream) {\n      setNotifications((prev) => [...prev, notification])\n    }\n\n    setIsStreaming(false)\n  }, [])\n\n  return (\n    <div>\n      <button onClick={startStreaming} disabled={isStreaming}>\n        {isStreaming ? 'Streaming...' : 'Load Notifications'}\n      </button>\n\n      {notifications.map((notificationSrc, i) => (\n        <CompositeComponent\n          key={i}\n          src={notificationSrc}\n          renderActions={({ id }) => (\n            <button onClick={() => markAsRead(id)}>Mark read</button>\n          )}\n        />\n      ))}\n    </div>\n  )\n}\n```\n\nNotifications appear one by one. The first three show immediately, then more stream in. Each supports client interactivity through render props.\n\n## Error Handling\n\nErrors in Server Components—whether during data fetching or rendering—propagate to the client.\n\n### Route Level Errors\n\nIf a Server Component fails to load in the `loader`, the route's `errorComponent` renders:\n\n```tsx\nexport const Route = createFileRoute('/')({\n  loader: async () => ({\n    // If this fails, the errorComponent renders\n    Greeting: await getGreeting(),\n  }),\n  errorComponent: ({ error }) => <div>Failed to load: {error.message}</div>,\n  component: HomePage,\n})\n```\n\n### Component Level Errors\n\nTo isolate errors (e.g., preventing a single failing widget from crashing the page), you must use **[Deferred Loading](#deferred-component-loading)**.\n\nBy returning a Promise from the loader instead of awaiting it, the Route Component renders immediately. If the Promise later rejects, the `ErrorBoundary` inside your component catches it.\n\n```tsx\n// 1. Loader returns a Promise (don't await!)\nexport const Route = createFileRoute('/dashboard')({\n  loader: () => ({\n    // If this fails, only the specific ErrorBoundary below catches it\n    WidgetPromise: getWidget(),\n  }),\n  component: DashboardPage,\n})\n\n// 2. Component handles the potential failure\nfunction DashboardPage() {\n  const { WidgetPromise } = Route.useLoaderData()\n\n  return (\n    <ErrorBoundary fallback={<div>Widget unavailable</div>}>\n      <React.Suspense fallback={<Skeleton />}>\n        <Deferred promise={WidgetPromise} />\n      </React.Suspense>\n    </ErrorBoundary>\n  )\n}\n```\n\n## Tips\n\n### Using `React.cache`\n\n`React.cache` works inside server components for request-scoped memoization. This is useful when multiple components need the same expensive computation:\n\n```tsx\nimport { cache } from 'react'\n\nconst getUser = cache(async (userId: string) => {\n  return db.users.findById(userId)\n})\n\n// Both components share the same cached result within a single request\nasync function UserHeader() {\n  const user = await getUser('123') // Fetches from DB\n  return <h1>{user.name}</h1>\n}\n\nasync function UserSidebar() {\n  const user = await getUser('123') // Returns cached result\n  return <aside>{user.bio}</aside>\n}\n```\n\n### Router Links in Server Components\n\nTanStack Router's `Link` component works inside server components. The link is serialized and hydrates on the client for client-side navigation:\n\n```tsx\nimport { Link } from '@tanstack/react-router'\n\nconst getNavigation = createServerFn().handler(async () => {\n  const pages = await db.pages.list()\n\n  return renderServerComponent(\n    <nav>\n      {pages.map((page) => (\n        <Link key={page.id} to=\"/pages/$pageId\" params={{ pageId: page.id }}>\n          {page.title}\n        </Link>\n      ))}\n    </nav>,\n  )\n})\n```\n\n### CSS in Server Components\n\nCSS Modules and global CSS imports work in server components. Styles are extracted and sent to the client:\n\n```tsx\nimport styles from './Card.module.css'\n\nconst getCard = createServerFn().handler(async () => {\n  return renderServerComponent(\n    <div className={styles.card}>\n      <h2 className={styles.title}>Server Rendered</h2>\n    </div>,\n  )\n})\n```\n\n## Rules and Limitations\n\n### Slots are opaque on the server\n\nThe server cannot inspect slot content. `React.Children.map()` and `cloneElement()` won't work on `props.children`:\n\n```tsx\n// Won't work - children is a placeholder on the server\ncreateCompositeComponent((props: { children?: React.ReactNode }) => (\n  <div>\n    {React.Children.map(props.children, (child) =>\n      React.cloneElement(child, { extra: 'prop' }),\n    )}\n  </div>\n))\n\n// Do this instead - use render props\ncreateCompositeComponent<{\n  renderItem?: (data: { extra: string }) => React.ReactNode\n}>((props) => <div>{props.renderItem?.({ extra: 'prop' })}</div>)\n```\n\n### Render prop arguments must be serializable\n\nArguments passed to slots via render props and or components travel through React's Flight protocol. Use serializable values only: strings, numbers, booleans, null, plain objects, and arrays.\n\n## How It Works\n\nWhen a server component accesses slot props, it accesses a proxy:\n\n- Reading `props.children` creates a placeholder for \"whatever children the caller provides\"\n- Calling `props.renderFn(args)` creates a placeholder that records `args`\n\nTanStack Start sends a React Flight stream with these placeholders. On the client, placeholders are replaced with the actual props you passed when rendering.\n\n## Current Status\n\nServer Components are experimental in TanStack Start and will remain so into early v1.\n\n**Serialization:** Uses React's native Flight protocol. TanStack Start's custom serialization isn't available in server components yet. Primitives, Dates, and React elements work. Custom serialization coming in a future release.\n\n**API:** The RSC helper APIs may see refinements.\n\nQuestions? [Open an issue](https://github.com/tanstack/router/issues) or join the [Discord](https://tlinz.com/discord).\n\n## Low-Level Flight Stream APIs\n\nFor advanced use cases (custom streaming protocols, API route integration, external RSC-aware systems), TanStack Start exposes low-level Flight stream APIs. For most cases, prefer the high-level helpers which handle caching, streaming, and (for composites) slots automatically.\n\nImport from `@tanstack/react-start/rsc`:\n\n| Function                   | Available in          | Description                                        |\n| -------------------------- | --------------------- | -------------------------------------------------- |\n| `renderToReadableStream`   | server functions only | Renders React elements to a Flight stream          |\n| `createFromFetch`          | Client                | Decodes a Flight stream from a `Promise<Response>` |\n| `createFromReadableStream` | Client/SSR            | Decodes a Flight stream from a `ReadableStream`    |\n\n`createFromFetch` is a convenience wrapper around `createFromReadableStream` that accepts a fetch promise directly and extracts the body stream internally.\n\n### Example\n\n```tsx\n// src/routes/api/rsc.ts - API route with Flight stream\nimport { createAPIFileRoute } from '@tanstack/react-start/api'\nimport { createServerFn } from '@tanstack/react-start'\nimport { renderToReadableStream } from '@tanstack/react-start/rsc'\n\nconst getFlightStream = createServerFn({ method: 'GET' }).handler(async () => {\n  return renderToReadableStream(<div>Server Rendered Content</div>)\n})\n\nexport const APIRoute = createAPIFileRoute('/api/rsc')({\n  GET: async () => {\n    const stream = await getFlightStream()\n    return new Response(stream, {\n      headers: { 'Content-Type': 'text/x-component' },\n    })\n  },\n})\n```\n\n```tsx\n// Client: fetch and decode the Flight stream\nimport { createFromFetch } from '@tanstack/react-start/rsc'\n\nasync function fetchRSC() {\n  return createFromFetch(fetch('/api/rsc'))\n}\n```\n","originalRawMarkdown":"---\nid: server-components\ntitle: Server Components\n---\n\n> [!WARNING]\n> Server Components are experimental! The API may see refinements.\n\nServer Components let you render React components on the server and stream them to the client. Heavy dependencies stay out of your bundle, data fetching lives in the component, and sensitive logic never reaches the browser.\n\n## Setup\n\n**Server Components are not enabled by default.** Complete these three steps first:\n\n### 1. Install Build Tool-Specific RSC Dependencies\n\n<!-- ::start:tabs variant=\"bundler\" -->\n\n# Vite\n\n```bash\nnpm install -D @vitejs/plugin-rsc\n# or\npnpm add -D @vitejs/plugin-rsc\n# or\nyarn add -D @vitejs/plugin-rsc\n# or\nbun add -D @vitejs/plugin-rsc\n```\n\n# Rsbuild\n\nRsbuild does not need a separate RSC plugin. Make sure your Rsbuild React dependencies are installed:\n\n```bash\nnpm install -D @rsbuild/core @rsbuild/plugin-react\n```\n\n<!-- ::end:tabs -->\n\n### 2. Configure Your Build Tool\n\nUpdate your build tool config to enable RSC in the TanStack Start plugin:\n\n<!-- ::start:tabs variant=\"bundler\" -->\n\n# Vite\n\n```ts title=\"vite.config.ts\"\nimport { defineConfig } from 'vite'\nimport { tanstackStart } from '@tanstack/react-start/plugin/vite'\nimport viteReact from '@vitejs/plugin-react'\nimport rsc from '@vitejs/plugin-rsc'\n\nexport default defineConfig({\n  plugins: [\n    tanstackStart({\n      rsc: {\n        enabled: true,\n      },\n    }),\n    rsc(),\n    viteReact(),\n  ],\n})\n```\n\n# Rsbuild\n\n```ts title=\"rsbuild.config.ts\"\nimport { defineConfig } from '@rsbuild/core'\nimport { pluginReact } from '@rsbuild/plugin-react'\nimport { tanstackStart } from '@tanstack/react-start/plugin/rsbuild'\n\nexport default defineConfig({\n  plugins: [\n    pluginReact(),\n    tanstackStart({\n      rsc: {\n        enabled: true,\n      },\n    }),\n  ],\n})\n```\n\n<!-- ::end:tabs -->\n\n**Requirements:** React 19+, Vite 7+ or Rsbuild 2+\n\n## Quick Start\n\nIn TanStack Start, you typically create server-rendered UI in a server function, then return it through a route `loader`.\n\nThere are two high-level RSC helpers:\n\n- `renderServerComponent(<Element />)` returns a **renderable value** you can inline like `{Renderable}`.\n- `createCompositeComponent((props) => <Element />)` returns a **composite source** rendered via `<CompositeComponent src={...} />` (supports slots).\n\n### Renderable (no slots)\n\n```tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { createServerFn } from '@tanstack/react-start'\nimport { renderServerComponent } from '@tanstack/react-start/rsc'\n\nfunction Greeting() {\n  return <h1>Hello from RSC</h1>\n}\n\nconst getGreeting = createServerFn().handler(async () => {\n  const Renderable = await renderServerComponent(<Greeting />)\n  return { Renderable }\n})\n\nexport const Route = createFileRoute('/')({\n  loader: async () => {\n    const { Renderable } = await getGreeting()\n    return { Greeting: Renderable }\n  },\n  component: HomePage,\n})\n\nfunction HomePage() {\n  const { Greeting } = Route.useLoaderData()\n  return <>{Greeting}</>\n}\n```\n\n### Composite (slots)\n\n```tsx\nimport { createFileRoute } from '@tanstack/react-router'\nimport { createServerFn } from '@tanstack/react-start'\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getCard = createServerFn().handler(async () => {\n  const src = await createCompositeComponent(\n    (props: { children?: React.ReactNode }) => (\n      <div className=\"card\">\n        <h2>Server-rendered header</h2>\n        <div>{props.children}</div>\n      </div>\n    ),\n  )\n\n  return { src }\n})\n\nexport const Route = createFileRoute('/')({\n  loader: async () => ({\n    Card: await getCard(),\n  }),\n  component: HomePage,\n})\n\nfunction HomePage() {\n  const { Card } = Route.useLoaderData()\n\n  return (\n    <CompositeComponent src={Card.src}>\n      <Counter />\n    </CompositeComponent>\n  )\n}\n```\n\n## Why Server Components?\n\n- **Smaller bundles.** Markdown parsers, syntax highlighters, and heavy libraries run on the server. Only rendered HTML reaches the client.\n- **Colocated data fetching.** Fetch data directly in the component that needs it.\n- **Secure by default.** API keys, database queries, and business logic never appear in the client bundle.\n- **Progressive streaming.** UI streams to the browser as it renders. Users see content immediately.\n\n## Passing Props and Composition\n\nRenderable values returned from `renderServerComponent` do not support slots.\n\nTo accept client-provided props (\"slots\"), use `createCompositeComponent` and render it with `<CompositeComponent src={...} />`.\n\nSlots are declared on the server component props. There are three types of slots:\n\n| Slot Type       | Use Case                                          | Server Can Pass Data? |\n| --------------- | ------------------------------------------------- | --------------------- |\n| `children`      | Simple composition                                | No                    |\n| Render props    | Server passes data to client-rendered content     | Yes                   |\n| Component props | Pass reusable components that receive server data | Yes                   |\n\n### Children Slots\n\nPass client components as children. Simple and familiar, but the server cannot pass data to them:\n\n```tsx\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getCard = createServerFn().handler(async () => {\n  const src = await createCompositeComponent(\n    (props: { children?: React.ReactNode }) => (\n      <div className=\"card\">\n        <h2>Server-rendered header</h2>\n        <div>{props.children}</div>\n      </div>\n    ),\n  )\n\n  return { src }\n})\n\nfunction MyPage() {\n  const { src } = Route.useLoaderData()\n\n  return (\n    <CompositeComponent src={src}>\n      {/* Client components with full interactivity */}\n      <Counter />\n      <button onClick={() => alert('Clicked!')}>Click me</button>\n    </CompositeComponent>\n  )\n}\n```\n\n### Render Props\n\nUse render props when the server needs to pass data to client-rendered content:\n\n```tsx\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getPost = createServerFn()\n  .validator(z.object({ postId: z.string() }))\n  .handler(async ({ data }) => {\n    const post = await db.posts.findById(data.postId)\n\n    const src = await createCompositeComponent(\n      (props: {\n        children?: React.ReactNode\n        renderActions?: (data: {\n          postId: string\n          authorId: string\n        }) => React.ReactNode\n      }) => (\n        <article>\n          <h1>{post.title}</h1>\n          <p>{post.body}</p>\n          <footer>\n            {props.renderActions?.({\n              postId: post.id,\n              authorId: post.authorId,\n            })}\n          </footer>\n          {props.children}\n        </article>\n      ),\n    )\n\n    return { src }\n  })\n\nfunction PostPage() {\n  const { src } = Route.useLoaderData()\n\n  return (\n    <CompositeComponent\n      src={src}\n      renderActions={({ postId, authorId }) => (\n        <PostActions postId={postId} authorId={authorId} />\n      )}\n    >\n      <Comments />\n    </CompositeComponent>\n  )\n}\n```\n\n### Component Props\n\nPass React components as props. On the client, the passed in props will be rendered with data supplied by the server:\n\n```tsx\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst getProductCard = createServerFn()\n  .validator(z.object({ productId: z.string() }))\n  .handler(async ({ data }) => {\n    const product = await db.products.findById(data.productId)\n\n    const src = await createCompositeComponent(\n      ({\n        AddToCart,\n      }: {\n        AddToCart: React.ComponentType<{ productId: string; price: number }>\n      }) => (\n        <div className=\"product-card\">\n          <h2>{product.name}</h2>\n          <p>${product.price}</p>\n          <AddToCart productId={product.id} price={product.price} />\n        </div>\n      ),\n    )\n\n    return { src }\n  })\n\n// Client component with interactivity\nfunction AddToCartButton({\n  productId,\n  price,\n}: {\n  productId: string\n  price: number\n}) {\n  const [added, setAdded] = React.useState(false)\n\n  return (\n    <button onClick={() => setAdded(true)}>\n      {added ? '✓ Added!' : `Add to Cart - $${price}`}\n    </button>\n  )\n}\n\nfunction ProductPage() {\n  const { src } = Route.useLoaderData()\n\n  return <CompositeComponent src={src} AddToCart={AddToCartButton} />\n}\n```\n\nComponent props are useful when:\n\n- You want to pass reusable client components\n- The component needs its own state or event handlers\n- You prefer component composition over render prop callbacks\n\nAll three slot types can be combined. `createCompositeComponent` provides full type safety for slot props.\n\n## Caching\n\nServer components work with TanStack Router's built-in caching. The cache key is the route path plus params:\n\n```tsx\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ params }) => ({\n    Post: await getPost({ data: { postId: params.postId } }),\n  }),\n  component: PostPage,\n})\n```\n\nNavigate to `/posts/abc`, then `/posts/xyz`, then back to `/posts/abc` - the cached component renders instantly.\n\nControl freshness with `staleTime`:\n\n```tsx\nexport const Route = createFileRoute('/posts/$postId')({\n  staleTime: 10_000, // Fresh for 10 seconds\n  loader: async ({ params }) => ({\n    Post: await getPost({ data: { postId: params.postId } }),\n  }),\n  component: PostPage,\n})\n```\n\nFor cache keys beyond route params, use `loaderDeps`:\n\n```tsx\nexport const Route = createFileRoute('/posts/$postId')({\n  loaderDeps: ({ search }) => ({ tab: search.tab }),\n  loader: async ({ params, deps }) => ({\n    Post: await getPost({ data: { postId: params.postId, tab: deps.tab } }),\n  }),\n  component: PostPage,\n})\n```\n\n### TanStack Query\n\nFor fine-grained control, use TanStack Query:\n\n```tsx\nimport { useSuspenseQuery, useQueryClient } from '@tanstack/react-query'\n\nconst postQueryOptions = (postId: string) => ({\n  queryKey: ['post', postId],\n  structuralSharing: false, // Required - RSC values must not be merged\n  queryFn: () => getPost({ data: { postId } }),\n  staleTime: 5 * 60 * 1000,\n})\n\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ context, params }) => {\n    // Prefetch during SSR - data reused on client without refetch\n    await context.queryClient.query({\n      ...postQueryOptions(params.postId),\n      staleTime: 'static',\n    })\n  },\n  component: PostPage,\n})\n\nfunction PostPage() {\n  const { postId } = Route.useParams()\n  const queryClient = useQueryClient()\n\n  const { data } = useSuspenseQuery(postQueryOptions(postId))\n\n  const handleRefresh = () => {\n    // Manually refetch the RSC\n    queryClient.refetchQueries({ queryKey: ['post', postId] })\n  }\n\n  return <CompositeComponent src={data.src} />\n}\n```\n\n> [!IMPORTANT]\n> Always set `structuralSharing: false` when caching server components with React Query. Without this, React Query may attempt to merge RSC values between fetches, which can cause errors.\n\n### Invalidation\n\nTo refetch a server component after data changes, use `router.invalidate()`:\n\n```tsx\nimport { useRouter } from '@tanstack/react-router'\n\nfunction PostPage() {\n  const router = useRouter()\n  const { Post } = Route.useLoaderData()\n\n  const handleUpdate = async () => {\n    await updatePost({ data: { ... } })\n    // Refetch the route's loader, including the RSC\n    router.invalidate()\n  }\n\n  return (\n    <CompositeComponent\n      src={Post.src}\n      renderActions={() => (\n        <button onClick={handleUpdate}>Update Post</button>\n      )}\n    />\n  )\n}\n```\n\nThis pattern is useful when server functions mutate data that the RSC displays. After the mutation completes, `router.invalidate()` triggers the loader to run again, fetching a fresh server component with updated data.\n\n## Combining with Selective SSR\n\nServer Components pair with [Selective SSR](./selective-ssr.md) when you need server-rendered content but client-only rendering for the route component itself.\n\n### Example: `ssr: 'data-only'`\n\nThe server fetches the RSC, but the route component renders on the client:\n\n```tsx\nexport const Route = createFileRoute('/dashboard')({\n  ssr: 'data-only',\n  loader: async () => ({\n    Dashboard: await getDashboard(),\n  }),\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  const { Dashboard } = Route.useLoaderData()\n  const [width, setWidth] = React.useState(0)\n\n  React.useEffect(() => {\n    setWidth(window.innerWidth) // Browser API\n  }, [])\n\n  return (\n    <Dashboard\n      renderChart={({ data }) => <ResponsiveChart data={data} width={width} />}\n    />\n  )\n}\n```\n\nThis is useful when:\n\n- The server component fetches data and renders static content\n- The route component needs `window`, `localStorage`, or other browser APIs\n- You want the server component data ready before the client renders\n\n### Example: `ssr: false`\n\nBoth loader and component run on the client:\n\n```tsx\nexport const Route = createFileRoute('/canvas')({\n  ssr: false,\n  loader: async () => {\n    const savedState = localStorage.getItem('canvas-state')\n    return { Tools: await getDrawingTools({ data: { savedState } }) }\n  },\n  component: CanvasPage,\n})\n```\n\nUse this when the loader itself requires browser APIs.\n\n## Advanced Patterns\n\n### Multiple Server Components in Parallel\n\nWhen a page needs several independent server components, fetch them in parallel using `Promise.all`. Each component renders independently with its own data.\n\n**When to use:** Components from separate data sources with no shared dependencies. Maximizes concurrency when each component has independent fetch logic.\n\n```tsx\nconst getArticleA = createServerFn().handler(async () => {\n  const article = await db.articles.findById('a')\n  return renderServerComponent(<Article data={article} />)\n})\n\nconst getArticleB = createServerFn().handler(async () => {\n  const article = await db.articles.findById('b')\n  return renderServerComponent(<Article data={article} />)\n})\n\nconst getSidebar = createServerFn().handler(async () => {\n  const trending = await db.articles.getTrending()\n  return renderServerComponent(<Sidebar items={trending} />)\n})\n\nexport const Route = createFileRoute('/news')({\n  loader: async () => {\n    const [ArticleA, ArticleB, Sidebar] = await Promise.all([\n      getArticleA(),\n      getArticleB(),\n      getSidebar(),\n    ])\n    return { ArticleA, ArticleB, Sidebar }\n  },\n  component: NewsPage,\n})\n\nfunction NewsPage() {\n  const { ArticleA, ArticleB, Sidebar } = Route.useLoaderData()\n\n  return (\n    <div className=\"grid\">\n      <main>\n        {ArticleA}\n        {ArticleB}\n      </main>\n      <aside>{Sidebar}</aside>\n    </div>\n  )\n}\n```\n\nEach server function executes concurrently. The page renders when all complete.\n\n### Bundling Multiple Components\n\nReturn multiple server components from a single server function when they share data or should be fetched together. This reduces network round trips.\n\n**When to use:** Components that share fetched data, need a single cache key, or should invalidate together. Reduces database queries and network round trips.\n\n#### Using Promise.all\n\nCreate multiple `renderServerComponent` or `createCompositeComponent` calls and return them as an object:\n\n```tsx\nconst getPageLayout = createServerFn().handler(async () => {\n  // Fetch shared data once\n  const user = await db.users.getCurrent()\n  const config = await db.config.get()\n\n  // Create multiple components that share this data\n  const [Header, Content, Footer] = await Promise.all([\n    renderServerComponent(\n      <header>\n        <Logo />\n        <nav>\n          {config.navItems.map((item) => (\n            <NavLink key={item.id} {...item} />\n          ))}\n        </nav>\n        <UserMenu name={user.name} />\n      </header>,\n    ),\n    renderServerComponent(\n      <main>\n        <h1>Welcome, {user.name}</h1>\n        <Dashboard stats={user.stats} />\n      </main>,\n    ),\n    renderServerComponent(\n      <footer>\n        <span>{config.copyright}</span>\n        {config.footerLinks.map((link) => (\n          <a key={link.id} href={link.url}>\n            {link.label}\n          </a>\n        ))}\n      </footer>,\n    ),\n  ])\n\n  return { Header, Content, Footer }\n})\n\nexport const Route = createFileRoute('/dashboard')({\n  loader: async () => await getPageLayout(),\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  const { Header, Content, Footer } = Route.useLoaderData()\n\n  return (\n    <>\n      {Header}\n      {Content}\n      {Footer}\n    </>\n  )\n}\n```\n\n#### Using Nested Structures\n\nAlternatively, return a nested object structure from a single server function.\n\n- Use `renderServerComponent` when you just need renderables (no slots).\n- Use `createCompositeComponent` when you want each part to accept slots.\n\n```tsx\nconst getPageLayout = createServerFn().handler(async () => {\n  const user = await db.users.getCurrent()\n  const config = await db.config.get()\n\n  const [Header, Content, Footer] = await Promise.all([\n    createCompositeComponent((props: { children?: React.ReactNode }) => (\n      <header>\n        <Logo />\n        <nav>\n          {config.navItems.map((item) => (\n            <NavLink key={item.id} {...item} />\n          ))}\n        </nav>\n        <UserMenu name={user.name} />\n        {props.children}\n      </header>\n    )),\n    createCompositeComponent(\n      (props: { renderActions?: () => React.ReactNode }) => (\n        <main>\n          <h1>Welcome, {user.name}</h1>\n          <Dashboard stats={user.stats} />\n          {props.renderActions?.()}\n        </main>\n      ),\n    ),\n    createCompositeComponent(() => (\n      <footer>\n        <span>{config.copyright}</span>\n        {config.footerLinks.map((link) => (\n          <a key={link.id} href={link.url}>\n            {link.label}\n          </a>\n        ))}\n      </footer>\n    )),\n  ])\n\n  return { Header, Content, Footer }\n})\n\nexport const Route = createFileRoute('/dashboard')({\n  loader: async () => ({\n    Layout: await getPageLayout(),\n  }),\n  component: DashboardPage,\n})\n```\n\nRender nested composites using dot notation:\n\n```tsx\nimport { CompositeComponent } from '@tanstack/react-start/rsc'\n\nfunction DashboardPage() {\n  const { Layout } = Route.useLoaderData()\n\n  return (\n    <>\n      <CompositeComponent src={Layout.Header}>\n        <button onClick={() => setMenuOpen(true)}>Menu</button>\n      </CompositeComponent>\n      <CompositeComponent\n        src={Layout.Content}\n        renderActions={() => <ActionButtons />}\n      />\n      <CompositeComponent src={Layout.Footer} />\n    </>\n  )\n}\n```\n\nOr destructure them from the loader data:\n\n```tsx\nimport { CompositeComponent } from '@tanstack/react-start/rsc'\n\nfunction DashboardPage() {\n  const { Header, Content, Footer } = Route.useLoaderData().Layout\n\n  return (\n    <>\n      <CompositeComponent src={Header}>\n        <button onClick={() => setMenuOpen(true)}>Menu</button>\n      </CompositeComponent>\n      <CompositeComponent\n        src={Content}\n        renderActions={() => <ActionButtons />}\n      />\n      <CompositeComponent src={Footer} />\n    </>\n  )\n}\n```\n\nEach nested component receives its own slot props independently. The `children` passed to `<CompositeComponent src={Header}>` only affects that component, not the others.\n\nAll three components share the same user and config data from a single database query.\n\n### Deferred Component Loading\n\nReturn promises for server components instead of awaiting them. The client uses `React.use()` with `Suspense` to render each component as it resolves.\n\n**When to use:** Components with varying data latencies where faster results should render before slower ones complete. Avoids blocking on the slowest query.\n\n```tsx\nimport { Suspense, use } from 'react'\n\nconst getDashboardBundle = createServerFn().handler(() => ({\n  // Fast - resolves in ~100ms\n  QuickStats: (async () => {\n    const stats = await cache.getStats() // Fast cache hit\n    return renderServerComponent(<StatsCard data={stats} />)\n  })(),\n\n  // Medium - resolves in ~500ms\n  RecentActivity: (async () => {\n    const activity = await db.activity.getRecent()\n    return renderServerComponent(<ActivityFeed items={activity} />)\n  })(),\n\n  // Slow - resolves in ~2000ms\n  Analytics: (async () => {\n    const data = await analytics.computeMetrics() // Expensive query\n    return renderServerComponent(<AnalyticsChart data={data} />)\n  })(),\n}))\n\nexport const Route = createFileRoute('/dashboard')({\n  loader: () => getDashboardBundle(),\n  component: DashboardPage,\n})\n\nfunction DashboardPage() {\n  const { QuickStats, RecentActivity, Analytics } = Route.useLoaderData()\n\n  return (\n    <div>\n      <Suspense fallback={<Skeleton />}>\n        <Deferred promise={QuickStats} />\n      </Suspense>\n\n      <Suspense fallback={<Skeleton />}>\n        <Deferred promise={RecentActivity} />\n      </Suspense>\n\n      <Suspense fallback={<Skeleton />}>\n        <Deferred promise={Analytics} />\n      </Suspense>\n    </div>\n  )\n}\n\nfunction Deferred({ promise }: { promise: Promise<unknown> }) {\n  const Renderable = use(promise)\n  return <>{Renderable}</>\n}\n```\n\nQuickStats appears first, RecentActivity follows, then Analytics loads last. Users see progressive content instead of waiting for everything.\n\n### Suspense Inside Server Components\n\nUse React's `Suspense` directly inside server components to stream parts of the component as they become ready.\n\n**When to use:** A single server component with multiple async child components that should stream independently. Keeps related UI in one component while allowing progressive rendering.\n\n```tsx\nasync function SlowMetric({ label, delay }: { label: string; delay: number }) {\n  await new Promise((resolve) => setTimeout(resolve, delay))\n  const value = await db.metrics.get(label)\n\n  return (\n    <div className=\"metric\">\n      <span>{label}</span>\n      <span>{value.toLocaleString()}</span>\n    </div>\n  )\n}\n\nconst getAnalyticsDashboard = createServerFn().handler(() =>\n  renderServerComponent(\n    <div className=\"dashboard\">\n      <h1>Analytics</h1>\n\n      <div className=\"metrics-grid\">\n        <Suspense fallback={<MetricSkeleton label=\"Active Users\" />}>\n          <SlowMetric label=\"Active Users\" delay={500} />\n        </Suspense>\n\n        <Suspense fallback={<MetricSkeleton label=\"Revenue\" />}>\n          <SlowMetric label=\"Revenue\" delay={1500} />\n        </Suspense>\n\n        <Suspense fallback={<MetricSkeleton label=\"Conversion\" />}>\n          <SlowMetric label=\"Conversion\" delay={2500} />\n        </Suspense>\n      </div>\n    </div>,\n  ),\n)\n```\n\nEach metric streams independently. The dashboard shell appears immediately, then metrics pop in as their data loads.\n\n### Streaming with Async Generators\n\nUse async generators to stream server components one at a time. The client receives and renders each component as it's yielded.\n\n**When to use:** Unbounded or large result sets where items should render incrementally. Useful when processing time per item varies or total count is unknown upfront.\n\n```tsx\nimport {\n  CompositeComponent,\n  createCompositeComponent,\n} from '@tanstack/react-start/rsc'\n\nconst streamNotifications = createServerFn().handler(async function* () {\n  // Yield initial batch immediately\n  const recent = await db.notifications.getRecent(3)\n  for (const notification of recent) {\n    yield await createCompositeComponent<{\n      renderActions?: (data: { id: string }) => React.ReactNode\n    }>((props) => (\n      <div className=\"notification\">\n        <h3>{notification.title}</h3>\n        <p>{notification.message}</p>\n        {props.renderActions?.({ id: notification.id })}\n      </div>\n    ))\n  }\n\n  // Stream older notifications with delays\n  const older = await db.notifications.getOlder(5)\n  for (const notification of older) {\n    await new Promise((resolve) => setTimeout(resolve, 300))\n    yield await createCompositeComponent<{\n      renderActions?: (data: { id: string }) => React.ReactNode\n    }>((props) => (\n      <div className=\"notification\">\n        <h3>{notification.title}</h3>\n        <p>{notification.message}</p>\n        {props.renderActions?.({ id: notification.id })}\n      </div>\n    ))\n  }\n})\n\nexport const Route = createFileRoute('/notifications')({\n  component: NotificationsPage,\n})\n\nfunction NotificationsPage() {\n  const [notifications, setNotifications] = React.useState<Array<unknown>>([])\n  const [isStreaming, setIsStreaming] = React.useState(false)\n\n  const startStreaming = React.useCallback(async () => {\n    setNotifications([])\n    setIsStreaming(true)\n\n    const stream = await streamNotifications()\n    for await (const notification of stream) {\n      setNotifications((prev) => [...prev, notification])\n    }\n\n    setIsStreaming(false)\n  }, [])\n\n  return (\n    <div>\n      <button onClick={startStreaming} disabled={isStreaming}>\n        {isStreaming ? 'Streaming...' : 'Load Notifications'}\n      </button>\n\n      {notifications.map((notificationSrc, i) => (\n        <CompositeComponent\n          key={i}\n          src={notificationSrc}\n          renderActions={({ id }) => (\n            <button onClick={() => markAsRead(id)}>Mark read</button>\n          )}\n        />\n      ))}\n    </div>\n  )\n}\n```\n\nNotifications appear one by one. The first three show immediately, then more stream in. Each supports client interactivity through render props.\n\n## Error Handling\n\nErrors in Server Components—whether during data fetching or rendering—propagate to the client.\n\n### Route Level Errors\n\nIf a Server Component fails to load in the `loader`, the route's `errorComponent` renders:\n\n```tsx\nexport const Route = createFileRoute('/')({\n  loader: async () => ({\n    // If this fails, the errorComponent renders\n    Greeting: await getGreeting(),\n  }),\n  errorComponent: ({ error }) => <div>Failed to load: {error.message}</div>,\n  component: HomePage,\n})\n```\n\n### Component Level Errors\n\nTo isolate errors (e.g., preventing a single failing widget from crashing the page), you must use **[Deferred Loading](#deferred-component-loading)**.\n\nBy returning a Promise from the loader instead of awaiting it, the Route Component renders immediately. If the Promise later rejects, the `ErrorBoundary` inside your component catches it.\n\n```tsx\n// 1. Loader returns a Promise (don't await!)\nexport const Route = createFileRoute('/dashboard')({\n  loader: () => ({\n    // If this fails, only the specific ErrorBoundary below catches it\n    WidgetPromise: getWidget(),\n  }),\n  component: DashboardPage,\n})\n\n// 2. Component handles the potential failure\nfunction DashboardPage() {\n  const { WidgetPromise } = Route.useLoaderData()\n\n  return (\n    <ErrorBoundary fallback={<div>Widget unavailable</div>}>\n      <React.Suspense fallback={<Skeleton />}>\n        <Deferred promise={WidgetPromise} />\n      </React.Suspense>\n    </ErrorBoundary>\n  )\n}\n```\n\n## Tips\n\n### Using `React.cache`\n\n`React.cache` works inside server components for request-scoped memoization. This is useful when multiple components need the same expensive computation:\n\n```tsx\nimport { cache } from 'react'\n\nconst getUser = cache(async (userId: string) => {\n  return db.users.findById(userId)\n})\n\n// Both components share the same cached result within a single request\nasync function UserHeader() {\n  const user = await getUser('123') // Fetches from DB\n  return <h1>{user.name}</h1>\n}\n\nasync function UserSidebar() {\n  const user = await getUser('123') // Returns cached result\n  return <aside>{user.bio}</aside>\n}\n```\n\n### Router Links in Server Components\n\nTanStack Router's `Link` component works inside server components. The link is serialized and hydrates on the client for client-side navigation:\n\n```tsx\nimport { Link } from '@tanstack/react-router'\n\nconst getNavigation = createServerFn().handler(async () => {\n  const pages = await db.pages.list()\n\n  return renderServerComponent(\n    <nav>\n      {pages.map((page) => (\n        <Link key={page.id} to=\"/pages/$pageId\" params={{ pageId: page.id }}>\n          {page.title}\n        </Link>\n      ))}\n    </nav>,\n  )\n})\n```\n\n### CSS in Server Components\n\nCSS Modules and global CSS imports work in server components. Styles are extracted and sent to the client:\n\n```tsx\nimport styles from './Card.module.css'\n\nconst getCard = createServerFn().handler(async () => {\n  return renderServerComponent(\n    <div className={styles.card}>\n      <h2 className={styles.title}>Server Rendered</h2>\n    </div>,\n  )\n})\n```\n\n## Rules and Limitations\n\n### Slots are opaque on the server\n\nThe server cannot inspect slot content. `React.Children.map()` and `cloneElement()` won't work on `props.children`:\n\n```tsx\n// Won't work - children is a placeholder on the server\ncreateCompositeComponent((props: { children?: React.ReactNode }) => (\n  <div>\n    {React.Children.map(props.children, (child) =>\n      React.cloneElement(child, { extra: 'prop' }),\n    )}\n  </div>\n))\n\n// Do this instead - use render props\ncreateCompositeComponent<{\n  renderItem?: (data: { extra: string }) => React.ReactNode\n}>((props) => <div>{props.renderItem?.({ extra: 'prop' })}</div>)\n```\n\n### Render prop arguments must be serializable\n\nArguments passed to slots via render props and or components travel through React's Flight protocol. Use serializable values only: strings, numbers, booleans, null, plain objects, and arrays.\n\n## How It Works\n\nWhen a server component accesses slot props, it accesses a proxy:\n\n- Reading `props.children` creates a placeholder for \"whatever children the caller provides\"\n- Calling `props.renderFn(args)` creates a placeholder that records `args`\n\nTanStack Start sends a React Flight stream with these placeholders. On the client, placeholders are replaced with the actual props you passed when rendering.\n\n## Current Status\n\nServer Components are experimental in TanStack Start and will remain so into early v1.\n\n**Serialization:** Uses React's native Flight protocol. TanStack Start's custom serialization isn't available in server components yet. Primitives, Dates, and React elements work. Custom serialization coming in a future release.\n\n**API:** The RSC helper APIs may see refinements.\n\nQuestions? [Open an issue](https://github.com/tanstack/router/issues) or join the [Discord](https://tlinz.com/discord).\n\n## Low-Level Flight Stream APIs\n\nFor advanced use cases (custom streaming protocols, API route integration, external RSC-aware systems), TanStack Start exposes low-level Flight stream APIs. For most cases, prefer the high-level helpers which handle caching, streaming, and (for composites) slots automatically.\n\nImport from `@tanstack/react-start/rsc`:\n\n| Function                   | Available in          | Description                                        |\n| -------------------------- | --------------------- | -------------------------------------------------- |\n| `renderToReadableStream`   | server functions only | Renders React elements to a Flight stream          |\n| `createFromFetch`          | Client                | Decodes a Flight stream from a `Promise<Response>` |\n| `createFromReadableStream` | Client/SSR            | Decodes a Flight stream from a `ReadableStream`    |\n\n`createFromFetch` is a convenience wrapper around `createFromReadableStream` that accepts a fetch promise directly and extracts the body stream internally.\n\n### Example\n\n```tsx\n// src/routes/api/rsc.ts - API route with Flight stream\nimport { createAPIFileRoute } from '@tanstack/react-start/api'\nimport { createServerFn } from '@tanstack/react-start'\nimport { renderToReadableStream } from '@tanstack/react-start/rsc'\n\nconst getFlightStream = createServerFn({ method: 'GET' }).handler(async () => {\n  return renderToReadableStream(<div>Server Rendered Content</div>)\n})\n\nexport const APIRoute = createAPIFileRoute('/api/rsc')({\n  GET: async () => {\n    const stream = await getFlightStream()\n    return new Response(stream, {\n      headers: { 'Content-Type': 'text/x-component' },\n    })\n  },\n})\n```\n\n```tsx\n// Client: fetch and decode the Flight stream\nimport { createFromFetch } from '@tanstack/react-start/rsc'\n\nasync function fetchRSC() {\n  return createFromFetch(fetch('/api/rsc'))\n}\n```\n"}
