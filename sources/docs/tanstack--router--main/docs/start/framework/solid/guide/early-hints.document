id: early-hints
title: Early Hints
---
NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Experimental:"}]},{"type":"text","value":" Early Hints are experimental and subject to change."}]}]},{"type":"paragraph","children":[{"type":"text","value":"HTTP "},{"type":"inlineCode","value":"103 Early Hints"},{"type":"text","value":" lets your server tell the browser about important resources before the final HTML response is ready. TanStack Start can collect route assets and route "},{"type":"inlineCode","value":"head().links"},{"type":"text","value":", then call your server entry so your runtime can send "},{"type":"inlineCode","value":"103"},{"type":"text","value":" responses."}]},{"type":"paragraph","children":[{"type":"text","value":"Start does not send Early Hints automatically. Each deployment platform exposes a different API for writing informational responses, so your server entry decides how to send them."}]},{"type":"heading","depth":2,"id":"choose-how-to-send-hints","children":[{"type":"text","value":"Choose How to Send Hints"}]},{"type":"paragraph","children":[{"type":"text","value":"Most apps should choose one of these patterns."}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Goal"}]},{"type":"tableCell","children":[{"type":"text","value":"Use"}]},{"type":"tableCell","children":[{"type":"text","value":"Tradeoff"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"Send hints as early as possible"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"phase === 'static'"},{"type":"text","value":" with "},{"type":"inlineCode","value":"links"}]},{"type":"tableCell","children":[{"type":"text","value":"May send hints for a request that redirects"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Send only redirect-safe hints"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"phase === 'dynamic'"},{"type":"text","value":" with "},{"type":"inlineCode","value":"allLinks"}]},{"type":"tableCell","children":[{"type":"text","value":"Runs later, after route loading completes"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Let a CDN generate Early Hints"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"responseLinkHeader"}]},{"type":"tableCell","children":[{"type":"text","value":"Only safe for public, cache-stable links"}]}],[{"type":"tableCell","children":[{"type":"text","value":"Support runtimes without HTTP 103"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"responseLinkHeader"},{"type":"text","value":" as a preload hint fallback"}]},{"type":"tableCell","children":[{"type":"text","value":"Does not hide server think time like "},{"type":"inlineCode","value":"103"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Browsers generally process only the first "},{"type":"inlineCode","value":"103"},{"type":"text","value":" response for a navigation. Write at most one Early Hints response per request."}]},{"type":"heading","depth":2,"id":"send-early-hints-from-your-server-entry","children":[{"type":"text","value":"Send Early Hints From Your Server Entry"}]},{"type":"paragraph","children":[{"type":"text","value":"Add "},{"type":"inlineCode","value":"onEarlyHints"},{"type":"text","value":" in "},{"type":"inlineCode","value":"src/server.ts"},{"type":"text","value":", then pass the serialized "},{"type":"inlineCode","value":"links"},{"type":"text","value":" to your runtime's Early Hints API."}]},{"type":"paragraph","children":[{"type":"text","value":"This example sends the earliest static hints:"}]},{"type":"code","value":"// src/server.ts\nimport handler, { createServerEntry } from '@tanstack/solid-start/server-entry'\n\nexport default createServerEntry({\n  fetch(request) {\n    return handler.fetch(request, {\n      onEarlyHints: ({ phase, links }) => {\n        if (phase !== 'static' || !links.length) return\n\n        // Send `links` with your runtime-specific 103 API.\n      },\n    })\n  },\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Start can call "},{"type":"inlineCode","value":"onEarlyHints"},{"type":"text","value":" more than once for a request. "},{"type":"inlineCode","value":"links"},{"type":"text","value":" only contains values that were not emitted in an earlier phase. "},{"type":"inlineCode","value":"allLinks"},{"type":"text","value":" contains all deduped values collected so far."}]},{"type":"heading","depth":2,"id":"choose-when-to-send-hints","children":[{"type":"text","value":"Choose When to Send Hints"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"onEarlyHints"},{"type":"text","value":" can run in two phases."}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Phase"}]},{"type":"tableCell","children":[{"type":"text","value":"When it runs"}]},{"type":"tableCell","children":[{"type":"text","value":"What it contains"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"static"}]},{"type":"tableCell","children":[{"type":"text","value":"After route matching, before the router loads the route"}]},{"type":"tableCell","children":[{"type":"text","value":"Manifest-managed assets for the matched routes"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"dynamic"}]},{"type":"tableCell","children":[{"type":"text","value":"After "},{"type":"inlineCode","value":"router.load()"},{"type":"text","value":" completes, unless the request redirects"}]},{"type":"tableCell","children":[{"type":"text","value":"Supported links returned by route "},{"type":"inlineCode","value":"head()"},{"type":"text","value":" functions, or an empty array when all hints were already emitted"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"static"},{"type":"text","value":" when you want the browser to start loading known route assets as soon as possible. Static hints can run before route "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":" functions, so they may be sent for a request that later redirects."}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"dynamic"},{"type":"text","value":" when hints must be redirect-safe or loader-aware. If you want one "},{"type":"inlineCode","value":"103"},{"type":"text","value":" response that includes both static route assets and dynamic route "},{"type":"inlineCode","value":"head()"},{"type":"text","value":" links, wait for "},{"type":"inlineCode","value":"dynamic"},{"type":"text","value":" and send "},{"type":"inlineCode","value":"allLinks"},{"type":"text","value":"."}]},{"type":"code","value":"onEarlyHints: ({ phase, allLinks }) => {\n  if (phase !== 'dynamic' || !allLinks.length) return\n\n  // Send one redirect-safe 103 with static and dynamic links.\n  // Use `allLinks` with your runtime-specific 103 API.\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"dynamic"},{"type":"text","value":" phase can run with empty "},{"type":"inlineCode","value":"links"},{"type":"text","value":", so it can also be used as a post-load signal."}]},{"type":"heading","depth":2,"id":"add-dynamic-hints-from-route-head","children":[{"type":"text","value":"Add Dynamic Hints From Route Head"}]},{"type":"paragraph","children":[{"type":"text","value":"Dynamic Early Hints come from supported route "},{"type":"inlineCode","value":"head().links"},{"type":"text","value":" entries after loaders have run."}]},{"type":"code","value":"import { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ params }) => getPost(params.postId),\n  head: ({ loaderData }) => ({\n    links: [\n      {\n        rel: 'preload',\n        href: loaderData.heroImageUrl,\n        as: 'image',\n      },\n    ],\n  }),\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"dynamic"},{"type":"text","value":" phase is skipped when "},{"type":"inlineCode","value":"router.load()"},{"type":"text","value":" produces a redirect."}]},{"type":"paragraph","children":[{"type":"text","value":"Route "},{"type":"inlineCode","value":"head().links"},{"type":"text","value":" entries with "},{"type":"inlineCode","value":"rel: 'stylesheet'"},{"type":"text","value":" are converted to "},{"type":"inlineCode","value":"rel=preload; as=style"},{"type":"text","value":" for Early Hints. This includes stylesheets you import with "},{"type":"inlineCode","value":"?url"},{"type":"text","value":" and return from route "},{"type":"inlineCode","value":"head()"},{"type":"text","value":". See "},{"type":"link","href":"./css-styling#know-when-css-is-discovered","children":[{"type":"text","value":"CSS Styling"}]},{"type":"text","value":" for how CSS import patterns affect when Start discovers stylesheets."}]},{"type":"heading","depth":2,"id":"use-response-link-headers-as-a-fallback","children":[{"type":"text","value":"Use Response Link Headers as a Fallback"}]},{"type":"paragraph","children":[{"type":"text","value":"You can also attach collected hints to the final HTML response's HTTP "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" header."}]},{"type":"paragraph","children":[{"type":"text","value":"A response "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" header does not hide server think time like a "},{"type":"inlineCode","value":"103"},{"type":"text","value":" response does, but the browser receives it before parsing the HTML body, so it can still start supported preloads and preconnects earlier than it would from HTML alone."}]},{"type":"paragraph","children":[{"type":"text","value":"Response "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" headers are most useful when:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Your runtime cannot write "},{"type":"inlineCode","value":"103"},{"type":"text","value":" responses."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Your CDN can generate Early Hints from response "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" headers."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Start does not add response "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" headers automatically. It cannot know whether those headers will be used only by the browser for the current response, stored by a shared cache, or replayed later as CDN-generated Early Hints."}]},{"type":"paragraph","children":[{"type":"text","value":"This example appends all collected static and dynamic links to non-redirect HTML responses:"}]},{"type":"code","value":"// src/server.ts\nimport handler, { createServerEntry } from '@tanstack/solid-start/server-entry'\n\nexport default createServerEntry({\n  fetch(request) {\n    return handler.fetch(request, {\n      responseLinkHeader: true,\n    })\n  },\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"filter-links-before-sending-them-to-a-cdn","children":[{"type":"text","value":"Filter Links Before Sending Them to a CDN"}]},{"type":"paragraph","children":[{"type":"text","value":"Some CDNs can read response "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" headers, cache them, and emit their own "},{"type":"inlineCode","value":"103"},{"type":"text","value":" responses for later requests. For example, "},{"type":"link","href":"https://developers.cloudflare.com/cache/advanced-configuration/early-hints/","children":[{"type":"text","value":"Cloudflare Early Hints"}]},{"type":"text","value":" can use "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" headers from HTML responses."}]},{"type":"paragraph","children":[{"type":"text","value":"Only let a shared cache or CDN replay links that are public and cache-stable for the response's cache boundary."}]},{"type":"paragraph","children":[{"type":"text","value":"Good links to include are:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Static route JavaScript and CSS assets."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Public font, image, style, or fetch preloads with stable URLs."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Public preconnect origins."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Avoid or filter links when they are:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Authenticated, private, or user-specific."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Signed, expiring, or otherwise short-lived."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Derived from cookies, headers, query strings, A/B tests, or user data, unless the cache key varies on the same inputs."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Unsafe to replay before your app authorizes the request."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Cloudflare documents several important caveats: its Early Hints cache ignores query strings, it can emit cached hints before reaching your origin or Worker, and it only generates hints from selected final response status codes and "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" relations."}]},{"type":"paragraph","children":[{"type":"text","value":"Because of those cache semantics, use response "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" headers only when every emitted static or dynamic link is public and cache-stable for the request URI. Use "},{"type":"inlineCode","value":"responseLinkHeader.filter"},{"type":"text","value":" to remove links that are not safe for your cache boundary."}]},{"type":"paragraph","children":[{"type":"text","value":"For example, this keeps only static manifest assets:"}]},{"type":"code","value":"handler.fetch(request, {\n  responseLinkHeader: {\n    filter: ({ phase }) => phase === 'static',\n  },\n})","lang":"tsx"},{"type":"heading","depth":2,"id":"how-cdn-asset-rewrites-affect-hints","children":[{"type":"text","value":"How CDN Asset Rewrites Affect Hints"}]},{"type":"paragraph","children":[{"type":"text","value":"Static Early Hints are collected from the final Start manifest resolved for the request. This means they follow the result of "},{"type":"link","href":"./cdn-asset-urls","children":[{"type":"inlineCode","value":"transformAssets"}]},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"CDN URL rewrites are reflected in Early Hints."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"crossOrigin"},{"type":"text","value":" returned from "},{"type":"inlineCode","value":"transformAssets"},{"type":"text","value":" is reflected in Early Hints."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"JavaScript hints follow the client output format: "},{"type":"inlineCode","value":"modulepreload"},{"type":"text","value":" for module output, or "},{"type":"inlineCode","value":"preload; as=script"},{"type":"text","value":" for IIFE output."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Per-request transforms with "},{"type":"inlineCode","value":"cache: false"},{"type":"text","value":" are reflected in Early Hints for that request."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Inlined CSS assets are skipped when Start's "},{"type":"link","href":"./css-styling#inline-route-css-in-production","children":[{"type":"text","value":"CSS inlining"}]},{"type":"text","value":" build option inlines them into the HTML."}]}]}]},{"type":"heading","depth":2,"id":"event-shape","children":[{"type":"text","value":"Event Shape"}]},{"type":"paragraph","children":[{"type":"text","value":"The callback receives an "},{"type":"inlineCode","value":"EarlyHintsEvent"},{"type":"text","value":":"}]},{"type":"code","value":"type EarlyHintsEvent = {\n  phase: 'static' | 'dynamic'\n  hints: ReadonlyArray<EarlyHint>\n  links: Array<string>\n  allHints: ReadonlyArray<EarlyHint>\n  allLinks: Array<string>\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"hints"},{"type":"text","value":" is the structured form for the current phase. "},{"type":"inlineCode","value":"links"},{"type":"text","value":" is the serialized HTTP "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" header form for the current phase. Both are deduped across phases, contain only new values, and are index-aligned."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"allHints"},{"type":"text","value":" and "},{"type":"inlineCode","value":"allLinks"},{"type":"text","value":" contain all deduped values collected so far for the request. They are also index-aligned, and are useful when you want to write one combined "},{"type":"inlineCode","value":"103"},{"type":"text","value":" response during the "},{"type":"inlineCode","value":"dynamic"},{"type":"text","value":" phase."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"responseLinkHeader.filter"},{"type":"text","value":" callback receives entries with this shape:"}]},{"type":"code","value":"type ResponseLinkHeaderEntry = {\n  phase: 'static' | 'dynamic'\n  hint: EarlyHint\n  link: string\n}","lang":"ts"},{"type":"heading","depth":2,"id":"supported-links","children":[{"type":"text","value":"Supported Links"}]},{"type":"paragraph","children":[{"type":"text","value":"Start emits Early Hints for link relations that map cleanly to HTTP "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" headers:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"preload"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"modulepreload"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"preconnect"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"dns-prefetch"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Start serializes these attributes when present:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"href"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"rel"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"as"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"crossOrigin"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"type"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"integrity"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"referrerPolicy"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"fetchPriority"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Other head tags, inline styles, route scripts, and metadata are not converted into Early Hints."}]},{"type":"paragraph","children":[{"type":"text","value":"HTML Early Hints processing does not apply "},{"type":"inlineCode","value":"media"},{"type":"text","value":", "},{"type":"inlineCode","value":"imageSrcSet"},{"type":"text","value":", or "},{"type":"inlineCode","value":"imageSizes"},{"type":"text","value":" until the final document exists, so Start does not serialize those attributes into "},{"type":"inlineCode","value":"103"},{"type":"text","value":" links."}]},{"type":"heading","depth":2,"id":"runtime-example-node","children":[{"type":"text","value":"Runtime Example: Node"}]},{"type":"paragraph","children":[{"type":"text","value":"If your runtime exposes Node's "},{"type":"inlineCode","value":"ServerResponse"},{"type":"text","value":", call "},{"type":"inlineCode","value":"writeEarlyHints"},{"type":"text","value":" with "},{"type":"inlineCode","value":"links"},{"type":"text","value":". This example sends the earliest "},{"type":"inlineCode","value":"static"},{"type":"text","value":" hints:"}]},{"type":"code","value":"// src/server.ts\nimport handler, { createServerEntry } from '@tanstack/solid-start/server-entry'\nimport type { ServerResponse } from 'node:http'\n\nexport default createServerEntry({\n  fetch(request) {\n    return handler.fetch(request, {\n      onEarlyHints: ({ phase, links }) => {\n        if (phase !== 'static' || !links.length) return\n\n        const response = getNodeResponseSomehow(request) as\n          | ServerResponse\n          | undefined\n\n        response?.writeEarlyHints({ link: links })\n      },\n    })\n  },\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Replace "},{"type":"inlineCode","value":"getNodeResponseSomehow"},{"type":"text","value":" with the API your adapter exposes."}]},{"type":"heading","depth":2,"id":"runtime-example-srvx-nitro-on-node","children":[{"type":"text","value":"Runtime Example: srvx / Nitro on Node"}]},{"type":"paragraph","children":[{"type":"text","value":"Nitro uses "},{"type":"link","href":"https://srvx.h3.dev/","children":[{"type":"text","value":"srvx"}]},{"type":"text","value":" under the hood for Node deployments. srvx exposes the native Node response on the request runtime context. This example waits for "},{"type":"inlineCode","value":"dynamic"},{"type":"text","value":" to send one redirect-safe response with both static and dynamic links:"}]},{"type":"code","value":"// src/server.ts\nimport handler from '@tanstack/solid-start/server-entry'\nimport type { ServerRequest } from 'srvx'\n\nexport default {\n  fetch(request: Request) {\n    const serverRequest = request as ServerRequest\n\n    return handler.fetch(request, {\n      onEarlyHints: ({ phase, allLinks }) => {\n        if (phase !== 'dynamic') return\n\n        const response = serverRequest.runtime?.node?.res\n\n        if (response?.writeEarlyHints && allLinks.length) {\n          response.writeEarlyHints({ link: allLinks })\n        }\n      },\n    })\n  },\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"limitations","children":[{"type":"text","value":"Limitations"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Early Hints are skipped in the Start dev server."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Start only mutates the response "},{"type":"inlineCode","value":"Link"},{"type":"text","value":" header when "},{"type":"inlineCode","value":"responseLinkHeader"},{"type":"text","value":" is enabled."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Browsers generally process only the first "},{"type":"inlineCode","value":"103"},{"type":"text","value":" response for a navigation."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Static hints can be sent before "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":" redirects are known."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The runtime or proxy in front of your app must support HTTP "},{"type":"inlineCode","value":"103"},{"type":"text","value":" responses."}]}]}]}],"headings":[{"id":"choose-how-to-send-hints","text":"Choose How to Send Hints","level":2},{"id":"send-early-hints-from-your-server-entry","text":"Send Early Hints From Your Server Entry","level":2},{"id":"choose-when-to-send-hints","text":"Choose When to Send Hints","level":2},{"id":"add-dynamic-hints-from-route-head","text":"Add Dynamic Hints From Route Head","level":2},{"id":"use-response-link-headers-as-a-fallback","text":"Use Response Link Headers as a Fallback","level":2},{"id":"filter-links-before-sending-them-to-a-cdn","text":"Filter Links Before Sending Them to a CDN","level":2},{"id":"how-cdn-asset-rewrites-affect-hints","text":"How CDN Asset Rewrites Affect Hints","level":2},{"id":"event-shape","text":"Event Shape","level":2},{"id":"supported-links","text":"Supported Links","level":2},{"id":"runtime-example-node","text":"Runtime Example: Node","level":2},{"id":"runtime-example-srvx-nitro-on-node","text":"Runtime Example: srvx / Nitro on Node","level":2},{"id":"limitations","text":"Limitations","level":2}]},"frameworks":[],"downloadMarkdown":"\n> **Experimental:** Early Hints are experimental and subject to change.\n\nHTTP `103 Early Hints` lets your server tell the browser about important resources before the final HTML response is ready. TanStack Start can collect route assets and route `head().links`, then call your server entry so your runtime can send `103` responses.\n\nStart does not send Early Hints automatically. Each deployment platform exposes a different API for writing informational responses, so your server entry decides how to send them.\n\n## Choose How to Send Hints\n\nMost apps should choose one of these patterns.\n\n| Goal                              | Use                                             | Tradeoff                                    |\n| --------------------------------- | ----------------------------------------------- | ------------------------------------------- |\n| Send hints as early as possible   | `phase === 'static'` with `links`               | May send hints for a request that redirects |\n| Send only redirect-safe hints     | `phase === 'dynamic'` with `allLinks`           | Runs later, after route loading completes   |\n| Let a CDN generate Early Hints    | `responseLinkHeader`                            | Only safe for public, cache-stable links    |\n| Support runtimes without HTTP 103 | `responseLinkHeader` as a preload hint fallback | Does not hide server think time like `103`  |\n\nBrowsers generally process only the first `103` response for a navigation. Write at most one Early Hints response per request.\n\n## Send Early Hints From Your Server Entry\n\nAdd `onEarlyHints` in `src/server.ts`, then pass the serialized `links` to your runtime's Early Hints API.\n\nThis example sends the earliest static hints:\n\n```tsx\n// src/server.ts\nimport handler, { createServerEntry } from '@tanstack/solid-start/server-entry'\n\nexport default createServerEntry({\n  fetch(request) {\n    return handler.fetch(request, {\n      onEarlyHints: ({ phase, links }) => {\n        if (phase !== 'static' || !links.length) return\n\n        // Send `links` with your runtime-specific 103 API.\n      },\n    })\n  },\n})\n```\n\nStart can call `onEarlyHints` more than once for a request. `links` only contains values that were not emitted in an earlier phase. `allLinks` contains all deduped values collected so far.\n\n## Choose When to Send Hints\n\n`onEarlyHints` can run in two phases.\n\n| Phase     | When it runs                                                  | What it contains                                                                                            |\n| --------- | ------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------- |\n| `static`  | After route matching, before the router loads the route       | Manifest-managed assets for the matched routes                                                              |\n| `dynamic` | After `router.load()` completes, unless the request redirects | Supported links returned by route `head()` functions, or an empty array when all hints were already emitted |\n\nUse `static` when you want the browser to start loading known route assets as soon as possible. Static hints can run before route `beforeLoad` functions, so they may be sent for a request that later redirects.\n\nUse `dynamic` when hints must be redirect-safe or loader-aware. If you want one `103` response that includes both static route assets and dynamic route `head()` links, wait for `dynamic` and send `allLinks`.\n\n```tsx\nonEarlyHints: ({ phase, allLinks }) => {\n  if (phase !== 'dynamic' || !allLinks.length) return\n\n  // Send one redirect-safe 103 with static and dynamic links.\n  // Use `allLinks` with your runtime-specific 103 API.\n}\n```\n\nThe `dynamic` phase can run with empty `links`, so it can also be used as a post-load signal.\n\n## Add Dynamic Hints From Route Head\n\nDynamic Early Hints come from supported route `head().links` entries after loaders have run.\n\n```tsx\nimport { createFileRoute } from '@tanstack/react-router'\n\nexport const Route = createFileRoute('/posts/$postId')({\n  loader: async ({ params }) => getPost(params.postId),\n  head: ({ loaderData }) => ({\n    links: [\n      {\n        rel: 'preload',\n        href: loaderData.heroImageUrl,\n        as: 'image',\n      },\n    ],\n  }),\n})\n```\n\nThe `dynamic` phase is skipped when `router.load()` produces a redirect.\n\nRoute `head().links` entries with `rel: 'stylesheet'` are converted to `rel=preload; as=style` for Early Hints. This includes stylesheets you import with `?url` and return from route `head()`. See [CSS Styling](./css-styling#know-when-css-is-discovered) for how CSS import patterns affect when Start discovers stylesheets.\n\n## Use Response Link Headers as a Fallback\n\nYou can also attach collected hints to the final HTML response's HTTP `Link` header.\n\nA response `Link` header does not hide server think time like a `103` response does, but the browser receives it before parsing the HTML body, so it can still start supported preloads and preconnects earlier than it would from HTML alone.\n\nResponse `Link` headers are most useful when:\n\n- Your runtime cannot write `103` responses.\n- Your CDN can generate Early Hints from response `Link` headers.\n\nStart does not add response `Link` headers automatically. It cannot know whether those headers will be used only by the browser for the current response, stored by a shared cache, or replayed later as CDN-generated Early Hints.\n\nThis example appends all collected static and dynamic links to non-redirect HTML responses:\n\n```tsx\n// src/server.ts\nimport handler, { createServerEntry } from '@tanstack/solid-start/server-entry'\n\nexport default createServerEntry({\n  fetch(request) {\n    return handler.fetch(request, {\n      responseLinkHeader: true,\n    })\n  },\n})\n```\n\n## Filter Links Before Sending Them to a CDN\n\nSome CDNs can read response `Link` headers, cache them, and emit their own `103` responses for later requests. For example, [Cloudflare Early Hints](https://developers.cloudflare.com/cache/advanced-configuration/early-hints/) can use `Link` headers from HTML responses.\n\nOnly let a shared cache or CDN replay links that are public and cache-stable for the response's cache boundary.\n\nGood links to include are:\n\n- Static route JavaScript and CSS assets.\n- Public font, image, style, or fetch preloads with stable URLs.\n- Public preconnect origins.\n\nAvoid or filter links when they are:\n\n- Authenticated, private, or user-specific.\n- Signed, expiring, or otherwise short-lived.\n- Derived from cookies, headers, query strings, A/B tests, or user data, unless the cache key varies on the same inputs.\n- Unsafe to replay before your app authorizes the request.\n\nCloudflare documents several important caveats: its Early Hints cache ignores query strings, it can emit cached hints before reaching your origin or Worker, and it only generates hints from selected final response status codes and `Link` relations.\n\nBecause of those cache semantics, use response `Link` headers only when every emitted static or dynamic link is public and cache-stable for the request URI. Use `responseLinkHeader.filter` to remove links that are not safe for your cache boundary.\n\nFor example, this keeps only static manifest assets:\n\n```tsx\nhandler.fetch(request, {\n  responseLinkHeader: {\n    filter: ({ phase }) => phase === 'static',\n  },\n})\n```\n\n## How CDN Asset Rewrites Affect Hints\n\nStatic Early Hints are collected from the final Start manifest resolved for the request. This means they follow the result of [`transformAssets`](./cdn-asset-urls):\n\n- CDN URL rewrites are reflected in Early Hints.\n- `crossOrigin` returned from `transformAssets` is reflected in Early Hints.\n- JavaScript hints follow the client output format: `modulepreload` for module output, or `preload; as=script` for IIFE output.\n- Per-request transforms with `cache: false` are reflected in Early Hints for that request.\n- Inlined CSS assets are skipped when Start's [CSS inlining](./css-styling#inline-route-css-in-production) build option inlines them into the HTML.\n\n## Event Shape\n\nThe callback receives an `EarlyHintsEvent`:\n\n```ts\ntype EarlyHintsEvent = {\n  phase: 'static' | 'dynamic'\n  hints: ReadonlyArray<EarlyHint>\n  links: Array<string>\n  allHints: ReadonlyArray<EarlyHint>\n  allLinks: Array<string>\n}\n```\n\n`hints` is the structured form for the current phase. `links` is the serialized HTTP `Link` header form for the current phase. Both are deduped across phases, contain only new values, and are index-aligned.\n\n`allHints` and `allLinks` contain all deduped values collected so far for the request. They are also index-aligned, and are useful when you want to write one combined `103` response during the `dynamic` phase.\n\nThe `responseLinkHeader.filter` callback receives entries with this shape:\n\n```ts\ntype ResponseLinkHeaderEntry = {\n  phase: 'static' | 'dynamic'\n  hint: EarlyHint\n  link: string\n}\n```\n\n## Supported Links\n\nStart emits Early Hints for link relations that map cleanly to HTTP `Link` headers:\n\n- `preload`\n- `modulepreload`\n- `preconnect`\n- `dns-prefetch`\n\nStart serializes these attributes when present:\n\n- `href`\n- `rel`\n- `as`\n- `crossOrigin`\n- `type`\n- `integrity`\n- `referrerPolicy`\n- `fetchPriority`\n\nOther head tags, inline styles, route scripts, and metadata are not converted into Early Hints.\n\nHTML Early Hints processing does not apply `media`, `imageSrcSet`, or `imageSizes` until the final document exists, so Start does not serialize those attributes into `103` links.\n\n## Runtime Example: Node\n\nIf your runtime exposes Node's `ServerResponse`, call `writeEarlyHints` with `links`. This example sends the earliest `static` hints:\n\n```tsx\n// src/server.ts\nimport handler, { createServerEntry } from '@tanstack/solid-start/server-entry'\nimport type { ServerResponse } from 'node:http'\n\nexport default createServerEntry({\n  fetch(request) {\n    return handler.fetch(request, {\n      onEarlyHints: ({ phase, links }) => {\n        if (phase !== 'static' || !links.length) return\n\n        const response = getNodeResponseSomehow(request) as\n          | ServerResponse\n          | undefined\n\n        response?.writeEarlyHints({ link: links })\n      },\n    })\n  },\n})\n```\n\nReplace `getNodeResponseSomehow` with the API your adapter exposes.\n\n## Runtime Example: srvx / Nitro on Node\n\nNitro uses [srvx](https://srvx.h3.dev/) under the hood for Node deployments. srvx exposes the native Node response on the request runtime context. This example waits for `dynamic` to send one redirect-safe response with both static and dynamic links:\n\n```tsx\n// src/server.ts\nimport handler from '@tanstack/solid-start/server-entry'\nimport type { ServerRequest } from 'srvx'\n\nexport default {\n  fetch(request: Request) {\n    const serverRequest = request as ServerRequest\n\n    return handler.fetch(request, {\n      onEarlyHints: ({ phase, allLinks }) => {\n        if (phase !== 'dynamic') return\n\n        const response = serverRequest.runtime?.node?.res\n\n        if (response?.writeEarlyHints && allLinks.length) {\n          response.writeEarlyHints({ link: allLinks })\n        }\n      },\n    })\n  },\n}\n```\n\n## Limitations\n\n- Early Hints are skipped in the Start dev server.\n- Start only mutates the response `Link` header when `responseLinkHeader` is enabled.\n- Browsers generally process only the first `103` response for a navigation.\n- Static hints can be sent before `beforeLoad` redirects are known.\n- The runtime or proxy in front of your app must support HTTP `103` responses.\n","originalRawMarkdown":"---\nref: docs/start/framework/react/guide/early-hints.md\nreplace:\n  { '@tanstack/react-start': '@tanstack/solid-start', 'React': 'SolidJS' }\n---\n"}
