NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"heading","depth":2,"id":"error-boundaries-solid-start","children":[{"type":"text","value":"Error Boundaries (Solid Start)"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Start uses TanStack Router's route-level error boundaries."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Set a default for all routes via the router"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Override per-route with "},{"type":"inlineCode","value":"errorComponent"}]}]}]},{"type":"heading","depth":3,"id":"configure-a-default","children":[{"type":"text","value":"Configure a default"}]},{"type":"code","value":"// src/router.tsx\nimport { createRouter, ErrorComponent } from '@tanstack/solid-router'\nimport { routeTree } from './routeTree.gen'\n\nexport function getRouter() {\n  const router = createRouter({\n    routeTree,\n    // Shown when an error bubbles to the router\n    defaultErrorComponent: ({ error, reset }) => (\n      <ErrorComponent error={error} />\n    ),\n  })\n  return router\n}","lang":"tsx"},{"type":"heading","depth":3,"id":"per-route-override","children":[{"type":"text","value":"Per-route override"}]},{"type":"code","value":"// src/routes/posts.$postId.tsx\nimport { createFileRoute, ErrorComponent } from '@tanstack/solid-router'\nimport type { ErrorComponentProps } from '@tanstack/solid-router'\n\nfunction PostError({ error, reset }: ErrorComponentProps) {\n  return <ErrorComponent error={error} />\n}\n\nexport const Route = createFileRoute('/posts/$postId')({\n  component: PostComponent,\n  errorComponent: PostError,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Notes:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"ErrorComponent"},{"type":"text","value":" is a simple built-in UI you can replace."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Call "},{"type":"inlineCode","value":"reset()"},{"type":"text","value":" to retry rendering the route after fixing state."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"beforeLoad"},{"type":"text","value":"/"},{"type":"inlineCode","value":"loader"},{"type":"text","value":" to throw errors that will be caught."}]}]}]}],"headings":[{"id":"error-boundaries-solid-start","text":"Error Boundaries (Solid Start)","level":2},{"id":"configure-a-default","text":"Configure a default","level":3},{"id":"per-route-override","text":"Per-route override","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Error Boundaries (Solid Start)\n\nTanStack Start uses TanStack Router's route-level error boundaries.\n\n- Set a default for all routes via the router\n- Override per-route with `errorComponent`\n\n### Configure a default\n\n```tsx\n// src/router.tsx\nimport { createRouter, ErrorComponent } from '@tanstack/solid-router'\nimport { routeTree } from './routeTree.gen'\n\nexport function getRouter() {\n  const router = createRouter({\n    routeTree,\n    // Shown when an error bubbles to the router\n    defaultErrorComponent: ({ error, reset }) => (\n      <ErrorComponent error={error} />\n    ),\n  })\n  return router\n}\n```\n\n### Per-route override\n\n```tsx\n// src/routes/posts.$postId.tsx\nimport { createFileRoute, ErrorComponent } from '@tanstack/solid-router'\nimport type { ErrorComponentProps } from '@tanstack/solid-router'\n\nfunction PostError({ error, reset }: ErrorComponentProps) {\n  return <ErrorComponent error={error} />\n}\n\nexport const Route = createFileRoute('/posts/$postId')({\n  component: PostComponent,\n  errorComponent: PostError,\n})\n```\n\nNotes:\n\n- `ErrorComponent` is a simple built-in UI you can replace.\n- Call `reset()` to retry rendering the route after fixing state.\n- Use `beforeLoad`/`loader` to throw errors that will be caught.\n","originalRawMarkdown":"---\nref: docs/start/framework/react/guide/error-boundaries.md\nreplace:\n  {\n    '@tanstack/react-router': '@tanstack/solid-router',\n    'React Start': 'Solid Start',\n  }\n---\n"}
