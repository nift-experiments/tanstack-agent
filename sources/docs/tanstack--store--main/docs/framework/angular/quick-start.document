NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The basic angular app example to get started with the TanStack angular-store."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"app.component.ts"}]}]},{"type":"code","value":"import { Component } from '@angular/core'\nimport { DisplayComponent } from './display.component'\nimport { IncrementComponent } from './increment.component'\n\n@Component({\nselector: 'app-root',\nimports: [DisplayComponent, IncrementComponent],\ntemplate: `\n<h1>How many of your friends like cats or dogs?</h1>\n<p>\n  Press one of the buttons to add a counter of how many of your friends like\n  cats or dogs\n</p>\n<app-increment animal=\"dogs\" />\n<app-display animal=\"dogs\" />\n<app-increment animal=\"cats\" />\n<app-display animal=\"cats\" />\n`,\n})\nexport class AppComponent {}\n","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"store.ts"}]}]},{"type":"code","value":"import { createStore } from '@tanstack/angular-store';\n\n// You can instantiate the store outside of Angular components too!\nexport const store = createStore({\n  dogs: 0,\n  cats: 0,\n});\n\nexport function updateState(animal: 'dogs' | 'cats') {\n  store.setState((state) => {\n    return {\n      ...state,\n      [animal]: state[animal] + 1,\n    };\n  });\n}","lang":"typescript"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"display.component.ts"}]}]},{"type":"code","value":"import { injectSelector } from '@tanstack/angular-store';\nimport { store } from './store';\n\n@Component({\n    selector: 'app-display',\n    template: `\n        <!-- This will only re-render when animal changes. If an unrelated store property changes, it won't re-render -->\n        <div>{{ animal() }}: {{ count() }}</div>\n    `,\n    standalone: true\n})\nexport class Display {\n    animal = input.required<string>();\n    count = injectSelector(store, (state) => state[this.animal()]);\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"increment.component.ts"}]}]},{"type":"code","value":"import { injectStore } from '@tanstack/angular-store';\nimport { store, updateState } from './store';\n\n@Component({\n    selector: 'app-increment',\n    template: `\n        <button (click)=\"updateState(animal())\">My Friend Likes {{ animal() }}</button>\n    `,\n    standalone: true\n})\nexport class Increment {\n    animal = input.required<string>();\n    updateState = updateState;\n}","lang":"angular-ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"injectStore"},{"type":"text","value":" remains available as a deprecated alias to "},{"type":"inlineCode","value":"injectSelector"},{"type":"text","value":"."}]}],"headings":[]},"frameworks":[],"downloadMarkdown":"\nThe basic angular app example to get started with the TanStack angular-store.\n\n**app.component.ts**\n```angular-ts\nimport { Component } from '@angular/core'\nimport { DisplayComponent } from './display.component'\nimport { IncrementComponent } from './increment.component'\n\n@Component({\nselector: 'app-root',\nimports: [DisplayComponent, IncrementComponent],\ntemplate: `\n<h1>How many of your friends like cats or dogs?</h1>\n<p>\n  Press one of the buttons to add a counter of how many of your friends like\n  cats or dogs\n</p>\n<app-increment animal=\"dogs\" />\n<app-display animal=\"dogs\" />\n<app-increment animal=\"cats\" />\n<app-display animal=\"cats\" />\n`,\n})\nexport class AppComponent {}\n\n```\n\n**store.ts**\n```typescript\nimport { createStore } from '@tanstack/angular-store';\n\n// You can instantiate the store outside of Angular components too!\nexport const store = createStore({\n  dogs: 0,\n  cats: 0,\n});\n\nexport function updateState(animal: 'dogs' | 'cats') {\n  store.setState((state) => {\n    return {\n      ...state,\n      [animal]: state[animal] + 1,\n    };\n  });\n}\n```\n\n**display.component.ts**\n```angular-ts\nimport { injectSelector } from '@tanstack/angular-store';\nimport { store } from './store';\n\n@Component({\n    selector: 'app-display',\n    template: `\n        <!-- This will only re-render when animal changes. If an unrelated store property changes, it won't re-render -->\n        <div>{{ animal() }}: {{ count() }}</div>\n    `,\n    standalone: true\n})\nexport class Display {\n    animal = input.required<string>();\n    count = injectSelector(store, (state) => state[this.animal()]);\n}\n```\n\n**increment.component.ts**\n```angular-ts\nimport { injectStore } from '@tanstack/angular-store';\nimport { store, updateState } from './store';\n\n@Component({\n    selector: 'app-increment',\n    template: `\n        <button (click)=\"updateState(animal())\">My Friend Likes {{ animal() }}</button>\n    `,\n    standalone: true\n})\nexport class Increment {\n    animal = input.required<string>();\n    updateState = updateState;\n}\n```\n\n`injectStore` remains available as a deprecated alias to `injectSelector`.\n","originalRawMarkdown":"---\ntitle: Quick Start\nid: quick-start\n---\n\nThe basic angular app example to get started with the TanStack angular-store.\n\n**app.component.ts**\n```angular-ts\nimport { Component } from '@angular/core'\nimport { DisplayComponent } from './display.component'\nimport { IncrementComponent } from './increment.component'\n\n@Component({\nselector: 'app-root',\nimports: [DisplayComponent, IncrementComponent],\ntemplate: `\n<h1>How many of your friends like cats or dogs?</h1>\n<p>\n  Press one of the buttons to add a counter of how many of your friends like\n  cats or dogs\n</p>\n<app-increment animal=\"dogs\" />\n<app-display animal=\"dogs\" />\n<app-increment animal=\"cats\" />\n<app-display animal=\"cats\" />\n`,\n})\nexport class AppComponent {}\n\n```\n\n**store.ts**\n```typescript\nimport { createStore } from '@tanstack/angular-store';\n\n// You can instantiate the store outside of Angular components too!\nexport const store = createStore({\n  dogs: 0,\n  cats: 0,\n});\n\nexport function updateState(animal: 'dogs' | 'cats') {\n  store.setState((state) => {\n    return {\n      ...state,\n      [animal]: state[animal] + 1,\n    };\n  });\n}\n```\n\n**display.component.ts**\n```angular-ts\nimport { injectSelector } from '@tanstack/angular-store';\nimport { store } from './store';\n\n@Component({\n    selector: 'app-display',\n    template: `\n        <!-- This will only re-render when animal changes. If an unrelated store property changes, it won't re-render -->\n        <div>{{ animal() }}: {{ count() }}</div>\n    `,\n    standalone: true\n})\nexport class Display {\n    animal = input.required<string>();\n    count = injectSelector(store, (state) => state[this.animal()]);\n}\n```\n\n**increment.component.ts**\n```angular-ts\nimport { injectStore } from '@tanstack/angular-store';\nimport { store, updateState } from './store';\n\n@Component({\n    selector: 'app-increment',\n    template: `\n        <button (click)=\"updateState(animal())\">My Friend Likes {{ animal() }}</button>\n    `,\n    standalone: true\n})\nexport class Increment {\n    animal = input.required<string>();\n    updateState = updateState;\n}\n```\n\n`injectStore` remains available as a deprecated alias to `injectSelector`.\n"}
