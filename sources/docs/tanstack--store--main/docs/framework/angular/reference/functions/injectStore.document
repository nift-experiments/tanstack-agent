ers"}]},{"type":"heading","depth":3,"id":"store","children":[{"type":"text","value":"store"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Store"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TState"},{"type":"text","value":", "},{"type":"inlineCode","value":"TActions"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/InjectSelectorOptions.md","children":[{"type":"inlineCode","value":"InjectSelectorOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"["},{"type":"inlineCode","value":"Signal"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">, ["},{"type":"inlineCode","value":"TActions"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"never"},{"type":"text","value":"] ? ("},{"type":"inlineCode","value":"updater"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"},{"type":"text","value":" : "},{"type":"inlineCode","value":"TActions"},{"type":"text","value":"]"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Store with actions\nreadonly result = _injectStore(petStore, (s) => s.cats)\n// result[0] is Signal<number>, result[1] is actions\n\n// Store without actions\nreadonly result = _injectStore(plainStore, (s) => s)\n// result[0] is Signal<number>, result[1] is setState","lang":"ts"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tstate","text":"TState","level":3},{"id":"tactions","text":"TActions","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"store","text":"store","level":3},{"id":"selector","text":"selector","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction _injectStore<TState, TActions, TSelected>(\n   store, \n   selector, \n   options?): [Signal<TSelected>, [TActions] extends [never] ? (updater) => void : TActions];\n```\n\nDefined in: [packages/angular-store/src/\\_injectStore.ts:24](https://github.com/TanStack/store/blob/main/packages/angular-store/src/_injectStore.ts#L24)\n\nExperimental combined read+write injection function for stores, mirroring\ninjectAtom's pattern.\n\nReturns `[signal, actions]` when the store has an actions factory, or\n`[signal, setState]` for plain stores.\n\n## Type Parameters\n\n### TState\n\n`TState`\n\n### TActions\n\n`TActions` *extends* `StoreActionMap`\n\n### TSelected\n\n`TSelected` = `NoInfer`\\<`TState`\\>\n\n## Parameters\n\n### store\n\n`Store`\\<`TState`, `TActions`\\>\n\n### selector\n\n(`state`) => `TSelected`\n\n### options?\n\n[`InjectSelectorOptions`](../interfaces/InjectSelectorOptions.md)\\<`TSelected`\\>\n\n## Returns\n\n\\[`Signal`\\<`TSelected`\\>, \\[`TActions`\\] *extends* \\[`never`\\] ? (`updater`) => `void` : `TActions`\\]\n\n## Example\n\n```ts\n// Store with actions\nreadonly result = _injectStore(petStore, (s) => s.cats)\n// result[0] is Signal<number>, result[1] is actions\n\n// Store without actions\nreadonly result = _injectStore(plainStore, (s) => s)\n// result[0] is Signal<number>, result[1] is setState\n```\n","originalRawMarkdown":"---\nid: _injectStore\ntitle: _injectStore\n---\n\n```ts\nfunction _injectStore<TState, TActions, TSelected>(\n   store, \n   selector, \n   options?): [Signal<TSelected>, [TActions] extends [never] ? (updater) => void : TActions];\n```\n\nDefined in: [packages/angular-store/src/\\_injectStore.ts:24](https://github.com/TanStack/store/blob/main/packages/angular-store/src/_injectStore.ts#L24)\n\nExperimental combined read+write injection function for stores, mirroring\ninjectAtom's pattern.\n\nReturns `[signal, actions]` when the store has an actions factory, or\n`[signal, setState]` for plain stores.\n\n## Type Parameters\n\n### TState\n\n`TState`\n\n### TActions\n\n`TActions` *extends* `StoreActionMap`\n\n### TSelected\n\n`TSelected` = `NoInfer`\\<`TState`\\>\n\n## Parameters\n\n### store\n\n`Store`\\<`TState`, `TActions`\\>\n\n### selector\n\n(`state`) => `TSelected`\n\n### options?\n\n[`InjectSelectorOptions`](../interfaces/InjectSelectorOptions.md)\\<`TSelected`\\>\n\n## Returns\n\n\\[`Signal`\\<`TSelected`\\>, \\[`TActions`\\] *extends* \\[`never`\\] ? (`updater`) => `void` : `TActions`\\]\n\n## Example\n\n```ts\n// Store with actions\nreadonly result = _injectStore(petStore, (s) => s.cats)\n// result[0] is Signal<number>, result[1] is actions\n\n// Store without actions\nreadonly result = _injectStore(plainStore, (s) => s)\n// result[0] is Signal<number>, result[1] is setState\n```\n"}
