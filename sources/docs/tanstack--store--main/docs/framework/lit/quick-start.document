NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The basic Lit app example to get started with TanStack "},{"type":"inlineCode","value":"lit-store"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"You can use "},{"type":"inlineCode","value":"TanStackStoreSelector"},{"type":"text","value":" in two ways:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Trigger rerenders when a selected slice changes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Access the selected value directly through "},{"type":"inlineCode","value":".value"}]}]}]},{"type":"code","value":"import { LitElement, html } from 'lit'\nimport { customElement, property } from 'lit/decorators.js'\nimport { TanStackStoreSelector, createStore } from '@tanstack/lit-store'\n\n// You can instantiate a Store outside of Lit components too!\nexport const store = createStore({\n  dogs: 0,\n  cats: 0,\n})\n\ntype Animal = 'dogs' | 'cats'\n\nconst updateState = (animal: Animal) => {\n  store.setState((state) => ({\n    ...state,\n    [animal]: state[animal] + 1,\n  }))\n}\n\n@customElement('animal-display')\nexport class AnimalDisplay extends LitElement {\n  @property({ type: String }) animal: Animal = 'dogs'\n\n  // Subscribes only to `state[animal]`\n  counter = new TanStackStoreSelector(\n    this,\n    () => store,\n    (state) => state[this.animal],\n  )\n\n  render() {\n    return html`\n      <div>\n        <p>\n          Using selector.value:\n          ${this.counter.value}\n        </p>\n\n        <p>\n          Reading directly from store.state:\n          ${store.state[this.animal]}\n        </p>\n      </div>\n    `\n  }\n}\n\n@customElement('animal-increment')\nexport class AnimalIncrement extends LitElement {\n  @property({ type: String }) animal: Animal = 'dogs'\n\n  render() {\n    return html`\n      <button @click=${() => updateState(this.animal)}>\n        My Friend Likes ${this.animal}\n      </button>\n    `\n  }\n}\n\n@customElement('tanstack-store-demo')\nexport class TanStackStoreDemo extends LitElement {\n  render() {\n    return html`\n      <div>\n        <h1>How many of your friends like cats or dogs?</h1>\n\n        <p>\n          Press one of the buttons to increment how many of your friends\n          like cats or dogs.\n        </p>\n\n        <animal-increment animal=\"dogs\"></animal-increment>\n        <animal-display animal=\"dogs\"></animal-display>\n\n        <animal-increment animal=\"cats\"></animal-increment>\n        <animal-display animal=\"cats\"></animal-display>\n      </div>\n    `\n  }\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"selector.value"},{"type":"text","value":" returns the latest selected value and only updates when\nthat specific selection changes."}]},{"type":"paragraph","children":[{"type":"text","value":"Reading from "},{"type":"inlineCode","value":"store.state"},{"type":"text","value":" accesses the full store state directly. The\ncomponent still rerenders because the selector subscription is active,\nbut the rendered value itself comes from the store."}]},{"type":"paragraph","children":[{"type":"text","value":"Then mount the root element in your HTML:"}]},{"type":"code","value":"<tanstack-store-demo></tanstack-store-demo>\n<script type=\"module\" src=\"/src/index.ts\"></script>","lang":"html"}],"headings":[]},"frameworks":[],"downloadMarkdown":"\nThe basic Lit app example to get started with TanStack `lit-store`.\n\nYou can use `TanStackStoreSelector` in two ways:\n\n- Trigger rerenders when a selected slice changes\n- Access the selected value directly through `.value`\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement, property } from 'lit/decorators.js'\nimport { TanStackStoreSelector, createStore } from '@tanstack/lit-store'\n\n// You can instantiate a Store outside of Lit components too!\nexport const store = createStore({\n  dogs: 0,\n  cats: 0,\n})\n\ntype Animal = 'dogs' | 'cats'\n\nconst updateState = (animal: Animal) => {\n  store.setState((state) => ({\n    ...state,\n    [animal]: state[animal] + 1,\n  }))\n}\n\n@customElement('animal-display')\nexport class AnimalDisplay extends LitElement {\n  @property({ type: String }) animal: Animal = 'dogs'\n\n  // Subscribes only to `state[animal]`\n  counter = new TanStackStoreSelector(\n    this,\n    () => store,\n    (state) => state[this.animal],\n  )\n\n  render() {\n    return html`\n      <div>\n        <p>\n          Using selector.value:\n          ${this.counter.value}\n        </p>\n\n        <p>\n          Reading directly from store.state:\n          ${store.state[this.animal]}\n        </p>\n      </div>\n    `\n  }\n}\n\n@customElement('animal-increment')\nexport class AnimalIncrement extends LitElement {\n  @property({ type: String }) animal: Animal = 'dogs'\n\n  render() {\n    return html`\n      <button @click=${() => updateState(this.animal)}>\n        My Friend Likes ${this.animal}\n      </button>\n    `\n  }\n}\n\n@customElement('tanstack-store-demo')\nexport class TanStackStoreDemo extends LitElement {\n  render() {\n    return html`\n      <div>\n        <h1>How many of your friends like cats or dogs?</h1>\n\n        <p>\n          Press one of the buttons to increment how many of your friends\n          like cats or dogs.\n        </p>\n\n        <animal-increment animal=\"dogs\"></animal-increment>\n        <animal-display animal=\"dogs\"></animal-display>\n\n        <animal-increment animal=\"cats\"></animal-increment>\n        <animal-display animal=\"cats\"></animal-display>\n      </div>\n    `\n  }\n}\n```\n\n`selector.value` returns the latest selected value and only updates when\nthat specific selection changes.\n\nReading from `store.state` accesses the full store state directly. The\ncomponent still rerenders because the selector subscription is active,\nbut the rendered value itself comes from the store.\n\nThen mount the root element in your HTML:\n\n```html\n<tanstack-store-demo></tanstack-store-demo>\n<script type=\"module\" src=\"/src/index.ts\"></script>\n```\n","originalRawMarkdown":"---\ntitle: Quick Start\nid: quick-start\n---\n\nThe basic Lit app example to get started with TanStack `lit-store`.\n\nYou can use `TanStackStoreSelector` in two ways:\n\n- Trigger rerenders when a selected slice changes\n- Access the selected value directly through `.value`\n\n```ts\nimport { LitElement, html } from 'lit'\nimport { customElement, property } from 'lit/decorators.js'\nimport { TanStackStoreSelector, createStore } from '@tanstack/lit-store'\n\n// You can instantiate a Store outside of Lit components too!\nexport const store = createStore({\n  dogs: 0,\n  cats: 0,\n})\n\ntype Animal = 'dogs' | 'cats'\n\nconst updateState = (animal: Animal) => {\n  store.setState((state) => ({\n    ...state,\n    [animal]: state[animal] + 1,\n  }))\n}\n\n@customElement('animal-display')\nexport class AnimalDisplay extends LitElement {\n  @property({ type: String }) animal: Animal = 'dogs'\n\n  // Subscribes only to `state[animal]`\n  counter = new TanStackStoreSelector(\n    this,\n    () => store,\n    (state) => state[this.animal],\n  )\n\n  render() {\n    return html`\n      <div>\n        <p>\n          Using selector.value:\n          ${this.counter.value}\n        </p>\n\n        <p>\n          Reading directly from store.state:\n          ${store.state[this.animal]}\n        </p>\n      </div>\n    `\n  }\n}\n\n@customElement('animal-increment')\nexport class AnimalIncrement extends LitElement {\n  @property({ type: String }) animal: Animal = 'dogs'\n\n  render() {\n    return html`\n      <button @click=${() => updateState(this.animal)}>\n        My Friend Likes ${this.animal}\n      </button>\n    `\n  }\n}\n\n@customElement('tanstack-store-demo')\nexport class TanStackStoreDemo extends LitElement {\n  render() {\n    return html`\n      <div>\n        <h1>How many of your friends like cats or dogs?</h1>\n\n        <p>\n          Press one of the buttons to increment how many of your friends\n          like cats or dogs.\n        </p>\n\n        <animal-increment animal=\"dogs\"></animal-increment>\n        <animal-display animal=\"dogs\"></animal-display>\n\n        <animal-increment animal=\"cats\"></animal-increment>\n        <animal-display animal=\"cats\"></animal-display>\n      </div>\n    `\n  }\n}\n```\n\n`selector.value` returns the latest selected value and only updates when\nthat specific selection changes.\n\nReading from `store.state` accesses the full store state directly. The\ncomponent still rerenders because the selector subscription is active,\nbut the rendered value itself comes from the store.\n\nThen mount the root element in your HTML:\n\n```html\n<tanstack-store-demo></tanstack-store-demo>\n<script type=\"module\" src=\"/src/index.ts\"></script>\n```\n"}
