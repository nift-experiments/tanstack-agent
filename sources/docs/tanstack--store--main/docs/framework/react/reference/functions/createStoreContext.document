graph","children":[{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":3,"id":"storeprovider","children":[{"type":"text","value":"StoreProvider()"}]},{"type":"code","value":"StoreProvider: (props) => ReactElement;","lang":"ts"},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"props","children":[{"type":"text","value":"props"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"object"},{"type":"text","value":" & "},{"type":"inlineCode","value":"object"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactElement"}]},{"type":"heading","depth":3,"id":"usestorecontext","children":[{"type":"text","value":"useStoreContext()"}]},{"type":"code","value":"useStoreContext: () => TValue;","lang":"ts"},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const { StoreProvider, useStoreContext } = createStoreContext<{\n  countAtom: Atom<number>\n  totalsStore: Store<{ count: number }>\n}>()\n\nfunction CountButton() {\n  const { countAtom, totalsStore } = useStoreContext()\n  const count = useSelector(countAtom)\n  const total = useSelector(totalsStore, (state) => state.count)\n\n  return (\n    <button\n      type=\"button\"\n      onClick={() => totalsStore.setState((state) => ({ ...state, count: state.count + 1 }))}\n    >\n      {count} / {total}\n    </button>\n  )\n}","lang":"tsx"},{"type":"heading","depth":2,"id":"throws","children":[{"type":"text","value":"Throws"}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"useStoreContext()"},{"type":"text","value":" is called outside the matching "},{"type":"inlineCode","value":"StoreProvider"},{"type":"text","value":"."}]}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"returns","text":"Returns","level":2},{"id":"storeprovider","text":"StoreProvider()","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"props","text":"props","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"usestorecontext","text":"useStoreContext()","level":3},{"id":"returns-3","text":"Returns","level":4},{"id":"example","text":"Example","level":2},{"id":"throws","text":"Throws","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction createStoreContext<TValue>(): object;\n```\n\nDefined in: [packages/react-store/src/createStoreContext.tsx:40](https://github.com/TanStack/store/blob/main/packages/react-store/src/createStoreContext.tsx#L40)\n\nCreates a typed React context for sharing a bundle of atoms and stores with a subtree.\n\nThe returned `StoreProvider` only transports the provided object through\nReact context. Consumers destructure the contextual atoms and stores, then\ncompose them with the existing hooks like [useSelector](useSelector.md),\n[useSelector](useSelector.md) and [useAtom](useAtom.md).\n\nThe object shape is preserved exactly, so keyed atoms and stores remain fully\ntyped when read back with `useStoreContext()`.\n\n## Type Parameters\n\n### TValue\n\n`TValue` *extends* `object`\n\n## Returns\n\n`object`\n\n### StoreProvider()\n\n```ts\nStoreProvider: (props) => ReactElement;\n```\n\n#### Parameters\n\n##### props\n\n`object` & `object`\n\n#### Returns\n\n`ReactElement`\n\n### useStoreContext()\n\n```ts\nuseStoreContext: () => TValue;\n```\n\n#### Returns\n\n`TValue`\n\n## Example\n\n```tsx\nconst { StoreProvider, useStoreContext } = createStoreContext<{\n  countAtom: Atom<number>\n  totalsStore: Store<{ count: number }>\n}>()\n\nfunction CountButton() {\n  const { countAtom, totalsStore } = useStoreContext()\n  const count = useSelector(countAtom)\n  const total = useSelector(totalsStore, (state) => state.count)\n\n  return (\n    <button\n      type=\"button\"\n      onClick={() => totalsStore.setState((state) => ({ ...state, count: state.count + 1 }))}\n    >\n      {count} / {total}\n    </button>\n  )\n}\n```\n\n## Throws\n\nWhen `useStoreContext()` is called outside the matching `StoreProvider`.\n","originalRawMarkdown":"---\nid: createStoreContext\ntitle: createStoreContext\n---\n\n```ts\nfunction createStoreContext<TValue>(): object;\n```\n\nDefined in: [packages/react-store/src/createStoreContext.tsx:40](https://github.com/TanStack/store/blob/main/packages/react-store/src/createStoreContext.tsx#L40)\n\nCreates a typed React context for sharing a bundle of atoms and stores with a subtree.\n\nThe returned `StoreProvider` only transports the provided object through\nReact context. Consumers destructure the contextual atoms and stores, then\ncompose them with the existing hooks like [useSelector](useSelector.md),\n[useSelector](useSelector.md) and [useAtom](useAtom.md).\n\nThe object shape is preserved exactly, so keyed atoms and stores remain fully\ntyped when read back with `useStoreContext()`.\n\n## Type Parameters\n\n### TValue\n\n`TValue` *extends* `object`\n\n## Returns\n\n`object`\n\n### StoreProvider()\n\n```ts\nStoreProvider: (props) => ReactElement;\n```\n\n#### Parameters\n\n##### props\n\n`object` & `object`\n\n#### Returns\n\n`ReactElement`\n\n### useStoreContext()\n\n```ts\nuseStoreContext: () => TValue;\n```\n\n#### Returns\n\n`TValue`\n\n## Example\n\n```tsx\nconst { StoreProvider, useStoreContext } = createStoreContext<{\n  countAtom: Atom<number>\n  totalsStore: Store<{ count: number }>\n}>()\n\nfunction CountButton() {\n  const { countAtom, totalsStore } = useStoreContext()\n  const count = useSelector(countAtom)\n  const total = useSelector(totalsStore, (state) => state.count)\n\n  return (\n    <button\n      type=\"button\"\n      onClick={() => totalsStore.setState((state) => ({ ...state, count: state.count + 1 }))}\n    >\n      {count} / {total}\n    </button>\n  )\n}\n```\n\n## Throws\n\nWhen `useStoreContext()` is called outside the matching `StoreProvider`.\n"}
