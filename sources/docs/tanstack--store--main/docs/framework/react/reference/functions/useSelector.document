:"TSource"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"snapshot"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/UseSelectorOptions.md","children":[{"type":"inlineCode","value":"UseSelectorOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code","value":"const count = useSelector(counterStore, (state) => state.count)","lang":"tsx"},{"type":"code","value":"const value = useSelector(countAtom)","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tsource","text":"TSource","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"source","text":"source","level":3},{"id":"selector","text":"selector","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"examples","text":"Examples","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useSelector<TSource, TSelected>(\n   source, \n   selector, \n   options?): TSelected;\n```\n\nDefined in: [packages/react-store/src/useSelector.ts:43](https://github.com/TanStack/store/blob/main/packages/react-store/src/useSelector.ts#L43)\n\nSelects a slice of state from an atom or store and subscribes the component\nto that selection.\n\nThis is the primary React read hook for TanStack Store. It works with any\nsource that exposes `get()` and `subscribe()`, including atoms, readonly\natoms, stores, and readonly stores.\n\nOmit the selector to subscribe to the whole value.\n\n## Type Parameters\n\n### TSource\n\n`TSource`\n\n### TSelected\n\n`TSelected` = `NoInfer`\\<`TSource`\\>\n\n## Parameters\n\n### source\n\n`SelectionSource`\\<`TSource`\\>\n\n### selector\n\n(`snapshot`) => `TSelected`\n\n### options?\n\n[`UseSelectorOptions`](../interfaces/UseSelectorOptions.md)\\<`TSelected`\\>\n\n## Returns\n\n`TSelected`\n\n## Examples\n\n```tsx\nconst count = useSelector(counterStore, (state) => state.count)\n```\n\n```tsx\nconst value = useSelector(countAtom)\n```\n","originalRawMarkdown":"---\nid: useSelector\ntitle: useSelector\n---\n\n```ts\nfunction useSelector<TSource, TSelected>(\n   source, \n   selector, \n   options?): TSelected;\n```\n\nDefined in: [packages/react-store/src/useSelector.ts:43](https://github.com/TanStack/store/blob/main/packages/react-store/src/useSelector.ts#L43)\n\nSelects a slice of state from an atom or store and subscribes the component\nto that selection.\n\nThis is the primary React read hook for TanStack Store. It works with any\nsource that exposes `get()` and `subscribe()`, including atoms, readonly\natoms, stores, and readonly stores.\n\nOmit the selector to subscribe to the whole value.\n\n## Type Parameters\n\n### TSource\n\n`TSource`\n\n### TSelected\n\n`TSelected` = `NoInfer`\\<`TSource`\\>\n\n## Parameters\n\n### source\n\n`SelectionSource`\\<`TSource`\\>\n\n### selector\n\n(`snapshot`) => `TSelected`\n\n### options?\n\n[`UseSelectorOptions`](../interfaces/UseSelectorOptions.md)\\<`TSelected`\\>\n\n## Returns\n\n`TSelected`\n\n## Examples\n\n```tsx\nconst count = useSelector(counterStore, (state) => state.count)\n```\n\n```tsx\nconst value = useSelector(countAtom)\n```\n"}
