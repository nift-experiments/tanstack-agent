,{"type":"inlineCode","value":"void"},{"type":"text","value":" & ("},{"type":"inlineCode","value":"value"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"},{"type":"text","value":"]"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const [count, setCount] = useAtom(countAtom)\n\nreturn (\n  <button type=\"button\" onClick={() => setCount((prev) => prev + 1)}>\n    {count()}\n  </button>\n)","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"atom","text":"atom","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction useAtom<TValue>(atom, options?): [Accessor<TValue>, (fn) => void & (value) => void];\n```\n\nDefined in: [solid-store/src/useAtom.ts:23](https://github.com/TanStack/store/blob/main/packages/solid-store/src/useAtom.ts#L23)\n\nReturns the current atom accessor together with a setter.\n\nUse this when a component needs to both read and update the same writable\natom.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Parameters\n\n### atom\n\n`Atom`\\<`TValue`\\>\n\n### options?\n\n[`UseSelectorOptions`](../interfaces/UseSelectorOptions.md)\\<`TValue`\\>\n\n## Returns\n\n\\[`Accessor`\\<`TValue`\\>, (`fn`) => `void` & (`value`) => `void`\\]\n\n## Example\n\n```tsx\nconst [count, setCount] = useAtom(countAtom)\n\nreturn (\n  <button type=\"button\" onClick={() => setCount((prev) => prev + 1)}>\n    {count()}\n  </button>\n)\n```\n","originalRawMarkdown":"---\nid: useAtom\ntitle: useAtom\n---\n\n```ts\nfunction useAtom<TValue>(atom, options?): [Accessor<TValue>, (fn) => void & (value) => void];\n```\n\nDefined in: [solid-store/src/useAtom.ts:23](https://github.com/TanStack/store/blob/main/packages/solid-store/src/useAtom.ts#L23)\n\nReturns the current atom accessor together with a setter.\n\nUse this when a component needs to both read and update the same writable\natom.\n\n## Type Parameters\n\n### TValue\n\n`TValue`\n\n## Parameters\n\n### atom\n\n`Atom`\\<`TValue`\\>\n\n### options?\n\n[`UseSelectorOptions`](../interfaces/UseSelectorOptions.md)\\<`TValue`\\>\n\n## Returns\n\n\\[`Accessor`\\<`TValue`\\>, (`fn`) => `void` & (`value`) => `void`\\]\n\n## Example\n\n```tsx\nconst [count, setCount] = useAtom(countAtom)\n\nreturn (\n  <button type=\"button\" onClick={() => setCount((prev) => prev + 1)}>\n    {count()}\n  </button>\n)\n```\n"}
