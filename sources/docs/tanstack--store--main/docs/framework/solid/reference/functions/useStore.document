depth":3,"id":"store","children":[{"type":"text","value":"store"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Store"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TState"},{"type":"text","value":", "},{"type":"inlineCode","value":"TActions"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options?"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/UseSelectorOptions.md","children":[{"type":"inlineCode","value":"UseSelectorOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"["},{"type":"inlineCode","value":"Accessor"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">, ["},{"type":"inlineCode","value":"TActions"},{"type":"text","value":"] "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" ["},{"type":"inlineCode","value":"never"},{"type":"text","value":"] ? ("},{"type":"inlineCode","value":"updater"},{"type":"text","value":") => "},{"type":"inlineCode","value":"void"},{"type":"text","value":" : "},{"type":"inlineCode","value":"TActions"},{"type":"text","value":"]"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Store with actions\nconst [cats, { addCat }] = _useStore(petStore, (s) => s.cats)\n\n// Store without actions\nconst [count, setState] = _useStore(plainStore, (s) => s)\nsetState((prev) => prev + 1)","lang":"tsx"}],"headings":[{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tstate","text":"TState","level":3},{"id":"tactions","text":"TActions","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"store","text":"store","level":3},{"id":"selector","text":"selector","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n```ts\nfunction _useStore<TState, TActions, TSelected>(\n   store, \n   selector, \n   options?): [Accessor<TSelected>, [TActions] extends [never] ? (updater) => void : TActions];\n```\n\nDefined in: [solid-store/src/\\_useStore.ts:23](https://github.com/TanStack/store/blob/main/packages/solid-store/src/_useStore.ts#L23)\n\nExperimental combined read+write hook for stores, mirroring useAtom's tuple\npattern.\n\nReturns `[selected, actions]` when the store has an actions factory, or\n`[selected, setState]` for plain stores.\n\n## Type Parameters\n\n### TState\n\n`TState`\n\n### TActions\n\n`TActions` *extends* `StoreActionMap`\n\n### TSelected\n\n`TSelected` = `NoInfer`\\<`TState`\\>\n\n## Parameters\n\n### store\n\n`Store`\\<`TState`, `TActions`\\>\n\n### selector\n\n(`state`) => `TSelected`\n\n### options?\n\n[`UseSelectorOptions`](../interfaces/UseSelectorOptions.md)\\<`TSelected`\\>\n\n## Returns\n\n\\[`Accessor`\\<`TSelected`\\>, \\[`TActions`\\] *extends* \\[`never`\\] ? (`updater`) => `void` : `TActions`\\]\n\n## Example\n\n```tsx\n// Store with actions\nconst [cats, { addCat }] = _useStore(petStore, (s) => s.cats)\n\n// Store without actions\nconst [count, setState] = _useStore(plainStore, (s) => s)\nsetState((prev) => prev + 1)\n```\n","originalRawMarkdown":"---\nid: _useStore\ntitle: _useStore\n---\n\n```ts\nfunction _useStore<TState, TActions, TSelected>(\n   store, \n   selector, \n   options?): [Accessor<TSelected>, [TActions] extends [never] ? (updater) => void : TActions];\n```\n\nDefined in: [solid-store/src/\\_useStore.ts:23](https://github.com/TanStack/store/blob/main/packages/solid-store/src/_useStore.ts#L23)\n\nExperimental combined read+write hook for stores, mirroring useAtom's tuple\npattern.\n\nReturns `[selected, actions]` when the store has an actions factory, or\n`[selected, setState]` for plain stores.\n\n## Type Parameters\n\n### TState\n\n`TState`\n\n### TActions\n\n`TActions` *extends* `StoreActionMap`\n\n### TSelected\n\n`TSelected` = `NoInfer`\\<`TState`\\>\n\n## Parameters\n\n### store\n\n`Store`\\<`TState`, `TActions`\\>\n\n### selector\n\n(`state`) => `TSelected`\n\n### options?\n\n[`UseSelectorOptions`](../interfaces/UseSelectorOptions.md)\\<`TSelected`\\>\n\n## Returns\n\n\\[`Accessor`\\<`TSelected`\\>, \\[`TActions`\\] *extends* \\[`never`\\] ? (`updater`) => `void` : `TActions`\\]\n\n## Example\n\n```tsx\n// Store with actions\nconst [cats, { addCat }] = _useStore(petStore, (s) => s.cats)\n\n// Store without actions\nconst [count, setState] = _useStore(plainStore, (s) => s)\nsetState((prev) => prev + 1)\n```\n"}
