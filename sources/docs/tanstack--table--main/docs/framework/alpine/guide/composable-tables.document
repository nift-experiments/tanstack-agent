value":"."}]},{"type":"code","value":"import {\n  createSortedRowModel,\n  createTableHook,\n  rowSortingFeature,\n  sortFns,\n  tableFeatures,\n} from '@tanstack/alpine-table'\n\nconst features = tableFeatures({\n  rowSortingFeature,\n  sortedRowModel: createSortedRowModel(),\n  sortFns,\n})\n\nconst { createAppTable, createAppColumnHelper } = createTableHook({\n  features,\n  debugTable: true,\n  enableSortingRemoval: false,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Options passed to "},{"type":"inlineCode","value":"createTableHook"},{"type":"text","value":" become defaults for every table created by "},{"type":"inlineCode","value":"createAppTable"},{"type":"text","value":". The "},{"type":"inlineCode","value":"features"},{"type":"text","value":" option is also bound to the returned column helper, so column definitions know that sorting APIs are available."}]},{"type":"heading","depth":2,"id":"create-app-columns","children":[{"type":"text","value":"Create App Columns"}]},{"type":"paragraph","children":[{"type":"text","value":"Create one column helper per row type. The helper is already bound to your app's feature set, so each table does not need to thread "},{"type":"inlineCode","value":"typeof features"},{"type":"text","value":" through its column definitions. Renderers return HTML strings, which are rendered with "},{"type":"inlineCode","value":"x-html"},{"type":"text","value":" via "},{"type":"inlineCode","value":"table.FlexRender"},{"type":"text","value":"."}]},{"type":"code","value":"type Person = {\n  firstName: string\n  lastName: string\n  age: number\n  visits: number\n}\n\nconst columnHelper = createAppColumnHelper<Person>()\n\nconst columns = columnHelper.columns([\n  columnHelper.accessor('firstName', {\n    cell: (info) => info.getValue(),\n  }),\n  columnHelper.accessor((row) => row.lastName, {\n    id: 'lastName',\n    header: () => '<span>Last Name</span>',\n    cell: (info) => `<i>${info.getValue()}</i>`,\n  }),\n  columnHelper.accessor('age', {\n    header: 'Age',\n  }),\n  columnHelper.accessor('visits', {\n    header: 'Visits',\n  }),\n])","lang":"ts"},{"type":"heading","depth":2,"id":"create-a-table","children":[{"type":"text","value":"Create A Table"}]},{"type":"paragraph","children":[{"type":"text","value":"Create each table with "},{"type":"inlineCode","value":"createAppTable"},{"type":"text","value":" inside an "},{"type":"inlineCode","value":"Alpine.data"},{"type":"text","value":" component. The call site provides table-specific inputs such as "},{"type":"inlineCode","value":"columns"},{"type":"text","value":" and reactive "},{"type":"inlineCode","value":"data"},{"type":"text","value":"; shared features and defaults come from the hook."}]},{"type":"code","value":"import Alpine from 'alpinejs'\n\nAlpine.data('table', () => {\n  const local = Alpine.reactive({ data: [] as Array<Person> })\n\n  const table = createAppTable({\n    columns,\n    get data() {\n      return local.data\n    },\n  })\n\n  return { table }\n})\n\nwindow.Alpine = Alpine\nAlpine.start()","lang":"ts"},{"type":"heading","depth":2,"id":"render-with-the-normal-table-apis","children":[{"type":"text","value":"Render With The Normal Table APIs"}]},{"type":"paragraph","children":[{"type":"text","value":"You render the table with the same table instance APIs used by a standalone "},{"type":"inlineCode","value":"createTable"},{"type":"text","value":" table. "},{"type":"inlineCode","value":"table.FlexRender"},{"type":"text","value":" is attached to the instance, so you do not need to import the top-level helper. Attach the sort click handler to a real element (Alpine does not initialize directives inside "},{"type":"inlineCode","value":"x-html"},{"type":"text","value":")."}]},{"type":"code","value":"<div x-data=\"table\">\n  <table>\n    <thead>\n      <template\n        x-for=\"headerGroup in table.getHeaderGroups()\"\n        :key=\"headerGroup.id\"\n      >\n        <tr>\n          <template x-for=\"header in headerGroup.headers\" :key=\"header.id\">\n            <th @click=\"header.column.getToggleSortingHandler()?.($event)\">\n              <span x-html=\"table.FlexRender({ header })\"></span>\n            </th>\n          </template>\n        </tr>\n      </template>\n    </thead>\n    <tbody>\n      <template x-for=\"row in table.getRowModel().rows\" :key=\"row.id\">\n        <tr>\n          <template x-for=\"cell in row.getAllCells()\" :key=\"cell.id\">\n            <td x-html=\"table.FlexRender({ cell })\"></td>\n          </template>\n        </tr>\n      </template>\n    </tbody>\n  </table>\n</div>","lang":"html"},{"type":"heading","depth":2,"id":"override-shared-defaults-per-table","children":[{"type":"text","value":"Override Shared Defaults Per Table"}]},{"type":"paragraph","children":[{"type":"text","value":"Options passed to "},{"type":"inlineCode","value":"createAppTable"},{"type":"text","value":" override defaults from "},{"type":"inlineCode","value":"createTableHook"},{"type":"text","value":". Use this for the few tables that need different behavior without creating a separate app hook."}]},{"type":"code","value":"const table = createAppTable({\n  columns,\n  get data() {\n    return local.data\n  },\n  enableSortingRemoval: true, // override the hook default for this table only\n})","lang":"ts"},{"type":"heading","depth":2,"id":"when-to-use-this-pattern","children":[{"type":"text","value":"When To Use This Pattern"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"createTableHook"},{"type":"text","value":" when multiple tables should share features, row models, default options, or conventions. Use the standalone "},{"type":"inlineCode","value":"createTable"},{"type":"text","value":" API for a one-off table."}]}],"headings":[{"id":"examples","text":"Examples","level":2},{"id":"start-with-shared-features-and-options","text":"Start With Shared Features and Options","level":2},{"id":"create-app-columns","text":"Create App Columns","level":2},{"id":"create-a-table","text":"Create A Table","level":2},{"id":"render-with-the-normal-table-apis","text":"Render With The Normal Table APIs","level":2},{"id":"override-shared-defaults-per-table","text":"Override Shared Defaults Per Table","level":2},{"id":"when-to-use-this-pattern","text":"When To Use This Pattern","level":2}]},"frameworks":[],"downloadMarkdown":"\n`createTableHook` creates an app-specific table factory. Use it to define shared features, row models, and default table options once, then create each Alpine table with the columns and data that are unique to that table.\n\n> [!NOTE]\n> Unlike the React, Solid, Lit, and Svelte adapters, the Alpine `createTableHook` does not register reusable cell/header/table components. Alpine renders cell and header content as HTML strings through `x-html`, and Alpine has no component primitive to bind, so the hook is focused on sharing features and default options. Reusable interactive markup is expressed with [`Alpine.bind`](https://alpinejs.dev/globals/alpine-bind) bundles in your templates instead.\n\n## Examples\n\n- [Basic App Table](../examples/basic-app-table) - Minimal `createTableHook` setup.\n\n## Start With Shared Features and Options\n\nCreate one app table hook and put the feature set, row models, and shared defaults there. This example makes sorting available to every table created by `createAppTable`.\n\n```ts\nimport {\n  createSortedRowModel,\n  createTableHook,\n  rowSortingFeature,\n  sortFns,\n  tableFeatures,\n} from '@tanstack/alpine-table'\n\nconst features = tableFeatures({\n  rowSortingFeature,\n  sortedRowModel: createSortedRowModel(),\n  sortFns,\n})\n\nconst { createAppTable, createAppColumnHelper } = createTableHook({\n  features,\n  debugTable: true,\n  enableSortingRemoval: false,\n})\n```\n\nOptions passed to `createTableHook` become defaults for every table created by `createAppTable`. The `features` option is also bound to the returned column helper, so column definitions know that sorting APIs are available.\n\n## Create App Columns\n\nCreate one column helper per row type. The helper is already bound to your app's feature set, so each table does not need to thread `typeof features` through its column definitions. Renderers return HTML strings, which are rendered with `x-html` via `table.FlexRender`.\n\n```ts\ntype Person = {\n  firstName: string\n  lastName: string\n  age: number\n  visits: number\n}\n\nconst columnHelper = createAppColumnHelper<Person>()\n\nconst columns = columnHelper.columns([\n  columnHelper.accessor('firstName', {\n    cell: (info) => info.getValue(),\n  }),\n  columnHelper.accessor((row) => row.lastName, {\n    id: 'lastName',\n    header: () => '<span>Last Name</span>',\n    cell: (info) => `<i>${info.getValue()}</i>`,\n  }),\n  columnHelper.accessor('age', {\n    header: 'Age',\n  }),\n  columnHelper.accessor('visits', {\n    header: 'Visits',\n  }),\n])\n```\n\n## Create A Table\n\nCreate each table with `createAppTable` inside an `Alpine.data` component. The call site provides table-specific inputs such as `columns` and reactive `data`; shared features and defaults come from the hook.\n\n```ts\nimport Alpine from 'alpinejs'\n\nAlpine.data('table', () => {\n  const local = Alpine.reactive({ data: [] as Array<Person> })\n\n  const table = createAppTable({\n    columns,\n    get data() {\n      return local.data\n    },\n  })\n\n  return { table }\n})\n\nwindow.Alpine = Alpine\nAlpine.start()\n```\n\n## Render With The Normal Table APIs\n\nYou render the table with the same table instance APIs used by a standalone `createTable` table. `table.FlexRender` is attached to the instance, so you do not need to import the top-level helper. Attach the sort click handler to a real element (Alpine does not initialize directives inside `x-html`).\n\n```html\n<div x-data=\"table\">\n  <table>\n    <thead>\n      <template\n        x-for=\"headerGroup in table.getHeaderGroups()\"\n        :key=\"headerGroup.id\"\n      >\n        <tr>\n          <template x-for=\"header in headerGroup.headers\" :key=\"header.id\">\n            <th @click=\"header.column.getToggleSortingHandler()?.($event)\">\n              <span x-html=\"table.FlexRender({ header })\"></span>\n            </th>\n          </template>\n        </tr>\n      </template>\n    </thead>\n    <tbody>\n      <template x-for=\"row in table.getRowModel().rows\" :key=\"row.id\">\n        <tr>\n          <template x-for=\"cell in row.getAllCells()\" :key=\"cell.id\">\n            <td x-html=\"table.FlexRender({ cell })\"></td>\n          </template>\n        </tr>\n      </template>\n    </tbody>\n  </table>\n</div>\n```\n\n## Override Shared Defaults Per Table\n\nOptions passed to `createAppTable` override defaults from `createTableHook`. Use this for the few tables that need different behavior without creating a separate app hook.\n\n```ts\nconst table = createAppTable({\n  columns,\n  get data() {\n    return local.data\n  },\n  enableSortingRemoval: true, // override the hook default for this table only\n})\n```\n\n## When To Use This Pattern\n\nUse `createTableHook` when multiple tables should share features, row models, default options, or conventions. Use the standalone `createTable` API for a one-off table.\n","originalRawMarkdown":"---\ntitle: Composable Tables (createTableHook) Guide\n---\n\n`createTableHook` creates an app-specific table factory. Use it to define shared features, row models, and default table options once, then create each Alpine table with the columns and data that are unique to that table.\n\n> [!NOTE]\n> Unlike the React, Solid, Lit, and Svelte adapters, the Alpine `createTableHook` does not register reusable cell/header/table components. Alpine renders cell and header content as HTML strings through `x-html`, and Alpine has no component primitive to bind, so the hook is focused on sharing features and default options. Reusable interactive markup is expressed with [`Alpine.bind`](https://alpinejs.dev/globals/alpine-bind) bundles in your templates instead.\n\n## Examples\n\n- [Basic App Table](../examples/basic-app-table) - Minimal `createTableHook` setup.\n\n## Start With Shared Features and Options\n\nCreate one app table hook and put the feature set, row models, and shared defaults there. This example makes sorting available to every table created by `createAppTable`.\n\n```ts\nimport {\n  createSortedRowModel,\n  createTableHook,\n  rowSortingFeature,\n  sortFns,\n  tableFeatures,\n} from '@tanstack/alpine-table'\n\nconst features = tableFeatures({\n  rowSortingFeature,\n  sortedRowModel: createSortedRowModel(),\n  sortFns,\n})\n\nconst { createAppTable, createAppColumnHelper } = createTableHook({\n  features,\n  debugTable: true,\n  enableSortingRemoval: false,\n})\n```\n\nOptions passed to `createTableHook` become defaults for every table created by `createAppTable`. The `features` option is also bound to the returned column helper, so column definitions know that sorting APIs are available.\n\n## Create App Columns\n\nCreate one column helper per row type. The helper is already bound to your app's feature set, so each table does not need to thread `typeof features` through its column definitions. Renderers return HTML strings, which are rendered with `x-html` via `table.FlexRender`.\n\n```ts\ntype Person = {\n  firstName: string\n  lastName: string\n  age: number\n  visits: number\n}\n\nconst columnHelper = createAppColumnHelper<Person>()\n\nconst columns = columnHelper.columns([\n  columnHelper.accessor('firstName', {\n    cell: (info) => info.getValue(),\n  }),\n  columnHelper.accessor((row) => row.lastName, {\n    id: 'lastName',\n    header: () => '<span>Last Name</span>',\n    cell: (info) => `<i>${info.getValue()}</i>`,\n  }),\n  columnHelper.accessor('age', {\n    header: 'Age',\n  }),\n  columnHelper.accessor('visits', {\n    header: 'Visits',\n  }),\n])\n```\n\n## Create A Table\n\nCreate each table with `createAppTable` inside an `Alpine.data` component. The call site provides table-specific inputs such as `columns` and reactive `data`; shared features and defaults come from the hook.\n\n```ts\nimport Alpine from 'alpinejs'\n\nAlpine.data('table', () => {\n  const local = Alpine.reactive({ data: [] as Array<Person> })\n\n  const table = createAppTable({\n    columns,\n    get data() {\n      return local.data\n    },\n  })\n\n  return { table }\n})\n\nwindow.Alpine = Alpine\nAlpine.start()\n```\n\n## Render With The Normal Table APIs\n\nYou render the table with the same table instance APIs used by a standalone `createTable` table. `table.FlexRender` is attached to the instance, so you do not need to import the top-level helper. Attach the sort click handler to a real element (Alpine does not initialize directives inside `x-html`).\n\n```html\n<div x-data=\"table\">\n  <table>\n    <thead>\n      <template\n        x-for=\"headerGroup in table.getHeaderGroups()\"\n        :key=\"headerGroup.id\"\n      >\n        <tr>\n          <template x-for=\"header in headerGroup.headers\" :key=\"header.id\">\n            <th @click=\"header.column.getToggleSortingHandler()?.($event)\">\n              <span x-html=\"table.FlexRender({ header })\"></span>\n            </th>\n          </template>\n        </tr>\n      </template>\n    </thead>\n    <tbody>\n      <template x-for=\"row in table.getRowModel().rows\" :key=\"row.id\">\n        <tr>\n          <template x-for=\"cell in row.getAllCells()\" :key=\"cell.id\">\n            <td x-html=\"table.FlexRender({ cell })\"></td>\n          </template>\n        </tr>\n      </template>\n    </tbody>\n  </table>\n</div>\n```\n\n## Override Shared Defaults Per Table\n\nOptions passed to `createAppTable` override defaults from `createTableHook`. Use this for the few tables that need different behavior without creating a separate app hook.\n\n```ts\nconst table = createAppTable({\n  columns,\n  get data() {\n    return local.data\n  },\n  enableSortingRemoval: true, // override the hook default for this table only\n})\n```\n\n## When To Use This Pattern\n\nUse `createTableHook` when multiple tables should share features, row models, default options, or conventions. Use the standalone `createTable` API for a one-off table.\n"}
