:"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"props","children":[{"type":"text","value":"props"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/FlexRenderProps.md","children":[{"type":"inlineCode","value":"FlexRenderProps"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"any"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<th x-html=\"FlexRender({ header })\"></th>\n<td x-html=\"FlexRender({ cell })\"></td>\n<th x-html=\"FlexRender({ footer: header })\"></th>","lang":"html"}],"headings":[{"id":"function-flexrender","text":"Function: FlexRender()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"props","text":"props","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: FlexRender()\n\n```ts\nfunction FlexRender<TFeatures, TData, TValue>(props): any;\n```\n\nDefined in: [flexRender.ts:76](https://github.com/TanStack/table/blob/main/packages/alpine-table/src/flexRender.ts#L76)\n\nSimplified wrapper of `flexRender`. Use this utility function to render headers, cells, or footers with custom markup.\nOnly one prop (`cell`, `header`, or `footer`) may be passed.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### props\n\n[`FlexRenderProps`](../type-aliases/FlexRenderProps.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n`any`\n\n## Example\n\n```html\n<th x-html=\"FlexRender({ header })\"></th>\n<td x-html=\"FlexRender({ cell })\"></td>\n<th x-html=\"FlexRender({ footer: header })\"></th>\n```\n","originalRawMarkdown":"---\nid: FlexRender\ntitle: FlexRender\n---\n\n# Function: FlexRender()\n\n```ts\nfunction FlexRender<TFeatures, TData, TValue>(props): any;\n```\n\nDefined in: [flexRender.ts:76](https://github.com/TanStack/table/blob/main/packages/alpine-table/src/flexRender.ts#L76)\n\nSimplified wrapper of `flexRender`. Use this utility function to render headers, cells, or footers with custom markup.\nOnly one prop (`cell`, `header`, or `footer`) may be passed.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### props\n\n[`FlexRenderProps`](../type-aliases/FlexRenderProps.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n`any`\n\n## Example\n\n```html\n<th x-html=\"FlexRender({ header })\"></th>\n<td x-html=\"FlexRender({ cell })\"></td>\n<th x-html=\"FlexRender({ footer: header })\"></th>\n```\n"}
