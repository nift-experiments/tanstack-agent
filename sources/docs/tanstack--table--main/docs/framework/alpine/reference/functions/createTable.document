type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"tableoptions","children":[{"type":"text","value":"tableOptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TableOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AlpineTable.md","children":[{"type":"inlineCode","value":"AlpineTable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const table = createTable(options, (state) => ({ sorting: state.sorting }))","lang":"ts"}],"headings":[{"id":"function-createtable","text":"Function: createTable()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"tableoptions","text":"tableOptions","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: createTable()\n\n```ts\nfunction createTable<TFeatures, TData>(tableOptions, selector?): AlpineTable<TFeatures, TData>;\n```\n\nDefined in: [createTable.ts:46](https://github.com/TanStack/table/blob/main/packages/alpine-table/src/createTable.ts#L46)\n\nCreates an Alpine-reactive table instance.\n\nReactivity is bridged through a single version counter that every proxied\ntable read registers as a dependency, so by default ANY state change\nre-evaluates every Alpine binding that touches the table. Pass a `selector`\nto gate that: the counter then only bumps when the selected slice of state\nchanges (shallow compare). Use `() => ({})` to opt out of state-driven\nre-evaluation entirely and handle high-frequency state (e.g. column\nresizing) with explicit `table.atoms.<slice>.subscribe()` side effects.\nOptions changes (e.g. new `data`) always re-evaluate.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n## Parameters\n\n### tableOptions\n\n`TableOptions`\\<`TFeatures`, `TData`\\>\n\n### selector?\n\n(`state`) => `unknown`\n\n## Returns\n\n[`AlpineTable`](../type-aliases/AlpineTable.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```ts\nconst table = createTable(options, (state) => ({ sorting: state.sorting }))\n```\n","originalRawMarkdown":"---\nid: createTable\ntitle: createTable\n---\n\n# Function: createTable()\n\n```ts\nfunction createTable<TFeatures, TData>(tableOptions, selector?): AlpineTable<TFeatures, TData>;\n```\n\nDefined in: [createTable.ts:46](https://github.com/TanStack/table/blob/main/packages/alpine-table/src/createTable.ts#L46)\n\nCreates an Alpine-reactive table instance.\n\nReactivity is bridged through a single version counter that every proxied\ntable read registers as a dependency, so by default ANY state change\nre-evaluates every Alpine binding that touches the table. Pass a `selector`\nto gate that: the counter then only bumps when the selected slice of state\nchanges (shallow compare). Use `() => ({})` to opt out of state-driven\nre-evaluation entirely and handle high-frequency state (e.g. column\nresizing) with explicit `table.atoms.<slice>.subscribe()` side effects.\nOptions changes (e.g. new `data`) always re-evaluate.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n## Parameters\n\n### tableOptions\n\n`TableOptions`\\<`TFeatures`, `TData`\\>\n\n### selector?\n\n(`state`) => `unknown`\n\n## Returns\n\n[`AlpineTable`](../type-aliases/AlpineTable.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```ts\nconst table = createTable(options, (state) => ({ sorting: state.sorting }))\n```\n"}
