,"value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"any"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"flexRender(cell.column.columnDef.cell, cell.getContext())","lang":"ts"}],"headings":[{"id":"function-flexrender","text":"Function: flexRender()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tprops","text":"TProps","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"render","text":"render","level":3},{"id":"props","text":"props","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: flexRender()\n\n```ts\nfunction flexRender<TProps>(render, props): any;\n```\n\nDefined in: [flexRender.ts:22](https://github.com/TanStack/table/blob/main/packages/alpine-table/src/flexRender.ts#L22)\n\nRenders an Alpine table value with the provided context props.\n\nUse this lower-level helper for custom header, cell, or footer renderers when\nyou already have the render function and context. `FlexRender` is the\nconvenience wrapper for table cell/header/footer objects. Renderers typically\nreturn a string of markup that you render into the DOM with `x-html`.\n\n## Type Parameters\n\n### TProps\n\n`TProps` *extends* `object`\n\n## Parameters\n\n### render\n\n`any`\n\n### props\n\n`TProps`\n\n## Returns\n\n`any`\n\n## Example\n\n```ts\nflexRender(cell.column.columnDef.cell, cell.getContext())\n```\n","originalRawMarkdown":"---\nid: flexRender\ntitle: flexRender\n---\n\n# Function: flexRender()\n\n```ts\nfunction flexRender<TProps>(render, props): any;\n```\n\nDefined in: [flexRender.ts:22](https://github.com/TanStack/table/blob/main/packages/alpine-table/src/flexRender.ts#L22)\n\nRenders an Alpine table value with the provided context props.\n\nUse this lower-level helper for custom header, cell, or footer renderers when\nyou already have the render function and context. `FlexRender` is the\nconvenience wrapper for table cell/header/footer objects. Renderers typically\nreturn a string of markup that you render into the DOM with `x-html`.\n\n## Type Parameters\n\n### TProps\n\n`TProps` *extends* `object`\n\n## Parameters\n\n### render\n\n`any`\n\n### props\n\n`TProps`\n\n## Returns\n\n`any`\n\n## Example\n\n```ts\nflexRender(cell.column.columnDef.cell, cell.getContext())\n```\n"}
