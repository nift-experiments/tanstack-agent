NIFT_TANSTACK_DOCUMENT_V1
{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"@tanstack/angular-table"},{"type":"text","value":" adapter provides structural directives and dependency injection primitives for rendering table content in Angular templates."}]},{"type":"heading","depth":2,"id":"flexrender-vs-flexrender","children":[{"type":"inlineCode","value":"FlexRender"},{"type":"text","value":" vs "},{"type":"inlineCode","value":"flexRender"}]},{"type":"paragraph","children":[{"type":"text","value":"Angular uses the names for two related template concepts:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"FlexRender"},{"type":"text","value":" is the exported tuple of rendering directives. Add it to a component's "},{"type":"inlineCode","value":"imports"},{"type":"text","value":" array."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"*flexRender"},{"type":"text","value":" is the lower-level structural directive."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"*flexRenderCell"},{"type":"text","value":", "},{"type":"inlineCode","value":"*flexRenderHeader"},{"type":"text","value":", and "},{"type":"inlineCode","value":"*flexRenderFooter"},{"type":"text","value":" are table-aware shorthand selectors included in "},{"type":"inlineCode","value":"FlexRender"},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"FlexRender"},{"type":"text","value":" is the rendering primitive.\nIt is exported as a tuple of two directives:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"FlexRenderDirective"},{"type":"text","value":": the base structural directive ("},{"type":"inlineCode","value":"*flexRender"},{"type":"text","value":")"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"FlexRenderCell"},{"type":"text","value":": shorthand directives ("},{"type":"inlineCode","value":"*flexRenderCell"},{"type":"text","value":", "},{"type":"inlineCode","value":"*flexRenderHeader"},{"type":"text","value":", "},{"type":"inlineCode","value":"*flexRenderFooter"},{"type":"text","value":")"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Import "},{"type":"inlineCode","value":"FlexRender"},{"type":"text","value":" to get both:"}]},{"type":"code","value":"import { Component } from '@angular/core'\nimport { FlexRender } from '@tanstack/angular-table'\n\n@Component({\n  imports: [FlexRender],\n  templateUrl: './app.html',\n})\nexport class AppComponent {}","lang":"ts"},{"type":"heading","depth":3,"id":"how-it-works","children":[{"type":"text","value":"How it works"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"FlexRender"},{"type":"text","value":" is an Angular "},{"type":"strong","children":[{"type":"text","value":"structural directive"}]},{"type":"text","value":". Internally, it resolves the column definition's "},{"type":"inlineCode","value":"header"},{"type":"text","value":", "},{"type":"inlineCode","value":"cell"},{"type":"text","value":", or "},{"type":"inlineCode","value":"footer"},{"type":"text","value":" function and renders the result using "},{"type":"link","href":"https://angular.dev/api/core/ViewContainerRef","children":[{"type":"inlineCode","value":"ViewContainerRef"}]},{"type":"text","value":":"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Primitives"}]},{"type":"text","value":" ("},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"number"},{"type":"text","value":"): rendered via "},{"type":"inlineCode","value":"createEmbeddedView"},{"type":"text","value":" into the host "},{"type":"inlineCode","value":"ng-template"},{"type":"text","value":". The value is exposed as the template's implicit context ("},{"type":"inlineCode","value":"let value"},{"type":"text","value":")."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"TemplateRef"}]},{"type":"text","value":": rendered via "},{"type":"inlineCode","value":"createEmbeddedView"},{"type":"text","value":". The render context ("},{"type":"inlineCode","value":"CellContext"},{"type":"text","value":", "},{"type":"inlineCode","value":"HeaderContext"},{"type":"text","value":") is passed as "},{"type":"inlineCode","value":"$implicit"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineCode","value":"flexRenderComponent(...)"}]},{"type":"text","value":": rendered via "},{"type":"inlineCode","value":"createComponent"},{"type":"text","value":" with explicit "},{"type":"inlineCode","value":"inputs"},{"type":"text","value":", "},{"type":"inlineCode","value":"outputs"},{"type":"text","value":", "},{"type":"inlineCode","value":"bindings"},{"type":"text","value":", "},{"type":"inlineCode","value":"directives"},{"type":"text","value":", and "},{"type":"inlineCode","value":"injector"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Component type"}]},{"type":"text","value":" ("},{"type":"inlineCode","value":"Type<T>"},{"type":"text","value":"): rendered via "},{"type":"link","href":"https://angular.dev/api/core/ViewContainerRef#createComponent","children":[{"type":"inlineCode","value":"createComponent"}]},{"type":"text","value":". All properties from the render context are set as component inputs through "},{"type":"link","href":"https://angular.dev/api/core/ComponentRef#setInput","children":[{"type":"inlineCode","value":"ComponentRef.setInput"}]},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Column definition functions ("},{"type":"inlineCode","value":"header"},{"type":"text","value":", "},{"type":"inlineCode","value":"cell"},{"type":"text","value":", "},{"type":"inlineCode","value":"footer"},{"type":"text","value":") are called inside "},{"type":"link","href":"https://angular.dev/api/core/runInInjectionContext","children":[{"type":"inlineCode","value":"runInInjectionContext"}]},{"type":"text","value":", which means you can call "},{"type":"inlineCode","value":"inject()"},{"type":"text","value":", use signals, and access DI tokens directly in your render logic."}]},{"type":"heading","depth":2,"id":"cell-rendering","children":[{"type":"text","value":"Cell rendering"}]},{"type":"paragraph","children":[{"type":"text","value":"Prefer the shorthand directives for standard rendering:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Directive"}]},{"type":"tableCell","children":[{"type":"text","value":"Input"}]},{"type":"tableCell","children":[{"type":"text","value":"Column definition"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"*flexRenderCell"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Cell"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"columnDef.cell"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"*flexRenderHeader"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Header"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"columnDef.header"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"*flexRenderFooter"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"Header"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"columnDef.footer"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Each shorthand resolves the correct column definition function and render context automatically through a "},{"type":"inlineCode","value":"computed"},{"type":"text","value":" signal, so no manual "},{"type":"inlineCode","value":"props"},{"type":"text","value":" mapping is needed."}]},{"type":"heading","depth":3,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<thead>\n  @for (headerGroup of table.getHeaderGroups(); track headerGroup.id) {\n  <tr>\n    @for (header of headerGroup.headers; track header.id) {\n    <th>\n      @if (!header.isPlaceholder) {\n      <ng-container *flexRenderHeader=\"header; let value\">\n        {{ value }}\n      </ng-container>\n      }\n    </th>\n    }\n  </tr>\n  }\n</thead>\n\n<tbody>\n  @for (row of table.getRowModel().rows; track row.id) {\n  <tr>\n    @for (cell of row.getVisibleCells(); track cell.id) {\n    <td>\n      <ng-container *flexRenderCell=\"cell; let value\">\n        {{ value }}\n      </ng-container>\n    </td>\n    }\n  </tr>\n  }\n</tbody>","lang":"html"},{"type":"heading","depth":2,"id":"cell-rendering-with-custom-props","children":[{"type":"text","value":"Cell rendering with custom props"}]},{"type":"paragraph","children":[{"type":"text","value":"When you need full control over the "},{"type":"inlineCode","value":"props"},{"type":"text","value":" passed to the render function, use "},{"type":"inlineCode","value":"*flexRender"},{"type":"text","value":" directly."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"FlexRenderDirective"},{"type":"text","value":" accepts two inputs:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"flexRender"},{"type":"text","value":": the render definition (a column def function, a string, a "},{"type":"inlineCode","value":"TemplateRef"},{"type":"text","value":", a component type, or a "},{"type":"inlineCode","value":"flexRenderComponent(...)"},{"type":"text","value":" wrapper)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"flexRenderProps"},{"type":"text","value":": the props object passed to the render function and used as the implicit template context"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Standard usage:"}]},{"type":"code","value":"<ng-container\n  *flexRender=\"\n    cell.column.columnDef.cell;\n    props: cell.getContext();\n    let rendered\n  \"\n>\n  {{ rendered }}\n</ng-container>","lang":"html"},{"type":"paragraph","children":[{"type":"text","value":"You can pass a custom props object to override the default context shape:"}]},{"type":"code","value":"<ng-container\n  *flexRender=\"\n    cell.column.columnDef.cell;\n    props: {\n      value: cell.getValue(),\n      ...cell.getContext(),\n    };\n    let rendered\n  \"\n>\n  {{ rendered }}\n</ng-container>","lang":"html"},{"type":"paragraph","children":[{"type":"text","value":"Inside rendered components, the full props object is available via "},{"type":"link","href":"#injectflexrendercontext","children":[{"type":"inlineCode","value":"injectFlexRenderContext()"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"component-rendering","children":[{"type":"text","value":"Component rendering"}]},{"type":"paragraph","children":[{"type":"text","value":"You can render Angular components from column definitions in two ways:"}]},{"type":"heading","depth":3,"id":"using-flexrendercomponent","children":[{"type":"text","value":"Using "},{"type":"inlineCode","value":"flexRenderComponent"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"flexRenderComponent(component, options?)"},{"type":"text","value":" wraps a component type with explicit options for "},{"type":"inlineCode","value":"inputs"},{"type":"text","value":", "},{"type":"inlineCode","value":"outputs"},{"type":"text","value":", "},{"type":"inlineCode","value":"injector"},{"type":"text","value":", "},{"type":"inlineCode","value":"bindings"},{"type":"text","value":", and "},{"type":"inlineCode","value":"directives"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Use this when you need to:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"pass custom inputs not derived from the render context"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"subscribe to component outputs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"provide a custom "},{"type":"inlineCode","value":"Injector"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"use creation-time "},{"type":"inlineCode","value":"bindings"},{"type":"text","value":" (Angular v20+)"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"apply host directives and binding values at runtime"}]}]}]},{"type":"code","value":"import { flexRenderComponent, type ColumnDef } from '@tanstack/angular-table'\n\nconst columns: ColumnDef<Person>[] = [\n  {\n    id: 'custom-cell',\n    cell: (ctx) =>\n      flexRenderComponent(CustomCellComponent, {\n        inputs: {\n          content: ctx.row.original.firstName,\n        },\n        outputs: {\n          clicked: (value) => {\n            console.log(value)\n          },\n        },\n      }),\n  },\n]","lang":"ts"},{"type":"heading","depth":4,"id":"how-inputs-and-outputs-work","children":[{"type":"text","value":"How inputs and outputs work"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Inputs"}]},{"type":"text","value":" are applied through "},{"type":"link","href":"https://angular.dev/api/core/ComponentRef#setInput","children":[{"type":"inlineCode","value":"ComponentRef.setInput(key, value)"}]},{"type":"text","value":". This works with both "},{"type":"inlineCode","value":"input()"},{"type":"text","value":" signals and "},{"type":"inlineCode","value":"@Input()"},{"type":"text","value":" decorators. Inputs are diffed on every change detection cycle using "},{"type":"inlineCode","value":"KeyValueDiffers"},{"type":"text","value":"; only changed values trigger "},{"type":"inlineCode","value":"setInput"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"For object-like inputs, updates are reference-based: if the object reference is stable, Angular's default input equality semantics prevent unnecessary updates."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Outputs"}]},{"type":"text","value":" work through "},{"type":"inlineCode","value":"OutputEmitterRef"},{"type":"text","value":" subscriptions. The factory reads the component instance property by name, checks that it is an "},{"type":"inlineCode","value":"OutputEmitterRef"},{"type":"text","value":", and subscribes to it. When the output emits, the corresponding callback from "},{"type":"inlineCode","value":"outputs"},{"type":"text","value":" is invoked. Subscriptions are cleaned up automatically when the component is destroyed."}]},{"type":"heading","depth":4,"id":"bindings-api-angular-v20","children":[{"type":"inlineCode","value":"bindings"},{"type":"text","value":" API (Angular v20+)"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"flexRenderComponent"},{"type":"text","value":" also accepts "},{"type":"inlineCode","value":"bindings"},{"type":"text","value":" and "},{"type":"inlineCode","value":"directives"},{"type":"text","value":", forwarded directly to "},{"type":"link","href":"https://angular.dev/api/core/ViewContainerRef#createComponent","children":[{"type":"inlineCode","value":"ViewContainerRef.createComponent"}]},{"type":"text","value":" at creation time."}]},{"type":"paragraph","children":[{"type":"text","value":"This supports Angular programmatic rendering APIs for passing host directives and binding values at runtime."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike "},{"type":"inlineCode","value":"inputs"},{"type":"text","value":"/"},{"type":"inlineCode","value":"outputs"},{"type":"text","value":" (which are applied imperatively after creation), "},{"type":"inlineCode","value":"bindings"},{"type":"text","value":" are applied "},{"type":"strong","children":[{"type":"text","value":"at creation time"}]},{"type":"text","value":", so they participate in the component's initial change detection cycle."}]},{"type":"code","value":"import {\n  inputBinding,\n  outputBinding,\n  twoWayBinding,\n  signal,\n} from '@angular/core'\nimport { flexRenderComponent } from '@tanstack/angular-table'\n\nreadonly name = signal('Ada')\n\ncell: () =>\n  flexRenderComponent(EditableNameCellComponent, {\n    bindings: [\n      inputBinding('value', this.name),\n      outputBinding('valueChange', value => {\n        console.log('changed', value)\n      }),\n      twoWayBinding('value', this.name),\n    ],\n  })","lang":"ts"},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Avoid mixing "},{"type":"inlineCode","value":"bindings"},{"type":"text","value":" with "},{"type":"inlineCode","value":"inputs"},{"type":"text","value":"/"},{"type":"inlineCode","value":"outputs"},{"type":"text","value":" on the same property. "},{"type":"inlineCode","value":"bindings"},{"type":"text","value":" are applied at creation, while "},{"type":"inlineCode","value":"inputs"},{"type":"text","value":"/"},{"type":"inlineCode","value":"outputs"},{"type":"text","value":" are applied post-creation, so mixing them can lead to double initialization or conflicting values."}]}]},{"type":"paragraph","children":[{"type":"text","value":"See the Angular docs for details:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://angular.dev/guide/components/programmatic-rendering#binding-inputs-outputs-and-setting-host-directives-at-creation","children":[{"type":"text","value":"Programmatic rendering: Binding inputs/outputs/directives"}]}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"https://angular.dev/api/core/inputBinding","children":[{"type":"inlineCode","value":"inputBinding"}]},{"type":"text","value":", "},{"type":"link","href":"https://angular.dev/api/core/outputBinding","children":[{"type":"inlineCode","value":"outputBinding"}]},{"type":"text","value":", "},{"type":"link","href":"https://angular.dev/api/core/twoWayBinding","children":[{"type":"inlineCode","value":"twoWayBinding"}]}]}]}]},{"type":"heading","depth":3,"id":"returning-a-component-class","children":[{"type":"text","value":"Returning a component class"}]},{"type":"paragraph","children":[{"type":"text","value":"Return a component class from "},{"type":"inlineCode","value":"header"},{"type":"text","value":", "},{"type":"inlineCode","value":"cell"},{"type":"text","value":", or "},{"type":"inlineCode","value":"footer"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The render context properties ("},{"type":"inlineCode","value":"table"},{"type":"text","value":", "},{"type":"inlineCode","value":"column"},{"type":"text","value":", "},{"type":"inlineCode","value":"header"},{"type":"text","value":", "},{"type":"inlineCode","value":"cell"},{"type":"text","value":", "},{"type":"inlineCode","value":"row"},{"type":"text","value":", "},{"type":"inlineCode","value":"getValue"},{"type":"text","value":", etc.) are automatically set as component inputs via "},{"type":"inlineCode","value":"ComponentRef.setInput(...)"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Define input signals matching the context property names you need:"}]},{"type":"code","value":"import { Component, input } from '@angular/core'\nimport type { ColumnDef, Table, CellContext } from '@tanstack/angular-table'\n\nconst columns: ColumnDef<Person>[] = [\n  {\n    id: 'select',\n    header: () => TableHeadSelectionComponent,\n    cell: () => TableRowSelectionComponent,\n  },\n]\n\n@Component({\n  template: `\n    <input\n      type=\"checkbox\"\n      [checked]=\"table().getIsAllRowsSelected()\"\n      [indeterminate]=\"table().getIsSomeRowsSelected()\"\n      (change)=\"table().toggleAllRowsSelected()\"\n    />\n  `,\n})\nexport class TableHeadSelectionComponent<T> {\n  readonly table = input.required<Table<T>>()\n  // column = input.required<Column<typeof features, T, unknown>>()\n  // header = input.required<Header<typeof features, T, unknown>>()\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Only properties declared with "},{"type":"inlineCode","value":"input()"},{"type":"text","value":" / "},{"type":"inlineCode","value":"input.required()"},{"type":"text","value":" are set; other context properties are silently ignored. You can also access the full context via "},{"type":"link","href":"#injectflexrendercontext","children":[{"type":"inlineCode","value":"injectFlexRenderContext()"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"templateref-rendering","children":[{"type":"text","value":"TemplateRef rendering"}]},{"type":"paragraph","children":[{"type":"text","value":"You can return a "},{"type":"inlineCode","value":"TemplateRef"},{"type":"text","value":" from column definitions. The render context is passed as the template's "},{"type":"inlineCode","value":"$implicit"},{"type":"text","value":" context."}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"viewChild(...)"},{"type":"text","value":" to capture template references:"}]},{"type":"code","value":"import { Component, TemplateRef, viewChild } from '@angular/core'\nimport type {\n  CellContext,\n  ColumnDef,\n  HeaderContext,\n} from '@tanstack/angular-table'\n\n@Component({\n  template: `\n    <ng-template #customHeader let-context>\n      {{ context.column.id }}\n    </ng-template>\n\n    <ng-template #customCell let-context>\n      {{ context.getValue() }}\n    </ng-template>\n  `,\n})\nexport class AppComponent {\n  readonly customHeader =\n    viewChild.required<\n      TemplateRef<{ $implicit: HeaderContext<any, any, any> }>\n    >('customHeader')\n  readonly customCell =\n    viewChild.required<TemplateRef<{ $implicit: CellContext<any, any, any> }>>(\n      'customCell',\n    )\n\n  readonly columns: ColumnDef<any>[] = [\n    {\n      id: 'templated',\n      header: () => this.customHeader(),\n      cell: () => this.customCell(),\n    },\n  ]\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"TemplateRef"},{"type":"text","value":" rendering uses "},{"type":"inlineCode","value":"createEmbeddedView"},{"type":"text","value":" with an injector that includes the "},{"type":"link","href":"#dependency-injection","children":[{"type":"text","value":"DI context tokens"}]},{"type":"text","value":". For reusable render blocks shared across multiple screens, prefer standalone components over "},{"type":"inlineCode","value":"TemplateRef"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"dependency-injection","children":[{"type":"text","value":"Dependency injection"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"FlexRender"},{"type":"text","value":" automatically provides DI tokens when rendering components and templates. These tokens are created in the "},{"type":"inlineCode","value":"#getInjector"},{"type":"text","value":" method of the renderer, which builds a child "},{"type":"inlineCode","value":"Injector"},{"type":"text","value":" with the render context properties."}]},{"type":"heading","depth":3,"id":"injectflexrendercontext","children":[{"type":"inlineCode","value":"injectFlexRenderContext"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"injectFlexRenderContext<T>()"},{"type":"text","value":" returns the full props object passed to "},{"type":"inlineCode","value":"*flexRender"},{"type":"text","value":". The return type depends on the column definition slot:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"In a "},{"type":"inlineCode","value":"cell"},{"type":"text","value":" definition: "},{"type":"inlineCode","value":"CellContext<TFeatures, TData, TValue>"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"In a "},{"type":"inlineCode","value":"header"},{"type":"text","value":"/"},{"type":"inlineCode","value":"footer"},{"type":"text","value":" definition: "},{"type":"inlineCode","value":"HeaderContext<TFeatures, TData, TValue>"}]}]}]},{"type":"code","value":"import { Component } from '@angular/core'\nimport {\n  injectFlexRenderContext,\n  type CellContext,\n} from '@tanstack/angular-table'\n\n@Component({\n  template: `\n    <span>{{ context.getValue() }}</span>\n    <button (click)=\"context.row.toggleSelected()\">Toggle</button>\n  `,\n})\nexport class InteractiveCellComponent {\n  readonly context = injectFlexRenderContext<CellContext<any, any, any>>()\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Internally, the renderer wraps the context in a "},{"type":"inlineCode","value":"Proxy"},{"type":"text","value":" so that property access always reflects the latest values, even after re-renders."}]},{"type":"heading","depth":3,"id":"context-directives","children":[{"type":"text","value":"Context directives"}]},{"type":"paragraph","children":[{"type":"text","value":"Three optional directives let you expose table, header, and cell context to "},{"type":"strong","children":[{"type":"text","value":"any descendant"}]},{"type":"text","value":" in the template, not just components rendered by "},{"type":"inlineCode","value":"*flexRender"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"This eliminates prop drilling: instead of passing data through multiple "},{"type":"inlineCode","value":"input()"},{"type":"text","value":" layers, any nested component or directive can inject the context directly."}]},{"type":"table","align":[null,null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Directive"}]},{"type":"tableCell","children":[{"type":"text","value":"Selector"}]},{"type":"tableCell","children":[{"type":"text","value":"Token"}]},{"type":"tableCell","children":[{"type":"text","value":"Inject helper"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"TanStackTable"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"[tanStackTable]"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TanStackTableToken"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"injectTableContext()"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"TanStackTableHeader"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"[tanStackTableHeader]"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TanStackTableHeaderToken"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"injectTableHeaderContext()"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"TanStackTableCell"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"[tanStackTableCell]"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"TanStackTableCellToken"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"injectTableCellContext()"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Import them alongside "},{"type":"inlineCode","value":"FlexRender"},{"type":"text","value":":"}]},{"type":"code","value":"import {\n  FlexRender,\n  TanStackTable,\n  TanStackTableHeader,\n  TanStackTableCell,\n} from '@tanstack/angular-table'\n\n@Component({\n  imports: [FlexRender, TanStackTable, TanStackTableHeader, TanStackTableCell],\n  templateUrl: './app.html',\n})\nexport class AppComponent {}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Apply them in the template to establish injection scopes:"}]},{"type":"code","value":"<table [tanStackTable]=\"table\">\n  <!-- components can access to table context -->\n\n  @for (headerGroup of table.getHeaderGroups(); track headerGroup.id) {\n  <tr>\n    @for (header of headerGroup.headers; track header.id) {\n    <th [tanStackTableHeader]=\"header\">\n      <!-- components can access to table header context -->\n    </th>\n    }\n  </tr>\n  } @for (row of table.getRowModel().rows; track row.id) {\n  <tr>\n    @for (cell of row.getVisibleCells(); track cell.id) {\n    <td [tanStackTableCell]=\"cell\">\n      <!-- components can access to table cell context -->\n    </td>\n    }\n  </tr>\n  }\n</table>","lang":"html"},{"type":"paragraph","children":[{"type":"text","value":"Any component nested inside a "},{"type":"inlineCode","value":"[tanStackTableCell]"},{"type":"text","value":" host can inject the cell context:"}]},{"type":"code","value":"import { Component } from '@angular/core'\nimport { injectTableCellContext } from '@tanstack/angular-table'\n\n@Component({\n  template: `\n    <button (click)=\"onAction()\">Action for {{ cell().id }}</button>\n  `,\n})\nexport class CellActionsComponent {\n  readonly cell = injectTableCellContext()\n\n  onAction() {\n    console.log('Cell:', this.cell())\n  }\n}","lang":"ts"},{"type":"code","value":"<!-- No need to pass cell as an input, it is injected -->\n<td [tanStackTableCell]=\"cell\">\n  <app-cell-actions />\n</td>","lang":"html"},{"type":"paragraph","children":[{"type":"text","value":"Each directive uses Angular's "},{"type":"inlineCode","value":"providers"},{"type":"text","value":" array to register a factory that reads its own input signal."}]},{"type":"paragraph","children":[{"type":"text","value":"This means the token is scoped to the directive's host element and its descendants. Multiple "},{"type":"inlineCode","value":"[tanStackTableCell]"},{"type":"text","value":" directives on different elements provide independent contexts."}]},{"type":"heading","depth":3,"id":"automatic-token-injection-in-flexrender","children":[{"type":"text","value":"Automatic token injection in FlexRender"}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inlineCode","value":"FlexRender"},{"type":"text","value":" renders a component or template, it also provides DI tokens automatically based on the render context shape. In the renderer's "},{"type":"inlineCode","value":"#getInjector"},{"type":"text","value":" method, if the context object contains "},{"type":"inlineCode","value":"table"},{"type":"text","value":", "},{"type":"inlineCode","value":"cell"},{"type":"text","value":", or "},{"type":"inlineCode","value":"header"},{"type":"text","value":" properties, the corresponding "},{"type":"inlineCode","value":"TanStackTableToken"},{"type":"text","value":", "},{"type":"inlineCode","value":"TanStackTableCellToken"},{"type":"text","value":", or "},{"type":"inlineCode","value":"TanStackTableHeaderToken"},{"type":"text","value":" tokens are provided in the child injector."}]},{"type":"paragraph","children":[{"type":"text","value":"This means that even "},{"type":"strong","children":[{"type":"text","value":"without"}]},{"type":"text","value":" the context directives, components rendered via "},{"type":"inlineCode","value":"*flexRender"},{"type":"text","value":" can use "},{"type":"inlineCode","value":"injectTableContext()"},{"type":"text","value":", "},{"type":"inlineCode","value":"injectTableCellContext()"},{"type":"text","value":", and "},{"type":"inlineCode","value":"injectTableHeaderContext()"},{"type":"text","value":". The context directives are only needed for components that live "},{"type":"strong","children":[{"type":"text","value":"outside"}]},{"type":"text","value":" the "},{"type":"inlineCode","value":"*flexRender"},{"type":"text","value":" rendering tree (e.g. sibling components in the same "},{"type":"inlineCode","value":"<td>"},{"type":"text","value":")."}]}],"headings":[{"id":"flexrender-vs-flexrender","text":"FlexRender vs flexRender","level":2},{"id":"how-it-works","text":"How it works","level":3},{"id":"cell-rendering","text":"Cell rendering","level":2},{"id":"example","text":"Example","level":3},{"id":"cell-rendering-with-custom-props","text":"Cell rendering with custom props","level":2},{"id":"component-rendering","text":"Component rendering","level":2},{"id":"using-flexrendercomponent","text":"Using flexRenderComponent","level":3},{"id":"how-inputs-and-outputs-work","text":"How inputs and outputs work","level":4},{"id":"bindings-api-angular-v20","text":"bindings API (Angular v20+)","level":4},{"id":"returning-a-component-class","text":"Returning a component class","level":3},{"id":"templateref-rendering","text":"TemplateRef rendering","level":2},{"id":"dependency-injection","text":"Dependency injection","level":2},{"id":"injectflexrendercontext","text":"injectFlexRenderContext","level":3},{"id":"context-directives","text":"Context directives","level":3},{"id":"automatic-token-injection-in-flexrender","text":"Automatic token injection in FlexRender","level":3}]},"frameworks":[],"downloadMarkdown":"\nThe `@tanstack/angular-table` adapter provides structural directives and dependency injection primitives for rendering table content in Angular templates.\n\n## `FlexRender` vs `flexRender`\n\nAngular uses the names for two related template concepts:\n\n- `FlexRender` is the exported tuple of rendering directives. Add it to a component's `imports` array.\n- `*flexRender` is the lower-level structural directive.\n- `*flexRenderCell`, `*flexRenderHeader`, and `*flexRenderFooter` are table-aware shorthand selectors included in `FlexRender`.\n\n`FlexRender` is the rendering primitive.\nIt is exported as a tuple of two directives:\n\n- `FlexRenderDirective`: the base structural directive (`*flexRender`)\n- `FlexRenderCell`: shorthand directives (`*flexRenderCell`, `*flexRenderHeader`, `*flexRenderFooter`)\n\nImport `FlexRender` to get both:\n\n```ts\nimport { Component } from '@angular/core'\nimport { FlexRender } from '@tanstack/angular-table'\n\n@Component({\n  imports: [FlexRender],\n  templateUrl: './app.html',\n})\nexport class AppComponent {}\n```\n\n### How it works\n\n`FlexRender` is an Angular **structural directive**. Internally, it resolves the column definition's `header`, `cell`, or `footer` function and renders the result using [`ViewContainerRef`](https://angular.dev/api/core/ViewContainerRef):\n\n- **Primitives** (`string`, `number`): rendered via `createEmbeddedView` into the host `ng-template`. The value is exposed as the template's implicit context (`let value`).\n- **`TemplateRef`**: rendered via `createEmbeddedView`. The render context (`CellContext`, `HeaderContext`) is passed as `$implicit`.\n- **`flexRenderComponent(...)`**: rendered via `createComponent` with explicit `inputs`, `outputs`, `bindings`, `directives`, and `injector`.\n- **Component type** (`Type<T>`): rendered via [`createComponent`](https://angular.dev/api/core/ViewContainerRef#createComponent). All properties from the render context are set as component inputs through [`ComponentRef.setInput`](https://angular.dev/api/core/ComponentRef#setInput).\n\nColumn definition functions (`header`, `cell`, `footer`) are called inside [`runInInjectionContext`](https://angular.dev/api/core/runInInjectionContext), which means you can call `inject()`, use signals, and access DI tokens directly in your render logic.\n\n## Cell rendering\n\nPrefer the shorthand directives for standard rendering:\n\n| Directive           | Input    | Column definition  |\n| ------------------- | -------- | ------------------ |\n| `*flexRenderCell`   | `Cell`   | `columnDef.cell`   |\n| `*flexRenderHeader` | `Header` | `columnDef.header` |\n| `*flexRenderFooter` | `Header` | `columnDef.footer` |\n\nEach shorthand resolves the correct column definition function and render context automatically through a `computed` signal, so no manual `props` mapping is needed.\n\n### Example\n\n```html\n<thead>\n  @for (headerGroup of table.getHeaderGroups(); track headerGroup.id) {\n  <tr>\n    @for (header of headerGroup.headers; track header.id) {\n    <th>\n      @if (!header.isPlaceholder) {\n      <ng-container *flexRenderHeader=\"header; let value\">\n        {{ value }}\n      </ng-container>\n      }\n    </th>\n    }\n  </tr>\n  }\n</thead>\n\n<tbody>\n  @for (row of table.getRowModel().rows; track row.id) {\n  <tr>\n    @for (cell of row.getVisibleCells(); track cell.id) {\n    <td>\n      <ng-container *flexRenderCell=\"cell; let value\">\n        {{ value }}\n      </ng-container>\n    </td>\n    }\n  </tr>\n  }\n</tbody>\n```\n\n## Cell rendering with custom props\n\nWhen you need full control over the `props` passed to the render function, use `*flexRender` directly.\n\n`FlexRenderDirective` accepts two inputs:\n\n- `flexRender`: the render definition (a column def function, a string, a `TemplateRef`, a component type, or a `flexRenderComponent(...)` wrapper)\n- `flexRenderProps`: the props object passed to the render function and used as the implicit template context\n\nStandard usage:\n\n```html\n<ng-container\n  *flexRender=\"\n    cell.column.columnDef.cell;\n    props: cell.getContext();\n    let rendered\n  \"\n>\n  {{ rendered }}\n</ng-container>\n```\n\nYou can pass a custom props object to override the default context shape:\n\n```html\n<ng-container\n  *flexRender=\"\n    cell.column.columnDef.cell;\n    props: {\n      value: cell.getValue(),\n      ...cell.getContext(),\n    };\n    let rendered\n  \"\n>\n  {{ rendered }}\n</ng-container>\n```\n\nInside rendered components, the full props object is available via [`injectFlexRenderContext()`](#injectflexrendercontext).\n\n## Component rendering\n\nYou can render Angular components from column definitions in two ways:\n\n### Using `flexRenderComponent`\n\n`flexRenderComponent(component, options?)` wraps a component type with explicit options for `inputs`, `outputs`, `injector`, `bindings`, and `directives`.\n\nUse this when you need to:\n\n- pass custom inputs not derived from the render context\n- subscribe to component outputs\n- provide a custom `Injector`\n- use creation-time `bindings` (Angular v20+)\n- apply host directives and binding values at runtime\n\n```ts\nimport { flexRenderComponent, type ColumnDef } from '@tanstack/angular-table'\n\nconst columns: ColumnDef<Person>[] = [\n  {\n    id: 'custom-cell',\n    cell: (ctx) =>\n      flexRenderComponent(CustomCellComponent, {\n        inputs: {\n          content: ctx.row.original.firstName,\n        },\n        outputs: {\n          clicked: (value) => {\n            console.log(value)\n          },\n        },\n      }),\n  },\n]\n```\n\n#### How inputs and outputs work\n\n**Inputs** are applied through [`ComponentRef.setInput(key, value)`](https://angular.dev/api/core/ComponentRef#setInput). This works with both `input()` signals and `@Input()` decorators. Inputs are diffed on every change detection cycle using `KeyValueDiffers`; only changed values trigger `setInput`.\n\nFor object-like inputs, updates are reference-based: if the object reference is stable, Angular's default input equality semantics prevent unnecessary updates.\n\n**Outputs** work through `OutputEmitterRef` subscriptions. The factory reads the component instance property by name, checks that it is an `OutputEmitterRef`, and subscribes to it. When the output emits, the corresponding callback from `outputs` is invoked. Subscriptions are cleaned up automatically when the component is destroyed.\n\n#### `bindings` API (Angular v20+)\n\n`flexRenderComponent` also accepts `bindings` and `directives`, forwarded directly to [`ViewContainerRef.createComponent`](https://angular.dev/api/core/ViewContainerRef#createComponent) at creation time.\n\nThis supports Angular programmatic rendering APIs for passing host directives and binding values at runtime.\n\nUnlike `inputs`/`outputs` (which are applied imperatively after creation), `bindings` are applied **at creation time**, so they participate in the component's initial change detection cycle.\n\n```ts\nimport {\n  inputBinding,\n  outputBinding,\n  twoWayBinding,\n  signal,\n} from '@angular/core'\nimport { flexRenderComponent } from '@tanstack/angular-table'\n\nreadonly name = signal('Ada')\n\ncell: () =>\n  flexRenderComponent(EditableNameCellComponent, {\n    bindings: [\n      inputBinding('value', this.name),\n      outputBinding('valueChange', value => {\n        console.log('changed', value)\n      }),\n      twoWayBinding('value', this.name),\n    ],\n  })\n```\n\n> Avoid mixing `bindings` with `inputs`/`outputs` on the same property. `bindings` are applied at creation, while `inputs`/`outputs` are applied post-creation, so mixing them can lead to double initialization or conflicting values.\n\nSee the Angular docs for details:\n\n- [Programmatic rendering: Binding inputs/outputs/directives](https://angular.dev/guide/components/programmatic-rendering#binding-inputs-outputs-and-setting-host-directives-at-creation)\n- [`inputBinding`](https://angular.dev/api/core/inputBinding), [`outputBinding`](https://angular.dev/api/core/outputBinding), [`twoWayBinding`](https://angular.dev/api/core/twoWayBinding)\n\n### Returning a component class\n\nReturn a component class from `header`, `cell`, or `footer`.\n\nThe render context properties (`table`, `column`, `header`, `cell`, `row`, `getValue`, etc.) are automatically set as component inputs via `ComponentRef.setInput(...)`.\n\nDefine input signals matching the context property names you need:\n\n```ts\nimport { Component, input } from '@angular/core'\nimport type { ColumnDef, Table, CellContext } from '@tanstack/angular-table'\n\nconst columns: ColumnDef<Person>[] = [\n  {\n    id: 'select',\n    header: () => TableHeadSelectionComponent,\n    cell: () => TableRowSelectionComponent,\n  },\n]\n\n@Component({\n  template: `\n    <input\n      type=\"checkbox\"\n      [checked]=\"table().getIsAllRowsSelected()\"\n      [indeterminate]=\"table().getIsSomeRowsSelected()\"\n      (change)=\"table().toggleAllRowsSelected()\"\n    />\n  `,\n})\nexport class TableHeadSelectionComponent<T> {\n  readonly table = input.required<Table<T>>()\n  // column = input.required<Column<typeof features, T, unknown>>()\n  // header = input.required<Header<typeof features, T, unknown>>()\n}\n```\n\nOnly properties declared with `input()` / `input.required()` are set; other context properties are silently ignored. You can also access the full context via [`injectFlexRenderContext()`](#injectflexrendercontext).\n\n## TemplateRef rendering\n\nYou can return a `TemplateRef` from column definitions. The render context is passed as the template's `$implicit` context.\n\nUse `viewChild(...)` to capture template references:\n\n```ts\nimport { Component, TemplateRef, viewChild } from '@angular/core'\nimport type {\n  CellContext,\n  ColumnDef,\n  HeaderContext,\n} from '@tanstack/angular-table'\n\n@Component({\n  template: `\n    <ng-template #customHeader let-context>\n      {{ context.column.id }}\n    </ng-template>\n\n    <ng-template #customCell let-context>\n      {{ context.getValue() }}\n    </ng-template>\n  `,\n})\nexport class AppComponent {\n  readonly customHeader =\n    viewChild.required<\n      TemplateRef<{ $implicit: HeaderContext<any, any, any> }>\n    >('customHeader')\n  readonly customCell =\n    viewChild.required<TemplateRef<{ $implicit: CellContext<any, any, any> }>>(\n      'customCell',\n    )\n\n  readonly columns: ColumnDef<any>[] = [\n    {\n      id: 'templated',\n      header: () => this.customHeader(),\n      cell: () => this.customCell(),\n    },\n  ]\n}\n```\n\n`TemplateRef` rendering uses `createEmbeddedView` with an injector that includes the [DI context tokens](#dependency-injection). For reusable render blocks shared across multiple screens, prefer standalone components over `TemplateRef`.\n\n## Dependency injection\n\n`FlexRender` automatically provides DI tokens when rendering components and templates. These tokens are created in the `#getInjector` method of the renderer, which builds a child `Injector` with the render context properties.\n\n### `injectFlexRenderContext`\n\n`injectFlexRenderContext<T>()` returns the full props object passed to `*flexRender`. The return type depends on the column definition slot:\n\n- In a `cell` definition: `CellContext<TFeatures, TData, TValue>`\n- In a `header`/`footer` definition: `HeaderContext<TFeatures, TData, TValue>`\n\n```ts\nimport { Component } from '@angular/core'\nimport {\n  injectFlexRenderContext,\n  type CellContext,\n} from '@tanstack/angular-table'\n\n@Component({\n  template: `\n    <span>{{ context.getValue() }}</span>\n    <button (click)=\"context.row.toggleSelected()\">Toggle</button>\n  `,\n})\nexport class InteractiveCellComponent {\n  readonly context = injectFlexRenderContext<CellContext<any, any, any>>()\n}\n```\n\nInternally, the renderer wraps the context in a `Proxy` so that property access always reflects the latest values, even after re-renders.\n\n### Context directives\n\nThree optional directives let you expose table, header, and cell context to **any descendant** in the template, not just components rendered by `*flexRender`.\n\nThis eliminates prop drilling: instead of passing data through multiple `input()` layers, any nested component or directive can inject the context directly.\n\n| Directive             | Selector                | Token                      | Inject helper                |\n| --------------------- | ----------------------- | -------------------------- | ---------------------------- |\n| `TanStackTable`       | `[tanStackTable]`       | `TanStackTableToken`       | `injectTableContext()`       |\n| `TanStackTableHeader` | `[tanStackTableHeader]` | `TanStackTableHeaderToken` | `injectTableHeaderContext()` |\n| `TanStackTableCell`   | `[tanStackTableCell]`   | `TanStackTableCellToken`   | `injectTableCellContext()`   |\n\nImport them alongside `FlexRender`:\n\n```ts\nimport {\n  FlexRender,\n  TanStackTable,\n  TanStackTableHeader,\n  TanStackTableCell,\n} from '@tanstack/angular-table'\n\n@Component({\n  imports: [FlexRender, TanStackTable, TanStackTableHeader, TanStackTableCell],\n  templateUrl: './app.html',\n})\nexport class AppComponent {}\n```\n\nApply them in the template to establish injection scopes:\n\n```html\n<table [tanStackTable]=\"table\">\n  <!-- components can access to table context -->\n\n  @for (headerGroup of table.getHeaderGroups(); track headerGroup.id) {\n  <tr>\n    @for (header of headerGroup.headers; track header.id) {\n    <th [tanStackTableHeader]=\"header\">\n      <!-- components can access to table header context -->\n    </th>\n    }\n  </tr>\n  } @for (row of table.getRowModel().rows; track row.id) {\n  <tr>\n    @for (cell of row.getVisibleCells(); track cell.id) {\n    <td [tanStackTableCell]=\"cell\">\n      <!-- components can access to table cell context -->\n    </td>\n    }\n  </tr>\n  }\n</table>\n```\n\nAny component nested inside a `[tanStackTableCell]` host can inject the cell context:\n\n```ts\nimport { Component } from '@angular/core'\nimport { injectTableCellContext } from '@tanstack/angular-table'\n\n@Component({\n  template: `\n    <button (click)=\"onAction()\">Action for {{ cell().id }}</button>\n  `,\n})\nexport class CellActionsComponent {\n  readonly cell = injectTableCellContext()\n\n  onAction() {\n    console.log('Cell:', this.cell())\n  }\n}\n```\n\n```html\n<!-- No need to pass cell as an input, it is injected -->\n<td [tanStackTableCell]=\"cell\">\n  <app-cell-actions />\n</td>\n```\n\nEach directive uses Angular's `providers` array to register a factory that reads its own input signal.\n\nThis means the token is scoped to the directive's host element and its descendants. Multiple `[tanStackTableCell]` directives on different elements provide independent contexts.\n\n### Automatic token injection in FlexRender\n\nWhen `FlexRender` renders a component or template, it also provides DI tokens automatically based on the render context shape. In the renderer's `#getInjector` method, if the context object contains `table`, `cell`, or `header` properties, the corresponding `TanStackTableToken`, `TanStackTableCellToken`, or `TanStackTableHeaderToken` tokens are provided in the child injector.\n\nThis means that even **without** the context directives, components rendered via `*flexRender` can use `injectTableContext()`, `injectTableCellContext()`, and `injectTableHeaderContext()`. The context directives are only needed for components that live **outside** the `*flexRender` rendering tree (e.g. sibling components in the same `<td>`).\n","originalRawMarkdown":"---\ntitle: FlexRender (Angular) Guide\n---\n\nThe `@tanstack/angular-table` adapter provides structural directives and dependency injection primitives for rendering table content in Angular templates.\n\n## `FlexRender` vs `flexRender`\n\nAngular uses the names for two related template concepts:\n\n- `FlexRender` is the exported tuple of rendering directives. Add it to a component's `imports` array.\n- `*flexRender` is the lower-level structural directive.\n- `*flexRenderCell`, `*flexRenderHeader`, and `*flexRenderFooter` are table-aware shorthand selectors included in `FlexRender`.\n\n`FlexRender` is the rendering primitive.\nIt is exported as a tuple of two directives:\n\n- `FlexRenderDirective`: the base structural directive (`*flexRender`)\n- `FlexRenderCell`: shorthand directives (`*flexRenderCell`, `*flexRenderHeader`, `*flexRenderFooter`)\n\nImport `FlexRender` to get both:\n\n```ts\nimport { Component } from '@angular/core'\nimport { FlexRender } from '@tanstack/angular-table'\n\n@Component({\n  imports: [FlexRender],\n  templateUrl: './app.html',\n})\nexport class AppComponent {}\n```\n\n### How it works\n\n`FlexRender` is an Angular **structural directive**. Internally, it resolves the column definition's `header`, `cell`, or `footer` function and renders the result using [`ViewContainerRef`](https://angular.dev/api/core/ViewContainerRef):\n\n- **Primitives** (`string`, `number`): rendered via `createEmbeddedView` into the host `ng-template`. The value is exposed as the template's implicit context (`let value`).\n- **`TemplateRef`**: rendered via `createEmbeddedView`. The render context (`CellContext`, `HeaderContext`) is passed as `$implicit`.\n- **`flexRenderComponent(...)`**: rendered via `createComponent` with explicit `inputs`, `outputs`, `bindings`, `directives`, and `injector`.\n- **Component type** (`Type<T>`): rendered via [`createComponent`](https://angular.dev/api/core/ViewContainerRef#createComponent). All properties from the render context are set as component inputs through [`ComponentRef.setInput`](https://angular.dev/api/core/ComponentRef#setInput).\n\nColumn definition functions (`header`, `cell`, `footer`) are called inside [`runInInjectionContext`](https://angular.dev/api/core/runInInjectionContext), which means you can call `inject()`, use signals, and access DI tokens directly in your render logic.\n\n## Cell rendering\n\nPrefer the shorthand directives for standard rendering:\n\n| Directive           | Input    | Column definition  |\n| ------------------- | -------- | ------------------ |\n| `*flexRenderCell`   | `Cell`   | `columnDef.cell`   |\n| `*flexRenderHeader` | `Header` | `columnDef.header` |\n| `*flexRenderFooter` | `Header` | `columnDef.footer` |\n\nEach shorthand resolves the correct column definition function and render context automatically through a `computed` signal, so no manual `props` mapping is needed.\n\n### Example\n\n```html\n<thead>\n  @for (headerGroup of table.getHeaderGroups(); track headerGroup.id) {\n  <tr>\n    @for (header of headerGroup.headers; track header.id) {\n    <th>\n      @if (!header.isPlaceholder) {\n      <ng-container *flexRenderHeader=\"header; let value\">\n        {{ value }}\n      </ng-container>\n      }\n    </th>\n    }\n  </tr>\n  }\n</thead>\n\n<tbody>\n  @for (row of table.getRowModel().rows; track row.id) {\n  <tr>\n    @for (cell of row.getVisibleCells(); track cell.id) {\n    <td>\n      <ng-container *flexRenderCell=\"cell; let value\">\n        {{ value }}\n      </ng-container>\n    </td>\n    }\n  </tr>\n  }\n</tbody>\n```\n\n## Cell rendering with custom props\n\nWhen you need full control over the `props` passed to the render function, use `*flexRender` directly.\n\n`FlexRenderDirective` accepts two inputs:\n\n- `flexRender`: the render definition (a column def function, a string, a `TemplateRef`, a component type, or a `flexRenderComponent(...)` wrapper)\n- `flexRenderProps`: the props object passed to the render function and used as the implicit template context\n\nStandard usage:\n\n```html\n<ng-container\n  *flexRender=\"\n    cell.column.columnDef.cell;\n    props: cell.getContext();\n    let rendered\n  \"\n>\n  {{ rendered }}\n</ng-container>\n```\n\nYou can pass a custom props object to override the default context shape:\n\n```html\n<ng-container\n  *flexRender=\"\n    cell.column.columnDef.cell;\n    props: {\n      value: cell.getValue(),\n      ...cell.getContext(),\n    };\n    let rendered\n  \"\n>\n  {{ rendered }}\n</ng-container>\n```\n\nInside rendered components, the full props object is available via [`injectFlexRenderContext()`](#injectflexrendercontext).\n\n## Component rendering\n\nYou can render Angular components from column definitions in two ways:\n\n### Using `flexRenderComponent`\n\n`flexRenderComponent(component, options?)` wraps a component type with explicit options for `inputs`, `outputs`, `injector`, `bindings`, and `directives`.\n\nUse this when you need to:\n\n- pass custom inputs not derived from the render context\n- subscribe to component outputs\n- provide a custom `Injector`\n- use creation-time `bindings` (Angular v20+)\n- apply host directives and binding values at runtime\n\n```ts\nimport { flexRenderComponent, type ColumnDef } from '@tanstack/angular-table'\n\nconst columns: ColumnDef<Person>[] = [\n  {\n    id: 'custom-cell',\n    cell: (ctx) =>\n      flexRenderComponent(CustomCellComponent, {\n        inputs: {\n          content: ctx.row.original.firstName,\n        },\n        outputs: {\n          clicked: (value) => {\n            console.log(value)\n          },\n        },\n      }),\n  },\n]\n```\n\n#### How inputs and outputs work\n\n**Inputs** are applied through [`ComponentRef.setInput(key, value)`](https://angular.dev/api/core/ComponentRef#setInput). This works with both `input()` signals and `@Input()` decorators. Inputs are diffed on every change detection cycle using `KeyValueDiffers`; only changed values trigger `setInput`.\n\nFor object-like inputs, updates are reference-based: if the object reference is stable, Angular's default input equality semantics prevent unnecessary updates.\n\n**Outputs** work through `OutputEmitterRef` subscriptions. The factory reads the component instance property by name, checks that it is an `OutputEmitterRef`, and subscribes to it. When the output emits, the corresponding callback from `outputs` is invoked. Subscriptions are cleaned up automatically when the component is destroyed.\n\n#### `bindings` API (Angular v20+)\n\n`flexRenderComponent` also accepts `bindings` and `directives`, forwarded directly to [`ViewContainerRef.createComponent`](https://angular.dev/api/core/ViewContainerRef#createComponent) at creation time.\n\nThis supports Angular programmatic rendering APIs for passing host directives and binding values at runtime.\n\nUnlike `inputs`/`outputs` (which are applied imperatively after creation), `bindings` are applied **at creation time**, so they participate in the component's initial change detection cycle.\n\n```ts\nimport {\n  inputBinding,\n  outputBinding,\n  twoWayBinding,\n  signal,\n} from '@angular/core'\nimport { flexRenderComponent } from '@tanstack/angular-table'\n\nreadonly name = signal('Ada')\n\ncell: () =>\n  flexRenderComponent(EditableNameCellComponent, {\n    bindings: [\n      inputBinding('value', this.name),\n      outputBinding('valueChange', value => {\n        console.log('changed', value)\n      }),\n      twoWayBinding('value', this.name),\n    ],\n  })\n```\n\n> Avoid mixing `bindings` with `inputs`/`outputs` on the same property. `bindings` are applied at creation, while `inputs`/`outputs` are applied post-creation, so mixing them can lead to double initialization or conflicting values.\n\nSee the Angular docs for details:\n\n- [Programmatic rendering: Binding inputs/outputs/directives](https://angular.dev/guide/components/programmatic-rendering#binding-inputs-outputs-and-setting-host-directives-at-creation)\n- [`inputBinding`](https://angular.dev/api/core/inputBinding), [`outputBinding`](https://angular.dev/api/core/outputBinding), [`twoWayBinding`](https://angular.dev/api/core/twoWayBinding)\n\n### Returning a component class\n\nReturn a component class from `header`, `cell`, or `footer`.\n\nThe render context properties (`table`, `column`, `header`, `cell`, `row`, `getValue`, etc.) are automatically set as component inputs via `ComponentRef.setInput(...)`.\n\nDefine input signals matching the context property names you need:\n\n```ts\nimport { Component, input } from '@angular/core'\nimport type { ColumnDef, Table, CellContext } from '@tanstack/angular-table'\n\nconst columns: ColumnDef<Person>[] = [\n  {\n    id: 'select',\n    header: () => TableHeadSelectionComponent,\n    cell: () => TableRowSelectionComponent,\n  },\n]\n\n@Component({\n  template: `\n    <input\n      type=\"checkbox\"\n      [checked]=\"table().getIsAllRowsSelected()\"\n      [indeterminate]=\"table().getIsSomeRowsSelected()\"\n      (change)=\"table().toggleAllRowsSelected()\"\n    />\n  `,\n})\nexport class TableHeadSelectionComponent<T> {\n  readonly table = input.required<Table<T>>()\n  // column = input.required<Column<typeof features, T, unknown>>()\n  // header = input.required<Header<typeof features, T, unknown>>()\n}\n```\n\nOnly properties declared with `input()` / `input.required()` are set; other context properties are silently ignored. You can also access the full context via [`injectFlexRenderContext()`](#injectflexrendercontext).\n\n## TemplateRef rendering\n\nYou can return a `TemplateRef` from column definitions. The render context is passed as the template's `$implicit` context.\n\nUse `viewChild(...)` to capture template references:\n\n```ts\nimport { Component, TemplateRef, viewChild } from '@angular/core'\nimport type {\n  CellContext,\n  ColumnDef,\n  HeaderContext,\n} from '@tanstack/angular-table'\n\n@Component({\n  template: `\n    <ng-template #customHeader let-context>\n      {{ context.column.id }}\n    </ng-template>\n\n    <ng-template #customCell let-context>\n      {{ context.getValue() }}\n    </ng-template>\n  `,\n})\nexport class AppComponent {\n  readonly customHeader =\n    viewChild.required<\n      TemplateRef<{ $implicit: HeaderContext<any, any, any> }>\n    >('customHeader')\n  readonly customCell =\n    viewChild.required<TemplateRef<{ $implicit: CellContext<any, any, any> }>>(\n      'customCell',\n    )\n\n  readonly columns: ColumnDef<any>[] = [\n    {\n      id: 'templated',\n      header: () => this.customHeader(),\n      cell: () => this.customCell(),\n    },\n  ]\n}\n```\n\n`TemplateRef` rendering uses `createEmbeddedView` with an injector that includes the [DI context tokens](#dependency-injection). For reusable render blocks shared across multiple screens, prefer standalone components over `TemplateRef`.\n\n## Dependency injection\n\n`FlexRender` automatically provides DI tokens when rendering components and templates. These tokens are created in the `#getInjector` method of the renderer, which builds a child `Injector` with the render context properties.\n\n### `injectFlexRenderContext`\n\n`injectFlexRenderContext<T>()` returns the full props object passed to `*flexRender`. The return type depends on the column definition slot:\n\n- In a `cell` definition: `CellContext<TFeatures, TData, TValue>`\n- In a `header`/`footer` definition: `HeaderContext<TFeatures, TData, TValue>`\n\n```ts\nimport { Component } from '@angular/core'\nimport {\n  injectFlexRenderContext,\n  type CellContext,\n} from '@tanstack/angular-table'\n\n@Component({\n  template: `\n    <span>{{ context.getValue() }}</span>\n    <button (click)=\"context.row.toggleSelected()\">Toggle</button>\n  `,\n})\nexport class InteractiveCellComponent {\n  readonly context = injectFlexRenderContext<CellContext<any, any, any>>()\n}\n```\n\nInternally, the renderer wraps the context in a `Proxy` so that property access always reflects the latest values, even after re-renders.\n\n### Context directives\n\nThree optional directives let you expose table, header, and cell context to **any descendant** in the template, not just components rendered by `*flexRender`.\n\nThis eliminates prop drilling: instead of passing data through multiple `input()` layers, any nested component or directive can inject the context directly.\n\n| Directive             | Selector                | Token                      | Inject helper                |\n| --------------------- | ----------------------- | -------------------------- | ---------------------------- |\n| `TanStackTable`       | `[tanStackTable]`       | `TanStackTableToken`       | `injectTableContext()`       |\n| `TanStackTableHeader` | `[tanStackTableHeader]` | `TanStackTableHeaderToken` | `injectTableHeaderContext()` |\n| `TanStackTableCell`   | `[tanStackTableCell]`   | `TanStackTableCellToken`   | `injectTableCellContext()`   |\n\nImport them alongside `FlexRender`:\n\n```ts\nimport {\n  FlexRender,\n  TanStackTable,\n  TanStackTableHeader,\n  TanStackTableCell,\n} from '@tanstack/angular-table'\n\n@Component({\n  imports: [FlexRender, TanStackTable, TanStackTableHeader, TanStackTableCell],\n  templateUrl: './app.html',\n})\nexport class AppComponent {}\n```\n\nApply them in the template to establish injection scopes:\n\n```html\n<table [tanStackTable]=\"table\">\n  <!-- components can access to table context -->\n\n  @for (headerGroup of table.getHeaderGroups(); track headerGroup.id) {\n  <tr>\n    @for (header of headerGroup.headers; track header.id) {\n    <th [tanStackTableHeader]=\"header\">\n      <!-- components can access to table header context -->\n    </th>\n    }\n  </tr>\n  } @for (row of table.getRowModel().rows; track row.id) {\n  <tr>\n    @for (cell of row.getVisibleCells(); track cell.id) {\n    <td [tanStackTableCell]=\"cell\">\n      <!-- components can access to table cell context -->\n    </td>\n    }\n  </tr>\n  }\n</table>\n```\n\nAny component nested inside a `[tanStackTableCell]` host can inject the cell context:\n\n```ts\nimport { Component } from '@angular/core'\nimport { injectTableCellContext } from '@tanstack/angular-table'\n\n@Component({\n  template: `\n    <button (click)=\"onAction()\">Action for {{ cell().id }}</button>\n  `,\n})\nexport class CellActionsComponent {\n  readonly cell = injectTableCellContext()\n\n  onAction() {\n    console.log('Cell:', this.cell())\n  }\n}\n```\n\n```html\n<!-- No need to pass cell as an input, it is injected -->\n<td [tanStackTableCell]=\"cell\">\n  <app-cell-actions />\n</td>\n```\n\nEach directive uses Angular's `providers` array to register a factory that reads its own input signal.\n\nThis means the token is scoped to the directive's host element and its descendants. Multiple `[tanStackTableCell]` directives on different elements provide independent contexts.\n\n### Automatic token injection in FlexRender\n\nWhen `FlexRender` renders a component or template, it also provides DI tokens automatically based on the render context shape. In the renderer's `#getInjector` method, if the context object contains `table`, `cell`, or `header` properties, the corresponding `TanStackTableToken`, `TanStackTableCellToken`, or `TanStackTableHeaderToken` tokens are provided in the child injector.\n\nThis means that even **without** the context directives, components rendered via `*flexRender` can use `injectTableContext()`, `injectTableCellContext()`, and `injectTableHeaderContext()`. The context directives are only needed for components that live **outside** the `*flexRender` rendering tree (e.g. sibling components in the same `<td>`).\n"}
