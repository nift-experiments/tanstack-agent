":"./sorting","children":[{"type":"text","value":"Sorting"}]}]}]}]},{"type":"heading","depth":3,"id":"enable-row-pinning","children":[{"type":"text","value":"Enable Row Pinning"}]},{"type":"paragraph","children":[{"type":"text","value":"To use row pinning, add "},{"type":"inlineCode","value":"rowPinningFeature"},{"type":"text","value":" to your features. Row pinning does not require a row model factory."}]},{"type":"code","value":"import {\n  rowPinningFeature,\n  tableFeatures,\n  injectTable,\n} from '@tanstack/angular-table'\n\nconst features = tableFeatures({ rowPinningFeature })\n\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n}))","lang":"ts"},{"type":"heading","depth":3,"id":"row-pinning-state","children":[{"type":"text","value":"Row Pinning State"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"rowPinning"},{"type":"text","value":" state stores row IDs in "},{"type":"inlineCode","value":"top"},{"type":"text","value":" and "},{"type":"inlineCode","value":"bottom"},{"type":"text","value":" arrays:"}]},{"type":"code","value":"type RowPinningState = {\n  top: string[]\n  bottom: string[]\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"You can pin rows by default with "},{"type":"inlineCode","value":"initialState.rowPinning"},{"type":"text","value":":"}]},{"type":"code","value":"readonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  initialState: {\n    rowPinning: {\n      top: ['0'],\n      bottom: ['3'],\n    },\n  },\n}))","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"If you need to manage row pinning outside of the table instance, the recommended v9 approach is an external atom (created with "},{"type":"inlineCode","value":"createAtom"},{"type":"text","value":" from "},{"type":"inlineCode","value":"@tanstack/angular-store"},{"type":"text","value":") passed to the table's "},{"type":"inlineCode","value":"atoms"},{"type":"text","value":" option. External atoms give you fine-grained subscriptions anywhere in your app, and other code can read or write the pinning state without re-running the "},{"type":"inlineCode","value":"injectTable"},{"type":"text","value":" options initializer on every change."}]},{"type":"code","value":"import { createAtom } from '@tanstack/angular-store'\nimport type { RowPinningState } from '@tanstack/angular-table'\n\nexport class App {\n  readonly rowPinningAtom = createAtom<RowPinningState>({\n    top: [],\n    bottom: [],\n  })\n\n  readonly table = injectTable(() => ({\n    features,\n    columns,\n    data: this.data(),\n    atoms: {\n      rowPinning: this.rowPinningAtom,\n    },\n  }))\n\n  // read this.rowPinningAtom.get() wherever you need the value\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Alternatively, the v8-style "},{"type":"inlineCode","value":"state.rowPinning"},{"type":"text","value":" plus "},{"type":"inlineCode","value":"onRowPinningChange"},{"type":"text","value":" pattern is still supported. In Angular this means owning the slice with an Angular signal. It can be convenient for simple integrations or when migrating v8 code, but it is less fine-grained than external atoms. See the "},{"type":"link","href":"./table-state","children":[{"type":"text","value":"Table State Guide"}]},{"type":"text","value":" for a deeper comparison."}]},{"type":"code","value":"readonly rowPinning = signal<RowPinningState>({\n  top: [],\n  bottom: [],\n})\n\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  state: {\n    rowPinning: this.rowPinning(),\n  },\n  onRowPinningChange: (updater) =>\n    typeof updater === 'function'\n      ? this.rowPinning.update(updater)\n      : this.rowPinning.set(updater),\n}))","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"table.setRowPinning"},{"type":"text","value":" to update the state directly, and "},{"type":"inlineCode","value":"table.resetRowPinning"},{"type":"text","value":" to reset it to "},{"type":"inlineCode","value":"initialState.rowPinning"},{"type":"text","value":". Pass "},{"type":"inlineCode","value":"true"},{"type":"text","value":" to "},{"type":"inlineCode","value":"resetRowPinning"},{"type":"text","value":" to clear both pinned row arrays."}]},{"type":"code","value":"table.setRowPinning({\n  top: ['0', '2'],\n  bottom: ['8'],\n})\n\ntable.resetRowPinning()\ntable.resetRowPinning(true)","lang":"ts"},{"type":"heading","depth":3,"id":"pin-rows-with-row-apis","children":[{"type":"text","value":"Pin Rows With Row APIs"}]},{"type":"paragraph","children":[{"type":"text","value":"Each row exposes APIs for checking whether it can be pinned, reading its pinned position, and changing its pinned position."}]},{"type":"code","value":"row.getCanPin()\nrow.getIsPinned() // 'top', 'bottom', or false\nrow.getPinnedIndex()\n\nrow.pin('top')\nrow.pin('bottom')\nrow.pin(false)","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"You can use these APIs to build pinning controls:"}]},{"type":"code","value":"@if (row.getCanPin()) {\n<div>\n  <button\n    type=\"button\"\n    (click)=\"row.pin('top')\"\n    [disabled]=\"row.getIsPinned() === 'top'\"\n  >\n    Top\n  </button>\n  <button\n    type=\"button\"\n    (click)=\"row.pin(false)\"\n    [disabled]=\"!row.getIsPinned()\"\n  >\n    Center\n  </button>\n  <button\n    type=\"button\"\n    (click)=\"row.pin('bottom')\"\n    [disabled]=\"row.getIsPinned() === 'bottom'\"\n  >\n    Bottom\n  </button>\n</div>\n}","lang":"html"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"row.pin"},{"type":"text","value":" API also accepts "},{"type":"inlineCode","value":"includeLeafRows"},{"type":"text","value":" and "},{"type":"inlineCode","value":"includeParentRows"},{"type":"text","value":" flags. These can be useful when pinning grouped or expanded rows and deciding whether related parent or leaf rows should move with the row."}]},{"type":"heading","depth":3,"id":"row-pinning-table-apis","children":[{"type":"text","value":"Row Pinning Table APIs"}]},{"type":"paragraph","children":[{"type":"text","value":"Row pinning splits the current row model into 3 row lists:"}]},{"type":"code","value":"table.getTopRows()\ntable.getCenterRows()\ntable.getBottomRows()","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"If you render pinned rows in separate table sections, use those APIs directly:"}]},{"type":"code","value":"<tbody>\n  @for (row of table.getTopRows(); track row.id) {\n  <tr class=\"pinned\">\n    <!-- render pinned row -->\n  </tr>\n  } @for (row of table.getCenterRows(); track row.id) {\n  <tr>\n    <!-- render center row -->\n  </tr>\n  } @for (row of table.getBottomRows(); track row.id) {\n  <tr class=\"pinned\">\n    <!-- render pinned row -->\n  </tr>\n  }\n</tbody>","lang":"html"},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"table.getIsSomeRowsPinned()"},{"type":"text","value":" to check whether any rows are pinned, or pass a position to check a specific pinned region."}]},{"type":"code","value":"table.getIsSomeRowsPinned()\ntable.getIsSomeRowsPinned('top')\ntable.getIsSomeRowsPinned('bottom')","lang":"ts"},{"type":"heading","depth":3,"id":"disable-row-pinning","children":[{"type":"text","value":"Disable Row Pinning"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, all rows can be pinned. You can disable row pinning for the whole table or decide per row with "},{"type":"inlineCode","value":"enableRowPinning"},{"type":"text","value":"."}]},{"type":"code","value":"readonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  enableRowPinning: row => row.original.status !== 'archived',\n}))","lang":"ts"},{"type":"heading","depth":3,"id":"keep-pinned-rows","children":[{"type":"text","value":"Keep Pinned Rows"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, "},{"type":"inlineCode","value":"keepPinnedRows"},{"type":"text","value":" is "},{"type":"inlineCode","value":"true"},{"type":"text","value":", so pinned rows stay visible in their pinned region even when they would otherwise be filtered or paginated out of the center rows."}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"keepPinnedRows"},{"type":"text","value":" to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" if pinned rows should only render when they are present in the current filtered and paginated row model."}]},{"type":"code","value":"readonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  keepPinnedRows: false,\n}))","lang":"ts"}],"headings":[{"id":"examples","text":"Examples","level":2},{"id":"row-pinning-setup","text":"Row Pinning Setup","level":3},{"id":"row-pinning-angular-guide","text":"Row Pinning (Angular) Guide","level":2},{"id":"enable-row-pinning","text":"Enable Row Pinning","level":3},{"id":"row-pinning-state","text":"Row Pinning State","level":3},{"id":"pin-rows-with-row-apis","text":"Pin Rows With Row APIs","level":3},{"id":"row-pinning-table-apis","text":"Row Pinning Table APIs","level":3},{"id":"disable-row-pinning","text":"Disable Row Pinning","level":3},{"id":"keep-pinned-rows","text":"Keep Pinned Rows","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Examples\n\nWant to skip to the implementation? Check out these Angular examples:\n\n- [Row Pinning](../examples/row-pinning)\n\n### Row Pinning Setup\n\nHere's how you set up your table to use row pinning features. Adding the row pinning feature enables the related APIs.\n\n```ts\nimport { signal } from '@angular/core'\nimport {\n  injectTable,\n  tableFeatures,\n  rowPinningFeature,\n} from '@tanstack/angular-table'\n\nconst features = tableFeatures({ rowPinningFeature })\n\nexport class App {\n  readonly data = signal(defaultData)\n\n  readonly table = injectTable(() => ({\n    features,\n    columns,\n    data: this.data(),\n  }))\n}\n```\n\n## Row Pinning (Angular) Guide\n\nRow pinning lets you keep selected rows in top or bottom row regions while the rest of the rows render in the center region.\n\nThere are 2 table features that can reorder rows, which happen in the following order:\n\n1. **Row Pinning** - If pinning, rows are split into top, center (unpinned), and bottom pinned rows.\n2. [Sorting](./sorting)\n\n### Enable Row Pinning\n\nTo use row pinning, add `rowPinningFeature` to your features. Row pinning does not require a row model factory.\n\n```ts\nimport {\n  rowPinningFeature,\n  tableFeatures,\n  injectTable,\n} from '@tanstack/angular-table'\n\nconst features = tableFeatures({ rowPinningFeature })\n\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n}))\n```\n\n### Row Pinning State\n\nThe `rowPinning` state stores row IDs in `top` and `bottom` arrays:\n\n```ts\ntype RowPinningState = {\n  top: string[]\n  bottom: string[]\n}\n```\n\nYou can pin rows by default with `initialState.rowPinning`:\n\n```ts\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  initialState: {\n    rowPinning: {\n      top: ['0'],\n      bottom: ['3'],\n    },\n  },\n}))\n```\n\nIf you need to manage row pinning outside of the table instance, the recommended v9 approach is an external atom (created with `createAtom` from `@tanstack/angular-store`) passed to the table's `atoms` option. External atoms give you fine-grained subscriptions anywhere in your app, and other code can read or write the pinning state without re-running the `injectTable` options initializer on every change.\n\n```ts\nimport { createAtom } from '@tanstack/angular-store'\nimport type { RowPinningState } from '@tanstack/angular-table'\n\nexport class App {\n  readonly rowPinningAtom = createAtom<RowPinningState>({\n    top: [],\n    bottom: [],\n  })\n\n  readonly table = injectTable(() => ({\n    features,\n    columns,\n    data: this.data(),\n    atoms: {\n      rowPinning: this.rowPinningAtom,\n    },\n  }))\n\n  // read this.rowPinningAtom.get() wherever you need the value\n}\n```\n\nAlternatively, the v8-style `state.rowPinning` plus `onRowPinningChange` pattern is still supported. In Angular this means owning the slice with an Angular signal. It can be convenient for simple integrations or when migrating v8 code, but it is less fine-grained than external atoms. See the [Table State Guide](./table-state) for a deeper comparison.\n\n```ts\nreadonly rowPinning = signal<RowPinningState>({\n  top: [],\n  bottom: [],\n})\n\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  state: {\n    rowPinning: this.rowPinning(),\n  },\n  onRowPinningChange: (updater) =>\n    typeof updater === 'function'\n      ? this.rowPinning.update(updater)\n      : this.rowPinning.set(updater),\n}))\n```\n\nUse `table.setRowPinning` to update the state directly, and `table.resetRowPinning` to reset it to `initialState.rowPinning`. Pass `true` to `resetRowPinning` to clear both pinned row arrays.\n\n```ts\ntable.setRowPinning({\n  top: ['0', '2'],\n  bottom: ['8'],\n})\n\ntable.resetRowPinning()\ntable.resetRowPinning(true)\n```\n\n### Pin Rows With Row APIs\n\nEach row exposes APIs for checking whether it can be pinned, reading its pinned position, and changing its pinned position.\n\n```ts\nrow.getCanPin()\nrow.getIsPinned() // 'top', 'bottom', or false\nrow.getPinnedIndex()\n\nrow.pin('top')\nrow.pin('bottom')\nrow.pin(false)\n```\n\nYou can use these APIs to build pinning controls:\n\n```html\n@if (row.getCanPin()) {\n<div>\n  <button\n    type=\"button\"\n    (click)=\"row.pin('top')\"\n    [disabled]=\"row.getIsPinned() === 'top'\"\n  >\n    Top\n  </button>\n  <button\n    type=\"button\"\n    (click)=\"row.pin(false)\"\n    [disabled]=\"!row.getIsPinned()\"\n  >\n    Center\n  </button>\n  <button\n    type=\"button\"\n    (click)=\"row.pin('bottom')\"\n    [disabled]=\"row.getIsPinned() === 'bottom'\"\n  >\n    Bottom\n  </button>\n</div>\n}\n```\n\nThe `row.pin` API also accepts `includeLeafRows` and `includeParentRows` flags. These can be useful when pinning grouped or expanded rows and deciding whether related parent or leaf rows should move with the row.\n\n### Row Pinning Table APIs\n\nRow pinning splits the current row model into 3 row lists:\n\n```ts\ntable.getTopRows()\ntable.getCenterRows()\ntable.getBottomRows()\n```\n\nIf you render pinned rows in separate table sections, use those APIs directly:\n\n```html\n<tbody>\n  @for (row of table.getTopRows(); track row.id) {\n  <tr class=\"pinned\">\n    <!-- render pinned row -->\n  </tr>\n  } @for (row of table.getCenterRows(); track row.id) {\n  <tr>\n    <!-- render center row -->\n  </tr>\n  } @for (row of table.getBottomRows(); track row.id) {\n  <tr class=\"pinned\">\n    <!-- render pinned row -->\n  </tr>\n  }\n</tbody>\n```\n\nUse `table.getIsSomeRowsPinned()` to check whether any rows are pinned, or pass a position to check a specific pinned region.\n\n```ts\ntable.getIsSomeRowsPinned()\ntable.getIsSomeRowsPinned('top')\ntable.getIsSomeRowsPinned('bottom')\n```\n\n### Disable Row Pinning\n\nBy default, all rows can be pinned. You can disable row pinning for the whole table or decide per row with `enableRowPinning`.\n\n```ts\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  enableRowPinning: row => row.original.status !== 'archived',\n}))\n```\n\n### Keep Pinned Rows\n\nBy default, `keepPinnedRows` is `true`, so pinned rows stay visible in their pinned region even when they would otherwise be filtered or paginated out of the center rows.\n\nSet `keepPinnedRows` to `false` if pinned rows should only render when they are present in the current filtered and paginated row model.\n\n```ts\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  keepPinnedRows: false,\n}))\n```\n","originalRawMarkdown":"---\ntitle: Row Pinning (Angular) Guide\n---\n\n## Examples\n\nWant to skip to the implementation? Check out these Angular examples:\n\n- [Row Pinning](../examples/row-pinning)\n\n### Row Pinning Setup\n\nHere's how you set up your table to use row pinning features. Adding the row pinning feature enables the related APIs.\n\n```ts\nimport { signal } from '@angular/core'\nimport {\n  injectTable,\n  tableFeatures,\n  rowPinningFeature,\n} from '@tanstack/angular-table'\n\nconst features = tableFeatures({ rowPinningFeature })\n\nexport class App {\n  readonly data = signal(defaultData)\n\n  readonly table = injectTable(() => ({\n    features,\n    columns,\n    data: this.data(),\n  }))\n}\n```\n\n## Row Pinning (Angular) Guide\n\nRow pinning lets you keep selected rows in top or bottom row regions while the rest of the rows render in the center region.\n\nThere are 2 table features that can reorder rows, which happen in the following order:\n\n1. **Row Pinning** - If pinning, rows are split into top, center (unpinned), and bottom pinned rows.\n2. [Sorting](./sorting)\n\n### Enable Row Pinning\n\nTo use row pinning, add `rowPinningFeature` to your features. Row pinning does not require a row model factory.\n\n```ts\nimport {\n  rowPinningFeature,\n  tableFeatures,\n  injectTable,\n} from '@tanstack/angular-table'\n\nconst features = tableFeatures({ rowPinningFeature })\n\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n}))\n```\n\n### Row Pinning State\n\nThe `rowPinning` state stores row IDs in `top` and `bottom` arrays:\n\n```ts\ntype RowPinningState = {\n  top: string[]\n  bottom: string[]\n}\n```\n\nYou can pin rows by default with `initialState.rowPinning`:\n\n```ts\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  initialState: {\n    rowPinning: {\n      top: ['0'],\n      bottom: ['3'],\n    },\n  },\n}))\n```\n\nIf you need to manage row pinning outside of the table instance, the recommended v9 approach is an external atom (created with `createAtom` from `@tanstack/angular-store`) passed to the table's `atoms` option. External atoms give you fine-grained subscriptions anywhere in your app, and other code can read or write the pinning state without re-running the `injectTable` options initializer on every change.\n\n```ts\nimport { createAtom } from '@tanstack/angular-store'\nimport type { RowPinningState } from '@tanstack/angular-table'\n\nexport class App {\n  readonly rowPinningAtom = createAtom<RowPinningState>({\n    top: [],\n    bottom: [],\n  })\n\n  readonly table = injectTable(() => ({\n    features,\n    columns,\n    data: this.data(),\n    atoms: {\n      rowPinning: this.rowPinningAtom,\n    },\n  }))\n\n  // read this.rowPinningAtom.get() wherever you need the value\n}\n```\n\nAlternatively, the v8-style `state.rowPinning` plus `onRowPinningChange` pattern is still supported. In Angular this means owning the slice with an Angular signal. It can be convenient for simple integrations or when migrating v8 code, but it is less fine-grained than external atoms. See the [Table State Guide](./table-state) for a deeper comparison.\n\n```ts\nreadonly rowPinning = signal<RowPinningState>({\n  top: [],\n  bottom: [],\n})\n\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  state: {\n    rowPinning: this.rowPinning(),\n  },\n  onRowPinningChange: (updater) =>\n    typeof updater === 'function'\n      ? this.rowPinning.update(updater)\n      : this.rowPinning.set(updater),\n}))\n```\n\nUse `table.setRowPinning` to update the state directly, and `table.resetRowPinning` to reset it to `initialState.rowPinning`. Pass `true` to `resetRowPinning` to clear both pinned row arrays.\n\n```ts\ntable.setRowPinning({\n  top: ['0', '2'],\n  bottom: ['8'],\n})\n\ntable.resetRowPinning()\ntable.resetRowPinning(true)\n```\n\n### Pin Rows With Row APIs\n\nEach row exposes APIs for checking whether it can be pinned, reading its pinned position, and changing its pinned position.\n\n```ts\nrow.getCanPin()\nrow.getIsPinned() // 'top', 'bottom', or false\nrow.getPinnedIndex()\n\nrow.pin('top')\nrow.pin('bottom')\nrow.pin(false)\n```\n\nYou can use these APIs to build pinning controls:\n\n```html\n@if (row.getCanPin()) {\n<div>\n  <button\n    type=\"button\"\n    (click)=\"row.pin('top')\"\n    [disabled]=\"row.getIsPinned() === 'top'\"\n  >\n    Top\n  </button>\n  <button\n    type=\"button\"\n    (click)=\"row.pin(false)\"\n    [disabled]=\"!row.getIsPinned()\"\n  >\n    Center\n  </button>\n  <button\n    type=\"button\"\n    (click)=\"row.pin('bottom')\"\n    [disabled]=\"row.getIsPinned() === 'bottom'\"\n  >\n    Bottom\n  </button>\n</div>\n}\n```\n\nThe `row.pin` API also accepts `includeLeafRows` and `includeParentRows` flags. These can be useful when pinning grouped or expanded rows and deciding whether related parent or leaf rows should move with the row.\n\n### Row Pinning Table APIs\n\nRow pinning splits the current row model into 3 row lists:\n\n```ts\ntable.getTopRows()\ntable.getCenterRows()\ntable.getBottomRows()\n```\n\nIf you render pinned rows in separate table sections, use those APIs directly:\n\n```html\n<tbody>\n  @for (row of table.getTopRows(); track row.id) {\n  <tr class=\"pinned\">\n    <!-- render pinned row -->\n  </tr>\n  } @for (row of table.getCenterRows(); track row.id) {\n  <tr>\n    <!-- render center row -->\n  </tr>\n  } @for (row of table.getBottomRows(); track row.id) {\n  <tr class=\"pinned\">\n    <!-- render pinned row -->\n  </tr>\n  }\n</tbody>\n```\n\nUse `table.getIsSomeRowsPinned()` to check whether any rows are pinned, or pass a position to check a specific pinned region.\n\n```ts\ntable.getIsSomeRowsPinned()\ntable.getIsSomeRowsPinned('top')\ntable.getIsSomeRowsPinned('bottom')\n```\n\n### Disable Row Pinning\n\nBy default, all rows can be pinned. You can disable row pinning for the whole table or decide per row with `enableRowPinning`.\n\n```ts\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  enableRowPinning: row => row.original.status !== 'archived',\n}))\n```\n\n### Keep Pinned Rows\n\nBy default, `keepPinnedRows` is `true`, so pinned rows stay visible in their pinned region even when they would otherwise be filtered or paginated out of the center rows.\n\nSet `keepPinnedRows` to `false` if pinned rows should only render when they are present in the current filtered and paginated row model.\n\n```ts\nreadonly table = injectTable(() => ({\n  features,\n  columns,\n  data,\n  keepPinnedRows: false,\n}))\n```\n"}
