tures"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"TableFeatures"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"CellData"}]},{"type":"heading","depth":2,"id":"implements","children":[{"type":"text","value":"Implements"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"../interfaces/TanStackTableHeaderContext.md","children":[{"type":"inlineCode","value":"TanStackTableHeaderContext"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]}]}]},{"type":"heading","depth":2,"id":"constructors","children":[{"type":"text","value":"Constructors"}]},{"type":"heading","depth":3,"id":"constructor","children":[{"type":"text","value":"Constructor"}]},{"type":"code","value":"new TanStackTableHeader<TFeatures, TData, TValue>(): TanStackTableHeader<TFeatures, TData, TValue>;","lang":"ts"},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TanStackTableHeader"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"properties","children":[{"type":"text","value":"Properties"}]},{"type":"heading","depth":3,"id":"header","children":[{"type":"text","value":"header"}]},{"type":"code","value":"readonly header: InputSignal<Header<TFeatures, TData, TValue>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/angular-table/src/helpers/header.ts#L81","children":[{"type":"text","value":"packages/angular-table/src/helpers/header.ts:81"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The current TanStack Table header."}]},{"type":"paragraph","children":[{"type":"text","value":"Provided as a required signal input so DI consumers always read the latest value."}]},{"type":"heading","depth":4,"id":"implementation-of","children":[{"type":"text","value":"Implementation of"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/TanStackTableHeaderContext.md","children":[{"type":"inlineCode","value":"TanStackTableHeaderContext"}]},{"type":"text","value":"."},{"type":"link","href":"../interfaces/TanStackTableHeaderContext.md#header","children":[{"type":"inlineCode","value":"header"}]}]}],"headings":[{"id":"class-tanstacktableheadertfeatures-tdata-tvalue","text":"Class: TanStackTableHeader<TFeatures, TData, TValue>","level":1},{"id":"example","text":"Example","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"implements","text":"Implements","level":2},{"id":"constructors","text":"Constructors","level":2},{"id":"constructor","text":"Constructor","level":3},{"id":"returns","text":"Returns","level":4},{"id":"properties","text":"Properties","level":2},{"id":"header","text":"header","level":3},{"id":"implementation-of","text":"Implementation of","level":4}]},"frameworks":[],"downloadMarkdown":"\n# Class: TanStackTableHeader\\<TFeatures, TData, TValue\\>\n\nDefined in: [packages/angular-table/src/helpers/header.ts:71](https://github.com/TanStack/table/blob/main/packages/angular-table/src/helpers/header.ts#L71)\n\nProvides a TanStack Table `Header` instance in Angular DI.\n\nThe header can be injected by:\n- any descendant of an element using `[tanStackTableHeader]=\"...\"`\n- any component instantiated by `*flexRender` when the render props contains `header`\n\n## Example\n\n```html\n<th [tanStackTableHeader]=\"header\">\n  <app-sort-indicator />\n</th>\n```\n\n```ts\n@Component({\n  selector: 'app-sort-indicator',\n  template: `\n    <button (click)=\"toggle()\">\n      {{ header().column.id }}\n    </button>\n  `,\n})\nexport class SortIndicatorComponent {\n  readonly header = injectTableHeaderContext()\n\n  toggle() {\n    this.header().column.toggleSorting()\n  }\n}\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TValue\n\n`TValue` *extends* `CellData`\n\n## Implements\n\n- [`TanStackTableHeaderContext`](../interfaces/TanStackTableHeaderContext.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Constructors\n\n### Constructor\n\n```ts\nnew TanStackTableHeader<TFeatures, TData, TValue>(): TanStackTableHeader<TFeatures, TData, TValue>;\n```\n\n#### Returns\n\n`TanStackTableHeader`\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Properties\n\n### header\n\n```ts\nreadonly header: InputSignal<Header<TFeatures, TData, TValue>>;\n```\n\nDefined in: [packages/angular-table/src/helpers/header.ts:81](https://github.com/TanStack/table/blob/main/packages/angular-table/src/helpers/header.ts#L81)\n\nThe current TanStack Table header.\n\nProvided as a required signal input so DI consumers always read the latest value.\n\n#### Implementation of\n\n[`TanStackTableHeaderContext`](../interfaces/TanStackTableHeaderContext.md).[`header`](../interfaces/TanStackTableHeaderContext.md#header)\n","originalRawMarkdown":"---\nid: TanStackTableHeader\ntitle: TanStackTableHeader\n---\n\n# Class: TanStackTableHeader\\<TFeatures, TData, TValue\\>\n\nDefined in: [packages/angular-table/src/helpers/header.ts:71](https://github.com/TanStack/table/blob/main/packages/angular-table/src/helpers/header.ts#L71)\n\nProvides a TanStack Table `Header` instance in Angular DI.\n\nThe header can be injected by:\n- any descendant of an element using `[tanStackTableHeader]=\"...\"`\n- any component instantiated by `*flexRender` when the render props contains `header`\n\n## Example\n\n```html\n<th [tanStackTableHeader]=\"header\">\n  <app-sort-indicator />\n</th>\n```\n\n```ts\n@Component({\n  selector: 'app-sort-indicator',\n  template: `\n    <button (click)=\"toggle()\">\n      {{ header().column.id }}\n    </button>\n  `,\n})\nexport class SortIndicatorComponent {\n  readonly header = injectTableHeaderContext()\n\n  toggle() {\n    this.header().column.toggleSorting()\n  }\n}\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TValue\n\n`TValue` *extends* `CellData`\n\n## Implements\n\n- [`TanStackTableHeaderContext`](../interfaces/TanStackTableHeaderContext.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Constructors\n\n### Constructor\n\n```ts\nnew TanStackTableHeader<TFeatures, TData, TValue>(): TanStackTableHeader<TFeatures, TData, TValue>;\n```\n\n#### Returns\n\n`TanStackTableHeader`\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Properties\n\n### header\n\n```ts\nreadonly header: InputSignal<Header<TFeatures, TData, TValue>>;\n```\n\nDefined in: [packages/angular-table/src/helpers/header.ts:81](https://github.com/TanStack/table/blob/main/packages/angular-table/src/helpers/header.ts#L81)\n\nThe current TanStack Table header.\n\nProvided as a required signal input so DI consumers always read the latest value.\n\n#### Implementation of\n\n[`TanStackTableHeaderContext`](../interfaces/TanStackTableHeaderContext.md).[`header`](../interfaces/TanStackTableHeaderContext.md#header)\n"}
