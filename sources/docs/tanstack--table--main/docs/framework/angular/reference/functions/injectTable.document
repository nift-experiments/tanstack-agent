s","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"TableFeatures"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"inlineCode","value":"TableOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AngularTable.md","children":[{"type":"inlineCode","value":"AngularTable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"paragraph","children":[{"type":"text","value":"An Angular-reactive TanStack Table instance."}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Register the table features you need"}]}]}]},{"type":"code","value":"// Register only the features you need\nimport {tableFeatures, rowPaginationFeature} from '@tanstack/angular-table';\nconst features = tableFeatures({\n rowPaginationFeature,\n // ...all other features you need\n})\n\n// Use all table core features\nimport {stockFeatures} from '@tanstack/angular-table';\nconst features = tableFeatures(stockFeatures);","lang":"ts"},{"type":"list","ordered":true,"start":2,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Prepare the table columns"}]}]}]},{"type":"code","value":"import {ColumnDef} from '@tanstack/angular-table';\n\ntype MyData = {}\n\nconst columns: ColumnDef<typeof features, MyData>[] = [\n  // ...column definitions\n]\n\n// or using createColumnHelper\nimport {createColumnHelper} from '@tanstack/angular-table';\nconst columnHelper = createColumnHelper<typeof features, MyData>();\nconst columns = columnHelper.columns([\n columnHelper.accessor(...),\n // ...other columns\n])","lang":"ts"},{"type":"list","ordered":true,"start":3,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Create the table instance with "},{"type":"inlineCode","value":"injectTable"}]}]}]},{"type":"code","value":"const table = injectTable(() => {\n  // ...table options,\n  features,\n  columns: columns,\n  data: myDataSignal(),\n})","lang":"ts"}],"headings":[{"id":"function-injecttable","text":"Function: injectTable()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: injectTable()\n\n```ts\nfunction injectTable<TFeatures, TData>(options): AngularTable<TFeatures, TData>;\n```\n\nDefined in: [packages/angular-table/src/injectTable.ts:90](https://github.com/TanStack/table/blob/main/packages/angular-table/src/injectTable.ts#L90)\n\nCreates and returns an Angular-reactive table instance.\n\nThe initializer is intentionally re-evaluated whenever any signal read inside it changes.\nThis is how the adapter keeps the table in sync with Angular's reactivity model.\n\nBecause of that behavior, keep expensive/static values (for example `columns`, feature setup, row models)\nas stable references outside the initializer, and only read reactive state (`data()`, pagination/filter/sorting signals, etc.)\ninside it.\n\nThe returned table is also signal-reactive: table state and table APIs are wired for Angular signals, so you can safely consume table methods inside `computed(...)` and `effect(...)`.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n## Parameters\n\n### options\n\n() => `TableOptions`\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`AngularTable`](../type-aliases/AngularTable.md)\\<`TFeatures`, `TData`\\>\n\nAn Angular-reactive TanStack Table instance.\n\n## Example\n\n1. Register the table features you need\n```ts\n// Register only the features you need\nimport {tableFeatures, rowPaginationFeature} from '@tanstack/angular-table';\nconst features = tableFeatures({\n rowPaginationFeature,\n // ...all other features you need\n})\n\n// Use all table core features\nimport {stockFeatures} from '@tanstack/angular-table';\nconst features = tableFeatures(stockFeatures);\n```\n2. Prepare the table columns\n```ts\nimport {ColumnDef} from '@tanstack/angular-table';\n\ntype MyData = {}\n\nconst columns: ColumnDef<typeof features, MyData>[] = [\n  // ...column definitions\n]\n\n// or using createColumnHelper\nimport {createColumnHelper} from '@tanstack/angular-table';\nconst columnHelper = createColumnHelper<typeof features, MyData>();\nconst columns = columnHelper.columns([\n columnHelper.accessor(...),\n // ...other columns\n])\n```\n3. Create the table instance with `injectTable`\n```ts\nconst table = injectTable(() => {\n  // ...table options,\n  features,\n  columns: columns,\n  data: myDataSignal(),\n})\n```\n","originalRawMarkdown":"---\nid: injectTable\ntitle: injectTable\n---\n\n# Function: injectTable()\n\n```ts\nfunction injectTable<TFeatures, TData>(options): AngularTable<TFeatures, TData>;\n```\n\nDefined in: [packages/angular-table/src/injectTable.ts:90](https://github.com/TanStack/table/blob/main/packages/angular-table/src/injectTable.ts#L90)\n\nCreates and returns an Angular-reactive table instance.\n\nThe initializer is intentionally re-evaluated whenever any signal read inside it changes.\nThis is how the adapter keeps the table in sync with Angular's reactivity model.\n\nBecause of that behavior, keep expensive/static values (for example `columns`, feature setup, row models)\nas stable references outside the initializer, and only read reactive state (`data()`, pagination/filter/sorting signals, etc.)\ninside it.\n\nThe returned table is also signal-reactive: table state and table APIs are wired for Angular signals, so you can safely consume table methods inside `computed(...)` and `effect(...)`.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n## Parameters\n\n### options\n\n() => `TableOptions`\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`AngularTable`](../type-aliases/AngularTable.md)\\<`TFeatures`, `TData`\\>\n\nAn Angular-reactive TanStack Table instance.\n\n## Example\n\n1. Register the table features you need\n```ts\n// Register only the features you need\nimport {tableFeatures, rowPaginationFeature} from '@tanstack/angular-table';\nconst features = tableFeatures({\n rowPaginationFeature,\n // ...all other features you need\n})\n\n// Use all table core features\nimport {stockFeatures} from '@tanstack/angular-table';\nconst features = tableFeatures(stockFeatures);\n```\n2. Prepare the table columns\n```ts\nimport {ColumnDef} from '@tanstack/angular-table';\n\ntype MyData = {}\n\nconst columns: ColumnDef<typeof features, MyData>[] = [\n  // ...column definitions\n]\n\n// or using createColumnHelper\nimport {createColumnHelper} from '@tanstack/angular-table';\nconst columnHelper = createColumnHelper<typeof features, MyData>();\nconst columns = columnHelper.columns([\n columnHelper.accessor(...),\n // ...other columns\n])\n```\n3. Create the table instance with `injectTable`\n```ts\nconst table = injectTable(() => {\n  // ...table options,\n  features,\n  columns: columns,\n  data: myDataSignal(),\n})\n```\n"}
