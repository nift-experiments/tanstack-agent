pe":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Atom"},{"type":"text","value":"<"},{"type":"inlineCode","value":"T"},{"type":"text","value":">"}]}],"headings":[{"id":"function-createatom","text":"Function: createAtom()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"t","text":"T","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"initialvalue","text":"initialValue","level":3},{"id":"options","text":"options?","level":3},{"id":"returns","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: createAtom()\n\n```ts\nfunction createAtom<T>(initialValue, options?): Atom<T>;\n```\n\nDefined in: packages/ember-table/declarations/signal.d.ts:36\n\nCreates an Ember-native writable atom, satisfying the `@tanstack/store`\n`Atom` contract so it can be passed to `options.atoms`. Because it is backed\nby a `@tracked` Signal, reading `atom.get()` directly in a template or\ngetter is reactive — unlike a foreign `@tanstack/store` atom, whose reads\ncreate no Glimmer tag dependency.\n\nTakes a plain initial value only; there is no derived/function overload.\n\n## Type Parameters\n\n### T\n\n`T`\n\n## Parameters\n\n### initialValue\n\n`T`\n\n### options?\n\n`AtomOptions`\\<`T`\\>\n\n## Returns\n\n`Atom`\\<`T`\\>\n","originalRawMarkdown":"---\nid: createAtom\ntitle: createAtom\n---\n\n# Function: createAtom()\n\n```ts\nfunction createAtom<T>(initialValue, options?): Atom<T>;\n```\n\nDefined in: packages/ember-table/declarations/signal.d.ts:36\n\nCreates an Ember-native writable atom, satisfying the `@tanstack/store`\n`Atom` contract so it can be passed to `options.atoms`. Because it is backed\nby a `@tracked` Signal, reading `atom.get()` directly in a template or\ngetter is reactive — unlike a foreign `@tanstack/store` atom, whose reads\ncreate no Glimmer tag dependency.\n\nTakes a plain initial value only; there is no derived/function overload.\n\n## Type Parameters\n\n### T\n\n`T`\n\n## Parameters\n\n### initialValue\n\n`T`\n\n### options?\n\n`AtomOptions`\\<`T`\\>\n\n## Returns\n\n`Atom`\\<`T`\\>\n"}
