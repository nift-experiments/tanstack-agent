pe":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":5,"id":"parameters-3","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":6,"id":"gettableoptions-2","children":[{"type":"text","value":"getTableOptions"}]},{"type":"paragraph","children":[{"type":"text","value":"() => "},{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TableOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"features\""},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AppEmberTable.md","children":[{"type":"inlineCode","value":"AppEmberTable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const { createAppTable, createAppColumnHelper } = createTableHook({\n  features: tableFeatures({ rowSortingFeature, sortedRowModel: createSortedRowModel(), sortFns }),\n})\n\nconst columnHelper = createAppColumnHelper<Person>()\nconst columns = columnHelper.columns([...])\n\n// inside a Glimmer component; passing `this` binds cleanup to its lifecycle\ntable = createAppTable(this, () => ({ columns, data: this.data }))","lang":"ts"}],"headings":[{"id":"function-createtablehook","text":"Function: createTableHook()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"namedparameters","text":"__namedParameters","level":3},{"id":"returns","text":"Returns","level":2},{"id":"appfeatures","text":"appFeatures","level":3},{"id":"createappcolumnhelper","text":"createAppColumnHelper()","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":4},{"id":"tdata","text":"TData","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"createapptable","text":"createAppTable()","level":3},{"id":"call-signature","text":"Call Signature","level":4},{"id":"type-parameters-3","text":"Type Parameters","level":5},{"id":"tdata-2","text":"TData","level":6},{"id":"parameters-2","text":"Parameters","level":5},{"id":"owner","text":"owner","level":6},{"id":"gettableoptions","text":"getTableOptions","level":6},{"id":"returns-3","text":"Returns","level":5},{"id":"call-signature-2","text":"Call Signature","level":4},{"id":"type-parameters-4","text":"Type Parameters","level":5},{"id":"tdata-3","text":"TData","level":6},{"id":"parameters-3","text":"Parameters","level":5},{"id":"gettableoptions-2","text":"getTableOptions","level":6},{"id":"returns-4","text":"Returns","level":5},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: createTableHook()\n\n```ts\nfunction createTableHook<TFeatures>(__namedParameters): object;\n```\n\nDefined in: packages/ember-table/declarations/create-table-hook.d.ts:28\n\nBundles a feature set and shared default options once so every table in your\napp can be created without repeating them. Returns a typed column helper\nfactory and a `createAppTable` that wraps [useTable](useTable.md).\n\nUnlike the React adapter's hook, this does not pre-bind cell/header\ncomponents onto the table; render with the `FlexRenderCell`,\n`FlexRenderHeader`, and `FlexRenderFooter` components as usual.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n## Parameters\n\n### \\_\\_namedParameters\n\n[`CreateTableHookOptions`](../type-aliases/CreateTableHookOptions.md)\\<`TFeatures`\\>\n\n## Returns\n\n`object`\n\n### appFeatures\n\n```ts\nappFeatures: TFeatures;\n```\n\n### createAppColumnHelper()\n\n```ts\ncreateAppColumnHelper: <TData>() => ColumnHelper<TFeatures, TData>;\n```\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n#### Returns\n\n`ColumnHelper`\\<`TFeatures`, `TData`\\>\n\n### createAppTable()\n\n```ts\ncreateAppTable: {\n<TData>  (owner, getTableOptions): AppEmberTable<TFeatures, TData>;\n<TData>  (getTableOptions): AppEmberTable<TFeatures, TData>;\n};\n```\n\n#### Call Signature\n\n```ts\n<TData>(owner, getTableOptions): AppEmberTable<TFeatures, TData>;\n```\n\n##### Type Parameters\n\n###### TData\n\n`TData` *extends* `RowData`\n\n##### Parameters\n\n###### owner\n\n`object`\n\n###### getTableOptions\n\n() => `Omit`\\<`TableOptions`\\<`TFeatures`, `TData`\\>, `\"features\"`\\>\n\n##### Returns\n\n[`AppEmberTable`](../type-aliases/AppEmberTable.md)\\<`TFeatures`, `TData`\\>\n\n#### Call Signature\n\n```ts\n<TData>(getTableOptions): AppEmberTable<TFeatures, TData>;\n```\n\n##### Type Parameters\n\n###### TData\n\n`TData` *extends* `RowData`\n\n##### Parameters\n\n###### getTableOptions\n\n() => `Omit`\\<`TableOptions`\\<`TFeatures`, `TData`\\>, `\"features\"`\\>\n\n##### Returns\n\n[`AppEmberTable`](../type-aliases/AppEmberTable.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```ts\nconst { createAppTable, createAppColumnHelper } = createTableHook({\n  features: tableFeatures({ rowSortingFeature, sortedRowModel: createSortedRowModel(), sortFns }),\n})\n\nconst columnHelper = createAppColumnHelper<Person>()\nconst columns = columnHelper.columns([...])\n\n// inside a Glimmer component; passing `this` binds cleanup to its lifecycle\ntable = createAppTable(this, () => ({ columns, data: this.data }))\n```\n","originalRawMarkdown":"---\nid: createTableHook\ntitle: createTableHook\n---\n\n# Function: createTableHook()\n\n```ts\nfunction createTableHook<TFeatures>(__namedParameters): object;\n```\n\nDefined in: packages/ember-table/declarations/create-table-hook.d.ts:28\n\nBundles a feature set and shared default options once so every table in your\napp can be created without repeating them. Returns a typed column helper\nfactory and a `createAppTable` that wraps [useTable](useTable.md).\n\nUnlike the React adapter's hook, this does not pre-bind cell/header\ncomponents onto the table; render with the `FlexRenderCell`,\n`FlexRenderHeader`, and `FlexRenderFooter` components as usual.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n## Parameters\n\n### \\_\\_namedParameters\n\n[`CreateTableHookOptions`](../type-aliases/CreateTableHookOptions.md)\\<`TFeatures`\\>\n\n## Returns\n\n`object`\n\n### appFeatures\n\n```ts\nappFeatures: TFeatures;\n```\n\n### createAppColumnHelper()\n\n```ts\ncreateAppColumnHelper: <TData>() => ColumnHelper<TFeatures, TData>;\n```\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n#### Returns\n\n`ColumnHelper`\\<`TFeatures`, `TData`\\>\n\n### createAppTable()\n\n```ts\ncreateAppTable: {\n<TData>  (owner, getTableOptions): AppEmberTable<TFeatures, TData>;\n<TData>  (getTableOptions): AppEmberTable<TFeatures, TData>;\n};\n```\n\n#### Call Signature\n\n```ts\n<TData>(owner, getTableOptions): AppEmberTable<TFeatures, TData>;\n```\n\n##### Type Parameters\n\n###### TData\n\n`TData` *extends* `RowData`\n\n##### Parameters\n\n###### owner\n\n`object`\n\n###### getTableOptions\n\n() => `Omit`\\<`TableOptions`\\<`TFeatures`, `TData`\\>, `\"features\"`\\>\n\n##### Returns\n\n[`AppEmberTable`](../type-aliases/AppEmberTable.md)\\<`TFeatures`, `TData`\\>\n\n#### Call Signature\n\n```ts\n<TData>(getTableOptions): AppEmberTable<TFeatures, TData>;\n```\n\n##### Type Parameters\n\n###### TData\n\n`TData` *extends* `RowData`\n\n##### Parameters\n\n###### getTableOptions\n\n() => `Omit`\\<`TableOptions`\\<`TFeatures`, `TData`\\>, `\"features\"`\\>\n\n##### Returns\n\n[`AppEmberTable`](../type-aliases/AppEmberTable.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```ts\nconst { createAppTable, createAppColumnHelper } = createTableHook({\n  features: tableFeatures({ rowSortingFeature, sortedRowModel: createSortedRowModel(), sortFns }),\n})\n\nconst columnHelper = createAppColumnHelper<Person>()\nconst columns = columnHelper.columns([...])\n\n// inside a Glimmer component; passing `this` binds cleanup to its lifecycle\ntable = createAppTable(this, () => ({ columns, data: this.data }))\n```\n"}
