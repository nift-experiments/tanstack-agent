nt hosts, this corresponds to the "},{"type":"inlineCode","value":"disconnectedCallback()"},{"type":"text","value":" lifecycle,\nwhich is called the host or an ancestor component is disconnected from the\ndocument."}]},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"implementation-of-2","children":[{"type":"text","value":"Implementation of"}]},{"type":"code","value":"ReactiveController.hostDisconnected","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"hostupdated","children":[{"type":"text","value":"hostUpdated()"}]},{"type":"code","value":"hostUpdated(): void;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/lit-table/src/TableController.ts#L257","children":[{"type":"text","value":"packages/lit-table/src/TableController.ts:257"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called after a host update, just before the host calls firstUpdated and\nupdated. It is not called in server-side rendering."}]},{"type":"heading","depth":4,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":4,"id":"implementation-of-3","children":[{"type":"text","value":"Implementation of"}]},{"type":"code","value":"ReactiveController.hostUpdated","lang":"ts"},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table()"}]},{"type":"code","value":"table<TSelected>(tableOptions, selector?): LitTable<TFeatures, TData, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/lit-table/src/TableController.ts#L164","children":[{"type":