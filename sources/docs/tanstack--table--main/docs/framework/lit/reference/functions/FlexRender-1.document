"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"props","children":[{"type":"text","value":"props"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/FlexRenderProps.md","children":[{"type":"inlineCode","value":"FlexRenderProps"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/LitRenderable.md","children":[{"type":"inlineCode","value":"LitRenderable"}]}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"${FlexRender({ cell })}\n${FlexRender({ header })}\n${FlexRender({ footer: header })}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"This replaces calling "},{"type":"inlineCode","value":"flexRender"},{"type":"text","value":" directly like this:"}]},{"type":"code","value":"flexRender(cell.column.columnDef.cell, cell.getContext())\nflexRender(header.column.columnDef.header, header.getContext())\nflexRender(footer.column.columnDef.footer, footer.getContext())","lang":"ts"}],"headings":[{"id":"function-flexrender","text":"Function: FlexRender()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"props","text":"props","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: FlexRender()\n\n```ts\nfunction FlexRender<TFeatures, TData, TValue>(props): LitRenderable;\n```\n\nDefined in: [packages/lit-table/src/flexRender.ts:101](https://github.com/TanStack/table/blob/main/packages/lit-table/src/flexRender.ts#L101)\n\nSimplified component wrapper of `flexRender`. Use this utility function to render headers, cells, or footers with custom markup.\nOnly one prop (`cell`, `header`, or `footer`) may be passed.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### props\n\n[`FlexRenderProps`](../type-aliases/FlexRenderProps.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n[`LitRenderable`](../type-aliases/LitRenderable.md)\n\n## Example\n\n```ts\n${FlexRender({ cell })}\n${FlexRender({ header })}\n${FlexRender({ footer: header })}\n```\n\nThis replaces calling `flexRender` directly like this:\n```ts\nflexRender(cell.column.columnDef.cell, cell.getContext())\nflexRender(header.column.columnDef.header, header.getContext())\nflexRender(footer.column.columnDef.footer, footer.getContext())\n```\n","originalRawMarkdown":"---\nid: FlexRender\ntitle: FlexRender\n---\n\n# Function: FlexRender()\n\n```ts\nfunction FlexRender<TFeatures, TData, TValue>(props): LitRenderable;\n```\n\nDefined in: [packages/lit-table/src/flexRender.ts:101](https://github.com/TanStack/table/blob/main/packages/lit-table/src/flexRender.ts#L101)\n\nSimplified component wrapper of `flexRender`. Use this utility function to render headers, cells, or footers with custom markup.\nOnly one prop (`cell`, `header`, or `footer`) may be passed.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### props\n\n[`FlexRenderProps`](../type-aliases/FlexRenderProps.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n[`LitRenderable`](../type-aliases/LitRenderable.md)\n\n## Example\n\n```ts\n${FlexRender({ cell })}\n${FlexRender({ header })}\n${FlexRender({ footer: header })}\n```\n\nThis replaces calling `flexRender` directly like this:\n```ts\nflexRender(cell.column.columnDef.cell, cell.getContext())\nflexRender(header.column.columnDef.header, header.getContext())\nflexRender(footer.column.columnDef.footer, footer.getContext())\n```\n"}
