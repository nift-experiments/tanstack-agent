:"text","value":" & "},{"type":"inlineCode","value":"HTMLElement"}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ContextConsumer"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Context"},{"type":"text","value":"<"},{"type":"inlineCode","value":"symbol"},{"type":"text","value":", "},{"type":"inlineCode","value":"Header"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">>, "},{"type":"inlineCode","value":"ReactiveControllerHost"},{"type":"text","value":" & "},{"type":"inlineCode","value":"HTMLElement"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"usetablecontext","children":[{"type":"text","value":"useTableContext()"}]},{"type":"code","value":"useTableContext: <TData>(host) => ContextConsumer<Context<symbol, LitTable<TFeatures, TData, any>>, ReactiveControllerHost & HTMLElement>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L400","children":[{"type":"text","value":"packages/lit-table/src/createTableHook.ts:400"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Reads the table provided by the nearest ancestor that called "},{"type":"inlineCode","value":"useAppTable"},{"type":"text","value":",\nvia a "},{"type":"inlineCode","value":"@lit/context"},{"type":"text","value":" "},{"type":"inlineCode","value":"ContextConsumer"},{"type":"text","value":". This is the BARE "},{"type":"inlineCode","value":"LitTable"},{"type":"text","value":" written\nto the provider, not the extended "},{"type":"inlineCode","value":"AppLitTable"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"type-parameters-6","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tdata-3","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":4,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"host-4","children":[{"type":"text","value":"host"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactiveControllerHost"},{"type":"text","value":" & "},{"type":"inlineCode","value":"HTMLElement"}]},{"type":"heading","depth":4,"id":"returns-6","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ContextConsumer"},{"type":"text","value":"<"},{"type":"inlineCode","value":"Context"},{"type":"text","value":"<"},{"type":"inlineCode","value":"symbol"},{"type":"text","value":", "},{"type":"link","href":"../type-aliases/LitTable.md","children":[{"type":"inlineCode","value":"LitTable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">>, "},{"type":"inlineCode","value":"ReactiveControllerHost"},{"type":"text","value":" & "},{"type":"inlineCode","value":"HTMLElement"},{"type":"text","value":">"}]}],"headings":[{"id":"interface-createtablehookresulttfeatures-ttablecomponents-tcellcomponents-theadercomponents","text":"Interface: CreateTableHookResult<TFeatures, TTableComponents, TCellComponents, THeaderComponents>","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"ttablecomponents","text":"TTableComponents","level":3},{"id":"tcellcomponents","text":"TCellComponents","level":3},{"id":"theadercomponents","text":"THeaderComponents","level":3},{"id":"properties","text":"Properties","level":2},{"id":"appfeatures","text":"appFeatures","level":3},{"id":"createappcolumnhelper","text":"createAppColumnHelper()","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":4},{"id":"tdata","text":"TData","level":5},{"id":"returns","text":"Returns","level":4},{"id":"useapptable","text":"useAppTable()","level":3},{"id":"type-parameters-3","text":"Type Parameters","level":4},{"id":"tdata-2","text":"TData","level":5},{"id":"tselected","text":"TSelected","level":5},{"id":"parameters","text":"Parameters","level":4},{"id":"host","text":"host","level":5},{"id":"tableoptions","text":"tableOptions","level":5},{"id":"selector","text":"selector?","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"table","text":"table()","level":5},{"id":"returns-3","text":"Returns","level":6},{"id":"usecellcontext","text":"useCellContext()","level":3},{"id":"type-parameters-4","text":"Type Parameters","level":4},{"id":"tvalue","text":"TValue","level":5},{"id":"parameters-2","text":"Parameters","level":4},{"id":"host-2","text":"host","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"useheadercontext","text":"useHeaderContext()","level":3},{"id":"type-parameters-5","text":"Type Parameters","level":4},{"id":"tvalue-2","text":"TValue","level":5},{"id":"parameters-3","text":"Parameters","level":4},{"id":"host-3","text":"host","level":5},{"id":"returns-5","text":"Returns","level":4},{"id":"usetablecontext","text":"useTableContext()","level":3},{"id":"type-parameters-6","text":"Type Parameters","level":4},{"id":"tdata-3","text":"TData","level":5},{"id":"parameters-4","text":"Parameters","level":4},{"id":"host-4","text":"host","level":5},{"id":"returns-6","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\n# Interface: CreateTableHookResult\\<TFeatures, TTableComponents, TCellComponents, THeaderComponents\\>\n\nDefined in: [packages/lit-table/src/createTableHook.ts:358](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L358)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, [`ComponentType`](../type-aliases/ComponentType.md)\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, [`ComponentType`](../type-aliases/ComponentType.md)\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, [`ComponentType`](../type-aliases/ComponentType.md)\\<`any`\\>\\>\n\n## Properties\n\n### appFeatures\n\n```ts\nappFeatures: TFeatures;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:365](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L365)\n\nThe features object that was passed to `createTableHook`.\n\n***\n\n### createAppColumnHelper()\n\n```ts\ncreateAppColumnHelper: <TData>() => AppColumnHelper<TFeatures, TData, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:370](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L370)\n\nA column helper pre-bound to `TFeatures` and the registered components, so\nthe cell/header/footer render props expose the bound components.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n#### Returns\n\n[`AppColumnHelper`](../type-aliases/AppColumnHelper.md)\\<`TFeatures`, `TData`, `TCellComponents`, `THeaderComponents`\\>\n\n***\n\n### useAppTable()\n\n```ts\nuseAppTable: <TData, TSelected>(host, tableOptions, selector?) => object;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:381](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L381)\n\nCreates a controller-like object whose `table()` method returns a table with\nthe `App*` wrapper functions, a bound `FlexRender`, and the registered\n`tableComponents` attached. `TData` is inferred from the `data` option.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n##### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n\n#### Parameters\n\n##### host\n\n`ReactiveControllerHost` & `HTMLElement`\n\n##### tableOptions\n\n`Omit`\\<`TableOptions`\\<`TFeatures`, `TData`\\>, `\"features\"`\\>\n\n##### selector?\n\n(`state`) => `TSelected`\n\n#### Returns\n\n`object`\n\n##### table()\n\n```ts\ntable: () => AppLitTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents>;\n```\n\n###### Returns\n\n[`AppLitTable`](../type-aliases/AppLitTable.md)\\<`TFeatures`, `TData`, `TSelected`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n\n***\n\n### useCellContext()\n\n```ts\nuseCellContext: <TValue>(host) => ContextConsumer<Context<symbol, Cell<TFeatures, any, TValue>>, ReactiveControllerHost & HTMLElement>;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:410](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L410)\n\nReads the cell instance from a `@lit/context` `ContextConsumer`. lit never\nprovides an extended cell through context, so this is a BARE `Cell`.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n#### Parameters\n\n##### host\n\n`ReactiveControllerHost` & `HTMLElement`\n\n#### Returns\n\n`ContextConsumer`\\<`Context`\\<`symbol`, `Cell`\\<`TFeatures`, `any`, `TValue`\\>\\>, `ReactiveControllerHost` & `HTMLElement`\\>\n\n***\n\n### useHeaderContext()\n\n```ts\nuseHeaderContext: <TValue>(host) => ContextConsumer<Context<symbol, Header<TFeatures, any, TValue>>, ReactiveControllerHost & HTMLElement>;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:420](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L420)\n\nReads the header instance from a `@lit/context` `ContextConsumer`. lit never\nprovides an extended header through context, so this is a BARE `Header`.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n#### Parameters\n\n##### host\n\n`ReactiveControllerHost` & `HTMLElement`\n\n#### Returns\n\n`ContextConsumer`\\<`Context`\\<`symbol`, `Header`\\<`TFeatures`, `any`, `TValue`\\>\\>, `ReactiveControllerHost` & `HTMLElement`\\>\n\n***\n\n### useTableContext()\n\n```ts\nuseTableContext: <TData>(host) => ContextConsumer<Context<symbol, LitTable<TFeatures, TData, any>>, ReactiveControllerHost & HTMLElement>;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:400](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L400)\n\nReads the table provided by the nearest ancestor that called `useAppTable`,\nvia a `@lit/context` `ContextConsumer`. This is the BARE `LitTable` written\nto the provider, not the extended `AppLitTable`.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData` = `RowData`\n\n#### Parameters\n\n##### host\n\n`ReactiveControllerHost` & `HTMLElement`\n\n#### Returns\n\n`ContextConsumer`\\<`Context`\\<`symbol`, [`LitTable`](../type-aliases/LitTable.md)\\<`TFeatures`, `TData`, `any`\\>\\>, `ReactiveControllerHost` & `HTMLElement`\\>\n","originalRawMarkdown":"---\nid: CreateTableHookResult\ntitle: CreateTableHookResult\n---\n\n# Interface: CreateTableHookResult\\<TFeatures, TTableComponents, TCellComponents, THeaderComponents\\>\n\nDefined in: [packages/lit-table/src/createTableHook.ts:358](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L358)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, [`ComponentType`](../type-aliases/ComponentType.md)\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, [`ComponentType`](../type-aliases/ComponentType.md)\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, [`ComponentType`](../type-aliases/ComponentType.md)\\<`any`\\>\\>\n\n## Properties\n\n### appFeatures\n\n```ts\nappFeatures: TFeatures;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:365](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L365)\n\nThe features object that was passed to `createTableHook`.\n\n***\n\n### createAppColumnHelper()\n\n```ts\ncreateAppColumnHelper: <TData>() => AppColumnHelper<TFeatures, TData, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:370](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L370)\n\nA column helper pre-bound to `TFeatures` and the registered components, so\nthe cell/header/footer render props expose the bound components.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n#### Returns\n\n[`AppColumnHelper`](../type-aliases/AppColumnHelper.md)\\<`TFeatures`, `TData`, `TCellComponents`, `THeaderComponents`\\>\n\n***\n\n### useAppTable()\n\n```ts\nuseAppTable: <TData, TSelected>(host, tableOptions, selector?) => object;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:381](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L381)\n\nCreates a controller-like object whose `table()` method returns a table with\nthe `App*` wrapper functions, a bound `FlexRender`, and the registered\n`tableComponents` attached. `TData` is inferred from the `data` option.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n##### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n\n#### Parameters\n\n##### host\n\n`ReactiveControllerHost` & `HTMLElement`\n\n##### tableOptions\n\n`Omit`\\<`TableOptions`\\<`TFeatures`, `TData`\\>, `\"features\"`\\>\n\n##### selector?\n\n(`state`) => `TSelected`\n\n#### Returns\n\n`object`\n\n##### table()\n\n```ts\ntable: () => AppLitTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents>;\n```\n\n###### Returns\n\n[`AppLitTable`](../type-aliases/AppLitTable.md)\\<`TFeatures`, `TData`, `TSelected`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n\n***\n\n### useCellContext()\n\n```ts\nuseCellContext: <TValue>(host) => ContextConsumer<Context<symbol, Cell<TFeatures, any, TValue>>, ReactiveControllerHost & HTMLElement>;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:410](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L410)\n\nReads the cell instance from a `@lit/context` `ContextConsumer`. lit never\nprovides an extended cell through context, so this is a BARE `Cell`.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n#### Parameters\n\n##### host\n\n`ReactiveControllerHost` & `HTMLElement`\n\n#### Returns\n\n`ContextConsumer`\\<`Context`\\<`symbol`, `Cell`\\<`TFeatures`, `any`, `TValue`\\>\\>, `ReactiveControllerHost` & `HTMLElement`\\>\n\n***\n\n### useHeaderContext()\n\n```ts\nuseHeaderContext: <TValue>(host) => ContextConsumer<Context<symbol, Header<TFeatures, any, TValue>>, ReactiveControllerHost & HTMLElement>;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:420](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L420)\n\nReads the header instance from a `@lit/context` `ContextConsumer`. lit never\nprovides an extended header through context, so this is a BARE `Header`.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n#### Parameters\n\n##### host\n\n`ReactiveControllerHost` & `HTMLElement`\n\n#### Returns\n\n`ContextConsumer`\\<`Context`\\<`symbol`, `Header`\\<`TFeatures`, `any`, `TValue`\\>\\>, `ReactiveControllerHost` & `HTMLElement`\\>\n\n***\n\n### useTableContext()\n\n```ts\nuseTableContext: <TData>(host) => ContextConsumer<Context<symbol, LitTable<TFeatures, TData, any>>, ReactiveControllerHost & HTMLElement>;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:400](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L400)\n\nReads the table provided by the nearest ancestor that called `useAppTable`,\nvia a `@lit/context` `ContextConsumer`. This is the BARE `LitTable` written\nto the provider, not the extended `AppLitTable`.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData` = `RowData`\n\n#### Parameters\n\n##### host\n\n`ReactiveControllerHost` & `HTMLElement`\n\n#### Returns\n\n`ContextConsumer`\\<`Context`\\<`symbol`, [`LitTable`](../type-aliases/LitTable.md)\\<`TFeatures`, `TData`, `any`\\>\\>, `ReactiveControllerHost` & `HTMLElement`\\>\n"}
