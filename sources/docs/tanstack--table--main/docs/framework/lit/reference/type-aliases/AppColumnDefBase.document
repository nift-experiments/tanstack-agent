tType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]}],"headings":[{"id":"type-alias-appcolumndefbasetfeatures-tdata-tvalue-tcellcomponents-theadercomponents","text":"Type Alias: AppColumnDefBase<TFeatures, TData, TValue, TCellComponents, THeaderComponents>","level":1},{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"cell","text":"cell?","level":3},{"id":"footer","text":"footer?","level":3},{"id":"header","text":"header?","level":3},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"tcellcomponents","text":"TCellComponents","level":3},{"id":"theadercomponents","text":"THeaderComponents","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Type Alias: AppColumnDefBase\\<TFeatures, TData, TValue, TCellComponents, THeaderComponents\\>\n\n```ts\ntype AppColumnDefBase<TFeatures, TData, TValue, TCellComponents, THeaderComponents> = Omit<IdentifiedColumnDef<TFeatures, TData, TValue>, \"cell\" | \"header\" | \"footer\"> & object;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:97](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L97)\n\nEnhanced column definition base with pre-bound components in cell/header/footer contexts.\n\n## Type Declaration\n\n### cell?\n\n```ts\noptional cell: AppColumnDefTemplate<AppCellContext<TFeatures, TData, TValue, TCellComponents>>;\n```\n\n### footer?\n\n```ts\noptional footer: AppColumnDefTemplate<AppHeaderContext<TFeatures, TData, TValue, THeaderComponents>>;\n```\n\n### header?\n\n```ts\noptional header: AppColumnDefTemplate<AppHeaderContext<TFeatures, TData, TValue, THeaderComponents>>;\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TValue\n\n`TValue` *extends* `CellData`\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n","originalRawMarkdown":"---\nid: AppColumnDefBase\ntitle: AppColumnDefBase\n---\n\n# Type Alias: AppColumnDefBase\\<TFeatures, TData, TValue, TCellComponents, THeaderComponents\\>\n\n```ts\ntype AppColumnDefBase<TFeatures, TData, TValue, TCellComponents, THeaderComponents> = Omit<IdentifiedColumnDef<TFeatures, TData, TValue>, \"cell\" | \"header\" | \"footer\"> & object;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:97](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L97)\n\nEnhanced column definition base with pre-bound components in cell/header/footer contexts.\n\n## Type Declaration\n\n### cell?\n\n```ts\noptional cell: AppColumnDefTemplate<AppCellContext<TFeatures, TData, TValue, TCellComponents>>;\n```\n\n### footer?\n\n```ts\noptional footer: AppColumnDefTemplate<AppHeaderContext<TFeatures, TData, TValue, THeaderComponents>>;\n```\n\n### header?\n\n```ts\noptional header: AppColumnDefTemplate<AppHeaderContext<TFeatures, TData, TValue, THeaderComponents>>;\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TValue\n\n`TValue` *extends* `CellData`\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n"}
