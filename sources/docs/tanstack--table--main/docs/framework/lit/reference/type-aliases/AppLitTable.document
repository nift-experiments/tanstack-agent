e":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"theadercomponents","children":[{"type":"text","value":"THeaderComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"THeaderComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"link","href":"ComponentType.md","children":[{"type":"inlineCode","value":"ComponentType"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]}],"headings":[{"id":"type-alias-applittabletfeatures-tdata-tselected-ttablecomponents-tcellcomponents-theadercomponents","text":"Type Alias: AppLitTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents>","level":1},{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"appcell","text":"AppCell()","level":3},{"id":"type-parameters","text":"Type Parameters","level":4},{"id":"tvalue","text":"TValue","level":5},{"id":"parameters","text":"Parameters","level":4},{"id":"cell","text":"cell","level":5},{"id":"renderfn","text":"renderFn","level":5},{"id":"returns","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"appfooter","text":"AppFooter()","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":4},{"id":"tvalue-2","text":"TValue","level":5},{"id":"parameters-2","text":"Parameters","level":4},{"id":"header","text":"header","level":5},{"id":"renderfn-2","text":"renderFn","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"example-2","text":"Example","level":4},{"id":"appheader","text":"AppHeader()","level":3},{"id":"type-parameters-3","text":"Type Parameters","level":4},{"id":"tvalue-3","text":"TValue","level":5},{"id":"parameters-3","text":"Parameters","level":4},{"id":"header-2","text":"header","level":5},{"id":"renderfn-3","text":"renderFn","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"example-3","text":"Example","level":4},{"id":"flexrender","text":"FlexRender","level":3},{"id":"example-4","text":"Example","level":4},{"id":"type-parameters-4","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"ttablecomponents","text":"TTableComponents","level":3},{"id":"tcellcomponents","text":"TCellComponents","level":3},{"id":"theadercomponents","text":"THeaderComponents","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Type Alias: AppLitTable\\<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents\\>\n\n```ts\ntype AppLitTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents> = LitTable<TFeatures, TData, TSelected> & NoInfer<TTableComponents> & object;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:288](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L288)\n\nExtended table API returned by useAppTable with all App wrapper functions\n\n## Type Declaration\n\n### AppCell()\n\n```ts\nAppCell: <TValue>(cell, renderFn) => LitRenderable;\n```\n\nWraps a cell and provides cell context with pre-bound cellComponents.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `CellData` = `CellData`\n\n#### Parameters\n\n##### cell\n\n`Cell`\\<`TFeatures`, `TData`, `TValue`\\>\n\n##### renderFn\n\n(`cell`) => [`LitRenderable`](LitRenderable.md)\n\n#### Returns\n\n[`LitRenderable`](LitRenderable.md)\n\n#### Example\n\n```ts\n${table.AppCell(cell, (c) => html`<td>${c.FlexRender()}</td>`)}\n```\n\n### AppFooter()\n\n```ts\nAppFooter: <TValue>(header, renderFn) => LitRenderable;\n```\n\nWraps a footer and provides header context with pre-bound headerComponents.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `CellData` = `CellData`\n\n#### Parameters\n\n##### header\n\n`Header`\\<`TFeatures`, `TData`, `TValue`\\>\n\n##### renderFn\n\n(`header`) => [`LitRenderable`](LitRenderable.md)\n\n#### Returns\n\n[`LitRenderable`](LitRenderable.md)\n\n#### Example\n\n```ts\n${table.AppFooter(footer, (f) => html`<td>${f.FlexRender()}</td>`)}\n```\n\n### AppHeader()\n\n```ts\nAppHeader: <TValue>(header, renderFn) => LitRenderable;\n```\n\nWraps a header and provides header context with pre-bound headerComponents.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `CellData` = `CellData`\n\n#### Parameters\n\n##### header\n\n`Header`\\<`TFeatures`, `TData`, `TValue`\\>\n\n##### renderFn\n\n(`header`) => [`LitRenderable`](LitRenderable.md)\n\n#### Returns\n\n[`LitRenderable`](LitRenderable.md)\n\n#### Example\n\n```ts\n${table.AppHeader(header, (h) => html`<th>${h.FlexRender()}</th>`)}\n```\n\n### FlexRender\n\n```ts\nFlexRender: typeof FlexRender;\n```\n\nConvenience FlexRender function attached to the table instance.\nRenders cell, header, or footer content from column definitions.\n\n#### Example\n\n```ts\n${table.FlexRender({ header })}\n${table.FlexRender({ cell })}\n${table.FlexRender({ footer: header })}\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n","originalRawMarkdown":"---\nid: AppLitTable\ntitle: AppLitTable\n---\n\n# Type Alias: AppLitTable\\<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents\\>\n\n```ts\ntype AppLitTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents> = LitTable<TFeatures, TData, TSelected> & NoInfer<TTableComponents> & object;\n```\n\nDefined in: [packages/lit-table/src/createTableHook.ts:288](https://github.com/TanStack/table/blob/main/packages/lit-table/src/createTableHook.ts#L288)\n\nExtended table API returned by useAppTable with all App wrapper functions\n\n## Type Declaration\n\n### AppCell()\n\n```ts\nAppCell: <TValue>(cell, renderFn) => LitRenderable;\n```\n\nWraps a cell and provides cell context with pre-bound cellComponents.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `CellData` = `CellData`\n\n#### Parameters\n\n##### cell\n\n`Cell`\\<`TFeatures`, `TData`, `TValue`\\>\n\n##### renderFn\n\n(`cell`) => [`LitRenderable`](LitRenderable.md)\n\n#### Returns\n\n[`LitRenderable`](LitRenderable.md)\n\n#### Example\n\n```ts\n${table.AppCell(cell, (c) => html`<td>${c.FlexRender()}</td>`)}\n```\n\n### AppFooter()\n\n```ts\nAppFooter: <TValue>(header, renderFn) => LitRenderable;\n```\n\nWraps a footer and provides header context with pre-bound headerComponents.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `CellData` = `CellData`\n\n#### Parameters\n\n##### header\n\n`Header`\\<`TFeatures`, `TData`, `TValue`\\>\n\n##### renderFn\n\n(`header`) => [`LitRenderable`](LitRenderable.md)\n\n#### Returns\n\n[`LitRenderable`](LitRenderable.md)\n\n#### Example\n\n```ts\n${table.AppFooter(footer, (f) => html`<td>${f.FlexRender()}</td>`)}\n```\n\n### AppHeader()\n\n```ts\nAppHeader: <TValue>(header, renderFn) => LitRenderable;\n```\n\nWraps a header and provides header context with pre-bound headerComponents.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `CellData` = `CellData`\n\n#### Parameters\n\n##### header\n\n`Header`\\<`TFeatures`, `TData`, `TValue`\\>\n\n##### renderFn\n\n(`header`) => [`LitRenderable`](LitRenderable.md)\n\n#### Returns\n\n[`LitRenderable`](LitRenderable.md)\n\n#### Example\n\n```ts\n${table.AppHeader(header, (h) => html`<th>${h.FlexRender()}</th>`)}\n```\n\n### FlexRender\n\n```ts\nFlexRender: typeof FlexRender;\n```\n\nConvenience FlexRender function attached to the table instance.\nRenders cell, header, or footer content from column definitions.\n\n#### Example\n\n```ts\n${table.FlexRender({ header })}\n${table.FlexRender({ cell })}\n${table.FlexRender({ footer: header })}\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, [`ComponentType`](ComponentType.md)\\<`any`\\>\\>\n"}
