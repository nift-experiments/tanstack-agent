the selector function that\nyou pass as the 2nd argument to "},{"type":"inlineCode","value":"controller.table()"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const table = this.tableController.table(options, (state) => ({\n  globalFilter: state.globalFilter,\n}))\n\nconsole.log(table.state.globalFilter)","lang":"ts"},{"type":"heading","depth":3,"id":"store","children":[{"type":"strike","children":[{"type":"text","value":"store"}]}]},{"type":"code","value":"readonly store: Table<TFeatures, TData>[\"store\"];","lang":"ts"},{"type":"heading","depth":4,"id":"deprecated","children":[{"type":"text","value":"Deprecated"}]},{"type":"paragraph","children":[{"type":"text","value":"Prefer "},{"type":"inlineCode","value":"table.state"},{"type":"text","value":" for render reads,\n"},{"type":"inlineCode","value":"table.atoms.<slice>.get()"},{"type":"text","value":" for slice snapshots, or "},{"type":"inlineCode","value":"table.subscribe"},{"type":"text","value":" for\nexplicit subscriptions. "},{"type":"inlineCode","value":"table.store.state"},{"type":"text","value":" is a current-value snapshot and\nis easy to misuse in render code."}]},{"type":"heading","depth":3,"id":"subscribe","children":[{"type":"text","value":"subscribe"}]},{"type":"code","value":"subscribe: typeof subscribe;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Subscribes to the table's underlying state store within a Lit template.\nRe-renders only the targeted template slice when the observed state changes."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// 1. Subscribe to a specific state slice (re-renders ONLY when rowSelection changes)\nhtml`\n<div>\n${table.subscribe(\ntable.store,\n(state) => state.rowSelection,\n(rowSelection) => html`<span>Selected: ${JSON.stringify(rowSelection)}</span>`\n)}\n</div>\n`\n\n// 2. Subscribe to the full state (re-renders on any state mutation)\nhtml`\n<div>\n${table.subscribe(\ntable.store,\n(state) => html`<span>Total rows: ${state.rowModel.rows.length}</span>`\n)}\n</div>\n`","lang":"ts"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfeatures","children":[{"type":"text","value":"TFeatures"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"TableFeatures"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TableState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":">"}]}],"headings":[{"id":"type-alias-littabletfeatures-tdata-tselected","text":"Type Alias: LitTable<TFeatures, TData, TSelected>","level":1},{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"flexrender","text":"FlexRender","level":3},{"id":"example","text":"Example","level":4},{"id":"state","text":"state","level":3},{"id":"example-2","text":"Example","level":4},{"id":"store","text":"store","level":3},{"id":"deprecated","text":"Deprecated","level":4},{"id":"subscribe","text":"subscribe","level":3},{"id":"example-3","text":"Example","level":4},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tselected","text":"TSelected","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Type Alias: LitTable\\<TFeatures, TData, TSelected\\>\n\n```ts\ntype LitTable<TFeatures, TData, TSelected> = Omit<Table<TFeatures, TData>, \"store\"> & object;\n```\n\nDefined in: [packages/lit-table/src/TableController.ts:26](https://github.com/TanStack/table/blob/main/packages/lit-table/src/TableController.ts#L26)\n\nThe extended table type returned by the Lit adapter.\nIncludes a `Subscribe` method for fine-grained state subscriptions\nand a `state` property with the selected state.\n\n## Type Declaration\n\n### FlexRender\n\n```ts\nFlexRender: typeof FlexRender;\n```\n\nConvenience FlexRender function attached to the table instance.\nRenders cell, header, or footer content from column definitions.\n\n#### Example\n\n```ts\n${table.FlexRender({ header })}\n${table.FlexRender({ cell })}\n${table.FlexRender({ footer: header })}\n```\n\n### state\n\n```ts\nreadonly state: Readonly<TSelected>;\n```\n\nThe selected state of the table. This state may not match the structure of\nthe full table state because it is selected by the selector function that\nyou pass as the 2nd argument to `controller.table()`.\n\n#### Example\n\n```ts\nconst table = this.tableController.table(options, (state) => ({\n  globalFilter: state.globalFilter,\n}))\n\nconsole.log(table.state.globalFilter)\n```\n\n### ~~store~~\n\n```ts\nreadonly store: Table<TFeatures, TData>[\"store\"];\n```\n\n#### Deprecated\n\nPrefer `table.state` for render reads,\n`table.atoms.<slice>.get()` for slice snapshots, or `table.subscribe` for\nexplicit subscriptions. `table.store.state` is a current-value snapshot and\nis easy to misuse in render code.\n\n### subscribe\n\n```ts\nsubscribe: typeof subscribe;\n```\n\nSubscribes to the table's underlying state store within a Lit template.\nRe-renders only the targeted template slice when the observed state changes.\n\n#### Example\n\n```ts\n// 1. Subscribe to a specific state slice (re-renders ONLY when rowSelection changes)\nhtml`\n<div>\n${table.subscribe(\ntable.store,\n(state) => state.rowSelection,\n(rowSelection) => html`<span>Selected: ${JSON.stringify(rowSelection)}</span>`\n)}\n</div>\n`\n\n// 2. Subscribe to the full state (re-renders on any state mutation)\nhtml`\n<div>\n${table.subscribe(\ntable.store,\n(state) => html`<span>Total rows: ${state.rowModel.rows.length}</span>`\n)}\n</div>\n`\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n","originalRawMarkdown":"---\nid: LitTable\ntitle: LitTable\n---\n\n# Type Alias: LitTable\\<TFeatures, TData, TSelected\\>\n\n```ts\ntype LitTable<TFeatures, TData, TSelected> = Omit<Table<TFeatures, TData>, \"store\"> & object;\n```\n\nDefined in: [packages/lit-table/src/TableController.ts:26](https://github.com/TanStack/table/blob/main/packages/lit-table/src/TableController.ts#L26)\n\nThe extended table type returned by the Lit adapter.\nIncludes a `Subscribe` method for fine-grained state subscriptions\nand a `state` property with the selected state.\n\n## Type Declaration\n\n### FlexRender\n\n```ts\nFlexRender: typeof FlexRender;\n```\n\nConvenience FlexRender function attached to the table instance.\nRenders cell, header, or footer content from column definitions.\n\n#### Example\n\n```ts\n${table.FlexRender({ header })}\n${table.FlexRender({ cell })}\n${table.FlexRender({ footer: header })}\n```\n\n### state\n\n```ts\nreadonly state: Readonly<TSelected>;\n```\n\nThe selected state of the table. This state may not match the structure of\nthe full table state because it is selected by the selector function that\nyou pass as the 2nd argument to `controller.table()`.\n\n#### Example\n\n```ts\nconst table = this.tableController.table(options, (state) => ({\n  globalFilter: state.globalFilter,\n}))\n\nconsole.log(table.state.globalFilter)\n```\n\n### ~~store~~\n\n```ts\nreadonly store: Table<TFeatures, TData>[\"store\"];\n```\n\n#### Deprecated\n\nPrefer `table.state` for render reads,\n`table.atoms.<slice>.get()` for slice snapshots, or `table.subscribe` for\nexplicit subscriptions. `table.store.state` is a current-value snapshot and\nis easy to misuse in render code.\n\n### subscribe\n\n```ts\nsubscribe: typeof subscribe;\n```\n\nSubscribes to the table's underlying state store within a Lit template.\nRe-renders only the targeted template slice when the observed state changes.\n\n#### Example\n\n```ts\n// 1. Subscribe to a specific state slice (re-renders ONLY when rowSelection changes)\nhtml`\n<div>\n${table.subscribe(\ntable.store,\n(state) => state.rowSelection,\n(rowSelection) => html`<span>Selected: ${JSON.stringify(rowSelection)}</span>`\n)}\n</div>\n`\n\n// 2. Subscribe to the full state (re-renders on any state mutation)\nhtml`\n<div>\n${table.subscribe(\ntable.store,\n(state) => html`<span>Total rows: ${state.rowModel.rows.length}</span>`\n)}\n</div>\n`\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n"}
