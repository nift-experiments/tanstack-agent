alue":"template"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TemplateFunction"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSource"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"DirectiveResult"},{"type":"text","value":"<"},{"type":"emphasis","children":[{"type":"text","value":"typeof"}]},{"type":"text","value":" "},{"type":"link","href":"../classes/SubscribeDirective.md","children":[{"type":"inlineCode","value":"SubscribeDirective"}]},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"call-signature-2","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"<TSource, TSelected>(\n   source,\n   selector,\ntemplate): DirectiveResult<typeof SubscribeDirective>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Subscribes to a specific slice of the source state via a selector,\npreventing unnecessary re-renders when other parts of the state change."}]},{"type":"heading","depth":3,"id":"type-parameters-2","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":4,"id":"tsource-2","children":[{"type":"text","value":"TSource"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSource"}]},{"type":"heading","depth":4,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"source-2","children":[{"type":"text","value":"source"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/SelectionSource.md","children":[{"type":"inlineCode","value":"SelectionSource"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSource"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"selector","children":[{"type":"text","value":"selector"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Selector"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSource"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"template-2","children":[{"type":"text","value":"template"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TemplateFunction"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"DirectiveResult"},{"type":"text","value":"<"},{"type":"emphasis","children":[{"type":"text","value":"typeof"}]},{"type":"text","value":" "},{"type":"link","href":"../classes/SubscribeDirective.md","children":[{"type":"inlineCode","value":"SubscribeDirective"}]},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// Without a selector (subscribes to entire state)\nhtml`<div>${subscribe(myStore, (state) => html`<span>${state.count}</span>`)}</div>`\n* // With a selector (only updates when `count` changes)\nhtml`<div>${subscribe(myStore, state => state.count, (count) => html`<span>${count}</span>`)}</div>`","lang":"ts"}],"headings":[{"id":"variable-subscribe","text":"Variable: subscribe()","level":1},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tsource","text":"TSource","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"source","text":"source","level":4},{"id":"template","text":"template","level":4},{"id":"returns","text":"Returns","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tsource-2","text":"TSource","level":4},{"id":"tselected","text":"TSelected","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"source-2","text":"source","level":4},{"id":"selector","text":"selector","level":4},{"id":"template-2","text":"template","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Variable: subscribe()\n\n```ts\nconst subscribe: {\n<TSource>  (source, template): DirectiveResult<typeof SubscribeDirective>;\n<TSource, TSelected>  (source, selector, template): DirectiveResult<typeof SubscribeDirective>;\n};\n```\n\nDefined in: [packages/lit-table/src/subscribe-directive.ts:191](https://github.com/TanStack/table/blob/main/packages/lit-table/src/subscribe-directive.ts#L191)\n\nA Lit directive that subscribes to a source (Store or Atom)\nand efficiently updates only the wrapped template\nwhen the state or selected slice changes.\n\n## Call Signature\n\n```ts\n<TSource>(source, template): DirectiveResult<typeof SubscribeDirective>;\n```\n\nSubscribes to the entire source state without filtering.\n\n### Type Parameters\n\n#### TSource\n\n`TSource`\n\n### Parameters\n\n#### source\n\n[`SelectionSource`](../type-aliases/SelectionSource.md)\\<`TSource`\\>\n\n#### template\n\n`TemplateFunction`\\<`TSource`\\>\n\n### Returns\n\n`DirectiveResult`\\<*typeof* [`SubscribeDirective`](../classes/SubscribeDirective.md)\\>\n\n## Call Signature\n\n```ts\n<TSource, TSelected>(\n   source,\n   selector,\ntemplate): DirectiveResult<typeof SubscribeDirective>;\n```\n\nSubscribes to a specific slice of the source state via a selector,\npreventing unnecessary re-renders when other parts of the state change.\n\n### Type Parameters\n\n#### TSource\n\n`TSource`\n\n#### TSelected\n\n`TSelected`\n\n### Parameters\n\n#### source\n\n[`SelectionSource`](../type-aliases/SelectionSource.md)\\<`TSource`\\>\n\n#### selector\n\n`Selector`\\<`TSource`, `TSelected`\\>\n\n#### template\n\n`TemplateFunction`\\<`TSelected`\\>\n\n### Returns\n\n`DirectiveResult`\\<*typeof* [`SubscribeDirective`](../classes/SubscribeDirective.md)\\>\n\n## Example\n\n```ts\n// Without a selector (subscribes to entire state)\nhtml`<div>${subscribe(myStore, (state) => html`<span>${state.count}</span>`)}</div>`\n* // With a selector (only updates when `count` changes)\nhtml`<div>${subscribe(myStore, state => state.count, (count) => html`<span>${count}</span>`)}</div>`\n```\n","originalRawMarkdown":"---\nid: subscribe\ntitle: subscribe\n---\n\n# Variable: subscribe()\n\n```ts\nconst subscribe: {\n<TSource>  (source, template): DirectiveResult<typeof SubscribeDirective>;\n<TSource, TSelected>  (source, selector, template): DirectiveResult<typeof SubscribeDirective>;\n};\n```\n\nDefined in: [packages/lit-table/src/subscribe-directive.ts:191](https://github.com/TanStack/table/blob/main/packages/lit-table/src/subscribe-directive.ts#L191)\n\nA Lit directive that subscribes to a source (Store or Atom)\nand efficiently updates only the wrapped template\nwhen the state or selected slice changes.\n\n## Call Signature\n\n```ts\n<TSource>(source, template): DirectiveResult<typeof SubscribeDirective>;\n```\n\nSubscribes to the entire source state without filtering.\n\n### Type Parameters\n\n#### TSource\n\n`TSource`\n\n### Parameters\n\n#### source\n\n[`SelectionSource`](../type-aliases/SelectionSource.md)\\<`TSource`\\>\n\n#### template\n\n`TemplateFunction`\\<`TSource`\\>\n\n### Returns\n\n`DirectiveResult`\\<*typeof* [`SubscribeDirective`](../classes/SubscribeDirective.md)\\>\n\n## Call Signature\n\n```ts\n<TSource, TSelected>(\n   source,\n   selector,\ntemplate): DirectiveResult<typeof SubscribeDirective>;\n```\n\nSubscribes to a specific slice of the source state via a selector,\npreventing unnecessary re-renders when other parts of the state change.\n\n### Type Parameters\n\n#### TSource\n\n`TSource`\n\n#### TSelected\n\n`TSelected`\n\n### Parameters\n\n#### source\n\n[`SelectionSource`](../type-aliases/SelectionSource.md)\\<`TSource`\\>\n\n#### selector\n\n`Selector`\\<`TSource`, `TSelected`\\>\n\n#### template\n\n`TemplateFunction`\\<`TSelected`\\>\n\n### Returns\n\n`DirectiveResult`\\<*typeof* [`SubscribeDirective`](../classes/SubscribeDirective.md)\\>\n\n## Example\n\n```ts\n// Without a selector (subscribes to entire state)\nhtml`<div>${subscribe(myStore, (state) => html`<span>${state.count}</span>`)}</div>`\n* // With a selector (only updates when `count` changes)\nhtml`<div>${subscribe(myStore, state => state.count, (count) => html`<span>${count}</span>`)}</div>`\n```\n"}
