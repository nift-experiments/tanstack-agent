{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"function-createtablehook","children":[{"type":"text","value":"Function: createTableHook()"}]},{"type":"code","value":"function createTableHook<TFeatures, TTableComponents, TCellComponents, THeaderComponents>(__namedParameters): CreateTableHookResult<TFeatures, TTableComponents, TCellComponents, THeaderComponents>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L691","children":[{"type":"text","value":"createTableHook.tsx:691"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a custom table hook with pre-bound components for composition."}]},{"type":"paragraph","children":[{"type":"text","value":"This is the table equivalent of TanStack Form's "},{"type":"inlineCode","value":"createFormHook"},{"type":"text","value":". It allows you to:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Define features, row models, and default options once, shared across all tables"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Register reusable table, cell, and header components"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Access table/cell/header instances via context in those components"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Get a "},{"type":"inlineCode","value":"useAppTable"},{"type":"text","value":" hook that returns an extended table with App wrapper components"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Get a "},{"type":"inlineCode","value":"createAppColumnHelper"},{"type":"text","value":" function pre-bound to your features"}]}]}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfeatures","children":[{"type":"text","value":"TFeatures"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"TableFeatures"}]},{"type":"heading","depth":3,"id":"ttablecomponents","children":[{"type":"text","value":"TTableComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTableComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"ComponentType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"tcellcomponents","children":[{"type":"text","value":"TCellComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCellComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"ComponentType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"theadercomponents","children":[{"type":"text","value":"THeaderComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"THeaderComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"ComponentType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"namedparameters","children":[{"type":"text","value":"__namedParameters"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/CreateTableHookOptions.md","children":[{"type":"inlineCode","value":"CreateTableHookOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TTableComponents"},{"type":"text","value":", "},{"type":"inlineCode","value":"TCellComponents"},{"type":"text","value":", "},{"type":"inlineCode","value":"THeaderComponents"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/CreateTableHookResult.md","children":[{"type":"inlineCode","value":"CreateTableHookResult"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TTableComponents"},{"type":"text","value":", "},{"type":"inlineCode","value":"TCellComponents"},{"type":"text","value":", "},{"type":"inlineCode","value":"THeaderComponents"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"// hooks/table.ts\nexport const {\n  useAppTable,\n  createAppColumnHelper,\n  useTableContext,\n  useCellContext,\n  useHeaderContext,\n} = createTableHook({\n  features: tableFeatures({\n    rowPaginationFeature,\n    rowSortingFeature,\n    columnFilteringFeature,\n    paginatedRowModel: createPaginatedRowModel(),\n    sortedRowModel: createSortedRowModel(),\n    filteredRowModel: createFilteredRowModel(),\n    sortFns,\n    filterFns,\n  }),\n  tableComponents: { PaginationControls, RowCount },\n  cellComponents: { TextCell, NumberCell },\n  headerComponents: { SortIndicator, ColumnFilter },\n})\n\n// Create column helper with TFeatures already bound\nconst columnHelper = createAppColumnHelper<Person>()\n\n// components/table-components.tsx\nfunction PaginationControls() {\n  const table = useTableContext() // TFeatures already known!\n  return <table.Subscribe selector={(s) => s.pagination}>...</table.Subscribe>\n}\n\n// features/users.tsx\nfunction UsersTable({ data }: { data: Person[] }) {\n  const table = useAppTable({\n    columns,\n    data, // TData inferred from Person[]\n  })\n\n  return (\n    <table.AppTable>\n      <table>\n        <thead>\n          {table.getHeaderGroups().map(headerGroup => (\n            <tr key={headerGroup.id}>\n              {headerGroup.headers.map(h => (\n                <table.AppHeader header={h} key={h.id}>\n                  {(header) => (\n                    <th>\n                      <table.FlexRender header={h} />\n                      <header.SortIndicator />\n                    </th>\n                  )}\n                </table.AppHeader>\n              ))}\n            </tr>\n          ))}\n        </thead>\n        <tbody>\n          {table.getRowModel().rows.map(row => (\n            <tr key={row.id}>\n              {row.getAllCells().map(c => (\n                <table.AppCell cell={c} key={c.id}>\n                  {(cell) => <td><cell.TextCell /></td>}\n                </table.AppCell>\n              ))}\n            </tr>\n          ))}\n        </tbody>\n      </table>\n      <table.PaginationControls />\n    </table.AppTable>\n  )\n}","lang":"tsx"}],"headings":[{"id":"function-createtablehook","text":"Function: createTableHook()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"ttablecomponents","text":"TTableComponents","level":3},{"id":"tcellcomponents","text":"TCellComponents","level":3},{"id":"theadercomponents","text":"THeaderComponents","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"namedparameters","text":"__namedParameters","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: createTableHook()\n\n```ts\nfunction createTableHook<TFeatures, TTableComponents, TCellComponents, THeaderComponents>(__namedParameters): CreateTableHookResult<TFeatures, TTableComponents, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [createTableHook.tsx:691](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L691)\n\nCreates a custom table hook with pre-bound components for composition.\n\nThis is the table equivalent of TanStack Form's `createFormHook`. It allows you to:\n- Define features, row models, and default options once, shared across all tables\n- Register reusable table, cell, and header components\n- Access table/cell/header instances via context in those components\n- Get a `useAppTable` hook that returns an extended table with App wrapper components\n- Get a `createAppColumnHelper` function pre-bound to your features\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n## Parameters\n\n### \\_\\_namedParameters\n\n[`CreateTableHookOptions`](../type-aliases/CreateTableHookOptions.md)\\<`TFeatures`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n\n## Returns\n\n[`CreateTableHookResult`](../interfaces/CreateTableHookResult.md)\\<`TFeatures`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n\n## Example\n\n```tsx\n// hooks/table.ts\nexport const {\n  useAppTable,\n  createAppColumnHelper,\n  useTableContext,\n  useCellContext,\n  useHeaderContext,\n} = createTableHook({\n  features: tableFeatures({\n    rowPaginationFeature,\n    rowSortingFeature,\n    columnFilteringFeature,\n    paginatedRowModel: createPaginatedRowModel(),\n    sortedRowModel: createSortedRowModel(),\n    filteredRowModel: createFilteredRowModel(),\n    sortFns,\n    filterFns,\n  }),\n  tableComponents: { PaginationControls, RowCount },\n  cellComponents: { TextCell, NumberCell },\n  headerComponents: { SortIndicator, ColumnFilter },\n})\n\n// Create column helper with TFeatures already bound\nconst columnHelper = createAppColumnHelper<Person>()\n\n// components/table-components.tsx\nfunction PaginationControls() {\n  const table = useTableContext() // TFeatures already known!\n  return <table.Subscribe selector={(s) => s.pagination}>...</table.Subscribe>\n}\n\n// features/users.tsx\nfunction UsersTable({ data }: { data: Person[] }) {\n  const table = useAppTable({\n    columns,\n    data, // TData inferred from Person[]\n  })\n\n  return (\n    <table.AppTable>\n      <table>\n        <thead>\n          {table.getHeaderGroups().map(headerGroup => (\n            <tr key={headerGroup.id}>\n              {headerGroup.headers.map(h => (\n                <table.AppHeader header={h} key={h.id}>\n                  {(header) => (\n                    <th>\n                      <table.FlexRender header={h} />\n                      <header.SortIndicator />\n                    </th>\n                  )}\n                </table.AppHeader>\n              ))}\n            </tr>\n          ))}\n        </thead>\n        <tbody>\n          {table.getRowModel().rows.map(row => (\n            <tr key={row.id}>\n              {row.getAllCells().map(c => (\n                <table.AppCell cell={c} key={c.id}>\n                  {(cell) => <td><cell.TextCell /></td>}\n                </table.AppCell>\n              ))}\n            </tr>\n          ))}\n        </tbody>\n      </table>\n      <table.PaginationControls />\n    </table.AppTable>\n  )\n}\n```\n","originalRawMarkdown":"---\nid: createTableHook\ntitle: createTableHook\n---\n\n# Function: createTableHook()\n\n```ts\nfunction createTableHook<TFeatures, TTableComponents, TCellComponents, THeaderComponents>(__namedParameters): CreateTableHookResult<TFeatures, TTableComponents, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [createTableHook.tsx:691](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L691)\n\nCreates a custom table hook with pre-bound components for composition.\n\nThis is the table equivalent of TanStack Form's `createFormHook`. It allows you to:\n- Define features, row models, and default options once, shared across all tables\n- Register reusable table, cell, and header components\n- Access table/cell/header instances via context in those components\n- Get a `useAppTable` hook that returns an extended table with App wrapper components\n- Get a `createAppColumnHelper` function pre-bound to your features\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n## Parameters\n\n### \\_\\_namedParameters\n\n[`CreateTableHookOptions`](../type-aliases/CreateTableHookOptions.md)\\<`TFeatures`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n\n## Returns\n\n[`CreateTableHookResult`](../interfaces/CreateTableHookResult.md)\\<`TFeatures`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n\n## Example\n\n```tsx\n// hooks/table.ts\nexport const {\n  useAppTable,\n  createAppColumnHelper,\n  useTableContext,\n  useCellContext,\n  useHeaderContext,\n} = createTableHook({\n  features: tableFeatures({\n    rowPaginationFeature,\n    rowSortingFeature,\n    columnFilteringFeature,\n    paginatedRowModel: createPaginatedRowModel(),\n    sortedRowModel: createSortedRowModel(),\n    filteredRowModel: createFilteredRowModel(),\n    sortFns,\n    filterFns,\n  }),\n  tableComponents: { PaginationControls, RowCount },\n  cellComponents: { TextCell, NumberCell },\n  headerComponents: { SortIndicator, ColumnFilter },\n})\n\n// Create column helper with TFeatures already bound\nconst columnHelper = createAppColumnHelper<Person>()\n\n// components/table-components.tsx\nfunction PaginationControls() {\n  const table = useTableContext() // TFeatures already known!\n  return <table.Subscribe selector={(s) => s.pagination}>...</table.Subscribe>\n}\n\n// features/users.tsx\nfunction UsersTable({ data }: { data: Person[] }) {\n  const table = useAppTable({\n    columns,\n    data, // TData inferred from Person[]\n  })\n\n  return (\n    <table.AppTable>\n      <table>\n        <thead>\n          {table.getHeaderGroups().map(headerGroup => (\n            <tr key={headerGroup.id}>\n              {headerGroup.headers.map(h => (\n                <table.AppHeader header={h} key={h.id}>\n                  {(header) => (\n                    <th>\n                      <table.FlexRender header={h} />\n                      <header.SortIndicator />\n                    </th>\n                  )}\n                </table.AppHeader>\n              ))}\n            </tr>\n          ))}\n        </thead>\n        <tbody>\n          {table.getRowModel().rows.map(row => (\n            <tr key={row.id}>\n              {row.getAllCells().map(c => (\n                <table.AppCell cell={c} key={c.id}>\n                  {(cell) => <td><cell.TextCell /></td>}\n                </table.AppCell>\n              ))}\n            </tr>\n          ))}\n        </tbody>\n      </table>\n      <table.PaginationControls />\n    </table.AppTable>\n  )\n}\n```\n"}
