{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"function-usetable","children":[{"type":"text","value":"Function: useTable()"}]},{"type":"code","value":"function useTable<TFeatures, TData, TSelected>(tableOptions, selector?): PreactTable<TFeatures, TData, TSelected>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/preact-table/src/useTable.ts#L120","children":[{"type":"text","value":"useTable.ts:120"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a Preact table instance backed by TanStack Store atoms."}]},{"type":"paragraph","children":[{"type":"text","value":"The optional selector projects from "},{"type":"inlineCode","value":"table.store"},{"type":"text","value":"; the selected value is\nexposed on "},{"type":"inlineCode","value":"table.state"},{"type":"text","value":" and compared shallowly for Preact re-renders. Omit\nthe selector to subscribe to every registered table state slice, or pass a\nnarrower selector and use "},{"type":"inlineCode","value":"table.Subscribe"},{"type":"text","value":" lower in the tree for targeted\nsubscriptions."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfeatures","children":[{"type":"text","value":"TFeatures"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"TableFeatures"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TableState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"tableoptions","children":[{"type":"text","value":"tableOptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TableOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"selector","children":[{"type":"text","value":"selector?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"state"},{"type":"text","value":") => "},{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/PreactTable.md","children":[{"type":"inlineCode","value":"PreactTable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const table = useTable(\n  {\n    features,\n    columns,\n    data,\n  },\n  (state) => ({ pagination: state.pagination }),\n)\n\ntable.state.pagination","lang":"tsx"}],"headings":[{"id":"function-usetable","text":"Function: useTable()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"tableoptions","text":"tableOptions","level":3},{"id":"selector","text":"selector?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: useTable()\n\n```ts\nfunction useTable<TFeatures, TData, TSelected>(tableOptions, selector?): PreactTable<TFeatures, TData, TSelected>;\n```\n\nDefined in: [useTable.ts:120](https://github.com/TanStack/table/blob/main/packages/preact-table/src/useTable.ts#L120)\n\nCreates a Preact table instance backed by TanStack Store atoms.\n\nThe optional selector projects from `table.store`; the selected value is\nexposed on `table.state` and compared shallowly for Preact re-renders. Omit\nthe selector to subscribe to every registered table state slice, or pass a\nnarrower selector and use `table.Subscribe` lower in the tree for targeted\nsubscriptions.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n\n## Parameters\n\n### tableOptions\n\n`TableOptions`\\<`TFeatures`, `TData`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`PreactTable`](../type-aliases/PreactTable.md)\\<`TFeatures`, `TData`, `TSelected`\\>\n\n## Example\n\n```tsx\nconst table = useTable(\n  {\n    features,\n    columns,\n    data,\n  },\n  (state) => ({ pagination: state.pagination }),\n)\n\ntable.state.pagination\n```\n","originalRawMarkdown":"---\nid: useTable\ntitle: useTable\n---\n\n# Function: useTable()\n\n```ts\nfunction useTable<TFeatures, TData, TSelected>(tableOptions, selector?): PreactTable<TFeatures, TData, TSelected>;\n```\n\nDefined in: [useTable.ts:120](https://github.com/TanStack/table/blob/main/packages/preact-table/src/useTable.ts#L120)\n\nCreates a Preact table instance backed by TanStack Store atoms.\n\nThe optional selector projects from `table.store`; the selected value is\nexposed on `table.state` and compared shallowly for Preact re-renders. Omit\nthe selector to subscribe to every registered table state slice, or pass a\nnarrower selector and use `table.Subscribe` lower in the tree for targeted\nsubscriptions.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n\n## Parameters\n\n### tableOptions\n\n`TableOptions`\\<`TFeatures`, `TData`\\>\n\n### selector?\n\n(`state`) => `TSelected`\n\n## Returns\n\n[`PreactTable`](../type-aliases/PreactTable.md)\\<`TFeatures`, `TData`, `TSelected`\\>\n\n## Example\n\n```tsx\nconst table = useTable(\n  {\n    features,\n    columns,\n    data,\n  },\n  (state) => ({ pagination: state.pagination }),\n)\n\ntable.state.pagination\n```\n"}
