alue":"App*"},{"type":"text","value":" components and your\n"},{"type":"inlineCode","value":"tableComponents"},{"type":"text","value":" are available on it."}]},{"type":"paragraph","children":[{"type":"text","value":"Pass "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" to match the selector you gave "},{"type":"inlineCode","value":"useAppTable"},{"type":"text","value":", so\n"},{"type":"inlineCode","value":"table.state"},{"type":"text","value":" is typed as the selected slice. It cannot be inferred\nautomatically (context does not carry the provider's generics), so it\ndefaults to the full table state, which is correct for the common case of\n"},{"type":"inlineCode","value":"useAppTable"},{"type":"text","value":" without a selector."}]},{"type":"heading","depth":4,"id":"type-parameters-6","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":5,"id":"tdata-3","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"},{"type":"text","value":" = "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":5,"id":"tselected-2","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TableState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-5","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/AppPreactTable.md","children":[{"type":"inlineCode","value":"AppPreactTable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSelected"},{"type":"text","value":", "},{"type":"inlineCode","value":"TTableComponents"},{"type":"text","value":", "},{"type":"inlineCode","value":"TCellComponents"},{"type":"text","value":", "},{"type":"inlineCode","value":"THeaderComponents"},{"type":"text","value":">"}]}],"headings":[{"id":"interface-createtablehookresulttfeatures-ttablecomponents-tcellcomponents-theadercomponents","text":"Interface: CreateTableHookResult<TFeatures, TTableComponents, TCellComponents, THeaderComponents>","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"ttablecomponents","text":"TTableComponents","level":3},{"id":"tcellcomponents","text":"TCellComponents","level":3},{"id":"theadercomponents","text":"THeaderComponents","level":3},{"id":"properties","text":"Properties","level":2},{"id":"appfeatures","text":"appFeatures","level":3},{"id":"createappcolumnhelper","text":"createAppColumnHelper()","level":3},{"id":"type-parameters-2","text":"Type Parameters","level":4},{"id":"tdata","text":"TData","level":5},{"id":"returns","text":"Returns","level":4},{"id":"useapptable","text":"useAppTable()","level":3},{"id":"type-parameters-3","text":"Type Parameters","level":4},{"id":"tdata-2","text":"TData","level":5},{"id":"tselected","text":"TSelected","level":5},{"id":"parameters","text":"Parameters","level":4},{"id":"tableoptions","text":"tableOptions","level":5},{"id":"selector","text":"selector?","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"usecellcontext","text":"useCellContext()","level":3},{"id":"type-parameters-4","text":"Type Parameters","level":4},{"id":"tvalue","text":"TValue","level":5},{"id":"returns-3","text":"Returns","level":4},{"id":"useheadercontext","text":"useHeaderContext()","level":3},{"id":"type-parameters-5","text":"Type Parameters","level":4},{"id":"tvalue-2","text":"TValue","level":5},{"id":"returns-4","text":"Returns","level":4},{"id":"usetablecontext","text":"useTableContext()","level":3},{"id":"type-parameters-6","text":"Type Parameters","level":4},{"id":"tdata-3","text":"TData","level":5},{"id":"tselected-2","text":"TSelected","level":5},{"id":"returns-5","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\n# Interface: CreateTableHookResult\\<TFeatures, TTableComponents, TCellComponents, THeaderComponents\\>\n\nDefined in: [createTableHook.tsx:295](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L295)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n## Properties\n\n### appFeatures\n\n```ts\nappFeatures: TFeatures;\n```\n\nDefined in: [createTableHook.tsx:302](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L302)\n\nThe features object that was passed to `createTableHook`.\n\n***\n\n### createAppColumnHelper()\n\n```ts\ncreateAppColumnHelper: <TData>() => AppColumnHelper<TFeatures, TData, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [createTableHook.tsx:307](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L307)\n\nA column helper pre-bound to `TFeatures` and the registered components, so\nthe cell/header/footer render props expose the bound components.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n#### Returns\n\n[`AppColumnHelper`](../type-aliases/AppColumnHelper.md)\\<`TFeatures`, `TData`, `TCellComponents`, `THeaderComponents`\\>\n\n***\n\n### useAppTable()\n\n```ts\nuseAppTable: <TData, TSelected>(tableOptions, selector?) => AppPreactTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [createTableHook.tsx:317](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L317)\n\nCreates a table with the `App*` wrapper components and registered\n`tableComponents` attached. `TData` is inferred from the `data` option.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n##### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n\n#### Parameters\n\n##### tableOptions\n\n`Omit`\\<`TableOptions`\\<`TFeatures`, `TData`\\>, `\"features\"`\\>\n\n##### selector?\n\n(`state`) => `TSelected`\n\n#### Returns\n\n[`AppPreactTable`](../type-aliases/AppPreactTable.md)\\<`TFeatures`, `TData`, `TSelected`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n\n***\n\n### useCellContext()\n\n```ts\nuseCellContext: <TValue>() => Cell_Core<TFeatures, any, TValue> & ExtractFeatureMapTypes<TFeatures, Cell_FeatureMap> & TCellComponents & object;\n```\n\nDefined in: [createTableHook.tsx:354](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L354)\n\nReads the cell provided by the nearest `<table.AppCell>`, extended with your\n`cellComponents` and a context-bound `FlexRender`.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n#### Returns\n\n`Cell_Core`\\<`TFeatures`, `any`, `TValue`\\> & `ExtractFeatureMapTypes`\\<`TFeatures`, `Cell_FeatureMap`\\> & `TCellComponents` & `object`\n\n***\n\n### useHeaderContext()\n\n```ts\nuseHeaderContext: <TValue>() => Header_Core<TFeatures, any, TValue> & ExtractFeatureMapTypes<TFeatures, Header_FeatureMap> & THeaderComponents & object;\n```\n\nDefined in: [createTableHook.tsx:365](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L365)\n\nReads the header provided by the nearest `<table.AppHeader>` /\n`<table.AppFooter>`, extended with your `headerComponents` and a\ncontext-bound `FlexRender`.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n#### Returns\n\n`Header_Core`\\<`TFeatures`, `any`, `TValue`\\> & `ExtractFeatureMapTypes`\\<`TFeatures`, `Header_FeatureMap`\\> & `THeaderComponents` & `object`\n\n***\n\n### useTableContext()\n\n```ts\nuseTableContext: <TData, TSelected>() => AppPreactTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [createTableHook.tsx:339](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L339)\n\nReads the table provided by the nearest `<table.AppTable>`. This is the same\nextended instance `useAppTable` returns, so the `App*` components and your\n`tableComponents` are available on it.\n\nPass `TSelected` to match the selector you gave `useAppTable`, so\n`table.state` is typed as the selected slice. It cannot be inferred\nautomatically (context does not carry the provider's generics), so it\ndefaults to the full table state, which is correct for the common case of\n`useAppTable` without a selector.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData` = `RowData`\n\n##### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n\n#### Returns\n\n[`AppPreactTable`](../type-aliases/AppPreactTable.md)\\<`TFeatures`, `TData`, `TSelected`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n","originalRawMarkdown":"---\nid: CreateTableHookResult\ntitle: CreateTableHookResult\n---\n\n# Interface: CreateTableHookResult\\<TFeatures, TTableComponents, TCellComponents, THeaderComponents\\>\n\nDefined in: [createTableHook.tsx:295](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L295)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n## Properties\n\n### appFeatures\n\n```ts\nappFeatures: TFeatures;\n```\n\nDefined in: [createTableHook.tsx:302](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L302)\n\nThe features object that was passed to `createTableHook`.\n\n***\n\n### createAppColumnHelper()\n\n```ts\ncreateAppColumnHelper: <TData>() => AppColumnHelper<TFeatures, TData, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [createTableHook.tsx:307](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L307)\n\nA column helper pre-bound to `TFeatures` and the registered components, so\nthe cell/header/footer render props expose the bound components.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n#### Returns\n\n[`AppColumnHelper`](../type-aliases/AppColumnHelper.md)\\<`TFeatures`, `TData`, `TCellComponents`, `THeaderComponents`\\>\n\n***\n\n### useAppTable()\n\n```ts\nuseAppTable: <TData, TSelected>(tableOptions, selector?) => AppPreactTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [createTableHook.tsx:317](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L317)\n\nCreates a table with the `App*` wrapper components and registered\n`tableComponents` attached. `TData` is inferred from the `data` option.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData`\n\n##### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n\n#### Parameters\n\n##### tableOptions\n\n`Omit`\\<`TableOptions`\\<`TFeatures`, `TData`\\>, `\"features\"`\\>\n\n##### selector?\n\n(`state`) => `TSelected`\n\n#### Returns\n\n[`AppPreactTable`](../type-aliases/AppPreactTable.md)\\<`TFeatures`, `TData`, `TSelected`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n\n***\n\n### useCellContext()\n\n```ts\nuseCellContext: <TValue>() => Cell_Core<TFeatures, any, TValue> & ExtractFeatureMapTypes<TFeatures, Cell_FeatureMap> & TCellComponents & object;\n```\n\nDefined in: [createTableHook.tsx:354](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L354)\n\nReads the cell provided by the nearest `<table.AppCell>`, extended with your\n`cellComponents` and a context-bound `FlexRender`.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n#### Returns\n\n`Cell_Core`\\<`TFeatures`, `any`, `TValue`\\> & `ExtractFeatureMapTypes`\\<`TFeatures`, `Cell_FeatureMap`\\> & `TCellComponents` & `object`\n\n***\n\n### useHeaderContext()\n\n```ts\nuseHeaderContext: <TValue>() => Header_Core<TFeatures, any, TValue> & ExtractFeatureMapTypes<TFeatures, Header_FeatureMap> & THeaderComponents & object;\n```\n\nDefined in: [createTableHook.tsx:365](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L365)\n\nReads the header provided by the nearest `<table.AppHeader>` /\n`<table.AppFooter>`, extended with your `headerComponents` and a\ncontext-bound `FlexRender`.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n#### Returns\n\n`Header_Core`\\<`TFeatures`, `any`, `TValue`\\> & `ExtractFeatureMapTypes`\\<`TFeatures`, `Header_FeatureMap`\\> & `THeaderComponents` & `object`\n\n***\n\n### useTableContext()\n\n```ts\nuseTableContext: <TData, TSelected>() => AppPreactTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents>;\n```\n\nDefined in: [createTableHook.tsx:339](https://github.com/TanStack/table/blob/main/packages/preact-table/src/createTableHook.tsx#L339)\n\nReads the table provided by the nearest `<table.AppTable>`. This is the same\nextended instance `useAppTable` returns, so the `App*` components and your\n`tableComponents` are available on it.\n\nPass `TSelected` to match the selector you gave `useAppTable`, so\n`table.state` is typed as the selected slice. It cannot be inferred\nautomatically (context does not carry the provider's generics), so it\ndefaults to the full table state, which is correct for the common case of\n`useAppTable` without a selector.\n\n#### Type Parameters\n\n##### TData\n\n`TData` *extends* `RowData` = `RowData`\n\n##### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n\n#### Returns\n\n[`AppPreactTable`](../type-aliases/AppPreactTable.md)\\<`TFeatures`, `TData`, `TSelected`, `TTableComponents`, `TCellComponents`, `THeaderComponents`\\>\n"}
