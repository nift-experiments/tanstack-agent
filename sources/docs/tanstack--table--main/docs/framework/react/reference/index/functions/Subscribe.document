e) => ({ rowSelection: state.rowSelection })}>\n  {({ rowSelection }) => (\n    <div>Selected rows: {Object.keys(rowSelection).length}</div>\n  )}\n</Subscribe>","lang":"tsx"},{"type":"code","value":"// Entire source (atom or store) — no selector\n<Subscribe source={table.atoms.rowSelection}>\n  {(rowSelection) => <div>...</div>}\n</Subscribe>","lang":"tsx"},{"type":"code","value":"// Project source value (e.g. one row’s selection)\n<Subscribe\n  source={table.atoms.rowSelection}\n  selector={(rowSelection) => rowSelection?.[row.id]}\n>\n  {(selected) => <tr data-selected={!!selected}>...</tr>}\n</Subscribe>","lang":"tsx"},{"type":"code","value":"// As table.Subscribe (table instance method)\n<table.Subscribe selector={(state) => ({ rowSelection: state.rowSelection })}>\n  {({ rowSelection }) => (\n    <div>Selected rows: {Object.keys(rowSelection).length}</div>\n  )}\n</table.Subscribe>","lang":"tsx"}],"headings":[{"id":"function-subscribe","text":"Function: Subscribe()","level":1},{"id":"call-signature","text":"Call Signature","level":2},{"id":"type-parameters","text":"Type Parameters","level":3},{"id":"tsourcevalue","text":"TSourceValue","level":4},{"id":"parameters","text":"Parameters","level":3},{"id":"props","text":"props","level":4},{"id":"returns","text":"Returns","level":3},{"id":"examples","text":"Examples","level":3},{"id":"call-signature-2","text":"Call Signature","level":2},{"id":"type-parameters-2","text":"Type Parameters","level":3},{"id":"tsourcevalue-2","text":"TSourceValue","level":4},{"id":"tselected","text":"TSelected","level":4},{"id":"parameters-2","text":"Parameters","level":3},{"id":"props-2","text":"props","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"examples-2","text":"Examples","level":3},{"id":"call-signature-3","text":"Call Signature","level":2},{"id":"type-parameters-3","text":"Type Parameters","level":3},{"id":"tfeatures","text":"TFeatures","level":4},{"id":"tselected-2","text":"TSelected","level":4},{"id":"parameters-3","text":"Parameters","level":3},{"id":"props-3","text":"props","level":4},{"id":"returns-3","text":"Returns","level":3},{"id":"examples-3","text":"Examples","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Function: Subscribe()\n\n## Call Signature\n\n```ts\nfunction Subscribe<TSourceValue>(props): ReactNode | Promise<ReactNode>;\n```\n\nDefined in: [react-table/src/Subscribe.ts:122](https://github.com/TanStack/table/blob/main/packages/react-table/src/Subscribe.ts#L122)\n\nA React component that allows you to subscribe to the table state.\n\nThis is useful for opting into state re-renders for specific parts of the table state.\n\nFor `table.Subscribe` from `useTable`, prefer that API — it uses overloads so JSX\ncontextual typing works. This standalone component uses a union `props` type.\n\n### Type Parameters\n\n#### TSourceValue\n\n`TSourceValue`\n\n### Parameters\n\n#### props\n\n[`SubscribePropsWithSourceIdentity`](../type-aliases/SubscribePropsWithSourceIdentity.md)\\<`TSourceValue`\\>\n\n### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n### Examples\n\n```tsx\n// As a standalone component — full store\n<Subscribe source={table.store} selector={(state) => ({ rowSelection: state.rowSelection })}>\n  {({ rowSelection }) => (\n    <div>Selected rows: {Object.keys(rowSelection).length}</div>\n  )}\n</Subscribe>\n```\n\n```tsx\n// Entire source (atom or store) — no selector\n<Subscribe source={table.atoms.rowSelection}>\n  {(rowSelection) => <div>...</div>}\n</Subscribe>\n```\n\n```tsx\n// Project source value (e.g. one row’s selection)\n<Subscribe\n  source={table.atoms.rowSelection}\n  selector={(rowSelection) => rowSelection?.[row.id]}\n>\n  {(selected) => <tr data-selected={!!selected}>...</tr>}\n</Subscribe>\n```\n\n```tsx\n// As table.Subscribe (table instance method)\n<table.Subscribe selector={(state) => ({ rowSelection: state.rowSelection })}>\n  {({ rowSelection }) => (\n    <div>Selected rows: {Object.keys(rowSelection).length}</div>\n  )}\n</table.Subscribe>\n```\n\n## Call Signature\n\n```ts\nfunction Subscribe<TSourceValue, TSelected>(props): ReactNode | Promise<ReactNode>;\n```\n\nDefined in: [react-table/src/Subscribe.ts:125](https://github.com/TanStack/table/blob/main/packages/react-table/src/Subscribe.ts#L125)\n\nA React component that allows you to subscribe to the table state.\n\nThis is useful for opting into state re-renders for specific parts of the table state.\n\nFor `table.Subscribe` from `useTable`, prefer that API — it uses overloads so JSX\ncontextual typing works. This standalone component uses a union `props` type.\n\n### Type Parameters\n\n#### TSourceValue\n\n`TSourceValue`\n\n#### TSelected\n\n`TSelected`\n\n### Parameters\n\n#### props\n\n[`SubscribePropsWithSourceWithSelector`](../type-aliases/SubscribePropsWithSourceWithSelector.md)\\<`TSourceValue`, `TSelected`\\>\n\n### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n### Examples\n\n```tsx\n// As a standalone component — full store\n<Subscribe source={table.store} selector={(state) => ({ rowSelection: state.rowSelection })}>\n  {({ rowSelection }) => (\n    <div>Selected rows: {Object.keys(rowSelection).length}</div>\n  )}\n</Subscribe>\n```\n\n```tsx\n// Entire source (atom or store) — no selector\n<Subscribe source={table.atoms.rowSelection}>\n  {(rowSelection) => <div>...</div>}\n</Subscribe>\n```\n\n```tsx\n// Project source value (e.g. one row’s selection)\n<Subscribe\n  source={table.atoms.rowSelection}\n  selector={(rowSelection) => rowSelection?.[row.id]}\n>\n  {(selected) => <tr data-selected={!!selected}>...</tr>}\n</Subscribe>\n```\n\n```tsx\n// As table.Subscribe (table instance method)\n<table.Subscribe selector={(state) => ({ rowSelection: state.rowSelection })}>\n  {({ rowSelection }) => (\n    <div>Selected rows: {Object.keys(rowSelection).length}</div>\n  )}\n</table.Subscribe>\n```\n\n## Call Signature\n\n```ts\nfunction Subscribe<TFeatures, TSelected>(props): ReactNode | Promise<ReactNode>;\n```\n\nDefined in: [react-table/src/Subscribe.ts:128](https://github.com/TanStack/table/blob/main/packages/react-table/src/Subscribe.ts#L128)\n\nA React component that allows you to subscribe to the table state.\n\nThis is useful for opting into state re-renders for specific parts of the table state.\n\nFor `table.Subscribe` from `useTable`, prefer that API — it uses overloads so JSX\ncontextual typing works. This standalone component uses a union `props` type.\n\n### Type Parameters\n\n#### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n#### TSelected\n\n`TSelected`\n\n### Parameters\n\n#### props\n\n[`SubscribePropsWithStore`](../type-aliases/SubscribePropsWithStore.md)\\<`TFeatures`, `TSelected`\\>\n\n### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n### Examples\n\n```tsx\n// As a standalone component — full store\n<Subscribe source={table.store} selector={(state) => ({ rowSelection: state.rowSelection })}>\n  {({ rowSelection }) => (\n    <div>Selected rows: {Object.keys(rowSelection).length}</div>\n  )}\n</Subscribe>\n```\n\n```tsx\n// Entire source (atom or store) — no selector\n<Subscribe source={table.atoms.rowSelection}>\n  {(rowSelection) => <div>...</div>}\n</Subscribe>\n```\n\n```tsx\n// Project source value (e.g. one row’s selection)\n<Subscribe\n  source={table.atoms.rowSelection}\n  selector={(rowSelection) => rowSelection?.[row.id]}\n>\n  {(selected) => <tr data-selected={!!selected}>...</tr>}\n</Subscribe>\n```\n\n```tsx\n// As table.Subscribe (table instance method)\n<table.Subscribe selector={(state) => ({ rowSelection: state.rowSelection })}>\n  {({ rowSelection }) => (\n    <div>Selected rows: {Object.keys(rowSelection).length}</div>\n  )}\n</table.Subscribe>\n```\n","originalRawMarkdown":"---\nid: Subscribe\ntitle: Subscribe\n---\n\n# Function: Subscribe()\n\n## Call Signature\n\n```ts\nfunction Subscribe<TSourceValue>(props): ReactNode | Promise<ReactNode>;\n```\n\nDefined in: [react-table/src/Subscribe.ts:122](https://githu