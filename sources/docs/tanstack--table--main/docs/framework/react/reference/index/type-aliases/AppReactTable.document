ination.pageIndex}</div>}\n</table.AppTable>","lang":"tsx"},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfeatures","children":[{"type":"text","value":"TFeatures"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"TableFeatures"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"}]},{"type":"heading","depth":3,"id":"ttablecomponents","children":[{"type":"text","value":"TTableComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTableComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"ComponentType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"tcellcomponents","children":[{"type":"text","value":"TCellComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCellComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"ComponentType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"theadercomponents","children":[{"type":"text","value":"THeaderComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"THeaderComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"ComponentType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]}],"headings":[{"id":"type-alias-appreacttabletfeatures-tdata-tselected-ttablecomponents-tcellcomponents-theadercomponents","text":"Type Alias: AppReactTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents>","level":1},{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"appcell","text":"AppCell","level":3},{"id":"example","text":"Example","level":4},{"id":"appfooter","text":"AppFooter","level":3},{"id":"example-2","text":"Example","level":4},{"id":"appheader","text":"AppHeader","level":3},{"id":"example-3","text":"Example","level":4},{"id":"apptable","text":"AppTable","level":3},{"id":"example-4","text":"Example","level":4},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tselected","text":"TSelected","level":3},{"id":"ttablecomponents","text":"TTableComponents","level":3},{"id":"tcellcomponents","text":"TCellComponents","level":3},{"id":"theadercomponents","text":"THeaderComponents","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Type Alias: AppReactTable\\<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents\\>\n\n```ts\ntype AppReactTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents> = ReactTable<TFeatures, TData, TSelected> & NoInfer<TTableComponents> & object;\n```\n\nDefined in: [react-table/src/createTableHook.tsx:532](https://github.com/TanStack/table/blob/main/packages/react-table/src/createTableHook.tsx#L532)\n\nExtended table API returned by useAppTable with all App wrapper components\n\n## Type Declaration\n\n### AppCell\n\n```ts\nAppCell: AppCellComponent<TFeatures, TData, NoInfer<TCellComponents>>;\n```\n\nWraps a cell and provides cell context with pre-bound cellComponents.\nOptionally accepts a selector for Subscribe functionality.\n\n#### Example\n\n```tsx\n// Without selector\n<table.AppCell cell={cell}>\n  {(c) => <td><c.TextCell /></td>}\n</table.AppCell>\n\n// With selector - children receives cell and selected state\n<table.AppCell cell={cell} selector={(s) => s.columnFilters}>\n  {(c, filters) => <td>{filters.length}</td>}\n</table.AppCell>\n```\n\n### AppFooter\n\n```ts\nAppFooter: AppHeaderComponent<TFeatures, TData, NoInfer<THeaderComponents>>;\n```\n\nWraps a footer and provides header context with pre-bound headerComponents.\nOptionally accepts a selector for Subscribe functionality.\n\n#### Example\n\n```tsx\n<table.AppFooter header={footer}>\n  {(f) => <td><table.FlexRender footer={footer} /></td>}\n</table.AppFooter>\n```\n\n### AppHeader\n\n```ts\nAppHeader: AppHeaderComponent<TFeatures, TData, NoInfer<THeaderComponents>>;\n```\n\nWraps a header and provides header context with pre-bound headerComponents.\nOptionally accepts a selector for Subscribe functionality.\n\n#### Example\n\n```tsx\n// Without selector\n<table.AppHeader header={header}>\n  {(h) => <th><h.SortIndicator /></th>}\n</table.AppHeader>\n\n// With selector\n<table.AppHeader header={header} selector={(s) => s.sorting}>\n  {(h, sorting) => <th>{sorting.length} sorted</th>}\n</table.AppHeader>\n```\n\n### AppTable\n\n```ts\nAppTable: AppTableComponent<TFeatures>;\n```\n\nRoot wrapper component that provides table context with optional Subscribe.\n\n#### Example\n\n```tsx\n// Without selector - children is ReactNode\n<table.AppTable>\n  <table>...</table>\n</table.AppTable>\n\n// With selector - children receives selected state\n<table.AppTable selector={(s) => s.pagination}>\n  {(pagination) => <div>Page {pagination.pageIndex}</div>}\n</table.AppTable>\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n","originalRawMarkdown":"---\nid: AppReactTable\ntitle: AppReactTable\n---\n\n# Type Alias: AppReactTable\\<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents\\>\n\n```ts\ntype AppReactTable<TFeatures, TData, TSelected, TTableComponents, TCellComponents, THeaderComponents> = ReactTable<TFeatures, TData, TSelected> & NoInfer<TTableComponents> & object;\n```\n\nDefined in: [react-table/src/createTableHook.tsx:532](https://github.com/TanStack/table/blob/main/packages/react-table/src/createTableHook.tsx#L532)\n\nExtended table API returned by useAppTable with all App wrapper components\n\n## Type Declaration\n\n### AppCell\n\n```ts\nAppCell: AppCellComponent<TFeatures, TData, NoInfer<TCellComponents>>;\n```\n\nWraps a cell and provides cell context with pre-bound cellComponents.\nOptionally accepts a selector for Subscribe functionality.\n\n#### Example\n\n```tsx\n// Without selector\n<table.AppCell cell={cell}>\n  {(c) => <td><c.TextCell /></td>}\n</table.AppCell>\n\n// With selector - children receives cell and selected state\n<table.AppCell cell={cell} selector={(s) => s.columnFilters}>\n  {(c, filters) => <td>{filters.length}</td>}\n</table.AppCell>\n```\n\n### AppFooter\n\n```ts\nAppFooter: AppHeaderComponent<TFeatures, TData, NoInfer<THeaderComponents>>;\n```\n\nWraps a footer and provides header context with pre-bound headerComponents.\nOptionally accepts a selector for Subscribe functionality.\n\n#### Example\n\n```tsx\n<table.AppFooter header={footer}>\n  {(f) => <td><table.FlexRender footer={footer} /></td>}\n</table.AppFooter>\n```\n\n### AppHeader\n\n```ts\nAppHeader: AppHeaderComponent<TFeatures, TData, NoInfer<THeaderComponents>>;\n```\n\nWraps a header and provides header context with pre-bound headerComponents.\nOptionally accepts a selector for Subscribe functionality.\n\n#### Example\n\n```tsx\n// Without selector\n<table.AppHeader header={header}>\n  {(h) => <th><h.SortIndicator /></th>}\n</table.AppHeader>\n\n// With selector\n<table.AppHeader header={header} selector={(s) => s.sorting}>\n  {(h, sorting) => <th>{sorting.length} sorted</th>}\n</table.AppHeader>\n```\n\n### AppTable\n\n```ts\nAppTable: AppTableComponent<TFeatures>;\n```\n\nRoot wrapper component that provides table context with optional Subscribe.\n\n#### Example\n\n```tsx\n// Without selector - children is ReactNode\n<table.AppTable>\n  <table>...</table>\n</table.AppTable>\n\n// With selector - children receives selected state\n<table.AppTable selector={(s) => s.pagination}>\n  {(pagination) => <div>Page {pagination.pageIndex}</div>}\n</table.AppTable>\n```\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n"}
