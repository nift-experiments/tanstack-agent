nce.\nThese are available directly on the table object returned by useAppTable.\nUse "},{"type":"inlineCode","value":"useTableContext()"},{"type":"text","value":" inside these components."}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"{ PaginationControls, GlobalFilter, RowCount }","lang":"ts"},{"type":"heading","depth":3,"id":"tablecontext","children":[{"type":"text","value":"tableContext?"}]},{"type":"code","value":"optional tableContext: Context<ReactTable<any, any>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"A custom React context for the table instance (read with "},{"type":"inlineCode","value":"useContext"},{"type":"text","value":" inside\nyour "},{"type":"inlineCode","value":"tableComponents"},{"type":"text","value":"). Optional: defaults to a shared module-scoped context.\nOnly pass your own (created via "},{"type":"inlineCode","value":"createContext"},{"type":"text","value":") when you need to isolate this\ntable's context from other tables, e.g. when nesting one table inside another."}]},{"type":"heading","depth":2,"id":"type-parameters","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfeatures","children":[{"type":"text","value":"TFeatures"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"TableFeatures"}]},{"type":"heading","depth":3,"id":"ttablecomponents","children":[{"type":"text","value":"TTableComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TTableComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"ComponentType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"tcellcomponents","children":[{"type":"text","value":"TCellComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCellComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"ComponentType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]},{"type":"heading","depth":3,"id":"theadercomponents","children":[{"type":"text","value":"THeaderComponents"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"THeaderComponents"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"ComponentType"},{"type":"text","value":"<"},{"type":"inlineCode","value":"any"},{"type":"text","value":">>"}]}],"headings":[{"id":"type-alias-createtablehookoptionstfeatures-ttablecomponents-tcellcomponents-theadercomponents","text":"Type Alias: CreateTableHookOptions<TFeatures, TTableComponents, TCellComponents, THeaderComponents>","level":1},{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"cellcomponents","text":"cellComponents?","level":3},{"id":"example","text":"Example","level":4},{"id":"cellcontext","text":"cellContext?","level":3},{"id":"see","text":"See","level":4},{"id":"headercomponents","text":"headerComponents?","level":3},{"id":"example-2","text":"Example","level":4},{"id":"headercontext","text":"headerContext?","level":3},{"id":"see-2","text":"See","level":4},{"id":"tablecomponents","text":"tableComponents?","level":3},{"id":"example-3","text":"Example","level":4},{"id":"tablecontext","text":"tableContext?","level":3},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"ttablecomponents","text":"TTableComponents","level":3},{"id":"tcellcomponents","text":"TCellComponents","level":3},{"id":"theadercomponents","text":"THeaderComponents","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Type Alias: CreateTableHookOptions\\<TFeatures, TTableComponents, TCellComponents, THeaderComponents\\>\n\n```ts\ntype CreateTableHookOptions<TFeatures, TTableComponents, TCellComponents, THeaderComponents> = Omit<TableOptions<TFeatures, any>, \"columns\" | \"data\" | \"store\" | \"state\" | \"initialState\"> & object;\n```\n\nDefined in: [react-table/src/createTableHook.tsx:248](https://github.com/TanStack/table/blob/main/packages/react-table/src/createTableHook.tsx#L248)\n\nOptions for creating a table hook with pre-bound components and default table options.\nExtends all TableOptions except 'columns' | 'data' | 'store' | 'state' | 'initialState'.\n\n## Type Declaration\n\n### cellComponents?\n\n```ts\noptional cellComponents: TCellComponents;\n```\n\nCell-level components that need access to the cell instance.\nThese are available on the cell object passed to AppCell's children.\nUse `useCellContext()` inside these components.\n\n#### Example\n\n```ts\n{ TextCell, NumberCell, DateCell, CurrencyCell }\n```\n\n### cellContext?\n\n```ts\noptional cellContext: Context<Cell<any, any, any>>;\n```\n\nA custom React context for the cell instance, used inside your `cellComponents`.\n\n#### See\n\nCreateTableHookOptions.tableContext\n\n### headerComponents?\n\n```ts\noptional headerComponents: THeaderComponents;\n```\n\nHeader-level components that need access to the header instance.\nThese are available on the header object passed to AppHeader/AppFooter's children.\nUse `useHeaderContext()` inside these components.\n\n#### Example\n\n```ts\n{ SortIndicator, ColumnFilter, ResizeHandle }\n```\n\n### headerContext?\n\n```ts\noptional headerContext: Context<Header<any, any, any>>;\n```\n\nA custom React context for the header instance, used inside your\n`headerComponents` (and footer components).\n\n#### See\n\nCreateTableHookOptions.tableContext\n\n### tableComponents?\n\n```ts\noptional tableComponents: TTableComponents;\n```\n\nTable-level components that need access to the table instance.\nThese are available directly on the table object returned by useAppTable.\nUse `useTableContext()` inside these components.\n\n#### Example\n\n```ts\n{ PaginationControls, GlobalFilter, RowCount }\n```\n\n### tableContext?\n\n```ts\noptional tableContext: Context<ReactTable<any, any>>;\n```\n\nA custom React context for the table instance (read with `useContext` inside\nyour `tableComponents`). Optional: defaults to a shared module-scoped context.\nOnly pass your own (created via `createContext`) when you need to isolate this\ntable's context from other tables, e.g. when nesting one table inside another.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n","originalRawMarkdown":"---\nid: CreateTableHookOptions\ntitle: CreateTableHookOptions\n---\n\n# Type Alias: CreateTableHookOptions\\<TFeatures, TTableComponents, TCellComponents, THeaderComponents\\>\n\n```ts\ntype CreateTableHookOptions<TFeatures, TTableComponents, TCellComponents, THeaderComponents> = Omit<TableOptions<TFeatures, any>, \"columns\" | \"data\" | \"store\" | \"state\" | \"initialState\"> & object;\n```\n\nDefined in: [react-table/src/createTableHook.tsx:248](https://github.com/TanStack/table/blob/main/packages/react-table/src/createTableHook.tsx#L248)\n\nOptions for creating a table hook with pre-bound components and default table options.\nExtends all TableOptions except 'columns' | 'data' | 'store' | 'state' | 'initialState'.\n\n## Type Declaration\n\n### cellComponents?\n\n```ts\noptional cellComponents: TCellComponents;\n```\n\nCell-level components that need access to the cell instance.\nThese are available on the cell object passed to AppCell's children.\nUse `useCellContext()` inside these components.\n\n#### Example\n\n```ts\n{ TextCell, NumberCell, DateCell, CurrencyCell }\n```\n\n### cellContext?\n\n```ts\noptional cellContext: Context<Cell<any, any, any>>;\n```\n\nA custom React context for the cell instance, used inside your `cellComponents`.\n\n#### See\n\nCreateTableHookOptions.tableContext\n\n### headerComponents?\n\n```ts\noptional headerComponents: THeaderComponents;\n```\n\nHeader-level components that need access to the header instance.\nThese are available on the header object passed to AppHeader/AppFooter's children.\nUse `useHeaderContext()` inside these components.\n\n#### Example\n\n```ts\n{ SortIndicator, ColumnFilter, ResizeHandle }\n```\n\n### headerContext?\n\n```ts\noptional headerContext: Context<Header<any, any, any>>;\n```\n\nA custom React context for the header instance, used inside your\n`headerComponents` (and footer components).\n\n#### See\n\nCreateTableHookOptions.tableContext\n\n### tableComponents?\n\n```ts\noptional tableComponents: TTableComponents;\n```\n\nTable-level components that need access to the table instance.\nThese are available directly on the table object returned by useAppTable.\nUse `useTableContext()` inside these components.\n\n#### Example\n\n```ts\n{ PaginationControls, GlobalFilter, RowCount }\n```\n\n### tableContext?\n\n```ts\noptional tableContext: Context<ReactTable<any, any>>;\n```\n\nA custom React context for the table instance (read with `useContext` inside\nyour `tableComponents`). Optional: defaults to a shared module-scoped context.\nOnly pass your own (created via `createContext`) when you need to isolate this\ntable's context from other tables, e.g. when nesting one table inside another.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TTableComponents\n\n`TTableComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### TCellComponents\n\n`TCellComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n\n### THeaderComponents\n\n`THeaderComponents` *extends* `Record`\\<`string`, `ComponentType`\\<`any`\\>\\>\n"}
