,{"type":"inlineCode","value":"TSourceValue"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactNode"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReactNode"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"call-signature-3","children":[{"type":"text","value":"Call Signature"}]},{"type":"code","value":"<TSubSelected>(props): ReactNode | Promise<ReactNode>;","lang":"ts"},{"type":"heading","depth":5,"id":"type-parameters-4","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":6,"id":"tsubselected-2","children":[{"type":"text","value":"TSubSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSubSelected"}]},{"type":"heading","depth":5,"id":"parameters-4","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":6,"id":"props-4","children":[{"type":"text","value":"props"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Omit"},{"type":"text","value":"<"},{"type":"link","href":"SubscribePropsWithStore.md","children":[{"type":"inlineCode","value":"SubscribePropsWithStore"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TSubSelected"},{"type":"text","value":">, "},{"type":"inlineCode","value":"\"source\""},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"returns-4","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"ReactNode"},{"type":"text","value":" | "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"ReactNode"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"type-parameters-5","children":[{"type":"text","value":"Type Parameters"}]},{"type":"heading","depth":3,"id":"tfeatures","children":[{"type":"text","value":"TFeatures"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"TableFeatures"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":3,"id":"tselected","children":[{"type":"text","value":"TSelected"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TSelected"},{"type":"text","value":" = "},{"type":"inlineCode","value":"TableState"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":">"}]}],"headings":[{"id":"type-alias-reacttabletfeatures-tdata-tselected","text":"Type Alias: ReactTable<TFeatures, TData, TSelected>","level":1},{"id":"type-declaration","text":"Type Declaration","level":2},{"id":"flexrender","text":"FlexRender()","level":3},{"id":"type-parameters","text":"Type Parameters","level":4},{"id":"tvalue","text":"TValue","level":5},{"id":"parameters","text":"Parameters","level":4},{"id":"props","text":"props","level":5},{"id":"returns","text":"Returns","level":4},{"id":"example","text":"Example","level":4},{"id":"state","text":"state","level":3},{"id":"example-2","text":"Example","level":4},{"id":"store","text":"store","level":3},{"id":"deprecated","text":"Deprecated","level":4},{"id":"subscribe","text":"Subscribe()","level":3},{"id":"call-signature","text":"Call Signature","level":4},{"id":"type-parameters-2","text":"Type Parameters","level":5},{"id":"tsourcevalue","text":"TSourceValue","level":6},{"id":"parameters-2","text":"Parameters","level":5},{"id":"props-2","text":"props","level":6},{"id":"children","text":"children","level":6},{"id":"selector","text":"selector?","level":6},{"id":"source","text":"source","level":6},{"id":"returns-2","text":"Returns","level":5},{"id":"call-signature-2","text":"Call Signature","level":4},{"id":"type-parameters-3","text":"Type Parameters","level":5},{"id":"tsourcevalue-2","text":"TSourceValue","level":6},{"id":"tsubselected","text":"TSubSelected","level":6},{"id":"parameters-3","text":"Parameters","level":5},{"id":"props-3","text":"props","level":6},{"id":"children-2","text":"children","level":6},{"id":"selector-2","text":"selector","level":6},{"id":"source-2","text":"source","level":6},{"id":"returns-3","text":"Returns","level":5},{"id":"call-signature-3","text":"Call Signature","level":4},{"id":"type-parameters-4","text":"Type Parameters","level":5},{"id":"tsubselected-2","text":"TSubSelected","level":6},{"id":"parameters-4","text":"Parameters","level":5},{"id":"props-4","text":"props","level":6},{"id":"returns-4","text":"Returns","level":5},{"id":"type-parameters-5","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tselected","text":"TSelected","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Type Alias: ReactTable\\<TFeatures, TData, TSelected\\>\n\n```ts\ntype ReactTable<TFeatures, TData, TSelected> = Omit<Table<TFeatures, TData>, \"store\"> & object;\n```\n\nDefined in: [react-table/src/useTable.ts:29](https://github.com/TanStack/table/blob/main/packages/react-table/src/useTable.ts#L29)\n\n## Type Declaration\n\n### FlexRender()\n\n```ts\nFlexRender: <TValue>(props) => ReactNode;\n```\n\nA React component that renders headers, cells, or footers with custom markup.\nUse this utility component instead of manually calling flexRender.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `CellData` = `CellData`\n\n#### Parameters\n\n##### props\n\n[`FlexRenderProps`](FlexRenderProps.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n#### Returns\n\n`ReactNode`\n\n#### Example\n\n```tsx\n<table.FlexRender cell={cell} />\n<table.FlexRender header={header} />\n<table.FlexRender footer={footer} />\n```\n\nThis replaces calling `flexRender` directly like this:\n```tsx\nflexRender(cell.column.columnDef.cell, cell.getContext())\nflexRender(header.column.columnDef.header, header.getContext())\nflexRender(footer.column.columnDef.footer, footer.getContext())\n```\n\n### state\n\n```ts\nreadonly state: Readonly<TSelected>;\n```\n\nThe selected state of the table. This state may not match the structure of\nthe full table state because it is selected by the selector function that\nyou pass as the 2nd argument to `useTable`.\n\n#### Example\n\n```ts\nconst table = useTable(options, (state) => ({ globalFilter: state.globalFilter })) // only globalFilter is part of the selected state\n\nconsole.log(table.state.globalFilter)\n```\n\n### ~~store~~\n\n```ts\nreadonly store: Table<TFeatures, TData>[\"store\"];\n```\n\n#### Deprecated\n\nPrefer `table.state` for render reads,\n`table.atoms.<slice>.get()` for slice snapshots, or\n`table.Subscribe` / `useSelector(table.store, selector)` for explicit\nsubscriptions. `table.store.state` is a current-value snapshot and is easy\nto misuse in render code.\n\n### Subscribe()\n\n```ts\nSubscribe: {\n<TSourceValue>  (props): ReactNode | Promise<ReactNode>;\n<TSourceValue, TSubSelected>  (props): ReactNode | Promise<ReactNode>;\n<TSubSelected>  (props): ReactNode | Promise<ReactNode>;\n};\n```\n\nOverloads (not a single union) so `selector` callbacks get correct contextual\ntypes in JSX; a union of two `selector` signatures degrades to implicit `any`.\n\nSource **without** `selector` is a separate overload so children receive `TSourceValue`\n(identity projection). If `selector` were optional on one overload, `TSubSelected`\nwould default to `unknown` instead of inferring from the source.\n\nThe **source** overloads are listed first so `TSourceValue` is inferred from `source`.\n\n#### Call Signature\n\n```ts\n<TSourceValue>(props): ReactNode | Promise<ReactNode>;\n```\n\n##### Type Parameters\n\n###### TSourceValue\n\n`TSourceValue`\n\n##### Parameters\n\n###### props\n\n###### children\n\n(`state`) => `ReactNode` \\| `ReactNode`\n\n###### selector?\n\n`undefined`\n\n###### source\n\n[`SubscribeSource`](SubscribeSource.md)\\<`TSourceValue`\\>\n\n##### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n#### Call Signature\n\n```ts\n<TSourceValue, TSubSelected>(props): ReactNode | Promise<ReactNode>;\n```\n\n##### Type Parameters\n\n###### TSourceValue\n\n`TSourceValue`\n\n###### TSubSelected\n\n`TSubSelected`\n\n##### Parameters\n\n###### props\n\n###### children\n\n(`state`) => `ReactNode` \\| `ReactNode`\n\n###### selector\n\n(`state`) => `TSubSelected`\n\n###### source\n\n[`SubscribeSource`](SubscribeSource.md)\\<`TSourceValue`\\>\n\n##### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n#### Call Signature\n\n```ts\n<TSubSelected>(props): ReactNode | Promise<ReactNode>;\n```\n\n##### Type Parameters\n\n###### TSubSelected\n\n`TSubSelected`\n\n##### Parameters\n\n###### props\n\n`Omit`\\<[`SubscribePropsWithStore`](SubscribePropsWithStore.md)\\<`TFeatures`, `TSubSelected`\\>, `\"source\"`\\>\n\n##### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n","originalRawMarkdown":"---\nid: ReactTable\ntitle: ReactTable\n---\n\n# Type Alias: ReactTable\\<TFeatures, TData, TSelected\\>\n\n```ts\ntype ReactTable<TFeatures, TData, TSelected> = Omit<Table<TFeatures, TData>, \"store\"> & object;\n```\n\nDefined in: [react-table/src/useTable.ts:29](https://github.com/TanStack/table/blob/main/packages/react-table/src/useTable.ts#L29)\n\n## Type Declaration\n\n### FlexRender()\n\n```ts\nFlexRender: <TValue>(props) => ReactNode;\n```\n\nA React component that renders headers, cells, or footers with custom markup.\nUse this utility component instead of manually calling flexRender.\n\n#### Type Parameters\n\n##### TValue\n\n`TValue` *extends* `CellData` = `CellData`\n\n#### Parameters\n\n##### props\n\n[`FlexRenderProps`](FlexRenderProps.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n#### Returns\n\n`ReactNode`\n\n#### Example\n\n```tsx\n<table.FlexRender cell={cell} />\n<table.FlexRender header={header} />\n<table.FlexRender footer={footer} />\n```\n\nThis replaces calling `flexRender` directly like this:\n```tsx\nflexRender(cell.column.columnDef.cell, cell.getContext())\nflexRender(header.column.columnDef.header, header.getContext())\nflexRender(footer.column.columnDef.footer, footer.getContext())\n```\n\n### state\n\n```ts\nreadonly state: Readonly<TSelected>;\n```\n\nThe selected state of the table. This state may not match the structure of\nthe full table state because it is selected by the selector function that\nyou pass as the 2nd argument to `useTable`.\n\n#### Example\n\n```ts\nconst table = useTable(options, (state) => ({ globalFilter: state.globalFilter })) // only globalFilter is part of the selected state\n\nconsole.log(table.state.globalFilter)\n```\n\n### ~~store~~\n\n```ts\nreadonly store: Table<TFeatures, TData>[\"store\"];\n```\n\n#### Deprecated\n\nPrefer `table.state` for render reads,\n`table.atoms.<slice>.get()` for slice snapshots, or\n`table.Subscribe` / `useSelector(table.store, selector)` for explicit\nsubscriptions. `table.store.state` is a current-value snapshot and is easy\nto misuse in render code.\n\n### Subscribe()\n\n```ts\nSubscribe: {\n<TSourceValue>  (props): ReactNode | Promise<ReactNode>;\n<TSourceValue, TSubSelected>  (props): ReactNode | Promise<ReactNode>;\n<TSubSelected>  (props): ReactNode | Promise<ReactNode>;\n};\n```\n\nOverloads (not a single union) so `selector` callbacks get correct contextual\ntypes in JSX; a union of two `selector` signatures degrades to implicit `any`.\n\nSource **without** `selector` is a separate overload so children receive `TSourceValue`\n(identity projection). If `selector` were optional on one overload, `TSubSelected`\nwould default to `unknown` instead of inferring from the source.\n\nThe **source** overloads are listed first so `TSourceValue` is inferred from `source`.\n\n#### Call Signature\n\n```ts\n<TSourceValue>(props): ReactNode | Promise<ReactNode>;\n```\n\n##### Type Parameters\n\n###### TSourceValue\n\n`TSourceValue`\n\n##### Parameters\n\n###### props\n\n###### children\n\n(`state`) => `ReactNode` \\| `ReactNode`\n\n###### selector?\n\n`undefined`\n\n###### source\n\n[`SubscribeSource`](SubscribeSource.md)\\<`TSourceValue`\\>\n\n##### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n#### Call Signature\n\n```ts\n<TSourceValue, TSubSelected>(props): ReactNode | Promise<ReactNode>;\n```\n\n##### Type Parameters\n\n###### TSourceValue\n\n`TSourceValue`\n\n###### TSubSelected\n\n`TSubSelected`\n\n##### Parameters\n\n###### props\n\n###### children\n\n(`state`) => `ReactNode` \\| `ReactNode`\n\n###### selector\n\n(`state`) => `TSubSelected`\n\n###### source\n\n[`SubscribeSource`](SubscribeSource.md)\\<`TSourceValue`\\>\n\n##### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n#### Call Signature\n\n```ts\n<TSubSelected>(props): ReactNode | Promise<ReactNode>;\n```\n\n##### Type Parameters\n\n###### TSubSelected\n\n`TSubSelected`\n\n##### Parameters\n\n###### props\n\n`Omit`\\<[`SubscribePropsWithStore`](SubscribePropsWithStore.md)\\<`TFeatures`, `TSubSelected`\\>, `\"source\"`\\>\n\n##### Returns\n\n`ReactNode` \\| `Promise`\\<`ReactNode`\\>\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n### TSelected\n\n`TSelected` = `TableState`\\<`TFeatures`\\>\n"}
