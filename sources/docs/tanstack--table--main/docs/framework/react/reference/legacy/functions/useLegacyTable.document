ode","value":"getState()"},{"type":"text","value":" method"}]},{"type":"heading","depth":2,"id":"deprecated","children":[{"type":"text","value":"Deprecated"}]},{"type":"paragraph","children":[{"type":"text","value":"This hook is provided as a compatibility layer for migrating from TanStack Table v8."}]},{"type":"paragraph","children":[{"type":"text","value":"Use the new "},{"type":"inlineCode","value":"useTable"},{"type":"text","value":" hook instead with an explicit "},{"type":"inlineCode","value":"features"},{"type":"text","value":" option:"}]},{"type":"code","value":"// New v9 API\nconst features = tableFeatures({\n  columnFilteringFeature,\n  rowSortingFeature,\n  rowPaginationFeature,\n  filteredRowModel: createFilteredRowModel(),\n  sortedRowModel: createSortedRowModel(),\n  paginatedRowModel: createPaginatedRowModel(),\n  filterFns,\n  sortFns,\n})\n\nconst table = useTable({\n  features,\n  columns,\n  data,\n})","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Key differences from v8:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Features are tree-shakeable - only import what you use"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Row models and fn registries are explicitly passed on the "},{"type":"inlineCode","value":"features"},{"type":"text","value":" option"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"table.Subscribe"},{"type":"text","value":" for fine-grained re-renders"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"State is accessed via "},{"type":"inlineCode","value":"table.state"},{"type":"text","value":" after selecting with the 2nd argument"}]}]}]}],"headings":[{"id":"function-uselegacytable","text":"Function: useLegacyTable()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"options","text":"options","level":3},{"id":"returns","text":"Returns","level":2},{"id":"deprecated","text":"Deprecated","level":2}]},"frameworks":[],"downloadMarkdown":"\n# ~~Function: useLegacyTable()~~\n\n```ts\nfunction useLegacyTable<TData>(options): LegacyReactTable<TData>;\n```\n\nDefined in: [react-table/src/useLegacyTable.ts:405](https://github.com/TanStack/table/blob/main/packages/react-table/src/useLegacyTable.ts#L405)\n\n## Type Parameters\n\n### TData\n\n`TData` *extends* `RowData`\n\n## Parameters\n\n### options\n\n[`LegacyTableOptions`](../type-aliases/LegacyTableOptions.md)\\<`TData`\\>\n\nLegacy v8-style table options\n\n## Returns\n\n[`LegacyReactTable`](../type-aliases/LegacyReactTable.md)\\<`TData`\\>\n\nA table instance with the full state subscribed and a `getState()` method\n\n## Deprecated\n\nThis hook is provided as a compatibility layer for migrating from TanStack Table v8.\n\nUse the new `useTable` hook instead with an explicit `features` option:\n\n```tsx\n// New v9 API\nconst features = tableFeatures({\n  columnFilteringFeature,\n  rowSortingFeature,\n  rowPaginationFeature,\n  filteredRowModel: createFilteredRowModel(),\n  sortedRowModel: createSortedRowModel(),\n  paginatedRowModel: createPaginatedRowModel(),\n  filterFns,\n  sortFns,\n})\n\nconst table = useTable({\n  features,\n  columns,\n  data,\n})\n```\n\nKey differences from v8:\n- Features are tree-shakeable - only import what you use\n- Row models and fn registries are explicitly passed on the `features` option\n- Use `table.Subscribe` for fine-grained re-renders\n- State is accessed via `table.state` after selecting with the 2nd argument\n","originalRawMarkdown":"---\nid: useLegacyTable\ntitle: useLegacyTable\n---\n\n# ~~Function: useLegacyTable()~~\n\n```ts\nfunction useLegacyTable<TData>(options): LegacyReactTable<TData>;\n```\n\nDefined in: [react-table/src/useLegacyTable.ts:405](https://github.com/TanStack/table/blob/main/packages/react-table/src/useLegacyTable.ts#L405)\n\n## Type Parameters\n\n### TData\n\n`TData` *extends* `RowData`\n\n## Parameters\n\n### options\n\n[`LegacyTableOptions`](../type-aliases/LegacyTableOptions.md)\\<`TData`\\>\n\nLegacy v8-style table options\n\n## Returns\n\n[`LegacyReactTable`](../type-aliases/LegacyReactTable.md)\\<`TData`\\>\n\nA table instance with the full state subscribed and a `getState()` method\n\n## Deprecated\n\nThis hook is provided as a compatibility layer for migrating from TanStack Table v8.\n\nUse the new `useTable` hook instead with an explicit `features` option:\n\n```tsx\n// New v9 API\nconst features = tableFeatures({\n  columnFilteringFeature,\n  rowSortingFeature,\n  rowPaginationFeature,\n  filteredRowModel: createFilteredRowModel(),\n  sortedRowModel: createSortedRowModel(),\n  paginatedRowModel: createPaginatedRowModel(),\n  filterFns,\n  sortFns,\n})\n\nconst table = useTable({\n  features,\n  columns,\n  data,\n})\n```\n\nKey differences from v8:\n- Features are tree-shakeable - only import what you use\n- Row models and fn registries are explicitly passed on the `features` option\n- Use `table.Subscribe` for fine-grained re-renders\n- State is accessed via `table.state` after selecting with the 2nd argument\n"}
