ableFeatures"}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"RowData"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"tableoptions","children":[{"type":"text","value":"tableOptions"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TableOptions"},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/SvelteTable.md","children":[{"type":"inlineCode","value":"SvelteTable"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<script lang=\"ts\">\n  const table = createTable({\n    features,\n    columns,\n    get data() {\n      return data\n    },\n  })\n\n  const pagination = $derived(table.atoms.pagination.get())\n  const stateJson = $derived(JSON.stringify(table.store.get(), null, 2))\n</script>\n\n<span>Page {pagination.pageIndex + 1}</span>\n<pre>{stateJson}</pre>","lang":"svelte"}],"headings":[{"id":"function-createtable","text":"Function: createTable()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"tableoptions","text":"tableOptions","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: createTable()\n\n```ts\nfunction createTable<TFeatures, TData>(tableOptions): SvelteTable<TFeatures, TData>;\n```\n\nDefined in: [packages/svelte-table/src/createTable.svelte.ts:52](https://github.com/TanStack/table/blob/main/packages/svelte-table/src/createTable.svelte.ts#L52)\n\nCreates a Svelte 5 table instance backed by rune-aware TanStack Store atoms.\n\nRead a specific state slice with `table.atoms.<slice>.get()` and read the\ncomplete state with `table.store.get()`. Those reads participate in Svelte\ndependency tracking when they run in a template, `$derived`, or `$effect`.\nThe adapter syncs options in `$effect.pre`, so reactive option getters and\nexternal `$state` values are applied before DOM updates read table APIs such\nas `getRowModel()`.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n## Parameters\n\n### tableOptions\n\n`TableOptions`\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`SvelteTable`](../type-aliases/SvelteTable.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```svelte\n<script lang=\"ts\">\n  const table = createTable({\n    features,\n    columns,\n    get data() {\n      return data\n    },\n  })\n\n  const pagination = $derived(table.atoms.pagination.get())\n  const stateJson = $derived(JSON.stringify(table.store.get(), null, 2))\n</script>\n\n<span>Page {pagination.pageIndex + 1}</span>\n<pre>{stateJson}</pre>\n```\n","originalRawMarkdown":"---\nid: createTable\ntitle: createTable\n---\n\n# Function: createTable()\n\n```ts\nfunction createTable<TFeatures, TData>(tableOptions): SvelteTable<TFeatures, TData>;\n```\n\nDefined in: [packages/svelte-table/src/createTable.svelte.ts:52](https://github.com/TanStack/table/blob/main/packages/svelte-table/src/createTable.svelte.ts#L52)\n\nCreates a Svelte 5 table instance backed by rune-aware TanStack Store atoms.\n\nRead a specific state slice with `table.atoms.<slice>.get()` and read the\ncomplete state with `table.store.get()`. Those reads participate in Svelte\ndependency tracking when they run in a template, `$derived`, or `$effect`.\nThe adapter syncs options in `$effect.pre`, so reactive option getters and\nexternal `$state` values are applied before DOM updates read table APIs such\nas `getRowModel()`.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* `TableFeatures`\n\n### TData\n\n`TData` *extends* `RowData`\n\n## Parameters\n\n### tableOptions\n\n`TableOptions`\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`SvelteTable`](../type-aliases/SvelteTable.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```svelte\n<script lang=\"ts\">\n  const table = createTable({\n    features,\n    columns,\n    get data() {\n      return data\n    },\n  })\n\n  const pagination = $derived(table.atoms.pagination.get())\n  const stateJson = $derived(JSON.stringify(table.store.get(), null, 2))\n</script>\n\n<span>Page {pagination.pageIndex + 1}</span>\n<pre>{stateJson}</pre>\n```\n"}
