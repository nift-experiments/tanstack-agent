ach "},{"type":"inlineCode","value":"cell.id"},{"type":"text","value":" is constructed simply as a union of its parent row and column IDs separated by an underscore."}]},{"type":"code","value":"{\n  id: `${row.id}_${column.id}`\n}","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"During grouping or aggregation features, the "},{"type":"inlineCode","value":"cell.id"},{"type":"text","value":" will have an additional string appended to it."}]},{"type":"heading","depth":3,"id":"cell-parent-objects","children":[{"type":"text","value":"Cell Parent Objects"}]},{"type":"paragraph","children":[{"type":"text","value":"Every cell stores a reference to its parent "},{"type":"link","href":"./rows","children":[{"type":"text","value":"row"}]},{"type":"text","value":" and "},{"type":"link","href":"./columns","children":[{"type":"text","value":"column"}]},{"type":"text","value":" objects."}]},{"type":"heading","depth":3,"id":"access-cell-values","children":[{"type":"text","value":"Access Cell Values"}]},{"type":"paragraph","children":[{"type":"text","value":"The recommended way to access data values from a cell is to use either the "},{"type":"inlineCode","value":"cell.getValue"},{"type":"text","value":" or "},{"type":"inlineCode","value":"cell.renderValue"},{"type":"text","value":" APIs. Using either of these APIs will cache the results of the accessor functions and keep rendering efficient. The only difference between the two is that "},{"type":"inlineCode","value":"cell.renderValue"},{"type":"text","value":" will return either the value or the "},{"type":"inlineCode","value":"renderFallbackValue"},{"type":"text","value":" if the value is undefined, whereas "},{"type":"inlineCode","value":"cell.getValue"},{"type":"text","value":" will return the value or "},{"type":"inlineCode","value":"undefined"},{"type":"text","value":" if the value is undefined."}]},{"type":"callout","kind":"note","title":"Note","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"cell.getValue"},{"type":"text","value":" and "},{"type":"inlineCode","value":"cell.renderValue"},{"type":"text","value":" APIs are shortcuts for the "},{"type":"inlineCode","value":"row.getValue"},{"type":"text","value":" and "},{"type":"inlineCode","value":"row.renderValue"},{"type":"text","value":" APIs, respectively."}]}]},{"type":"code","value":"// Access the value for this cell's own column\nconst value = cell.getValue() // read the cell value\nconst renderedValue = cell.renderValue() // read the cell value, falling back to `renderFallbackValue`","lang":"js"},{"type":"paragraph","children":[{"type":"text","value":"These APIs take no arguments. They are bound to the cell's own column. If you need to read a different column's value from within a cell, use the parent row instead, e.g. "},{"type":"inlineCode","value":"cell.row.getValue('someColumnId')"},{"type":"text","value":"."}]},{"type":"heading","depth":3,"id":"access-other-row-data-from-any-cell","children":[{"type":"text","value":"Access Other Row Data from Any Cell"}]},{"type":"paragraph","children":[{"type":"text","value":"Since every cell object is associated with its parent row, you can access any data from the original row that you are using in your table using "},{"type":"inlineCode","value":"cell.row.original"},{"type":"text","value":"."}]},{"type":"code","value":"// Even if we are in the scope of a different cell, we can still access the original row data\nconst firstName = cell.row.original.firstName // { firstName: 'John', lastName: 'Doe' }","lang":"js"},{"type":"heading","depth":2,"id":"more-cell-apis","children":[{"type":"text","value":"More Cell APIs"}]},{"type":"paragraph","children":[{"type":"text","value":"Depending on the features that you are using for your table, there are dozens more useful APIs for interacting with cells. See each feature's respective API docs or guide for more information."}]},{"type":"heading","depth":2,"id":"cell-rendering","children":[{"type":"text","value":"Cell Rendering"}]},{"type":"paragraph","children":[{"type":"text","value":"You can just use the "},{"type":"inlineCode","value":"cell.renderValue"},{"type":"text","value":" or "},{"type":"inlineCode","value":"cell.getValue"},{"type":"text","value":" APIs to render the cells of your table. However, these APIs will only spit out the raw cell values (from accessor functions). If you are using the "},{"type":"inlineCode","value":"cell: () => JSX"},{"type":"text","value":" column definition options, you will want to use the "},{"type":"inlineCode","value":"flexRender"},{"type":"text","value":" API utility from your adapter."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"flexRender"},{"type":"text","value":" API renders the cell correctly with any extra markup or JSX and calls the callback function with the correct parameters."}]},{"type":"code","value":"import { flexRender } from '@tanstack/react-table'\n\nconst columns = [\n  {\n    accessorKey: 'fullName',\n    cell: ({ cell, row }) => {\n      return <div><strong>{row.original.firstName}</strong> {row.original.lastName}</div>\n    }\n    //...\n  }\n]\n//...\n<tr>\n  {row.getVisibleCells().map(cell => {\n    return <td key={cell.id}>{flexRender(cell.column.columnDef.cell, cell.getContext())}</td>\n  })}\n</tr>","lang":"jsx"},{"type":"heading","depth":3,"id":"cell-spanning","children":[{"type":"text","value":"Cell Spanning"}]},{"type":"paragraph","children":[{"type":"text","value":"When the optional "},{"type":"inlineCode","value":"cellSpanningFeature"},{"type":"text","value":" is registered, adjacent cells can merge into one rendered cell. A cell reporting a span of "},{"type":"inlineCode","value":"0"},{"type":"text","value":" is covered by another cell's span and must be skipped instead of rendered. See the "},{"type":"link","href":"../framework/react/guide/cell-spanning","children":[{"type":"text","value":"Cell Spanning Guide"}]},{"type":"text","value":" for the full rendering pattern."}]}],"headings":[{"id":"where-to-get-cells-from","text":"Where to Get Cells From","level":2},{"id":"cell-objects","text":"Cell Objects","level":2},{"id":"cell-ids","text":"Cell IDs","level":3},{"id":"cell-parent-objects","text":"Cell Parent Objects","level":3},{"id":"access-cell-values","text":"Access Cell Values","level":3},{"id":"access-other-row-data-from-any-cell","text":"Access Other Row Data from Any Cell","level":3},{"id":"more-cell-apis","text":"More Cell APIs","level":2},{"id":"cell-rendering","text":"Cell Rendering","level":2},{"id":"cell-spanning","text":"Cell Spanning","level":3}]},"frameworks":[],"downloadMarkdown":"\nThis quick guide will discuss the different ways you can retrieve and interact with `cell` objects in TanStack Table.\n\n## Where to Get Cells From\n\nCells come from [Rows](./rows). Enough said, right?\n\nThere are multiple `row` instance APIs you can use to retrieve the appropriate cells from a row depending on which features you are using. Most commonly, you will use the `row.getAllCells` or `row.getVisibleCells` APIs (if you are using column visibility features), but there are a handful of other similar APIs that you can use.\n\n## Cell Objects\n\nEvery cell object can be associated with a `<td>` or similar cell element in your UI. There are a few properties and methods on `cell` objects that you can use to interact with the table state and extract cell values from the table based on the state of the table.\n\n### Cell IDs\n\nEvery cell object has an `id` property that makes it unique within the table instance. Each `cell.id` is constructed simply as a union of its parent row and column IDs separated by an underscore.\n\n```js\n{\n  id: `${row.id}_${column.id}`\n}\n```\n\nDuring grouping or aggregation features, the `cell.id` will have an additional string appended to it.\n\n### Cell Parent Objects\n\nEvery cell stores a reference to its parent [row](./rows) and [column](./columns) objects.\n\n### Access Cell Values\n\nThe recommended way to access data values from a cell is to use either the `cell.getValue` or `cell.renderValue` APIs. Using either of these APIs will cache the results of the accessor functions and keep rendering efficient. The only difference between the two is that `cell.renderValue` will return either the value or the `renderFallbackValue` if the value is undefined, whereas `cell.getValue` will return the value or `undefined` if the value is undefined.\n\n> [!NOTE]\n> The `cell.getValue` and `cell.renderValue` APIs are shortcuts for the `row.getValue` and `row.renderValue` APIs, respectively.\n\n```js\n// Access the value for this cell's own column\nconst value = cell.getValue() // read the cell value\nconst renderedValue = cell.renderValue() // read the cell value, falling back to `renderFallbackValue`\n```\n\nThese APIs take no arguments. They are bound to the cell's own column. If you need to read a different column's value from within a cell, use the parent row instead, e.g. `cell.row.getValue('someColumnId')`.\n\n### Access Other Row Data from Any Cell\n\nSince every cell object is associated with its parent row, you can access any data from the original row that you are using in your table using `cell.row.original`.\n\n```js\n// Even if we are in the scope of a different cell, we can still access the original row data\nconst firstName = cell.row.original.firstName // { firstName: 'John', lastName: 'Doe' }\n```\n\n## More Cell APIs\n\nDepending on the features that you are using for your table, there are dozens more useful APIs for interacting with cells. See each feature's respective API docs or guide for more information.\n\n## Cell Rendering\n\nYou can just use the `cell.renderValue` or `cell.getValue` APIs to render the cells of your table. However, these APIs will only spit out the raw cell values (from accessor functions). If you are using the `cell: () => JSX` column definition options, you will want to use the `flexRender` API utility from your adapter.\n\nThe `flexRender` API renders the cell correctly with any extra markup or JSX and calls the callback function with the correct parameters.\n\n```jsx\nimport { flexRender } from '@tanstack/react-table'\n\nconst columns = [\n  {\n    accessorKey: 'fullName',\n    cell: ({ cell, row }) => {\n      return <div><strong>{row.original.firstName}</strong> {row.original.lastName}</div>\n    }\n    //...\n  }\n]\n//...\n<tr>\n  {row.getVisibleCells().map(cell => {\n    return <td key={cell.id}>{flexRender(cell.column.columnDef.cell, cell.getContext())}</td>\n  })}\n</tr>\n```\n\n### Cell Spanning\n\nWhen the optional `cellSpanningFeature` is registered, adjacent cells can merge into one rendered cell. A cell reporting a span of `0` is covered by another cell's span and must be skipped instead of rendered. See the [Cell Spanning Guide](../framework/react/guide/cell-spanning) for the full rendering pattern.\n","originalRawMarkdown":"---\ntitle: Cells Guide\n---\n\nThis quick guide will discuss the different ways you can retrieve and interact with `cell` objects in TanStack Table.\n\n## Where to Get Cells From\n\nCells come from [Rows](./rows). Enough said, right?\n\nThere are multiple `row` instance APIs you can use to retrieve the appropriate cells from a row depending on which features you are using. Most commonly, you will use the `row.getAllCells` or `row.getVisibleCells` APIs (if you are using column visibility features), but there are a handful of other similar APIs that you can use.\n\n## Cell Objects\n\nEvery cell object can be associated with a `<td>` or similar cell element in your UI. There are a few properties and methods on `cell` objects that you can use to interact with the table state and extract cell values from the table based on the state of the table.\n\n### Cell IDs\n\nEvery cell object has an `id` property that makes it unique within the table instance. Each `cell.id` is constructed simply as a union of its parent row and column IDs separated by an underscore.\n\n```js\n{\n  id: `${row.id}_${column.id}`\n}\n```\n\nDuring grouping or aggregation features, the `cell.id` will have an additional string appended to it.\n\n### Cell Parent Objects\n\nEvery cell stores a reference to its parent [row](./rows) and [column](./columns) objects.\n\n### Access Cell Values\n\nThe recommended way to access data values from a cell is to use either the `cell.getValue` or `cell.renderValue` APIs. Using either of these APIs will cache the results of the accessor functions and keep rendering efficient. The only difference between the two is that `cell.renderValue` will return either the value or the `renderFallbackValue` if the value is undefined, whereas `cell.getValue` will return the value or `undefined` if the value is undefined.\n\n> [!NOTE]\n> The `cell.getValue` and `cell.renderValue` APIs are shortcuts for the `row.getValue` and `row.renderValue` APIs, respectively.\n\n```js\n// Access the value for this cell's own column\nconst value = cell.getValue() // read the cell value\nconst renderedValue = cell.renderValue() // read the cell value, falling back to `renderFallbackValue`\n```\n\nThese APIs take no arguments. They are bound to the cell's own column. If you need to read a different column's value from within a cell, use the parent row instead, e.g. `cell.row.getValue('someColumnId')`.\n\n### Access Other Row Data from Any Cell\n\nSince every cell object is associated with its parent row, you can access any data from the original row that you are using in your table using `cell.row.original`.\n\n```js\n// Even if we are in the scope of a different cell, we can still access the original row data\nconst firstName = cell.row.original.firstName // { firstName: 'John', lastName: 'Doe' }\n```\n\n## More Cell APIs\n\nDepending on the features that you are using for your table, there are dozens more useful APIs for interacting with cells. See each feature's respective API docs or guide for more information.\n\n## Cell Rendering\n\nYou can just use the `cell.renderValue` or `cell.getValue` APIs to render the cells of your table. However, these APIs will only spit out the raw cell values (from accessor functions). If you are using the `cell: () => JSX` column definition options, you will want to use the `flexRender` API utility from your adapter.\n\nThe `flexRender` API renders the cell correctly with any extra markup or JSX and calls the callback function with the correct parameters.\n\n```jsx\nimport { flexRender } from '@tanstack/react-table'\n\nconst columns = [\n  {\n    accessorKey: 'fullName',\n    cell: ({ cell, row }) => {\n      return <div><strong>{row.original.firstName}</strong> {row.original.lastName}</div>\n    }\n    //...\n  }\n]\n//...\n<tr>\n  {row.getVisibleCells().map(cell => {\n    return <td key={cell.id}>{flexRender(cell.column.columnDef.cell, cell.getContext())}</td>\n  })}\n</tr>\n```\n\n### Cell Spanning\n\nWhen the optional `cellSpanningFeature` is registered, adjacent cells can merge into one rendered cell. A cell reporting a span of `0` is covered by another cell's span and must be skipped instead of rendered. See the [Cell Spanning Guide](../framework/react/guide/cell-spanning) for the full rendering pattern.\n"}
