{"document":{"type":"root","children":[{"type":"callout","kind":"note","title":"Note","children":[{"type":"paragraph","children":[{"type":"text","value":"If you are upgrading from TanStack Table v8, start with the migration guide for your framework:"}]}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/migrating","children":[{"type":"text","value":"Migrating to v9"}]}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"preact"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/preact/guide/migrating","children":[{"type":"text","value":"Migrating to v9"}]}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"octane"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Octane support is new in v9, so there is nothing to migrate. Start with the "},{"type":"link","href":"./framework/octane/quick-start","children":[{"type":"text","value":"Octane Quick Start"}]},{"type":"text","value":"."}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/solid/guide/migrating","children":[{"type":"text","value":"Migrating to v9"}]}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"svelte"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/svelte/guide/migrating","children":[{"type":"text","value":"Migrating to v9"}]}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"vue"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/vue/guide/migrating","children":[{"type":"text","value":"Migrating to v9"}]}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"angular"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/angular/guide/migrating","children":[{"type":"text","value":"Migrating to v9"}]}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"ember"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Ember support is new in v9, so there is nothing to migrate. Start with the "},{"type":"link","href":"./framework/ember/quick-start","children":[{"type":"text","value":"Quick Start"}]},{"type":"text","value":"."}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"lit"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/lit/guide/migrating","children":[{"type":"text","value":"Migrating to v9"}]}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"alpine"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Alpine support is new in v9, so there is nothing to migrate. Start with the "},{"type":"link","href":"./framework/alpine/quick-start","children":[{"type":"text","value":"Quick Start"}]},{"type":"text","value":"."}]}]}]}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"vanilla"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The vanilla "},{"type":"inlineCode","value":"@tanstack/table-core"},{"type":"text","value":" entry point changed in v9. See the "},{"type":"link","href":"./framework/vanilla/quick-start","children":[{"type":"text","value":"Vanilla Quick Start"}]},{"type":"text","value":" page for the new setup."}]}]}]}]}],"properties":{"data-available-frameworks":"[\"react\",\"preact\",\"octane\",\"solid\",\"svelte\",\"vue\",\"angular\",\"ember\",\"lit\",\"alpine\",\"vanilla\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[],\"preact\":[],\"octane\":[],\"solid\":[],\"svelte\":[],\"vue\":[],\"angular\":[],\"ember\":[],\"lit\":[],\"alpine\":[],\"vanilla\":[]}}"}},{"type":"paragraph","children":[{"type":"text","value":"TanStack Table is the best way to build your own powerful table and datagrid components with "},{"type":"emphasis","children":[{"type":"text","value":"blazingly fast"}]},{"type":"text","value":" performance, but most importantly, with "},{"type":"strong","children":[{"type":"text","value":"100% control over your own design and markup."}]}]},{"type":"paragraph","children":[{"type":"text","value":"In this new age of AI, where markup can be generated in seconds, the old value proposition of pre-built components (saving you the typing) matters less than ever. What matters now is owning and controlling the result, and that is exactly what TanStack Table gives you."}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Table might be a bit of a different table library than you are used to. It is "},{"type":"strong","children":[{"type":"emphasis","children":[{"type":"text","value":"NOT"}]}]},{"type":"text","value":" a pre-built table component, like you might find from a library like "},{"type":"link","href":"https://ag-grid.com?utm_source=reacttable&utm_campaign=githubreacttable","children":[{"type":"text","value":"AG Grid"}]},{"type":"text","value":". Instead, TanStack Table is a headless UI library that gives you the power to build your own fully customizable table and datagrid components the right way with whatever JavaScript libraries, component libraries, or design systems you want. TanStack Table is the "},{"type":"emphasis","children":[{"type":"text","value":"engine"}]},{"type":"text","value":" that you can hook up to your own favorite front-end tech, no matter what you're already using or want to use."}]},{"type":"paragraph","children":[{"type":"text","value":"At its core, TanStack Table is "},{"type":"strong","children":[{"type":"text","value":"agnostic"}]},{"type":"text","value":". Most table data-processing and state logic is written in framework-agnostic TypeScript, and framework adapters connect that core to your favorite frameworks. Official adapters are provided for React, Preact, Octane, Vue, Solid, Svelte, Angular, Ember, Lit, and Alpine, or you can use the core directly in vanilla JavaScript via "},{"type":"inlineCode","value":"@tanstack/table-core"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"It also "},{"type":"strong","children":[{"type":"text","value":"does not care which CSS or component library"}]},{"type":"text","value":" you use, and is compatible with anything from Tailwind, Bootstrap, Material UI, ShadCN UI, or even your own custom design system."}]},{"type":"heading","depth":2,"id":"what-is-headless-ui","children":[{"type":"text","value":"What is \"Headless\" UI?"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Headless UI"}]},{"type":"text","value":" is a term for libraries and utilities that provide the logic, state, processing, and APIs for UI elements and interactions, but "},{"type":"strong","children":[{"type":"text","value":"do not provide markup, styles, or pre-built implementations"}]},{"type":"text","value":". The hardest parts of building complex UIs usually revolve around state, events, side effects, and data processing. By removing those concerns from the markup and styles, your logic becomes more modular and reusable, while you keep complete control over the look and feel. When you use a headless library like TanStack Table, the complex work of data processing, state management, and business logic is handled for you, so you can focus on the higher-cardinality decisions that differ across designs and use cases."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Want to dive deeper? "},{"type":"link","href":"https://www.merrickchristensen.com/articles/headless-user-interface-components/","children":[{"type":"text","value":"Read more about Headless UI"}]},{"type":"text","value":"."}]}]},{"type":"paragraph","children":[{"type":"text","value":"Here's the difference in practice. With a pre-built table component, you pass props in and style the result from the outside, limited to whatever the component's props and theme APIs allow. With TanStack Table, you create a table instance and use its state and APIs to render your own markup:"}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"code","value":"- {/* Pass props into a pre-built component and hope you can style it */}\n- <PrebuiltDataGrid\n-   data={data}\n-   columns={columns}\n-   theme={messyThemeOverrides}\n-   sx={cssOverridesThatHopefullyWork}\n-   positionPagination={\"however-my-stakeholders-are-feeling-today\"}\n- />\n+ // Build your own markup from the table instance's state and APIs\n+ const table = useTable({ features, columns, data })\n+\n+ return (\n+   <table className=\"anything-you-want\">\n+     <thead>\n+       {/* need to really customize the functionality in your headers? no problem! */}\n+       {table.getHeaderGroups().map((headerGroup) => ( ... ))}\n+     </thead>\n+     <tbody>\n+       {/* want to add virtualization here? no problem! */}\n+       {table.getRowModel().rows.map((row) => ( ... ))}\n+     </tbody>\n+   </table>\n+ )","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"preact"},"children":[{"type":"code","value":"- {/* Pass props into a pre-built component and hope you can style it */}\n- <PrebuiltDataGrid\n-   data={data}\n-   columns={columns}\n-   theme={messyThemeOverrides}\n-   sx={cssOverridesThatHopefullyWork}\n-   positionPagination={\"however-my-stakeholders-are-feeling-today\"}\n- />\n+ // Build your own markup from the table instance's state and APIs\n+ const table = useTable({ features, columns, data })\n+\n+ return (\n+   <table className=\"anything-you-want\">\n+     <thead>\n+       {/* need to really customize the functionality in your headers? no problem! */}\n+       {table.getHeaderGroups().map((headerGroup) => ( ... ))}\n+     </thead>\n+     <tbody>\n+       {/* want to add virtualization here? no problem! */}\n+       {table.getRowModel().rows.map((row) => ( ... ))}\n+     </tbody>\n+   </table>\n+ )","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"octane"},"children":[{"type":"code","value":"- {/* Pass props into a pre-built component and hope you can style it */}\n- <PrebuiltDataGrid\n-   data={data}\n-   columns={columns}\n-   theme={messyThemeOverrides}\n-   sx={cssOverridesThatHopefullyWork}\n-   positionPagination={\"however-my-stakeholders-are-feeling-today\"}\n- />\n+ // Build your own markup from the table instance's state and APIs\n+ const table = useTable({ features, columns, data })\n+\n+ <table className=\"anything-you-want\">\n+   <thead>\n+     {/* need to really customize the functionality in your headers? no problem! */}\n+     @for (const headerGroup of table.getHeaderGroups(); key headerGroup.id) { ... }\n+   </thead>\n+   <tbody>\n+     @for (const row of table.getRowModel().rows; key row.id) { ... }\n+   </tbody>\n+ </table>","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"solid"},"children":[{"type":"code","value":"- {/* Pass props into a pre-built component and hope you can style it */}\n- <PrebuiltDataGrid\n-   data={data()}\n-   columns={columns}\n-   theme={messyThemeOverrides}\n-   sx={cssOverridesThatHopefullyWork}\n-   positionPagination={\"however-my-stakeholders-are-feeling-today\"}\n- />\n+ // Build your own markup from the table instance's state and APIs\n+ const table = createTable({ features, columns, get data() { return data() } })\n+\n+ return (\n+   <table class=\"anything-you-want\">\n+     <thead>\n+       {/* need to really customize the functionality in your headers? no problem! */}\n+       <For each={table.getHeaderGroups()}>{(headerGroup) => ( ... )}</For>\n+     </thead>\n+     <tbody>\n+       {/* want to add virtualization here? no problem! */}\n+       <For each={table.getRowModel().rows}>{(row) => ( ... )}</For>\n+     </tbody>\n+   </table>\n+ )","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"svelte"},"children":[{"type":"code","value":"- <!-- Pass props into a pre-built component and hope you can style it -->\n- <PrebuiltDataGrid\n-   {data}\n-   {columns}\n-   theme={messyThemeOverrides}\n-   sx={cssOverridesThatHopefullyWork}\n-   positionPagination=\"however-my-stakeholders-are-feeling-today\"\n- />\n+ <!-- Build your own markup from the table instance's state and APIs -->\n+ <script>\n+   const table = createTable({ features, columns, get data() { return data } })\n+ </script>\n+\n+ <table class=\"anything-you-want\">\n+   <thead>\n+     <!-- need to really customize the functionality in your headers? no problem! -->\n+     {#each table.getHeaderGroups() as headerGroup} ... {/each}\n+   </thead>\n+   <tbody>\n+     <!-- want to add virtualization here? no problem! -->\n+     {#each table.getRowModel().rows as row} ... {/each}\n+   </tbody>\n+ </table>","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"vue"},"children":[{"type":"code","value":"- <!-- Pass props into a pre-built component and hope you can style it -->\n- <PrebuiltDataGrid\n-   :data=\"data\"\n-   :columns=\"columns\"\n-   :theme=\"messyThemeOverrides\"\n-   :sx=\"cssOverridesThatHopefullyWork\"\n-   position-pagination=\"however-my-stakeholders-are-feeling-today\"\n- />\n+ <!-- Build your own markup from the table instance's state and APIs -->\n+ <script setup>\n+ const table = useTable({ features, columns, data })\n+ </script>\n+\n+ <template>\n+   <table class=\"anything-you-want\">\n+     <thead>\n+       <!-- need to really customize the functionality in your headers? no problem! -->\n+       <tr v-for=\"headerGroup in table.getHeaderGroups()\" :key=\"headerGroup.id\">...</tr>\n+     </thead>\n+     <tbody>\n+       <!-- want to add virtualization here? no problem! -->\n+       <tr v-for=\"row in table.getRowModel().rows\" :key=\"row.id\">...</tr>\n+     </tbody>\n+   </table>\n+ </template>","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"angular"},"children":[{"type":"code","value":"- <!-- Pass props into a pre-built component and hope you can style it -->\n- <prebuilt-data-grid\n-   [data]=\"data\"\n-   [columns]=\"columns\"\n-   [theme]=\"messyThemeOverrides\"\n-   [styleOverrides]=\"cssOverridesThatHopefullyWork\"\n-   positionPagination=\"however-my-stakeholders-are-feeling-today\"\n- />\n+ // Build your own markup from the table instance's state and APIs\n+ readonly table = injectTable(() => ({ features, columns, data: this.data() }))\n+\n+ <!-- in your component template -->\n+ <table class=\"anything-you-want\">\n+   <thead>\n+     <!-- need to really customize the functionality in your headers? no problem! -->\n+     @for (headerGroup of table.getHeaderGroups(); track headerGroup.id) { ... }\n+   </thead>\n+   <tbody>\n+     <!-- want to add virtualization here? no problem! -->\n+     @for (row of table.getRowModel().rows; track row.id) { ... }\n+   </tbody>\n+ </table>","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"ember"},"children":[{"type":"code","value":"- <!-- Pass props into a pre-built component and hope you can style it -->\n- <PrebuiltDataGrid\n-   @data={{this.data}}\n-   @columns={{this.columns}}\n-   @theme={{this.messyThemeOverrides}}\n-   @styleOverrides={{this.cssOverridesThatHopefullyWork}}\n-   @positionPagination=\"however-my-stakeholders-are-feeling-today\"\n- />\n+ // Build your own markup from the table instance's state and APIs\n+ table = useTable(() => ({ features, columns, data: this.data }))\n+\n+ get rows() { return this.table.getRowModel().rows }\n+ get headerGroups() { return this.table.getHeaderGroups() }\n+\n+ <template>\n+   <table class=\"anything-you-want\">\n+     <thead>\n+       {{! need to really customize the functionality in your headers? no problem! }}\n+       {{#each this.headerGroups as |headerGroup|}} ... {{/each}}\n+     </thead>\n+     <tbody>\n+       {{! want to add virtualization here? no problem! }}\n+       {{#each this.rows as |row|}} ... {{/each}}\n+     </tbody>\n+   </table>\n+ </template>","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"lit"},"children":[{"type":"code","value":"- <!-- Pass props into a pre-built component and hope you can style it -->\n- <prebuilt-data-grid\n-   .data=${data}\n-   .columns=${columns}\n-   .theme=${messyThemeOverrides}\n-   .sx=${cssOverridesThatHopefullyWork}\n-   positionPagination=\"however-my-stakeholders-are-feeling-today\"\n- ></prebuilt-data-grid>\n+ // Build your own markup from the table instance's state and APIs\n+ private tableController = new TableController(this)\n+\n+ render() {\n+   const table = this.tableController.table({ features, columns, data: this.data })\n+\n+   return html`\n+     <table class=\"anything-you-want\">\n+       <thead>\n+         <!-- need to really customize the functionality in your headers? no problem! -->\n+         ${table.getHeaderGroups().map((headerGroup) => html`...`)}\n+       </thead>\n+       <tbody>\n+         <!-- want to add virtualization here? no problem! -->\n+         ${table.getRowModel().rows.map((row) => html`...`)}\n+       </tbody>\n+     </table>\n+   `\n+ }","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"alpine"},"children":[{"type":"code","value":"- <!-- Pass props into a pre-built component and hope you can style it -->\n- <prebuilt-data-grid\n-   data=\"data\"\n-   columns=\"columns\"\n-   theme=\"messy-theme-overrides\"\n-   position-pagination=\"however-my-stakeholders-are-feeling-today\"\n- ></prebuilt-data-grid>\n+ // Build your own markup from the table instance's state and APIs\n+ Alpine.data('myTable', () => {\n+   const table = createTable({ features, columns, get data() { return data } })\n+   return { table }\n+ })\n+\n+ <!-- in your markup -->\n+ <table class=\"anything-you-want\" x-data=\"myTable\">\n+   <thead>\n+     <!-- need to really customize the functionality in your headers? no problem! -->\n+     <template x-for=\"headerGroup in table.getHeaderGroups()\" :key=\"headerGroup.id\">...</template>\n+   </thead>\n+   <tbody>\n+     <!-- want to add virtualization here? no problem! -->\n+     <template x-for=\"row in table.getRowModel().rows\" :key=\"row.id\">...</template>\n+   </tbody>\n+ </table>","lang":"diff"}]},{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"vanilla"},"children":[{"type":"code","value":"- // Configure a pre-built widget and hope you can style it\n- new PrebuiltDataGrid('#my-table', {\n-   data,\n-   columns,\n-   theme: messyThemeOverrides,\n-   positionPagination: 'however-my-stakeholders-are-feeling-today',\n- })\n+ // Build your own markup from the table instance's state and APIs\n+ const table = constructTable({ features, columns, data })\n+\n+ // render however you like: DOM APIs, innerHTML, or your own template system\n+ table.getHeaderGroups().forEach((headerGroup) => { ... })\n+ table.getRowModel().rows.forEach((row) => { ... })","lang":"diff"}]}],"properties":{"data-available-frameworks":"[\"react\",\"preact\",\"octane\",\"solid\",\"svelte\",\"vue\",\"angular\",\"ember\",\"lit\",\"alpine\",\"vanilla\"]","data-framework-meta":"{\"codeBlocksByFramework\":{\"react\":[{\"title\":\"\",\"code\":\"- {/* Pass props into a pre-built component and hope you can style it */}\\n- <PrebuiltDataGrid\\n-   data={data}\\n-   columns={columns}\\n-   theme={messyThemeOverrides}\\n-   sx={cssOverridesThatHopefullyWork}\\n-   positionPagination={\\\"however-my-stakeholders-are-feeling-today\\\"}\\n- />\\n+ // Build your own markup from the table instance's state and APIs\\n+ const table = useTable({ features, columns, data })\\n+\\n+ return (\\n+   <table className=\\\"anything-you-want\\\">\\n+     <thead>\\n+       {/* need to really customize the functionality in your headers? no problem! */}\\n+       {table.getHeaderGroups().map((headerGroup) => ( ... ))}\\n+     </thead>\\n+     <tbody>\\n+       {/* want to add virtualization here? no problem! */}\\n+       {table.getRowModel().rows.map((row) => ( ... ))}\\n+     </tbody>\\n+   </table>\\n+ )\",\"language\":\"diff\"}],\"preact\":[{\"title\":\"\",\"code\":\"- {/* Pass props into a pre-built component and hope you can style it */}\\n- <PrebuiltDataGrid\\n-   data={data}\\n-   columns={columns}\\n-   theme={messyThemeOverrides}\\n-   sx={cssOverridesThatHopefullyWork}\\n-   positionPagination={\\\"however-my-stakeholders-are-feeling-today\\\"}\\n- />\\n+ // Build your own markup from the table instance's state and APIs\\n+ const table = useTable({ features, columns, data })\\n+\\n+ return (\\n+   <table className=\\\"anything-you-want\\\">\\n+     <thead>\\n+       {/* need to really customize the functionality in your headers? no problem! */}\\n+       {table.getHeaderGroups().map((headerGroup) => ( ... ))}\\n+     </thead>\\n+     <tbody>\\n+       {/* want to add virtualization here? no problem! */}\\n+       {table.getRowModel().rows.map((row) => ( ... ))}\\n+     </tbody>\\n+   </table>\\n+ )\",\"language\":\"diff\"}],\"octane\":[{\"title\":\"\",\"code\":\"- {/* Pass props into a pre-built component and hope you can style it */}\\n- <PrebuiltDataGrid\\n-   data={data}\\n-   columns={columns}\\n-   theme={messyThemeOverrides}\\n-   sx={cssOverridesThatHopefullyWork}\\n-   positionPagination={\\\"however-my-stakeholders-are-feeling-today\\\"}\\n- />\\n+ // Build your own markup from the table instance's state and APIs\\n+ const table = useTable({ features, columns, data })\\n+\\n+ <table className=\\\"anything-you-want\\\">\\n+   <thead>\\n+     {/* need to really customize the functionality in your headers? no problem! */}\\n+     @for (const headerGroup of table.getHeaderGroups(); key headerGroup.id) { ... }\\n+   </thead>\\n+   <tbody>\\n+     @for (const row of table.getRowModel().rows; key row.id) { ... }\\n+   </tbody>\\n+ </table>\",\"language\":\"diff\"}],\"solid\":[{\"title\":\"\",\"code\":\"- {/* Pass props into a pre-built component and hope you can style it */}\\n- <PrebuiltDataGrid\\n-   data={data()}\\n-   columns={columns}\\n-   theme={messyThemeOverrides}\\n-   sx={cssOverridesThatHopefullyWork}\\n-   positionPagination={\\\"however-my-stakeholders-are-feeling-today\\\"}\\n- />\\n+ // Build your own markup from the table instance's state and APIs\\n+ const table = createTable({ features, columns, get data() { return data() } })\\n+\\n+ return (\\n+   <table class=\\\"anything-you-want\\\">\\n+     <thead>\\n+       {/* need to really customize the functionality in your headers? no problem! */}\\n+       <For each={table.getHeaderGroups()}>{(headerGroup) => ( ... )}</For>\\n+     </thead>\\n+     <tbody>\\n+       {/* want to add virtualization here? no problem! */}\\n+       <For each={table.getRowModel().rows}>{(row) => ( ... )}</For>\\n+     </tbody>\\n+   </table>\\n+ )\",\"language\":\"diff\"}],\"svelte\":[{\"title\":\"\",\"code\":\"- <!-- Pass props into a pre-built component and hope you can style it -->\\n- <PrebuiltDataGrid\\n-   {data}\\n-   {columns}\\n-   theme={messyThemeOverrides}\\n-   sx={cssOverridesThatHopefullyWork}\\n-   positionPagination=\\\"however-my-stakeholders-are-feeling-today\\\"\\n- />\\n+ <!-- Build your own markup from the table instance's state and APIs -->\\n+ <script>\\n+   const table = createTable({ features, columns, get data() { return data } })\\n+ </script>\\n+\\n+ <table class=\\\"anything-you-want\\\">\\n+   <thead>\\n+     <!-- need to really customize the functionality in your headers? no problem! -->\\n+     {#each table.getHeaderGroups() as headerGroup} ... {/each}\\n+   </thead>\\n+   <tbody>\\n+     <!-- want to add virtualization here? no problem! -->\\n+     {#each table.getRowModel().rows as row} ... {/each}\\n+   </tbody>\\n+ </table>\",\"language\":\"diff\"}],\"vue\":[{\"title\":\"\",\"code\":\"- <!-- Pass props into a pre-built component and hope you can style it -->\\n- <PrebuiltDataGrid\\n-   :data=\\\"data\\\"\\n-   :columns=\\\"columns\\\"\\n-   :theme=\\\"messyThemeOverrides\\\"\\n-   :sx=\\\"cssOverridesThatHopefullyWork\\\"\\n-   position-pagination=\\\"however-my-stakeholders-are-feeling-today\\\"\\n- />\\n+ <!-- Build your own markup from the table instance's state and APIs -->\\n+ <script setup>\\n+ const table = useTable({ features, columns, data })\\n+ </script>\\n+\\n+ <template>\\n+   <table class=\\\"anything-you-want\\\">\\n+     <thead>\\n+       <!-- need to really customize the functionality in your headers? no problem! -->\\n+       <tr v-for=\\\"headerGroup in table.getHeaderGroups()\\\" :key=\\\"headerGroup.id\\\">...</tr>\\n+     </thead>\\n+     <tbody>\\n+       <!-- want to add virtualization here? no problem! -->\\n+       <tr v-for=\\\"row in table.getRowModel().rows\\\" :key=\\\"row.id\\\">...</tr>\\n+     </tbody>\\n+   </table>\\n+ </template>\",\"language\":\"diff\"}],\"angular\":[{\"title\":\"\",\"code\":\"- <!-- Pass props into a pre-built component and hope you can style it -->\\n- <prebuilt-data-grid\\n-   [data]=\\\"data\\\"\\n-   [columns]=\\\"columns\\\"\\n-   [theme]=\\\"messyThemeOverrides\\\"\\n-   [styleOverrides]=\\\"cssOverridesThatHopefullyWork\\\"\\n-   positionPagination=\\\"however-my-stakeholders-are-feeling-today\\\"\\n- />\\n+ // Build your own markup from the table instance's state and APIs\\n+ readonly table = injectTable(() => ({ features, columns, data: this.data() }))\\n+\\n+ <!-- in your component template -->\\n+ <table class=\\\"anything-you-want\\\">\\n+   <thead>\\n+     <!-- need to really customize the functionality in your headers? no problem! -->\\n+     @for (headerGroup of table.getHeaderGroups(); track headerGroup.id) { ... }\\n+   </thead>\\n+   <tbody>\\n+     <!-- want to add virtualization here? no problem! -->\\n+     @for (row of table.getRowModel().rows; track row.id) { ... }\\n+   </tbody>\\n+ </table>\",\"language\":\"diff\"}],\"ember\":[{\"title\":\"\",\"code\":\"- <!-- Pass props into a pre-built component and hope you can style it -->\\n- <PrebuiltDataGrid\\n-   @data={{this.data}}\\n-   @columns={{this.columns}}\\n-   @theme={{this.messyThemeOverrides}}\\n-   @styleOverrides={{this.cssOverridesThatHopefullyWork}}\\n-   @positionPagination=\\\"however-my-stakeholders-are-feeling-today\\\"\\n- />\\n+ // Build your own markup from the table instance's state and APIs\\n+ table = useTable(() => ({ features, columns, data: this.data }))\\n+\\n+ get rows() { return this.table.getRowModel().rows }\\n+ get headerGroups() { return this.table.getHeaderGroups() }\\n+\\n+ <template>\\n+   <table class=\\\"anything-you-want\\\">\\n+     <thead>\\n+       {{! need to really customize the functionality in your headers? no problem! }}\\n+       {{#each this.headerGroups as |headerGroup|}} ... {{/each}}\\n+     </thead>\\n+     <tbody>\\n+       {{! want to add virtualization here? no problem! }}\\n+       {{#each this.rows as |row|}} ... {{/each}}\\n+     </tbody>\\n+   </table>\\n+ </template>\",\"language\":\"diff\"}],\"lit\":[{\"title\":\"\",\"code\":\"- <!-- Pass props into a pre-built component and hope you can style it -->\\n- <prebuilt-data-grid\\n-   .data=${data}\\n-   .columns=${columns}\\n-   .theme=${messyThemeOverrides}\\n-   .sx=${cssOverridesThatHopefullyWork}\\n-   positionPagination=\\\"however-my-stakeholders-are-feeling-today\\\"\\n- ></prebuilt-data-grid>\\n+ // Build your own markup from the table instance's state and APIs\\n+ private tableController = new TableController(this)\\n+\\n+ render() {\\n+   const table = this.tableController.table({ features, columns, data: this.data })\\n+\\n+   return html`\\n+     <table class=\\\"anything-you-want\\\">\\n+       <thead>\\n+         <!-- need to really customize the functionality in your headers? no problem! -->\\n+         ${table.getHeaderGroups().map((headerGroup) => html`...`)}\\n+       </thead>\\n+       <tbody>\\n+         <!-- want to add virtualization here? no problem! -->\\n+         ${table.getRowModel().rows.map((row) => html`...`)}\\n+       </tbody>\\n+     </table>\\n+   `\\n+ }\",\"language\":\"diff\"}],\"alpine\":[{\"title\":\"\",\"code\":\"- <!-- Pass props into a pre-built component and hope you can style it -->\\n- <prebuilt-data-grid\\n-   data=\\\"data\\\"\\n-   columns=\\\"columns\\\"\\n-   theme=\\\"messy-theme-overrides\\\"\\n-   position-pagination=\\\"however-my-stakeholders-are-feeling-today\\\"\\n- ></prebuilt-data-grid>\\n+ // Build your own markup from the table instance's state and APIs\\n+ Alpine.data('myTable', () => {\\n+   const table = createTable({ features, columns, get data() { return data } })\\n+   return { table }\\n+ })\\n+\\n+ <!-- in your markup -->\\n+ <table class=\\\"anything-you-want\\\" x-data=\\\"myTable\\\">\\n+   <thead>\\n+     <!-- need to really customize the functionality in your headers? no problem! -->\\n+     <template x-for=\\\"headerGroup in table.getHeaderGroups()\\\" :key=\\\"headerGroup.id\\\">...</template>\\n+   </thead>\\n+   <tbody>\\n+     <!-- want to add virtualization here? no problem! -->\\n+     <template x-for=\\\"row in table.getRowModel().rows\\\" :key=\\\"row.id\\\">...</template>\\n+   </tbody>\\n+ </table>\",\"language\":\"diff\"}],\"vanilla\":[{\"title\":\"\",\"code\":\"- // Configure a pre-built widget and hope you can style it\\n- new PrebuiltDataGrid('#my-table', {\\n-   data,\\n-   columns,\\n-   theme: messyThemeOverrides,\\n-   positionPagination: 'however-my-stakeholders-are-feeling-today',\\n- })\\n+ // Build your own markup from the table instance's state and APIs\\n+ const table = constructTable({ features, columns, data })\\n+\\n+ // render however you like: DOM APIs, innerHTML, or your own template system\\n+ table.getHeaderGroups().forEach((headerGroup) => { ... })\\n+ table.getRowModel().rows.forEach((row) => { ... })\",\"language\":\"diff\"}]}}"}},{"type":"heading","depth":2,"id":"features","children":[{"type":"text","value":"Features"}]},{"type":"paragraph","children":[{"type":"text","value":"TanStack Table is packed with features, but you only ever bundle the ones you use. The full v9 package is about 25 KB when minified and Brotli-compressed, but more importantly, it is "},{"type":"strong","children":[{"type":"text","value":"modular"}]},{"type":"text","value":"! You register only the features and row models that your table actually uses, and your bundler can tree-shake away unused optional capabilities. A basic table bundles just the small core. Because features vary in size and share that core, the exact savings depend on which capabilities you register."}]},{"type":"paragraph","children":[{"type":"text","value":"We like to think of TanStack Table as more of a \"system\" for building tables than just a library, as it is one of the most customizable table libraries ever built. TanStack Table has the following built-in features, plus a custom feature (plugin) system for adding your own state and APIs."}]},{"type":"component","name":"framework","attributes":{},"children":[{"type":"component","name":"framework-panel","tagName":"md-framework-panel","attributes":{},"properties":{"data-framework":"react"},"children":[{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/cell-selection","children":[{"type":"text","value":"Cell Selection"}]},{"type":"text","value":" - Select spreadsheet-style rectangular ranges of cells"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/cell-spanning","children":[{"type":"text","value":"Cell Spanning"}]},{"type":"text","value":" - Merge adjacent body cells across rows or columns"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/column-filtering","children":[{"type":"text","value":"Column Filtering"}]},{"type":"text","value":" - Filter rows based on search values for a column"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/grouping","children":[{"type":"text","value":"Column Grouping"}]},{"type":"text","value":" - Group rows by one or more column values"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/column-ordering","children":[{"type":"text","value":"Column Ordering"}]},{"type":"text","value":" - Dynamically change the order of columns"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/column-pinning","children":[{"type":"text","value":"Column Pinning"}]},{"type":"text","value":" - Pin (Freeze) columns to the left or right of the table"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/column-resizing","children":[{"type":"text","value":"Column Resizing"}]},{"type":"text","value":" - Let users resize columns with drag handles"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/column-sizing","children":[{"type":"text","value":"Column Sizing"}]},{"type":"text","value":" - Dynamically change the size of columns"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/column-visibility","children":[{"type":"text","value":"Column Visibility"}]},{"type":"text","value":" - Hide/show columns"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"./framework/react/guide/column-faceting","children":[{"type":"text","value":"Faceting"}]},{"type":"tex