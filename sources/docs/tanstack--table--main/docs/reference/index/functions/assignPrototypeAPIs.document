}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TDeps"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" readonly "},{"type":"inlineCode","value":"any"},{"type":"text","value":"[]"}]},{"type":"heading","depth":3,"id":"tdepargs","children":[{"type":"text","value":"TDepArgs"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TDepArgs"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"feature","children":[{"type":"text","value":"feature"}]},{"type":"paragraph","children":[{"type":"text","value":"keyof "},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":" & "},{"type":"inlineCode","value":"string"}]},{"type":"heading","depth":3,"id":"prototype","children":[{"type":"text","value":"prototype"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"any"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"apis","children":[{"type":"text","value":"apis"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/PrototypeAPIObject.md","children":[{"type":"inlineCode","value":"PrototypeAPIObject"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TDeps"},{"type":"text","value":", "},{"type":"link","href":"../type-aliases/NoInfer.md","children":[{"type":"inlineCode","value":"NoInfer"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TDepArgs"},{"type":"text","value":">>"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]}],"headings":[{"id":"function-assignprototypeapis","text":"Function: assignPrototypeAPIs()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tdeps","text":"TDeps","level":3},{"id":"tdepargs","text":"TDepArgs","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"feature","text":"feature","level":3},{"id":"prototype","text":"prototype","level":3},{"id":"table","text":"table","level":3},{"id":"apis","text":"apis","level":3},{"id":"returns","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: assignPrototypeAPIs()\n\n```ts\nfunction assignPrototypeAPIs<TFeatures, TData, TDeps, TDepArgs>(\n   feature,\n   prototype,\n   table,\n   apis): void;\n```\n\nDefined in: [utils.ts:586](https://github.com/TanStack/table/blob/main/packages/table-core/src/utils.ts#L586)\n\nAssigns API methods to a prototype object for memory-efficient method sharing.\nAll instances created with this prototype will share the same method references.\n\nFor memoized methods, the memo state is lazily created and stored on each instance.\nThis provides the best of both worlds: shared method code + per-instance caching.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n### TDeps\n\n`TDeps` *extends* readonly `any`[]\n\n### TDepArgs\n\n`TDepArgs`\n\n## Parameters\n\n### feature\n\nkeyof `TFeatures` & `string`\n\n### prototype\n\n`Record`\\<`string`, `any`\\>\n\n### table\n\n[`Table_Internal`](../interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### apis\n\n[`PrototypeAPIObject`](../type-aliases/PrototypeAPIObject.md)\\<`TDeps`, [`NoInfer`](../type-aliases/NoInfer.md)\\<`TDepArgs`\\>\\>\n\n## Returns\n\n`void`\n","originalRawMarkdown":"---\nid: assignPrototypeAPIs\ntitle: assignPrototypeAPIs\n---\n\n# Function: assignPrototypeAPIs()\n\n```ts\nfunction assignPrototypeAPIs<TFeatures, TData, TDeps, TDepArgs>(\n   feature,\n   prototype,\n   table,\n   apis): void;\n```\n\nDefined in: [utils.ts:586](https://github.com/TanStack/table/blob/main/packages/table-core/src/utils.ts#L586)\n\nAssigns API methods to a prototype object for memory-efficient method sharing.\nAll instances created with this prototype will share the same method references.\n\nFor memoized methods, the memo state is lazily created and stored on each instance.\nThis provides the best of both worlds: shared method code + per-instance caching.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n### TDeps\n\n`TDeps` *extends* readonly `any`[]\n\n### TDepArgs\n\n`TDepArgs`\n\n## Parameters\n\n### feature\n\nkeyof `TFeatures` & `string`\n\n### prototype\n\n`Record`\\<`string`, `any`\\>\n\n### table\n\n[`Table_Internal`](../interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### apis\n\n[`PrototypeAPIObject`](../type-aliases/PrototypeAPIObject.md)\\<`TDeps`, [`NoInfer`](../type-aliases/NoInfer.md)\\<`TDepArgs`\\>\\>\n\n## Returns\n\n`void`\n"}
