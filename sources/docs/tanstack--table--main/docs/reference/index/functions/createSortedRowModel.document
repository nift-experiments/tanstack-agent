ype":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../interfaces/TableFeatures.md","children":[{"type":"inlineCode","value":"TableFeatures"}]}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"(table): () => RowModel<TFeatures, TData>;","lang":"ts"},{"type":"heading","depth":3,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Table.md","children":[{"type":"inlineCode","value":"Table"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"(): RowModel<TFeatures, TData>;","lang":"ts"},{"type":"heading","depth":4,"id":"returns-3","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../interfaces/RowModel.md","children":[{"type":"inlineCode","value":"RowModel"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]}],"headings":[{"id":"function-createsortedrowmodel","text":"Function: createSortedRowModel()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"returns","text":"Returns","level":2},{"id":"parameters","text":"Parameters","level":3},{"id":"table","text":"table","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"returns-3","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\n# Function: createSortedRowModel()\n\n```ts\nfunction createSortedRowModel<TFeatures, TData>(): (table) => () => RowModel<TFeatures, TData>;\n```\n\nDefined in: [features/row-sorting/createSortedRowModel.ts:28](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-sorting/createSortedRowModel.ts#L28)\n\nCreates a memoized sorted row model factory.\n\nThe factory reads the relevant table state atoms and options, then returns a row model function used by the table row-model pipeline.\n\nRegister the sorting functions you use with the `sortFns` slot on the\n`features` option:\n`tableFeatures({ rowSortingFeature, sortedRowModel: createSortedRowModel(), sortFns: { alphanumeric: sortFn_alphanumeric } })`.\nImporting individual `sortFn_*` functions keeps unused built-ins out of\nyour bundle; sorting functions passed directly to the `sortFn` column\noption need no registration at all.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Returns\n\n```ts\n(table): () => RowModel<TFeatures, TData>;\n```\n\n### Parameters\n\n#### table\n\n[`Table`](../type-aliases/Table.md)\\<`TFeatures`, `TData`\\>\n\n### Returns\n\n```ts\n(): RowModel<TFeatures, TData>;\n```\n\n#### Returns\n\n[`RowModel`](../interfaces/RowModel.md)\\<`TFeatures`, `TData`\\>\n","originalRawMarkdown":"---\nid: createSortedRowModel\ntitle: createSortedRowModel\n---\n\n# Function: createSortedRowModel()\n\n```ts\nfunction createSortedRowModel<TFeatures, TData>(): (table) => () => RowModel<TFeatures, TData>;\n```\n\nDefined in: [features/row-sorting/createSortedRowModel.ts:28](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-sorting/createSortedRowModel.ts#L28)\n\nCreates a memoized sorted row model factory.\n\nThe factory reads the relevant table state atoms and options, then returns a row model function used by the table row-model pipeline.\n\nRegister the sorting functions you use with the `sortFns` slot on the\n`features` option:\n`tableFeatures({ rowSortingFeature, sortedRowModel: createSortedRowModel(), sortFns: { alphanumeric: sortFn_alphanumeric } })`.\nImporting individual `sortFn_*` functions keeps unused built-ins out of\nyour bundle; sorting functions passed directly to the `sortFn` column\noption need no registration at all.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Returns\n\n```ts\n(table): () => RowModel<TFeatures, TData>;\n```\n\n### Parameters\n\n#### table\n\n[`Table`](../type-aliases/Table.md)\\<`TFeatures`, `TData`\\>\n\n### Returns\n\n```ts\n(): RowModel<TFeatures, TData>;\n```\n\n#### Returns\n\n[`RowModel`](../interfaces/RowModel.md)\\<`TFeatures`, `TData`\\>\n"}
