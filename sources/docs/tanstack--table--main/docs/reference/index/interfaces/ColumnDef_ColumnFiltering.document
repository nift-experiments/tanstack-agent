umn-filtering/columnFilteringFeature.types.ts:187"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Enables this column to participate in column-specific filtering."}]},{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":"; table-level "},{"type":"inlineCode","value":"enableColumnFilters"},{"type":"text","value":" and "},{"type":"inlineCode","value":"enableFilters"},{"type":"text","value":"\nmust also allow filtering."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"filterfn","children":[{"type":"text","value":"filterFn?"}]},{"type":"code","value":"optional filterFn: FilterFnOption<TFeatures, TData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L191","children":[{"type":"text","value":"features/column-filtering/columnFilteringFeature.types.ts:191"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The filter function to use with this column. Can be the name of a built-in filter function or a custom filter function."}]}],"headings":[{"id":"interface-columndef-columnfilteringtfeatures-tdata","text":"Interface: ColumnDef_ColumnFiltering<TFeatures, TData>","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"enablecolumnfilter","text":"enableColumnFilter?","level":3},{"id":"filterfn","text":"filterFn?","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Interface: ColumnDef\\_ColumnFiltering\\<TFeatures, TData\\>\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:177](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L177)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### enableColumnFilter?\n\n```ts\noptional enableColumnFilter: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:187](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L187)\n\nEnables this column to participate in column-specific filtering.\n\nDefaults to `true`; table-level `enableColumnFilters` and `enableFilters`\nmust also allow filtering.\n\n***\n\n### filterFn?\n\n```ts\noptional filterFn: FilterFnOption<TFeatures, TData>;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:191](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L191)\n\nThe filter function to use with this column. Can be the name of a built-in filter function or a custom filter function.\n","originalRawMarkdown":"---\nid: ColumnDef_ColumnFiltering\ntitle: ColumnDef_ColumnFiltering\n---\n\n# Interface: ColumnDef\\_ColumnFiltering\\<TFeatures, TData\\>\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:177](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L177)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### enableColumnFilter?\n\n```ts\noptional enableColumnFilter: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:187](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L187)\n\nEnables this column to participate in column-specific filtering.\n\nDefaults to `true`; table-level `enableColumnFilters` and `enableFilters`\nmust also allow filtering.\n\n***\n\n### filterFn?\n\n```ts\noptional filterFn: FilterFnOption<TFeatures, TData>;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:191](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L191)\n\nThe filter function to use with this column. Can be the name of a built-in filter function or a custom filter function.\n"}
