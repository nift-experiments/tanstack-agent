pingFeature.types.ts:21"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Allows this column to be added to grouping state."}]},{"type":"paragraph","children":[{"type":"text","value":"Defaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":"; table-level "},{"type":"inlineCode","value":"enableGrouping"},{"type":"text","value":" must also allow grouping."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getgroupingvalue","children":[{"type":"text","value":"getGroupingValue()?"}]},{"type":"code","value":"optional getGroupingValue: (originalRow, index, row) => any;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L28","children":[{"type":"text","value":"features/column-grouping/columnGroupingFeature.types.ts:28"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Returns the value used to group rows for this column."}]},{"type":"paragraph","children":[{"type":"text","value":"When omitted, grouping uses the value derived from this column's\n"},{"type":"inlineCode","value":"accessorKey"},{"type":"text","value":" or "},{"type":"inlineCode","value":"accessorFn"},{"type":"text","value":"."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"originalrow","children":[{"type":"text","value":"originalRow"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"}]},{"type":"heading","depth":5,"id":"index","children":[{"type":"text","value":"index"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":5,"id":"row","children":[{"type":"text","value":"row"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Row.md","children":[{"type":"inlineCode","value":"Row"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"any"}]}],"headings":[{"id":"interface-columndef-columngroupingtfeatures-tdata","text":"Interface: ColumnDef_ColumnGrouping<TFeatures, TData>","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"enablegrouping","text":"enableGrouping?","level":3},{"id":"getgroupingvalue","text":"getGroupingValue()?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"originalrow","text":"originalRow","level":5},{"id":"index","text":"index","level":5},{"id":"row","text":"row","level":5},{"id":"returns","text":"Returns","level":4}]},"frameworks":[],"downloadMarkdown":"\n# Interface: ColumnDef\\_ColumnGrouping\\<TFeatures, TData\\>\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:12](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L12)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### enableGrouping?\n\n```ts\noptional enableGrouping: boolean;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:21](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L21)\n\nAllows this column to be added to grouping state.\n\nDefaults to `true`; table-level `enableGrouping` must also allow grouping.\n\n***\n\n### getGroupingValue()?\n\n```ts\noptional getGroupingValue: (originalRow, index, row) => any;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:28](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L28)\n\nReturns the value used to group rows for this column.\n\nWhen omitted, grouping uses the value derived from this column's\n`accessorKey` or `accessorFn`.\n\n#### Parameters\n\n##### originalRow\n\n`TData`\n\n##### index\n\n`number`\n\n##### row\n\n[`Row`](../type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n#### Returns\n\n`any`\n","originalRawMarkdown":"---\nid: ColumnDef_ColumnGrouping\ntitle: ColumnDef_ColumnGrouping\n---\n\n# Interface: ColumnDef\\_ColumnGrouping\\<TFeatures, TData\\>\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:12](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L12)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### enableGrouping?\n\n```ts\noptional enableGrouping: boolean;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:21](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L21)\n\nAllows this column to be added to grouping state.\n\nDefaults to `true`; table-level `enableGrouping` must also allow grouping.\n\n***\n\n### getGroupingValue()?\n\n```ts\noptional getGroupingValue: (originalRow, index, row) => any;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:28](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L28)\n\nReturns the value used to group rows for this column.\n\nWhen omitted, grouping uses the value derived from this column's\n`accessorKey` or `accessorFn`.\n\n#### Parameters\n\n##### originalRow\n\n`TData`\n\n##### index\n\n`number`\n\n##### row\n\n[`Row`](../type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n#### Returns\n\n`any`\n"}
