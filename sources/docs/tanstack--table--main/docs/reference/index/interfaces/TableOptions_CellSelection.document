l-selection/cellSelectionFeature.types.ts:102"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Resets cell selection to "},{"type":"inlineCode","value":"initialState.cellSelection"},{"type":"text","value":" whenever "},{"type":"inlineCode","value":"data"},{"type":"text","value":"\nchanges. Defaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Ranges are stored as row and column ids, so new data would otherwise leave\na selection pointing at rows that no longer exist, or silently re-select\ncells if the new data happens to reuse ids. Set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" to keep ranges\nacross data changes, and note "},{"type":"inlineCode","value":"autoResetAll"},{"type":"text","value":" overrides this."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"enablecellrangeselection","children":[{"type":"text","value":"enableCellRangeSelection?"}]},{"type":"code","value":"optional enableCellRangeSelection: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L107","children":[{"type":"text","value":"features/cell-selection/cellSelectionFeature.types.ts:107"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Enables inclusive cell range selection through shift-click and drag.\nDefaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"enablecellselection","children":[{"type":"text","value":"enableCellSelection?"}]},{"type":"code","value":"optional enableCellSelection: boolean | (cell) => boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/tabl