faults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"iscellrangeselectionevent","children":[{"type":"text","value":"isCellRangeSelectionEvent()?"}]},{"type":"code","value":"optional isCellRangeSelectionEvent: (event) => boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L131","children":[{"type":"text","value":"features/cell-selection/cellSelectionFeature.types.ts:131"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Determines whether a selection-start event should extend the active range\ninstead of replacing the selection."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, events with "},{"type":"inlineCode","value":"shiftKey"},{"type":"text","value":" directly on the event or on\n"},{"type":"inlineCode","value":"event.nativeEvent"},{"type":"text","value":" are treated as range-selection events."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"event","children":[{"type":"text","value":"event"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"ismulticellrangeselectionevent","children":[{"type":"text","value":"isMultiCellRangeSelectionEvent()?"}]},{"type":"code","value":"optional isMultiCellRangeSelectionEvent: (event) => boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L139","children":[{"type":"text","value":"features/cell-selection/cellSelectionFeature.types.ts:139"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Determines whether a selection-start event should add or subtract a new\nrectangle. The operation depends on whether the starting cell is selected."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, events with "},{"type":"inlineCode","value":"ctrlKey"},{"type":"text","value":" or "},{"type":"inlineCode","value":"metaKey"},{"type":"text","value":" directly on the event or on\n"},{"type":"inlineCode","value":"event.nativeEvent"},{"type":"text","value":" are treated as multi-range events."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"event-2","children":[{"type":"text","value":"event"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"oncellselectionchange","children":[{"type":"text","value":"onCellSelectionChange?"}]},{"type":"code","value":"optional onCellSelectionChange: OnChangeFn<CellSelectionState>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L148","children":[{"type":"text","value":"features/cell-selection/cellSelectionFeature.types.ts:148"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called with an updater when cell selection state changes. Pair this with\n"},{"type":"inlineCode","value":"state.cellSelection"},{"type":"text","value":" when using external state; external atoms can own the\nslice without this callback."}]},{"type":"paragraph","children":[{"type":"text","value":"A drag emits one change per cell crossed. Subscribe to\n"},{"type":"inlineCode","value":"table.atoms.cellSelection"},{"type":"text","value":" for finer-grained reads when that matters."}]}],"headings":[{"id":"interface-tableoptions-cellselectiontfeatures-tdata","text":"Interface: TableOptions_CellSelection<TFeatures, TData>","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"autoresetcellselection","text":"autoResetCellSelection?","level":3},{"id":"enablecellrangeselection","text":"enableCellRangeSelection?","level":3},{"id":"enablecellselection","text":"enableCellSelection?","level":3},{"id":"enablecellselectiondrag","text":"enableCellSelectionDrag?","level":3},{"id":"enablemulticellrangeselection","text":"enableMultiCellRangeSelection?","level":3},{"id":"iscellrangeselectionevent","text":"isCellRangeSelectionEvent()?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"event","text":"event","level":5},{"id":"returns","text":"Returns","level":4},{"id":"ismulticellrangeselectionevent","text":"isMultiCellRangeSelectionEvent()?","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"event-2","text":"event","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"oncellselectionchange","text":"onCellSelectionChange?","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Interface: TableOptions\\_CellSelection\\<TFeatures, TData\\>\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:89](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L89)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### autoResetCellSelection?\n\n```ts\noptional autoResetCellSelection: boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:102](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L102)\n\nResets cell selection to `initialState.cellSelection` whenever `data`\nchanges. Defaults to `true`.\n\nRanges are stored as row and column ids, so new data would otherwise leave\na selection pointing at rows that no longer exist, or silently re-select\ncells if the new data happens to reuse ids. Set to `false` to keep ranges\nacross data changes, and note `autoResetAll` overrides this.\n\n***\n\n### enableCellRangeSelection?\n\n```ts\noptional enableCellRangeSelection: boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:107](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L107)\n\nEnables inclusive cell range selection through shift-click and drag.\nDefaults to `true`.\n\n***\n\n### enableCellSelection?\n\n```ts\noptional enableCellSelection: boolean | (cell) => boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:114](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L114)\n\nAllows cells to be selected.\n\nProvide a predicate to decide per cell. A column def may also opt out with\nits own `enableCellSelection: false`. Defaults to `true`.\n\n***\n\n### enableCellSelectionDrag?\n\n```ts\noptional enableCellSelectionDrag: boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:119](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L119)\n\nEnables extending a selection by dragging across cells. Defaults to `true`.\n\n***\n\n### enableMultiCellRangeSelection?\n\n```ts\noptional enableMultiCellRangeSelection: boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:123](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L123)\n\nAllows modifier interactions to add or subtract ranges. Defaults to `true`.\n\n***\n\n### isCellRangeSelectionEvent()?\n\n```ts\noptional isCellRangeSelectionEvent: (event) => boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:131](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L131)\n\nDetermines whether a selection-start event should extend the active range\ninstead of replacing the selection.\n\nBy default, events with `shiftKey` directly on the event or on\n`event.nativeEvent` are treated as range-selection events.\n\n#### Parameters\n\n##### event\n\n`unknown`\n\n#### Returns\n\n`boolean`\n\n***\n\n### isMultiCellRangeSelectionEvent()?\n\n```ts\noptional isMultiCellRangeSelectionEvent: (event) => boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:139](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L139)\n\nDetermines whether a selection-start event should add or subtract a new\nrectangle. The operation depends on whether the starting cell is selected.\n\nBy default, events with `ctrlKey` or `metaKey` directly on the event or on\n`event.nativeEvent` are treated as multi-range events.\n\n#### Parameters\n\n##### event\n\n`unknown`\n\n#### Returns\n\n`boolean`\n\n***\n\n### onCellSelectionChange?\n\n```ts\noptional onCellSelectionChange: OnChangeFn<CellSelectionState>;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:148](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L148)\n\nCalled with an updater when cell selection state changes. Pair this with\n`state.cellSelection` when using external state; external atoms can own the\nslice without this callback.\n\nA drag emits one change per cell crossed. Subscribe to\n`table.atoms.cellSelection` for finer-grained reads when that matters.\n","originalRawMarkdown":"---\nid: TableOptions_CellSelection\ntitle: TableOptions_CellSelection\n---\n\n# Interface: TableOptions\\_CellSelection\\<TFeatures, TData\\>\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:89](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L89)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### autoResetCellSelection?\n\n```ts\noptional autoResetCellSelection: boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:102](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L102)\n\nResets cell selection to `initialState.cellSelection` whenever `data`\nchanges. Defaults to `true`.\n\nRanges are stored as row and column ids, so new data would otherwise leave\na selection pointing at rows that no longer exist, or silently re-select\ncells if the new data happens to reuse ids. Set to `false` to keep ranges\nacross data changes, and note `autoResetAll` overrides this.\n\n***\n\n### enableCellRangeSelection?\n\n```ts\noptional enableCellRangeSelection: boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:107](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L107)\n\nEnables inclusive cell range selection through shift-click and drag.\nDefaults to `true`.\n\n***\n\n### enableCellSelection?\n\n```ts\noptional enableCellSelection: boolean | (cell) => boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:114](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L114)\n\nAllows cells to be selected.\n\nProvide a predicate to decide per cell. A column def may also opt out with\nits own `enableCellSelection: false`. Defaults to `true`.\n\n***\n\n### enableCellSelectionDrag?\n\n```ts\noptional enableCellSelectionDrag: boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:119](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L119)\n\nEnables extending a selection by dragging across cells. Defaults to `true`.\n\n***\n\n### enableMultiCellRangeSelection?\n\n```ts\noptional enableMultiCellRangeSelection: boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:123](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L123)\n\nAllows modifier interactions to add or subtract ranges. Defaults to `true`.\n\n***\n\n### isCellRangeSelectionEvent()?\n\n```ts\noptional isCellRangeSelectionEvent: (event) => boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:131](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L131)\n\nDetermines whether a selection-start event should extend the active range\ninstead of replacing the selection.\n\nBy default, events with `shiftKey` directly on the event or on\n`event.nativeEvent` are treated as range-selection events.\n\n#### Parameters\n\n##### event\n\n`unknown`\n\n#### Returns\n\n`boolean`\n\n***\n\n### isMultiCellRangeSelectionEvent()?\n\n```ts\noptional isMultiCellRangeSelectionEvent: (event) => boolean;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:139](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L139)\n\nDetermines whether a selection-start event should add or subtract a new\nrectangle. The operation depends on whether the starting cell is selected.\n\nBy default, events with `ctrlKey` or `metaKey` directly on the event or on\n`event.nativeEvent` are treated as multi-range events.\n\n#### Parameters\n\n##### event\n\n`unknown`\n\n#### Returns\n\n`boolean`\n\n***\n\n### onCellSelectionChange?\n\n```ts\noptional onCellSelectionChange: OnChangeFn<CellSelectionState>;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.types.ts:148](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.types.ts#L148)\n\nCalled with an updater when cell selection state changes. Pair this with\n`state.cellSelection` when using external state; external atoms can own the\nslice without this callback.\n\nA drag emits one change per cell crossed. Subscribe to\n`table.atoms.cellSelection` for finer-grained reads when that matters.\n"}
