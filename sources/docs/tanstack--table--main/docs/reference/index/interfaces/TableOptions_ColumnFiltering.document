e":"features/column-filtering/columnFilteringFeature.types.ts:252"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Enables column-specific filtering for all columns that also allow it."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"enablefilters","children":[{"type":"text","value":"enableFilters?"}]},{"type":"code","value":"optional enableFilters: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L258","children":[{"type":"text","value":"features/column-filtering/columnFilteringFeature.types.ts:258"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Enables all filtering features for the table."}]},{"type":"paragraph","children":[{"type":"text","value":"Set this to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" to disable both column filtering and global filtering."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"filterfromleafrows","children":[{"type":"text","value":"filterFromLeafRows?"}]},{"type":"code","value":"optional filterFromLeafRows: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L262","children":[{"type":"text","value":"features/column-filtering/columnFilteringFeature.types.ts:262"}]}]},{"type":"paragraph","children":[{"type":"text","value":"By default, filtering is done from parent rows down (so if a parent row is filtered out, all of its children will be filtered out as well). Setting this option to "},{"type":"inlineCode","value":"true"},{"type":"text","value":" will cause filtering to be done from leaf rows up (which means parent rows will be included so long as one of their child or grand-child rows is also included)."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"manualfiltering","children":[{"type":"text","value":"manualFiltering?"}]},{"type":"code","value":"optional manualFiltering: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L266","children":[{"type":"text","value":"features/column-filtering/columnFilteringFeature.types.ts:266"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Disables the "},{"type":"inlineCode","value":"getFilteredRowModel"},{"type":"text","value":" from being used to filter data. This may be useful if your table needs to dynamically support both client-side and server-side filtering."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"maxleafrowfilterdepth","children":[{"type":"text","value":"maxLeafRowFilterDepth?"}]},{"type":"code","value":"optional maxLeafRowFilterDepth: number;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L272","children":[{"type":"text","value":"features/column-filtering/columnFilteringFeature.types.ts:272"}]}]},{"type":"paragraph","children":[{"type":"text","value":"By default, filtering is done for all rows (max depth of 100), no matter if they are root level parent rows or the child leaf rows of a parent row. Setting this option to "},{"type":"inlineCode","value":"0"},{"type":"text","value":" will cause filtering to only be applied to the root level parent rows, with all sub-rows remaining unfiltered. Similarly, setting this option to "},{"type":"inlineCode","value":"1"},{"type":"text","value":" will cause filtering to only be applied to child leaf rows 1 level deep, and so on."}]},{"type":"paragraph","children":[{"type":"text","value":"This is useful for situations where you want a row's entire child hierarchy to be visible regardless of the applied filter."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"oncolumnfilterschange","children":[{"type":"text","value":"onColumnFiltersChange?"}]},{"type":"code","value":"optional onColumnFiltersChange: OnChangeFn<ColumnFiltersState>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L278","children":[{"type":"text","value":"features/column-filtering/columnFilteringFeature.types.ts:278"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called with an updater when column filter state changes. Pair this with\n"},{"type":"inlineCode","value":"state.columnFilters"},{"type":"text","value":" when using external state; external atoms can own the\nslice without this callback."}]}],"headings":[{"id":"interface-tableoptions-columnfiltering-tfeatures-tdata","text":"Interface: TableOptions_ColumnFiltering<_TFeatures, _TData>","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"_TFeatures","level":3},{"id":"tdata","text":"_TData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"enablecolumnfilters","text":"enableColumnFilters?","level":3},{"id":"enablefilters","text":"enableFilters?","level":3},{"id":"filterfromleafrows","text":"filterFromLeafRows?","level":3},{"id":"manualfiltering","text":"manualFiltering?","level":3},{"id":"maxleafrowfilterdepth","text":"maxLeafRowFilterDepth?","level":3},{"id":"oncolumnfilterschange","text":"onColumnFiltersChange?","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Interface: TableOptions\\_ColumnFiltering\\<_TFeatures, _TData\\>\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:245](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L245)\n\n## Type Parameters\n\n### _TFeatures\n\n`_TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### _TData\n\n`_TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### enableColumnFilters?\n\n```ts\noptional enableColumnFilters: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:252](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L252)\n\nEnables column-specific filtering for all columns that also allow it.\n\n***\n\n### enableFilters?\n\n```ts\noptional enableFilters: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:258](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L258)\n\nEnables all filtering features for the table.\n\nSet this to `false` to disable both column filtering and global filtering.\n\n***\n\n### filterFromLeafRows?\n\n```ts\noptional filterFromLeafRows: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:262](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L262)\n\nBy default, filtering is done from parent rows down (so if a parent row is filtered out, all of its children will be filtered out as well). Setting this option to `true` will cause filtering to be done from leaf rows up (which means parent rows will be included so long as one of their child or grand-child rows is also included).\n\n***\n\n### manualFiltering?\n\n```ts\noptional manualFiltering: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:266](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L266)\n\nDisables the `getFilteredRowModel` from being used to filter data. This may be useful if your table needs to dynamically support both client-side and server-side filtering.\n\n***\n\n### maxLeafRowFilterDepth?\n\n```ts\noptional maxLeafRowFilterDepth: number;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:272](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L272)\n\nBy default, filtering is done for all rows (max depth of 100), no matter if they are root level parent rows or the child leaf rows of a parent row. Setting this option to `0` will cause filtering to only be applied to the root level parent rows, with all sub-rows remaining unfiltered. Similarly, setting this option to `1` will cause filtering to only be applied to child leaf rows 1 level deep, and so on.\n\nThis is useful for situations where you want a row's entire child hierarchy to be visible regardless of the applied filter.\n\n***\n\n### onColumnFiltersChange?\n\n```ts\noptional onColumnFiltersChange: OnChangeFn<ColumnFiltersState>;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:278](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L278)\n\nCalled with an updater when column filter state changes. Pair this with\n`state.columnFilters` when using external state; external atoms can own the\nslice without this callback.\n","originalRawMarkdown":"---\nid: TableOptions_ColumnFiltering\ntitle: TableOptions_ColumnFiltering\n---\n\n# Interface: TableOptions\\_ColumnFiltering\\<_TFeatures, _TData\\>\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:245](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L245)\n\n## Type Parameters\n\n### _TFeatures\n\n`_TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### _TData\n\n`_TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### enableColumnFilters?\n\n```ts\noptional enableColumnFilters: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:252](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L252)\n\nEnables column-specific filtering for all columns that also allow it.\n\n***\n\n### enableFilters?\n\n```ts\noptional enableFilters: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:258](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L258)\n\nEnables all filtering features for the table.\n\nSet this to `false` to disable both column filtering and global filtering.\n\n***\n\n### filterFromLeafRows?\n\n```ts\noptional filterFromLeafRows: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:262](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L262)\n\nBy default, filtering is done from parent rows down (so if a parent row is filtered out, all of its children will be filtered out as well). Setting this option to `true` will cause filtering to be done from leaf rows up (which means parent rows will be included so long as one of their child or grand-child rows is also included).\n\n***\n\n### manualFiltering?\n\n```ts\noptional manualFiltering: boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:266](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L266)\n\nDisables the `getFilteredRowModel` from being used to filter data. This may be useful if your table needs to dynamically support both client-side and server-side filtering.\n\n***\n\n### maxLeafRowFilterDepth?\n\n```ts\noptional maxLeafRowFilterDepth: number;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:272](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L272)\n\nBy default, filtering is done for all rows (max depth of 100), no matter if they are root level parent rows or the child leaf rows of a parent row. Setting this option to `0` will cause filtering to only be applied to the root level parent rows, with all sub-rows remaining unfiltered. Similarly, setting this option to `1` will cause filtering to only be applied to child leaf rows 1 level deep, and so on.\n\nThis is useful for situations where you want a row's entire child hierarchy to be visible regardless of the applied filter.\n\n***\n\n### onColumnFiltersChange?\n\n```ts\noptional onColumnFiltersChange: OnChangeFn<ColumnFiltersState>;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.types.ts:278](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.types.ts#L278)\n\nCalled with an updater when column filter state changes. Pair this with\n`state.columnFilters` when using external state; external atoms can own the\nslice without this callback.\n"}
