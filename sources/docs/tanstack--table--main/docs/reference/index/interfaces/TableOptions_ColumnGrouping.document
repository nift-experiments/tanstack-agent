 mode here."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"manualgrouping","children":[{"type":"text","value":"manualGrouping?"}]},{"type":"code","value":"optional manualGrouping: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L106","children":[{"type":"text","value":"features/column-grouping/columnGroupingFeature.types.ts:106"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Enables manual grouping. If this option is set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", the table will not automatically group rows using "},{"type":"inlineCode","value":"getGroupedRowModel()"},{"type":"text","value":" and instead will expect you to manually group the rows before passing them to the table. This is useful if you are doing server-side grouping and aggregation."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"ongroupingchange","children":[{"type":"text","value":"onGroupingChange?"}]},{"type":"code","value":"optional onGroupingChange: OnChangeFn<GroupingState>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L112","children":[{"type":"text","value":"features/column-grouping/columnGroupingFeature.types.ts:112"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called with an updater when grouping state changes. Pair this with\n"},{"type":"inlineCode","value":"state.grouping"},{"type":"text","value":" when using external state; external atoms can own the\nslice without this callback."}]}],"headings":[{"id":"interface-tableoptions-columngrouping","text":"Interface: TableOptions_ColumnGrouping","level":1},{"id":"properties","text":"Properties","level":2},{"id":"enablegrouping","text":"enableGrouping?","level":3},{"id":"groupedcolumnmode","text":"groupedColumnMode?","level":3},{"id":"manualgrouping","text":"manualGrouping?","level":3},{"id":"ongroupingchange","text":"onGroupingChange?","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Interface: TableOptions\\_ColumnGrouping\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:94](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L94)\n\n## Properties\n\n### enableGrouping?\n\n```ts\noptional enableGrouping: boolean;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:98](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L98)\n\nAllows columns to be grouped for this table.\n\n***\n\n### groupedColumnMode?\n\n```ts\noptional groupedColumnMode: false | \"reorder\" | \"remove\";\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:102](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L102)\n\nGrouping columns are automatically reordered by default to the start of the columns list. If you would rather remove them or leave them as-is, set the appropriate mode here.\n\n***\n\n### manualGrouping?\n\n```ts\noptional manualGrouping: boolean;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:106](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L106)\n\nEnables manual grouping. If this option is set to `true`, the table will not automatically group rows using `getGroupedRowModel()` and instead will expect you to manually group the rows before passing them to the table. This is useful if you are doing server-side grouping and aggregation.\n\n***\n\n### onGroupingChange?\n\n```ts\noptional onGroupingChange: OnChangeFn<GroupingState>;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:112](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L112)\n\nCalled with an updater when grouping state changes. Pair this with\n`state.grouping` when using external state; external atoms can own the\nslice without this callback.\n","originalRawMarkdown":"---\nid: TableOptions_ColumnGrouping\ntitle: TableOptions_ColumnGrouping\n---\n\n# Interface: TableOptions\\_ColumnGrouping\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:94](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L94)\n\n## Properties\n\n### enableGrouping?\n\n```ts\noptional enableGrouping: boolean;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:98](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L98)\n\nAllows columns to be grouped for this table.\n\n***\n\n### groupedColumnMode?\n\n```ts\noptional groupedColumnMode: false | \"reorder\" | \"remove\";\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:102](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L102)\n\nGrouping columns are automatically reordered by default to the start of the columns list. If you would rather remove them or leave them as-is, set the appropriate mode here.\n\n***\n\n### manualGrouping?\n\n```ts\noptional manualGrouping: boolean;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:106](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L106)\n\nEnables manual grouping. If this option is set to `true`, the table will not automatically group rows using `getGroupedRowModel()` and instead will expect you to manually group the rows before passing them to the table. This is useful if you are doing server-side grouping and aggregation.\n\n***\n\n### onGroupingChange?\n\n```ts\noptional onGroupingChange: OnChangeFn<GroupingState>;\n```\n\nDefined in: [features/column-grouping/columnGroupingFeature.types.ts:112](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-grouping/columnGroupingFeature.types.ts#L112)\n\nCalled with an updater when grouping state changes. Pair this with\n`state.grouping` when using external state; external atoms can own the\nslice without this callback.\n"}
