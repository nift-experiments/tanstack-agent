eature.types.ts:43"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Enables automatic expanded-state resets when page-altering table state changes."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"enableexpanding","children":[{"type":"text","value":"enableExpanding?"}]},{"type":"code","value":"optional enableExpanding: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L47","children":[{"type":"text","value":"features/row-expanding/rowExpandingFeature.types.ts:47"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Allows rows with subRows to be expanded."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getisrowexpanded","children":[{"type":"text","value":"getIsRowExpanded()?"}]},{"type":"code","value":"optional getIsRowExpanded: (row) => boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L51","children":[{"type":"text","value":"features/row-expanding/rowExpandingFeature.types.ts:51"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If provided, allows you to override the default behavior of determining whether a row is currently expanded."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"row","children":[{"type":"text","value":"row"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Row.md","children":[{"type":"inlineCode","value":"Row"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"getrowcanexpand","children":[{"type":"text","value":"getRowCanExpand()?"}]},{"type":"code","value":"optional getRowCanExpand: (row) => boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L55","children":[{"type":"text","value":"features/row-expanding/rowExpandingFeature.types.ts:55"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If provided, allows you to override the default behavior of determining whether a row can be expanded."}]},{"type":"heading","depth":4,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"row-2","children":[{"type":"text","value":"row"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/Row.md","children":[{"type":"inlineCode","value":"Row"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":4,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"manualexpanding","children":[{"type":"text","value":"manualExpanding?"}]},{"type":"code","value":"optional manualExpanding: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L59","children":[{"type":"text","value":"features/row-expanding/rowExpandingFeature.types.ts:59"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Enables manual row expansion. If this is set to "},{"type":"inlineCode","value":"true"},{"type":"text","value":", "},{"type":"inlineCode","value":"getExpandedRowModel"},{"type":"text","value":" will not be used to expand rows and you would be expected to perform the expansion in your own data model. This is useful if you are doing server-side expansion."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onexpandedchange","children":[{"type":"text","value":"onExpandedChange?"}]},{"type":"code","value":"optional onExpandedChange: OnChangeFn<ExpandedState>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L65","children":[{"type":"text","value":"features/row-expanding/rowExpandingFeature.types.ts:65"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called with an updater when expanded state changes. Pair this with\n"},{"type":"inlineCode","value":"state.expanded"},{"type":"text","value":" when using external state; external atoms can own the\nslice without this callback."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"paginateexpandedrows","children":[{"type":"text","value":"paginateExpandedRows?"}]},{"type":"code","value":"optional paginateExpandedRows: boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L69","children":[{"type":"text","value":"features/row-expanding/rowExpandingFeature.types.ts:69"}]}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inlineCode","value":"true"},{"type":"text","value":" expanded rows will be paginated along with the rest of the table (which means expanded rows may span multiple pages). If "},{"type":"inlineCode","value":"false"},{"type":"text","value":" expanded rows will not be considered for pagination (which means expanded rows will always render on their parent's page). This also means more rows will be rendered than the set page size."}]}],"headings":[{"id":"interface-tableoptions-rowexpandingtfeatures-tdata","text":"Interface: TableOptions_RowExpanding<TFeatures, TData>","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"autoresetexpanded","text":"autoResetExpanded?","level":3},{"id":"enableexpanding","text":"enableExpanding?","level":3},{"id":"getisrowexpanded","text":"getIsRowExpanded()?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"row","text":"row","level":5},{"id":"returns","text":"Returns","level":4},{"id":"getrowcanexpand","text":"getRowCanExpand()?","level":3},{"id":"parameters-2","text":"Parameters","level":4},{"id":"row-2","text":"row","level":5},{"id":"returns-2","text":"Returns","level":4},{"id":"manualexpanding","text":"manualExpanding?","level":3},{"id":"onexpandedchange","text":"onExpandedChange?","level":3},{"id":"paginateexpandedrows","text":"paginateExpandedRows?","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Interface: TableOptions\\_RowExpanding\\<TFeatures, TData\\>\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:36](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L36)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### autoResetExpanded?\n\n```ts\noptional autoResetExpanded: boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:43](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L43)\n\nEnables automatic expanded-state resets when page-altering table state changes.\n\n***\n\n### enableExpanding?\n\n```ts\noptional enableExpanding: boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:47](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L47)\n\nAllows rows with subRows to be expanded.\n\n***\n\n### getIsRowExpanded()?\n\n```ts\noptional getIsRowExpanded: (row) => boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:51](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L51)\n\nIf provided, allows you to override the default behavior of determining whether a row is currently expanded.\n\n#### Parameters\n\n##### row\n\n[`Row`](../type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n#### Returns\n\n`boolean`\n\n***\n\n### getRowCanExpand()?\n\n```ts\noptional getRowCanExpand: (row) => boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:55](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L55)\n\nIf provided, allows you to override the default behavior of determining whether a row can be expanded.\n\n#### Parameters\n\n##### row\n\n[`Row`](../type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n#### Returns\n\n`boolean`\n\n***\n\n### manualExpanding?\n\n```ts\noptional manualExpanding: boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:59](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L59)\n\nEnables manual row expansion. If this is set to `true`, `getExpandedRowModel` will not be used to expand rows and you would be expected to perform the expansion in your own data model. This is useful if you are doing server-side expansion.\n\n***\n\n### onExpandedChange?\n\n```ts\noptional onExpandedChange: OnChangeFn<ExpandedState>;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:65](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L65)\n\nCalled with an updater when expanded state changes. Pair this with\n`state.expanded` when using external state; external atoms can own the\nslice without this callback.\n\n***\n\n### paginateExpandedRows?\n\n```ts\noptional paginateExpandedRows: boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:69](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L69)\n\nIf `true` expanded rows will be paginated along with the rest of the table (which means expanded rows may span multiple pages). If `false` expanded rows will not be considered for pagination (which means expanded rows will always render on their parent's page). This also means more rows will be rendered than the set page size.\n","originalRawMarkdown":"---\nid: TableOptions_RowExpanding\ntitle: TableOptions_RowExpanding\n---\n\n# Interface: TableOptions\\_RowExpanding\\<TFeatures, TData\\>\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:36](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L36)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### autoResetExpanded?\n\n```ts\noptional autoResetExpanded: boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:43](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L43)\n\nEnables automatic expanded-state resets when page-altering table state changes.\n\n***\n\n### enableExpanding?\n\n```ts\noptional enableExpanding: boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:47](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L47)\n\nAllows rows with subRows to be expanded.\n\n***\n\n### getIsRowExpanded()?\n\n```ts\noptional getIsRowExpanded: (row) => boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:51](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L51)\n\nIf provided, allows you to override the default behavior of determining whether a row is currently expanded.\n\n#### Parameters\n\n##### row\n\n[`Row`](../type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n#### Returns\n\n`boolean`\n\n***\n\n### getRowCanExpand()?\n\n```ts\noptional getRowCanExpand: (row) => boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:55](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L55)\n\nIf provided, allows you to override the default behavior of determining whether a row can be expanded.\n\n#### Parameters\n\n##### row\n\n[`Row`](../type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n#### Returns\n\n`boolean`\n\n***\n\n### manualExpanding?\n\n```ts\noptional manualExpanding: boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:59](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L59)\n\nEnables manual row expansion. If this is set to `true`, `getExpandedRowModel` will not be used to expand rows and you would be expected to perform the expansion in your own data model. This is useful if you are doing server-side expansion.\n\n***\n\n### onExpandedChange?\n\n```ts\noptional onExpandedChange: OnChangeFn<ExpandedState>;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:65](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L65)\n\nCalled with an updater when expanded state changes. Pair this with\n`state.expanded` when using external state; external atoms can own the\nslice without this callback.\n\n***\n\n### paginateExpandedRows?\n\n```ts\noptional paginateExpandedRows: boolean;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.types.ts:69](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.types.ts#L69)\n\nIf `true` expanded rows will be paginated along with the rest of the table (which means expanded rows may span multiple pages). If `false` expanded rows will not be considered for pagination (which means expanded rows will always render on their parent's page). This also means more rows will be rendered than the set page size.\n"}
