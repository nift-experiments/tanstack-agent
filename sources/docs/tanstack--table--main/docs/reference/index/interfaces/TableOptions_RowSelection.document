ticBreak"},{"type":"heading","depth":3,"id":"enablesubrowselection","children":[{"type":"text","value":"enableSubRowSelection?"}]},{"type":"code","value":"optional enableSubRowSelection: boolean | (row) => boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L62","children":[{"type":"text","value":"features/row-selection/rowSelectionFeature.types.ts:62"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Controls whether selecting a parent row also selects its subRows."}]},{"type":"paragraph","children":[{"type":"text","value":"Provide a predicate to decide per row. This is most useful with expanding or\ngrouping features and defaults to "},{"type":"inlineCode","value":"true"},{"type":"text","value":". Select-all and the all-selected\ngetters also skip descendants of parents that block sub-row selection."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"isrowrangeselectionevent","children":[{"type":"text","value":"isRowRangeSelectionEvent()?"}]},{"type":"code","value":"optional isRowRangeSelectionEvent: (event) => boolean;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L70","children":[{"type":"text","value":"features/row-selection/rowSelectionFeature.types.ts:70"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Determines whether a row-selection handler event should select or\ndeselect the inclusive range from the most recent handler interaction."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, events with "},{"type":"inlineCode","value":"shiftKey"},{"type":"text","value":" directly on the event or on\n"},{"type":"inlineCode","value":"event.nativeEvent"},{"type":"text","value":" are treated as range-selection events."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"event","children":[{"type":"text","value":"event"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"onrowselectionchange","children":[{"type":"text","value":"onRowSelectionChange?"}]},{"type":"code","value":"optional onRowSelectionChange: OnChangeFn<RowSelectionState>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L76","children":[{"type":"text","value":"features/row-selection/rowSelectionFeature.types.ts:76"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Called with an updater when row selection state changes. Pair this with\n"},{"type":"inlineCode","value":"state.rowSelection"},{"type":"text","value":" when using external state; external atoms can own the\nslice without this callback."}]}],"headings":[{"id":"interface-tableoptions-rowselectiontfeatures-tdata","text":"Interface: TableOptions_RowSelection<TFeatures, TData>","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"enablemultirowselection","text":"enableMultiRowSelection?","level":3},{"id":"enablerowrangeselection","text":"enableRowRangeSelection?","level":3},{"id":"enablerowselection","text":"enableRowSelection?","level":3},{"id":"enablesubrowselection","text":"enableSubRowSelection?","level":3},{"id":"isrowrangeselectionevent","text":"isRowRangeSelectionEvent()?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"event","text":"event","level":5},{"id":"returns","text":"Returns","level":4},{"id":"onrowselectionchange","text":"onRowSelectionChange?","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Interface: TableOptions\\_RowSelection\\<TFeatures, TData\\>\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:34](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L34)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### enableMultiRowSelection?\n\n```ts\noptional enableMultiRowSelection: boolean | (row) => boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:48](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L48)\n\nAllows rows to be selected alongside other rows.\n\nProvide a predicate to decide per row. Defaults to `true`.\n\n***\n\n### enableRowRangeSelection?\n\n```ts\noptional enableRowRangeSelection: boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:42](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L42)\n\nEnables inclusive row range selection through\n`row.getToggleSelectedHandler()`. Defaults to `true`.\n\n***\n\n### enableRowSelection?\n\n```ts\noptional enableRowSelection: boolean | (row) => boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:54](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L54)\n\nAllows rows to be selected.\n\nProvide a predicate to decide per row. Defaults to `true`.\n\n***\n\n### enableSubRowSelection?\n\n```ts\noptional enableSubRowSelection: boolean | (row) => boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:62](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L62)\n\nControls whether selecting a parent row also selects its subRows.\n\nProvide a predicate to decide per row. This is most useful with expanding or\ngrouping features and defaults to `true`. Select-all and the all-selected\ngetters also skip descendants of parents that block sub-row selection.\n\n***\n\n### isRowRangeSelectionEvent()?\n\n```ts\noptional isRowRangeSelectionEvent: (event) => boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:70](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L70)\n\nDetermines whether a row-selection handler event should select or\ndeselect the inclusive range from the most recent handler interaction.\n\nBy default, events with `shiftKey` directly on the event or on\n`event.nativeEvent` are treated as range-selection events.\n\n#### Parameters\n\n##### event\n\n`unknown`\n\n#### Returns\n\n`boolean`\n\n***\n\n### onRowSelectionChange?\n\n```ts\noptional onRowSelectionChange: OnChangeFn<RowSelectionState>;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:76](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L76)\n\nCalled with an updater when row selection state changes. Pair this with\n`state.rowSelection` when using external state; external atoms can own the\nslice without this callback.\n","originalRawMarkdown":"---\nid: TableOptions_RowSelection\ntitle: TableOptions_RowSelection\n---\n\n# Interface: TableOptions\\_RowSelection\\<TFeatures, TData\\>\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:34](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L34)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### enableMultiRowSelection?\n\n```ts\noptional enableMultiRowSelection: boolean | (row) => boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:48](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L48)\n\nAllows rows to be selected alongside other rows.\n\nProvide a predicate to decide per row. Defaults to `true`.\n\n***\n\n### enableRowRangeSelection?\n\n```ts\noptional enableRowRangeSelection: boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:42](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L42)\n\nEnables inclusive row range selection through\n`row.getToggleSelectedHandler()`. Defaults to `true`.\n\n***\n\n### enableRowSelection?\n\n```ts\noptional enableRowSelection: boolean | (row) => boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:54](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L54)\n\nAllows rows to be selected.\n\nProvide a predicate to decide per row. Defaults to `true`.\n\n***\n\n### enableSubRowSelection?\n\n```ts\noptional enableSubRowSelection: boolean | (row) => boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:62](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L62)\n\nControls whether selecting a parent row also selects its subRows.\n\nProvide a predicate to decide per row. This is most useful with expanding or\ngrouping features and defaults to `true`. Select-all and the all-selected\ngetters also skip descendants of parents that block sub-row selection.\n\n***\n\n### isRowRangeSelectionEvent()?\n\n```ts\noptional isRowRangeSelectionEvent: (event) => boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:70](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L70)\n\nDetermines whether a row-selection handler event should select or\ndeselect the inclusive range from the most recent handler interaction.\n\nBy default, events with `shiftKey` directly on the event or on\n`event.nativeEvent` are treated as range-selection events.\n\n#### Parameters\n\n##### event\n\n`unknown`\n\n#### Returns\n\n`boolean`\n\n***\n\n### onRowSelectionChange?\n\n```ts\noptional onRowSelectionChange: OnChangeFn<RowSelectionState>;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.types.ts:76](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.types.ts#L76)\n\nCalled with an updater when row selection state changes. Pair this with\n`state.rowSelection` when using external state; external atoms can own the\nslice without this callback.\n"}
