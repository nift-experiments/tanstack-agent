"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The data for the table to display. When the "},{"type":"inlineCode","value":"data"},{"type":"text","value":" option changes reference, the table will reprocess the data."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"features","children":[{"type":"text","value":"features"}]},{"type":"code","value":"readonly features: TFeatures & ValidateFeatureSlots<TFeatures>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L101","children":[{"type":"text","value":"core/table/coreTablesFeature.types.ts:101"}]}]},{"type":"paragraph","children":[{"type":"text","value":"The feature modules registered on this table instance."}]},{"type":"paragraph","children":[{"type":"text","value":"Feature registration controls which state slices, options, and prototype\nAPIs are available. This object also carries the table's row model\nfactories ("},{"type":"inlineCode","value":"sortedRowModel"},{"type":"text","value":", "},{"type":"inlineCode","value":"filteredRowModel"},{"type":"text","value":", etc.), row model function\nregistries ("},{"type":"inlineCode","value":"sortFns"},{"type":"text","value":", "},{"type":"inlineCode","value":"filterFns"},{"type":"text","value":", "},{"type":"inlineCode","value":"aggregationFns"},{"type":"text","value":"), and type-only meta\nslots ("},{"type":"inlineCode","value":"tableMeta"},{"type":"text","value":", "},{"type":"inlineCode","value":"columnMeta"},{"type":"text","value":")."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"initialstate","children":[{"type":"text","value":"initialState?"}]},{"type":"code","value":"readonly optional initialState: Partial<ExtractFeatureMapTypes<TFeatures, TableState_FeatureMap>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L131","children":[{"type":"text","value":"core/table/coreTablesFeature.types.ts:131"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optionally provide starting values for registered table state slices.\nFeature reset APIs use this value by default, and many reset APIs accept\n"},{"type":"inlineCode","value":"true"},{"type":"text","value":" to reset to that feature's blank/default state instead. Changing this\nobject later does not reset table state, so it does not need to be stable."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"key","children":[{"type":"text","value":"key?"}]},{"type":"code","value":"readonly optional key: string;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L124","children":[{"type":"text","value":"core/table/coreTablesFeature.types.ts:124"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optional key used to identify this table instance."}]},{"type":"paragraph","children":[{"type":"text","value":"This is used by TanStack Table Devtools to register and select tables. It is\nnot required unless the table is passed to devtools."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"mergeoptions","children":[{"type":"text","value":"mergeOptions()?"}]},{"type":"code","value":"readonly optional mergeOptions: (defaultOptions, options) => TableOptions<TFeatures, TData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L135","children":[{"type":"text","value":"core/table/coreTablesFeature.types.ts:135"}]}]},{"type":"paragraph","children":[{"type":"text","value":"This option is used to optionally implement the merging of table options."}]},{"type":"heading","depth":4,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":5,"id":"defaultoptions","children":[{"type":"text","value":"defaultOptions"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/TableOptions.md","children":[{"type":"inlineCode","value":"TableOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":5,"id":"options","children":[{"type":"text","value":"options"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"link","href":"../type-aliases/TableOptions.md","children":[{"type":"inlineCode","value":"TableOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">>"}]},{"type":"heading","depth":4,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../type-aliases/TableOptions.md","children":[{"type":"inlineCode","value":"TableOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"meta","children":[{"type":"text","value":"meta?"}]},{"type":"code","value":"readonly optional meta: ExtractTableMeta<TFeatures, TData>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L145","children":[{"type":"text","value":"core/table/coreTablesFeature.types.ts:145"}]}]},{"type":"paragraph","children":[{"type":"text","value":"You can pass any object to "},{"type":"inlineCode","value":"options.meta"},{"type":"text","value":" and access it anywhere the "},{"type":"inlineCode","value":"table"},{"type":"text","value":" is available via "},{"type":"inlineCode","value":"table.options.meta"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Declare its type per-table via the "},{"type":"inlineCode","value":"tableMeta"},{"type":"text","value":" type-only slot on the\n"},{"type":"inlineCode","value":"features"},{"type":"text","value":" option, or globally via declaration merging on "},{"type":"inlineCode","value":"TableMeta"},{"type":"text","value":"."}]},{"type":"thematicBreak"},{"type":"heading","depth":3,"id":"state","children":[{"type":"text","value":"state?"}]},{"type":"code","value":"readonly optional state: Partial<ExtractFeatureMapTypes<TFeatures, TableState_FeatureMap>>;","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Defined in: "},{"type":"link","href":"https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L153","children":[{"type":"text","value":"core/table/coreTablesFeature.types.ts:153"}]}]},{"type":"paragraph","children":[{"type":"text","value":"Optionally provide externally managed values for individual state slices."}]},{"type":"paragraph","children":[{"type":"text","value":"Pair each slice with its matching "},{"type":"inlineCode","value":"on[State]Change"},{"type":"text","value":" callback so table state\nupdates can be persisted outside the table. External atoms take precedence\nover this option when both are provided for the same slice."}]}],"headings":[{"id":"interface-tableoptions-tabletfeatures-tdata","text":"Interface: TableOptions_Table<TFeatures, TData>","level":1},{"id":"extended-by","text":"Extended by","level":2},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"properties","text":"Properties","level":2},{"id":"atoms","text":"atoms?","level":3},{"id":"autoresetall","text":"autoResetAll?","level":3},{"id":"data","text":"data","level":3},{"id":"features","text":"features","level":3},{"id":"initialstate","text":"initialState?","level":3},{"id":"key","text":"key?","level":3},{"id":"mergeoptions","text":"mergeOptions()?","level":3},{"id":"parameters","text":"Parameters","level":4},{"id":"defaultoptions","text":"defaultOptions","level":5},{"id":"options","text":"options","level":5},{"id":"returns","text":"Returns","level":4},{"id":"meta","text":"meta?","level":3},{"id":"state","text":"state?","level":3}]},"frameworks":[],"downloadMarkdown":"\n# Interface: TableOptions\\_Table\\<TFeatures, TData\\>\n\nDefined in: [core/table/coreTablesFeature.types.ts:88](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L88)\n\n## Extended by\n\n- [`TableOptions_Core`](TableOptions_Core.md)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### atoms?\n\n```ts\nreadonly optional atoms: Partial<{ [K in string | number | symbol]: Atom<ExtractFeatureMapTypes<TFeatures, TableState_FeatureMap>[K]> }>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:109](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L109)\n\nOptionally, provide your own external writable atoms for individual state slices.\nWhen an atom is provided for a given slice, it takes precedence over `options.state[key]`\nand the internal base atom for that slice. Feature state update APIs write through\nthe corresponding atom updater, so external atoms are the preferred v9 ownership\nmodel for app-managed table state slices.\n\n***\n\n### autoResetAll?\n\n```ts\nreadonly optional autoResetAll: boolean;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:113](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L113)\n\nSet this option to override any of the `autoReset...` feature options.\n\n***\n\n### data\n\n```ts\nreadonly data: readonly TData[];\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:117](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L117)\n\nThe data for the table to display. When the `data` option changes reference, the table will reprocess the data.\n\n***\n\n### features\n\n```ts\nreadonly features: TFeatures & ValidateFeatureSlots<TFeatures>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:101](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L101)\n\nThe feature modules registered on this table instance.\n\nFeature registration controls which state slices, options, and prototype\nAPIs are available. This object also carries the table's row model\nfactories (`sortedRowModel`, `filteredRowModel`, etc.), row model function\nregistries (`sortFns`, `filterFns`, `aggregationFns`), and type-only meta\nslots (`tableMeta`, `columnMeta`).\n\n***\n\n### initialState?\n\n```ts\nreadonly optional initialState: Partial<ExtractFeatureMapTypes<TFeatures, TableState_FeatureMap>>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:131](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L131)\n\nOptionally provide starting values for registered table state slices.\nFeature reset APIs use this value by default, and many reset APIs accept\n`true` to reset to that feature's blank/default state instead. Changing this\nobject later does not reset table state, so it does not need to be stable.\n\n***\n\n### key?\n\n```ts\nreadonly optional key: string;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:124](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L124)\n\nOptional key used to identify this table instance.\n\nThis is used by TanStack Table Devtools to register and select tables. It is\nnot required unless the table is passed to devtools.\n\n***\n\n### mergeOptions()?\n\n```ts\nreadonly optional mergeOptions: (defaultOptions, options) => TableOptions<TFeatures, TData>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:135](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L135)\n\nThis option is used to optionally implement the merging of table options.\n\n#### Parameters\n\n##### defaultOptions\n\n[`TableOptions`](../type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\n\n##### options\n\n`Partial`\\<[`TableOptions`](../type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\\>\n\n#### Returns\n\n[`TableOptions`](../type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\n\n***\n\n### meta?\n\n```ts\nreadonly optional meta: ExtractTableMeta<TFeatures, TData>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:145](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L145)\n\nYou can pass any object to `options.meta` and access it anywhere the `table` is available via `table.options.meta`.\n\nDeclare its type per-table via the `tableMeta` type-only slot on the\n`features` option, or globally via declaration merging on `TableMeta`.\n\n***\n\n### state?\n\n```ts\nreadonly optional state: Partial<ExtractFeatureMapTypes<TFeatures, TableState_FeatureMap>>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:153](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L153)\n\nOptionally provide externally managed values for individual state slices.\n\nPair each slice with its matching `on[State]Change` callback so table state\nupdates can be persisted outside the table. External atoms take precedence\nover this option when both are provided for the same slice.\n","originalRawMarkdown":"---\nid: TableOptions_Table\ntitle: TableOptions_Table\n---\n\n# Interface: TableOptions\\_Table\\<TFeatures, TData\\>\n\nDefined in: [core/table/coreTablesFeature.types.ts:88](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L88)\n\n## Extended by\n\n- [`TableOptions_Core`](TableOptions_Core.md)\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../type-aliases/RowData.md)\n\n## Properties\n\n### atoms?\n\n```ts\nreadonly optional atoms: Partial<{ [K in string | number | symbol]: Atom<ExtractFeatureMapTypes<TFeatures, TableState_FeatureMap>[K]> }>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:109](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L109)\n\nOptionally, provide your own external writable atoms for individual state slices.\nWhen an atom is provided for a given slice, it takes precedence over `options.state[key]`\nand the internal base atom for that slice. Feature state update APIs write through\nthe corresponding atom updater, so external atoms are the preferred v9 ownership\nmodel for app-managed table state slices.\n\n***\n\n### autoResetAll?\n\n```ts\nreadonly optional autoResetAll: boolean;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:113](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L113)\n\nSet this option to override any of the `autoReset...` feature options.\n\n***\n\n### data\n\n```ts\nreadonly data: readonly TData[];\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:117](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L117)\n\nThe data for the table to display. When the `data` option changes reference, the table will reprocess the data.\n\n***\n\n### features\n\n```ts\nreadonly features: TFeatures & ValidateFeatureSlots<TFeatures>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:101](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L101)\n\nThe feature modules registered on this table instance.\n\nFeature registration controls which state slices, options, and prototype\nAPIs are available. This object also carries the table's row model\nfactories (`sortedRowModel`, `filteredRowModel`, etc.), row model function\nregistries (`sortFns`, `filterFns`, `aggregationFns`), and type-only meta\nslots (`tableMeta`, `columnMeta`).\n\n***\n\n### initialState?\n\n```ts\nreadonly optional initialState: Partial<ExtractFeatureMapTypes<TFeatures, TableState_FeatureMap>>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:131](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L131)\n\nOptionally provide starting values for registered table state slices.\nFeature reset APIs use this value by default, and many reset APIs accept\n`true` to reset to that feature's blank/default state instead. Changing this\nobject later does not reset table state, so it does not need to be stable.\n\n***\n\n### key?\n\n```ts\nreadonly optional key: string;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:124](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L124)\n\nOptional key used to identify this table instance.\n\nThis is used by TanStack Table Devtools to register and select tables. It is\nnot required unless the table is passed to devtools.\n\n***\n\n### mergeOptions()?\n\n```ts\nreadonly optional mergeOptions: (defaultOptions, options) => TableOptions<TFeatures, TData>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:135](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L135)\n\nThis option is used to optionally implement the merging of table options.\n\n#### Parameters\n\n##### defaultOptions\n\n[`TableOptions`](../type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\n\n##### options\n\n`Partial`\\<[`TableOptions`](../type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\\>\n\n#### Returns\n\n[`TableOptions`](../type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\n\n***\n\n### meta?\n\n```ts\nreadonly optional meta: ExtractTableMeta<TFeatures, TData>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:145](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L145)\n\nYou can pass any object to `options.meta` and access it anywhere the `table` is available via `table.options.meta`.\n\nDeclare its type per-table via the `tableMeta` type-only slot on the\n`features` option, or globally via declaration merging on `TableMeta`.\n\n***\n\n### state?\n\n```ts\nreadonly optional state: Partial<ExtractFeatureMapTypes<TFeatures, TableState_FeatureMap>>;\n```\n\nDefined in: [core/table/coreTablesFeature.types.ts:153](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.types.ts#L153)\n\nOptionally provide externally managed values for individual state slices.\n\nPair each slice with its matching `on[State]Change` callback so table state\nupdates can be persisted outside the table. External atoms take precedence\nover this option when both are provided for the same slice.\n"}
