ype":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"cell","children":[{"type":"text","value":"cell"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/Cell.md","children":[{"type":"inlineCode","value":"Cell"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"contextdocument","children":[{"type":"text","value":"_contextDocument?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Document"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"(e): void;","lang":"ts"},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"e","children":[{"type":"text","value":"e"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"<td onMouseDown={cell.getSelectionStartHandler()} />","lang":"tsx"}],"headings":[{"id":"function-cell-getselectionstarthandler","text":"Function: cell_getSelectionStartHandler()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"cell","text":"cell","level":3},{"id":"contextdocument","text":"_contextDocument?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"parameters-2","text":"Parameters","level":3},{"id":"e","text":"e","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: cell\\_getSelectionStartHandler()\n\n```ts\nfunction cell_getSelectionStartHandler<TFeatures, TData, TValue>(cell, _contextDocument?): (e) => void;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.utils.ts:1411](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.utils.ts#L1411)\n\nCreates a handler that begins a selection at this cell.\n\nFollows `header_getResizeHandler`: the enable check is resolved once outside\nthe returned closure and guarded again inside it, the document is injectable\nfor SSR and cross-document rendering, and the document-level `mouseup`\nlistener is attached here so a drag released outside the table still ends.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### cell\n\n[`Cell`](../../index/type-aliases/Cell.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n### \\_contextDocument?\n\n`Document`\n\n## Returns\n\n```ts\n(e): void;\n```\n\n### Parameters\n\n#### e\n\n`unknown`\n\n### Returns\n\n`void`\n\n## Example\n\n```tsx\n<td onMouseDown={cell.getSelectionStartHandler()} />\n```\n","originalRawMarkdown":"---\nid: cell_getSelectionStartHandler\ntitle: cell_getSelectionStartHandler\n---\n\n# Function: cell\\_getSelectionStartHandler()\n\n```ts\nfunction cell_getSelectionStartHandler<TFeatures, TData, TValue>(cell, _contextDocument?): (e) => void;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.utils.ts:1411](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.utils.ts#L1411)\n\nCreates a handler that begins a selection at this cell.\n\nFollows `header_getResizeHandler`: the enable check is resolved once outside\nthe returned closure and guarded again inside it, the document is injectable\nfor SSR and cross-document rendering, and the document-level `mouseup`\nlistener is attached here so a drag released outside the table still ends.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### cell\n\n[`Cell`](../../index/type-aliases/Cell.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n### \\_contextDocument?\n\n`Document`\n\n## Returns\n\n```ts\n(e): void;\n```\n\n### Parameters\n\n#### e\n\n`unknown`\n\n### Returns\n\n`void`\n\n## Example\n\n```tsx\n<td onMouseDown={cell.getSelectionStartHandler()} />\n```\n"}
