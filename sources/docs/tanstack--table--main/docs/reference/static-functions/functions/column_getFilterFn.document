","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"column","children":[{"type":"text","value":"column"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Column_Internal.md","children":[{"type":"inlineCode","value":"Column_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"| "},{"type":"link","href":"../../index/interfaces/FilterFn.md","children":[{"type":"inlineCode","value":"FilterFn"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">\n| "},{"type":"inlineCode","value":"undefined"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const filterFn = column_getFilterFn(column)","lang":"ts"}],"headings":[{"id":"function-column-getfilterfn","text":"Function: column_getFilterFn()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"column","text":"column","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: column\\_getFilterFn()\n\n```ts\nfunction column_getFilterFn<TFeatures, TData, TValue>(column):\n  | FilterFn<TFeatures, TData>\n  | undefined;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.utils.ts:109](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.utils.ts#L109)\n\nResolves the filter function configured for a column.\n\nFunction-valued `columnDef.filterFn` is returned directly, `'auto'` delegates\nto `column_getAutoFilterFn`, and string values are looked up in the table's\nfilter function registry.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n  \\| [`FilterFn`](../../index/interfaces/FilterFn.md)\\<`TFeatures`, `TData`\\>\n  \\| `undefined`\n\n## Example\n\n```ts\nconst filterFn = column_getFilterFn(column)\n```\n","originalRawMarkdown":"---\nid: column_getFilterFn\ntitle: column_getFilterFn\n---\n\n# Function: column\\_getFilterFn()\n\n```ts\nfunction column_getFilterFn<TFeatures, TData, TValue>(column):\n  | FilterFn<TFeatures, TData>\n  | undefined;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.utils.ts:109](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.utils.ts#L109)\n\nResolves the filter function configured for a column.\n\nFunction-valued `columnDef.filterFn` is returned directly, `'auto'` delegates\nto `column_getAutoFilterFn`, and string values are looked up in the table's\nfilter function registry.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n  \\| [`FilterFn`](../../index/interfaces/FilterFn.md)\\<`TFeatures`, `TData`\\>\n  \\| `undefined`\n\n## Example\n\n```ts\nconst filterFn = column_getFilterFn(column)\n```\n"}
