a"}]}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"column","children":[{"type":"text","value":"column"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Column_Internal.md","children":[{"type":"inlineCode","value":"Column_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"position","children":[{"type":"text","value":"position?"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/ColumnPinningPosition.md","children":[{"type":"inlineCode","value":"ColumnPinningPosition"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"center\""}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const index = column_getIndex(column, 'center')","lang":"ts"}],"headings":[{"id":"function-column-getindex","text":"Function: column_getIndex()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"column","text":"column","level":3},{"id":"position","text":"position?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: column\\_getIndex()\n\n```ts\nfunction column_getIndex<TFeatures, TData, TValue>(column, position?): number;\n```\n\nDefined in: [features/column-ordering/columnOrderingFeature.utils.ts:81](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-ordering/columnOrderingFeature.utils.ts#L81)\n\nFinds this column's index within a visible pinning region.\n\nPass `'start'`, `'center'`, or `'end'` to search that region; omit the\nposition to search the full visible leaf column list.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n### position?\n\n[`ColumnPinningPosition`](../../index/type-aliases/ColumnPinningPosition.md) | `\"center\"`\n\n## Returns\n\n`number`\n\n## Example\n\n```ts\nconst index = column_getIndex(column, 'center')\n```\n","originalRawMarkdown":"---\nid: column_getIndex\ntitle: column_getIndex\n---\n\n# Function: column\\_getIndex()\n\n```ts\nfunction column_getIndex<TFeatures, TData, TValue>(column, position?): number;\n```\n\nDefined in: [features/column-ordering/columnOrderingFeature.utils.ts:81](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-ordering/columnOrderingFeature.utils.ts#L81)\n\nFinds this column's index within a visible pinning region.\n\nPass `'start'`, `'center'`, or `'end'` to search that region; omit the\nposition to search the full visible leaf column list.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n### position?\n\n[`ColumnPinningPosition`](../../index/type-aliases/ColumnPinningPosition.md) | `\"center\"`\n\n## Returns\n\n`number`\n\n## Example\n\n```ts\nconst index = column_getIndex(column, 'center')\n```\n"}
