":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/interfaces/TableFeatures.md","children":[{"type":"inlineCode","value":"TableFeatures"}]}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"column","children":[{"type":"text","value":"column"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Column_Internal.md","children":[{"type":"inlineCode","value":"Column_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/ColumnPinningPosition.md","children":[{"type":"inlineCode","value":"ColumnPinningPosition"}]}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const position = column_getIsPinned(column)","lang":"ts"}],"headings":[{"id":"function-column-getispinned","text":"Function: column_getIsPinned()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"column","text":"column","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: column\\_getIsPinned()\n\n```ts\nfunction column_getIsPinned<TFeatures, TData, TValue>(column): ColumnPinningPosition;\n```\n\nDefined in: [features/column-pinning/columnPinningFeature.utils.ts:143](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-pinning/columnPinningFeature.utils.ts#L143)\n\nReads this column's current pinning region.\n\nGroup columns report `'start'` or `'end'` when any leaf column is pinned in\nthat region. Unpinned columns return `false`.\n\n`start` and `end` are logical positions. In LTR languages/layouts, `start`\nusually corresponds to left and `end` to right. In RTL languages/layouts,\n`start` usually corresponds to right and `end` to left.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n[`ColumnPinningPosition`](../../index/type-aliases/ColumnPinningPosition.md)\n\n## Example\n\n```ts\nconst position = column_getIsPinned(column)\n```\n","originalRawMarkdown":"---\nid: column_getIsPinned\ntitle: column_getIsPinned\n---\n\n# Function: column\\_getIsPinned()\n\n```ts\nfunction column_getIsPinned<TFeatures, TData, TValue>(column): ColumnPinningPosition;\n```\n\nDefined in: [features/column-pinning/columnPinningFeature.utils.ts:143](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-pinning/columnPinningFeature.utils.ts#L143)\n\nReads this column's current pinning region.\n\nGroup columns report `'start'` or `'end'` when any leaf column is pinned in\nthat region. Unpinned columns return `false`.\n\n`start` and `end` are logical positions. In LTR languages/layouts, `start`\nusually corresponds to left and `end` to right. In RTL languages/layouts,\n`start` usually corresponds to right and `end` to left.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n[`ColumnPinningPosition`](../../index/type-aliases/ColumnPinningPosition.md)\n\n## Example\n\n```ts\nconst position = column_getIsPinned(column)\n```\n"}
