asis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/interfaces/TableFeatures.md","children":[{"type":"inlineCode","value":"TableFeatures"}]}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"column","children":[{"type":"text","value":"column"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Column_Internal.md","children":[{"type":"inlineCode","value":"Column_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"position","children":[{"type":"text","value":"position?"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/ColumnPinningPosition.md","children":[{"type":"inlineCode","value":"ColumnPinningPosition"}]},{"type":"text","value":" | "},{"type":"inlineCode","value":"\"center\""}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const startOffset = column_getStart(column, 'start')","lang":"ts"}],"headings":[{"id":"function-column-getstart","text":"Function: column_getStart()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"column","text":"column","level":3},{"id":"position","text":"position?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: column\\_getStart()\n\n```ts\nfunction column_getStart<TFeatures, TData, TValue>(column, position?): number;\n```\n\nDefined in: [features/column-sizing/columnSizingFeature.utils.ts:186](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-sizing/columnSizingFeature.utils.ts#L186)\n\nComputes the offset from the start edge of a pinning region to this column.\n\nThe value is the sum of all previous visible leaf column sizes in the\nrequested `'start'`, `'center'`, or `'end'` region.\n\n`start` and `end` are logical positions. In LTR languages/layouts, `start`\nusually corresponds to left and `end` to right. In RTL languages/layouts,\n`start` usually corresponds to right and `end` to left.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n### position?\n\n[`ColumnPinningPosition`](../../index/type-aliases/ColumnPinningPosition.md) | `\"center\"`\n\n## Returns\n\n`number`\n\n## Example\n\n```ts\nconst startOffset = column_getStart(column, 'start')\n```\n","originalRawMarkdown":"---\nid: column_getStart\ntitle: column_getStart\n---\n\n# Function: column\\_getStart()\n\n```ts\nfunction column_getStart<TFeatures, TData, TValue>(column, position?): number;\n```\n\nDefined in: [features/column-sizing/columnSizingFeature.utils.ts:186](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-sizing/columnSizingFeature.utils.ts#L186)\n\nComputes the offset from the start edge of a pinning region to this column.\n\nThe value is the sum of all previous visible leaf column sizes in the\nrequested `'start'`, `'center'`, or `'end'` region.\n\n`start` and `end` are logical positions. In LTR languages/layouts, `start`\nusually corresponds to left and `end` to right. In RTL languages/layouts,\n`start` usually corresponds to right and `end` to left.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n### position?\n\n[`ColumnPinningPosition`](../../index/type-aliases/ColumnPinningPosition.md) | `\"center\"`\n\n## Returns\n\n`number`\n\n## Example\n\n```ts\nconst startOffset = column_getStart(column, 'start')\n```\n"}
