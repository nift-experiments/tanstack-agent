ue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"column","children":[{"type":"text","value":"column"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Column_Internal.md","children":[{"type":"inlineCode","value":"Column_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"any"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"column_setFilterValue(column, (old) => String(old ?? '').trim())","lang":"ts"}],"headings":[{"id":"function-column-setfiltervalue","text":"Function: column_setFilterValue()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"column","text":"column","level":3},{"id":"value","text":"value","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: column\\_setFilterValue()\n\n```ts\nfunction column_setFilterValue<TFeatures, TData, TValue>(column, value): void;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.utils.ts:234](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.utils.ts#L234)\n\nAdds, updates, or removes this column's filter value.\n\nThe incoming value may be an updater. After resolution, `autoRemove` rules\ndecide whether the filter should be removed instead of stored.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n### value\n\n`any`\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ncolumn_setFilterValue(column, (old) => String(old ?? '').trim())\n```\n","originalRawMarkdown":"---\nid: column_setFilterValue\ntitle: column_setFilterValue\n---\n\n# Function: column\\_setFilterValue()\n\n```ts\nfunction column_setFilterValue<TFeatures, TData, TValue>(column, value): void;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.utils.ts:234](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.utils.ts#L234)\n\nAdds, updates, or removes this column's filter value.\n\nThe incoming value may be an updater. After resolution, `autoRemove` rules\ndecide whether the filter should be removed instead of stored.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### column\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n### value\n\n`any`\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ncolumn_setFilterValue(column, (old) => String(old ?? '').trim())\n```\n"}
