tends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"rows","children":[{"type":"text","value":"rows"}]},{"type":"paragraph","children":[{"type":"text","value":"readonly "},{"type":"link","href":"../../index/type-aliases/Row.md","children":[{"type":"inlineCode","value":"Row"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">[]"}]},{"type":"heading","depth":3,"id":"maxdepth","children":[{"type":"text","value":"maxDepth"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"number"},{"type":"text","value":" = "},{"type":"inlineCode","value":"0"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"text","value":"readonly "},{"type":"link","href":"../../index/type-aliases/Row.md","children":[{"type":"inlineCode","value":"Row"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">[]"}]}],"headings":[{"id":"function-normalizeuniqueaggregationrows","text":"Function: normalizeUniqueAggregationRows()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"rows","text":"rows","level":3},{"id":"maxdepth","text":"maxDepth","level":3},{"id":"returns","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: normalizeUniqueAggregationRows()\n\n```ts\nfunction normalizeUniqueAggregationRows<TFeatures, TData>(rows, maxDepth): readonly Row<TFeatures, TData>[];\n```\n\nDefined in: [features/row-aggregation/rowAggregationFeature.utils.ts:145](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-aggregation/rowAggregationFeature.utils.ts#L145)\n\nFrontier selection for rows that are distinct nodes of a single row tree —\nthe row models the table builds itself. Skips `normalizeAggregationRows`'\nduplicate-id guard (disjoint subtrees cannot revisit a row) and returns\n`rows` unchanged when no row descends, so the default `maxDepth: 0` case\ncosts nothing per aggregation.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### rows\n\nreadonly [`Row`](../../index/type-aliases/Row.md)\\<`TFeatures`, `TData`\\>[]\n\n### maxDepth\n\n`number` = `0`\n\n## Returns\n\nreadonly [`Row`](../../index/type-aliases/Row.md)\\<`TFeatures`, `TData`\\>[]\n","originalRawMarkdown":"---\nid: normalizeUniqueAggregationRows\ntitle: normalizeUniqueAggregationRows\n---\n\n# Function: normalizeUniqueAggregationRows()\n\n```ts\nfunction normalizeUniqueAggregationRows<TFeatures, TData>(rows, maxDepth): readonly Row<TFeatures, TData>[];\n```\n\nDefined in: [features/row-aggregation/rowAggregationFeature.utils.ts:145](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-aggregation/rowAggregationFeature.utils.ts#L145)\n\nFrontier selection for rows that are distinct nodes of a single row tree —\nthe row models the table builds itself. Skips `normalizeAggregationRows`'\nduplicate-id guard (disjoint subtrees cannot revisit a row) and returns\n`rows` unchanged when no row descends, so the default `maxDepth: 0` case\ncosts nothing per aggregation.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### rows\n\nreadonly [`Row`](../../index/type-aliases/Row.md)\\<`TFeatures`, `TData`\\>[]\n\n### maxDepth\n\n`number` = `0`\n\n## Returns\n\nreadonly [`Row`](../../index/type-aliases/Row.md)\\<`TFeatures`, `TData`\\>[]\n"}
