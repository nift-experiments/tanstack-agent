ue":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"row","children":[{"type":"text","value":"row"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/Row.md","children":[{"type":"inlineCode","value":"Row"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"opts","children":[{"type":"text","value":"opts?"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/ToggleSelectedOptions.md","children":[{"type":"inlineCode","value":"ToggleSelectedOptions"}]}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"code","value":"(e): void;","lang":"ts"},{"type":"heading","depth":3,"id":"parameters-2","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":4,"id":"e","children":[{"type":"text","value":"e"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":3,"id":"returns-2","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const onChange = row_getToggleSelectedHandler(row)","lang":"ts"}],"headings":[{"id":"function-row-gettoggleselectedhandler","text":"Function: row_getToggleSelectedHandler()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"row","text":"row","level":3},{"id":"opts","text":"opts?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"parameters-2","text":"Parameters","level":3},{"id":"e","text":"e","level":4},{"id":"returns-2","text":"Returns","level":3},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: row\\_getToggleSelectedHandler()\n\n```ts\nfunction row_getToggleSelectedHandler<TFeatures, TData>(row, opts?): (e) => void;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.utils.ts:697](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.utils.ts#L697)\n\nCreates a checkbox-style handler that selects or deselects this row.\n\nThe handler is a no-op when the row cannot be selected and reads\n`event.target.checked`. Shift events select or deselect the inclusive range\nfrom the most recent selectable row handled by this table. Pass\n`selectChildren: false` to limit changes to rows explicitly present in the\ndisplay-order interval, and `deselectParents: true` to remove ancestor row\nids from the selection when rows are deselected.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### row\n\n[`Row`](../../index/type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n### opts?\n\n[`ToggleSelectedOptions`](../../index/interfaces/ToggleSelectedOptions.md)\n\n## Returns\n\n```ts\n(e): void;\n```\n\n### Parameters\n\n#### e\n\n`unknown`\n\n### Returns\n\n`void`\n\n## Example\n\n```ts\nconst onChange = row_getToggleSelectedHandler(row)\n```\n","originalRawMarkdown":"---\nid: row_getToggleSelectedHandler\ntitle: row_getToggleSelectedHandler\n---\n\n# Function: row\\_getToggleSelectedHandler()\n\n```ts\nfunction row_getToggleSelectedHandler<TFeatures, TData>(row, opts?): (e) => void;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.utils.ts:697](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.utils.ts#L697)\n\nCreates a checkbox-style handler that selects or deselects this row.\n\nThe handler is a no-op when the row cannot be selected and reads\n`event.target.checked`. Shift events select or deselect the inclusive range\nfrom the most recent selectable row handled by this table. Pass\n`selectChildren: false` to limit changes to rows explicitly present in the\ndisplay-order interval, and `deselectParents: true` to remove ancestor row\nids from the selection when rows are deselected.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### row\n\n[`Row`](../../index/type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n### opts?\n\n[`ToggleSelectedOptions`](../../index/interfaces/ToggleSelectedOptions.md)\n\n## Returns\n\n```ts\n(e): void;\n```\n\n### Parameters\n\n#### e\n\n`unknown`\n\n### Returns\n\n`void`\n\n## Example\n\n```ts\nconst onChange = row_getToggleSelectedHandler(row)\n```\n"}
