ype":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"row","children":[{"type":"text","value":"row"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/Row.md","children":[{"type":"inlineCode","value":"Row"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"expanded","children":[{"type":"text","value":"expanded?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"row_toggleExpanded(row)","lang":"ts"}],"headings":[{"id":"function-row-toggleexpanded","text":"Function: row_toggleExpanded()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"row","text":"row","level":3},{"id":"expanded","text":"expanded?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: row\\_toggleExpanded()\n\n```ts\nfunction row_toggleExpanded<TFeatures, TData>(row, expanded?): void;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.utils.ts:289](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.utils.ts#L289)\n\nExpands or collapses this row.\n\nOmitting `expanded` toggles the row. If the current state is expanded-all,\nthe function first materializes that state into a row-id map (containing\nonly expandable row ids) before applying the row-specific change.\n\nThe call is a no-op (no `onExpandedChange`) when the requested state matches\nthe current state, or when expanding a row that cannot expand. Collapsing is\nalways allowed so stale expanded ids can be cleaned up.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### row\n\n[`Row`](../../index/type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n### expanded?\n\n`boolean`\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\nrow_toggleExpanded(row)\n```\n","originalRawMarkdown":"---\nid: row_toggleExpanded\ntitle: row_toggleExpanded\n---\n\n# Function: row\\_toggleExpanded()\n\n```ts\nfunction row_toggleExpanded<TFeatures, TData>(row, expanded?): void;\n```\n\nDefined in: [features/row-expanding/rowExpandingFeature.utils.ts:289](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-expanding/rowExpandingFeature.utils.ts#L289)\n\nExpands or collapses this row.\n\nOmitting `expanded` toggles the row. If the current state is expanded-all,\nthe function first materializes that state into a row-id map (containing\nonly expandable row ids) before applying the row-specific change.\n\nThe call is a no-op (no `onExpandedChange`) when the requested state matches\nthe current state, or when expanding a row that cannot expand. Collapsing is\nalways allowed so stale expanded ids can be cleaned up.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### row\n\n[`Row`](../../index/type-aliases/Row.md)\\<`TFeatures`, `TData`\\>\n\n### expanded?\n\n`boolean`\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\nrow_toggleExpanded(row)\n```\n"}
