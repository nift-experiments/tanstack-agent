:3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":3,"id":"tvalue","children":[{"type":"text","value":"TValue"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TValue"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" = "},{"type":"inlineCode","value":"unknown"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"filterfn","children":[{"type":"text","value":"filterFn?"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/FilterFn.md","children":[{"type":"inlineCode","value":"FilterFn"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"value","children":[{"type":"text","value":"value?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"any"}]},{"type":"heading","depth":3,"id":"column","children":[{"type":"text","value":"column?"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Column_Internal.md","children":[{"type":"inlineCode","value":"Column_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":", "},{"type":"inlineCode","value":"TValue"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const removeFilter = shouldAutoRemoveFilter(filterFn, value, column)","lang":"ts"}],"headings":[{"id":"function-shouldautoremovefilter","text":"Function: shouldAutoRemoveFilter()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"tvalue","text":"TValue","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"filterfn","text":"filterFn?","level":3},{"id":"value","text":"value?","level":3},{"id":"column","text":"column?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: shouldAutoRemoveFilter()\n\n```ts\nfunction shouldAutoRemoveFilter<TFeatures, TData, TValue>(\n   filterFn?,\n   value?,\n   column?): boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.utils.ts:348](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.utils.ts#L348)\n\nReturns whether a filter value should be removed from filter state.\n\n`undefined` always removes: it is the universal \"clear this filter\"\nsentinel used by `setFilterValue(undefined)` and functional updaters. For\nany other value, a filter function's `autoRemove` hook is authoritative\nwhen provided, so custom filter functions can keep values (such as empty\nstrings) that the default heuristic would drop. Without an `autoRemove`\nhook, empty strings are removed.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### filterFn?\n\n[`FilterFn`](../../index/interfaces/FilterFn.md)\\<`TFeatures`, `TData`\\>\n\n### value?\n\n`any`\n\n### column?\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n`boolean`\n\n## Example\n\n```ts\nconst removeFilter = shouldAutoRemoveFilter(filterFn, value, column)\n```\n","originalRawMarkdown":"---\nid: shouldAutoRemoveFilter\ntitle: shouldAutoRemoveFilter\n---\n\n# Function: shouldAutoRemoveFilter()\n\n```ts\nfunction shouldAutoRemoveFilter<TFeatures, TData, TValue>(\n   filterFn?,\n   value?,\n   column?): boolean;\n```\n\nDefined in: [features/column-filtering/columnFilteringFeature.utils.ts:348](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-filtering/columnFilteringFeature.utils.ts#L348)\n\nReturns whether a filter value should be removed from filter state.\n\n`undefined` always removes: it is the universal \"clear this filter\"\nsentinel used by `setFilterValue(undefined)` and functional updaters. For\nany other value, a filter function's `autoRemove` hook is authoritative\nwhen provided, so custom filter functions can keep values (such as empty\nstrings) that the default heuristic would drop. Without an `autoRemove`\nhook, empty strings are removed.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n### TValue\n\n`TValue` *extends* `unknown` = `unknown`\n\n## Parameters\n\n### filterFn?\n\n[`FilterFn`](../../index/interfaces/FilterFn.md)\\<`TFeatures`, `TData`\\>\n\n### value?\n\n`any`\n\n### column?\n\n[`Column_Internal`](../../index/interfaces/Column_Internal.md)\\<`TFeatures`, `TData`, `TValue`\\>\n\n## Returns\n\n`boolean`\n\n## Example\n\n```ts\nconst removeFilter = shouldAutoRemoveFilter(filterFn, value, column)\n```\n"}
