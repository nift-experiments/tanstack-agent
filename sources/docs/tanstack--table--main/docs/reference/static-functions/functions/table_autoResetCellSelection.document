ef":"../../index/interfaces/TableFeatures.md","children":[{"type":"inlineCode","value":"TableFeatures"}]}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"table_autoResetCellSelection(table)","lang":"ts"}],"headings":[{"id":"function-table-autoresetcellselection","text":"Function: table_autoResetCellSelection()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_autoResetCellSelection()\n\n```ts\nfunction table_autoResetCellSelection<TFeatures, TData>(table): void;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.utils.ts:107](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.utils.ts#L107)\n\nSchedules a cell selection reset after `data` changes.\n\nRanges are stored as row and column ids, so without this a data swap would\nleave a selection pointing at rows that no longer exist, or silently\nre-select cells whenever new data reuses ids. The reset runs when\n`autoResetAll` or `autoResetCellSelection` allows it, defaulting to on.\n\nResetting to `initialState.cellSelection` rather than to empty means the\nfirst row-model computation is a no-op, matching `table_autoResetExpanded`.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_autoResetCellSelection(table)\n```\n","originalRawMarkdown":"---\nid: table_autoResetCellSelection\ntitle: table_autoResetCellSelection\n---\n\n# Function: table\\_autoResetCellSelection()\n\n```ts\nfunction table_autoResetCellSelection<TFeatures, TData>(table): void;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.utils.ts:107](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.utils.ts#L107)\n\nSchedules a cell selection reset after `data` changes.\n\nRanges are stored as row and column ids, so without this a data swap would\nleave a selection pointing at rows that no longer exist, or silently\nre-select cells whenever new data reuses ids. The reset runs when\n`autoResetAll` or `autoResetCellSelection` allows it, defaulting to on.\n\nResetting to `initialState.cellSelection` rather than to empty means the\nfirst row-model computation is a no-op, matching `table_autoResetExpanded`.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_autoResetCellSelection(table)\n```\n"}
