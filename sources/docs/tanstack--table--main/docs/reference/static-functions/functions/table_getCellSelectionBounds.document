value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/CellSelectionBounds.md","children":[{"type":"inlineCode","value":"CellSelectionBounds"}]},{"type":"text","value":"[]"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const bounds = table_getCellSelectionBounds(table)","lang":"ts"}],"headings":[{"id":"function-table-getcellselectionbounds","text":"Function: table_getCellSelectionBounds()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_getCellSelectionBounds()\n\n```ts\nfunction table_getCellSelectionBounds<TFeatures, TData>(table): CellSelectionBounds[];\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.utils.ts:414](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.utils.ts#L414)\n\nResolves ordered range operations into disjoint, positive display-order\nindex rectangles.\n\nThis is the single cache every per-cell read goes through, so index lookups\nhappen once per invalidation rather than once per cell. A range whose corners\nno longer resolve, for example because its anchor row was filtered out, is\nomitted rather than clamped, so it contributes nothing while remaining in\nstate and returns intact when the filter clears.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`CellSelectionBounds`](../../index/interfaces/CellSelectionBounds.md)[]\n\n## Example\n\n```ts\nconst bounds = table_getCellSelectionBounds(table)\n```\n","originalRawMarkdown":"---\nid: table_getCellSelectionBounds\ntitle: table_getCellSelectionBounds\n---\n\n# Function: table\\_getCellSelectionBounds()\n\n```ts\nfunction table_getCellSelectionBounds<TFeatures, TData>(table): CellSelectionBounds[];\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.utils.ts:414](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.utils.ts#L414)\n\nResolves ordered range operations into disjoint, positive display-order\nindex rectangles.\n\nThis is the single cache every per-cell read goes through, so index lookups\nhappen once per invalidation rather than once per cell. A range whose corners\nno longer resolve, for example because its anchor row was filtered out, is\nomitted rather than clamped, so it contributes nothing while remaining in\nstate and returns intact when the filter clears.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`CellSelectionBounds`](../../index/interfaces/CellSelectionBounds.md)[]\n\n## Example\n\n```ts\nconst bounds = table_getCellSelectionBounds(table)\n```\n"}
