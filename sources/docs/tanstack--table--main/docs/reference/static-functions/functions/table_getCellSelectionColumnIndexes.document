ef":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Record"},{"type":"text","value":"<"},{"type":"inlineCode","value":"string"},{"type":"text","value":", "},{"type":"inlineCode","value":"number"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const index = table_getCellSelectionColumnIndexes(table)[columnId]","lang":"ts"}],"headings":[{"id":"function-table-getcellselectioncolumnindexes","text":"Function: table_getCellSelectionColumnIndexes()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_getCellSelectionColumnIndexes()\n\n```ts\nfunction table_getCellSelectionColumnIndexes<TFeatures, TData>(table): Record<string, number>;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.utils.ts:200](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.utils.ts#L200)\n\nBuilds a column id to render-order index map.\n\nRegistered by this feature so the lookup stays memoized even when\n`columnOrderingFeature` is absent, since that feature's `getColumnIndexes`\nstatic rebuilds all four maps on every call, which would make per-cell reads\nO(columns).\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n`Record`\\<`string`, `number`\\>\n\n## Example\n\n```ts\nconst index = table_getCellSelectionColumnIndexes(table)[columnId]\n```\n","originalRawMarkdown":"---\nid: table_getCellSelectionColumnIndexes\ntitle: table_getCellSelectionColumnIndexes\n---\n\n# Function: table\\_getCellSelectionColumnIndexes()\n\n```ts\nfunction table_getCellSelectionColumnIndexes<TFeatures, TData>(table): Record<string, number>;\n```\n\nDefined in: [features/cell-selection/cellSelectionFeature.utils.ts:200](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-selection/cellSelectionFeature.utils.ts#L200)\n\nBuilds a column id to render-order index map.\n\nRegistered by this feature so the lookup stays memoized even when\n`columnOrderingFeature` is absent, since that feature's `getColumnIndexes`\nstatic rebuilds all four maps on every call, which would make per-cell reads\nO(columns).\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n`Record`\\<`string`, `number`\\>\n\n## Example\n\n```ts\nconst index = table_getCellSelectionColumnIndexes(table)[columnId]\n```\n"}
