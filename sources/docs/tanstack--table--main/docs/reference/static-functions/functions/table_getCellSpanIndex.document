:2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/CellSpanIndex.md","children":[{"type":"inlineCode","value":"CellSpanIndex"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const spanIndex = table_getCellSpanIndex(table)","lang":"ts"}],"headings":[{"id":"function-table-getcellspanindex","text":"Function: table_getCellSpanIndex()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_getCellSpanIndex()\n\n```ts\nfunction table_getCellSpanIndex<TFeatures, TData>(table): CellSpanIndex<TFeatures, TData>;\n```\n\nDefined in: [features/cell-spanning/cellSpanningFeature.utils.ts:150](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-spanning/cellSpanningFeature.utils.ts#L150)\n\nBuilds the table's cell span index for the rows that are currently rendered.\n\nSpans are always derived from scratch from the final row model, so sorting,\nfiltering, pagination, expansion, and row pinning only change adjacency and\nthe index follows. Nothing is persisted and there is nothing to configure.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`CellSpanIndex`](../../index/interfaces/CellSpanIndex.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```ts\nconst spanIndex = table_getCellSpanIndex(table)\n```\n","originalRawMarkdown":"---\nid: table_getCellSpanIndex\ntitle: table_getCellSpanIndex\n---\n\n# Function: table\\_getCellSpanIndex()\n\n```ts\nfunction table_getCellSpanIndex<TFeatures, TData>(table): CellSpanIndex<TFeatures, TData>;\n```\n\nDefined in: [features/cell-spanning/cellSpanningFeature.utils.ts:150](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/cell-spanning/cellSpanningFeature.utils.ts#L150)\n\nBuilds the table's cell span index for the rows that are currently rendered.\n\nSpans are always derived from scratch from the final row model, so sorting,\nfiltering, pagination, expansion, and row pinning only change adjacency and\nthe index follows. Nothing is persisted and there is nothing to configure.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`CellSpanIndex`](../../index/interfaces/CellSpanIndex.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```ts\nconst spanIndex = table_getCellSpanIndex(table)\n```\n"}
