.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const allSelected = table_getIsAllRowsSelected(table)","lang":"ts"}],"headings":[{"id":"function-table-getisallrowsselected","text":"Function: table_getIsAllRowsSelected()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_getIsAllRowsSelected()\n\n```ts\nfunction table_getIsAllRowsSelected<TFeatures, TData>(table): boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.utils.ts:358](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.utils.ts#L358)\n\nChecks whether every selectable filtered row is selected.\n\nThe result is false when there are no filtered rows or when selection state is\nempty. Sub-rows whose ancestors block descent via `enableSubRowSelection` are\nignored, matching the rows that `table_toggleAllRowsSelected` selects.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n`boolean`\n\n## Example\n\n```ts\nconst allSelected = table_getIsAllRowsSelected(table)\n```\n","originalRawMarkdown":"---\nid: table_getIsAllRowsSelected\ntitle: table_getIsAllRowsSelected\n---\n\n# Function: table\\_getIsAllRowsSelected()\n\n```ts\nfunction table_getIsAllRowsSelected<TFeatures, TData>(table): boolean;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.utils.ts:358](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.utils.ts#L358)\n\nChecks whether every selectable filtered row is selected.\n\nThe result is false when there are no filtered rows or when selection state is\nempty. Sub-rows whose ancestors block descent via `enableSubRowSelection` are\nignored, matching the rows that `table_toggleAllRowsSelected` selects.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n`boolean`\n\n## Example\n\n```ts\nconst allSelected = table_getIsAllRowsSelected(table)\n```\n"}
