de","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"newoptions","children":[{"type":"text","value":"newOptions"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/TableOptions.md","children":[{"type":"inlineCode","value":"TableOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/TableOptions.md","children":[{"type":"inlineCode","value":"TableOptions"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const options = table_mergeOptions(table, nextOptions)","lang":"ts"}],"headings":[{"id":"function-table-mergeoptions","text":"Function: table_mergeOptions()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"newoptions","text":"newOptions","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_mergeOptions()\n\n```ts\nfunction table_mergeOptions<TFeatures, TData>(table, newOptions): TableOptions<TFeatures, TData>;\n```\n\nDefined in: [core/table/coreTablesFeature.utils.ts:134](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.utils.ts#L134)\n\nMerges new table options with the current resolved options.\n\nIf `options.mergeOptions` is provided, it owns the merge behavior; otherwise\noptions are shallow-merged. Static options that should never change after\ninitialization are restored on a fresh object so framework merge helpers may\nreturn readonly getter/proxy objects.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### newOptions\n\n[`TableOptions`](../../index/type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`TableOptions`](../../index/type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```ts\nconst options = table_mergeOptions(table, nextOptions)\n```\n","originalRawMarkdown":"---\nid: table_mergeOptions\ntitle: table_mergeOptions\n---\n\n# Function: table\\_mergeOptions()\n\n```ts\nfunction table_mergeOptions<TFeatures, TData>(table, newOptions): TableOptions<TFeatures, TData>;\n```\n\nDefined in: [core/table/coreTablesFeature.utils.ts:134](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.utils.ts#L134)\n\nMerges new table options with the current resolved options.\n\nIf `options.mergeOptions` is provided, it owns the merge behavior; otherwise\noptions are shallow-merged. Static options that should never change after\ninitialization are restored on a fresh object so framework merge helpers may\nreturn readonly getter/proxy objects.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### newOptions\n\n[`TableOptions`](../../index/type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\n\n## Returns\n\n[`TableOptions`](../../index/type-aliases/TableOptions.md)\\<`TFeatures`, `TData`\\>\n\n## Example\n\n```ts\nconst options = table_mergeOptions(table, nextOptions)\n```\n"}
