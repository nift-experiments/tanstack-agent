ype":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"defaultstate","children":[{"type":"text","value":"defaultState?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"table_resetGlobalFilter(table)\ntable_resetGlobalFilter(table, true)","lang":"ts"}],"headings":[{"id":"function-table-resetglobalfilter","text":"Function: table_resetGlobalFilter()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"defaultstate","text":"defaultState?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_resetGlobalFilter()\n\n```ts\nfunction table_resetGlobalFilter<TFeatures, TData>(table, defaultState?): void;\n```\n\nDefined in: [features/global-filtering/globalFilteringFeature.utils.ts:120](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/global-filtering/globalFilteringFeature.utils.ts#L120)\n\nResets `globalFilter` to the configured initial state or feature default.\n\nWith no argument, the reset clones `table.initialState.globalFilter`. Passing\n`true` ignores initial state and resets to `undefined`.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### defaultState?\n\n`boolean`\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_resetGlobalFilter(table)\ntable_resetGlobalFilter(table, true)\n```\n","originalRawMarkdown":"---\nid: table_resetGlobalFilter\ntitle: table_resetGlobalFilter\n---\n\n# Function: table\\_resetGlobalFilter()\n\n```ts\nfunction table_resetGlobalFilter<TFeatures, TData>(table, defaultState?): void;\n```\n\nDefined in: [features/global-filtering/globalFilteringFeature.utils.ts:120](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/global-filtering/globalFilteringFeature.utils.ts#L120)\n\nResets `globalFilter` to the configured initial state or feature default.\n\nWith no argument, the reset clones `table.initialState.globalFilter`. Passing\n`true` ignores initial state and resets to `undefined`.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### defaultState?\n\n`boolean`\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_resetGlobalFilter(table)\ntable_resetGlobalFilter(table, true)\n```\n"}
