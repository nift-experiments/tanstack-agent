rs"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"updater","children":[{"type":"text","value":"updater"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/Updater.md","children":[{"type":"inlineCode","value":"Updater"}]},{"type":"text","value":"<"},{"type":"link","href":"../../index/type-aliases/ColumnSizingState.md","children":[{"type":"inlineCode","value":"ColumnSizingState"}]},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"table_setColumnSizing(table, (old) => ({ ...old, age: 96 }))","lang":"ts"}],"headings":[{"id":"function-table-setcolumnsizing","text":"Function: table_setColumnSizing()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"updater","text":"updater","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_setColumnSizing()\n\n```ts\nfunction table_setColumnSizing<TFeatures, TData>(table, updater): void;\n```\n\nDefined in: [features/column-sizing/columnSizingFeature.utils.ts:335](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-sizing/columnSizingFeature.utils.ts#L335)\n\nRoutes a committed column sizing updater through the table's sizing handler.\n\nThe updater may be a next size map or a function of the previous map,\nmatching the instance `table.setColumnSizing` behavior.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### updater\n\n[`Updater`](../../index/type-aliases/Updater.md)\\<[`ColumnSizingState`](../../index/type-aliases/ColumnSizingState.md)\\>\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_setColumnSizing(table, (old) => ({ ...old, age: 96 }))\n```\n","originalRawMarkdown":"---\nid: table_setColumnSizing\ntitle: table_setColumnSizing\n---\n\n# Function: table\\_setColumnSizing()\n\n```ts\nfunction table_setColumnSizing<TFeatures, TData>(table, updater): void;\n```\n\nDefined in: [features/column-sizing/columnSizingFeature.utils.ts:335](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/column-sizing/columnSizingFeature.utils.ts#L335)\n\nRoutes a committed column sizing updater through the table's sizing handler.\n\nThe updater may be a next size map or a function of the previous map,\nmatching the instance `table.setColumnSizing` behavior.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### updater\n\n[`Updater`](../../index/type-aliases/Updater.md)\\<[`ColumnSizingState`](../../index/type-aliases/ColumnSizingState.md)\\>\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_setColumnSizing(table, (old) => ({ ...old, age: 96 }))\n```\n"}
