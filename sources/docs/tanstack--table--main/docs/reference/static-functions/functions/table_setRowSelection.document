eters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"updater","children":[{"type":"text","value":"updater"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/Updater.md","children":[{"type":"inlineCode","value":"Updater"}]},{"type":"text","value":"<"},{"type":"link","href":"../../index/type-aliases/RowSelectionState.md","children":[{"type":"inlineCode","value":"RowSelectionState"}]},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"table_setRowSelection(table, (old) => ({ ...old, [rowId]: true }))","lang":"ts"}],"headings":[{"id":"function-table-setrowselection","text":"Function: table_setRowSelection()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"updater","text":"updater","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_setRowSelection()\n\n```ts\nfunction table_setRowSelection<TFeatures, TData>(table, updater): void;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.utils.ts:46](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.utils.ts#L46)\n\nRoutes a row selection updater through the table's selection change handler.\n\nThe updater may be a next selection map or a function of the previous map,\nmatching the instance `table.setRowSelection` behavior.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### updater\n\n[`Updater`](../../index/type-aliases/Updater.md)\\<[`RowSelectionState`](../../index/type-aliases/RowSelectionState.md)\\>\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_setRowSelection(table, (old) => ({ ...old, [rowId]: true }))\n```\n","originalRawMarkdown":"---\nid: table_setRowSelection\ntitle: table_setRowSelection\n---\n\n# Function: table\\_setRowSelection()\n\n```ts\nfunction table_setRowSelection<TFeatures, TData>(table, updater): void;\n```\n\nDefined in: [features/row-selection/rowSelectionFeature.utils.ts:46](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-selection/rowSelectionFeature.utils.ts#L46)\n\nRoutes a row selection updater through the table's selection change handler.\n\nThe updater may be a next selection map or a function of the previous map,\nmatching the instance `table.setRowSelection` behavior.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### updater\n\n[`Updater`](../../index/type-aliases/Updater.md)\\<[`RowSelectionState`](../../index/type-aliases/RowSelectionState.md)\\>\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_setRowSelection(table, (old) => ({ ...old, [rowId]: true }))\n```\n"}
