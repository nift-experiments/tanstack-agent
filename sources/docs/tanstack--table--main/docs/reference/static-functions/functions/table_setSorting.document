type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"updater","children":[{"type":"text","value":"updater"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/type-aliases/Updater.md","children":[{"type":"inlineCode","value":"Updater"}]},{"type":"text","value":"<"},{"type":"link","href":"../../index/type-aliases/SortingState.md","children":[{"type":"inlineCode","value":"SortingState"}]},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"table_setSorting(table, (old) => [...old, { id: 'age', desc: true }])","lang":"ts"}],"headings":[{"id":"function-table-setsorting","text":"Function: table_setSorting()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"updater","text":"updater","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_setSorting()\n\n```ts\nfunction table_setSorting<TFeatures, TData>(table, updater): void;\n```\n\nDefined in: [features/row-sorting/rowSortingFeature.utils.ts:43](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-sorting/rowSortingFeature.utils.ts#L43)\n\nRoutes a sorting updater through the table's sorting change handler.\n\nThe updater may be a next `SortingState` array or a function of the previous\nsorting state, matching the instance `table.setSorting` behavior. State\nowners receive an equality-guarded updater so structurally equal sorting\nvalues preserve the owner's existing reference.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### updater\n\n[`Updater`](../../index/type-aliases/Updater.md)\\<[`SortingState`](../../index/type-aliases/SortingState.md)\\>\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_setSorting(table, (old) => [...old, { id: 'age', desc: true }])\n```\n","originalRawMarkdown":"---\nid: table_setSorting\ntitle: table_setSorting\n---\n\n# Function: table\\_setSorting()\n\n```ts\nfunction table_setSorting<TFeatures, TData>(table, updater): void;\n```\n\nDefined in: [features/row-sorting/rowSortingFeature.utils.ts:43](https://github.com/TanStack/table/blob/main/packages/table-core/src/features/row-sorting/rowSortingFeature.utils.ts#L43)\n\nRoutes a sorting updater through the table's sorting change handler.\n\nThe updater may be a next `SortingState` array or a function of the previous\nsorting state, matching the instance `table.setSorting` behavior. State\nowners receive an equality-guarded updater so structurally equal sorting\nvalues preserve the owner's existing reference.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### updater\n\n[`Updater`](../../index/type-aliases/Updater.md)\\<[`SortingState`](../../index/type-aliases/SortingState.md)\\>\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_setSorting(table, (old) => [...old, { id: 'age', desc: true }])\n```\n"}
