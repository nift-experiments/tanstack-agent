eatures"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/interfaces/TableFeatures.md","children":[{"type":"inlineCode","value":"TableFeatures"}]}]},{"type":"heading","depth":3,"id":"tdata","children":[{"type":"text","value":"TData"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TData"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"extends"}]},{"type":"text","value":" "},{"type":"link","href":"../../index/type-aliases/RowData.md","children":[{"type":"inlineCode","value":"RowData"}]}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"table","children":[{"type":"text","value":"table"}]},{"type":"paragraph","children":[{"type":"link","href":"../../index/interfaces/Table_Internal.md","children":[{"type":"inlineCode","value":"Table_Internal"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":", "},{"type":"inlineCode","value":"TData"},{"type":"text","value":">"}]},{"type":"heading","depth":3,"id":"capturedstate","children":[{"type":"text","value":"capturedState?"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Partial"},{"type":"text","value":"<"},{"type":"link","href":"../../index/type-aliases/TableState.md","children":[{"type":"inlineCode","value":"TableState"}]},{"type":"text","value":"<"},{"type":"inlineCode","value":"TFeatures"},{"type":"text","value":">> | "},{"type":"inlineCode","value":"null"}]},{"type":"heading","depth":3,"id":"compare","children":[{"type":"text","value":"compare?"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"currentState"},{"type":"text","value":", "},{"type":"inlineCode","value":"externalState"},{"type":"text","value":") => "},{"type":"inlineCode","value":"boolean"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"void"}]},{"type":"heading","depth":2,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"table_syncExternalStateToBaseAtoms(table)\ntable_syncExternalStateToBaseAtoms(table, capturedState ?? null, shallow)","lang":"ts"}],"headings":[{"id":"function-table-syncexternalstatetobaseatoms","text":"Function: table_syncExternalStateToBaseAtoms()","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tfeatures","text":"TFeatures","level":3},{"id":"tdata","text":"TData","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"table","text":"table","level":3},{"id":"capturedstate","text":"capturedState?","level":3},{"id":"compare","text":"compare?","level":3},{"id":"returns","text":"Returns","level":2},{"id":"example","text":"Example","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Function: table\\_syncExternalStateToBaseAtoms()\n\n```ts\nfunction table_syncExternalStateToBaseAtoms<TFeatures, TData>(\n   table,\n   capturedState?,\n   compare?): void;\n```\n\nDefined in: [core/table/coreTablesFeature.utils.ts:28](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.utils.ts#L28)\n\nSynchronizes externally controlled state slices into the table's base atoms.\n\nThis keeps `options.state` values mirrored in the atom graph so derived\natoms, stores, and table APIs read a consistent snapshot.\n\nAdapters that update options during their host's render phase pass the\nstate snapshot captured by the committed render as `capturedState` — the\nshared options object may already hold values from a newer render that\nnever commits. Pass `null` to publish nothing (a captured \"no controlled\nstate\"); omitting the argument reads the current `table.options.state`\ninstead. An optional `compare` suppresses semantically unchanged slice\nwrites; the default remains reference equality.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### capturedState?\n\n`Partial`\\<[`TableState`](../../index/type-aliases/TableState.md)\\<`TFeatures`\\>\\> | `null`\n\n### compare?\n\n(`currentState`, `externalState`) => `boolean`\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_syncExternalStateToBaseAtoms(table)\ntable_syncExternalStateToBaseAtoms(table, capturedState ?? null, shallow)\n```\n","originalRawMarkdown":"---\nid: table_syncExternalStateToBaseAtoms\ntitle: table_syncExternalStateToBaseAtoms\n---\n\n# Function: table\\_syncExternalStateToBaseAtoms()\n\n```ts\nfunction table_syncExternalStateToBaseAtoms<TFeatures, TData>(\n   table,\n   capturedState?,\n   compare?): void;\n```\n\nDefined in: [core/table/coreTablesFeature.utils.ts:28](https://github.com/TanStack/table/blob/main/packages/table-core/src/core/table/coreTablesFeature.utils.ts#L28)\n\nSynchronizes externally controlled state slices into the table's base atoms.\n\nThis keeps `options.state` values mirrored in the atom graph so derived\natoms, stores, and table APIs read a consistent snapshot.\n\nAdapters that update options during their host's render phase pass the\nstate snapshot captured by the committed render as `capturedState` — the\nshared options object may already hold values from a newer render that\nnever commits. Pass `null` to publish nothing (a captured \"no controlled\nstate\"); omitting the argument reads the current `table.options.state`\ninstead. An optional `compare` suppresses semantically unchanged slice\nwrites; the default remains reference equality.\n\n## Type Parameters\n\n### TFeatures\n\n`TFeatures` *extends* [`TableFeatures`](../../index/interfaces/TableFeatures.md)\n\n### TData\n\n`TData` *extends* [`RowData`](../../index/type-aliases/RowData.md)\n\n## Parameters\n\n### table\n\n[`Table_Internal`](../../index/interfaces/Table_Internal.md)\\<`TFeatures`, `TData`\\>\n\n### capturedState?\n\n`Partial`\\<[`TableState`](../../index/type-aliases/TableState.md)\\<`TFeatures`\\>\\> | `null`\n\n### compare?\n\n(`currentState`, `externalState`) => `boolean`\n\n## Returns\n\n`void`\n\n## Example\n\n```ts\ntable_syncExternalStateToBaseAtoms(table)\ntable_syncExternalStateToBaseAtoms(table, capturedState ?? null, shallow)\n```\n"}
