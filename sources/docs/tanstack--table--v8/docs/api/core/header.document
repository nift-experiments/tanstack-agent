{"type":"link","href":"./header-group.md","children":[{"type":"text","value":"HeaderGroup"}]},{"type":"text","value":" object"}]},{"type":"heading","depth":3,"id":"subheaders","children":[{"type":"inlineCode","value":"subHeaders"}]},{"type":"code","value":"type subHeaders = Header<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The header's hierarchical sub/child headers. Will be empty if the header's associated column is a leaf-column."}]},{"type":"heading","depth":3,"id":"colspan","children":[{"type":"inlineCode","value":"colSpan"}]},{"type":"code","value":"colSpan: number","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The col-span for the header."}]},{"type":"heading","depth":3,"id":"rowspan","children":[{"type":"inlineCode","value":"rowSpan"}]},{"type":"code","value":"rowSpan: number","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"The row-span for the header."}]},{"type":"heading","depth":3,"id":"getleafheaders","children":[{"type":"inlineCode","value":"getLeafHeaders"}]},{"type":"code","value":"type getLeafHeaders = () => Header<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns the leaf headers hierarchically nested under this header."}]},{"type":"heading","depth":3,"id":"isplaceholder","children":[{"type":"inlineCode","value":"isPlaceholder"}]},{"type":"code","value":"isPlaceholder: boolean","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"A boolean denoting if the header is a placeholder header"}]},{"type":"heading","depth":3,"id":"placeholderid","children":[{"type":"inlineCode","value":"placeholderId"}]},{"type":"code","value":"placeholderId?: string","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If the header is a placeholder header, this will be a unique header ID that does not conflict with any other headers across the table"}]},{"type":"heading","depth":3,"id":"getcontext","children":[{"type":"inlineCode","value":"getContext"}]},{"type":"code","value":"getContext: () => {\n  table: Table<TData>\n  header: Header<TData, TValue>\n  column: Column<TData, TValue>\n}","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns the rendering context (or props) for column-based components like headers, footers and filters. Use these props with your framework's "},{"type":"inlineCode","value":"flexRender"},{"type":"text","value":" utility to render these using the template of your choice:"}]},{"type":"code","value":"flexRender(header.column.columnDef.header, header.getContext())","lang":"tsx"},{"type":"heading","depth":2,"id":"table-api","children":[{"type":"text","value":"Table API"}]},{"type":"heading","depth":3,"id":"getheadergroups","children":[{"type":"inlineCode","value":"getHeaderGroups"}]},{"type":"code","value":"type getHeaderGroups = () => HeaderGroup<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns all header groups for the table."}]},{"type":"heading","depth":3,"id":"getleftheadergroups","children":[{"type":"inlineCode","value":"getLeftHeaderGroups"}]},{"type":"code","value":"type getLeftHeaderGroups = () => HeaderGroup<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns the header groups for the left pinned columns."}]},{"type":"heading","depth":3,"id":"getcenterheadergroups","children":[{"type":"inlineCode","value":"getCenterHeaderGroups"}]},{"type":"code","value":"type getCenterHeaderGroups = () => HeaderGroup<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns the header groups for columns that are not pinned."}]},{"type":"heading","depth":3,"id":"getrightheadergroups","children":[{"type":"inlineCode","value":"getRightHeaderGroups"}]},{"type":"code","value":"type getRightHeaderGroups = () => HeaderGroup<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns the header groups for the right pinned columns."}]},{"type":"heading","depth":3,"id":"getfootergroups","children":[{"type":"inlineCode","value":"getFooterGroups"}]},{"type":"code","value":"type getFooterGroups = () => HeaderGroup<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns all footer groups for the table."}]},{"type":"heading","depth":3,"id":"getleftfootergroups","children":[{"type":"inlineCode","value":"getLeftFooterGroups"}]},{"type":"code","value":"type getLeftFooterGroups = () => HeaderGroup<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns the footer groups for the left pinned columns."}]},{"type":"heading","depth":3,"id":"getcenterfootergroups","children":[{"type":"inlineCode","value":"getCenterFooterGroups"}]},{"type":"code","value":"type getCenterFooterGroups = () => HeaderGroup<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns the footer groups for columns that are not pinned."}]},{"type":"heading","depth":3,"id":"getrightfootergroups","children":[{"type":"inlineCode","value":"getRightFooterGroups"}]},{"type":"code","value":"type getRightFooterGroups = () => HeaderGroup<TData>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns the footer groups for the right pinned columns."}]},{"type":"heading","depth":3,"id":"getflatheaders","children":[{"type":"inlineCode","value":"getFlatHeaders"}]},{"type":"code","value":"type getFlatHeaders = () => Header<TData, unknown>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns headers for all columns in the table, including parent headers."}]},{"type":"heading","depth":3,"id":"getleftflatheaders","children":[{"type":"inlineCode","value":"getLeftFlatHeaders"}]},{"type":"code","value":"type getLeftFlatHeaders = () => Header<TData, unknown>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns headers for all left pinned columns in the table, including parent headers."}]},{"type":"heading","depth":3,"id":"getcenterflatheaders","children":[{"type":"inlineCode","value":"getCenterFlatHeaders"}]},{"type":"code","value":"type getCenterFlatHeaders = () => Header<TData, unknown>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns headers for all columns that are not pinned, including parent headers."}]},{"type":"heading","depth":3,"id":"getrightflatheaders","children":[{"type":"inlineCode","value":"getRightFlatHeaders"}]},{"type":"code","value":"type getRightFlatHeaders = () => Header<TData, unknown>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns headers for all right pinned columns in the table, including parent headers."}]},{"type":"heading","depth":3,"id":"getleafheaders-2","children":[{"type":"inlineCode","value":"getLeafHeaders"}]},{"type":"code","value":"type getLeafHeaders = () => Header<TData, unknown>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns headers for all leaf columns in the table, (not including parent headers)."}]},{"type":"heading","depth":3,"id":"getleftleafheaders","children":[{"type":"inlineCode","value":"getLeftLeafHeaders"}]},{"type":"code","value":"type getLeftLeafHeaders = () => Header<TData, unknown>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns headers for all left pinned leaf columns in the table, (not including parent headers)."}]},{"type":"heading","depth":3,"id":"getcenterleafheaders","children":[{"type":"inlineCode","value":"getCenterLeafHeaders"}]},{"type":"code","value":"type getCenterLeafHeaders = () => Header<TData, unknown>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns headers for all columns that are not pinned, (not including parent headers)."}]},{"type":"heading","depth":3,"id":"getrightleafheaders","children":[{"type":"inlineCode","value":"getRightLeafHeaders"}]},{"type":"code","value":"type getRightLeafHeaders = () => Header<TData, unknown>[]","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"If pinning, returns headers for all right pinned leaf columns in the table, (not including parent headers)."}]}],"headings":[{"id":"header-api","text":"Header API","level":2},{"id":"id","text":"id","level":3},{"id":"index","text":"index","level":3},{"id":"depth","text":"depth","level":3},{"id":"column","text":"column","level":3},{"id":"headergroup","text":"headerGroup","level":3},{"id":"subheaders","text":"subHeaders","level":3},{"id":"colspan","text":"colSpan","level":3},{"id":"rowspan","text":"rowSpan","level":3},{"id":"getleafheaders","text":"getLeafHeaders","level":3},{"id":"isplaceholder","text":"isPlaceholder","level":3},{"id":"placeholderid","text":"placeholderId","level":3},{"id":"getcontext","text":"getContext","level":3},{"id":"table-api","text":"Table API","level":2},{"id":"getheadergroups","text":"getHeaderGroups","level":3},{"id":"getleftheadergroups","text":"getLeftHeaderGroups","level":3},{"id":"getcenterheadergroups","text":"getCenterHeaderGroups","level":3},{"id":"getrightheadergroups","text":"getRightHeaderGroups","level":3},{"id":"getfootergroups","text":"getFooterGroups","level":3},{"id":"getleftfootergroups","text":"getLeftFooterGroups","level":3},{"id":"getcenterfootergroups","text":"getCenterFooterGroups","level":3},{"id":"getrightfootergroups","text":"getRightFooterGroups","level":3},{"id":"getflatheaders","text":"getFlatHeaders","level":3},{"id":"getleftflatheaders","text":"getLeftFlatHeaders","level":3},{"id":"getcenterflatheaders","text":"getCenterFlatHeaders","level":3},{"id":"getrightflatheaders","text":"getRightFlatHeaders","level":3},{"id":"getleafheaders-2","text":"getLeafHeaders","level":3},{"id":"getleftleafheaders","text":"getLeftLeafHeaders","level":3},{"id":"getcenterleafheaders","text":"getCenterLeafHeaders","level":3},{"id":"getrightleafheaders","text":"getRightLeafHeaders","level":3}]},"frameworks":[],"downloadMarkdown":"\nThese are **core** options and API properties for all headers. More options and API properties may be available for other [table features](../../guide/features.md).\n\n## Header API\n\nAll header objects have the following properties:\n\n### `id`\n\n```tsx\nid: string\n```\n\nThe unique identifier for the header.\n\n### `index`\n\n```tsx\nindex: number\n```\n\nThe index for the header within the header group.\n\n### `depth`\n\n```tsx\ndepth: number\n```\n\nThe depth of the header, zero-indexed based.\n\n### `column`\n\n```tsx\ncolumn: Column<TData>\n```\n\nThe header's associated [Column](./column.md) object\n\n### `headerGroup`\n\n```tsx\nheaderGroup: HeaderGroup<TData>\n```\n\nThe header's associated [HeaderGroup](./header-group.md) object\n\n### `subHeaders`\n\n```tsx\ntype subHeaders = Header<TData>[]\n```\n\nThe header's hierarchical sub/child headers. Will be empty if the header's associated column is a leaf-column.\n\n### `colSpan`\n\n```tsx\ncolSpan: number\n```\n\nThe col-span for the header.\n\n### `rowSpan`\n\n```tsx\nrowSpan: number\n```\n\nThe row-span for the header.\n\n### `getLeafHeaders`\n\n```tsx\ntype getLeafHeaders = () => Header<TData>[]\n```\n\nReturns the leaf headers hierarchically nested under this header.\n\n### `isPlaceholder`\n\n```tsx\nisPlaceholder: boolean\n```\n\nA boolean denoting if the header is a placeholder header\n\n### `placeholderId`\n\n```tsx\nplaceholderId?: string\n```\n\nIf the header is a placeholder header, this will be a unique header ID that does not conflict with any other headers across the table\n\n### `getContext`\n\n```tsx\ngetContext: () => {\n  table: Table<TData>\n  header: Header<TData, TValue>\n  column: Column<TData, TValue>\n}\n```\n\nReturns the rendering context (or props) for column-based components like headers, footers and filters. Use these props with your framework's `flexRender` utility to render these using the template of your choice:\n\n```tsx\nflexRender(header.column.columnDef.header, header.getContext())\n```\n\n## Table API\n\n### `getHeaderGroups`\n\n```tsx\ntype getHeaderGroups = () => HeaderGroup<TData>[]\n```\n\nReturns all header groups for the table.\n\n### `getLeftHeaderGroups`\n\n```tsx\ntype getLeftHeaderGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the header groups for the left pinned columns.\n\n### `getCenterHeaderGroups`\n\n```tsx\ntype getCenterHeaderGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the header groups for columns that are not pinned.\n\n### `getRightHeaderGroups`\n\n```tsx\ntype getRightHeaderGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the header groups for the right pinned columns.\n\n### `getFooterGroups`\n\n```tsx\ntype getFooterGroups = () => HeaderGroup<TData>[]\n```\n\nReturns all footer groups for the table.\n\n### `getLeftFooterGroups`\n\n```tsx\ntype getLeftFooterGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the footer groups for the left pinned columns.\n\n### `getCenterFooterGroups`\n\n```tsx\ntype getCenterFooterGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the footer groups for columns that are not pinned.\n\n### `getRightFooterGroups`\n\n```tsx\ntype getRightFooterGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the footer groups for the right pinned columns.\n\n### `getFlatHeaders`\n\n```tsx\ntype getFlatHeaders = () => Header<TData, unknown>[]\n```\n\nReturns headers for all columns in the table, including parent headers.\n\n### `getLeftFlatHeaders`\n\n```tsx\ntype getLeftFlatHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all left pinned columns in the table, including parent headers.\n\n### `getCenterFlatHeaders`\n\n```tsx\ntype getCenterFlatHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all columns that are not pinned, including parent headers.\n\n### `getRightFlatHeaders`\n\n```tsx\ntype getRightFlatHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all right pinned columns in the table, including parent headers.\n\n### `getLeafHeaders`\n\n```tsx\ntype getLeafHeaders = () => Header<TData, unknown>[]\n```\n\nReturns headers for all leaf columns in the table, (not including parent headers).\n\n### `getLeftLeafHeaders`\n\n```tsx\ntype getLeftLeafHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all left pinned leaf columns in the table, (not including parent headers).\n\n### `getCenterLeafHeaders`\n\n```tsx\ntype getCenterLeafHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all columns that are not pinned, (not including parent headers).\n\n### `getRightLeafHeaders`\n\n```tsx\ntype getRightLeafHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all right pinned leaf columns in the table, (not including parent headers).\n","originalRawMarkdown":"---\ntitle: Header APIs\n---\n\nThese are **core** options and API properties for all headers. More options and API properties may be available for other [table features](../../guide/features.md).\n\n## Header API\n\nAll header objects have the following properties:\n\n### `id`\n\n```tsx\nid: string\n```\n\nThe unique identifier for the header.\n\n### `index`\n\n```tsx\nindex: number\n```\n\nThe index for the header within the header group.\n\n### `depth`\n\n```tsx\ndepth: number\n```\n\nThe depth of the header, zero-indexed based.\n\n### `column`\n\n```tsx\ncolumn: Column<TData>\n```\n\nThe header's associated [Column](./column.md) object\n\n### `headerGroup`\n\n```tsx\nheaderGroup: HeaderGroup<TData>\n```\n\nThe header's associated [HeaderGroup](./header-group.md) object\n\n### `subHeaders`\n\n```tsx\ntype subHeaders = Header<TData>[]\n```\n\nThe header's hierarchical sub/child headers. Will be empty if the header's associated column is a leaf-column.\n\n### `colSpan`\n\n```tsx\ncolSpan: number\n```\n\nThe col-span for the header.\n\n### `rowSpan`\n\n```tsx\nrowSpan: number\n```\n\nThe row-span for the header.\n\n### `getLeafHeaders`\n\n```tsx\ntype getLeafHeaders = () => Header<TData>[]\n```\n\nReturns the leaf headers hierarchically nested under this header.\n\n### `isPlaceholder`\n\n```tsx\nisPlaceholder: boolean\n```\n\nA boolean denoting if the header is a placeholder header\n\n### `placeholderId`\n\n```tsx\nplaceholderId?: string\n```\n\nIf the header is a placeholder header, this will be a unique header ID that does not conflict with any other headers across the table\n\n### `getContext`\n\n```tsx\ngetContext: () => {\n  table: Table<TData>\n  header: Header<TData, TValue>\n  column: Column<TData, TValue>\n}\n```\n\nReturns the rendering context (or props) for column-based components like headers, footers and filters. Use these props with your framework's `flexRender` utility to render these using the template of your choice:\n\n```tsx\nflexRender(header.column.columnDef.header, header.getContext())\n```\n\n## Table API\n\n### `getHeaderGroups`\n\n```tsx\ntype getHeaderGroups = () => HeaderGroup<TData>[]\n```\n\nReturns all header groups for the table.\n\n### `getLeftHeaderGroups`\n\n```tsx\ntype getLeftHeaderGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the header groups for the left pinned columns.\n\n### `getCenterHeaderGroups`\n\n```tsx\ntype getCenterHeaderGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the header groups for columns that are not pinned.\n\n### `getRightHeaderGroups`\n\n```tsx\ntype getRightHeaderGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the header groups for the right pinned columns.\n\n### `getFooterGroups`\n\n```tsx\ntype getFooterGroups = () => HeaderGroup<TData>[]\n```\n\nReturns all footer groups for the table.\n\n### `getLeftFooterGroups`\n\n```tsx\ntype getLeftFooterGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the footer groups for the left pinned columns.\n\n### `getCenterFooterGroups`\n\n```tsx\ntype getCenterFooterGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the footer groups for columns that are not pinned.\n\n### `getRightFooterGroups`\n\n```tsx\ntype getRightFooterGroups = () => HeaderGroup<TData>[]\n```\n\nIf pinning, returns the footer groups for the right pinned columns.\n\n### `getFlatHeaders`\n\n```tsx\ntype getFlatHeaders = () => Header<TData, unknown>[]\n```\n\nReturns headers for all columns in the table, including parent headers.\n\n### `getLeftFlatHeaders`\n\n```tsx\ntype getLeftFlatHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all left pinned columns in the table, including parent headers.\n\n### `getCenterFlatHeaders`\n\n```tsx\ntype getCenterFlatHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all columns that are not pinned, including parent headers.\n\n### `getRightFlatHeaders`\n\n```tsx\ntype getRightFlatHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all right pinned columns in the table, including parent headers.\n\n### `getLeafHeaders`\n\n```tsx\ntype getLeafHeaders = () => Header<TData, unknown>[]\n```\n\nReturns headers for all leaf columns in the table, (not including parent headers).\n\n### `getLeftLeafHeaders`\n\n```tsx\ntype getLeftLeafHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all left pinned leaf columns in the table, (not including parent headers).\n\n### `getCenterLeafHeaders`\n\n```tsx\ntype getCenterLeafHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all columns that are not pinned, (not including parent headers).\n\n### `getRightLeafHeaders`\n\n```tsx\ntype getRightLeafHeaders = () => Header<TData, unknown>[]\n```\n\nIf pinning, returns headers for all right pinned leaf columns in the table, (not including parent headers).\n"}
