hildren":[{"type":"inlineCode","value":"getIsSomeRowsSelected"}]},{"type":"code","value":"getIsSomeRowsSelected: () => boolean","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns whether or not any rows in the table are selected."}]},{"type":"heading","depth":3,"id":"getissomepagerowsselected","children":[{"type":"inlineCode","value":"getIsSomePageRowsSelected"}]},{"type":"code","value":"getIsSomePageRowsSelected: () => boolean","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns whether or not any rows on the current page are selected."}]},{"type":"heading","depth":3,"id":"toggleallrowsselected","children":[{"type":"inlineCode","value":"toggleAllRowsSelected"}]},{"type":"code","value":"toggleAllRowsSelected: (value: boolean) => void","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Selects/deselects all rows in the table."}]},{"type":"heading","depth":3,"id":"toggleallpagerowsselected","children":[{"type":"inlineCode","value":"toggleAllPageRowsSelected"}]},{"type":"code","value":"toggleAllPageRowsSelected: (value: boolean) => void","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Selects/deselects all rows on the current page."}]},{"type":"heading","depth":3,"id":"getpreselectedrowmodel","children":[{"type":"inlineCode","value":"getPreSelectedRowModel"}]},{"type":"code","value":"getPreSelectedRowModel: () => RowModel<TData>","lang":"tsx"},{"type":"heading","depth":3,"id":"getselectedrowmodel","children":[{"type":"inlineCode","value":"getSelectedRowModel"}]},{"type":"code","value":"getSelectedRowModel: () => RowModel<TData>","lang":"tsx"},{"type":"heading","depth":3,"id":"getfilteredselectedrowmodel","children":[{"type":"inlineCode","value":"getFilteredSelectedRowModel"}]},{"type":"code","value":"getFilteredSelectedRowModel: () => RowModel<TData>","lang":"tsx"},{"type":"heading","depth":3,"id":"getgroupedselectedrowmodel","children":[{"type":"inlineCode","value":"getGroupedSelectedRowModel"}]},{"type":"code","value":"getGroupedSelectedRowModel: () => RowModel<TData>","lang":"tsx"},{"type":"heading","depth":2,"id":"row-api","children":[{"type":"text","value":"Row API"}]},{"type":"heading","depth":3,"id":"getisselected","children":[{"type":"inlineCode","value":"getIsSelected"}]},{"type":"code","value":"getIsSelected: () => boolean","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns whether or not the row is selected."}]},{"type":"heading","depth":3,"id":"getissomeselected","children":[{"type":"inlineCode","value":"getIsSomeSelected"}]},{"type":"code","value":"getIsSomeSelected: () => boolean","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns whether or not some of the row's sub rows are selected."}]},{"type":"heading","depth":3,"id":"getisallsubrowsselected","children":[{"type":"inlineCode","value":"getIsAllSubRowsSelected"}]},{"type":"code","value":"getIsAllSubRowsSelected: () => boolean","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns whether or not all of the row's sub rows are selected."}]},{"type":"heading","depth":3,"id":"getcanselect","children":[{"type":"inlineCode","value":"getCanSelect"}]},{"type":"code","value":"getCanSelect: () => boolean","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns whether or not the row can be selected."}]},{"type":"heading","depth":3,"id":"getcanmultiselect","children":[{"type":"inlineCode","value":"getCanMultiSelect"}]},{"type":"code","value":"getCanMultiSelect: () => boolean","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns whether or not the row can multi-select."}]},{"type":"heading","depth":3,"id":"getcanselectsubrows","children":[{"type":"inlineCode","value":"getCanSelectSubRows"}]},{"type":"code","value":"getCanSelectSubRows: () => boolean","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns whether or not the row can select sub rows automatically when the parent row is selected."}]},{"type":"heading","depth":3,"id":"toggleselected","children":[{"type":"inlineCode","value":"toggleSelected"}]},{"type":"code","value":"toggleSelected: (value?: boolean) => void","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Selects/deselects the row."}]},{"type":"heading","depth":3,"id":"gettoggleselectedhandler","children":[{"type":"inlineCode","value":"getToggleSelectedHandler"}]},{"type":"code","value":"getToggleSelectedHandler: () => (event: unknown) => void","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Returns a handler that can be used to toggle the row."}]}],"headings":[{"id":"state","text":"State","level":2},{"id":"table-options","text":"Table Options","level":2},{"id":"enablerowselection","text":"enableRowSelection","level":3},{"id":"enablemultirowselection","text":"enableMultiRowSelection","level":3},{"id":"enablesubrowselection","text":"enableSubRowSelection","level":3},{"id":"onrowselectionchange","text":"onRowSelectionChange","level":3},{"id":"table-api","text":"Table API","level":2},{"id":"gettoggleallrowsselectedhandler","text":"getToggleAllRowsSelectedHandler","level":3},{"id":"gettoggleallpagerowsselectedhandler","text":"getToggleAllPageRowsSelectedHandler","level":3},{"id":"setrowselection","text":"setRowSelection","level":3},{"id":"resetrowselection","text":"resetRowSelection","level":3},{"id":"getisallrowsselected","text":"getIsAllRowsSelected","level":3},{"id":"getisallpagerowsselected","text":"getIsAllPageRowsSelected","level":3},{"id":"getissomerowsselected","text":"getIsSomeRowsSelected","level":3},{"id":"getissomepagerowsselected","text":"getIsSomePageRowsSelected","level":3},{"id":"toggleallrowsselected","text":"toggleAllRowsSelected","level":3},{"id":"toggleallpagerowsselected","text":"toggleAllPageRowsSelected","level":3},{"id":"getpreselectedrowmodel","text":"getPreSelectedRowModel","level":3},{"id":"getselectedrowmodel","text":"getSelectedRowModel","level":3},{"id":"getfilteredselectedrowmodel","text":"getFilteredSelectedRowModel","level":3},{"id":"getgroupedselectedrowmodel","text":"getGroupedSelectedRowModel","level":3},{"id":"row-api","text":"Row API","level":2},{"id":"getisselected","text":"getIsSelected","level":3},{"id":"getissomeselected","text":"getIsSomeSelected","level":3},{"id":"getisallsubrowsselected","text":"getIsAllSubRowsSelected","level":3},{"id":"getcanselect","text":"getCanSelect","level":3},{"id":"getcanmultiselect","text":"getCanMultiSelect","level":3},{"id":"getcanselectsubrows","text":"getCanSelectSubRows","level":3},{"id":"toggleselected","text":"toggleSelected","level":3},{"id":"gettoggleselectedhandler","text":"getToggleSelectedHandler","level":3}]},"frameworks":[],"downloadMarkdown":"\n## State\n\nRow selection state is stored on the table using the following shape:\n\n```tsx\nexport type RowSelectionState = Record<string, boolean>\n\nexport type RowSelectionTableState = {\n  rowSelection: RowSelectionState\n}\n```\n\nBy default, the row selection state uses the index of each row as the row identifiers. Row selection state can instead be tracked with a custom unique row id by passing in a custom [getRowId](../core/table.md#getrowid) function to the the table.\n\n## Table Options\n\n### `enableRowSelection`\n\n```tsx\nenableRowSelection?: boolean | ((row: Row<TData>) => boolean)\n```\n\n- Enables/disables row selection for all rows in the table OR\n- A function that given a row, returns whether to enable/disable row selection for that row\n\n### `enableMultiRowSelection`\n\n```tsx\nenableMultiRowSelection?: boolean | ((row: Row<TData>) => boolean)\n```\n\n- Enables/disables multiple row selection for all rows in the table OR\n- A function that given a row, returns whether to enable/disable multiple row selection for that row's children/grandchildren\n\n### `enableSubRowSelection`\n\n```tsx\nenableSubRowSelection?: boolean | ((row: Row<TData>) => boolean)\n```\n\nEnables/disables automatic sub-row selection when a parent row is selected, or a function that enables/disables automatic sub-row selection for each row.\n\n(Use in combination with expanding or grouping features)\n\n### `onRowSelectionChange`\n\n```tsx\nonRowSelectionChange?: OnChangeFn<RowSelectionState>\n```\n\nIf provided, this function will be called with an `updaterFn` when `state.rowSelection` changes. This overrides the default internal state management, so you will need to persist the state change either fully or partially outside of the table.\n\n## Table API\n\n### `getToggleAllRowsSelectedHandler`\n\n```tsx\ngetToggleAllRowsSelectedHandler: () => (event: unknown) => void\n```\n\nReturns a handler that can be used to toggle all rows in the table.\n\n### `getToggleAllPageRowsSelectedHandler`\n\n```tsx\ngetToggleAllPageRowsSelectedHandler: () => (event: unknown) => void\n```\n\nReturns a handler that can be used to toggle all rows on the current page.\n\n### `setRowSelection`\n\n```tsx\nsetRowSelection: (updater: Updater<RowSelectionState>) => void\n```\n\nSets or updates the `state.rowSelection` state.\n\n### `resetRowSelection`\n\n```tsx\nresetRowSelection: (defaultState?: boolean) => void\n```\n\nResets the **rowSelection** state to the `initialState.rowSelection`, or `true` can be passed to force a default blank state reset to `{}`.\n\n### `getIsAllRowsSelected`\n\n```tsx\ngetIsAllRowsSelected: () => boolean\n```\n\nReturns whether or not all rows in the table are selected.\n\n### `getIsAllPageRowsSelected`\n\n```tsx\ngetIsAllPageRowsSelected: () => boolean\n```\n\nReturns whether or not all rows on the current page are selected.\n\n### `getIsSomeRowsSelected`\n\n```tsx\ngetIsSomeRowsSelected: () => boolean\n```\n\nReturns whether or not any rows in the table are selected.\n\n### `getIsSomePageRowsSelected`\n\n```tsx\ngetIsSomePageRowsSelected: () => boolean\n```\n\nReturns whether or not any rows on the current page are selected.\n\n### `toggleAllRowsSelected`\n\n```tsx\ntoggleAllRowsSelected: (value: boolean) => void\n```\n\nSelects/deselects all rows in the table.\n\n### `toggleAllPageRowsSelected`\n\n```tsx\ntoggleAllPageRowsSelected: (value: boolean) => void\n```\n\nSelects/deselects all rows on the current page.\n\n### `getPreSelectedRowModel`\n\n```tsx\ngetPreSelectedRowModel: () => RowModel<TData>\n```\n\n### `getSelectedRowModel`\n\n```tsx\ngetSelectedRowModel: () => RowModel<TData>\n```\n\n### `getFilteredSelectedRowModel`\n\n```tsx\ngetFilteredSelectedRowModel: () => RowModel<TData>\n```\n\n### `getGroupedSelectedRowModel`\n\n```tsx\ngetGroupedSelectedRowModel: () => RowModel<TData>\n```\n\n## Row API\n\n### `getIsSelected`\n\n```tsx\ngetIsSelected: () => boolean\n```\n\nReturns whether or not the row is selected.\n\n### `getIsSomeSelected`\n\n```tsx\ngetIsSomeSelected: () => boolean\n```\n\nReturns whether or not some of the row's sub rows are selected.\n\n### `getIsAllSubRowsSelected`\n\n```tsx\ngetIsAllSubRowsSelected: () => boolean\n```\n\nReturns whether or not all of the row's sub rows are selected.\n\n### `getCanSelect`\n\n```tsx\ngetCanSelect: () => boolean\n```\n\nReturns whether or not the row can be selected.\n\n### `getCanMultiSelect`\n\n```tsx\ngetCanMultiSelect: () => boolean\n```\n\nReturns whether or not the row can multi-select.\n\n### `getCanSelectSubRows`\n\n```tsx\ngetCanSelectSubRows: () => boolean\n```\n\nReturns whether or not the row can select sub rows automatically when the parent row is selected.\n\n### `toggleSelected`\n\n```tsx\ntoggleSelected: (value?: boolean) => void\n```\n\nSelects/deselects the row.\n\n### `getToggleSelectedHandler`\n\n```tsx\ngetToggleSelectedHandler: () => (event: unknown) => void\n```\n\nReturns a handler that can be used to toggle the row.\n","originalRawMarkdown":"---\ntitle: Row Selection APIs\nid: row-selection\n---\n\n## State\n\nRow selection state is stored on the table using the following shape:\n\n```tsx\nexport type RowSelectionState = Record<string, boolean>\n\nexport type RowSelectionTableState = {\n  rowSelection: RowSelectionState\n}\n```\n\nBy default, the row selection state uses the index of each row as the row identifiers. Row selection state can instead be tracked with a custom unique row id by passing in a custom [getRowId](../core/table.md#getrowid) function to the the table.\n\n## Table Options\n\n### `enableRowSelection`\n\n```tsx\nenableRowSelection?: boolean | ((row: Row<TData>) => boolean)\n```\n\n- Enables/disables row selection for all rows in the table OR\n- A function that given a row, returns whether to enable/disable row selection for that row\n\n### `enableMultiRowSelection`\n\n```tsx\nenableMultiRowSelection?: boolean | ((row: Row<TData>) => boolean)\n```\n\n- Enables/disables multiple row selection for all rows in the table OR\n- A function that given a row, returns whether to enable/disable multiple row selection for that row's children/grandchildren\n\n### `enableSubRowSelection`\n\n```tsx\nenableSubRowSelection?: boolean | ((row: Row<TData>) => boolean)\n```\n\nEnables/disables automatic sub-row selection when a parent row is selected, or a function that enables/disables automatic sub-row selection for each row.\n\n(Use in combination with expanding or grouping features)\n\n### `onRowSelectionChange`\n\n```tsx\nonRowSelectionChange?: OnChangeFn<RowSelectionState>\n```\n\nIf provided, this function will be called with an `updaterFn` when `state.rowSelection` changes. This overrides the default internal state management, so you will need to persist the state change either fully or partially outside of the table.\n\n## Table API\n\n### `getToggleAllRowsSelectedHandler`\n\n```tsx\ngetToggleAllRowsSelectedHandler: () => (event: unknown) => void\n```\n\nReturns a handler that can be used to toggle all rows in the table.\n\n### `getToggleAllPageRowsSelectedHandler`\n\n```tsx\ngetToggleAllPageRowsSelectedHandler: () => (event: unknown) => void\n```\n\nReturns a handler that can be used to toggle all rows on the current page.\n\n### `setRowSelection`\n\n```tsx\nsetRowSelection: (updater: Updater<RowSelectionState>) => void\n```\n\nSets or updates the `state.rowSelection` state.\n\n### `resetRowSelection`\n\n```tsx\nresetRowSelection: (defaultState?: boolean) => void\n```\n\nResets the **rowSelection** state to the `initialState.rowSelection`, or `true` can be passed to force a default blank state reset to `{}`.\n\n### `getIsAllRowsSelected`\n\n```tsx\ngetIsAllRowsSelected: () => boolean\n```\n\nReturns whether or not all rows in the table are selected.\n\n### `getIsAllPageRowsSelected`\n\n```tsx\ngetIsAllPageRowsSelected: () => boolean\n```\n\nReturns whether or not all rows on the current page are selected.\n\n### `getIsSomeRowsSelected`\n\n```tsx\ngetIsSomeRowsSelected: () => boolean\n```\n\nReturns whether or not any rows in the table are selected.\n\n### `getIsSomePageRowsSelected`\n\n```tsx\ngetIsSomePageRowsSelected: () => boolean\n```\n\nReturns whether or not any rows on the current page are selected.\n\n### `toggleAllRowsSelected`\n\n```tsx\ntoggleAllRowsSelected: (value: boolean) => void\n```\n\nSelects/deselects all rows in the table.\n\n### `toggleAllPageRowsSelected`\n\n```tsx\ntoggleAllPageRowsSelected: (value: boolean) => void\n```\n\nSelects/deselects all rows on the current page.\n\n### `getPreSelectedRowModel`\n\n```tsx\ngetPreSelectedRowModel: () => RowModel<TData>\n```\n\n### `getSelectedRowModel`\n\n```tsx\ngetSelectedRowModel: () => RowModel<TData>\n```\n\n### `getFilteredSelectedRowModel`\n\n```tsx\ngetFilteredSelectedRowModel: () => RowModel<TData>\n```\n\n### `getGroupedSelectedRowModel`\n\n```tsx\ngetGroupedSelectedRowModel: () => RowModel<TData>\n```\n\n## Row API\n\n### `getIsSelected`\n\n```tsx\ngetIsSelected: () => boolean\n```\n\nReturns whether or not the row is selected.\n\n### `getIsSomeSelected`\n\n```tsx\ngetIsSomeSelected: () => boolean\n```\n\nReturns whether or not some of the row's sub rows are selected.\n\n### `getIsAllSubRowsSelected`\n\n```tsx\ngetIsAllSubRowsSelected: () => boolean\n```\n\nReturns whether or not all of the row's sub rows are selected.\n\n### `getCanSelect`\n\n```tsx\ngetCanSelect: () => boolean\n```\n\nReturns whether or not the row can be selected.\n\n### `getCanMultiSelect`\n\n```tsx\ngetCanMultiSelect: () => boolean\n```\n\nReturns whether or not the row can multi-select.\n\n### `getCanSelectSubRows`\n\n```tsx\ngetCanSelectSubRows: () => boolean\n```\n\nReturns whether or not the row can select sub rows automatically when the parent row is selected.\n\n### `toggleSelected`\n\n```tsx\ntoggleSelected: (value?: boolean) => void\n```\n\nSelects/deselects the row.\n\n### `getToggleSelectedHandler`\n\n```tsx\ngetToggleSelectedHandler: () => (event: unknown) => void\n```\n\nReturns a handler that can be used to toggle the row.\n"}
