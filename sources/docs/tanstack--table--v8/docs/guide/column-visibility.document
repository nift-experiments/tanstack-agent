ic property on a column, but in v8, there is a dedicated "},{"type":"inlineCode","value":"columnVisibility"},{"type":"text","value":" state and APIs for managing column visibility dynamically."}]},{"type":"heading","depth":3,"id":"column-visibility-state","children":[{"type":"text","value":"Column Visibility State"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"columnVisibility"},{"type":"text","value":" state is a map of column IDs to boolean values. A column will be hidden if its ID is present in the map and the value is "},{"type":"inlineCode","value":"false"},{"type":"text","value":". If the column ID is not present in the map, or the value is "},{"type":"inlineCode","value":"true"},{"type":"text","value":", the column will be shown."}]},{"type":"code","value":"const [columnVisibility, setColumnVisibility] = useState({\n  columnId1: true,\n  columnId2: false, //hide this column by default\n  columnId3: true,\n});\n\nconst table = useReactTable({\n  //...\n  state: {\n    columnVisibility,\n    //...\n  },\n  onColumnVisibilityChange: setColumnVisibility,\n});","lang":"jsx"},{"type":"paragraph","children":[{"type":"text","value":"Alternatively, if you don't need to manage the column visibility state outside of the table, you can still set the initial default column visibility state using the "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" option."}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note"}]},{"type":"text","value":": If "},{"type":"inlineCode","value":"columnVisibility"},{"type":"text","value":" is provided to both "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" and "},{"type":"inlineCode","value":"state"},{"type":"text","value":", the "},{"type":"inlineCode","value":"state"},{"type":"text","value":" initialization will take precedence and "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" will be ignored. Do not provide "},{"type":"inlineCode","value":"columnVisibility"},{"type":"text","value":" to both "},{"type":"inlineCode","value":"initialState"},{"type":"text","value":" and "},{"type":"inlineCode","value":"state"},{"type":"text","value":", only one or the other."}]}]},{"type":"code","value":"const table = useReactTable({\n  //...\n  initialState: {\n    columnVisibility: {\n      columnId1: true,\n      columnId2: false, //hide this column by default\n      columnId3: true,\n    },\n    //...\n  },\n});","lang":"jsx"},{"type":"heading","depth":3,"id":"disable-hiding-columns","children":[{"type":"text","value":"Disable Hiding Columns"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, all columns can be hidden or shown. If you want to prevent certain columns from being hidden, you set the "},{"type":"inlineCode","value":"enableHiding"},{"type":"text","value":" column option to "},{"type":"inlineCode","value":"false"},{"type":"text","value":" for those columns."}]},{"type":"code","value":"const columns = [\n  {\n    header: 'ID',\n    accessorKey: 'id',\n    enableHiding: false, // disable hiding for this column\n  },\n  {\n    header: 'Name',\n    accessor: 'name', // can be hidden\n  },\n];","lang":"jsx"},{"type":"heading","depth":3,"id":"column-visibility-toggle-apis","children":[{"type":"text","value":"Column Visibility Toggle APIs"}]},{"type":"paragraph","children":[{"type":"text","value":"There are several column API methods that are useful for rendering column visibility toggles in the UI."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"column.getCanHide"},{"type":"text","value":" - Useful for disabling the visibility toggle for a column that has "},{"type":"inlineCode","value":"enableHiding"},{"type":"text","value":" set to "},{"type":"inlineCode","value":"false"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"column.getIsVisible"},{"type":"text","value":" - Useful for setting the initial state of the visibility toggle."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"column.toggleVisibility"},{"type":"text","value":" - Useful for toggling the visibility of a column."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"column.getToggleVisibilityHandler"},{"type":"text","value":" - Shortcut for hooking up the "},{"type":"inlineCode","value":"column.toggleVisibility"},{"type":"text","value":" method to a UI event handler."}]}]}]},{"type":"code","value":"{table.getAllColumns().map((column) => (\n  <label key={column.id}>\n    <input\n      checked={column.getIsVisible()}\n      disabled={!column.getCanHide()}\n      onChange={column.getToggleVisibilityHandler()}\n      type=\"checkbox\"\n    />\n    {column.columnDef.header}\n  </label>\n))}","lang":"jsx"},{"type":"heading","depth":3,"id":"column-visibility-aware-table-apis","children":[{"type":"text","value":"Column Visibility Aware Table APIs"}]},{"type":"paragraph","children":[{"type":"text","value":"When you render your header, body, and footer cells, there are a lot of API options available. You may see APIs like "},{"type":"inlineCode","value":"table.getAllLeafColumns"},{"type":"text","value":" and "},{"type":"inlineCode","value":"row.getAllCells"},{"type":"text","value":", but if you use these APIs, they will not take column visibility into account. Instead, you need to use the \"visible\" variants of these APIs, such as "},{"type":"inlineCode","value":"table.getVisibleLeafColumns"},{"type":"text","value":" and "},{"type":"inlineCode","value":"row.getVisibleCells"},{"type":"text","value":"."}]},{"type":"code","value":"<table>\n  <thead>\n    <tr>\n      {table.getVisibleLeafColumns().map((column) => ( // takes column visibility into account\n        //\n      ))}\n    </tr>\n  </thead>\n  <tbody>\n    {table.getRowModel().rows.map((row) => (\n      <tr key={row.id}>\n        {row.getVisibleCells().map((cell) => ( // takes column visibility into account\n          //\n        ))}\n      </tr>\n    ))}\n  </tbody>\n</table>","lang":"jsx"},{"type":"paragraph","children":[{"type":"text","value":"If you are using the Header Group APIs, they will already take column visibility into account."}]}],"headings":[{"id":"examples","text":"Examples","level":2},{"id":"other-examples","text":"Other Examples","level":3},{"id":"api","text":"API","level":2},{"id":"column-visibility-guide","text":"Column Visibility Guide","level":2},{"id":"column-visibility-state","text":"Column Visibility State","level":3},{"id":"disable-hiding-columns","text":"Disable Hiding Columns","level":3},{"id":"column-visibility-toggle-apis","text":"Column Visibility Toggle APIs","level":3},{"id":"column-visibility-aware-table-apis","text":"Column Visibility Aware Table APIs","level":3}]},"frameworks":[],"downloadMarkdown":"\n## Examples\n\nWant to skip to the implementation? Check out these examples:\n\n- [column-visibility](../framework/react/examples/column-visibility)\n- [column-ordering](../framework/react/examples/column-ordering)\n- [sticky-column-pinning](../framework/react/examples/column-pinning-sticky)\n\n### Other Examples\n\n- [SolidJS column-visibility](../framework/solid/examples/column-visibility)\n- [Svelte column-visibility](../framework/svelte/examples/column-visibility)\n\n## API\n\n[Column Visibility API](../api/features/column-visibility)\n\n## Column Visibility Guide\n\nThe column visibility feature allows table columns to be hidden or shown dynamically. In previous versions of react-table, this feature was a static property on a column, but in v8, there is a dedicated `columnVisibility` state and APIs for managing column visibility dynamically.\n\n### Column Visibility State\n\nThe `columnVisibility` state is a map of column IDs to boolean values. A column will be hidden if its ID is present in the map and the value is `false`. If the column ID is not present in the map, or the value is `true`, the column will be shown.\n\n```jsx\nconst [columnVisibility, setColumnVisibility] = useState({\n  columnId1: true,\n  columnId2: false, //hide this column by default\n  columnId3: true,\n});\n\nconst table = useReactTable({\n  //...\n  state: {\n    columnVisibility,\n    //...\n  },\n  onColumnVisibilityChange: setColumnVisibility,\n});\n```\n\nAlternatively, if you don't need to manage the column visibility state outside of the table, you can still set the initial default column visibility state using the `initialState` option.\n\n> **Note**: If `columnVisibility` is provided to both `initialState` and `state`, the `state` initialization will take precedence and `initialState` will be ignored. Do not provide `columnVisibility` to both `initialState` and `state`, only one or the other.\n\n```jsx\nconst table = useReactTable({\n  //...\n  initialState: {\n    columnVisibility: {\n      columnId1: true,\n      columnId2: false, //hide this column by default\n      columnId3: true,\n    },\n    //...\n  },\n});\n```\n\n### Disable Hiding Columns\n\nBy default, all columns can be hidden or shown. If you want to prevent certain columns from being hidden, you set the `enableHiding` column option to `false` for those columns.\n\n```jsx\nconst columns = [\n  {\n    header: 'ID',\n    accessorKey: 'id',\n    enableHiding: false, // disable hiding for this column\n  },\n  {\n    header: 'Name',\n    accessor: 'name', // can be hidden\n  },\n];\n```\n\n### Column Visibility Toggle APIs\n\nThere are several column API methods that are useful for rendering column visibility toggles in the UI.\n\n- `column.getCanHide` - Useful for disabling the visibility toggle for a column that has `enableHiding` set to `false`.\n- `column.getIsVisible` - Useful for setting the initial state of the visibility toggle.\n- `column.toggleVisibility` - Useful for toggling the visibility of a column.\n- `column.getToggleVisibilityHandler` - Shortcut for hooking up the `column.toggleVisibility` method to a UI event handler.\n\n```jsx\n{table.getAllColumns().map((column) => (\n  <label key={column.id}>\n    <input\n      checked={column.getIsVisible()}\n      disabled={!column.getCanHide()}\n      onChange={column.getToggleVisibilityHandler()}\n      type=\"checkbox\"\n    />\n    {column.columnDef.header}\n  </label>\n))}\n```\n\n### Column Visibility Aware Table APIs\n\nWhen you render your header, body, and footer cells, there are a lot of API options available. You may see APIs like `table.getAllLeafColumns` and `row.getAllCells`, but if you use these APIs, they will not take column visibility into account. Instead, you need to use the \"visible\" variants of these APIs, such as `table.getVisibleLeafColumns` and `row.getVisibleCells`.\n\n```jsx\n<table>\n  <thead>\n    <tr>\n      {table.getVisibleLeafColumns().map((column) => ( // takes column visibility into account\n        //\n      ))}\n    </tr>\n  </thead>\n  <tbody>\n    {table.getRowModel().rows.map((row) => (\n      <tr key={row.id}>\n        {row.getVisibleCells().map((cell) => ( // takes column visibility into account\n          //\n        ))}\n      </tr>\n    ))}\n  </tbody>\n</table>\n```\n\nIf you are using the Header Group APIs, they will already take column visibility into account.\n","originalRawMarkdown":"---\ntitle: Column Visibility Guide\n---\n\n## Examples\n\nWant to skip to the implementation? Check out these examples:\n\n- [column-visibility](../framework/react/examples/column-visibility)\n- [column-ordering](../framework/react/examples/column-ordering)\n- [sticky-column-pinning](../framework/react/examples/column-pinning-sticky)\n\n### Other Examples\n\n- [SolidJS column-visibility](../framework/solid/examples/column-visibility)\n- [Svelte column-visibility](../framework/svelte/examples/column-visibility)\n\n## API\n\n[Column Visibility API](../api/features/column-visibility)\n\n## Column Visibility Guide\n\nThe column visibility feature allows table columns to be hidden or shown dynamically. In previous versions of react-table, this feature was a static property on a column, but in v8, there is a dedicated `columnVisibility` state and APIs for managing column visibility dynamically.\n\n### Column Visibility State\n\nThe `columnVisibility` state is a map of column IDs to boolean values. A column will be hidden if its ID is present in the map and the value is `false`. If the column ID is not present in the map, or the value is `true`, the column will be shown.\n\n```jsx\nconst [columnVisibility, setColumnVisibility] = useState({\n  columnId1: true,\n  columnId2: false, //hide this column by default\n  columnId3: true,\n});\n\nconst table = useReactTable({\n  //...\n  state: {\n    columnVisibility,\n    //...\n  },\n  onColumnVisibilityChange: setColumnVisibility,\n});\n```\n\nAlternatively, if you don't need to manage the column visibility state outside of the table, you can still set the initial default column visibility state using the `initialState` option.\n\n> **Note**: If `columnVisibility` is provided to both `initialState` and `state`, the `state` initialization will take precedence and `initialState` will be ignored. Do not provide `columnVisibility` to both `initialState` and `state`, only one or the other.\n\n```jsx\nconst table = useReactTable({\n  //...\n  initialState: {\n    columnVisibility: {\n      columnId1: true,\n      columnId2: false, //hide this column by default\n      columnId3: true,\n    },\n    //...\n  },\n});\n```\n\n### Disable Hiding Columns\n\nBy default, all columns can be hidden or shown. If you want to prevent certain columns from being hidden, you set the `enableHiding` column option to `false` for those columns.\n\n```jsx\nconst columns = [\n  {\n    header: 'ID',\n    accessorKey: 'id',\n    enableHiding: false, // disable hiding for this column\n  },\n  {\n    header: 'Name',\n    accessor: 'name', // can be hidden\n  },\n];\n```\n\n### Column Visibility Toggle APIs\n\nThere are several column API methods that are useful for rendering column visibility toggles in the UI.\n\n- `column.getCanHide` - Useful for disabling the visibility toggle for a column that has `enableHiding` set to `false`.\n- `column.getIsVisible` - Useful for setting the initial state of the visibility toggle.\n- `column.toggleVisibility` - Useful for toggling the visibility of a column.\n- `column.getToggleVisibilityHandler` - Shortcut for hooking up the `column.toggleVisibility` method to a UI event handler.\n\n```jsx\n{table.getAllColumns().map((column) => (\n  <label key={column.id}>\n    <input\n      checked={column.getIsVisible()}\n      disabled={!column.getCanHide()}\n      onChange={column.getToggleVisibilityHandler()}\n      type=\"checkbox\"\n    />\n    {column.columnDef.header}\n  </label>\n))}\n```\n\n### Column Visibility Aware Table APIs\n\nWhen you render your header, body, and footer cells, there are a lot of API options available. You may see APIs like `table.getAllLeafColumns` and `row.getAllCells`, but if you use these APIs, they will not take column visibility into account. Instead, you need to use the \"visible\" variants of these APIs, such as `table.getVisibleLeafColumns` and `row.getVisibleCells`.\n\n```jsx\n<table>\n  <thead>\n    <tr>\n      {table.getVisibleLeafColumns().map((column) => ( // takes column visibility into account\n        //\n      ))}\n    </tr>\n  </thead>\n  <tbody>\n    {table.getRowModel().rows.map((row) => (\n      <tr key={row.id}>\n        {row.getVisibleCells().map((cell) => ( // takes column visibility into account\n          //\n        ))}\n      </tr>\n    ))}\n  </tbody>\n</table>\n```\n\nIf you are using the Header Group APIs, they will already take column visibility into account.\n"}
