eact-table"},{"type":"text","value":" + "},{"type":"inlineCode","value":"@tanstack/react-table"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"react-virtual"},{"type":"text","value":" + "},{"type":"inlineCode","value":"@tanstack/react-virtual"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Do not assume every rename or adjacent product belongs in the same lineage forever. The model should allow future time-aware lineage rules if simple summing becomes misleading."}]},{"type":"paragraph","children":[{"type":"text","value":"V1 rule:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"tracked entities use a flat array of package names and simple summed downloads"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Future rule if needed:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"tracked entities can support time-bounded package membership"}]}]}]},{"type":"heading","depth":2,"id":"ranking-and-normalization","children":[{"type":"text","value":"Ranking and Normalization"}]},{"type":"paragraph","children":[{"type":"text","value":"Raw download growth is not a good primary signal because the entire ecosystem is growing."}]},{"type":"heading","depth":3,"id":"primary-ranking-metric","children":[{"type":"text","value":"Primary ranking metric"}]},{"type":"paragraph","children":[{"type":"text","value":"Use trailing 28-day downloads for rank within a watchlist."}]},{"type":"paragraph","children":[{"type":"text","value":"Why 28-day:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"smoother than daily or weekly"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"still responsive enough for weekly digests"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"less sensitive to npm reporting noise"}]}]}]},{"type":"heading","depth":3,"id":"primary-normalization-metric-share-of-watchlist","children":[{"type":"text","value":"Primary normalization metric: share of watchlist"}]},{"type":"code","value":"share_of_watchlist = entity_28d_downloads / sum(all_watchlist_entity_28d_downloads)","lang":"txt"},{"type":"paragraph","children":[{"type":"text","value":"This should be the main lens in digests because it makes leaders and laggards visible even when the whole cohort is growing."}]},{"type":"heading","depth":3,"id":"secondary-normalization-metric-relative-growth-vs-cohort","children":[{"type":"text","value":"Secondary normalization metric: relative growth vs cohort"}]},{"type":"code","value":"relative_growth = entity_growth_rate - median_growth_rate_of_watchlist","lang":"txt"},{"type":"paragraph","children":[{"type":"text","value":"This helps answer whether a library is outperforming or underperforming peers."}]},{"type":"heading","depth":3,"id":"optional-tertiary-benchmark-ecosystem-index","children":[{"type":"text","value":"Optional tertiary benchmark: ecosystem index"}]},{"type":"paragraph","children":[{"type":"text","value":"Do not use a raw sum of giant packages as the main baseline."}]},{"type":"paragraph","children":[{"type":"text","value":"If we add an ecosystem benchmark, it should come from a stable curated basket like "},{"type":"inlineCode","value":"JavaScript Ecosystem Leaders"},{"type":"text","value":" and use a median or trimmed-mean growth factor rather than raw weighted sum."}]},{"type":"heading","depth":3,"id":"digest-metrics-to-show-in-v1","children":[{"type":"text","value":"Digest metrics to show in v1"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"rank"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"rank delta"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"share of watchlist"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"share delta"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"trailing 4-week trend"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"crossover events"}]}]}]},{"type":"heading","depth":2,"id":"trend-detection","children":[{"type":"text","value":"Trend Detection"}]},{"type":"paragraph","children":[{"type":"text","value":"Avoid generic \"anomaly detection\" in v1."}]},{"type":"paragraph","children":[{"type":"text","value":"The data is too noisy and npm has known reporting weirdness. We already correct obvious outliers and zero-day anomalies in the stats pipeline."}]},{"type":"paragraph","children":[{"type":"text","value":"If we surface trend change signals, they should be conservative and digest-oriented."}]},{"type":"paragraph","children":[{"type":"text","value":"Suggested v1 notable movement rules:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"rank changed by at least 1"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"share moved by a meaningful threshold"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"one entity crossed another and stayed ahead for at least one full digest period"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"growth outperformed the cohort median by a meaningful margin"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Possible later signals:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"sustained acceleration over 4 weeks vs prior 8 to 12 weeks"}