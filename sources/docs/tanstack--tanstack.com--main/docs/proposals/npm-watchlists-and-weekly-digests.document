ike "},{"type":"inlineCode","value":"router-ecosystem"},{"type":"text","value":" can be "},{"type":"inlineCode","value":"overlap"}]}]}]},{"type":"heading","depth":2,"id":"popular-comparisons-migration","children":[{"type":"text","value":"Popular Comparisons Migration"}]},{"type":"paragraph","children":[{"type":"text","value":"The current "},{"type":"inlineCode","value":"popular comparisons"},{"type":"text","value":" file is useful but not a good source of truth."}]},{"type":"paragraph","children":[{"type":"text","value":"Migration direction:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Build the entity, rollup, and watchlist registry."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Rebuild "},{"type":"inlineCode","value":"getPopularComparisons()"},{"type":"text","value":" from curated watchlists and rollups flagged for chart use."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Keep the existing route behavior and "},{"type":"inlineCode","value":"packageGroup"},{"type":"text","value":" output shape unchanged at first."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Add rollup-aware chart grouping later."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Remove duplicated manual comparison definitions once parity looks good."}]}]}]},{"type":"heading","depth":2,"id":"handoff-notes","children":[{"type":"text","value":"Handoff Notes"}]},{"type":"paragraph","children":[{"type":"text","value":"If another agent picks this up, these are the highest-value next steps already implied by the current plan."}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Convert the draft model into a real "},{"type":"inlineCode","value":"s