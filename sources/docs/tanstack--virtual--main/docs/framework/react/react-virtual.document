{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineCode","value":"@tanstack/react-virtual"},{"type":"text","value":" adapter is a wrapper around the core virtual logic."}]},{"type":"heading","depth":2,"id":"usevirtualizer","children":[{"type":"inlineCode","value":"useVirtualizer"}]},{"type":"code","value":"function useVirtualizer<TScrollElement, TItemElement = unknown>(\n  options: PartialKeys<\n    ReactVirtualizerOptions<TScrollElement, TItemElement>,\n    'observeElementRect' | 'observeElementOffset' | 'scrollToFn'\n  >,\n): Virtualizer<TScrollElement, TItemElement>","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"This function returns a standard "},{"type":"inlineCode","value":"Virtualizer"},{"type":"text","value":" instance configured to work with an HTML element as the scrollElement."}]},{"type":"heading","depth":2,"id":"usewindowvirtualizer","children":[{"type":"inlineCode","value":"useWindowVirtualizer"}]},{"type":"code","value":"function useWindowVirtualizer<TItemElement = unknown>(\n  options: PartialKeys<\n    ReactVirtualizerOptions<Window, TItemElement>,\n    | 'getScrollElement'\n    | 'observeElementRect'\n    | 'observeElementOffset'\n    | 'scrollToFn'\n  >,\n): Virtualizer<Window, TItemElement>","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"This function returns a window-based "},{"type":"inlineCode","value":"Virtualizer"},{"type":"text","value":" instance configured to work with the window as the scrollElement."}]},{"type":"heading","depth":2,"id":"react-specific-options","children":[{"type":"text","value":"React-Specific Options"}]},{"type":"heading","depth":3,"id":"useflushsync","children":[{"type":"inlineCode","value":"useFlushSync"}]},{"type":"code","value":"type ReactVirtualizerOptions<TScrollElement, TItemElement> = \n  VirtualizerOptions<TScrollElement, TItemElement> & {\n    useFlushSync?: boolean\n  }","lang":"tsx"},{"type":"paragraph","children":[{"type":"text","value":"Both "},{"type":"inlineCode","value":"useVirtualizer"},{"type":"text","value":" and "},{"type":"inlineCode","value":"useWindowVirtualizer"},{"type":"text","value":" accept a "},{"type":"inlineCode","value":"useFlushSync"},{"type":"text","value":" option that controls whether React's "},{"type":"inlineCode","value":"flushSync"},{"type":"text","value":" is used for synchronous updates."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Type"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Default"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"true"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Description"}]},{"type":"text","value":": When "},{"type":"inlineCode","value":"true"},{"type":"text","value":", the virtualizer will use "},{"type":"inlineCode","value":"flushSync"},{"type":"text","value":" from "},{"type":"inlineCode","value":"react-dom"},{"type":"text","value":" to ensure synchronous rendering during scroll events. This provides the most accurate scrolling behavior but may impact performance in some scenarios."}]}]}]},{"type":"heading","depth":4,"id":"when-to-disable-useflushsync","children":[{"type":"text","value":"When to disable "},{"type":"inlineCode","value":"useFlushSync"}]},{"type":"paragraph","children":[{"type":"text","value":"You may want to set "},{"type":"inlineCode","value":"useFlushSync: false"},{"type":"text","value":" in the following scenarios:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"React 19 compatibility"}]},{"type":"text","value":": In React 19, you may see the following console warning when scrolling:"}]},{"type":"code","value":"flushSync was called from inside a lifecycle method. React cannot flush when React is already rendering. Consider moving this call to a scheduler task or micro task."},{"type":"paragraph","children":[{"type":"text","value":"Setting "},{"type":"inlineCode","value":"useFlushSync: false"},{"type":"text","value":" will eliminate this warning by allowing React to batch updates naturally."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Performance optimization"}]},{"type":"text","value":": If you experience performance issues with rapid scrolling on lower-end devices"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Testing environments"}]},{"type":"text","value":": When running tests that don't require synchronous DOM updates"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Non-critical lists"}]},{"type":"text","value":": When slight visual delays during scrolling are acceptable for better overall performance"}]}]}]},{"type":"heading","depth":4,"id":"example","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const virtualizer = useVirtualizer({\n  count: 10000,\n  getScrollElement: () => parentRef.current,\n  estimateSize: () => 50,\n  useFlushSync: false, // Disable synchronous updates\n})","lang":"tsx"},{"type":"heading","depth":3,"id":"directdomupdates","children":[{"type":"inlineCode","value":"directDomUpdates"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Type"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"boolean"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Default"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"false"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Description"}]},{"type":"text","value":": Skip React re-renders for scroll-only updates. When enabled, the virtualizer writes item positions ("},{"type":"inlineCode","value":"top"},{"type":"text","value":"/"},{"type":"inlineCode","value":"left"},{"type":"text","value":" or "},{"type":"inlineCode","value":"transform"},{"type":"text","value":") and the container size ("},{"type":"inlineCode","value":"height"},{"type":"text","value":"/"},{"type":"inlineCode","value":"width"},{"type":"text","value":") directly to the DOM, and only re-renders when the visible index range or "},{"type":"inlineCode","value":"isScrolling"},{"type":"text","value":" changes."}]}]}]},{"type":"heading","depth":4,"id":"requirements-when-enabled","children":[{"type":"text","value":"Requirements when enabled"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Item elements must be "},{"type":"inlineCode","value":"position: absolute"},{"type":"text","value":"; in "},{"type":"inlineCode","value":"'transform'"},{"type":"text","value":" mode they must also be anchored with "},{"type":"inlineCode","value":"top: 0"},{"type":"text","value":" / "},{"type":"inlineCode","value":"left: 0"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Item elements must "},{"type":"strong","children":[{"type":"text","value":"not"}]},{"type":"text","value":" set the main-axis position in their style — the virtualizer owns "},{"type":"inlineCode","value":"top"},{"type":"text","value":" / "},{"type":"inlineCode","value":"left"},{"type":"text","value":" in "},{"type":"inlineCode","value":"'position'"},{"type":"text","value":" mode and "},{"type":"inlineCode","value":"transform"},{"type":"text","value":" in "},{"type":"inlineCode","value":"'transform'"},{"type":"text","value":" mode."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"The inner size container must receive "},{"type":"inlineCode","value":"virtualizer.containerRef"},{"type":"text","value":" and must "},{"type":"strong","children":[{"type":"text","value":"not"}]},{"type":"text","value":" set "},{"type":"inlineCode","value":"height"},{"type":"text","value":" / "},{"type":"inlineCode","value":"width"},{"type":"text","value":" in its style."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"For multi-lane layouts (grids / masonry), the cross-axis position (e.g. "},{"type":"inlineCode","value":"left: ${(item.lane * 100) / lanes}%"},{"type":"text","value":") is stable per item and must still be set in your JSX — only the main axis is automated."}]}]}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"⚠️ This flag is intended to be set once at mount. Toggling it (or "},{"type":"inlineCode","value":"directDomUpdatesMode"},{"type":"text","value":") at runtime can leave stale inline styles on items and the container."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note:"}]},{"type":"text","value":" If you omit "},{"type":"inlineCode","value":"containerRef"},{"type":"text","value":", the virtualizer makes no direct DOM writes — it writes neither item positions nor the container size. You're then responsible for positioning items and sizing the container yourself (e.g. in "},{"type":"inlineCode","value":"onChange"},{"type":"text","value":"), while still benefiting from the skipped re-renders."}]}]},{"type":"heading","depth":4,"id":"example-2","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const virtualizer = useVirtualizer({\n  count: 10000,\n  getScrollElement: () => parentRef.current,\n  estimateSize: () => 50,\n  directDomUpdates: true,\n})\n\nreturn (\n  <div ref={parentRef} style={{ overflow: 'auto', height: 400 }}>\n    {/* The inner container must use virtualizer.containerRef and not set height */}\n    <div ref={virtualizer.containerRef} style={{ position: 'relative' }}>\n      {virtualizer.getVirtualItems().map((item) => (\n        <div\n          key={item.key}\n          ref={virtualizer.measureElement}\n          data-index={item.index}\n          style={{\n            position: 'absolute',\n            top: 0,\n            left: 0,\n            width: '100%',\n            // Do NOT set top/left/transform — the virtualizer handles it\n          }}\n        >\n          Row {item.index}\n        </div>\n      ))}\n    </div>\n  </div>\n)","lang":"tsx"},{"type":"heading","depth":3,"id":"directdomupdatesmode","children":[{"type":"inlineCode","value":"directDomUpdatesMode"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Type"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"'position' | 'transform'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Default"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"'transform'"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Description"}]},{"type":"text","value":": Controls how "},{"type":"inlineCode","value":"directDomUpdates"},{"type":"text","value":" positions item elements."}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"'transform'"},{"type":"text","value":" (default): writes "},{"type":"inlineCode","value":"transform: translate3d(...)"},{"type":"text","value":". Promotes items to their own compositor layer — usually smoother on long lists, but creates a stacking context and can interfere with "},{"type":"inlineCode","value":"position: fixed"},{"type":"text","value":" descendants. Item elements must be anchored with "},{"type":"inlineCode","value":"position: absolute"},{"type":"text","value":", "},{"type":"inlineCode","value":"top: 0"},{"type":"text","value":", and "},{"type":"inlineCode","value":"left: 0"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"'position'"},{"type":"text","value":": writes "},{"type":"inlineCode","value":"top"},{"type":"text","value":" / "},{"type":"inlineCode","value":"left"},{"type":"text","value":". Item elements must be "},{"type":"inlineCode","value":"position: absolute"},{"type":"text","value":"."}]}]}]}]}]},{"type":"heading","depth":4,"id":"example-3","children":[{"type":"text","value":"Example"}]},{"type":"code","value":"const virtualizer = useVirtualizer({\n  count: 10000,\n  getScrollElement: () => parentRef.current,\n  estimateSize: () => 50,\n  directDomUpdates: true,\n  directDomUpdatesMode: 'position', // Use top/left instead of transform\n})","lang":"tsx"}],"headings":[{"id":"usevirtualizer","text":"useVirtualizer","level":2},{"id":"usewindowvirtualizer","text":"useWindowVirtualizer","level":2},{"id":"react-specific-options","text":"React-Specific Options","level":2},{"id":"useflushsync","text":"useFlushSync","level":3},{"id":"when-to-disable-useflushsync","text":"When to disable useFlushSync","level":4},{"id":"example","text":"Example","level":4},{"id":"directdomupdates","text":"directDomUpdates","level":3},{"id":"requirements-when-enabled","text":"Requirements when enabled","level":4},{"id":"example-2","text":"Example","level":4},{"id":"directdomupdatesmode","text":"directDomUpdatesMode","level":3},{"id":"example-3","text":"Example","level":4}]},"frameworks":[],"downloadMarkdown":"\nThe `@tanstack/react-virtual` adapter is a wrapper around the core virtual logic.\n\n## `useVirtualizer`\n\n```tsx\nfunction useVirtualizer<TScrollElement, TItemElement = unknown>(\n  options: PartialKeys<\n    ReactVirtualizerOptions<TScrollElement, TItemElement>,\n    'observeElementRect' | 'observeElementOffset' | 'scrollToFn'\n  >,\n): Virtualizer<TScrollElement, TItemElement>\n```\n\nThis function returns a standard `Virtualizer` instance configured to work with an HTML element as the scrollElement.\n\n## `useWindowVirtualizer`\n\n```tsx\nfunction useWindowVirtualizer<TItemElement = unknown>(\n  options: PartialKeys<\n    ReactVirtualizerOptions<Window, TItemElement>,\n    | 'getScrollElement'\n    | 'observeElementRect'\n    | 'observeElementOffset'\n    | 'scrollToFn'\n  >,\n): Virtualizer<Window, TItemElement>\n```\n\nThis function returns a window-based `Virtualizer` instance configured to work with the window as the scrollElement.\n\n## React-Specific Options\n\n### `useFlushSync`\n\n```tsx\ntype ReactVirtualizerOptions<TScrollElement, TItemElement> = \n  VirtualizerOptions<TScrollElement, TItemElement> & {\n    useFlushSync?: boolean\n  }\n```\n\nBoth `useVirtualizer` and `useWindowVirtualizer` accept a `useFlushSync` option that controls whether React's `flushSync` is used for synchronous updates.\n\n- **Type**: `boolean`\n- **Default**: `true`\n- **Description**: When `true`, the virtualizer will use `flushSync` from `react-dom` to ensure synchronous rendering during scroll events. This provides the most accurate scrolling behavior but may impact performance in some scenarios.\n\n#### When to disable `useFlushSync`\n\nYou may want to set `useFlushSync: false` in the following scenarios:\n\n- **React 19 compatibility**: In React 19, you may see the following console warning when scrolling:\n  ```\n  flushSync was called from inside a lifecycle method. React cannot flush when React is already rendering. Consider moving this call to a scheduler task or micro task.\n  ```\n  Setting `useFlushSync: false` will eliminate this warning by allowing React to batch updates naturally.\n- **Performance optimization**: If you experience performance issues with rapid scrolling on lower-end devices\n- **Testing environments**: When running tests that don't require synchronous DOM updates\n- **Non-critical lists**: When slight visual delays during scrolling are acceptable for better overall performance\n\n#### Example\n\n```tsx\nconst virtualizer = useVirtualizer({\n  count: 10000,\n  getScrollElement: () => parentRef.current,\n  estimateSize: () => 50,\n  useFlushSync: false, // Disable synchronous updates\n})\n```\n\n### `directDomUpdates`\n\n- **Type**: `boolean`\n- **Default**: `false`\n- **Description**: Skip React re-renders for scroll-only updates. When enabled, the virtualizer writes item positions (`top`/`left` or `transform`) and the container size (`height`/`width`) directly to the DOM, and only re-renders when the visible index range or `isScrolling` changes.\n\n#### Requirements when enabled\n\n- Item elements must be `position: absolute`; in `'transform'` mode they must also be anchored with `top: 0` / `left: 0`.\n- Item elements must **not** set the main-axis position in their style — the virtualizer owns `top` / `left` in `'position'` mode and `transform` in `'transform'` mode.\n- The inner size container must receive `virtualizer.containerRef` and must **not** set `height` / `width` in its style.\n- For multi-lane layouts (grids / masonry), the cross-axis position (e.g. `left: ${(item.lane * 100) / lanes}%`) is stable per item and must still be set in your JSX — only the main axis is automated.\n\n> ⚠️ This flag is intended to be set once at mount. Toggling it (or `directDomUpdatesMode`) at runtime can leave stale inline styles on items and the container.\n\n> **Note:** If you omit `containerRef`, the virtualizer makes no direct DOM writes — it writes neither item positions nor the container size. You're then responsible for positioning items and sizing the container yourself (e.g. in `onChange`), while still benefiting from the skipped re-renders.\n\n#### Example\n\n```tsx\nconst virtualizer = useVirtualizer({\n  count: 10000,\n  getScrollElement: () => parentRef.current,\n  estimateSize: () => 50,\n  directDomUpdates: true,\n})\n\nreturn (\n  <div ref={parentRef} style={{ overflow: 'auto', height: 400 }}>\n    {/* The inner container must use virtualizer.containerRef and not set height */}\n    <div ref={virtualizer.containerRef} style={{ position: 'relative' }}>\n      {virtualizer.getVirtualItems().map((item) => (\n        <div\n          key={item.key}\n          ref={virtualizer.measureElement}\n          data-index={item.index}\n          style={{\n            position: 'absolute',\n            top: 0,\n            left: 0,\n            width: '100%',\n            // Do NOT set top/left/transform — the virtualizer handles it\n          }}\n        >\n          Row {item.index}\n        </div>\n      ))}\n    </div>\n  </div>\n)\n```\n\n### `directDomUpdatesMode`\n\n- **Type**: `'position' | 'transform'`\n- **Default**: `'transform'`\n- **Description**: Controls how `directDomUpdates` positions item elements.\n  - `'transform'` (default): writes `transform: translate3d(...)`. Promotes items to their own compositor layer — usually smoother on long lists, but creates a stacking context and can interfere with `position: fixed` descendants. Item elements must be anchored with `position: absolute`, `top: 0`, and `left: 0`.\n  - `'position'`: writes `top` / `left`. Item elements must be `position: absolute`.\n\n#### Example\n\n```tsx\nconst virtualizer = useVirtualizer({\n  count: 10000,\n  getScrollElement: () => parentRef.current,\n  estimateSize: () => 50,\n  directDomUpdates: true,\n  directDomUpdatesMode: 'position', // Use top/left instead of transform\n})\n```\n","originalRawMarkdown":"---\ntitle: React Virtual\n---\n\nThe `@tanstack/react-virtual` adapter is a wrapper around the core virtual logic.\n\n## `useVirtualizer`\n\n```tsx\nfunction useVirtualizer<TScrollElement, TItemElement = unknown>(\n  options: PartialKeys<\n    ReactVirtualizerOptions<TScrollElement, TItemElement>,\n    'observeElementRect' | 'observeElementOffset' | 'scrollToFn'\n  >,\n): Virtualizer<TScrollElement, TItemElement>\n```\n\nThis function returns a standard `Virtualizer` instance configured to work with an HTML element as the scrollElement.\n\n## `useWindowVirtualizer`\n\n```tsx\nfunction useWindowVirtualizer<TItemElement = unknown>(\n  options: PartialKeys<\n    ReactVirtualizerOptions<Window, TItemElement>,\n    | 'getScrollElement'\n    | 'observeElementRect'\n    | 'observeElementOffset'\n    | 'scrollToFn'\n  >,\n): Virtualizer<Window, TItemElement>\n```\n\nThis function returns a window-based `Virtualizer` instance configured to work with the window as the scrollElement.\n\n## React-Specific Options\n\n### `useFlushSync`\n\n```tsx\ntype ReactVirtualizerOptions<TScrollElement, TItemElement> = \n  VirtualizerOptions<TScrollElement, TItemElement> & {\n    useFlushSync?: boolean\n  }\n```\n\nBoth `useVirtualizer` and `useWindowVirtualizer` accept a `useFlushSync` option that controls whether React's `flushSync` is used for synchronous updates.\n\n- **Type**: `boolean`\n- **Default**: `true`\n- **Description**: When `true`, the virtualizer will use `flushSync` from `react-dom` to ensure synchronous rendering during scroll events. This provides the most accurate scrolling behavior but may impact performance in some scenarios.\n\n#### When to disable `useFlushSync`\n\nYou may want to set `useFlushSync: false` in the following scenarios:\n\n- **React 19 compatibility**: In React 19, you may see the following console warning when scrolling:\n  ```\n  flushSync was called from inside a lifecycle method. React cannot flush when React is already rendering. Consider moving this call to a scheduler task or micro task.\n  ```\n  Setting `useFlushSync: false` will eliminate this warning by allowing React to batch updates naturally.\n- **Performance optimization**: If you experience performance issues with rapid scrolling on lower-end devices\n- **Testing environments**: When running tests that don't require synchronous DOM updates\n- **Non-critical lists**: When slight visual delays during scrolling are acceptable for better overall performance\n\n#### Example\n\n```tsx\nconst virtualizer = useVirtualizer({\n  count: 10000,\n  getScrollElement: () => parentRef.current,\n  estimateSize: () => 50,\n  useFlushSync: false, // Disable synchronous updates\n})\n```\n\n### `directDomUpdates`\n\n- **Type**: `boolean`\n- **Default**: `false`\n- **Description**: Skip React re-renders for scroll-only updates. When enabled, the virtualizer writes item positions (`top`/`left` or `transform`) and the container size (`height`/`width`) directly to the DOM, and only re-renders when the visible index range or `isScrolling` changes.\n\n#### Requirements when enabled\n\n- Item elements must be `position: absolute`; in `'transform'` mode they must also be anchored with `top: 0` / `left: 0`.\n- Item elements must **not** set the main-axis position in their style — the virtualizer owns `top` / `left` in `'position'` mode and `transform` in `'transform'` mode.\n- The inner size container must receive `virtualizer.containerRef` and must **not** set `height` / `width` in its style.\n- For multi-lane layouts (grids / masonry), the cross-axis position (e.g. `left: ${(item.lane * 100) / lanes}%`) is stable per item and must still be set in your JSX — only the main axis is automated.\n\n> ⚠️ This flag is intended to be set once at mount. Toggling it (or `directDomUpdatesMode`) at runtime can leave stale inline styles on items and the container.\n\n> **Note:** If you omit `containerRef`, the virtualizer makes no direct DOM writes — it writes neither item positions nor the container size. You're then responsible for positioning items and sizing the container yourself (e.g. in `onChange`), while still benefiting from the skipped re-renders.\n\n#### Example\n\n```tsx\nconst virtualizer = useVirtualizer({\n  count: 10000,\n  getScrollElement: () => parentRef.current,\n  estimateSize: () => 50,\n  directDomUpdates: true,\n})\n\nreturn (\n  <div ref={parentRef} style={{ overflow: 'auto', height: 400 }}>\n    {/* The inner container must use virtualizer.containerRef and not set height */}\n    <div ref={virtualizer.containerRef} style={{ position: 'relative' }}>\n      {virtualizer.getVirtualItems().map((item) => (\n        <div\n          key={item.key}\n          ref={virtualizer.measureElement}\n          data-index={item.index}\n          style={{\n            position: 'absolute',\n            top: 0,\n            left: 0,\n            width: '100%',\n            // Do NOT set top/left/transform — the virtualizer handles it\n          }}\n        >\n          Row {item.index}\n        </div>\n      ))}\n    </div>\n  </div>\n)\n```\n\n### `directDomUpdatesMode`\n\n- **Type**: `'position' | 'transform'`\n- **Default**: `'transform'`\n- **Description**: Controls how `directDomUpdates` positions item elements.\n  - `'transform'` (default): writes `transform: translate3d(...)`. Promotes items to their own compositor layer — usually smoother on long lists, but creates a stacking context and can interfere with `position: fixed` descendants. Item elements must be anchored with `position: absolute`, `top: 0`, and `left: 0`.\n  - `'position'`: writes `top` / `left`. Item elements must be `position: absolute`.\n\n#### Example\n\n```tsx\nconst virtualizer = useVirtualizer({\n  count: 10000,\n  getScrollElement: () => parentRef.current,\n  estimateSize: () => 50,\n  directDomUpdates: true,\n  directDomUpdatesMode: 'position', // Use top/left instead of transform\n})\n```\n"}
