ost-adapters.md","children":[{"type":"text","value":"Host adapters"}]}]}]]},{"type":"heading","depth":2,"id":"which-api-should-i-start-with","children":[{"type":"text","value":"Which API should I start with?"}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"@tanstack/workflow-core"},{"type":"text","value":" directly when:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you are writing tests"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you are embedding the replay engine into your own runtime"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you want to handle persistence, timers, and signals yourself"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"@tanstack/workflow-runtime"},{"type":"text","value":" when:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you want registered workflows"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you need schedules and timer sweeps"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you need a production store contract"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you deploy to serverless or multiple workers"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Use host adapters when:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you want a provider-native cron or scheduled function entrypoint"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you want compact sweep responses"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"you want deployment examples that fit the host"}]}]}]},{"type":"heading","depth":2,"id":"stability","children":[{"type":"text","value":"Stability"}]},{"type":"paragraph","children":[{"type":"text","value":"The runtime and adapter packages are experimental. The direction is stable:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"core stays small"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"runtime owns durable execution orchestration"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"stores implement a contract"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"host adapters stay thin"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Some names and option shapes may still change while the first production guides\nsettle."}]}],"headings":[{"id":"api-reference","text":"API reference","level":1},{"id":"packages","text":"Packages","level":2},{"id":"which-api-should-i-start-with","text":"Which API should I start with?","level":2},{"id":"stability","text":"Stability","level":2}]},"frameworks":[],"downloadMarkdown":"\n# API reference\n\nThis section is the human-authored API reference for the runtime, store, and\nhost adapter packages.\n\nThe generated reference for `@tanstack/workflow-core` still lives in\n[Generated core reference](../reference/index.md).\n\n## Packages\n\n| Package | API page |\n| --- | --- |\n| `@tanstack/workflow-core` | [Core API](core.md) |\n| `@tanstack/workflow-runtime` | [Runtime API](runtime.md) |\n| `@tanstack/workflow-store-drizzle-postgres` | [Store adapters](store-adapters.md) |\n| `@tanstack/workflow-cloudflare`, `@tanstack/workflow-railway`, `@tanstack/workflow-netlify`, and `@tanstack/workflow-vercel` | [Host adapters](host-adapters.md) |\n\n## Which API should I start with?\n\nUse `@tanstack/workflow-core` directly when:\n\n- you are writing tests\n- you are embedding the replay engine into your own runtime\n- you want to handle persistence, timers, and signals yourself\n\nUse `@tanstack/workflow-runtime` when:\n\n- you want registered workflows\n- you need schedules and timer sweeps\n- you need a production store contract\n- you deploy to serverless or multiple workers\n\nUse host adapters when:\n\n- you want a provider-native cron or scheduled function entrypoint\n- you want compact sweep responses\n- you want deployment examples that fit the host\n\n## Stability\n\nThe runtime and adapter packages are experimental. The direction is stable:\n\n- core stays small\n- runtime owns durable execution orchestration\n- stores implement a contract\n- host adapters stay thin\n\nSome names and option shapes may still change while the first production guides\nsettle.\n","originalRawMarkdown":"---\nid: api\ntitle: API Reference\n---\n\n# API reference\n\nThis section is the human-authored API reference for the runtime, store, and\nhost adapter packages.\n\nThe generated reference for `@tanstack/workflow-core` still lives in\n[Generated core reference](../reference/index.md).\n\n## Packages\n\n| Package | API page |\n| --- | --- |\n| `@tanstack/workflow-core` | [Core API](core.md) |\n| `@tanstack/workflow-runtime` | [Runtime API](runtime.md) |\n| `@tanstack/workflow-store-drizzle-postgres` | [Store adapters](store-adapters.md) |\n| `@tanstack/workflow-cloudflare`, `@tanstack/workflow-railway`, `@tanstack/workflow-netlify`, and `@tanstack/workflow-vercel` | [Host adapters](host-adapters.md) |\n\n## Which API should I start with?\n\nUse `@tanstack/workflow-core` directly when:\n\n- you are writing tests\n- you are embedding the replay engine into your own runtime\n- you want to handle persistence, timers, and signals yourself\n\nUse `@tanstack/workflow-runtime` when:\n\n- you want registered workflows\n- you need schedules and timer sweeps\n- you need a production store contract\n- you deploy to serverless or multiple workers\n\nUse host adapters when:\n\n- you want a provider-native cron or scheduled function entrypoint\n- you want compact sweep responses\n- you want deployment examples that fit the host\n\n## Stability\n\nThe runtime and adapter packages are experimental. The direction is stable:\n\n- core stays small\n- runtime owns durable execution orchestration\n- stores implement a contract\n- host adapters stay thin\n\nSome names and option shapes may still change while the first production guides\nsettle.\n"}
