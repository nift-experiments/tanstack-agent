{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"runtime-api","children":[{"type":"text","value":"Runtime API"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"@tanstack/workflow-runtime"},{"type":"text","value":" provides the deployment-independent execution\nruntime."}]},{"type":"heading","depth":2,"id":"defineworkflowruntime","children":[{"type":"inlineCode","value":"defineWorkflowRuntime"}]},{"type":"paragraph","children":[{"type":"text","value":"Registers workflows and returns runtime methods."}]},{"type":"code","value":"import { defineWorkflowRuntime } from '@tanstack/workflow-runtime'\n\nconst runtime = defineWorkflowRuntime({\n  store,\n  defaultLeaseMs: 30_000,\n  publish: async (runId, event) => {\n    await eventBus.publish(runId, event)\n  },\n  telemetry: {\n    spanNamePrefix: 'tanstack.workflow',\n  },\n  workflows: {\n    checkout: {\n      load: async () => checkoutWorkflow,\n      version: 'v2',\n      previousVersions: {\n        v1: async () => checkoutWorkflowV1,\n      },\n      schedules: [],\n    },\n  },\n})","lang":"ts"},{"type":"heading","depth":3,"id":"telemetry","children":[{"type":"text","value":"Telemetry"}]},{"type":"paragraph","children":[{"type":"text","value":"Workflow emits OpenTelemetry traces through "},{"type":"inlineCode","value":"@opentelemetry/api"},{"type":"text","value":". Applications\nown SDK/exporter setup. If no SDK is configured, spans are no-ops."}]},{"type":"code","value":"const runtime = defineWorkflowRuntime({\n  store,\n  workflows,\n  telemetry: {\n    attributes: ({ workflowId, runId }) => ({\n      'app.workflow': workflowId ?? 'unknown',\n      'app.run': runId ?? 'unknown',\n    }),\n    mapStepMeta: (meta) => ({\n      'app.step_name': String(meta.name),\n    }),\n  },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"telemetry: false"},{"type":"text","value":" or "},{"type":"inlineCode","value":"telemetry: { enabled: false }"},{"type":"text","value":" to disable tracing."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"WorkflowTelemetryOptions"},{"type":"text","value":":"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"enabled"}]},{"type":"tableCell","children":[{"type":"text","value":"Set false to disable tracing."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"tracer"}]},{"type":"tableCell","children":[{"type":"text","value":"Custom OpenTelemetry "},{"type":"inlineCode","value":"Tracer"},{"type":"text","value":". Defaults to the global tracer provider."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"spanNamePrefix"}]},{"type":"tableCell","children":[{"type":"text","value":"Prefix for Workflow span names. Defaults to "},{"type":"inlineCode","value":"tanstack.workflow"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"attributes"}]},{"type":"tableCell","children":[{"type":"text","value":"Safe shared attributes or a function that returns them per span."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"recordExceptions"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether to call "},{"type":"inlineCode","value":"span.recordException"},{"type":"text","value":". Defaults to true."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"mapStepMeta"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional mapper for safe "},{"type":"inlineCode","value":"ctx.step(..., { meta })"},{"type":"text","value":" attributes."}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Workflow never records workflow input, output, signal payloads, step results, or\nraw step metadata as attributes by default."}]},{"type":"heading","depth":3,"id":"workflow-registration","children":[{"type":"text","value":"Workflow registration"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Field"}]},{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"load"}]},{"type":"tableCell","children":[{"type":"text","value":"Async workflow loader. Can return a workflow, "},{"type":"inlineCode","value":"{ default }"},{"type":"text","value":", or "},{"type":"inlineCode","value":"{ workflow }"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"version"}]},{"type":"tableCell","children":[{"type":"text","value":"Current workflow version for new runs."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"previousVersions"}]},{"type":"tableCell","children":[{"type":"text","value":"Loaders for old versions that still have paused runs."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"schedules"}]},{"type":"tableCell","children":[{"type":"text","value":"Registered recurring schedules for this workflow."}]}]]},{"type":"heading","depth":2,"id":"runtime-deadlines","children":[{"type":"text","value":"Runtime deadlines"}]},{"type":"paragraph","children":[{"type":"text","value":"Every runtime method that can drive workflow code accepts the same budget\noptions:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"deadline"}]},{"type":"tableCell","children":[{"type":"text","value":"Absolute wall-clock deadline in UTC milliseconds."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"maxDurationMs"}]},{"type":"tableCell","children":[{"type":"text","value":"Maximum wall-clock duration for this runtime call."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"minYieldRemainingMs"}]},{"type":"tableCell","children":[{"type":"text","value":"Budget reserved before fresh durable work. Defaults to 1000ms."}]}]]},{"type":"paragraph","children":[{"type":"text","value":"When both deadline forms are present, the earlier deadline wins. The runtime\nchecks the budget before fresh "},{"type":"inlineCode","value":"step"},{"type":"text","value":", "},{"type":"inlineCode","value":"now"},{"type":"text","value":", and "},{"type":"inlineCode","value":"uuid"},{"type":"text","value":" work. A low budget\npauses the run on a durable timer, releases its lease, and lets a later sweep\nresume it. Existing "},{"type":"inlineCode","value":"sleep"},{"type":"text","value":", "},{"type":"inlineCode","value":"waitForEvent"},{"type":"text","value":", and "},{"type":"inlineCode","value":"approve"},{"type":"text","value":" calls already pause."}]},{"type":"paragraph","children":[{"type":"text","value":"Step timeouts remain per-attempt limits and do not use the runtime deadline."}]},{"type":"heading","depth":2,"id":"leases-and-recovery","children":[{"type":"text","value":"Leases and recovery"}]},{"type":"paragraph","children":[{"type":"text","value":"The runtime renews an owned run lease every third of "},{"type":"inlineCode","value":"leaseMs"},{"type":"text","value":" while workflow\ncode is running. It stops renewal before releasing the lease on completion,\npause, yield, or error. "},{"type":"inlineCode","value":"leaseMs"},{"type":"text","value":" must be a positive finite number."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"runtime.sweep()"},{"type":"text","value":" also claims expired running executions and replays them from\ntheir durable checkpoints. Completed steps are not executed again. Fresh steps\nremain at-least-once operations, so external side effects still need\nidempotency keys."}]},{"type":"heading","depth":2,"id":"live-events","children":[{"type":"text","value":"Live events"}]},{"type":"paragraph","children":[{"type":"text","value":"Set "},{"type":"inlineCode","value":"publish"},{"type":"text","value":" on the runtime or an individual runtime call to receive events as\nthey are emitted. When both are present, both publishers run. Fan-out is\nbest-effort: publisher failures do not change durable execution."}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"publish"},{"type":"text","value":" is independent of "},{"type":"inlineCode","value":"includeEvents"},{"type":"text","value":". A host can stream live events while\nsetting "},{"type":"inlineCode","value":"includeEvents: false"},{"type":"text","value":" to avoid retaining them in the final result."}]},{"type":"heading","depth":2,"id":"runtime-startrun","children":[{"type":"inlineCode","value":"runtime.startRun"}]},{"type":"paragraph","children":[{"type":"text","value":"Starts or attaches to a run ID through the runtime store."}]},{"type":"code","value":"const result = await runtime.startRun({\n  workflowId: 'checkout',\n  runId: 'checkout:order-1',\n  input: { orderId: 'order-1' },\n  leaseOwner: 'api:checkout',\n  leaseMs: 30_000,\n  includeEvents: false,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Options:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"workflowId"}]},{"type":"tableCell","children":[{"type":"text","value":"Registered workflow key."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"runId"}]},{"type":"tableCell","children":[{"type":"text","value":"Stable run identifier."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"input"}]},{"type":"tableCell","children":[{"type":"text","value":"Workflow input for new runs."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"now"}]},{"type":"tableCell","children":[{"type":"text","value":"Override current time for tests or host events."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"deadline"}]},{"type":"tableCell","children":[{"type":"text","value":"Absolute wall-clock deadline in UTC milliseconds."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"maxDurationMs"}]},{"type":"tableCell","children":[{"type":"text","value":"Maximum wall-clock duration for this call."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"minYieldRemainingMs"}]},{"type":"tableCell","children":[{"type":"text","value":"Budget reserved before fresh durable work."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"leaseOwner"}]},{"type":"tableCell","children":[{"type":"text","value":"Worker identity used while executing."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"leaseMs"}]},{"type":"tableCell","children":[{"type":"text","value":"Lease duration."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"threadId"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional core engine thread ID."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"includeEvents"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether to retain emitted events in the result. Defaults to true."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"maxEvents"}]},{"type":"tableCell","children":[{"type":"text","value":"Maximum retained events when "},{"type":"inlineCode","value":"includeEvents"},{"type":"text","value":" is true."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"publish"}]},{"type":"tableCell","children":[{"type":"text","value":"Best-effort live event publisher for this drive."}]}]]},{"type":"heading","depth":2,"id":"runtime-deliversignal","children":[{"type":"inlineCode","value":"runtime.deliverSignal"}]},{"type":"paragraph","children":[{"type":"text","value":"Delivers an external signal and resumes the run."}]},{"type":"code","value":"await runtime.deliverSignal({\n  runId: 'checkout:order-1',\n  signalId: 'stripe:evt_123',\n  name: 'payment-received',\n  payload: { paymentId: 'pi_123' },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Use stable "},{"type":"inlineCode","value":"signalId"},{"type":"text","value":" values so webhook retries are idempotent."}]},{"type":"heading","depth":2,"id":"runtime-deliverapproval","children":[{"type":"inlineCode","value":"runtime.deliverApproval"}]},{"type":"paragraph","children":[{"type":"text","value":"Delivers an approval decision and resumes the run."}]},{"type":"code","value":"await runtime.deliverApproval({\n  runId,\n  approval: {\n    approvalId,\n    approved: true,\n    feedback: 'Approved',\n  },\n})","lang":"ts"},{"type":"heading","depth":2,"id":"runtime-sweep","children":[{"type":"inlineCode","value":"runtime.sweep"}]},{"type":"paragraph","children":[{"type":"text","value":"Recovers stale running executions, then claims due schedules and timers and\ndrives them to completion or the next pause."}]},{"type":"code","value":"const result = await runtime.sweep({\n  now: Date.now(),\n  maxRecoveredRuns: 25,\n  maxScheduledRuns: 25,\n  maxTimers: 25,\n  maxDurationMs: 55_000,\n  leaseOwner: 'cron:sweep',\n  leaseMs: 30_000,\n  includeEvents: false,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Options:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"now"}]},{"type":"tableCell","children":[{"type":"text","value":"Current timestamp used for due checks."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"limit"}]},{"type":"tableCell","children":[{"type":"text","value":"Backward-compatible shared limit for recoveries, schedules, and timers."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"maxRecoveredRuns"}]},{"type":"tableCell","children":[{"type":"text","value":"Maximum expired running executions to recover."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"maxScheduledRuns"}]},{"type":"tableCell","children":[{"type":"text","value":"Maximum due schedule buckets to start."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"maxTimers"}]},{"type":"tableCell","children":[{"type":"text","value":"Maximum due timers to resume."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"deadline"}]},{"type":"tableCell","children":[{"type":"text","value":"Absolute wall-clock deadline in UTC milliseconds."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"maxDurationMs"}]},{"type":"tableCell","children":[{"type":"text","value":"Wall-clock budget for this sweep."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"minYieldRemainingMs"}]},{"type":"tableCell","children":[{"type":"text","value":"Stops claims and fresh durable work inside this margin."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"leaseOwner"}]},{"type":"tableCell","children":[{"type":"text","value":"Worker identity for claimed work."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"leaseMs"}]},{"type":"tableCell","children":[{"type":"text","value":"Lease duration."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"includeEvents"}]},{"type":"tableCell","children":[{"type":"text","value":"Whether to retain emitted events. Sweeps usually set false."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"maxEvents"}]},{"type":"tableCell","children":[{"type":"text","value":"Maximum retained events per run result."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"publish"}]},{"type":"tableCell","children":[{"type":"text","value":"Best-effort live event publisher for every driven run."}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Result:"}]},{"type":"code","value":"interface WorkflowRuntimeSweepResult {\n  recovered: ReadonlyArray<WorkflowRuntimeRunResult>\n  scheduled: ReadonlyArray<WorkflowRuntimeRunResult>\n  timers: ReadonlyArray<WorkflowRuntimeRunResult>\n  summary: WorkflowRuntimeSweepSummary\n  deadlineReached: boolean\n  remainingMayExist: boolean\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"remainingMayExist"},{"type":"text","value":" means the sweep stopped at a count or time budget, so more\ndue work may be available."}]},{"type":"heading","depth":2,"id":"cron","children":[{"type":"inlineCode","value":"cron"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates a cron schedule spec."}]},{"type":"code","value":"import { cron } from '@tanstack/workflow-runtime'\n\ncron('0 9 * * 1', { timezone: 'UTC' })","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Current materialization supports numeric five-field UTC cron schedules."}]},{"type":"heading","depth":2,"id":"every","children":[{"type":"inlineCode","value":"every"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates interval schedule specs."}]},{"type":"code","value":"import { every } from '@tanstack/workflow-runtime'\n\nevery.seconds(30)\nevery.minutes(15)\nevery.hours(1)","lang":"ts"},{"type":"heading","depth":2,"id":"materializeworkflowschedules","children":[{"type":"inlineCode","value":"materializeWorkflowSchedules"}]},{"type":"paragraph","children":[{"type":"text","value":"Computes due schedule buckets from registered workflow schedules."}]},{"type":"code","value":"import { materializeWorkflowSchedules } from '@tanstack/workflow-runtime'\n\nconst materialized = await materializeWorkflowSchedules(runtime, {\n  now: Date.now(),\n  cronLookbackMs: 24 * 60 * 60 * 1000,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Host adapters call this for you before sweeping."}]},{"type":"heading","depth":2,"id":"inmemoryworkflowexecutionstore","children":[{"type":"inlineCode","value":"inMemoryWorkflowExecutionStore"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates an in-memory "},{"type":"inlineCode","value":"WorkflowExecutionStore"},{"type":"text","value":" for tests and local demos."}]},{"type":"code","value":"import { inMemoryWorkflowExecutionStore } from '@tanstack/workflow-runtime'\n\nconst store = inMemoryWorkflowExecutionStore()","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Do not use this as production persistence. Memory disappears when the process\nexits."}]},{"type":"heading","depth":2,"id":"createrunstoreadapter","children":[{"type":"inlineCode","value":"createRunStoreAdapter"}]},{"type":"paragraph","children":[{"type":"text","value":"Adapts a "},{"type":"inlineCode","value":"WorkflowExecutionStore"},{"type":"text","value":" to the core engine's "},{"type":"inlineCode","value":"RunStore"},{"type":"text","value":" interface."}]},{"type":"paragraph","children":[{"type":"text","value":"Most users will not call this directly. The runtime driver uses it internally."}]},{"type":"heading","depth":2,"id":"createruntimedriver","children":[{"type":"inlineCode","value":"createRuntimeDriver"}]},{"type":"paragraph","children":[{"type":"text","value":"Lower-level helper used by "},{"type":"inlineCode","value":"defineWorkflowRuntime"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Most users should call "},{"type":"inlineCode","value":"defineWorkflowRuntime"},{"type":"text","value":"."}]}],"headings":[{"id":"runtime-api","text":"Runtime API","level":1},{"id":"defineworkflowruntime","text":"defineWorkflowRuntime","level":2},{"id":"telemetry","text":"Telemetry","level":3},{"id":"workflow-registration","text":"Workflow registration","level":3},{"id":"runtime-deadlines","text":"Runtime deadlines","level":2},{"id":"leases-and-recovery","text":"Leases and recovery","level":2},{"id":"live-events","text":"Live events","level":2},{"id":"runtime-startrun","text":"runtime.startRun","level":2},{"id":"runtime-deliversignal","text":"runtime.deliverSignal","level":2},{"id":"runtime-deliverapproval","text":"runtime.deliverApproval","level":2},{"id":"runtime-sweep","text":"runtime.sweep","level":2},{"id":"cron","text":"cron","level":2},{"id":"every","text":"every","level":2},{"id":"materializeworkflowschedules","text":"materializeWorkflowSchedules","level":2},{"id":"inmemoryworkflowexecutionstore","text":"inMemoryWorkflowExecutionStore","level":2},{"id":"createrunstoreadapter","text":"createRunStoreAdapter","level":2},{"id":"createruntimedriver","text":"createRuntimeDriver","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Runtime API\n\n`@tanstack/workflow-runtime` provides the deployment-independent execution\nruntime.\n\n## `defineWorkflowRuntime`\n\nRegisters workflows and returns runtime methods.\n\n```ts\nimport { defineWorkflowRuntime } from '@tanstack/workflow-runtime'\n\nconst runtime = defineWorkflowRuntime({\n  store,\n  defaultLeaseMs: 30_000,\n  publish: async (runId, event) => {\n    await eventBus.publish(runId, event)\n  },\n  telemetry: {\n    spanNamePrefix: 'tanstack.workflow',\n  },\n  workflows: {\n    checkout: {\n      load: async () => checkoutWorkflow,\n      version: 'v2',\n      previousVersions: {\n        v1: async () => checkoutWorkflowV1,\n      },\n      schedules: [],\n    },\n  },\n})\n```\n\n### Telemetry\n\nWorkflow emits OpenTelemetry traces through `@opentelemetry/api`. Applications\nown SDK/exporter setup. If no SDK is configured, spans are no-ops.\n\n```ts\nconst runtime = defineWorkflowRuntime({\n  store,\n  workflows,\n  telemetry: {\n    attributes: ({ workflowId, runId }) => ({\n      'app.workflow': workflowId ?? 'unknown',\n      'app.run': runId ?? 'unknown',\n    }),\n    mapStepMeta: (meta) => ({\n      'app.step_name': String(meta.name),\n    }),\n  },\n})\n```\n\nSet `telemetry: false` or `telemetry: { enabled: false }` to disable tracing.\n\n`WorkflowTelemetryOptions`:\n\n| Option | Purpose |\n| --- | --- |\n| `enabled` | Set false to disable tracing. |\n| `tracer` | Custom OpenTelemetry `Tracer`. Defaults to the global tracer provider. |\n| `spanNamePrefix` | Prefix for Workflow span names. Defaults to `tanstack.workflow`. |\n| `attributes` | Safe shared attributes or a function that returns them per span. |\n| `recordExceptions` | Whether to call `span.recordException`. Defaults to true. |\n| `mapStepMeta` | Optional mapper for safe `ctx.step(..., { meta })` attributes. |\n\nWorkflow never records workflow input, output, signal payloads, step results, or\nraw step metadata as attributes by default.\n\n### Workflow registration\n\n| Field | Purpose |\n| --- | --- |\n| `load` | Async workflow loader. Can return a workflow, `{ default }`, or `{ workflow }`. |\n| `version` | Current workflow version for new runs. |\n| `previousVersions` | Loaders for old versions that still have paused runs. |\n| `schedules` | Registered recurring schedules for this workflow. |\n\n## Runtime deadlines\n\nEvery runtime method that can drive workflow code accepts the same budget\noptions:\n\n| Option | Purpose |\n| --- | --- |\n| `deadline` | Absolute wall-clock deadline in UTC milliseconds. |\n| `maxDurationMs` | Maximum wall-clock duration for this runtime call. |\n| `minYieldRemainingMs` | Budget reserved before fresh durable work. Defaults to 1000ms. |\n\nWhen both deadline forms are present, the earlier deadline wins. The runtime\nchecks the budget before fresh `step`, `now`, and `uuid` work. A low budget\npauses the run on a durable timer, releases its lease, and lets a later sweep\nresume it. Existing `sleep`, `waitForEvent`, and `approve` calls already pause.\n\nStep timeouts remain per-attempt limits and do not use the runtime deadline.\n\n## Leases and recovery\n\nThe runtime renews an owned run lease every third of `leaseMs` while workflow\ncode is running. It stops renewal before releasing the lease on completion,\npause, yield, or error. `leaseMs` must be a positive finite number.\n\n`runtime.sweep()` also claims expired running executions and replays them from\ntheir durable checkpoints. Completed steps are not executed again. Fresh steps\nremain at-least-once operations, so external side effects still need\nidempotency keys.\n\n## Live events\n\nSet `publish` on the runtime or an individual runtime call to receive events as\nthey are emitted. When both are present, both publishers run. Fan-out is\nbest-effort: publisher failures do not change durable execution.\n\n`publish` is independent of `includeEvents`. A host can stream live events while\nsetting `includeEvents: false` to avoid retaining them in the final result.\n\n## `runtime.startRun`\n\nStarts or attaches to a run ID through the runtime store.\n\n```ts\nconst result = await runtime.startRun({\n  workflowId: 'checkout',\n  runId: 'checkout:order-1',\n  input: { orderId: 'order-1' },\n  leaseOwner: 'api:checkout',\n  leaseMs: 30_000,\n  includeEvents: false,\n})\n```\n\nOptions:\n\n| Option | Purpose |\n| --- | --- |\n| `workflowId` | Registered workflow key. |\n| `runId` | Stable run identifier. |\n| `input` | Workflow input for new runs. |\n| `now` | Override current time for tests or host events. |\n| `deadline` | Absolute wall-clock deadline in UTC milliseconds. |\n| `maxDurationMs` | Maximum wall-clock duration for this call. |\n| `minYieldRemainingMs` | Budget reserved before fresh durable work. |\n| `leaseOwner` | Worker identity used while executing. |\n| `leaseMs` | Lease duration. |\n| `threadId` | Optional core engine thread ID. |\n| `includeEvents` | Whether to retain emitted events in the result. Defaults to true. |\n| `maxEvents` | Maximum retained events when `includeEvents` is true. |\n| `publish` | Best-effort live event publisher for this drive. |\n\n## `runtime.deliverSignal`\n\nDelivers an external signal and resumes the run.\n\n```ts\nawait runtime.deliverSignal({\n  runId: 'checkout:order-1',\n  signalId: 'stripe:evt_123',\n  name: 'payment-received',\n  payload: { paymentId: 'pi_123' },\n})\n```\n\nUse stable `signalId` values so webhook retries are idempotent.\n\n## `runtime.deliverApproval`\n\nDelivers an approval decision and resumes the run.\n\n```ts\nawait runtime.deliverApproval({\n  runId,\n  approval: {\n    approvalId,\n    approved: true,\n    feedback: 'Approved',\n  },\n})\n```\n\n## `runtime.sweep`\n\nRecovers stale running executions, then claims due schedules and timers and\ndrives them to completion or the next pause.\n\n```ts\nconst result = await runtime.sweep({\n  now: Date.now(),\n  maxRecoveredRuns: 25,\n  maxScheduledRuns: 25,\n  maxTimers: 25,\n  maxDurationMs: 55_000,\n  leaseOwner: 'cron:sweep',\n  leaseMs: 30_000,\n  includeEvents: false,\n})\n```\n\nOptions:\n\n| Option | Purpose |\n| --- | --- |\n| `now` | Current timestamp used for due checks. |\n| `limit` | Backward-compatible shared limit for recoveries, schedules, and timers. |\n| `maxRecoveredRuns` | Maximum expired running executions to recover. |\n| `maxScheduledRuns` | Maximum due schedule buckets to start. |\n| `maxTimers` | Maximum due timers to resume. |\n| `deadline` | Absolute wall-clock deadline in UTC milliseconds. |\n| `maxDurationMs` | Wall-clock budget for this sweep. |\n| `minYieldRemainingMs` | Stops claims and fresh durable work inside this margin. |\n| `leaseOwner` | Worker identity for claimed work. |\n| `leaseMs` | Lease duration. |\n| `includeEvents` | Whether to retain emitted events. Sweeps usually set false. |\n| `maxEvents` | Maximum retained events per run result. |\n| `publish` | Best-effort live event publisher for every driven run. |\n\nResult:\n\n```ts\ninterface WorkflowRuntimeSweepResult {\n  recovered: ReadonlyArray<WorkflowRuntimeRunResult>\n  scheduled: ReadonlyArray<WorkflowRuntimeRunResult>\n  timers: ReadonlyArray<WorkflowRuntimeRunResult>\n  summary: WorkflowRuntimeSweepSummary\n  deadlineReached: boolean\n  remainingMayExist: boolean\n}\n```\n\n`remainingMayExist` means the sweep stopped at a count or time budget, so more\ndue work may be available.\n\n## `cron`\n\nCreates a cron schedule spec.\n\n```ts\nimport { cron } from '@tanstack/workflow-runtime'\n\ncron('0 9 * * 1', { timezone: 'UTC' })\n```\n\nCurrent materialization supports numeric five-field UTC cron schedules.\n\n## `every`\n\nCreates interval schedule specs.\n\n```ts\nimport { every } from '@tanstack/workflow-runtime'\n\nevery.seconds(30)\nevery.minutes(15)\nevery.hours(1)\n```\n\n## `materializeWorkflowSchedules`\n\nComputes due schedule buckets from registered workflow schedules.\n\n```ts\nimport { materializeWorkflowSchedules } from '@tanstack/workflow-runtime'\n\nconst materialized = await materializeWorkflowSchedules(runtime, {\n  now: Date.now(),\n  cronLookbackMs: 24 * 60 * 60 * 1000,\n})\n```\n\nHost adapters call this for you before sweeping.\n\n## `inMemoryWorkflowExecutionStore`\n\nCreates an in-memory `WorkflowExecutionStore` for tests and local demos.\n\n```ts\nimport { inMemoryWorkflowExecutionStore } from '@tanstack/workflow-runtime'\n\nconst store = inMemoryWorkflowExecutionStore()\n```\n\nDo not use this as production persistence. Memory disappears when the process\nexits.\n\n## `createRunStoreAdapter`\n\nAdapts a `WorkflowExecutionStore` to the core engine's `RunStore` interface.\n\nMost users will not call this directly. The runtime driver uses it internally.\n\n## `createRuntimeDriver`\n\nLower-level helper used by `defineWorkflowRuntime`.\n\nMost users should call `defineWorkflowRuntime`.\n","originalRawMarkdown":"---\nid: runtime-api\ntitle: Runtime API\n---\n\n# Runtime API\n\n`@tanstack/workflow-runtime` provides the deployment-independent execution\nruntime.\n\n## `defineWorkflowRuntime`\n\nRegisters workflows and returns runtime methods.\n\n```ts\nimport { defineWorkflowRuntime } from '@tanstack/workflow-runtime'\n\nconst runtime = defineWorkflowRuntime({\n  store,\n  defaultLeaseMs: 30_000,\n  publish: async (runId, event) => {\n    await eventBus.publish(runId, event)\n  },\n  telemetry: {\n    spanNamePrefix: 'tanstack.workflow',\n  },\n  workflows: {\n    checkout: {\n      load: async () => checkoutWorkflow,\n      version: 'v2',\n      previousVersions: {\n        v1: async () => checkoutWorkflowV1,\n      },\n      schedules: [],\n    },\n  },\n})\n```\n\n### Telemetry\n\nWorkflow emits OpenTelemetry traces through `@opentelemetry/api`. Applications\nown SDK/exporter setup. If no SDK is configured, spans are no-ops.\n\n```ts\nconst runtime = defineWorkflowRuntime({\n  store,\n  workflows,\n  telemetry: {\n    attributes: ({ workflowId, runId }) => ({\n      'app.workflow': workflowId ?? 'unknown',\n      'app.run': runId ?? 'unknown',\n    }),\n    mapStepMeta: (meta) => ({\n      'app.step_name': String(meta.name),\n    }),\n  },\n})\n```\n\nSet `telemetry: false` or `telemetry: { enabled: false }` to disable tracing.\n\n`WorkflowTelemetryOptions`:\n\n| Option | Purpose |\n| --- | --- |\n| `enabled` | Set false to disable tracing. |\n| `tracer` | Custom OpenTelemetry `Tracer`. Defaults to the global tracer provider. |\n| `spanNamePrefix` | Prefix for Workflow span names. Defaults to `tanstack.workflow`. |\n| `attributes` | Safe shared attributes or a function that returns them per span. |\n| `recordExceptions` | Whether to call `span.recordException`. Defaults to true. |\n| `mapStepMeta` | Optional mapper for safe `ctx.step(..., { meta })` attributes. |\n\nWorkflow never records workflow input, output, signal payloads, step results, or\nraw step metadata as attributes by default.\n\n### Workflow registration\n\n| Field | Purpose |\n| --- | --- |\n| `load` | Async workflow loader. Can return a workflow, `{ default }`, or `{ workflow }`. |\n| `version` | Current workflow version for new runs. |\n| `previousVersions` | Loaders for old versions that still have paused runs. |\n| `schedules` | Registered recurring schedules for this workflow. |\n\n## Runtime deadlines\n\nEvery runtime method that can drive workflow code accepts the same budget\noptions:\n\n| Option | Purpose |\n| --- | --- |\n| `deadline` | Absolute wall-clock deadline in UTC milliseconds. |\n| `maxDurationMs` | Maximum wall-clock duration for this runtime call. |\n| `minYieldRemainingMs` | Budget reserved before fresh durable work. Defaults to 1000ms. |\n\nWhen both deadline forms are present, the earlier deadline wins. The runtime\nchecks the budget before fresh `step`, `now`, and `uuid` work. A low budget\npauses the run on a durable timer, releases its lease, and lets a later sweep\nresume it. Existing `sleep`, `waitForEvent`, and `approve` calls already pause.\n\nStep timeouts remain per-attempt limits and do not use the runtime deadline.\n\n## Leases and recovery\n\nThe runtime renews an owned run lease every third of `leaseMs` while workflow\ncode is running. It stops renewal before releasing the lease on completion,\npause, yield, or error. `leaseMs` must be a positive finite number.\n\n`runtime.sweep()` also claims expired running executions and replays them from\ntheir durable checkpoints. Completed steps are not executed again. Fresh steps\nremain at-least-once operations, so external side effects still need\nidempotency keys.\n\n## Live events\n\nSet `publish` on the runtime or an individual runtime call to receive events as\nthey are emitted. When both are present, both publishers run. Fan-out is\nbest-effort: publisher failures do not change durable execution.\n\n`publish` is independent of `includeEvents`. A host can stream live events while\nsetting `includeEvents: false` to avoid retaining them in the final result.\n\n## `runtime.startRun`\n\nStarts or attaches to a run ID through the runtime store.\n\n```ts\nconst result = await runtime.startRun({\n  workflowId: 'checkout',\n  runId: 'checkout:order-1',\n  input: { orderId: 'order-1' },\n  leaseOwner: 'api:checkout',\n  leaseMs: 30_000,\n  includeEvents: false,\n})\n```\n\nOptions:\n\n| Option | Purpose |\n| --- | --- |\n| `workflowId` | Registered workflow key. |\n| `runId` | Stable run identifier. |\n| `input` | Workflow input for new runs. |\n| `now` | Override current time for tests or host events. |\n| `deadline` | Absolute wall-clock deadline in UTC milliseconds. |\n| `maxDurationMs` | Maximum wall-clock duration for this call. |\n| `minYieldRemainingMs` | Budget reserved before fresh durable work. |\n| `leaseOwner` | Worker identity used while executing. |\n| `leaseMs` | Lease duration. |\n| `threadId` | Optional core engine thread ID. |\n| `includeEvents` | Whether to retain emitted events in the result. Defaults to true. |\n| `maxEvents` | Maximum retained events when `includeEvents` is true. |\n| `publish` | Best-effort live event publisher for this drive. |\n\n## `runtime.deliverSignal`\n\nDelivers an external signal and resumes the run.\n\n```ts\nawait runtime.deliverSignal({\n  runId: 'checkout:order-1',\n  signalId: 'stripe:evt_123',\n  name: 'payment-received',\n  payload: { paymentId: 'pi_123' },\n})\n```\n\nUse stable `signalId` values so webhook retries are idempotent.\n\n## `runtime.deliverApproval`\n\nDelivers an approval decision and resumes the run.\n\n```ts\nawait runtime.deliverApproval({\n  runId,\n  approval: {\n    approvalId,\n    approved: true,\n    feedback: 'Approved',\n  },\n})\n```\n\n## `runtime.sweep`\n\nRecovers stale running executions, then claims due schedules and timers and\ndrives them to completion or the next pause.\n\n```ts\nconst result = await runtime.sweep({\n  now: Date.now(),\n  maxRecoveredRuns: 25,\n  maxScheduledRuns: 25,\n  maxTimers: 25,\n  maxDurationMs: 55_000,\n  leaseOwner: 'cron:sweep',\n  leaseMs: 30_000,\n  includeEvents: false,\n})\n```\n\nOptions:\n\n| Option | Purpose |\n| --- | --- |\n| `now` | Current timestamp used for due checks. |\n| `limit` | Backward-compatible shared limit for recoveries, schedules, and timers. |\n| `maxRecoveredRuns` | Maximum expired running executions to recover. |\n| `maxScheduledRuns` | Maximum due schedule buckets to start. |\n| `maxTimers` | Maximum due timers to resume. |\n| `deadline` | Absolute wall-clock deadline in UTC milliseconds. |\n| `maxDurationMs` | Wall-clock budget for this sweep. |\n| `minYieldRemainingMs` | Stops claims and fresh durable work inside this margin. |\n| `leaseOwner` | Worker identity for claimed work. |\n| `leaseMs` | Lease duration. |\n| `includeEvents` | Whether to retain emitted events. Sweeps usually set false. |\n| `maxEvents` | Maximum retained events per run result. |\n| `publish` | Best-effort live event publisher for every driven run. |\n\nResult:\n\n```ts\ninterface WorkflowRuntimeSweepResult {\n  recovered: ReadonlyArray<WorkflowRuntimeRunResult>\n  scheduled: ReadonlyArray<WorkflowRuntimeRunResult>\n  timers: ReadonlyArray<WorkflowRuntimeRunResult>\n  summary: WorkflowRuntimeSweepSummary\n  deadlineReached: boolean\n  remainingMayExist: boolean\n}\n```\n\n`remainingMayExist` means the sweep stopped at a count or time budget, so more\ndue work may be available.\n\n## `cron`\n\nCreates a cron schedule spec.\n\n```ts\nimport { cron } from '@tanstack/workflow-runtime'\n\ncron('0 9 * * 1', { timezone: 'UTC' })\n```\n\nCurrent materialization supports numeric five-field UTC cron schedules.\n\n## `every`\n\nCreates interval schedule specs.\n\n```ts\nimport { every } from '@tanstack/workflow-runtime'\n\nevery.seconds(30)\nevery.minutes(15)\nevery.hours(1)\n```\n\n## `materializeWorkflowSchedules`\n\nComputes due schedule buckets from registered workflow schedules.\n\n```ts\nimport { materializeWorkflowSchedules } from '@tanstack/workflow-runtime'\n\nconst materialized = await materializeWorkflowSchedules(runtime, {\n  now: Date.now(),\n  cronLookbackMs: 24 * 60 * 60 * 1000,\n})\n```\n\nHost adapters call this for you before sweeping.\n\n## `inMemoryWorkflowExecutionStore`\n\nCreates an in-memory `WorkflowExecutionStore` for tests and local demos.\n\n```ts\nimport { inMemoryWorkflowExecutionStore } from '@tanstack/workflow-runtime'\n\nconst store = inMemoryWorkflowExecutionStore()\n```\n\nDo not use this as production persistence. Memory disappears when the process\nexits.\n\n## `createRunStoreAdapter`\n\nAdapts a `WorkflowExecutionStore` to the core engine's `RunStore` interface.\n\nMost users will not call this directly. The runtime driver uses it internally.\n\n## `createRuntimeDriver`\n\nLower-level helper used by `defineWorkflowRuntime`.\n\nMost users should call `defineWorkflowRuntime`.\n"}
