Store({ db })","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Apply the package-owned migration during setup/deploy:"}]},{"type":"code","value":"psql \"$DATABASE_URL\" -f node_modules/@tanstack/workflow-store-drizzle-postgres/migrations/0000_workflow_store.sql","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"Use it in the runtime:"}]},{"type":"code","value":"const runtime = defineWorkflowRuntime({\n  store,\n  workflows,\n})","lang":"ts"},{"type":"heading","depth":2,"id":"createdrizzlepostgresworkflowstore","children":[{"type":"inlineCode","value":"createDrizzlePostgresWorkflowStore"}]},{"type":"code","value":"const store = createDrizzlePostgresWorkflowStore({\n  db,\n  schema: 'public',\n  tables: {\n    runs: 'workflow_runs',\n  },\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Options:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Option"}]},{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"db"}]},{"type":"tableCell","children":[{"type":"text","value":"Drizzle-compatible database object with "},{"type":"inlineCode","value":"execute"},{"type":"text","value":" and optional "},{"type":"inlineCode","value":"transaction"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"schema"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional Postgres schema name."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"tables"}]},{"type":"tableCell","children":[{"type":"text","value":"Optional table name overrides."}]}]]},{"type":"heading","depth":2,"id":"package-owned-migrations","children":[{"type":"text","value":"Package-owned migrations"}]},{"type":"paragraph","children":[{"type":"text","value":"The Drizzle/Postgres package owns the durable Workflow schema. Apps should apply\nthe SQL artifact from the installed package instead of mirroring "},{"type":"inlineCode","value":"workflow_*"},{"type":"text","value":"\ntables in application Drizzle schema files."}]},{"type":"code","value":"psql \"$DATABASE_URL\" -f node_modules/@tanstack/workflow-store-drizzle-postgres/migrations/0000_workflow_store.sql","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"Programmatic setup can use the exported migration helpers:"}]},{"type":"code","value":"import {\n  getDrizzlePostgresWorkflowStoreMigrationSql,\n  getDrizzlePostgresWorkflowStoreMigrations,\n} from '@tanstack/workflow-store-drizzle-postgres'","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Schema changes are versioned with "},{"type":"inlineCode","value":"@tanstack/workflow-store-drizzle-postgres"},{"type":"text","value":".\nApply new package migrations when upgrading the adapter. Runtime code assumes the\ndatabase schema is compatible with the installed store adapter version."}]},{"type":"paragraph","children":[{"type":"text","value":"The initial migration creates "},{"type":"inlineCode","value":"workflow_schema_migrations"},{"type":"text","value":" and records applied\nWorkflow store migrations. Future migrations will be appended as new numbered SQL\nfiles in the package. Apply them in order during deploy/setup before running the\nnew adapter version."}]},{"type":"paragraph","children":[{"type":"text","value":"Maintainers changing the Drizzle/Postgres store schema should follow the\npackage-local "},{"type":"inlineCode","value":"SCHEMA_MIGRATIONS.md"},{"type":"text","value":" checklist."}]},{"type":"heading","depth":2,"id":"cloudflare-d1","children":[{"type":"text","value":"Cloudflare D1"}]},{"type":"paragraph","children":[{"type":"text","value":"Install:"}]},{"type":"code","value":"pnpm add @tanstack/workflow-store-cloudflare-d1","lang":"bash"},{"type":"paragraph","children":[{"type":"text","value":"Create the store from a D1 binding:"}]},{"type":"code","value":"import { createCloudflareD1WorkflowStore } from '@tanstack/workflow-store-cloudflare-d1'\n\nconst store = createCloudflareD1WorkflowStore({\n  db: env.WORKFLOW_DB,\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Apply the package-owned D1 migration during setup/deploy:"}]},{"type":"code","value":"node_modules/@tanstack/workflow-store-cloudflare-d1/migrations/0000_workflow_store.sql","lang":"txt"},{"type":"paragraph","children":[{"type":"text","value":"Programmatic setup can use the exported migration helpers:"}]},{"type":"code","value":"import {\n  getCloudflareD1WorkflowStoreMigrationSql,\n  getCloudflareD1WorkflowStoreMigrations,\n} from '@tanstack/workflow-store-cloudflare-d1'","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"D1 stores JSON payloads as text and uses SQLite integer timestamps. Its claim\noperations use atomic conditional updates and leases rather than Postgres\n"},{"type":"inlineCode","value":"FOR UPDATE SKIP LOCKED"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"store-ensureschema","children":[{"type":"inlineCode","value":"store.ensureSchema"}]},{"type":"paragraph","children":[{"type":"text","value":"Creates the required tables and indexes if they do not exist."}]},{"type":"code","value":"await store.ensureSchema()","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Use this from tests, local demos, or an explicit admin bootstrap script, not\nfrom every request or sweep. Runtime and host adapters assume the schema exists.\nProduction deploys should prefer the package-owned SQL migration artifact."}]},{"type":"heading","depth":2,"id":"default-tables","children":[{"type":"text","value":"Default tables"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"defaultDrizzlePostgresWorkflowStoreTables"},{"type":"text","value":" contains:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Table key"}]},{"type":"tableCell","children":[{"type":"text","value":"Default table"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"schemaMigrations"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"workflow_schema_migrations"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"runs"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"workflow_runs"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"runStates"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"workflow_run_states"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"eventLocks"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"workflow_event_locks"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"events"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"workflow_events"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"timers"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"workflow_timers"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"signalDeliveries"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"workflow_signal_deliveries"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"schedules"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"workflow_schedules"}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"scheduleBuckets"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"workflow_schedule_buckets"}]}]]},{"type":"heading","depth":2,"id":"optional-drizzle-table-definitions","children":[{"type":"text","value":"Optional Drizzle table definitions"}]},{"type":"paragraph","children":[{"type":"text","value":"The package exports Drizzle table definitions for apps that explicitly want\ntyped read access for dashboards, diagnostics, or admin tooling:"}]},{"type":"code","value":"import {\n  workflowEvents,\n  workflowRuns,\n  workflowSchedules,\n  workflowSchemaMigrations,\n} from '@tanstack/workflow-store-drizzle-postgres'","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"These exports are optional. Normal runtime use does not require adding Workflow\ntables to your app schema."}]},{"type":"heading","depth":2,"id":"in-memory-store","children":[{"type":"text","value":"In-memory store"}]},{"type":"paragraph","children":[{"type":"text","value":"For tests and demos:"}]},{"type":"code","value":"import { inMemoryWorkflowExecutionStore } from '@tanstack/workflow-runtime'\n\nconst store = inMemoryWorkflowExecutionStore()","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The in-memory store implements the same runtime contract, but it is not durable."}]},{"type":"heading","depth":2,"id":"adapter-implementation-checklist","children":[{"type":"text","value":"Adapter implementation checklist"}]},{"type":"paragraph","children":[{"type":"text","value":"A production store adapter should satisfy:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"compare-and-swap append semantics for events"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"idempotent run creation"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"idempotent signal and approval delivery"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"atomic claim and lease semantics"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"due timer and due schedule indexes"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"stale lease recovery"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"timeline and list APIs"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"migration strategy"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"tests against the shared contract suite"}]}]}]}],"headings":[{"id":"store-adapters","text":"Store adapters","level":1},{"id":"workflowexecutionstore","text":"WorkflowExecutionStore","level":2},{"id":"drizzle-postgres","text":"Drizzle/Postgres","level":2},{"id":"createdrizzlepostgresworkflowstore","text":"createDrizzlePostgresWorkflowStore","level":2},{"id":"package-owned-migrations","text":"Package-owned migrations","level":2},{"id":"cloudflare-d1","text":"Cloudflare D1","level":2},{"id":"store-ensureschema","text":"store.ensureSchema","level":2},{"id":"default-tables","text":"Default tables","level":2},{"id":"optional-drizzle-table-definitions","text":"Optional Drizzle table definitions","level":2},{"id":"in-memory-store","text":"In-memory store","level":2},{"id":"adapter-implementation-checklist","text":"Adapter implementation checklist","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Store adapters\n\nStore adapters implement `WorkflowExecutionStore` from\n`@tanstack/workflow-runtime`.\n\n## `WorkflowExecutionStore`\n\nThe runtime store contract includes:\n\n| Capability | Methods |\n| --- | --- |\n| Run lifecycle | `createRun`, `loadRun`, `loadExecution`, `markRunPaused`, `markRunFinished`, `markRunErrored` |\n| Event log | `appendEvents`, `readEvents`, optional `subscribeEvents` |\n| Leases | `claimRun`, `heartbeatRunLease`, `releaseRunLease`, `claimStaleRuns` |\n| Timers | `scheduleTimer`, `claimDueTimers` |\n| Signals | `deliverSignal` |\n| Approvals | `deliverApproval` |\n| Schedules | `upsertSchedule`, `claimDueScheduleBuckets`, `markScheduleBucketStarted` |\n| Query | `listRuns`, `getRunTimeline` |\n\nAdapter authors should run the shared contract tests from\n`@tanstack/workflow-runtime`.\n\n## Drizzle/Postgres\n\nInstall:\n\n```bash\npnpm add @tanstack/workflow-store-drizzle-postgres drizzle-orm pg\n```\n\nCreate the store:\n\n```ts\nimport { drizzle } from 'drizzle-orm/node-postgres'\nimport { Pool } from 'pg'\nimport { createDrizzlePostgresWorkflowStore } from '@tanstack/workflow-store-drizzle-postgres'\n\nconst db = drizzle(new Pool({ connectionString: process.env.DATABASE_URL }))\nconst store = createDrizzlePostgresWorkflowStore({ db })\n```\n\nApply the package-owned migration during setup/deploy:\n\n```bash\npsql \"$DATABASE_URL\" -f node_modules/@tanstack/workflow-store-drizzle-postgres/migrations/0000_workflow_store.sql\n```\n\nUse it in the runtime:\n\n```ts\nconst runtime = defineWorkflowRuntime({\n  store,\n  workflows,\n})\n```\n\n## `createDrizzlePostgresWorkflowStore`\n\n```ts\nconst store = createDrizzlePostgresWorkflowStore({\n  db,\n  schema: 'public',\n  tables: {\n    runs: 'workflow_runs',\n  },\n})\n```\n\nOptions:\n\n| Option | Purpose |\n| --- | --- |\n| `db` | Drizzle-compatible database object with `execute` and optional `transaction`. |\n| `schema` | Optional Postgres schema name. |\n| `tables` | Optional table name overrides. |\n\n## Package-owned migrations\n\nThe Drizzle/Postgres package owns the durable Workflow schema. Apps should apply\nthe SQL artifact from the installed package instead of mirroring `workflow_*`\ntables in application Drizzle schema files.\n\n```bash\npsql \"$DATABASE_URL\" -f node_modules/@tanstack/workflow-store-drizzle-postgres/migrations/0000_workflow_store.sql\n```\n\nProgrammatic setup can use the exported migration helpers:\n\n```ts\nimport {\n  getDrizzlePostgresWorkflowStoreMigrationSql,\n  getDrizzlePostgresWorkflowStoreMigrations,\n} from '@tanstack/workflow-store-drizzle-postgres'\n```\n\nSchema changes are versioned with `@tanstack/workflow-store-drizzle-postgres`.\nApply new package migrations when upgrading the adapter. Runtime code assumes the\ndatabase schema is compatible with the installed store adapter version.\n\nThe initial migration creates `workflow_schema_migrations` and records applied\nWorkflow store migrations. Future migrations will be appended as new numbered SQL\nfiles in the package. Apply them in order during deploy/setup before running the\nnew adapter version.\n\nMaintainers changing the Drizzle/Postgres store schema should follow the\npackage-local `SCHEMA_MIGRATIONS.md` checklist.\n\n## Cloudflare D1\n\nInstall:\n\n```bash\npnpm add @tanstack/workflow-store-cloudflare-d1\n```\n\nCreate the store from a D1 binding:\n\n```ts\nimport { createCloudflareD1WorkflowStore } from '@tanstack/workflow-store-cloudflare-d1'\n\nconst store = createCloudflareD1WorkflowStore({\n  db: env.WORKFLOW_DB,\n})\n```\n\nApply the package-owned D1 migration during setup/deploy:\n\n```txt\nnode_modules/@tanstack/workflow-store-cloudflare-d1/migrations/0000_workflow_store.sql\n```\n\nProgrammatic setup can use the exported migration helpers:\n\n```ts\nimport {\n  getCloudflareD1WorkflowStoreMigrationSql,\n  getCloudflareD1WorkflowStoreMigrations,\n} from '@tanstack/workflow-store-cloudflare-d1'\n```\n\nD1 stores JSON payloads as text and uses SQLite integer timestamps. Its claim\noperations use atomic conditional updates and leases rather than Postgres\n`FOR UPDATE SKIP LOCKED`.\n\n## `store.ensureSchema`\n\nCreates the required tables and indexes if they do not exist.\n\n```ts\nawait store.ensureSchema()\n```\n\nUse this from tests, local demos, or an explicit admin bootstrap script, not\nfrom every request or sweep. Runtime and host adapters assume the schema exists.\nProduction deploys should prefer the package-owned SQL migration artifact.\n\n## Default tables\n\n`defaultDrizzlePostgresWorkflowStoreTables` contains:\n\n| Table key | Default table |\n| --- | --- |\n| `schemaMigrations` | `workflow_schema_migrations` |\n| `runs` | `workflow_runs` |\n| `runStates` | `workflow_run_states` |\n| `eventLocks` | `workflow_event_locks` |\n| `events` | `workflow_events` |\n| `timers` | `workflow_timers` |\n| `signalDeliveries` | `workflow_signal_deliveries` |\n| `schedules` | `workflow_schedules` |\n| `scheduleBuckets` | `workflow_schedule_buckets` |\n\n## Optional Drizzle table definitions\n\nThe package exports Drizzle table definitions for apps that explicitly want\ntyped read access for dashboards, diagnostics, or admin tooling:\n\n```ts\nimport {\n  workflowEvents,\n  workflowRuns,\n  workflowSchedules,\n  workflowSchemaMigrations,\n} from '@tanstack/workflow-store-drizzle-postgres'\n```\n\nThese exports are optional. Normal runtime use does not require adding Workflow\ntables to your app schema.\n\n## In-memory store\n\nFor tests and demos:\n\n```ts\nimport { inMemoryWorkflowExecutionStore } from '@tanstack/workflow-runtime'\n\nconst store = inMemoryWorkflowExecutionStore()\n```\n\nThe in-memory store implements the same runtime contract, but it is not durable.\n\n## Adapter implementation checklist\n\nA production store adapter should satisfy:\n\n- compare-and-swap append semantics for events\n- idempotent run creation\n- idempotent signal and approval delivery\n- atomic claim and lease semantics\n- due timer and due schedule indexes\n- stale lease recovery\n- timeline and list APIs\n- migration strategy\n- tests against the shared contract suite\n","originalRawMarkdown":"---\nid: store-adapters\ntitle: Store Adapters\n---\n\n# Store adapters\n\nStore adapters implement `WorkflowExecutionStore` from\n`@tanstack/workflow-runtime`.\n\n## `WorkflowExecutionStore`\n\nThe runtime store contract includes:\n\n| Capability | Methods |\n| --- | --- |\n| Run lifecycle | `createRun`, `loadRun`, `loadExecution`, `markRunPaused`, `markRunFinished`, `markRunErrored` |\n| Event log | `appendEvents`, `readEvents`, optional `subscribeEvents` |\n| Leases | `claimRun`, `heartbeatRunLease`, `releaseRunLease`, `claimStaleRuns` |\n| Timers | `scheduleTimer`, `claimDueTimers` |\n| Signals | `deliverSignal` |\n| Approvals | `deliverApproval` |\n| Schedules | `upsertSchedule`, `claimDueScheduleBuckets`, `markScheduleBucketStarted` |\n| Query | `listRuns`, `getRunTimeline` |\n\nAdapter authors should run the shared contract tests from\n`@tanstack/workflow-runtime`.\n\n## Drizzle/Postgres\n\nInstall:\n\n```bash\npnpm add @tanstack/workflow-store-drizzle-postgres drizzle-orm pg\n```\n\nCreate the store:\n\n```ts\nimport { drizzle } from 'drizzle-orm/node-postgres'\nimport { Pool } from 'pg'\nimport { createDrizzlePostgresWorkflowStore } from '@tanstack/workflow-store-drizzle-postgres'\n\nconst db = drizzle(new Pool({ connectionString: process.env.DATABASE_URL }))\nconst store = createDrizzlePostgresWorkflowStore({ db })\n```\n\nApply the package-owned migration during setup/deploy:\n\n```bash\npsql \"$DATABASE_URL\" -f node_modules/@tanstack/workflow-store-drizzle-postgres/migrations/0000_workflow_store.sql\n```\n\nUse it in the runtime:\n\n```ts\nconst runtime = defineWorkflowRuntime({\n  store,\n  workflows,\n})\n```\n\n## `createDrizzlePostgresWorkflowStore`\n\n```ts\nconst store = createDrizzlePostgresWorkflowStore({\n  db,\n  schema: 'public',\n  tables: {\n    runs: 'workflow_runs',\n  },\n})\n```\n\nOptions:\n\n| Option | Purpose |\n| --- | --- |\n| `db` | Drizzle-compatible database object with `execute` and optional `transaction`. |\n| `schema` | Optional Postgres schema name. |\n| `tables` | Optional table name overrides. |\n\n## Package-owned migrations\n\nThe Drizzle/Postgres package owns the durable Workflow schema. Apps should apply\nthe SQL artifact from the installed package instead of mirroring `workflow_*`\ntables in application Drizzle schema files.\n\n```bash\npsql \"$DATABASE_URL\" -f node_modules/@tanstack/workflow-store-drizzle-postgres/migrations/0000_workflow_store.sql\n```\n\nProgrammatic setup can use the exported migration helpers:\n\n```ts\nimport {\n  getDrizzlePostgresWorkflowStoreMigrationSql,\n  getDrizzlePostgresWorkflowStoreMigrations,\n} from '@tanstack/workflow-store-drizzle-postgres'\n```\n\nSchema changes are versioned with `@tanstack/workflow-store-drizzle-postgres`.\nApply new package migrations when upgrading the adapter. Runtime code assumes the\ndatabase schema is compatible with the installed store adapter version.\n\nThe initial migration creates `workflow_schema_migrations` and records applied\nWorkflow store migrations. Future migrations will be appended as new numbered SQL\nfiles in the package. Apply them in order during deploy/setup before running the\nnew adapter version.\n\nMaintainers changing the Drizzle/Postgres store schema should follow the\npackage-local `SCHEMA_MIGRATIONS.md` checklist.\n\n## Cloudflare D1\n\nInstall:\n\n```bash\npnpm add @tanstack/workflow-store-cloudflare-d1\n```\n\nCreate the store from a D1 binding:\n\n```ts\nimport { createCloudflareD1WorkflowStore } from '@tanstack/workflow-store-cloudflare-d1'\n\nconst store = createCloudflareD1WorkflowStore({\n  db: env.WORKFLOW_DB,\n})\n```\n\nApply the package-owned D1 migration during setup/deploy:\n\n```txt\nnode_modules/@tanstack/workflow-store-cloudflare-d1/migrations/0000_workflow_store.sql\n```\n\nProgrammatic setup can use the exported migration helpers:\n\n```ts\nimport {\n  getCloudflareD1WorkflowStoreMigrationSql,\n  getCloudflareD1WorkflowStoreMigrations,\n} from '@tanstack/workflow-store-cloudflare-d1'\n```\n\nD1 stores JSON payloads as text and uses SQLite integer timestamps. Its claim\noperations use atomic conditional updates and leases rather than Postgres\n`FOR UPDATE SKIP LOCKED`.\n\n## `store.ensureSchema`\n\nCreates the required tables and indexes if they do not exist.\n\n```ts\nawait store.ensureSchema()\n```\n\nUse this from tests, local demos, or an explicit admin bootstrap script, not\nfrom every request or sweep. Runtime and host adapters assume the schema exists.\nProduction deploys should prefer the package-owned SQL migration artifact.\n\n## Default tables\n\n`defaultDrizzlePostgresWorkflowStoreTables` contains:\n\n| Table key | Default table |\n| --- | --- |\n| `schemaMigrations` | `workflow_schema_migrations` |\n| `runs` | `workflow_runs` |\n| `runStates` | `workflow_run_states` |\n| `eventLocks` | `workflow_event_locks` |\n| `events` | `workflow_events` |\n| `timers` | `workflow_timers` |\n| `signalDeliveries` | `workflow_signal_deliveries` |\n| `schedules` | `workflow_schedules` |\n| `scheduleBuckets` | `workflow_schedule_buckets` |\n\n## Optional Drizzle table definitions\n\nThe package exports Drizzle table definitions for apps that explicitly want\ntyped read access for dashboards, diagnostics, or admin tooling:\n\n```ts\nimport {\n  workflowEvents,\n  workflowRuns,\n  workflowSchedules,\n  workflowSchemaMigrations,\n} from '@tanstack/workflow-store-drizzle-postgres'\n```\n\nThese exports are optional. Normal runtime use does not require adding Workflow\ntables to your app schema.\n\n## In-memory store\n\nFor tests and demos:\n\n```ts\nimport { inMemoryWorkflowExecutionStore } from '@tanstack/workflow-runtime'\n\nconst store = inMemoryWorkflowExecutionStore()\n```\n\nThe in-memory store implements the same runtime contract, but it is not durable.\n\n## Adapter implementation checklist\n\nA production store adapter should satisfy:\n\n- compare-and-swap append semantics for events\n- idempotent run creation\n- idempotent signal and approval delivery\n- atomic claim and lease semantics\n- due timer and due schedule indexes\n- stale lease recovery\n- timeline and list APIs\n- migration strategy\n- tests against the shared contract suite\n"}
