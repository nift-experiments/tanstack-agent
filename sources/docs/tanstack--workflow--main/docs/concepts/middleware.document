{"document":{"type":"root","children":[{"type":"paragraph","children":[{"type":"text","value":"Middleware extends "},{"type":"inlineCode","value":"ctx"},{"type":"text","value":" with typed fields. Workflows declare them as an array — extensions accumulate."}]},{"type":"heading","depth":2,"id":"recipe-extend-ctx","children":[{"type":"text","value":"Recipe: extend ctx"}]},{"type":"code","value":"import { createMiddleware } from '@tanstack/workflow-core'\n\nconst requireUser = createMiddleware().server<{\n  user: { id: string; email: string }\n}>(async ({ next }) => {\n  const user = await loadUser()\n  if (!user) throw new Error('unauthorized')\n  return next({ context: { user } })\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The generic on "},{"type":"inlineCode","value":".server<...>"},{"type":"text","value":" is the extension shape. TS uses it to add "},{"type":"inlineCode","value":"ctx.user"},{"type":"text","value":" everywhere the middleware is registered."}]},{"type":"heading","depth":2,"id":"recipe-register-on-a-workflow","children":[{"type":"text","value":"Recipe: register on a workflow"}]},{"type":"code","value":"const wf = createWorkflow({ id: 'wf' })\n  .middleware([requireUser])\n  .handler(async (ctx) => {\n    ctx.user.id   // typed\n  })","lang":"ts"},{"type":"heading","depth":2,"id":"recipe-middleware-that-wraps-the-handler","children":[{"type":"text","value":"Recipe: middleware that wraps the handler"}]},{"type":"code","value":"const traced = createMiddleware().server<{ trace: Trace }>(async ({ next }) => {\n  const trace = startTrace()\n  try {\n    return await next({ context: { trace } })\n  } finally {\n    trace.end()\n  }\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"next"},{"type":"text","value":" is called "},{"type":"strong","children":[{"type":"text","value":"once"}]},{"type":"text","value":". Code before runs pre-handler; code after runs post."}]},{"type":"heading","depth":2,"id":"recipe-middleware-that-depends-on-a-prior-middleware","children":[{"type":"text","value":"Recipe: middleware that depends on a prior middleware"}]},{"type":"code","value":"const requireUser = createMiddleware().server<{ user: User }>(\n  async ({ next }) => next({ context: { user: await loadUser() } }),\n)\n\n// Reaches ctx.user — type the inbound ctx with the generic on createMiddleware.\nconst requirePro = createMiddleware<{ user: User }>().server<{ tier: 'pro' }>(\n  async ({ ctx, next }) => {\n    if (ctx.user.tier !== 'pro') throw new Error('pro required')\n    return next({ context: { tier: 'pro' } })\n  },\n)\n\ncreateWorkflow({ id: 'wf' })\n  .middleware([requireUser, requirePro])  // order matters\n  .handler(async (ctx) => {\n    ctx.user           // from requireUser\n    ctx.tier           // from requirePro\n  })","lang":"ts"},{"type":"heading","depth":2,"id":"recipe-typed-helper-that-needs-ctx-fields","children":[{"type":"text","value":"Recipe: typed helper that needs ctx fields"}]},{"type":"code","value":"import type { WorkflowCtx } from '@tanstack/workflow-core'\n\nasync function sendReceipt(\n  ctx: WorkflowCtx<{ user: User }>,\n  amount: number,\n) {\n  await ctx.step('send-receipt', () => mailer.send(ctx.user.email, amount))\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Pass the typed "},{"type":"inlineCode","value":"ctx"},{"type":"text","value":" to the helper — the constraint documents which middleware fields must be in scope."}]},{"type":"heading","depth":2,"id":"rules","children":[{"type":"text","value":"Rules"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":".middleware([a, b])"},{"type":"text","value":" runs "},{"type":"inlineCode","value":"a"},{"type":"text","value":" first, then "},{"type":"inlineCode","value":"b"},{"type":"text","value":", then the handler."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Each middleware must call "},{"type":"inlineCode","value":"next()"},{"type":"text","value":" exactly once. Twice throws "},{"type":"inlineCode","value":"RUN_ERRORED"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Middleware extensions cannot shadow reserved ctx fields ("},{"type":"inlineCode","value":"input"},{"type":"text","value":", "},{"type":"inlineCode","value":"state"},{"type":"text","value":", "},{"type":"inlineCode","value":"runId"},{"type":"text","value":", "},{"type":"inlineCode","value":"signal"},{"type":"text","value":", "},{"type":"inlineCode","value":"step"},{"type":"text","value":", "},{"type":"inlineCode","value":"sleep"},{"type":"text","value":", "},{"type":"inlineCode","value":"sleepUntil"},{"type":"text","value":", "},{"type":"inlineCode","value":"waitForEvent"},{"type":"text","value":", "},{"type":"inlineCode","value":"approve"},{"type":"text","value":", "},{"type":"inlineCode","value":"now"},{"type":"text","value":", "},{"type":"inlineCode","value":"uuid"},{"type":"text","value":", "},{"type":"inlineCode","value":"emit"},{"type":"text","value":"). Type system rejects them; runtime guards too."}]}]}]},{"type":"heading","depth":2,"id":"footguns","children":[{"type":"text","value":"Footguns"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Implicit ctx inference fails."}]},{"type":"text","value":" The "},{"type":"inlineCode","value":".server<TExtension>(...)"},{"type":"text","value":" generic is mandatory; bare "},{"type":"inlineCode","value":".server(fn)"},{"type":"text","value":" defaults "},{"type":"inlineCode","value":"TExtension"},{"type":"text","value":" to "},{"type":"inlineCode","value":"unknown"},{"type":"text","value":" and ctx fields aren't visible."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Middleware errors abort the run."}]},{"type":"text","value":" A throw before "},{"type":"inlineCode","value":"next()"},{"type":"text","value":" skips the handler entirely; status becomes "},{"type":"inlineCode","value":"errored"},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"recipe-extend-ctx","text":"Recipe: extend ctx","level":2},{"id":"recipe-register-on-a-workflow","text":"Recipe: register on a workflow","level":2},{"id":"recipe-middleware-that-wraps-the-handler","text":"Recipe: middleware that wraps the handler","level":2},{"id":"recipe-middleware-that-depends-on-a-prior-middleware","text":"Recipe: middleware that depends on a prior middleware","level":2},{"id":"recipe-typed-helper-that-needs-ctx-fields","text":"Recipe: typed helper that needs ctx fields","level":2},{"id":"rules","text":"Rules","level":2},{"id":"footguns","text":"Footguns","level":2}]},"frameworks":[],"downloadMarkdown":"\nMiddleware extends `ctx` with typed fields. Workflows declare them as an array — extensions accumulate.\n\n## Recipe: extend ctx\n\n```ts\nimport { createMiddleware } from '@tanstack/workflow-core'\n\nconst requireUser = createMiddleware().server<{\n  user: { id: string; email: string }\n}>(async ({ next }) => {\n  const user = await loadUser()\n  if (!user) throw new Error('unauthorized')\n  return next({ context: { user } })\n})\n```\n\nThe generic on `.server<...>` is the extension shape. TS uses it to add `ctx.user` everywhere the middleware is registered.\n\n## Recipe: register on a workflow\n\n```ts\nconst wf = createWorkflow({ id: 'wf' })\n  .middleware([requireUser])\n  .handler(async (ctx) => {\n    ctx.user.id   // typed\n  })\n```\n\n## Recipe: middleware that wraps the handler\n\n```ts\nconst traced = createMiddleware().server<{ trace: Trace }>(async ({ next }) => {\n  const trace = startTrace()\n  try {\n    return await next({ context: { trace } })\n  } finally {\n    trace.end()\n  }\n})\n```\n\n`next` is called **once**. Code before runs pre-handler; code after runs post.\n\n## Recipe: middleware that depends on a prior middleware\n\n```ts\nconst requireUser = createMiddleware().server<{ user: User }>(\n  async ({ next }) => next({ context: { user: await loadUser() } }),\n)\n\n// Reaches ctx.user — type the inbound ctx with the generic on createMiddleware.\nconst requirePro = createMiddleware<{ user: User }>().server<{ tier: 'pro' }>(\n  async ({ ctx, next }) => {\n    if (ctx.user.tier !== 'pro') throw new Error('pro required')\n    return next({ context: { tier: 'pro' } })\n  },\n)\n\ncreateWorkflow({ id: 'wf' })\n  .middleware([requireUser, requirePro])  // order matters\n  .handler(async (ctx) => {\n    ctx.user           // from requireUser\n    ctx.tier           // from requirePro\n  })\n```\n\n## Recipe: typed helper that needs ctx fields\n\n```ts\nimport type { WorkflowCtx } from '@tanstack/workflow-core'\n\nasync function sendReceipt(\n  ctx: WorkflowCtx<{ user: User }>,\n  amount: number,\n) {\n  await ctx.step('send-receipt', () => mailer.send(ctx.user.email, amount))\n}\n```\n\nPass the typed `ctx` to the helper — the constraint documents which middleware fields must be in scope.\n\n## Rules\n\n- `.middleware([a, b])` runs `a` first, then `b`, then the handler.\n- Each middleware must call `next()` exactly once. Twice throws `RUN_ERRORED`.\n- Middleware extensions cannot shadow reserved ctx fields (`input`, `state`, `runId`, `signal`, `step`, `sleep`, `sleepUntil`, `waitForEvent`, `approve`, `now`, `uuid`, `emit`). Type system rejects them; runtime guards too.\n\n## Footguns\n\n- **Implicit ctx inference fails.** The `.server<TExtension>(...)` generic is mandatory; bare `.server(fn)` defaults `TExtension` to `unknown` and ctx fields aren't visible.\n- **Middleware errors abort the run.** A throw before `next()` skips the handler entirely; status becomes `errored`.\n","originalRawMarkdown":"---\nid: middleware\ntitle: Middleware\n---\n\nMiddleware extends `ctx` with typed fields. Workflows declare them as an array — extensions accumulate.\n\n## Recipe: extend ctx\n\n```ts\nimport { createMiddleware } from '@tanstack/workflow-core'\n\nconst requireUser = createMiddleware().server<{\n  user: { id: string; email: string }\n}>(async ({ next }) => {\n  const user = await loadUser()\n  if (!user) throw new Error('unauthorized')\n  return next({ context: { user } })\n})\n```\n\nThe generic on `.server<...>` is the extension shape. TS uses it to add `ctx.user` everywhere the middleware is registered.\n\n## Recipe: register on a workflow\n\n```ts\nconst wf = createWorkflow({ id: 'wf' })\n  .middleware([requireUser])\n  .handler(async (ctx) => {\n    ctx.user.id   // typed\n  })\n```\n\n## Recipe: middleware that wraps the handler\n\n```ts\nconst traced = createMiddleware().server<{ trace: Trace }>(async ({ next }) => {\n  const trace = startTrace()\n  try {\n    return await next({ context: { trace } })\n  } finally {\n    trace.end()\n  }\n})\n```\n\n`next` is called **once**. Code before runs pre-handler; code after runs post.\n\n## Recipe: middleware that depends on a prior middleware\n\n```ts\nconst requireUser = createMiddleware().server<{ user: User }>(\n  async ({ next }) => next({ context: { user: await loadUser() } }),\n)\n\n// Reaches ctx.user — type the inbound ctx with the generic on createMiddleware.\nconst requirePro = createMiddleware<{ user: User }>().server<{ tier: 'pro' }>(\n  async ({ ctx, next }) => {\n    if (ctx.user.tier !== 'pro') throw new Error('pro required')\n    return next({ context: { tier: 'pro' } })\n  },\n)\n\ncreateWorkflow({ id: 'wf' })\n  .middleware([requireUser, requirePro])  // order matters\n  .handler(async (ctx) => {\n    ctx.user           // from requireUser\n    ctx.tier           // from requirePro\n  })\n```\n\n## Recipe: typed helper that needs ctx fields\n\n```ts\nimport type { WorkflowCtx } from '@tanstack/workflow-core'\n\nasync function sendReceipt(\n  ctx: WorkflowCtx<{ user: User }>,\n  amount: number,\n) {\n  await ctx.step('send-receipt', () => mailer.send(ctx.user.email, amount))\n}\n```\n\nPass the typed `ctx` to the helper — the constraint documents which middleware fields must be in scope.\n\n## Rules\n\n- `.middleware([a, b])` runs `a` first, then `b`, then the handler.\n- Each middleware must call `next()` exactly once. Twice throws `RUN_ERRORED`.\n- Middleware extensions cannot shadow reserved ctx fields (`input`, `state`, `runId`, `signal`, `step`, `sleep`, `sleepUntil`, `waitForEvent`, `approve`, `now`, `uuid`, `emit`). Type system rejects them; runtime guards too.\n\n## Footguns\n\n- **Implicit ctx inference fails.** The `.server<TExtension>(...)` generic is mandatory; bare `.server(fn)` defaults `TExtension` to `unknown` and ctx fields aren't visible.\n- **Middleware errors abort the run.** A throw before `next()` skips the handler entirely; status becomes `errored`.\n"}
