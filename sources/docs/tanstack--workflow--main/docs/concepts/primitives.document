"type":"paragraph","children":[{"type":"inlineCode","value":"retry"},{"type":"text","value":": "},{"type":"inlineCode","value":"{ maxAttempts, backoff?, baseMs?, shouldRetry? }"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"timeout"},{"type":"text","value":": per-attempt wall-clock budget in ms"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"meta"},{"type":"text","value":": free-form metadata copied into "},{"type":"inlineCode","value":"STEP_*"},{"type":"text","value":" events"}]}]}]},{"type":"code","value":"await ctx.step(\n  'flaky-call',\n  () => unstableApi(),\n  {\n    retry: { maxAttempts: 3, backoff: 'exponential', baseMs: 250 },\n    timeout: 5000,\n  },\n)","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Footgun"}]},{"type":"text","value":": Duplicate "},{"type":"inlineCode","value":"id"},{"type":"text","value":" per call site is a programmer error. In loops, interpolate: "},{"type":"inlineCode","value":"ctx.step(\\"},{"type":"text","value":"charge-${i}`, fn)`."}]},{"type":"heading","depth":2,"id":"ctx-sleep-ms-opts-ctx-sleepuntil-timestamp-opts","children":[{"type":"inlineCode","value":"ctx.sleep(ms, opts?)"},{"type":"text","value":" / "},{"type":"inlineCode","value":"ctx.sleepUntil(timestamp, opts?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Durable pause. Engine emits "},{"type":"inlineCode","value":"SIGNAL_AWAITED { name: '__timer', deadline }"},{"type":"text","value":". Run resumes when the host delivers the "},{"type":"inlineCode","value":"__timer"},{"type":"text","value":" signal."}]},{"type":"code","value":"await ctx.sleep(60_000)              // wake in 60s\nawait ctx.sleepUntil(nextMidnight()) // wake at a wall-clock time\nawait ctx.sleepUntil(deadline, { id: 'cooldown', meta: { reason: 'rate-limit' } })","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Footgun"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"Date.now()"},{"type":"text","value":" inside the handler is non-deterministic. Anchor with "},{"type":"inlineCode","value":"ctx.now()"},{"type":"text","value":" if you need a stable deadline across replays."}]},{"type":"heading","depth":2,"id":"ctx-waitforevent-name-opts","children":[{"type":"inlineCode","value":"ctx.waitForEvent(name, opts?)"}]},{"type":"paragraph","children":[{"type":"text","value":"Pause until the host delivers a signal with this "},{"type":"inlineCode","value":"name"},{"type":"text","value":". Returns the payload."}]},{"type":"code","value":"const now = await ctx.now()\nconst payload = await ctx.waitForEvent('webhook-received', {\n  id: 'stripe-webhook',\n  schema: z.object({ reference: z.string() }),\n  meta: { source: 'stripe' },     // visible to the host driver\n  deadline: now + 86_400_000,     // host wakes if not delivered\n})","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Resume by calling "},{"type":"inlineCode","value":"runWorkflow({ runId, signalDelivery: { signalId, name, payload } })"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Footgun"}]},{"type":"text","value":": Multiple unnamed "},{"type":"inlineCode","value":"waitForEvent"},{"type":"text","value":" calls with the same "},{"type":"inlineCode","value":"name"},{"type":"text","value":" match\ntheir generated operation IDs by call order. Use explicit "},{"type":"inlineCode","value":"id"},{"type":"text","value":"s when two waits\nshare a signal name or when you may reorder the workflow later."}]},{"type":"heading","depth":2,"id":"ctx-approve-title-description","children":[{"type":"inlineCode","value":"ctx.approve({ title, description? })"}]},{"type":"paragraph","children":[{"type":"text","value":"Pause for a human decision. Returns "},{"type":"inlineCode","value":"{ approved, approvalId, feedback? }"},{"type":"text","value":"."}]},{"type":"code","value":"const decision = await ctx.approve({\n  id: 'publish-approval',\n  title: 'Publish article?',\n  description: draft.title,\n})\nif (!decision.approved) return { status: 'rejected', notes: decision.feedback }","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"Resume by calling "},{"type":"inlineCode","value":"runWorkflow({ runId, approval: { approvalId, approved, feedback? } })"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Footgun"}]},{"type":"text","value":": unnamed approvals are positional. Use explicit "},{"type":"inlineCode","value":"id"},{"type":"text","value":"s for approvals\nthat may move, and use "},{"type":"inlineCode","value":"previousVersions"},{"type":"text","value":" when changing in-flight workflow code."}]},{"type":"heading","depth":2,"id":"ctx-now-ctx-uuid","children":[{"type":"inlineCode","value":"ctx.now()"},{"type":"text","value":" / "},{"type":"inlineCode","value":"ctx.uuid()"}]},{"type":"paragraph","children":[{"type":"text","value":"Deterministic recorded values. First execution captures, replay returns the same."}]},{"type":"code","value":"const startedAt = await ctx.now({ id: 'started-at' })\nconst correlationId = await ctx.uuid({ id: 'correlation-id' })","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Footgun"}]},{"type":"text","value":": Calling "},{"type":"inlineCode","value":"Date.now()"},{"type":"text","value":" or "},{"type":"inlineCode","value":"crypto.randomUUID()"},{"type":"text","value":" directly is a determinism violation. Replay won't match. Multiple unnamed "},{"type":"inlineCode","value":"now()"},{"type":"text","value":" / "},{"type":"inlineCode","value":"uuid()"},{"type":"text","value":" calls are positional, so give important recorded values explicit "},{"type":"inlineCode","value":"id"},{"type":"text","value":"s."}]},{"type":"heading","depth":2,"id":"ctx-emit-name-value","children":[{"type":"inlineCode","value":"ctx.emit(name, value)"}]},{"type":"paragraph","children":[{"type":"text","value":"Synchronous, non-durable observability event. Reaches live subscribers; not persisted."}]},{"type":"code","value":"ctx.emit('progress', { step: 3, of: 10 })","lang":"ts"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Use for"}]},{"type":"text","value":": UI hints, telemetry, devtools breadcrumbs. "},{"type":"strong","children":[{"type":"text","value":"Don't use for"}]},{"type":"text","value":" anything the engine should replay."}]},{"type":"heading","depth":2,"id":"ctx-signal","children":[{"type":"inlineCode","value":"ctx.signal"}]},{"type":"paragraph","children":[{"type":"text","value":"Run-level "},{"type":"inlineCode","value":"AbortSignal"},{"type":"text","value":". Already-aborted state propagates to "},{"type":"inlineCode","value":"step"},{"type":"text","value":" fns via "},{"type":"inlineCode","value":"stepCtx.signal"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"ctx-runtime","children":[{"type":"inlineCode","value":"ctx.runtime"}]},{"type":"paragraph","children":[{"type":"text","value":"Runtime deadline metadata and cooperative yielding:"}]},{"type":"code","value":"ctx.runtime.deadline\nctx.runtime.timeRemaining()\nctx.runtime.shouldYield({ minRemainingMs: 2_000 })\nawait ctx.runtime.yield({ reason: 'host deadline' })","lang":"ts"},{"type":"paragraph","children":[{"type":"text","value":"The runtime automatically yields before fresh durable work when its budget is\nlow, so queue loops do not need arbitrary batch sizes:"}]},{"type":"code","value":"for (let index = 0; ; index++) {\n  const item = await ctx.step(`take-${index}`, takeNextItem)\n  if (!item) break\n  await ctx.step(`process-${item.id}`, () => processItem(item))\n}","lang":"ts"},{"type":"paragraph","children":[{"type":"inlineCode","value":"stepCtx.runtime"},{"type":"text","value":" exposes the deadline, remaining time, and "},{"type":"inlineCode","value":"shouldYield"},{"type":"text","value":" for\nlong-running step logic. A step cannot yield midway because partial step work is\nnot a durable checkpoint. Step timeouts remain independent."}]},{"type":"code","value":"await ctx.step('long-fetch', (stepCtx) =>\n  fetch(url, { signal: stepCtx.signal }),\n)","lang":"ts"},{"type":"heading","depth":2,"id":"succeed-fail","children":[{"type":"inlineCode","value":"succeed"},{"type":"text","value":" / "},{"type":"inlineCode","value":"fail"}]},{"type":"paragraph","children":[{"type":"text","value":"Tagged return helpers. Avoids "},{"type":"inlineCode","value":"as const"},{"type":"text","value":" clutter on discriminated unions."}]},{"type":"code","value":"import { succeed, fail } from '@tanstack/workflow-core'\n\nif (review.verdict === 'block') return fail(`legal: ${review.findings.join('; ')}`)\nreturn succeed({ article: draft })","lang":"ts"}],"headings":[{"id":"stable-operation-ids","text":"Stable operation IDs","level":2},{"id":"ctx-step-id-fn-opts","text":"ctx.step(id, fn, opts?)","level":2},{"id":"ctx-sleep-ms-opts-ctx-sleepuntil-timestamp-opts","text":"ctx.sleep(ms, opts?) / ctx.sleepUntil(timestamp, opts?)","level":2},{"id":"ctx-waitforevent-name-opts","text":"ctx.waitForEvent(name, opts?)","level":2},{"id":"ctx-approve-title-description","text":"ctx.approve({ title, description? })","level":2},{"id":"ctx-now-ctx-uuid","text":"ctx.now() / ctx.uuid()","level":2},{"id":"ctx-emit-name-value","text":"ctx.emit(name, value)","level":2},{"id":"ctx-signal","text":"ctx.signal","level":2},{"id":"ctx-runtime","text":"ctx.runtime","level":2},{"id":"succeed-fail","text":"succeed / fail","level":2}]},"frameworks":[],"downloadMarkdown":"\nEvery durable operation goes through `ctx.*`. Each primitive has one recipe and one footgun.\n\n## Stable operation IDs\n\nEvery durable primitive records a `stepId` in the log. `ctx.step(id, ...)`\nalready takes one. For the other primitives, pass `id` in the options object\nwhen the operation is important or likely to be reordered later:\n\n```ts\nconst startedAt = await ctx.now({ id: 'started-at' })\nawait ctx.sleepUntil(deadline, { id: 'cooldown' })\nconst payload = await ctx.waitForEvent('payment', { id: 'payment-webhook' })\nconst decision = await ctx.approve({ id: 'legal-review', title: 'Ship?' })\n```\n\nIf omitted, the engine generates a positional internal ID for backwards-compatible\nergonomics. Explicit IDs are safer for long-lived workflows and future versions.\n\n## `ctx.step(id, fn, opts?)`\n\nRun `fn` durably. Returns its value. Replays from the log on subsequent invocations.\n\n```ts\nconst data = await ctx.step('fetch-user', (stepCtx) =>\n  fetch('/api/user', { headers: { 'Idempotency-Key': stepCtx.id } }).then((r) => r.json())\n)\n```\n\nOptions:\n- `retry`: `{ maxAttempts, backoff?, baseMs?, shouldRetry? }`\n- `timeout`: per-attempt wall-clock budget in ms\n- `meta`: free-form metadata copied into `STEP_*` events\n\n```ts\nawait ctx.step(\n  'flaky-call',\n  () => unstableApi(),\n  {\n    retry: { maxAttempts: 3, backoff: 'exponential', baseMs: 250 },\n    timeout: 5000,\n  },\n)\n```\n\n**Footgun**: Duplicate `id` per call site is a programmer error. In loops, interpolate: `ctx.step(\\`charge-${i}\\`, fn)`.\n\n## `ctx.sleep(ms, opts?)` / `ctx.sleepUntil(timestamp, opts?)`\n\nDurable pause. Engine emits `SIGNAL_AWAITED { name: '__timer', deadline }`. Run resumes when the host delivers the `__timer` signal.\n\n```ts\nawait ctx.sleep(60_000)              // wake in 60s\nawait ctx.sleepUntil(nextMidnight()) // wake at a wall-clock time\nawait ctx.sleepUntil(deadline, { id: 'cooldown', meta: { reason: 'rate-limit' } })\n```\n\n**Footgun**: `Date.now()` inside the handler is non-deterministic. Anchor with `ctx.now()` if you need a stable deadline across replays.\n\n## `ctx.waitForEvent(name, opts?)`\n\nPause until the host delivers a signal with this `name`. Returns the payload.\n\n```ts\nconst now = await ctx.now()\nconst payload = await ctx.waitForEvent('webhook-received', {\n  id: 'stripe-webhook',\n  schema: z.object({ reference: z.string() }),\n  meta: { source: 'stripe' },     // visible to the host driver\n  deadline: now + 86_400_000,     // host wakes if not delivered\n})\n```\n\nResume by calling `runWorkflow({ runId, signalDelivery: { signalId, name, payload } })`.\n\n**Footgun**: Multiple unnamed `waitForEvent` calls with the same `name` match\ntheir generated operation IDs by call order. Use explicit `id`s when two waits\nshare a signal name or when you may reorder the workflow later.\n\n## `ctx.approve({ title, description? })`\n\nPause for a human decision. Returns `{ approved, approvalId, feedback? }`.\n\n```ts\nconst decision = await ctx.approve({\n  id: 'publish-approval',\n  title: 'Publish article?',\n  description: draft.title,\n})\nif (!decision.approved) return { status: 'rejected', notes: decision.feedback }\n```\n\nResume by calling `runWorkflow({ runId, approval: { approvalId, approved, feedback? } })`.\n\n**Footgun**: unnamed approvals are positional. Use explicit `id`s for approvals\nthat may move, and use `previousVersions` when changing in-flight workflow code.\n\n## `ctx.now()` / `ctx.uuid()`\n\nDeterministic recorded values. First execution captures, replay returns the same.\n\n```ts\nconst startedAt = await ctx.now({ id: 'started-at' })\nconst correlationId = await ctx.uuid({ id: 'correlation-id' })\n```\n\n**Footgun**: Calling `Date.now()` or `crypto.randomUUID()` directly is a determinism violation. Replay won't match. Multiple unnamed `now()` / `uuid()` calls are positional, so give important recorded values explicit `id`s.\n\n## `ctx.emit(name, value)`\n\nSynchronous, non-durable observability event. Reaches live subscribers; not persisted.\n\n```ts\nctx.emit('progress', { step: 3, of: 10 })\n```\n\n**Use for**: UI hints, telemetry, devtools breadcrumbs. **Don't use for** anything the engine should replay.\n\n## `ctx.signal`\n\nRun-level `AbortSignal`. Already-aborted state propagates to `step` fns via `stepCtx.signal`.\n\n## `ctx.runtime`\n\nRuntime deadline metadata and cooperative yielding:\n\n```ts\nctx.runtime.deadline\nctx.runtime.timeRemaining()\nctx.runtime.shouldYield({ minRemainingMs: 2_000 })\nawait ctx.runtime.yield({ reason: 'host deadline' })\n```\n\nThe runtime automatically yields before fresh durable work when its budget is\nlow, so queue loops do not need arbitrary batch sizes:\n\n```ts\nfor (let index = 0; ; index++) {\n  const item = await ctx.step(`take-${index}`, takeNextItem)\n  if (!item) break\n  await ctx.step(`process-${item.id}`, () => processItem(item))\n}\n```\n\n`stepCtx.runtime` exposes the deadline, remaining time, and `shouldYield` for\nlong-running step logic. A step cannot yield midway because partial step work is\nnot a durable checkpoint. Step timeouts remain independent.\n\n```ts\nawait ctx.step('long-fetch', (stepCtx) =>\n  fetch(url, { signal: stepCtx.signal }),\n)\n```\n\n## `succeed` / `fail`\n\nTagged return helpers. Avoids `as const` clutter on discriminated unions.\n\n```ts\nimport { succeed, fail } from '@tanstack/workflow-core'\n\nif (review.verdict === 'block') return fail(`legal: ${review.findings.join('; ')}`)\nreturn succeed({ article: draft })\n```\n","originalRawMarkdown":"---\nid: primitives\ntitle: Primitives\n---\n\nEvery durable operation goes through `ctx.*`. Each primitive has one recipe and one footgun.\n\n## Stable operation IDs\n\nEvery durable primitive records a `stepId` in the log. `ctx.step(id, ...)`\nalready takes one. For the other primitives, pass `id` in the options object\nwhen the operation is important or likely to be reordered later:\n\n```ts\nconst startedAt = await ctx.now({ id: 'started-at' })\nawait ctx.sleepUntil(deadline, { id: 'cooldown' })\nconst payload = await ctx.waitForEvent('payment', { id: 'payment-webhook' })\nconst decision = await ctx.approve({ id: 'legal-review', title: 'Ship?' })\n```\n\nIf omitted, the engine generates a positional internal ID for backwards-compatible\nergonomics. Explicit IDs are safer for long-lived workflows and future versions.\n\n## `ctx.step(id, fn, opts?)`\n\nRun `fn` durably. Returns its value. Replays from the log on subsequent invocations.\n\n```ts\nconst data = await ctx.step('fetch-user', (stepCtx) =>\n  fetch('/api/user', { headers: { 'Idempotency-Key': stepCtx.id } }).then((r) => r.json())\n)\n```\n\nOptions:\n- `retry`: `{ maxAttempts, backoff?, baseMs?, shouldRetry? }`\n- `timeout`: per-attempt wall-clock budget in ms\n- `meta`: free-form metadata copied into `STEP_*` events\n\n```ts\nawait ctx.step(\n  'flaky-call',\n  () => unstableApi(),\n  {\n    retry: { maxAttempts: 3, backoff: 'exponential', baseMs: 250 },\n    timeout: 5000,\n  },\n)\n```\n\n**Footgun**: Duplicate `id` per call site is a programmer error. In loops, interpolate: `ctx.step(\\`charge-${i}\\`, fn)`.\n\n## `ctx.sleep(ms, opts?)` / `ctx.sleepUntil(timestamp, opts?)`\n\nDurable pause. Engine emits `SIGNAL_AWAITED { name: '__timer', deadline }`. Run resumes when the host delivers the `__timer` signal.\n\n```ts\nawait ctx.sleep(60_000)              // wake in 60s\nawait ctx.sleepUntil(nextMidnight()) // wake at a wall-clock time\nawait ctx.sleepUntil(deadline, { id: 'cooldown', meta: { reason: 'rate-limit' } })\n```\n\n**Footgun**: `Date.now()` inside the handler is non-deterministic. Anchor with `ctx.now()` if you need a stable deadline across replays.\n\n## `ctx.waitForEvent(name, opts?)`\n\nPause until the host delivers a signal with this `name`. Returns the payload.\n\n```ts\nconst now = await ctx.now()\nconst payload = await ctx.waitForEvent('webhook-received', {\n  id: 'stripe-webhook',\n  schema: z.object({ reference: z.string() }),\n  meta: { source: 'stripe' },     // visible to the host driver\n  deadline: now + 86_400_000,     // host wakes if not delivered\n})\n```\n\nResume by calling `runWorkflow({ runId, signalDelivery: { signalId, name, payload } })`.\n\n**Footgun**: Multiple unnamed `waitForEvent` calls with the same `name` match\ntheir generated operation IDs by call order. Use explicit `id`s when two waits\nshare a signal name or when you may reorder the workflow later.\n\n## `ctx.approve({ title, description? })`\n\nPause for a human decision. Returns `{ approved, approvalId, feedback? }`.\n\n```ts\nconst decision = await ctx.approve({\n  id: 'publish-approval',\n  title: 'Publish article?',\n  description: draft.title,\n})\nif (!decision.approved) return { status: 'rejected', notes: decision.feedback }\n```\n\nResume by calling `runWorkflow({ runId, approval: { approvalId, approved, feedback? } })`.\n\n**Footgun**: unnamed approvals are positional. Use explicit `id`s for approvals\nthat may move, and use `previousVersions` when changing in-flight workflow code.\n\n## `ctx.now()` / `ctx.uuid()`\n\nDeterministic recorded values. First execution captures, replay returns the same.\n\n```ts\nconst startedAt = await ctx.now({ id: 'started-at' })\nconst correlationId = await ctx.uuid({ id: 'correlation-id' })\n```\n\n**Footgun**: Calling `Date.now()` or `crypto.randomUUID()` directly is a determinism violation. Replay won't match. Multiple unnamed `now()` / `uuid()` calls are positional, so give important recorded values explicit `id`s.\n\n## `ctx.emit(name, value)`\n\nSynchronous, non-durable observability event. Reaches live subscribers; not persisted.\n\n```ts\nctx.emit('progress', { step: 3, of: 10 })\n```\n\n**Use for**: UI hints, telemetry, devtools breadcrumbs. **Don't use for** anything the engine should replay.\n\n## `ctx.signal`\n\nRun-level `AbortSignal`. Already-aborted state propagates to `step` fns via `stepCtx.signal`.\n\n## `ctx.runtime`\n\nRuntime deadline metadata and cooperative yielding:\n\n```ts\nctx.runtime.deadline\nctx.runtime.timeRemaining()\nctx.runtime.shouldYield({ minRemainingMs: 2_000 })\nawait ctx.runtime.yield({ reason: 'host deadline' })\n```\n\nThe runtime automatically yields before fresh durable work when its budget is\nlow, so queue loops do not need arbitrary batch sizes:\n\n```ts\nfor (let index = 0; ; index++) {\n  const item = await ctx.step(`take-${index}`, takeNextItem)\n  if (!item) break\n  await ctx.step(`process-${item.id}`, () => processItem(item))\n}\n```\n\n`stepCtx.runtime` exposes the deadline, remaining time, and `shouldYield` for\nlong-running step logic. A step cannot yield midway because partial step work is\nnot a durable checkpoint. Step timeouts remain independent.\n\n```ts\nawait ctx.step('long-fetch', (stepCtx) =>\n  fetch(url, { signal: stepCtx.signal }),\n)\n```\n\n## `succeed` / `fail`\n\nTagged return helpers. Avoids `as const` clutter on discriminated unions.\n\n```ts\nimport { succeed, fail } from '@tanstack/workflow-core'\n\nif (review.verdict === 'block') return fail(`legal: ${review.findings.join('; ')}`)\nreturn succeed({ article: draft })\n```\n"}
