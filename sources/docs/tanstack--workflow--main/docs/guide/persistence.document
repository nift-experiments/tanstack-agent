{"document":{"type":"root","children":[{"type":"heading","depth":1,"id":"persistence","children":[{"type":"text","value":"Persistence"}]},{"type":"paragraph","children":[{"type":"text","value":"Durability is the difference between \"an async function\" and \"a workflow.\" In\nTanStack Workflow, durability lives in an explicit store contract."}]},{"type":"paragraph","children":[{"type":"text","value":"The store is responsible for the facts that must survive process exits,\ndeployments, retries, and concurrent workers."}]},{"type":"heading","depth":2,"id":"two-store-layers","children":[{"type":"text","value":"Two store layers"}]},{"type":"paragraph","children":[{"type":"text","value":"There are two related store shapes:"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Store"}]},{"type":"tableCell","children":[{"type":"text","value":"Package"}]},{"type":"tableCell","children":[{"type":"text","value":"Purpose"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineCode","value":"RunStore"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/workflow-core"}]},{"type":"tableCell","children":[{"type":"text","value":"The low-level replay store used directly by "},{"type":"inlineCode","value":"runWorkflow"},{"type":"text","value":"."}]}],[{"type":"tableCell","children":[{"type":"inlineCode","value":"WorkflowExecutionStore"}]},{"type":"tableCell","children":[{"type":"inlineCode","value":"@tanstack/workflow-runtime"}]},{"type":"tableCell","children":[{"type":"text","value":"The production runtime store for runs, events, timers, schedules, signals, approvals, leases, and timelines."}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Use "},{"type":"inlineCode","value":"RunStore"},{"type":"text","value":" when embedding the core engine yourself. Use\n"},{"type":"inlineCode","value":"WorkflowExecutionStore"},{"type":"text","value":" when using "},{"type":"inlineCode","value":"defineWorkflowRuntime"},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"what-persists","children":[{"type":"text","value":"What persists"}]},{"type":"paragraph","children":[{"type":"text","value":"The runtime store persists:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Runs"}]},{"type":"text","value":": "},{"type":"inlineCode","value":"runId"},{"type":"text","value":", "},{"type":"inlineCode","value":"workflowId"},{"type":"text","value":", "},{"type":"inlineCode","value":"workflowVersion"},{"type":"text","value":", status, input, output, and\nerror."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Run state"}]},{"type":"text","value":": the replay metadata needed by the core engine, including\n"},{"type":"inlineCode","value":"awaiting[]"},{"type":"text","value":" plus current single-wait projections for hosts."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Events"}]},{"type":"text","value":": the append-only workflow event log."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Timers"}]},{"type":"text","value":": due wake-ups for "},{"type":"inlineCode","value":"ctx.sleep"},{"type":"text","value":" and "},{"type":"inlineCode","value":"ctx.sleepUntil"},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Signals"}]},{"type":"text","value":": delivered external events with idempotency."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Approvals"}]},{"type":"text","value":": delivered approval decisions with idempotency."}]}]},{"type":"listItem","children":[{"type":