hildren":[{"type":"inlineCode","value":"TExtension"}]},{"type":"heading","depth":2,"id":"parameters","children":[{"type":"text","value":"Parameters"}]},{"type":"heading","depth":3,"id":"args","children":[{"type":"text","value":"args"}]},{"type":"heading","depth":4,"id":"ctx","children":[{"type":"text","value":"ctx"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"TCtxIn"}]},{"type":"heading","depth":4,"id":"next","children":[{"type":"text","value":"next"}]},{"type":"paragraph","children":[{"type":"text","value":"("},{"type":"inlineCode","value":"opts"},{"type":"text","value":") => "},{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]},{"type":"heading","depth":2,"id":"returns","children":[{"type":"text","value":"Returns"}]},{"type":"paragraph","children":[{"type":"inlineCode","value":"Promise"},{"type":"text","value":"<"},{"type":"inlineCode","value":"unknown"},{"type":"text","value":">"}]}],"headings":[{"id":"type-alias-middlewareserverfn-tctxin-textension","text":"Type Alias: MiddlewareServerFn()<TCtxIn, TExtension>","level":1},{"id":"type-parameters","text":"Type Parameters","level":2},{"id":"tctxin","text":"TCtxIn","level":3},{"id":"textension","text":"TExtension","level":3},{"id":"parameters","text":"Parameters","level":2},{"id":"args","text":"args","level":3},{"id":"ctx","text":"ctx","level":4},{"id":"next","text":"next","level":4},{"id":"returns","text":"Returns","level":2}]},"frameworks":[],"downloadMarkdown":"\n# Type Alias: MiddlewareServerFn()\\<TCtxIn, TExtension\\>\n\n```ts\ntype MiddlewareServerFn<TCtxIn, TExtension> = (args) => Promise<unknown>;\n```\n\nDefined in: [packages/workflow-core/src/types.ts:399](https://github.com/TanStack/workflow/blob/main/packages/workflow-core/src/types.ts#L399)\n\nA middleware extends the ctx for downstream middleware + the\nhandler. The function receives the *current* `ctx` and a `next`\ncallable taking `{ context: TExtension }` — the literal `context`\nfield is what TypeScript anchors on to infer `TExtension` from the\ncall site.\n\n    const requireUser = createMiddleware().server(async ({ ctx, next }) => {\n      const user = await loadUser()\n      return next({ context: { user } })\n      // downstream ctx is now `prev & { user: User }`\n    })\n\n## Type Parameters\n\n### TCtxIn\n\n`TCtxIn`\n\n### TExtension\n\n`TExtension`\n\n## Parameters\n\n### args\n\n#### ctx\n\n`TCtxIn`\n\n#### next\n\n(`opts`) => `Promise`\\<`unknown`\\>\n\n## Returns\n\n`Promise`\\<`unknown`\\>\n","originalRawMarkdown":"---\nid: MiddlewareServerFn\ntitle: MiddlewareServerFn\n---\n\n# Type Alias: MiddlewareServerFn()\\<TCtxIn, TExtension\\>\n\n```ts\ntype MiddlewareServerFn<TCtxIn, TExtension> = (args) => Promise<unknown>;\n```\n\nDefined in: [packages/workflow-core/src/types.ts:399](https://github.com/TanStack/workflow/blob/main/packages/workflow-core/src/types.ts#L399)\n\nA middleware extends the ctx for downstream middleware + the\nhandler. The function receives the *current* `ctx` and a `next`\ncallable taking `{ context: TExtension }` — the literal `context`\nfield is what TypeScript anchors on to infer `TExtension` from the\ncall site.\n\n    const requireUser = createMiddleware().server(async ({ ctx, next }) => {\n      const user = await loadUser()\n      return next({ context: { user } })\n      // downstream ctx is now `prev & { user: User }`\n    })\n\n## Type Parameters\n\n### TCtxIn\n\n`TCtxIn`\n\n### TExtension\n\n`TExtension`\n\n## Parameters\n\n### args\n\n#### ctx\n\n`TCtxIn`\n\n#### next\n\n(`opts`) => `Promise`\\<`unknown`\\>\n\n## Returns\n\n`Promise`\\<`unknown`\\>\n"}
